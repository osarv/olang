import "std/io"

type Fv struct(h F16, b BF16, f F32, d F64) {
    h
    b
    f
    d
}
type Named struct(n I32) {
    n
}
fn (x Named) Str() String { return "<" $x.n ">" }
type Cyc struct(v I32) {
    v
    next mut Cyc& = null
}
type Col enum {
    Red
    Green
    Blue
}
type Wrap enum {
    W(c Col, s String&, n Named)
}
fn pair(n I32) (I32, String) { return n, "x" $n }
fn dbl(x I32) I32 { return x * 2 }

fn show(a I32) String {
    fv := Fv(F16(0.1), BF16(0.1), F32(0.1), 0.1)
    u := U8[104, 105]
    ch := Char['h', 'i']
    s := Named(a)
    arrN := Array<Named>(2)
    c Cyc& = Cyc(a)
    c.next = c
    w := Wrap.W(Col.Green, "q", Named(3))
    f fn(x I32) I32 = dbl
    lam := fn(x I32) I32 { return x + a }
    em := Array<String&>(0)
    i8s := I8[-128, 127]
    bools := Bool[true, false]
    cols := Col[Col.Red, Col.Blue]
    return $fv " " $u " " $ch " " $s " " $arrN " " $c " " $w " " $f " " $lam " " $em " " $i8s " " $bools " " $cols " " $pair(a) " " $dbl " " $(a == 3) " " $Col.Blue
}
B String = show(3)
M mut I32 = 3
fn main() ? io.IoError {
    try io.Print($B "\n" $show(M) "\n")
}
