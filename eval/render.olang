import "std/io"

type P struct(x I32, y I32) {
    x
    y
}
type Q struct(p P, name String&, h F16) {
    p
    name
    h
}
type Shape enum {
    Circle(r F64)
    Rect(w I32, h I32)
    Dot
}
type Node struct(v I32, next Node&) {
    v
    next
}
type Expr enum {
    Lit(v I64)
    Add(a Expr&, b Expr&)
}
type Meters extends I32
type Tag struct(c Char, u U8, b Bool, s String&) {
    c
    u
    b
    s
}

fn show(a I32) String {
    p := P(a, -a)
    q := Q(p, "hi\n\"x\"", F16(0.1))
    s1 := Shape.Circle(1.5)
    s2 := Shape.Rect(a, 4)
    s3 := Shape.Dot
    arr := I32[a, 2, 3]
    nested := Array<Array<I32>&>(2)
    n2 Node& = Node(1, Node(2, null))
    e Expr& = Expr.Add(Expr.Lit(1), Expr.Add(Expr.Lit(2), Expr.Lit(3)))
    m Meters = Meters(a)
    t := Tag('q', U8(200), true, "z\t")
    empty := Array<I32>(0)
    texts := String&["a", "b\\c"]
    c := '\''
    return $p " " $q " " $s1 " " $s2 " " $s3 " " $arr " " $nested " " $n2 " " $e " " $m " " $t " " $empty " " $texts " " $c " " $(F32(1.0) / 3.0) " " $(-0.0) " " $U64(18446744073709551615)
}
B String = show(7)
M mut I32 = 7
fn main() ? io.IoError {
    try io.Print($B "\n" $show(M) "\n")
}
