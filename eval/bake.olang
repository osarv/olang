import "std/io"
type Holder struct(a mut Array<I32>&, b mut Array<I32>&) {
    a
    b
}
fn mk() Holder {
    arr Array<I32>&return = Array<I32>(4)
    return Holder(arr, arr[1:3])
}
G Holder = mk()
Gm mut Holder = mk()
fn main() ? io.IoError {
    try io.Print("same " $same(G.a[1:3], G.b) " " $same(Gm.a[1:3], Gm.b) "\n")
    G.a[1] = 5
    try io.Print("wrote a[1]: b[0] = " $G.b[0] "\n")
    Gm.a[1] = 6
    try io.Print("wrote mut a[1]: b[0] = " $Gm.b[0] "\n")
}
