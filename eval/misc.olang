import "std/io"
import "std/map"

type Pct extends I32(v mut I32) ? {
    if v > 100 { error }
    if v < 0 { v = 0 }
}
type V2 struct(x I32, y I32) {
    x
    y
}
fn (a V2) Plus(b V2) V2 { return V2(a.x + b.x, a.y + b.y) }
fn (a V2) Less(b V2) Bool { return a.x < b.x }
fn (a V2) Neg() V2 { return V2(-a.x, -a.y) }
fn (a V2) At(i I64) I32 { return a.x if i == 0 else a.y }
fn (a V2) Len() I64 { return 2 }

type Expr enum {
    Lit(v I64)
    Add(a Expr&, b Expr&)
    Mul(a Expr&, b Expr&)
    Neg(e Expr&)
}
fn eval(e Expr&) I64 {
    return match e {
        case Expr.Lit(v) => v
        case Expr.Add(a, b) => eval(a) + eval(b)
        case Expr.Mul(Expr.Lit(0), _), Expr.Mul(_, Expr.Lit(0)) => 0
        case Expr.Mul(a, b) => eval(a) * eval(b)
        case Expr.Neg(x) => -eval(x)
        nomatch => 0
    }
}
error E1 {
    A
    B
}
fn risky(n I32) I32 ? E1 {
    if n == 1 { error E1.A }
    if n == 2 { error E1.B }
    return n * 3
}
fn handle(n I32) I32 {
    r := try risky(n) catch E1.A default 100 catch E1.B { return -1 }
    return r
}
fn defers(n I32) String {
    b := StringBuilder()
    if n > 0 {
        defer b.Push("a")
        defer b.Push("b")
        for i in range n + 1 {
            defer b.Push($i)
            if i == 1 { continue }
            b.Push("x")
        }
    }
    b.Push("|")
    return b.ToString()
}
fn defret(n I32) I32 {
    x I32 = n
    defer x = 99
    return x
}
fn classify(n I32) String {
    return match n {
        case 1, 2, 3 => "small"
        case 100, 200 if n > 150 => "big"
        case 7 => "seven"
        nomatch => "other"
    }
}
fn closures(n I32) String {
    k I32 = n
    add := fn(x I32) I32 { return x + k }
    fs := Array<fn(x I32) I32>(3)
    for i in range 3 {
        j := I32(i)
        fs[i] = fn(x I32) I32 { return x * j + k }
    }
    acc I32 = 0
    for f in fs { acc += f(10) }
    return $add(1) " " $acc
}
fn maps(n I32) String {
    m := map.Map<String&, I32>()
    words := "a b c a b a d e f g h i j k l m n o p q".Split(" ")
    for w in words {
        c := try m.Get(w) catch default 0
        m.Put(w, c + n)
    }
    removed := m.Remove("b")
    total I32 = 0
    for e in m { total += e.Value }
    l := List<I32>()
    for i in range 40 { l.Push(I32(i) * n) }
    l[17] = -5
    s I64 = 0
    for x in l { s += x }
    arr := l.ToArray()
    return $m.Len() " " $total " " $removed $(try m.Get("a") catch default -1) " " $("z" in m) " " $s " " $l[17] " " $l[39] " " $arr.Len() " " $(try l[40] catch default -3)
}
fn ops(n I32) String {
    a := V2(n, 2)
    b := V2(3, n)
    c := a + b
    d := -c
    lt := a < b
    ge Bool = a >= b
    s I32 = 0
    for x in c { s += x }
    return $c " " $d " " $lt " " $ge " " $s " " $c[1]
}
fn pcts(n I32) String {
    p := try Pct(n) catch default 50
    q := try Pct(n - 200) catch default 1
    return $p " " $q
}
fn tree(n I64) String {
    e Expr& = Expr.Add(Expr.Lit(n), Expr.Mul(Expr.Neg(Expr.Lit(3)), Expr.Add(Expr.Lit(1), Expr.Lit(n))))
    z Expr& = Expr.Mul(Expr.Lit(0), Expr.Lit(n))
    return $eval(e) " " $eval(z) " " $e
}
fn all(n I32) String {
    return $handle(n) " " $handle(n - 1) " " $handle(n - 2) " | " $defers(n) " | " $defret(n) " | " $classify(n) " " $classify(n * 100) " " $classify(n + 6) " | " $closures(n) " | " $maps(n) " | " $ops(n) " | " $pcts(n) " | " $tree(I64(n))
}
B String = all(1)
B2 String = all(2)
M mut I32 = 1
M2 mut I32 = 2
fn main() ? io.IoError {
    try io.Print($B "\n" $all(M) "\n" $B2 "\n" $all(M2) "\n")
}
