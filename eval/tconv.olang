import "std/io"
fn cu8(x F64) U8 { return try U8(x) catch default 77 }
fn ci32(x F64) I32 { return try I32(x) catch default 77 }
fn cu64(x F64) U64 { return try U64(x) catch default 77 }
fn all(a F64, b F64, c F64, d F64) String { return $cu8(a) " " $ci32(b) " " $cu64(c) " " $ci32(d) }
B String = all(-0.5, -2147483648.5, -0.9, 2147483647.9)
Ma mut F64 = -0.5
Mb mut F64 = -2147483648.5
Mc mut F64 = -0.9
Md mut F64 = 2147483647.9
fn main() ? io.IoError {
    try io.Print($B "\n" $all(Ma, Mb, Mc, Md) "\n")
}
