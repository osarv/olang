import "std/io"
error E {
    A
    B
}
error F {
    X
}
fn g(n I32) I32 ? E {
    if n < 0 { error E.A }
    if n > 100 { error E.B }
    return n
}
fn h(n I32) I32 ? F {
    if n == 7 { error F.X }
    return n * 2
}
fn add(a I32, b I32) I32 { return a + b }
fn nest(n I32) I32 ? E {
    r := add(try g(n), try h(n) catch default -1)
    return r
}
fn loopy(n I32) I32 {
    acc I32 = 0
    for i in range 10 {
        v := try g(n - I32(i) * 50) catch E.A { break } catch E.B { continue }
        acc += v
    }
    return acc
}
fn gen(n I32) I32 ? {
    x := try g(n)
    y := try h(n)
    return x + y
}
fn chk(a I32, b I32) I32 ? BuiltinError {
    return try (a / b + a * b)
}
fn all(n I32) String {
    r1 := try nest(n) catch default -5
    r2 := try nest(-n) catch E.A default -6 catch default -7
    r3 := try nest(n + 200) catch default -8
    r4 := try gen(7) catch default -9
    r5 := try chk(n, 0) catch BuiltinError.DIVIDE_BY_ZERO default -10 catch default -11
    r6 := try chk(2147483647, 2) catch BuiltinError.OVERFLOW default -12 catch default -13
    return $r1 " " $r2 " " $r3 " " $loopy(n) " " $r4 " " $r5 " " $r6 " " $(try (n + 2147483647) catch default -14)
}
B String = all(7)
M mut I32 = 7
fn main() ? io.IoError {
    try io.Print($B "\n" $all(M) "\n")
}
