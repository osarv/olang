import "std/io"
fn pick(n I32) Array<I32> {
    return match n {
        case 1 => I32[7, 8]
        nomatch => I32[9, 9]
    }
}
fn pickS(n I32) String {
    return match n {
        case 1 => "seven"
        nomatch => "other"
    }
}
fn churn() I64 {
    s I64 = 0
    for i in range 50 {
        x := Array<I64>(64, i)
        s += x[3]
    }
    return s
}
M mut I32 = 1
fn main() ? io.IoError {
    p := pick(M)
    s := pickS(M)
    c := churn()
    try io.Print($p " " $s " " $c "\n")
}
