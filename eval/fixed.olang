import "std/io"
fn f(n I32) I32 {
    x I32 = 5
    r I32 = 0
    for i in range n {
        if x == 5 { r += 1 } else { r += 100 }
        x = 7
    }
    return r
}
fn g(n I32) I32 {
    x I32 = 5
    r I32 = 0
    for i in range n {
        if x == 5 { r += 1 } else { r += 100 }
        x, r = 7, r
    }
    return r
}
fn h(n I32) I32 {
    x I32 = 5
    r I32 = 0
    for i in range n {
        if x == 5 { r += 1 } else { r += 100 }
        defer x = 9
    }
    return r
}
fn k(n I32) I32 {
