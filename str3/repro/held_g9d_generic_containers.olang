# HELD (item 2): generic Map/List builders over a destructor value (G9d binds mut Res&): 'made 10 gone 10' under
# -b and -b -s. 7345ff9/b6259d1 refused these (C11 inside the generic).
Made mut I64 = 0
Gone mut I64 = 0
type Res struct(k I64) {
    k
    Made++
} destruct { Gone++ }
fn mk(k <K>, v <V>) Map<K, V> {
    m := Map<K, V>()
    m.Put(k, v)
    return m
}
fn lst(v <V>) List<V> {
    l := List<V>()
    l.Push(v)
    return l
}
fn main() ? {
    for i in range 5 {
        m := mk(i, Res(i))
        l := lst(Res(i))
        x := try m.Get(i) catch { unreachable }
    }
    println("made " $Made " gone " $Gone)
}
