# NEW, CONFIRMED: segfault. A spawned lambda capturing the receiver that renders text (escape on the closure).
# e27b83b -b: exit 139. 7345ff9: 'b5'. b6259d1: refused (purity).
type Cell struct() {
    v I64 = 3
}
type Bag struct(c mut Cell&) {
    c
}
fn (b Bag&) Str() String {
    join {
        spawn fn() {
            s := $b.c.v "x"
            b.c.v.AtomicAdd(s.Len())
        }
    }
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    println($b)
}
