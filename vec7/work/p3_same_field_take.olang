# p.lx.toks = take p.lx.toks: the target's place read first - is the old value released after the take moved it?
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    p := Parser()
    p.lx = Lexer()
    for i in range 30 { p.lx.toks.Push($i "-word") }
    p.lx.toks = take p.lx.toks
    churn()
    v := Vec<I64>()
    for i in range 40 { v.Push(i) }
    println(p.lx.toks[29])
}
