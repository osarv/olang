# a conversion of a try of a borrowed own result
fn main() ? {
    v := Vec<Char>()
    for i in range 3 { v.Push('a') }
    s := String(try v.RunFrom(0) catch default Array<Char>(1, 'x'))
    for i in range 100 { v.Push('b') }
    z := Vec<I64>()
    for i in range 100 { z.Push(i) }
    println(s)
}
