# ...taken into a local of main
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn (p mut Parser&) Lx() mut Lexer&p { return p.lx }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
GP mut Parser = Parser()
fn words() Vec<String&> { return take GP.Lx().toks }
fn main() ? {
    GP.lx = Lexer()
    for i in range 3 { GP.lx.toks.Push($i "-word-built-in-the-lexer's-region") }
    w := words()
    GP.lx = null
    churn()
    println(w[0])
}
