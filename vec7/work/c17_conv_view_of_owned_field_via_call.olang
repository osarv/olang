# ...the Vec field reached through a borrowed own result call
type Lexer struct() {
    chars Vec<Char> = Vec<Char>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn (p mut Parser&) Lx() mut Lexer&p { return p.lx }
fn main() ? {
    p := Parser()
    p.lx = Lexer()
    for i in range 5 { p.lx.chars.Push('a') }
    s := String(p.Lx().chars.View())
    p.lx = null
    w := Vec<I64>()
    for i in range 100 { w.Push(i) }
    println(s)
}
