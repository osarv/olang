# R1 through a call: a method giving a borrowed own result (the object in p.lx), then 'take' of its Vec field
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn (p mut Parser&) Lx() mut Lexer&p { return p.lx }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn words() Vec<String&> {
    p := Parser()
    p.lx = Lexer()
    for i in range 3 { p.lx.toks.Push($i "-word-built-in-the-lexer's-region") }
    return take p.Lx().toks
}
fn main() ? {
    w := words()
    churn()
    println(w[0])
}
