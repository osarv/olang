type E enum {
    T(s String&)
    N
}
fn main() ? {
    v := Vec<Char>()
    for i in range 3 { v.Push('a') }
    e := E.T(String(v.View()))
    for i in range 100 { v.Push('b') }
    w := Vec<I64>()
    for i in range 100 { w.Push(i) }
    match e {
        case E.T(s) { println(s) }
        case E.N { println("n") }
    }
}
