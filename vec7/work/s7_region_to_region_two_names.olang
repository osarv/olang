# a field moved between two owned lexers held through two different reference locals: region to region, not the same path
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
    more Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    a mut Parser& = Parser()
    b mut Parser& = Parser()
    a.lx = Lexer()
    b.lx = Lexer()
    for i in range 3 { b.lx.toks.Push($i "-word-in-b's-lexer-region") }
    q := a.lx
    q.more = take b.lx.toks
    b.lx = null
    churn()
    println(a.lx.more[0])
}
