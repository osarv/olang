# O26a follows take from a reference local made from a temporary
type Lex struct() {
    toks Vec<String&> = Vec<String&>()
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn mk() Vec<String&> {
    r mut Lex& = Lex()
    for i in range 3 { r.toks.Push($i "-word-in-r's-referent") }
    w := take r.toks
    return w
}
fn main() ? {
    a := mk()
    churn()
    println(a[0])
}
