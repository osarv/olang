# R1 through a match binding of a payload held in the owned object
type Sub struct() {
    toks Vec<String&> = Vec<String&>()
}
type E enum {
    A(s mut Sub&)
    N
}
type Lexer struct() {
    e E = E.N
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    p := Parser()
    p.lx = Lexer()
    p.lx.e = E.A(Sub())
    for i in range 3 { p.lx.toks.Push($i "-word-in-the-lexer's-region") }
    d := Parser()
    d.lx = Lexer()
    match p.lx.e {
        case E.A(s) { s.toks = take p.lx.toks }
        case E.N { }
    }
    match p.lx.e {
        case E.A(s) { d.lx.toks = take s.toks }
        case E.N { }
    }
    p.lx = null
    churn()
    println(d.lx.toks[0])
}
