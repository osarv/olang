# a conversion of a conditional of two views - retyped in place now (a conditional of array references)
fn main() ? {
    v := Vec<Char>()
    w := Vec<Char>()
    for i in range 3 { v.Push('a') }
    for i in range 3 { w.Push('c') }
    c := v.Len() > 1
    s := String(v.View() if c else w.View())
    for i in range 100 { v.Push('b') }
    z := Vec<I64>()
    for i in range 100 { z.Push(i) }
    println(s)
}
