# P2 (o4, settleTaskStandins) + mbiMemo.deps: cc's answer for its scope is "builds nothing" because the cycle ca/cb read
# ca's in-progress deps as 0 (as c1); the re-ask loop later turns cb to "yes" but never revisits ca or cc. So each task is
# handed the spawner's block scope raw, and four tasks allocate in it with no lock.
# expected 4200. new -b: 4325, 4281, 4368, 4364, 4331; -b -r: ThreadSanitizer data race in __olang_scope_alloc_a
# (lambda -> ca -> cb -> ...). e27b83b and be042da: 4200 every run
type Node struct(v I64) {
    v
    next mut Node& = null
}
fn ca(g fn(x mut Node&), n mut Node&, c I64) {
    if c > 0 { cb(n, c - 1) }
    g(n)
}
fn cb(n mut Node&, c I64) {
    ca(fn(x mut Node&) { x.next = Node(x.v + 1) }, n, c)
}
fn cc(n mut Node&) { ca(fn(x mut Node&) { }, n, 400) }
fn main() ? {
    total I64 = 0
    for r in range 300 {
        a := Node(1)
        b := Node(2)
        c := Node(3)
        d := Node(4)
        join {
            spawn cc(a)
            spawn cc(b)
            spawn cc(c)
            spawn cc(d)
        }
        total += a.next.v + b.next.v + c.next.v + d.next.v
    }
    println($total)
}
