# E11c walk + O23a (since decision 49 round 2-3, not closed): a callback handed elements read through a "&p" field of a view
# over the receiver's array builds where those elements live. The walk does not see it (the element's scope is taken to be
# the view's - PE2), so Str is accepted and the node is built in a scope that closes. new and e27b83b -b -s: "use after
# scope closed" (134); new -b: "99 0"; -i: "103 0"; be042da: refused (purity)
type Node struct(v I64) {
    v
    next mut Node& = null
}
type View struct(ns Array<mut Node&>&) {
    at Array<mut Node&>&ns = ns
}
type Bag struct(ns Array<mut Node&>&) {
    ns
}
fn visit(w View&, g fn(x mut Node&)) {
    for x in w.at { g(x) }
}
fn (b Bag&) Str() String {
    visit(View(b.ns), fn(x mut Node&) { x.next = Node(x.v + 100) })
    return "b" $b.ns[0].v
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    b := Bag(Array<mut Node&>(1, Node(3)))
    println($b)
    t := churn(100)
    println($b.ns[0].next.v " " $t)
}
