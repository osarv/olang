# HELD (-b -r): a task callee building in a "try join" clause - stand-in made, no race, "1400"
type Node struct(v I64) {
    v
    next mut Node& = null
}
error Bad { NO }
fn bad(k I64) ? Bad { if k >= 0 { error Bad.NO } }
fn work(n mut Node&) {
    for j in range 50 {
        try join { spawn try bad(j) } catch Bad { n.next = Node(n.v + 1) }
    }
}
fn main() ? {
    total I64 = 0
    for r in range 100 {
        a := Node(1)
        b := Node(2)
        c := Node(3)
        d := Node(4)
        join {
            spawn work(a)
            spawn work(b)
            spawn work(c)
            spawn work(d)
        }
        total += a.next.v + b.next.v + c.next.v + d.next.v
    }
    println($total)
}
