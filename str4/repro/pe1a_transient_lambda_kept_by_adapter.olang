# PRE-EXISTING (e27b83b, be042da): a capturing lambda handed to a callee that "keeps nothing of it" (SemanticParamTransient,
# read off obligations) gets its environment in the caller's frame - but the callee hands it to a function value, a Keeper
# whose Call stores it, and a call through a function value records no obligation. After fill returns, kp.kept() reads
# a dead frame: -b -d prints "18 0" on new and be042da, "300 0" on e27b83b (garbage text under -b on new); -i prints "20 0"
type Node struct(v I64) {
    v
}
type Keeper struct() {
    kept fn() I64 = null
}
fn (k mut Keeper&) Call(x fn() I64) { k.kept = x }
fn keepVia(s fn(x fn() I64), g fn() I64) { s(g) }
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn fill(n Node&, kp mut Keeper&) {
    k := n.v
    keepVia(kp, fn() I64 { return n.v + k })
}
fn main() ? {
    n := Node(10)
    kp := Keeper()
    fill(n, kp)
    t := churn(300)
    println($kp.kept() " " $t)
}
