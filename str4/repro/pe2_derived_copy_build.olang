# PRE-EXISTING (be042da too, no Str involved): a reference read through a "&p" field, copied into a local (or a for-in
# element), then handed to a callee that builds through it. "grow(w.at[0])" is refused (C2d); the copy is not, and the
# node is built in the view's own scope (work's block), not where the element lives. new and be042da -b -s: "use after
# scope closed"; -b: "100 0"; -i: "103 0"
type Node struct(v I64) {
    v
    next mut Node& = null
}
type View struct(ns Array<mut Node&>&) {
    at Array<mut Node&>&ns = ns
}
fn grow(x mut Node&) { x.next = Node(x.v + 100) }
fn visit(w View&) {
    x := w.at[0]
    grow(x)
}
fn work(a Array<mut Node&>&) { visit(View(a)) }
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    a := Array<mut Node&>(1, Node(3))
    work(a)
    t := churn(100)
    println($a[0].next.v " " $t)
}
