# HELD: a frame lambda returning a closure (built where it lands, heap), a lambda passed to a frame lambda (heap, it
# escapes); -b -s and -i print "10 20 0". The form whose inner closure captures a reference is refused with T22a.
type Node struct(v I64) {
    v
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn maker(n Node&) I64 {
    k := n.v * 2
    f := fn() fn() I64 { return fn() I64 { return k } }
    g := f()
    return g()
}
fn maker2(n Node&) I64 {
    f := fn(h fn() I64) I64 { return h() + n.v }
    g := fn() I64 { return n.v * 3 }
    return f(g)
}
fn main() ? {
    n := Node(5)
    t := churn(300)
    println($maker(n) " " $maker2(n) " " $t)
}
