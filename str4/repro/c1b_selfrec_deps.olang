# may-build walk (mbiMemo.deps): a recursive call reads its own in-progress memo's deps as 0, so the callback it passes
# itself is never asked about - Str hands a non-building callback, the recursion hands a building one.
# new -b: "b1 / 100 0"; -b -s: "use after scope closed" (134); -i: "b1 / 101 0". e27b83b: error[E11c, O12]
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(head mut Node&) {
    head
}
fn rec(g fn(x mut Node&), n mut Node&, c I64) {
    if c > 0 { rec(fn(x mut Node&) { x.next = Node(x.v + 100) }, n, c - 1) }
    g(n)
}
fn (b Bag&) Str() String {
    rec(fn(x mut Node&) { }, b.head, 1)
    return "b" $b.head.v
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    b := Bag(Node(1))
    println($b)
    t := churn(100)
    println($b.head.next.v " " $t)
}
