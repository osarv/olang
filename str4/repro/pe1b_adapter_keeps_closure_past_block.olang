# PRE-EXISTING (be042da too): T22a refuses a lambda that keeps its parameter beyond the call, but a Call adapter whose Call
# does the same fits the function type - so a closure over a block-local node is kept past its block.
# new and be042da, -b -s: "use after scope closed" (exit 134); new -b -d prints "101 0" where -i prints "11 0"
type Node struct(v I64) {
    v
}
type Keeper struct() {
    kept fn() I64 = null
}
fn (k mut Keeper&) Call(x fn() I64) { k.kept = x }
fn apply(s fn(x fn() I64), g fn() I64) { s(g) }
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 40 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    kp := Keeper()
    s fn(x fn() I64) = kp
    {
        m := Node(10)
        s(fn() I64 { return m.v + 1 })
    }
    t := churn(100)
    println($kp.kept() " " $t)
}
