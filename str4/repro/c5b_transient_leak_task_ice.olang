# may-build walk: mbiTransient (set while walking a capturing lambda passed to a callee that keeps nothing of it) is
# never reset on entering that lambda's own body, so the closure the lambda makes where its capture lives is skipped and
# the lambda's memo says "builds nothing" - codegen then holds the lambda to it. No Str is involved: settleTaskStandins
# asks it for an ordinary task, and a valid program stops with an internal compiler error (e27b83b and be042da: "4")
type Node struct(v I64) {
    v
}
fn apply(f fn() I64) I64 { return f() }
fn work(n Node&) I64 {
    return apply(fn() I64 {
        h := fn() I64 { return n.v }
        t := h is h
        return h() if t else 0
    })
}
fn main() ? {
    n := Node(4)
    x I64 = 0
    join { spawn x = work(n) }
    println($x)
}
