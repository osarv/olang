# crc32 - the CRC-32 checksum of zlib, gzip, PNG and Ethernet (the IEEE polynomial, reflected, 0xEDB88320): four bytes
# that catch any burst of errors up to 32 bits long, for checking a transfer or a file - not for anything an attacker
# chooses (sha256 is for that). Table-driven, a byte at a time; the table is computed while compiling (K2). Imported with
# `import "std/crc32"`.

fn makeTable() Array<U32> {
    t := Array<U32>(256)
    for i in range 256 {
        c := U32(i)
        for _ in range 8 { c = (c >> 1) ^ 0xEDB88320 if (c & 1) == 1 else c >> 1 }
        t[i] = c
    }
    return t
}

table Array<U32> = makeTable()

# the checksum of what crc was taken of followed by data - so a checksum is taken a piece at a time, starting from 0:
# "c := crc32.Update(0, a)" then "c = crc32.Update(c, b)"
fn Update(crc U32, data Array<U8>&) U32 {
    c := ~crc
    for b in data { c = table[(c ^ U32(b)) & 0xFF] ^ (c >> 8) }
    return ~c
}

# the checksum of data
fn Checksum(data Array<U8>&) U32 { return Update(0, data) }

if TestBuild {

Check U32 = Checksum("123456789")

test "the CRC-32 check value, and pieces" {
    assert Check == 0xCBF43926 and Checksum("") == 0
    assert Checksum("The quick brown fox jumps over the lazy dog") == 0x414FA339
    s := "The quick brown fox jumps over the lazy dog"
    assert Update(Update(0, s[:10]), s[10:]) == Checksum(s)
}

}
