# rand - a seeded pseudo-random generator: rand.Rand(seed), xoshiro256** (Blackman and Vigna, 2018), its state seeded
# through splitmix64 as its authors recommend. Fast (a few instructions per number), 256 bits of state, statistically
# strong, and reproducible: one seed gives one sequence on every machine, so a simulation's draws, a network's
# initialization and a dataset's shuffling can be repeated exactly. Not for anything secret.
#
# One generator is shared by whatever draws from it - a caller hands its own to whatever fills from it, so one seed
# decides a whole run. A generator is an ordinary value: two copies continue the same sequence independently.


# splitmix64's output function: a bijection scattering the bits of x
fn mix64(x U64) U64 {
    z U64 = x
    z = (z ^ (z >> 30)) * U64(0xBF58476D1CE4E5B9)
    z = (z ^ (z >> 27)) * U64(0x94D049BB133111EB)
    return z ^ (z >> 31)
}

golden U64 = 11400714819323198485        # 2^64 / the golden ratio, splitmix64's increment

# a generator whose sequence is decided by "seed" alone: the first four outputs of splitmix64 from it
type Rand struct(seed U64) {
    s0 U64 = mix64(seed + golden)
    s1 U64 = mix64(seed + 2 * golden)
    s2 U64 = mix64(seed + 3 * golden)
    s3 U64 = mix64(seed + 4 * golden)
}

# the next 64 random bits
fn (r mut Rand&) Next() U64 {
    out U64 = (r.s1 * 5).RotateLeft(7) * 9
    t U64 = r.s1 << 17
    r.s2 = r.s2 ^ r.s0
    r.s3 = r.s3 ^ r.s1
    r.s1 = r.s1 ^ r.s2
    r.s0 = r.s0 ^ r.s3
    r.s2 = r.s2 ^ t
    r.s3 = r.s3.RotateLeft(45)
    return out
}

# the generator's whole state, its four 64-bit words - what a checkpoint keeps so that SetState can put a generator back
# exactly where this one is, to continue the same sequence, rather than replaying every draw made since its seed
fn (r Rand&) State() Array<U64> {
    s := Array<U64>(4)
    s[0] = r.s0
    s[1] = r.s1
    s[2] = r.s2
    s[3] = r.s3
    return s
}

# what SetState fails with: four zeros, which no generator's state is, or other than four words; and what a draw from
# an array fails with: no element to draw (Empty), or more than it has drawn without replacement (TooFew)
type Error error {
    ZeroState
    WrongLength
    Empty
    TooFew
}

# puts the generator in the state "s", one State gave: from here it draws what the generator State was asked of drew
# after it. Four zeros are no state xoshiro256** can be in - from them it would give zeros forever, and State never
# gives them - so they fail with ZeroState, and other than four words with WrongLength, the generator left as it was
fn (r mut Rand&) SetState(s Array<U64>&) ? Error {
    if s.Len() != 4 { error Error.WrongLength }
    if s[0] == 0 and s[1] == 0 and s[2] == 0 and s[3] == 0 { error Error.ZeroState }
    r.s0 = s[0]
    r.s1 = s[1]
    r.s2 = s[2]
    r.s3 = s[3]
}

# a uniform integer in [0, n), n > 0 - unbiased: a draw from the incomplete last stretch of 2^64 is drawn again
fn (r mut Rand&) Below(n I64) I64 {
    m := U64(n)
    limit U64 = U64(0) - (U64(0) - m) % m        # the largest multiple of m that fits, wrapping to 0 for m = 2^k
    for {
        x := r.Next()
        if limit == 0 or x < limit { return I64(x % m) }
    }
    unreachable
}

# a uniform F64 in [0, 1), with all 53 bits of the mantissa random
fn (r mut Rand&) Float() F64 {
    return F64(r.Next() >> 11) * (1.0 / 9007199254740992.0)
}

# a uniform F64 in [lo, hi)
fn (r mut Rand&) Uniform(lo F64, hi F64) F64 {
    return lo + (hi - lo) * r.Float()
}

# a normally distributed F64 with the mean and standard deviation given, 0 and 1 by default (Box-Muller; the second
# value of each pair is dropped, which costs a logarithm and a square root per number and keeps the generator's state
# its only state)
fn (r mut Rand&) Normal(mean F64 = 0.0, sd F64 = 1.0) F64 {
    u F64 = 1.0 - r.Float()                       # in (0, 1], so its logarithm is finite
    v := r.Float()
    return mean + sd * (-2.0 * u.Log()).Sqrt() * (2.0 * Pi * v).Cos()
}

# n normally distributed F64s, as Normal draws them one after another (numpy's normal(mean, sd, n))
fn (r mut Rand&) Normals(n I64, mean F64 = 0.0, sd F64 = 1.0) Array<F64> {
    return Array<F64>[r.Normal(mean, sd) for _ in range n]
}

# n uniform F64s in [lo, hi), as Uniform draws them one after another (numpy's uniform(lo, hi, n))
fn (r mut Rand&) Uniforms(n I64, lo F64 = 0.0, hi F64 = 1.0) Array<F64> {
    return Array<F64>[r.Uniform(lo, hi) for _ in range n]
}

# one element of "a", each as likely - failing with Empty where it has none
fn (r mut Rand&) Choice<T>(a Array<T>&) T ? Error.Empty {
    if a.Len() == 0 { error Error.Empty }
    return a[r.Below(a.Len())]
}

# k elements of "a" drawn with replacement, so one may come again (Python's random.choices) - failing with Empty where
# it has none and k is above zero
fn (r mut Rand&) Choices<T>(a Array<T>&, k I64) Array<T> ? Error.Empty {
    if k > 0 and a.Len() == 0 { error Error.Empty }
    return Array<T>[a[r.Below(a.Len())] for _ in range k]
}

# k elements of "a" drawn without replacement, in the order drawn (Python's random.sample): k different positions -
# failing with TooFew where "a" has fewer than k
fn (r mut Rand&) Sample<T>(a Array<T>&, k I64) Array<T> ? Error.TooFew {
    if k > a.Len() { error Error.TooFew }
    order := Array<I64>[i for i in range a.Len()]
    for i in range k {
        j := i + r.Below(a.Len() - i)              # Fisher-Yates, stopped after k places
        t := order[i]
        order[i] = order[j]
        order[j] = t
    }
    return Array<T>[a[order[i]] for i in range k]
}

# puts the elements of "a" in a uniformly random order (Fisher-Yates), in place
fn (r mut Rand&) Shuffle<T>(a mut Array<T>&) {
    i I64 = a.Len() - 1
    for i > 0 {
        j := r.Below(i + 1)
        t := a[i]
        a[i] = a[j]
        a[j] = t
        i--
    }
}

test "the first numbers are xoshiro256** seeded by splitmix64" {
    # splitmix64 from 0 gives 0xE220A8397B1DCDAF first, as its reference implementation does
    assert mix64(golden) == 16294208416658607535
    r := Rand(0)
    a := r.Next()
    b := r.Next()
    assert a != b
    again := Rand(0)
    assert again.Next() == a and again.Next() == b
    other := Rand(1)
    assert other.Next() != a
}

test "from the state 1, 2, 3, 4 xoshiro256** gives its reference outputs" {
    r := Rand(0)
    r.s0 = 1
    r.s1 = 2
    r.s2 = 3
    r.s3 = 4
    assert r.Next() == 11520 and r.Next() == 0 and r.Next() == 1509978240 and r.Next() == 1215971899390074240
}

# a generator restored from a saved state draws what the saved one did after it was saved - into another generator, or
# into the same one after it has drawn on
fn restoredDraws() U64 {
    r := Rand(2024)
    for _ in range 5 { r.Next() }
    saved := r.State()
    a := r.Next()
    b := r.Below(1000)
    c := r.Float()
    other := Rand(1)
    try other.SetState(saved) catch { unreachable }
    assert other.Next() == a and other.Below(1000) == b and other.Float() == c
    for _ in range 100 { r.Next() }
    try r.SetState(saved) catch { unreachable }
    assert r.Next() == a and r.State()[0] != saved[0]
    return a
}

restoredBaked := restoredDraws()

test "State and SetState put a generator back where it was, evaluated while compiling as at run time" {
    assert restoredDraws() == restoredBaked
    r := Rand(9)
    s := r.State()
    fresh := Rand(9)
    assert s[0] == fresh.s0 and s[1] == fresh.s1 and s[2] == fresh.s2 and s[3] == fresh.s3
    s[0] = 1
    s[1] = 2
    s[2] = 3
    s[3] = 4
    try r.SetState(s)
    assert r.Next() == 11520 and r.Next() == 0 and r.Next() == 1509978240     # the reference outputs from 1, 2, 3, 4
}

test "Below is uniform and in range" {
    r := Rand(42)
    counts := Array<I64>(10)
    for _ in range 100000 {
        k := r.Below(10)
        assert k >= 0 and k < 10
        counts[k]++
    }
    for c in counts { assert c > 9500 and c < 10500 }
    for _ in range 1000 { assert r.Below(1) == 0 }
}

test "Float lies in [0, 1) with the mean of a uniform" {
    r := Rand(7)
    sum F64 = 0.0
    for _ in range 100000 {
        x := r.Float()
        assert x >= 0.0 and x < 1.0
        sum += x
    }
    mean F64 = sum / 100000.0
    assert mean > 0.49 and mean < 0.51
}

test "Normal has mean 0 and standard deviation 1" {
    r := Rand(3)
    n I64 = 200000
    sum F64 = 0.0
    sq F64 = 0.0
    for _ in range n {
        x := r.Normal()
        sum += x
        sq += x * x
    }
    mean F64 = sum / F64(n)
    sd := (sq / F64(n) - mean * mean).Sqrt()
    assert mean > -0.01 and mean < 0.01
    assert sd > 0.99 and sd < 1.01
}

test "Shuffle permutes, and one seed gives one order" {
    a := Array<I64>(1000)
    for i in range 1000 { a[i] = i }
    r := Rand(11)
    r.Shuffle(a)
    seen := Array<Bool>(1000)
    moved I64 = 0
    for i, x in a {
        assert not seen[x]
        seen[x] = true
        if x != i { moved++ }
    }
    assert moved > 900
    b := Array<I64>(1000)
    for i in range 1000 { b[i] = i }
    again := Rand(11)
    again.Shuffle(b)
    for i in range 1000 { assert a[i] == b[i] }
}

# draws over arrays, the same while compiling as at run time
fn drawsOverArrays() F64 {
    r := Rand(5)
    xs := r.Normals(4, 10.0, 0.0)               # a deviation of zero: every draw the mean
    us := r.Uniforms(3, 2.0, 3.0)
    pick := try r.Choice(Array<I64>[7, 8, 9]) catch { unreachable }
    many := try r.Choices(Array<I64>[4], 3) catch { unreachable }
    some := try r.Sample(Array<I64>[1, 2, 3, 4, 5], 5) catch { unreachable }
    assert xs.Sum() == 40.0 and us.Every(fn(u): return u >= 2.0 and u < 3.0) and pick >= 7 and pick <= 9
    assert many == Array<I64>[4, 4, 4] and some.Sum() == 15
    return us[0]
}

drawsBaked := drawsOverArrays()

test "Normals, Uniforms, Choice, Choices and Sample draw over arrays, while compiling as at run time" {
    assert drawsOverArrays() == drawsBaked
    r := Rand(8)
    xs := r.Normals(100000, 5.0, 2.0)
    m := xs.Sum() / 100000.0
    assert m > 4.97 and m < 5.03
    seen := Array<Bool>(10)
    for x in try r.Sample(Array<I64>[i for i in range 10], 10) {
        assert not seen[x]
        seen[x] = true
    }
    empty := Array<I64>(0)
    got := try r.Choice(empty) catch Error.Empty { return }
    assert false, "a draw from nothing gave " $got
}
