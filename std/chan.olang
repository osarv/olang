# chan - a bounded, blocking channel. Ordinary olang over pthread.h imported (§11 X17), with no help from the
# compiler at all: the same claim io.olang makes, held to for the one type that most obviously wants to be a builtin.
#
# pthread's mutex and condition variables are pthread.h's own types, as the header lays them out for the target - held
# in the channel's record, where they never move (pthread needs their address to stay the one they were initialised
# at), and private, their bytes pthread's: no module but this one names them, and this one only hands them to pthread.

import "cancel"
import "time"
import pthread "pthread.h"
import ctime "time.h"


# This type synchronises its own state, which is exactly what no compile-time rule could know. It used to
# say so with a "shared" marker waiving P3's exclusivity for the whole type - a claim nothing verified.
# Both are gone now: P3 could never be sound without an ownership discipline this language does not have,
# so it stopped claiming and was then removed outright, and an exemption from a rule that no longer exists
# has nothing to mean. A channel handed to a producer and a consumer is once again just a channel.
#
# A channel's capacity is how many values it holds before Send blocks. Capacity 0 is a RENDEZVOUS, as an unbuffered
# channel is in Go: Send hands its value over directly, returning only once a Recv has taken it. Underneath it is a
# one-slot ring whose sender then waits for that one value to be taken - values are taken in the order they were
# placed, so a sender knows its own by counting (sent, taken). A negative capacity is out of range, as an array's
# length is (D14b).
#
# Close says no more values will be sent: what is buffered is still received, in order, and after that Recv and
# RecvUntil fail with Error.CLOSED, and "for v in c" ends. The side that sends is the side that closes - after its
# last Send, or after joining every task that sends - so a Send on a closed channel, or one still blocked when the
# channel closes, is a mistake in the program, and fails with Error.CLOSED (std stops no program for a caller's
# mistake). Closing twice changes nothing.
#
# What is sent lives where the channel does, being stored in it (O6): a value holding references - text, say - sent
# through a channel that outlives the loop sending it stays there until the channel's scope closes (O8c), however
# long ago it was received. A program streaming text indefinitely sends something that holds none (an index, a number)
# or gives each batch a channel of its own, in a block that ends.
type Chan<T> struct(cap I64) {
        # the ring buffer, and the two cursors into it. A bare "&" field lives where the channel does
        # (C2d), which is what a run-time-sized field needs. It is made by the first send, filled with what is sent,
        # so the elements need no zero value (T2c: a reference never null has none)
    size I64 = 1 if cap == 0 else cap
    data mut Array<T>& = Array<T>(0)
    head I64 = 0
    tail I64 = 0
    count I64 = 0
    rendezvous Bool = cap == 0
    sent I64 = 0
    taken I64 = 0
    closed Bool = false
    waiting I64 = 0     # the receivers blocked waiting for a value: what a rendezvous send of Select's hands its value to
    lock pthread.pthread_mutex_t
    notEmpty pthread.pthread_cond_t
    notFull pthread.pthread_cond_t
}

# a channel must be initialised before use: a constructor cannot call these, because pthread wants the
# final address of the mutex and the constructed value has not reached its home yet.
fn Init<T>(c mut Chan<T>&) {
    pthread.pthread_mutex_init(c.lock, null)
    pthread.pthread_cond_init(c.notEmpty, null)
    pthread.pthread_cond_init(c.notFull, null)
}

# v into the ring, the lock held and a slot free; returns its ticket - how many values were placed before it
fn place<T>(c mut Chan<T>&, v T) I64 {
    if c.data.Len() == 0 { c.data = Array<T>(c.size, v) }
    c.data[c.tail] = v
    c.tail = (c.tail + 1) % c.size
    c.count = c.count + 1
    c.sent = c.sent + 1
    pthread.pthread_cond_broadcast(c.notEmpty)
    return c.sent - 1
}

# the oldest value out of the ring, the lock held and the ring not empty
fn oldest<T>(c mut Chan<T>&) T {
    v := c.data[c.head]
    c.head = (c.head + 1) % c.size
    c.count = c.count - 1
    c.taken = c.taken + 1
    pthread.pthread_cond_broadcast(c.notFull)   # a sender waiting for a slot, or for its value to be taken
    return v
}

# the failure of a Recv on a closed channel with nothing left in it
type Error error {
    CLOSED
}

# no more values will be sent: what is buffered is still received, then Recv fails with Error.CLOSED. Wakes every
# task waiting on the channel. Closing a closed channel changes nothing.
fn Close<T>(c mut Chan<T>&) {
    pthread.pthread_mutex_lock(c.lock)
    c.closed = true
    pthread.pthread_cond_broadcast(c.notEmpty)
    pthread.pthread_cond_broadcast(c.notFull)
    pthread.pthread_mutex_unlock(c.lock)
}

# whether Close has been called. A channel open now may be closed by the time the answer is used - a receiver learns
# that it has ended from Recv's error, never from this
fn IsClosed<T>(c mut Chan<T>&) Bool {
    pthread.pthread_mutex_lock(c.lock)
    closed := c.closed
    pthread.pthread_mutex_unlock(c.lock)
    return closed
}

# a Send, the lock held: fails with CLOSED if the channel is closed - the lock let go first, so the channel stays usable
fn sendOpen<T>(c mut Chan<T>&) ? Error {
    if c.closed {
        pthread.pthread_mutex_unlock(c.lock)
        error Error.CLOSED
    }
}

# a rendezvous Send whose value is still in the slot when the channel closes withdraws it - the slot holds only that
# value, as values leave in order and none was placed after it while the slot was full - and so never completed
fn withdraw<T>(c mut Chan<T>&) {
    c.tail = 0
    c.count = 0
    c.sent = c.sent - 1
    pthread.pthread_cond_broadcast(c.notFull)
}

# blocks while the channel is full, then appends - and on a rendezvous channel, blocks again until the value has been
# taken. A condition variable may wake spuriously, so each wait is in a loop re-reading the count under the lock.
fn Send<T>(c mut Chan<T>&, v T) ? Error {
    pthread.pthread_mutex_lock(c.lock)
    for c.count == c.size and not c.closed {
        pthread.pthread_cond_wait(c.notFull, c.lock)
    }
    try sendOpen(c)
    ticket := place(c, v)
    for c.rendezvous and c.taken <= ticket and not c.closed {
        pthread.pthread_cond_wait(c.notFull, c.lock)
    }
    if c.rendezvous and c.taken <= ticket {
        withdraw(c)
        try sendOpen(c)
    }
    pthread.pthread_mutex_unlock(c.lock)
}

# blocks while the channel is empty and open, then takes the oldest value; fails with Error.CLOSED once the
# channel is closed and everything sent before has been taken
fn Recv<T>(c mut Chan<T>&) T ? Error {
    pthread.pthread_mutex_lock(c.lock)
    c.waiting++
    for c.count == 0 and not c.closed {
        pthread.pthread_cond_wait(c.notEmpty, c.lock)
    }
    c.waiting--
    if c.count == 0 {
        pthread.pthread_mutex_unlock(c.lock)
        error Error.CLOSED
    }
    v := oldest(c)
    pthread.pthread_mutex_unlock(c.lock)
    return v
}

# a channel is its own iterator (S9a): "for v in c" receives until the channel is closed and drained - Recv, with the
# end of a closed channel as the end of the walk
fn (c mut Chan<T>&) Next() T ? Exhausted {
    return try Recv(c) catch Error { error Exhausted.END }
}

# Send, giving up - with the token's reason - once the token fires while the channel is still full, or, on a
# rendezvous channel, while the value has not been taken yet: it is withdrawn, so a value either reached a Recv or
# was never sent. The wait wakes at the token's deadline, and every few milliseconds besides to notice a Cancel()
# (cancel.WakeAt).
fn SendUntil<T>(c mut Chan<T>&, v T, tok cancel.Token&) ? cancel.Stopped, Error {
    ts := Array<I64>(2)
    pthread.pthread_mutex_lock(c.lock)
    for c.count == c.size and not c.closed {
        if tok.Cancelled() {
            pthread.pthread_mutex_unlock(c.lock)
            try tok.Reason()
        }
        tok.WakeAt(ts)
        pthread.pthread_cond_timedwait(c.notFull, c.lock, ts)
    }
    try sendOpen(c)
    ticket := place(c, v)
    for c.rendezvous and c.taken <= ticket and not c.closed {
        if tok.Cancelled() {
            withdraw(c)
            pthread.pthread_mutex_unlock(c.lock)
            try tok.Reason()
        }
        tok.WakeAt(ts)
        pthread.pthread_cond_timedwait(c.notFull, c.lock, ts)
    }
    if c.rendezvous and c.taken <= ticket {
        withdraw(c)
        try sendOpen(c)
    }
    pthread.pthread_mutex_unlock(c.lock)
}

# Recv, giving up - with the token's reason - once the token fires while the channel is still empty and open; fails
# with Error.CLOSED once it is closed and drained
fn RecvUntil<T>(c mut Chan<T>&, tok cancel.Token&) T ? cancel.Stopped, Error {
    ts := Array<I64>(2)
    pthread.pthread_mutex_lock(c.lock)
    for c.count == 0 and not c.closed {
        if tok.Cancelled() {
            pthread.pthread_mutex_unlock(c.lock)
            try tok.Reason()
        }
        tok.WakeAt(ts)
        c.waiting++
        pthread.pthread_cond_timedwait(c.notEmpty, c.lock, ts)
        c.waiting--
    }
    if c.count == 0 {
        pthread.pthread_mutex_unlock(c.lock)
        error Error.CLOSED
    }
    v := oldest(c)
    pthread.pthread_mutex_unlock(c.lock)
    return v
}

# a producer and a consumer on separate tasks, communicating only through the channel. This is the shape
# P3 used to reject and "shared" used to un-reject: one channel handed to both as "mut Chan<I32>&".
# Nothing about it is checked - the correctness is the mutex's, which is where it belongs.
fn produce(c mut Chan<I32>&, n I32) {
    for i in range n {
        try Send(c, i) catch { return }
    }
}

fn consume(c mut Chan<I32>&, n I32, total mut sumBox&) {
    for _ in range n {
        total.v = total.v + (Recv(c)!)
    }
}

type sumBox struct(start I32) {
    v I32 = start
}

test "a bounded channel carries values between two tasks" {
    c mut Chan<I32>& = Chan<I32>(4)
    Init(c)
    total mut sumBox& = sumBox(0)
    join {
        spawn produce(c, 100)
        spawn consume(c, 100, total)
    }
        # 0 + 1 + ... + 99
    assert total.v == 4950
}

# and the same channel used sequentially, which exercises the ring buffer wrapping several times over
test "the ring buffer wraps" {
    c mut Chan<I32>& = Chan<I32>(4)
    Init(c)
    total mut sumBox& = sumBox(0)
    for _ in range 5 {
        produce(c, 4)
        consume(c, 4, total)
    }
    assert total.v == 30
}

test "a wait with a token returns what is there, and gives up when the deadline passes" {
    c mut Chan<I32>& = Chan<I32>(1)
    Init(c)
    tok := cancel.After(30)
    try SendUntil(c, 5, tok)
    assert (try RecvUntil(c, tok) catch default -1) == 5
    start := cancel.NowNs()
    v := try RecvUntil(c, tok) catch cancel.Stopped.TIMED_OUT default -2 catch default -3
    assert v == -2
    assert cancel.NowNs() - start >= 20000000
    try SendUntil(c, 1, tok)
    try SendUntil(c, 2, tok) catch cancel.Stopped.TIMED_OUT { return }
    unreachable
}

fn waitFor(c mut Chan<I32>&, tok cancel.Token&, got mut sumBox&) {
    got.v = try RecvUntil(c, tok) catch cancel.Stopped.CANCELLED default -1 catch default -2
}

test "Cancel wakes a task blocked in a wait" {
    c mut Chan<I32>& = Chan<I32>(1)
    Init(c)
    tok mut cancel.Token& = cancel.Token()
    got mut sumBox& = sumBox(0)
    start := cancel.NowNs()
    join {
        spawn waitFor(c, tok, got)
        for cancel.NowNs() - start < 5000000 { }
        tok.Cancel()
    }
    assert got.v == -1
    assert cancel.NowNs() - start < 1000000000
}

# P4: a task's wait may fail - RecvUntil when its token is cancelled - and the error reaches the join, which a "try join"
# takes (its clause leaving, since the target is left unwritten, P4d); or the task's own clause gives the target a value
fn recvOrStop(c mut Chan<I32>&, tok mut cancel.Token&) I32 {
    v I32 = 0
    start := cancel.NowNs()
    try join {
        spawn v = try RecvUntil(c, tok)
        for cancel.NowNs() - start < 5000000 { }
        tok.Cancel()
    } catch cancel.Stopped.CANCELLED { return -1 } catch { return -2 }
    return v
}

test "P4: a task cancelled in RecvUntil fails into its join, or takes its own default" {
    c mut Chan<I32>& = Chan<I32>(1)
    Init(c)
    assert recvOrStop(c, cancel.Token()) == -1
    tok mut cancel.Token& = cancel.Token()
    v, w I32
    join {
        spawn v = try RecvUntil(c, tok) catch cancel.Stopped.CANCELLED default -1 catch default -2
        spawn w = try Recv(c) catch default -3
        try Send(c, 7) catch { unreachable }
        tok.Cancel()
        Close(c)                             # what is buffered is still taken, then a Recv fails
    }
    # Recv may take the 7 first; RecvUntil then sees the cancel or the close, whichever it notices first
    assert (v == 7 and w == -3) or ((v == -1 or v == -2) and w == 7)
}

# a channel of any element type - here a struct, carried by value, and text, each across tasks
type reading struct(sensor I32, value F64) {
    sensor
    value
}

fn sendReadings(c mut Chan<reading>&, n I32) {
    for i in range n { try Send(c, reading(i, F64(i) * 0.5)) catch { return } }
}

fn sumReadings(c mut Chan<reading>&, n I32, total mut sumBox&) {
    for _ in range n {
        r := Recv(c)!
        total.v = total.v + r.sensor
    }
}

test "a channel carries any element type" {
    c mut Chan<reading>& = Chan<reading>(3)
    Init(c)
    total mut sumBox& = sumBox(0)
    join {
        spawn sendReadings(c, 50)
        spawn sumReadings(c, 50, total)
    }
    assert total.v == 1225
    f mut Chan<F64>& = Chan<F64>(2)
    Init(f)
    try Send(f, 1.5)
    try Send(f, 2.25)
    assert (try Recv(f)) + (try Recv(f)) == 3.75
    t mut Chan<String&>& = Chan<String&>(2)
    Init(t)
    try Send(t, "one")
    try Send(t, $(1 + 1))
    assert (try Recv(t)) == "one" and (try Recv(t)) == "2"
}

# capacity 0: each Send returns only once its value has been received, so the sender is never more than one value
# ahead of the receiver
fn sendCounting(c mut Chan<I32>&, n I32, sentAll mut sumBox&) {
    for i in range n { try Send(c, i) catch { return } }
    sentAll.v = 1
}

test "a channel of capacity 0 is a rendezvous" {
    c mut Chan<I32>& = Chan<I32>(0)
    Init(c)
    total mut sumBox& = sumBox(0)
    sentAll mut sumBox& = sumBox(0)
    join {
        spawn sendCounting(c, 100, sentAll)
        spawn consume(c, 100, total)
    }
    assert total.v == 4950 and sentAll.v == 1
    # nobody receives, so a send with a deadline gives up - and its value is withdrawn, not left behind
    tok := cancel.After(20)
    try SendUntil(c, 7, tok) catch cancel.Stopped.TIMED_OUT { }
    assert c.count == 0
    tok2 := cancel.After(20)
    assert (try RecvUntil(c, tok2) catch cancel.Stopped.TIMED_OUT default -1 catch default -2) == -1
}

# Close: what was buffered before it is still received, in order, then Recv fails with CLOSED - again on every call
test "a closed channel gives what it holds, then fails with CLOSED" {
    c mut Chan<I32>& = Chan<I32>(4)
    Init(c)
    try Send(c, 1)
    try Send(c, 2)
    try Send(c, 3)
    assert not IsClosed(c)
    Close(c)
    Close(c)                                 # again: nothing changes
    assert IsClosed(c)
    assert (try Recv(c) catch default -1) == 1
    tok := cancel.After(1000)
    assert (try RecvUntil(c, tok) catch default -1) == 2
    sum := 0
    for v in c { sum += v }                  # the rest, then the loop ends
    assert sum == 3
    assert (try Recv(c) catch Error.CLOSED default -7) == -7
    assert (try RecvUntil(c, tok) catch Error.CLOSED default -8 catch cancel.Stopped default -9) == -8
}

# "for v in c" ends at the close: a producer sends and closes, the consumer walks the channel - buffered and rendezvous
fn sendThenClose(c mut Chan<I32>&, n I32) {
    for i in range n { try Send(c, i) catch { return } }
    Close(c)
}

fn walkSum(c mut Chan<I32>&, total mut sumBox&) {
    for v in c { total.v = total.v + v }
}

test "for v in c receives until the channel is closed and drained" {
    for cap in I32[3, 0] {
        c mut Chan<I32>& = Chan<I32>(cap)
        Init(c)
        total mut sumBox& = sumBox(0)
        join {
            spawn sendThenClose(c, 100)
            spawn walkSum(c, total)
        }
        assert total.v == 4950
    }
}

# several receivers blocked on an empty channel are all woken by the close, each ending its loop
fn walkCount(c mut Chan<I32>&, seen mut sumBox&) {
    for _ in c { seen.v.AtomicAdd(1) }
}

test "Close wakes every task waiting to receive, and RecvUntil sees it before its deadline" {
    c mut Chan<I32>& = Chan<I32>(2)
    Init(c)
    seen mut sumBox& = sumBox(0)
    got mut sumBox& = sumBox(0)
    tok := cancel.After(60000)
    start := cancel.NowNs()
    join {
        for _ in range 3 { spawn walkCount(c, seen) }
        spawn waitClosed(c, tok, seen, got)
        for i in range I32(10) { try Send(c, i) }
        Close(c)
    }
    assert seen.v.AtomicLoad() == 10 and got.v == 1
    assert cancel.NowNs() - start < 30000000000
}

fn waitClosed(c mut Chan<I32>&, tok cancel.Token&, seen mut sumBox&, got mut sumBox&) {
    for {
        try RecvUntil(c, tok) catch Error.CLOSED { break } catch cancel.Stopped { return }
        seen.v.AtomicAdd(1)
    }
    got.v = 1
}

# a capacity is a count, an I64 as every length and count is: one computed from a length goes in as it is
test "a channel's capacity is an I64" {
    items := I64[4, 5, 6]
    c mut Chan<I64>& = Chan<I64>(items.Len())
    Init(c)
    for x in items { try Send(c, x) }
    total I64 = 0
    for _ in range items.Len() { total += try Recv(c) catch Error { unreachable } }
    assert total == 15
}

# ---- select ----

# what Select waits on (a channel to receive from, SendOf for a send, time.After's timer): TryNow takes what is ready
# without waiting - failing with Exhausted where nothing is, with E where the case has failed (a closed channel) - and
# Due is the clock reading (time.Now's) at which it is ready by itself, 0 where nothing but another task makes it so
type Case<T ? E> trait {
    mut TryNow() T ? E, Exhausted
    Due() I64
}

# which of Select's cases fired, with what it gave: a received value, a send's nothing (Sent), a timer's reading
type Ready<A, B, C, D> enum {
    First(v A)
    Second(v B)
    Third(v C)
    Fourth(v D)
}

# the value a send case gives when it has fired
type Sent struct() { }

# a send of v on c, as a case of Select: fires once c takes v - a slot free, or on a rendezvous channel a receiver
# waiting for it
type SendOf<T> struct(c mut Chan<T>&, v T) {
    c
    v
}

# what a case Select is not given stands for: never ready, of a value no program can hold
type unused enum { }
type idle struct() { }
fn (i mut idle&) TryNow() unused ? Exhausted { error Exhausted.END }
fn (i idle&) Due() I64 { return 0 }

# the oldest value, without waiting: Exhausted while the channel is empty and open, Error.CLOSED once it is closed and
# drained
fn (c mut Chan<T>&) TryNow() T ? Error, Exhausted {
    pthread.pthread_mutex_lock(c.lock)
    if c.count == 0 {
        closed := c.closed
        pthread.pthread_mutex_unlock(c.lock)
        if closed { error Error.CLOSED }
        error Exhausted.END
    }
    v := oldest(c)
    pthread.pthread_mutex_unlock(c.lock)
    return v
}

fn (c Chan<T>&) Due() I64 { return 0 }

# the send, without waiting for room: Exhausted while the channel is full, Error.CLOSED once it is closed
fn (s mut SendOf<T>&) TryNow() Sent ? Error, Exhausted {
    c := s.c
    pthread.pthread_mutex_lock(c.lock)
    try sendOpen(c)
    if c.count == c.size or (c.rendezvous and c.waiting == 0) {
        pthread.pthread_mutex_unlock(c.lock)
        error Exhausted.END
    }
    ticket := place(c, s.v)
    for c.rendezvous and c.taken <= ticket and not c.closed {
        pthread.pthread_cond_wait(c.notFull, c.lock)
    }
    if c.rendezvous and c.taken <= ticket {
        withdraw(c)
        try sendOpen(c)
    }
    pthread.pthread_mutex_unlock(c.lock)
    return Sent()
}

fn (s SendOf<T>&) Due() I64 { return 0 }

# the first of the cases ready, in the order given, taken - waiting until one is: a received value, a send done, a
# timer's reading, as the Ready case of its position. Two to four cases; one left off is never ready. Fails with what a
# case fails with (Error.CLOSED: a channel received from or sent on is closed). No case is given priority but by its
# position; a wait polls - holding no lock - backing off from a spin to a sleep of a millisecond at most, and wakes for
# the earliest timer it has
fn Select<A, B, C, D, I Case<A ? E>, J Case<B ? E>, K Case<C ? E>, L Case<D ? E> ? E>(a mut I&, b mut J&
    c mut K& = idle(), d mut L& = idle()) Ready<A, B, C, D> ? E {
    round I64 = 0
    for {
        r := try pick(a, b, c, d) catch Exhausted {
            pause(round, earliest(earliest(a.Due(), b.Due()), earliest(c.Due(), d.Due())))
            round++
            continue
        }
        return r
    }
}

# the first case ready, in order, taken; Exhausted where none is
fn pick<A, B, C, D, I Case<A ? E>, J Case<B ? E>, K Case<C ? E>, L Case<D ? E> ? E>(a mut I&, b mut J&, c mut K&
    d mut L&) Ready<A, B, C, D> ? E, Exhausted {
    x := try a.TryNow() catch Exhausted {
        y := try b.TryNow() catch Exhausted {
            z := try c.TryNow() catch Exhausted { return Ready<A, B, C, D>.Fourth(try d.TryNow()) }
            return Ready<A, B, C, D>.Third(z)
        }
        return Ready<A, B, C, D>.Second(y)
    }
    return Ready<A, B, C, D>.First(x)
}

# the earlier of two clock readings a case is due at, 0 standing for none
fn earliest(x I64, y I64) I64 {
    if x == 0: return y
    if y == 0: return x
    return x if x < y else y
}

# a wait between two rounds of Select's: none for the first rounds, then a sleep growing to a millisecond - no longer
# than until due, the earliest timer's reading (0 for none)
fn pause(round I64, due I64) {
    if round < 64: return
    ns I64 = 10000 << (round - 64 if round - 64 < 7 else 7)
    if ns > 1000000: ns = 1000000
    if due > 0 {
        left := due - time.Now()
        if left < ns: ns = left if left > 0 else 0
    }
    if due > 0 and time.IsVirtual() {
        # inside time.Virtual the timer's deadline is reached at once, and what the cases wait for given a millisecond
        time.Reach(due)
        ns = 1000000
    }
    realSleep(ns)
}

# the thread asleep for ns nanoseconds of real time, whatever clock time.Now reads
fn realSleep(ns I64) {
    if ns <= 0: return
    req := ctime.timespec()
    req.tv_sec = ns / 1000000000
    req.tv_nsec = ns % 1000000000
    rem := ctime.timespec()
    ctime.nanosleep(req, rem)
}

fn fill(c mut Chan<I64>&, n I64) {
    for i in range n: try Send(c, i) catch Error { }
}

test Select "takes the first case ready, in order" {
    a := Chan<I64>(4)
    Init(a)
    b := Chan<String&>(4)
    Init(b)
    try Send(b, "hi")
    match try Select(a, b) {
        case Ready.First(_) { unreachable }
        case Ready.Second(s) { assert s == "hi" }
    }
    try Send(a, 7)
    try Send(b, "later")
    # both ready: the first given wins
    match try Select(a, b) {
        case Ready.First(v) { assert v == 7 }
        case Ready.Second(_) { unreachable }
    }
    join { spawn fill(a, 3) }
    got I64 = 0
    for _ in range 4 {
        match try Select(a, b) {
            case Ready.First(v) { got += v }
            case Ready.Second(s) { assert s == "later" }
        }
    }
    assert got == 3
    try Send(a, 5)
    r := try Select(a, b)
    assert r == Ready.First(5) and $r == "Ready.First(5)"
}

fn take(c mut Chan<I64>&, got mut sumBox&) {
    got.v = I32(try Recv(c) catch Error default -1)
}

test Select "sends through SendOf, a rendezvous handing its value to a waiting receiver" {
    full := Chan<I64>(1)
    Init(full)
    try Send(full, 1)
    room := Chan<I64>(1)
    Init(room)
    match try Select(SendOf(full, 2), SendOf(room, 3)) {
        case Ready.First(_) { unreachable }
        case Ready.Second(_) { assert (try Recv(room)) == 3 }
    }
    r := Chan<I64>(0)
    Init(r)
    got mut sumBox& = sumBox(0)
    hand := SendOf(r, 9)
    more := SendOf(full, 4)
    join {
        spawn take(r, got)
        match try Select(hand, more) {
            case Ready.First(_) { }
            case Ready.Second(_) { unreachable }
        }
    }
    assert got.v == 9
}

test Select "times out on time.After, on the virtual clock in no time" {
    c mut Chan<I64>& = Chan<I64>(1)
    Init(c)
    time.Virtual(fn() {
        start := time.Now()
        match try Select(c, time.After(time.Seconds(30))) catch Error { unreachable } {
            case Ready.First(_) { unreachable }
            case Ready.Second(at) { assert at >= start + 30000000000 }
        }
    })
    real := time.Now()
    match try Select(c, time.After(time.Millis(5))) {
        case Ready.First(_) { unreachable }
        case Ready.Second(at) { assert at - real >= 5000000 }
    }
}

test Select "fails with CLOSED once a channel it receives from is closed and drained" {
    a := Chan<I64>(1)
    Init(a)
    b := Chan<I64>(1)
    Init(b)
    Close(a)
    try Select(a, b) catch Error.CLOSED { return }
    unreachable
}
