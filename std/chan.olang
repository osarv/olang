import "cancel"

# chan - a bounded, blocking channel. Ordinary olang on top of "extern fn", with no help from the
# compiler at all: the same claim io.olang makes, held to for the one type that most obviously wants to
# be a builtin.

# pthread's own types are opaque C structs, and X2's extern vocabulary is numeric primitives and arrays of
# them - so a mutex is a byte array handed over as exactly the pointer pthread wants (X3).
# These are RESERVATIONS in WORDS, not sizes in bytes (X3a), and both halves of that matter.
# Reservation: nothing embeds the blob by value - pthread only ever receives a pointer - so over-reserving
# is free and only under-reserving corrupts. That is what makes one constant right everywhere, because the
# true size is a property of the architecture rather than of C: glibc's own headers define three different
# values for pthread_mutex_t (40, 32, 24) by machine, and other platforms differ again. 8 words is 64
# bytes, comfortably above all of them, for a few bytes per channel.
# Words: the ELEMENT TYPE is what supplies the alignment. "I64" is 8-aligned, so "Array<I64, 8>" is 8-aligned
# wherever it sits - inline in a struct (T7c), in a local, in the arena - which is what pthread needs. An
# "Array<U8, 64>" would be alignment 1 and could land at any offset in its container: measured, a byte blob
# after a single byte field sits at offset 1, where a word blob sits at 8.
# And they are private (lowercase), because their bytes are pthread's, not ours - no module but this one can name
# them, and this one only hands them to pthread, which is free to write them since an extern-param carries no
# mutability and X3 hands over a bare pointer (X3a).
MutexWords I32 = 8
CondWords I32 = 8

extern fn pthread_mutex_init(m Array<I64>, attr I64) I32
extern fn pthread_mutex_lock(m Array<I64>) I32
extern fn pthread_mutex_unlock(m Array<I64>) I32
extern fn pthread_cond_init(c Array<I64>, attr I64) I32
extern fn pthread_cond_wait(c Array<I64>, m Array<I64>) I32
extern fn pthread_cond_broadcast(c Array<I64>) I32
extern fn pthread_cond_timedwait(c Array<I64>, m Array<I64>, ts Array<I64>) I32

# This type synchronises its own state, which is exactly what no compile-time rule could know. It used to
# say so with a "shared" marker waiving P3's exclusivity for the whole type - a claim nothing verified.
# Both are gone now: P3 could never be sound without an ownership discipline this language does not have,
# so it stopped claiming and was then removed outright, and an exemption from a rule that no longer exists
# has nothing to mean. A channel handed to a producer and a consumer is once again just a channel.
#
# A channel's capacity is how many values it holds before Send blocks. Capacity 0 is a RENDEZVOUS, as an unbuffered
# channel is in Go: Send hands its value over directly, returning only once a Recv has taken it. Underneath it is a
# one-slot ring whose sender then waits for that one value to be taken - values are taken in the order they were
# placed, so a sender knows its own by counting (sent, taken). A negative capacity is out of range, as an array's
# length is (D14b).
#
# Close says no more values will be sent: what is buffered is still received, in order, and after that Recv and
# RecvUntil fail with ChanError.CLOSED, and "for v in c" ends. The side that sends is the side that closes - after its
# last Send, or after joining every task that sends - so a Send on a closed channel, or one still blocked when the
# channel closes, is a mistake in the program: it stops it, as a slice out of range does (List.RemoveAt's rule), rather
# than making every Send of every program something to try. Closing twice changes nothing.
#
# What is sent lives where the channel does, being stored in it (O6): a value holding references - text, say - sent
# through a channel that outlives the loop sending it stays there until the channel's scope closes (O8c), however
# long ago it was received. A program streaming text indefinitely sends something that holds none (an index, a number)
# or gives each batch a channel of its own, in a block that ends.
type Chan<T> struct(cap I64) {
        # the ring buffer, and the two cursors into it. A bare "&" field lives where the channel does
        # (C2d), which is what a run-time-sized field needs.
    data mut Array<T>& = Array<T>(1 if cap == 0 else cap)
    head I64 = 0
    tail I64 = 0
    count I64 = 0
    rendezvous Bool = cap == 0
    sent I64 = 0
    taken I64 = 0
    closed Bool = false
    lock Array<I64, MutexWords>                    # in the channel itself (T7c): its length is its type's
    notEmpty Array<I64, CondWords>
    notFull Array<I64, CondWords>
}

# a channel must be initialised before use: a constructor cannot call these, because pthread wants the
# final address of the mutex and the constructed value has not reached its home yet.
fn Init(c mut Chan<<T>>&) {
    pthread_mutex_init(c.lock, 0)
    pthread_cond_init(c.notEmpty, 0)
    pthread_cond_init(c.notFull, 0)
}

# v into the ring, the lock held and a slot free; returns its ticket - how many values were placed before it
fn place(c mut Chan<<T>>&, v T) I64 {
    c.data[c.tail] = v
    c.tail = (c.tail + 1) % c.data.Len()
    c.count = c.count + 1
    c.sent = c.sent + 1
    pthread_cond_broadcast(c.notEmpty)
    return c.sent - 1
}

# the oldest value out of the ring, the lock held and the ring not empty
fn take(c mut Chan<<T>>&) T {
    v := c.data[c.head]
    c.head = (c.head + 1) % c.data.Len()
    c.count = c.count - 1
    c.taken = c.taken + 1
    pthread_cond_broadcast(c.notFull)   # a sender waiting for a slot, or for its value to be taken
    return v
}

# the failure of a Recv on a closed channel with nothing left in it
error ChanError {
    CLOSED
}

# no more values will be sent: what is buffered is still received, then Recv fails with ChanError.CLOSED. Wakes every
# task waiting on the channel. Closing a closed channel changes nothing.
fn Close(c mut Chan<<T>>&) {
    pthread_mutex_lock(c.lock)
    c.closed = true
    pthread_cond_broadcast(c.notEmpty)
    pthread_cond_broadcast(c.notFull)
    pthread_mutex_unlock(c.lock)
}

# whether Close has been called. A channel open now may be closed by the time the answer is used - a receiver learns
# that it has ended from Recv's error, never from this
fn IsClosed(c mut Chan<<T>>&) Bool {
    pthread_mutex_lock(c.lock)
    closed := c.closed
    pthread_mutex_unlock(c.lock)
    return closed
}

# a Send, the lock held: stops the program if the channel is closed - the lock let go first, so a test that ends this
# way leaves the channel usable
fn sendOpen(c mut Chan<<T>>&) {
    closed := c.closed
    if closed { pthread_mutex_unlock(c.lock) }
    assert not closed, "send on a closed channel"
}

# a rendezvous Send whose value is still in the slot when the channel closes withdraws it - the slot holds only that
# value, as values leave in order and none was placed after it while the slot was full - and so never completed
fn withdraw(c mut Chan<<T>>&) {
    c.tail = 0
    c.count = 0
    c.sent = c.sent - 1
    pthread_cond_broadcast(c.notFull)
}

# blocks while the channel is full, then appends - and on a rendezvous channel, blocks again until the value has been
# taken. A condition variable may wake spuriously, so each wait is in a loop re-reading the count under the lock.
fn Send(c mut Chan<<T>>&, v T) {
    pthread_mutex_lock(c.lock)
    for c.count == c.data.Len() and not c.closed {
        pthread_cond_wait(c.notFull, c.lock)
    }
    sendOpen(c)
    ticket := place(c, v)
    for c.rendezvous and c.taken <= ticket and not c.closed {
        pthread_cond_wait(c.notFull, c.lock)
    }
    if c.rendezvous and c.taken <= ticket {
        withdraw(c)
        sendOpen(c)
    }
    pthread_mutex_unlock(c.lock)
}

# blocks while the channel is empty and open, then takes the oldest value; fails with ChanError.CLOSED once the
# channel is closed and everything sent before has been taken
fn Recv(c mut Chan<<T>>&) T ? ChanError {
    pthread_mutex_lock(c.lock)
    for c.count == 0 and not c.closed {
        pthread_cond_wait(c.notEmpty, c.lock)
    }
    if c.count == 0 {
        pthread_mutex_unlock(c.lock)
        error ChanError.CLOSED
    }
    v := take(c)
    pthread_mutex_unlock(c.lock)
    return v
}

# a channel is its own iterator (S9a): "for v in c" receives until the channel is closed and drained - Recv, with the
# end of a closed channel as the end of the walk
fn (c mut Chan<<T>>&) Next() T ? Exhausted {
    return try Recv(c) catch ChanError { error Exhausted.END }
}

# Send, giving up - with the token's reason - once the token fires while the channel is still full, or, on a
# rendezvous channel, while the value has not been taken yet: it is withdrawn, so a value either reached a Recv or
# was never sent. The wait wakes at the token's deadline, and every few milliseconds besides to notice a Cancel()
# (cancel.WakeAt).
fn SendUntil(c mut Chan<<T>>&, v T, tok cancel.Token&) ? cancel.Stopped {
    ts Array<I64, 2>
    pthread_mutex_lock(c.lock)
    for c.count == c.data.Len() and not c.closed {
        if tok.Cancelled() {
            pthread_mutex_unlock(c.lock)
            try tok.Reason()
        }
        tok.WakeAt(ts)
        pthread_cond_timedwait(c.notFull, c.lock, ts)
    }
    sendOpen(c)
    ticket := place(c, v)
    for c.rendezvous and c.taken <= ticket and not c.closed {
        if tok.Cancelled() {
            withdraw(c)
            pthread_mutex_unlock(c.lock)
            try tok.Reason()
        }
        tok.WakeAt(ts)
        pthread_cond_timedwait(c.notFull, c.lock, ts)
    }
    if c.rendezvous and c.taken <= ticket {
        withdraw(c)
        sendOpen(c)
    }
    pthread_mutex_unlock(c.lock)
}

# Recv, giving up - with the token's reason - once the token fires while the channel is still empty and open; fails
# with ChanError.CLOSED once it is closed and drained
fn RecvUntil(c mut Chan<<T>>&, tok cancel.Token&) T ? cancel.Stopped + ChanError {
    ts Array<I64, 2>
    pthread_mutex_lock(c.lock)
    for c.count == 0 and not c.closed {
        if tok.Cancelled() {
            pthread_mutex_unlock(c.lock)
            try tok.Reason()
        }
        tok.WakeAt(ts)
        pthread_cond_timedwait(c.notEmpty, c.lock, ts)
    }
    if c.count == 0 {
        pthread_mutex_unlock(c.lock)
        error ChanError.CLOSED
    }
    v := take(c)
    pthread_mutex_unlock(c.lock)
    return v
}

# a producer and a consumer on separate tasks, communicating only through the channel. This is the shape
# P3 used to reject and "shared" used to un-reject: one channel handed to both as "mut Chan<I32>&".
# Nothing about it is checked - the correctness is the mutex's, which is where it belongs.
fn produce(c mut Chan<I32>&, n I32) {
    for i in range n {
        Send(c, i)
    }
}

fn consume(c mut Chan<I32>&, n I32, total mut sumBox&) {
    for i in range n {
        total.v = total.v + (try Recv(c) catch { fail })
    }
}

type sumBox struct(start I32) {
    v I32 = start
}

test "a bounded channel carries values between two tasks" {
    c mut Chan<I32>& = Chan<I32>(4)
    Init(c)
    total mut sumBox& = sumBox(0)
    join {
        spawn produce(c, 100)
        spawn consume(c, 100, total)
    }
        # 0 + 1 + ... + 99
    assert total.v == 4950
}

# and the same channel used sequentially, which exercises the ring buffer wrapping several times over
test "the ring buffer wraps" {
    c mut Chan<I32>& = Chan<I32>(4)
    Init(c)
    total mut sumBox& = sumBox(0)
    for round in range 5 {
        produce(c, 4)
        consume(c, 4, total)
    }
    assert total.v == 30
}

test "a wait with a token returns what is there, and gives up when the deadline passes" {
    c mut Chan<I32>& = Chan<I32>(1)
    Init(c)
    tok := cancel.After(30)
    try SendUntil(c, 5, tok) catch { fail }
    assert (try RecvUntil(c, tok) catch default -1) == 5
    start := cancel.NowNs()
    v := try RecvUntil(c, tok) catch cancel.Stopped.TIMED_OUT default -2 catch default -3
    assert v == -2
    assert cancel.NowNs() - start >= 20000000
    try SendUntil(c, 1, tok) catch { fail }
    try SendUntil(c, 2, tok) catch cancel.Stopped.TIMED_OUT { done } catch { fail }
    fail
}

fn waitFor(c mut Chan<I32>&, tok cancel.Token&, got mut sumBox&) {
    got.v = try RecvUntil(c, tok) catch cancel.Stopped.CANCELLED default -1 catch default -2
}

test "Cancel wakes a task blocked in a wait" {
    c mut Chan<I32>& = Chan<I32>(1)
    Init(c)
    tok mut cancel.Token& = cancel.Token()
    got mut sumBox& = sumBox(0)
    start := cancel.NowNs()
    join {
        spawn waitFor(c, tok, got)
        for cancel.NowNs() - start < 5000000 { }
        tok.Cancel()
    }
    assert got.v == -1
    assert cancel.NowNs() - start < 1000000000
}

# a channel of any element type - here a struct, carried by value, and text, each across tasks
type reading struct(sensor I32, value F64) {
    sensor
    value
}

fn sendReadings(c mut Chan<reading>&, n I32) {
    for i in range n { Send(c, reading(i, F64(i) * 0.5)) }
}

fn sumReadings(c mut Chan<reading>&, n I32, total mut sumBox&) {
    for i in range n {
        r := try Recv(c) catch { fail }
        total.v = total.v + r.sensor
    }
}

test "a channel carries any element type" {
    c mut Chan<reading>& = Chan<reading>(3)
    Init(c)
    total mut sumBox& = sumBox(0)
    join {
        spawn sendReadings(c, 50)
        spawn sumReadings(c, 50, total)
    }
    assert total.v == 1225
    f mut Chan<F64>& = Chan<F64>(2)
    Init(f)
    Send(f, 1.5)
    Send(f, 2.25)
    assert (try Recv(f) catch { fail }) + (try Recv(f) catch { fail }) == 3.75
    t mut Chan<String&>& = Chan<String&>(2)
    Init(t)
    Send(t, "one")
    Send(t, $(1 + 1))
    assert (try Recv(t) catch { fail }) == "one" and (try Recv(t) catch { fail }) == "2"
}

# capacity 0: each Send returns only once its value has been received, so the sender is never more than one value
# ahead of the receiver
fn sendCounting(c mut Chan<I32>&, n I32, sentAll mut sumBox&) {
    for i in range n { Send(c, i) }
    sentAll.v = 1
}

test "a channel of capacity 0 is a rendezvous" {
    c mut Chan<I32>& = Chan<I32>(0)
    Init(c)
    total mut sumBox& = sumBox(0)
    sentAll mut sumBox& = sumBox(0)
    join {
        spawn sendCounting(c, 100, sentAll)
        spawn consume(c, 100, total)
    }
    assert total.v == 4950 and sentAll.v == 1
    # nobody receives, so a send with a deadline gives up - and its value is withdrawn, not left behind
    tok := cancel.After(20)
    try SendUntil(c, 7, tok) catch cancel.Stopped.TIMED_OUT { } catch { fail }
    assert c.count == 0
    tok2 := cancel.After(20)
    assert (try RecvUntil(c, tok2) catch cancel.Stopped.TIMED_OUT default -1 catch default -2) == -1
}

# Close: what was buffered before it is still received, in order, then Recv fails with CLOSED - again on every call
test "a closed channel gives what it holds, then fails with CLOSED" {
    c mut Chan<I32>& = Chan<I32>(4)
    Init(c)
    Send(c, 1)
    Send(c, 2)
    Send(c, 3)
    assert not IsClosed(c)
    Close(c)
    Close(c)                                 # again: nothing changes
    assert IsClosed(c)
    assert (try Recv(c) catch default -1) == 1
    tok := cancel.After(1000)
    assert (try RecvUntil(c, tok) catch default -1) == 2
    sum := 0
    for v in c { sum += v }                  # the rest, then the loop ends
    assert sum == 3
    assert (try Recv(c) catch ChanError.CLOSED default -7) == -7
    assert (try RecvUntil(c, tok) catch ChanError.CLOSED default -8 catch cancel.Stopped default -9) == -8
}

# "for v in c" ends at the close: a producer sends and closes, the consumer walks the channel - buffered and rendezvous
fn sendThenClose(c mut Chan<I32>&, n I32) {
    for i in range n { Send(c, i) }
    Close(c)
}

fn walkSum(c mut Chan<I32>&, total mut sumBox&) {
    for v in c { total.v = total.v + v }
}

test "for v in c receives until the channel is closed and drained" {
    for cap in I32[3, 0] {
        c mut Chan<I32>& = Chan<I32>(cap)
        Init(c)
        total mut sumBox& = sumBox(0)
        join {
            spawn sendThenClose(c, 100)
            spawn walkSum(c, total)
        }
        assert total.v == 4950
    }
}

# several receivers blocked on an empty channel are all woken by the close, each ending its loop
fn walkCount(c mut Chan<I32>&, seen mut sumBox&) {
    for v in c { seen.v.AtomicAdd(1) }
}

test "Close wakes every task waiting to receive, and RecvUntil sees it before its deadline" {
    c mut Chan<I32>& = Chan<I32>(2)
    Init(c)
    seen mut sumBox& = sumBox(0)
    got mut sumBox& = sumBox(0)
    tok := cancel.After(60000)
    start := cancel.NowNs()
    join {
        for w in range 3 { spawn walkCount(c, seen) }
        spawn waitClosed(c, tok, seen, got)
        for i in range I32(10) { Send(c, i) }
        Close(c)
    }
    assert seen.v.AtomicLoad() == 10 and got.v == 1
    assert cancel.NowNs() - start < 30000000000
}

fn waitClosed(c mut Chan<I32>&, tok cancel.Token&, seen mut sumBox&, got mut sumBox&) {
    for {
        v := try RecvUntil(c, tok) catch ChanError.CLOSED { break } catch cancel.Stopped { return }
        seen.v.AtomicAdd(1)
    }
    got.v = 1
}

# a capacity is a count, an I64 as every length and count is: one computed from a length goes in as it is
test "a channel's capacity is an I64" {
    items := I64[4, 5, 6]
    c mut Chan<I64>& = Chan<I64>(items.Len())
    Init(c)
    for x in items { Send(c, x) }
    total I64 = 0
    for i in range items.Len() { total += try Recv(c) catch ChanError { unreachable } }
    assert total == 15
}
