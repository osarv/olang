# Json - JSON text (RFC 8259) read into a tree and written back. Ordinary olang: no extern, nothing the compiler
# provides, so Parse and Encode run while compiling (K1) and under -i as they run in a built program.
#
#     doc := try json.Parse(text)
#     name := try (try doc["users"][0]["name"]).AsStr()
#     try io.Print(json.Encode(doc, "  "))
#
# A value is a Json, an enum held by reference (T17d): a tree whose arrays and objects hold their parts by reference,
# matched with nested patterns (case Json.Arr(items)). A tree never changes once built - every payload is read-only -
# so a part of one tree may be shared by another, and a reference into a tree may be kept anywhere the tree lives.
#
# Where a tree lives: everything Parse builds - every node, every string, every array - is built where its caller puts
# the result, as any built result is (§8.5): "doc := try json.Parse(text)" builds it in the block "doc" is declared in,
# a field or a list it is put in holds it where that lives. Nothing of it borrows the text: strings are copied, so the
# text may be dropped as soon as Parse returns.
#
# Errors: one error type for reading and for asking (JsonError). An error carries no data, so where a parse stopped
# is written into a Position its caller passes ("try json.Parse(text, at)"), when it passes one.

# why a text is not JSON, or what a question asked of a value could not answer
error JsonError {
    UNEXPECTED          # a character that cannot be where it is: a missing ',' or ':', a misspelt true, a raw control
                        # character in a string
    UNTERMINATED        # the text ends inside a string, an array or an object - or before any value at all
    BAD_ESCAPE          # a backslash not followed by one of JSON's escapes, or a \u naming half a surrogate pair
    BAD_NUMBER          # not a JSON number (01, 1., -, 1e), or too large for an F64
    BAD_UTF8            # a string's bytes are not UTF-8
    TRAILING            # something follows the value
    DEPTH               # arrays and objects nest more than MaxDepth deep
    MISSING             # no member by that name, or no item at that index
    WRONG_KIND          # the value is not the kind asked for: AsNum on a string, a name asked of an array
}

# how deeply arrays and objects may nest in a text Parse reads - a bound that keeps code walking a tree recursively,
# Encode included, well inside its stack
MaxDepth I64 = 1000

# a JSON value
type Json enum {
    Null
    Bool(v Bool)
    Num(v F64)
    Str(s String&)
    Arr(items Array<Json&>&)
    Obj(o Object&)
}

# an object: its members' names and values, in the order they were written. Names need not be unique; asking for a
# name gives the LAST member by it, as most readers of JSON do. Built from the two arrays, which must be as long as
# each other: Json.Obj(Object(String&["a", "b"], Json&[Json.Num(1.0), Json.Null])). Objects with more than
# eight members are indexed by a hash of their names when built, so asking costs the same whatever their size.
type Object struct(Keys Array<String&>&, Values Array<Json&>&) {
    Keys
    Values
    index Array<I32>& = nameIndex(Keys)         # empty, or slots of member position + 1 (0 an empty slot)
    assert Keys.Len() == Values.Len()
}

# where Parse stopped: the byte offset into the text, and the line and the column there, both from 1 - a column
# counting characters (UTF-8 sequences), not bytes. "$at" is "LINE:COL".
type Position struct() {
    Offset I64 = 0
    Line I64 = 1
    Col I64 = 1
}

fn (p Position&) Str() String { return $p.Line ":" $p.Col }

# ---- asking a value ----

# the member named key of an object (a String), or the item at index key of an array (an I32 or I64): "try doc["name"]",
# "try doc[0]". Only under try - a JSON text can always lack what is asked of it - and a "try" over a chain of them
# checks each: "try doc["users"][0]["name"]". Fails with MISSING when there is no such member or item, WRONG_KIND
# when the value is not an object (a name asked) or an array (an index).
fn (j Json&) TryAt(key <K>) Json&j ? JsonError {
    match K {
        case String {
            match j {
                case Json.Obj(o) { return o.Values[try o.find(key) catch { error JsonError.MISSING }] }
                nomatch { error JsonError.WRONG_KIND }
            }
        }
        case String& {
            match j {
                case Json.Obj(o) { return o.Values[try o.find(key) catch { error JsonError.MISSING }] }
                nomatch { error JsonError.WRONG_KIND }
            }
        }
        case I32 {
            match j {
                case Json.Arr(items) {
                    if key < 0 or I64(key) >= items.Len() { error JsonError.MISSING }
                    return items[I64(key)]
                }
                nomatch { error JsonError.WRONG_KIND }
            }
        }
        case I64 {
            match j {
                case Json.Arr(items) {
                    if key < 0 or key >= items.Len() { error JsonError.MISSING }
                    return items[key]
                }
                nomatch { error JsonError.WRONG_KIND }
            }
        }
    }
}

# whether j is an object with a member named key: "name" in doc
fn (j Json&) Has(key String&) Bool {
    match j {
        case Json.Obj(o) { return o.Has(key) }
        nomatch { return false }
    }
}

fn (j Json&) IsNull() Bool { return j is Json.Null }

# the number j holds - failing with WRONG_KIND when it holds something else
fn (j Json&) AsNum() F64 ? JsonError {
    match j {
        case Json.Num(v) { return v }
        nomatch { error JsonError.WRONG_KIND }
    }
}

# the number j holds, when it is a whole number an I64 holds - failing with WRONG_KIND otherwise. JSON numbers are read
# as F64s, so a whole number beyond 2^53 has already been rounded to one
fn (j Json&) AsInt() I64 ? JsonError {
    match j {
        case Json.Num(v) {
            if v >= -9223372036854775808.0 and v < 9223372036854775808.0 and F64(I64(v)) == v { return I64(v) }
            error JsonError.WRONG_KIND
        }
        nomatch { error JsonError.WRONG_KIND }
    }
}

fn (j Json&) AsBool() Bool ? JsonError {
    match j {
        case Json.Bool(v) { return v }
        nomatch { error JsonError.WRONG_KIND }
    }
}

# the text j holds - part of the tree, so it lives where j does
fn (j Json&) AsStr() String&j ? JsonError {
    match j {
        case Json.Str(s) { return s }
        nomatch { error JsonError.WRONG_KIND }
    }
}

# the items of the array j is: "for x in try doc.AsArr() { ... } catch JsonError { ... }"
fn (j Json&) AsArr() Array<Json&>&j ? JsonError {
    match j {
        case Json.Arr(items) { return items }
        nomatch { error JsonError.WRONG_KIND }
    }
}

# the object j is - its Keys and Values, and asking it by name
fn (j Json&) AsObj() Object&j ? JsonError {
    match j {
        case Json.Obj(o) { return o }
        nomatch { error JsonError.WRONG_KIND }
    }
}

# how many members it has
fn (o Object&) Len() I64 { return o.Keys.Len() }

# the value of the member named key - the last, when several are - failing with MISSING when there is none
fn (o Object&) TryAt(key String&) Json&o ? JsonError {
    return o.Values[try o.find(key) catch { error JsonError.MISSING }]
}

# whether a member is named key: "name" in o
fn (o Object&) Has(key String&) Bool {
    try o.find(key) catch { return false }
    return true
}

# where the last member named key is, failing - with the default error - when none is. Names are compared byte by
# byte rather than with "==", so that key may be text passed by value (a generic's String), which it can only index
fn (o Object&) find(key <K>) I64 ? {
    if o.index.Len() == 0 {
        i I64 = o.Keys.Len() - 1
        for i >= 0 {
            if sameName(o.Keys[i], key) { return i }
            i--
        }
        error
    }
    mask I64 = o.index.Len() - 1
    s I64 = nameHash(key) & mask
    for probe in range o.index.Len() {
        at I64 = I64(o.index[s])
        if at == 0 { error }
        if sameName(o.Keys[at - 1], key) { return at - 1 }
        s = (s + 1) & mask
    }
    error
}

fn sameName(a String&, b <K>) Bool {
    if a.Len() != b.Len() { return false }
    for i in range a.Len() {
        if a[i] != b[i] { return false }
    }
    return true
}

# FNV-1a over the name's bytes
fn nameHash(t <K>) I64 {
    h I64 = -3750763034362895579
    for i in range t.Len() { h = (h ^ I64(t[i])) * 1099511628211 }
    return h
}

# the index an Object of these names is built with: nothing for eight or fewer (a look at each is as quick), else an
# open-addressed table twice their number or more, each later member of a name taking the slot of an earlier one
fn nameIndex(keys Array<String&>&) Array<I32>& {
    n := keys.Len()
    if n <= 8 { return Array<I32>(0) }
    size I64 = 16
    for size < 2 * n { size = size * 2 }
    slots mut Array<I32>&return = Array<I32>(size)
    mask I64 = size - 1
    for i in range n {
        s I64 = nameHash(keys[i]) & mask
        for slots[s] != 0 and not sameName(keys[I64(slots[s]) - 1], keys[i]) { s = (s + 1) & mask }
        slots[s] = I32(i + 1)
    }
    return slots
}

# ---- equality ----

# two values are equal when they are the same kind holding equal parts: numbers by value (so NaN equals nothing), text
# byte by byte, arrays item by item, and objects with the same number of members, each name having an equal value in
# both - in whatever order they were written
fn (a Json&) Eq(b Json&) Bool {
    if a is b { return true }
    match a {
        case Json.Null { return b is Json.Null }
        case Json.Bool(x) {
            match b {
                case Json.Bool(y) { return x == y }
                nomatch { return false }
            }
        }
        case Json.Num(x) {
            match b {
                case Json.Num(y) { return x == y }
                nomatch { return false }
            }
        }
        case Json.Str(x) {
            match b {
                case Json.Str(y) { return x == y }
                nomatch { return false }
            }
        }
        case Json.Arr(x) {
            match b {
                case Json.Arr(y) {
                    if x.Len() != y.Len() { return false }
                    for i in range x.Len() {
                        if x[i] != y[i] { return false }
                    }
                    return true
                }
                nomatch { return false }
            }
        }
        case Json.Obj(x) {
            match b {
                case Json.Obj(y) {
                    if x.Len() != y.Len() { return false }
                    for i in range x.Len() {
                        at := try y.find(x.Keys[i]) catch { return false }
                        mine := try x.find(x.Keys[i]) catch { return false }
                        if x.Values[mine] != y.Values[at] { return false }
                    }
                    return true
                }
                nomatch { return false }
            }
        }
        nomatch { return false }
    }
}

# agrees with Eq: equal values hash equally (an object's members combined in no order, a zero of either sign alike)
fn (j Json&) Hash() I64 {
    match j {
        case Json.Null { return 1 }
        case Json.Bool(v) { return 2 if v else 3 }
        case Json.Num(v) {
            if v == 0.0 { return 4 }
            return I64(v.Bits()) * 1099511628211
        }
        case Json.Str(s) { return s.Hash() }
        case Json.Arr(items) {
            h I64 = 5
            for x in items { h = h * 31 + x.Hash() }
            return h
        }
        case Json.Obj(o) {
            h I64 = 6
            for i in range o.Len() { h = h + (nameHash(o.Keys[i]) ^ o.Values[i].Hash()) * 1099511628211 }
            return h
        }
        nomatch { return 0 }
    }
}

# ---- reading ----

# the value the JSON text holds: one value, with nothing but whitespace around it (a byte order mark before it is
# ignored). Fails with the JsonError that says why the text is not JSON; "at", when given, is set to where reading
# stopped - the start of the problem, or the end of the text.
fn Parse(text String&, at mut Position& = null) Json& ? JsonError {
    r mut reader&return = reader(text)
    defer {
        if at != null { r.place(at) }
    }
    try r.run()
    return r.vals[0]
}

# what Parse reads with: the text, where it has got to, and the values read and not yet gathered into their array or
# object - each open array's items and object's members on the stacks, an object's names on "names". It lives where
# Parse's result does, so everything it builds - each value pushed, each array gathered - is built there.
type reader struct(src String&) {
    src
    pos I64 = 0
    vals mut Array<mut Json&>& = Array<mut Json&>(64)
    nv I64 = 0
    names mut Array<String&>& = Array<String&>(16)
    nn I64 = 0
    starts mut Array<I64>& = Array<I64>(16)     # for each open array, where its items start in vals; for an object,
    nameStarts mut Array<I64>& = Array<I64>(16) # also where its names start in names - -1 for an array
    depth I64 = 0
}

# where pos is, as a Position
fn (r reader&) place(at mut Position&) {
    at.Offset = r.pos
    at.Line = 1
    at.Col = 1
    for i in range r.pos {
        c := r.src[i]
        if c == '\n' {
            at.Line++
            at.Col = 1
        } else if (c & 0xC0) != 0x80 {
            at.Col++
        }
    }
}

fn (r mut reader&) push(v mut Json&) {
    if r.nv == r.vals.Len() {
        old := r.vals
        r.vals = Array<mut Json&>(r.nv * 2)
        for i in range r.nv { r.vals[i] = old[i] }
    }
    r.vals[r.nv] = v
    r.nv++
}

fn (r mut reader&) pushName(name String&) {
    if r.nn == r.names.Len() {
        old := r.names
        r.names = Array<String&>(r.nn * 2)
        for i in range r.nn { r.names[i] = old[i] }
    }
    r.names[r.nn] = name
    r.nn++
}

fn (r mut reader&) open(isObject Bool) ? JsonError {
    if r.depth == MaxDepth { error JsonError.DEPTH }
    if r.depth == r.starts.Len() {
        old := r.starts
        oldNames := r.nameStarts
        r.starts = Array<I64>(r.depth * 2)
        r.nameStarts = Array<I64>(r.depth * 2)
        for i in range r.depth {
            r.starts[i] = old[i]
            r.nameStarts[i] = oldNames[i]
        }
    }
    r.starts[r.depth] = r.nv
    r.nameStarts[r.depth] = r.nn if isObject else -1
    r.depth++
    r.pos++
}

# the innermost open array or object is complete: its parts become one value in their place
fn (r mut reader&) close() {
    r.depth--
    from I64 = r.starts[r.depth]
    n I64 = r.nv - from
    items mut Array<Json&>&r = Array<Json&>(n)
    for i in range n { items[i] = r.vals[from + i] }
    r.nv = from
    namesFrom I64 = r.nameStarts[r.depth]
    if namesFrom < 0 {
        r.push(Json.Arr(items))
    } else {
        names mut Array<String&>&r = Array<String&>(n)
        for i in range n { names[i] = r.names[namesFrom + i] }
        r.nn = namesFrom
        r.push(Json.Obj(Object(names, items)))
    }
    r.pos++
}

fn (r mut reader&) skipSpace() { r.pos = spaceEnd(r.src, r.pos) }

# where the whitespace from i in s ends. The scans are plain functions over a text and a position, which the optimizer
# keeps in registers, where a loop over the reader's fields would load and store them at every byte
fn spaceEnd(s String&, from I64) I64 {
    i I64 = from
    for i < s.Len() {
        c := s[i]
        if c != ' ' and c != '\n' and c != '\r' and c != '\t' { return i }
        i++
    }
    return i
}

# where the run of characters from i in s that a string holds as they are - printable ASCII, no quote, no backslash - ends
fn plainEnd(s String&, from I64) I64 {
    i I64 = from
    for i < s.Len() {
        c := s[i]
        if c == '"' or c == '\\' or c < 0x20 or c >= 0x80 { return i }
        i++
    }
    return i
}

fn (r reader&) inObject() Bool { return r.nameStarts[r.depth - 1] >= 0 }

# reads the whole text: values one after another, each array or object opened on the stacks and gathered once closed,
# so nesting costs no recursion
fn (r mut reader&) run() ? JsonError {
    if r.src.Len() >= 3 and r.src[0] == 0xEF and r.src[1] == 0xBB and r.src[2] == 0xBF { r.pos = 3 }
    for {
        # a value is next
        r.skipSpace()
        if r.pos == r.src.Len() { error JsonError.UNTERMINATED }
        c := r.src[r.pos]
        if c == '[' {
            try r.open(false)
            r.skipSpace()
            if r.pos < r.src.Len() and r.src[r.pos] == ']' {
                r.close()
            } else {
                continue
            }
        } else if c == '{' {
            try r.open(true)
            r.skipSpace()
            if r.pos < r.src.Len() and r.src[r.pos] == '}' {
                r.close()
            } else {
                try r.name()
                continue
            }
        } else {
            try r.scalar(c)
        }
        # a value is complete: the next item of what is open, the end of it, or the end of the text
        for {
            if r.depth == 0 {
                r.skipSpace()
                if r.pos < r.src.Len() { error JsonError.TRAILING }
                return
            }
            r.skipSpace()
            if r.pos == r.src.Len() { error JsonError.UNTERMINATED }
            d := r.src[r.pos]
            if d == ',' {
                r.pos++
                if r.inObject() { try r.name() }
                break
            }
            if d == ('}' if r.inObject() else ']') {
                r.close()
            } else {
                error JsonError.UNEXPECTED
            }
        }
    }
}

# an object member's name and the ':' after it
fn (r mut reader&) name() ? JsonError {
    r.skipSpace()
    if r.pos == r.src.Len() { error JsonError.UNTERMINATED }
    if r.src[r.pos] != '"' { error JsonError.UNEXPECTED }
    r.pushName(try r.string())
    r.skipSpace()
    if r.pos == r.src.Len() { error JsonError.UNTERMINATED }
    if r.src[r.pos] != ':' { error JsonError.UNEXPECTED }
    r.pos++
}

# a value that is no array or object, starting with c
fn (r mut reader&) scalar(c Char) ? JsonError {
    if c == '"' {
        r.push(Json.Str(try r.string()))
    } else if c == '-' or c.IsDigit() {
        r.push(Json.Num(try r.number()))
    } else if c == 't' {
        try r.word("true")
        r.push(Json.Bool(true))
    } else if c == 'f' {
        try r.word("false")
        r.push(Json.Bool(false))
    } else if c == 'n' {
        try r.word("null")
        r.push(Json.Null)
    } else {
        error JsonError.UNEXPECTED
    }
}

fn (r mut reader&) word(w String&) ? JsonError {
    for i in range w.Len() {
        if r.pos == r.src.Len() { error JsonError.UNTERMINATED }
        if r.src[r.pos] != w[i] { error JsonError.UNEXPECTED }
        r.pos++
    }
}

# ---- reading a string ----

# the string whose opening quote is at pos, decoded - new text, built where its caller puts it
fn (r mut reader&) string() String& ? JsonError {
    start I64 = r.pos + 1
    r.pos = plainEnd(r.src, start)
    if r.pos < r.src.Len() and r.src[r.pos] == '"' {   # the usual string: printable ASCII, no escapes - copied as it is
        r.pos++
        return $r.src[start:r.pos - 1]
    }
    # the rest: checked, and measured, then decoded into text of exactly that length
    size I64 = r.pos - start
    for {
        if r.pos == r.src.Len() { error JsonError.UNTERMINATED }
        c := r.src[r.pos]
        if c == '"' { break }
        if c == '\\' {
            size += try r.escape(start, null)
        } else if c < 0x20 {
            error JsonError.UNEXPECTED
        } else if c < 0x80 {
            size++
            r.pos++
        } else {
            n := try r.utf8()
            size += n
            r.pos += n
        }
    }
    end I64 = r.pos
    out mut String&return = String(Array<U8>(size))
    w I64 = 0
    r.pos = start
    for r.pos < end {
        c := r.src[r.pos]
        if c == '\\' {
            w += try r.escape(w, out)
        } else {
            out[w] = c
            w++
            r.pos++
        }
    }
    r.pos = end + 1
    return out
}

# the escape at pos: moves past it and gives how many bytes it stands for - writing them into out at w, when out is
# given. \u escapes are UTF-8 there, a surrogate pair (😀) one character of four bytes
fn (r mut reader&) escape(w I64, out mut String&) I64 ? JsonError {
    if r.pos + 1 == r.src.Len() {
        r.pos++
        error JsonError.UNTERMINATED
    }
    e := r.src[r.pos + 1]
    b Char = 0
    if e == '"' or e == '\\' or e == '/' {
        b = e
    } else if e == 'n' {
        b = '\n'
    } else if e == 't' {
        b = '\t'
    } else if e == 'r' {
        b = '\r'
    } else if e == 'b' {
        b = 8
    } else if e == 'f' {
        b = 12
    } else if e == 'u' {
        cp := try r.hex4(r.pos + 2)
        at I64 = r.pos
        r.pos += 6
        if cp >= 0xDC00 and cp <= 0xDFFF {
            r.pos = at
            error JsonError.BAD_ESCAPE
        }
        if cp >= 0xD800 and cp <= 0xDBFF {          # the first half of a pair: the second must follow at once
            if r.pos + 1 >= r.src.Len() or r.src[r.pos] != '\\' or r.src[r.pos + 1] != 'u' {
                r.pos = at
                error JsonError.BAD_ESCAPE
            }
            lo := try r.hex4(r.pos + 2)
            if lo < 0xDC00 or lo > 0xDFFF {
                r.pos = at
                error JsonError.BAD_ESCAPE
            }
            r.pos += 6
            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
        }
        return putUtf8(cp, w, out)
    } else {
        error JsonError.BAD_ESCAPE
    }
    if out != null { out[w] = b }
    r.pos += 2
    return 1
}

# the four hex digits at i, as a number - failing where the text ends or a digit is not one
fn (r mut reader&) hex4(i I64) I64 ? JsonError {
    v I64 = 0
    for k in range i, i + 4 {
        if k >= r.src.Len() {
            r.pos = r.src.Len()
            error JsonError.UNTERMINATED
        }
        c := r.src[k]
        d I64 = 0
        if c >= '0' and c <= '9' {
            d = I64(c - '0')
        } else if c >= 'a' and c <= 'f' {
            d = I64(c - 'a') + 10
        } else if c >= 'A' and c <= 'F' {
            d = I64(c - 'A') + 10
        } else {
            r.pos = k
            error JsonError.BAD_ESCAPE
        }
        v = v * 16 + d
    }
    return v
}

# code point cp's UTF-8 bytes, written into out at w when out is given, and how many there are
fn putUtf8(cp I64, w I64, out mut String&) I64 {
    if cp < 0x80 {
        if out != null { out[w] = Char(cp) }
        return 1
    }
    if cp < 0x800 {
        if out != null {
            out[w] = Char(0xC0 | (cp >> 6))
            out[w + 1] = Char(0x80 | (cp & 0x3F))
        }
        return 2
    }
    if cp < 0x10000 {
        if out != null {
            out[w] = Char(0xE0 | (cp >> 12))
            out[w + 1] = Char(0x80 | ((cp >> 6) & 0x3F))
            out[w + 2] = Char(0x80 | (cp & 0x3F))
        }
        return 3
    }
    if out != null {
        out[w] = Char(0xF0 | (cp >> 18))
        out[w + 1] = Char(0x80 | ((cp >> 12) & 0x3F))
        out[w + 2] = Char(0x80 | ((cp >> 6) & 0x3F))
        out[w + 3] = Char(0x80 | (cp & 0x3F))
    }
    return 4
}

# how long the UTF-8 sequence at pos is (RFC 3629: no overlong forms, no surrogates, nothing past U+10FFFF), failing
# with BAD_UTF8 at its first byte when it is not one
fn (r reader&) utf8() I64 ? JsonError {
    c := r.src[r.pos]
    n I64 = 0
    lo Char = 0x80                                  # the range the second byte must be in
    hi Char = 0xBF
    if c >= 0xC2 and c <= 0xDF {
        n = 2
    } else if c >= 0xE0 and c <= 0xEF {
        n = 3
        if c == 0xE0 { lo = 0xA0 }
        if c == 0xED { hi = 0x9F }
    } else if c >= 0xF0 and c <= 0xF4 {
        n = 4
        if c == 0xF0 { lo = 0x90 }
        if c == 0xF4 { hi = 0x8F }
    } else {
        error JsonError.BAD_UTF8
    }
    if r.pos + n > r.src.Len() { error JsonError.BAD_UTF8 }
    b := r.src[r.pos + 1]
    if b < lo or b > hi { error JsonError.BAD_UTF8 }
    for k in range 2, n {
        if (r.src[r.pos + k] & 0xC0) != 0x80 { error JsonError.BAD_UTF8 }
    }
    return n
}

# ---- reading a number ----

# the number starting at pos, to the nearest F64: checked against JSON's grammar, -?(0|[1-9][0-9]*)(.[0-9]+)?
# ([eE][+-]?[0-9]+)?, then read by the prelude's String.ParseFloat, whose grammar is wider - a number too large for an
# F64 is BAD_NUMBER, one too small is zero. A whole number of at most 15 digits, the commonest kind, is worked out as it
# is checked: it is exactly an F64, so there is nothing to round
fn (r mut reader&) number() F64 ? JsonError {
    start I64 = r.pos
    neg Bool = r.src[r.pos] == '-'
    if neg { r.pos++ }
    if not r.digitAt(r.pos) { error JsonError.BAD_NUMBER }
    whole I64 = 0
    digits I64 = 0
    if r.src[r.pos] == '0' {
        r.pos++
        if r.digitAt(r.pos) { error JsonError.BAD_NUMBER }     # no leading zeros
    } else {
        for r.digitAt(r.pos) {
            whole = whole * 10 + I64(r.src[r.pos] - '0')
            digits++
            r.pos++
        }
    }
    simple Bool = digits <= 15
    if r.pos < r.src.Len() and r.src[r.pos] == '.' {
        simple = false
        r.pos++
        if not r.digitAt(r.pos) { error JsonError.BAD_NUMBER }
        for r.digitAt(r.pos) { r.pos++ }
    }
    if r.pos < r.src.Len() and (r.src[r.pos] == 'e' or r.src[r.pos] == 'E') {
        simple = false
        r.pos++
        if r.pos < r.src.Len() and (r.src[r.pos] == '+' or r.src[r.pos] == '-') { r.pos++ }
        if not r.digitAt(r.pos) { error JsonError.BAD_NUMBER }
        for r.digitAt(r.pos) { r.pos++ }
    }
    if simple { return -F64(whole) if neg else F64(whole) }
    v := try r.src[start:r.pos].ParseFloat() catch {
        r.pos = start
        error JsonError.BAD_NUMBER
    }
    return v
}

fn (r reader&) digitAt(i I64) Bool { return i < r.src.Len() and r.src[i].IsDigit() }

# ---- writing a number: the shortest text that reads back ----

# v, finite, as the shortest text that reads back as it - the closest such, when several are as short - which is what
# "$v" writes (E11a)
fn writeNumber(sb mut StringBuilder&, v F64) { sb.Push($v) }

# ---- writing ----

# j as JSON text: compact - no space anywhere - with no indent, or with each array item and object member on a line of
# its own, indented by "indent" once for each level ("  ", "\t"). A number is written as "$" writes it, the shortest
# text that reads back as it; NaN and the infinities, which JSON cannot write, are written null, as JavaScript does.
# Text is written as it is, UTF-8 left alone, with '"', '\' and the control characters escaped.
fn Encode(j Json&, indent String& = "") String& {
    w := writer(indent)
    w.value(j, 0)
    return w.out.ToString()
}

# a value renders as its compact JSON text: "$doc"
fn (j Json&) Str() String { return Encode(j) }

type writer struct(indent String&) {
    indent
    out StringBuilder = StringBuilder()
}

fn (w mut writer&) newline(depth I64) {
    if w.indent.Len() == 0 { return }
    w.out.PushChar('\n')
    for i in range depth { w.out.Push(w.indent) }
}

fn (w mut writer&) value(j Json&, depth I64) {
    match j {
        case Json.Null { w.out.Push("null") }
        case Json.Bool(v) { w.out.Push("true" if v else "false") }
        case Json.Num(v) {
            if v != v or v - v != 0.0 {             # NaN, or infinite (inf - inf is NaN)
                w.out.Push("null")
            } else {
                writeNumber(w.out, v)
            }
        }
        case Json.Str(s) { w.text(s) }
        case Json.Arr(items) {
            if items.Len() == 0 {
                w.out.Push("[]")
                return
            }
            w.out.PushChar('[')
            for i in range items.Len() {
                if i > 0 { w.out.PushChar(',') }
                w.newline(depth + 1)
                w.value(items[i], depth + 1)
            }
            w.newline(depth)
            w.out.PushChar(']')
        }
        case Json.Obj(o) {
            if o.Len() == 0 {
                w.out.Push("{}")
                return
            }
            w.out.PushChar('{')
            for i in range o.Len() {
                if i > 0 { w.out.PushChar(',') }
                w.newline(depth + 1)
                w.text(o.Keys[i])
                w.out.Push(": " if w.indent.Len() > 0 else ":")
                w.value(o.Values[i], depth + 1)
            }
            w.newline(depth)
            w.out.PushChar('}')
        }
        nomatch { w.out.Push("null") }              # a null reference - and nomatch keeps Str evaluable (see Eq)
    }
}

hexDigits := "0123456789abcdef"

# s as a JSON string: quoted, with what must be escaped escaped, each run of what need not be written at once
fn (w mut writer&) text(s String&) {
    w.out.PushChar('"')
    from I64 = 0
    for i in range s.Len() {
        c := s[i]
        if c >= 0x20 and c != '"' and c != '\\' { continue }
        w.out.Push(s[from:i])
        from = i + 1
        if c == '"' {
            w.out.Push("\\\"")
        } else if c == '\\' {
            w.out.Push("\\\\")
        } else if c == '\n' {
            w.out.Push("\\n")
        } else if c == '\t' {
            w.out.Push("\\t")
        } else if c == '\r' {
            w.out.Push("\\r")
        } else {
            w.out.Push("\\u00")
            w.out.PushChar(hexDigits[I64(c >> 4)])
            w.out.PushChar(hexDigits[I64(c & 15)])
        }
    }
    w.out.Push(s[from:])
    w.out.PushChar('"')
}

# ---- tests ----

# the tests, and what only they use - under TestBuild, so a program that is not being tested compiles none of it

if TestBuild {
    import "os"

    # why text is not JSON, as "WORD LINE:COL", or "ok"
    fn problem(text String&) String& {
        at := Position()
        try Parse(text, at) catch JsonError.UNEXPECTED { return "UNEXPECTED " $at }
            catch JsonError.UNTERMINATED { return "UNTERMINATED " $at }
            catch JsonError.BAD_ESCAPE { return "BAD_ESCAPE " $at }
            catch JsonError.BAD_NUMBER { return "BAD_NUMBER " $at }
            catch JsonError.BAD_UTF8 { return "BAD_UTF8 " $at }
            catch JsonError.TRAILING { return "TRAILING " $at }
            catch JsonError.DEPTH { return "DEPTH " $at }
            catch JsonError { return "OTHER" }
        return "ok"
    }

    # the number text is, or NaN when it is not one
    fn num(text String&) F64 {
        doc := try Parse(text) catch { return 0.0 / 0.0 }
        return try doc.AsNum() catch { return 0.0 / 0.0 }
    }

    # the word a question about j fails with, or "ok"
    fn asking(j Json&, key <K>) String& {
        try j[key] catch JsonError.MISSING { return "MISSING" } catch JsonError.WRONG_KIND { return "WRONG_KIND" }
            catch JsonError { return "OTHER" }
        return "ok"
    }

    # the As questions, through a signature that lets their errors go - the way a program asks them
    fn kinds(doc Json&) ? JsonError {
        assert (try (try doc["s"]).AsStr()) == "text"
        assert (try (try doc["n"]).AsNum()) == -125.0 and (try (try doc["n"]).AsInt()) == -125
        assert (try (try doc["t"]).AsBool()) and not (try (try doc["f"]).AsBool())
        assert (try doc["z"]).IsNull() and not (try doc["s"]).IsNull()
        assert (try (try doc["a"][1][0]).AsNum()) == 2.0
        i I64 = 1
        assert (try (try doc["a"][i][1]).AsNum()) == 3.0
        assert (try (try doc["a"]).AsArr()).Len() == 3
        o := try doc.AsObj()
        assert o.Len() == 6 and o.Keys[0] == "s" and o.Keys[5] == "a"
        assert (try (try o["t"]).AsBool()) and "z" in o and "y" not in o
    }

    test "every kind of value, and asking for its parts" {
        doc := try Parse("{\"s\": \"text\", \"n\": -12.5e1, \"t\": true, \"f\": false, \"z\": null, \"a\": [1, [2, 3], {}]}")
            catch { fail }
        try kinds(doc) catch { fail }
        assert (try (doc["s"] as Json.Str) catch default "") == "text"
        assert (try (doc["a"][1][1] as Json.Num) catch default 0.0) == 3.0
        assert (try (doc["a"][9] as Json.Num) catch default -1.0) == -1.0
        assert "s" in doc and "a" in doc and "missing" not in doc
        assert asking(doc, "missing") == "MISSING" and asking(doc, 0) == "WRONG_KIND"
        a := try doc["a"] catch { fail }
        assert asking(a, 3) == "MISSING" and asking(a, -1) == "MISSING" and asking(a, 2) == "ok"
        assert asking(a, "s") == "WRONG_KIND" and asking(try doc["s"] catch { fail }, 0) == "WRONG_KIND"
        wrong := false
        try (try doc["s"] catch { fail }).AsNum() catch JsonError.WRONG_KIND { wrong = true } catch { fail }
        assert wrong
        half := try Parse("2.5") catch { fail }
        notWhole := false
        try half.AsInt() catch JsonError.WRONG_KIND { notWhole = true } catch { fail }
        assert notWhole
        tooBig := false
        try (try Parse("1e19") catch { fail }).AsInt() catch JsonError.WRONG_KIND { tooBig = true } catch { fail }
        assert tooBig and (try (try Parse("-9223372036854775808") catch { fail }).AsInt() catch default 0) == -9223372036854775807 - 1
    }

    test "numbers are read to the nearest F64" {
        assert num("0") == 0.0 and num("-0").Bits() == U64(0x8000000000000000) and num("0").Bits() == 0
        assert num("1") == 1.0 and num("-1") == -1.0 and num("0.1") == 0.1 and num("0.30000000000000004") == 0.30000000000000004
        assert num("1e23") == 1e23 and num("8.98846567431158e307") == 8.98846567431158e307
        assert num("1.7976931348623157e308") == 1.7976931348623157e308
        assert num("2.2250738585072011e-308").Bits() == 0xFFFFFFFFFFFFF          # just below the smallest normal
        assert num("2.2250738585072014e-308").Bits() == 0x10000000000000
        assert num("4.9e-324").Bits() == 1 and num("2.4703282292062328e-324").Bits() == 1
        assert num("2.4703282292062327e-324") == 0.0                             # exactly half the smallest: to even
        assert num("1e-400") == 0.0 and num("-1e-400").Bits() == U64(0x8000000000000000)
        assert num("9007199254740993") == 9007199254740992.0                     # halfway: to even
        assert num("9007199254740993.00000000000000000001") == 9007199254740994.0 # past 19 digits, just above halfway
        assert num("0.1000000000000000055511151231257827021181583404541015625") == 0.1
        assert num("123456789012345678901234567890") == 1.2345678901234568e29
        assert num("1E2") == 100.0 and num("1e+2") == 100.0 and num("100e-2") == 1.0 and num("0e99") == 0.0
        assert num("-9223372036854775808") == -9223372036854775808.0
        assert problem("1e309") == "BAD_NUMBER 1:1" and problem("-1e400") == "BAD_NUMBER 1:1"
    }

    test "strings: escapes, \\u and surrogate pairs to UTF-8" {
        s := try (try Parse("\"a\\\"b\\\\c\\/d\\b\\f\\n\\r\\t\"") catch { fail }).AsStr() catch { fail }
        assert s == "a\"b\\c/d" $Char(8) $Char(12) "\n\r\t"
        e := try (try Parse("\"\\u00e9\\u4e2d\\ud83d\\ude00\\u0000!\"") catch { fail }).AsStr() catch { fail }
        assert e.Len() == 2 + 3 + 4 + 1 + 1
        assert e[0] == 0xC3 and e[1] == 0xA9 and e[2] == 0xE4 and e[3] == 0xB8 and e[4] == 0xAD
        assert e[5] == 0xF0 and e[6] == 0x9F and e[7] == 0x98 and e[8] == 0x80 and e[9] == 0 and e[10] == '!'
        raw := try (try Parse("[\"é中😀\"]") catch { fail })[0] catch { fail }
        assert (try raw.AsStr() catch { fail }) == "é中😀"
        assert problem("\"\\ud83d\"") == "BAD_ESCAPE 1:2" and problem("\"\\ude00\"") == "BAD_ESCAPE 1:2"
        assert problem("\"\\ud83dx\"") == "BAD_ESCAPE 1:2" and problem("\"\\x\"") == "BAD_ESCAPE 1:2"
        assert problem("\"\\u12g4\"") == "BAD_ESCAPE 1:6" and problem("\"\\u12") == "UNTERMINATED 1:6"
        assert problem("\"tab\there\"") == "UNEXPECTED 1:5" and problem("\"open") == "UNTERMINATED 1:6"
        bad := String(U8['"', 0xC3, '"'])
        assert problem(bad) == "BAD_UTF8 1:2"
        assert problem(String(U8['"', 0xED, 0xA0, 0x80, '"'])) == "BAD_UTF8 1:2"       # a surrogate written in UTF-8
        assert problem(String(U8['"', 0xC0, 0xAF, '"'])) == "BAD_UTF8 1:2"             # overlong
    }

    test "what is wrong, and where" {
        assert problem("") == "UNTERMINATED 1:1" and problem("   ") == "UNTERMINATED 1:4"
        assert problem("[1, 2") == "UNTERMINATED 1:6" and problem("{\"a\": 1") == "UNTERMINATED 1:8"
        assert problem("[1 2]") == "UNEXPECTED 1:4" and problem("[1,]") == "UNEXPECTED 1:4"
        assert problem("{\"a\" 1}") == "UNEXPECTED 1:6" and problem("{\"a\": 1,}") == "UNEXPECTED 1:9"
        assert problem("{a: 1}") == "UNEXPECTED 1:2" and problem("[tru]") == "UNEXPECTED 1:5"
        assert problem("[01]") == "BAD_NUMBER 1:3" and problem("[1.]") == "BAD_NUMBER 1:4"
        assert problem("-") == "BAD_NUMBER 1:2" and problem("1e") == "BAD_NUMBER 1:3" and problem(".5") == "UNEXPECTED 1:1"
        assert problem("+1") == "UNEXPECTED 1:1" and problem("NaN") == "UNEXPECTED 1:1"
        assert problem("[1] x") == "TRAILING 1:5" and problem("1 2") == "TRAILING 1:3"
        assert problem("{\n  \"a\": [1,\n        oops]\n}") == "UNEXPECTED 3:9"
        assert problem("[\"é\", x]") == "UNEXPECTED 1:7"                          # a column counts characters
        assert problem(" {\"a\":[{}, [], \"\", 0, -1.5e-3, true, false, null]} \n") == "ok"
        assert problem(String(U8[0xEF, 0xBB, 0xBF, '1'])) == "ok"                   # a byte order mark is passed over
    }

    test "nesting is bounded by MaxDepth" {
        deep := StringBuilder()
        for i in range MaxDepth { deep.PushChar('[') }
        for i in range MaxDepth { deep.PushChar(']') }
        assert problem(deep.ToString()) == "ok"
        deeper := StringBuilder()
        for i in range MaxDepth + 1 { deeper.Push("{\"a\":") }
        assert problem(deeper.ToString()) == "DEPTH 1:" $(5 * MaxDepth + 1)
        flood := StringBuilder()
        for i in range 100000 { flood.PushChar('[') }
        assert problem(flood.ToString()) == "DEPTH 1:" $(MaxDepth + 1)
    }

    test "Encode writes compact and indented text" {
        doc := try Parse("{\"a\": [1, 2.5, \"x\\ny\"], \"b\": {}, \"c\": [], \"d\": null, \"e\": true}") catch { fail }
        assert Encode(doc) == "{\"a\":[1,2.5,\"x\\ny\"],\"b\":{},\"c\":[],\"d\":null,\"e\":true}"
        assert Encode(doc, "  ") == "{\n  \"a\": [\n    1,\n    2.5,\n    \"x\\ny\"\n  ],\n  \"b\": {},\n  \"c\": [],\n  \"d\": null,\n  \"e\": true\n}"
        assert Encode(doc, "\t").StartsWith("{\n\t\"a\": [\n\t\t1,")
        assert $doc == Encode(doc)
        control := Json.Str(String(U8['"', '\\', 1, 0x1F, 0x7F, 'q']))
        assert Encode(control) == "\"\\\"\\\\\\u0001\\u001f" $Char(0x7F) "q\""
        nums := Json&[Json.Num(0.1), Json.Num(100.0), Json.Num(-0.0), Json.Num(1e21), Json.Num(1.5e-7), Json.Num(5e-324),
            Json.Num(123456789.125), Json.Num(1e16), Json.Num(1e17), Json.Num(0.0 / 0.0), Json.Num(1.0 / 0.0)]
        assert Encode(Json.Arr(nums)) == "[0.1,100,-0,1e+21,1.5e-07,5e-324,123456789.125,10000000000000000,1e+17,null,null]"
    }

    test "a number is written as the shortest text that reads back as it" {
        for x in F64[0.1, 1.0 / 3.0, 2.0 / 3.0, 1e23, 9007199254740993.0, 2.2250738585072014e-308, 4.9406564584124654e-324,
            1.7976931348623157e308, 7.120236347223045e-307, 123.456, -98765.4321e-12, 3.141592653589793] {
            text := Encode(Json.Num(x))
            assert num(text) == x and text.Len() <= ($x).Len()
        }
        assert Encode(Json.Num(7.120236347223045e-307)) == "7.120236347223045e-307"     # a power of two: 16 digits
    }

    test "what Encode writes, Parse reads back as an equal value" {
        text := "[{\"x\": 1, \"y\": [true, false, null, \"\\u00e9\\ud83d\\ude00\"]}, -0.0, 1e-300, \"\", {\"\": {}}]"
        doc := try Parse(text) catch { fail }
        again := try Parse(Encode(doc)) catch { fail }
        pretty := try Parse(Encode(doc, "    ")) catch { fail }
        assert doc == again and doc == pretty and Encode(again) == Encode(doc)
        assert Encode(doc) == "[{\"x\":1,\"y\":[true,false,null,\"é😀\"]},-0,1e-300,\"\",{\"\":{}}]"
    }

    test "objects keep their order, answer with the last of a repeated name, and index big ones" {
        doc := try Parse("{\"b\": 1, \"a\": 2, \"b\": 3}") catch { fail }
        assert (try (doc["b"] as Json.Num) catch default 0.0) == 3.0
        assert Encode(doc) == "{\"b\":1,\"a\":2,\"b\":3}"
        big := StringBuilder()
        big.PushChar('{')
        for i in range 500 {
            if i > 0 { big.PushChar(',') }
            big.Push("\"key" $i "\": " $(i * i))
        }
        big.Push(", \"key7\": -1}")
        o := try Parse(big.ToString()) catch { fail }
        for i in range 500 {
            want F64 = F64(i * i) if i != 7 else -1.0
            assert (try (o["key" $i] as Json.Num) catch default -2.0) == want
        }
        assert "key499" in o and "key500" not in o and "" not in o
        assert (try o.AsObj() catch { fail }).Len() == 501
    }

    test "two values are equal when they hold equal parts, objects in any order" {
        a := try Parse("{\"x\": [1, 2, {\"p\": null}], \"y\": \"s\"}") catch { fail }
        b := try Parse("{\"y\": \"s\", \"x\": [1.0, 2e0, {\"p\": null}]}") catch { fail }
        c := try Parse("{\"y\": \"s\", \"x\": [1, 2, {\"p\": false}]}") catch { fail }
        assert a == b and a != c and a.Hash() == b.Hash()
        assert (try Parse("0") catch { fail }) == (try Parse("-0") catch { fail })
        assert (try Parse("[1, 2]") catch { fail }) != (try Parse("[2, 1]") catch { fail })
        assert (try Parse("{\"a\": 1}") catch { fail }) != (try Parse("{\"a\": 1, \"b\": 2}") catch { fail })
    }

    test "values built in code" {
        o := Object(String&["name", "tags", "ok"], Json&[Json.Str("olang"), Json.Arr(Json&[Json.Num(1.0), Json.Null]),
            Json.Bool(true)])
        doc Json& = Json.Obj(o)
        assert Encode(doc) == "{\"name\":\"olang\",\"tags\":[1,null],\"ok\":true}"
        assert doc == (try Parse("{\"ok\": true, \"tags\": [1, null], \"name\": \"olang\"}") catch { fail })
        items := List<Json&>()
        for i in range 3 { items.Push(Json.Num(F64(i))) }
        assert Encode(Json.Arr(items.ToArray())) == "[0,1,2]"
    }

    # allocates and lets go of a few hundred texts, so storage a closed scope gave back is handed out again - anything
    # still pointing into such storage would read these bytes instead of its own
    fn churn() I64 {
        t I64 = 0
        for i in range 300 {
            s := $i "-------------------------------------------------------------"
            t += s.Len()
        }
        return t
    }

    fn parsed(n I64) Json& {
        return try Parse("{\"n\": " $n ", \"s\": \"value " $n "\", \"a\": [" $n ", {\"deep\": \"x\\ty\"}]}") catch { fail }
    }

    test "a tree lives where its caller puts it, and no longer needs the text" {
        doc := parsed(7)
        kept := List<Json&>()
        for i in range 5 { kept.Push(parsed(i)) }
        assert churn() > 0
        assert Encode(doc) == "{\"n\":7,\"s\":\"value 7\",\"a\":[7,{\"deep\":\"x\\ty\"}]}"
        for i, k in kept {
            assert (try (k["s"] as Json.Str) catch default "") == "value " $i
            assert (try (k["a"][1]["deep"] as Json.Str) catch default "") == "x\ty"
        }
    }

    # what the fixture holds, asked as a program would ask it
    fn fixture(doc Json&) ? JsonError {
        assert (try (try doc["authors"][0]["commits"]).AsInt()) == 1205
        assert (try doc["authors"][1]["email"]).IsNull()
        assert (try (try doc["limits"]["tiny"]).AsNum()).Bits() == 1
        assert (try (try doc["limits"]["neg"]).AsNum()).Bits() == U64(0x8000000000000000)
        assert (try (try doc["text"]).AsStr()) == "line one\nline \"two\"\ttabbed é 中 😀 \\ /"
        n I64 = 0
        for tag in try (try doc["tags"]).AsArr() { n += (try tag.AsStr()).Len() }
        assert n == 13
        assert (try (try doc["empty"]).AsObj()).Len() == 3
    }

    test "the fixture file" {
        text := try os.ReadFile("checks/fixtures/json/sample.json") catch { fail }
        at := Position()
        doc := try Parse(text, at) catch { fail }
        assert at.Offset == text.Len() and at.Line == 15 and at.Col == 1
        try fixture(doc) catch { fail }
        assert (try Parse(Encode(doc, "  ")) catch { fail }) == doc
    }

    # K1: Parse and Encode run while compiling - this global is baked, and agrees with the same work done at run time
    bakedText String& = Encode(try Parse("{\"a\": [1, 2.5e-3, \"\\u00e9\"], \"b\": {\"c\": null}}") catch default Json.Null)
    sourceText mut String& = "{\"a\": [1, 2.5e-3, \"\\u00e9\"], \"b\": {\"c\": null}}"

    test "Parse and Encode give the same while compiling as at run time" {
        assert bakedText == "{\"a\":[1,0.0025,\"é\"],\"b\":{\"c\":null}}"
        assert Encode(try Parse(sourceText) catch { fail }) == bakedText
    }
}
