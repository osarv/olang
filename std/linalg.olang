# linalg - dense linear algebra on Matrix<T>, the operand of numeric and neural-network code: matrix products, element
# operations, reductions, random fills, linear systems.
#
# A Matrix<T> is two-dimensional and row-major, with a row stride: element (r, c) is Data[r * Stride + c]. Rows are the
# samples of a batch and columns their features; structure beyond two dimensions belongs to the operation that needs
# it, which takes it as parameters and interprets a row itself - a convolution told C, H and W lowers to im2col into a
# workspace matrix and one product; attention keeps each head as a column block (ColRange, a strided view) and runs
# its products on those views. Transposition is likewise a parameter of the products (Gemm's transA and transB, or
# m.T() in an expression), never a layout: A^T B and A B^T read A and B where they are.
#
# A matrix is a VIEW - its shape, its stride and a slice of storage - so copying one copies the view, never the
# elements (Clone does that), and one made over existing storage (View, RowRange, ColRange, Block) allocates nothing.
# Matrix<F32>(rows, cols) is a new zero-filled matrix, built where it lands like any other value (O18a).
#
# Two kinds of operation, and the difference is what a loop pays:
# - forms with a DESTINATION write into a matrix the caller already has and allocate nothing: Gemm, Map/Map2/Map3,
#   Add, Sub, Scale, AddScaled, AddRow, Fill, Copy, ColumnSums, RowSums, RowMax, ArgMaxRows, the random fills.
#   A training step written with them allocates nothing at all.
# - operators and the rest (a + b, a @ b, a.T() @ b, -a, m.Exp(), Clone) build a new matrix each time - for scripts,
#   and anywhere a result is wanted once. Note that "a += b" is "a = a + b" (E31): a new matrix, not an in-place add;
#   a.Add(b) is the in-place one.
#
# Shapes are checked once per operation, never per element: a mismatch aborts, as an out-of-range slice does, and
# under try - try (a + b), try (a @ b) - it is the error ShapeError.MISMATCH instead. Every check is one of the
# functions in the "shapes" section, so that when dimensions move into the type (Matrix<T, R, C>, each a constant or
# known at run time) they move in one place. Element access (Get, Set) is unchecked, as an array index is (E16).
#
# Element types: every numeric type. F16 and BF16 are stored as they are and computed in F32 where it matters - the
# products accumulate in F32 and round once, and so do the sums - and the F8 types (F8E4M3, F8E5M2) are storage that
# the products and conversions read. Integer arithmetic wraps (E6c).
#
# Threads: a product large enough to be worth it is split over linalg.Threads tasks (the machine's cores unless set),
# by rows of the result, so its result does not depend on the thread count. ParallelRows gives the same splitting to
# the row-wise kernels a caller writes itself.

import "std/math"
import "std/rand"

extern fn sysconf(name I32) I64

# a shape that does not fit the operation - two operands of different shapes, a product whose inner dimensions differ
error ShapeError {
    MISMATCH
}

# a linear system with no unique solution
error SolveError {
    SINGULAR
}

# ---- the matrix ----

# a Rows x Cols matrix: over data (from the element at its start, row r at r * stride) when it is given, and over new,
# zero-filled storage when it is not. stride defaults to Cols, which makes the rows contiguous
type Matrix<T> struct(Rows I64, Cols I64, data mut Array<<T>>& = null, stride I64 = 0) {
    Rows
    Cols
    Stride I64 = stride if stride > 0 else Cols
    assert Rows >= 0 and Cols >= 0 and Stride >= Cols
    assert data == null or Rows == 0 or data.Len() >= (Rows - 1) * Stride + Cols
    Data mut Array<<T>>& = data if data != null else Array<<T>>(Rows * Cols)
}

# a rows x cols matrix over the caller's storage, starting at data[offset], row r at offset + r * stride (stride
# defaults to cols) - the way to lay matrices out in an arena the caller owns. It allocates nothing; writing it writes
# data
fn View(data mut Array<<T>>&, offset I64, rows I64, cols I64, stride I64 = 0) Matrix<<T>> {
    s I64 = stride if stride > 0 else cols
    n I64 = (rows - 1) * s + cols if rows > 0 else 0
    return Matrix<<T>>(rows, cols, data[offset:offset + n], s)
}

# a rows x cols matrix with every element v
fn Full(rows I64, cols I64, v <T>) Matrix<<T>> {
    m Matrix<<T>>&return = Matrix<<T>>(rows, cols, null)
    m.Fill(v)
    return m
}

# a matrix holding the given rows, which must all have one length: linalg.FromRows(Array<F64>&[F64[1, 2], F64[3, 4]])
fn FromRows(rows Array<Array<<T>>&>&) Matrix<<T>> {
    cols I64 = rows[0].Len() if rows.Len() > 0 else 0
    m Matrix<<T>>&return = Matrix<<T>>(rows.Len(), cols, null)
    for r, row in rows {
        assert row.Len() == cols
        for c in range cols { m.Data[r * m.Stride + c] = row[c] }
    }
    return m
}

# the element at row r, column c - unchecked, as an array index is (E16)
fn (m Matrix<<T>>&) Get(r I64, c I64) <T> { return m.Data[r * m.Stride + c] }

# sets the element at row r, column c - unchecked
fn (m Matrix<<T>>&) Set(r I64, c I64, v <T>) { m.Data[r * m.Stride + c] = v }

# row i as an array view of its Cols elements: writing it writes the matrix. Out of range aborts (E16b)
fn (m Matrix<<T>>&) Row(i I64) mut Array<<T>>&m { return m.Data[i * m.Stride:i * m.Stride + m.Cols] }

# whether the rows follow one another with no gap, so the elements are one run of Rows * Cols in Data
fn (m Matrix<<T>>&) Contiguous() Bool { return m.Stride == m.Cols or m.Rows <= 1 }

# ---- shapes: every check an operation makes, in one place ----

fn sameShape(a Matrix<<T>>&, b Matrix<<U>>&) Bool { return a.Rows == b.Rows and a.Cols == b.Cols }

# whether r is a row of m's width: a 1 x m.Cols matrix
fn rowShape(m Matrix<<T>>&, r Matrix<<T>>&) Bool { return r.Rows == 1 and r.Cols == m.Cols }

# whether c (m x n) can hold op(a) op(b): op(a) is m x k and op(b) k x n
fn productShape(c Matrix<<T>>&, a Matrix<<T>>&, transA Bool, b Matrix<<T>>&, transB Bool) Bool {
    am I64 = a.Cols if transA else a.Rows
    ak I64 = a.Rows if transA else a.Cols
    bk I64 = b.Cols if transB else b.Rows
    bn I64 = b.Rows if transB else b.Cols
    return ak == bk and c.Rows == am and c.Cols == bn
}

# whether lo .. hi is a range within 0 .. n
fn rangeShape(lo I64, hi I64, n I64) Bool { return 0 <= lo and lo <= hi and hi <= n }

# ---- views: none of these allocates ----

# rows lo .. hi (hi not included), sharing m's storage
fn (m Matrix<<T>>&) RowRange(lo I64, hi I64) Matrix<<T>> {
    assert rangeShape(lo, hi, m.Rows)
    return View(m.Data, lo * m.Stride, hi - lo, m.Cols, m.Stride)
}

# columns lo .. hi, sharing m's storage: a view whose stride is wider than its rows
fn (m Matrix<<T>>&) ColRange(lo I64, hi I64) Matrix<<T>> {
    assert rangeShape(lo, hi, m.Cols)
    return View(m.Data, lo, m.Rows, hi - lo, m.Stride)
}

# the rows x cols block whose first element is (r, c), sharing m's storage
fn (m Matrix<<T>>&) Block(r I64, c I64, rows I64, cols I64) Matrix<<T>> {
    assert rangeShape(r, r + rows, m.Rows) and rangeShape(c, c + cols, m.Cols)
    return View(m.Data, r * m.Stride + c, rows, cols, m.Stride)
}

# the same elements in row-major order as a rows x cols matrix, sharing m's storage - so m must be contiguous, and
# rows * cols its size
fn (m Matrix<<T>>&) Reshape(rows I64, cols I64) Matrix<<T>> {
    assert m.Contiguous() and rows * cols == m.Rows * m.Cols
    return View(m.Data, 0, rows, cols, cols)
}

# m transposed, as an operand of the products: a.T() @ b is A^T B, read where A is. It is not a matrix of its own -
# Clone() makes one
type Transposed<T> struct(of Matrix<<T>>&) {
    M Matrix<<T>>&of = of
}

fn (m Matrix<<T>>&) T() Transposed<<T>> { return Transposed<<T>>(m) }

# the transpose as a matrix of its own: Cols x Rows, new storage
fn (t Transposed<<T>>&) Clone() Matrix<<T>> {
    out Matrix<<T>>&return = Matrix<<T>>(t.M.Cols, t.M.Rows, null)
    out.Copy(t)
    return out
}

# ---- element kernels: one pass, in row order, a function value applied to each element ----
#
# Each writes its destination and allocates nothing. The function is a lambda written at the call, which is inlined
# into the loop (a function value's code is a value the optimizer follows, T21), so dst.Map2(a, b, fn(x, y) { return
# x * y }) runs as the loop written out would. A destination may be one of the operands itself - each element is read
# before it is written - but not another view overlapping one.

# dst = f(a), element by element
fn (dst Matrix<<T>>&) Map(a Matrix<<T>>&, f fn(x <T>) <T>) {
    assert sameShape(dst, a)
    if dst.Contiguous() and a.Contiguous() {
        for i in range dst.Rows * dst.Cols { dst.Data[i] = f(a.Data[i]) }
        return
    }
    for r in range dst.Rows {
        d I64 = r * dst.Stride
        x I64 = r * a.Stride
        for c in range dst.Cols { dst.Data[d + c] = f(a.Data[x + c]) }
    }
}

# dst = f(a, b), element by element
fn (dst Matrix<<T>>&) Map2(a Matrix<<T>>&, b Matrix<<T>>&, f fn(x <T>, y <T>) <T>) {
    assert sameShape(dst, a) and sameShape(dst, b)
    if dst.Contiguous() and a.Contiguous() and b.Contiguous() {
        for i in range dst.Rows * dst.Cols { dst.Data[i] = f(a.Data[i], b.Data[i]) }
        return
    }
    for r in range dst.Rows {
        d I64 = r * dst.Stride
        x I64 = r * a.Stride
        y I64 = r * b.Stride
        for c in range dst.Cols { dst.Data[d + c] = f(a.Data[x + c], b.Data[y + c]) }
    }
}

# dst = f(a, b, c), element by element - a fused update of three operands, an optimizer's step say
fn (dst Matrix<<T>>&) Map3(a Matrix<<T>>&, b Matrix<<T>>&, c Matrix<<T>>&, f fn(x <T>, y <T>, z <T>) <T>) {
    assert sameShape(dst, a) and sameShape(dst, b) and sameShape(dst, c)
    if dst.Contiguous() and a.Contiguous() and b.Contiguous() and c.Contiguous() {
        for i in range dst.Rows * dst.Cols { dst.Data[i] = f(a.Data[i], b.Data[i], c.Data[i]) }
        return
    }
    for r in range dst.Rows {
        d I64 = r * dst.Stride
        x I64 = r * a.Stride
        y I64 = r * b.Stride
        z I64 = r * c.Stride
        for k in range dst.Cols { dst.Data[d + k] = f(a.Data[x + k], b.Data[y + k], c.Data[z + k]) }
    }
}

# every element v
fn (m Matrix<<T>>&) Fill(v <T>) { m.Map(m, fn(x) { return v }) }

# the identity: ones on the diagonal, zeros elsewhere
fn (m Matrix<<T>>&) SetIdentity() {
    z <T>
    m.Fill(z)
    for i in range lesser(m.Rows, m.Cols) { m.Data[i * m.Stride + i] = 1 }
}

# m = src, element by element - src a matrix of m's shape, or a transposed one (src.T())
fn (m Matrix<<T>>&) Copy(src <U>) {
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { m.Map(src, fn(x) { return x }) }
        case Transposed<<T>>, Transposed<<T>>& {
            s := src.M
            assert m.Rows == s.Cols and m.Cols == s.Rows
            # in blocks of 32 x 32, so both sides stay in the cache whichever way they are walked
            for r0 in range 0, m.Rows, 32 {
                for c0 in range 0, m.Cols, 32 {
                    for r in range r0, lesser(r0 + 32, m.Rows) {
                        for c in range c0, lesser(c0 + 32, m.Cols) { m.Data[r * m.Stride + c] = s.Data[c * s.Stride + r] }
                    }
                }
            }
        }
    }
}

# m += x
fn (m Matrix<<T>>&) Add(x Matrix<<T>>&) { m.Map2(m, x, fn(a, b) { return a + b }) }

# m -= x
fn (m Matrix<<T>>&) Sub(x Matrix<<T>>&) { m.Map2(m, x, fn(a, b) { return a - b }) }

# m *= k
fn (m Matrix<<T>>&) Scale(k <T>) { m.Map(m, fn(a) { return a * k }) }

# m += alpha * x - BLAS's axpy
fn (m Matrix<<T>>&) AddScaled(x Matrix<<T>>&, alpha <T>) { m.Map2(m, x, fn(a, b) { return a + alpha * b }) }

# every row += bias, a 1 x Cols matrix: a layer's bias added to a batch, read where it is
fn (m Matrix<<T>>&) AddRow(bias Matrix<<T>>&) {
    assert rowShape(m, bias)
    for r in range m.Rows {
        d I64 = r * m.Stride
        for c in range m.Cols { m.Data[d + c] = m.Data[d + c] + bias.Data[c] }
    }
}

# ---- new matrices: the operators, for scripts and one-off results ----
#
# Each builds its result where it lands (O18a). A matrix operand must have the receiver's shape; a scalar operand is
# of the element type exactly - a literal does not adapt through the operator's generic operand, so an F32 matrix is
# scaled by m * F32(0.5), or in place by m.Scale(0.5)

fn (a Matrix<<T>>&) Plus(b <U>) Matrix<<T>> {
    out Matrix<<T>>&return = Matrix<<T>>(a.Rows, a.Cols, null)
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { out.Map2(a, b, fn(x, y) { return x + y }) }
        case <T> { out.Map(a, fn(x) { return x + b }) }
    }
    return out
}

fn (a Matrix<<T>>&) Minus(b <U>) Matrix<<T>> {
    out Matrix<<T>>&return = Matrix<<T>>(a.Rows, a.Cols, null)
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { out.Map2(a, b, fn(x, y) { return x - y }) }
        case <T> { out.Map(a, fn(x) { return x - b }) }
    }
    return out
}

# element by element (the Hadamard product) - the matrix product is "@"
fn (a Matrix<<T>>&) Mul(b <U>) Matrix<<T>> {
    out Matrix<<T>>&return = Matrix<<T>>(a.Rows, a.Cols, null)
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { out.Map2(a, b, fn(x, y) { return x * y }) }
        case <T> { out.Map(a, fn(x) { return x * b }) }
    }
    return out
}

fn (a Matrix<<T>>&) Div(b <U>) Matrix<<T>> {
    out Matrix<<T>>&return = Matrix<<T>>(a.Rows, a.Cols, null)
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { out.Map2(a, b, fn(x, y) { return x / y }) }
        case <T> { out.Map(a, fn(x) { return x / b }) }
    }
    return out
}

fn (a Matrix<<T>>&) Neg() Matrix<<T>> {
    out Matrix<<T>>&return = Matrix<<T>>(a.Rows, a.Cols, null)
    out.Map(a, fn(x) { return -x })
    return out
}

# the checked forms: what try (a + b) calls, failing with ShapeError.MISMATCH where the operator would abort
fn (a Matrix<<T>>&) TryPlus(b <U>) Matrix<<T>> ? ShapeError {
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { if not sameShape(a, b) { error ShapeError.MISMATCH } }
        nomatch { }
    }
    return a + b
}

fn (a Matrix<<T>>&) TryMinus(b <U>) Matrix<<T>> ? ShapeError {
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { if not sameShape(a, b) { error ShapeError.MISMATCH } }
        nomatch { }
    }
    return a - b
}

fn (a Matrix<<T>>&) TryMul(b <U>) Matrix<<T>> ? ShapeError {
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { if not sameShape(a, b) { error ShapeError.MISMATCH } }
        nomatch { }
    }
    return a * b
}

fn (a Matrix<<T>>&) TryDiv(b <U>) Matrix<<T>> ? ShapeError {
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { if not sameShape(a, b) { error ShapeError.MISMATCH } }
        nomatch { }
    }
    return a / b
}

# a copy with storage of its own, contiguous
fn (m Matrix<<T>>&) Clone() Matrix<<T>> {
    out Matrix<<T>>&return = Matrix<<T>>(m.Rows, m.Cols, null)
    out.Copy(m)
    return out
}

# f applied to every element, into a new matrix
fn (m Matrix<<T>>&) Mapped(f fn(x <T>) <T>) Matrix<<T>> {
    out Matrix<<T>>&return = Matrix<<T>>(m.Rows, m.Cols, null)
    out.Map(m, f)
    return out
}

# the floating-point functions of std/math, element by element, into a new matrix
fn (m Matrix<<T>>&) Exp() Matrix<<T>> { return m.Mapped(fn(x) { return math.Exp(x) }) }
fn (m Matrix<<T>>&) Log() Matrix<<T>> { return m.Mapped(fn(x) { return math.Log(x) }) }
fn (m Matrix<<T>>&) Tanh() Matrix<<T>> { return m.Mapped(fn(x) { return math.Tanh(x) }) }
fn (m Matrix<<T>>&) Sqrt() Matrix<<T>> { return m.Mapped(fn(x) { return math.Sqrt(x) }) }
fn (m Matrix<<T>>&) Abs() Matrix<<T>> { return m.Mapped(fn(x) { return math.Abs(x) }) }

fn lesser(a I64, b I64) I64 { return a if a < b else b }
# ---- matrix multiplication ----
#
# Gemm computes C = alpha * op(A) op(B) + beta * C, where op(X) is X or its transpose, for row-major matrices held in
# arrays with a row stride: element (i, j) of a matrix with stride ld is x[i * ld + j]. It is the one kernel every
# product in this module goes through.
#
# The algorithm is the one BLAS libraries use (Goto's, as in BLIS): C is computed in blocks sized for the caches -
# KC rows of B by NC columns packed into a contiguous panel that stays in the L3 (or L2) cache, MC rows of A by KC
# packed into one that stays in L2 - and each block by a micro-kernel computing an MR x NR tile of C entirely in
# registers, one rank-1 update per step of k, reading both panels in the order they were packed. Packing is also
# where the transposes are applied and where F16 and BF16 are widened to F32, so the micro-kernel only ever sees
# contiguous panels of its own accumulation type. Edges are padded with zeros in the panels; a partial tile is
# written back through a full one.
#
# The micro-kernels are written with LITERAL tile sizes, never named constants: an immutable global is emitted as a
# mutable LLVM global, so the per-module optimizer cannot see its value, and the tile loops are then neither fully
# unrolled nor the accumulators kept in registers - measured at 10.8 against 17.5 GFLOPS. Each accumulator is read
# and written only at constant positions, which is what lets LLVM keep all of them in registers.

kc I64 = 256          # the depth of a panel - k per block
mc I64 = 128         # the rows of A per block - a multiple of the tiles' 4 rows
nc I64 = 2040         # the columns of B per block - a multiple of every tile's columns

# the number of cores, from the C library (84 is glibc's _SC_NPROCESSORS_ONLN on Linux)
fn cores() I64 {
    n := sysconf(84)
    return n if n > 0 else 1
}

# how many threads a large product is split over; set it to 1 to keep every product on the calling thread
Threads mut I64 = cores()

# x as a D, rounded or wrapped as a conversion D(x) does (T4) - from or to an F8 type through F64, the F8 types' own
# way in and out
fn convert(x <S>, like <D>) <D> {
    match <S> {
        case F8E4M3, F8E5M2 { return convert(x.F64(), like) }
        nomatch {
            return match <D> {
                case F8E4M3 => F8E4M3(F64(x))
                case F8E5M2 => F8E5M2(F64(x))
                case F16 => F16(x)
                case BF16 => BF16(x)
                case F32 => F32(x)
                case F64 => F64(x)
                case I8 => I8(x)
                case I16 => I16(x)
                case I32 => I32(x)
                case I64 => I64(x)
                case U8 => U8(x)
                case U16 => U16(x)
                case U32 => U32(x)
                case U64 => U64(x)
            }
        }
    }
}

# a tile of accumulators, kept in registers by the micro-kernels (an inline array, indexed only at constants)
type tile<A> struct() {
    v mut Array<<A>> = Array<<A>>(48)
}

# A[i0 : i0 + rows, p0 : p0 + depth] (or of A's transpose) packed into ap as panels of mr rows: panel r holds, for
# each k, the mr values of rows r * mr ... r * mr + mr - 1 of column k; rows past the end are zeros
fn packA(transA Bool, a Array<<T>>&, lda I64, i0 I64, p0 I64, rows I64, depth I64, mr I64, ap mut Array<<A>>&) {
    z <A>
    for r in range 0, rows, mr {
        base I64 = r * depth
        for k in range depth {
            for i in range mr {
                v <A> = z
                if r + i < rows {
                    v = convert(a[(p0 + k) * lda + i0 + r + i] if transA else a[(i0 + r + i) * lda + p0 + k], z)
                }
                ap[base + k * mr + i] = v
            }
        }
    }
}

# B[p0 : p0 + depth, j0 : j0 + cols] (or of B's transpose) packed into bp as panels of nr columns
fn packB(transB Bool, b Array<<T>>&, ldb I64, p0 I64, j0 I64, depth I64, cols I64, nr I64, bp mut Array<<A>>&) {
    z <A>
    for c in range 0, cols, nr {
        base I64 = c * depth
        for k in range depth {
            for j in range nr {
                v <A> = z
                if c + j < cols {
                    v = convert(b[(j0 + c + j) * ldb + p0 + k] if transB else b[(p0 + k) * ldb + j0 + c + j], z)
                }
                bp[base + k * nr + j] = v
            }
        }
    }
}

# the micro-kernels: C[i, j] = alpha * sum over k of ap[k][i] * bp[k][j] + beta * C[i, j] for one MR x NR tile, where
# rows and cols say how much of the tile is inside C. beta == 0 never reads C, so C may hold anything (BLAS's rule).
# 4 x 12 for four-lane element types (F32 and smaller: 12 accumulator registers of an SSE machine's 16), 4 x 6 for
# two-lane ones (F64, I64)
fn micro4x12(depth I64, ap Array<<A>>&, ao I64, bp Array<<A>>&, bo I64, alpha <A>, beta <A>, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64) {
    acc := tile<<A>>()
    for k in range depth {
        for i in range 4 {
            ai := ap[ao + k * 4 + i]
            for j in range 12 { acc.v[i * 12 + j] += ai * bp[bo + k * 12 + j] }
        }
    }
    # the accumulators leave the registers in row order, which is also what lets the vectorizer group them by rows
    out := tile<<A>>()
    for i in range 4 {
        for j in range 12 { out.v[i * 12 + j] = acc.v[i * 12 + j] }
    }
    storeTile(out, 12, alpha, beta, c, co, ldc, rows, cols)
}

fn micro4x6(depth I64, ap Array<<A>>&, ao I64, bp Array<<A>>&, bo I64, alpha <A>, beta <A>, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64) {
    acc := tile<<A>>()
    for k in range depth {
        for i in range 4 {
            ai := ap[ao + k * 4 + i]
            for j in range 6 { acc.v[i * 6 + j] += ai * bp[bo + k * 6 + j] }
        }
    }
    # the accumulators leave the registers in row order, which is also what lets the vectorizer group them by rows
    out := tile<<A>>()
    for i in range 4 {
        for j in range 6 { out.v[i * 6 + j] = acc.v[i * 6 + j] }
    }
    storeTile(out, 6, alpha, beta, c, co, ldc, rows, cols)
}

# C[i, j] = alpha * t[i, j] + beta * C[i, j] for the rows x cols part of a tile held in t, row stride ts
fn storeTile(t tile<<A>>&, ts I64, alpha <A>, beta <A>, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64) {
    like <T>
    if beta == 0 {
        for i in range rows {
            for j in range cols { c[co + i * ldc + j] = convert(alpha * t.v[i * ts + j], like) }
        }
        return
    }
    for i in range rows {
        for j in range cols { c[co + i * ldc + j] = convert(alpha * t.v[i * ts + j] + beta * convert(c[co + i * ldc + j], alpha), like) }
    }
}

# the columns of the tile for accumulation type A: 12 for four-lane types, 6 for two-lane ones
fn tileCols(z <A>) I64 {
    return match <A> {
        case F64, I64, U64 => 6
        nomatch => 12
    }
}

# rows i0 .. i1 of C for one packed block of B: each task's share of a product
fn gemmRows(transA Bool, a Array<<T>>&, lda I64, i0 I64, i1 I64, p0 I64, depth I64, cols I64, alpha <A>, bp Array<<A>>&, beta <A>, c mut Array<<T>>&, ldc I64, j0 I64) {
    nr := tileCols(alpha)
    ap := Array<<A>>(mc * depth)
    for ic in range i0, i1, mc {
        rows I64 = lesser(mc, i1 - ic)
        packA(transA, a, lda, ic, p0, rows, depth, 4, ap)
        for jr in range 0, cols, nr {
            for ir in range 0, rows, 4 {
                co I64 = (ic + ir) * ldc + j0 + jr
                match <A> {
                    case F64, I64, U64 {
                        micro4x6(depth, ap, ir * depth, bp, jr * depth, alpha, beta, c, co, ldc, lesser(4, rows - ir), lesser(nr, cols - jr))
                    }
                    nomatch {
                        micro4x12(depth, ap, ir * depth, bp, jr * depth, alpha, beta, c, co, ldc, lesser(4, rows - ir), lesser(nr, cols - jr))
                    }
                }
            }
        }
    }
}

# Gemm in accumulation type A (the type of z)
fn gemmIn(transA Bool, transB Bool, m I64, n I64, k I64, alpha <T>, a Array<<T>>&, lda I64, b Array<<T>>&, ldb I64, beta <T>, c mut Array<<T>>&, ldc I64, z <A>) {
    al := convert(alpha, z)
    be := convert(beta, z)
    nr := tileCols(z)
    if k == 0 {
        for i in range m {
            for j in range n { c[i * ldc + j] = convert(be * convert(c[i * ldc + j], z), alpha) if be != 0 else convert(z, alpha) }
        }
        return
    }
    depthMax I64 = lesser(k, kc)
    colsMax I64 = lesser((n + nr - 1) / nr * nr, nc)
    bp := Array<<A>>(depthMax * colsMax)
    # tasks: each takes a run of rows, a multiple of 4; small products stay on the calling thread
    tasks I64 = lesser(Threads, (m + 3) / 4)
    if m * n * k < 2000000 { tasks = 1 }
    share I64 = ((m + tasks - 1) / tasks + 3) / 4 * 4
    for jc in range 0, n, nc {
        cols I64 = lesser(nc, n - jc)
        for pc in range 0, k, kc {
            depth I64 = lesser(kc, k - pc)
            packB(transB, b, ldb, pc, jc, depth, cols, nr, bp)
            bt <A> = be if pc == 0 else convert(1, z)
            if tasks == 1 {
                gemmRows(transA, a, lda, 0, m, pc, depth, cols, al, bp, bt, c, ldc, jc)
            } else {
                join {
                    for t in range tasks {
                        lo I64 = t * share
                        hi I64 = lesser(m, lo + share)
                        if lo < hi { spawn gemmRows(transA, a, lda, lo, hi, pc, depth, cols, al, bp, bt, c, ldc, jc) }
                    }
                }
            }
        }
    }
}

# C = alpha * op(A) op(B) + beta * C on arrays: an m x k op(A), a k x n op(B) and an m x n C, each row-major with a
# row stride (lda, ldb, ldc) - op(A) is A, or A's transpose when transA, so A is then stored k x m
fn gemm(transA Bool, transB Bool, m I64, n I64, k I64, alpha <T>, a Array<<T>>&, lda I64, b Array<<T>>&, ldb I64, beta <T>, c mut Array<<T>>&, ldc I64) {
    if m == 0 or n == 0 { return }
    match <T> {
        case F16, BF16, F8E4M3, F8E5M2 { gemmIn(transA, transB, m, n, k, alpha, a, lda, b, ldb, beta, c, ldc, F32(0)) }
        nomatch {
            z <T>
            gemmIn(transA, transB, m, n, k, alpha, a, lda, b, ldb, beta, c, ldc, z)
        }
    }
}

# ---- products of matrices ----

# c = alpha * op(a) op(b) + beta * c, where op(x) is x or, when its flag is set, x's transpose - read where x is, never
# transposed in memory. beta = 1 accumulates (a gradient's second contribution, with no temporary); beta = 0 never
# reads c, so c may hold anything. c must not overlap a or b. Allocates only the panels the product packs into, in
# its own scope; large products are split over Threads tasks. alpha and beta are F64, so a literal is written as it
# is whatever the element type; each is converted to it once
fn Gemm(c Matrix<<T>>&, a Matrix<<T>>&, transA Bool, b Matrix<<T>>&, transB Bool, alpha F64 = 1, beta F64 = 0) {
    assert productShape(c, a, transA, b, transB)
    k I64 = a.Rows if transA else a.Cols
    like <T>
    gemm(transA, transB, c.Rows, c.Cols, k, convert(alpha, like), a.Data, a.Stride, b.Data, b.Stride, convert(beta, like), c.Data, c.Stride)
}

# a @ b, the matrix product - b a matrix, or a transposed one (a @ b.T() is A B^T)
fn (a Matrix<<T>>&) MatMul(b <U>) Matrix<<T>> {
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& {
            out Matrix<<T>>&return = Matrix<<T>>(a.Rows, b.Cols, null)
            Gemm(out, a, false, b, false)
            return out
        }
        case Transposed<<T>>, Transposed<<T>>& {
            out Matrix<<T>>&return = Matrix<<T>>(a.Rows, b.M.Rows, null)
            Gemm(out, a, false, b.M, true)
            return out
        }
    }
}

# a.T() @ b, A^T B, and a.T() @ b.T()
fn (a Transposed<<T>>&) MatMul(b <U>) Matrix<<T>> {
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& {
            out Matrix<<T>>&return = Matrix<<T>>(a.M.Cols, b.Cols, null)
            Gemm(out, a.M, true, b, false)
            return out
        }
        case Transposed<<T>>, Transposed<<T>>& {
            out Matrix<<T>>&return = Matrix<<T>>(a.M.Cols, b.M.Rows, null)
            Gemm(out, a.M, true, b.M, true)
            return out
        }
    }
}

# what try (a @ b) calls: ShapeError.MISMATCH where the inner dimensions differ
fn (a Matrix<<T>>&) TryMatMul(b <U>) Matrix<<T>> ? ShapeError {
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { if a.Cols != b.Rows { error ShapeError.MISMATCH } }
        case Transposed<<T>>, Transposed<<T>>& { if a.Cols != b.M.Cols { error ShapeError.MISMATCH } }
    }
    return a @ b
}

fn (a Transposed<<T>>&) TryMatMul(b <U>) Matrix<<T>> ? ShapeError {
    match <U> {
        case Matrix<<T>>, Matrix<<T>>& { if a.M.Rows != b.Rows { error ShapeError.MISMATCH } }
        case Transposed<<T>>, Transposed<<T>>& { if a.M.Rows != b.M.Cols { error ShapeError.MISMATCH } }
    }
    return a @ b
}

# x y^T for two vectors: an x.Len() x y.Len() matrix
fn Outer(x Array<<T>>&, y Array<<T>>&) Matrix<<T>> {
    out Matrix<<T>>&return = Matrix<<T>>(x.Len(), y.Len(), null)
    for r in range x.Len() {
        xr := x[r]
        d I64 = r * out.Stride
        for c in range y.Len() { out.Data[d + c] = xr * y[c] }
    }
    return out
}

# ---- reductions ----
#
# A sum runs in the accumulation type (F32 for F16, BF16 and the F8 types, the element type otherwise) and in sixteen
# lanes - sixteen partial sums, combined pairwise at the end - which is what lets it run in vector registers, since
# floating-point addition may not be reordered behind the program's back; the lanes also keep the rounding error of a
# long sum near that of pairwise summation. The order is fixed, so a sum is the same on every run.

type lanes<A> struct() {
    v mut Array<<A>> = Array<<A>>(16)
}

# the sixteen lanes added up pairwise
fn (l mut lanes<<A>>&) total() <A> {
    for w in range 3 {
        h I64 = 8 >> w
        for i in range h { l.v[i] = l.v[i] + l.v[i + h] }
    }
    return l.v[0] + l.v[1]
}

# the sum of x[from .. from + n] times f(...) - the one loop every sum is: lane j takes elements j, j + 16, ...
fn sumRun(x Array<<T>>&, from I64, n I64, z <A>) <A> {
    acc := lanes<<A>>()
    whole I64 = n - n % 16
    for i in range 0, whole, 16 {
        for j in range 16 { acc.v[j] = acc.v[j] + convert(x[from + i + j], z) }
    }
    for i in range whole, n { acc.v[i - whole] = acc.v[i - whole] + convert(x[from + i], z) }
    return acc.total()
}

# the sum of x[i] * y[i] over a run, in the same lanes
fn dotRun(x Array<<T>>&, xf I64, y Array<<T>>&, yf I64, n I64, z <A>) <A> {
    acc := lanes<<A>>()
    whole I64 = n - n % 16
    for i in range 0, whole, 16 {
        for j in range 16 { acc.v[j] = acc.v[j] + convert(x[xf + i + j], z) * convert(y[yf + i + j], z) }
    }
    for i in range whole, n { acc.v[i - whole] = acc.v[i - whole] + convert(x[xf + i], z) * convert(y[yf + i], z) }
    return acc.total()
}

fn sumIn(m Matrix<<T>>&, z <A>) <A> {
    if m.Contiguous() { return sumRun(m.Data, 0, m.Rows * m.Cols, z) }
    s <A> = z
    for r in range m.Rows { s = s + sumRun(m.Data, r * m.Stride, m.Cols, z) }
    return s
}

fn dotIn(a Matrix<<T>>&, b Matrix<<T>>&, z <A>) <A> {
    if a.Contiguous() and b.Contiguous() { return dotRun(a.Data, 0, b.Data, 0, a.Rows * a.Cols, z) }
    s <A> = z
    for r in range a.Rows { s = s + dotRun(a.Data, r * a.Stride, b.Data, r * b.Stride, a.Cols, z) }
    return s
}

# the sum of every element
fn (m Matrix<<T>>&) Sum() <T> {
    like <T>
    return match <T> {
        case F16, BF16, F8E4M3, F8E5M2 => convert(sumIn(m, F32(0)), like)
        nomatch => sumIn(m, like)
    }
}

# the mean of every element - for a float matrix
fn (m Matrix<<T>>&) Mean() <T> {
    like <T>
    return match <T> {
        case F16, BF16, F8E4M3, F8E5M2 => convert(sumIn(m, F32(0)) / F32(m.Rows * m.Cols), like)
        nomatch => sumIn(m, like) / convert(m.Rows * m.Cols, like)
    }
}

# the sum of the products of corresponding elements - the Frobenius inner product; two vectors' dot product when
# both are one row
fn (a Matrix<<T>>&) Dot(b Matrix<<T>>&) <T> {
    assert sameShape(a, b)
    like <T>
    return match <T> {
        case F16, BF16, F8E4M3, F8E5M2 => convert(dotIn(a, b, F32(0)), like)
        nomatch => dotIn(a, b, like)
    }
}

# the Frobenius norm: the square root of the sum of the squares - for a float matrix
fn (m Matrix<<T>>&) Norm() <T> {
    like <T>
    return match <T> {
        case F16, BF16, F8E4M3, F8E5M2 => convert(math.Sqrt(dotIn(m, m, F32(0))), like)
        nomatch => math.Sqrt(dotIn(m, m, like))
    }
}

# the largest element, and the smallest - a NaN if any element is one (std/math's Max and Min); for a matrix with
# at least one element
fn (m Matrix<<T>>&) Max() <T> {
    best <T> = m.Data[0]
    for r in range m.Rows {
        d I64 = r * m.Stride
        for c in range m.Cols { best = math.Max(best, m.Data[d + c]) }
    }
    return best
}

fn (m Matrix<<T>>&) Min() <T> {
    best <T> = m.Data[0]
    for r in range m.Rows {
        d I64 = r * m.Stride
        for c in range m.Cols { best = math.Min(best, m.Data[d + c]) }
    }
    return best
}

# out[r] = the sum of row r, for every row: out has Rows elements
fn (m Matrix<<T>>&) RowSums(out mut Array<<T>>&) {
    assert out.Len() == m.Rows
    match <T> {
        case F16, BF16, F8E4M3, F8E5M2 { rowSumsIn(m, out, F32(0)) }
        nomatch {
            z <T>
            rowSumsIn(m, out, z)
        }
    }
}

fn rowSumsIn(m Matrix<<T>>&, out mut Array<<T>>&, z <A>) {
    like <T>
    for r in range m.Rows { out[r] = convert(sumRun(m.Data, r * m.Stride, m.Cols, z), like) }
}

# out[r] = the largest element of row r - a NaN if the row holds one
fn (m Matrix<<T>>&) RowMax(out mut Array<<T>>&) {
    assert out.Len() == m.Rows
    for r in range m.Rows {
        d I64 = r * m.Stride
        best <T> = m.Data[d]
        for c in range 1, m.Cols { best = math.Max(best, m.Data[d + c]) }
        out[r] = best
    }
}

# out[r] = the column of row r's largest element, the first one where several are equal, and the first NaN where
# the row holds one - each row's class, for a matrix of scores
fn (m Matrix<<T>>&) ArgMaxRows(out mut Array<I32>&) {
    assert out.Len() == m.Rows
    for r in range m.Rows {
        d I64 = r * m.Stride
        at I64 = 0
        best <T> = m.Data[d]
        for c in range 1, m.Cols {
            if best != best { break }
            x := m.Data[d + c]
            if x > best or x != x {
                best = x
                at = c
            }
        }
        out[r] = I32(at)
    }
}

# out (1 x Cols) = the sums of m's columns + beta * out: a bias's gradient, summed over the batch. Sixty-four columns
# at a time, every row added into lanes held on the stack, so nothing is allocated and the adds are vector adds
fn (m Matrix<<T>>&) ColumnSums(out Matrix<<T>>&, beta F64 = 0) {
    assert rowShape(m, out)
    match <T> {
        case F16, BF16, F8E4M3, F8E5M2 { columnSumsIn(m, out, beta, F32(0)) }
        nomatch {
            z <T>
            columnSumsIn(m, out, beta, z)
        }
    }
}

type colLanes<A> struct(z <A>) {
    v mut Array<<A>> = Array<<A>>(64)
}

fn columnSumsIn(m Matrix<<T>>&, out Matrix<<T>>&, beta F64, z <A>) {
    like <T>
    b := convert(beta, z)
    acc := colLanes<<A>>(z)
    for c0 in range 0, m.Cols, 64 {
        w I64 = lesser(64, m.Cols - c0)
        for j in range 64 { acc.v[j] = z }
        for r in range m.Rows {
            d I64 = r * m.Stride + c0
            for j in range w { acc.v[j] = acc.v[j] + convert(m.Data[d + j], z) }
        }
        for j in range w {
            s <A> = acc.v[j]
            if beta != 0.0 { s = s + b * convert(out.Data[c0 + j], z) }
            out.Data[c0 + j] = convert(s, like)
        }
    }
}

# ---- conversions between element types ----

# dst = src with every element converted to dst's element type, rounded or wrapped as a conversion does (T4)
fn (dst Matrix<<T>>&) Convert(src Matrix<<S>>&) {
    assert sameShape(dst, src)
    like <T>
    for r in range dst.Rows {
        d I64 = r * dst.Stride
        s I64 = r * src.Stride
        for c in range dst.Cols { dst.Data[d + c] = convert(src.Data[s + c], like) }
    }
}

# the matrix with its elements converted, into a new matrix
fn (m Matrix<<T>>&) ToF64() Matrix<F64> {
    out Matrix<F64>&return = Matrix<F64>(m.Rows, m.Cols, null)
    out.Convert(m)
    return out
}

fn (m Matrix<<T>>&) ToF32() Matrix<F32> {
    out Matrix<F32>&return = Matrix<F32>(m.Rows, m.Cols, null)
    out.Convert(m)
    return out
}

fn (m Matrix<<T>>&) ToF16() Matrix<F16> {
    out Matrix<F16>&return = Matrix<F16>(m.Rows, m.Cols, null)
    out.Convert(m)
    return out
}

fn (m Matrix<<T>>&) ToBF16() Matrix<BF16> {
    out Matrix<BF16>&return = Matrix<BF16>(m.Rows, m.Cols, null)
    out.Convert(m)
    return out
}

# ---- random fills, from the caller's generator (std/rand), so that one seed decides a whole run ----

# every element drawn uniformly from [lo, hi), in row order
fn (m Matrix<<T>>&) FillUniform(r mut rand.Rand&, lo F64, hi F64) {
    like <T>
    for i in range m.Rows {
        d I64 = i * m.Stride
        for c in range m.Cols { m.Data[d + c] = convert(r.Uniform(lo, hi), like) }
    }
}

# every element drawn from the normal distribution with this mean and standard deviation, in row order
fn (m Matrix<<T>>&) FillNormal(r mut rand.Rand&, mean F64, sd F64) {
    like <T>
    for i in range m.Rows {
        d I64 = i * m.Stride
        for c in range m.Cols { m.Data[d + c] = convert(mean + sd * r.Normal(), like) }
    }
}

# ---- threads ----

# runs body over 0 .. rows split into consecutive runs, one task each, in parallel: body(lo, hi) for each run. Runs
# are at least grain rows (fewer when there are fewer rows), at most Threads of them; when there would be one, body
# runs on the calling thread with no task at all. The runs do not overlap and cover every row once, so a body writing
# only its own rows needs no synchronisation
fn ParallelRows(rows I64, grain I64, body fn(lo I64, hi I64)) {
    tasks I64 = lesser(Threads, rows / (grain if grain > 0 else 1))
    if tasks <= 1 {
        body(0, rows)
        return
    }
    share I64 = (rows + tasks - 1) / tasks
    join {
        for t in range tasks {
            lo I64 = t * share
            hi I64 = lesser(rows, lo + share)
            if lo < hi { spawn body(lo, hi) }
        }
    }
}

# ---- rendering and equality ----

# the elements as rows of brackets, as numpy prints an array:
#   [[1, 2, 3],
#    [4, 5, 6]]
# with only the first and last three rows, and columns, of a dimension longer than ten (the rest as "...")
fn (m Matrix<<T>>&) Str() String {
    b := StringBuilder()
    b.PushChar('[')
    for r in range m.Rows {
        if m.Rows > 10 and r == 3 {
            b.Push(" ...,\n ")
        }
        if m.Rows > 10 and r >= 3 and r < m.Rows - 3 { continue }
        if r > 0 and not (m.Rows > 10 and r == m.Rows - 3) { b.Push(",\n ") }
        b.PushChar('[')
        for c in range m.Cols {
            if m.Cols > 10 and c == 3 { b.Push(", ...") }
            if m.Cols > 10 and c >= 3 and c < m.Cols - 3 { continue }
            if c > 0 { b.Push(", ") }
            b.Push($m.Data[r * m.Stride + c])
        }
        b.PushChar(']')
    }
    b.PushChar(']')
    return b.ToString()
}

# the same shape and equal elements, compared as "==" compares them - so a matrix holding a NaN is equal to nothing
fn (a Matrix<<T>>&) Eq(b Matrix<<T>>&) Bool {
    if not sameShape(a, b) { return false }
    for r in range a.Rows {
        x I64 = r * a.Stride
        y I64 = r * b.Stride
        for c in range a.Cols {
            if a.Data[x + c] != b.Data[y + c] { return false }
        }
    }
    return true
}

# agrees with Eq: the shape and every element - a float by its bits, with -0 taken as 0, since the two are equal
fn (m Matrix<<T>>&) Hash() I64 {
    h I64 = m.Rows * 1099511628211 + m.Cols
    for r in range m.Rows {
        d I64 = r * m.Stride
        for c in range m.Cols { h = h * 1099511628211 + elementHash(m.Data[d + c]) }
    }
    return h
}

fn elementHash(x <T>) I64 {
    return match <T> {
        case F64 => 0 if x == 0 else I64(x.Bits())
        case F32, F16, BF16 => 0 if x == 0 else I64(x.Bits())
        case F8E4M3, F8E5M2 => 0 if x.F64() == 0 else I64(x.Bits)
        nomatch => x.Hash()
    }
}

# ---- linear systems ----

# the x with a x = b, for a square a and any number of right-hand sides (b's columns), by LU decomposition with
# partial pivoting (Gaussian elimination choosing the largest pivot in each column) - for a float matrix. A pivot of
# zero means a has no inverse: SolveError.SINGULAR. a and b are not changed
fn Solve(a Matrix<<T>>&, b Matrix<<T>>&) Matrix<<T>> ? SolveError {
    assert a.Rows == a.Cols and b.Rows == a.Rows
    x Matrix<<T>>&return = Matrix<<T>>(b.Rows, b.Cols, null)
    x.Copy(b)
    lu := a.Clone()
    try solveInPlace(lu, x)
    return x
}

# the inverse of a square float matrix: Solve with the identity
fn (a Matrix<<T>>&) Inverse() Matrix<<T>> ? SolveError {
    assert a.Rows == a.Cols
    x Matrix<<T>>&return = Matrix<<T>>(a.Rows, a.Rows, null)
    x.SetIdentity()
    lu := a.Clone()
    try solveInPlace(lu, x)
    return x
}

# x = lu^-1 x, overwriting lu with its LU factors and x with the solution
fn solveInPlace(lu Matrix<<T>>&, x Matrix<<T>>&) ? SolveError {
    n I64 = lu.Rows
    for k in range n {
        p I64 = k
        for i in range k + 1, n {
            if math.Abs(lu.Get(i, k)) > math.Abs(lu.Get(p, k)) { p = i }
        }
        if lu.Get(p, k) == 0 { error SolveError.SINGULAR }
        if p != k {
            swapRows(lu, p, k)
            swapRows(x, p, k)
        }
        pivot := lu.Get(k, k)
        kr := lu.Row(k)
        xk := x.Row(k)
        for i in range k + 1, n {
            f <T> = lu.Get(i, k) / pivot
            if f == 0 { continue }
            lr := lu.Row(i)
            for j in range k + 1, n { lr[j] = lr[j] - f * kr[j] }
            xi := x.Row(i)
            for j in range x.Cols { xi[j] = xi[j] - f * xk[j] }
        }
    }
    # back substitution, the last row first
    i I64 = n - 1
    for i >= 0 {
        xi := x.Row(i)
        li := lu.Row(i)
        for k in range i + 1, n {
            xk := x.Row(k)
            for j in range x.Cols { xi[j] = xi[j] - li[k] * xk[j] }
        }
        for j in range x.Cols { xi[j] = xi[j] / li[i] }
        i--
    }
}

fn swapRows(m Matrix<<T>>&, p I64, q I64) {
    rp := m.Row(p)
    rq := m.Row(q)
    for j in range m.Cols { rp[j], rq[j] = rq[j], rp[j] }
}
