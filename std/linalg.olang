# linalg - dense linear algebra on Matrix<T>, the operand of numeric and neural-network code: matrix products, element
# operations, reductions, random fills, linear systems.
#
# A Matrix<T> is two-dimensional and row-major, with a row stride: element (r, c) is Data[r * Stride + c]. Rows are the
# samples of a batch and columns their features; structure beyond two dimensions belongs to the operation that needs
# it, which takes it as parameters and interprets a row itself - a convolution told C, H and W lowers to im2col into a
# workspace matrix and one product; attention keeps each head as a column block (ColRange, a strided view) and runs
# its products on those views. Transposition is likewise a parameter of the products (Gemm's transA and transB, or
# m.T() in an expression), never a layout: A^T B and A B^T read A and B where they are.
#
# A matrix is a VIEW - its shape, its stride and a slice of storage - so copying one copies the view, never the
# elements (Clone does that), and one made over existing storage (View, RowRange, ColRange, Block) allocates nothing.
# Matrix<F32>(rows, cols) is a new zero-filled matrix, built where it lands like any other value (O18a). A Batch is many
# matrices of one shape in one storage - every sequence and head of attention - and Patches the patch matrix of a
# convolution over images held as rows, never made.
#
# Two kinds of operation, and the difference is what a loop pays:
# - forms with a DESTINATION write into a matrix (or array) the caller already has and allocate nothing but the
#   products' packing panels, in their own scope - and not those either through a GemmWorkspace the caller keeps
#   (ws.Gemm), so a training step allocates nothing at all: Gemm, GemmAct (a product, its bias and its activation),
#   GemmBatch (a product per matrix of batches, causal ones skipping their upper triangle), GemmPatches (a convolution,
#   the patches packed from the images), Gemv, Ger, Ger2, Map/Map2/Map3, Add, Sub, Scale, AddScaled, AddRow,
#   AddOuterDifference, AddScaledMasked, Clamp, Fill, Copy, Convert, Activate, ActivationBackward, Im2col,
#   NormalizeRows, RowSoftmax, the row and column reductions (RowSums, RowMax, RowMaxAbs, RowAbsSums, RowNorms,
#   ArgMaxRows, ColumnSums, ColumnAbsSums) and the random fills. A training step is written with these.
# - operators and the rest (a + b, a @ b, a.T() @ b, -a, m.Exp(), Clone) build a new matrix each time - for scripts,
#   and anywhere a result is wanted once. Note that "a += b" is "a = a + b" (E31): a new matrix, not an in-place add;
#   a.Add(b) is the in-place one.
#
# Shapes are checked once per operation, never per element: a mismatch aborts, as an out-of-range slice does, and
# under try - try (a + b), try (a @ b) - it is the error ShapeError.MISMATCH instead. Every check is one of the
# functions in the "shapes" section, so that when dimensions move into the type (Matrix<T, R, C>, each a constant or
# known at run time) they move in one place. Element access (Get, Set) is unchecked, as an array index is (E16).
#
# Element types: every numeric type. F16 and BF16 are stored as they are and computed in F32 where it matters - the
# products accumulate in F32 and round once, and so do the sums - and the F8 types (F8E4M3, F8E5M2) are storage that
# the products and conversions read. Integer arithmetic wraps (E6c).
#
# The target (B12): the products are computed for the machine the program is built for - Gemm's tile in its vector
# registers (TargetVectorBits), and every multiply-add of a product fused into one rounding where it has fused
# multiply-add (TargetHasFma). So a product built for two targets may differ in its last bits; built for one, it is
# the same in the program, under -i and while compiling, which read the same build constants.
#
# Threads: Gemm takes a thread count (1 unless given - linalg.Cores() is the machine's), and splits a product large
# enough to be worth it over that many tasks, by rows of the result, so the result does not depend on the count.
# ParallelRows gives the same splitting to the row-wise kernels a caller writes itself. The count is a parameter rather
# than a setting: a global the program can change would keep every product from being computed while compiling (K1).

import "std/math"
import "std/rand"

extern fn sysconf(name I32) I64

# a shape that does not fit the operation - two operands of different shapes, a product whose inner dimensions differ
error ShapeError {
    MISMATCH
}

# a linear system with no unique solution
error SolveError {
    SINGULAR
}

# ---- the matrix ----

# a Rows x Cols matrix: over data (from the element at its start, row r at r * stride) when it is given, and over new,
# zero-filled storage when it is not. stride defaults to Cols, which makes the rows contiguous
type Matrix<T> struct(Rows I64, Cols I64, data mut Array<T>& = null, stride I64 = 0) {
    Rows
    Cols
    Stride I64 = stride if stride > 0 else Cols
    assert Rows >= 0 and Cols >= 0 and Stride >= Cols
    assert data == null or Rows == 0 or data.Len() >= (Rows - 1) * Stride + Cols
    Data mut Array<T>& = data if data != null else Array<T>(Rows * Cols)
}

# a rows x cols matrix over the caller's storage, starting at data[offset], row r at offset + r * stride (stride
# defaults to cols) - the way to lay matrices out in an arena the caller owns. It allocates nothing; writing it writes
# data
fn View(data mut Array<<T>>&, offset I64, rows I64, cols I64, stride I64 = 0) Matrix<T> {
    s I64 = stride if stride > 0 else cols
    n I64 = (rows - 1) * s + cols if rows > 0 else 0
    return Matrix<T>(rows, cols, data[offset:offset + n], s)
}

# a rows x cols matrix with every element v
fn Full(rows I64, cols I64, v <T>) Matrix<T> {
    m Matrix<T>&return = Matrix<T>(rows, cols, null)
    m.Fill(v)
    return m
}

# a matrix holding the given rows, which must all have one length: linalg.FromRows(Array<F64>&[F64[1, 2], F64[3, 4]])
fn FromRows(rows Array<Array<<T>>&>&) Matrix<T> {
    cols I64 = rows[0].Len() if rows.Len() > 0 else 0
    m Matrix<T>&return = Matrix<T>(rows.Len(), cols, null)
    for r, row in rows {
        assert row.Len() == cols
        for c in range cols { m.Data[r * m.Stride + c] = row[c] }
    }
    return m
}

# the element at row r, column c - unchecked, as an array index is (E16)
fn (m Matrix<<T>>&) Get(r I64, c I64) T { return m.Data[r * m.Stride + c] }

# sets the element at row r, column c - unchecked
fn (m Matrix<<T>>&) Set(r I64, c I64, v T) { m.Data[r * m.Stride + c] = v }

# row i as an array view of its Cols elements: writing it writes the matrix. Out of range aborts (E16b)
fn (m Matrix<<T>>&) Row(i I64) mut Array<T>&m { return m.Data[i * m.Stride:i * m.Stride + m.Cols] }

# whether the rows follow one another with no gap, so the elements are one run of Rows * Cols in Data
fn (m Matrix<<T>>&) Contiguous() Bool { return m.Stride == m.Cols or m.Rows <= 1 }

# ---- shapes: every check an operation makes, in one place ----

fn sameShape(a Matrix<<T>>&, b Matrix<<U>>&) Bool { return a.Rows == b.Rows and a.Cols == b.Cols }

# whether r is a row of m's width: a 1 x m.Cols matrix
fn rowShape(m Matrix<<T>>&, r Matrix<T>&) Bool { return r.Rows == 1 and r.Cols == m.Cols }

# whether c (m x n) can hold op(a) op(b): op(a) is m x k and op(b) k x n
fn productShape(c Matrix<<T>>&, a Matrix<T>&, transA Bool, b Matrix<T>&, transB Bool) Bool {
    am I64 = a.Cols if transA else a.Rows
    ak I64 = a.Rows if transA else a.Cols
    bk I64 = b.Cols if transB else b.Rows
    bn I64 = b.Rows if transB else b.Cols
    return ak == bk and c.Rows == am and c.Cols == bn
}

# whether lo .. hi is a range within 0 .. n
fn rangeShape(lo I64, hi I64, n I64) Bool { return 0 <= lo and lo <= hi and hi <= n }

# ---- views: none of these allocates ----

# rows lo .. hi (hi not included), sharing m's storage
fn (m Matrix<<T>>&) RowRange(lo I64, hi I64) Matrix<T> {
    assert rangeShape(lo, hi, m.Rows)
    return View(m.Data, lo * m.Stride, hi - lo, m.Cols, m.Stride)
}

# columns lo .. hi, sharing m's storage: a view whose stride is wider than its rows
fn (m Matrix<<T>>&) ColRange(lo I64, hi I64) Matrix<T> {
    assert rangeShape(lo, hi, m.Cols)
    return View(m.Data, lo, m.Rows, hi - lo, m.Stride)
}

# the rows x cols block whose first element is (r, c), sharing m's storage
fn (m Matrix<<T>>&) Block(r I64, c I64, rows I64, cols I64) Matrix<T> {
    assert rangeShape(r, r + rows, m.Rows) and rangeShape(c, c + cols, m.Cols)
    return View(m.Data, r * m.Stride + c, rows, cols, m.Stride)
}

# the same elements in row-major order as a rows x cols matrix, sharing m's storage - so m must be contiguous, and
# rows * cols its size
fn (m Matrix<<T>>&) Reshape(rows I64, cols I64) Matrix<T> {
    assert m.Contiguous() and rows * cols == m.Rows * m.Cols
    return View(m.Data, 0, rows, cols, cols)
}

# m transposed, as an operand of the products: a.T() @ b is A^T B, read where A is. It is not a matrix of its own -
# Clone() makes one
type Transposed<T> struct(of Matrix<T>&) {
    M Matrix<T>&of = of
}

fn (m Matrix<<T>>&) T() Transposed<T> { return Transposed<T>(m) }

# the transpose as a matrix of its own: Cols x Rows, new storage
fn (t Transposed<<T>>&) Clone() Matrix<T> {
    out Matrix<T>&return = Matrix<T>(t.M.Cols, t.M.Rows, null)
    out.Copy(t)
    return out
}

# ---- element kernels: one pass, in row order, a function value applied to each element ----
#
# Each writes its destination and allocates nothing. The function is a lambda written at the call, which is inlined
# into the loop (a function value's code is a value the optimizer follows, T21), so dst.Map2(a, b, fn(x, y) { return
# x * y }) runs as the loop written out would. A destination may be one of the operands itself - each element is read
# before it is written - but not another view overlapping one.

# dst = f(a), element by element
fn (dst Matrix<<T>>&) Map(a Matrix<T>&, f fn(x T) T) {
    assert sameShape(dst, a)
    if dst.Contiguous() and a.Contiguous() {
        for i in range dst.Rows * dst.Cols { dst.Data[i] = f(a.Data[i]) }
        return
    }
    for r in range dst.Rows {
        d I64 = r * dst.Stride
        x I64 = r * a.Stride
        for c in range dst.Cols { dst.Data[d + c] = f(a.Data[x + c]) }
    }
}

# dst = f(a, b), element by element
fn (dst Matrix<<T>>&) Map2(a Matrix<T>&, b Matrix<T>&, f fn(x T, y T) T) {
    assert sameShape(dst, a) and sameShape(dst, b)
    if dst.Contiguous() and a.Contiguous() and b.Contiguous() {
        for i in range dst.Rows * dst.Cols { dst.Data[i] = f(a.Data[i], b.Data[i]) }
        return
    }
    for r in range dst.Rows {
        d I64 = r * dst.Stride
        x I64 = r * a.Stride
        y I64 = r * b.Stride
        for c in range dst.Cols { dst.Data[d + c] = f(a.Data[x + c], b.Data[y + c]) }
    }
}

# dst = f(a, b, c), element by element - a fused update of three operands, an optimizer's step say
fn (dst Matrix<<T>>&) Map3(a Matrix<T>&, b Matrix<T>&, c Matrix<T>&, f fn(x T, y T, z T) T) {
    assert sameShape(dst, a) and sameShape(dst, b) and sameShape(dst, c)
    if dst.Contiguous() and a.Contiguous() and b.Contiguous() and c.Contiguous() {
        for i in range dst.Rows * dst.Cols { dst.Data[i] = f(a.Data[i], b.Data[i], c.Data[i]) }
        return
    }
    for r in range dst.Rows {
        d I64 = r * dst.Stride
        x I64 = r * a.Stride
        y I64 = r * b.Stride
        z I64 = r * c.Stride
        for k in range dst.Cols { dst.Data[d + k] = f(a.Data[x + k], b.Data[y + k], c.Data[z + k]) }
    }
}

# every element v
fn (m Matrix<<T>>&) Fill(v T) { m.Map(m, fn(x) { return v }) }

# the identity: ones on the diagonal, zeros elsewhere
fn (m Matrix<<T>>&) SetIdentity() {
    z T
    m.Fill(z)
    for i in range lesser(m.Rows, m.Cols) { m.Data[i * m.Stride + i] = 1 }
}

# m = src, element by element - src a matrix of m's shape, or a transposed one (src.T())
fn (m Matrix<<T>>&) Copy(src <U>) {
    match U {
        case Matrix<T>, Matrix<T>& { m.Map(src, fn(x) { return x }) }
        case Transposed<T>, Transposed<T>& {
            s := src.M
            assert m.Rows == s.Cols and m.Cols == s.Rows
            # in blocks of 32 x 32, so both sides stay in the cache whichever way they are walked
            for r0 in range 0, m.Rows, 32 {
                for c0 in range 0, m.Cols, 32 {
                    for r in range r0, lesser(r0 + 32, m.Rows) {
                        for c in range c0, lesser(c0 + 32, m.Cols) { m.Data[r * m.Stride + c] = s.Data[c * s.Stride + r] }
                    }
                }
            }
        }
    }
}

# m += x
fn (m Matrix<<T>>&) Add(x Matrix<T>&) { m.Map2(m, x, fn(a, b) { return a + b }) }

# m -= x
fn (m Matrix<<T>>&) Sub(x Matrix<T>&) { m.Map2(m, x, fn(a, b) { return a - b }) }

# m *= k
fn (m Matrix<<T>>&) Scale(k T) { m.Map(m, fn(a) { return a * k }) }

# m += alpha * x - BLAS's axpy
fn (m Matrix<<T>>&) AddScaled(x Matrix<T>&, alpha T) { m.Map2(m, x, fn(a, b) { return a + alpha * b }) }

# every row += bias, a 1 x Cols matrix: a layer's bias added to a batch, read where it is
fn (m Matrix<<T>>&) AddRow(bias Matrix<T>&) {
    assert rowShape(m, bias)
    for r in range m.Rows {
        d I64 = r * m.Stride
        for c in range m.Cols { m.Data[d + c] = m.Data[d + c] + bias.Data[c] }
    }
}

# m += alpha (a b^T - c d^T) in one pass - the contrastive update of two phases (a learning rule comparing a free
# state with a nudged one), with neither outer product made. It is computed factored, as a (b - d)^T + (a - c) d^T,
# so that two nearly equal phases do not cancel: the differences are taken first, element by element
fn (m Matrix<<T>>&) AddOuterDifference(a Array<T>&, b Array<T>&, c Array<T>&, d Array<T>&, alpha T) {
    assert a.Len() == m.Rows and c.Len() == m.Rows and b.Len() == m.Cols and d.Len() == m.Cols
    for r in range m.Rows {
        o I64 = r * m.Stride
        ar T = alpha * a[r]
        dr T = alpha * (a[r] - c[r])
        for k in range m.Cols { m.Data[o + k] = m.Data[o + k] + (ar * (b[k] - d[k]) + dr * d[k]) }
    }
}

# m = min(max(m, lo), hi), element by element - a cap on every weight
fn (m Matrix<<T>>&) Clamp(lo T, hi T) { m.Map(m, fn(x) { return lo if x < lo else (hi if x > hi else x) }) }

# m += alpha g where mask is not zero, element by element: sparse connectivity, frozen weights
fn (m Matrix<<T>>&) AddScaledMasked(g Matrix<T>&, alpha T, mask Matrix<U8>&) {
    assert sameShape(m, g) and sameShape(m, mask)
    z T
    for r in range m.Rows {
        d I64 = r * m.Stride
        x I64 = r * g.Stride
        k I64 = r * mask.Stride
        for c in range m.Cols { m.Data[d + c] = m.Data[d + c] + (alpha * g.Data[x + c] if mask.Data[k + c] != 0 else z) }
    }
}

# ---- new matrices: the operators, for scripts and one-off results ----
#
# Each builds its result where it lands (O18a). A matrix operand must have the receiver's shape; a scalar operand is
# of the element type exactly - a literal does not adapt through the operator's generic operand, so an F32 matrix is
# scaled by m * F32(0.5), or in place by m.Scale(0.5)

fn (a Matrix<<T>>&) Plus(b <U>) Matrix<T> {
    out Matrix<T>&return = Matrix<T>(a.Rows, a.Cols, null)
    match U {
        case Matrix<T>, Matrix<T>& { out.Map2(a, b, fn(x, y) { return x + y }) }
        case T { out.Map(a, fn(x) { return x + b }) }
    }
    return out
}

fn (a Matrix<<T>>&) Minus(b <U>) Matrix<T> {
    out Matrix<T>&return = Matrix<T>(a.Rows, a.Cols, null)
    match U {
        case Matrix<T>, Matrix<T>& { out.Map2(a, b, fn(x, y) { return x - y }) }
        case T { out.Map(a, fn(x) { return x - b }) }
    }
    return out
}

# element by element (the Hadamard product) - the matrix product is "@"
fn (a Matrix<<T>>&) Mul(b <U>) Matrix<T> {
    out Matrix<T>&return = Matrix<T>(a.Rows, a.Cols, null)
    match U {
        case Matrix<T>, Matrix<T>& { out.Map2(a, b, fn(x, y) { return x * y }) }
        case T { out.Map(a, fn(x) { return x * b }) }
    }
    return out
}

fn (a Matrix<<T>>&) Div(b <U>) Matrix<T> {
    out Matrix<T>&return = Matrix<T>(a.Rows, a.Cols, null)
    match U {
        case Matrix<T>, Matrix<T>& { out.Map2(a, b, fn(x, y) { return x / y }) }
        case T { out.Map(a, fn(x) { return x / b }) }
    }
    return out
}

fn (a Matrix<<T>>&) Neg() Matrix<T> {
    out Matrix<T>&return = Matrix<T>(a.Rows, a.Cols, null)
    out.Map(a, fn(x) { return -x })
    return out
}

# the checked forms: what try (a + b) calls, failing with ShapeError.MISMATCH where the operator would abort
fn (a Matrix<<T>>&) TryPlus(b <U>) Matrix<T> ? ShapeError {
    match U {
        case Matrix<T>, Matrix<T>& { if not sameShape(a, b) { error ShapeError.MISMATCH } }
        nomatch { }
    }
    return a + b
}

fn (a Matrix<<T>>&) TryMinus(b <U>) Matrix<T> ? ShapeError {
    match U {
        case Matrix<T>, Matrix<T>& { if not sameShape(a, b) { error ShapeError.MISMATCH } }
        nomatch { }
    }
    return a - b
}

fn (a Matrix<<T>>&) TryMul(b <U>) Matrix<T> ? ShapeError {
    match U {
        case Matrix<T>, Matrix<T>& { if not sameShape(a, b) { error ShapeError.MISMATCH } }
        nomatch { }
    }
    return a * b
}

fn (a Matrix<<T>>&) TryDiv(b <U>) Matrix<T> ? ShapeError {
    match U {
        case Matrix<T>, Matrix<T>& { if not sameShape(a, b) { error ShapeError.MISMATCH } }
        nomatch { }
    }
    return a / b
}

# a copy with storage of its own, contiguous
fn (m Matrix<<T>>&) Clone() Matrix<T> {
    out Matrix<T>&return = Matrix<T>(m.Rows, m.Cols, null)
    out.Copy(m)
    return out
}

# f applied to every element, into a new matrix
fn (m Matrix<<T>>&) Mapped(f fn(x T) T) Matrix<T> {
    out Matrix<T>&return = Matrix<T>(m.Rows, m.Cols, null)
    out.Map(m, f)
    return out
}

# the floating-point functions of std/math, element by element, into a new matrix
fn (m Matrix<<T>>&) Exp() Matrix<T> { return m.Mapped(fn(x) { return math.Exp(x) }) }
fn (m Matrix<<T>>&) Log() Matrix<T> { return m.Mapped(fn(x) { return math.Log(x) }) }
fn (m Matrix<<T>>&) Tanh() Matrix<T> { return m.Mapped(fn(x) { return math.Tanh(x) }) }
fn (m Matrix<<T>>&) Sqrt() Matrix<T> { return m.Mapped(fn(x) { return math.Sqrt(x) }) }
fn (m Matrix<<T>>&) Abs() Matrix<T> { return m.Mapped(fn(x) { return math.Abs(x) }) }

fn lesser(a I64, b I64) I64 { return a if a < b else b }
# ---- matrix multiplication ----
#
# Gemm computes C = alpha * op(A) op(B) + beta * C, where op(X) is X or its transpose, for row-major matrices held in
# arrays with a row stride: element (i, j) of a matrix with stride ld is x[i * ld + j]. It is the one kernel every
# product in this module goes through.
#
# The algorithm is the one BLAS libraries use (Goto's, as in BLIS): C is computed in blocks sized for the caches -
# KC rows of B by NC columns packed into a contiguous panel that stays in the L3 (or L2) cache, MC rows of A by KC
# packed into one that stays in L2 - and each block by a micro-kernel computing an MR x NR tile of C entirely in
# registers, one rank-1 update per step of k, reading both panels in the order they were packed. Packing is also
# where the transposes are applied and where F16 and BF16 are widened to F32, so the micro-kernel only ever sees
# contiguous panels of its own accumulation type. Edges are padded with zeros in the panels; a partial tile is
# written back through a full one.
#
# The tile is sized for the target (B12): its accumulators, a step's B vectors and a broadcast A value fill the vector
# registers the target has, and a multiply-add is one fused instruction where the target has one (TargetHasFma) - so
# the same product computed for two targets may differ in its last bits, where one rounds each step once and the other
# twice. Both conditions are build constants, so the compile-time evaluator takes the branch the program does. The
# tile's sizes reach the micro-kernel as constants (tileRows and tileCols, inlined): each accumulator is read and
# written only at constant positions, which is what lets LLVM keep all of them in registers.
#
# Four refinements, each where the plain algorithm wastes work. A result narrower than two vectors (a convolution's
# sixteen channels, ten classes) gets a tile one vector wide - thin - instead of one half padding; one whose rows cover
# the tile badly (a 16 x 9 weight gradient) is computed as its transpose, C^T = op(B)^T op(A)^T, stored transposed -
# exchanged; neither changes any element's sum (tileChoice). A result one or two tiles wide reads A where it is, by
# rows, rather than packing it - each element of A is used once or twice, and packing it cost more than the product
# (tileInPlace). A triangular product (GemmBatch's Triangular) skips the tiles above a triangular result's diagonal and
# the zeros of a triangular operand, and never reads what is above its diagonal (gemmRows). And the epilogue -
# GemmAct's bias and activation - runs on each block of C's rows as soon as it is summed, while it is in the cache.

# the number of cores the machine has online, from the C library (84 is glibc's _SC_NPROCESSORS_ONLN on Linux) - the
# usual thread count for Gemm and ParallelRows
fn Cores() I64 {
    n := sysconf(84)
    return n if n > 0 else 1
}

# x as a D, rounded or wrapped as a conversion D(x) does (T4) - from or to an F8 type through F64, the F8 types' own
# way in and out
fn Cast(x <S>, like <D>) D {
    match S {
        case F8E4M3, F8E5M2 { return Cast(x.F64(), like) }
        nomatch {
            return match D {
                case F8E4M3 => F8E4M3(F64(x))
                case F8E5M2 => F8E5M2(F64(x))
                case F16 => F16(x)
                case BF16 => BF16(x)
                case F32 => F32(x)
                case F64 => F64(x)
                case I8 => I8(x)
                case I16 => I16(x)
                case I32 => I32(x)
                case I64 => I64(x)
                case U8 => U8(x)
                case U16 => U16(x)
                case U32 => U32(x)
                case U64 => U64(x)
            }
        }
    }
}

# a tile of accumulators, kept in registers by the micro-kernel (an inline array, indexed only at constants) - room for
# the largest tile, 12 x 32
type tile<A> struct() {
    v Array<A, 384>
}

# ---- what a product's packing reads: a matrix, or a convolution's patches ----
#
# Packing is where each operand is read: op(x)'s block of WIDTH w0 .. w0 + width and DEPTH p0 .. p0 + depth (the sum's
# index) into panels of wr - panel q holding, for each step p of the depth, the wr values (w0 + q + w, p0 + p),
# zeros past the width. For the left operand the width is op(a)'s rows; for the right one op(b)'s columns, which is
# the same thing read the other way - so one routine packs both, told by trans which way x is stored: element (w, p)
# is x[w, p], or x[p, w] when trans (the left operand's transA; the right operand's "not transB").

# a matrix as a product reads it - its storage from its first element and its row stride, read-only, so that a vector
# Gemv was given can be one
type operand<T> struct(d Array<T>&, ld I64) {
    d
    ld
}

# the panels' two roles: the left operand's, as wide as the tile's rows, and the right one's, as wide as its columns -
# a constant either way, so that copying a whole panel's step is unrolled
type aPanel struct() { }
type bPanel struct() { }

fn panelWidth(z <A>, role <R>, sh <S>) I64 {
    return match R {
        case aPanel => tileRows(z)
        case bPanel => tileColsOf(z, sh)
    }
}

# whether an operand is a matrix - a convolution's patches are only ever the left operand, never exchanged
fn (x operand<<T>>&) isMatrix() Bool { return true }
fn (x Patches<<T>>&) isMatrix() Bool { return false }

# lower: x is lower-triangular - x[r, s] is zero for s > r + diag and never read (Triangular.Left)
fn (x operand<<T>>&) pack(trans Bool, w0 I64, p0 I64, width I64, depth I64, role <R>, sh <S>, lower Bool, diag I64, dst mut Array<<A>>&) {
    z A
    wr := panelWidth(z, role, sh)
    if trans {
        # element (w, p) is x[p0 + p, w0 + q + w]: each step of a panel a run of x's row. Of a triangular x the steps
        # before pAny are zeros, those from pFull on read whole, and only those between - fewer than wr - are cut
        for q in range 0, width, wr {
            base I64 = q * depth
            n I64 = lesser(wr, width - q)
            pAny I64 = 0
            pFull I64 = 0
            if lower {
                pAny = clampI(w0 + q - diag - p0, 0, depth)
                pFull = clampI(w0 + q + n - 1 - diag - p0, pAny, depth)
            }
            for p in range pAny {
                for w in range wr { dst[base + p * wr + w] = z }
            }
            for p in range pAny, pFull {
                s I64 = (p0 + p) * x.ld + w0 + q
                m I64 = clampI(p0 + p + diag - w0 - q + 1, 0, n)
                for w in range m { dst[base + p * wr + w] = Cast(x.d[s + w], z) }
                for w in range m, wr { dst[base + p * wr + w] = z }
            }
            if n == wr {
                for p in range pFull, depth {
                    s I64 = (p0 + p) * x.ld + w0 + q
                    for w in range wr { dst[base + p * wr + w] = Cast(x.d[s + w], z) }
                }
            } else {
                for p in range pFull, depth {
                    s I64 = (p0 + p) * x.ld + w0 + q
                    for w in range n { dst[base + p * wr + w] = Cast(x.d[s + w], z) }
                    for w in range n, wr { dst[base + p * wr + w] = z }
                }
            }
        }
        return
    }
    for q in range 0, width, wr {
        base I64 = q * depth
        n I64 = lesser(wr, width - q)
        # element (w, p) is x[w0 + q + w, p0 + p]: a whole panel a step at a time, its wr rows read together - of a
        # triangular x, those above the diagonal read too (they are inside x) and replaced by zeros, with no branch
        if n == wr {
            s I64 = (w0 + q) * x.ld + p0
            if lower {
                for p in range depth {
                    first I64 = p0 + p - diag - w0 - q          # the first of the panel's rows reaching this step
                    for w in range wr {
                        v A = Cast(x.d[s + w * x.ld + p], z)
                        dst[base + p * wr + w] = v if w >= first else z
                    }
                }
            } else {
                for p in range depth {
                    for w in range wr { dst[base + p * wr + w] = Cast(x.d[s + w * x.ld + p], z) }
                }
            }
            continue
        }
        # the last rows, or a triangular x: each row a run of the depth, written wr apart
        for w in range n {
            s I64 = (w0 + q + w) * x.ld + p0
            m I64 = depth
            if lower { m = clampI(w0 + q + w + diag - p0 + 1, 0, depth) }
            for p in range m { dst[base + p * wr + w] = Cast(x.d[s + p], z) }
            for p in range m, depth { dst[base + p * wr + w] = z }
        }
        for w in range n, wr {
            for p in range depth { dst[base + p * wr + w] = z }
        }
    }
}

# the patch matrix as the left operand: element (w, p) is input p0 + p of output position w0 + w (trans is never set:
# patches are only ever the left operand, not transposed). A panel's wr positions are gathered together, one input at a
# time - the input's offset within a window the same for all of them, each window's own first pixel added - with no
# test per element where every window lies inside the image, as most do. Positions follow one another, so each is
# found from the last by a step, not by dividing; the geometry is held in locals, read through x it would be read
# again at every store
fn (x Patches<<T>>&) pack(trans Bool, w0 I64, p0 I64, width I64, depth I64, role <R>, sh <S>, lower Bool, diag I64, dst mut Array<<A>>&) {
    assert not trans and not lower
    z A
    wr := panelWidth(z, role, sh)
    data := x.Images.Data
    C, H, W, K, S, P := x.C, x.H, x.W, x.K, x.Stride, x.Pad
    ow, per, ld := x.OutW, x.OutH * x.OutW, x.Images.Stride
    kk I64 = K * K
    hu U64 = U64(H)
    wu U64 = U64(W)
    win := windows()
    # the position w0, and its image, row and column of the output
    img I64 = w0 / per
    oy I64 = (w0 - img * per) / ow
    ox I64 = w0 - img * per - oy * ow
    for q in range 0, width, wr {
        base I64 = q * depth
        n I64 = lesser(wr, width - q)
        inside Bool = n == wr
        for w in range wr {
            if w < n {
                y0 I64 = oy * S - P
                x0 I64 = ox * S - P
                win.at[w] = img * ld + (y0 * W + x0) * C
                win.y0[w] = y0
                win.x0[w] = x0
                inside = inside and y0 >= 0 and y0 + K <= H and x0 >= 0 and x0 + K <= W
                ox++
                if ox == ow {
                    ox = 0
                    oy++
                    if oy == x.OutH {
                        oy = 0
                        img++
                    }
                }
            } else {
                win.at[w] = 0
                win.y0[w] = -H - K                       # never inside: a position past the panel's last is zeros
                win.x0[w] = 0
            }
        }
        c I64 = p0 / kk
        ky I64 = (p0 - c * kk) / K
        kx I64 = p0 - c * kk - ky * K
        off I64 = (ky * W + kx) * C + c
        for p in range depth {
            d I64 = base + p * wr
            if inside {
                for w in range wr { dst[d + w] = Cast(data[win.at[w] + off], z) }
            } else {
                for w in range wr {
                    v A = z
                    if U64(win.y0[w] + ky) < hu and U64(win.x0[w] + kx) < wu { v = Cast(data[win.at[w] + off], z) }
                    dst[d + w] = v
                }
            }
            kx++
            off = off + C
            if kx == K {
                kx = 0
                ky++
                off = off + (W - K) * C
                if ky == K {
                    ky = 0
                    c++
                    off = c
                }
            }
        }
    }
}

# a panel's windows: each position's first pixel's offset in the images, and its window's top-left pixel (which may lie
# outside the image, in the padding)
type windows struct() {
    at Array<I64, 12>
    y0 Array<I64, 12>
    x0 Array<I64, 12>
}

fn clampI(x I64, lo I64, hi I64) I64 { return lo if x < lo else (hi if x > hi else x) }

# ---- the micro-kernels ----

# the two tile shapes: two vectors of columns (three on SSE) - the usual one - and one vector, for a product too narrow
# to fill two (a thin product: a convolution's sixteen output channels, a classifier's ten)
type wideTile struct() { }
type thinTile struct() { }

fn tileColsOf(z <A>, sh <S>) I64 {
    return match S {
        case wideTile => tileCols(z)
        case thinTile => vectorLanes(z)
    }
}

# the elements of accumulation type A in one vector register of the target
fn vectorLanes(z <A>) I64 {
    return match A {
        case F64, I64, U64 => TargetVectorBits / 64
        nomatch => TargetVectorBits / 32
    }
}

# where a micro-kernel reads the left operand's elements: a packed panel (element (i, k) of the tile at k MR + i), or
# the operand where it is, by rows (element (i, k) at i ld + k)
type packedA struct() { }
type rowsA struct() { }

# the steps between the elements of one step's rows, and between one step's and the next's
fn aSteps(z <A>, lay <L>, ld I64) (I64, I64) {
    match L {
        case packedA { return 1, tileRows(z) }
        case rowsA { return ld, 1 }
    }
}

# the micro-kernels: C = alpha * the sum over the depth of A(i, k) bp[k][j] + beta * C for one MR x NR tile (4, 6 or 12
# rows - tileRows - by tileColsOf columns), stored as storeTile stores it (storeTileT where exchanged). A's elements are
# read d1 steps as lay says from a1[o1] on, then d2 steps from the packed panel a2[o2] - the depth read from two places,
# the part of a triangular operand where the tile's rows end at different places being packed with its zeros (B's
# steps follow on). Each row of a step is written out on its own line, so that every accumulator's index is a constant
# once the tile's columns are (inlined) - with the rows as a loop too, a tile this large is too big for LLVM to unroll
# whole, and its accumulators would live in memory. The accumulators never leave the kernel but to be stored, so only
# the tile's own are kept, in registers
fn micro4(d1 I64, a1 Array<<A>>&, o1 I64, ld1 I64, lay <L>, d2 I64, a2 Array<A>&, o2 I64, bp Array<A>&, bo I64, sh <S>, alpha A, beta A, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64, lim I64, exchanged Bool) {
    z A
    nr := tileColsOf(z, sh)
    si, sk := aSteps(z, lay, ld1)
    acc := tile<A>()
    for k in range d1 {
        a I64 = o1 + k * sk
        b I64 = bo + k * nr
        rowStep(acc, 0, a1[a], bp, b, nr)
        rowStep(acc, nr, a1[a + si], bp, b, nr)
        rowStep(acc, 2 * nr, a1[a + 2 * si], bp, b, nr)
        rowStep(acc, 3 * nr, a1[a + 3 * si], bp, b, nr)
    }
    # the packed tail of a tile read in place - no other layout has one
    match L {
        case rowsA {
            for k in range d2 {
                a I64 = o2 + k * 4
                b I64 = bo + (d1 + k) * nr
                rowStep(acc, 0, a2[a], bp, b, nr)
                rowStep(acc, nr, a2[a + 1], bp, b, nr)
                rowStep(acc, 2 * nr, a2[a + 2], bp, b, nr)
                rowStep(acc, 3 * nr, a2[a + 3], bp, b, nr)
            }
        }
        nomatch { }
    }
    # the accumulators leave the registers in row order, which is what lets the vectorizer group them by rows - read
    # by the stores in any other order (storeTileT's), they would be kept one to a register, or in memory
    t := tile<A>()
    for i in range 4 {
        for j in range nr { t.v[i * nr + j] = acc.v[i * nr + j] }
    }
    if exchanged { storeTileT(t, nr, alpha, beta, c, co, ldc, rows, cols) } else { storeTile(t, nr, alpha, beta, c, co, ldc, rows, cols, lim) }
}

fn micro6(d1 I64, a1 Array<<A>>&, o1 I64, ld1 I64, lay <L>, d2 I64, a2 Array<A>&, o2 I64, bp Array<A>&, bo I64, sh <S>, alpha A, beta A, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64, lim I64, exchanged Bool) {
    z A
    nr := tileColsOf(z, sh)
    si, sk := aSteps(z, lay, ld1)
    acc := tile<A>()
    for k in range d1 {
        a I64 = o1 + k * sk
        b I64 = bo + k * nr
        rowStep(acc, 0, a1[a], bp, b, nr)
        rowStep(acc, nr, a1[a + si], bp, b, nr)
        rowStep(acc, 2 * nr, a1[a + 2 * si], bp, b, nr)
        rowStep(acc, 3 * nr, a1[a + 3 * si], bp, b, nr)
        rowStep(acc, 4 * nr, a1[a + 4 * si], bp, b, nr)
        rowStep(acc, 5 * nr, a1[a + 5 * si], bp, b, nr)
    }
    # the packed tail of a tile read in place - no other layout has one
    match L {
        case rowsA {
            for k in range d2 {
                a I64 = o2 + k * 6
                b I64 = bo + (d1 + k) * nr
                rowStep(acc, 0, a2[a], bp, b, nr)
                rowStep(acc, nr, a2[a + 1], bp, b, nr)
                rowStep(acc, 2 * nr, a2[a + 2], bp, b, nr)
                rowStep(acc, 3 * nr, a2[a + 3], bp, b, nr)
                rowStep(acc, 4 * nr, a2[a + 4], bp, b, nr)
                rowStep(acc, 5 * nr, a2[a + 5], bp, b, nr)
            }
        }
        nomatch { }
    }
    # the accumulators leave the registers in row order, which is what lets the vectorizer group them by rows - read
    # by the stores in any other order (storeTileT's), they would be kept one to a register, or in memory
    t := tile<A>()
    for i in range 6 {
        for j in range nr { t.v[i * nr + j] = acc.v[i * nr + j] }
    }
    if exchanged { storeTileT(t, nr, alpha, beta, c, co, ldc, rows, cols) } else { storeTile(t, nr, alpha, beta, c, co, ldc, rows, cols, lim) }
}

fn micro12(d1 I64, a1 Array<<A>>&, o1 I64, ld1 I64, lay <L>, d2 I64, a2 Array<A>&, o2 I64, bp Array<A>&, bo I64, sh <S>, alpha A, beta A, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64, lim I64, exchanged Bool) {
    z A
    nr := tileColsOf(z, sh)
    si, sk := aSteps(z, lay, ld1)
    acc := tile<A>()
    for k in range d1 {
        a I64 = o1 + k * sk
        b I64 = bo + k * nr
        rowStep(acc, 0, a1[a], bp, b, nr)
        rowStep(acc, nr, a1[a + si], bp, b, nr)
        rowStep(acc, 2 * nr, a1[a + 2 * si], bp, b, nr)
        rowStep(acc, 3 * nr, a1[a + 3 * si], bp, b, nr)
        rowStep(acc, 4 * nr, a1[a + 4 * si], bp, b, nr)
        rowStep(acc, 5 * nr, a1[a + 5 * si], bp, b, nr)
        rowStep(acc, 6 * nr, a1[a + 6 * si], bp, b, nr)
        rowStep(acc, 7 * nr, a1[a + 7 * si], bp, b, nr)
        rowStep(acc, 8 * nr, a1[a + 8 * si], bp, b, nr)
        rowStep(acc, 9 * nr, a1[a + 9 * si], bp, b, nr)
        rowStep(acc, 10 * nr, a1[a + 10 * si], bp, b, nr)
        rowStep(acc, 11 * nr, a1[a + 11 * si], bp, b, nr)
    }
    # the packed tail of a tile read in place - no other layout has one
    match L {
        case rowsA {
            for k in range d2 {
                a I64 = o2 + k * 12
                b I64 = bo + (d1 + k) * nr
                rowStep(acc, 0, a2[a], bp, b, nr)
                rowStep(acc, nr, a2[a + 1], bp, b, nr)
                rowStep(acc, 2 * nr, a2[a + 2], bp, b, nr)
                rowStep(acc, 3 * nr, a2[a + 3], bp, b, nr)
                rowStep(acc, 4 * nr, a2[a + 4], bp, b, nr)
                rowStep(acc, 5 * nr, a2[a + 5], bp, b, nr)
                rowStep(acc, 6 * nr, a2[a + 6], bp, b, nr)
                rowStep(acc, 7 * nr, a2[a + 7], bp, b, nr)
                rowStep(acc, 8 * nr, a2[a + 8], bp, b, nr)
                rowStep(acc, 9 * nr, a2[a + 9], bp, b, nr)
                rowStep(acc, 10 * nr, a2[a + 10], bp, b, nr)
                rowStep(acc, 11 * nr, a2[a + 11], bp, b, nr)
            }
        }
        nomatch { }
    }
    # the accumulators leave the registers in row order, which is what lets the vectorizer group them by rows - read
    # by the stores in any other order (storeTileT's), they would be kept one to a register, or in memory
    t := tile<A>()
    for i in range 12 {
        for j in range nr { t.v[i * nr + j] = acc.v[i * nr + j] }
    }
    if exchanged { storeTileT(t, nr, alpha, beta, c, co, ldc, rows, cols) } else { storeTile(t, nr, alpha, beta, c, co, ldc, rows, cols, lim) }
}

# the target's micro-kernel
fn micro(d1 I64, a1 Array<<A>>&, o1 I64, ld1 I64, lay <L>, d2 I64, a2 Array<A>&, o2 I64, bp Array<A>&, bo I64, sh <S>, alpha A, beta A, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64, lim I64, exchanged Bool) {
    if TargetVectorBits >= 512 {
        micro12(d1, a1, o1, ld1, lay, d2, a2, o2, bp, bo, sh, alpha, beta, c, co, ldc, rows, cols, lim, exchanged)
    } else if TargetVectorBits >= 256 {
        micro6(d1, a1, o1, ld1, lay, d2, a2, o2, bp, bo, sh, alpha, beta, c, co, ldc, rows, cols, lim, exchanged)
    } else {
        micro4(d1, a1, o1, ld1, lay, d2, a2, o2, bp, bo, sh, alpha, beta, c, co, ldc, rows, cols, lim, exchanged)
    }
}

# whether a left operand can be read where it is rather than packed: a matrix whose elements are already of the
# accumulation type, read by rows (op(a) = a - read by columns, a transposed one strides across its rows a step at a
# time, which the caches do not prefetch: packing it was measured 1.5x as fast)
fn readsInPlace(sa <SA>, ta Bool, z <A>) Bool {
    return match SA {
        case operand<A> => not ta
        nomatch => false
    }
}

# the tile of rows ti .. ti + tr of x and the depth ks .. ke of this block (from p0), read where x is, by rows - the
# last rows, fewer than the tile's, packed into ap with zeros below them - and stored. A lower-triangular x (lower) is
# read in place up to the depth where its triangle begins, every row of the tile reaching that far (p <= ti + diag), and
# the triangle's part, where the rows end at different places, is packed with its zeros
fn tileInPlace(x operand<<A>>&, ti I64, tr I64, p0 I64, ks I64, ke I64, lower Bool, diag I64, ap mut Array<A>&, bp Array<A>&, bo I64, sh <S>, alpha A, beta A, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64, lim I64, exchanged Bool) {
    z A
    mr := tileRows(z)
    nr := tileColsOf(z, sh)
    if tr < mr {
        x.pack(false, ti, p0 + ks, tr, ke - ks, aPanel(), sh, lower, diag, ap)
        micro(ke - ks, ap, 0, 0, packedA(), 0, ap, 0, bp, bo + ks * nr, sh, alpha, beta, c, co, ldc, rows, cols, lim, exchanged)
        return
    }
    full I64 = clampI(ti + diag + 1 - p0, ks, ke) if lower else ke
    if full < ke { x.pack(false, ti, p0 + full, mr, ke - full, aPanel(), sh, true, diag, ap) }
    micro(full - ks, x.d, ti * x.ld + p0 + ks, x.ld, rowsA(), ke - full, ap, 0, bp, bo + ks * nr, sh, alpha, beta, c, co, ldc, rows, cols, lim, exchanged)
}

# a tile computed and stored: by tileInPlace where the left operand is read in place, from the packed panel otherwise -
# its rows from ao, the depth from ks (the panel's depth ks - from its start)
fn computeTile(sa <SA>, inPlace Bool, ti I64, tr I64, p0 I64, ks I64, ke I64, lower Bool, diag I64, ap mut Array<<A>>&, ao I64, bp Array<A>&, bo I64, sh <S>, alpha A, beta A, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64, lim I64, exchanged Bool) {
    if inPlace {
        match SA {
            case operand<A> {
                tileInPlace(sa, ti, tr, p0, ks, ke, lower, diag, ap, bp, bo, sh, alpha, beta, c, co, ldc, rows, cols, lim, exchanged)
                return
            }
            nomatch { }
        }
    }
    z A
    micro(ke - ks, ap, ao + ks * tileRows(z), 0, packedA(), 0, ap, 0, bp, bo + ks * tileColsOf(z, sh), sh, alpha, beta, c, co, ldc, rows, cols, lim, exchanged)
}

# one row of the tile for one step of k: acc[base + j] += x * bp[b + j] for the tile's nr columns
fn rowStep(acc mut tile<<A>>&, base I64, x A, bp Array<A>&, b I64, nr I64) {
    for j in range nr { acc.v[base + j] = mulAdd(x, bp[b + j], acc.v[base + j]) }
}

# a * b + c - rounded once, by the target's fused multiply-add instruction, where it has one and A is a float. Every
# product here accumulates through it: the micro-kernels, the small and matrix-vector products and the dot products
fn mulAdd(a <A>, b A, c A) A {
    match A {
        case F32, F64 {
            if TargetHasFma { return math.Fma(a, b, c) }
        }
        nomatch { }
    }
    return a * b + c
}

# ---- storing a tile ----

# C[i, j] = alpha acc[i, j] + beta C[i, j] for the rows x cols part of the tile inside the product, C's element (i, j)
# at c[co + i ldc + j] - of row i only its first lim + i columns (a triangular result's diagonal: lim >= cols where the
# whole tile is wanted). beta == 0 never reads C, so C may hold anything (BLAS's rule)
fn storeTile(acc tile<<A>>&, nr I64, alpha A, beta A, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64, lim I64) {
    like T
    if beta == 0 {
        for i in range rows {
            o I64 = co + i * ldc
            for j in range clampI(lim + i, 0, cols) { c[o + j] = Cast(alpha * acc.v[i * nr + j], like) }
        }
        return
    }
    for i in range rows {
        o I64 = co + i * ldc
        for j in range clampI(lim + i, 0, cols) { c[o + j] = Cast(alpha * acc.v[i * nr + j] + beta * Cast(c[o + j], alpha), like) }
    }
}

# the tile of C^T computed where a product is exchanged (tileChoice): C[j, i] = alpha acc[i, j] + beta C[j, i], at
# c[co + j ldc + i]
fn storeTileT(acc tile<<A>>&, nr I64, alpha A, beta A, c mut Array<<T>>&, co I64, ldc I64, rows I64, cols I64) {
    like T
    for j in range cols {
        o I64 = co + j * ldc
        if beta == 0 {
            for i in range rows { c[o + i] = Cast(alpha * acc.v[i * nr + j], like) }
        } else {
            for i in range rows { c[o + i] = Cast(alpha * acc.v[i * nr + j] + beta * Cast(c[o + i], alpha), like) }
        }
    }
}

# the tile for accumulation type A on the target, BLIS's: NR columns, a whole number of vectors (TargetVectorBits) of
# B's packed row, by MR rows, each broadcast from A's panel - so the MR x NR accumulators, the vectors of B and the
# broadcast fill the vector registers the target has: AVX-512's 32 registers of 512 bits take 12 x 32 four-byte elements
# (24 accumulators), AVX's 16 of 256 bits 6 x 16 (12), SSE's 16 of 128 bits 4 x 12 (12); an eight-byte element type
# has half the columns. A thin tile has the same rows and one vector of columns
fn tileRows(z <A>) I64 {
    if TargetVectorBits >= 512 { return 12 }
    if TargetVectorBits >= 256 { return 6 }
    return 4
}

fn tileCols(z <A>) I64 {
    wide I64 = match A {
        case F64, I64, U64 => 2
        nomatch => 1
    }
    if TargetVectorBits >= 512 { return 32 / wide }
    if TargetVectorBits >= 256 { return 16 / wide }
    return 12 / wide
}

# the blocking around the tile, Goto's: kc the depth of a packed panel (k per block), mc the rows of A packed per block
# (a multiple of the tile's rows; its panel stays in L2), nc the columns of B packed per block (a multiple of the tile's
# columns, wide or thin; its panel stays in L3)
kc I64 = 256

fn blockRows(z <A>) I64 {
    mr := tileRows(z)
    return 128 / mr * mr
}

fn blockCols(z <A>) I64 {
    nr := tileCols(z)
    return 2048 / nr * nr
}

# the fraction of the tiles' work that falls inside an m x n result, the rest being padding: what decides the tile
fn coverage(m I64, n I64, mr I64, nr I64) F64 {
    return F64(m) / F64((m + mr - 1) / mr * mr) * (F64(n) / F64((n + nr - 1) / nr * nr))
}

# the tile for an m x n result: thin where it covers the result by 15% more than the wide one (a thin tile computes
# about as fast per element, one vector wider loads aside), and whether to compute the transpose of the result instead
# - exchanging the operands, C^T = op(b)^T op(a)^T - where that covers it by 25% more still (a 16 x 9 gradient of a
# convolution's weights, a batch of 64 against ten classes). Exchanging changes no element's sum, only where it is
# computed
fn tileChoice(m I64, n I64, mr I64, wideCols I64, thinCols I64, mayExchange Bool) (Bool, Bool) {
    w := coverage(m, n, mr, wideCols)
    t := coverage(m, n, mr, thinCols)
    thin Bool = t > 1.15 * w
    best F64 = t if thin else w
    if mayExchange {
        we := coverage(n, m, mr, wideCols)
        te := coverage(n, m, mr, thinCols)
        thinE Bool = te > 1.15 * we
        if (te if thinE else we) > 1.25 * best { return thinE, true }
    }
    return thin, false
}

# whether a product of m x k by k x n is computed by gemmDirect rather than packed: one so small that the packed path's
# own costs outweigh what it saves - at most smallProduct multiply-adds - or a result of fewer than twelve rows, each at
# least four vectors long, against a right operand that stays in the cache (k n at most 65536 elements): the direct
# loop then runs along the rows at full width, where a tile would be mostly padding. Measured against the packed path
# on AVX-512, AVX2 and SSE (bench/README.md). The bound this replaced, 64^3 multiply-adds of any shape, made a product
# as small as attention's 64 x 32 x 64 two to three times slower than packing it on AVX-512, and only the shapes above
# ever came out ahead
smallProduct I64 = 1024

fn computedDirectly(m I64, n I64, k I64, z <T>) Bool {
    return m * n * k <= smallProduct or (m < 12 and n >= 4 * vectorLanes(z) and k * n <= 65536)
}

# a small product, in the element type and without packing: each row of C updated from rows of B (the i-k-j loop,
# vectorized along the rows) - B not transposed
fn gemmDirect(transA Bool, m I64, n I64, k I64, alpha <T>, a Array<T>&, lda I64, b Array<T>&, ldb I64, beta T, c mut Array<T>&, ldc I64) {
    z T
    for i in range m {
        ci I64 = i * ldc
        if beta == z {
            for j in range n { c[ci + j] = z }
        } else if beta != 1 {
            for j in range n { c[ci + j] = beta * c[ci + j] }
        }
        for p in range k {
            aip T = alpha * (a[p * lda + i] if transA else a[i * lda + p])
            bp I64 = p * ldb
            for j in range n { c[ci + j] = mulAdd(aip, b[bp + j], c[ci + j]) }
        }
    }
}

# out[i * os] = alpha * sum over p < len of M(i, p) v[p] + beta * out[i * os] for i < rows, where M(i, p) is
# mat[i * rs + p * cs] and v[p] is vec[p * vs]: a matrix-vector product in either orientation. Rows of M that are
# contiguous (cs = 1) with a contiguous v are dot products in lanes; columns of M that are contiguous (rs = 1) are
# added in, scaled, one after another
fn gemv(rows I64, len I64, alpha <T>, mat Array<T>&, rs I64, cs I64, vec Array<T>&, vs I64, beta T, out mut Array<T>&, os I64) {
    z T
    if cs == 1 and vs == 1 {
        for i in range rows {
            d T = alpha * dotRun(mat, i * rs, vec, 0, len, z)
            out[i * os] = d if beta == z else d + beta * out[i * os]
        }
        return
    }
    for i in range rows {
        out[i * os] = z if beta == z else beta * out[i * os]
    }
    if rs == 1 and os == 1 {
        for p in range len {
            vp T = alpha * vec[p * vs]
            col I64 = p * cs
            for i in range rows { out[i] = mulAdd(vp, mat[col + i], out[i]) }
        }
        return
    }
    for i in range rows {
        acc T = z
        for p in range len { acc = mulAdd(mat[i * rs + p * cs], vec[p * vs], acc) }
        out[i * os] = out[i * os] + alpha * acc
    }
}

# ---- the blocked product ----

# rows i0 .. i1 of the result for one packed block of the right operand - bp, its depth p0 .. p0 + depth of k and its
# columns j0 .. j0 + cols: the left operand's rows packed mc at a time into ap (or read in place), and every tile
# computed by the micro-kernel and stored - transposed into c where exchanged, C^T being what is computed then. A
# triangular product (tri) skips what it can: a triangular result the tiles past the diagonal, a triangular left
# operand the part of the depth a tile's rows read as its zeros
fn gemmRows(sa <SA>, ta Bool, i0 I64, i1 I64, p0 I64, depth I64, k I64, cols I64, j0 I64, al <A>, ap mut Array<A>&, bp Array<A>&, bt A, c mut Array<<T>>&, ldc I64, sh <S>, exchanged Bool, tri Triangular, diag I64, ep epilogue<T>&) {
    mr := tileRows(al)
    nr := tileColsOf(al, sh)
    mc := blockRows(al)
    lower Bool = tri == Triangular.Left
    result Bool = tri == Triangular.Result
    act Bool = p0 + depth == k and ep.on()
    # a result one or two tiles wide reads each element of A once or twice: packing it would cost more than it saves,
    # so A is read where it is
    inPlace Bool = readsInPlace(sa, ta, al) and cols <= 2 * nr
    for ic in range i0, i1, mc {
        rows I64 = lesser(mc, i1 - ic)
        # a triangular result: rows whose every column in this block is past the diagonal compute nothing
        if result and ic + rows - 1 + diag < j0 { continue }
        # the depth these rows reach: all of it, or what a triangular left operand leaves
        lo, hi := triangleDepth(lower, ta, ic, rows, p0, depth, diag)
        if not inPlace and lo < hi { sa.pack(ta, ic, p0 + lo, rows, hi - lo, aPanel(), sh, lower, diag, ap) }
        for jr in range 0, cols, nr {
            for ir in range 0, rows, mr {
                ti I64 = ic + ir
                tj I64 = j0 + jr
                tr I64 = lesser(mr, rows - ir)
                tc I64 = lesser(nr, cols - jr)
                lim I64 = tc
                ks I64 = 0
                ke I64 = depth
                if result {
                    lim = ti + diag - tj + 1
                    if lim + tr <= 1 { continue }               # every element past the diagonal
                } else if lower {
                    ks, ke = triangleDepth(lower, ta, ti, tr, p0, depth, diag)
                    if ks >= ke {
                        if p0 > 0 { continue }                  # nothing to add: the first block applied beta
                        ks = 0
                        ke = 0
                    }
                }
                co I64 = tj * ldc + ti if exchanged else ti * ldc + tj
                computeTile(sa, inPlace, ti, tr, p0, ks, ke, lower, diag, ap, ir * (hi - lo) - lo * mr, bp, jr * depth, sh, al, bt, c, co, ldc, tr, tc, lim, exchanged)
            }
        }
        # the epilogue, once these rows are summed: a pass over their part of C while it is in the cache, a row of C at
        # a time - the columns of C^T where exchanged
        if act {
            if exchanged { epilogueRegion(c, ldc, j0, j0 + cols, ic, ic + rows, ep, al) } else { epilogueRegion(c, ldc, ic, ic + rows, j0, j0 + cols, ep, al) }
        }
    }
}

# the epilogue on rows r0 .. r1, columns c0 .. c1 of C (row stride ldc): z = C + bias, kept in pre, then C = act(z),
# computed in the accumulation type A - one loop per activation, its function inlined (epilogueAs)
fn epilogueRegion(c mut Array<<T>>&, ldc I64, r0 I64, r1 I64, c0 I64, c1 I64, ep epilogue<T>&, z <A>) {
    match ep.act {
        case Activation.Identity { epilogueAs(c, ldc, r0, r1, c0, c1, ep, z, identityAct()) }
        case Activation.Relu { epilogueAs(c, ldc, r0, r1, c0, c1, ep, z, reluAct()) }
        case Activation.Gelu { epilogueAs(c, ldc, r0, r1, c0, c1, ep, z, geluAct()) }
        case Activation.Tanh { epilogueAs(c, ldc, r0, r1, c0, c1, ep, z, tanhAct()) }
        case Activation.Sigmoid { epilogueAs(c, ldc, r0, r1, c0, c1, ep, z, sigmoidAct()) }
    }
}

# the activations as types, so that each epilogue is compiled with its own inlined
type identityAct struct() { }
type reluAct struct() { }
type geluAct struct() { }
type tanhAct struct() { }
type sigmoidAct struct() { }

fn activateAs(x <A>, kind <K>) A {
    return match K {
        case identityAct => x
        case reluAct => relu(x)
        case geluAct => gelu(x)
        case tanhAct => tanhOf(x)
        case sigmoidAct => sigmoidOf(x)
    }
}

fn epilogueAs(c mut Array<<T>>&, ldc I64, r0 I64, r1 I64, c0 I64, c1 I64, ep epilogue<T>&, z <A>, kind <K>) {
    like T
    pre := ep.pre
    ldp := ep.ldp
    bias := ep.bias
    # 64 columns at a time, their bias in a local first: with C the only array a loop touches, a short row (a
    # convolution's sixteen channels) needs no test for overlapping arrays each time round
    b := colLanes<A>(z)
    for j0 in range c0, c1, 64 {
        w I64 = lesser(64, c1 - j0)
        if bias != null {
            for j in range w { b.v[j] = Cast(bias[j0 + j], z) }
        }
        for r in range r0, r1 {
            o I64 = r * ldc + j0
            if pre != null {
                q I64 = r * ldp + j0
                for j in range w {
                    v T = Cast(Cast(c[o + j], z) + b.v[j], like) if bias != null else c[o + j]
                    pre[q + j] = v
                    c[o + j] = Cast(activateAs(Cast(v, z), kind), like)
                }
            } else if bias != null {
                for j in range w { c[o + j] = Cast(activateAs(Cast(Cast(Cast(c[o + j], z) + b.v[j], like), z), kind), like) }
            } else {
                for j in range w { c[o + j] = Cast(activateAs(Cast(c[o + j], z), kind), like) }
            }
        }
    }
}

# the part of this block's depth (0 .. depth, from p0) that rows ti .. ti + tr of a triangular left operand read: of a
# lower-triangular x[r, s], zero for s > r + diag, p <= i + diag - or p >= i - diag where it is transposed (ta)
fn triangleDepth(lower Bool, ta Bool, ti I64, tr I64, p0 I64, depth I64, diag I64) (I64, I64) {
    if not lower { return 0, depth }
    if ta { return clampI(ti - diag - p0, 0, depth), depth }
    return 0, clampI(ti + tr + diag - p0, 0, depth)
}

# the m x n x k product C = alpha op(A) op(B) + beta C from sa and sb (as packing reads them: ta and tb its trans), one
# packed block of B at a time into bp, rows in runs of share over tasks (one task: the calling thread), each task
# packing its rows of A into its own panel of ap (panel elements)
fn gemmBlocks(m I64, n I64, k I64, sa <SA>, ta Bool, sb <SB>, tb Bool, al <A>, be A, c mut Array<<T>>&, ldc I64, share I64, ap mut Array<A>&, panel I64, bp mut Array<A>&, sh <S>, exchanged Bool, tri Triangular, diag I64, ep epilogue<T>&) {
    nr := tileColsOf(al, sh)
    nc := blockCols(al)
    tasks I64 = (m + share - 1) / share
    one A = Cast(1, al)
    for jc in range 0, n, nc {
        cols I64 = lesser(nc, n - jc)
        for pc in range 0, k, kc {
            depth I64 = lesser(kc, k - pc)
            sb.pack(tb, jc, pc, cols, depth, bPanel(), sh, false, 0, bp)
            bt A = be if pc == 0 else one
            if tasks <= 1 {
                gemmRows(sa, ta, 0, m, pc, depth, k, cols, jc, al, ap, bp, bt, c, ldc, sh, exchanged, tri, diag, ep)
            } else {
                join {
                    for t in range tasks {
                        lo I64 = t * share
                        hi I64 = lesser(m, lo + share)
                        if lo < hi { spawn gemmRows(sa, ta, lo, hi, pc, depth, k, cols, jc, al, ap[t * panel:(t + 1) * panel], bp, bt, c, ldc, sh, exchanged, tri, diag, ep) }
                    }
                }
            }
        }
    }
}

# C = act(beta C + bias) where there is nothing to sum (k = 0) - of a triangular result its lower triangle only
fn emptyProduct(m I64, n I64, be <A>, c mut Array<<T>>&, ldc I64, ep epilogue<T>&, tri Triangular, diag I64) {
    like T
    z A
    for i in range m {
        w I64 = clampI(i + diag + 1, 0, n) if tri == Triangular.Result else n
        for j in range w {
            x A = z
            if be != 0 { x = be * Cast(c[i * ldc + j], z) }
            if ep.bias != null { x = x + Cast(ep.bias[j], z) }
            if ep.pre != null { ep.pre[i * ep.ldp + j] = Cast(x, like) }
            c[i * ldc + j] = Cast(Activate(x, ep.act), like)
        }
    }
}

# C = alpha op(A) op(B) + beta C, then the epilogue, for an m x n x k product of a and b (an operand or Patches, as
# packing reads them) into c, row stride ldc, in accumulation type A (the type of z)
fn productIn(m I64, n I64, k I64, a <SA>, transA Bool, b <SB>, transB Bool, alpha <T>, beta T, c mut Array<T>&, ldc I64, threads I64, ws mut GemmWorkspace<T>&, ep epilogue<T>&, z <A>) {
    al := Cast(alpha, z)
    be := Cast(beta, z)
    if k == 0 {
        emptyProduct(m, n, be, c, ldc, ep, Triangular.None, 0)
        return
    }
    match T {
        case F16, BF16, F8E4M3, F8E5M2 { }
        nomatch {
            match SA {
                case operand<T> {
                    match SB {
                        case operand<T> {
                            if m <= 4 or n == 1 {
                                # vectors times a matrix (a batch of up to four), or a matrix times a vector: no packing and
                                # no threads, one pass over the matrix per vector
                                if m <= 4 {
                                    # c's row i: c[i, j] = alpha * sum over p of x[p] B(p, j), x being a's row i (column, if transA)
                                    for i in range m {
                                        x := a.d[i:] if transA else a.d[i * a.ld:]
                                        gemv(n, k, alpha, b.d, b.ld if transB else 1, 1 if transB else b.ld, x, a.ld if transA else 1, beta, c[i * ldc:], 1)
                                    }
                                } else {
                                    # c's one column: c[i] = alpha * sum over p of A(i, p) y[p], y being b's one column (row, if transB)
                                    gemv(m, k, alpha, a.d, 1 if transA else a.ld, a.ld if transA else 1, b.d, 1 if transB else b.ld, beta, c, ldc)
                                }
                                epilogueRegion(c, ldc, 0, m, 0, n, ep, z)
                                return
                            }
                            if not transB and computedDirectly(m, n, k, z) {
                                gemmDirect(transA, m, n, k, alpha, a.d, a.ld, b.d, b.ld, beta, c, ldc)
                                epilogueRegion(c, ldc, 0, m, 0, n, ep, z)
                                return
                            }
                        }
                        nomatch { }
                    }
                }
                nomatch { }
            }
        }
    }
    mr := tileRows(z)
    thin, exchanged := tileChoice(m, n, mr, tileCols(z), vectorLanes(z), a.isMatrix() and b.isMatrix())
    if exchanged {
        packedProduct(n, m, k, b, not transB, a, transA, al, be, c, ldc, threads, ws, thin, true, ep)
    } else {
        packedProduct(m, n, k, a, transA, b, not transB, al, be, c, ldc, threads, ws, thin, false, ep)
    }
}

# the packed product, its panels from ws: B's one panel, A's one per task - a product large enough is split over up to
# threads tasks by rows of the result, a multiple of the tile's rows each
fn packedProduct(m I64, n I64, k I64, sa <SA>, ta Bool, sb <SB>, tb Bool, al <A>, be A, c mut Array<<T>>&, ldc I64, threads I64, ws mut GemmWorkspace<T>&, thin Bool, exchanged Bool, ep epilogue<T>&) {
    mr := tileRows(al)
    nr I64 = vectorLanes(al) if thin else tileCols(al)
    depthMax I64 = lesser(k, kc)
    colsMax I64 = lesser((n + nr - 1) / nr * nr, blockCols(al))
    bp := ws.panelB(depthMax * colsMax, al)
    tasks I64 = lesser(threads, (m + mr - 1) / mr)
    if m * n * k < 2000000 { tasks = 1 }
    share I64 = ((m + tasks - 1) / tasks + mr - 1) / mr * mr
    panel I64 = lesser(blockRows(al), share) * depthMax
    ap := ws.panelsA(tasks * panel, al)
    if thin {
        gemmBlocks(m, n, k, sa, ta, sb, tb, al, be, c, ldc, share, ap, panel, bp, thinTile(), exchanged, Triangular.None, 0, ep)
    } else {
        gemmBlocks(m, n, k, sa, ta, sb, tb, al, be, c, ldc, share, ap, panel, bp, wideTile(), exchanged, Triangular.None, 0, ep)
    }
}

# a product through the core: C (m x n, row stride ldc, in c) = alpha * op(a) op(b) + beta * C, then the epilogue
fn product(m I64, n I64, k I64, a <SA>, transA Bool, b <SB>, transB Bool, alpha F64, beta F64, c mut Array<<T>>&, ldc I64, threads I64, ws mut GemmWorkspace<T>&, ep epilogue<T>&) {
    if m == 0 or n == 0 { return }
    like T
    al := Cast(alpha, like)
    be := Cast(beta, like)
    match T {
        case F16, BF16, F8E4M3, F8E5M2 { productIn(m, n, k, a, transA, b, transB, al, be, c, ldc, threads, ws, ep, F32(0)) }
        nomatch { productIn(m, n, k, a, transA, b, transB, al, be, c, ldc, threads, ws, ep, like) }
    }
}

# The panels a product packs its operands into, kept from one product to the next: ws.Gemm(...) is Gemm packing into
# ws rather than into storage of its own, so a loop of products - a training step's - allocates nothing once ws has
# grown to the largest of them. GemmWorkspace<F32>() is empty; it grows where it lives, to what the largest product
# given needs, and never shrinks. A panel that is too small is replaced by one at least twice its size, so products
# growing a step at a time (attention over a growing context) replace it a logarithmic number of times, and all the
# panels a workspace ever made - each superseded one stays where the workspace lives until that closes - come to
# less than four times what the largest product needs. It holds no result, so one workspace serves products of any
# shapes, one at a time - two at once on one workspace, from two tasks, write the same panels (a data race, P8b)
type GemmWorkspace<T> struct() {
    a mut Array<T>&             # A's panels, one per task, for element types computed in themselves
    b mut Array<T>&             # B's panel
    wideA mut Array<F32>&       # the same for F16, BF16 and the F8s, which are computed in F32
    wideB mut Array<F32>&
}

# B's panel, with room for at least n elements of accumulation type A - made larger, where ws lives, when it has less:
# n elements, or twice what it had when that is more
fn (ws mut GemmWorkspace<<T>>&) panelB(n I64, z <A>) mut Array<A>&ws {
    match T {
        case F16, BF16, F8E4M3, F8E5M2 {
            if ws.wideB == null { ws.wideB = Array<F32>(n) } else if ws.wideB.Len() < n { ws.wideB = Array<F32>(grown(ws.wideB.Len(), n)) }
            return ws.wideB
        }
        nomatch {
            if ws.b == null { ws.b = Array<T>(n) } else if ws.b.Len() < n { ws.b = Array<T>(grown(ws.b.Len(), n)) }
            return ws.b
        }
    }
}

# A's panels, the same way
fn (ws mut GemmWorkspace<<T>>&) panelsA(n I64, z <A>) mut Array<A>&ws {
    match T {
        case F16, BF16, F8E4M3, F8E5M2 {
            if ws.wideA == null { ws.wideA = Array<F32>(n) } else if ws.wideA.Len() < n { ws.wideA = Array<F32>(grown(ws.wideA.Len(), n)) }
            return ws.wideA
        }
        nomatch {
            if ws.a == null { ws.a = Array<T>(n) } else if ws.a.Len() < n { ws.a = Array<T>(grown(ws.a.Len(), n)) }
            return ws.a
        }
    }
}

# the length a panel holding have elements is replaced by when a product needs n: n, or twice have when that is more -
# so the panels a workspace makes at least double each time, and the superseded ones add up to less than the last
fn grown(have I64, n I64) I64 { return n if n > have * 2 else have * 2 }

# ---- products of matrices and vectors ----

# c = alpha * op(a) op(b) + beta * c, where op(x) is x or, when its flag is set, x's transpose - read where x is, never
# transposed in memory. beta = 1 accumulates (a gradient's second contribution, with no temporary); beta = 0 never
# reads c, so c may hold anything. c must not overlap a or b. Allocates only the panels the product packs into, in
# its own scope (ws.Gemm, below, packs into a workspace the caller keeps instead); a large product is split over up to
# threads tasks. alpha and beta are F64, so a literal is written as it is whatever the element type; each is converted
# to it once
fn Gemm(c Matrix<<T>>&, a Matrix<T>&, transA Bool, b Matrix<T>&, transB Bool, alpha F64 = 1, beta F64 = 0, threads I64 = 1) {
    ws := GemmWorkspace<T>()
    ws.Gemm(c, a, transA, b, transB, alpha, beta, threads)
}

# Gemm, packing into ws: allocates nothing once ws has room for this product's panels
fn (ws mut GemmWorkspace<<T>>&) Gemm(c Matrix<T>&, a Matrix<T>&, transA Bool, b Matrix<T>&, transB Bool, alpha F64 = 1, beta F64 = 0, threads I64 = 1) {
    assert productShape(c, a, transA, b, transB)
    k I64 = a.Rows if transA else a.Cols
    ep := epilogue<T>(null, Activation.Identity, null, 0)
    product(c.Rows, c.Cols, k, operand<T>(a.Data, a.Stride), transA, operand<T>(b.Data, b.Stride), transB, alpha, beta, c.Data, c.Stride, threads, ws, ep)
}

# y = alpha * op(a) x + beta * y, for vectors x and y: a matrix-vector product, a's rows dotted with x (trans false)
# or a's columns (trans true) - no packing, no threads, nothing allocated; beta = 0 never reads y. A batch of up to
# four rows through Gemm takes the same path
fn Gemv(y mut Array<<T>>&, a Matrix<T>&, trans Bool, x Array<T>&, alpha F64 = 1, beta F64 = 0) {
    m I64 = a.Cols if trans else a.Rows
    k I64 = a.Rows if trans else a.Cols
    assert y.Len() == m and x.Len() == k
    ws := GemmWorkspace<T>()          # never packed into: one column takes the matrix-vector path
    ep := epilogue<T>(null, Activation.Identity, null, 0)
    product(m, 1, k, operand<T>(a.Data, a.Stride), trans, operand<T>(x, 1), false, alpha, beta, y, 1, 1, ws, ep)
}

# ---- a product and what follows it: the epilogue ----

# an activation, applied to every element of a product's result as the product finishes it (GemmAct, GemmPatches) - a
# layer and its nonlinearity in one call - or on its own (Activate, ActivationBackward). Activate gives each one's
# formula; F16, BF16 and the F8 types are computed in F32 and rounded once, and an integer has only Identity and Relu
type Activation enum {
    Identity
    Relu
    Gelu
    Tanh
    Sigmoid
}

# what a product does to each element of its result once it is summed: a bias row added, what the activation is applied
# to kept in pre (row stride ldp), the activation - none of it where bias and pre are null and act is Identity
type epilogue<T> struct(bias Array<T>&, act Activation, pre mut Array<T>&, ldp I64) {
    bias
    act
    pre
    ldp
}

fn (e epilogue<<T>>&) on() Bool { return e.bias != null or e.pre != null or e.act != Activation.Identity }

# act(x), one element: Identity x; Relu max(x, 0), a NaN staying a NaN; Gelu GELU in its tanh form,
# 0.5 x (1 + tanh(sqrt(2 / pi) (x + 0.044715 x^3))) - Hendrycks and Gimpel's approximation, GPT-2's activation,
# PyTorch's approximate="tanh" - through FastTanh: within 7e-7 (F32) and 3e-16 (F64) of that formula computed with the
# C library's tanh in F64, measured at 20,001 points over [-10, 10] (beyond them it is x or 0 to the type's precision),
# and the formula itself within 5e-4 of GELU's exact x Phi(x); Tanh FastTanh(x); Sigmoid FastSigmoid(x)
fn Activate(x <T>, act Activation) T {
    return match act {
        case Activation.Identity => x
        case Activation.Relu => relu(x)
        case Activation.Gelu => gelu(x)
        case Activation.Tanh => tanhOf(x)
        case Activation.Sigmoid => sigmoidOf(x)
    }
}

# each activation of one element, for every element type: a float computed in its own type, F16, BF16 and the F8 types
# in F32 and rounded once; an integer has only the identity and ReLU
fn relu(x <T>) T {
    match T {
        case F8E4M3, F8E5M2 { return Cast(relu(Cast(x, F32(0))), x) }
        nomatch {
            z T
            return z if x < z else x
        }
    }
}

fn gelu(x <T>) T {
    return match T {
        case F32, F64 => 0.5 * x * (1.0 + FastTanh(0.7978845608028654 * (x + 0.044715 * x * x * x)))
        case F16, BF16, F8E4M3, F8E5M2 => Cast(gelu(Cast(x, F32(0))), x)
        nomatch => integerActivation(x)
    }
}

fn tanhOf(x <T>) T {
    return match T {
        case F32, F64 => FastTanh(x)
        case F16, BF16, F8E4M3, F8E5M2 => Cast(FastTanh(Cast(x, F32(0))), x)
        nomatch => integerActivation(x)
    }
}

fn sigmoidOf(x <T>) T {
    return match T {
        case F32, F64 => FastSigmoid(x)
        case F16, BF16, F8E4M3, F8E5M2 => Cast(FastSigmoid(Cast(x, F32(0))), x)
        nomatch => integerActivation(x)
    }
}

# GELU, tanh or the sigmoid of an integer: there is none
fn integerActivation(x <T>) T {
    abort
}

# act'(x), the slope of act at x - what an activation's backward multiplies a gradient by: Relu's 1 where x > 0 and 0
# elsewhere (at 0 too, as PyTorch has it); Gelu's 0.5 (1 + t) + 0.5 x (1 - t^2) sqrt(2 / pi) (1 + 3 0.044715 x^2),
# t = tanh(sqrt(2 / pi) (x + 0.044715 x^3)); Tanh's 1 - tanh(x)^2; Sigmoid's s (1 - s), s = sigmoid(x)
fn ActivationSlope(x <T>, act Activation) T {
    match T {
        case F32, F64 {
            return match act {
                case Activation.Identity => 1.0
                case Activation.Relu => 1.0 if x > 0.0 else 0.0
                case Activation.Gelu => geluSlope(x)
                case Activation.Tanh => 1.0 - FastTanh(x) * FastTanh(x)
                case Activation.Sigmoid => FastSigmoid(x) * (1.0 - FastSigmoid(x))
            }
        }
        case F16, BF16, F8E4M3, F8E5M2 { return Cast(ActivationSlope(Cast(x, F32(0)), act), x) }
        nomatch {
            assert act == Activation.Identity or act == Activation.Relu, "an integer has only the identity and ReLU"
            z T
            one T = 1
            return z if act == Activation.Relu and not (x > z) else one
        }
    }
}

fn geluSlope(x <T>) T {
    t T = FastTanh(0.7978845608028654 * (x + 0.044715 * x * x * x))
    return 0.5 * (1.0 + t) + 0.5 * x * (1.0 - t * t) * 0.7978845608028654 * (1.0 + 0.134145 * x * x)
}

# y = act(z), element by element - y may be z
fn (y Matrix<<T>>&) Activate(z Matrix<T>&, act Activation) {
    match act {
        case Activation.Identity { y.Map(z, fn(x) { return x }) }
        case Activation.Relu { y.Map(z, fn(x) { return relu(x) }) }
        case Activation.Gelu { y.Map(z, fn(x) { return gelu(x) }) }
        case Activation.Tanh { y.Map(z, fn(x) { return tanhOf(x) }) }
        case Activation.Sigmoid { y.Map(z, fn(x) { return sigmoidOf(x) }) }
    }
}

# dz = dy act'(z) + beta dz, element by element: an activation's backward, z being what act was applied to (pre, from
# GemmAct) - for Relu its output serves as well, having z's sign. dz may be dy
fn (dz Matrix<<T>>&) ActivationBackward(dy Matrix<T>&, z Matrix<T>&, act Activation, beta F64 = 0) {
    like T
    b := Cast(beta, like)
    if beta == 0.0 {
        match act {
            case Activation.Identity { dz.Map2(dy, z, fn(g, v) { return g * ActivationSlope(v, Activation.Identity) }) }
            case Activation.Relu { dz.Map2(dy, z, fn(g, v) { return g * ActivationSlope(v, Activation.Relu) }) }
            case Activation.Gelu { dz.Map2(dy, z, fn(g, v) { return g * ActivationSlope(v, Activation.Gelu) }) }
            case Activation.Tanh { dz.Map2(dy, z, fn(g, v) { return g * ActivationSlope(v, Activation.Tanh) }) }
            case Activation.Sigmoid { dz.Map2(dy, z, fn(g, v) { return g * ActivationSlope(v, Activation.Sigmoid) }) }
        }
        return
    }
    match act {
        case Activation.Identity { dz.Map3(dz, dy, z, fn(d, g, v) { return b * d + g * ActivationSlope(v, Activation.Identity) }) }
        case Activation.Relu { dz.Map3(dz, dy, z, fn(d, g, v) { return b * d + g * ActivationSlope(v, Activation.Relu) }) }
        case Activation.Gelu { dz.Map3(dz, dy, z, fn(d, g, v) { return b * d + g * ActivationSlope(v, Activation.Gelu) }) }
        case Activation.Tanh { dz.Map3(dz, dy, z, fn(d, g, v) { return b * d + g * ActivationSlope(v, Activation.Tanh) }) }
        case Activation.Sigmoid { dz.Map3(dz, dy, z, fn(d, g, v) { return b * d + g * ActivationSlope(v, Activation.Sigmoid) }) }
    }
}

# c = act(alpha * op(a) op(b) + beta * c + bias), bias a row of c's width added to every row (null: none) - a dense
# layer and its activation in one call. Each block of c's rows gets the bias and the activation as soon as it is
# summed, while it is still in the cache, a row at a time, so c is never read again from memory: the result is what
# Gemm, AddRow and Activate give, rounding as they do, in one pass over c. Where pre is given (c's shape, not
# overlapping it) it gets what act was applied to, which act's backward needs (ActivationBackward). Otherwise Gemm
fn GemmAct(c Matrix<<T>>&, a Matrix<T>&, transA Bool, b Matrix<T>&, transB Bool, bias Matrix<T>&, act Activation, alpha F64 = 1, beta F64 = 0, threads I64 = 1, pre Matrix<T>& = null) {
    ws := GemmWorkspace<T>()
    ws.GemmAct(c, a, transA, b, transB, bias, act, alpha, beta, threads, pre)
}

fn (ws mut GemmWorkspace<<T>>&) GemmAct(c Matrix<T>&, a Matrix<T>&, transA Bool, b Matrix<T>&, transB Bool, bias Matrix<T>&, act Activation, alpha F64 = 1, beta F64 = 0, threads I64 = 1, pre Matrix<T>& = null) {
    assert productShape(c, a, transA, b, transB)
    k I64 = a.Rows if transA else a.Cols
    ep := epilogueOf(c, bias, act, pre)
    product(c.Rows, c.Cols, k, operand<T>(a.Data, a.Stride), transA, operand<T>(b.Data, b.Stride), transB, alpha, beta, c.Data, c.Stride, threads, ws, ep)
}

fn epilogueOf(c Matrix<<T>>&, bias Matrix<T>&, act Activation, pre Matrix<T>&) epilogue<T> {
    assert bias == null or rowShape(c, bias)
    assert pre == null or sameShape(c, pre)
    if pre == null { return epilogue<T>(bias.Data if bias != null else null, act, null, 0) }
    return epilogue<T>(bias.Data if bias != null else null, act, pre.Data, pre.Stride)
}

# ---- batches: every sequence and head of attention in one call ----

# Groups x Members matrices of one shape in one storage: matrix (g, m), member m of group g, is Rows x Cols with row
# stride Stride, its first element g GroupStride + m MemberStride elements past the batch's first. A view, as a Matrix
# is - it allocates nothing, and writing a matrix of it writes the storage; b[g, m] is matrix (g, m). For attention
# over n = B T rows of D columns in heads blocks: q.Heads(T, heads) is every sequence's (a group's) every head's (a
# member's) queries, a T x D / heads column block, and so are the keys, the values and the outputs; p.Stacked(T, heads)
# is every sequence's every head's T x T scores or weights, stacked in the rows of p, head after head within a sequence
type Batch<T> struct(Rows I64, Cols I64, Stride I64, Groups I64, GroupStride I64, Members I64, MemberStride I64, data mut Array<T>&) {
    Rows
    Cols
    Stride
    Groups
    GroupStride
    Members
    MemberStride
    assert Rows >= 0 and Cols >= 0 and Stride >= Cols and Groups >= 0 and Members >= 0 and GroupStride >= 0 and MemberStride >= 0
    assert Rows == 0 or Cols == 0 or Groups == 0 or Members == 0 or data.Len() >= (Groups - 1) * GroupStride + (Members - 1) * MemberStride + (Rows - 1) * Stride + Cols
    Data mut Array<T>& = data
}

# matrix (g, m), a view
fn (b Batch<<T>>&) At(g I64, m I64) Matrix<T> {
    return View(b.Data, g * b.GroupStride + m * b.MemberStride, b.Rows, b.Cols, b.Stride)
}

# m's rows in runs of rows (the groups: sequences of T positions) and its columns in heads equal blocks (the
# members): matrix (s, h) is rows s rows ... s rows + rows - 1 and columns h w ... h w + w - 1, w = Cols / heads
fn (m Matrix<<T>>&) Heads(rows I64, heads I64) Batch<T> {
    assert rows > 0 and heads > 0 and m.Rows % rows == 0 and m.Cols % heads == 0
    w I64 = m.Cols / heads
    return Batch<T>(rows, w, m.Stride, m.Rows / rows, rows * m.Stride, heads, w, m.Data)
}

# m's rows in runs of rows, run r being matrix (r / members, r % members): attention's T x T matrices of every sequence and
# head, stacked. m.Stacked(m.Rows) is m alone, as a batch of one
fn (m Matrix<<T>>&) Stacked(rows I64, members I64 = 1) Batch<T> {
    assert rows > 0 and members > 0 and m.Rows % (rows * members) == 0
    return Batch<T>(rows, m.Cols, m.Stride, m.Rows / (rows * members), rows * members * m.Stride, members, rows * m.Stride, m.Data)
}

# which part of a product a triangle confines it to - causal attention, where position i of a sequence sees positions
# 0 .. i only, has both kinds: its scores S = Q K^T and their gradient dP = dO V^T are wanted below the diagonal only
# (Result), and its weights P, zero above the diagonal, are the left operand of Y = P V, dQ = dS K, dV = P^T dO and
# dK = dS^T Q (Left; the last two with transA). The diagonal is moved by GemmBatch's diagonal: d > 0 lets row i reach
# column i + d - queries d positions after the keys' first, as when decoding with a cache
type Triangular enum {
    None            # the whole product
    Result          # only c's lower triangle: c[i, j] for j <= i + d is computed, and the rest of c not touched -
                    # neither written nor scaled by beta (as MKL's gemmt). Tiles wholly above it are skipped
    Left            # a is lower-triangular: a[r, s] for s <= r + d is read, the rest taken as zero and never read - so
                    # op(a) is lower-triangular, or upper with transA (BLAS's trmm). The part of the depth a tile's rows
                    # read as zeros is skipped
}

# c[g, m] = alpha * op(a[g, m]) op(b[g, m]) + beta * c[g, m] for every matrix of the batches, which must have the same
# Groups and Members and fitting shapes - each product by Gemm's blocked algorithm, packed into ws. triangular confines
# every product to a triangle (above), saving about half the work. threads tasks take runs of the products, so the
# results do not depend on their number; a batch too small to be worth it stays on the calling thread. Causal attention, per batch of B sequences of T positions, D / heads columns
# a head (oann's layout: q, k, v and y n x D, the weights p (B heads T) x T):
#     ws.GemmBatch(p.Stacked(T, heads), q.Heads(T, heads), false, k.Heads(T, heads), true, scale, 0, Triangular.Result)
#     (the softmax of each row over its first i + 1 columns, then)
#     ws.GemmBatch(y.Heads(T, heads), p.Stacked(T, heads), false, v.Heads(T, heads), false, 1, 0, Triangular.Left)
fn GemmBatch(c Batch<<T>>&, a Batch<T>&, transA Bool, b Batch<T>&, transB Bool, alpha F64 = 1, beta F64 = 0, triangular Triangular = Triangular.None, diagonal I64 = 0, threads I64 = 1) {
    ws := GemmWorkspace<T>()
    ws.GemmBatch(c, a, transA, b, transB, alpha, beta, triangular, diagonal, threads)
}

fn (ws mut GemmWorkspace<<T>>&) GemmBatch(c Batch<T>&, a Batch<T>&, transA Bool, b Batch<T>&, transB Bool, alpha F64 = 1, beta F64 = 0, triangular Triangular = Triangular.None, diagonal I64 = 0, threads I64 = 1) {
    assert batchShape(c, a, transA, b, transB)
    like T
    al := Cast(alpha, like)
    be := Cast(beta, like)
    match T {
        case F16, BF16, F8E4M3, F8E5M2 { batchIn(c, a, transA, b, transB, al, be, triangular, diagonal, threads, ws, F32(0)) }
        nomatch { batchIn(c, a, transA, b, transB, al, be, triangular, diagonal, threads, ws, like) }
    }
}

fn batchShape(c Batch<<T>>&, a Batch<T>&, transA Bool, b Batch<T>&, transB Bool) Bool {
    am I64 = a.Cols if transA else a.Rows
    ak I64 = a.Rows if transA else a.Cols
    bk I64 = b.Cols if transB else b.Rows
    bn I64 = b.Rows if transB else b.Cols
    return c.Groups == a.Groups and c.Groups == b.Groups and c.Members == a.Members and c.Members == b.Members and ak == bk and
        c.Rows == am and c.Cols == bn
}

fn batchIn(c Batch<<T>>&, a Batch<T>&, transA Bool, b Batch<T>&, transB Bool, alpha T, beta T, tri Triangular, diag I64, threads I64, ws mut GemmWorkspace<T>&, z <A>) {
    m I64 = c.Rows
    n I64 = c.Cols
    k I64 = a.Rows if transA else a.Cols
    count I64 = c.Groups * c.Members
    if m == 0 or n == 0 or count == 0 { return }
    al := Cast(alpha, z)
    be := Cast(beta, z)
    ep := epilogue<T>(null, Activation.Identity, null, 0)
    if k == 0 {
        for e in range count {
            o I64 = e / c.Members
            i I64 = e - o * c.Members
            emptyProduct(m, n, be, c.Data[o * c.GroupStride + i * c.MemberStride:], c.Stride, ep, tri, diag)
        }
        return
    }
    mr := tileRows(z)
    thin, _ := tileChoice(m, n, mr, tileCols(z), vectorLanes(z), false)
    nr I64 = vectorLanes(z) if thin else tileCols(z)
    depthMax I64 = lesser(k, kc)
    bsize I64 = depthMax * lesser((n + nr - 1) / nr * nr, blockCols(z))
    asize I64 = depthMax * lesser((m + mr - 1) / mr * mr, blockRows(z))
    tasks I64 = lesser(threads, count)
    if count * m * n * k < 2000000 { tasks = 1 }
    bp := ws.panelB(tasks * bsize, z)
    ap := ws.panelsA(tasks * asize, z)
    share I64 = (count + tasks - 1) / tasks
    if tasks <= 1 {
        batchRun(0, count, c, a, transA, b, transB, m, n, k, al, be, ap, bp, thin, tri, diag, ep)
        return
    }
    join {
        for t in range tasks {
            lo I64 = t * share
            hi I64 = lesser(count, lo + share)
            if lo < hi { spawn batchRun(lo, hi, c, a, transA, b, transB, m, n, k, al, be, ap[t * asize:(t + 1) * asize], bp[t * bsize:(t + 1) * bsize], thin, tri, diag, ep) }
        }
    }
}

# products lo .. hi of the batches, in order, each on its own as gemmBlocks computes it on one thread
fn batchRun(lo I64, hi I64, c Batch<<T>>&, a Batch<T>&, transA Bool, b Batch<T>&, transB Bool, m I64, n I64, k I64, al <A>, be A, ap mut Array<A>&, bp mut Array<A>&, thin Bool, tri Triangular, diag I64, ep epilogue<T>&) {
    for e in range lo, hi {
        g I64 = e / c.Members
        h I64 = e - g * c.Members
        sa := operand<T>(a.Data[g * a.GroupStride + h * a.MemberStride:], a.Stride)
        sb := operand<T>(b.Data[g * b.GroupStride + h * b.MemberStride:], b.Stride)
        cd := c.Data[g * c.GroupStride + h * c.MemberStride:]
        if thin {
            gemmBlocks(m, n, k, sa, transA, sb, not transB, al, be, cd, c.Stride, m, ap, 0, bp, thinTile(), false, tri, diag, ep)
        } else {
            gemmBlocks(m, n, k, sa, transA, sb, not transB, al, be, cd, c.Stride, m, ap, 0, bp, wideTile(), false, tri, diag, ep)
        }
    }
}

# ---- convolutions: products of patches, never made ----

# the patch matrix of a two-dimensional convolution over images held as rows, channels last - image b is row b of
# images, H x W pixels of C channels, pixel (y, x) channel c at column (y W + x) C + c - as im2col would make it but
# never made: a row for every output position of every image, (b OutH + oy) OutW + ox, and a column for every input
# the kernel sees there, (c K + ky) K + kx (the order of PyTorch's Conv2d weights flattened), holding pixel
# (oy Stride - Pad + ky, ox Stride - Pad + kx) channel c of image b, or zero off the image. GemmPatches packs its
# panels straight from the images; Im2col makes the matrix
type Patches<T> struct(images Matrix<T>&, C I64, H I64, W I64, K I64, Stride I64 = 1, Pad I64 = 0) {
    Images Matrix<T>&images = images
    C
    H
    W
    K
    Stride
    Pad
    assert C > 0 and H > 0 and W > 0 and K > 0 and Stride > 0 and Pad >= 0 and images.Cols == H * W * C
    assert H + 2 * Pad >= K and W + 2 * Pad >= K
    OutH I64 = (H + 2 * Pad - K) / Stride + 1
    OutW I64 = (W + 2 * Pad - K) / Stride + 1
    Rows I64 = images.Rows * OutH * OutW
    Cols I64 = C * K * K
}

# the patch matrix made: cols, Rows x Cols, holds the patches - what GemmPatches reads without making it. Rows are split
# over threads tasks. A window inside the image is copied with no test per element: a kernel row's pixels at a time
# where the image has fewer channels than the kernel is wide (an image's first layer), a pixel's channels at a time
# otherwise
fn (x Patches<<T>>&) Im2col(cols Matrix<T>&, threads I64 = 1) {
    assert cols.Rows == x.Rows and cols.Cols == x.Cols
    ParallelRows(x.Rows, 256, threads, fn(lo, hi) { x.im2colRows(cols, lo, hi) })
}

# rows lo .. hi of the patch matrix into cols: with fewer channels than the kernel is wide, each row's inputs in order,
# their offset in the window kept as they go rather than as loops of the kernel's width - which LLVM would test for
# overlapping arrays each time round, for three elements - and a pixel's channels at a time otherwise
fn (x Patches<<T>>&) im2colRows(cols Matrix<T>&, lo I64, hi I64) {
    z T
    data := x.Images.Data
    out := cols.Data
    C, H, W, K, S, P := x.C, x.H, x.W, x.K, x.Stride, x.Pad
    ow, oh, per, ld, lc := x.OutW, x.OutH, x.OutH * x.OutW, x.Images.Stride, cols.Stride
    n I64 = C * K * K
    kk I64 = K * K
    hu U64 = U64(H)
    wu U64 = U64(W)
    img I64 = lo / per
    oy I64 = (lo - img * per) / ow
    ox I64 = lo - img * per - oy * ow
    for pos in range lo, hi {
        y0 I64 = oy * S - P
        x0 I64 = ox * S - P
        at I64 = img * ld + (y0 * W + x0) * C
        row I64 = pos * lc
        inside Bool = y0 >= 0 and y0 + K <= H and x0 >= 0 and x0 + K <= W
        if C >= K {
            # a pixel's channels at a time: a run of C read, written K K apart
            for ky in range K {
                for kx in range K {
                    w I64 = row + ky * K + kx
                    if inside or (U64(y0 + ky) < hu and U64(x0 + kx) < wu) {
                        s I64 = at + (ky * W + kx) * C
                        for c in range C { out[w + c * kk] = data[s + c] }
                    } else {
                        for c in range C { out[w + c * kk] = z }
                    }
                }
            }
        } else {
            # the inputs in order, a pixel's channels apart along a kernel row
            c, ky, kx, off I64 = 0, 0, 0, 0
            for i in range n {
                v T = z
                if inside or (U64(y0 + ky) < hu and U64(x0 + kx) < wu) { v = data[at + off] }
                out[row + i] = v
                kx++
                off = off + C
                if kx == K {
                    kx = 0
                    ky++
                    off = off + (W - K) * C
                    if ky == K {
                        ky = 0
                        c++
                        off = c
                    }
                }
            }
        }
        ox++
        if ox == ow {
            ox = 0
            oy++
            if oy == oh {
                oy = 0
                img++
            }
        }
    }
}

# c = act(alpha * p op(b) + beta * c + bias), p a convolution's patch matrix: a convolution of p's images by the
# weights b (OutC x C K K, transB) - c's rows being the images' output pixels, OutC wide, channels last again - with its
# bias and activation, the patches packed from the images as the product needs them and never made. bias, act and
# pre as GemmAct's
fn GemmPatches(c Matrix<<T>>&, p Patches<T>&, b Matrix<T>&, transB Bool, bias Matrix<T>&, act Activation, alpha F64 = 1, beta F64 = 0, threads I64 = 1, pre Matrix<T>& = null) {
    ws := GemmWorkspace<T>()
    ws.GemmPatches(c, p, b, transB, bias, act, alpha, beta, threads, pre)
}

fn (ws mut GemmWorkspace<<T>>&) GemmPatches(c Matrix<T>&, p Patches<T>&, b Matrix<T>&, transB Bool, bias Matrix<T>&, act Activation, alpha F64 = 1, beta F64 = 0, threads I64 = 1, pre Matrix<T>& = null) {
    bk I64 = b.Cols if transB else b.Rows
    bn I64 = b.Rows if transB else b.Cols
    assert c.Rows == p.Rows and bk == p.Cols and c.Cols == bn
    ep := epilogueOf(c, bias, act, pre)
    product(c.Rows, c.Cols, p.Cols, p, false, operand<T>(b.Data, b.Stride), transB, alpha, beta, c.Data, c.Stride, threads, ws, ep)
}

# a = alpha * x y^T + beta * a, for vectors x (a.Rows elements) and y (a.Cols): a rank-1 update (BLAS's ger, which
# accumulates - beta 1 - as these do unless told otherwise) - a local learning rule's outer product, in one pass with
# no temporary; beta = 0 never reads a, and beta below 1 decays what is there
fn Ger(a Matrix<<T>>&, x Array<T>&, y Array<T>&, alpha F64 = 1, beta F64 = 1) {
    assert x.Len() == a.Rows and y.Len() == a.Cols
    like T
    al := Cast(alpha, like)
    be := Cast(beta, like)
    for r in range a.Rows {
        d I64 = r * a.Stride
        xr T = al * x[r]
        if beta == 0.0 {
            for c in range a.Cols { a.Data[d + c] = xr * y[c] }
        } else if beta == 1.0 {
            for c in range a.Cols { a.Data[d + c] = a.Data[d + c] + xr * y[c] }
        } else {
            for c in range a.Cols { a.Data[d + c] = be * a.Data[d + c] + xr * y[c] }
        }
    }
}

# a = alpha * (x1 y1^T + x2 y2^T) + beta * a: a decayed rank-2 update in one pass - an eligibility trace, say
fn Ger2(a Matrix<<T>>&, x1 Array<T>&, y1 Array<T>&, x2 Array<T>&, y2 Array<T>&, alpha F64 = 1, beta F64 = 1) {
    assert x1.Len() == a.Rows and x2.Len() == a.Rows and y1.Len() == a.Cols and y2.Len() == a.Cols
    like T
    al := Cast(alpha, like)
    be := Cast(beta, like)
    for r in range a.Rows {
        d I64 = r * a.Stride
        p T = al * x1[r]
        q T = al * x2[r]
        for c in range a.Cols { a.Data[d + c] = be * a.Data[d + c] + (p * y1[c] + q * y2[c]) }
    }
}

# a @ b, the matrix product - b a matrix, or a transposed one (a @ b.T() is A B^T)
fn (a Matrix<<T>>&) MatMul(b <U>) Matrix<T> {
    match U {
        case Matrix<T>, Matrix<T>& {
            out Matrix<T>&return = Matrix<T>(a.Rows, b.Cols, null)
            Gemm(out, a, false, b, false)
            return out
        }
        case Transposed<T>, Transposed<T>& {
            out Matrix<T>&return = Matrix<T>(a.Rows, b.M.Rows, null)
            Gemm(out, a, false, b.M, true)
            return out
        }
    }
}

# a.T() @ b, A^T B, and a.T() @ b.T()
fn (a Transposed<<T>>&) MatMul(b <U>) Matrix<T> {
    match U {
        case Matrix<T>, Matrix<T>& {
            out Matrix<T>&return = Matrix<T>(a.M.Cols, b.Cols, null)
            Gemm(out, a.M, true, b, false)
            return out
        }
        case Transposed<T>, Transposed<T>& {
            out Matrix<T>&return = Matrix<T>(a.M.Cols, b.M.Rows, null)
            Gemm(out, a.M, true, b.M, true)
            return out
        }
    }
}

# what try (a @ b) calls: ShapeError.MISMATCH where the inner dimensions differ
fn (a Matrix<<T>>&) TryMatMul(b <U>) Matrix<T> ? ShapeError {
    match U {
        case Matrix<T>, Matrix<T>& { if a.Cols != b.Rows { error ShapeError.MISMATCH } }
        case Transposed<T>, Transposed<T>& { if a.Cols != b.M.Cols { error ShapeError.MISMATCH } }
    }
    return a @ b
}

fn (a Transposed<<T>>&) TryMatMul(b <U>) Matrix<T> ? ShapeError {
    match U {
        case Matrix<T>, Matrix<T>& { if a.M.Rows != b.Rows { error ShapeError.MISMATCH } }
        case Transposed<T>, Transposed<T>& { if a.M.Rows != b.M.Cols { error ShapeError.MISMATCH } }
    }
    return a @ b
}

# x y^T for two vectors: an x.Len() x y.Len() matrix
fn Outer(x Array<<T>>&, y Array<T>&) Matrix<T> {
    out Matrix<T>&return = Matrix<T>(x.Len(), y.Len(), null)
    for r in range x.Len() {
        xr := x[r]
        d I64 = r * out.Stride
        for c in range y.Len() { out.Data[d + c] = xr * y[c] }
    }
    return out
}

# ---- reductions ----
#
# A sum runs in the accumulation type (F32 for F16, BF16 and the F8 types, the element type otherwise) and in eight
# lanes - eight partial sums, combined pairwise at the end - which is what lets it run in vector registers, since
# floating-point addition may not be reordered behind the program's back; the lanes also keep the rounding error of a
# long sum near that of pairwise summation. The order is fixed, so a sum is the same on every run.

type lanes<A> struct() {
    v Array<A, 16>
}

# the eight lanes added up pairwise. The loops filling lanes read and write them only at constant positions, which
# lets them live in vector registers; here they are first copied out in order into a second set, kept in memory, which
# is what makes the vectorizer group them four or eight to a register by position (with no copy it pairs them two to
# a register)
fn (l lanes<<A>>&) total() A {
    out := lanes<A>()
    for i in range 8 { out.v[i] = l.v[i] }
    return out.sum(8)
}

fn (l mut lanes<<A>>&) sum(n I64) A {
    h I64 = n / 2
    for h >= 1 {
        for i in range h { l.v[i] = l.v[i] + l.v[i + h] }
        h = h / 2
    }
    return l.v[0]
}

# the sum of x[from .. from + n] - the one loop every sum is: lane j takes elements j, j + 8, ...
fn sumRun(x Array<<T>>&, from I64, n I64, z <A>) A {
    acc := lanes<A>()
    whole I64 = n - n % 8
    for i in range 0, whole, 8 {
        for j in range 8 { acc.v[j] = acc.v[j] + Cast(x[from + i + j], z) }
    }
    rest A = z
    for i in range whole, n { rest = rest + Cast(x[from + i], z) }
    return acc.total() + rest
}

# the sum of x[i] * y[i] over a run, in the same lanes
fn dotRun(x Array<<T>>&, xf I64, y Array<T>&, yf I64, n I64, z <A>) A {
    acc := lanes<A>()
    whole I64 = n - n % 8
    for i in range 0, whole, 8 {
        for j in range 8 { acc.v[j] = mulAdd(Cast(x[xf + i + j], z), Cast(y[yf + i + j], z), acc.v[j]) }
    }
    rest A = z
    for i in range whole, n { rest = mulAdd(Cast(x[xf + i], z), Cast(y[yf + i], z), rest) }
    return acc.total() + rest
}

fn sumIn(m Matrix<<T>>&, z <A>) A {
    if m.Contiguous() { return sumRun(m.Data, 0, m.Rows * m.Cols, z) }
    s A = z
    for r in range m.Rows { s = s + sumRun(m.Data, r * m.Stride, m.Cols, z) }
    return s
}

fn dotIn(a Matrix<<T>>&, b Matrix<T>&, z <A>) A {
    if a.Contiguous() and b.Contiguous() { return dotRun(a.Data, 0, b.Data, 0, a.Rows * a.Cols, z) }
    s A = z
    for r in range a.Rows { s = s + dotRun(a.Data, r * a.Stride, b.Data, r * b.Stride, a.Cols, z) }
    return s
}

# the sum of every element
fn (m Matrix<<T>>&) Sum() T {
    like T
    return match T {
        case F16, BF16, F8E4M3, F8E5M2 => Cast(sumIn(m, F32(0)), like)
        nomatch => sumIn(m, like)
    }
}

# the mean of every element - for a float matrix
fn (m Matrix<<T>>&) Mean() T {
    like T
    return match T {
        case F16, BF16, F8E4M3, F8E5M2 => Cast(sumIn(m, F32(0)) / F32(m.Rows * m.Cols), like)
        nomatch => sumIn(m, like) / Cast(m.Rows * m.Cols, like)
    }
}

# the sum of the products of corresponding elements - the Frobenius inner product; two vectors' dot product when
# both are one row
fn (a Matrix<<T>>&) Dot(b Matrix<T>&) T {
    assert sameShape(a, b)
    like T
    return match T {
        case F16, BF16, F8E4M3, F8E5M2 => Cast(dotIn(a, b, F32(0)), like)
        nomatch => dotIn(a, b, like)
    }
}

# the Frobenius norm: the square root of the sum of the squares - for a float matrix
fn (m Matrix<<T>>&) Norm() T {
    like T
    return match T {
        case F16, BF16, F8E4M3, F8E5M2 => Cast(math.Sqrt(dotIn(m, m, F32(0))), like)
        nomatch => math.Sqrt(dotIn(m, m, like))
    }
}

# the Euclidean distance between a and b - the norm of a - b, with no difference made: a residual's size
fn (a Matrix<<T>>&) Distance(b Matrix<T>&) T {
    assert sameShape(a, b)
    like T
    return match T {
        case F16, BF16, F8E4M3, F8E5M2 => Cast(math.Sqrt(distanceIn(a, b, F32(0))), like)
        nomatch => math.Sqrt(distanceIn(a, b, like))
    }
}

fn distanceIn(a Matrix<<T>>&, b Matrix<T>&, z <A>) A {
    s A = z
    for r in range a.Rows {
        acc := lanes<A>()
        x I64 = r * a.Stride
        y I64 = r * b.Stride
        whole I64 = a.Cols - a.Cols % 8
        for i in range 0, whole, 8 {
            for j in range 8 {
                e A = Cast(a.Data[x + i + j], z) - Cast(b.Data[y + i + j], z)
                acc.v[j] = acc.v[j] + e * e
            }
        }
        rest A = z
        for i in range whole, a.Cols {
            e A = Cast(a.Data[x + i], z) - Cast(b.Data[y + i], z)
            rest = rest + e * e
        }
        s = s + acc.total() + rest
    }
    return s
}

# the largest absolute difference between corresponding elements - a residual's size in the max norm, with no
# difference made; a NaN if either holds one
fn (a Matrix<<T>>&) MaxAbsDifference(b Matrix<T>&) T {
    assert sameShape(a, b)
    z T
    best T = z
    for r in range a.Rows {
        x I64 = r * a.Stride
        y I64 = r * b.Stride
        for c in range a.Cols { best = math.Max(best, math.Abs(a.Data[x + c] - b.Data[y + c])) }
    }
    return best
}

# the largest absolute value of an element - the max norm; 0 for an empty matrix
fn (m Matrix<<T>>&) MaxAbs() T {
    z T
    best T = z
    for r in range m.Rows {
        d I64 = r * m.Stride
        for c in range m.Cols { best = math.Max(best, math.Abs(m.Data[d + c])) }
    }
    return best
}

# the largest element, and the smallest - a NaN if any element is one (std/math's Max and Min); for a matrix with
# at least one element
fn (m Matrix<<T>>&) Max() T {
    best T = m.Data[0]
    for r in range m.Rows {
        d I64 = r * m.Stride
        for c in range m.Cols { best = math.Max(best, m.Data[d + c]) }
    }
    return best
}

fn (m Matrix<<T>>&) Min() T {
    best T = m.Data[0]
    for r in range m.Rows {
        d I64 = r * m.Stride
        for c in range m.Cols { best = math.Min(best, m.Data[d + c]) }
    }
    return best
}

# out[r] = the sum of row r, for every row: out has Rows elements
fn (m Matrix<<T>>&) RowSums(out mut Array<T>&) {
    assert out.Len() == m.Rows
    match T {
        case F16, BF16, F8E4M3, F8E5M2 { rowSumsIn(m, out, F32(0)) }
        nomatch {
            z T
            rowSumsIn(m, out, z)
        }
    }
}

fn rowSumsIn(m Matrix<<T>>&, out mut Array<T>&, z <A>) {
    like T
    for r in range m.Rows { out[r] = Cast(sumRun(m.Data, r * m.Stride, m.Cols, z), like) }
}

# out[r] = the largest absolute value in row r - each row's max norm (a residual's, per row)
fn (m Matrix<<T>>&) RowMaxAbs(out mut Array<T>&) {
    assert out.Len() == m.Rows
    z T
    for r in range m.Rows {
        d I64 = r * m.Stride
        best T = z
        for c in range m.Cols { best = math.Max(best, math.Abs(m.Data[d + c])) }
        out[r] = best
    }
}

# out[r] = the sum of the absolute values in row r
fn (m Matrix<<T>>&) RowAbsSums(out mut Array<T>&) {
    assert out.Len() == m.Rows
    match T {
        case F16, BF16, F8E4M3, F8E5M2 { rowAbsSumsIn(m, out, F32(0)) }
        nomatch {
            z T
            rowAbsSumsIn(m, out, z)
        }
    }
}

fn rowAbsSumsIn(m Matrix<<T>>&, out mut Array<T>&, z <A>) {
    like T
    for r in range m.Rows {
        acc := lanes<A>()
        d I64 = r * m.Stride
        whole I64 = m.Cols - m.Cols % 8
        for i in range 0, whole, 8 {
            for j in range 8 { acc.v[j] = acc.v[j] + math.Abs(Cast(m.Data[d + i + j], z)) }
        }
        rest A = z
        for i in range whole, m.Cols { rest = rest + math.Abs(Cast(m.Data[d + i], z)) }
        out[r] = Cast(acc.total() + rest, like)
    }
}

# out[r] = the Euclidean norm of row r
fn (m Matrix<<T>>&) RowNorms(out mut Array<T>&) {
    assert out.Len() == m.Rows
    like T
    match T {
        case F16, BF16, F8E4M3, F8E5M2 {
            for r in range m.Rows { out[r] = Cast(math.Sqrt(dotRun(m.Data, r * m.Stride, m.Data, r * m.Stride, m.Cols, F32(0))), like) }
        }
        nomatch {
            for r in range m.Rows { out[r] = math.Sqrt(dotRun(m.Data, r * m.Stride, m.Data, r * m.Stride, m.Cols, like)) }
        }
    }
}

# every row divided by its Euclidean norm, in place; a row of zeros stays zeros
fn (m Matrix<<T>>&) NormalizeRows() {
    like T
    for r in range m.Rows {
        d I64 = r * m.Stride
        n T = math.Sqrt(dotRun(m.Data, d, m.Data, d, m.Cols, like))
        if n == like { continue }
        inv T = 1.0 / n
        for c in range m.Cols { m.Data[d + c] = m.Data[d + c] * inv }
    }
}

# dst's row r = the softmax of src's row r over temperature: exp((x - max) / t) normalised to sum 1, row by row - the
# policy over a block of columns (src a ColRange view), one pass to the maximum and one to the exponentials. dst may
# be src
fn (dst Matrix<<T>>&) RowSoftmax(src Matrix<T>&, temperature T) {
    assert sameShape(dst, src)
    like T
    inv T = 1.0 / temperature
    for r in range src.Rows {
        s I64 = r * src.Stride
        d I64 = r * dst.Stride
        top T = src.Data[s]
        for c in range 1, src.Cols { top = math.Max(top, src.Data[s + c]) }
        total T = like
        for c in range src.Cols {
            e T = math.Exp((src.Data[s + c] - top) * inv)
            dst.Data[d + c] = e
            total = total + e
        }
        scale T = 1.0 / total
        for c in range dst.Cols { dst.Data[d + c] = dst.Data[d + c] * scale }
    }
}

# out[r] = the largest element of row r - a NaN if the row holds one
fn (m Matrix<<T>>&) RowMax(out mut Array<T>&) {
    assert out.Len() == m.Rows
    for r in range m.Rows {
        d I64 = r * m.Stride
        best T = m.Data[d]
        for c in range 1, m.Cols { best = math.Max(best, m.Data[d + c]) }
        out[r] = best
    }
}

# out[r] = the column of row r's largest element, the first one where several are equal, and the first NaN where
# the row holds one - each row's class, for a matrix of scores
fn (m Matrix<<T>>&) ArgMaxRows(out mut Array<I32>&) {
    assert out.Len() == m.Rows
    for r in range m.Rows {
        d I64 = r * m.Stride
        at I64 = 0
        best T = m.Data[d]
        for c in range 1, m.Cols {
            if best != best { break }
            x := m.Data[d + c]
            if x > best or x != x {
                best = x
                at = c
            }
        }
        out[r] = I32(at)
    }
}

# out (1 x Cols) = the sums of m's columns + beta * out: a bias's gradient, summed over the batch. Sixty-four columns
# at a time, every row added into lanes held on the stack, so nothing is allocated and the adds are vector adds
fn (m Matrix<<T>>&) ColumnSums(out Matrix<T>&, beta F64 = 0) {
    assert rowShape(m, out)
    match T {
        case F16, BF16, F8E4M3, F8E5M2 { columnSumsIn(m, out, beta, F32(0)) }
        nomatch {
            z T
            columnSumsIn(m, out, beta, z)
        }
    }
}

type colLanes<A> struct(z A) {
    v Array<A, 64>
}

fn columnSumsIn(m Matrix<<T>>&, out Matrix<T>&, beta F64, z <A>) {
    like T
    b := Cast(beta, z)
    acc := colLanes<A>(z)
    for c0 in range 0, m.Cols, 64 {
        w I64 = lesser(64, m.Cols - c0)
        for j in range 64 { acc.v[j] = z }
        for r in range m.Rows {
            d I64 = r * m.Stride + c0
            for j in range w { acc.v[j] = acc.v[j] + Cast(m.Data[d + j], z) }
        }
        for j in range w {
            s A = acc.v[j]
            if beta != 0.0 { s = s + b * Cast(out.Data[c0 + j], z) }
            out.Data[c0 + j] = Cast(s, like)
        }
    }
}

# ---- activations that vectorize ----
#
# std/math's Exp and Tanh are the C library's (X8): within about an ulp and the same while compiling, but a call per
# element, so a loop over them does not vectorize. These are written in olang from arithmetic and bit operations
# only, so a Map with one of them inlined runs in vector registers - in F32, 14 instructions an element for FastExp
# and 17 for FastTanh, against the C library's 39 for exp and 129 for tanh. Each is generic over F32 and F64 and
# computed in its own type. Their errors, measured against the C library at two million points spread over
# [-100, 100]: FastExp's relative error under 3e-7 in F32 and 6e-16 in F64 (about 2.5 ulp); FastTanh's and
# FastSigmoid's absolute error under 2e-7 in F32 and 3e-16 in F64 (near zero FastTanh's relative error is larger).
# Beyond the range of the type FastExp gives infinity or zero (a result below the smallest normal number is zero), a
# NaN gives a NaN, and the others saturate to their limits.

# e to the power x: x = k ln 2 + r with |r| <= ln 2 / 2, e^r by its Taylor series (to r^6 in F32, r^12 in F64), and
# 2^k made from its bits
fn FastExp(x <T>) T {
    return match T {
        case F32 => fastExp32(x)
        case F64 => fastExp64(x)
    }
}

fn fastExp32(x F32) F32 {
    t F32 = x if x > -87.33654 else -87.33654
    t = t if t < 88.72283 else 88.72283
    # k, the nearest whole number to t / ln 2, by adding 1.5 * 2^23 (whose last bits then hold k) and taking it away
    kb F32 = t * 1.44269504 + 12582912.0
    k F32 = kb - 12582912.0
    ki U32 = kb.Bits() - U32(0x4B400000)
    r F32 = t - k * 0.693145751953125 - k * 1.428606765330187e-06
    p F32 = 1.0 + r * (1.0 + r * (0.5 + r * (0.16666667 + r * (0.041666668 + r * (0.008333334 + r * 0.0013888889)))))
    # 2^k from its bits - as 2^(k - 1) * 2 for k > 0, so that 2^128 never has to be made
    up Bool = k > 0.0
    scale F32 = ((ki - (U32(1) if up else U32(0)) + 127) << 23).F32FromBits()
    two F32 = 2.0 if up else 1.0
    e F32 = p * scale * two
    e = e if x < 88.72283 else infinity32
    e = e if x > -87.33654 else 0.0
    return e if x == x else x
}

fn fastExp64(x F64) F64 {
    t F64 = x if x > -708.3964185322641 else -708.3964185322641
    t = t if t < 709.782712893384 else 709.782712893384
    kb F64 = t * 1.4426950408889634 + 6755399441055744.0        # 1.5 * 2^52
    k F64 = kb - 6755399441055744.0
    ki U64 = kb.Bits() - U64(0x4338000000000000)
    r F64 = t - k * 0.6931471803691238 - k * 1.9082149292705877e-10
    p F64 = 1.0 + r * (1.0 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333
        + r * (0.001388888888888889 + r * (1.984126984126984e-4 + r * (2.48015873015873e-5 + r * (2.7557319223985893e-6
        + r * (2.755731922398589e-7 + r * (2.505210838544172e-8 + r * 2.08767569878681e-9)))))))))))
    up Bool = k > 0.0
    scale F64 = ((ki - (U64(1) if up else U64(0)) + 1023) << 52).F64FromBits()
    e F64 = p * scale * (2.0 if up else 1.0)
    e = e if x < 709.782712893384 else math.Inf
    e = e if x > -708.3964185322641 else 0.0
    return e if x == x else x
}

infinity32 F32 = F32(math.Inf)

# the hyperbolic tangent: 1 - 2 / (e^(2|x|) + 1), with x's sign. |x| is held below the point past which tanh rounds
# to 1 in the type (10 in F32, 20 in F64), so that e^(2|x|) stays finite; a NaN is not held and gives a NaN
fn FastTanh(x <T>) T {
    a T = math.Abs(x)
    limit T = match T {
        case F32 => 10.0
        case F64 => 20.0
    }
    a = limit if a > limit else a
    v T = 1.0 - 2.0 / (FastExp(a + a) + 1.0)
    return math.CopySign(v, x)
}

# the logistic function 1 / (1 + e^-x)
fn FastSigmoid(x <T>) T {
    return 1.0 / (1.0 + FastExp(-x))
}

# ---- conversions between element types ----

# dst = src with every element converted to dst's element type, rounded or wrapped as a conversion does (T4)
fn (dst Matrix<<T>>&) Convert(src Matrix<<S>>&) {
    assert sameShape(dst, src)
    like T
    for r in range dst.Rows {
        d I64 = r * dst.Stride
        s I64 = r * src.Stride
        for c in range dst.Cols { dst.Data[d + c] = Cast(src.Data[s + c], like) }
    }
}

# the matrix with its elements converted, into a new matrix
fn (m Matrix<<T>>&) ToF64() Matrix<F64> {
    out Matrix<F64>&return = Matrix<F64>(m.Rows, m.Cols, null)
    out.Convert(m)
    return out
}

fn (m Matrix<<T>>&) ToF32() Matrix<F32> {
    out Matrix<F32>&return = Matrix<F32>(m.Rows, m.Cols, null)
    out.Convert(m)
    return out
}

fn (m Matrix<<T>>&) ToF16() Matrix<F16> {
    out Matrix<F16>&return = Matrix<F16>(m.Rows, m.Cols, null)
    out.Convert(m)
    return out
}

fn (m Matrix<<T>>&) ToBF16() Matrix<BF16> {
    out Matrix<BF16>&return = Matrix<BF16>(m.Rows, m.Cols, null)
    out.Convert(m)
    return out
}

# ---- random fills, from the caller's generator (std/rand), so that one seed decides a whole run ----

# every element drawn uniformly from [lo, hi), in row order
fn (m Matrix<<T>>&) FillUniform(r mut rand.Rand&, lo F64, hi F64) {
    like T
    for i in range m.Rows {
        d I64 = i * m.Stride
        for c in range m.Cols { m.Data[d + c] = Cast(r.Uniform(lo, hi), like) }
    }
}

# every element drawn from the normal distribution with this mean and standard deviation, in row order
fn (m Matrix<<T>>&) FillNormal(r mut rand.Rand&, mean F64, sd F64) {
    like T
    for i in range m.Rows {
        d I64 = i * m.Stride
        for c in range m.Cols { m.Data[d + c] = Cast(mean + sd * r.Normal(), like) }
    }
}

# out (1 x Cols) = the sums of the absolute values of m's columns
fn (m Matrix<<T>>&) ColumnAbsSums(out Matrix<T>&) {
    assert rowShape(m, out)
    z T
    out.Fill(z)
    for r in range m.Rows {
        d I64 = r * m.Stride
        for c in range m.Cols { out.Data[c] = out.Data[c] + math.Abs(m.Data[d + c]) }
    }
}

# every element 1 with probability p and 0 otherwise: a connectivity mask, or dropout's
fn (m Matrix<<T>>&) FillBernoulli(r mut rand.Rand&, p F64) {
    like T
    one := Cast(1.0, like)
    for i in range m.Rows {
        d I64 = i * m.Stride
        for c in range m.Cols { m.Data[d + c] = one if r.Float() < p else like }
    }
}

# every element +scale or -scale with equal probability: random signs, for a random projection or a feedback matrix
fn (m Matrix<<T>>&) FillSigns(r mut rand.Rand&, scale F64 = 1) {
    like T
    up := Cast(scale, like)
    down := Cast(-scale, like)
    for i in range m.Rows {
        d I64 = i * m.Stride
        for c in range m.Cols { m.Data[d + c] = up if r.Next() >> 63 == 1 else down }
    }
}

# ---- threads ----

# runs body over 0 .. rows split into consecutive runs, one task each, in parallel: body(lo, hi) for each run. Runs
# are at least grain rows (fewer when there are fewer rows), at most threads of them; when there would be one, body
# runs on the calling thread with no task at all. The runs do not overlap and cover every row once, so a body writing
# only its own rows needs no synchronisation
fn ParallelRows(rows I64, grain I64, threads I64, body fn(lo I64, hi I64)) {
    tasks I64 = lesser(threads, rows / (grain if grain > 0 else 1))
    if tasks <= 1 {
        body(0, rows)
        return
    }
    share I64 = (rows + tasks - 1) / tasks
    join {
        for t in range tasks {
            lo I64 = t * share
            hi I64 = lesser(rows, lo + share)
            if lo < hi { spawn body(lo, hi) }
        }
    }
}

# ---- rendering and equality ----

# the elements as rows of brackets, as numpy prints an array:
#   [[1, 2, 3],
#    [4, 5, 6]]
# with only the first and last three rows, and columns, of a dimension longer than ten (the rest as "...")
fn (m Matrix<<T>>&) Str() String {
    b := StringBuilder()
    b.PushChar('[')
    for r in range m.Rows {
        if m.Rows > 10 and r >= 3 and r < m.Rows - 3 {
            if r == 3 { b.Push(",\n ...") }
            continue
        }
        if r > 0 { b.Push(",\n ") }
        b.PushChar('[')
        for c in range m.Cols {
            if m.Cols > 10 and c == 3 { b.Push(", ...") }
            if m.Cols > 10 and c >= 3 and c < m.Cols - 3 { continue }
            if c > 0 { b.Push(", ") }
            b.Push($m.Data[r * m.Stride + c])
        }
        b.PushChar(']')
    }
    b.PushChar(']')
    return b.ToString()
}

# the same shape and equal elements, compared as "==" compares them - so a matrix holding a NaN is equal to nothing
fn (a Matrix<<T>>&) Eq(b Matrix<T>&) Bool {
    if not sameShape(a, b) { return false }
    for r in range a.Rows {
        x I64 = r * a.Stride
        y I64 = r * b.Stride
        for c in range a.Cols {
            if a.Data[x + c] != b.Data[y + c] { return false }
        }
    }
    return true
}

# agrees with Eq: the shape and every element - a float by its bits, with -0 taken as 0, since the two are equal
fn (m Matrix<<T>>&) Hash() I64 {
    h I64 = m.Rows * 1099511628211 + m.Cols
    for r in range m.Rows {
        d I64 = r * m.Stride
        for c in range m.Cols { h = h * 1099511628211 + elementHash(m.Data[d + c]) }
    }
    return h
}

fn elementHash(x <T>) I64 {
    return match T {
        case F64 => 0 if x == 0 else I64(x.Bits())
        case F32, F16, BF16 => 0 if x == 0 else I64(x.Bits())
        case F8E4M3, F8E5M2 => 0 if x.F64() == 0 else I64(x.Bits)
        nomatch => x.Hash()
    }
}

# ---- linear systems ----

# the x with a x = b, for a square a and any number of right-hand sides (b's columns), by LU decomposition with
# partial pivoting (Gaussian elimination choosing the largest pivot in each column) - for a float matrix. A pivot of
# zero means a has no inverse: SolveError.SINGULAR. a and b are not changed
fn Solve(a Matrix<<T>>&, b Matrix<T>&) Matrix<T> ? SolveError {
    assert a.Rows == a.Cols and b.Rows == a.Rows
    x Matrix<T>&return = Matrix<T>(b.Rows, b.Cols, null)
    x.Copy(b)
    lu := a.Clone()
    try solveInPlace(lu, x)
    return x
}

# the inverse of a square float matrix: Solve with the identity
fn (a Matrix<<T>>&) Inverse() Matrix<T> ? SolveError {
    assert a.Rows == a.Cols
    x Matrix<T>&return = Matrix<T>(a.Rows, a.Rows, null)
    x.SetIdentity()
    lu := a.Clone()
    try solveInPlace(lu, x)
    return x
}

# x = lu^-1 x, overwriting lu with its LU factors and x with the solution
fn solveInPlace(lu Matrix<<T>>&, x Matrix<T>&) ? SolveError {
    n I64 = lu.Rows
    for k in range n {
        p I64 = k
        for i in range k + 1, n {
            if math.Abs(lu.Get(i, k)) > math.Abs(lu.Get(p, k)) { p = i }
        }
        if lu.Get(p, k) == 0 { error SolveError.SINGULAR }
        if p != k {
            swapRows(lu, p, k)
            swapRows(x, p, k)
        }
        pivot := lu.Get(k, k)
        kr := lu.Row(k)
        xk := x.Row(k)
        for i in range k + 1, n {
            f T = lu.Get(i, k) / pivot
            if f == 0 { continue }
            lr := lu.Row(i)
            for j in range k + 1, n { lr[j] = lr[j] - f * kr[j] }
            xi := x.Row(i)
            for j in range x.Cols { xi[j] = xi[j] - f * xk[j] }
        }
    }
    # back substitution, the last row first
    i I64 = n - 1
    for i >= 0 {
        xi := x.Row(i)
        li := lu.Row(i)
        for k in range i + 1, n {
            xk := x.Row(k)
            for j in range x.Cols { xi[j] = xi[j] - li[k] * xk[j] }
        }
        for j in range x.Cols { xi[j] = xi[j] / li[i] }
        i--
    }
}

fn swapRows(m Matrix<<T>>&, p I64, q I64) {
    rp := m.Row(p)
    rq := m.Row(q)
    for j in range m.Cols { rp[j], rq[j] = rq[j], rp[j] }
}

# ---- tests ----
#
# under TestBuild, so that a program importing this module compiles none of it
if TestBuild {

    # a matrix of the numbers from start, one apart, in row order
    fn counting(rows I64, cols I64, start F64) Matrix<F64> {
        m Matrix<F64>&return = Matrix<F64>(rows, cols, null)
        for i in range rows * cols { m.Data[i] = start + F64(i) }
        return m
    }

    # op(a) op(b) the plain way, for checking Gemm: element (i, j) a sum in order over p
    fn referenceProduct(a Matrix<<T>>&, transA Bool, b Matrix<T>&, transB Bool) Matrix<F64> {
        m I64 = a.Cols if transA else a.Rows
        k I64 = a.Rows if transA else a.Cols
        n I64 = b.Rows if transB else b.Cols
        out Matrix<F64>&return = Matrix<F64>(m, n, null)
        for i in range m {
            for j in range n {
                s F64 = 0.0
                for p in range k {
                    x F64 = F64(a.Get(p, i) if transA else a.Get(i, p))
                    y F64 = F64(b.Get(j, p) if transB else b.Get(p, j))
                    s += x * y
                }
                out.Set(i, j, s)
            }
        }
        return out
    }

    # the small computations below are made while compiling (K2): views, element kernels, reductions and rendering are
    # all evaluable, so these globals are data in the program - and each is checked against the same computation at run
    # time in a test
    fn smallSum() F64 {
        a := counting(3, 4, 1.0)
        b := a.ColRange(1, 3)
        c := b + b
        c.AddRow(Full(1, 2, 0.5))
        return c.Sum()
    }
    bakedSmallSum F64 = smallSum()
    bakedRendered String& = $counting(2, 3, 0.0)
    fn solvedSmall() F64 {
        x := try Solve(counting(2, 2, 1.0), Full(2, 1, 1.0)) catch SolveError { return -1.0 }
        return x.Get(1, 0)
    }
    bakedSolved F64 = solvedSmall()

    test "the compile-time values are the run time's" {
        assert bakedSmallSum == smallSum() and bakedSmallSum == 81.0
        assert bakedRendered == $counting(2, 3, 0.0) and bakedRendered == "[[0, 1, 2],\n [3, 4, 5]]"
        assert bakedSolved == solvedSmall() and bakedSolved == 1.0
    }

    # B12c: (1 + 2^-12)^2 needs 25 bits, so the second step of this product - [1, x] times [-(1 + 2^-11), x] - leaves
    # 2^-24 where the multiply-add is fused and 0 where its product is rounded first. one is read from a mutable global
    # at run time, so that product is the running program's, while one written as a literal is computed while compiling
    fusedOne mut F32 = 1.0

    fn fusedProduct(one F32) F32 {
        x F32 = one + one / 4096.0
        a := Matrix<F32>(1, 2)
        b := Matrix<F32>(2, 1)
        a.Set(0, 0, one)
        a.Set(0, 1, x)
        b.Set(0, 0, -(one + one / 2048.0))
        b.Set(1, 0, x)
        c := Matrix<F32>(1, 1)
        Gemm(c, a, false, b, false)
        return c.Get(0, 0)
    }

    test "a product's multiply-adds are fused exactly where the target has fused multiply-add" {
        want F32 = 1.0 / 16777216.0 if TargetHasFma else 0.0
        assert fusedProduct(1.0) == want
        assert fusedProduct(fusedOne) == want
    }

    test "a new matrix is zeros; a view shares its storage, and writing it writes the matrix" {
        m := Matrix<F32>(3, 4)
        assert m.Rows == 3 and m.Cols == 4 and m.Stride == 4 and m.Sum() == 0.0 and m.Contiguous()
        for i in range 12 { m.Data[i] = F32(i) }
        rows := m.RowRange(1, 3)
        assert rows.Rows == 2 and rows.Get(0, 0) == 4.0 and rows.Contiguous()
        cols := m.ColRange(1, 3)
        assert cols.Cols == 2 and cols.Stride == 4 and cols.Get(2, 1) == 10.0 and not cols.Contiguous()
        cols.Fill(-1.0)
        assert m.Get(0, 1) == -1.0 and m.Get(2, 2) == -1.0 and m.Get(2, 3) == 11.0 and m.Get(1, 0) == 4.0
        block := m.Block(1, 2, 2, 2)
        block.Set(1, 1, 99.0)
        assert m.Get(2, 3) == 99.0
        r := m.Row(2)
        r[0] = 7.0
        assert m.Get(2, 0) == 7.0 and r.Len() == 4
        flat := m.Reshape(2, 6)
        assert flat.Get(1, 5) == 99.0 and flat.Rows == 2
        # over the caller's storage
        store := Array<F64>(10)
        v := View(store, 2, 2, 3, 4)
        v.Fill(1.0)
        assert store[2] == 1.0 and store[4] == 1.0 and store[5] == 0.0 and store[6] == 1.0 and store[8] == 1.0
        assert store[9] == 0.0 and store[0] == 0.0
        copy := v.Clone()
        copy.Fill(2.0)
        assert store[2] == 1.0 and copy.Contiguous()
    }

    test "element operators, in-place forms and Map" {
        a := counting(2, 3, 1.0)
        b := Full(2, 3, 2.0)
        assert (a + b).Get(1, 2) == 8.0 and (a - b).Get(0, 0) == -1.0 and (a * b).Get(1, 0) == 8.0
        assert (a / b).Get(0, 1) == 1.0 and (-a).Get(1, 1) == -5.0 and (a * 3.0).Get(1, 2) == 18.0 and (a + 0.5).Get(0, 0) == 1.5
        c := a.Clone()
        c.Add(b)
        c.Sub(a)
        assert c == b
        c.Scale(0.5)
        c.AddScaled(a, 2.0)
        assert c.Get(1, 2) == 13.0
        d := Matrix<F64>(2, 3)
        d.Map(a, fn(x) { return x * x })
        assert d.Get(1, 2) == 36.0
        d.Map2(a, b, fn(x, y) { return x - y })
        assert d.Get(0, 0) == -1.0
        d.Map3(a, b, a, fn(x, y, z) { return x * y + z })
        assert d.Get(1, 2) == 18.0
        # in place: the destination is an operand
        d.Map(d, fn(x) { return x + 1.0 })
        assert d.Get(1, 2) == 19.0
        e := a.Exp()
        assert e.Get(0, 0) == math.Exp(1.0) and a.Sqrt().Get(1, 0) == 2.0 and a.Log().Get(0, 0) == 0.0
        assert (-a).Abs() == a and a.Tanh().Get(0, 0) == math.Tanh(1.0)
        i := Matrix<F32>(3, 3)
        i.SetIdentity()
        assert i.Sum() == 3.0 and i.Get(1, 1) == 1.0 and i.Get(0, 1) == 0.0
    }

    test "a row is added to every row, and outer products are added in place" {
        m := counting(3, 2, 0.0)
        bias := counting(1, 2, 10.0)
        m.AddRow(bias)
        assert m.Get(0, 0) == 10.0 and m.Get(2, 1) == 16.0
        w := Matrix<F64>(2, 3)
        x := F64[1.0, 2.0]
        y := F64[3.0, 4.0, 5.0]
        Ger(w, x, y, 2.0, 1.0)
        assert w.Get(1, 2) == 20.0 and w.Get(0, 0) == 6.0
        w.AddOuterDifference(x, y, x, y, 1.0)
        assert w.Get(1, 2) == 20.0
        w.AddOuterDifference(x, y, F64[3.0, 4.0], F64[1.0, 2.0, 0.0], 1.0)
        assert w.Get(0, 1) == 6.0 and w.Get(1, 2) == 30.0 and w.Get(1, 0) == 14.0
    }

    # whether try (a op b) failed with ShapeError.MISMATCH - op 0 is +, 1 is -, 2 is @, 3 is a.T() @ b.T()
    fn shapeFails(a Matrix<F32>&, b Matrix<F32>&, op I64) Bool {
        if op == 0 { try (a + b) catch ShapeError.MISMATCH { return true } }
        if op == 1 { try (a - b) catch ShapeError.MISMATCH { return true } }
        if op == 2 { try (a @ b) catch ShapeError.MISMATCH { return true } }
        if op == 3 { try (a.T() @ b.T()) catch ShapeError.MISMATCH { return true } }
        return false
    }

    test "shapes that do not fit are an error under try" {
        a := Matrix<F32>(2, 3)
        b := Matrix<F32>(3, 2)
        assert shapeFails(a, b, 0) and shapeFails(a, b, 1) and shapeFails(a, a, 2) and shapeFails(a, a, 3)
        assert not shapeFails(a, a, 0) and not shapeFails(b, b, 1) and not shapeFails(a, b, 2) and not shapeFails(a, b, 3)
        s := try (a + a) catch ShapeError { unreachable }
        assert s.Rows == 2 and s.Cols == 3
    }

    test "Gemm against the plain sum, every transpose, alpha and beta, across block boundaries" {
        r := rand.Rand(5)
        for size in range 3 {
            m I64 = I64[3, 37, 300][size]
            n I64 = I64[5, 29, 270][size]
            k I64 = I64[7, 41, 517][size]
            for form in range 4 {
                transA Bool = form % 2 == 1
                transB Bool = form >= 2
                a := Matrix<F64>(k, m) if transA else Matrix<F64>(m, k)
                b := Matrix<F64>(n, k) if transB else Matrix<F64>(k, n)
                a.FillUniform(r, -1.0, 1.0)
                b.FillUniform(r, -1.0, 1.0)
                want := referenceProduct(a, transA, b, transB)
                c := Matrix<F64>(m, n)
                Gemm(c, a, transA, b, transB)
                assert c.Distance(want) < 1e-9 * F64(k)
                # beta = 1 accumulates, beta = 0 never reads what is there, alpha scales
                c.Fill(1.0)
                Gemm(c, a, transA, b, transB, 2.0, 1.0)
                twice := want * 2.0 + 1.0
                assert c.Distance(twice) < 1e-9 * F64(k)
                c.Fill(math.NaN)
                Gemm(c, a, transA, b, transB, 1.0, 0.0)
                assert c.Distance(want) < 1e-9 * F64(k)
                # threads change nothing
                d := Matrix<F64>(m, n)
                Gemm(d, a, transA, b, transB, 1.0, 0.0, 4)
                assert d == c
            }
        }
    }

    # computedDirectly: the shapes either side of each of its bounds, every element a small integer so that both paths'
    # sums are exact and so equal
    test "products either side of the direct path's bounds are the plain sum" {
        shapes := I64[8, 8, 8, 10, 10, 10, 11, 11, 11, 5, 64, 64, 11, 64, 64, 12, 64, 64, 8, 32, 32, 64, 32, 64, 5, 1024, 64,
                      5, 1025, 64, 7, 64, 3]
        for s in range shapes.Len() / 3 {
            m I64 = shapes[3 * s]
            k I64 = shapes[3 * s + 1]
            n I64 = shapes[3 * s + 2]
            for transA in Bool[false, true] {
                a := Matrix<F32>(k, m) if transA else Matrix<F32>(m, k)
                b := Matrix<F32>(k, n)
                for i in range a.Data.Len() { a.Data[i] = F32(i * 5 % 7 - 3) }
                for i in range b.Data.Len() { b.Data[i] = F32(i * 3 % 5 - 2) }
                want := referenceProduct(a, transA, b, false)
                c := Matrix<F32>(m, n)
                Gemm(c, a, transA, b, false)
                assert c.ToF64() == want, "the product " $m "x" $k "x" $n
                ai := Matrix<I32>(a.Rows, a.Cols)
                ai.Convert(a)
                bi := Matrix<I32>(k, n)
                bi.Convert(b)
                ci := Matrix<I32>(m, n)
                Gemm(ci, ai, transA, bi, false)
                assert ci.ToF64() == want, "the integer product " $m "x" $k "x" $n
            }
        }
    }

    test "a workspace's Gemm is Gemm, and keeps its panels from one product to the next" {
        r := rand.Rand(11)
        ws := GemmWorkspace<F64>()
        wide := GemmWorkspace<F16>()
        for size in range 4 {
            # a large product, then smaller ones, then the large one again: one workspace serves them all
            m I64 = I64[300, 37, 64, 300][size]
            n I64 = I64[270, 29, 784, 270][size]
            k I64 = I64[517, 41, 128, 517][size]
            for form in range 4 {
                transA Bool = form % 2 == 1
                transB Bool = form >= 2
                a := Matrix<F64>(k, m) if transA else Matrix<F64>(m, k)
                b := Matrix<F64>(n, k) if transB else Matrix<F64>(k, n)
                a.FillUniform(r, -1.0, 1.0)
                b.FillUniform(r, -1.0, 1.0)
                want := Matrix<F64>(m, n)
                Gemm(want, a, transA, b, transB, 2.0, 0.0, 1)
                c := Matrix<F64>(m, n)
                c.Fill(1.0)
                ws.Gemm(c, a, transA, b, transB, 2.0, 0.0)
                assert c == want
                c.Fill(1.0)
                ws.Gemm(c, a, transA, b, transB, 2.0, 1.0, 4)
                assert c.Distance(want + 1.0) < 1e-9 * F64(k)
                # F16 is packed in F32, into the workspace's F32 panels
                a16 := a.ToF16()
                b16 := b.ToF16()
                want16 := Matrix<F16>(m, n)
                Gemm(want16, a16, transA, b16, transB)
                c16 := Matrix<F16>(m, n)
                wide.Gemm(c16, a16, transA, b16, transB)
                assert c16 == want16
            }
            if size == 0 {
                # F64 is packed in its own panels, F16 in the F32 ones
                assert ws.a != null and ws.b != null and ws.wideA == null and ws.wideB == null
                assert wide.wideA != null and wide.wideB != null and wide.a == null and wide.b == null
            }
        }
        # the largest product came first, so nothing after it needed more room: the panels are those it made
        big := ws.b
        bigWide := wide.wideB
        x := Matrix<F64>(300, 517)
        y := Matrix<F64>(517, 270)
        z := Matrix<F64>(300, 270)
        ws.Gemm(z, x, false, y, false)
        wide.Gemm(Matrix<F16>(300, 270), x.ToF16(), false, y.ToF16(), false)
        assert ws.b is big and wide.wideB is bigWide and ws.wideB == null and wide.b == null
    }

    test "a workspace's panels at least double as its products grow, so a growing product replaces them rarely" {
        # attention over a growing context: the product's columns grow a step at a time, and so does B's panel - every
        # superseded panel stays where the workspace lives, so it must be replaced a logarithmic number of times, not
        # once a step (the panel grows from 64 x 64 to 64 x 1600 here: five replacements, where it was one for every tile
        # of columns the product gained - 49 with AVX-512's tile)
        ws := GemmWorkspace<F32>()
        q := Matrix<F32>(64, 64)
        q.Fill(1.0)
        replaced I64 = 0
        for t in range 64, 1600, 16 {
            k := Matrix<F32>(t, 64)
            k.Fill(0.5)
            s := Matrix<F32>(64, t)
            before := ws.b
            ws.Gemm(s, q, false, k, true)
            assert s.Get(63, t - 1) == 32.0
            if not (ws.b is before) { replaced++ }
        }
        assert replaced <= 7, $replaced " replacements"
        assert ws.b.Len() >= 64 * 1600 and ws.b.Len() < 2 * 64 * (1600 + 64)
    }

    test "the product operators, and products of views" {
        a := counting(2, 3, 0.0)
        b := counting(3, 2, 1.0)
        c := a @ b
        assert c.Get(0, 0) == 13.0 and c.Get(1, 1) == 52.0
        assert (a @ a.T()).Get(0, 1) == 14.0 and (a.T() @ a).Get(2, 2) == 29.0 and (b.T() @ a.T()) == c.T().Clone()
        big := counting(4, 5, 0.0)
        left := big.ColRange(1, 4)
        right := big.Block(0, 1, 3, 2)
        assert left @ right == left.Clone() @ right.Clone()
        # a vector times a matrix, and a matrix times a vector, both ways round
        x := counting(1, 3, 1.0)
        w := counting(2, 3, 0.0)
        y := x @ w.T()
        assert y.Get(0, 0) == 8.0 and y.Get(0, 1) == 26.0
        col := w @ x.Reshape(3, 1)
        assert col.Get(1, 0) == 26.0
        z := Matrix<F64>(1, 3)
        Gemm(z, x.RowRange(0, 1).Reshape(1, 3), false, counting(3, 3, 0.0), false)
        assert z.Get(0, 2) == 1.0 * 2.0 + 2.0 * 5.0 + 3.0 * 8.0
        o := Outer(F64[1.0, 2.0], F64[3.0, 4.0, 5.0])
        assert o.Rows == 2 and o.Get(1, 2) == 10.0
    }

    test "products in every element type: F16, BF16 and F8 computed in F32, integers wrapping" {
        a := counting(3, 4, 1.0)
        b := counting(4, 2, -3.0)
        want := a @ b
        assert (a.ToF32() @ b.ToF32()).ToF64() == want
        assert (a.ToF16() @ b.ToF16()).ToF64() == want
        assert (a.ToBF16() @ b.ToBF16()).ToF64() == want
        ai := Matrix<I32>(3, 4)
        ai.Convert(a)
        bi := Matrix<I32>(4, 2)
        bi.Convert(b)
        ci := ai @ bi
        assert ci.Get(2, 1) == I32(want.Get(2, 1))
        a8 := Matrix<F8E4M3>(3, 4)
        a8.Convert(a)
        b8 := Matrix<F8E4M3>(4, 2)
        b8.Convert(Full(4, 2, 0.5))
        c8 := Matrix<F32>(3, 2)
        c32 := Matrix<F32>(3, 2)
        out8 := Matrix<F8E4M3>(3, 2)
        Gemm(out8, a8, false, b8, false)
        c8.Convert(out8)
        Gemm(c32, a.ToF32(), false, Full(4, 2, F32(0.5)), false)
        assert c8.Get(0, 0) == c32.Get(0, 0) and c8.Get(0, 0) == 5.0
        # an F16 sum many times beyond F16's own precision, accumulated in F32
        ones := Full(1, 4096, F16(1.0))
        assert ones.Sum() == 4096.0 and ones.Dot(ones) == 4096.0
    }

    test "sums, means, norms and extremes" {
        m := counting(3, 4, 1.0)
        assert m.Sum() == 78.0 and m.Mean() == 6.5 and m.Max() == 12.0 and m.Min() == 1.0
        assert m.Dot(m) == 650.0 and m.Norm() == math.Sqrt(650.0) and m.MaxAbs() == 12.0
        assert m.Distance(m) == 0.0 and m.Distance(m + 1.0) == math.Sqrt(12.0) and m.MaxAbsDifference(m * 2.0) == 12.0
        rows := Array<F64>(3)
        m.RowSums(rows)
        assert rows[0] == 10.0 and rows[2] == 42.0
        maxes := Array<F64>(3)
        m.RowMax(maxes)
        assert maxes[1] == 8.0
        cols := Full(1, 4, 100.0)
        m.ColumnSums(cols)
        assert cols.Get(0, 0) == 15.0 and cols.Get(0, 3) == 24.0
        m.ColumnSums(cols, 1.0)
        assert cols.Get(0, 3) == 48.0
        wide := counting(2, 150, 0.0)
        wcols := Matrix<F64>(1, 150)
        wide.ColumnSums(wcols)
        assert wcols.Get(0, 149) == 149.0 + 299.0 and wcols.Get(0, 70) == 70.0 + 220.0
        scores := counting(2, 3, 0.0)
        scores.Set(0, 1, 9.0)
        scores.Set(1, 0, 5.0)
        classes := Array<I32>(2)
        scores.ArgMaxRows(classes)
        assert classes[0] == 1 and classes[1] == 0
        scores.Set(1, 2, math.NaN)
        scores.ArgMaxRows(classes)
        assert classes[1] == 2 and math.IsNan(scores.Max())
        # a strided view sums only its own elements
        assert m.ColRange(1, 3).Sum() == 2.0 + 3.0 + 6.0 + 7.0 + 10.0 + 11.0
        # a long sum in lanes: exact here, since every partial sum is an integer
        long := counting(1, 1001, 0.0)
        assert long.Sum() == 500500.0
    }

    test "random fills are reproducible from the seed" {
        r := rand.Rand(42)
        a := Matrix<F32>(100, 100)
        a.FillNormal(r, 1.0, 2.0)
        mean := a.Mean()
        sd F32 = (a - mean).Norm() / 100.0
        assert mean > 0.9 and mean < 1.1 and sd > 1.9 and sd < 2.1
        again := rand.Rand(42)
        b := Matrix<F32>(100, 100)
        b.FillNormal(again, 1.0, 2.0)
        assert a == b
        u := Matrix<F64>(50, 50)
        u.FillUniform(r, -1.0, 3.0)
        assert u.Min() >= -1.0 and u.Max() < 3.0 and u.Mean() > 0.9 and u.Mean() < 1.1
    }

    test "conversions round as a conversion does" {
        m := Full(2, 2, 1.0 / 3.0)
        f := m.ToF32()
        assert f.Get(1, 1) == F32(1.0 / 3.0)
        h := m.ToF16()
        assert h.Get(0, 0) == F16(1.0 / 3.0)
        bf := m.ToBF16()
        assert bf.Get(0, 1) == BF16(1.0 / 3.0)
        back := Matrix<F64>(2, 2)
        back.Convert(bf)
        assert back.Get(0, 1) == F64(BF16(1.0 / 3.0))
    }

    test "rendering, equality and hashing" {
        m := counting(2, 2, 0.5)
        assert $m == "[[0.5, 1.5],\n [2.5, 3.5]]"
        long := counting(12, 1, 0.0)
        assert $long == "[[0],\n [1],\n [2],\n ...,\n [9],\n [10],\n [11]]"
        wide := counting(1, 12, 0.0)
        assert $wide == "[[0, 1, 2, ..., 9, 10, 11]]"
        assert m == m.Clone() and m != m * 2.0 and m != counting(1, 4, 0.5)
        assert m.Hash() == m.Clone().Hash()
        z := Full(1, 1, 0.0)
        nz := Full(1, 1, -0.0)
        assert z == nz and z.Hash() == nz.Hash()
        seen := Map<Matrix<F64>, I64>()
        seen.Put(m, 1)
        assert m.Clone() in seen
    }

    test "Solve and Inverse" {
        a := counting(3, 3, 1.0)
        a.Set(2, 2, 10.0)
        x := counting(3, 2, 0.0)
        b := a @ x
        got := try Solve(a, b) catch SolveError { unreachable }
        assert got.MaxAbsDifference(x) < 1e-12
        inv := try a.Inverse() catch SolveError { unreachable }
        id := Matrix<F64>(3, 3)
        id.SetIdentity()
        assert (a @ inv).MaxAbsDifference(id) < 1e-12
        singular := Full(3, 3, 2.0)
        failed Bool = false
        try Solve(singular, b) catch SolveError.SINGULAR { failed = true }
        assert failed
    }

    test "ParallelRows covers every row once" {
        m Matrix<I64>& = Matrix<I64>(1000, 1)
        ParallelRows(1000, 10, 4, fn(lo, hi) {
            for i in range lo, hi { m.Set(i, 0, m.Get(i, 0) + 1) }
        })
        assert m.Sum() == 1000 and m.Min() == 1 and m.Max() == 1
        small Matrix<I64>& = Matrix<I64>(5, 1)
        ParallelRows(5, 10, 4, fn(lo, hi) {
            for i in range lo, hi { small.Set(i, 0, I64(hi - lo)) }
        })
        assert small.Sum() == 25
    }

    test "matrix-vector products both ways round, of views too, and products of one to four rows" {
        r := rand.Rand(7)
        for size in range 2 {
            rows I64 = I64[64, 256][size]
            cols I64 = I64[64, 128][size]
            a := Matrix<F64>(rows, cols)
            a.FillUniform(r, -1.0, 1.0)
            x := Matrix<F64>(cols, 1)
            x.FillUniform(r, -1.0, 1.0)
            want := referenceProduct(a, false, x, false)
            y := Array<F64>(rows, math.NaN)
            Gemv(y, a, false, x.Data)
            for i in range rows { assert math.Abs(y[i] - want.Get(i, 0)) < 1e-13 * F64(cols) }
            # a's columns: y = 2 a^T u + y
            u := Matrix<F64>(rows, 1)
            u.FillUniform(r, -1.0, 1.0)
            wantT := referenceProduct(a, true, u, false)
            yt := Array<F64>(cols, 1.0)
            Gemv(yt, a, true, u.Data, 2.0, 1.0)
            for j in range cols { assert math.Abs(yt[j] - (2.0 * wantT.Get(j, 0) + 1.0)) < 1e-13 * F64(rows) }
            # a view: its rows are not contiguous with each other
            v := a.ColRange(1, cols - 1)
            xv := Matrix<F64>(cols - 2, 1)
            xv.Fill(1.0)
            wantV := referenceProduct(v, false, xv, false)
            yv := Array<F64>(rows)
            Gemv(yv, v, false, xv.Data)
            for i in range rows { assert math.Abs(yv[i] - wantV.Get(i, 0)) < 1e-13 * F64(cols) }
            wantVT := referenceProduct(v, true, u, false)
            yvt := Array<F64>(cols - 2)
            Gemv(yvt, v, true, u.Data)
            for j in range cols - 2 { assert math.Abs(yvt[j] - wantVT.Get(j, 0)) < 1e-13 * F64(rows) }
        }
        # a batch of one to four rows through Gemm takes the same path, every transpose
        for m in range 1, 5 {
            for form in range 4 {
                transA Bool = form % 2 == 1
                transB Bool = form >= 2
                a := Matrix<F32>(37, m) if transA else Matrix<F32>(m, 37)
                b := Matrix<F32>(29, 37) if transB else Matrix<F32>(37, 29)
                a.FillUniform(r, -1.0, 1.0)
                b.FillUniform(r, -1.0, 1.0)
                c := Full(m, 29, F32(1.0))
                Gemm(c, a, transA, b, transB, 1.0, 1.0)
                want := referenceProduct(a, transA, b, transB) + 1.0
                assert c.ToF64().MaxAbsDifference(want) < 1e-5
            }
        }
    }

    test "rank-1 and rank-2 updates, accumulating, decayed or replacing" {
        x := F64[1.0, 2.0]
        y := F64[3.0, 4.0, 5.0]
        w := counting(2, 3, 0.0)
        Ger(w, x, y)
        assert w.Get(1, 2) == 5.0 + 10.0 and w.Get(0, 0) == 3.0
        Ger(w, x, y, 2.0, 0.5)
        assert w.Get(1, 2) == 0.5 * 15.0 + 2.0 * 2.0 * 5.0
        w.Fill(math.NaN)
        Ger(w, x, y, 1.0, 0.0)
        assert w == Outer(x, y)
        u := counting(2, 3, 1.0)
        Ger2(u, x, y, F64[1.0, -1.0], F64[1.0, 1.0, 1.0], 1.0, 0.9)
        assert u.Get(1, 2) == 0.9 * 6.0 + (10.0 - 1.0) and u.Get(0, 0) == 0.9 + (3.0 + 1.0)
        f := Matrix<F32>(2, 3)
        Ger(f, F32[1.0, 2.0], F32[3.0, 4.0, 5.0], 0.5)
        assert f.Get(1, 2) == 5.0
    }

    test "clamps, masked updates and random masks" {
        m := counting(2, 3, -2.0)
        m.Clamp(-1.0, 2.0)
        assert m.Min() == -1.0 and m.Max() == 2.0 and m.Get(0, 2) == 0.0 and m.Get(1, 0) == 1.0 and m.Get(0, 0) == -1.0
        mask := Matrix<U8>(2, 3)
        mask.Set(0, 1, 1)
        mask.Set(1, 2, 1)
        w := Matrix<F64>(2, 3)
        w.AddScaledMasked(Full(2, 3, 1.0), 0.5, mask)
        assert w.Sum() == 1.0 and w.Get(0, 1) == 0.5 and w.Get(1, 2) == 0.5
        r := rand.Rand(3)
        b := Matrix<U8>(100, 100)
        b.FillBernoulli(r, 0.3)
        ones := b.ToF64().Sum()
        assert ones > 2700.0 and ones < 3300.0 and b.Max() == 1 and b.Min() == 0
        signs := Matrix<F32>(10, 10)
        signs.FillBernoulli(r, 1.0)
        assert signs.Sum() == 100.0
    }

    test "row reductions, normalised rows and the softmax of rows" {
        m := counting(2, 3, -2.0)
        out := Array<F64>(2)
        m.RowMaxAbs(out)
        assert out[0] == 2.0 and out[1] == 3.0
        m.RowAbsSums(out)
        assert out[0] == 3.0 and out[1] == 6.0
        m.RowNorms(out)
        assert out[0] == math.Sqrt(5.0) and out[1] == math.Sqrt(14.0)
        cs := Matrix<F64>(1, 3)
        counting(2, 3, -4.0).ColumnAbsSums(cs)
        assert cs.Get(0, 0) == 5.0 and cs.Get(0, 1) == 3.0 and cs.Get(0, 2) == 3.0
        n := m.Clone()
        n.NormalizeRows()
        n.RowNorms(out)
        assert math.Abs(out[0] - 1.0) < 1e-15 and math.Abs(out[1] - 1.0) < 1e-15
        zero := Matrix<F64>(1, 3)
        zero.NormalizeRows()
        assert zero.Sum() == 0.0
        # a block of columns, in place, over a temperature: what is outside the block is untouched
        s := counting(2, 4, 0.0)
        block := s.ColRange(1, 4)
        block.RowSoftmax(block, 2.0)
        assert s.Get(0, 0) == 0.0 and s.Get(1, 0) == 4.0
        sums := Array<F64>(2)
        block.RowSums(sums)
        assert math.Abs(sums[0] - 1.0) < 1e-15 and math.Abs(sums[1] - 1.0) < 1e-15
        want F64 = math.Exp(-1.0) / (math.Exp(-1.0) + math.Exp(-0.5) + 1.0)
        assert math.Abs(s.Get(0, 1) - want) < 1e-15 and math.Abs(s.Get(1, 1) - want) < 1e-15
        p := Matrix<F32>(2, 3)
        p.RowSoftmax(m.ToF32(), 1.0)
        assert p.Get(0, 2) > p.Get(0, 1) and math.Abs(p.Sum() - 2.0) < 1e-6
    }

    # the largest errors of FastExp (relative, where e^x is a normal number), FastTanh and FastSigmoid (absolute) against
    # the C library's, at n points spread over [-100, 100]
    fn fastErrors(like <T>, n I64) (F64, F64, F64) {
        tiny F64 = match T {
            case F32 => 1.1754943508222875e-38
            case F64 => 2.2250738585072014e-308
        }
        worstExp, worstTanh, worstSig := 0.0, 0.0, 0.0
        for i in range n {
            x T = Cast(-100.0 + 200.0 * F64(i) / F64(n - 1), like)
            want F64 = F64(math.Exp(x))
            if want > tiny and math.IsFinite(want) { worstExp = math.Max(worstExp, math.Abs(F64(FastExp(x)) - want) / want) }
            worstTanh = math.Max(worstTanh, math.Abs(F64(FastTanh(x)) - F64(math.Tanh(x))))
            worstSig = math.Max(worstSig, math.Abs(F64(FastSigmoid(x)) - 1.0 / (1.0 + math.Exp(-F64(x)))))
        }
        return worstExp, worstTanh, worstSig
    }

    test "the fast activations: their errors against the C library, and their limits" {
        e32, t32, s32 := fastErrors(F32(0), 20001)
        assert e32 < 3e-7 and t32 < 2e-7 and s32 < 2e-7
        e64, t64, s64 := fastErrors(F64(0), 20001)
        assert e64 < 6e-16 and t64 < 3e-16 and s64 < 3e-16
        assert math.IsInf(FastExp(F32(89.0))) and FastExp(F32(-88.0)) == 0.0 and math.IsNan(FastExp(F32(math.NaN)))
        assert math.IsInf(FastExp(710.0)) and FastExp(-709.0) == 0.0 and FastExp(0.0) == 1.0 and FastExp(F32(0.0)) == 1.0
        assert FastTanh(F32(50.0)) == 1.0 and FastTanh(-50.0) == -1.0 and FastTanh(0.0) == 0.0
        assert FastSigmoid(F32(-1000.0)) == 0.0 and FastSigmoid(1000.0) == 1.0 and FastSigmoid(0.0) == 0.5
        m := counting(2, 2, -1.0).ToF32()
        e := Matrix<F32>(2, 2)
        e.Map(m, fn(x) { return FastExp(x) })
        assert math.Abs(F64(e.Get(1, 1)) - math.Exp(2.0)) < 1e-6 * math.Exp(2.0)
    }

    test "Cast converts as a conversion does, the 8-bit floats included" {
        assert Cast(2.75, F32(0)) == F32(2.75) and Cast(F32(-1.5), I32(0)) == -1 and Cast(300, U8(0)) == 44
        assert Cast(Cast(1.5, F8E4M3(0.0)), 0.0) == 1.5 and Cast(F16(0.5), BF16(0)) == BF16(0.5)
    }

    # a batch over storage of its own with gaps everywhere: rows a stride of cols + 3, members rows stride + 5 apart,
    # groups members member stride + 7 apart; the gaps hold NaN
    fn gappyBatch(rows I64, cols I64, groups I64, members I64, r mut rand.Rand&) Batch<F64> {
        stride I64 = cols + 3
        ms I64 = rows * stride + 5
        gs I64 = members * ms + 7
        data mut Array<F64>&return = Array<F64>(groups * gs, math.NaN)
        b Batch<F64>&return = Batch<F64>(rows, cols, stride, groups, gs, members, ms, data)
        for g in range groups {
            for m in range members {
                x := b[g, m]
                x.FillUniform(r, -1.0, 1.0)
            }
        }
        return b
    }

    # whether every element of the batch's storage outside its matrices is still a NaN
    fn gapsUntouched(b Batch<F64>&) Bool {
        inside := Array<Bool>(b.Data.Len())
        for g in range b.Groups {
            for m in range b.Members {
                for i in range b.Rows {
                    for j in range b.Cols { inside[g * b.GroupStride + m * b.MemberStride + i * b.Stride + j] = true }
                }
            }
        }
        for e in range b.Data.Len() {
            if not inside[e] and not math.IsNan(b.Data[e]) { return false }
        }
        return true
    }

    test "GemmBatch is a Gemm per matrix: every transpose, alpha and beta, strided storage, threads" {
        r := rand.Rand(21)
        for size in range 2 {
            m I64 = I64[37, 130][size]
            n I64 = I64[29, 45][size]
            k I64 = I64[41, 300][size]
            for form in range 4 {
                transA Bool = form % 2 == 1
                transB Bool = form >= 2
                a := gappyBatch(k if transA else m, m if transA else k, 3, 2, r)
                b := gappyBatch(n if transB else k, k if transB else n, 3, 2, r)
                c := gappyBatch(m, n, 3, 2, r)
                c0 := gappyBatch(m, n, 3, 2, r)
                for e in range c.Data.Len() { c0.Data[e] = c.Data[e] }
                GemmBatch(c, a, transA, b, transB, 2.0, 0.5)
                for g in range 3 {
                    for h in range 2 {
                        want := referenceProduct(a[g, h], transA, b[g, h], transB) * 2.0 + c0[g, h].ToF64() * 0.5
                        assert c[g, h].Distance(want) < 1e-9 * F64(k)
                    }
                }
                assert gapsUntouched(c)
                # threads change nothing
                d := gappyBatch(m, n, 3, 2, r)
                for e in range d.Data.Len() { d.Data[e] = c0.Data[e] }
                ws := GemmWorkspace<F64>()
                ws.GemmBatch(d, a, transA, b, transB, 2.0, 0.5, Triangular.None, 0, 4)
                for e in range d.Data.Len() { assert d.Data[e] == c.Data[e] or math.IsNan(c.Data[e]) }
            }
        }
    }

    # m with every element above its diagonal (j > i + diag) set to v
    fn aboveDiagonal(m Matrix<<T>>&, diag I64, v T) {
        for i in range m.Rows {
            for j in range m.Cols {
                if j > i + diag { m.Set(i, j, v) }
            }
        }
    }

    test "a triangular result is computed below its diagonal only, and nothing above it is touched" {
        r := rand.Rand(5)
        for size in range 3 {
            T I64 = I64[37, 300, 9][size]
            first I64 = I64[0, 0, 40][size]          # queries from position first on, the keys from 0: decoding with a cache
            for diag in range -2, 4, 3 {
                d I64 = diag + first
                q := Matrix<F64>(2 * T, 2 * 13)
                k := Matrix<F64>(2 * (T + first), 2 * 13)
                q.FillUniform(r, -1.0, 1.0)
                k.FillUniform(r, -1.0, 1.0)
                s := Matrix<F64>(2 * 2 * T, T + first)
                s.Fill(math.NaN)
                S := s.Stacked(T, 2)
                Q := q.Heads(T, 2)
                K := k.Heads(T + first, 2)
                GemmBatch(S, Q, false, K, true, 0.5, 0, Triangular.Result, d)
                for g in range 2 {
                    for h in range 2 {
                        want := referenceProduct(Q[g, h], false, K[g, h], true)
                        got := S[g, h]
                        for i in range T {
                            for j in range T + first {
                                if j <= i + d { assert math.Abs(got.Get(i, j) - 0.5 * want.Get(i, j)) < 1e-12 * F64(T) } else { assert math.IsNan(got.Get(i, j)) }
                            }
                        }
                    }
                }
                # beta = 1 adds below the diagonal, and still touches nothing above it
                GemmBatch(S, Q, false, K, true, 0.5, 1, Triangular.Result, d)
                for g in range 2 {
                    for h in range 2 {
                        want := referenceProduct(Q[g, h], false, K[g, h], true)
                        got := S[g, h]
                        for i in range T {
                            for j in range T + first {
                                if j <= i + d { assert math.Abs(got.Get(i, j) - want.Get(i, j)) < 1e-12 * F64(T) } else { assert math.IsNan(got.Get(i, j)) }
                            }
                        }
                    }
                }
            }
        }
    }

    test "a triangular left operand is read in its lower triangle only, transposed or not" {
        r := rand.Rand(6)
        for size in range 2 {
            T I64 = I64[37, 300][size]
            for diag in range -2, 4, 3 {
                for transA in range 2 {
                    p := Matrix<F64>(3 * T, T)
                    p.FillUniform(r, 0.0, 1.0)
                    clean := p.Clone()
                    for g in range 3 {
                        aboveDiagonal(clean.RowRange(g * T, (g + 1) * T), diag, 0.0)
                        aboveDiagonal(p.RowRange(g * T, (g + 1) * T), diag, math.NaN)      # never read
                    }
                    v := Matrix<F64>(3 * T, 19)
                    v.FillUniform(r, -1.0, 1.0)
                    y := Matrix<F64>(3 * T, 19)
                    y.Fill(1.0)
                    GemmBatch(y.Stacked(T), p.Stacked(T), transA == 1, v.Stacked(T), false, 1, 2, Triangular.Left, diag)
                    for g in range 3 {
                        want := referenceProduct(clean.Stacked(T)[g, 0], transA == 1, v.Stacked(T)[g, 0], false) + 2.0
                        assert y.Stacked(T)[g, 0].Distance(want) < 1e-12 * F64(T)
                    }
                }
            }
        }
    }

    test "causal attention's six products, in one call each, are the products per sequence and head" {
        r := rand.Rand(8)
        B I64 = 3
        T I64 = 50
        heads I64 = 4
        D I64 = 4 * 10
        q := Matrix<F32>(B * T, D)
        k := Matrix<F32>(B * T, D)
        v := Matrix<F32>(B * T, D)
        dy := Matrix<F32>(B * T, D)
        q.FillUniform(r, -1.0, 1.0)
        k.FillUniform(r, -1.0, 1.0)
        v.FillUniform(r, -1.0, 1.0)
        dy.FillUniform(r, -1.0, 1.0)
        p := Matrix<F32>(B * heads * T, T)
        p.FillUniform(r, 0.0, 1.0)
        for e in range B * heads {
            aboveDiagonal(p.RowRange(e * T, (e + 1) * T), 0, 0.0)
        }
        Q, K, V, DY := q.Heads(T, heads), k.Heads(T, heads), v.Heads(T, heads), dy.Heads(T, heads)
        P := p.Stacked(T, heads)
        s := Matrix<F32>(B * heads * T, T)
        y := Matrix<F32>(B * T, D)
        dp := Matrix<F32>(B * heads * T, T)
        dq := Matrix<F32>(B * T, D)
        dk := Matrix<F32>(B * T, D)
        dv := Matrix<F32>(B * T, D)
        ws := GemmWorkspace<F32>()
        ws.GemmBatch(s.Stacked(T, heads), Q, false, K, true, 0.25, 0, Triangular.Result)
        ws.GemmBatch(y.Heads(T, heads), P, false, V, false, 1, 0, Triangular.Left)
        ws.GemmBatch(dp.Stacked(T, heads), DY, false, V, true, 1, 0, Triangular.Result)
        ws.GemmBatch(dq.Heads(T, heads), P, false, K, false, 1, 0, Triangular.Left)
        ws.GemmBatch(dk.Heads(T, heads), P, true, Q, false, 1, 0, Triangular.Left)
        ws.GemmBatch(dv.Heads(T, heads), P, true, DY, false, 1, 0, Triangular.Left, 0, 3)
        for g in range B {
            for h in range heads {
                ss := Matrix<F32>(T, T)
                ws.Gemm(ss, Q[g, h], false, K[g, h], true, 0.25)
                ps := Matrix<F32>(T, T)
                ws.Gemm(ps, DY[g, h], false, V[g, h], true)
                for i in range T {
                    for j in range i + 1 {
                        assert math.Abs(s.Stacked(T, heads)[g, h].Get(i, j) - ss.Get(i, j)) < 1e-5
                        assert math.Abs(dp.Stacked(T, heads)[g, h].Get(i, j) - ps.Get(i, j)) < 1e-5
                    }
                }
                for which in range 4 {
                    got := y.Heads(T, heads)[g, h]
                    want := Matrix<F32>(T, 10)
                    if which == 0 { ws.Gemm(want, P[g, h], false, V[g, h], false) }
                    if which == 1 {
                        got = dq.Heads(T, heads)[g, h]
                        ws.Gemm(want, P[g, h], false, K[g, h], false)
                    }
                    if which == 2 {
                        got = dk.Heads(T, heads)[g, h]
                        ws.Gemm(want, P[g, h], true, Q[g, h], false)
                    }
                    if which == 3 {
                        got = dv.Heads(T, heads)[g, h]
                        ws.Gemm(want, P[g, h], true, DY[g, h], false)
                    }
                    assert got.MaxAbsDifference(want) < 1e-5
                }
            }
        }
    }

    # products whose result is narrower than two vectors take a tile one vector wide, or are computed as their transpose
    test "thin products and transposed ones: a convolution's sixteen channels, its weights' gradient, ten classes" {
        r := rand.Rand(9)
        for size in range 5 {
            m I64 = I64[500, 16, 64, 7, 300][size]
            n I64 = I64[16, 9, 10, 300, 3][size]
            k I64 = I64[9, 3000, 128, 70, 20][size]
            for form in range 4 {
                transA Bool = form % 2 == 1
                transB Bool = form >= 2
                a := Matrix<F64>(k, m) if transA else Matrix<F64>(m, k)
                b := Matrix<F64>(n, k) if transB else Matrix<F64>(k, n)
                a.FillUniform(r, -1.0, 1.0)
                b.FillUniform(r, -1.0, 1.0)
                want := referenceProduct(a, transA, b, transB)
                c := Full(m, n, 1.0)
                Gemm(c, a, transA, b, transB, 1, 1)
                assert c.Distance(want + 1.0) < 1e-12 * F64(k)
                d := Full(m, n, 1.0)
                Gemm(d, a, transA, b, transB, 1, 1, 4)
                assert d == c
            }
        }
    }

    test "the activations: their values, their slopes, and GELU's error" {
        worstTanhForm, worstExact, worstTanhForm32, worstSlope := 0.0, 0.0, 0.0, 0.0
        for i in range 20001 {
            x F64 = -10.0 + 20.0 * F64(i) / 20000.0
            u F64 = 0.7978845608028654 * (x + 0.044715 * x * x * x)
            tanhForm F64 = 0.5 * x * (1.0 + math.Tanh(u))
            exact F64 = 0.5 * x * (1.0 + math.Erf(x / math.Sqrt2))
            worstTanhForm = math.Max(worstTanhForm, math.Abs(Activate(x, Activation.Gelu) - tanhForm))
            worstTanhForm32 = math.Max(worstTanhForm32, math.Abs(F64(Activate(F32(x), Activation.Gelu)) - tanhForm))
            worstExact = math.Max(worstExact, math.Abs(tanhForm - exact))
            # the slope, against a central difference of the activation itself
            h F64 = 1e-5
            for act in Activation[Activation.Gelu, Activation.Tanh, Activation.Sigmoid] {
                diff F64 = (Activate(x + h, act) - Activate(x - h, act)) / (2.0 * h)
                worstSlope = math.Max(worstSlope, math.Abs(ActivationSlope(x, act) - diff))
            }
        }
        assert worstTanhForm < 4e-16 and worstTanhForm32 < 1e-6 and worstExact < 5e-4 and worstSlope < 1e-8
        assert Activate(-2.0, Activation.Relu) == 0.0 and Activate(3.0, Activation.Relu) == 3.0
        assert math.IsNan(Activate(math.NaN, Activation.Relu))
        assert ActivationSlope(0.0, Activation.Relu) == 0.0 and ActivationSlope(0.5, Activation.Relu) == 1.0
        assert Activate(I32(-3), Activation.Relu) == 0 and Activate(F16(-1.5), Activation.Relu) == 0.0
        z := counting(3, 4, -6.0)
        y := Matrix<F64>(3, 4)
        y.Activate(z, Activation.Gelu)
        assert y.Get(2, 3) == Activate(5.0, Activation.Gelu)
        dy := Full(3, 4, 2.0)
        dz := Full(3, 4, 1.0)
        dz.ActivationBackward(dy, z, Activation.Relu, 1)
        assert dz.Get(0, 0) == 1.0 and dz.Get(2, 3) == 3.0
        dz.ActivationBackward(dy, z, Activation.Gelu)
        assert dz.Get(1, 1) == 2.0 * ActivationSlope(-1.0, Activation.Gelu)
    }

    # E4a/E28: ActivationSlope's "1.0 if x > 0.0 else 0.0" beside an F32 value is an F32 - it did not compile at F32
    test "an activation's slope and backward at F32, and through it at F16, are the F64 ones rounded" {
        worst := 0.0
        for i in range 2001 {
            x F64 = -10.0 + 20.0 * F64(i) / 2000.0
            for act in Activation[Activation.Identity, Activation.Relu, Activation.Gelu, Activation.Tanh, Activation.Sigmoid] {
                worst = math.Max(worst, math.Abs(F64(ActivationSlope(F32(x), act)) - ActivationSlope(x, act)))
            }
        }
        assert worst < 1e-4
        assert ActivationSlope(F32(0.5), Activation.Relu) == 1.0 and ActivationSlope(F32(0.0), Activation.Relu) == 0.0
        assert ActivationSlope(F32(-3.0), Activation.Identity) == 1.0 and ActivationSlope(F16(2.0), Activation.Relu) == 1.0
        z := Matrix<F32>(3, 4)
        z.Convert(counting(3, 4, -6.0))
        dy := Full(3, 4, F32(2.0))
        for act in Activation[Activation.Identity, Activation.Relu, Activation.Gelu, Activation.Tanh, Activation.Sigmoid] {
            dz := Full(3, 4, F32(1.0))
            dz.ActivationBackward(dy, z, act)
            dz2 := Full(3, 4, F32(1.0))
            dz2.ActivationBackward(dy, z, act, 1)
            for r in range 3 {
                for c in range 4 {
                    assert dz.Get(r, c) == 2.0 * ActivationSlope(z.Get(r, c), act)
                    assert dz2.Get(r, c) == 1.0 + 2.0 * ActivationSlope(z.Get(r, c), act)
                }
            }
        }
    }

    test "GemmAct is Gemm, the bias row and the activation, in one pass" {
        r := rand.Rand(10)
        for size in range 6 {
            m I64 = I64[3, 20, 100, 150, 130, 64][size]
            n I64 = I64[50, 30, 16, 70, 70, 10][size]
            k I64 = I64[40, 30, 9, 300, 0, 128][size]
            for form in range 4 {
                transA Bool = form % 2 == 1
                transB Bool = form >= 2
                a := Matrix<F32>(k, m) if transA else Matrix<F32>(m, k)
                b := Matrix<F32>(n, k) if transB else Matrix<F32>(k, n)
                a.FillUniform(r, -1.0, 1.0)
                b.FillUniform(r, -1.0, 1.0)
                bias := Matrix<F32>(1, n)
                bias.FillUniform(r, -1.0, 1.0)
                for act in Activation[Activation.Identity, Activation.Relu, Activation.Gelu, Activation.Tanh, Activation.Sigmoid] {
                    want := Full(m, n, F32(0.5))
                    Gemm(want, a, transA, b, transB, 2, 3)
                    want.AddRow(bias)
                    pre := want.Clone()
                    want.Activate(want, act)
                    got := Full(m, n, F32(0.5))
                    z := Matrix<F32>(m, n)
                    GemmAct(got, a, transA, b, transB, bias, act, 2, 3, 1, z)
                    assert got == want and z == pre
                    # threads, and no bias
                    got.Fill(0.5)
                    GemmAct(got, a, transA, b, transB, null, act, 2, 3, 4)
                    want.Fill(0.5)
                    Gemm(want, a, transA, b, transB, 2, 3)
                    want.Activate(want, act)
                    assert got == want
                }
            }
        }
        # F16, rounded once: within F16's precision of the result computed in F64
        a := counting(37, 64, -1000.0).ToF16()
        a.Scale(F16(0.001))
        b := counting(64, 40, -1200.0).ToF16()
        b.Scale(F16(0.001))
        bias := counting(1, 40, -20.0).ToF16()
        c := Matrix<F16>(37, 40)
        GemmAct(c, a, false, b, false, bias, Activation.Gelu)
        want := referenceProduct(a, false, b, false)
        want.AddRow(bias.ToF64())
        want.Activate(want, Activation.Gelu)
        assert c.ToF64().MaxAbsDifference(want) <= 0.001 * want.MaxAbs()
        # integers: the bias and ReLU
        ai := Matrix<I32>(5, 6)
        ai.Convert(counting(5, 6, -15.0))
        bi := Matrix<I32>(6, 70)
        bi.Convert(counting(6, 70, -200.0))
        ci := Matrix<I32>(5, 70)
        GemmAct(ci, ai, false, bi, false, null, Activation.Relu)
        wi := ai @ bi
        for i in range 5 {
            for j in range 70 { assert ci.Get(i, j) == (wi.Get(i, j) if wi.Get(i, j) > 0 else 0) }
        }
    }

    # the patch matrix by its definition, element by element
    fn definedPatches(x Matrix<F64>&, C I64, H I64, W I64, K I64, S I64, P I64) Matrix<F64> {
        oh I64 = (H + 2 * P - K) / S + 1
        ow I64 = (W + 2 * P - K) / S + 1
        out Matrix<F64>&return = Matrix<F64>(x.Rows * oh * ow, C * K * K, null)
        for b in range x.Rows {
            for oy in range oh {
                for ox in range ow {
                    for c in range C {
                        for ky in range K {
                            for kx in range K {
                                iy I64 = oy * S - P + ky
                                ix I64 = ox * S - P + kx
                                v F64 = x.Get(b, (iy * W + ix) * C + c) if iy >= 0 and iy < H and ix >= 0 and ix < W else 0.0
                                out.Set((b * oh + oy) * ow + ox, (c * K + ky) * K + kx, v)
                            }
                        }
                    }
                }
            }
        }
        return out
    }

    test "patches: Im2col is their definition, and the products read them from the images" {
        r := rand.Rand(12)
        for shape in range 5 {
            C I64 = I64[1, 3, 16, 2, 20][shape]
            H I64 = I64[28, 7, 14, 5, 6][shape]
            W I64 = I64[28, 9, 14, 6, 7][shape]
            K I64 = I64[3, 3, 3, 5, 4][shape]
            S I64 = I64[1, 2, 1, 1, 2][shape]
            P I64 = I64[1, 1, 1, 0, 2][shape]
            outC I64 = I64[16, 5, 32, 3, 7][shape]
            n I64 = 3
            x := Matrix<F64>(n, H * W * C)
            x.FillUniform(r, -1.0, 1.0)
            p := Patches(x, C, H, W, K, S, P)
            cols := Matrix<F64>(p.Rows, p.Cols)
            p.Im2col(cols, 3)
            assert cols == definedPatches(x, C, H, W, K, S, P)
            w := Matrix<F64>(outC, p.Cols)
            w.FillUniform(r, -1.0, 1.0)
            bias := Matrix<F64>(1, outC)
            bias.FillUniform(r, -1.0, 1.0)
            # the forward: y = act(patches w^T + b)
            y := Matrix<F64>(p.Rows, outC)
            z := Matrix<F64>(p.Rows, outC)
            GemmPatches(y, p, w, true, bias, Activation.Relu, 1, 0, 1, z)
            want := referenceProduct(cols, false, w, true)
            want.AddRow(bias)
            assert z.Distance(want) < 1e-12 * F64(p.Cols)
            want.Activate(want, Activation.Relu)
            assert y.Distance(want) < 1e-12 * F64(p.Cols)
            y2 := Matrix<F64>(p.Rows, outC)
            GemmAct(y2, cols, false, w, true, bias, Activation.Relu)
            assert y2 == y
            # threads, and F32: the same
            y3 := Matrix<F64>(p.Rows, outC)
            GemmPatches(y3, p, w, true, bias, Activation.Relu, 1, 0, 3)
            assert y3 == y
            x32 := x.ToF32()
            p32 := Patches(x32, C, H, W, K, S, P)
            y32 := Matrix<F32>(p.Rows, outC)
            GemmPatches(y32, p32, w.ToF32(), true, bias.ToF32(), Activation.Gelu)
            want32 := Matrix<F32>(p.Rows, outC)
            cols32 := Matrix<F32>(p.Rows, p.Cols)
            p32.Im2col(cols32)
            GemmAct(want32, cols32, false, w.ToF32(), true, bias.ToF32(), Activation.Gelu)
            assert y32 == want32
        }
    }

    fn causalSmall(one F64) F64 {
        q := counting(4, 4, one)
        k := counting(4, 4, -2.0 * one)
        s := Matrix<F64>(4, 4)
        GemmBatch(s.Stacked(4), q.Heads(4, 1), false, k.Heads(4, 1), true, 1, 0, Triangular.Result)
        p := Full(4, 4, one)
        aboveDiagonal(p, 0, math.NaN)
        v := counting(4, 4, -one)
        y := Matrix<F64>(4, 4)
        GemmBatch(y.Stacked(4), p.Stacked(4), false, v.Stacked(4), false, 1, 0, Triangular.Left)
        return s.Sum() + y.Sum()
    }

    # one is read from a mutable global at run time, so that product is the running program's, while one written as a
    # literal is computed while compiling, where the assert is decided (S18c): a wrong value would be a compile error
    causalOne mut F64 = 1.0

    test "a small causal product is decided while compiling, and the run time agrees" {
        assert causalSmall(1.0) == 2020.0
        assert causalSmall(causalOne) == 2020.0
    }
}
