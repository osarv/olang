# deque - Deque<T>: a double-ended queue, pushed and popped at both ends in constant time - a work list taken from
# either end, a sliding window, a breadth-first search's frontier. A ring buffer that doubles when full, its elements
# moved into the new one in order; Front, Back and "d[i]" (from the front, unchecked as an array index is, "checked
# d[i]" checked) read without moving anything. Imported with `import "std/deque"`; the type is deque.Deque<T>.
#
# A Deque is a VALUE, as Vec and Map are: a copy of a Deque ("e := d", a field, an argument) is a deque of its own
# holding the same elements, and sharing one is written "&" ("d mut deque.Deque<T>&"). As a Vec's, a replaced buffer
# stays where the Deque lives until that scope closes.
#
# The ring's elements are stored into room with occupy and taken out with vacate (as the prelude's collections do), so
# a Deque of values with destructors to run (Deque<File>, unique as they are, T13b) ends them: Clear ends every element,
# a store over one the old one, and the deque's holder letting go of it every element, back to front (C11, O15) - its
# destructor, which a Deque of anything else has not.

# what a Deque's operations fail with: a Front, Back or Pop of an empty deque
type Error error {
    Empty
}

type Deque<T> struct() {
    buf Array<T>                                   # the ring (of a run-time length, T7d)
    head I64 = 0                                   # where the front element is
    n I64 = 0
} destruct {
    for k := n - 1, k >= 0, k-- { buf[(head + k) % buf.Len()].vacate() }   # back to front (C11: Deque<File> only)
}

# a Deque of every value an iterator gives, front to back (D19) - what a Deque's literal and comprehension call (E19,
# E27): "deque.Deque<I64>[1, 2, 3]". Fails with what the iterator fails with
fn Deque<T>.FromIter<I Iterator<T ? E> ? E>(it mut I&) Deque<T> ? E {
    d := Deque<T>()
    for x in try it { d.PushBack(x) }
    return d
}

# room for one more, the elements moved into a buffer twice the size when the ring is full, front first - the rest of
# it never filled, so no zero value is needed (D13c): each position is written by a Push before it is read
fn (d mut Deque<T>&) room() {
    if d.n < d.buf.Len() { return }
    old mut Array<T>& = d.buf
    size I64 = 8 if old.Len() == 0 else old.Len() * 2
    d.buf = old[:0].grown(size)
    for i in range d.n { d.buf[i].occupy(old[(d.head + i) % old.Len()].vacate()) }
    old.retire()
    d.head = 0
}

fn (d Deque<T>&) Len() I64 { return d.n }

# x after the back
fn (d mut Deque<T>&) PushBack(x T) {
    d.room()
    d.buf[(d.head + d.n) % d.buf.Len()].occupy(x)
    d.n++
}

# x before the front
fn (d mut Deque<T>&) PushFront(x T) {
    d.room()
    d.head = (d.head + d.buf.Len() - 1) % d.buf.Len()
    d.buf[d.head].occupy(x)
    d.n++
}

# the front element, taken off
fn (d mut Deque<T>&) PopFront() T ? Error.Empty {
    if d.n == 0 { error Error.Empty }
    x := d.buf[d.head].vacate()
    d.head = (d.head + 1) % d.buf.Len()
    d.n--
    return x
}

# the back element, taken off
fn (d mut Deque<T>&) PopBack() T ? Error.Empty {
    if d.n == 0 { error Error.Empty }
    d.n--
    return d.buf[(d.head + d.n) % d.buf.Len()].vacate()
}

fn (d Deque<T>&) Front() T ? Error.Empty {
    if d.n == 0 { error Error.Empty }
    return d.buf[d.head]
}

fn (d Deque<T>&) Back() T ? Error.Empty {
    if d.n == 0 { error Error.Empty }
    return d.buf[(d.head + d.n - 1) % d.buf.Len()]
}

# element i counted from the front - a copy, as a Vec's is. Unchecked: "checked d[i]" checks i against Len()
fn (d Deque<T>&) At(i I64) T {
    return d.buf[(d.head + i) % d.buf.Len()]
}

fn (d mut Deque<T>&) SetAt(i I64, x T) {
    d.buf[(d.head + i) % d.buf.Len()] = x
}

# removes every element, ending them back to front, keeping the buffer for the next ones
fn (d mut Deque<T>&) Clear() {
    for d.n > 0 {
        d.n--
        d.buf[(d.head + d.n) % d.buf.Len()].vacate()
    }
    d.head = 0
}

# the elements front to back, in an array of their own
fn (d Deque<T>&) ToArray() mut Array<T>& {
    out mut Array<T>& = Array<T>(0)
    if d.n == 0 { return out }
    out = Array<T>(d.n, d.buf[d.head])
    for i in range d.n { out[i] = d.buf[(d.head + i) % d.buf.Len()] }
    return out
}

# a position in a Deque, front to back: "for x in d" walks one
type Iter<T> struct(of Deque<T>&) {
    d Deque<T>& = of
    i I64 = 0
}

fn (it mut Iter<T>&) Next() T ? Exhausted {
    if it.i >= it.d.Len() { error Exhausted.End }
    it.i++
    return it.d.At(it.i - 1)
}

fn (d Deque<T>&) Iter() Iter<T> { return Iter<T>(d) }

# whether two Deques hold equal elements in the same order - "==" (E10a)
fn (d Deque<T>&) Eq(o Deque<T>&) Bool {
    if d.Len() != o.Len() { return false }
    for i in range d.Len() {
        if d.At(i) != o.At(i): return false
    }
    return true
}

fn (d Deque<T>&) Hash() I64 {
    h I64 = -3750763034362895579
    for i in range d.Len() { h = (h ^ d.At(i).Hash()) * 1099511628211 }
    return h
}

# how "$" renders a Deque: its elements front to back, as an array renders, after "Deque" - "Deque[1, 2, 3]"
fn (d Deque<T>&) Str() String {
    r := $d.ToArray()                                    # "Array<T>[...]", the literal making it (E19)
    return "deque.Deque" $r[5:]
}

if TestBuild {

test "a Deque is pushed and popped at both ends" {
    d := Deque<I64>()
    for i in range 20 { d.PushBack(i) }
    d.PushFront(-1)
    d.PushFront(-2)
    assert d.Len() == 22 and d.Front()! == -2 and d.Back()! == 19 and d[2] == 0
    assert d.PopFront()! == -2 and d.PopBack()! == 19 and d.Len() == 20
    sum := 0
    for x in d { sum += x }
    assert sum == -1 + 171
    d.Clear()
    v := try d.PopFront() catch Error.Empty default 99
    assert v == 99
    assert (try d.Back() catch Error.Empty default 7) == 7
}

test "a Deque used as a ring wraps and grows in order" {
    d := Deque<I64>()
    for round in range 50 {
        d.PushBack(round)
        d.PushBack(round + 1000)
        assert d.PopFront()! >= 0
    }
    assert d.Len() == 50
    a := d.ToArray()
    for i in range a.Len() - 1 { assert a[i] != a[i + 1] }
    c := d                                          # a copy: a deque of its own
    c.PushBack(5)
    assert c.Len() == 51 and d.Len() == 50 and c != d
    d.PushBack(5)
    assert c == d and c.Hash() == d.Hash()
    d[0] = 77
    assert d.Front()! == 77 and $Deque<I64>() == "Deque[]"
}

test "a Deque of text" {
    q := Deque<String&>()
    q.PushBack("b")
    q.PushFront("a")
    assert $q == "Deque[\"a\", \"b\"]" and q.PopBack()! == "b"
}

}
