# utf8 - text as Unicode code points. A String is bytes (a Char is one byte, T29h); this module reads and writes the
# UTF-8 those bytes hold: a code point - a Rune, the number Unicode gives a character - is one to four bytes. Decode
# reads one strictly, Valid says whether a text is UTF-8 all through, Runes walks one code point at a time, Encode writes
# one. Imported with `import "std/utf8"`; Unicode's own tables (letters, case, width, normalization) are not here.

# a Unicode code point, U+0000 to U+10FFFF without the surrogates U+D800 to U+DFFF. It extends U32 (T29f): runes compare
# and do arithmetic as numbers, and a literal is one ("utf8.Rune(0x1F600)")
type Rune extends U32

# what stands for bytes that are not UTF-8 when Runes walks them: U+FFFD, the replacement character
Replacement Rune = 0xFFFD

# the largest code point
MaxRune Rune = 0x10FFFF

# what Decode, Encode, Count and FromRunes fail with: bytes that are not UTF-8 - a byte no sequence starts with, a
# sequence cut short or written longer than it needs, a surrogate, a value past U+10FFFF - or such a value to write
type Error error {
    INVALID
}

# whether r is a code point UTF-8 can hold
fn (r Rune) IsValid() Bool { return r <= MaxRune and not (r >= 0xD800 and r <= 0xDFFF) }

# how many bytes UTF-8 writes r in: 1 to 4 (a value that is no code point counts as Replacement's 3)
fn (r Rune) Len() I64 {
    if r < 0x80 { return 1 }
    if r < 0x800 { return 2 }
    if not r.IsValid() { return 3 }
    if r < 0x10000 { return 3 }
    return 4
}

# the code point at byte "at" of t and how many bytes it takes - failing with INVALID where the bytes there are not one
fn Decode(t String&, at I64) Rune, I64 ? Error.INVALID {
    if at < 0 or at >= t.Len() { error Error.INVALID }
    b0 := U32(t[at])
    if b0 < 0x80 { return Rune(b0), 1 }
    n I64 = 0
    r U32 = 0
    least U32 = 0
    if b0 >= 0xC2 and b0 <= 0xDF {
        n = 2
        r = b0 & 0x1F
        least = 0x80
    } else if b0 >= 0xE0 and b0 <= 0xEF {
        n = 3
        r = b0 & 0x0F
        least = 0x800
    } else if b0 >= 0xF0 and b0 <= 0xF4 {
        n = 4
        r = b0 & 0x07
        least = 0x10000
    } else {
        error Error.INVALID
    }
    if at + n > t.Len() { error Error.INVALID }
    for i in range 1, n {
        b := U32(t[at + i])
        if (b & 0xC0) != 0x80 { error Error.INVALID }
        r = (r << 6) | (b & 0x3F)
    }
    if r < least or not Rune(r).IsValid() { error Error.INVALID }
    return Rune(r), n
}

# r as UTF-8 - failing with INVALID when r is no code point
fn Encode(r Rune) String ? Error.INVALID {
    if not r.IsValid() { error Error.INVALID }
    n := r.Len()
    out := String(Array<Char>(n))
    v := U32(r)
    if n == 1 {
        out[0] = Char(v)
    } else if n == 2 {
        out[0] = Char(0xC0 | (v >> 6))
        out[1] = Char(0x80 | (v & 0x3F))
    } else if n == 3 {
        out[0] = Char(0xE0 | (v >> 12))
        out[1] = Char(0x80 | ((v >> 6) & 0x3F))
        out[2] = Char(0x80 | (v & 0x3F))
    } else {
        out[0] = Char(0xF0 | (v >> 18))
        out[1] = Char(0x80 | ((v >> 12) & 0x3F))
        out[2] = Char(0x80 | ((v >> 6) & 0x3F))
        out[3] = Char(0x80 | (v & 0x3F))
    }
    return out
}

# whether t is UTF-8 all through (the empty text is)
fn Valid(t String&) Bool {
    at I64 = 0
    for at < t.Len() {
        if t[at] < 0x80 {
            at++
            continue
        }
        _, n := try Decode(t, at) catch Error { return false }
        at += n
    }
    return true
}

# how many code points t holds - failing with INVALID when t is not UTF-8
fn Count(t String&) I64 ? Error.INVALID {
    at I64 = 0
    n I64 = 0
    for at < t.Len() {
        if t[at] < 0x80 {
            at++
        } else {
            _, k := try Decode(t, at)
            at += k
        }
        n++
    }
    return n
}

# a walk over t's code points: "for r in utf8.Runes(t)". A byte that does not start a valid sequence gives Replacement
# and the walk goes on from the next byte - as Go's range over a string and every browser decode - so a walk never
# fails; Valid or Decode say where text is not UTF-8. Pos is the byte the next code point starts at
type RuneIter struct(of String&) {
    t String&of = of
    Pos I64 = 0
}

fn (it mut RuneIter&) Next() Rune ? Exhausted {
    if it.Pos >= it.t.Len() { error Exhausted.END }
    c := it.t[it.Pos]
    if c < 0x80 {
        it.Pos++
        return Rune(c)
    }
    r, n := try Decode(it.t, it.Pos) catch Error {
        it.Pos++
        return Replacement
    }
    it.Pos += n
    return r
}

fn Runes(t String&) RuneIter { return RuneIter(t) }

# t's code points, each its own element - failing with INVALID when t is not UTF-8
fn ToRunes(t String&) Array<Rune> ? Error.INVALID {
    out := Array<Rune>(try Count(t))
    at I64 = 0
    for i in range out.Len() {
        r, n := try Decode(t, at)
        out[i] = r
        at += n
    }
    return out
}

# the code points of a written as UTF-8 - failing with INVALID when one is no code point
fn FromRunes(a Array<Rune>&) String ? Error.INVALID {
    b := StringBuilder()
    for r in a { b.Push(try Encode(r)) }
    return b.ToString()
}

if TestBuild {

# text from its bytes, for bytes no text literal writes
fn bytes(a Array<U8>&) String& {
    t mut String&return = String(Array<Char>(a.Len()))
    for i in range a.Len() { t[i] = Char(a[i]) }
    return t
}

# a code point written out and read back, while compiling as at run time
Smile String = Encode(Rune(0x1F600))!
SmileBack I64 = Count("a😀b")!

test "code points are written and read back" {
    assert Smile.Len() == 4 and Smile[0] == Char(0xF0) and Smile == "😀"
    assert SmileBack == 3
    for v in U32[0, 0x41, 0x7F, 0x80, 0x7FF, 0x800, 0xFFFD, 0xFFFF, 0x10000, 0x10FFFF] {
        t := Encode(Rune(v))!
        r, n := Decode(t, 0)!
        assert U32(r) == v and n == t.Len() and n == Rune(v).Len()
    }
    t := "héllo €"
    assert Valid(t) and Count(t)! == 7
    rs := ToRunes(t)!
    assert rs[1] == Rune(0xE9) and rs[6] == Rune(0x20AC) and FromRunes(rs)! == t
}

test "what is not UTF-8 is refused, and walked as replacement characters" {
    bad := Array<String&>(8)
    bad[0] = bytes(U8[0x80])
    bad[1] = bytes(U8[0xC0, 0x80])                  # overlong
    bad[2] = bytes(U8[0xC3])                        # cut short
    bad[3] = bytes(U8[0xE0, 0x80, 0x80])            # overlong
    bad[4] = bytes(U8[0xED, 0xA0, 0x80])            # a surrogate
    bad[5] = bytes(U8[0xF4, 0x90, 0x80, 0x80])      # past U+10FFFF
    bad[6] = bytes(U8[0xFF])
    bad[7] = bytes(U8[0x61, 0xC3, 0x28])
    for b in bad {
        assert not Valid(b)
        try Count(b) catch Error.INVALID { continue }
        unreachable
    }
    assert (try Encode(Rune(0xD800)) catch Error.INVALID default "x") == "x"
    assert (try Encode(Rune(0x110000)) catch Error.INVALID default "y") == "y"
    seen := Vec<Rune>()
    for r in Runes(bytes(U8[0x61, 0xFF, 0x62, 0xE2, 0x82])) { seen.Push(r) }
    assert seen.Len() == 5 and seen[0] == Rune('a') and seen[1] == Replacement and seen[2] == Rune('b')
    assert seen[3] == Replacement and seen[4] == Replacement
}

}
