# sync - locks for state that tasks share: Mutex<T>, RWLock<T> and Once. Ordinary olang over pthread.h imported (§11
# X17), as chan is: pthread's mutex and read-write lock, of the header's own types.
#
# A Mutex holds the value it guards, and the value is reached only inside a call of With, which takes the lock, hands
# the callback a writable reference to the value, and lets the lock go when the callback returns - so there is no lock
# and unlock to pair by hand, and none to forget on an early return. The callback's parameter lives in a scope it cannot
# name (O4b), so no reference into the guarded value outlives the call: what the callback wants to keep it copies out,
# through a reference it captured: "m.With(fn(c mut Counter&) { c.n++ })". A value with no references to it - a number
# (T24) - is changed by Update instead, which hands the callback a copy and stores what it gives back:
# "m.Update(fn(n I64) I64 { return n + 1 })". Get and Set read and replace the value whole.
#
# Each type is a HANDLE, as Vec and Map are: the lock and what it guards are one record, made where the value is
# constructed (C2d), and a copy of the value is a second name for the same lock - which is what a lock handed to two
# tasks has to be. The locks sit inside that record and never move, as pthread needs. glibc's initial state of a mutex
# and of a read-write lock is all zero bytes (PTHREAD_MUTEX_INITIALIZER, PTHREAD_RWLOCK_INITIALIZER), which is what
# their zero values hold, so nothing has to be initialised. The methods take the handle writable ("mut"), since
# they change what it reaches.
#
# A callback that ends the test running (a failed assert) leaves the lock held, as it leaves anything half done; nothing
# else can leave a callback early - it cannot fail. Locks are not reentrant: a With inside a With on the same Mutex
# waits for itself forever. Under ThreadSanitizer (-race) every edge is pthread's, which it follows (P7).

import pthread "pthread.h"

# ---- Mutex ----

type Mutex<T> struct(value T) {
    s mut mutexState<T>& = mutexState<T>(value)      # every copy of this value names the same lock
}

type mutexState<T> struct(value T) {
    v T = value
    lock pthread.pthread_mutex_t
}

# calls f with the guarded value, the lock held for the whole call: f may read and change the value, and every other
# With waits until f returns
fn (m mut Mutex<T>&) With(f fn(v mut T&)) {
    s := m.s
    pthread.pthread_mutex_lock(s.lock)
    f(s.v)
    pthread.pthread_mutex_unlock(s.lock)
}

# the guarded value replaced by f of it, the lock held for the whole call - for a value With cannot hand out by
# reference, a number say (there are no references to numbers, T24): "m.Update(fn(n) { return n + 1 })"
fn (m mut Mutex<T>&) Update(f fn(v T) T) {
    s := m.s
    pthread.pthread_mutex_lock(s.lock)
    s.v = f(s.v)
    pthread.pthread_mutex_unlock(s.lock)
}

# a copy of the guarded value, read under the lock
fn (m mut Mutex<T>&) Get() T {
    s := m.s
    pthread.pthread_mutex_lock(s.lock)
    v := s.v
    pthread.pthread_mutex_unlock(s.lock)
    return v
}

# the guarded value replaced by x, under the lock
fn (m mut Mutex<T>&) Set(x T) {
    s := m.s
    pthread.pthread_mutex_lock(s.lock)
    s.v = x
    pthread.pthread_mutex_unlock(s.lock)
}

# ---- RWLock ----

# a lock any number of readers may hold together, or one writer alone: for a value read far more often than it changes.
# Read hands the callback a read-only reference, Write a writable one. Which of a waiting reader and a waiting writer goes
# first is glibc's choice (readers, by default)
type RWLock<T> struct(value T) {
    s mut rwlockState<T>& = rwlockState<T>(value)
}

type rwlockState<T> struct(value T) {
    v T = value
    lock pthread.pthread_rwlock_t
}

# calls f with the guarded value, read-only, the lock held for reading: other readers may run beside it, a writer waits
fn (l mut RWLock<T>&) Read(f fn(v T&)) {
    s := l.s
    pthread.pthread_rwlock_rdlock(s.lock)
    f(s.v)
    pthread.pthread_rwlock_unlock(s.lock)
}

# calls f with the guarded value, writable, the lock held for writing: nothing else holds it meanwhile
fn (l mut RWLock<T>&) Write(f fn(v mut T&)) {
    s := l.s
    pthread.pthread_rwlock_wrlock(s.lock)
    f(s.v)
    pthread.pthread_rwlock_unlock(s.lock)
}

# the guarded value replaced by f of it, the lock held for writing
fn (l mut RWLock<T>&) Update(f fn(v T) T) {
    s := l.s
    pthread.pthread_rwlock_wrlock(s.lock)
    s.v = f(s.v)
    pthread.pthread_rwlock_unlock(s.lock)
}

# a copy of the guarded value, read under the lock held for reading
fn (l mut RWLock<T>&) Get() T {
    s := l.s
    pthread.pthread_rwlock_rdlock(s.lock)
    v := s.v
    pthread.pthread_rwlock_unlock(s.lock)
    return v
}

# ---- Once ----

# something done at most once however many tasks ask for it: the first Do runs its callback, every later Do - on any
# task - returns at once, and every Do returns only once that first callback has, so what it set up is there to use.
# After the first the cost is one atomic load
type Once struct() {
    s mut onceState& = onceState()
}

type onceState struct() {
    done I32 = 0
    lock pthread.pthread_mutex_t
}

fn (o mut Once&) Do(f fn()) {
    s := o.s
    if s.done.AtomicLoad() == 1 { return }
    pthread.pthread_mutex_lock(s.lock)
    if s.done.AtomicLoad() == 0 {
        f()
        s.done.AtomicStore(1)
    }
    pthread.pthread_mutex_unlock(s.lock)
}

# whether a Do has finished its callback
fn (o mut Once&) Done() Bool { return o.s.done.AtomicLoad() == 1 }

# ---- the tests ----

if TestBuild {

fn bump(m mut Mutex<I64>&, n I64) {
    for i in range n { m.Update(fn(v I64) I64 { return v + 1 }) }
}

test "a Mutex keeps every task's increments" {
    m mut Mutex<I64>& = Mutex(I64(0))
    join {
        for t in range 4 { spawn bump(m, 2000) }
    }
    assert m.Get() == 8000
    m.Set(5)
    m.Update(fn(v I64) I64 { return v * 3 })
    assert m.Get() == 15
}

# a guarded value that is a struct, reached by reference inside With
type counter struct() {
    n I64 = 0
    max I64 = 0
}

fn countTo(m mut Mutex<counter>&, k I64) {
    for i in range k {
        m.With(fn(c mut counter&) {
            c.n++
            if c.n > c.max: c.max = c.n
        })
    }
}

test "With hands the guarded struct over by reference" {
    m mut Mutex<counter>& = Mutex(counter())
    join {
        for t in range 3 { spawn countTo(m, 1000) }
    }
    seen mut Box& = Box()
    m.With(fn(c mut counter&) { seen.n = c.n })
    assert seen.n == 3000 and m.Get().max == 3000
}

# a guarded value that is itself a handle: a copy of the Mutex value is a second name for the same lock
fn pushAll(m mut Mutex<Vec<I64>>&, from I64) {
    for i in range 100 { m.With(fn(l mut Vec<I64>&) { l.Push(from + i) }) }
}

test "a Mutex guards a collection, and a copy of it is the same lock" {
    m mut Mutex<Vec<I64>>& = Mutex(Vec<I64>())
    other mut Mutex<Vec<I64>>& = m
    join {
        spawn pushAll(m, 0)
        spawn pushAll(other, 1000)
    }
    total mut Box& = Box()
    m.With(fn(l mut Vec<I64>&) { total.n = l.Len() })
    assert total.n == 200
}

type Box struct() {
    n I64 = 0
}

fn readMany(l mut RWLock<counter>&, seen mut Box&) {
    for i in range 500 { l.Read(fn(c counter&) { if c.n >= 0: seen.n.AtomicAdd(1) }) }
}

fn writeMany(l mut RWLock<counter>&) {
    for i in range 500 { l.Write(fn(c mut counter&) { c.n += 2 }) }
}

test "an RWLock lets readers share it and a writer have it alone" {
    l mut RWLock<counter>& = RWLock(counter())
    seen mut Box& = Box()
    join {
        spawn readMany(l, seen)
        spawn readMany(l, seen)
        spawn writeMany(l)
    }
    assert l.Get().n == 1000 and seen.n == 1000
    n mut RWLock<I64>& = RWLock(I64(4))
    n.Update(fn(v I64) I64 { return v * v })
    assert n.Get() == 16
}

fn initOnce(o mut Once&, count mut Box&) {
    o.Do(fn() { count.n.AtomicAdd(1) })
}

test "Once runs its callback once, whoever asks first" {
    o mut Once& = Once()
    count mut Box& = Box()
    assert not o.Done()
    join {
        for t in range 8 { spawn initOnce(o, count) }
    }
    assert count.n == 1 and o.Done()
    o.Do(fn() { count.n = 100 })
    assert count.n == 1
}

}
