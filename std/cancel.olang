# cancel - telling tasks to stop. A task is an OS thread, and nothing can stop one safely from outside: killed
# part way, it could leave a mutex locked or a structure half written. So stopping is the task's own decision,
# taken where it is safe, and a Token is the signal it checks. Whoever made the token calls Cancel(); the tasks
# handed it read Cancelled() in their loops, and pass it to anything that waits (chan's RecvUntil/SendUntil),
# which gives up when it fires. A timeout is the same signal, fired by a deadline instead of a call.
# Ordinary olang on top of "extern fn", as chan and io are.

# why a wait gave up
error Stopped {
    CANCELLED
    TIMED_OUT
}

# Linux's clock ids, and a timespec as the two words it is
ClockRealtime I32 = 0
ClockMonotonic I32 = 1
extern fn clock_gettime(clock I32, ts Array<I64>) I32

# now on the monotonic clock, in nanoseconds - never jumps when the wall clock is set
fn NowNs() I64 {
    ts := Array<I64>(2)
    clock_gettime(ClockMonotonic, ts)
    return ts[0] * 1000000000 + ts[1]
}

# the wall clock in nanoseconds - only what pthread_cond_timedwait measures its deadlines against
fn wallNs() I64 {
    ts := Array<I64>(2)
    clock_gettime(ClockRealtime, ts)
    return ts[0] * 1000000000 + ts[1]
}

# a stop signal, with a deadline when deadlineNs (on NowNs's clock) is not 0. The flag is only ever touched
# atomically (P9), since Cancel() runs on one thread while the tasks read it on others; the deadline is fixed
# at construction, before any task can see it.
type Token struct(deadlineNs I64 = 0) {
    flag mut I32 = 0
    deadline I64 = deadlineNs
}

# a token that fires by itself once ms milliseconds have passed - and on Cancel(), like any other
fn After(ms I64) Token& {
    return Token(NowNs() + ms * 1000000)
}

# fires the token: every Cancelled() from now on is true, and every wait given it gives up
fn (t mut Token&) Cancel() {
    t.flag.AtomicStore(1)
}

# true once the token was cancelled or its deadline has passed
fn (t Token&) Cancelled() Bool {
    return t.Why() != 0
}

# 0 while the token has not fired; otherwise 1 when it was cancelled, 2 when its deadline passed
fn (t Token&) Why() I32 {
    if t.flag.AtomicLoad() != 0 { return 1 }
    if t.deadline != 0 and NowNs() >= t.deadline { return 2 }
    return 0
}

# the error a wait gives up with, for a token that has fired
fn (t Token&) Reason() ? Stopped {
    if t.Why() == 1 { error Stopped.CANCELLED }
    error Stopped.TIMED_OUT
}

# the wall-clock time, as a timespec, a wait should next wake at: the deadline if it is near, else soon enough
# to notice a Cancel() - which no wait can be woken for directly, since the token does not know who is waiting
PollNs I64 = 10000000
fn (t Token&) WakeAt(ts mut Array<I64>&) {
    wait I64 = PollNs
    if t.deadline != 0 {
        left I64 = t.deadline - NowNs()
        if left < wait { wait = left }
        if wait < 0 { wait = 0 }
    }
    at I64 = wallNs() + wait
    ts[0] = at / 1000000000
    ts[1] = at % 1000000000
}

test "a token fires on Cancel, and not before" {
    t Token& = Token()
    assert not t.Cancelled()
    t.Cancel()
    assert t.Cancelled()
    try t.Reason() catch Stopped.CANCELLED { done } catch { fail }
}

# timed from before the token is made, so the bounds hold however long this thread is kept off a core: it has not
# fired unless its whole 20ms has passed, and once it fires they have
test "a token with a deadline fires by itself" {
    start := NowNs()
    t := After(20)
    assert not t.Cancelled() or NowNs() - start >= 20000000
    for not t.Cancelled() { }
    assert NowNs() - start >= 20000000
    try t.Reason() catch Stopped.TIMED_OUT { done } catch { fail }
}

# a task doing work checks the token itself, at points where stopping is safe. It counts atomically, so the spawner
# may watch the count while it runs (P9a)
fn spin(t Token&, n mut spinCount&) {
    for not t.Cancelled() { n.v.AtomicAdd(1) }
}

type spinCount struct() {
    v mut I64 = 0
}

# the Cancel waits until the task has done some work: a task need not have started by any particular time, and one
# cancelled before its first look at the token rightly does nothing - which, waited for only by a clock, made this
# test fail whenever the machine was busy enough to keep the task off a core for those milliseconds
test "a busy task stops when the token is cancelled" {
    t Token& = Token()
    n spinCount& = spinCount()
    join {
        spawn spin(t, n)
        for n.v.AtomicLoad() < 1000 { }
        t.Cancel()
    }
    assert n.v >= 1000
}

# S19a: a join block's deferred code runs as its last statements, before the block's end waits for its tasks - so a
# deferred Cancel() is what lets a worker stop, however the block is left, an error included. The worker records what
# stopped it: 1 the Cancel, 2 its deadline - which would mean the join had waited the deadline out first.
error stepFailed {
    BAD
}
type stopCount struct() {
    v mut I64 = 0
    why mut I32 = 0
}
fn spinRecord(t Token&, n mut stopCount&) {
    for not t.Cancelled() { n.v++ }
    n.why = t.Why()
}
fn cancelOnExit(fails Bool, n mut stopCount&) ? stepFailed {
    t := After(5000)
    join {
        defer t.Cancel()
        spawn spinRecord(t, n)
        if fails { error stepFailed.BAD }
    }
}

test "a deferred Cancel lets a join block's tasks stop, on an error too" {
    n stopCount& = stopCount()
    try cancelOnExit(false, n) catch { fail }
    assert n.why == 1
    m stopCount& = stopCount()
    try cancelOnExit(true, m) catch stepFailed { }
    assert m.why == 1
}
