# cancel - telling tasks to stop. A task is an OS thread, and nothing can stop one safely from outside: killed
# part way, it could leave a mutex locked or a structure half written. So stopping is the task's own decision,
# taken where it is safe, and a Token is the signal it checks. Whoever made the token calls Cancel(); the tasks
# handed it read Cancelled() in their loops, and pass it to anything that waits (chan's RecvUntil/SendUntil),
# which gives up when it fires. A timeout is the same signal, fired by a deadline instead of a call.
# Ordinary olang over the C library's time.h imported (§11 X17), as chan and io are.

import ctime "time.h"
import pthread "pthread.h"
import unistd "unistd.h"
import "time"

# why a wait gave up
type Stopped error {
    Cancelled
    TimedOut
}

# Linux's clock ids
ClockRealtime I32 = 0
ClockMonotonic I32 = 1

# now on the monotonic clock, in nanoseconds - never jumps when the wall clock is set; inside time.Virtual the virtual
# clock, so a deadline fires on it
fn NowNs() I64 { return time.Now() }

# the wall clock in nanoseconds - only what pthread_cond_timedwait measures its deadlines against
fn wallNs() I64 {
    ts := ctime.timespec()
    ctime.clock_gettime(ClockRealtime, ts)
    return ts.tv_sec * 1000000000 + ts.tv_nsec
}

# a stop signal, with a deadline when deadlineNs (on NowNs's clock) is not 0. The flag is only ever touched
# atomically (P9), since Cancel() runs on one thread while the tasks read it on others; the deadline is fixed
# at construction, before any task can see it.
type Token struct(deadlineNs I64 = 0) {
    flag I32 = 0
    deadline I64 = deadlineNs
}

# a token that fires by itself once ms milliseconds have passed - and on Cancel(), like any other
fn Token.After(ms I64) mut Token& {
    return Token(NowNs() + ms * 1000000)
}

# fires the token: every Cancelled() from now on is true, and every wait given it gives up
fn (t mut Token&) Cancel() {
    t.flag.AtomicStore(1)
    wakeAll()
}

# true once the token was cancelled or its deadline has passed
fn (t Token&) Cancelled() Bool {
    return t.Why() != 0
}

# 0 while the token has not fired; otherwise 1 when it was cancelled, 2 when its deadline passed
fn (t Token&) Why() I32 {
    if t.flag.AtomicLoad() != 0: return 1
    if t.deadline != 0 and NowNs() >= t.deadline: return 2
    return 0
}

# the error a wait gives up with, for a token that has fired
fn (t Token&) Reason() ? Stopped {
    if t.Why() == 1: error Stopped.Cancelled
    error Stopped.TimedOut
}

# ---- waits a Cancel() wakes ----
#
# A wait given a token blocks until what it waits for comes, the deadline passes or Cancel() is called - with no
# periodic wakeup. A thread can block on one thing only (a condition variable, or poll(2)'s set of descriptors), so
# whatever may end the wait has to reach that one thing. Each blocked wait is a WAITER: a mutex, a condition
# variable and a flag of its own, and for a wait in poll() an eventfd. Cancel() wakes every waiter blocked, whatever its
# token - each looks at its own and sleeps again if that has not fired: a token carries nothing that tells it apart
# (a number from a counter would be a global its constructor writes, and leave Token with no zero value, D13c), and a
# Cancel() is an event, not a timer, so no wait wakes while nothing happens. The thing waited on (a channel) keeps the
# numbers of the waiters parked on it and wakes them as it changes. Waiters live in one table for the program's life -
# never moved, never freed, reused once let go - so a waiter is named by its number and nothing holds a reference into
# anyone's scope.
#
# Locks are taken in one order only: what is waited on (a channel's lock), then the table's, then a waiter's. Cancel()
# takes the table's lock and wakes each waiter under its own; Wake takes the table's lock only to find the waiter. A
# waiter's flag is cleared (Rearm) while the condition it waits for is checked under the waited-on lock, and set by
# every wake after that - so a wake between the check and the sleep is never lost.

type waiter struct() {
    lock pthread.pthread_mutex_t
    cond pthread.pthread_cond_t
    woken I32 = 0
    used Bool = false   # given to a wait
    fd I32 = -1         # an eventfd a wake writes to, for a wait in poll(); -1 for none
}

tableLock mut pthread.pthread_mutex_t = pthread.pthread_mutex_t()
table mut Vec<mut waiter&> = Vec<mut waiter&>()

# the waiter numbered w, found under the table's lock
fn waiter.at(w I64) mut waiter& {
    pthread.pthread_mutex_lock(tableLock)
    x := table[w]
    pthread.pthread_mutex_unlock(tableLock)
    return x
}

# a waiter for a wait on a token, which Cancel() wakes, its flag clear: its number, for Rearm, Sleep and Done. fd,
# when not -1, is an eventfd every wake writes to as well, for a wait in poll(); it stays the caller's to close, after
# Done. Taken while the waited-on lock is held, before the condition is checked again
fn Park(fd I32 = -1) I64 {
    pthread.pthread_mutex_lock(tableLock)
    w I64 = -1
    for i in range table.Len() {
        if not table[i].used {
            w = i
            break
        }
    }
    if w < 0 {
        table.Push(waiter())
        w = table.Len() - 1
    }
    x := table[w]
    x.used = true
    pthread.pthread_mutex_lock(x.lock)
    x.woken = 0
    x.fd = fd
    pthread.pthread_mutex_unlock(x.lock)
    pthread.pthread_mutex_unlock(tableLock)
    return w
}

# the waiter let go: no wake reaches it any more, and its number may be given to another wait
fn Done(w I64) {
    pthread.pthread_mutex_lock(tableLock)
    x := table[w]
    pthread.pthread_mutex_lock(x.lock)
    x.fd = -1
    pthread.pthread_mutex_unlock(x.lock)
    x.used = false
    pthread.pthread_mutex_unlock(tableLock)
}

# the waiter's flag cleared, before what it waits for is checked again
fn Rearm(w I64) {
    x := waiter.at(w)
    pthread.pthread_mutex_lock(x.lock)
    x.woken = 0
    pthread.pthread_mutex_unlock(x.lock)
}

# wakes the waiter w: its Sleep returns, its eventfd turns readable
fn Wake(w I64) { wake(waiter.at(w)) }

fn wake(x mut waiter&) {
    pthread.pthread_mutex_lock(x.lock)
    x.woken = 1
    pthread.pthread_cond_signal(x.cond)
    if x.fd >= 0 {
        one := Array<U64>[1]
        unistd.write(x.fd, one, 8)
    }
    pthread.pthread_mutex_unlock(x.lock)
}

# every waiter given to a wait woken
fn wakeAll() {
    pthread.pthread_mutex_lock(tableLock)
    for x in table {
        if x.used: wake(x)
    }
    pthread.pthread_mutex_unlock(tableLock)
}

# blocks until the waiter w is woken (Wake or Cancel()) or the token's deadline passes - waking for nothing else. Inside
# time.Virtual the deadline is reached at once - the virtual clock moved to it - and what the wait waits for is given a
# millisecond of real time to come first
fn (t Token&) Sleep(w I64) {
    x := waiter.at(w)
    ts := Array<I64>(2)
    pthread.pthread_mutex_lock(x.lock)
    if t.deadline != 0 and time.IsVirtual() {
        time.Reach(t.deadline)
        wallAt(wallNs() + 1000000, ts)
        for x.woken == 0 {
            if pthread.pthread_cond_timedwait(x.cond, x.lock, ts) != 0: break
        }
        pthread.pthread_mutex_unlock(x.lock)
        return
    }
    for x.woken == 0 and t.Why() == 0 {
        if t.deadline == 0 {
            pthread.pthread_cond_wait(x.cond, x.lock)
            continue
        }
        wallAt(wallNs() + t.deadline - NowNs(), ts)
        pthread.pthread_cond_timedwait(x.cond, x.lock, ts)
    }
    pthread.pthread_mutex_unlock(x.lock)
}

# the nanoseconds left until the token's deadline, for a wait elsewhere (poll's timeout): -1 for none, 0 once it has
# passed. Inside time.Virtual the deadline is reached at once, and a millisecond is left for what the wait waits for
fn (t Token&) LeftNs() I64 {
    if t.deadline != 0 and time.IsVirtual() {
        time.Reach(t.deadline)
        return 1000000
    }
    if t.deadline == 0: return -1
    left := t.deadline - NowNs()
    return left if left > 0 else 0
}

# a wall-clock reading, as pthread_cond_timedwait's timespec
fn wallAt(ns I64, ts mut Array<I64>&) {
    ts[0] = ns / 1000000000
    ts[1] = ns % 1000000000
}

test "a token fires on Cancel, and not before" {
    t mut Token& = Token()
    assert not t.Cancelled()
    t.Cancel()
    assert t.Cancelled()
    try t.Reason() catch Stopped.Cancelled { return }
}

# timed from before the token is made, so the bounds hold however long this thread is kept off a core: it has not
# fired unless its whole 20ms has passed, and once it fires they have
test "a token with a deadline fires by itself" {
    start := NowNs()
    t := Token.After(20)
    assert not t.Cancelled() or NowNs() - start >= 20000000
    for not t.Cancelled() { }
    assert NowNs() - start >= 20000000
    try t.Reason() catch Stopped.TimedOut { return }
}

# inside time.Virtual a deadline fires on the virtual clock: when a task sleeps past it, and at once for a wait
test Token.After "a deadline fires on the virtual clock" {
    time.Virtual(fn() {
        t := Token.After(20000)
        assert not t.Cancelled()
        time.Sleep(time.Duration.Seconds(19))
        assert not t.Cancelled()
        time.Sleep(time.Duration.Seconds(1))
        assert t.Cancelled()
        u := Token.After(500)
        assert u.LeftNs() == 1000000
        assert u.Cancelled()
    })
}

# a task doing work checks the token itself, at points where stopping is safe. It counts atomically, so the spawner
# may watch the count while it runs (P9a)
fn spin(t Token&, n mut spinCount&) {
    for not t.Cancelled(): n.v.AtomicAdd(1)
}

type spinCount struct() {
    v I64 = 0
}

# the Cancel waits until the task has done some work: a task need not have started by any particular time, and one
# cancelled before its first look at the token rightly does nothing - which, waited for only by a clock, made this
# test fail whenever the machine was busy enough to keep the task off a core for those milliseconds
test "a busy task stops when the token is cancelled" {
    t mut Token& = Token()
    n mut spinCount& = spinCount()
    join {
        spawn spin(t, n)
        for n.v.AtomicLoad() < 1000 { }
        t.Cancel()
    }
    assert n.v >= 1000
}

# S19a: a join block's deferred code runs as its last statements, before the block's end waits for its tasks - so a
# deferred Cancel() is what lets a worker stop, however the block is left, an error included. The worker records what
# stopped it: 1 the Cancel, 2 its deadline - which would mean the join had waited the deadline out first.
type stepFailed error {
    Bad
}
type stopCount struct() {
    v I64 = 0
    why I32 = 0
}
fn spinRecord(t Token&, n mut stopCount&) {
    for not t.Cancelled(): n.v++
    n.why = t.Why()
}
fn cancelOnExit(fails Bool, n mut stopCount&) ? stepFailed {
    t := Token.After(5000)
    join {
        defer: t.Cancel()
        spawn spinRecord(t, n)
        if fails: error stepFailed.Bad
    }
}

test "a deferred Cancel lets a join block's tasks stop, on an error too" {
    n mut stopCount& = stopCount()
    try cancelOnExit(false, n)
    assert n.why == 1
    m mut stopCount& = stopCount()
    try cancelOnExit(true, m) catch stepFailed { }
    assert m.why == 1
}
