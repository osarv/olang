# sha1 - the SHA-1 digest (FIPS 180-4): 20 bytes. SHA-1 is BROKEN for collision resistance: never use it where an
# attacker could choose the input (signatures, certificates, content addressing of untrusted data). It remains in use
# where the protocol fixes it: the WebSocket handshake (RFC 6455), git object names, HMAC-SHA1 in older protocols.
# Sum takes the digest of bytes held whole, Hex writes it as text; a Hasher takes one of bytes given a piece at a
# time; Hmac is the keyed digest of RFC 2104. Ordinary olang - U32 arithmetic wrapping as SHA-1's does.
# Imported with `import "std/sha1"`.

import "hex"

fn rotl(x U32, n U32) U32 { return (x << n) | (x >> (32 - n)) }

# the digest of bytes given a piece at a time: "h := sha1.Hasher()", then "h.Push(piece)" for each piece, then
# "h.Sum()" - the digest Sum gives of the pieces joined. A copy of a Hasher is a hasher of its own, as it stands
type Hasher struct() {
    state := Array<U32>[0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0]
    buf := Array<U8>(64)
    used I64 = 0                                   # bytes in buf
    total I64 = 0                                  # bytes pushed in all
}

# one 64-byte block of data, from byte at, folded into the state
fn (h mut Hasher&) block(data Array<U8>&, at I64) {
    w := Array<U32>(80)
    for i in range 16 {
        j := at + 4 * i
        w[i] = (U32(data[j]) << 24) | (U32(data[j + 1]) << 16) | (U32(data[j + 2]) << 8) | U32(data[j + 3])
    }
    for i in range 16, 80: w[i] = rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1)
    a := h.state[0]
    b := h.state[1]
    c := h.state[2]
    d := h.state[3]
    e := h.state[4]
    for i in range 80 {
        f U32 = 0
        kk U32 = 0
        if i < 20 {
            f = (b & c) | (~b & d)
            kk = 0x5a827999
        } else if i < 40 {
            f = b ^ c ^ d
            kk = 0x6ed9eba1
        } else if i < 60 {
            f = (b & c) | (b & d) | (c & d)
            kk = 0x8f1bbcdc
        } else {
            f = b ^ c ^ d
            kk = 0xca62c1d6
        }
        t := rotl(a, 5) + f + e + kk + w[i]
        e = d
        d = c
        c = rotl(b, 30)
        b = a
        a = t
    }
    h.state[0] += a
    h.state[1] += b
    h.state[2] += c
    h.state[3] += d
    h.state[4] += e
}

# data added to what the digest is taken of
fn (h mut Hasher&) Push(data Array<U8>&) {
    h.total += data.Len()
    i I64 = 0
    if h.used > 0 {
        for i < data.Len() and h.used < 64 {
            h.buf[h.used] = data[i]
            h.used++
            i++
        }
        if h.used < 64: return
        h.block(h.buf, 0)
        h.used = 0
    }
    for i + 64 <= data.Len() {
        h.block(data, i)
        i += 64
    }
    for i < data.Len() {
        h.buf[h.used] = data[i]
        h.used++
        i++
    }
}

# the digest of everything pushed so far, 20 bytes; the Hasher is left as it was
fn (h Hasher&) Sum() Array<U8> {
    c Hasher = h
    bits := U64(h.total) * 8
    c.Push(Array<U8>(1, 0x80))
    zero := Array<U8>(1)
    for c.used != 56: c.Push(zero)
    tail := Array<U8>(8)
    for i in range 8: tail[i] = U8((bits >> U64(56 - 8 * i)) & 0xFF)
    c.Push(tail)
    out := Array<U8>(20)
    for i in range 5 {
        v := c.state[i]
        out[4 * i] = U8(v >> 24)
        out[4 * i + 1] = U8((v >> 16) & 0xFF)
        out[4 * i + 2] = U8((v >> 8) & 0xFF)
        out[4 * i + 3] = U8(v & 0xFF)
    }
    return out
}

# the digest of data, 20 bytes
fn Sum(data Array<U8>&) Array<U8> {
    h := Hasher()
    h.Push(data)
    return h.Sum()
}

# the digest of data as 40 lowercase hex digits, as sha1sum writes it
fn Hex(data Array<U8>&) String { return hex.Encode(Sum(data)) }

# HMAC-SHA1 of the pieces of data together, keyed by key (RFC 2104), 20 bytes
fn Hmac(key Array<U8>&, data ...Array<U8>&) Array<U8> {
    block := Array<U8>(64)
    if key.Len() > 64 {
        h := Sum(key)
        for i in range 20: block[i] = h[i]
    } else {
        for i in range key.Len(): block[i] = key[i]
    }
    inner := Hasher()
    outer := Hasher()
    pad := Array<U8>(64)
    for i in range 64: pad[i] = block[i] ^ 0x36
    inner.Push(pad)
    for d in data: inner.Push(d)
    for i in range 64: pad[i] = block[i] ^ 0x5c
    outer.Push(pad)
    outer.Push(inner.Sum())
    return outer.Sum()
}

if TestBuild {

test "the FIPS 180-4 test vectors" {
    assert Hex("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709"
    assert Hex("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d"
    assert Hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") == "84983e441c3bd26ebaae4aa1f95129e5e54670f1"
}

test "the WebSocket handshake accept key (RFC 6455 1.3)" {
    assert Sum("dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11") ==
        hex.Decode("b37a4f2cc0624f1690f64606cf385945b2bec4ea")!
}

test Hmac "RFC 2202's test vectors, the data whole or in pieces" {
    assert hex.Encode(Hmac(Array<U8>(20, 0x0b), "Hi There")) == "b617318655057264e28bc0b6fb378c8ef146be00"
    assert hex.Encode(Hmac("Jefe", "what do ya want ", "for nothing?")) == "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79"
    assert hex.Encode(Hmac(Array<U8>(80, 0xaa), "Test Using Larger Than Block-Size Key - Hash Key First")) ==
        "aa4ae5e15272d00e95705637ce8a3b55ed402112"
}

test "a Hasher fed in pieces gives the digest of the whole" {
    big := Array<U8>(1000000, 'a')
    assert hex.Encode(Sum(big)) == "34aa973cd4c4daa4f61eeb2bdbad27316534016f"
    h := Hasher()
    for n in Array<I64>[1, 63, 64, 65, 7, 128, 200]: h.Push(big[:n])
    whole := Sum(big[:1 + 63 + 64 + 65 + 7 + 128 + 200])
    assert h.Sum() == whole and h.Sum() == whole
}

}
