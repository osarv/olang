# csv - comma-separated values (RFC 4180): a text's records read one at a time, and records written. Ordinary olang:
# no extern, so it runs while compiling (K1) and under -i as in a built program.
#
#     for row in try csv.Rows(text) {
#         name := row[0]
#         price := try row[2].ParseFloat()
#         ...
#     } catch csv.Error { ... }
#
#     out.Write(csv.Record(name, $count, $price.Fixed(2)))
#
# A record is fields separated by a separator - ',' unless another is given (csv.Rows(text, ';'), '\t' for TSV) - and
# ends at a line break: "\n", or "\r\n", the carriage return dropped; one just before the end of the text goes too, as
# String.Lines drops it. A field may be quoted: "a, b" is the field a, b, and inside quotes the separator, line breaks
# and a doubled quote ("" for ") are text. The last record needs no line break after it, and an empty line is a record
# of one empty field - so "a\n" is one record and "a\n\nb" three; the empty text has none. A record's fields are as
# many as it has: a reader wanting every record the same width checks row.Len() itself.
#
# Strict, as RFC 4180 is: a quote inside a field that does not start with one (a"b), text after a field's closing quote
# ("a"b) and a quote never closed are errors (Error), never read some way of the reader's choosing.
#
# Where a field lives: each row Next gives is an array built where its caller puts it (§8.5) - in "for row in", the
# loop body's own scope, reclaimed as each turn ends. A field that is the text as written - unquoted, or quoted with
# no doubled quote in it - is a slice of the text, copying nothing; one holding a doubled quote is new text built where
# the row is. To keep a field past its turn, put a copy where it is to be kept: kept.Push($row[0]) (O8c).
#
# A file is read whole with os.ReadFile and its text handed to Rows - fields can then borrow it. Records are written by
# Record, one line of text each, to wherever text goes (an io.Writer, a StringBuilder).

# why a text is not CSV
type Error error {
    BareQuote          # a quote inside a field that does not start with one: a"b - quote the field, "a""b"
    TextAfterQuote    # something other than a separator or a line break after a field's closing quote: "a"b
    BadSeparator       # a separator that is a quote or a line break, which could never be told apart from the text
    UnclosedQuote      # the text ends inside a quoted field
    NoColumn           # Decode: the header names no column for a parameter with no default
    BadValue           # Decode: a field that is no value of its column's type (a number, a Bool, a Char)
}

# a text's records, one at a time: "for row in try csv.Rows(text) { ... } catch csv.Error { ... }". Each is an
# Array<String&> of its fields. Line is where the record Next last gave - or failed on - starts, counted from 1, so a
# reader calling Next itself can say where a text went wrong ("for row in" walks a copy of the Rows it is given):
#
#     rows := csv.Rows(text)
#     for {
#         row := try rows.Next() catch Exhausted { break } catch csv.Error { io.PrintErrln("line " $rows.Line); fail }
#         ...
#     }
type Rows struct(of String&, sep Char = ',') {
    text String&of = of
    sep
    at I64 = 0                       # where the next record starts
    Line I64 = 0
    next I64 = 1                     # the line the next record starts on
}

# the next record's fields - failing with Exhausted when the text has no more, and with Error when the next one is
# not CSV, the reader then staying where it was
fn (r mut Rows&) Next() Array<String&> ? Error, Exhausted {
    if r.sep == '"' or r.sep == '\n' or r.sep == '\r' { error Error.BadSeparator }
    t := r.text
    n I64 = t.Len()
    if r.at >= n { error Exhausted.End }
    r.Line = r.next
    count I64 = 1                    # first the fields are counted, and the record checked, so the row is made once
    i I64 = try fieldEnd(t, r.at, r.sep)
    for i < n and t[i] == r.sep {
        count++
        i = try fieldEnd(t, i + 1, r.sep)
    }
    row := Array<String&>(count, "")
    lines I64 = 1
    i = r.at
    for k in range count {
        e := try fieldEnd(t, i, r.sep) catch { unreachable }   # checked by the count above
        if t[i] == '"' if i < n else false {
            inner := t[i + 1:e - 1]
            quotes I64 = 0
            for c in inner {
                if c == '"' { quotes++ }
                if c == '\n' { lines++ }
            }
            row[k] = inner if quotes == 0 else unquote(inner, quotes / 2)
        } else {
            last I64 = e
            if last > i and t[last - 1] == '\r' and (last == n or t[last] == '\n') { last-- }
            row[k] = t[i:last]
        }
        i = e + 1
    }
    i--                              # at the record's end: its line break, or the text's end
    if i < n and t[i] == '\r' { i++ }
    if i < n and t[i] == '\n' { i++ }
    r.at = i
    r.next += lines
    return row
}

# where the field starting at t[i] ends: just past its closing quote, or at the separator, line break or text end
# after it - checking that it is CSV
fn fieldEnd(t String&, i I64, sep Char) I64 ? Error {
    n I64 = t.Len()
    if i < n and t[i] == '"' {
        j I64 = i + 1
        for {
            if j >= n { error Error.UnclosedQuote }
            if t[j] == '"' {
                if j + 1 < n and t[j + 1] == '"' {
                    j += 2
                    continue
                }
                break
            }
            j++
        }
        j++                          # past the closing quote: a separator, a line break or the end must follow
        if j < n and t[j] != sep and t[j] != '\n' and not (t[j] == '\r' and (j + 1 == n or t[j + 1] == '\n')) {
            error Error.TextAfterQuote
        }
        return j
    }
    j I64 = i
    for j < n and t[j] != sep and t[j] != '\n' {
        if t[j] == '"' { error Error.BareQuote }
        j++
    }
    return j
}

# the inside of a quoted field holding "pairs" doubled quotes, each made one: new text
fn unquote(inner String&, pairs I64) String {
    out := String(Array<Char>(inner.Len() - pairs))
    w I64 = 0
    i I64 = 0
    for i < inner.Len() {
        out[w] = inner[i]
        w++
        i += 2 if inner[i] == '"' else 1
    }
    return out
}

# the fields as one record: separated by sep, ending with "\n", each quoted when it must be - when it holds the
# separator, a quote or a line break - with its quotes doubled. Other fields are written as they are, so
# Record("a", "b c", "say \"hi\"") is a,b c,"say ""hi"""\n. No fields at all is "\n", which reads back as
# one empty field - CSV has no record of none. New text, built at its length once, where its result is put
fn Record(fields ...String&, sep Char = ',') String ? Error {
    if sep == '"' or sep == '\n' or sep == '\r' { error Error.BadSeparator }
    n I64 = fields.Len() if fields.Len() > 0 else 1    # the separators and the line break
    for f in fields {
        n += f.Len()
        if quoted(f, sep) { n += 2 + f.CountOf("\"") }
    }
    out := String(Array<Char>(n))
    w I64 = 0
    for k, f in fields {
        if k > 0 {
            out[w] = sep
            w++
        }
        q := quoted(f, sep)
        if q {
            out[w] = '"'
            w++
        }
        for c in f {
            out[w] = c
            w++
            if c == '"' {
                out[w] = '"'
                w++
            }
        }
        if q {
            out[w] = '"'
            w++
        }
    }
    out[w] = '\n'
    return out
}

# ---- records as structs (G39, G40) ----
#
# A struct's fields are columns, by reflection while compiling: each of text (String, String&), a Char, a Bool or a
# number, written as "$" writes it. A column is named by its field's or its constructor parameter's name (a field
# punning one has its attributes), or by "@csv.Column("name")" written on it; "@csv.Skip" leaves a field out.
#
#     type Item struct(Name String&, @csv.Column("price") Cost F64, @csv.Skip Note String& = "") { Name, Cost, Note }
#     text := try csv.Encode(items)                 # Name,price\npen,1.5\n - Header, then a RecordOf each
#     items := try csv.Decode<Item>(text)           # a Vec<Item>, by the header's names

# a column's name, written on a field or a constructor's parameter (G39)
type Column struct(Name String&) [Name.Len() > 0] ? { Name }

# a field that is no column (G39): never written, and read back its parameter takes its default
type Skip struct() { }

# the column a field or a parameter is: its own "@csv.Column", else its name
fn columnOf<F>(f F) String& {
    if f.HasAttr<Column>() { return $(f.Attr<Column>()!).Name }
    return $f.Name
}

# T's columns as a record: the header a text of T's records begins with
fn Header<T>(sep Char = ',') String ? Error {
    assert T.Kind == TypeKind.Struct, "csv writes a struct's fields as columns"
    names Vec<String&>
    for f in T.Fields {
        if not f.HasAttr<Skip>() { names.Push(columnOf(f)) }
    }
    return try Record(...names.ToArray(), sep = sep)
}

# the records of xs, after their header: a text Decode reads back
fn Encode<T>(xs Array<T>&, sep Char = ',') String ? Error {
    b := StringBuilder()
    b.Push(try Header<T>(sep))
    for x in xs { b.Push(try RecordOf(x, sep)) }
    return b.ToString()
}

# v's fields as a record, in Header's columns
fn RecordOf<T>(v T, sep Char = ',') String ? Error {
    assert T.Kind == TypeKind.Struct, "csv writes a struct's fields as columns"
    fs Vec<String&>
    for f in T.Fields {
        if not f.HasAttr<Skip>() { fs.Push(cell(f.Of(v))) }
    }
    return try Record(...fs.ToArray(), sep = sep)
}

# a field's text: text as it is, a number, a Bool or a Char as "$" writes it
fn cell<V>(x V) String {
    match V {
        case String, String& { return $x }
        case Char, Bool { return $x }
        case _ {
            assert V.Kind == TypeKind.Integer or V.Kind == TypeKind.Float, "a csv column is text, a Char, a Bool or a number"
            return $x
        }
    }
}

# the records of a text whose first is its header, each built as a T through its constructor (G37): a parameter from
# the column its name (or "@csv.Column") names, read as its type; a column missing, or a parameter "@csv.Skip" leaves out,
# its default. Fails with what Rows fails with, NoColumn where a parameter with no default has no column and BadValue
# where a field is no value of its type - and with what the constructor fails with
fn Decode<T>(text String&, sep Char = ',') Vec<T> ? {
    assert T.Kind == TypeKind.Struct, "csv reads a struct's fields as columns"
    out Vec<T>
    rows := Rows(text, sep)
    header := try rows.Next() catch Exhausted { return out }
    for {
        row := try rows.Next() catch Exhausted { break }
        out.Push(try T(try argument(header, row, p) for p in T.Params))
    }
    return out
}

# a constructor parameter's argument from a record: its column's field, read as its type, else its default
fn argument<P>(header Array<String&>&, row Array<String&>&, p P) P.Type ? Error {
    if p.HasAttr<Skip>() {
        assert p.HasDefault, "a parameter csv.Skip leaves out takes its default, and this one has none"
        return p.Default
    } else {
        name := columnOf(p)
        at I64 = -1
        for i, h in header {
            if h == name and at < 0 { at = i }
        }
        if at < 0 or at >= row.Len() {
            if p.HasDefault { return p.Default }
            error Error.NoColumn
        }
        if P.Type.Kind == TypeKind.Reference {
            # text read as new text and moved where the argument lands (O26a), as json's member does
            v := try value<P.Type.Target>(row[at])
            return v
        } else {
            return try value<P.Type>(row[at])
        }
    }
}

# a field read as a value of type V
fn value<V>(f String&) V ? Error {
    match V {
        case String { return $f }
        case Bool {
            if f == "true" { return true }
            if f == "false" { return false }
            error Error.BadValue
        }
        case Char {
            if f.Len() != 1 { error Error.BadValue }
            return f[0]
        }
        case _ {
            if V.Kind == TypeKind.Integer {
                return V(try f.ParseAs<V.Base>() catch ParseError { error Error.BadValue })
            } else {
                assert V.Kind == TypeKind.Float, "a csv column is text, a Char, a Bool or a number"
                return V(V.Base(try f.ParseFloat() catch ParseError { error Error.BadValue }))
            }
        }
    }
}

# whether a field must be quoted to be read back as itself
fn quoted(f String&, sep Char) Bool {
    for c in f {
        if c == sep or c == '"' or c == '\n' or c == '\r' { return true }
    }
    return false
}

# the records of a text, each field in brackets and each record ended by a bar - or the error's word - for the tests
fn show(text String&, sep Char = ',') String& {
    b := StringBuilder()
    for row in try Rows(text, sep) {
        for f in row {
            b.PushChar('[')
            b.Push(f)
            b.PushChar(']')
        }
        b.PushChar('|')
    } catch Error.BareQuote {
        return "bare"
    } catch Error.TextAfterQuote {
        return "after"
    } catch Error.UnclosedQuote {
        return "open"
    } catch Error.BadSeparator {
        return "separator"
    }
    return b.ToString()
}

test "Rows reads fields, separators and line breaks" {
    assert (show("a,b,c\n1,2,3\n")) == "[a][b][c]|[1][2][3]|"
    assert (show("a,b\r\nc,d\r\n")) == "[a][b]|[c][d]|"                  # CRLF
    assert (show("a,b\nc,d")) == "[a][b]|[c][d]|"                        # no line break after the last
    assert (show("a\r")) == "[a]|"                                       # a CR before the end goes with it
    assert (show("")) == ""
    assert (show("\n")) == "[]|"                                         # an empty line: one empty field
    assert (show("a\n\nb")) == "[a]|[]|[b]|"
    assert (show(",,")) == "[][][]|"
    assert (show("a\rb,c\n")) == "[a\rb][c]|"                            # a CR not before a LF is text
    assert (show("a;b,c\n", ';')) == "[a][b,c]|"
    assert (show("a\tb\n", '\t')) == "[a][b]|"
}

test "Rows reads quoted fields: separators, line breaks and doubled quotes inside" {
    assert (show("\"a, b\",c\n")) == "[a, b][c]|"
    assert (show("\"say \"\"hi\"\"\",x")) == "[say \"hi\"][x]|"
    assert (show("\"two\nlines\",x\ny,z")) == "[two\nlines][x]|[y][z]|"
    assert (show("\"\",\"\"\"\"\n")) == "[][\"]|"
    assert (show("\"a\"\r\n\"b\"")) == "[a]|[b]|"
    assert (show("\"a\"\r")) == "[a]|"
    assert (show("x,\"\r\n\"\n")) == "[x][\r\n]|"                       # a CRLF inside quotes is text
}

test "Rows reports what is not CSV, and where" {
    assert show("a\"b,c\n") == "bare" and show("x\ny \"q\"") == "bare"
    assert show("\"a\"b,c\n") == "after" and show("\"a\"\rb\n") == "after" and show("\"a\" ,b") == "after"
    assert show("a,\"b\n") == "open" and show("\"") == "open"
    rows := Rows("h,i\n\"x\ny\",1\nz,2\nbad\"\n")
    n I64 = 0
    for {
        row := try rows.Next() catch Exhausted { break } catch Error.BareQuote {
            assert rows.Line == 5 and n == 3
            n = -1
            break
        }
        assert rows.Line == I64[1, 2, 4][n] and row.Len() == 2
        n++
    }
    assert n == -1
}

test "fields borrow the text unless a doubled quote must be made one" {
    text := "plain,\"quoted\",\"dou\"\"bled\"\n"
    for row in try Rows(text) {
        assert row[0] == "plain" and row[1] == "quoted" and row[2] == "dou\"bled"
    }
}

test "Record quotes what must be, and Rows reads it back" {
    assert try Record("a", "b c", "say \"hi\"") == "a,b c,\"say \"\"hi\"\"\"\n"
    assert try Record("x,y", "two\nlines", "", "cr\r") == "\"x,y\",\"two\nlines\",,\"cr\r\"\n"
    assert try Record("a;b", "c,d", sep = ';') == "\"a;b\";c,d\n"
    assert try Record(...Array<String&>(0)) == "\n"
    fields := String&["", "\"", "a,\"b\"\r\nc", " lead", "x"]
    text := try Record(...fields)
    for row in try Rows(text) {
        assert row.Len() == 5
        for k in range 5 { assert row[k] == fields[k] }
    }
}

# a table read while compiling (K2): rows counted and a field summed
fn csvTotal(text String&) I64 ? Error, ParseError {
    total I64 = 0
    for row in try Rows(text) {
        total = total * 10 + (try row[1].ParseInt())
    }
    return total
}
csvTotalBaked I64 = try csvTotal("a,1\n\"b,\"\"c\"\"\",2\nd,3") catch default -1

test "Rows read while compiling as at run time" {
    assert csvTotalBaked == 123 and (try csvTotal("a,1\n\"b,\"\"c\"\"\",2\nd,3") catch default -1) == csvTotalBaked
}

# a struct of columns (G39): one renamed, one left out, a pun having its parameter's attributes
type item struct(Name String&, @Column("price") Cost F64, Count I64 = 1, @Skip Note String& = "-", Fresh Bool = true) {
    Name
    Cost
    Count
    Note
    Fresh
}

itemsBaked String = try Encode(item[item("pen", 1.5, 3, "x")]) catch default ""

test Decode "records read as structs by their header's names, written back by Encode" {
    assert itemsBaked == "Name,price,Count,Fresh\npen,1.5,3,true\n"
    assert $(try Header<item>()) $(try RecordOf(item("pen", 1.5, 3, "x"))) == itemsBaked
    xs := try Decode<item>("price,Name,Fresh\n2.25,ink,false\n0.5,\"a, b\",true\n")
    assert xs.Len() == 2 and xs[0].Name == "ink" and xs[0].Cost == 2.25 and not xs[0].Fresh and xs[0].Count == 1
    assert xs[1].Name == "a, b" and xs[1].Note == "-"
    assert (try RecordOf(xs[1])) == "\"a, b\",0.5,1,true\n"
    assert (try Encode(xs.View())) == "Name,price,Count,Fresh\nink,2.25,1,false\n\"a, b\",0.5,1,true\n"
    bad := ""
    try Decode<item>("price,Name\nlots,ink\n") catch Error.BadValue { bad = "value" }
    try Decode<item>("Name\nink\n") catch Error.NoColumn { bad = $bad " column" }
    assert bad == "value column"
    assert (try Decode<item>("")).Len() == 0
}
