# bench - benchmarks, measured by "olang test -bench FILE [WORD...]" (B19b) and run once by every other test run.
#
# A benchmark is a test whose body hands Run the work to measure:
#
#     test Sum "a million numbers" {
#         xs := Array<I64>[i for i in range 1000000]
#         bench.Run(fn() { bench.Keep(Sum(xs)) })
#     }
#
# Under "olang test -bench" Run calls the work N times, N grown until the N calls take the budget (a second unless
# said), and writes what one call cost to the standard output, before the test's own "ok" line:
#
#     bench Sum: a million numbers  2048 ops  487113 ± 2104 ns/op (7 runs)  0 allocs/op  0 B/op  1500213 instr/op
#
# - the time (the median of seven runs, each grown to a seventh of the budget, and the spread of the runs: their median
# absolute deviation from that median), the allocations and their bytes counted by the runtime's allocator (only a benchmark build counts them,
# so no other build pays for it), and the instructions the test's thread retired where the machine and the kernel
# give a counter. What the test does outside the work (building xs above) is not measured. Keep hands a value to
# nothing the optimizer can see through, so work whose result is otherwise unused is still done. Every other run of
# the test - a plain "olang test", "olang test -evaluate" - calls the work once and measures nothing, so a benchmark
# is a test as well. Measurement.Of gives one run's numbers to a program, in any build, Series.Of the repeated runs.
#
# For the prompt, a notebook and scripts, where no test is running, Time measures in any build and writes one line,
# like Python's %timeit, and Compare measures two pieces of work against each other, their runs interleaved:
#
#     bench.Time(fn() { bench.Keep(Sum(xs)) })
#     487 µs ± 3 µs per call (median of 7 runs × 2048 calls)

import "std/io"
import "std/time"

extern {
    fn __olang_bench_on() I64
    fn __olang_bench_allocs_made() I64
    fn __olang_bench_bytes_made() I64
    fn __olang_bench_instructions() I64
    fn __olang_bench_keep(v I64)
    fn __olang_test_running(buf Array<U8>, cap I64) I64
}

# the budget a benchmark's calls are grown to when Run is given none
DefaultBudget time.Duration = time.Duration.Seconds(1)

# the most calls one measurement makes, however cheap a call is
MaxOps I64 = 1000000000

# what Ops calls of a piece of work took together: Nanos on the monotonic clock; Allocs allocations of Bytes bytes made
# on the calling thread (-1 for both outside a benchmark build, which does not count them); Instructions retired by
# the calling thread, -1 where no counter is available
type Measurement struct(Ops I64, Nanos I64, Allocs I64, Bytes I64, Instructions I64) {
    Ops
    Nanos
    Allocs
    Bytes
    Instructions
}

# the nanoseconds one call took
fn (m Measurement&) NanosPerOp() F64 { return F64(m.Nanos) / F64(m.Ops.Max(1)) }

# the allocations one call made, rounded down (-1 where none were counted)
fn (m Measurement&) AllocsPerOp() I64 { return -1 if m.Allocs < 0 else m.Allocs / m.Ops.Max(1) }

# the bytes one call allocated, rounded down (-1 where none were counted)
fn (m Measurement&) BytesPerOp() I64 { return -1 if m.Bytes < 0 else m.Bytes / m.Ops.Max(1) }

# the instructions one call retired, rounded down (-1 where no counter is available)
fn (m Measurement&) InstructionsPerOp() I64 { return -1 if m.Instructions < 0 else m.Instructions / m.Ops.Max(1) }

# "2048 ops  487113 ns/op  0 allocs/op  0 B/op  1500213 instr/op": what is not counted is left out
fn (m Measurement&) Str() String { return $m.Ops + " ops  " + $nanos(m.NanosPerOp()) + " ns/op" + $m.counts() }

# "  0 allocs/op  0 B/op  1500213 instr/op", each part left out where it is not counted
fn (m Measurement&) counts() String {
    t := ""
    if m.Allocs >= 0: t = $"  " + $m.AllocsPerOp() + " allocs/op  " + $m.BytesPerOp() + " B/op"
    if m.Instructions >= 0: t = $t + "  " + $m.InstructionsPerOp() + " instr/op"
    return t
}

# nanoseconds as Go's benchmarks write them: whole from 100 up, with one more decimal below each power of ten under it
fn nanos(x F64) String {
    if x >= 100.0: return x.Fixed(0)
    if x >= 10.0: return x.Fixed(1)
    if x >= 1.0: return x.Fixed(2)
    return x.Fixed(3)
}

# whether this is a benchmark build, "olang test -bench" - false in every other build and in the evaluator
fn On() Bool { return __olang_bench_on() != 0 }

# v handed to nothing the optimizer can see through, so the work computing it is done: a number or a Bool as its bits,
# any other value through its Hash - which the measurement then includes; keep a number taken from such a value where
# hashing it would cost more than the work
fn Keep<T>(v T) {
    match T {
        case I8, I16, I32, I64, U8, U16, U32, U64, Char { __olang_bench_keep(I64(v)) }
        case F16, BF16, F32 { __olang_bench_keep(I64(F64(v).Bits())) }
        case F64 { __olang_bench_keep(I64(v.Bits())) }
        case Bool { __olang_bench_keep(1 if v else 0) }
        case _ { __olang_bench_keep(v.Hash()) }
    }
}

# body called ops times on this thread, and what the calls took together
fn Measurement.taken<? E>(body fn&() ? E, ops I64) Measurement ? E {
    counted := On()
    allocs, bytes := __olang_bench_allocs_made(), __olang_bench_bytes_made()
    instructions := __olang_bench_instructions()
    start := time.Now()
    for _ in range ops: try body()
    took := time.Since(start)
    after := __olang_bench_instructions()
    spent := -1 if instructions < 0 or after < 0 else after - instructions
    if not counted: return Measurement(ops, took, -1, -1, spent)
    return Measurement(ops, took, __olang_bench_allocs_made() - allocs, __olang_bench_bytes_made() - bytes, spent)
}

# how many calls the next round makes to fill budget, from the last round's: as many as took the budget at its pace,
# a fifth more, at most a hundred times as many and at least one more (Go's rule), never past MaxOps
fn nextOps(last Measurement&, budget I64) I64 {
    n := budget * last.Ops / last.Nanos.Max(1)
    n += n / 5
    return n.Min(100 * last.Ops).Max(last.Ops + 1).Min(MaxOps)
}

# body measured: called once, then in rounds of more calls, each round's count from the last's pace, until a round's
# calls take budget together or make MaxOps; the last round's numbers. Fails with what body fails with, as soon as a
# call does
fn Measurement.Of<? E>(body fn&() ? E, budget time.Duration = DefaultBudget) Measurement ? E {
    goal := budget.Nanos()
    m := try Measurement.taken(body, 1)
    for m.Nanos < goal and m.Ops < MaxOps: m = try Measurement.taken(body, nextOps(m, goal))
    return m
}

# the benchmark the running test makes of body: in a benchmark build body measured (Series.Of: runs runs, each grown to
# budget / runs) and "bench NAME  ..." written to the standard output, NAME the running test's name and "/label" after
# it where a label is given (for a test measuring several pieces of work); in every other build body called once.
# Fails with what body fails with
fn Run<? E>(body fn&() ? E, label String& = "", budget time.Duration = DefaultBudget, runs I64 = DefaultRuns) ? E {
    if not On() {
        try body()
        return
    }
    s := try Series.Of(body, budget, runs)
    name := $running() + $("/" if label != "" else "") + $label
    try io.PutLine($"bench " + $name + "  " + $s) catch io.Error { }
}

# the runs a measurement is made of unless said
DefaultRuns I64 = 7

# the middle of xs: the middle one of an odd count, the mean of the two middle ones of an even count, 0 of none
fn Median(xs Array<F64>&) F64 {
    n := xs.Len()
    if n == 0: return 0.0
    sorted := xs.Copy()
    sorted.Sort(fn(a F64, b F64): return a < b)
    return sorted[n / 2] if n % 2 == 1 else (sorted[n / 2 - 1] + sorted[n / 2]) / 2.0
}

# how far xs lie from their median, as their median absolute deviation (unscaled): robust where one run met a load
# spike, which a standard deviation would blow up on; 0 of none
fn Spread(xs Array<F64>&) F64 {
    m := Median(xs)
    return Median(Array<F64>[(x - m).Abs() for x in xs])
}

# several runs of one piece of work, each a Measurement of as many calls as the first run settled on
type Series struct(Runs Array<Measurement>) { Runs }

# body measured in runs runs: the first (Measurement.Of) grows the calls to budget / runs, the others make as many calls
# as it settled on. Fails with what body fails with
fn Series.Of<? E>(body fn&() ? E, budget time.Duration = DefaultBudget, runs I64 = DefaultRuns) Series ? E {
    n := runs.Max(1)
    first := try Measurement.Of(body, time.Duration(I64(budget) / n))
    return try Series.taken(body, first.Ops, n, first)
}

# body measured in runs runs of ops calls each; first, where given a run already made, is the first of them
fn Series.taken<? E>(body fn&() ? E, ops I64, runs I64, first Measurement& = Measurement(0, 0, -1, -1, -1)) Series ? E {
    all mut Vec<Measurement>& = Vec<Measurement>()
    if first.Ops > 0: all.Push(first)
    for _ in range runs - all.Len(): all.Push(try Measurement.taken(body, ops))
    return Series(all.ToArray())
}

# the nanoseconds one call took, in each run
fn (s Series&) PerOp() Array<F64> { return Array<F64>[m.NanosPerOp() for m in s.Runs] }

# the median of the runs' time per call
fn (s Series&) Median() F64 { return Median(s.PerOp()) }

# the fastest run's time per call
fn (s Series&) Min() F64 { return try s.PerOp().Min() catch default 0.0 }

# the spread of the runs' time per call: Spread
fn (s Series&) Spread() F64 { return Spread(s.PerOp()) }

# the run closest to the median, whose counts (calls, allocations, instructions) stand for the series
fn (s Series&) Typical() Measurement {
    m := s.Median()
    best := 0
    for i, r in s.Runs {
        if (r.NanosPerOp() - m).Abs() < (s.Runs[best].NanosPerOp() - m).Abs(): best = i
    }
    return s.Runs[best]
}

# "2048 ops  487113 ± 2104 ns/op (7 runs)  0 allocs/op  0 B/op  1500213 instr/op": the typical run's counts
fn (s Series&) Str() String {
    m := s.Typical()
    return $m.Ops + " ops  " + $nanos(s.Median()) + " ± " + $nanos(s.Spread()) + " ns/op (" + $s.Runs.Len() + " runs)" + $m.counts()
}

# "487 µs ± 3 µs per call (median of 7 runs × 2048 calls)": the median and spread in the unit the median reads best in
fn (s Series&) Line() String {
    m := s.Typical()
    return $Human(s.Median(), s.Spread()) + " per call (median of " + $s.Runs.Len() + " runs × " + $m.Ops + " calls)"
}

# a notebook shows a series as a small table
fn (s Series&) Display() Display {
    m := s.Typical()
    return Display.Markdown($"| median | spread | min | runs | calls per run |\n|---|---|---|---|---|\n| " + $Human(s.Median(), s.Spread()) + " | | " + $Human(s.Min(), 0.0) + " | " + $s.Runs.Len() + " | " + $m.Ops + " |")
}

# "487 µs ± 3 µs": ns and its spread in ns, ns's unit, as many decimals as three digits of ns need
fn Human(ns F64, spread F64) String {
    unit, div := "ns", 1.0
    if ns >= 1e9 { unit, div = "s", 1e9 }
    else if ns >= 1e6 { unit, div = "ms", 1e6 }
    else if ns >= 1e3 { unit, div = "µs", 1e3 }
    decimals := 0 if ns / div >= 100.0 else 1 if ns / div >= 10.0 else 2
    shown := $(ns / div).Fixed(decimals) + " " + $unit
    return shown if spread == 0.0 else $shown + " ± " + $(spread / div).Fixed(decimals) + " " + $unit
}

# body measured (Series.Of) in any build, and one line written to the standard output (Series.Line); gives the median
# time of a call in nanoseconds (Series.Of gives all the runs, where they are wanted)
fn Time<? E>(body fn&() ? E, budget time.Duration = DefaultBudget, runs I64 = DefaultRuns) F64 ? E {
    s := try Series.Of(body, budget, runs)
    try io.PutLine(s.Line()) catch io.Error { }
    return s.Median()
}

# two pieces of work measured against each other: their runs, and the b/a ratio of each pair of runs
type Comparison struct(A Series, B Series, Ratios Array<F64>) { A, B, Ratios }

# how many times as long b took as a, the median of the pairs' ratios
fn (c Comparison&) Ratio() F64 { return Median(c.Ratios) }

# the spread of the pairs' ratios: Spread
fn (c Comparison&) RatioSpread() F64 { return Spread(c.Ratios) }

# a and b measured against each other: each is grown to budget / runs as Series.Of does, then the runs are made
# alternately (a, b, a, b, ...) so that a change in the machine's load meets both. Fails with what a or b fails with
fn Comparison.Of<? E>(a fn&() ? E, b fn&() ? E, budget time.Duration = DefaultBudget, runs I64 = DefaultRuns) Comparison ? E {
    n := runs.Max(1)
    each := time.Duration(I64(budget) / (2 * n))
    opsA, opsB := (try Measurement.Of(a, each)).Ops, (try Measurement.Of(b, each)).Ops
    return try Comparison.interleave(a, b, opsA, opsB, n)
}

# Comparison.Of, and both lines and the ratio written to the standard output ("b/a 1.67 ± 0.02 (median of 7 paired
# runs)"), labels naming the two; gives the ratio
fn Compare<? E>(a fn&() ? E, b fn&() ? E, labels Array<String&> = Array<String&>["a", "b"]
    budget time.Duration = DefaultBudget, runs I64 = DefaultRuns) F64 ? E {
    c := try Comparison.Of(a, b, budget, runs)
    la, lb := labels[0], labels[1]
    try io.PutLine($la + ": " + $c.A.Line()) catch io.Error { }
    try io.PutLine($lb + ": " + $c.B.Line()) catch io.Error { }
    try io.PutLine($lb + "/" + $la + " " + $c.Ratio().Fixed(2) + " ± " + $c.RatioSpread().Fixed(2) + " (median of " + $c.Ratios.Len() + " paired runs)") catch io.Error { }
    return c.Ratio()
}

# runs pairs of runs: a's run of opsA calls, then b's of opsB, each pair after the one before
fn Comparison.interleave<? E>(a fn&() ? E, b fn&() ? E, opsA I64, opsB I64, runs I64) Comparison ? E {
    xs, bs := Vec<Measurement>(), Vec<Measurement>()
    for _ in range runs {
        xs.Push(try Measurement.taken(a, opsA))
        bs.Push(try Measurement.taken(b, opsB))
    }
    ratios := Array<F64>[bs[i].NanosPerOp() / xs[i].NanosPerOp().Max(1e-9) for i in range runs]
    return Comparison(Series(xs.ToArray()), Series(bs.ToArray()), ratios)
}

# the running test's name, as its run reports it ("Sum: a million numbers"), "" outside a test
fn running() String {
    n := __olang_test_running(Array<U8>(0), 0)
    if n < 0: return ""
    buf := Array<U8>(n)
    __olang_test_running(buf, n)
    return String(buf)
}

test Run "outside -bench, calls the work once" {
    calls mut Vec<I64>& = Vec<I64>()
    Run(fn() { calls.Push(calls.Len()) })
    Run(fn() { calls.Push(calls.Len()) }, label = "again")
    assert On() or calls.ToArray() == Array<I64>[0, 1] # in a benchmark build Run measures instead
}

test Measurement.Of "grows the calls to the budget" {
    count mut Vec<I64>& = Vec<I64>[0]
    m := Measurement.Of(fn() { count[0] += 1 }, budget = time.Duration.Millis(5))
    assert m.Ops > 1 and count[0] >= m.Ops and m.Nanos > 0 and m.NanosPerOp() > 0.0
    assert (m.Allocs >= 0) == On() and (m.Bytes >= 0) == On()
}

test Measurement.Of "fails as the work does, at once" {
    calls mut Vec<I64>& = Vec<I64>[0]
    failed := false
    try Measurement.Of(fn() ? Stop {
        calls[0] += 1
        if calls[0] == 3: error Stop
    }) catch Stop { failed = true }
    assert failed and calls[0] == 3
}

test nextOps "grows by the last round's pace, within Go's bounds" {
    assert nextOps(Measurement(1, 1000, 0, 0, -1), 1000000) == 100
    assert nextOps(Measurement(100, 1000, 0, 0, -1), 1000000) == 10000
    assert nextOps(Measurement(100, 10000000, 0, 0, -1), 1000000) == 101
    assert nextOps(Measurement(500000000, 1, 0, 0, -1), 1000000000) == MaxOps
}

test Measurement.Str "writes what one call cost, leaving out what was not counted" {
    assert $Measurement(4, 1000, 8, 640, -1) == "4 ops  250 ns/op  2 allocs/op  160 B/op"
    assert $Measurement(1000, 1234, -1, -1, 9000) == "1000 ops  1.23 ns/op  9 instr/op"
    assert nanos(12.34) == "12.3" and nanos(0.1234) == "0.123"
}

test Median "the middle, from any order" {
    assert Median(Array<F64>[5.0, 1.0, 3.0]) == 3.0
    assert Median(Array<F64>[1.0, 2.0, 3.0, 10.0]) == 2.5
    assert Median(Array<F64>[]) == 0.0
}

test Spread "the median absolute deviation, which one outlier does not move" {
    assert Spread(Array<F64>[1.0, 2.0, 3.0, 4.0, 100.0]) == 1.0
    assert Spread(Array<F64>[7.0, 7.0, 7.0]) == 0.0
}

test Series.Str "writes the median, its spread and the typical run's counts" {
    s := Series(Array<Measurement>[Measurement(10, 1000, 0, 0, -1), Measurement(10, 1200, 20, 640, -1), Measurement(10, 2000, 0, 0, -1)])
    assert s.Median() == 120.0 and s.Min() == 100.0 and s.Spread() == 20.0
    assert $s == "10 ops  120 ± 20.0 ns/op (3 runs)  2 allocs/op  64 B/op"
}

test Series.Line "scales the unit and writes the runs and calls" {
    s := Series(Array<Measurement>[Measurement(2048, 487000 * 2048, -1, -1, -1), Measurement(2048, 490000 * 2048, -1, -1, -1), Measurement(2048, 484000 * 2048, -1, -1, -1)])
    assert s.Line() == "487 µs ± 3 µs per call (median of 3 runs × 2048 calls)"
    assert Human(1500000000.0, 0.0) == "1.50 s" and Human(12.0, 0.0) == "12.0 ns" and Human(2500000.0, 500000.0) == "2.50 ms ± 0.50 ms"
}

test Series.taken "makes the runs it is given, each of the calls it is given" {
    calls mut Vec<I64>& = Vec<I64>[0]
    s := Series.taken(fn() { calls[0] += 1 }, 5, 4)
    assert s.Runs.Len() == 4 and calls[0] == 20 and s.Runs[3].Ops == 5
}

test Series.Of "makes the runs asked for" {
    s := Series.Of(fn() { Keep(1) }, budget = time.Duration.Millis(7), runs = 3)
    assert s.Runs.Len() == 3 and s.Runs[0].Ops == s.Runs[2].Ops
}

test Comparison.interleave "alternates a and b run by run" {
    log mut Vec<I64>& = Vec<I64>()
    c := Comparison.interleave(fn() { log.Push(1) }, fn() { log.Push(2) }, 2, 1, 3)
    assert log.ToArray() == Array<I64>[1, 1, 2, 1, 1, 2, 1, 1, 2]
    assert c.A.Runs.Len() == 3 and c.B.Runs[0].Ops == 1 and c.Ratios.Len() == 3
}

test Comparison "the ratio is the median of the pairs' b/a" {
    c := Comparison(Series(Array<Measurement>[]), Series(Array<Measurement>[]), Array<F64>[1.0, 2.0, 3.0, 2.0, 50.0])
    assert c.Ratio() == 2.0 and c.RatioSpread() == 1.0
}

test Time "measures in any build and gives the median back" {
    assert Time(fn() { Keep(2) }, budget = time.Duration.Millis(7), runs = 3) > 0.0
}

test Compare "measures both and gives the ratio" {
    r := Compare(fn() { Keep(1) }, fn() { Keep(Array<I64>[1, 2].Hash()) }, Array<String&>["one", "hash"], budget = time.Duration.Millis(10), runs = 3)
    assert r > 0.0
    c := Comparison.Of(fn() { Keep(1) }, fn() { Keep(2) }, budget = time.Duration.Millis(10), runs = 3)
    assert c.A.Runs.Len() == 3 and c.B.Runs.Len() == 3
}

test Series.Display "is a table in a notebook" {
    s := Series(Array<Measurement>[Measurement(10, 1000, -1, -1, -1)])
    assert s.Display().Mime() == "text/markdown"
}

test Keep "keeps a value of any type" {
    Keep(3)
    Keep(2.5)
    Keep(F32(1.5))
    Keep(true)
    Keep('a')
    Keep("text")
    Keep(Array<I64>[1, 2])
}

# K1: what the evaluator decides - no benchmark build, so the work runs once
fn runsOnce() I64 {
    calls mut Vec<I64>& = Vec<I64>[0]
    Run(fn() { calls[0] += 1 })
    Keep(calls[0])
    return calls[0]
}

assert runsOnce() == 1 and not On()
