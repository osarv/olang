# Vec<T>, the growable array, tested - a module of its own, not part of the prelude, so these are compiled only when
# they are run. Text and nodes kept in a Vec are read back after the arena churns; a computation through Vecs is baked
# into a global (K2) and decided by an assert (S18c) beside the same computation at run time

Run I64 = Count(1)                                      # a run-time 1: computations given it are not folded
fn Count(k I64) I64 {
    c := 0
    for i in range k { c++ }
    return c
}
# churn the arena: a block that allocates and closes, many times, so storage freed early would be reused
fn churn() {
    for i in range 200 {
        s := $i " churn " $(i * 7)
        assert s.Len() > 0
    }
}

fn vecWork(k I64) I64 {
    v := Vec<I64>()
    for i in range 100 { v.Push(i * k) }
    t := v.Len() + v[99]
    v.Insert(0, 7)
    t += v.TakeAt(50) + v.SwapTake(1) + v[1]
    v.RemoveAt(2)                                       # gives nothing: Remove lets go, Take gives
    v.SwapRemove(3)
    t += v[2] + v[3] + v.Len()
    v.Reverse()
    v.Sort(fn(a I64, b I64) Bool { return a < b })
    t += v[0] + v[v.Len() - 1] + (try v.IndexOf(10 * k) catch default -1)
    p := try v.Pop() catch default 0
    t += p + (try v.First() catch default 0) + (try v.Last() catch default 0)
    v.Truncate(10)
    w := v.Clone()
    w.Push(5)
    t += w.Len() * 1000 + v.Len()
    for x in v { t += x }
    t += v.Iter().Fold(0, fn(a I64, x I64) I64 { return a + x * 2 })
    a := v.ToArray()
    t += a.Len() + a[3]
    v.Clear()
    t += v.Len()
    return t
}
VecBaked I64 = vecWork(3)                               # K2: computed while compiling

test "Vec: Push, indexing, Insert, TakeAt, RemoveAt, SwapTake, SwapRemove, Sort, Pop, Truncate, Clone - while compiling and at run time" {
    assert VecBaked == vecWork(3 * Run) and VecBaked == vecWork(3)
    assert vecWork(1) == 12085                          # S18c: decided while compiling
}

fn vecText(k I64) I64 {
    v := Vec<String&>()
    for i in range 30 { v.Push($(i * k % 17)) }
    s := v[3]                                           # kept across the growth below (13.1)
    for i in range 30 { v.Push("x" $i) }
    v.Sort(fn(a String&, b String&) Bool { return a < b })  # O17: Sort only permutes the buffer's elements
    d := v.View()                                       # O37: a borrowed own result, used before the next Push
    t := d.Len() * 100 + d[0].Len() + d[59].Len() + s.Len()
    v.Push("z")
    return t + v.Len() + (try v.IndexOf("x7") catch default -1)
}
VecTextBaked I64 = vecText(5)                           # K2

test "Vec: text sorted, viewed and kept - while compiling and at run time" {
    assert VecTextBaked == vecText(5 * Run) and vecText(1) == vecText(Run)
}

test "Vec: an empty one fails First, Last, Pop and IndexOf with the default error" {
    v := Vec<I64>()
    assert v.Len() == 0 and (try v.First() catch default -1) == -1 and (try v.Last() catch default -1) == -1
    assert (try v.Pop() catch default -1) == -1 and (try v.IndexOf(3) catch default -1) == -1
    assert (try v[0] catch default -1) == -1           # E31a: the derived checked form
    v.Push(4)
    assert (try v[1] catch default -1) == -1 and (try v[0] catch default -1) == 4
}

test "Vec: growth keeps every element, the buffer doubling from 8" {
    v := Vec<I32>()
    for i in range I32(1000) { v.Push(i) }
    churn()
    t := 0
    for x in v { t += x }
    assert v.Len() == 1000 and t == 499500 and v[999] == 999 and v[0] == 0
    v.PushAll(I32[1, 2, 3])
    assert v.Len() == 1003 and v[1002] == 3
}

test "Vec: text kept in one, an element kept while it grows, read back after a churn" {
    v := Vec<String&>()
    for i in range 40 { v.Push($i) }                    # each text built where v lives - its elements' reach
    s := v[7]                                           # an element refers outside the buffer (13.1)
    for i in range 200 { v.Push("x" $i) }               # so the buffer may be replaced under it
    churn()
    assert s == "7" and v.Len() == 240 and v[37] == "37" and v[239] == "x199"
    v.Sort(fn(a String&, b String&) Bool { return a < b })
    assert v[0] == "0" and v[1] == "1" and v[2] == "10"
    assert "12" in v and not ("z" in v) and (try v.IndexOf("x0") catch default -1) == 40
}

test "Vec: View lends the elements as an array, RunFrom walks one run" {
    v := Vec<F64>()
    for i in range 10 { v.Push(F64(i) * 0.5) }
    d := v.View()
    s := 0.0
    for x in d { s += x }
    assert d.Len() == 10 and s == 22.5
    m := v.ViewMut()
    m[0] = 9.0
    assert v[0] == 9.0
    r := try v.RunFrom(4) catch default Array<F64>(0)
    assert r.Len() == 6 and r[0] == 2.0
    assert (try v.RunFrom(10) catch Exhausted default Array<F64>(1)).Len() == 1
}

test "Vec: equal Vecs compare and hash alike, and render as their elements" {
    a := Vec<I64>()
    b := Vec<I64>()
    for i in range 5 { a.Push(i) }
    for i in range 5 { b.Push(i) }
    b.Push(9)
    assert a != b
    try b.Pop() catch { unreachable }
    assert a == b and a.Hash() == b.Hash() and a.Hash() == I64[0, 1, 2, 3, 4].HashElements()
    assert $a == "Vec<I64>[0, 1, 2, 3, 4]" and $Vec<String&>() == "Vec<String&>[]"
}

test "Vec: a borrowed copy reads, take moves, Clone copies" {
    a := Vec<I64>()
    for i in range 3 { a.Push(i + 1) }
    b := a                                              # a borrowed copy: a loan on a's buffer to its last use
    assert b.Len() == 3 and b[2] == 3
    c := take a                                         # a left its zero value
    assert a.Len() == 0 and c.Len() == 3
    d := c.Clone()
    d.Push(4)
    assert c.Len() == 3 and d.Len() == 4
}

type vecNode struct(name String&, n I64) {
    name
    n
}
test "Vec: references kept in one, read back after a churn and after the Vec is replaced" {
    v := Vec<vecNode&>()
    for i in range 30 { v.Push(vecNode($i, i)) }
    first := v[0]
    v = Vec<vecNode&>()                                 # the old buffer released; the nodes live where v does
    churn()
    assert first.name == "0" and first.n == 0 and v.Len() == 0
    for i in range 3 { v.Push(vecNode("n" $i, i * 10)) }
    churn()
    assert v[2].name == "n2" and v[2].n == 20
}

test "Vec: room made up front, Reserve, Cap, Remove and Join" {
    v := Vec<I64>(100)
    assert v.Len() == 0 and v.Cap() == 100
    for i in range 100 { v.Push(i) }
    assert v.Cap() == 100                               # no buffer replaced while there was room
    v.Push(100)
    assert v.Cap() == 200
    v.Reserve(500)
    assert v.Cap() == 601 and v.Len() == 101 and v[100] == 100
    v.Reserve(10)
    assert v.Cap() == 601                               # room enough: nothing replaced
    assert v.Remove(50) and not v.Remove(50) and v.Len() == 100 and v[50] == 51
    t := Vec<String&>()
    t.Push("a")
    t.Push("b")
    t.Push("c")
    assert t.Join(", ") == "a, b, c" and Vec<String&>().Join("-") == ""
}

# ---- Vec phase 2a: a Vec held by value in a field or a global, elements that are values holding references ----
type vecTok struct(text String&, line I64) {
    text
    line
}
type vecLexer struct(src String&) {
    src
    toks Vec<vecTok> = Vec<vecTok>()           # O31: a Vec field - its buffer is the instance's, released with it
}
fn (l mut vecLexer&) run() {
    line := 0
    for w in l.src.Split(" ") {
        l.toks.Push(vecTok(w, line))
        line++
    }
}
fn vecLex(src String&) vecLexer {               # an owned result holding a Vec field (O37)
    l := vecLexer(src)
    l.run()
    return l
}
fn vecLexWork(k I64) I64 {
    l := vecLex("let x = 42 + y")
    for i in range 30 { l.toks.Push(vecTok("t" $(i * k), i)) }
    first := l.toks[0]                          # a value element holding text, kept across the growth below (O38)
    l.toks.Sort(fn(a vecTok, b vecTok) Bool { return a.text < b.text })
    t := l.toks.Len() * 100 + l.toks[0].text.Len() + first.text.Len()
    moved := take l.toks                        # E34: the field taken, left its zero value
    t += moved.Len() * 10 + l.toks.Len()
    l.toks = take moved                         # ...and given back
    l.toks.Push(vecTok("z", 99))
    t += l.toks.TakeAt(0).line + l.toks.SwapTake(1).line + l.toks.Len()
    return t
}
VecLexBaked I64 = vecLexWork(3)                 # K2: computed while compiling

test "Vec: a struct holding a Vec in a field - built, grown, sorted, taken - while compiling and at run time" {
    assert VecLexBaked == vecLexWork(3 * Run) and vecLexWork(1) == vecLexWork(Run)
}

test "Vec: a Vec field filled by a method, its elements' text read back after the arena churns" {
    l := vecLex("alpha beta gamma delta")
    churn()
    assert l.toks.Len() == 4 and l.toks[2].text == "gamma" and l.toks[3].line == 3
    for i in range 50 { l.toks.Push(vecTok("w" $i, i)) }   # the buffer replaced several times
    churn()
    assert l.toks[1].text == "beta" and l.toks[53].text == "w49"
    c := l                                      # a borrowed copy of the struct: a loan on its Vec's buffer (O32)
    assert c.toks.Len() == 54 and c.toks[0].text == "alpha"
    l.toks = Vec<vecTok>()                      # the old buffer released (O35); c's last use was above
    l.toks.Push(vecTok("again", 7))
    churn()
    assert l.toks.Len() == 1 and l.toks[0].text == "again"
}

type vecWrap struct() {
    lx vecLexer = vecLexer("one two")           # a struct holding a struct holding a Vec - owning, transitively
}
test "Vec: a Vec two structs deep, replaced through each level" {
    w := vecWrap()
    w.lx.run()
    assert w.lx.toks.Len() == 2 and w.lx.toks[1].text == "two"
    w.lx = vecLex("a b c")                      # the inner struct and its Vec released
    churn()
    assert w.lx.toks.Len() == 3 and w.lx.toks[2].text == "c"
    w = vecWrap()                               # and the outer one
    assert w.lx.toks.Len() == 0
}

VecG mut Vec<I64> = Vec<I64>()                  # O31: a Vec global - the program's, never released, never baked (K2)
VecGC Vec<I64> = vecSquares(5)                  # ...an immutable one, set at startup
fn vecSquares(n I64) Vec<I64> {
    v := Vec<I64>()
    for i in range n { v.Push(i * i) }
    return v
}
fn vecGPush(x I64) { VecG.Push(x) }
test "Vec: a global Vec, pushed to from functions, taken and given back" {
    for i in range 20 { vecGPush(i) }
    churn()
    assert VecG.Len() == 20 and VecG[19] == 19 and VecGC.Len() == 5 and VecGC[4] == 16
    t := take VecG
    assert VecG.Len() == 0 and t.Len() == 20
    VecG = take t
    VecG = vecSquares(3)                        # the old buffer released
    assert VecG.Len() == 3 and VecG[2] == 4 and $VecG == "Vec<I64>[0, 1, 4]"
}

test "Vec: elements that are values holding references, kept across growth and read back after the arena churns" {
    v := Vec<vecTok>()
    for i in range 10 { v.Push(vecTok("e" $i, i)) }
    e := v[3]                                   # a copy, holding text where v keeps it (O33) - no loan on the buffer
    for i in range 100 { v.Push(vecTok("f" $i, i)) }
    churn()
    assert e.text == "e3" and v[3].text == "e3" and v[109].text == "f99"
    v.Reverse()
    m := v.ViewMut()
    m[0].text = "last"                          # a field of an element written through a view, its text a literal
    assert v[0].text == "last" and v[109].text == "e0"
}

# T29a (vec6 x1): a conversion of the view a call gives names the Vec's buffer, while compiling and at run time alike
fn vecViewNamed(n I64) I64 {
    v := Vec<Char>()
    for i in range n { v.Push('a') }
    w String&v = String(v.View())
    v[0] = 'z'
    return 1 if w[0] == 'z' and w.Len() == n else 0
}
VecViewBaked I64 = vecViewNamed(2)              # K2: computed while compiling
test "Vec: a conversion of a view names the buffer, not a copy of it" {
    assert VecViewBaked == 1 and vecViewNamed(2 * Run) == 1
}

# O26a (vec6): a Vec taken out of a local into one returned keeps what it refers to where the result goes
fn vecTakenOut(n I64) Vec<vecTok> {
    t := "kept-" $n
    l := Vec<vecTok>()
    l.Push(vecTok(t, n))
    w := take l
    return w
}
test "Vec: a Vec taken into a local that is returned, its text read back after the arena churns" {
    w := vecTakenOut(3)
    churn()
    assert w[0].text == "kept-3" and w[0].line == 3
}
