# the prelude iterator adapters, tested - a module of its own, not part of the prelude, so the tests are compiled only
# when they are run

fn upTo(n I64) Vec<I64>& {
    l mut Vec<I64>&return = Vec<I64>()
    for i in range n { l.Push(i) }
    return l
}

test "Take and Skip walk part of an iterator" {
    l := upTo(10)
    assert l.Iter().Take(3).ToVec() == upTo(3)
    assert l.Iter().Skip(7).ToVec().ToArray() == I64[7, 8, 9]
    assert l.Iter().Skip(2).Take(3).ToVec().ToArray() == I64[2, 3, 4]
    assert l.Iter().Skip(20).ToVec().Len() == 0 and l.Iter().Take(0).ToVec().Len() == 0
    a := I64[5, 6, 7]
    total := 0
    for x in a.Iter().Take(2) { total += x }
    assert total == 11
}

test "Enumerate, Zip and Chain" {
    a := I64[10, 20, 30]
    n := 0
    for e in a.Iter().Enumerate() {
        assert e.Value == (e.Index + 1) * 10
        n++
    }
    assert n == 3
    names := String&["a", "b"]
    s := StringBuilder()
    for p in names.Iter().Zip(a.Iter()) { s.Push($p.First $p.Second) }
    assert s.ToString() == "a10b20"
    assert a.Iter().Chain(upTo(2).Iter()).ToVec().ToArray() == I64[10, 20, 30, 0, 1]
    assert upTo(0).Iter().Chain(a.Iter()).Count(fn(x I64) Bool { return x > 15 }) == 2
}

test "Sum, Min, Max and their keyed forms" {
    a := I64[4, -2, 9, 3]
    assert a.Iter().Sum() == 14 and a.Iter().Min()! == -2 and a.Iter().Max()! == 9
    f := F64[1.5, 2.5]
    assert f.Iter().Sum() == 4.0
    assert (try I64[].Iter().Min() catch Exhausted default 99) == 99
    w := String&["pear", "fig", "banana"]
    assert w.Iter().MinBy(fn(t String&) I64 { return t.Len() })! == "fig"
    assert w.Iter().MaxBy(fn(t String&) I64 { return t.Len() })! == "banana"
    assert upTo(5).Iter().Sum() == 10
}

SumBaked I64 = I64[1, 2, 3].Iter().Skip(1).Sum()

test "an adapter is evaluated while compiling" {
    assert SumBaked == 5
}

# ---- the walks of the second survey (1.5): Reversed, Windows, TakeWhile, SkipWhile, StepBy, FlatMap, Partition ----

type Bad error {
    No
}

fn odd(x I64) Bool ? Bad {
    if x == 4 { error Bad.No }
    return x % 2 == 1
}

# 0 .. n-1, failing with Bad when it reaches 7
fn upToSeven(n I64) Iterator<I64 ? Bad> {
    for i in range n {
        if i == 7 { error Bad.No }
        yield i
    }
}

test "Reversed walks arrays, text and Vecs backward" {
    a := I64[1, 2, 3, 4]
    digits := 0
    for x in a.Reversed() { digits = digits * 10 + x }
    assert digits == 4321
    assert a.Reversed().ToVec().ToArray() == I64[4, 3, 2, 1]
    assert "olang".Reversed().ToVec().ToArray() == Char['g', 'n', 'a', 'l', 'o']
    assert upTo(3).Reversed().ToVec().ToArray() == I64[2, 1, 0]
    assert a[1:3].Reversed().Sum() == 5
}

test "Windows gives every run of n, overlapping, as views" {
    a := F64[1.0, 2.0, 3.0, 4.0]
    smooth := Vec<F64>()
    for w in a.Windows(2) { smooth.Push(w.Sum() / 2.0) }
    assert smooth.ToArray() == F64[1.5, 2.5, 3.5]
    assert a.Windows(4).Len() == 1 and a.Windows(5).Len() == 0 and F64[].Windows(1).Len() == 0
    assert "abcd".Windows(3)[1] == "bcd"
    n := 3
    assert a.Windows(try ChunkSize(n)).Len() == 2
    assert (try ChunkSize(n - 3) catch ArrayError.BadChunk default ChunkSize(7)) == ChunkSize(7)
}

test "an array's TakeWhile and SkipWhile are views, Partition two arrays" {
    a := I64[2, 4, 5, 6]
    assert a.TakeWhile(fn(x): return x % 2 == 0) == I64[2, 4]
    assert a.SkipWhile(fn(x): return x % 2 == 0) == I64[5, 6]
    assert a.TakeWhile(fn(x): return x > 0) == a and a.SkipWhile(fn(x): return x > 0).Len() == 0
    evens, rest := a.Partition(fn(x): return x % 2 == 0)
    assert evens == I64[2, 4, 6] and rest == I64[5]
    e2, r2 := I64[].Partition(fn(x): return x > 0)
    assert e2.Len() == 0 and r2.Len() == 0
    assert (try I64[1, 3, 4].TakeWhile(odd).Len() catch Bad default -1) == -1
    assert (try I64[1, 2, 4].TakeWhile(odd).Len() catch Bad default -1) == 1
}

test "FlatMap walks the iterator each value gives" {
    a := I64[1, 2, 3]
    assert a.Iter().FlatMap(fn(x I64) ArrayIter<I64> { return a[:x].Iter() }).ToVec().ToArray() == I64[1, 1, 2, 1, 2, 3]
    words := String&["a b", "", "c"]
    n := 0
    for _ in words.Iter().FlatMap(fn(t String&) ArrayIter<String&> { return t.Split(" ").Iter() }) { n++ }
    assert n == 4
    assert I64[].Iter().FlatMap(fn(x I64) ArrayIter<I64> { return a.Iter() }).ToVec().Len() == 0
}

test "Partition splits a walk into two Vecs" {
    small, big := upTo(6).Iter().Partition(fn(x): return x < 2)
    assert small.ToArray() == I64[0, 1] and big.ToArray() == I64[2, 3, 4, 5]
}

test "the walks fail with what their iterator and callbacks fail with" {
    assert (try upToSeven(10).TakeWhile(fn(x): return x < 3).ToVec()).Len() == 3
    assert (try upToSeven(10).SkipWhile(fn(x): return x < 3).ToVec() catch Bad default Vec<I64>()).Len() == 0
    assert (try upToSeven(10).StepBy(3).ToVec() catch Bad default Vec<I64>()).Len() == 0
    assert (try upToSeven(7).StepBy(3).ToVec()).ToArray() == I64[0, 3, 6]
    yes, no := try I64[1, 3, 5].Iter().Partition(odd) catch Bad { unreachable }
    assert yes.ToArray() == I64[1, 3, 5] and no.Len() == 0
    assert (try I64[1, 4].Iter().SkipWhile(odd).ToVec() catch Bad default Vec<I64>()).Len() == 0
    flat := try upToSeven(5).FlatMap(fn(x I64) Generator<I64 ? Bad> { return upToSeven(x) }).ToVec()
    assert flat.Len() == 10
    try upToSeven(9).FlatMap(fn(x I64) Generator<I64 ? Bad> { return upToSeven(x) }).ToVec() catch Bad {
        return
    }
    unreachable
}

# computed while compiling (K2): a walk through the new adapters, baked into the program
WalkBaked I64 = I64[1, 2, 3, 4, 5, 6].Iter().TakeWhile(fn(x): return x < 6).StepBy(2).Sum()
WindowsBaked I64 = I64[1, 2, 3, 4].Windows(3).Len() + I64[9, 8, 7].Reversed().Fold(0, fn(acc, x) { return acc * 10 + x })

test "the walks are evaluated while compiling" {
    assert WalkBaked == 9 and WindowsBaked == 791
    assert WalkBaked == I64[1, 2, 3, 4, 5, 6].Iter().TakeWhile(fn(x): return x < 6).StepBy(2).Sum()
}

# ---- walks, round 3: computed while compiling (K2) beside the same at run time ----

Walks3Baked I64 = try I64[1, 2, 3, 4].Iter().Scan(0, fn(a, x): return a + x).Last() catch default -1
Walks3Product I64 = I64[1, 1, 2, 3, 3].Iter().Dedup().Product() + (try I64[5, 6, 7].Iter().Nth(2) catch default -1)
Walks3Search I64 = (try I64[1, 3, 5, 7].BinarySearch(5) catch default -1) * 100 + I64[1, 3, 5, 7].LowerBound(6) * 10 +
                   I64[1, 1, 2, 3, 3].ChunkBy(fn(x, y): return x == y).Len()
Walks3Groups I64 = I64[1, 2, 3, 4, 5].Iter().GroupBy(fn(x): return x % 3).Len()
Walks3Cycle I64 = I64[1, 2].Cycle().Take(5).Sum()

test "the third round's walks are evaluated while compiling, as they run" {
    a := I64[1, 2, 3, 4]
    assert Walks3Baked == 10 and Walks3Baked == (try a.Iter().Scan(0, fn(acc, x): return acc + x).Last() catch default -1)
    assert Walks3Product == 13 and Walks3Search == 233 and Walks3Groups == 3 and Walks3Cycle == 7
    v := Vec<I64>()
    v.Push(4)
    v.Push(9)
    assert (try v.BinarySearch(9) catch default -1) == 1 and v.Cycle().Take(3).Sum() == 17
    xs, ys := a.Iter().Zip(a.Iter().Skip(1)).Unzip()
    assert xs.Len() == 3 and ys.ToArray() == I64[2, 3, 4]
}
