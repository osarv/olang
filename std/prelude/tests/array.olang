# the prelude's newer array methods, tested - a module of its own, not part of the prelude, so these are compiled only
# when they are run

test "CountOf counts runs from the start, without overlapping" {
    assert I32[1, 2, 1, 2, 1].CountOf(I32[1, 2]) == 2
    assert I32[1, 1, 1, 1].CountOf(I32[1, 1]) == 2              # not three: occurrences do not overlap
    assert I32[1, 2, 3].CountOf(I32[4]) == 0
    assert I32[1, 2].CountOf(I32[1, 2, 3]) == 0                 # longer than the array
    assert I32[1, 2, 3].CountOf(Array<I32>(0)) == 4             # the empty run is at every position
    assert Array<I32>(0).CountOf(Array<I32>(0)) == 1
    assert "banana".CountOf("an") == 2 and "aaaa".CountOf("aa") == 2 and "abc".CountOf("") == 4
}

test "Replace puts new in place of every run old, building the array once" {
    a := I32[1, 2, 3, 1, 2].Replace(I32[1, 2], I32[9])
    assert a.Len() == 3 and a[0] == 9 and a[1] == 3 and a[2] == 9
    assert I32[1, 2, 3].Replace(I32[7], I32[8, 8]).Len() == 3                      # nothing to replace
    b := I32[5, 5, 5].Replace(I32[5], Array<I32>(0))                            # removing every one
    assert b.Len() == 0
    assert "a-b-c".Replace("-", ", ") == "a, b, c"
    assert "aaaa".Replace("aa", "b") == "bb" and "aaa".Replace("aa", "b") == "ba"
    assert "abc".Replace("", "-") == "-a-b-c-" and "".Replace("", "x") == "x"   # the empty run is everywhere
    assert "".Replace("a", "b") == "" and "hello".Replace("hello", "") == ""
    assert "x".Replace("x", "xx").Replace("x", "xx") == "xxxx"
    t := "one two".Replace(" ", "  ")                     # an inherited array method gives a String back
    assert t.ToUpper() == "ONE  TWO"
}

test "Repeat and Reverse" {
    assert "ab".Repeat(3) == "ababab" and "ab".Repeat(1) == "ab"
    assert "ab".Repeat(0) == "" and "ab".Repeat(-2) == "" and "".Repeat(5) == ""
    r := I32[1, 2].Repeat(2)
    assert r.Len() == 4 and r[2] == 1 and r[3] == 2
    a := I32[1, 2, 3, 4, 5]
    a.Reverse()
    assert a[0] == 5 and a[2] == 3 and a[4] == 1
    e := Array<I32>(0)
    e.Reverse()
    one := I32[7]
    one.Reverse()
    assert one[0] == 7 and e.Len() == 0
    s := String(Array<Char>(3, 'x'))
    s[0] = 'a'
    s.Reverse()                                          # text reverses byte by byte
    assert s == "xxa"
    words := "c b a".Split(" ")
    words.Reverse()
    assert words.Join(" ") == "a b c"
}

# the same, computed while compiling (K2)
fn arrayReshaped() I64 {
    t := "a,b,,c".Replace(",", "::").Repeat(2)
    n := t.CountOf("::")
    r := I64[1, 2, 3, 4]
    r.Reverse()
    return n * 1000 + t.Len() * 10 + r[0]
}
arrayReshapedBaked := arrayReshaped()

test "CountOf, Replace, Repeat and Reverse, evaluated while compiling as at run time" {
    assert arrayReshapedBaked == 6 * 1000 + 18 * 10 + 4
    assert arrayReshaped() == arrayReshapedBaked
}

# a record holding a reference - sorted through positions, a scratch array being unable to hold it (Sort)
type sortRec struct(key I64, at I64, name String&) {
    key
    at
    name
}

# whether a is in order by less and, for equal keys, in the order "first" gives
fn sortedStably(a Array<sortRec>&) Bool {
    for i in range 1, a.Len() {
        if a[i].key < a[i - 1].key { return false }
        if a[i].key == a[i - 1].key and a[i].at < a[i - 1].at { return false }
        if a[i].name != $a[i].at { return false }
    }
    return true
}

# n records with keys 0 to k - 1 scattered, each named by where it started - so stability is checkable
fn sortRecs(n I64, k I64) Array<sortRec> {
    keep := Array<String&>(n, "")
    out := Array<sortRec>(n, sortRec(0, 0, keep[0]))
    for i in range n {
        keep[i] = $i
        out[i] = sortRec((i * 7919 + 13) % k, i, keep[i])
    }
    return out
}

test "Sort is O(n log n) and stable on numbers, merging through a scratch array" {
    for n in I64[2, 23, 24, 25, 100, 12287, 12288, 12289, 30001] {
        a := Array<I64>(n)
        for i in range n { a[i] = (i * 7919 + 13) % 1000 }
        a.Sort(fn(x, y) { return x < y })
        ok := true
        for i in range 1, n {
            if a[i] < a[i - 1] { ok = false }
        }
        assert ok, "numbers out of order at " $n
        # stability on numbers: order by the hundreds only, the rest kept in the order it came
        b := Array<I32>(n)
        for i in range n { b[i] = I32(i) }
        b.Sort(fn(x, y) { return x / 100 % 7 < y / 100 % 7 })
        for i in range 1, n {
            if b[i] / 100 % 7 == b[i - 1] / 100 % 7 and b[i] < b[i - 1] { ok = false }
        }
        assert ok, "numbers unstable at " $n
    }
    f := F32[2.5, -1, 0, 7.25, -3, 2.5]
    f.Sort(fn(x, y) { return x > y })
    assert f == F32[7.25, 2.5, 2.5, 0, -1, -3]
    c := Char['o', 'l', 'a', 'n', 'g']
    c.Sort(fn(x, y) { return x < y })
    assert String(c) == "aglno"
}

test "Sort orders elements holding references through positions, in blocks, stably" {
    for n in I64[2, 24, 25, 1000, 12288, 12289, 40000] {
        a := sortRecs(n, 37)
        a.Sort(fn(x, y) { return x.key < y.key })
        assert sortedStably(a), "records out of order at " $n
    }
    words := "pear fig apple kiwi banana fig date".Split(" ")
    words.Sort(fn(x, y) { return x < y })
    assert words.Join(" ") == "apple banana date fig fig kiwi pear"
}

# the same sorts, while compiling (K2) - numbers through the scratch, records through positions
fn sortBakedSum() I64 {
    a := Array<I64>(100)
    for i in range 100 { a[i] = (i * 37) % 100 }
    a.Sort(fn(x, y) { return x > y })
    r := sortRecs(60, 5)
    r.Sort(fn(x, y) { return x.key < y.key })
    return a[0] * 1000 + a[99] * 100 + r[0].key * 10 + (1 if sortedStably(r) else 0)
}
sortBakedSumBaked := sortBakedSum()

test "Sort evaluated while compiling as at run time" {
    assert sortBakedSumBaked == 99001 and sortBakedSum() == sortBakedSumBaked
}
