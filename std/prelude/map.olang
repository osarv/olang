# Map - values found by key, compared with "==" (E10). Part of the prelude, as Vec is: "Map<K, V>" is named bare
# everywhere. A key is any type with a "Hash() I64" agreeing with "==": the prelude gives it to the integers and
# String, the compiler supplies one for a struct, enum or array value whose parts all have one (E10b), and a key type
# declaring Eq declares its Hash too.
#
# Buckets of chained slots, a power of two of them, doubled when the map is three-quarters full. Growing re-links the
# existing slots into new buckets and copies nothing else; the old bucket array stays in the scope until it closes, as
# anything an arena holds does.
#
# A Map is a HANDLE, as a Vec is: the buckets, the count and the slots kept for reuse are one record, made where the Map
# is constructed (C2d), and a Map value is one reference to it - so a copy of a Map value is a second name for the same
# map, as a Go map is, and Clone() is the copy with storage of its own. "Array<Map<K, V>>(n, Map<K, V>())" is n names for
# one map (T8). Everything a Map allocates lives where it was made, so it is reclaimed with that scope and needs no
# destructor.
#
# A key or value that is a reference ("Map<String&, I32>") is stored as the reference - it must outlive the
# map, which every call checks (O10b).

# what a Map's Get and Take fail with: no value for the key
type MapError error {
    Missing
}

# one key and its value, as a "for ... in" over a Map gives them
type MapEntry<K, V> struct(key K, value V) {
    Key K = key
    Value V = value
}

# a key and its value where the Map keeps them, and the next of its chain. The entry is held whole, so a walk hands out
# a copy of one that already exists rather than building one per step
type mapSlot<K, V> struct(key K, value V, next mut mapSlot<K, V>?&) {
    entry MapEntry<K, V> = MapEntry<K, V>(key, value)
    next
}

type Map<K Hashable<K>, V> struct() {
    s mut mapState<K, V>& = mapState<K, V>()    # the map itself; every copy of this value names the same one
}

# what a Map holds - private, reached only through a Map
type mapState<K, V> struct() {
    buckets mut Array<mut mapSlot<K, V>?&>& = Array<mut mapSlot<K, V>?&>(8)
    count I64 = 0
    free mut mapSlot<K, V>?& = null             # slots of removed keys, chained through next, for the next keys put
}

fn (m Map<K, V>&) Len() I64 { return m.s.count }

fn (s mapState<K, V>&) bucketOf(key K) I64 { return key.Hash() & (s.buckets.Len() - 1) }

# a new key and its value, at the head of bucket i's chain - in a slot a removed key left, when there is one, so a Map
# whose keys come and go stays the size of what it holds
fn (s mut mapState<K, V>&) add(i I64, key K, value V) {
    f := s.free
    if f is null {
        s.buckets[i] = mapSlot<K, V>(key, value, s.buckets[i])
    } else {
        s.free = f.next
        f.entry = MapEntry<K, V>(key, value)
        f.next = s.buckets[i]
        s.buckets[i] = f
    }
    s.count++
    if s.count * 4 > s.buckets.Len() * 3 { s.grow() }
}

# sets the value for key, replacing the one it had
fn (m mut Map<K, V>&) Put(key K, value V) {
    s := m.s
    i := s.bucketOf(key)
    for f mut mapSlot<K, V>?&s = s.buckets[i], f is not null, f = f.next {
        if f.entry.Key == key {
            f.entry.Value = value
            return
        }
    }
    s.add(i, key, value)
}

# doubles the buckets and re-links every slot into its new one
fn (s mut mapState<K, V>&) grow() {
    old := s.buckets
    s.buckets = Array<mut mapSlot<K, V>?&>(old.Len() * 2)
    for i in range old.Len() {
        f mut mapSlot<K, V>?&s = old[i]
        for f is not null {
            after := f.next
            j := s.bucketOf(f.entry.Key)
            f.next = s.buckets[j]
            s.buckets[j] = f
            f = after
        }
    }
}

# the value for key made f(its value) - or, where key has none, f(init) put for it: counting is
# "m.Update(word, 0, fn(n) { return n + 1 })". One hash and one walk of key's chain, where Get then Put take two
fn (m mut Map<K, V>&) Update(key K, init V, f fn(v V) V) {
    s := m.s
    i := s.bucketOf(key)
    for g mut mapSlot<K, V>?&s = s.buckets[i], g is not null, g = g.next {
        if g.entry.Key == key {
            g.entry.Value = f(g.entry.Value)
            return
        }
    }
    s.add(i, key, f(init))
}

# the value for key - failing with MISSING when there is none, so a miss is never read as a value:
# "try m.Get(k) catch default 0" gives a fallback, "try m.Get(k)" passes the miss on, "k in m" only asks
fn (m Map<K, V>&) Get(key K) V ? MapError {
    s := m.s
    for f mut mapSlot<K, V>?&s = s.buckets[s.bucketOf(key)], f is not null, f = f.next {
        if f.entry.Key == key { return f.entry.Value }
    }
    error MapError.Missing
}

# whether key has a value - what "key in m" asks (E29)
fn (m Map<K, V>&) Has(key K) Bool {
    s := m.s
    for f mapSlot<K, V>?&s = s.buckets[s.bucketOf(key)], f is not null, f = f.next {
        if f.entry.Key == key { return true }
    }
    return false
}

# removes key and its value, and says whether it was there. Its slot is kept for the next key put
fn (m mut Map<K, V>&) Remove(key K) Bool {
    s := m.s
    i := s.bucketOf(key)
    prev mut mapSlot<K, V>?&s = null
    for f mut mapSlot<K, V>?&s = s.buckets[i], f is not null, f = f.next {
        if f.entry.Key == key {
            f.entry.vacate()
            if prev is null { s.buckets[i] = f.next } else { prev.next = f.next }
            f.next = s.free
            s.free = f
            s.count--
            return true
        }
        prev = f
    }
    return false
}

# removes key and gives its value - Get and Remove in one, failing with MISSING when there is none. Its slot is kept for
# the next key put
fn (m mut Map<K, V>&) Take(key K) V ? MapError {
    s := m.s
    i := s.bucketOf(key)
    prev mut mapSlot<K, V>?&s = null
    for f mut mapSlot<K, V>?&s = s.buckets[i], f is not null, f = f.next {
        if f.entry.Key == key {
            v := f.entry.Value.vacate()
            f.entry.Key.vacate()
            if prev is null { s.buckets[i] = f.next } else { prev.next = f.next }
            f.next = s.free
            s.free = f
            s.count--
            return v
        }
        prev = f
    }
    error MapError.Missing
}

# removes every key and its value. The slots are kept for the keys put next, and the buckets stay as many as they
# were, so emptying a map and filling it again allocates nothing
fn (m mut Map<K, V>&) Clear() {
    s := m.s
    for i in range s.buckets.Len() {
        f mut mapSlot<K, V>?&s = s.buckets[i]
        for f is not null {
            after := f.next
            f.entry.vacate()
            f.next = s.free
            s.free = f
            f = after
        }
        s.buckets[i] = null
    }
    s.count = 0
}

# a new Map - built where the result lands - holding the same keys and values, with storage of its own: the copy a Map
# value's own copy is not (a copy of the value names the same map). Its buckets are as many as m's and each chain is
# copied in order, so it is walked in the order m is; keys and values are copied as values, so references stay the
# same references
fn (m Map<K, V>&) Clone() Map<K, V> {
    c := Map<K, V>()
    s := m.s
    t := c.s
    t.buckets = Array<mut mapSlot<K, V>?&>(s.buckets.Len())
    for i in range s.buckets.Len() {
        last mut mapSlot<K, V>?&t = null
        for f mapSlot<K, V>?&s = s.buckets[i], f is not null, f = f.next {
            n mut mapSlot<K, V>&t = mapSlot<K, V>(f.entry.Key, f.entry.Value, null)
            if last is null { t.buckets[i] = n } else { last.next = n }
            last = n
        }
    }
    t.count = s.count
    return c
}

# whether two Maps hold the same keys, each with an equal value - "==" (E10a), whatever order they were put in
fn (m Map<K, V>&) Eq(o Map<K, V>&) Bool {
    if m.Len() != o.Len() { return false }
    for e in m {
        v := try o.Get(e.Key) catch MapError { return false }
        if v != e.Value { return false }
    }
    return true
}

# the entries' hashes summed, so equal Maps hash alike whatever order they were put in (E10b)
fn (m Map<K, V>&) Hash() I64 {
    h I64 = 0
    for e in m { h += e.Key.Hash() * 1099511628211 + e.Value.Hash() }
    return h
}

# how "$" renders a Map (E11c): its entries in the order a walk gives them, each "key: value", in braces after the Map's
# type - "Map<String&, I64>{"a": 1, "b": 2}", "Map<I64, Bool>{}" - each key and value rendering as it does inside any
# other value: text quoted, a Char as a character literal, a value whose type declares Str as its Str says (once each)
fn (m Map<K, V>&) Str() String {
    b := StringBuilder()
    b.Push("Map<" $typeWritten(Array<K>(0)) ", " $typeWritten(Array<V>(0)) ">{")
    n I64 = 0
    for e in m {
        if n > 0 { b.Push(", ") }
        n++
        k := $alone(e.Key)                                     # "(" the key ", false)"
        b.Push(k[1:k.Len() - 8])
        b.Push(": ")
        v := $alone(e.Value)
        b.Push(v[1:v.Len() - 8])
    }
    b.PushChar('}')
    return b.ToString()
}

# x and false - so that "$" renders x as it does inside another value, text and characters quoted (E11a), with nothing
# built around it: a value built only to be rendered would have to live exactly where what it holds lives
fn alone<T>(x T) T, Bool { return x, false }

# T as written - what "$" puts before an array's items, and what a Map's rendering names its key and value types by
fn typeWritten<T>(a Array<T>&) String {
    match T {
        case Char { return "Char" }                            # an array of Char renders as text
        case _ { }
    }
    r := $a[0:0]                                               # "T[]"
    return $r[:r.Len() - 2]
}

# a position in a Map - handed out fresh by Iter(), so the map keeps none and every loop gets its own. It holds the
# next slot itself, so each step follows one link rather than walking a chain from its start. The entry just given may
# be removed while the walk goes on; any other change to the map during a walk leaves which entries the rest of it gives
# unspecified
type MapIter<K, V> struct(of Map<K, V>&) {
    m mapState<K, V>&of = of.s
    bucket I64 = 0                              # the next bucket to start a chain from
    slot mut mapSlot<K, V>?&of = null           # the next slot along the current chain; null once it is walked
    given mut mapSlot<K, V>?&of = null          # the slot given last
}

fn (it mut MapIter<K, V>&) Next() MapEntry<K, V> ? Exhausted {
    try it.advance()
    return it.given!.entry      # read through a field of its own, where the map's entries live (O23a)
}

# on to the next slot, which becomes the one given - failing with Exhausted when every slot has been
fn (it mut MapIter<K, V>&) advance() ? Exhausted {
    s := it.slot
    for s is null {
        if it.bucket >= it.m.buckets.Len() { error Exhausted.End }
        s = it.m.buckets[it.bucket]
        it.bucket++
    }
    it.given = s
    it.slot = s.next
}

# the entries, one at a time, in no order to rely on. In order of their keys it is two lines - the entries listed, then
# sorted - with no lookup that could fail:
#
#     es := m.Iter().ToVec()
#     es.Sort(fn(a, b) { return a.Key < b.Key })
#     for e in es { ... e.Key ... e.Value ... }
fn (m Map<K, V>&) Iter() MapIter<K, V> { return MapIter<K, V>(m) }

# the keys, one at a time, in the order Iter() gives the entries: "for k in m.Keys()", "m.Keys().ToVec()" for a Vec of
# them. A walk of the map as Iter's is, under the same rule for changes made during it
fn (m Map<K, V>&) Keys() MapKeyIter<K, V> { return MapKeyIter<K, V>(m) }

# the values, one at a time, in the order Iter() gives the entries
fn (m Map<K, V>&) Values() MapValueIter<K, V> { return MapValueIter<K, V>(m) }

# Each holds the walk itself, as MapIter does, rather than a MapIter: what it gives is then read through a field of its
# own, which is where the map's entries live (O23a), and "for k in m.Keys() { l.Push(k) }" keeps a key as "for e in m"
# keeps an entry's
type MapKeyIter<K, V> struct(of Map<K, V>&) {
    m mapState<K, V>&of = of.s
    bucket I64 = 0                              # the next bucket to start a chain from
    slot mut mapSlot<K, V>?&of = null           # the next slot along the current chain; null once it is walked
}

fn (it mut MapKeyIter<K, V>&) Next() K ? Exhausted {
    s := it.slot
    for s is null {
        if it.bucket == it.m.buckets.Len() { error Exhausted.End }
        s = it.m.buckets[it.bucket]
        it.bucket++
    }
    it.slot = s.next
    return s.entry.Key
}

type MapValueIter<K, V> struct(of Map<K, V>&) {
    m mapState<K, V>&of = of.s
    bucket I64 = 0
    slot mut mapSlot<K, V>?&of = null
}

fn (it mut MapValueIter<K, V>&) Next() V ? Exhausted {
    s := it.slot
    for s is null {
        if it.bucket == it.m.buckets.Len() { error Exhausted.End }
        s = it.m.buckets[it.bucket]
        it.bucket++
    }
    it.slot = s.next
    return s.entry.Value
}

# the tests, and what only they use - under TestBuild, so a program that is not being tested compiles none of it: the
# prelude is part of every program

if TestBuild {
    # examples (B7a): what olang doc shows under the method
    test Map.Get "gives the value put for a key" {
        m := Map<String&, I64>()
        m.Put("one", 1)
        assert (try m.Get("one") catch default 0) == 1
    }
    test Map.Get "fails on a key never put" {
        m := Map<String&, I64>()
        assert (try m.Get("none") catch MapError default -1) == -1
    }
}
