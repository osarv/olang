# Map - values found by key, compared with "==" (E10). Part of the prelude, as List is: "Map<K, V>" is named bare
# everywhere. A key is any type with a "Hash() I64" agreeing with "==": the prelude gives it to the integers and
# String, the compiler supplies one for a struct, enum or array value whose parts all have one (E10b), and a key type
# declaring Eq declares its Hash too.
#
# Buckets of chained slots, a power of two of them, doubled when the map is three-quarters full. Everything a
# Map allocates lives where the Map does (its fields are bare "&", C2d), so it is reclaimed with that scope and
# needs no destructor. Growing re-links the existing slots into new buckets and copies nothing else; the old
# bucket array stays in the scope until it closes, as anything an arena holds does.
#
# A key or value that is a reference ("Map<String&, I32>") is stored as the reference - it must outlive the
# map, which every call checks (O10b).

# one key and its value, as a "for ... in" over a Map gives them
type MapEntry<K, V> struct(key <K>, value <V>) {
    Key mut <K> = key
    Value mut <V> = value
}

# a key and its value where the Map keeps them, and the next of its chain. The entry is held whole, so a walk hands out
# a copy of one that already exists rather than building one per step
type mapSlot<K, V> struct(key <K>, value <V>, next mut mapSlot<<K>, <V>>&) {
    entry mut MapEntry<<K>, <V>> = MapEntry<<K>, <V>>(key, value)
    next mut
}

type Map<K Hashable<<K>>, V> struct() {
    buckets mut Array<mut mapSlot<<K>, <V>>&>& = Array<mut mapSlot<<K>, <V>>&>(8)
    count mut I64 = 0
    free mut mapSlot<<K>, <V>>& = null          # slots of removed keys, chained through next, for the next keys put
}

fn (m Map<<K>, <V>>&) Len() I64 { return m.count }

fn (m Map<<K>, <V>>&) bucketOf(key <K>) I64 { return key.Hash() & (m.buckets.Len() - 1) }

# a new key and its value, at the head of bucket i's chain - in a slot a removed key left, when there is one, so a Map
# whose keys come and go stays the size of what it holds
fn (m mut Map<<K>, <V>>&) add(i I64, key <K>, value <V>) {
    if m.free == null {
        m.buckets[i] = mapSlot<<K>, <V>>(key, value, m.buckets[i])
    } else {
        s mapSlot<<K>, <V>>&m = m.free
        m.free = s.next
        s.entry.Key = key
        s.entry.Value = value
        s.next = m.buckets[i]
        m.buckets[i] = s
    }
    m.count++
    if m.count * 4 > m.buckets.Len() * 3 { m.grow() }
}

# sets the value for key, replacing the one it had
fn (m mut Map<<K>, <V>>&) Put(key <K>, value <V>) {
    i := m.bucketOf(key)
    for s mapSlot<<K>, <V>>&m = m.buckets[i], s != null, s = s.next {
        if s.entry.Key == key {
            s.entry.Value = value
            return
        }
    }
    m.add(i, key, value)
}

# doubles the buckets and re-links every slot into its new one
fn (m mut Map<<K>, <V>>&) grow() {
    old := m.buckets
    m.buckets = Array<mut mapSlot<<K>, <V>>&>(old.Len() * 2)
    for i in range old.Len() {
        s mapSlot<<K>, <V>>&m = old[i]
        for s != null {
            after := s.next
            j := m.bucketOf(s.entry.Key)
            s.next = m.buckets[j]
            m.buckets[j] = s
            s = after
        }
    }
}

# the value for key made f(its value) - or, where key has none, f(init) put for it: counting is
# "m.Update(word, 0, fn(n) { return n + 1 })". One hash and one walk of key's chain, where Get then Put take two
fn (m mut Map<<K>, <V>>&) Update(key <K>, init <V>, f fn(v <V>) <V>) {
    i := m.bucketOf(key)
    for s mapSlot<<K>, <V>>&m = m.buckets[i], s != null, s = s.next {
        if s.entry.Key == key {
            s.entry.Value = f(s.entry.Value)
            return
        }
    }
    m.add(i, key, f(init))
}

# the value for key - failing with the default error when there is none, so a miss is never read as a value:
# "try m.Get(k) catch default 0" gives a fallback, "try m.Get(k)" passes the miss on, "k in m" only asks
fn (m Map<<K>, <V>>&) Get(key <K>) <V> ? {
    for s mapSlot<<K>, <V>>&m = m.buckets[m.bucketOf(key)], s != null, s = s.next {
        if s.entry.Key == key { return s.entry.Value }
    }
    error
}

# whether key has a value - what "key in m" asks (E29)
fn (m Map<<K>, <V>>&) Has(key <K>) Bool {
    for s mapSlot<<K>, <V>>&m = m.buckets[m.bucketOf(key)], s != null, s = s.next {
        if s.entry.Key == key { return true }
    }
    return false
}

# removes key and its value, and says whether it was there. Its slot is kept for the next key put
fn (m mut Map<<K>, <V>>&) Remove(key <K>) Bool {
    i := m.bucketOf(key)
    prev mapSlot<<K>, <V>>&m = null
    for s mapSlot<<K>, <V>>&m = m.buckets[i], s != null, s = s.next {
        if s.entry.Key == key {
            if prev == null { m.buckets[i] = s.next } else { prev.next = s.next }
            s.next = m.free
            m.free = s
            m.count--
            return true
        }
        prev = s
    }
    return false
}

# a position in a Map - handed out fresh by Iter(), so the map keeps none and every loop gets its own. It holds the
# next slot itself, so each step follows one link rather than walking a chain from its start. The entry just given may
# be removed while the walk goes on; any other change to the map during a walk leaves which entries the rest of it gives
# unspecified
type MapIter<K, V> struct(of Map<<K>, <V>>&) {
    m Map<<K>, <V>>&of = of
    bucket mut I64 = 0                          # the next bucket to start a chain from
    slot mut mapSlot<<K>, <V>>&of = null        # the next slot along the current chain; null once it is walked
    given mut mapSlot<<K>, <V>>&of = null       # the slot given last
}

fn (it mut MapIter<<K>, <V>>&) Next() MapEntry<<K>, <V>> ? Exhausted {
    for it.slot == null {
        if it.bucket == it.m.buckets.Len() { error Exhausted.END }
        it.slot = it.m.buckets[it.bucket]
        it.bucket++
    }
    it.given = it.slot
    it.slot = it.slot.next
    return it.given.entry
}

fn (m Map<<K>, <V>>&) Iter() MapIter<<K>, <V>> { return MapIter<<K>, <V>>(m) }

test "put, get, replace, remove" {
    m := Map<I32, I64>()
    m.Put(1, 10)
    m.Put(2, 20)
    assert (try m.Get(1) catch default -1) == 10
    m.Put(1, 11)
    assert (try m.Get(1) catch default -1) == 11 and m.Len() == 2
    assert (try m.Get(3) catch default -1) == -1
    missed := false
    try m.Get(3) catch { missed = true }
    assert missed
    assert m.Remove(1) and not m.Remove(1)
    assert not m.Has(1) and m.Has(2) and m.Len() == 1
}

test "Update counts in one lookup, inserting f(init) for a missing key" {
    text String& = "a b a c a b"
    m := Map<String&, I64>()
    for w in text.Split(" ") { m.Update(w, 0, fn(n) { return n + 1 }) }
    assert m.Len() == 3
    assert (try m.Get("a") catch default 0) == 3 and (try m.Get("b") catch default 0) == 2
    assert (try m.Get("c") catch default 0) == 1
    d := Map<I32, I32>()
    d.Update(7, 10, fn(v) { return v * 2 })            # missing: f(init) goes in
    assert (try d.Get(7) catch default 0) == 20
    d.Update(7, 10, fn(v) { return v * 2 })            # present: f(its value)
    assert (try d.Get(7) catch default 0) == 40 and d.Len() == 1
    g := Map<I32, I32>()
    for i in range 3000 { g.Update(I32(i % 1000), 0, fn(v) { return v + 1 }) }     # grows while updating
    assert g.Len() == 1000
    for i in range 1000 { assert (try g.Get(I32(i)) catch default 0) == 3 }
}

# the same, computed while compiling (K2) - the evaluator runs Update and its lambda as the run time does
fn wordCounts() I64 {
    text String& = "to be or not to be"
    m := Map<String&, I64>()
    for w in text.Split(" ") { m.Update(w, 0, fn(n) { return n + 1 }) }
    return (try m.Get("to") catch default 0) * 100 + (try m.Get("be") catch default 0) * 10 + m.Len()
}

wordCountsBaked := wordCounts()

test "Update, evaluated while compiling as at run time" {
    assert wordCountsBaked == 224
    assert wordCounts() == wordCountsBaked
}

test "a map grows, and keeps every key through it" {
    m := Map<I32, I32>()
    for i in range 1000 { m.Put(i, i * i) }
    assert m.Len() == 1000
    for i in range 1000 {
        assert (try m.Get(i) catch default -1) == i * i
    }
}

test "text keys compare by what they say" {
    m := Map<String&, I32>()
    m.Put("apple", 1)
    m.Put("pear", 2)
    key := String(U8['p', 'e', 'a', 'r'])
    assert (try m.Get(key) catch default -1) == 2
}

test "for ... in visits every entry once" {
    m := Map<I32, I32>()
    for i in range 50 { m.Put(I32(i), I32(i) * 2) }
    keys I64 = 0
    values I64 = 0
    for e in m {
        keys = keys + e.Key
        values = values + e.Value
    }
    assert keys == 1225 and values == 2450
}

test "a pair is a key when both its parts are" {
    m := Map<Pair<I32, I32>, I32>()
    for i in range 20 { m.Put(Pair(I32(i), I32(i) + 1), I32(i)) }
    assert (try m.Get(Pair(7, 8)) catch default -1) == 7
    assert not m.Has(Pair(8, 7))
}

test "membership in a Map is by key" {
    m := Map<String&, I32>()
    m.Put("k", 1)
    assert "k" in m
    assert "z" not in m
}

# a lookup and a miss, computed while compiling (K2) - the same answers as at run time
fn lookupBoth() I32 {
    m := Map<I32, I32>()
    m.Put(4, 40)
    return (try m.Get(4) catch default 0) + (try m.Get(5) catch default 1)
}

lookupBaked := lookupBoth()

test "a miss is an error, evaluated while compiling as at run time" {
    assert lookupBaked == 41
    assert lookupBoth() == lookupBaked
}

test "E10: with no Eq anywhere, == is the built-in comparison and a Map takes any key with a Hash" {
    a := Pair(1, I64(2))
    assert a == Pair(1, I64(2)) and a != Pair(2, I64(2))
    m := Map<Pair<I32, I64>, I32>()
    m.Put(a, 7)
    assert try m.Get(Pair(1, I64(2))) catch default 0 == 7
}

# E10b: keys with no Hash written - the compiler supplies one from the parts, while compiling as at run time
type hPt struct(x I32, y I32) {
    x
    y
}
type hTagged struct(name String&, at hPt) {
    name
    at
}
type hShape enum {
    Circle(r I32)
    Rect(w I32, h I32)
    Blank
}
fn hashKeys() Bool {
    m := Map<hPt, I32>()
    m.Put(hPt(1, 2), 5)
    m.Put(hPt(2, 1), 6)
    t := Map<hTagged, I32>()
    s String& = "ab"
    t.Put(hTagged(s, hPt(0, 0)), 1)
    e := Map<hShape, I32>()
    e.Put(hShape.Rect(1, 2), 4)
    e.Put(hShape.Circle(1), 7)
    n String& = null
    pts Bool = try m.Get(hPt(1, 2)) catch default 0 == 5 and try m.Get(hPt(2, 1)) catch default 0 == 6
    tagged Bool = try t.Get(hTagged("ab", hPt(0, 0))) catch default 0 == 1 and hTagged(n, hPt(0, 0)).Hash() == hTagged(n, hPt(0, 0)).Hash()
    shapes Bool = try e.Get(hShape.Rect(1, 2)) catch default 0 == 4 and not (hShape.Rect(2, 1) in e) and not (hShape.Blank in e)
    arrays Bool = I32[1, 2].Hash() == I32[1, 2].Hash() and I32[1, 2].Hash() != I32[2, 1].Hash()
    return pts and tagged and shapes and arrays and hPt(1, 2).Hash() != hPt(2, 1).Hash()
}
hashKeysBaked := hashKeys()

test "E10b: a struct, an enum or an array is a key with no Hash written" {
    assert hashKeys()
    assert hashKeysBaked
}

# E10b: an enum one of whose cases holds a reference - each case's payload is read only where that case holds, so
# hashing a value of another case reads nothing it does not have
type hLabel enum {
    Unnamed
    Named(s String&)
    Pos(n I64, m U8)
}
fn labelKeys() Bool {
    m := Map<hLabel, I32>()
    m.Put(hLabel.Named("ab"), 1)
    m.Put(hLabel.Pos(5, 6), 2)
    m.Put(hLabel.Unnamed, 3)
    got Bool = try m.Get(hLabel.Named("ab")) catch default 0 == 1 and try m.Get(hLabel.Pos(5, 6)) catch default 0 == 2
    rest Bool = try m.Get(hLabel.Unnamed) catch default 0 == 3 and not (hLabel.Pos(5, 7) in m)
    u := hLabel.Unnamed
    h := hTagged("ab", hPt(1, 2)).Hash()           # D15: a supplied Hash names its type as a call does
    return got and rest and u.Hash() != hLabel.Named("ab").Hash() and h == hTagged("ab", hPt(1, 2)).Hash()
}
LabelKeysBaked := labelKeys()

test "E10b: an enum whose cases hold references hashes whichever case it holds" {
    assert labelKeys()
    assert LabelKeysBaked
}

# T29e/T29f/G19: a type extending I64 has I64's Hash, and an inherited method meets a trait as it answers a direct
# call - so it is a key with nothing written; one declaring its own Eq declares its own Hash, replacing the base's
type hExtId extends I64
type hModId extends I64
fn (a hModId) Eq(b hModId) Bool { return I64(a) % 100 == I64(b) % 100 }
fn (a hModId) Hash() I64 { return I64(a) % 100 }
fn (a hModId) Str() String { return "mod" $(I64(a) % 100) }
fn extKeys() Bool {
    m := Map<hExtId, I32>()
    m.Put(hExtId(105), 1)
    n := Map<hModId, I32>()
    n.Put(hModId(105), 2)
    plain Bool = try m.Get(hExtId(105)) catch default 0 == 1 and not (hExtId(5) in m)
    return plain and try n.Get(hModId(205)) catch default 0 == 2 and $hModId(7) == "mod7"
}
ExtKeysBaked := extKeys()

test "T29e/G19: a type extending a number is a key through its inherited Hash, or through its own" {
    assert extKeys()
    assert ExtKeysBaked
}

# MapIter holds the slot it is at, so a walk follows one link per entry, over chains of any length, with text keys
# as with any other; and the evaluator walks it as the run time does (K2)
fn walkedKeys() I64 {
    m := Map<String&, I64>()
    m.Put("one", 1)
    m.Put("two", 2)
    m.Put("three", 3)
    for i in range 200 { m.Put($i, i) }        # renderings, built where the map lives
    total I64 = 0
    for e in m { total += e.Value * e.Key.Len() }
    return total
}

walkedBaked := walkedKeys()

test "walking a Map of text keys, evaluated while compiling as at run time" {
    assert walkedKeys() == walkedBaked
    n I64 = 0
    for i in range 200 { n += i * ($i).Len() }
    assert walkedBaked == 1 * 3 + 2 * 3 + 3 * 5 + n
}

# O18b: a key rendered in a loop body is built where the map lives, so it survives the loop's arena being reused - read
# back after churning the arena hard; and one map's entries go into another through its iterator, which reads where
# the first map lives (O23a)
mapRuntime mut I64 = 50 #mutable, so the test runs (a call given a constant would be decided while compiling, S18c)

fn mapChurn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    return t
}

test "O18b/O23a: text keys put in a loop survive it, and one map's entries go into another" {
    m := Map<String&, I64>()
    for i in range mapRuntime {
        m.Put($i, i)
        scratch Array<I64>& = Array<I64>(8, 999)
        scratch[0] = 5
    }
    mapChurn()
    total I64 = 0
    for i in range mapRuntime { total += try m.Get($i) catch default 1000 }
    assert total == 1225
    m2 := Map<String&, I64>()
    for e in m { m2.Put(e.Key, e.Value) }
    mapChurn()
    assert m2.Len() == 50 and (try m2.Get("49") catch default -1) == 49
}

# O18c: an entry walked out of a Map that arrived as a parameter keeps its key where that map keeps it, so the key may
# go into another map or be returned as the map's own - keys rendered in a loop, read back after churning the arena
fn mapCopyInto(from Map<String&, I64>&, into mut Map<String&, I64>&) {
    for e in from { into.Put(e.Key, e.Value) }
}
fn mapAnyKey(from Map<String&, I64>&) String&from {
    for e in from { return e.Key }
    return ""
}

test "O18c: a Map's entries, walked through a parameter, go into another map and out as its own keys" {
    m := Map<String&, I64>()
    for i in range mapRuntime { m.Put($i, i) }
    m2 := Map<String&, I64>()
    mapCopyInto(m, m2)
    k := mapAnyKey(m)
    mapChurn()
    total I64 = 0
    for i in range mapRuntime { total += try m2.Get($i) catch default 1000 }
    assert total == 1225 and m2.Len() == 50
    assert (try m.Get(k) catch default -1) == (try k.ParseInt() catch default -2)
}

# T25d: constant text elements of a read-only array literal walked by for-in are the static data itself, so they may go
# into a map anywhere; O1b/O25e: a global map read through read-only receivers binds their scope to the program's
fn mapGlobalMade() Map<I32, I32>& {
    m Map<I32, I32>&return = Map<I32, I32>()
    m.Put(1, 2)
    return m
}
MapGlobal Map<I32, I32>& = mapGlobalMade()

test "T25d/O1b: constant text keys put from a for-in, and a global map read through read-only receivers" {
    m := Map<String&, I64>()
    if mapRuntime > 0 {
        for nm in String&["ann", "bobby"] { m.Put(nm, nm.Len()) }
    }
    mapChurn()
    assert (try m.Get("bobby") catch default -1) == 5 and m.Len() == 2
    assert 1 in MapGlobal and (try MapGlobal.Get(1) catch default -1) == 2 and MapGlobal.Len() == 1
}

# a Map whose values are Lists - a group-by, a multimap - is filled through Get and walked by "for ... in": an entry is a
# copy of one the map holds, so its Value is the very List
fn groupInto(groups mut Map<I64, mut List<I64>&>&, n I64) ? {
    for i in range n {
        k I64 = i % 3
        if k not in groups { groups.Put(k, List<I64>()) }
        g := try groups.Get(k)
        g.Push(i)
    }
}

fn groupBy(n I64) I64 {
    groups := Map<I64, mut List<I64>&>()
    try groupInto(groups, n) catch { unreachable }
    total I64 = 0
    for e in groups { total += e.Key * 1000 + e.Value.Len() }
    return total
}

groupByBaked := groupBy(10)

test "a Map of Lists is filled and walked" {
    assert groupBy(10) == groupByBaked
    assert groupByBaked == 0 * 1000 + 4 + 1 * 1000 + 3 + 2 * 1000 + 3
}

# a struct or an enum with a Bool part is a key: Bool has a Hash (E10b)
type mapFlagged struct(on Bool, n I32) {
    on
    n
}
type mapToggle enum {
    Off
    On(fast Bool)
}
test "keys with Bool parts" {
    m := Map<mapFlagged, I32>()
    m.Put(mapFlagged(true, 1), 10)
    m.Put(mapFlagged(false, 1), 20)
    assert (try m.Get(mapFlagged(true, 1)) catch default 0) == 10 and (try m.Get(mapFlagged(false, 1)) catch default 0) == 20
    t := Map<mapToggle, I32>()
    t.Put(mapToggle.On(true), 1)
    t.Put(mapToggle.Off, 2)
    assert mapToggle.On(true) in t and mapToggle.On(false) not in t and mapToggle.Off in t
}

# a removed key's slot is reused by the next key put, so a Map whose keys come and go keeps the size of what it holds
# (checks/cases/mapchurn measures it) - and every key keeps its own value through the reuse
test "removed slots are reused, and keys keep their values" {
    m := Map<I64, I64>()
    for i in range 10000 {
        m.Put(i, i * 3)
        if i >= 50 { assert m.Remove(i - 50) }
    }
    assert m.Len() == 50
    for i in range 9950, 10000 { assert (try m.Get(i) catch default -1) == i * 3 }
    assert 9949 not in m and 0 not in m
    free I64 = 0
    for s mapSlot<I64, I64>& = m.free, s != null, s = s.next { free++ }
    assert free <= 1                                    # each removal's slot was taken by the next put
}

# the entry a walk just gave may be removed while the walk goes on - the walk has already moved past it - so filtering a
# map in place is one loop
test "removing the entry just given, during a walk" {
    m := Map<I32, I32>()
    for i in range 100 { m.Put(I32(i), I32(i)) }
    seen I32 = 0
    for e in m {
        seen++
        if e.Key % 2 == 0 { assert m.Remove(e.Key) }
    }
    assert seen == 100 and m.Len() == 50
    for e in m { assert e.Key % 2 == 1 and e.Value == e.Key }
}
