# Map - values found by key, compared with "==" (E10). Part of the prelude, as Vec is: "Map<K, V>" is named bare
# everywhere. A key is any type with a "Hash() I64" agreeing with "==": the prelude gives it to the integers and
# String, the compiler supplies one for a struct, enum or array value whose parts all have one (E10b), and a key type
# declaring Eq declares its Hash too.
#
# The entries are held in slots, one array of them in the order the slots were first used, and found through buckets of
# chained slot numbers - a power of two of them, doubled when the map is three-quarters full. A removed key's slot is
# emptied and kept for the next key put, so a Map whose keys come and go stays the size of what it holds. Growing makes
# a slot array twice the size, the entries moved into it, and re-chains the slots into new buckets; the old arrays stay
# in the scope until it closes, as anything an arena holds does.
#
# A Map is a VALUE, as a Vec is: it holds its entries by value (QCE), so a copy of a Map ("c := m", a field, an element,
# a by-value argument, a task's argument) is a map of its own holding the same keys and values - deep through values,
# shallow at references - and a Put to one is never seen through the other. Sharing one map is written with "&" ("m mut
# Map<K, V>&"); a value is read where the map holds it through Ref(key), and changed there through RefMut(key)
# ("m.RefMut(k).Push(x)" for a Map of Vecs) or Update. Everything a Map allocates lives where it does, so it is
# reclaimed with that scope and needs no destructor.
#
# A key or value that is a reference ("Map<String&, I32>") is stored as the reference - it must outlive the
# map, which every call checks (O10b). A key held by value ("Map<String, I32>") is the map's own copy, made when the key
# is first put (MapEntry's constructor); an update or a lookup copies nothing.

# what a Map's Get and Take fail with: no value for the key
type MapError error {
    Missing
}

# one key and its value, as a "for ... in" over a Map gives them
type MapEntry<K, V> struct(key K, value V) {
    Key K = key
    Value V = value
}

type Map<K Hashable<K>, V> struct() {
    ents Array<MapEntry<K, V>>                  # the slots; the first n are in use or emptied (a removed key's)
    next Array<I64>                             # by slot: the next of its bucket's chain, -1 at the end - for an emptied
                                                # slot the next emptied one, below -1 (freeLink)
    buckets Array<I64>                          # by bucket: its chain's first slot, -1 for none; none before the first Put
    n I64 = 0                                   # the slots used
    count I64 = 0
    free I64 = -1                               # the emptied slot a key put next takes, -1 for none
}

fn (m Map<K, V>&) Len() I64 { return m.count }

fn (m Map<K, V>&) bucketOf(key K) I64 { return key.Hash() & (m.buckets.Len() - 1) }

# an emptied slot's next link, which holds the emptied slot after it, f (-1 for none), below every chain's link
fn freeLink(f I64) I64 { return -3 - f }

# whether slot i holds an entry: chained in a bucket, not emptied
fn (m Map<K, V>&) live(i I64) Bool { return m.next[i] >= -1 }

# the slot holding key - failing with Missing when no slot does
fn (m Map<K, V>&) slotOf(key K) I64 ? MapError {
    if m.count == 0 { error MapError.Missing }
    for i := m.buckets[m.bucketOf(key)], i >= 0, i = m.next[i] {
        if m.ents[i].Key == key { return i }
    }
    error MapError.Missing
}

# a new key and its value, at the head of bucket b's chain - in a slot a removed key emptied, when there is one
fn (m mut Map<K, V>&) add(b I64, key K, value V) {
    i := m.free
    if i >= 0 {
        m.free = freeLink(m.next[i])
    } else {
        if m.n == m.ents.Len() { m.room() }
        i = m.n
        m.n++
    }
    m.ents[i] = MapEntry<K, V>(key, value)
    m.next[i] = m.buckets[b]
    m.buckets[b] = i
    m.count++
    if m.count * 4 > m.buckets.Len() * 3 { m.rehash() }
}

# slot arrays twice the size (8 at first), the slots moved into them, grown from the old as a Vec's buffer is (M19d) -
# the room past them never read before an add writes it, and the old arrays retired
fn (m mut Map<K, V>&) room() {
    r I64 = 8 if m.ents.Len() < 4 else m.ents.Len() * 2
    oe Array<MapEntry<K, V>>& = m.ents
    m.ents = oe[:m.n].grown(r)
    oe.retire()
    on Array<I64>& = m.next
    m.next = on[:m.n].grown(r)
    on.retire()
}

# twice the buckets, every slot in use chained into its new one
fn (m mut Map<K, V>&) rehash() {
    m.buckets = Array<I64>(m.buckets.Len() * 2, -1)
    for i in range m.n {
        if not m.live(i): continue
        b := m.bucketOf(m.ents[i].Key)
        m.next[i] = m.buckets[b]
        m.buckets[b] = i
    }
}

# sets the value for key, replacing the one it had
fn (m mut Map<K, V>&) Put(key K, value V) {
    if m.buckets.Len() == 0 { m.buckets = Array<I64>(8, -1) }
    b := m.bucketOf(key)
    for i := m.buckets[b], i >= 0, i = m.next[i] {
        if m.ents[i].Key == key {
            m.ents[i].Value = value
            return
        }
    }
    m.add(b, key, value)
}

# the value for key made f(its value) - or, where key has none, f(init) put for it: counting is
# "m.Update(word, 0, fn(n) { return n + 1 })". One hash and one walk of key's chain, where Get then Put take two
fn (m mut Map<K, V>&) Update(key K, init V, f fn(v V) V) {
    if m.buckets.Len() == 0 { m.buckets = Array<I64>(8, -1) }
    b := m.bucketOf(key)
    for i := m.buckets[b], i >= 0, i = m.next[i] {
        if m.ents[i].Key == key {
            m.ents[i].Value = f(m.ents[i].Value)
            return
        }
    }
    m.add(b, key, f(init))
}

# the value for key - failing with Missing when there is none, so a miss is never read as a value:
# "try m.Get(k) catch default 0" gives a fallback, "try m.Get(k)" passes the miss on, "k in m" only asks
fn (m Map<K, V>&) Get(key K) V ? MapError { return m.ents[try m.slotOf(key)].Value }

# the value for key where the map holds it, read with no copy made (Get gives one) - failing with Missing when there is
# none. Good until the map grows (a Put of a new key may move the values) or loses the key
fn (m Map<K, V>&) Ref(key K) V& ? MapError { return m.ents[try m.slotOf(key)].Value }

# ...writable, to change in place - "m.RefMut(k).Push(x)" for a Map of Vecs
fn (m mut Map<K, V>&) RefMut(key K) mut V& ? MapError { return m.ents[try m.slotOf(key)].Value }

# whether key has a value - what "key in m" asks (E29)
fn (m Map<K, V>&) Has(key K) Bool {
    try m.slotOf(key) catch { return false }
    return true
}

# key's slot taken out of its chain and emptied, kept for the next key put - failing with Missing when there is none.
# take: the value moved out and given (Take), else let go (Remove)
fn (m mut Map<K, V>&) unlink(key K) I64 ? MapError {
    if m.count == 0 { error MapError.Missing }
    b := m.bucketOf(key)
    prev I64 = -1
    for i := m.buckets[b], i >= 0, i = m.next[i] {
        if m.ents[i].Key == key {
            if prev < 0 { m.buckets[b] = m.next[i] } else { m.next[prev] = m.next[i] }
            m.next[i] = freeLink(m.free)
            m.free = i
            m.count--
            return i
        }
        prev = i
    }
    error MapError.Missing
}

# removes key and its value, and says whether it was there. Its slot is kept for the next key put
fn (m mut Map<K, V>&) Remove(key K) Bool {
    i := try m.unlink(key) catch { return false }
    m.ents[i].vacate()
    return true
}

# removes key and gives its value - Get and Remove in one, failing with Missing when there is none. Its slot is kept for
# the next key put
fn (m mut Map<K, V>&) Take(key K) V ? MapError {
    i := try m.unlink(key)
    m.ents[i].Key.vacate()
    return m.ents[i].Value.vacate()
}

# removes every key and its value. The slot arrays are kept for the keys put next, and the buckets stay as many as they
# were, so emptying a map and filling it again allocates nothing
fn (m mut Map<K, V>&) Clear() {
    for i in range m.n { m.ents[i].vacate() }
    for b in range m.buckets.Len() { m.buckets[b] = -1 }
    m.n = 0
    m.count = 0
    m.free = -1
}

# whether two Maps hold the same keys, each with an equal value - "==" (E10a), whatever order they were put in
fn (m Map<K, V>&) Eq(o Map<K, V>&) Bool {
    if m.Len() != o.Len() { return false }
    for e in m {
        v := try o.Get(e.Key) catch MapError { return false }
        if v != e.Value { return false }
    }
    return true
}

# the entries' hashes summed, so equal Maps hash alike whatever order they were put in (E10b)
fn (m Map<K, V>&) Hash() I64 {
    h I64 = 0
    for e in m { h += e.Key.Hash() * 1099511628211 + e.Value.Hash() }
    return h
}

# how "$" renders a Map (E11c): its entries in the order a walk gives them, each "key: value", in braces after the Map's
# type - "Map<String&, I64>{"a": 1, "b": 2}", "Map<I64, Bool>{}" - each key and value rendering as it does inside any
# other value: text quoted, a Char as a character literal, a value whose type declares Str as its Str says (once each)
fn (m Map<K, V>&) Str() String {
    b := StringBuilder()
    b.Push("Map<" $typeWritten(Array<K>(0)) ", " $typeWritten(Array<V>(0)) ">{")
    n I64 = 0
    # (the slots read where they are: an entry made of a value holding "mut" references, read through this read-only
    # receiver, would be a read-only copy, QC)
    for i in range m.n {
        if not m.live(i): continue
        if n > 0 { b.Push(", ") }
        n++
        k := $alone(m.ents[i].Key)                             # "(" the key ", 0)"
        b.Push(k[1:k.Len() - 4])
        b.Push(": ")
        v := $alone(m.ents[i].Value)
        b.Push(v[1:v.Len() - 4])
    }
    b.PushChar('}')
    return b.ToString()
}

# x and 0 - so that "$" renders x as it does inside another value, text and characters quoted (E11a), with nothing
# built around it: a value built only to be rendered would have to live exactly where what it holds lives
fn alone<T>(x T) T, I64 { return x, 0 }

# T as written - what "$" puts before an array's items, and what a Map's rendering names its key and value types by
fn typeWritten<T>(a Array<T>&) String {
    match T {
        case Char { return "Char" }                            # an array of Char renders as text
        case _ { }
    }
    r := $a[0:0]                                               # "T[]"
    return $r[:r.Len() - 2]
}

# a position in a Map - handed out fresh by Iter(), so the map keeps none and every loop gets its own: the next slot to
# look at, the slots walked in order - the order their keys were first put, but where a removed key's slot was taken
# again. The entry just given may be removed while the walk goes on; any other change to the map during a walk leaves
# which entries the rest of it gives unspecified, though never anything but entries of the map
type MapIter<K, V> struct(of Map<K, V>&) {
    m Map<K, V>& = of
    i I64 = 0
}

fn (it mut MapIter<K, V>&) Next() MapEntry<K, V> ? Exhausted {
    for it.i < it.m.n {
        k := it.i
        it.i++
        # (an entry of its own made from the slot's parts: a value reference read out of a map walked read-only is
        # what it is, while a copy of a whole entry holding one would be read-only, QC)
        if it.m.live(k): return MapEntry<K, V>(it.m.ents[k].Key, it.m.ents[k].Value)
    }
    error Exhausted.End
}

# the entries, one at a time, in no order to rely on. In order of their keys it is two lines - the entries listed, then
# sorted - with no lookup that could fail:
#
#     es := m.Iter().ToVec()
#     es.Sort(fn(a, b) { return a.Key < b.Key })
#     for e in es { ... e.Key ... e.Value ... }
fn (m Map<K, V>&) Iter() MapIter<K, V> { return MapIter<K, V>(m) }

# the keys, one at a time, in the order Iter() gives the entries: "for k in m.Keys()", "m.Keys().ToVec()" for a Vec of
# them. A walk of the map as Iter's is, under the same rule for changes made during it
fn (m Map<K, V>&) Keys() MapKeyIter<K, V> { return MapKeyIter<K, V>(m) }

# the values, one at a time, in the order Iter() gives the entries
fn (m Map<K, V>&) Values() MapValueIter<K, V> { return MapValueIter<K, V>(m) }

# Each holds the walk itself, as MapIter does: what it gives is read through a field of its own, which is where the
# map's entries live (O23a), and "for k in m.Keys() { l.Push(k) }" keeps a key as "for e in m" keeps an entry's
type MapKeyIter<K, V> struct(of Map<K, V>&) {
    m Map<K, V>& = of
    i I64 = 0
}

fn (it mut MapKeyIter<K, V>&) Next() K ? Exhausted {
    for it.i < it.m.n {
        k := it.i
        it.i++
        if it.m.live(k): return it.m.ents[k].Key
    }
    error Exhausted.End
}

type MapValueIter<K, V> struct(of Map<K, V>&) {
    m Map<K, V>& = of
    i I64 = 0
}

fn (it mut MapValueIter<K, V>&) Next() V ? Exhausted {
    for it.i < it.m.n {
        k := it.i
        it.i++
        if it.m.live(k): return it.m.ents[k].Value
    }
    error Exhausted.End
}

# the tests, and what only they use - under TestBuild, so a program that is not being tested compiles none of it: the
# prelude is part of every program

if TestBuild {
    # examples (B7a): what olang doc shows under the method
    test Map.Get "gives the value put for a key" {
        m := Map<String&, I64>()
        m.Put("one", 1)
        assert (try m.Get("one") catch default 0) == 1
    }
    test Map.Get "fails on a key never put" {
        m := Map<String&, I64>()
        assert (try m.Get("none") catch MapError default -1) == -1
    }
}
