# text, part of the prelude. A String is an Array<Char> with an identity of its own (T29a): it indexes, slices
# and goes to C as the array does, and text written in the program - a literal, a "$x" rendering, a join - is a
# String wherever one is wanted (T29c). Bytes become text with "String(bytes)", which copies nothing, and text goes
# wherever an Array<U8> is wanted as it is (T29h). "==" compares what two texts say (String's Eq, E10a); "a is b"
# asks whether they are one. There is no encoding check: a Char is one byte of text, a UTF-8 code unit. Numbers are read
# from text here too (ParseInt, ParseFloat), and a float's fewest digits worked out (ShortestDecimal) - exactly, in
# olang, so all of it runs while compiling as at run time.

# one byte of text (T29h): a U8 that renders as a character, the type of a character literal ('a'), and with U8's
# arithmetic ('a' + 1 is 'b')
type Char extends U8

fn (c Char) IsDigit() Bool { return c >= '0' and c <= '9' }
fn (c Char) IsLower() Bool { return c >= 'a' and c <= 'z' }
fn (c Char) IsUpper() Bool { return c >= 'A' and c <= 'Z' }
fn (c Char) IsLetter() Bool { return c.IsLower() or c.IsUpper() }
fn (c Char) IsSpace() Bool { return c == ' ' or c == '\t' or c == '\n' or c == '\r' }
fn (c Char) ToUpper() Char { return c - 32 if c.IsLower() else c }
fn (c Char) ToLower() Char { return c + 32 if c.IsUpper() else c }

type String extends Array<Char>

error ParseError {
    EMPTY
    INVALID
    OVERFLOW
}

# FNV-1a over the bytes: text that SAYS the same thing hashes the same, whatever storage holds it
fn (t String&) Hash() I64 {
    h I64 = -3750763034362895579
    for c in t {
        h = (h ^ c) * 1099511628211
    }
    return h
}

# the same bytes, in the same order
fn (a String&) Eq(b String&) Bool {
    if a.Len() != b.Len() {
        return false
    }
    for i in range a.Len() {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

# bytewise lexicographic order: -1, 0 or 1. A proper prefix sorts first.
fn (a String&) Compare(b String&) I32 {
    n I64 = a.Len()
    if b.Len() < n {
        n = b.Len()
    }
    for i in range n {
        if a[i] < b[i] {
            return -1
        }
        if a[i] > b[i] {
            return 1
        }
    }
    if a.Len() < b.Len() {
        return -1
    }
    if a.Len() > b.Len() {
        return 1
    }
    return 0
}

fn (a String&) StartsWith(prefix String&) Bool {
    if prefix.Len() > a.Len() {
        return false
    }
    return a[:prefix.Len()].Eq(prefix)
}

fn (a String&) EndsWith(suffix String&) Bool {
    if suffix.Len() > a.Len() {
        return false
    }
    return a[a.Len() - suffix.Len():].Eq(suffix)
}

# the index of the first occurrence of c - failing with the default error when there is none, so a miss is never read
# as a position: "try t.FindByte(c) catch default -1" gives a fallback, "c in t" only asks
fn (a String&) FindByte(c U8) I64 ? {
    for i in range a.Len() {
        if a[i] == c { return i }
    }
    error
}

# the index of the first occurrence of sub, failing with the default error when there is none. An empty sub is found
# at 0. Compared where it stands - each candidate's first byte, then the rest one byte at a time - so nothing is
# sliced per position
fn (a String&) Find(sub String&) I64 ? {
    return try a.findFrom(sub, 0)
}

# the index of the first occurrence of sub at or after from
fn (a String&) findFrom(sub String&, from I64) I64 ? {
    n I64 = sub.Len()
    if n == 0 { return from }
    first := sub[0]
    for i in range from, a.Len() - n + 1 {
        if a[i] == first {
            j I64 = 1
            for j < n and a[i + j] == sub[j] { j++ }
            if j == n { return i }
        }
    }
    error
}

# (Contains - whether sub occurs in it - is every array's, std/prelude/array.olang: text is an array of bytes)

# the pieces of the text between each occurrence of sep, in order - borrows of the receiver's own storage,
# so no text is copied, held in an array that lives where the receiver does. Adjacent separators, or one at
# either end, give empty pieces, so joining the pieces with sep gives the text back; text with no separator
# is one piece, and the empty text one empty piece. An empty sep splits the text into its single bytes.
# The pieces are counted first, so the array is allocated once at its exact length; for a one-byte sep the count is a
# plain loop over the bytes, which the optimizer turns into vector compares
fn (t String&) Split(sep String&) mut Array<String&>&t {
    if sep.Len() == 0 {
        bytes Array<String&>&t = Array<String&>(t.Len())
        for i in range t.Len() {
            bytes[i] = t[i:i + 1]
        }
        return bytes
    }
    if sep.Len() == 1 {
        c := sep[0]
        n I64 = 1
        for x in t {
            if x == c { n++ }
        }
        pieces Array<String&>&t = Array<String&>(n)
        k I64 = 0
        start I64 = 0
        for i in range t.Len() {
            if t[i] == c {
                pieces[k] = t[start:i]
                k++
                start = i + 1
            }
        }
        pieces[k] = t[start:]
        return pieces
    }
    n I64 = 1
    from I64 = 0
    for {
        at := try t.findFrom(sep, from) catch { break }
        n++
        from = at + sep.Len()
    }
    pieces Array<String&>&t = Array<String&>(n)
    from = 0
    for i in range n - 1 {
        at := try t.findFrom(sep, from) catch { unreachable }
        pieces[i] = t[from:at]
        from = at + sep.Len()
    }
    pieces[n - 1] = t[from:]
    return pieces
}

fn isSpace(c U8) Bool {
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'
}

# the text without leading and trailing whitespace - a borrow of the receiver's own storage, so it lives where the
# receiver does and costs no copy
fn (t String&) Trim() String&t {
    lo I64 = 0
    hi I64 = t.Len()
    for lo < hi and isSpace(t[lo]) {
        lo++
    }
    for hi > lo and isSpace(t[hi - 1]) {
        hi--
    }
    return t[lo:hi]
}

# the text without leading whitespace - a borrow of the receiver's own storage, as Trim's is
fn (t String&) TrimStart() String&t {
    lo I64 = 0
    for lo < t.Len() and isSpace(t[lo]) {
        lo++
    }
    return t[lo:]
}

# the text without trailing whitespace - a borrow of the receiver's own storage, as Trim's is
fn (t String&) TrimEnd() String&t {
    hi I64 = t.Len()
    for hi > 0 and isSpace(t[hi - 1]) {
        hi--
    }
    return t[:hi]
}

# the text with every ASCII lower-case letter made upper-case, as new text. Every other byte - those of a UTF-8 sequence
# for a character beyond ASCII included - is left as it is
fn (t String&) ToUpper() String {
    out := String(Array<Char>(t.Len()))
    for i, c in t { out[i] = c.ToUpper() }
    return out
}

# the text with every ASCII upper-case letter made lower-case, as new text, every other byte left as it is
fn (t String&) ToLower() String {
    out := String(Array<Char>(t.Len()))
    for i, c in t { out[i] = c.ToLower() }
    return out
}

# the index of the last occurrence of sub, failing with the default error when there is none, as Find does. An empty
# sub is found at Len()
fn (a String&) FindLast(sub String&) I64 ? {
    n I64 = sub.Len()
    i I64 = a.Len() - n
    for i >= 0 {
        j I64 = 0
        for j < n and a[i + j] == sub[j] { j++ }
        if j == n { return i }
        i--
    }
    error
}

# bytewise lexicographic order, as Compare gives it - what "<" asks of two texts (E31), and with it ">", "<=" and ">=":
# "words.Sort(fn(a, b) { return a < b })"
fn (a String&) Less(b String&) Bool { return a.Compare(b) < 0 }

# the lines of the text, one at a time, each a borrow of the text's own storage, so no text is copied: "for line in
# t.Lines() { ... }". Lines as io.Lines reads them from a file: a line is what comes before a newline, without it, and
# one carriage return just before the newline goes with it, so "a\r\nb\n" is "a" and "b" as "a\nb\n" is. The last line
# needs no newline after it: "a\nb" is "a" and "b", "a\n" is just "a", and "a\n\n" is "a" and "" - the empty text has no
# lines at all
fn (t String&) Lines() LineIter { return LineIter(t) }

# a position in a text's lines - handed out fresh by Lines(), so every loop gets its own
type LineIter struct(of String&) {
    text String&of = of
    at mut I64 = 0                   # where the next line starts
}

fn (it mut LineIter&) Next() String&it ? Exhausted {
    if it.at == it.text.Len() { error Exhausted.END }
    start := it.at
    end I64 = start
    for end < it.text.Len() and it.text[end] != '\n' { end++ }
    it.at = end + 1 if end < it.text.Len() else end
    if end > start and it.text[end - 1] == '\r' { end-- }
    return it.text[start:end]
}

# the texts one after another with sep between each two: String&["a", "b", "c"].Join(", ") is "a, b, c" - the empty array
# joins to the empty text. Built at its exact length, once; "$" renders the array itself as source instead (E11a)
fn (parts Array<String&>&) Join(sep String&) String {
    n I64 = 0
    for p in parts { n += p.Len() }
    if parts.Len() > 1 { n += sep.Len() * (parts.Len() - 1) }
    out := String(Array<Char>(n))
    w I64 = 0
    for i, p in parts {
        if i > 0 {
            for c in sep {
                out[w] = c
                w++
            }
        }
        for c in p {
            out[w] = c
            w++
        }
    }
    return out
}

# ---- padding, for columns ----

# the text made "width" characters wide by "fill" - a space unless another is given - before it, so it stands at the
# right of a column: "7".PadStart(3) is "  7". Text already that wide is given whole, never cut. New text, built where
# it is put. A character here is a Char, one byte, as everywhere in a String: text beyond ASCII counts its UTF-8 bytes
fn (t String&) PadStart(width I64, fill Char = ' ') String {
    if t.Len() >= width { return t }
    out := String(Array<Char>(width, fill))
    at := width - t.Len()
    for i, c in t { out[at + i] = c }
    return out
}

# the text made "width" characters wide by "fill" after it, so it stands at the left of a column: "ab".PadEnd(4, '.')
# is "ab..". Given whole when already that wide, as PadStart's is
fn (t String&) PadEnd(width I64, fill Char = ' ') String {
    if t.Len() >= width { return t }
    out := String(Array<Char>(width, fill))
    for i, c in t { out[i] = c }
    return out
}

# the integers made text and padded, for a column of numbers: "$n.PadStart(5)" right-aligns n in five characters, and
# a line number before a source line is "$line.PadStart(4) " | "". Zeros go after a sign, as a number is written:
# (-7).PadStart(4, '0') is "-007", where the text "-7".PadStart(4, '0') is "00-7". Every integer type but U8,
# whose methods Char inherits (T29f) - and a Char padded should be the character, not its number: pad "$c" for that,
# and "U32(b)" for a U8's number
fn (n I8) PadStart(width I64, fill Char = ' ') String { return padNumber($n, width, fill) }
fn (n I16) PadStart(width I64, fill Char = ' ') String { return padNumber($n, width, fill) }
fn (n I32) PadStart(width I64, fill Char = ' ') String { return padNumber($n, width, fill) }
fn (n I64) PadStart(width I64, fill Char = ' ') String { return padNumber($n, width, fill) }
fn (n U16) PadStart(width I64, fill Char = ' ') String { return padNumber($n, width, fill) }
fn (n U32) PadStart(width I64, fill Char = ' ') String { return padNumber($n, width, fill) }
fn (n U64) PadStart(width I64, fill Char = ' ') String { return padNumber($n, width, fill) }

# the integers made text and padded after, for a column of numbers standing at its left
fn (n I8) PadEnd(width I64, fill Char = ' ') String { return ($n).PadEnd(width, fill) }
fn (n I16) PadEnd(width I64, fill Char = ' ') String { return ($n).PadEnd(width, fill) }
fn (n I32) PadEnd(width I64, fill Char = ' ') String { return ($n).PadEnd(width, fill) }
fn (n I64) PadEnd(width I64, fill Char = ' ') String { return ($n).PadEnd(width, fill) }
fn (n U16) PadEnd(width I64, fill Char = ' ') String { return ($n).PadEnd(width, fill) }
fn (n U32) PadEnd(width I64, fill Char = ' ') String { return ($n).PadEnd(width, fill) }
fn (n U64) PadEnd(width I64, fill Char = ' ') String { return ($n).PadEnd(width, fill) }

# a number's text padded before: zeros after its sign
fn padNumber(digits String&, width I64, fill Char) String {
    if fill != '0' or digits[0] != '-' { return digits.PadStart(width, fill) }
    return "-" $digits[1:].PadStart(width - 1, '0')
}

# ---- integers from their text ----

# the integer the text writes: an optional '-' or '+', then digits of "base" - 2 to 36, the digits past 9 being the
# letters in either case, so "ff".ParseInt(16) is 255 - and nothing else: no surrounding space ("t.Trim().ParseInt()"),
# no prefix, no separators. Base 0 reads the digits as olang writes an integer literal (L10): "0x" or "0X" before
# hexadecimal digits, "0b" or "0B" before binary ones, decimal otherwise (a leading 0 is no octal prefix), with a '_'
# between any two digits ("1_000", "0xFF_FF") - and, as in a program, a hexadecimal or binary literal is a bit pattern,
# read as an I64 (L10a): "0xFFFFFFFFFFFFFFFF".ParseInt(0) is -1, and a '-' before one negates that reading (wrapping,
# E6c). Fails with EMPTY for no text, INVALID for anything else that is not such a number - a sign with no digits after
# it included - and OVERFLOW for a number beyond I64's range. A base other than 0 or 2 to 36 is a mistake in the
# program, stopped as a failed assert is
fn (t String&) ParseInt(base I64 = 10) I64 ? ParseError {
    if t.Len() == 0 { error ParseError.EMPTY }
    neg := t[0] == '-'
    digits := t[1:] if neg or t[0] == '+' else t[:]
    if base == 0 and isPrefixed(digits) {
        bits I64 = I64(try readDigits(digits, 0, ~U64(0)))
        return -bits if neg else bits
    }
    most U64 = (U64(1) << 63) if neg else (U64(1) << 63) - 1      # the magnitude of I64's most negative, or its largest
    v := try readDigits(digits, base, most)
    return -I64(v) if neg else I64(v)
}

# the unsigned integer the text writes, as ParseInt reads one - an optional '+', never a '-' - up to U64's largest,
# 18446744073709551615: "ffffffffffffffff".ParseUint(16) is that. Base 0 reads an olang integer literal (L10) to the
# value it is in a program: "18446744073709551615".ParseUint(0) and "0xFFFF_FFFF_FFFF_FFFF".ParseUint(0) are both U64's
# largest, and a literal needing more than 64 bits fails with OVERFLOW, as it is an error in a program
fn (t String&) ParseUint(base I64 = 10) U64 ? ParseError {
    if t.Len() == 0 { error ParseError.EMPTY }
    digits := t[1:] if t[0] == '+' else t[:]
    return try readDigits(digits, base, ~U64(0))
}

# whether "digits" begins with a "0x" or "0b" prefix, in either case
fn isPrefixed(digits String&) Bool {
    if digits.Len() < 2 or digits[0] != '0' { return false }
    p := digits[1]
    return p == 'x' or p == 'X' or p == 'b' or p == 'B'
}

# what one character is worth as a digit: 0 to 9, then the letters from 10 in either case - 36 for anything else
fn digitWorth(c Char) I64 {
    if c >= '0' and c <= '9' { return I64(c - '0') }
    if c >= 'a' and c <= 'z' { return I64(c - 'a') + 10 }
    if c >= 'A' and c <= 'Z' { return I64(c - 'A') + 10 }
    return 36
}

# the number "digits" writes in "base", at most "most": INVALID for text that is not one - no digits at all included -
# and OVERFLOW above "most". Base 0 is an olang literal's digits (L10, L10a, L10b): a prefix choosing the base, and a '_'
# allowed between two digits
fn readDigits(digits String&, base I64, most U64) U64 ? ParseError {
    assert base == 0 or (base >= 2 and base <= 36), "a base is 0 or 2 to 36, found " $base
    b I64 = base
    from I64 = 0
    if base == 0 {
        b = 10
        if isPrefixed(digits) {
            b = 16 if digits[1] == 'x' or digits[1] == 'X' else 2
            from = 2
        }
    }
    if from == digits.Len() { error ParseError.INVALID }
    ub := U64(b)
    cutoff U64 = most / ub                      # past this, one more digit is too many
    cutlim U64 = most % ub                      # ...and at it, so is a digit worth more than this
    v U64 = 0
    for i in range from, digits.Len() {
        c := digits[i]
        if c == '_' and base == 0 {
            # between two digits: one before it, and the next one is checked as a digit when its turn comes
            if i == from or digits[i - 1] == '_' or i + 1 == digits.Len() { error ParseError.INVALID }
            continue
        }
        d := digitWorth(c)
        if d >= b { error ParseError.INVALID }
        ud := U64(d)
        if v > cutoff or (v == cutoff and ud > cutlim) { error ParseError.OVERFLOW }
        v = v * ub + ud
    }
    return v
}

# ---- a float from its decimal text, exactly ----

# the decimal number the text writes, to the nearest F64 - correctly rounded, a tie to the even one, as C's strtod and
# Go's and Python's readers round: an optional '-' or '+', digits with an optional '.' (".5" and "5." are numbers, "."
# is not), and an optional exponent - 'e' or 'E', an optional sign, digits: "1e3", "-0.25", "6.02E23". "inf",
# "infinity" and "nan", in any case and with an optional sign, are the infinities and a NaN, so the text "$x" writes
# reads back as x. Nothing else: no surrounding space ("t.Trim().ParseFloat()"), no separators, no hexadecimal. Fails
# with EMPTY for no text, INVALID for text that is not a number, and OVERFLOW for a number too large for an F64; one
# too small for any but zero is a zero of its sign. Exact with no help from the C library - Clinger's fast path, then
# Eisel and Lemire's algorithm, then the number's own digits - so it runs while compiling (K1) as at run time. A
# narrower float is the F64 converted, "F32(t.ParseFloat())", which can round twice: rarely, a text lying within half
# an F64 unit of an F32 halfway point rounds the wrong way
fn (t String&) ParseFloat() F64 ? ParseError {
    if t.Len() == 0 { error ParseError.EMPTY }
    neg Bool = false
    start I64 = 0
    if t[0] == '-' or t[0] == '+' {
        neg = t[0] == '-'
        start = 1
    }
    body := t[start:]
    sign U64 = U64(1) << 63 if neg else 0
    if body.Len() > 0 and body[0] != '.' and not body[0].IsDigit() {
        if sameLetters(body, "inf") or sameLetters(body, "infinity") { return (sign | (U64(0x7FF) << 52)).F64FromBits() }
        if sameLetters(body, "nan") { return (sign | (U64(0xFFF) << 51)).F64FromBits() }
        error ParseError.INVALID
    }
    man U64 = 0                 # the first 19 significant digits
    taken I64 = 0               # how many man holds
    nd I64 = 0                  # significant digits in all
    trunc Bool = false          # a nonzero digit past the 19th
    digits I64 = 0              # digits of any kind, leading zeros included
    i I64 = 0
    for i < body.Len() and body[i].IsDigit() {
        c := body[i]
        digits++
        if c != '0' or nd > 0 {
            nd++
            if taken < 19 {
                man = man * 10 + U64(c - '0')
                taken++
            } else if c != '0' {
                trunc = true
            }
        }
        i++
    }
    dp I64 = nd                 # the decimal point: the value is 0.(the significant digits) * 10^dp
    if i < body.Len() and body[i] == '.' {
        i++
        for i < body.Len() and body[i].IsDigit() {
            c := body[i]
            digits++
            if c == '0' and nd == 0 {
                dp--
            } else {
                nd++
                if taken < 19 {
                    man = man * 10 + U64(c - '0')
                    taken++
                } else if c != '0' {
                    trunc = true
                }
            }
            i++
        }
    }
    if digits == 0 { error ParseError.INVALID }
    if i < body.Len() and (body[i] == 'e' or body[i] == 'E') {
        i++
        esign I64 = 1
        if i < body.Len() and (body[i] == '+' or body[i] == '-') {
            if body[i] == '-' { esign = -1 }
            i++
        }
        if i == body.Len() or not body[i].IsDigit() { error ParseError.INVALID }
        e I64 = 0
        for i < body.Len() and body[i].IsDigit() {
            if e < 100000 { e = e * 10 + I64(body[i] - '0') }
            i++
        }
        dp += e * esign
    }
    if i < body.Len() { error ParseError.INVALID }
    return try toF64(man, dp - taken, trunc, neg, body) catch { error ParseError.OVERFLOW }
}

# whether t is the lower-case letters "lower", in any case
fn sameLetters(t String&, lower String&) Bool {
    if t.Len() != lower.Len() { return false }
    for i, c in t {
        if c.ToLower() != lower[i] { return false }
    }
    return true
}

# 10^0 .. 10^22, each exactly an F64
exactPow10 := F64[1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16,
    1e17, 1e18, 1e19, 1e20, 1e21, 1e22]

# the F64 nearest man * 10^exp10 - the number "text" writes, its sign aside (neg), man holding its first 19 significant
# digits and trunc saying whether any later one is nonzero - correctly rounded (to nearest, a tie to even), failing with the default
# error when that is too large for an F64 (one too small is zero). Three ways, each taken only when it is exact:
# Clinger's (man and a power of ten both exactly F64s, so one rounding); Eisel and Lemire's (man times a 128-bit power
# of ten, decided whenever the bits it keeps settle the rounding, which is nearly always); and failing both, the
# number's own digits, shifted by powers of two until the integer part is the mantissa (Go's strconv's "simple
# decimal conversion").
fn toF64(man U64, exp10 I64, trunc Bool, neg Bool, text String&) F64 ? {
    if man == 0 { return -0.0 if neg else 0.0 }
    if not trunc and man >> 52 == 0 {
        f := F64(man)
        if neg { f = -f }
        if exp10 == 0 { return f }
        if exp10 > 0 and exp10 <= 37 {
            e I64 = exp10
            if e > 22 {                             # moving some of the zeros into man may still leave it exact
                f = f * exactPow10[e - 22]
                e = 22
            }
            if f <= 1e15 and f >= -1e15 { return f * exactPow10[e] }
        } else if exp10 < 0 and exp10 >= -22 {
            return f / exactPow10[-exp10]
        }
    }
    b := try eiselLemire(man, exp10) catch { return try slowF64(text, neg) }
    if trunc {                                      # the digits man lacks matter only if man + 1 rounds elsewhere
        up := try eiselLemire(man + 1, exp10) catch { return try slowF64(text, neg) }
        if up != b { return try slowF64(text, neg) }
    }
    if neg { b = b | (U64(1) << 63) }
    return b.F64FromBits()
}

# the low and high 64 bits of a * b
fn mul128(a U64, b U64) (U64, U64) {
    a0 U64 = a & 0xFFFFFFFF
    a1 U64 = a >> 32
    b0 U64 = b & 0xFFFFFFFF
    b1 U64 = b >> 32
    w0 U64 = a0 * b0
    t U64 = a1 * b0 + (w0 >> 32)
    w1 U64 = (t & 0xFFFFFFFF) + a0 * b1
    hi U64 = a1 * b1 + (t >> 32) + (w1 >> 32)
    return hi, a * b
}

# how many of x's top bits are zero
fn leadingZeros(x mut U64) I64 {
    if x == 0 { return 64 }
    n I64 = 0
    if x >> 32 == 0 {
        n += 32
        x <<= 32
    }
    if x >> 48 == 0 {
        n += 16
        x <<= 16
    }
    if x >> 56 == 0 {
        n += 8
        x <<= 8
    }
    if x >> 60 == 0 {
        n += 4
        x <<= 4
    }
    if x >> 62 == 0 {
        n += 2
        x <<= 2
    }
    if x >> 63 == 0 { n += 1 }
    return n
}

# the bits of the F64 nearest man * 10^exp10 (man not 0), by Eisel and Lemire's algorithm as Go's strconv has it -
# failing, with the default error, where the bits it keeps cannot settle the rounding, or the value is subnormal or
# too large
fn eiselLemire(man mut U64, exp10 I64) U64 ? {
    if exp10 < -348 or exp10 > 347 { error }
    clz := leadingZeros(man)
    man <<= U64(clz)
    exp2 I64 = ((217706 * exp10) >> 16) + 64 + 1023 - clz
    row I64 = (exp10 + 348) * 2
    xHi, xLo := mul128(man, U64(pow10Mant[row]))
    if (xHi & 0x1FF) == 0x1FF and xLo + man < man {
        yHi, yLo := mul128(man, U64(pow10Mant[row + 1]))
        mHi U64 = xHi
        mLo U64 = xLo + yHi
        if mLo < xLo { mHi++ }
        if (mHi & 0x1FF) == 0x1FF and mLo + 1 == 0 and yLo + man < man { error }
        xHi = mHi
        xLo = mLo
    }
    msb U64 = xHi >> 63
    mant U64 = xHi >> (msb + 9)
    exp2 -= I64(1 ^ msb)
    if xLo == 0 and (xHi & 0x1FF) == 0 and (mant & 3) == 1 { error }    # exactly halfway: not decided here
    mant += mant & 1
    mant >>= 1
    if mant >> 53 > 0 {
        mant >>= 1
        exp2++
    }
    if exp2 <= 0 or exp2 >= 0x7FF { error }
    return (U64(exp2) << 52) | (mant & 0xFFFFFFFFFFFFF)
}

# the F64 nearest the number text writes, its sign aside (neg), from its own digits
fn slowF64(text String&, neg Bool) F64 ? {
    a := decimal()
    a.set(text)
    b := try a.bits()
    if neg { b = b | (U64(1) << 63) }
    return b.F64FromBits()
}

# a decimal of up to 800 significant digits, shifted by powers of two until its integer part is the mantissa
type decimal struct() {
    d mut Array<U8>& = Array<U8>(800)       # digit values, the most significant first
    tmp mut Array<U8>& = Array<U8>(820)
    nd mut I64 = 0                          # digits used
    dp mut I64 = 0                          # the decimal point: the value is 0.d[0]d[1]... * 10^dp
    trunc mut Bool = false                  # a nonzero digit was dropped past the 800th
}

# the number s writes - digits with an optional '.', then an optional exponent - with no sign before it
fn (a mut decimal&) set(s String&) {
    i I64 = 0
    sawDot := false
    for i < s.Len() {
        c := s[i]
        if c == '.' {
            sawDot = true
            a.dp = a.nd
        } else if c < '0' or c > '9' {
            break
        } else if c == '0' and a.nd == 0 {
            a.dp--
        } else if a.nd < 800 {
            a.d[a.nd] = U8(c - '0')
            a.nd++
        } else if c != '0' {
            a.trunc = true
        }
        i++
    }
    if not sawDot { a.dp = a.nd }
    if i < s.Len() {
        i++
        sign I64 = 1
        if s[i] == '+' {
            i++
        } else if s[i] == '-' {
            sign = -1
            i++
        }
        e I64 = 0
        for i < s.Len() {
            if e < 10000 { e = e * 10 + I64(s[i] - '0') }
            i++
        }
        a.dp += e * sign
    }
}

fn (a mut decimal&) trim() {
    for a.nd > 0 and a.d[a.nd - 1] == 0 { a.nd-- }
    if a.nd == 0 { a.dp = 0 }
}

# divides by 2^k, k at most 60
fn (a mut decimal&) rightShift(k U64) {
    r I64 = 0
    w I64 = 0
    n U64 = 0
    for n >> k == 0 {
        if r >= a.nd {
            if n == 0 {
                a.nd = 0
                return
            }
            for n >> k == 0 {
                n = n * 10
                r++
            }
            break
        }
        n = n * 10 + U64(a.d[r])
        r++
    }
    a.dp -= r - 1
    mask U64 = (U64(1) << k) - 1
    for r < a.nd {
        c := a.d[r]
        a.d[w] = U8(n >> k)
        w++
        n = (n & mask) * 10 + U64(c)
        r++
    }
    for n > 0 {
        dig U64 = n >> k
        n = n & mask
        if w < 800 {
            a.d[w] = U8(dig)
            w++
        } else if dig > 0 {
            a.trunc = true
        }
        n = n * 10
    }
    a.nd = w
    a.trim()
}

# multiplies by 2^k, k at most 60
fn (a mut decimal&) leftShift(k U64) {
    w I64 = a.tmp.Len()
    n U64 = 0
    r I64 = a.nd - 1
    for r >= 0 {
        n += U64(a.d[r]) << k
        q U64 = n / 10
        w--
        a.tmp[w] = U8(n - 10 * q)
        n = q
        r--
    }
    for n > 0 {
        q U64 = n / 10
        w--
        a.tmp[w] = U8(n - 10 * q)
        n = q
    }
    got I64 = a.tmp.Len() - w
    a.dp += got - a.nd
    keep I64 = got if got < 800 else 800
    for i in range keep { a.d[i] = a.tmp[w + i] }
    for i in range keep, got {
        if a.tmp[w + i] != 0 { a.trunc = true }
    }
    a.nd = keep
    a.trim()
}

fn (a mut decimal&) shift(k mut I64) {
    if a.nd == 0 { return }
    for k > 60 {
        a.leftShift(60)
        k -= 60
    }
    for k < -60 {
        a.rightShift(60)
        k += 60
    }
    if k > 0 { a.leftShift(U64(k)) }
    if k < 0 { a.rightShift(U64(-k)) }
}

# whether the integer part, the digits before d[nd], rounds up: a half to the even
fn (a decimal&) roundsUp(nd I64) Bool {
    if nd < 0 or nd >= a.nd { return false }
    if a.d[nd] == 5 and nd + 1 == a.nd {
        if a.trunc { return true }
        return nd > 0 and a.d[nd - 1] % 2 == 1
    }
    return a.d[nd] >= 5
}

fn (a decimal&) roundedInteger() U64 {
    if a.dp > 20 { return ~U64(0) }
    n U64 = 0
    i I64 = 0
    for i < a.dp and i < a.nd {
        n = n * 10 + U64(a.d[i])
        i++
    }
    for i < a.dp {
        n = n * 10
        i++
    }
    if a.roundsUp(a.dp) { n++ }
    return n
}

decimalShifts := I64[1, 3, 6, 9, 13, 16, 19, 23, 26]       # 2^decimalShifts[i] < 10^i, for 0 <= i < 9

# the bits of the nearest F64, its sign aside - failing, with the default error, when it is too large for one
fn (a mut decimal&) bits() U64 ? {
    if a.nd == 0 or a.dp < -330 { return 0 }
    if a.dp > 310 { error }
    exp I64 = 0
    for a.dp > 0 {
        n I64 = 27 if a.dp >= 9 else decimalShifts[a.dp]
        a.shift(-n)
        exp += n
    }
    for a.dp < 0 or (a.dp == 0 and a.d[0] < 5) {
        n I64 = 27 if -a.dp >= 9 else decimalShifts[-a.dp]
        a.shift(n)
        exp -= n
    }
    exp--                                   # in [0.5, 1): an F64's mantissa is in [1, 2)
    if exp < -1022 {                        # subnormal: fewer bits
        n I64 = -1022 - exp
        a.shift(-n)
        exp += n
    }
    if exp + 1023 >= 0x7FF { error }
    a.shift(53)
    mant := a.roundedInteger()
    if mant == U64(1) << 53 {
        mant >>= 1
        exp++
        if exp + 1023 >= 0x7FF { error }
    }
    biased I64 = exp + 1023
    if (mant & (U64(1) << 52)) == 0 { biased = 0 }
    return (mant & 0xFFFFFFFFFFFFF) | (U64(biased) << 52)
}

# ---- a float as its fewest digits ----

mask63 U64 = 0x7FFFFFFFFFFFFFFF

# the F64 v (finite, not 0) as the fewest decimal digits that read back as it, the closest to v of those: f * 10^e. By
# Schubfach (Giulietti), as Java's Double.toString has it, with its 126-bit powers of ten made from pow10Mant (a power's
# top 126 bits rounded down, plus one); and where Java keeps two digits for the smallest numbers, one here when one
# reads back, as for every other number - so the digits are those of Python's repr and JavaScript's toString
fn shortest(v F64) (U64, I64) {
    b := v.Bits()
    t U64 = b & 0xFFFFFFFFFFFFF
    bq I64 = I64((b >> 52) & 0x7FF)
    if bq != 0 {
        mq I64 = 1075 - bq
        c U64 = (U64(1) << 52) | t
        if mq > 0 and mq < 53 {
            f U64 = c >> U64(mq)
            if f << U64(mq) == c { return f, 0 }
        }
        return schubfach(-mq, c, 0)
    }
    if t == 1 { return 5, -324 }                    # the two smallest: 5e-324 and 1e-323
    if t == 2 { return 1, -323 }
    return schubfach(-1074, t, 0)
}

# the rounded-to-odd top bits of g * cp, g = g1 * 2^63 + g0
fn rop(g1 U64, g0 U64, cp U64) U64 {
    x1, x0 := mul128(g0, cp)
    y1, y0 := mul128(g1, cp)
    z U64 = (y0 >> 1) + x1
    vbp U64 = y1 + (z >> 63)
    return vbp | (((z & mask63) + mask63) >> 63)
}

# the shortest decimal in the rounding interval of c * 2^q, c a whole number: its digits and power of ten
fn schubfach(q I64, c U64, dk I64) (U64, I64) {
    out U64 = c & 1
    cb U64 = c << 2
    cbr U64 = cb + 2
    cbl U64 = cb - 2
    k I64 = (q * 661971961083) >> 41
    if c == U64(1) << 52 and q != -1074 {
        cbl = cb - 1
        k = (q * 661971961083 - 274743187321) >> 41
    }
    h I64 = q + ((-k * 913124641741) >> 38) + 2
    row I64 = (348 - k) * 2
    hi U64 = U64(pow10Mant[row])
    lo U64 = U64(pow10Mant[row + 1])
    gh U64 = hi >> 2
    gl U64 = ((lo >> 2) | (hi << 62)) + 1
    if gl == 0 { gh++ }
    g1 U64 = (gh << 1) | (gl >> 63)
    g0 U64 = gl & mask63
    vb U64 = rop(g1, g0, cb << U64(h))
    vbl U64 = rop(g1, g0, cbl << U64(h))
    vbr U64 = rop(g1, g0, cbr << U64(h))
    s U64 = vb >> 2
    if s >= 10 {
        sp10 U64 = 10 * (s / 10)
        tp10 U64 = sp10 + 10
        upin Bool = vbl + out <= sp10 << 2
        wpin Bool = (tp10 << 2) + out <= vbr
        if upin != wpin {
            if upin { return sp10, k }
            return tp10, k
        }
    }
    t U64 = s + 1
    uin Bool = vbl + out <= s << 2
    win Bool = (t << 2) + out <= vbr
    if uin != win {
        if uin { return s, k + dk }
        return t, k + dk
    }
    cmp I64 = I64(vb) - I64((s + t) << 1)
    if cmp < 0 or (cmp == 0 and (s & 1) == 0) { return s, k + dk }
    return t, k + dk
}

# the fewest decimal digits that read back as x, and where the point goes: d and e with |x| = d * 10^e and no zero at
# d's end - of those, the closest to x. 0 and 0 for a zero: x's sign is its own ("x < 0", or "x.Bits() >> 63" for a
# negative zero). Fails with the default error for a NaN or an infinity, which no digits write. The digits are those of
# Python's repr and JavaScript's toString, and those "$x" writes (E11a: the runtime and the evaluator compute them by the
# same algorithm, in IR and in C) - worked out exactly (Schubfach), so this runs while compiling (K1) as at run time
fn (x F64) ShortestDecimal() (U64, I64) ? {
    b := x.Bits()
    if ((b >> 52) & 0x7FF) == 0x7FF { error }
    if b << 1 == 0 { return 0, 0 }
    f, e := shortest(x)
    for f % 10 == 0 {
        f = f / 10
        e++
    }
    return f, e
}

# text built up piece by piece - what a program writing a lot of it (a compiler's output, a report) accumulates
# before it has it all. Held as a List of Chars, so adding never moves what is already there and costs no more
# than writing into a preallocated array would, and copied into one String, once, by ToString. Numbers and other
# values go in as their renderings: "b.Push($n)".
type StringBuilder struct() {
    chars mut List<Char> = List<Char>()
}

# adds t at the end
fn (b mut StringBuilder&) Push(t String&) { b.chars.PushAll(t) }

# adds one character at the end
fn (b mut StringBuilder&) PushChar(c Char) { b.chars.Push(c) }

# how many characters it holds
fn (b StringBuilder&) Len() I64 { return b.chars.Len() }

# everything added so far, as one String in the CALLER's scope - a copy, so the builder may be discarded, or keep
# growing, without affecting it
fn (b StringBuilder&) ToString() mut String& { return String(b.chars.ToArray()) }

# the tests, and what only they use - under TestBuild, so a program that is not being tested compiles none of it: the
# prelude is part of every program

if TestBuild {
    test "Eq compares contents, and == goes through it; same asks for one instance" {
        a String& = "hello"
        bytes := Array<U8>(5, 'x')
        bytes[0] = 'h'
        bytes[1] = 'e'
        bytes[2] = 'l'
        bytes[3] = 'l'
        bytes[4] = 'o'
        b := String(bytes)        # bytes become text by naming them so (T29c)
        assert a.Eq(b)
        assert a.Eq("hello")
        assert not a.Eq("hell")
        assert not a.Eq("hellO")
        assert "".Eq("")
        assert ("x = " $42).Eq("x = 42")        # a rendering is text like any other
        c String& = b                # E10a: String declares Eq, so "==" compares what two texts say
        d String& = "hello"
        assert a == c and c == "hello" and "hello" == d and a != "hell"
        assert a is a and a is not c    # E10c: identity, whatever Eq says
        n String& = null
        assert n == null and n != a and a != n
    }

    test "Compare orders bytewise, a prefix first" {
        assert "abc".Compare("abc") == 0
        assert "abc".Compare("abd") == -1
        assert "abd".Compare("abc") == 1
        assert "ab".Compare("abc") == -1
        assert "abc".Compare("ab") == 1
        assert "".Compare("a") == -1
    }

    test "prefixes, suffixes and searching" {
        s := "hello, world"
        assert s.StartsWith("hello")
        assert not s.StartsWith("world")
        assert s.EndsWith("world")
        assert s.StartsWith("")
        assert not "hi".StartsWith("high")
        assert (try s.FindByte(',') catch default -1) == 5
        assert (try s.FindByte('z') catch default -1) == -1
        assert (try s.Find("world") catch default -1) == 7
        assert (try s.Find("o") catch default -1) == 4
        assert (try s.Find("") catch default -1) == 0
        assert (try s.Find("worlds") catch default -1) == -1
        assert (try s.Find("hello, world!") catch default -1) == -1        # longer than the text
        assert (try "aab".Find("ab") catch default -1) == 1                # a false start, then the match
        assert (try "".Find("") catch default -1) == 0 and (try "".Find("a") catch default -1) == -1
        missed := false
        try s.Find("xyz") catch { missed = true }
        assert missed
        assert s.Contains("lo, w")
        assert not "".Contains("a")
    }

    test "Trim borrows the receiver's storage" {
        assert "  padded \t\n".Trim().Eq("padded")
        assert "bare".Trim().Eq("bare")
        assert "   ".Trim().Eq("")
        assert "".Trim().Eq("")
    }

    # the result of a fallible call can be bound only where there is a signature to propagate through, so the
    # checks live in a helper, as io.olang's do
    fn checkParses(t String&, want I64) ? ParseError {
        got I64 = try t.ParseInt()
        assert got == want
    }

    # each of these lets exactly one word through and swallows the other two, so a test - which must catch
    # everything it tries - can still tell which word a failure was
    fn onlyEmpty(t String&) ? ParseError {
        try t.ParseInt() catch ParseError.INVALID + ParseError.OVERFLOW { }
    }

    fn onlyInvalid(t String&) ? ParseError {
        try t.ParseInt() catch ParseError.EMPTY + ParseError.OVERFLOW { }
    }

    fn onlyOverflow(t String&) ? ParseError {
        try t.ParseInt() catch ParseError.EMPTY + ParseError.INVALID { }
    }

    test "ParseInt reads decimals across the whole I64 range" {
        ok Bool = true
        try checkParses("0", 0) catch ParseError { ok = false }
        try checkParses("42", 42) catch ParseError { ok = false }
        try checkParses("-17", -17) catch ParseError { ok = false }
        try checkParses("+8", 8) catch ParseError { ok = false }
        try checkParses("9223372036854775807", 9223372036854775807) catch ParseError { ok = false }
        try checkParses("-9223372036854775808", -9223372036854775807 - 1) catch ParseError { ok = false }
        assert ok
    }

    test "ParseInt names what was wrong" {
        e Bool = false
        try onlyEmpty("") catch ParseError { e = true }
        assert e
        i Bool = false
        try onlyInvalid("12a") catch ParseError { i = true }
        assert i
        i = false
        try onlyInvalid("-") catch ParseError { i = true }
        assert i
        i = false
        try onlyInvalid(" 1") catch ParseError { i = true }  # no surrounding space: Trim first
        assert i
        o Bool = false
        try onlyOverflow("9223372036854775808") catch ParseError { o = true }
        assert o
        o = false
        try onlyOverflow("-9223372036854775809") catch ParseError { o = true }
        assert o
        o = false
        try onlyOverflow("99999999999999999999") catch ParseError { o = true }
        assert o
        o = false
        try onlyOverflow("12") catch ParseError { o = true }
        assert not o
    }

    # T29c: text written in the program is a String wherever one is wanted - declared from, called on, passed
    fn takesBytes(b Array<U8>&) I64 { return b.Len() }

    test "T29c: written text is a String, and a String is still its bytes" {
        s := "  hi  "                        # ":=" from text declares a String
        assert s.Trim().Eq("hi")             # so it has text's methods
        r := $42 "!"                         # a rendering and a join are text too
        assert r.Eq("42!")
        assert s[2:4].Eq("hi")               # a slice of text is text
        assert takesBytes(s) == 6            # and text goes wherever bytes are wanted
        raw := Array<U8>(2, 'z')
        assert String(raw).Eq("zz")          # bytes become text only by saying so
    }

    test "equal text hashes equally, whatever storage holds it" {
        assert "ab".Hash() == String(U8['a', 'b']).Hash()
        assert "ab".Hash() != "ba".Hash()
    }

    test "Split gives the pieces between separators, borrowed from the text" {
        p := "a,b,,c".Split(",")
        assert p.Len() == 4
        assert p[0].Eq("a") and p[1].Eq("b") and p[2].Eq("") and p[3].Eq("c")
        q := ",x,".Split(",")
        assert q.Len() == 3 and q[0].Eq("") and q[1].Eq("x") and q[2].Eq("")
        assert "none".Split(",").Len() == 1 and "none".Split(",")[0].Eq("none")
        e := "".Split(",")
        assert e.Len() == 1 and e[0].Eq("")
        w := "one::two::three".Split("::")
        assert w.Len() == 3 and w[1].Eq("two") and w[2].Eq("three")
        b := "abc".Split("")
        assert b.Len() == 3 and b[0].Eq("a") and b[2].Eq("c")
        n I32 = 0
        for piece in "1 2 3".Split(" ") {
            n = n + I32(try piece.ParseInt() catch default 0)
        }
        assert n == 6
    }

    # the same searching and splitting, computed while compiling (K2): a miss is the same error there as at run time
    fn splitShape() I64 {
        p := "x::y::::z".Split("::")
        q := "1 22 333".Split(" ")
        found I64 = (try "hello".Find("ll") catch default -1) * 10 + (try "hello".Find("lo!") catch default -1)
        return p.Len() * 100000 + p[2].Len() * 10000 + q.Len() * 1000 + q[2].Len() * 100 + found
    }

    splitShapeBaked := splitShape()

    test "Split and Find, evaluated while compiling as at run time" {
        assert splitShapeBaked == 400000 + 0 + 3000 + 300 + 19
        assert splitShape() == splitShapeBaked
        one := "a b  c ".Split(" ")              # a one-byte separator: adjacent ones and one at the end
        assert one.Len() == 5 and one[1] == "b" and one[2] == "" and one[3] == "c" and one[4] == ""
    }

    test "a StringBuilder gathers text and hands it back as one String" {
        b := StringBuilder()
        assert b.Len() == 0 and b.ToString() == ""
        b.Push("define i32 @f")
        b.PushChar('(')
        b.Push($42)                          # a value goes in as its rendering
        b.PushChar(')')
        assert b.Len() == 17
        s := b.ToString()
        assert s == "define i32 @f(42)"
        b.Push(" {")                         # the String handed back is a copy: the builder keeps growing apart from it
        assert s == "define i32 @f(42)" and b.ToString() == "define i32 @f(42) {"
        long := StringBuilder()
        for i in range 1000 {
            long.Push("ab")
            long.PushChar('c')
        }
        t := long.ToString()
        assert t.Len() == 3000 and t[0] == 'a' and t[2] == 'c' and t[2997] == 'a' and t[2999] == 'c'
        assert t.EndsWith("abcabc") and t.Split("c").Len() == 1001
    }

    # the same, built while compiling (K2): the evaluator runs the builder as the run time does
    fn builtText() String& {
        b := StringBuilder()
        for i in range 3 {
            b.Push($i)
            b.PushChar(',')
        }
        b.Push("end")
        return b.ToString()
    }

    builtBaked := builtText()

    test "a StringBuilder, evaluated while compiling as at run time" {
        assert builtBaked == "0,1,2,end"
        assert builtText() == builtBaked
    }

    # mutable, so the check below is made at run time, where the arena is - and the reason it exists: ToString's text is
    # built through the conversion String(...), and the call inside it used to land in ToString's own scope, closed by its
    # return, so the next scope to take a chunk - here scribble's own - wrote over the text
    churnBytes mut I64 = 100
    fn scribble(n I64) I64 {
        a := Array<Char>(n, 'z')
        return a.Len()
    }
    test "a StringBuilder's text lives where the caller keeps it" {
        b := StringBuilder()
        b.Push("import \"std/io\"\n")
        t := b.ToString()
        assert scribble(churnBytes) == churnBytes and t == "import \"std/io\"\n"
    }
}

# the Eisel-Lemire powers of ten: for 10^e, e from -348 to 347, the top 128 bits of its binary mantissa, rounded down
# (normalized so the top bit is set), as two I64 bit patterns each - the high half, then the low. Go's
# strconv.detailedPowersOfTen, generated with exact integers.
pow10Mant := I64[
    0xFA8FD5A0081C0288, 0x1732C869CD60E453,
    0x9C99E58405118195, 0x0E7FBD42205C8EB4,
    0xC3C05EE50655E1FA, 0x521FAC92A873B261,
    0xF4B0769E47EB5A78, 0xE6A797B752909EF9,
