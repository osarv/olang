# text, part of the prelude. A String is an Array<Char> with an identity of its own (T29a): it indexes, slices
# and goes to C as the array does, and text written in the program - a literal, a "$x" rendering, a join - is a
# String wherever one is wanted (T29c). Bytes become text with "String(bytes)", which copies nothing, and text goes
# wherever an Array<U8> is wanted as it is (T29h). "==" compares what two texts say (String's Eq, E10a); "a is b"
# asks whether they are one. There is no encoding check: a Char is one byte of text, a UTF-8 code unit.

# one byte of text (T29h): a U8 that renders as a character, the type of a character literal ('a'), and with U8's
# arithmetic ('a' + 1 is 'b')
type Char extends U8

fn (c Char) IsDigit() Bool { return c >= '0' and c <= '9' }
fn (c Char) IsLower() Bool { return c >= 'a' and c <= 'z' }
fn (c Char) IsUpper() Bool { return c >= 'A' and c <= 'Z' }
fn (c Char) IsLetter() Bool { return c.IsLower() or c.IsUpper() }
fn (c Char) IsSpace() Bool { return c == ' ' or c == '\t' or c == '\n' or c == '\r' }
fn (c Char) ToUpper() Char { return c - 32 if c.IsLower() else c }
fn (c Char) ToLower() Char { return c + 32 if c.IsUpper() else c }

type String extends Array<Char>

error ParseError {
    EMPTY
    INVALID
    OVERFLOW
}

# FNV-1a over the bytes: text that SAYS the same thing hashes the same, whatever storage holds it
fn (t String&) Hash() I64 {
    h I64 = -3750763034362895579
    for c in t {
        h = (h ^ c) * 1099511628211
    }
    return h
}

# the same bytes, in the same order
fn (a String&) Eq(b String&) Bool {
    if a.Len() != b.Len() {
        return false
    }
    for i in range a.Len() {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

# bytewise lexicographic order: -1, 0 or 1. A proper prefix sorts first.
fn (a String&) Compare(b String&) I32 {
    n I64 = a.Len()
    if b.Len() < n {
        n = b.Len()
    }
    for i in range n {
        if a[i] < b[i] {
            return -1
        }
        if a[i] > b[i] {
            return 1
        }
    }
    if a.Len() < b.Len() {
        return -1
    }
    if a.Len() > b.Len() {
        return 1
    }
    return 0
}

fn (a String&) StartsWith(prefix String&) Bool {
    if prefix.Len() > a.Len() {
        return false
    }
    return a[:prefix.Len()].Eq(prefix)
}

fn (a String&) EndsWith(suffix String&) Bool {
    if suffix.Len() > a.Len() {
        return false
    }
    return a[a.Len() - suffix.Len():].Eq(suffix)
}

# the index of the first occurrence of c - failing with the default error when there is none, so a miss is never read
# as a position: "try t.FindByte(c) catch default -1" gives a fallback, "c in t" only asks
fn (a String&) FindByte(c U8) I64 ? {
    for i in range a.Len() {
        if a[i] == c { return i }
    }
    error
}

# the index of the first occurrence of sub, failing with the default error when there is none. An empty sub is found
# at 0. Compared where it stands - each candidate's first byte, then the rest one byte at a time - so nothing is
# sliced per position
fn (a String&) Find(sub String&) I64 ? {
    return try a.findFrom(sub, 0)
}

# the index of the first occurrence of sub at or after from
fn (a String&) findFrom(sub String&, from I64) I64 ? {
    n I64 = sub.Len()
    if n == 0 { return from }
    first := sub[0]
    for i in range from, a.Len() - n + 1 {
        if a[i] == first {
            j I64 = 1
            for j < n and a[i + j] == sub[j] { j++ }
            if j == n { return i }
        }
    }
    error
}

# (Contains - whether sub occurs in it - is every array's, std/prelude/array.olang: text is an array of bytes)

# the pieces of the text between each occurrence of sep, in order - borrows of the receiver's own storage,
# so no text is copied, held in an array that lives where the receiver does. Adjacent separators, or one at
# either end, give empty pieces, so joining the pieces with sep gives the text back; text with no separator
# is one piece, and the empty text one empty piece. An empty sep splits the text into its single bytes.
# The pieces are counted first, so the array is allocated once at its exact length; for a one-byte sep the count is a
# plain loop over the bytes, which the optimizer turns into vector compares
fn (t String&) Split(sep String&) mut Array<String&>&t {
    if sep.Len() == 0 {
        bytes Array<String&>&t = Array<String&>(t.Len())
        for i in range t.Len() {
            bytes[i] = t[i:i + 1]
        }
        return bytes
    }
    if sep.Len() == 1 {
        c := sep[0]
        n I64 = 1
        for x in t {
            if x == c { n++ }
        }
        pieces Array<String&>&t = Array<String&>(n)
        k I64 = 0
        start I64 = 0
        for i in range t.Len() {
            if t[i] == c {
                pieces[k] = t[start:i]
                k++
                start = i + 1
            }
        }
        pieces[k] = t[start:]
        return pieces
    }
    n I64 = 1
    from I64 = 0
    for {
        at := try t.findFrom(sep, from) catch { break }
        n++
        from = at + sep.Len()
    }
    pieces Array<String&>&t = Array<String&>(n)
    from = 0
    for i in range n - 1 {
        at := try t.findFrom(sep, from) catch { unreachable }
        pieces[i] = t[from:at]
        from = at + sep.Len()
    }
    pieces[n - 1] = t[from:]
    return pieces
}

fn isSpace(c U8) Bool {
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'
}

# the text without leading and trailing whitespace - a borrow of the receiver's own storage, so it shares
# the receiver's scope "s" and costs no copy
fn (t String&) Trim() String&t {
    lo I64 = 0
    hi I64 = t.Len()
    for lo < hi and isSpace(t[lo]) {
        lo++
    }
    for hi > lo and isSpace(t[hi - 1]) {
        hi--
    }
    return t[lo:hi]
}

# a decimal integer with an optional leading '-' or '+', and nothing else - no surrounding space, no
# separators. The value is accumulated NEGATIVELY, since the negative range is the larger one: that is what
# lets the most negative I64 parse without overflowing on its way in.
fn (t String&) ParseInt() I64 ? ParseError {
    if t.Len() == 0 {
        error ParseError.EMPTY
    }
    neg Bool = false
    start I64 = 0
    if t[0] == '-' or t[0] == '+' {
        neg = t[0] == '-'
        start = 1
    }
    if start == t.Len() {
        error ParseError.INVALID
    }
    limit I64 = -922337203685477580        # the most negative I64 divided by ten, truncated toward zero
    v I64 = 0
    for i in range start, t.Len() {
        c U8 = t[i]
        if c < '0' or c > '9' {
            error ParseError.INVALID
        }
        d I64 = c - '0'
        if v < limit or (v == limit and d > 8) {
            error ParseError.OVERFLOW
        }
        v = v * 10 - d
    }
    if not neg {
        if v == limit * 10 - 8 {
            error ParseError.OVERFLOW
        }
        return -v
    }
    return v
}

# text built up piece by piece - what a program writing a lot of it (a compiler's output, a report) accumulates
# before it has it all. Held as a List of Chars, so adding never moves what is already there and costs no more
# than writing into a preallocated array would, and copied into one String, once, by ToString. Numbers and other
# values go in as their renderings: "b.Push($n)".
type StringBuilder struct() {
    chars mut List<Char> = List<Char>()
}

# adds t at the end
fn (b mut StringBuilder&) Push(t String&) { b.chars.PushAll(t) }

# adds one character at the end
fn (b mut StringBuilder&) PushChar(c Char) { b.chars.Push(c) }

# how many characters it holds
fn (b StringBuilder&) Len() I64 { return b.chars.Len() }

# everything added so far, as one String in the CALLER's scope - a copy, so the builder may be discarded, or keep
# growing, without affecting it
fn (b StringBuilder&) ToString() mut String& { return String(b.chars.ToArray()) }

# the tests, and what only they use - under TestBuild, so a program that is not being tested compiles none of it: the
# prelude is part of every program

if TestBuild {
    test "Eq compares contents, and == goes through it; same asks for one instance" {
        a String& = "hello"
        bytes := Array<U8>(5, 'x')
        bytes[0] = 'h'
        bytes[1] = 'e'
        bytes[2] = 'l'
        bytes[3] = 'l'
        bytes[4] = 'o'
        b := String(bytes)        # bytes become text by naming them so (T29c)
        assert a.Eq(b)
        assert a.Eq("hello")
        assert not a.Eq("hell")
        assert not a.Eq("hellO")
        assert "".Eq("")
        assert ("x = " $42).Eq("x = 42")        # a rendering is text like any other
        c String& = b                # E10a: String declares Eq, so "==" compares what two texts say
        d String& = "hello"
        assert a == c and c == "hello" and "hello" == d and a != "hell"
        assert a is a and a is not c    # E10c: identity, whatever Eq says
        n String& = null
        assert n == null and n != a and a != n
    }

    test "Compare orders bytewise, a prefix first" {
        assert "abc".Compare("abc") == 0
        assert "abc".Compare("abd") == -1
        assert "abd".Compare("abc") == 1
        assert "ab".Compare("abc") == -1
        assert "abc".Compare("ab") == 1
        assert "".Compare("a") == -1
    }

    test "prefixes, suffixes and searching" {
        s := "hello, world"
        assert s.StartsWith("hello")
        assert not s.StartsWith("world")
        assert s.EndsWith("world")
        assert s.StartsWith("")
        assert not "hi".StartsWith("high")
        assert (try s.FindByte(',') catch default -1) == 5
        assert (try s.FindByte('z') catch default -1) == -1
        assert (try s.Find("world") catch default -1) == 7
        assert (try s.Find("o") catch default -1) == 4
        assert (try s.Find("") catch default -1) == 0
        assert (try s.Find("worlds") catch default -1) == -1
        assert (try s.Find("hello, world!") catch default -1) == -1        # longer than the text
        assert (try "aab".Find("ab") catch default -1) == 1                # a false start, then the match
        assert (try "".Find("") catch default -1) == 0 and (try "".Find("a") catch default -1) == -1
        missed := false
        try s.Find("xyz") catch { missed = true }
        assert missed
        assert s.Contains("lo, w")
        assert not "".Contains("a")
    }

    test "Trim borrows the receiver's storage" {
        assert "  padded \t\n".Trim().Eq("padded")
        assert "bare".Trim().Eq("bare")
        assert "   ".Trim().Eq("")
        assert "".Trim().Eq("")
    }

    # the result of a fallible call can be bound only where there is a signature to propagate through, so the
    # checks live in a helper, as io.olang's do
    fn checkParses(t String&, want I64) ? ParseError {
        got I64 = try t.ParseInt()
        assert got == want
    }

    # each of these lets exactly one word through and swallows the other two, so a test - which must catch
    # everything it tries - can still tell which word a failure was
    fn onlyEmpty(t String&) ? ParseError {
        try t.ParseInt() catch ParseError.INVALID + ParseError.OVERFLOW { }
    }

    fn onlyInvalid(t String&) ? ParseError {
        try t.ParseInt() catch ParseError.EMPTY + ParseError.OVERFLOW { }
    }

    fn onlyOverflow(t String&) ? ParseError {
        try t.ParseInt() catch ParseError.EMPTY + ParseError.INVALID { }
    }

    test "ParseInt reads decimals across the whole I64 range" {
        ok Bool = true
        try checkParses("0", 0) catch ParseError { ok = false }
        try checkParses("42", 42) catch ParseError { ok = false }
        try checkParses("-17", -17) catch ParseError { ok = false }
        try checkParses("+8", 8) catch ParseError { ok = false }
        try checkParses("9223372036854775807", 9223372036854775807) catch ParseError { ok = false }
        try checkParses("-9223372036854775808", -9223372036854775807 - 1) catch ParseError { ok = false }
        assert ok
    }

    test "ParseInt names what was wrong" {
        e Bool = false
        try onlyEmpty("") catch ParseError { e = true }
        assert e
        i Bool = false
        try onlyInvalid("12a") catch ParseError { i = true }
        assert i
        i = false
        try onlyInvalid("-") catch ParseError { i = true }
        assert i
        i = false
        try onlyInvalid(" 1") catch ParseError { i = true }  # no surrounding space: Trim first
        assert i
        o Bool = false
        try onlyOverflow("9223372036854775808") catch ParseError { o = true }
        assert o
        o = false
        try onlyOverflow("-9223372036854775809") catch ParseError { o = true }
        assert o
        o = false
        try onlyOverflow("99999999999999999999") catch ParseError { o = true }
        assert o
        o = false
        try onlyOverflow("12") catch ParseError { o = true }
        assert not o
    }

    # T29c: text written in the program is a String wherever one is wanted - declared from, called on, passed
    fn takesBytes(b Array<U8>&) I64 { return b.Len() }

    test "T29c: written text is a String, and a String is still its bytes" {
        s := "  hi  "                        # ":=" from text declares a String
        assert s.Trim().Eq("hi")             # so it has text's methods
        r := $42 "!"                         # a rendering and a join are text too
        assert r.Eq("42!")
        assert s[2:4].Eq("hi")               # a slice of text is text
        assert takesBytes(s) == 6            # and text goes wherever bytes are wanted
        raw := Array<U8>(2, 'z')
        assert String(raw).Eq("zz")          # bytes become text only by saying so
    }

    test "equal text hashes equally, whatever storage holds it" {
        assert "ab".Hash() == String(U8['a', 'b']).Hash()
        assert "ab".Hash() != "ba".Hash()
    }

    test "Split gives the pieces between separators, borrowed from the text" {
        p := "a,b,,c".Split(",")
        assert p.Len() == 4
        assert p[0].Eq("a") and p[1].Eq("b") and p[2].Eq("") and p[3].Eq("c")
        q := ",x,".Split(",")
        assert q.Len() == 3 and q[0].Eq("") and q[1].Eq("x") and q[2].Eq("")
        assert "none".Split(",").Len() == 1 and "none".Split(",")[0].Eq("none")
        e := "".Split(",")
        assert e.Len() == 1 and e[0].Eq("")
        w := "one::two::three".Split("::")
        assert w.Len() == 3 and w[1].Eq("two") and w[2].Eq("three")
        b := "abc".Split("")
        assert b.Len() == 3 and b[0].Eq("a") and b[2].Eq("c")
        n I32 = 0
        for piece in "1 2 3".Split(" ") {
            n = n + I32(try piece.ParseInt() catch default 0)
        }
        assert n == 6
    }

    # the same searching and splitting, computed while compiling (K2): a miss is the same error there as at run time
    fn splitShape() I64 {
        p := "x::y::::z".Split("::")
        q := "1 22 333".Split(" ")
        found I64 = (try "hello".Find("ll") catch default -1) * 10 + (try "hello".Find("lo!") catch default -1)
        return p.Len() * 100000 + p[2].Len() * 10000 + q.Len() * 1000 + q[2].Len() * 100 + found
    }

    splitShapeBaked := splitShape()

    test "Split and Find, evaluated while compiling as at run time" {
        assert splitShapeBaked == 400000 + 0 + 3000 + 300 + 19
        assert splitShape() == splitShapeBaked
        one := "a b  c ".Split(" ")              # a one-byte separator: adjacent ones and one at the end
        assert one.Len() == 5 and one[1] == "b" and one[2] == "" and one[3] == "c" and one[4] == ""
    }

    test "a StringBuilder gathers text and hands it back as one String" {
        b := StringBuilder()
        assert b.Len() == 0 and b.ToString() == ""
        b.Push("define i32 @f")
        b.PushChar('(')
        b.Push($42)                          # a value goes in as its rendering
        b.PushChar(')')
        assert b.Len() == 17
        s := b.ToString()
        assert s == "define i32 @f(42)"
        b.Push(" {")                         # the String handed back is a copy: the builder keeps growing apart from it
        assert s == "define i32 @f(42)" and b.ToString() == "define i32 @f(42) {"
        long := StringBuilder()
        for i in range 1000 {
            long.Push("ab")
            long.PushChar('c')
        }
        t := long.ToString()
        assert t.Len() == 3000 and t[0] == 'a' and t[2] == 'c' and t[2997] == 'a' and t[2999] == 'c'
        assert t.EndsWith("abcabc") and t.Split("c").Len() == 1001
    }

    # the same, built while compiling (K2): the evaluator runs the builder as the run time does
    fn builtText() String& {
        b := StringBuilder()
        for i in range 3 {
            b.Push($i)
            b.PushChar(',')
        }
        b.Push("end")
        return b.ToString()
    }

    builtBaked := builtText()

    test "a StringBuilder, evaluated while compiling as at run time" {
        assert builtBaked == "0,1,2,end"
        assert builtText() == builtBaked
    }

    # mutable, so the check below is made at run time, where the arena is - and the reason it exists: ToString's text is
    # built through the conversion String(...), and the call inside it used to land in ToString's own scope, closed by its
    # return, so the next scope to take a chunk - here scribble's own - wrote over the text
    churnBytes mut I64 = 100
    fn scribble(n I64) I64 {
        a := Array<Char>(n, 'z')
        return a.Len()
    }
    test "a StringBuilder's text lives where the caller keeps it" {
        b := StringBuilder()
        b.Push("import \"std/io\"\n")
        t := b.ToString()
        assert scribble(churnBytes) == churnBytes and t == "import \"std/io\"\n"
    }
}
