# T35b: the prelude is part of every program - its exported types are visible in every module without an
# import, and it is the one place methods on the built-in types are declared (M19d).

# what Next fails with once there are no more values: running out is how a walk ends (S9a)
type Exhausted error {
    END
}

# what "for ... in" walks besides an array and a range (S9a): each Next() gives the following value, and fails
# with Exhausted once there are no more - or with what E holds, for an iterator that can fail on its way (a file's
# lines, QAH): "Iterator<String ? io.Error>". "Iterator<I64>" fails with nothing but Exhausted
type Iterator<T ? E> trait {
    mut Next() T ? E, Exhausted
}

# what a generator gives its caller (D18): a function whose result is written Iterator<T ? E> and whose body yields
# gives a Generator<T ? E>. Each Next runs the body on from where it stopped to its next yield, whose value it gives;
# it fails with Exhausted once the body has ended - and again whenever it is asked after - or with the error the body
# failed with, after which the body is over. A copy is a second name for the same walk, as a Vec's copy is the same
# list. next is the walk itself: a Generator made of any such function value walks it
type Generator<T ? E> struct(next (fn() T ? E, Exhausted)) {
    next
}

fn (g mut Generator<T ? E>&) Next() T ? E, Exhausted { return try g.next() }

# what a generator whose elements are borrowed gives (D18c): one whose result is written Iterator<T&p ? E> - each element
# a reference into what its parameter p refers to - or Iterator<T&return ? E> - into storage its walk keeps, where the
# generator lives - gives a ViewGenerator<T ? E>, T the elements' referent. Its Next gives a read-only reference that
# lives where the generator does, at least: no shorter than what Next is called on
type ViewGenerator<T ? E> struct(next (fn() T& ? E, Exhausted)) {
    next
}

fn (g mut ViewGenerator<T ? E>&) Next() T&g ? E, Exhausted { return try g.next() }

# what every iterator can do, declared once here (M19e): defaults, each a method of every type satisfying Iterator -
# "l.Iter().Count(f)", "m.Iter().Some(f)", an array's "a.Iter().Fold(...)" - with nothing written on those types.
# Each walks the iterator onward from where it stands. Each fails with what the iterator and its callbacks fail with
# (E, QAH): with nothing, for an iterator that cannot fail and callbacks that cannot, and then it is called with no try

# true when keep holds for at least one value
fn (it mut I&) Some<I Iterator<T ? E>, T ? E>(keep fn(x T) Bool ? E) Bool ? E {
    for x in try it {
        if try keep(x) { return true }
    }
    return false
}

# true when keep holds for every value - so for none, when there are none
fn (it mut I&) Every<I Iterator<T ? E>, T ? E>(keep fn(x T) Bool ? E) Bool ? E {
    for x in try it {
        if not try keep(x) { return false }
    }
    return true
}

# how many values keep holds for
fn (it mut I&) Count<I Iterator<T ? E>, T ? E>(keep fn(x T) Bool ? E) I64 ? E {
    n I64 = 0
    for x in try it {
        if try keep(x) { n++ }
    }
    return n
}

# every value folded into one, starting from init
fn (it mut I&) Fold<I Iterator<T ? E>, T, U ? E>(init U, f fn(acc U, x T) U ? E) U ? E {
    acc U = init
    for x in try it {
        acc = try f(acc, x)
    }
    return acc
}

# a new Vec - in the caller's scope - of f applied to every element
fn (it mut I&) Map<I Iterator<T ? E>, T, U ? E>(f fn(x T) U ? E) Vec<U>& ? E {
    out mut Vec<U>&return = Vec<U>()
    for x in try it {
        out.Push(try f(x))
    }
    return out
}

# a new Vec - in the caller's scope - of the elements keep holds for
fn (it mut I&) Filter<I Iterator<T ? E>, T ? E>(keep fn(x T) Bool ? E) Vec<T>& ? E {
    out mut Vec<T>&return = Vec<T>()
    for x in try it {
        if try keep(x) { out.Push(x) }
    }
    return out
}

# a new Vec - in the caller's scope - of every value, in order: "m.Keys().ToVec()"
fn (it mut I&) ToVec<I Iterator<T ? E>, T ? E>() Vec<T>& ? E {
    out mut Vec<T>&return = Vec<T>()
    for x in try it {
        out.Push(x)
    }
    return out
}

# a collection with positions (S9d): "for x in c" walks one directly, as a counted loop over At(0) .. At(Len()-1);
# Iter() is derived here for one that has no Iter of its own, so the helpers above reach it too
type Indexable<T> trait {
    At(i I64) T
    Len() I64
}

# a position in an Indexable - the collection by reference, and the next index
type IndexIter<T, C Indexable<T>> struct(of C&) {
    c C&of = of
    i I64 = 0
}

fn (it mut IndexIter<T, C>&) Next() T ? Exhausted {
    if it.i >= it.c.Len() { error Exhausted.END }
    it.i++
    return it.c.At(it.i - 1)
}

# a fresh position at the start, for any type with At and Len and no Iter of its own (M19e)
fn (c C&) Iter<C Indexable<T>, T>() IndexIter<T, C> { return IndexIter<T, C>(c) }

# ---- adapters: iterators made from iterators ----
#
# Each wraps the iterator it is made from - a copy of it, so the one it was made from stays where it stood - and walks
# it lazily, one value per Next: "for x in l.Iter().Skip(2).Take(3)" reads five of l's elements and builds nothing.

# Each fails with what the iterator it wraps fails with (E, QAH).

# the first n values, then the end
type TakeIter<I, T ? E> struct(of I, n I64) {
    it I = of
    left I64 = n
}

fn (t mut TakeIter<I, T ? E>&) Next() T ? E, Exhausted {
    if t.left <= 0 { error Exhausted.END }
    t.left--
    return try t.it.Next()
}

fn (it mut I&) Take<I Iterator<T ? E>, T ? E>(n I64) TakeIter<I, T ? E> { return TakeIter<I, T ? E>(it, n) }

# every value after the first n
type SkipIter<I, T ? E> struct(of I, n I64) {
    it I = of
    skip I64 = n
}

fn (s mut SkipIter<I, T ? E>&) Next() T ? E, Exhausted {
    for s.skip > 0 {
        try s.it.Next()
        s.skip--
    }
    return try s.it.Next()
}

fn (it mut I&) Skip<I Iterator<T ? E>, T ? E>(n I64) SkipIter<I, T ? E> { return SkipIter<I, T ? E>(it, n) }

# a value and how many came before it - what Enumerate gives
type Indexed<T> struct(index I64, value T) {
    Index I64 = index
    Value T = value
}

type EnumerateIter<I, T ? E> struct(of I) {
    it I = of
    i I64 = 0
}

fn (e mut EnumerateIter<I, T ? E>&) Next() Indexed<T> ? E, Exhausted {
    x := try e.it.Next()
    e.i++
    return Indexed<T>(e.i - 1, x)
}

# each value with its position, from 0: "for e in it.Enumerate() { ... e.Index ... e.Value }" - as "for i, x in it" does
# in a loop, for a walk handed on to something else
fn (it mut I&) Enumerate<I Iterator<T ? E>, T ? E>() EnumerateIter<I, T ? E> { return EnumerateIter<I, T ? E>(it) }

# two values, one from each of two iterators walked side by side - what Zip gives
type Zipped<A, B> struct(first A, second B) {
    First A = first
    Second B = second
}

type ZipIter<I, A, J, B ? E> struct(a I, b J) {
    x I = a
    y J = b
}

fn (z mut ZipIter<I, A, J, B ? E>&) Next() Zipped<A, B> ? E, Exhausted {
    p := try z.x.Next()
    q := try z.y.Next()
    return Zipped<A, B>(p, q)
}

# this iterator's values paired with other's, until either runs out: "for p in xs.Iter().Zip(ys.Iter()) { p.First ...
# p.Second }"
fn (it mut I&) Zip<I Iterator<A ? E>, A, J Iterator<B ? E>, B ? E>(other J) ZipIter<I, A, J, B ? E> {
    return ZipIter<I, A, J, B ? E>(it, other)
}

# this iterator's values, then other's
type ChainIter<I, J, T ? E> struct(a I, b J) {
    x I = a
    y J = b
    second Bool = false
}

fn (c mut ChainIter<I, J, T ? E>&) Next() T ? E, Exhausted {
    if not c.second {
        return try c.x.Next() catch Exhausted {
            c.second = true
            return try c.y.Next()
        }
    }
    return try c.y.Next()
}

fn (it mut I&) Chain<I Iterator<T ? E>, T, J Iterator<T ? E> ? E>(other J) ChainIter<I, J, T ? E> {
    return ChainIter<I, J, T ? E>(it, other)
}

# every value added up, from 0 - wrapping as "+" does for integers (E6c); a sum of none is 0
fn (it mut I&) Sum<I Iterator<T ? E>, T Number ? E>() T ? E {
    acc T = 0
    for x in try it { acc = acc + x }
    return acc
}

# the least value by "<" - the first of several equal ones - failing with Exhausted when there is none
fn (it mut I&) Min<I Iterator<T ? E>, T ? E>() T ? E, Exhausted {
    best := try it.Next()
    for x in try it {
        if x < best: best = x
    }
    return best
}

# the greatest value by "<" - the first of several equal ones - failing with Exhausted when there is none
fn (it mut I&) Max<I Iterator<T ? E>, T ? E>() T ? E, Exhausted {
    best := try it.Next()
    for x in try it {
        if best < x: best = x
    }
    return best
}

# the value whose key is least, key called once per value - the first of several equal ones; failing with Exhausted
# when there is none: "people.Iter().MinBy(fn(p Person) I64 { return p.Age })"
fn (it mut I&) MinBy<I Iterator<T ? E>, T, K ? E>(key fn(x T) K ? E) T ? E, Exhausted {
    best := try it.Next()
    bestKey := try key(best)
    for x in try it {
        k := try key(x)
        if k < bestKey {
            best = x
            bestKey = k
        }
    }
    return best
}

# the value whose key is greatest, as MinBy
fn (it mut I&) MaxBy<I Iterator<T ? E>, T, K ? E>(key fn(x T) K ? E) T ? E, Exhausted {
    best := try it.Next()
    bestKey := try key(best)
    for x in try it {
        k := try key(x)
        if bestKey < k {
            best = x
            bestKey = k
        }
    }
    return best
}

# ---- more walks: while forms, a step, flattening, a backward walk, partition ----

# the values up to the first keep does not hold for, which ends the walk there (and is not given): "for x in
# it.TakeWhile(fn(x): return x < 100)". keep is not called again once it has said no
type TakeWhileIter<I, T ? E> struct(of I, keep fn(x T) Bool ? E) {
    it I = of
    pred fn(x T) Bool ? E = keep
    done Bool = false
}

fn (t mut TakeWhileIter<I, T ? E>&) Next() T ? E, Exhausted {
    if t.done { error Exhausted.END }
    x := try t.it.Next()
    if not try t.pred(x) {
        t.done = true
        error Exhausted.END
    }
    return x
}

fn (it mut I&) TakeWhile<I Iterator<T ? E>, T ? E>(keep fn(x T) Bool ? E) TakeWhileIter<I, T ? E> {
    return TakeWhileIter<I, T ? E>(it, keep)
}

# the values from the first keep does not hold for on, that one included: the leading run keep holds for is skipped,
# and keep is not called again after it
type SkipWhileIter<I, T ? E> struct(of I, keep fn(x T) Bool ? E) {
    it I = of
    pred fn(x T) Bool ? E = keep
    skipping Bool = true
}

fn (s mut SkipWhileIter<I, T ? E>&) Next() T ? E, Exhausted {
    for s.skipping {
        x := try s.it.Next()
        if not try s.pred(x) {
            s.skipping = false
            return x
        }
    }
    return try s.it.Next()
}

fn (it mut I&) SkipWhile<I Iterator<T ? E>, T ? E>(keep fn(x T) Bool ? E) SkipWhileIter<I, T ? E> {
    return SkipWhileIter<I, T ? E>(it, keep)
}

# what a StepSize below one fails with
type StepError error {
    BAD_STEP
}

# how far StepBy steps: at least one. A literal is checked while compiling ("it.StepBy(2)", and 0 is a compile-time
# error, T29d); a step computed while the program runs is made one with StepSize(n), which fails with
# StepError.BAD_STEP below one - as ChunkSize is for Chunks and Windows
type StepSize I64(v I64) ? StepError.BAD_STEP {
    if v < 1 { error StepError.BAD_STEP }
}

# the first value, then every n-th after it: values 0, n, 2n ... of the walk; "range s, e, step" is the same for numbers
type StepByIter<I, T ? E> struct(of I, n I64) {
    it I = of
    step I64 = n
    started Bool = false
}

fn (s mut StepByIter<I, T ? E>&) Next() T ? E, Exhausted {
    if s.started {
        for _ in range s.step - 1 { try s.it.Next() }
    }
    s.started = true
    return try s.it.Next()
}

fn (it mut I&) StepBy<I Iterator<T ? E>, T ? E>(n StepSize) StepByIter<I, T ? E> { return StepByIter<I, T ? E>(it, I64(n)) }

# the values of the iterator f gives for each value, one after another: "for w in lines.FlatMap(fn(l String&)
# ArrayIter<String&> { return l.Split(" ").Iter() })". Each inner walk is made when the one before it has run out
type FlatMapIter<I, T, J, U ? E> struct(of I, f fn(x T) J ? E) {
    it I = of
    make fn(x T) J ? E = f
    cur Vec<J>          # the inner walk under way: none before the first value, and after each has run out (a Vec,
                        # since a walk may have no zero value, D13c)
}

fn (m mut FlatMapIter<I, T, J, U ? E>&) Next() U ? E, Exhausted {
    for {
        if m.cur.Len() > 0 {
            w := m.cur[0]
            v := try w.Next() catch Exhausted {
                m.cur.Clear()
                continue
            }
            m.cur[0] = w
            return v
        }
        x := try m.it.Next()
        m.cur.Push(try m.make(x))
    }
}

fn (it mut I&) FlatMap<I Iterator<T ? E>, T, J Iterator<U ? E>, U ? E>(f fn(x T) J ? E) FlatMapIter<I, T, J, U ? E> {
    return FlatMapIter<I, T, J, U ? E>(it, f)
}

# the values split by keep: two new Vecs - in the caller's scope - of those keep holds for and of the rest, each in
# the order they came: "small, big := it.Partition(fn(x): return x < 10)"
fn (it mut I&) Partition<I Iterator<T ? E>, T ? E>(keep fn(x T) Bool ? E) Vec<T>&, Vec<T>& ? E {
    yes mut Vec<T>&return = Vec<T>()
    no mut Vec<T>&return = Vec<T>()
    for x in try it {
        if try keep(x) {
            yes.Push(x)
        } else {
            no.Push(x)
        }
    }
    return yes, no
}

# a collection with positions walked from its last element to its first - what Reversed gives a Vec, or any type with
# At and Len (an array's own Reversed is in array.olang)
type ReversedIndexIter<T, C Indexable<T>> struct(of C&) {
    c C&of = of
    i I64 = of.Len()
}

fn (it mut ReversedIndexIter<T, C>&) Next() T ? Exhausted {
    if it.i <= 0 { error Exhausted.END }
    it.i--
    return it.c.At(it.i)
}

# the elements from the last to the first: "for x in v.Reversed()" - the position read at each step, so a walk sees
# what its body stores at the positions still ahead of it
fn (c C&) Reversed<C Indexable<T>, T>() ReversedIndexIter<T, C> { return ReversedIndexIter<T, C>(c) }

# ---- walks, round 3: running totals, groups and runs, duplicates, pairs taken apart, a product, the last and n-th ----

# each running value of f, from init: the first f(init, x0), then f of that and x1, and so on - "it.Scan(0, fn(a, x):
# return a + x)" gives the running sums; init itself is not given
type ScanIter<I, T, U ? E> struct(of I, init U, f fn(acc U, x T) U ? E) {
    it I = of
    acc U = init
    step fn(acc U, x T) U ? E = f
}

fn (s mut ScanIter<I, T, U ? E>&) Next() U ? E, Exhausted {
    x := try s.it.Next()
    s.acc = try s.step(s.acc, x)
    return s.acc
}

fn (it mut I&) Scan<I Iterator<T ? E>, T, U ? E>(init U, f fn(acc U, x T) U ? E) ScanIter<I, T, U ? E> {
    return ScanIter<I, T, U ? E>(it, init, f)
}

# the values grouped by their key: a new Map - in the caller's scope - from each key to a Vec of the values that have
# it, in the order they came, the keys in the order first met; key called once per value
fn (it mut I&) GroupBy<I Iterator<T ? E>, T, K Hashable<K> ? E>(key fn(x T) K ? E) Map<K, Vec<T>>& ? E {
    out mut Map<K, Vec<T>>&return = Map<K, Vec<T>>()
    for x in try it {
        k := try key(x)
        if not out.Has(k): out.Put(k, Vec<T>())
        g := try out.Get(k) catch MapError { continue }
        g.Push(x)
    }
    return out
}

# the values in runs: each run a new Vec of consecutive values same holds for, called on each value and the one before
# it - "it.ChunkBy(fn(a, b): return b == a + 1)" gives the runs of counting numbers. A run ends where same says no
type ChunkByIter<I, T ? E> struct(of I, same fn(a T, b T) Bool ? E) {
    it I = of
    pred fn(a T, b T) Bool ? E = same
    next Vec<T>         # the value that began the next run, read past the end of the last one (a Vec, since T may
                        # have no zero value, D13c)
}

fn (c mut ChunkByIter<I, T ? E>&) Next() Vec<T>& ? E, Exhausted {
    run mut Vec<T>&return = Vec<T>()
    if c.next.Len() > 0 {
        run.Push(c.next[0])
        c.next.Clear()
    } else {
        run.Push(try c.it.Next())
    }
    for {
        x := try c.it.Next() catch Exhausted { return run }
        if not try c.pred(run[run.Len() - 1], x) {
            c.next.Push(x)
            return run
        }
        run.Push(x)
    }
}

fn (it mut I&) ChunkBy<I Iterator<T ? E>, T ? E>(same fn(a T, b T) Bool ? E) ChunkByIter<I, T ? E> {
    return ChunkByIter<I, T ? E>(it, same)
}

# the values with each run of equal ones ("==", E10) given once: 1, 1, 2, 1 gives 1, 2, 1 - a value equal to one
# further back, not the one before it, is given again
type DedupIter<I, T ? E> struct(of I) {
    it I = of
    last Vec<T>         # the value given last: none before the first (a Vec, since T may have no zero value, D13c)
}

fn (d mut DedupIter<I, T ? E>&) Next() T ? E, Exhausted {
    for {
        x := try d.it.Next()
        if d.last.Len() > 0 and d.last[0] == x: continue
        d.last.Clear()
        d.last.Push(x)
        return x
    }
}

fn (it mut I&) Dedup<I Iterator<T ? E>, T ? E>() DedupIter<I, T ? E> { return DedupIter<I, T ? E>(it) }

# a walk of pairs (Zip's) taken apart: two new Vecs - in the caller's scope - of the first parts and of the second
fn (it mut I&) Unzip<I Iterator<Zipped<A, B> ? E>, A, B ? E>() Vec<A>&, Vec<B>& ? E {
    firsts mut Vec<A>&return = Vec<A>()
    seconds mut Vec<B>&return = Vec<B>()
    for z in try it {
        firsts.Push(z.first)
        seconds.Push(z.second)
    }
    return firsts, seconds
}

# every value multiplied together, from 1 - wrapping as "*" does for integers (E6c); a product of none is 1
fn (it mut I&) Product<I Iterator<T ? E>, T Number ? E>() T ? E {
    acc T = 1
    for x in try it { acc = acc * x }
    return acc
}

# the last value, the walk run to its end - failing with Exhausted when there is none
fn (it mut I&) Last<I Iterator<T ? E>, T ? E>() T ? E, Exhausted {
    last := try it.Next()
    for x in try it { last = x }
    return last
}

# the value at position n, counted from 0 - the n before it read and dropped - failing with Exhausted where the walk
# has no more than n values, and for a negative n
fn (it mut I&) Nth<I Iterator<T ? E>, T ? E>(n I64) T ? E, Exhausted {
    if n < 0: error Exhausted.END
    for _ in range n { try it.Next() }
    return try it.Next()
}

# ---- the same on a collection with positions: a Vec, or any type with At and Len (an array's own are in array.olang)

# the first position whose element is not below x ("<"), in a collection sorted by "<": where x would go to keep it
# sorted, Len() where every element is below x - a binary search, log2 n reads
fn (c C&) LowerBound<C Indexable<T>, T>(x T) I64 {
    lo I64 = 0
    hi := c.Len()
    for lo < hi {
        mid := lo + (hi - lo) / 2
        if c.At(mid) < x { lo = mid + 1 } else { hi = mid }
    }
    return lo
}

# the first position whose element is equal to x ("==", E10), in a collection sorted by "<" - a binary search, failing
# with ArrayError.NOT_FOUND where there is none
fn (c C&) BinarySearch<C Indexable<T>, T>(x T) I64 ? ArrayError.NOT_FOUND {
    i := c.LowerBound(x)
    if i < c.Len() and c.At(i) == x: return i
    error ArrayError.NOT_FOUND
}

# a collection with positions walked from its first element to its last and round again, without end - an empty one
# gives nothing
type CycleIndexIter<T, C Indexable<T>> struct(of C&) {
    c C&of = of
    i I64 = 0
}

fn (it mut CycleIndexIter<T, C>&) Next() T ? Exhausted {
    n := it.c.Len()
    if n == 0: error Exhausted.END
    if it.i >= n: it.i = 0
    it.i++
    return it.c.At(it.i - 1)
}

# the elements over and over: "for x in v.Cycle().Take(10)" - the position read at each step, so a walk sees what its
# body stores
fn (c C&) Cycle<C Indexable<T>, T>() CycleIndexIter<T, C> { return CycleIndexIter<T, C>(c) }

# the tests, and what only they use - under TestBuild, so a program that is not being tested compiles none of it: the
# prelude is part of every program

if TestBuild {
    # what the walks below fail with when a callback does
    type walkBad error {
        NO
    }

    fn walkOdd(x I64) Bool ? walkBad {
        if x == 4 { error walkBad.NO }
        return x % 2 == 1
    }

    # examples (B7a): what olang doc shows under each adapter
    test Iterator.TakeWhile "the leading values a test holds for" {
        assert I64[1, 2, 5, 3].Iter().TakeWhile(fn(x): return x < 4).ToVec().ToArray() == I64[1, 2]
    }
    test Iterator.TakeWhile "fails with what its test fails with" {
        assert (try I64[1, 3, 4, 5].Iter().TakeWhile(walkOdd).ToVec().Len() catch walkBad default -1) == -1
        assert (try I64[1, 3, 2, 4].Iter().TakeWhile(walkOdd).ToVec().Len() catch walkBad default -1) == 2
    }
    test Iterator.SkipWhile "the values from the first a test does not hold for" {
        assert I64[1, 2, 5, 3].Iter().SkipWhile(fn(x): return x < 4).ToVec().ToArray() == I64[5, 3]
        assert I64[1, 2].Iter().SkipWhile(fn(x): return x < 4).ToVec().Len() == 0
    }
    test Iterator.StepBy "the first value and every n-th after it" {
        assert I64[0, 1, 2, 3, 4, 5, 6].Iter().StepBy(3).ToVec().ToArray() == I64[0, 3, 6]
        assert I64[0, 1].Iter().StepBy(1).ToVec().ToArray() == I64[0, 1]
        n := 0
        assert (try StepSize(n) catch StepError default StepSize(9)) == StepSize(9)
    }
    test Iterator.FlatMap "the values of each value's walk, one walk after another" {
        a := I64[1, 2, 3]
        assert a.Iter().FlatMap(fn(x I64) ArrayIter<I64> { return a[x - 1:].Iter() }).ToVec().ToArray() == I64[1, 2, 3, 2, 3, 3]
    }
    test Indexable.Reversed "a Vec from its last element to its first" {
        v := Vec<I64>()
        for i in range 4 { v.Push(i) }
        s := 0
        for x in v.Reversed() { s = s * 10 + x }
        assert s == 3210 and Vec<I64>().Reversed().ToVec().Len() == 0
    }
}
