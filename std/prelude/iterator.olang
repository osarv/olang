# T35b: the prelude is part of every program - its exported types are visible in every module without an
# import, and it is the one place methods on the built-in types are declared (M19d).

# what "for ... in" walks besides an array and a range (S9a): each Next() gives the following value, and
# false once there are no more
type Iterator<T> interface {
    mut Next() (<T>, Bool)
}

# what every iterator can do, declared once here (M19e): callable on any value whose type satisfies Iterator -
# "l.Iter().Count(f)", "m.Iter().Any(f)", an array's "a.Iter().Fold(...)" - with nothing written on those types.
# Each walks the iterator onward from where it stands.

# true when keep holds for at least one value
fn (it mut Iterator<<T>>&) Any(keep fn(x <T>) Bool) Bool {
    for x in it {
        if keep(x) { return true }
    }
    return false
}

# true when keep holds for every value - so for none, when there are none
fn (it mut Iterator<<T>>&) All(keep fn(x <T>) Bool) Bool {
    for x in it {
        if not keep(x) { return false }
    }
    return true
}

# how many values keep holds for
fn (it mut Iterator<<T>>&) Count(keep fn(x <T>) Bool) Int64 {
    n Int64 = 0
    for x in it {
        if keep(x) { n++ }
    }
    return n
}

# every value folded into one, starting from init
fn (it mut Iterator<<T>>&) Fold(init <U>, f fn(acc <U>, x <T>) <U>) <U> {
    acc <U> = init
    for x in it {
        acc = f(acc, x)
    }
    return acc
}

# a new List - in the caller's scope - of f applied to every element
fn (it mut Iterator<<T>>&) Map(f fn(x <T>) <U>) List<<U>>& {
    out List<<U>>&return = List<<U>>()
    for x in it {
        out.Push(f(x))
    }
    return out
}

# a new List - in the caller's scope - of the elements keep holds for
fn (it mut Iterator<<T>>&) Filter(keep fn(x <T>) Bool) List<<T>>& {
    out List<<T>>&return = List<<T>>()
    for x in it {
        if keep(x) { out.Push(x) }
    }
    return out
}
