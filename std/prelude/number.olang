# the numbers, part of the prelude: the numeric traits, the constants, and the numbers' methods - the C math library's
# functions on every float (x.Sqrt(), x.Exp(), y.Atan2(x) ...), and Abs, Min, Max, Clamp on every number and Pow and
# Sqrt on every integer.
#
# Float, Integer and Number name the built-in number types, so generic code over numbers says which it takes -
# `fn (x T) Sqrt<T Float>() T` - and a call with any other type is an error at the call naming the trait (G19), not a
# case missing inside the library.
#
# Each trait is closed (T31a, T35c): it lists the types that satisfy it, and no other type does - not one declaring a
# method of some name, and not one extending a number: Char (`type Char extends U8`) and `type Dist extends F64` are
# types of their own and satisfy none. So a body constrained by one may choose per type with "match T" over the
# built-in numbers alone, as the methods below do, and needs no nomatch.

import cmath "math.h"

type Float trait for F16, BF16, F32, F64 { }

# every integer type, of every width from 1 to 128 bits (T4a), signed and unsigned, sixteen widths a line
type Integer trait for I1, I2, I3, I4, I5, I6, I7, I8, I9, I10, I11, I12, I13, I14, I15, I16
    I17, I18, I19, I20, I21, I22, I23, I24, I25, I26, I27, I28, I29, I30, I31, I32
    I33, I34, I35, I36, I37, I38, I39, I40, I41, I42, I43, I44, I45, I46, I47, I48
    I49, I50, I51, I52, I53, I54, I55, I56, I57, I58, I59, I60, I61, I62, I63, I64
    I65, I66, I67, I68, I69, I70, I71, I72, I73, I74, I75, I76, I77, I78, I79, I80
    I81, I82, I83, I84, I85, I86, I87, I88, I89, I90, I91, I92, I93, I94, I95, I96
    I97, I98, I99, I100, I101, I102, I103, I104, I105, I106, I107, I108, I109, I110, I111, I112
    I113, I114, I115, I116, I117, I118, I119, I120, I121, I122, I123, I124, I125, I126, I127, I128
    U1, U2, U3, U4, U5, U6, U7, U8, U9, U10, U11, U12, U13, U14, U15, U16
    U17, U18, U19, U20, U21, U22, U23, U24, U25, U26, U27, U28, U29, U30, U31, U32
    U33, U34, U35, U36, U37, U38, U39, U40, U41, U42, U43, U44, U45, U46, U47, U48
    U49, U50, U51, U52, U53, U54, U55, U56, U57, U58, U59, U60, U61, U62, U63, U64
    U65, U66, U67, U68, U69, U70, U71, U72, U73, U74, U75, U76, U77, U78, U79, U80
    U81, U82, U83, U84, U85, U86, U87, U88, U89, U90, U91, U92, U93, U94, U95, U96
    U97, U98, U99, U100, U101, U102, U103, U104, U105, U106, U107, U108, U109, U110, U111, U112
    U113, U114, U115, U116, U117, U118, U119, U120, U121, U122, U123, U124, U125, U126, U127, U128 { }

# every Float and every Integer
type Number trait for Integer, Float { }

# ---- the constants ----

# pi, e, the positive infinity and the quiet NaN, as F64s - F32(Pi) is the F32 nearest pi. Others are computed where
# they are wanted, F64(2).Sqrt() or F64(10).Log(), which a constant context does while compiling (K2)
Pi F64 = 3.141592653589793
Euler F64 = 2.718281828459045
Inf F64 = 1.0 / 0.0
# the quiet NaN with no sign and no payload, made from its bits so that its bits are known (E33a)
NaN F64 = U64(0x7FF8000000000000).F64FromBits()

# ---- the floats' methods ----
#
# Each is written once, over the four float types (a default of Float, M19e), and compiled per type. An F64 or an F32
# goes to the C math library's function for its type; an F16 or a BF16 is computed in F32 - F64 for Fma - and rounded
# once to its own type. The library's functions are ones the language knows (X8): sqrt, fma, floor and the other exact
# ones become instructions where the machine has them and vectorize, and every one of them is computed while compiling
# where a value is needed then (K1, K2), by the very function the program calls.
#
# A result outside a function's domain is what IEEE 754 says - (-1.0).Sqrt() and (-1.0).Log() are NaN, 0.0.Log() is
# -Inf, 1000.0.Exp() is Inf - never an error: a NaN carries the failure through the rest of a computation and is asked
# about once, with IsNan, where a check on every call would cost what the call does. Math with checks is IsFinite on
# the result.


# the square root - correctly rounded, as IEEE 754 requires; NaN below zero, and (-0.0).Sqrt() is -0.0
fn (x T) Sqrt<T Float>() T {
    return match T {
        case F64: cmath.sqrt(x)
        case F32: cmath.sqrtf(x)
        case F16: F16(cmath.sqrtf(x))
        case BF16: BF16(cmath.sqrtf(x))
    }
}

# the cube root, negative for a negative x
fn (x T) Cbrt<T Float>() T {
    return match T {
        case F64: cmath.cbrt(x)
        case F32: cmath.cbrtf(x)
        case F16: F16(cmath.cbrtf(x))
        case BF16: BF16(cmath.cbrtf(x))
    }
}

# e to the power x
fn (x T) Exp<T Float>() T {
    return match T {
        case F64: cmath.exp(x)
        case F32: cmath.expf(x)
        case F16: F16(cmath.expf(x))
        case BF16: BF16(cmath.expf(x))
    }
}

# 2 to the power x
fn (x T) Exp2<T Float>() T {
    return match T {
        case F64: cmath.exp2(x)
        case F32: cmath.exp2f(x)
        case F16: F16(cmath.exp2f(x))
        case BF16: BF16(cmath.exp2f(x))
    }
}

# x.Exp() - 1, accurate where x is near zero and the subtraction would lose it
fn (x T) Expm1<T Float>() T {
    return match T {
        case F64: cmath.expm1(x)
        case F32: cmath.expm1f(x)
        case F16: F16(cmath.expm1f(x))
        case BF16: BF16(cmath.expm1f(x))
    }
}

# the natural logarithm: -Inf at zero, NaN below it
fn (x T) Log<T Float>() T {
    return match T {
        case F64: cmath.log(x)
        case F32: cmath.logf(x)
        case F16: F16(cmath.logf(x))
        case BF16: BF16(cmath.logf(x))
    }
}

# the base-2 logarithm
fn (x T) Log2<T Float>() T {
    return match T {
        case F64: cmath.log2(x)
        case F32: cmath.log2f(x)
        case F16: F16(cmath.log2f(x))
        case BF16: BF16(cmath.log2f(x))
    }
}

# the base-10 logarithm
fn (x T) Log10<T Float>() T {
    return match T {
        case F64: cmath.log10(x)
        case F32: cmath.log10f(x)
        case F16: F16(cmath.log10f(x))
        case BF16: BF16(cmath.log10f(x))
    }
}

# (1 + x).Log(), accurate where x is near zero and the addition would lose it
fn (x T) Log1p<T Float>() T {
    return match T {
        case F64: cmath.log1p(x)
        case F32: cmath.log1pf(x)
        case F16: F16(cmath.log1pf(x))
        case BF16: BF16(cmath.log1pf(x))
    }
}

# x to the power y - C's pow, with every one of its special cases: x.Pow(0.0) is 1 even for a NaN x, and a negative
# x to a power that is not a whole number is NaN
fn (x T) Pow<T Float>(y T) T {
    return match T {
        case F64: cmath.pow(x, y)
        case F32: cmath.powf(x, y)
        case F16: F16(cmath.powf(x, y))
        case BF16: BF16(cmath.powf(x, y))
    }
}

# the length of the vector (x, y) - (x * x + y * y).Sqrt() without overflowing or underflowing on the way
fn (x T) Hypot<T Float>(y T) T {
    return match T {
        case F64: cmath.hypot(x, y)
        case F32: cmath.hypotf(x, y)
        case F16: F16(cmath.hypotf(x, y))
        case BF16: BF16(cmath.hypotf(x, y))
    }
}

# x * a + b, rounded once - an F16 or a BF16 in F64, whose 53 bits hold their product exactly
fn (x T) Fma<T Float>(a T, b T) T {
    return match T {
        case F64: cmath.fma(x, a, b)
        case F32: cmath.fmaf(x, a, b)
        case F16: F16(cmath.fma(x, a, b))
        case BF16: BF16(cmath.fma(x, a, b))
    }
}

fn (x T) Sin<T Float>() T {
    return match T {
        case F64: cmath.sin(x)
        case F32: cmath.sinf(x)
        case F16: F16(cmath.sinf(x))
        case BF16: BF16(cmath.sinf(x))
    }
}

fn (x T) Cos<T Float>() T {
    return match T {
        case F64: cmath.cos(x)
        case F32: cmath.cosf(x)
        case F16: F16(cmath.cosf(x))
        case BF16: BF16(cmath.cosf(x))
    }
}

fn (x T) Tan<T Float>() T {
    return match T {
        case F64: cmath.tan(x)
        case F32: cmath.tanf(x)
        case F16: F16(cmath.tanf(x))
        case BF16: BF16(cmath.tanf(x))
    }
}

# the angle whose sine is x, in -Pi/2 .. Pi/2; NaN outside -1 .. 1
fn (x T) Asin<T Float>() T {
    return match T {
        case F64: cmath.asin(x)
        case F32: cmath.asinf(x)
        case F16: F16(cmath.asinf(x))
        case BF16: BF16(cmath.asinf(x))
    }
}

# the angle whose cosine is x, in 0 .. Pi; NaN outside -1 .. 1
fn (x T) Acos<T Float>() T {
    return match T {
        case F64: cmath.acos(x)
        case F32: cmath.acosf(x)
        case F16: F16(cmath.acosf(x))
        case BF16: BF16(cmath.acosf(x))
    }
}

# the angle whose tangent is x, in -Pi/2 .. Pi/2
fn (x T) Atan<T Float>() T {
    return match T {
        case F64: cmath.atan(x)
        case F32: cmath.atanf(x)
        case F16: F16(cmath.atanf(x))
        case BF16: BF16(cmath.atanf(x))
    }
}

# the angle of the point (x, y) from the positive x axis, in -Pi .. Pi: y.Atan2(x) - y first, as in C
fn (y T) Atan2<T Float>(x T) T {
    return match T {
        case F64: cmath.atan2(y, x)
        case F32: cmath.atan2f(y, x)
        case F16: F16(cmath.atan2f(y, x))
        case BF16: BF16(cmath.atan2f(y, x))
    }
}

fn (x T) Sinh<T Float>() T {
    return match T {
        case F64: cmath.sinh(x)
        case F32: cmath.sinhf(x)
        case F16: F16(cmath.sinhf(x))
        case BF16: BF16(cmath.sinhf(x))
    }
}

fn (x T) Cosh<T Float>() T {
    return match T {
        case F64: cmath.cosh(x)
        case F32: cmath.coshf(x)
        case F16: F16(cmath.coshf(x))
        case BF16: BF16(cmath.coshf(x))
    }
}

fn (x T) Tanh<T Float>() T {
    return match T {
        case F64: cmath.tanh(x)
        case F32: cmath.tanhf(x)
        case F16: F16(cmath.tanhf(x))
        case BF16: BF16(cmath.tanhf(x))
    }
}

# the error function, 2/Pi.Sqrt() times the integral of (-t*t).Exp() from 0 to x - the normal distribution's, and GELU's
fn (x T) Erf<T Float>() T {
    return match T {
        case F64: cmath.erf(x)
        case F32: cmath.erff(x)
        case F16: F16(cmath.erff(x))
        case BF16: BF16(cmath.erff(x))
    }
}

# 1 - x.Erf(), accurate where x.Erf() is near 1
fn (x T) Erfc<T Float>() T {
    return match T {
        case F64: cmath.erfc(x)
        case F32: cmath.erfcf(x)
        case F16: F16(cmath.erfcf(x))
        case BF16: BF16(cmath.erfcf(x))
    }
}

# the largest whole number not above x
fn (x T) Floor<T Float>() T {
    return match T {
        case F64: cmath.floor(x)
        case F32: cmath.floorf(x)
        case F16: F16(cmath.floorf(x))
        case BF16: BF16(cmath.floorf(x))
    }
}

# the smallest whole number not below x
fn (x T) Ceil<T Float>() T {
    return match T {
        case F64: cmath.ceil(x)
        case F32: cmath.ceilf(x)
        case F16: F16(cmath.ceilf(x))
        case BF16: BF16(cmath.ceilf(x))
    }
}

# x without its fraction - toward zero
fn (x T) Trunc<T Float>() T {
    return match T {
        case F64: cmath.trunc(x)
        case F32: cmath.truncf(x)
        case F16: F16(cmath.truncf(x))
        case BF16: BF16(cmath.truncf(x))
    }
}

# the nearest whole number, a half away from zero: 2.5.Round() is 3, (-2.5).Round() is -3 - as C, Go and Rust round
fn (x T) Round<T Float>() T {
    return match T {
        case F64: cmath.round(x)
        case F32: cmath.roundf(x)
        case F16: F16(cmath.roundf(x))
        case BF16: BF16(cmath.roundf(x))
    }
}

# the nearest whole number, a half to the even one: 2.5.RoundEven() is 2, 3.5.RoundEven() is 4 - IEEE 754's own rounding,
# which leaves no bias over many values, so the one a quantizer wants
fn (x T) RoundEven<T Float>() T {
    return match T {
        case F64: cmath.roundeven(x)
        case F32: cmath.roundevenf(x)
        case F16: F16(cmath.roundevenf(x))
        case BF16: BF16(cmath.roundevenf(x))
    }
}

# x's magnitude with the sign of s - its sign bit, so 1.0.CopySign(-0.0) is -1.0
fn (x T) CopySign<T Float>(s T) T {
    return match T {
        case F64: cmath.copysign(x, s)
        case F32: cmath.copysignf(x, s)
        case F16: F16(cmath.copysignf(x, s))
        case BF16: BF16(cmath.copysignf(x, s))
    }
}

# whether x's sign bit is set - true for -0.0 and for a NaN with a sign, which x < 0.0 is not
fn (x T) SignBit<T Float>() Bool {
    return match T {
        case F64: x.Bits() >> 63 == 1
        case F32: x.Bits() >> 31 == 1
        case F16, BF16: x.Bits() >> 15 == 1
    }
}

# whether x is a NaN - the one value not equal to itself
fn (x T) IsNan<T Float>() Bool {
    return match T {
        case F64, F32, F16, BF16: x != x
    }
}

# whether x is an infinity, of either sign
fn (x T) IsInf<T Float>() Bool {
    return match T {
        case F64, F32, F16, BF16: x.Abs() == Inf
    }
}

# whether x is a number - neither an infinity nor a NaN
fn (x T) IsFinite<T Float>() Bool {
    return match T {
        case F64, F32, F16, BF16: x.Abs() < Inf
    }
}

# ---- every number's methods ----
#
# Abs, Min, Max and Clamp on a float follow IEEE 754 (the sign bit; a NaN propagates; -0.0 below 0.0), on an integer
# the plain arithmetic. A type other than a number that wants them declares its own

# x without its sign - a float's sign bit cleared, so (-0.0).Abs() is 0.0; an integer's negation when it is negative,
# which for the most negative one is itself, as negation wraps (E6c); an unsigned integer as it is
fn (x T) Abs<T Number>() T {
    return match T {
        case F64: cmath.fabs(x)
        case F32: cmath.fabsf(x)
        case F16: F16(cmath.fabsf(x))
        case BF16: BF16(cmath.fabsf(x))
        case U8, U16, U32, U64: x
        case _: -x if x < 0 else x
    }
}

# the lesser of a and b. For a float, IEEE 754's minimum: a NaN if either is one, since a NaN means the computation that
# made it failed and taking the other would hide that; and -0.0 below 0.0, so a.Min(b) and b.Min(a) are the same value.
# Otherwise a when they are equal
fn (a T) Min<T Number>(b T) T {
    match T {
        case F64, F32, F16, BF16 {
            if a != a or b != b { return a + b }        # a NaN: the sum is one
            if a == b { return a if a.SignBit() else b } # -0.0 and 0.0 are equal and differ only there
        }
        case _ { }
    }
    return b if b < a else a
}

# the greater of a and b, as Min: a NaN if either is one, and 0.0 above -0.0
fn (a T) Max<T Number>(b T) T {
    match T {
        case F64, F32, F16, BF16 {
            if a != a or b != b { return a + b }
            if a == b { return b if a.SignBit() else a }
        }
        case _ { }
    }
    return b if a < b else a
}

# x brought within lo .. hi: lo below it, hi above it - and hi when lo is above hi, since the upper bound is applied
# last. A NaN x stays a NaN
fn (x T) Clamp<T Number>(lo T, hi T) T {
    return x.Max(lo).Min(hi)
}

# ---- the integers' methods ----

# what an integer's square root fails with, and a narrowing x.Narrow<T>(), which the compiler supplies (E26b)
type NumberError error {
    NEGATIVE       # a negative value, which has no square root among the integers
    OVERFLOW       # a narrowing that changes the value: an integer out of T's range, a finite float made infinite
    INVALID        # a NaN or an infinity narrowed to an integer
}

# x to the power n, wrapping as "*" does (E6c): x.Pow(0) is 1, 0 included - at I1, which cannot hold 1, that 1 wrapped,
# -1 - std/arith's Pow fails where it overflows. The product starts from the first factor taken, so no 1 is ever held
fn (x T) Pow<T Integer>(n U32) T {
    if n == 0 {
        if T.Max < 1 { return T.Min } else { return 1 }     # I1's 1 wrapped is its least value, -1
    }
    r T = x
    started := false
    b T = x
    e U32 = n
    for e > 0 {
        if (e & 1) == 1 {
            r = r * b if started else b
            started = true
        }
        e = e >> 1
        if e > 0 { b = b * b }
    }
    return r
}

# x modulo n, floored (Knuth's, Python's "%"): x - n * x.DivFloor(n), its sign the divisor's (or zero) - where "%"
# (Rem) truncates, its sign the dividend's: (-7).Mod(3) is 2, -7 % 3 is -1. A zero n is undefined, as for "/" (E6a)
fn (x T) Mod<T Integer>(n T) T {
    r := x % n
    if r != 0 and (r < 0) != (n < 0): return r + n
    return r
}

# x divided by n, rounded down (toward negative infinity): (-7).DivFloor(2) is -4, where "/" truncates to -3. A zero
# n, and an integer's least value divided by -1, are undefined, as for "/" (E6a)
fn (x T) DivFloor<T Integer>(n T) T {
    q := x / n
    if x % n != 0 and (x < 0) != (n < 0): return q - 1
    return q
}

# x divided by n, rounded up (toward positive infinity): 7.DivCeil(2) is 4, where "/" truncates to 3 - the count of
# n-sized pieces x needs. A zero n, and an integer's least value divided by -1, are undefined, as for "/" (E6a)
fn (x T) DivCeil<T Integer>(n T) T {
    q := x / n
    if x % n != 0 and (x < 0) == (n < 0): return q + 1
    return q
}

# the largest whole number whose square is not above n - the floor of its square root, exact for every U64: the
# hardware's square root of the nearest F64, then a correction of one each way (the F64's rounding and the root's leave
# it within one). The comparisons divide rather than square, so nothing overflows near 2^64
fn sqrtU64(n U64) U64 {
    if n < 2 { return n }
    r U64 = U64(cmath.sqrt(F64(n)))
    for r > n / r { r-- }                           # r * r > n
    for r + 1 <= n / (r + 1) { r++ }                # (r + 1) * (r + 1) <= n
    return r
}

# the integer square root: the largest whole number whose square is not above x, in x's type - 17 gives 4. An unsigned
# integer's cannot fail; a signed integer's fails with NumberError.NEGATIVE for a negative x
fn (x U8) Sqrt() U8 { return U8(sqrtU64(U64(x))) }
fn (x U16) Sqrt() U16 { return U16(sqrtU64(U64(x))) }
fn (x U32) Sqrt() U32 { return U32(sqrtU64(U64(x))) }
fn (x U64) Sqrt() U64 { return sqrtU64(x) }
fn (x I8) Sqrt() I8 ? NumberError {
    if x < 0 { error NumberError.NEGATIVE }
    return I8(sqrtU64(U64(x)))
}
fn (x I16) Sqrt() I16 ? NumberError {
    if x < 0 { error NumberError.NEGATIVE }
    return I16(sqrtU64(U64(x)))
}
fn (x I32) Sqrt() I32 ? NumberError {
    if x < 0 { error NumberError.NEGATIVE }
    return I32(sqrtU64(U64(x)))
}
fn (x I64) Sqrt() I64 ? NumberError {
    if x < 0 { error NumberError.NEGATIVE }
    return I64(sqrtU64(U64(x)))
}

# every other integer width's (T4a), as the eight's: an unsigned one's cannot fail, a signed one's fails with
# NumberError.NEGATIVE for a negative x - its error set inferred, so per width (R1a)
fn (x T) Sqrt<T Integer>() T ? {
    if T.Min < 0 {
        if x < 0 { error NumberError.NEGATIVE }
    }
    if T.Size <= 8 { return T(sqrtU64(U64(x))) }
    return T(sqrtU128(U128(x)))
}

# sqrtU64's floor of the square root, for the widths past 64 bits: from just above the F64's root - within 2^12 of the
# true one at 128 bits - Newton's steps down to the floor, each step's sum below 2^66
fn sqrtU128(n U128) U128 {
    if n < (U128(1) << 64) { return U128(sqrtU64(U64(n))) }
    r := U128(cmath.sqrt(F64(n))) + 4096
    for {
        s := (r + n / r) / 2
        if s >= r { break }
        r = s
    }
    for r > n / r { r-- }
    for r + 1 <= n / (r + 1) { r++ }
    return r
}
