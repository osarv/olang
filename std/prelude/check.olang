# the errors the language's own checks report, part of the prelude. Each is produced only under "checked": an
# operation or a call written without it behaves as it always does (§5, E6a-E6c, E8a, E16, E26a, D17). A function
# that lets one through names CheckError in its signature, as it would any error type, or catches it.
error CheckError {
    OUT_OF_BOUNDS      # an index or slice outside its array, or an array length out of range
    DIVIDE_BY_ZERO     # an integer "/" or "%" by zero, or a finite nonzero float divided by zero
    OVERFLOW           # a result the type cannot hold: an integer operation's, a shift's true value x * 2^n, a
                       # conversion that changes the value, a finite value made infinite
    INVALID            # IEEE's invalid operation: a NaN from operands that are not, a NaN or infinity made an integer
    WRONG_CASE         # an "as" naming a case the value is not
    CONTRACT           # a call's contract (D17): a requirement false before it, or a guarantee false after it
}
