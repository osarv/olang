# vec - the growable array, the one a program reaches for first: its elements in one contiguous buffer, which doubles as
# it fills. Where std/list's List never moves what it stores (a chain of chunks, a copy for contiguity), a Vec moves its
# elements into a new buffer when it grows, and is an array in every other respect: "v[i]" is an element of one array,
# "for x in v" a counted walk over it, View() lends the elements as an array.
#
# A Vec is a VALUE, as an array is: it holds its buffer by value (QCE), so a copy of a Vec ("w := v", a field, an
# element, a by-value argument, a task's argument) is a Vec of its own holding the same elements - deep through values,
# shallow at references, as any value's copy is - and a Push to one is never seen through the other. Sharing one Vec is
# written with "&": "v mut Vec<I64>&" names another's Vec and may change it, "v Vec<I64>&" reads it. An element is
# read where the Vec holds it through Ref(i) and changed there through RefMut(i) ("vv.RefMut(i).Push(x)" for a Vec of
# Vecs), as a Map's value is through Map.Ref and Map.RefMut - where "vv[i]" gives a copy.
#
# Growth replaces the buffer: a new one, twice the size (8 at first), the elements moved into it, and the old one
# retired - nothing in a Vec uses it again. The old buffer stays where the Vec lives until that scope closes, so a view of
# it taken before the growth ("d := v.View()") reads the elements as they were then, never freed memory. That is a
# correctness hazard rather than a memory one, and it is written where it can happen: View() is the one way to have a
# Vec's elements as an array. The compile-time evaluator stops on a use of such a view, and under -sanitize the old
# buffer is made unreadable, so a run reports one (B2f). The buffers growth leaves add up to less than the last one (8 +
# 16 + ... + N/2 < N).
#
# "Vec<T>(cap)" starts with room for cap elements (none by default), made by its first Push. The elements are the
# buffer's first Len(); the rest is room - never read as elements, and where an element owns storage (a String, a Vec)
# left empty (grown clears it, vacate empties what it moves out), so a copy of the whole buffer copies nothing that is
# no longer an element.

# what a Vec's operations fail with: a First, Last or Pop of an empty Vec (Empty), an IndexOf finding nothing
# (NotFound), and a position outside it given to TakeAt, RemoveAt, SwapTake, SwapRemove or Insert (OutOfRange)
type VecError error {
    Empty
    NotFound
    OutOfRange
}

type Vec<T> struct(cap I64 = 0) {
    data Array<T>                                            # the buffer (of a run-time length, T7d); its first n elements are the Vec's
    n I64 = 0
    want I64 = cap                                           # the room asked for (Vec<T>(cap), Reserve) while there is no buffer
}

# a buffer of room for at least need elements, the elements moved into it when the one there is smaller: twice the size
# of the last (8 at first), or need, or what was asked for, whichever is most. The new buffer is grown from the old
# (M19d): its first elements moved out of it, the rest never filled - no slot past the count is read before a Push or
# an Insert writes it, so a T with no zero value - a Map, a struct whose constructor has an effect - is as ordinary an
# element as any other (D13c), and a doubling writes each byte once. The old buffer is retired: nothing here uses it
# again
fn (v mut Vec<T>&) room(need I64) {
    if need <= v.data.Len() { return }
    r I64 = 8 if v.data.Len() < 4 else v.data.Len() * 2
    if r < need { r = need }
    if r < v.want { r = v.want }
    old Array<T>&v = v.data                                  # the buffer being replaced, viewed (not copied)
    v.data = old[:v.n].grown(r)
    old.retire()
}

# x after the last element - into the room left, or into a buffer twice the size, the elements moved into it
fn (v mut Vec<T>&) Push(x T) {
    if v.n == v.data.Len() { v.room(v.n + 1) }
    v.data[v.n] = x
    v.n++
}

# every element of a, in order - with one grow at most
fn (v mut Vec<T>&) PushAll(a Array<T>&) {
    if a.Len() == 0 { return }
    if v.n + a.Len() > v.data.Len() {
        r I64 = v.data.Len() * 2
        if r < v.n + a.Len() { r = v.n + a.Len() }
        v.room(r)
    }
    for i in range a.Len() { v.data[v.n + i] = a[i] }
    v.n += a.Len()
}

fn (v Vec<T>&) Len() I64 { return v.n }

# how many elements fit before the buffer is replaced
fn (v Vec<T>&) Cap() I64 { return v.data.Len() if v.data.Len() > v.want else v.want }

# room for n more elements, the buffer replaced at most once - by one at least twice the size when it is (so a Push
# after a Reserve costs as one after doubling would). With no element to fill a new buffer with, an empty Vec only
# remembers the room, and its first Push makes it
fn (v mut Vec<T>&) Reserve(n I64) {
    if v.n + n <= v.Cap() { return }
    r I64 = v.Cap() * 2
    if r < v.n + n { r = v.n + n }
    if v.n == 0 {
        v.want = r
        return
    }
    v.room(r)
}

# the element at position i - "v[i]" (E31). Unchecked, as an array index is (E16): "try v.Get(i)" checks it
fn (v Vec<T>&) At(i I64) T { return v.data[i] }

# the element at position i, failing with OUT_OF_RANGE where i is no position - "v[i]" checked, as an array's Get is
# (E16d)
fn (v Vec<T>&) Get(i I64) T ? VecError.OutOfRange {
    if i < 0 or i >= v.n { error VecError.OutOfRange }
    return v.data[i]
}

# the element at position i where the Vec holds it, read with no copy made - "vv[i]" gives a copy. Unchecked, as At is;
# good until the Vec grows or loses it, as a view is (View)
fn (v Vec<T>&) Ref(i I64) T&v { return v.data[i] }

# ...writable, to change in place - "vv.RefMut(i).Push(x)" for a Vec of Vecs
fn (v mut Vec<T>&) RefMut(i I64) mut T&v { return v.data[i] }

# replaces the element at position i - "v[i] = x" (E31), unchecked as At is
fn (v mut Vec<T>&) SetAt(i I64, x T) { v.data[i] = x }

# the first element - failing with Empty when there is none, as Map.Get fails on a missing key
fn (v Vec<T>&) First() T ? VecError.Empty {
    if v.n == 0 { error VecError.Empty }
    return v.data[0]
}

# the last element - failing with Empty when there is none
fn (v Vec<T>&) Last() T ? VecError.Empty {
    if v.n == 0 { error VecError.Empty }
    return v.data[v.n - 1]
}

# removes the last element and gives it - failing with Empty when there is none. Moves nothing, and keeps the buffer
fn (v mut Vec<T>&) Pop() T ? VecError.Empty {
    if v.n == 0 { error VecError.Empty }
    v.n--
    return v.data[v.n].vacate()
}

# removes every element, keeping the buffer for the Pushes that follow
fn (v mut Vec<T>&) Clear() { v.Truncate(0) }

# keeps the first k elements and removes the rest - nothing changes when there are k or fewer, and none is kept for a k of
# 0 or less
fn (v mut Vec<T>&) Truncate(k I64) {
    if k >= v.n { return }
    n I64 = k if k > 0 else 0
    for i in range n, v.n { v.data[i].vacate() }
    v.n = n
}

# the elements, lent as an array - a window on the buffer as it is now, good until the Vec grows (a Push, a PushAll, an
# Insert, a Reserve may replace the buffer, and the view goes on showing the old one)
fn (v Vec<T>&) View() Array<T>&v { return v.data[:v.n] }

# ...writable
fn (v mut Vec<T>&) ViewMut() mut Array<T>&v { return v.data[:v.n] }

# removes the element at position i, giving nothing (Remove lets go, Take gives - TakeAt below), the elements after it each
# moving down one place as TakeAt moves them
fn (v mut Vec<T>&) RemoveAt(i I64) ? VecError.OutOfRange { try v.TakeAt(i) }

# removes the element at position i and gives it, the elements after it each moving down one place - so it costs the
# number of elements after i. i must be a position, from 0 to Len() - 1: one that is not fails with OutOfRange,
# checked once per call
fn (v mut Vec<T>&) TakeAt(i I64) T ? VecError.OutOfRange {
    if i < 0 or i >= v.n { error VecError.OutOfRange }
    x := v.data[i].vacate()
    for k in range i, v.n - 1 { v.data[k] = v.data[k + 1].vacate() }
    v.n--
    return x
}

# removes the element at position i as SwapTake does, giving nothing
fn (v mut Vec<T>&) SwapRemove(i I64) ? VecError.OutOfRange { try v.SwapTake(i) }

# removes the element at position i and gives it, the last element taking its place - so it moves one element, and the
# order is not kept. i must be a position, checked once per call: one that is not fails with OutOfRange
fn (v mut Vec<T>&) SwapTake(i I64) T ? VecError.OutOfRange {
    if i < 0 or i >= v.n { error VecError.OutOfRange }
    x := v.data[i].vacate()
    v.n--
    if i < v.n { v.data[i] = v.data[v.n].vacate() }         # the last element moved into the gap
    return x
}

# puts x at position i, the elements from i on each moving up one place - so Insert(Len(), x) is Push(x). i must be from
# 0 to Len(), checked once per call: one that is not fails with OutOfRange
fn (v mut Vec<T>&) Insert(i I64, x T) ? VecError.OutOfRange {
    if i < 0 or i > v.n { error VecError.OutOfRange }
    if v.n == v.data.Len() { v.room(v.n + 1) }
    k I64 = v.n
    for k > i {
        v.data[k] = v.data[k - 1].vacate()
        k--
    }
    v.data[i] = x
    v.n++
}

# the elements in the opposite order, in place
fn (v mut Vec<T>&) Reverse() { v.data[:v.n].Reverse() }

# sorts the elements in place so that less(v[i], v[i - 1]) holds nowhere - stable, as an array's Sort is, and done by it
fn (v mut Vec<T>&) Sort<? E>(less fn(x T, y T) Bool ? E) ? E { try v.data[:v.n].Sort(less) }

# the position of the first element equal to x, compared with "==" - failing with NOT_FOUND when there is none
fn (v Vec<T>&) IndexOf(x T) I64 ? VecError.NotFound {
    for i in range v.n {
        if v.data[i] == x { return i }
    }
    error VecError.NotFound
}

# removes the first element equal to x, compared with "==", the elements after it each moving down one place as RemoveAt
# moves them - and says whether there was one, as Map's Remove does
fn (v mut Vec<T>&) Remove(x T) Bool {
    i := try v.IndexOf(x) catch { return false }
    try v.RemoveAt(i) catch { unreachable }   # a position IndexOf found
    return true
}

# whether x is one of the elements, compared with "==" - what "x in v" asks (E29)
fn (v Vec<T>&) Has(x T) Bool {
    for i in range v.n {
        if v.data[i] == x { return true }
    }
    return false
}

# the texts one after another with sep between each two, as an array of texts joins (Array<String&>.Join)
fn (v Vec<String&>&) Join(sep String&) String { return v.data[:v.n].Join(sep) }

# ...of texts the Vec holds by value
fn (v Vec<String>&) Join(sep String&) String {
    n I64 = sep.Len() * (v.n - 1) if v.n > 1 else 0
    for i in range v.n { n += v.data[i].Len() }
    out := String(Array<Char>(n))
    w I64 = 0
    for i in range v.n {
        if i > 0 {
            for c in sep {
                out[w] = c
                w++
            }
        }
        for c in v.data[i] {
            out[w] = c
            w++
        }
    }
    return out
}

# the elements copied into one array in the CALLER's scope - independent of the Vec, which may grow
fn (v Vec<T>&) ToArray() mut Array<T>& {
    if v.n == 0 { return Array<T>(0) }
    out mut Array<T>&return = Array<T>(v.n, v.data[0])
    for i in range v.n { out[i] = v.data[i] }
    return out
}

# whether two Vecs hold equal elements in the same order - "==" (E10a), as two arrays compare
fn (v Vec<T>&) Eq(o Vec<T>&) Bool { return v.data[:v.n] == o.data[:o.n] }

# the elements' hash, as an array of them hashes - so equal Vecs hash alike (E10b)
fn (v Vec<T>&) Hash() I64 { return v.data[:v.n].HashElements() }

# how "$" renders a Vec (E11c): as an array of its elements renders, with the Vec named in front - "Vec<I64>[1, 2, 3]",
# "Vec<String&>["a"]", "Vec<Char>['x', '\n']": an array of Char renders as text, so a Vec of them writes each element as a
# character literal, as it renders inside any other value
fn (v Vec<T>&) Str() String {
    match T {
        case Char {
            b := StringBuilder()
            b.Push("Vec<Char>[")
            for i in range v.n {
                if i > 0 { b.Push(", ") }
                b.Push(vecCharLiteral(v.data[i]))
            }
            b.PushChar(']')
            return b.ToString()
        }
        case _ {
            r := $v.data[:v.n]
            o := try r.FindByte('[') catch { unreachable }
            return "Vec<" $r[:o] ">" $r[o:]
        }
    }
}

# c as a character literal writes it - how "$" renders a Char inside another value (E11a)
fn vecCharLiteral(c Char) String {
    if c == '\n' { return "'\\n'" }
    if c == '\t' { return "'\\t'" }
    if c == '\r' { return "'\\r'" }
    if c == '\0' { return "'\\0'" }
    if c == '\\' { return "'\\\\'" }
    if c == '\'' { return "'\\''" }
    return "'" $c "'"
}

# the tests, and what only they use - under TestBuild, so a program that is not being tested compiles none of it: the
# prelude is part of every program

if TestBuild {
    # examples (B7a): what olang doc shows under the method
    test Vec.Push "adds at the end" {
        v := Vec<I64>()
        v.Push(1)
        v.Push(2)
        assert v.Len() == 2 and v[1] == 2
    }
}
