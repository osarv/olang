# compile-time reflection (G32-G38): what "T.Kind" gives, and the descriptors "T.Fields", "T.Cases", "T.Params" and
# "T.Results" hold. A descriptor is a value of no fields whose type says which member it describes - the compiler makes
# them, with the member's type and its position as arguments, so a generic taking one ("fn decode<P>(p P) P.Type") is
# compiled once per member, and everything it asks of one is a constant there

# what kind of type a type is (G32): coarse - I32 and I64 are both Integer, the exact type is "match T"'s (G13). A
# declared type has its base's kind
type TypeKind enum {
    Struct
    Enum
    Integer
    Float
    Bool
    Array
    Reference
    Function
    Error        # an error value's type (T20): an error type or a named set - its words its T.Cases
}

# a field (G34): of a struct, or of an enum's case C - a struct's fields are its one case's - at position I. Its
# arguments after T are constants, which the compiler writes
type FieldInfo<T, C, I> struct() { }

# an enum's case C (G34), or a struct's one case
type CaseInfo<T, C> struct() { }

# a parameter at position I (G34): of a function type, or of a type's constructor
type ParamInfo<T, I> struct() { }

# a function type's result at position I (G34)
type ResultInfo<T, I> struct() { }

# why "x.Attr<A>()" gives no value (G40): the declaration it reads has no attribute of type A
type AttrError error { Missing }

# the call "x.Attr<A>()" is (G40): the attribute's value where the declaration has one, an AttrError.Missing where it
# has none - which the compiler knows, so a program asking either way is held to handling the failure
fn attrGot<A>(a A) A ? AttrError.Missing { return a }
fn attrMissing<A>() A ? AttrError.Missing { error AttrError.Missing }

# a function, or a method (G41): F its type (a method's receiver first), K a key naming which - the compiler writes
# both. "f(args)" calls it, a method's receiver first
type FuncInfo<F, K> struct() { }
