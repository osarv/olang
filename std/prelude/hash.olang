# hashing, part of the prelude: what a Map needs of a key - "Hash() Int64", agreeing with "==" - for the built-in
# types a key is most often (String's own is in text.olang, beside the type - M19). A program's own key type declares
# it (T29, M19), and an Eq too when "==" is not already what equal keys means (E10a).
# Integer arithmetic wraps, which every hash here relies on.

# what a Map key needs (G19): a Hash that agrees with "==" - keys equal by "==" hash equally
type Hashable<T> interface {
    Hash() Int64
}

# a multiply by the golden-ratio constant, then the high bits folded into the low ones: a Map takes the low
# bits as a bucket index, and a multiply alone leaves keys that differ only above them in one bucket
fn mixHash(n Int64) Int64 {
    h Int64 = n * -7046029254386353131
    return h ^ (h >> 29)
}

fn (n Int64) Hash() Int64 { return mixHash(n) }
fn (n Int32) Hash() Int64 { return mixHash(Int64(n)) }
fn (b Byte) Hash() Int64 { return mixHash(Int64(b)) }


test "equal keys hash equally, and nearby integers spread" {
    assert Int32(7).Hash() == Int32(7).Hash()
    assert Int64(1).Hash() != Int64(2).Hash()
}
