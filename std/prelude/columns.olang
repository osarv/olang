# columns - structures of arrays (T7e): a table of rows of a record type T held as one array per field of T, a column,
# rather than one array of T - so a loop over one field reads one array of numbers, which the machine walks in order and
# vectorizes, where an array of T interleaves every field. Two types, as Array and Vec are two:
#
# Columns<T> acts as an array does: its length is set where it is made - "Columns<P>(n)" n rows as T's zero value,
# "Columns<P>(n, p)" n rows each p - and never changes. It is a value: a copy ("d := c", a field, a by-value argument)
# is a table of its own holding the same rows. ColumnVec<T> acts as a Vec does: it starts empty and grows by Push, Insert
# moving rows together; its buffers double as it fills, a growth retiring the old ones as a Vec's (B2f).
#
# T is a record - a struct whose constructor declares exactly its fields, each a parameter written bare ("type P
# struct(X F32, Y F32) { X, Y }"): a column is written element by element, so a type whose constructor checks or
# computes has nothing that would keep its rows as it made them. "c.x" is field x's column as an array - lane operators
# apply ("c.x += c.vx * dt"); a ColumnVec's is a view of its first Len() elements, good until it grows, as a Vec's View
# is. "c[i]" is row i as a T, a copy assembled from the columns, "c[i] = p" writes p's fields into them, "for p in c"
# walks the rows. A private field's column is read where the field is (M6a), and a column assigned whole ("c.x = v")
# is written in place, v's length checked once against the table's. The compiler lays a Columns out - one field per column, named as T's field, each an array of
# that field's type - and writes its constructor; everything else is here, over reflection (G32-G37), which here sees
# every field of T.

# T's zero value: the rows "Columns<P>(n)" holds where no fill is given (D13c) - a T with none (a never-null reference
# field) needs one
fn zeroRow<T>() T {
    r T
    return r
}

# rows rows, each fill: one column per field of T, the compiler's (columnsFields), each Array<F>(rows, fill.f) - a
# negative rows ends the program, as an array's length does (D14b)
type Columns<T> struct(rows I64 = 0, fill T = zeroRow<T>()) { }

# the number of rows: every column's length
fn (c Columns<T>&) Len() I64 { return Columns<T>.Fields[0].Of(c).Len() }

# row i, assembled from the columns - "c[i]" (E31). Unchecked, as an array index is (E16): "try c.Get(i)" checks it
fn (c Columns<T>&) At(i I64) T { return T(cell(c, p, i) for p in T.Params) }

# row i's value of the field p - a record's parameter is its field, of the same name
fn cell<T, P>(c Columns<T>&, p P, i I64) P.Type {
    for f in Columns<T>.Fields {
        if f.Name == p.Name { return f.Of(c)[i] }
    }
    unreachable
}

# row i, failing with OutOfRange where i is no row - "c[i]" checked, as an array's Get is (E16d)
fn (c Columns<T>&) Get(i I64) T ? ArrayError.OutOfRange {
    if i < 0 or i >= c.Len() { error ArrayError.OutOfRange }
    return c.At(i)
}

# row i replaced by x, each of x's fields written into its column - "c[i] = x" (E31b), unchecked as At is
fn (c mut Columns<T>&) SetAt(i I64, x T) {
    for k, f in T.Fields { Columns<T>.Fields[k].Of(c)[i] = f.Of(x) }
}

# rows i and j exchanged, in every column
fn (c mut Columns<T>&) Swap(i I64, j I64) {
    for f in Columns<T>.Fields { swapIn(f.Of(c), i, j) }
}

fn swapIn<F>(a mut Array<F>&, i I64, j I64) {
    x := a[i]
    a[i] = a[j]
    a[j] = x
}

# sorts the rows in place so that less(c[i], c[i - 1]) holds nowhere, every column moved together - stable, as an
# array's Sort is: the rows' order is found by sorting their positions, then each column is laid out in it
fn (c mut Columns<T>&) Sort<? E>(less fn&(x T, y T) Bool ? E) ? E {
    order := Array<I64>[k for k in range c.Len()]
    try order.Sort(fn(a I64, b I64) Bool ? E: return less(c[a], c[b]))
    for f in Columns<T>.Fields { reorder(f.Of(c), order) }
}

# a's elements laid out in the order given - element k the one at order[k]
fn reorder<F>(a mut Array<F>&, order Array<I64>&) {
    if a.Len() == 0 { return }
    was := Array<F>(a.Len(), a[0])
    for k in range a.Len() { was[k] = a[order[k]] }
    for k in range a.Len() { a[k] = was[k] }
}

# the rows, copied into one array in the caller's scope
fn (c Columns<T>&) ToArray() Array<T> { return rowsOf(c, c.Len()) }

# the first n rows of c, in order
fn rowsOf<T>(c Columns<T>&, n I64) Array<T> {
    if n == 0 { return Array<T>(0) }
    out := Array<T>(n, c[0])
    for i in range 1, n { out[i] = c[i] }
    return out
}

# the rows, copied into a Vec
fn (c Columns<T>&) ToVec() Vec<T> {
    v := Vec<T>(c.Len())
    for i in range c.Len() { v.Push(c[i]) }
    return v
}

# a ColumnVec holding the rows, copied - which may grow
fn (c Columns<T>&) ToColumnVec() ColumnVec<T> {
    v := ColumnVec<T>()
    v.data = c
    v.n = c.Len()
    return v
}

# a Columns of every row an iterator gives, in order (D19) - what its literal and comprehension call (E19, E27):
# "Columns<P>[P(1, 2), P(3, 4)]". A walk of an array is laid out column by column at once; any other gathered as a
# ColumnVec gathers and handed over at its count. Fails with what the iterator fails with
fn Columns<T>.FromIter<I Iterator<T ? E> ? E>(it mut I&) Columns<T> ? E {
    match I {
        case ArrayIter<T> { return it.Rest().ToColumns() }
        case _ { }
    }
    v := try ColumnVec<T>.FromIter(it)
    return v.ToColumns()
}

# the rows, held as columns: a Columns of an array's elements
fn (a Array<T>&) ToColumns() Columns<T> {
    out Columns<T>
    for k, f in T.Fields { Columns<T>.Fields[k].Of(out) = columnOf(a, f) }
    return out
}

# ...a ColumnVec of them
fn (a Array<T>&) ToColumnVec() ColumnVec<T> { return a.ToColumns().ToColumnVec() }

# ...of a Vec's elements
fn (v Vec<T>&) ToColumns() Columns<T> { return v.View().ToColumns() }

fn (v Vec<T>&) ToColumnVec() ColumnVec<T> { return v.View().ToColumns().ToColumnVec() }

# the field d of every element of a, in order
fn columnOf<T, D>(a Array<T>&, d D) Array<D.Type> {
    if a.Len() == 0 { return Array<D.Type>(0) }
    out := Array<D.Type>(a.Len(), d.Of(a[0]))
    for i in range 1, a.Len() { out[i] = d.Of(a[i]) }
    return out
}

# how "$" renders a Columns (E11c): as an array of its rows renders, the type named in front - "Columns<P>[P(1, 2)]"
fn (c Columns<T>&) Str() String {
    r := $c.ToArray()                                    # "Array<T>[...]"
    return "Columns" $r[5:]
}

# ---- ColumnVec ----

# a growable table of rows held as columns (T7e), as a Vec is a growable array: its columns the first n elements of
# data's, the rest room, never read as rows. "ColumnVec<T>(cap)" starts with room for cap rows, made by its first Push
type ColumnVec<T> struct(cap I64 = 0) {
    data Columns<T>        # the buffers: each column's first n elements are the rows'
    n I64 = 0
    want I64 = cap         # the room asked for while there are no buffers
}

# a ColumnVec of every row an iterator gives, in order (D19) - what its literal and comprehension call (E19, E27). A
# walk of an array reserves its count first. Fails with what the iterator fails with
fn ColumnVec<T>.FromIter<I Iterator<T ? E> ? E>(it mut I&) ColumnVec<T> ? E {
    out ColumnVec<T>
    match I {
        case ArrayIter<T> { out.Reserve(it.Rest().Len()) }
        case _ { }
    }
    for x in try it { out.Push(x) }
    return out
}

# room for at least need rows, every column moved into a buffer twice the size (8 at first), or need, or what was asked
# for, whichever is most - grown from the old as a Vec's is, the old one retired (M19d)
fn (v mut ColumnVec<T>&) room(need I64) {
    have := v.data.Len()
    if need <= have { return }
    r I64 = 8 if have < 4 else have * 2
    if r < need { r = need }
    if r < v.want { r = v.want }
    for f in Columns<T>.Fields {
        old f.Type& = f.Of(v.data)
        f.Of(v.data) = old[:v.n].grown(r)
        old.retire()
    }
}

fn (v ColumnVec<T>&) Len() I64 { return v.n }

# how many rows fit before the buffers are replaced
fn (v ColumnVec<T>&) Cap() I64 { return v.data.Len() if v.data.Len() > v.want else v.want }

# room for k more rows, the buffers replaced at most once
fn (v mut ColumnVec<T>&) Reserve(k I64) {
    if v.n + k <= v.Cap() { return }
    r I64 = v.Cap() * 2
    if r < v.n + k { r = v.n + k }
    v.want = r
    if v.n > 0 { v.room(r) }
}

# x after the last row - each of its fields after its column's last element
fn (v mut ColumnVec<T>&) Push(x T) {
    if v.n == v.data.Len() { v.room(v.n + 1) }
    for k, f in T.Fields { Columns<T>.Fields[k].Of(v.data)[v.n].occupy(f.Of(x)) }
    v.n++
}

# row i - "v[i]" (E31), unchecked as an array index is: "try v.Get(i)" checks it
fn (v ColumnVec<T>&) At(i I64) T { return v.data[i] }

# row i, failing with OutOfRange where i is no row
fn (v ColumnVec<T>&) Get(i I64) T ? VecError.OutOfRange {
    if i < 0 or i >= v.n { error VecError.OutOfRange }
    return v.data[i]
}

# row i replaced by x - "v[i] = x" (E31b), unchecked as At is
fn (v mut ColumnVec<T>&) SetAt(i I64, x T) { v.data[i] = x }

# removes the last row and gives it - failing with Empty when there is none
fn (v mut ColumnVec<T>&) Pop() T ? VecError.Empty {
    if v.n == 0 { error VecError.Empty }
    v.n--
    x := v.data[v.n]
    for f in Columns<T>.Fields { f.Of(v.data)[v.n].vacate() }
    return x
}

# removes every row, keeping the buffers
fn (v mut ColumnVec<T>&) Clear() { v.Truncate(0) }

# keeps the first k rows and removes the rest - nothing changes for k at or above Len()
fn (v mut ColumnVec<T>&) Truncate(k I64) {
    if k >= v.n { return }
    keep I64 = k if k > 0 else 0
    for f in Columns<T>.Fields { vacateFrom(f.Of(v.data), keep, v.n) }
    v.n = keep
}

fn vacateFrom<F>(a mut Array<F>&, from I64, n I64) {
    for i := n - 1, i >= from, i-- { a[i].vacate() }
}

# removes row i, the rows after it each moving down one place - failing with OutOfRange where i is no row
fn (v mut ColumnVec<T>&) RemoveAt(i I64) ? VecError.OutOfRange {
    if i < 0 or i >= v.n { error VecError.OutOfRange }
    for f in Columns<T>.Fields { removeIn(f.Of(v.data), i, v.n) }
    v.n--
}

fn removeIn<F>(a mut Array<F>&, i I64, n I64) {
    a[i].vacate()
    for k in range i, n - 1 { a[k].occupy(a[k + 1].vacate()) }
}

# removes row i, the last row moving into its place - so the order is not kept
fn (v mut ColumnVec<T>&) SwapRemove(i I64) ? VecError.OutOfRange {
    if i < 0 or i >= v.n { error VecError.OutOfRange }
    v.n--
    for f in Columns<T>.Fields { swapRemoveIn(f.Of(v.data), i, v.n) }
}

fn swapRemoveIn<F>(a mut Array<F>&, i I64, last I64) {
    a[i].vacate()
    if i < last { a[i].occupy(a[last].vacate()) }
}

# rows i and j exchanged - failing with OutOfRange where either is no row
fn (v mut ColumnVec<T>&) Swap(i I64, j I64) ? VecError.OutOfRange {
    if i < 0 or i >= v.n or j < 0 or j >= v.n { error VecError.OutOfRange }
    v.data.Swap(i, j)
}

# puts x at row i, the rows from i on each moving up one place - Insert(Len(), x) is Push(x)
fn (v mut ColumnVec<T>&) Insert(i I64, x T) ? VecError.OutOfRange {
    if i < 0 or i > v.n { error VecError.OutOfRange }
    if v.n == v.data.Len() { v.room(v.n + 1) }
    for k, f in T.Fields { insertIn(Columns<T>.Fields[k].Of(v.data), i, v.n, f.Of(x)) }
    v.n++
}

fn insertIn<F>(a mut Array<F>&, i I64, n I64, x F) {
    k I64 = n
    for k > i {
        a[k].occupy(a[k - 1].vacate())
        k--
    }
    a[i].occupy(x)
}

# sorts the rows in place, every column moved together - stable, as Columns' Sort is
fn (v mut ColumnVec<T>&) Sort<? E>(less fn&(x T, y T) Bool ? E) ? E {
    order := Array<I64>[k for k in range v.n]
    try order.Sort(fn(a I64, b I64) Bool ? E: return less(v.data[a], v.data[b]))
    for f in Columns<T>.Fields { reorder(f.Of(v.data)[:v.n], order) }
}

# the rows, copied into a Columns of their own
fn (v ColumnVec<T>&) ToColumns() Columns<T> {
    out Columns<T>
    for f in Columns<T>.Fields { f.Of(out) = f.Of(v.data)[:v.n] }
    return out
}

# the rows, copied into one array in the caller's scope
fn (v ColumnVec<T>&) ToArray() Array<T> { return rowsOf(v.data, v.n) }

# the rows, copied into a Vec
fn (v ColumnVec<T>&) ToVec() Vec<T> {
    out := Vec<T>(v.n)
    for i in range v.n { out.Push(v.data[i]) }
    return out
}

# whether two hold equal rows in the same order - "==" (E10a), column by column
fn (v ColumnVec<T>&) Eq(o ColumnVec<T>&) Bool {
    if v.n != o.n { return false }
    for f in Columns<T>.Fields {
        if f.Of(v.data)[:v.n] != f.Of(o.data)[:o.n] { return false }
    }
    return true
}

# the rows' hash, from each column's - so equal ColumnVecs hash alike (E10b)
fn (v ColumnVec<T>&) Hash() I64 {
    h I64 = v.n
    for f in Columns<T>.Fields { h = h * 31 + f.Of(v.data)[:v.n].HashElements() }
    return h
}

# how "$" renders a ColumnVec (E11c): as its rows render, the type named in front - "ColumnVec<P>[P(1, 2)]"
fn (v ColumnVec<T>&) Str() String {
    r := $v.ToArray()                                    # "Array<T>[...]"
    return "ColumnVec" $r[5:]
}

# ---- rich display (B23) ----

# how a notebook shows a Columns: an HTML table, a column per field headed by its name and a row per row, numbered -
# the first 50 rows and the count of the rest. The prompt's text stays "$c"
fn (c Columns<T>&) Display() Display { return Display.Html(tableHtml(c, c.Len())) }

# ...and a ColumnVec, as its rows
fn (v ColumnVec<T>&) Display() Display { return Display.Html(tableHtml(v.data, v.n)) }

# the first n rows of c as an HTML table
fn tableHtml<T>(c Columns<T>&, n I64) String {
    b := StringBuilder()
    b.Push("<table><thead><tr><th></th>")
    for f in T.Fields { b.Push($"<th>" $htmlEscaped(f.Name) "</th>") }
    b.Push("</tr></thead><tbody>")
    shown I64 = n if n <= 50 else 50
    for i in range shown {
        row := c[i]
        b.Push($"<tr><th>" $i "</th>")
        for f in T.Fields { b.Push($"<td>" $htmlEscaped(cellText(f.Of(row))) "</td>") }
        b.Push("</tr>")
    }
    b.Push("</tbody></table>")
    if shown < n { b.Push($"<p>" $(n - shown) " more rows</p>") }
    b.Push($"<p>" $n " rows \u{00D7} " $T.Fields.Len() " columns</p>")
    return b.ToString()
}

# a cell's text: text as it is, any other value as "$" renders it
fn cellText<V>(x V) String {
    match V {
        case String { return x }
        case _ { return $x }
    }
}

# t with &, < and > written as HTML's entities
fn htmlEscaped(t String&) String {
    b := StringBuilder()
    for ch in t {
        if ch == '&' { b.Push("&amp;") } else if ch == '<' { b.Push("&lt;") } else if ch == '>' { b.Push("&gt;") } else { b.PushChar(ch) }
    }
    return b.ToString()
}

# the tests, and what only they use - under TestBuild, so a program that is not being tested compiles none of it: the
# prelude is part of every program

if TestBuild {
    type columnsPt struct(X F32, Y F32) { X, Y }

    # examples (B7a): what olang doc shows under the type
    test Columns "a column per field, a row per index" {
        c := Columns<columnsPt>(3, columnsPt(1.0, 2.0))
        c.X += c.Y                                      # lanes: one loop over two arrays
        c[0] = columnsPt(0.0, 0.0)
        assert c.X[1] == 3.0 and c[0] == columnsPt(0.0, 0.0) and c.Len() == 3
    }

    test ColumnVec.Push "adds a row at the end of every column" {
        v := ColumnVec<columnsPt>()
        v.Push(columnsPt(1.0, 2.0))
        v.Push(columnsPt(3.0, 4.0))
        assert v.Len() == 2 and v.Y[1] == 4.0 and v[0] == columnsPt(1.0, 2.0)
    }

    test ColumnVec.Display "shows the rows as an HTML table, a column per field" {
        v := ColumnVec<columnsPt>()
        v.Push(columnsPt(1.0, 2.5))
        d := v.Display()
        assert d.Mime() == "text/html"
        assert d.Body() == "<table><thead><tr><th></th><th>X</th><th>Y</th></tr></thead><tbody><tr><th>0</th><td>1</td><td>2.5</td></tr></tbody></table><p>1 rows \u{00D7} 2 columns</p>"
        assert htmlEscaped("a<b & c>") == "a&lt;b &amp; c&gt;"
    }
}
