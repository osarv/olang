# arrays, part of the prelude: what a function value lets every array do. Each takes a lambda (D16) - "keep"
# says which elements count, "less" orders two, "f" makes a new value of one - and none of them copies an
# element it does not have to.

# whether x is one of the elements - what "x in a" asks (E29). Compared with "==", so by the element type's Eq
# where it declares one (E10a): text is found by what it says, not by where it is stored.
fn (a Array<<T>>&) Has(x <T>) Bool {
    for y in a {
        if y == x { return true }
    }
    return false
}

# whether the two hold equal elements in the same order - what "==" on two array values is when an element type
# declares Eq (E10), which the compiler calls it for: each pair compared with "==", so by that Eq
fn (a Array<<T>>&) Equal(b Array<<T>>&) Bool {
    if a.Len() != b.Len() { return false }
    for i in range a.Len() {
        if a[i] != b[i] { return false }
    }
    return true
}

# the elements' hashes combined in order - the Hash the compiler supplies for an array value whose elements have one
# (E10b), agreeing with "==" element by element. No Hashable constraint: an element type's Hash may be its private
# hash, which the compiler judges where the array is hashed (M6b), not here
fn (a Array<<T>>&) HashElements() I64 {
    h I64 = 0
    for y in a { h = h * 1099511628211 + y.Hash() }
    return h
}

# whether sub occurs in it as a contiguous run - what "sub in a" asks when sub is of the array's own type (E29):
# a substring, for text. The empty run occurs in everything.
fn (a Array<<T>>&) Contains(sub Array<<T>>&) Bool {
    for i in range a.Len() - sub.Len() + 1 {
        j I64 = 0
        for j < sub.Len() and a[i + j] == sub[j] { j++ }
        if j == sub.Len() { return true }
    }
    return false
}

# true when keep holds for at least one element
fn (a Array<<T>>&) Any(keep fn(x <T>) Bool) Bool {
    for x in a {
        if keep(x) { return true }
    }
    return false
}

# true when keep holds for every element - so for none, of an empty array
fn (a Array<<T>>&) All(keep fn(x <T>) Bool) Bool {
    for x in a {
        if not keep(x) { return false }
    }
    return true
}

# the index of the first element keep holds for - failing with the default error when keep holds for none, so a miss
# is never read as a position: "try a.FindIndex(f) catch default -1" gives a fallback, "a.Any(f)" only asks
fn (a Array<<T>>&) FindIndex(keep fn(x <T>) Bool) I64 ? {
    for i, x in a {
        if keep(x) { return i }
    }
    error
}

# how many elements keep holds for
fn (a Array<<T>>&) Count(keep fn(x <T>) Bool) I64 {
    n I64 = 0
    for x in a {
        if keep(x) { n++ }
    }
    return n
}

# a new array of f applied to every element, in order. Made filled with the first result rather than with U's zero value,
# so a U without one (D13c) maps as any other
fn (a Array<<T>>&) Map(f fn(x <T>) <U>) Array<<U>> {
    if a.Len() == 0 {
        none Array<<U>>                    # an array's zero value is empty, whatever U is
        return none
    }
    out := Array<<U>>(a.Len(), f(a[0]))
    for i in range 1, a.Len() {
        out[i] = f(a[i])
    }
    return out
}

# a new array of the elements keep holds for, in order. keep runs once per element
fn (a Array<<T>>&) Filter(keep fn(x <T>) Bool) Array<<T>> {
    marks := Array<Bool>(a.Len())
    n I64 = 0
    for i, x in a {
        marks[i] = keep(x)
        if marks[i] { n++ }
    }
    if n == 0 {
        none Array<<T>>                    # an array's zero value is empty, whatever T is
        return none
    }
    out := Array<<T>>(n, a[0])            # filled with an element rather than T's zero value, which T may not have (D13c)
    j I64 = 0
    for i, x in a {
        if marks[i] {
            out[j] = x
            j++
        }
    }
    return out
}

# the elements combined, in order, from init: f(f(f(init, a[0]), a[1]), ...)
fn (a Array<<T>>&) Fold(init <U>, f fn(acc <U>, x <T>) <U>) <U> {
    acc <U> = init
    for x in a {
        acc = f(acc, x)
    }
    return acc
}

# how many times sub occurs in it as a contiguous run - counted from the start, occurrences not overlapping, so "aaaa"
# holds "aa" twice. The empty run occurs at every position, before each element and after the last: Len() + 1 times
fn (a Array<<T>>&) CountOf(sub Array<<T>>&) I64 {
    if sub.Len() == 0 { return a.Len() + 1 }
    n I64 = 0
    i I64 = 0
    for i <= a.Len() - sub.Len() {
        j I64 = 0
        for j < sub.Len() and a[i + j] == sub[j] { j++ }
        if j == sub.Len() {
            n++
            i += sub.Len()
        } else {
            i++
        }
    }
    return n
}

# a new array with every occurrence of the run old - counted from the start, not overlapping, as CountOf counts them -
# replaced by the run new: "a-b-c".Replace("-", ", ") is "a, b, c". The empty run occurs at every position, so an empty
# old puts new before each element and after the last. Built at its exact length, once
fn (a Array<<T>>&) Replace(old Array<<T>>&, new Array<<T>>&) Array<<T>> {
    n := a.CountOf(old)
    out := Array<<T>>(a.Len() + n * (new.Len() - old.Len()))
    w I64 = 0
    i I64 = 0
    for i <= a.Len() {
        j I64 = 0
        for j < old.Len() and i + j < a.Len() and a[i + j] == old[j] { j++ }
        if j == old.Len() {
            for x in new {
                out[w] = x
                w++
            }
            if old.Len() > 0 {
                i += old.Len()
                continue
            }
        }
        if i == a.Len() { break }
        out[w] = a[i]
        w++
        i++
    }
    return out
}

# a new array of n copies of the elements, one after another - empty for n of 0 or below: "ab".Repeat(3) is "ababab"
fn (a Array<<T>>&) Repeat(n I64) Array<<T>> {
    k I64 = n if n > 0 else 0
    out := Array<<T>>(a.Len() * k)
    for r in range k {
        for i, x in a { out[r * a.Len() + i] = x }
    }
    return out
}

# the elements in the opposite order, in place
fn (a mut Array<<T>>&) Reverse() {
    i I64 = 0
    j I64 = a.Len() - 1
    for i < j {
        t := a[i]
        a[i] = a[j]
        a[j] = t
        i++
        j--
    }
}

# a new List - in the caller's scope - holding the elements, in order: "I32[3, 1, 2].ToList()", or n copies of one value,
# "Array<I32>(n, v).ToList()". The reverse of List's ToArray
fn (a Array<<T>>&) ToList() List<<T>>& {
    out List<<T>>&return = List<<T>>()
    out.PushAll(a)
    return out
}

# sorts the array in place so that less(a[i], a[i - 1]) holds nowhere - stable, so elements less does not
# order keep their order. It allocates nothing - elements only ever swap places, so it sorts an array of
# references exactly as it sorts numbers: insertion-sorted blocks, merged by rotation (Go's sort.Stable)
fn (a mut Array<<T>>&) Sort(less fn(x <T>, y <T>) Bool) {
    n I64 = a.Len()
    block I64 = 20
    lo I64 = 0
    for lo < n {
        hi I64 = lo + block
        if hi > n { hi = n }
        sortInsertion(a, lo, hi, less)
        lo = hi
    }
    for block < n {
        lo = 0
        for lo + block < n {
            hi I64 = lo + 2 * block
            if hi > n { hi = n }
            sortMerge(a, lo, lo + block, hi, less)
            lo = hi
        }
        block = block * 2
    }
}

fn sortSwap(a mut Array<<T>>&, i I64, j I64) {
    t := a[i]
    a[i] = a[j]
    a[j] = t
}

fn sortInsertion(a mut Array<<T>>&, lo I64, hi I64, less fn(x <T>, y <T>) Bool) {
    for i in range lo + 1, hi {
        j I64 = i
        for j > lo and less(a[j], a[j - 1]) {
            sortSwap(a, j, j - 1)
            j--
        }
    }
}

# merges the sorted runs a[lo:m] and a[m:hi] in place (SymMerge)
fn sortMerge(a mut Array<<T>>&, lo I64, m I64, hi I64, less fn(x <T>, y <T>) Bool) {
    if m - lo == 1 {
        i I64 = m
        j I64 = hi
        for i < j {
            h I64 = (i + j) / 2
            if less(a[h], a[lo]) { i = h + 1 } else { j = h }
        }
        for k in range lo, i - 1 { sortSwap(a, k, k + 1) }
        return
    }
    if hi - m == 1 {
        i I64 = lo
        j I64 = m
        for i < j {
            h I64 = (i + j) / 2
            if not less(a[m], a[h]) { i = h + 1 } else { j = h }
        }
        k I64 = m
        for k > i {
            sortSwap(a, k, k - 1)
            k--
        }
        return
    }
    mid I64 = (lo + hi) / 2
    n I64 = mid + m
    start I64 = lo
    r I64 = m
    if m > mid {
        start = n - hi
        r = mid
    }
    p I64 = n - 1
    for start < r {
        c I64 = (start + r) / 2
        if not less(a[p - c], a[c]) { start = c + 1 } else { r = c }
    }
    end I64 = n - start
    if start < m and m < end { sortRotate(a, start, m, end) }
    if lo < start and start < mid { sortMerge(a, lo, start, mid, less) }
    if mid < end and end < hi { sortMerge(a, mid, end, hi, less) }
}

# swaps the runs a[lo:m] and a[m:hi]
fn sortRotate(a mut Array<<T>>&, lo I64, m I64, hi I64) {
    i I64 = m - lo
    j I64 = hi - m
    for i != j {
        if i > j {
            for k in range j { sortSwap(a, m - i + k, m + k) }
            i = i - j
        } else {
            for k in range i { sortSwap(a, m - i + k, m + j - i + k) }
            j = j - i
        }
    }
    for k in range i { sortSwap(a, m - i + k, m + k) }
}

# a position in an array - what lets generic code written over Iterator<T> take an array too ("total(a.Iter())"),
# as it takes a List or a Map. "for x in a" does not go through it: an array is walked directly.
type ArrayIter<T> struct(of Array<<T>>&) {
    arr Array<<T>>&of = of
    i mut I64 = 0
}

fn (it mut ArrayIter<<T>>&) Next() <T> ? Exhausted {
    if it.i >= it.arr.Len() { error Exhausted.END }
    it.i++
    return it.arr[it.i - 1]
}

# a fresh position at the array's start - each call its own, so loops never disturb each other
fn (a Array<<T>>&) Iter() ArrayIter<<T>> { return ArrayIter<<T>>(a) }

# the tests, and what only they use - under TestBuild, so a program that is not being tested compiles none of it: the
# prelude is part of every program

if TestBuild {
    fn arraySorted() Array<I32> {
        a := I32[30, 10, 50, 20, 40]
        a.Sort(fn(x, y) { return x < y })
        return a.Filter(fn(x) { return x > 10 })
    }
    arraySortedBaked := arraySorted()                     # computed while compiling (K2): calls through lambdas
    arraySumBaked I32 = arraySorted().Fold(0, fn(acc, x) { return acc + x })

    test "the array methods take what to do as a lambda" {
        a := I32[5, 3, 8, 1, 9, 2]
        assert a.Any(fn(x) { return x > 8 }) and not a.Any(fn(x) { return x > 9 })
        assert a.All(fn(x) { return x > 0 }) and not a.All(fn(x) { return x > 1 })
        assert (try a.FindIndex(fn(x) { return x == 8 }) catch default -1) == 2
        assert (try a.FindIndex(fn(x) { return x == 7 }) catch default -1) == -1
        assert a.Count(fn(x) { return x % 2 == 1 }) == 4
        doubled := a.Map(fn(x) { return I64(x) * 2 })
        assert doubled[4] == 18
        small := a.Filter(fn(x) { return x < 5 })
        assert small.Len() == 3 and small[0] == 3 and small[2] == 2
        assert a.Fold(0, fn(acc, x) { return acc + x }) == 28
        a.Sort(fn(x, y) { return x < y })
        assert a[0] == 1 and a[5] == 9 and a[2] == 3
        a.Sort(fn(x, y) { return x > y })
        assert a[0] == 9 and a[5] == 1
        assert arraySortedBaked.Len() == 4 and arraySortedBaked[0] == 20 and arraySortedBaked[3] == 50 and arraySumBaked == 140
    }

    test "Sort is stable, and sorts long arrays and arrays of references" {
        big := Array<I32>(1000)
        for i in range 1000 { big[i] = I32((i * 7919) % 1000) }
        big.Sort(fn(x, y) { return x < y })
        assert big.All(fn(x) { return x >= 0 }) and big[0] == 0 and big[999] == 999
        ok Bool = true
        for i in range 1, 1000 {
            if big[i - 1] > big[i] { ok = false }
        }
        assert ok
        # stability: sort pairs by their key only, and equal keys keep the order they came in
        keys := Array<I32>(300)
        for i in range 300 { keys[i] = I32(i) }
        keys.Sort(fn(x, y) { return x % 3 < y % 3 })
        assert keys[0] == 0 and keys[1] == 3 and keys[99] == 297 and keys[100] == 1 and keys[299] == 299
        words := "pear fig apple kiwi banana".Split(" ")
        words.Sort(fn(x, y) { return x.Len() < y.Len() })
        assert words[0].Eq("fig") and words[1].Eq("pear") and words[2].Eq("kiwi") and words[4].Eq("banana")
    }

}
