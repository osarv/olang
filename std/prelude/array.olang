# arrays, part of the prelude: what a function value lets every array do. Each takes a lambda (D16) - "keep"
# says which elements count, "less" orders two, "f" makes a new value of one - and none of them copies an
# element it does not have to.

# whether x is one of the elements - what "x in a" asks (E29). Compared with "==", so by the element type's Eq
# where it declares one (E10a): text is found by what it says, not by where it is stored.
fn (a Array<T>&) Has(x T) Bool {
    for y in a {
        if y == x { return true }
    }
    return false
}

# whether the two hold equal elements in the same order - what "==" on two arrays, values or references, is when an
# element type declares Eq (E10), which the compiler calls it for: each pair compared with "==", so by that Eq
fn (a Array<T>&) Equal(b Array<T>&) Bool {
    if a.Len() != b.Len() { return false }
    for i in range a.Len() {
        if a[i] != b[i] { return false }
    }
    return true
}

# the elements' hashes combined in order - the Hash the compiler supplies for an array value whose elements have one
# (E10b), agreeing with "==" element by element. No Hashable constraint: an element type's Hash may be its private
# hash, which the compiler judges where the array is hashed (M6b), not here
fn (a Array<T>&) HashElements() I64 {
    h I64 = 0
    for y in a { h = h * 1099511628211 + y.Hash() }
    return h
}

# whether sub occurs in it as a contiguous run - what "sub in a" asks when sub is of the array's own type (E29):
# a substring, for text. The empty run occurs in everything.
fn (a Array<T>&) Contains(sub Array<T>&) Bool {
    for i in range a.Len() - sub.Len() + 1 {
        j I64 = 0
        for j < sub.Len() and a[i + j] == sub[j] { j++ }
        if j == sub.Len() { return true }
    }
    return false
}

# The helpers taking a callback fail with what it fails with (E, QAH): with nothing, for one that cannot, and then they
# are called with no try. One that fails stops at that element and passes the error on.

# true when keep holds for at least one element
fn (a Array<T>&) Some<? E>(keep fn(x T) Bool ? E) Bool ? E {
    for x in a {
        if try keep(x) { return true }
    }
    return false
}

# true when keep holds for every element - so for none, of an empty array
fn (a Array<T>&) Every<? E>(keep fn(x T) Bool ? E) Bool ? E {
    for x in a {
        if not try keep(x) { return false }
    }
    return true
}

# what an array's FindIndex fails with: no element keep holds for (NotFound); a ChunkSize below one (BadChunk); an
# index or a slice outside the array, a.Get(i) and a.SliceOf(lo, hi), which the compiler supplies (E16c, E16d); and a
# total that needs an element - a.Min(), a.Max() - of an array with none (Empty, E39)
type ArrayError error {
    NotFound
    BadChunk
    OutOfRange
    Empty
}

# the index of the first element keep holds for - failing with NotFound when keep holds for none, so a miss is never
# read as a position: "try a.FindIndex(f) catch default -1" gives a fallback, "a.Some(f)" only asks
fn (a Array<T>&) FindIndex<? E>(keep fn(x T) Bool ? E) I64 ? ArrayError, E {
    for i, x in a {
        if try keep(x) { return i }
    }
    error ArrayError.NotFound
}

# how many elements keep holds for
fn (a Array<T>&) Count<? E>(keep fn(x T) Bool ? E) I64 ? E {
    n I64 = 0
    for x in a {
        if try keep(x) { n++ }
    }
    return n
}

# a new array of f applied to every element, in order. Made filled with the first result rather than with U's zero value,
# so a U without one (D13c) maps as any other
fn (a Array<T>&) Map<U ? E>(f fn(x T) U ? E) Array<U> ? E {
    if a.Len() == 0 { return Array<U>(0) }           # no element, so no zero value of U is needed (D13c)
    out := Array<U>(a.Len(), try f(a[0]))
    for i in range 1, a.Len() {
        out[i] = try f(a[i])
    }
    return out
}

# a new array of the elements keep holds for, in order. keep runs once per element
fn (a Array<T>&) Filter<? E>(keep fn(x T) Bool ? E) Array<T> ? E {
    marks := Array<Bool>(a.Len())
    n I64 = 0
    for i, x in a {
        marks[i] = try keep(x)
        if marks[i] { n++ }
    }
    if n == 0 { return Array<T>(0) }                 # no element, so no zero value of T is needed (D13c)
    out := Array<T>(n, a[0])              # filled with an element rather than T's zero value, which T may not have (D13c)
    j I64 = 0
    for i, x in a {
        if marks[i] {
            out[j] = x
            j++
        }
    }
    return out
}

# the elements combined, in order, from init: f(f(f(init, a[0]), a[1]), ...)
fn (a Array<T>&) Fold<U ? E>(init U, f fn(acc U, x T) U ? E) U ? E {
    acc U = init
    for x in a {
        acc = try f(acc, x)
    }
    return acc
}

# how many times sub occurs in it as a contiguous run - counted from the start, occurrences not overlapping, so "aaaa"
# holds "aa" twice. The empty run occurs at every position, before each element and after the last: Len() + 1 times
fn (a Array<T>&) CountOf(sub Array<T>&) I64 {
    if sub.Len() == 0 { return a.Len() + 1 }
    n I64 = 0
    i I64 = 0
    for i <= a.Len() - sub.Len() {
        j I64 = 0
        for j < sub.Len() and a[i + j] == sub[j] { j++ }
        if j == sub.Len() {
            n++
            i += sub.Len()
        } else {
            i++
        }
    }
    return n
}

# a new array with every occurrence of the run old - counted from the start, not overlapping, as CountOf counts them -
# replaced by the run new: "a-b-c".Replace("-", ", ") is "a, b, c". The empty run occurs at every position, so an empty
# old puts new before each element and after the last. Built at its exact length, once
fn (a Array<T>&) Replace(old Array<T>&, new Array<T>&) Array<T> {
    n := a.CountOf(old)
    out := Array<T>(a.Len() + n * (new.Len() - old.Len()))
    w I64 = 0
    i I64 = 0
    for i <= a.Len() {
        j I64 = 0
        for j < old.Len() and i + j < a.Len() and a[i + j] == old[j] { j++ }
        if j == old.Len() {
            for x in new {
                out[w] = x
                w++
            }
            if old.Len() > 0 {
                i += old.Len()
                continue
            }
        }
        if i == a.Len() { break }
        out[w] = a[i]
        w++
        i++
    }
    return out
}

# a new array of n copies of the elements, one after another - empty for n of 0 or below: "ab".Repeat(3) is "ababab"
fn (a Array<T>&) Repeat(n I64) Array<T> {
    k I64 = n if n > 0 else 0
    out := Array<T>(a.Len() * k)
    for r in range k {
        for i, x in a { out[r * a.Len() + i] = x }
    }
    return out
}

# the elements in the opposite order, in place
fn (a mut Array<T>&) Reverse() {
    i I64 = 0
    j I64 = a.Len() - 1
    for i < j {
        t := a[i]
        a[i] = a[j]
        a[j] = t
        i++
        j--
    }
}

# a new Vec - in the caller's scope - holding the elements, in order: "I32[3, 1, 2].ToVec()", or n copies of one value,
# "Array<I32>(n, v).ToVec()". The reverse of Vec's ToArray
fn (a Array<T>&) ToVec() Vec<T>& {
    out mut Vec<T>&return = Vec<T>()
    out.PushAll(a)
    return out
}

# sorts the array in place so that less(a[i], a[i - 1]) holds nowhere - stable, so elements less does not order keep
# their order. A merge sort, O(n log n): runs of 24 (sortRun) insertion-sorted, then merged pairwise, each merge copying
# the shorter of its two runs into a scratch array and merging it back - so it allocates n / 2 elements, in its own
# scope, reclaimed as it returns.
# That scratch holds elements only where they hold no references - a number, a Bool or a Char - since an element
# holding references, copied into storage of the call's own, would have them live in the call's scope (G11) and could
# not be stored back into the array's. Any other element type is sorted in blocks of 12,288 (sortBlock) through
# positions - the merge sort orders the block's positions, I64s compared by the elements they name, and the elements are
# then moved where it puts them, one cycle of the permutation at a time, while the block is in the cache - and the
# blocks are merged in place by rotation (SymMerge, Go's sort.Stable), so it allocates only a block's positions and
# costs O(n log n log(n / 12288)): a few times the plain merge on a million elements
fn (a mut Array<T>&) Sort<? E>(less fn(x T, y T) Bool ? E) ? E {
    if a.Len() < 2 { return }
    match T {
        case I8, I16, I32, I64, U8, U16, U32, U64, F16, BF16, F32, F64, Bool, Char { try sortMergeBuffered(a, less) }
        case _ { try sortByPositions(a, less) }
    }
}

# Sort for elements a scratch array cannot hold
fn sortByPositions<T ? E>(a mut Array<T>&, less fn(x T, y T) Bool ? E) ? E {
    n I64 = a.Len()
    if n <= sortRun {                        # one run: insertion-sorted where it is, nothing allocated
        try sortInsertion(a, 0, n, less)
        return
    }
    pos := Array<I64>(sortBlock if n > sortBlock else n)
    lo I64 = 0
    for lo < n {
        hi I64 = lo + sortBlock
        if hi > n { hi = n }
        p := pos[:hi - lo]
        for k in range hi - lo { p[k] = lo + k }
        try sortMergeBuffered(p, fn(i I64, j I64) Bool { return try less(a[i], a[j]) })
        sortPermute(a, lo, p)
        lo = hi
    }
    block I64 = sortBlock
    for block < n {
        lo = 0
        for lo + block < n {
            hi I64 = lo + 2 * block
            if hi > n { hi = n }
            try sortMerge(a, lo, lo + block, hi, less)
            lo = hi
        }
        block = block * 2
    }
}

# the merge sort itself, over elements a scratch array of the call's own may hold (Sort)
fn sortMergeBuffered<T ? E>(a mut Array<T>&, less fn(x T, y T) Bool ? E) ? E {
    n I64 = a.Len()
    run I64 = sortRun
    lo I64 = 0
    for lo < n {
        hi I64 = lo + run
        if hi > n { hi = n }
        try sortInsertion(a, lo, hi, less)
        lo = hi
    }
    if n <= run { return }
    scratch := Array<T>((n + 1) / 2, a[0])     # filled with an element, which needs no zero value of T (D13c)
    lo = 0                                   # each block's merges first, while it is in the cache, then the blocks'
    for lo < n {
        hi I64 = lo + sortBlock
        if hi > n { hi = n }
        try sortMergeRuns(a, scratch, lo, hi, run, less)
        lo = hi
    }
    try sortMergeRuns(a, scratch, 0, n, sortBlock, less)
}

# merges the sorted runs of a[from:to], each "run" long but the last, pairwise into runs twice as long until one is left
fn sortMergeRuns<T ? E>(a mut Array<T>&, scratch mut Array<T>&, from I64, to I64, run I64, less fn(x T, y T) Bool ? E) ? E {
    for run < to - from {
        lo I64 = from
        for lo + run < to {
            m I64 = lo + run
            hi I64 = m + run
            if hi > to { hi = to }
            if try less(a[m], a[m - 1]) {        # already in order when the right run's first is not less than the left's last
                if m - lo <= hi - m {
                    try sortMergeForward(a, scratch, lo, m, hi, less)
                } else {
                    try sortMergeBackward(a, scratch, lo, m, hi, less)
                }
            }
            lo = hi
        }
        run = run * 2
    }
}

# merges the sorted runs a[lo:m] and a[m:hi], the left one the shorter: it is copied into scratch and merged back from
# the front, the right run's element taken only when strictly less - so equal ones keep their order
fn sortMergeForward<T ? E>(a mut Array<T>&, scratch mut Array<T>&, lo I64, m I64, hi I64, less fn(x T, y T) Bool ? E) ? E {
    nl I64 = m - lo
    for k in range nl { scratch[k] = a[lo + k] }
    i I64 = 0
    j I64 = m
    k I64 = lo
    for i < nl and j < hi {
        if try less(a[j], scratch[i]) {
            a[k] = a[j]
            j++
        } else {
            a[k] = scratch[i]
            i++
        }
        k++
    }
    for i < nl {                             # what is left of the right run is in place already
        a[k] = scratch[i]
        i++
        k++
    }
}

# the same with the right run the shorter: it is copied into scratch and merged back from the end, the left run's
# element taken only when the right one is strictly less than it
fn sortMergeBackward<T ? E>(a mut Array<T>&, scratch mut Array<T>&, lo I64, m I64, hi I64, less fn(x T, y T) Bool ? E) ? E {
    nr I64 = hi - m
    for k in range nr { scratch[k] = a[m + k] }
    i I64 = m - 1
    j I64 = nr - 1
    k I64 = hi - 1
    for i >= lo and j >= 0 {
        if try less(scratch[j], a[i]) {
            a[k] = a[i]
            i--
        } else {
            a[k] = scratch[j]
            j--
        }
        k--
    }
    for j >= 0 {                             # what is left of the left run is in place already
        a[k] = scratch[j]
        j--
        k--
    }
}

# the length of the runs Sort insertion-sorts before it merges, and of the blocks whose runs it merges before merging
# the blocks - sortRun times a power of two, so the runs tile each block
sortRun I64 = 24
sortBlock I64 = sortRun << 9

# sorts a[lo:hi] by insertion: each element shifted down past those it is less than
fn sortInsertion<T ? E>(a mut Array<T>&, lo I64, hi I64, less fn(x T, y T) Bool ? E) ? E {
    for i in range lo + 1, hi {
        x := a[i]
        j I64 = i
        for j > lo and try less(x, a[j - 1]) {
            a[j] = a[j - 1]
            j--
        }
        a[j] = x
    }
}

# moves each element of a[lo:lo + pos.Len()] to the place pos gives it - after it, a[lo + k] is what a[pos[k]] was -
# following each cycle of the permutation from its start, so every element is moved once and one is held aside per
# cycle. pos is used up
fn sortPermute<T>(a mut Array<T>&, lo I64, pos mut Array<I64>&) {
    for start in range pos.Len() {
        if pos[start] == lo + start { continue }
        held := a[lo + start]
        j I64 = start
        for {
            from := pos[j]
            pos[j] = lo + j
            if from == lo + start {
                a[lo + j] = held
                break
            }
            a[lo + j] = a[from]
            j = from - lo
        }
    }
}

fn sortSwap<T>(a mut Array<T>&, i I64, j I64) {
    t := a[i]
    a[i] = a[j]
    a[j] = t
}

# merges the sorted runs a[lo:m] and a[m:hi] in place (SymMerge)
fn sortMerge<T ? E>(a mut Array<T>&, lo I64, m I64, hi I64, less fn(x T, y T) Bool ? E) ? E {
    if m - lo == 1 {
        i I64 = m
        j I64 = hi
        for i < j {
            h I64 = (i + j) / 2
            if try less(a[h], a[lo]) { i = h + 1 } else { j = h }
        }
        for k in range lo, i - 1 { sortSwap(a, k, k + 1) }
        return
    }
    if hi - m == 1 {
        i I64 = lo
        j I64 = m
        for i < j {
            h I64 = (i + j) / 2
            if not try less(a[m], a[h]) { i = h + 1 } else { j = h }
        }
        k I64 = m
        for k > i {
            sortSwap(a, k, k - 1)
            k--
        }
        return
    }
    mid I64 = (lo + hi) / 2
    n I64 = mid + m
    start I64 = lo
    r I64 = m
    if m > mid {
        start = n - hi
        r = mid
    }
    p I64 = n - 1
    for start < r {
        c I64 = (start + r) / 2
        if not try less(a[p - c], a[c]) { start = c + 1 } else { r = c }
    }
    end I64 = n - start
    if start < m and m < end { sortRotate(a, start, m, end) }
    if lo < start and start < mid { try sortMerge(a, lo, start, mid, less) }
    if mid < end and end < hi { try sortMerge(a, mid, end, hi, less) }
}

# swaps the runs a[lo:m] and a[m:hi]
fn sortRotate<T>(a mut Array<T>&, lo I64, m I64, hi I64) {
    i I64 = m - lo
    j I64 = hi - m
    for i != j {
        if i > j {
            for k in range j { sortSwap(a, m - i + k, m + k) }
            i = i - j
        } else {
            for k in range i { sortSwap(a, m - i + k, m + j - i + k) }
            j = j - i
        }
    }
    for k in range i { sortSwap(a, m - i + k, m + k) }
}

# a position in an array - what lets generic code written over Iterator<T> take an array too ("total(a.Iter())"),
# as it takes a Vec or a Map. "for x in a" does not go through it: an array is walked directly.
type ArrayIter<T> struct(of Array<T>&) {
    arr Array<T>&of = of
    i I64 = 0
}

fn (it mut ArrayIter<T>&) Next() T ? Exhausted {
    if it.i >= it.arr.Len() { error Exhausted.End }
    it.i++
    return it.arr[it.i - 1]
}

# the elements it has still to give, as a view of the array
fn (it ArrayIter<T>&) Rest() Array<T>&it { return it.arr[it.i:] }

# moves past at most n of the elements it has still to give, as that many Nexts would: how many it passed (fewer only
# where the array ends first; none for an n below one)
fn (it mut ArrayIter<T>&) Advance(n I64) I64 {
    k := it.arr.Len() - it.i
    if n < k: k = n
    if k <= 0: return 0
    it.i += k
    return k
}

# a fresh position at the array's start - each call its own, so loops never disturb each other
fn (a Array<T>&) Iter() ArrayIter<T> { return ArrayIter<T>(a) }

# how many elements a piece Chunks hands out holds: at least one. A literal is checked while compiling ("a.Chunks(4)",
# and 0 is a compile-time error, T29d); a size computed while the program runs is made one with ChunkSize(n), which
# fails with ArrayError.BadChunk below one - the one way a size is refused
type ChunkSize I64(v I64) ? ArrayError.BadChunk {
    if v < 1 { error ArrayError.BadChunk }
}

# the array cut into consecutive pieces of size elements each, the last holding what is left (fewer, never none): each
# piece a writable view of the array's own storage (a slice, E16a), nothing copied, and no two sharing an element - so
# "join { for part in a.Chunks(4) { spawn work(part) } }" hands every task a part of its own to write and cannot race on
# the array. An empty array has no pieces. The pieces are held in an array that lives where the array does, as Split's
# (so a piece outlives nothing it views), allocated once at its exact length
fn (a mut Array<T>&) Chunks(size ChunkSize) mut Array<mut Array<T>&>&a {
    n := I64(size)
    pieces mut Array<mut Array<T>&>&a = Array<mut Array<T>&>((a.Len() + n - 1) / n, a)   # each piece written below
    for k in range pieces.Len() {
        start I64 = k * n
        end I64 = start + n if a.Len() - start > n else a.Len()
        pieces[k] = a[start:end]
    }
    return pieces
}

# a position in an array walked from its last element to its first - what an array's Reversed gives
type ReversedIter<T> struct(of Array<T>&) {
    arr Array<T>&of = of
    i I64 = of.Len()
}

fn (it mut ReversedIter<T>&) Next() T ? Exhausted {
    if it.i <= 0 { error Exhausted.End }
    it.i--
    return it.arr[it.i]
}

# the elements from the last to the first: "for x in a.Reversed() { ... }" - a walk, building nothing, as fast as the
# counted loop down the positions (a String's too: "for c in t.Reversed()" walks its bytes backward)
fn (a Array<T>&) Reversed() ReversedIter<T> { return ReversedIter<T>(a) }

# every run of size consecutive elements, overlapping, from the first: a.Len() - size + 1 of them (none where the array
# is shorter than size), each a read-only view of the array's own storage (a slice, E16a), nothing copied - "for w in
# a.Windows(3) { smooth.Push(w.Sum() / 3.0) }". The views are held in an array that lives where the array does, as
# Chunks' and Split's, allocated once at its exact length
fn (a Array<T>&) Windows(size ChunkSize) Array<Array<T>&>&a {
    n := I64(size)
    count := a.Len() - n + 1 if a.Len() >= n else 0
    views mut Array<Array<T>&>&a = Array<Array<T>&>(count, a)   # each view written below
    for k in range count { views[k] = a[k:k + n] }
    return views
}

# the leading elements keep holds for: a read-only view of them, up to the first it does not hold for (the whole array
# where it holds for all) - nothing copied, keep not called past that first
fn (a Array<T>&) TakeWhile<? E>(keep fn(x T) Bool ? E) Array<T>&a ? E {
    for i in range a.Len() {
        if not try keep(a[i]) { return a[:i] }
    }
    return a[:]
}

# the elements from the first keep does not hold for on: a read-only view (empty where keep holds for all)
fn (a Array<T>&) SkipWhile<? E>(keep fn(x T) Bool ? E) Array<T>&a ? E {
    for i in range a.Len() {
        if not try keep(a[i]) { return a[i:] }
    }
    return a[a.Len():]
}

# the elements split by keep: two new arrays, of those keep holds for and of the rest, each in the array's order
fn (a Array<T>&) Partition<? E>(keep fn(x T) Bool ? E) Array<T>, Array<T> ? E {
    if a.Len() == 0 { return Array<T>(0), Array<T>(0) }   # no element, so no zero value of T is needed (D13c)
    marks := Array<Bool>(a.Len())
    n I64 = 0
    for i, x in a {
        marks[i] = try keep(x)
        if marks[i] { n++ }
    }
    yes := Array<T>(n, a[0])                    # filled with an element, as Filter's
    no := Array<T>(a.Len() - n, a[0])
    j I64 = 0
    k I64 = 0
    for i, x in a {
        if marks[i] {
            yes[j] = x
            j++
        } else {
            no[k] = x
            k++
        }
    }
    return yes, no
}

# the first position whose element is not below x ("<"), in an array sorted by "<": where x would go to keep it sorted,
# Len() where every element is below x - a binary search, log2 n reads (text by its bytes, as "<" orders it)
fn (a Array<T>&) LowerBound(x T) I64 {
    lo I64 = 0
    hi := a.Len()
    for lo < hi {
        mid := lo + (hi - lo) / 2
        if a[mid] < x { lo = mid + 1 } else { hi = mid }
    }
    return lo
}

# the first position whose element is equal to x ("==", E10), in an array sorted by "<" - a binary search, failing with
# ArrayError.NotFound where there is none
fn (a Array<T>&) BinarySearch(x T) I64 ? ArrayError.NotFound {
    i := a.LowerBound(x)
    if i < a.Len() and a[i] == x: return i
    error ArrayError.NotFound
}

# a position in an array walked from its first element to its last and round again, without end - what Cycle gives
type CycleIter<T> struct(of Array<T>&) {
    arr Array<T>&of = of
    i I64 = 0
}

fn (it mut CycleIter<T>&) Next() T ? Exhausted {
    if it.arr.Len() == 0: error Exhausted.End
    if it.i >= it.arr.Len(): it.i = 0
    it.i++
    return it.arr[it.i - 1]
}

# the elements over and over, without end - "for x in a.Cycle().Take(10)"; an empty array gives nothing. A walk,
# building nothing
fn (a Array<T>&) Cycle() CycleIter<T> { return CycleIter<T>(a) }

# the array cut into runs of consecutive elements same holds for, called on each element and the one before it: each run
# a read-only view of the array's own storage (a slice, E16a), nothing copied - "a.ChunkBy(fn(x, y): return x == y)"
# gives the runs of equal elements. The views are held in an array that lives where the array does, as Windows' and
# Chunks', allocated once at its exact length; same is called once per neighbouring pair
fn (a Array<T>&) ChunkBy<? E>(same fn(x T, y T) Bool ? E) Array<Array<T>&>&a ? E {
    if a.Len() == 0: return Array<Array<T>&>(0, a)
    cuts := Array<Bool>(a.Len())            # cuts[i]: a run begins at i
    n I64 = 1
    for i in range 1, a.Len() {
        cuts[i] = not try same(a[i - 1], a[i])
        if cuts[i]: n++
    }
    runs mut Array<Array<T>&>&a = Array<Array<T>&>(n, a)   # each run written below
    k I64 = 0
    from I64 = 0
    for i in range 1, a.Len() {
        if not cuts[i]: continue
        runs[k] = a[from:i]
        k++
        from = i
    }
    runs[k] = a[from:]
    return runs
}

# the tests, and what only they use - under TestBuild, so a program that is not being tested compiles none of it: the
# prelude is part of every program

if TestBuild {
    fn arraySorted() Array<I32> {
        a := I32[30, 10, 50, 20, 40]
        a.Sort(fn(x, y) { return x < y })
        return a.Filter(fn(x) { return x > 10 })
    }
    arraySortedBaked := arraySorted()                     # computed while compiling (K2): calls through lambdas
    arraySumBaked I64 = arraySorted().Fold(0, fn(acc, x) { return acc + x })

    # examples (B7a): what olang doc shows under Array.Reversed
    test Array.Reversed "an array from its last element to its first" {
        s := 0
        for x in I64[1, 2, 3].Reversed() { s = s * 10 + x }
        assert s == 321 and I64[].Reversed().ToVec().Len() == 0
    }
    test Array.BinarySearch "the position of an element of a sorted array, the first of equal ones" {
        a := I64[1, 3, 3, 5, 8]
        assert (try a.BinarySearch(3) catch default -1) == 1 and (try a.BinarySearch(8) catch default -1) == 4
        assert (try a.BinarySearch(4) catch ArrayError.NotFound default -1) == -1
        assert (try I64[].BinarySearch(4) catch default -1) == -1 and (try "abcz".BinarySearch('c') catch default -1) == 2
    }
    test Array.LowerBound "where an element would go to keep a sorted array sorted" {
        a := I64[1, 3, 3, 5, 8]
        assert a.LowerBound(3) == 1 and a.LowerBound(4) == 3 and a.LowerBound(0) == 0 and a.LowerBound(9) == 5
    }
    test Array.Cycle "the elements over and over" {
        assert I64[1, 2, 3].Cycle().Take(7).ToVec().ToArray() == I64[1, 2, 3, 1, 2, 3, 1]
        assert I64[].Cycle().Take(3).ToVec().Len() == 0
    }
    test Array.ChunkBy "the runs a test holds for between neighbours, as views" {
        r := I64[1, 2, 3, 7, 8, 4].ChunkBy(fn(x, y): return y == x + 1)
        assert r.Len() == 3 and r[0] == I64[1, 2, 3] and r[1] == I64[7, 8] and r[2] == I64[4]
        assert I64[].ChunkBy(fn(x, y): return x == y).Len() == 0
        w := "aabccc".ChunkBy(fn(x, y): return x == y)
        assert w.Len() == 3 and w[2] == "ccc"
    }
    test Array.Windows "every run of so many consecutive elements, as views" {
        w := I64[1, 2, 3].Windows(2)
        assert w.Len() == 2 and w[0] == I64[1, 2] and w[1] == I64[2, 3]
    }
    test Array.Reversed "text from its last byte to its first" {
        b := StringBuilder()
        for c in "abc".Reversed() { b.PushChar(c) }
        assert b.ToString() == "cba"
    }

    test "the array methods take what to do as a lambda" {
        a := I32[5, 3, 8, 1, 9, 2]
        assert a.Some(fn(x) { return x > 8 }) and not a.Some(fn(x) { return x > 9 })
        assert a.Every(fn(x) { return x > 0 }) and not a.Every(fn(x) { return x > 1 })
        assert (try a.FindIndex(fn(x) { return x == 8 }) catch default -1) == 2
        assert (try a.FindIndex(fn(x) { return x == 7 }) catch default -1) == -1
        assert a.Count(fn(x) { return x % 2 == 1 }) == 4
        doubled := a.Map(fn(x) { return I64(x) * 2 })
        assert doubled[4] == 18
        small := a.Filter(fn(x) { return x < 5 })
        assert small.Len() == 3 and small[0] == 3 and small[2] == 2
        assert a.Fold(0, fn(acc, x) { return acc + x }) == 28
        a.Sort(fn(x, y) { return x < y })
        assert a[0] == 1 and a[5] == 9 and a[2] == 3
        a.Sort(fn(x, y) { return x > y })
        assert a[0] == 9 and a[5] == 1
        assert arraySortedBaked.Len() == 4 and arraySortedBaked[0] == 20 and arraySortedBaked[3] == 50 and arraySumBaked == 140
    }

    test "Sort is stable, and sorts long arrays and arrays of references" {
        big := Array<I32>(1000)
        for i in range 1000 { big[i] = I32((i * 7919) % 1000) }
        big.Sort(fn(x, y) { return x < y })
        assert big.Every(fn(x) { return x >= 0 }) and big[0] == 0 and big[999] == 999
        ok Bool = true
        for i in range 1, 1000 {
            if big[i - 1] > big[i] { ok = false }
        }
        assert ok
        # stability: sort pairs by their key only, and equal keys keep the order they came in
        keys := Array<I32>(300)
        for i in range 300 { keys[i] = I32(i) }
        keys.Sort(fn(x, y) { return x % 3 < y % 3 })
        assert keys[0] == 0 and keys[1] == 3 and keys[99] == 297 and keys[100] == 1 and keys[299] == 299
        words := "pear fig apple kiwi banana".Split(" ")
        words.Sort(fn(x, y) { return x.Len() < y.Len() })
        assert words[0].Eq("fig") and words[1].Eq("pear") and words[2].Eq("kiwi") and words[4].Eq("banana")
    }

}
