# CONFIRMED, NEW (771a922) over-rejection - the minimal form of o26a_cycle_overreject: h (declared first) keeps i only
# through a cycle with m, so m's obligation on i arrives late; A's "return W(g.m(i, 0))" is refused (O10c at 18:16)
# where c2a38f0 builds and runs it: "7 8" under -b, -b -s and -i.
type Info struct(Offset I64, Len I64) {
    Offset
    Len
}
type Ref struct(r Info&) { r }
type W struct(x Ref) { x }
type G struct() { n I64 = 0 }
fn (g G&) h(i Info&, d I64) Ref {
    if d < 5 { return g.m(i, d + 1) }
    return Ref(i)
}
fn (g G&) m(i Info&, d I64) Ref { return g.h(i, d) }
fn (g G&) A(k I64) W {
    i := Info(k, k + 1)
    return W(g.m(i, 0))
}
fn churn() I64 {
    t I64 = 0
    for k in range 50 {
        a := Array<I64>(64, I64(k) * 1000)
        t += a[3]
    }
    return t
}
fn main() ? {
    g := G()
    w := g.A(7)
    churn()
    println($w.x.r.Offset " " $w.x.r.Len)
}
