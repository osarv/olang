# channel: a lambda the callee calls, capturing where the result goes
type Info struct(Offset I64, Len I64) {
    Offset
    Len
}
type Box struct() { ref Info& = null }
type G struct() { x I64 = 0 }
fn (g G&) apply(i Info&, f fn(x Info&)) I64 {
    f(i)
    return 0
}
fn (g G&) build(k I64) Box& {
    b mut Box& = Box()
    i := Info(k, k + 1)
    g.apply(i, fn(x Info&) { b.ref = x })
    return b
}
fn churn() I64 {
    t I64 = 0
    for k in range 50 {
        a := Array<I64>(64, I64(k))
        t += a[3]
    }
    return t
}
fn main() ? {
    g := G()
    r := g.build(3)
    churn()
    println($r.ref.Len)
}
