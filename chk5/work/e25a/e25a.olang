# E25/C2d: an instance built where a scope argument says, holding a read-only reference to a shorter block's local
type Info struct(n I64) { n }
type Env struct(r Info&) {
    r
    parent mut Env& = null
}
fn build(c mut Env&) {
    for k in range 3 {
        local := Info(k + 100)
        x := Env&c(local)
        c.parent = x
    }
}
fn build2(c mut Env&) {
    for k in range 3 {
        local := Info(k + 200)
        x mut Env&c = Env(local)
        c.parent = x
    }
}
fn churn() I64 {
    t I64 = 0
    for k in range 50 {
        a := Array<I64>(64, I64(k) * 1000)
        t += a[3]
    }
    return t
}
fn main() ? {
    g := Info(1)
    c mut Env& = Env(g)
    build(c)
    churn()
    println($c.parent.r.n)
    build2(c)
    churn()
    println($c.parent.r.n)
}
