# match on a call's result whose payload part is kept in a longer-lived list from inside the clause
type Item struct(s String&) { s }
type Res enum {
    None
    Got(it Item)
}
type Src struct() {
    items mut List<Item>& = List<Item>()
}
fn (st Src&) find(t String&) Res {
    if t.Len() > 0 { return Res.Got(Item(t)) }
    return Res.None
}
fn churn() I64 {
    t I64 = 0
    for k in range 50 {
        a := Array<I64>(64, I64(k) * 1000)
        t += a[3]
    }
    return t
}
fn main() ? {
    st := Src()
    keep := List<Item>()
    for k in range 3 {
        t := "text" $k
        match st.find(t) {
            case Res.Got(it) { keep.Push(it) }
            nomatch { }
        }
    }
    churn()
    println($keep[0].s " " $keep[2].s)
}
