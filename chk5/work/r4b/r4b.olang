type Box<T> struct(v T) { v }
type Value struct(m mut Map<String&, I64>&) {
    m
    kids mut List<Box<Value>>& = List<Box<Value>>()
}
fn churn() I64 {
    t I64 = 0
    for k in range 50 {
        a := Array<I64>(64, I64(k) * 1000)
        t += a[3]
    }
    return t
}
fn main() ? {
    root := Value(Map<String&, I64>())
    for i in range 3 {
        inner := Map<String&, I64>()
        inner.Put("a", i)
        b := Box<Value>(Value(inner))
        root.kids.Push(b)
    }
    churn()
    for k in root.kids { println($k.v.m.Len()) }
}
