import "std/io"

N I64 = 1000000

fn mk(i I64) Vec<String> {
    w Vec<String>
    for j in range 20 { w.Push($i + "-" + $j + " padded out a little") }
    return w
}

fn longest(v Vec<String>) I64 {
    v.Push("one more, long enough to count")
    n I64 = 0
    for s in v { n = n.Max(s.Len()) }
    return n
}

fn main() {
    rows := Array<Vec<String>>(10)
    for i in range 10 { rows[i] = mk(i) }
    t := 0
    for i in range N { t += longest(rows[i % 10]) }
    io.PutLine($t)!
}
