import "std/io"
type Node struct(v I64) { v }
type E error { STOP }
fn g(i I64) I64 ? E {
    if i >= 3 { error E.STOP }
    return i
}

fn probe(c Bool) I64 {
    n Node&
    i I64 = 0
    for {
        for {
            if i > 2 { break }
            i++
        }
        y := I64[try g(i) catch { break }]
        i += y.Len()
    }
    return n.v
}
fn main() { io.Println($probe(true))! }
