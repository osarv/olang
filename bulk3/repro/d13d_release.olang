import "std/io"

type Node struct(v I64) { v }
type Holder struct(n Node?&) { n }

fn junk(k I64) I64 {
    a, b, c, d I64 = k * 7919, k * 104729, k * 15485863, k * 32452843
    e, f, g, h I64 = a ^ b, b ^ c, c ^ d, d ^ a
    return a + b + c + d + e + f + g + h
}

fn use(c Bool, k I64) I64 {
    h Holder
    if c {
        h = Holder(Node(k))
    } else {
        h = Holder(Node(k + 1))
    }
    s I64 = 0
    for i in range 100 {
        h = Holder(Node(i))
        s += h.n!.v
    }
    return s
}

fn main() {
    t I64 = 0
    for k in range 1000 {
        t += junk(k)
        t += use(k % 2 == 0, k)
    }
    io.Println($t)!
}
