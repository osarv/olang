import "std/io"

# D13d: as d13d_dowhile, with a type that has a zero value - none is written, and the read gets whatever the slot held
type P struct(v I64 = 7) { v }

fn junk(k I64) I64 {
    a, b, c, d I64 = k * 7919 + 4096, k * 104729 + 8192, k * 15485863, k * 32452843
    e, f, g, h I64 = a ^ b, b ^ c, c ^ d, d ^ a
    return a + b + c + d + e + f + g + h
}

fn probe() I64 {
    p P
    i I64 = 0
    do { i++ } for i < 3
    return p.v
}

fn main() {
    t I64 = 0
    for k in range 3 {
        t += junk(k)
        io.Println($probe())!
    }
}
