type K struct(s String&) { s }
type KL struct(l Lab&) { l }
type HS struct(s String&) { s }
type Lab extends String
# RetCopy: a borrow of the returned local stored into an outer block's reference local, which is then stored outward
fn f(k mut K&, i I64) String {
    r String& = "none"
    if i > 0 {
        s := "abc" $i
        r = s
        k.s = r
        return s
    }
    return "z"
}
fn probe() String {
    k := K("x")
    x := f(k, 1)
    x[0] = 'Q'
    return "k.s " $k.s " x " $x
}
G := probe()
fn main() {
    say("run: " $probe())
    say("baked: " $G)
}
