type K struct(s String&) { s }
type KL struct(l Lab&) { l }
type HS struct(s String&) { s }
type Lab extends String
# RetCopy and is: a reference stored by the callee compared with the caller's value by identity
type KR struct(s Array<I64>&) { s }
fn f(k mut KR&) Array<I64> {
    s := Array<I64>(3, 7)
    k.s = s
    return s
}
fn probe() String {
    k := KR(Array<I64>(1, 0))
    x := f(k)
    x[0] = 99
    return "k.s[0] " $k.s[0] " x[0] " $x[0]
}
G := probe()
fn main() {
    say("run: " $probe())
    say("baked: " $G)
}
