type K struct(s String&) { s }
# RetCopy: the borrow handed to a callee that keeps it in another argument which is not a local's read - a constructor
# call wrapping the caller's struct - so the third mode finds no root for it and calls it not kept
type Wrap struct(k mut K&) { k }
fn put(w Wrap, t String&) { w.k.s = t }
fn f(k mut K&, i I64) String {
    s := "abc" $i
    put(Wrap(k), s)
    return s
}
fn probe() String {
    k := K("x")
    x := f(k, 1)
    x[0] = 'Q'
    return "k.s " $k.s " x " $x
}
G := probe()
fn main() {
    say("run: " $probe())
    say("baked: " $G)
}
