import "std/io"
type K struct(s String&) { s }
type KL struct(l Lab&) { l }
type HS struct(s String&) { s }
type Lab extends String
# RetCopy: a borrow kept as a conversion naming the local's storage (T29a), stored in a parameter's field
fn f(k mut KL&, i I64) String {
    s := "abc" $i
    k.l = Lab(s)
    return s
}
fn probe() String {
    k := KL(Lab("x"))
    x := f(k, 1)
    x[0] = 'Q'
    return "k.l " $String(k.l) " x " $x
}
G := probe()
fn main() {
    say("run: " $probe())
    say("baked: " $G)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
