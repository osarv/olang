import "std/io"
type K struct(s String&) { s }
# RetCopy: the returned local returned twice, as two of several results - the third mode leaves returns out, so neither
# is copied and the caller's two values are one storage; compile-time evaluation copies each
fn two(i I64) String, String {
    s := "abc" $i
    return s, s
}
fn probe() String {
    a, b := two(1)
    a[0] = 'Q'
    return "a " $a " b " $b
}
G := probe()
fn main() {
    say("run: " $probe())
    say("baked: " $G)
    assert probe() == "a Qbc1 b abc1", "the two results are one storage"
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
