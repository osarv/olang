import "std/io"
type K struct(s String&) { s }
type KL struct(l Lab&) { l }
type HS struct(s String&) { s }
type Lab extends String
# RetCopy: the returned local and a struct holding a borrow of it returned together
fn f(i I64) String, HS {
    s := "abc" $i
    return s, HS(s)
}
fn probe() String {
    a, h := f(1)
    a[0] = 'Q'
    return "a " $a " h.s " $h.s
}
G := probe()
fn main() {
    say("run: " $probe())
    say("baked: " $G)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
