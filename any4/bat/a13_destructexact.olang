type P struct(n I64) { n }
type H struct(p P?&) { p }
type HS struct(s String&) { s }
type V struct(p P&) { p }
type Sh trait {
    Show() String
}
fn (p P&) Show() String { return "P" $p.n }
type Lab extends String
fn (l Lab&) Show() String { return "lab " $String(l) }
fn mkp(i I64) P& { return P(i) }
fn mk(i I64) String { return "text" $i "-" $(i * 7) }
fn mkv(i I64) V { return V(P(i)) }
error Fail {
    BAD
}
fn fp(i I64) P& ? Fail {
    if i >= 0 { error Fail.BAD }
    return P(i)
}
# accepted expected: SPEC's own E25 example, destructured results built where rows lives, pushed into it
fn mk2p(i I64) P&, P& { return P(i), P(i + 1) }
fn main() {
    rows := List<P&>()
    for i in range 2 {
        a, b := mk2p&rows(i * 11 + 1)
        rows.Push(a)
        rows.Push(b)
    }
    assert churn() > 0
    for x in rows { say("destructexact " $x.n) }
}
