type P struct(n I64) { n }
type H struct(p P?&) { p }
type HS struct(s String&) { s }
type V struct(p P&) { p }
type Sh trait {
    Show() String
}
fn (p P&) Show() String { return "P" $p.n }
type Lab extends String
fn (l Lab&) Show() String { return "lab " $String(l) }
fn mkp(i I64) P& { return P(i) }
fn mk(i I64) String { return "text" $i "-" $(i * 7) }
fn mkv(i I64) V { return V(P(i)) }
error Fail {
    BAD
}
fn fp(i I64) P& ? Fail {
    if i >= 0 { error Fail.BAD }
    return P(i)
}
# a struct value with an array field of known length (no references) from a scoped call, returned
type FA struct(a Array<I64, 3>) { a }
fn mkfa(i I64) FA { return FA(Array<I64, 3>(i, i + 1, i + 2)) }
fn g(i I64) FA {
    t := "local" $i
    return mkfa&t(i)
}
fn main() {
    a := g(1)
    assert churn() > 0
    say($a.a[0])
}
