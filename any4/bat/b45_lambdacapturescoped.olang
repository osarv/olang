type P struct(n I64) { n }
type H struct(p P?&) { p }
type HS struct(s String&) { s }
type V struct(p P&) { p }
type Sh trait {
    Show() String
}
fn (p P&) Show() String { return "P" $p.n }
type Lab extends String
fn (l Lab&) Show() String { return "lab " $String(l) }
fn mkp(i I64) P& { return P(i) }
fn mk(i I64) String { return "text" $i "-" $(i * 7) }
fn mkv(i I64) V { return V(P(i)) }
error Fail {
    BAD
}
fn fp(i I64) P& ? Fail {
    if i >= 0 { error Fail.BAD }
    return P(i)
}
# a lambda returning a scoped call naming what it captured (a value array built where an inner local lives), its
# result made an any in an outer list
fn main() {
    l := List<any Sh&>()
    for i in range 3 {
        t := "inner" $i
        f := fn() String { return mk&t(7) }
        l.Push(Lab(f()))
    }
    assert churn() > 0
    for x in l { say($x.Show()) }
}
