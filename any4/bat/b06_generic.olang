type P struct(n I64) { n }
type H struct(p P?&) { p }
type HS struct(s String&) { s }
type V struct(p P&) { p }
type Sh trait {
    Show() String
}
fn (p P&) Show() String { return "P" $p.n }
type Lab extends String
fn (l Lab&) Show() String { return "lab " $String(l) }
fn mkp(i I64) P& { return P(i) }
fn mk(i I64) String { return "text" $i "-" $(i * 7) }
fn mkv(i I64) V { return V(P(i)) }
error Fail {
    BAD
}
fn fp(i I64) P& ? Fail {
    if i >= 0 { error Fail.BAD }
    return P(i)
}
# a generic call given a scope argument, its result stored outward
type Box<T> struct(v T) { v }
type HB struct(b Box<I64>?&) { b }
fn mkb<T>(x T) Box<T>& { return Box<T>(x) }
fn main() {
    h := HB(null)
    for i in range 2 {
        t := "inner" $i
        h.b = mkb&t(i * 11 + 1)
    }
    assert churn() > 0
    say("generic " $h.b!.v)
}
