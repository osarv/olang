type P struct(n I64) { n }
type H struct(p P?&) { p }
type HS struct(s String&) { s }
type V struct(p P&) { p }
type Sh trait {
    Show() String
}
fn (p P&) Show() String { return "P" $p.n }
type Lab extends String
fn (l Lab&) Show() String { return "lab " $String(l) }
fn mkp(i I64) P& { return P(i) }
fn mk(i I64) String { return "text" $i "-" $(i * 7) }
fn mkv(i I64) V { return V(P(i)) }
error Fail {
    BAD
}
fn fp(i I64) P& ? Fail {
    if i >= 0 { error Fail.BAD }
    return P(i)
}
# accepted expected: a scoped call naming the parameter a borrowed result is borrowed from
fn g(h H&, i I64) P&h { return mkp&h(i) }
fn main() {
    h := H(null)
    l := List<P&>()
    for i in range 2 { l.Push(g(h, i * 11 + 1)) }
    assert churn() > 0
    for x in l { say("borrowedresult " $x.n) }
}
