type P struct(n I64) { n }
type H struct(p P?&) { p }
type HS struct(s String&) { s }
type V struct(p P&) { p }
type Sh trait {
    Show() String
}
fn (p P&) Show() String { return "P" $p.n }
type Lab extends String
fn (l Lab&) Show() String { return "lab " $String(l) }
fn mkp(i I64) P& { return P(i) }
fn mk(i I64) String { return "text" $i "-" $(i * 7) }
fn mkv(i I64) V { return V(P(i)) }
error Fail {
    BAD
}
fn fp(i I64) P& ? Fail {
    if i >= 0 { error Fail.BAD }
    return P(i)
}
# a scoped call's text naming an inner block's local lent to a callee that keeps it in an outer list (a String holds no
# references, so the call's value is plain)
fn keepS(l mut List<String&>&, s String&) { l.Push(s) }
fn main() {
    l := List<String&>()
    for i in range 2 {
        t := "inner" $i
        keepS(l, mk&t(i))
    }
    assert churn() > 0
    say($l)
}
