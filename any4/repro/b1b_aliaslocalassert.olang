# r20 through an assert: decided true while compiling and dropped; the same comparison fails at run time
fn f(lst mut List<String&>&, i I64) String {
    s := "abc" $i
    l := lst
    l.Push(s)
    return s
}
fn probe() String {
    lst := List<String&>()
    x := f(lst, 1)
    x[0] = 'Q'
    return $lst[0]
}
fn main() {
    assert probe() == "abc1"
    r := probe()
    say("run: lst[0] " $r)
    assert r == "abc1", "the caller's list changed when it wrote its own value"
}
