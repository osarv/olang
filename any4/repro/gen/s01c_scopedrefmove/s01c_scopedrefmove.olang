import "std/io"
# the reference form of s01 (expected: refused, O10d - the call is existing storage at t)
type P struct(n I64) { n }
fn mkp(i I64) P& { return P(i) }
fn g(i I64) P& {
    t := "local" $i
    x := mkp&t(i * 11 + 1)
    return x
}
fn main() {
    a := g(1)
    assert churn() > 0
    say("a " $a.n)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
