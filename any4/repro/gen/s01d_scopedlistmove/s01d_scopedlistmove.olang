import "std/io"
# s01 with a List value (a handle: its state behind a reference) built by a scope argument where the function's own
# local lives, then returned
fn mkl(i I64) List<I64> {
    l := List<I64>()
    for k in range 5 { l.Push(i * 10 + k) }
    return l
}
fn g(i I64) List<I64> {
    t := "local" $i
    x := mkl&t(i)
    return x
}
fn main() {
    a := g(1)
    b := g(2)
    assert churn() > 0
    say($a " " $b)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
