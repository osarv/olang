import "std/io"
# s01 with the scope argument naming a parameter: the callee puts its result where the caller's argument lives (an
# inner loop body's local) while the caller's result lands outside (an element pushed into an outer list)
fn mk(i I64) String { return "text" $i "-" $(i * 7) }
fn g(p String&, i I64) String {
    x := mk&p(i)
    return x
}
fn main() {
    l := List<String&>()
    for i in range 3 {
        t := "inner" $i
        l.Push(g(t, i))
    }
    assert churn() > 0
    say($l)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
