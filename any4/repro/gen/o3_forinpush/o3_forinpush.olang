import "std/io"
type K struct(s String&) { s }
type KL struct(l Lab&) { l }
type HS struct(s String&) { s }
type Lab extends String
# RetCopy: an element of an array of borrows walked by a for-in, pushed outward
fn f(l mut List<String&>&, i I64) String {
    s := "abc" $i
    arr := String&[s, "y"]
    for q in arr { l.Push(q) }
    return s
}
fn probe() String {
    l := List<String&>()
    x := f(l, 1)
    x[0] = 'Q'
    return "l " $l " x " $x
}
G := probe()
fn main() {
    say("run: " $probe())
    say("baked: " $G)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
