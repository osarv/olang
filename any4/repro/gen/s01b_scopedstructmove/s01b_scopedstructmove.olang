import "std/io"
# s01 with a struct value holding a reference: the call's built result (H holding a new P) is put by the scope argument
# where the function's own local lives; the local is moved to the result scope and returned as it is
type P struct(n I64) { n }
type H struct(p P&) { p }
fn mkh(i I64) H { return H(P(i)) }
fn g(i I64) H {
    t := "local" $i
    x := mkh&t(i * 11 + 1)
    return x
}
fn main() {
    a := g(1)
    b := g(2)
    assert churn() > 0
    say("a " $a.p.n " b " $b.p.n)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
