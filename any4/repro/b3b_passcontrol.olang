type K struct(s String&) { s }
# control for r18: the same chain three links long, which the third mode's six passes do see
fn f(k mut K&, i I64) String {
    s := "abc" $i
    r1 String&s = ""
    r2 String&s = ""
    r3 String&s = ""
    for j in range 9 {
        k.s = r3
        r3 = r2
        r2 = r1
        r1 = s
    }
    return s
}
fn probe() String {
    k := K("x")
    x := f(k, 1)
    x[0] = 'Q'
    return "k.s " $k.s " x " $x
}
G := probe()
fn main() {
    say("run: " $probe())
    say("baked: " $G)
}
