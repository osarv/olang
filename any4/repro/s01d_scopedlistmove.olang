# s01 with a List value (a handle: its state behind a reference) built by a scope argument where the function's own
# local lives, then returned
fn mkl(i I64) List<I64> {
    l := List<I64>()
    for k in range 5 { l.Push(i * 10 + k) }
    return l
}
fn g(i I64) List<I64> {
    t := "local" $i
    x := mkl&t(i)
    return x
}
fn main() {
    a := g(1)
    b := g(2)
    assert churn() > 0
    say($a " " $b)
}
