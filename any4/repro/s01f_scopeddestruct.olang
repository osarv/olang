# s01 through a destructured result: two arrays built by a scope argument where the function's own local lives,
# taken apart into locals and returned
fn mk2(i I64) String, String { return "one" $i, "two" $(i * 3) }
fn g(i I64) String {
    t := "local" $i
    a, b := mk2&t(i)
    return b
}
fn main() {
    a := g(1)
    b := g(2)
    assert churn() > 0
    say(a)
    say(b)
}
