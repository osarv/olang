import "std/io"
import "std/pair"
# T32 AnyNoCopy through Pair<I64, G>: a default whose result holds its receiver by value, called through an any
type Ups struct(n I64) {
    n
    at I64 = 0
}
type Gen trait {
    mut Step() I64
}
fn (u mut Ups&) Step() I64 {
    u.at += 1
    return u.at
}
type Wrap<T> struct(l List<T>&) { l }
fn (g mut G&) Twice<G Gen>() Pair<I64, G> {
    return Pair(1, g)
}
fn main() {
    a mut any Gen& = Ups(5)
    l := a.Twice()
    say("made")
}
fn say(s String&) { try io.Println(s) catch { } }
