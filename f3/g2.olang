import "std/io"

fn fill(n I64) I64 {
    v Vec<I64>
    for i in range n { v.Push(i) }
    return v[n - 1]
}

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    w.Push(i)
    return w
}

fn main() {
    a := mk(0)
    for i in range 100 { a = mk(i) }
    t := 0
    for k in range 4 { t += fill(4000000 + k) }
    io.PutLine($t)!
}
