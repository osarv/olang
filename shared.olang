## Foundational types and functions - no imports. The base of this suite's import graph; worker.olang
## and runner.olang both import this file, and also import each other (a genuine cycle - see runner.olang).

type Point struct {
    x int32,
    y int32
}

type Line struct {
    a Point,
    b Point
}

## a genuinely single-field struct - single-value struct literals ("Wrapper{42}") were impossible before
## the hand-written, type-aware parser (a lone value inside "{}" was always indistinguishable from an
## ordinary index/block by the old table-driven engine - see CLAUDE.md), so this exists specifically to
## keep that capability under test, not just the multi-field case every other Point literal already covers
type Wrapper struct {
    v int32
}

type Direction vocab {
    NORTH,
    SOUTH,
    EAST,
    WEST
}

error MathError {
    DIV_BY_ZERO,
    OVERFLOW
}

error RangeError {
    TOO_SMALL,
    TOO_LARGE
}

func add(a int32, b int32) int32 {
    return a + b
}

func factorial(n int32) int32 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

func addLong(a int64, b int64) int64 {
    return a + b
}

func average(a float32, b float32) float32 {
    return (a + b) / 2.0
}

func isDigit(c byte) bool {
    return c >= '0' && c <= '9'
}

func setBit(flags int32, bit int32) int32 {
    return flags | (1 << bit)
}

func doubleIt(n int32) int32 {
    return n * 2
}

## a bare read of a global FUNCTION (as opposed to a local/parameter that merely *holds* a function
## pointer) used to have no real storage slot to load through - the mangled function symbol IS its own
## address already (an LLVM `define`, not a `global`) - so loading "through" it read the function's own
## machine code as if it were a stored pointer, segfaulting the instant it was called. See cgValue in
## codegen.c.
func applyToFive(f func(n int32) int32) int32 {
    return f(5)
}

## vocab values ("Type.WORD") communicate a fixed set and a selection from it - not a C-enum-style number:
## no ordering/arithmetic (rejected the same way any non-numeric type is, see TypeIsNumeric/TypeIsInt),
## only equality/inequality and match/case, both already generic over every type with no vocab-specific
## codegen needed.
func opposite(d Direction) Direction {
    result mut Direction = Direction.NORTH
    match d {
        case Direction.NORTH {
            result = Direction.SOUTH
        }
        case Direction.SOUTH {
            result = Direction.NORTH
        }
        case Direction.EAST {
            result = Direction.WEST
        }
        case Direction.WEST {
            result = Direction.EAST
        }
        nomatch {
            result = Direction.NORTH
        }
    }
    return result
}

func describe(n int32) int32 {
    result mut int32 = 0
    match n {
        case 1 {
            result = 100
        }
        case 2 {
            result = 200
        }
        nomatch {
            result = -1
        }
    }
    return result
}

## match's case values may be struct/array literals, not just scalars - a case value is checked
## structurally against the matched expression (cgDeepEq in codegen.c), not by identity
func classifyPoint(p Point) int32 {
    result mut int32 = 0
    match p {
        case Point{1, 2} {
            result = 100
        }
        case Point{3, 4} {
            result = 200
        }
        nomatch {
            result = -1
        }
    }
    return result
}

## "scope" is a restricted type (like an error type): only ever a function parameter's type, never a
## struct field, a return type on its own, or an ordinary variable's type - see CLAUDE.md. A "&name" tag
## names which scope-typed parameter a value is allocated into; bare "&" (unchanged from before) means
## the value's own private scope. "own" is a keyword evaluating to that private scope as a passable value,
## so a caller can hand a callee its own scope instead of the callee's default private one.
func makePoint(x int32, y int32, s scope) Point&s {
    p mut Point&s = Point{x, y}
    return p
}

## A plain struct literal (structMAlloc false) fitting a "&"-heap-indirect target (structMAlloc true) is
## allowed by the type checker (TypeIsSame deliberately ignores structMAlloc for structs), so codegen must
## malloc-and-copy at every point that promotion can happen - a var-decl, a call argument, and a return
## value - rather than just aliasing the literal's own (about-to-be-gone) stack storage. See cgStoreInto/
## cgBoundaryValue in codegen.c.
func takesHeapPoint(p Point&) int32 {
    return p.x
}

func returnsHeapPoint(s scope) Point&s {
    return Point{9, 8}
}

## Exercises the real arena allocator (emitScopeRuntime in codegen.c), not just the type-checking: many
## allocations into one still-open scope forces chunk growth (linking on more than one chunk), and calling
## this repeatedly forces __olang_scope_close/__olang_scope_alloc to actually recycle chunks through the
## free pool rather than just malloc-and-leak.
func sumManyPoints(n int32, s scope) int32 {
    total mut int32 = 0
    i mut int32 = 0
    do {
        p mut Point&s = Point{i, i}
        total = total + p.x
        i++
    } while i < n
    return total
}

## a bare "&" struct field (fields can't carry an explicit "&name" tag yet - no scope-generic struct
## types, see the report) has no declared scope of its own; a field write's promoted literal used to
## always land in "whatever function is executing right now" regardless of which scope the containing
## instance actually belongs to - a real dangling-pointer hazard the instant that function returns, for
## exactly the shape a self-referential struct (a linked list node, say) would need. BoxedPoint exists to
## put that fix under test: its "inner" field is heap-indirect, and NestedBox writes it from inside a
## different function than the one that allocated the containing instance.
type BoxedPoint struct {
    tag int32,
    inner Point&
}

## the narrow fix (not the general one - see the report): when the base of "base.field = ..." is itself a
## "&"-heap-indirect value tagged to an explicit scope "s", the freshly-promoted literal now inherits
## that same scope, instead of this function's own (about-to-close) private scope
func fillBoxedPoint(s scope, b mut BoxedPoint&s, x int32, y int32) int32 {
    b.inner = Point{x, y}
    return b.inner.x
}

## forces reuse of whatever arena chunk fillBoxedPoint's own (now-closed) private scope just freed, by
## allocating something comparably sized right after - if "inner" had dangled into fillBoxedPoint's own
## scope instead of the caller's, this corrupts it and the later read in the test below fails
func noisePoint(n int32) int32 {
    p mut Point& = Point{n, n}
    return p.x
}

func sumUntil(n int32) int32 {
    total mut int32 = 0
    i mut int32 = 1
    do {
        total = total + i
        i++
    } while i <= n
    return total
}

func SafeDiv(a int32, b int32) int32 ? MathError {
    if b == 0 {
        error MathError.DIV_BY_ZERO
    }
    return a / b
}

func CheckRange(n int32, lo int32, hi int32) int32 ? RangeError {
    if n < lo {
        error RangeError.TOO_SMALL
    }
    if n > hi {
        error RangeError.TOO_LARGE
    }
    return n
}

## combines both of this file's error types in one signature, in declaration order (MathError first) -
## worker.olang re-declares the same pair in the OPPOSITE order when it propagates this, exercising the
## error-union ABI's ordinal remap across two differently-ordered signatures
func ComputeChecked(a int32, b int32, lo int32, hi int32) int32 ? MathError + RangeError {
    if b == 0 {
        error MathError.DIV_BY_ZERO
    }
    result int32 = a / b
    if result < lo {
        error RangeError.TOO_SMALL
    }
    if result > hi {
        error RangeError.TOO_LARGE
    }
    return result
}

## the bare error ("error" reused bare, wherever a real error type's name would otherwise go - see
## CLAUDE.md): a member of a function's own error union that names no declared type at all, standing for
## "this failed, no further detail is tracked." Mixes with a real named type via "+" the same way two named
## types combine; the bare "error" statement (no "TYPE.word" operand) produces it, and "catch error"
## matches only it - never RangeError, even though both are declared here.
func mightFailWithBareError(n int32) int32 ? RangeError + error {
    if n < 0 {
        error
    }
    if n > 100 {
        error RangeError.TOO_LARGE
    }
    return n * 2
}

## constructors: "type Name struct(params) errorList? { fields } destruct?" - params are the constructor's
## own declared arguments; each field is either a bare pun (binds directly to a same-named parameter, type
## inferred from it - no separate declaration needed) or an ordinary var-decl-shaped "name Type = expr" /
## "name := expr" (never silently inferred - a field always states its own type unless it opts into ":="
## the same way any other var-decl would). Once a type declares a constructor, the old positional "Type{...}"
## literal is rejected for it (TYPE_REQUIRES_CONSTRUCTOR_CALL) - constructing it any other way could
## silently bypass the constructor's own logic. Counter is the plain case: every field is a pun.
type Counter struct(start int32) {
    start
}

## a field may also be computed from the constructor's parameters via an ordinary expression, alongside a
## punned one - "doubled" has its own type/initializer, "n" is a bare pun
type Rectangle struct(n int32) {
    n,
    doubled mut int32 = n * 2
}

error ValidationError {
    NEGATIVE
}

func checkNonNegative(n int32) int32 ? ValidationError {
    if n < 0 {
        error ValidationError.NEGATIVE
    }
    return n
}

## a constructor may declare its own error union, exactly like a function signature - a fallible field
## initializer needs "try" the same way any fallible call does, and "Measurement(...)" itself becomes a
## fallible call site at every caller, handled by the exact same try/catch machinery as any other function
type Measurement struct(n int32) ValidationError {
    v mut int32 = try checkNonNegative(n),
    n
}

func measurementValue(n int32) int32 ? ValidationError {
    m mut Measurement = try Measurement(n)
    return m.v
}

resourcesClosed mut int32 = 0

## "T[N]" with no initializer - real BSS-style zero-fill (see the report). A global's own storage is
## already emitted as "zeroinitializer" unconditionally (emitGlobalDecls); leaving initExpr NULL, rather
## than writing a literal, is the entire mechanism - no dedicated zero-fill codegen exists or is needed.
zeroGlobal mut int32[5]

## "destruct { }" is the only other special block a type can declare (see the report - general
## "Type.funcName" methods were considered and explicitly dropped in favor of just these two). It has no
## error union of its own - same rule as a test{} block - so a fallible call inside must be fully caught
## right there; a destructor can never propagate a failure to anyone (there's no caller to hand it to,
## especially once many queued destructors can fire in one scope-close batch - see the report).
error CloseError {
    FAIL
}

func alwaysCloses() bool ? CloseError {
    return true
}

## bare field names inside destruct (like "id" below) read as that field directly, no "self."-style prefix
type Handle struct(id int32) {
    id
} destruct {
    try alwaysCloses() catch CloseError {
        crash
    }
    resourcesClosed = resourcesClosed + 1
}

## a destructor-declaring type is reference-only (C11), so every instance lives in some scope and its
## destructor runs when that scope closes (C9/O15) - there is no plain-local, function-return-governed
## case any more. Bare "&" means this function's own private scope, so this instance is torn down the
## moment useHandleLocally returns.
func useHandleLocally() int32 {
    h mut Handle& = Handle(7)
    return h.id
}

## an instance tagged to a PASSED-IN scope outlives the function that constructed it - it was registered
## with the caller's scope at construction (O16), not with makeHandle's own, so nothing fires when
## makeHandle returns. This replaces the old "return <bare local> skips its own destructor" special case:
## the scope tag now expresses that fact directly, so no dataflow exception is needed for it at all.
func makeHandle(n int32, s scope) Handle&s {
    h mut Handle&s = Handle(n)
    return h
}

## proves the deferral is scoped to exactly the instance tagged to the caller's scope, not a blanket "no
## destructors fire in this function": "discard" is tagged to makeAndDiscardOne's OWN scope, so it is
## destructed when that function returns, while "keep" survives into the caller's.
func makeAndDiscardOne(n int32, s scope) Handle&s {
    keep mut Handle&s = Handle(n)
    discard mut Handle& = Handle(n + 100)
    return keep
}

## every "&" instance constructed in a loop registers with the enclosing scope individually, and all of
## them are torn down together in LIFO order the moment that scope closes.
func useManyHandlesLocally(n int32) int32 {
    total mut int32 = 0
    for i mut int32 = 0, i < n, i++ {
        h mut Handle& = Handle(i)
        total = total + h.id
    }
    return total
}

## an ARRAY of destructor-bearing instances. A destructor-declaring type can never be an array element by
## VALUE (C11), so this needs an array OF references - the marker written BEFORE the array suffix
## ("Handle&[3]") rather than after it ("Handle[3]&", one reference to an array of values). Each Handle is
## constructed and registered individually (O16); no per-element destructor walk is involved anywhere,
## that machinery is gone.
func makeHandleArrayRef(s scope) Handle&[3]&s {
    return Handle&[Handle(20), Handle(21), Handle(22)]
}

func useHandleArrayLocally() int32 {
    arr mut Handle&[3]& = makeHandleArrayRef(own)
    return arr[0].id + arr[1].id + arr[2].id
}

## the same through the OTHER array-promotion path (a compile-time-length literal flowing into a genuinely runtime-length
## "T[]" target - cgPromoteFixedToRuntimeLength, an orthogonal mechanism from the compile-time-length-array-reference
## one above). Still no destructor registration in the promotion itself: the three Handles registered
## themselves when they were constructed, wherever the references to them later end up.
func useHandleArrayLocallyRuntimeLength() int32 {
    arr mut Handle&[]& = Handle&[Handle(30), Handle(31), Handle(32)]
    return arr[0].id + arr[1].id + arr[2].id
}

## constructors already give a struct field a real, type-level scope - no generics syntax needed. A
## field's type is resolved against the constructor's own parameter list (see resolveStructCtorInto in
## semantic.c), the same way a later parameter can already reference an earlier one - so a field can
## already name a real "&name" scope tag pointing at one of the constructor's own scope parameters,
## same as any function parameter/return type already could. This only works for constructor-bearing
## types: a plain "type X struct { ... }" still has no parameter list to resolve a field's "&name"
## against at all - that half of the scope-generic-struct-types gap is still open.
type ScopedBox struct(s scope, inner Point&s) {
    inner
}

func fillBoxViaCtor(outer scope) Point&outer {
    b mut ScopedBox& = ScopedBox(outer, Point{7, 8})
    return b.inner
}

## the transitive counterpart to BARE_SCOPE_RETURN_TYPE (resolveFuncSig in semantic.c): a PLAIN return
## type that embeds a bare "&" field anywhere inside it dangles the same way a bare "&" return type
## itself would, and is now also rejected. ScopedBox is returned here entirely by value (no "&" on the
## return type at all) - allowed, and correctly so, since "inner" carries an explicit "&s" tag rather
## than a bare one; nothing about returning the wrapping struct plain is unsound here.
func makeScopedBoxPlain(outer scope, x int32, y int32) ScopedBox {
    return ScopedBox(outer, Point{x, y})
}

## BARE_SCOPE_RETURN_TYPE and NESTED_BARE_SCOPE_RETURN_TYPE (resolveFuncSig in semantic.c) used to only
## ever check BASETYPE_STRUCT, silently letting a bare "&" compile-time-length array, a bare "&" field nested inside
## a plain struct/array, or - worse - an entirely UNMARKED runtime-length array (T11/O7: always reference-shaped,
## marker or not) escape by value with no compile-time check at all, even though a runtime-length array is just
## as own-scoped as an explicitly "&"-marked struct/compile-time-length array. Fixed by generalizing both checks
## (typeIsBareRefShaped/structContainsBareScopeField) to treat structs, compile-time-length arrays, and runtime-length arrays
## uniformly. All three shapes below are now correctly rejected at compile time - not testable here since
## a rejected program can't run as a test{} block; verified ad hoc during development instead:
##   func bad1(s scope) int32[3]& { ... return <own-scoped array> }
##   func bad2(s scope, n int32) int32[] { ... return <own-scoped runtime-length array> }
##   func bad3(s scope) Wrapper { ... return Wrapper{<own-scoped array field>} }

## the static scope checker's one positively-provable narrowing rule (scopeCanFlowInto in semantic.c): a
## value tagged with a scope RECEIVED as a parameter is always safe to store into a slot tagged with this
## function's own bare "&" scope, since every received scope is guaranteed to outlive the function's own
## private one (which closes the instant this function itself returns). The reverse, and two different
## named scopes of the same function, are both rejected at compile time - not testable here since a
## rejected program can't run as a test{} block; verified ad hoc during development instead.
func narrowNamedIntoOwn(s scope) int32 {
    p mut Point&s = fillBoxViaCtor(s)
    q mut Point& = p
    return q.x
}

## extends the static checker past one function's own frame: a call operand (constructor or ordinary
## function, same mechanism either way) now carries its own scope-binding map - what each of the callee's
## own scope params was concretely bound to at this call site - propagated one hop through a var-decl, so
## a later member access (or the call's own return value directly) can be checked against the CALLER's own
## frame instead of being silently treated as "foreign, unverifiable, allow". "box"'s own "s" is bound to
## "a" here, so returning "box.inner" against the declared "Point&a" return type is a real, verified match
## - not just an unverified pass-through. Swapping "a" for a second, unrelated scope parameter here (i.e.
## "ScopedBox(otherScope, ...)") is correctly rejected at compile time - not testable here since a rejected
## program can't run as a test{} block; verified ad hoc during development instead.
func fillBoxViaCtorChecked(a scope, x int32, y int32) Point&a {
    box mut ScopedBox& = ScopedBox(a, Point{x, y})
    return box.inner
}

## same extension, for an ordinary function call's own return type rather than a constructor field -
## "makePoint"'s own "s" is bound to "a" here, so the return type "Point&a" is a real, verified match.
func makePointChecked(a scope, x int32, y int32) Point&a {
    return makePoint(x, y, a)
}

## "field of a field" - a second, independent constructor-bearing type nested one level deeper. Mid's own
## "leaf" is tagged to MID's own ctor scope param (also spelled "s", but a completely different "struct
## var*" than Outer's own "s" - the two only happen to share a name). Outer's own "mid" field is
## constructed as "Mid(s, ...)" using OUTER's own "s" as MID's own ctor argument - this is the substitution
## a caller doing "outer.mid.leaf" needs traced through, not just Outer's own field tag, to know what scope
## "leaf" actually ends up in. Persisted once, at Outer's own declaration (see semaCheckBodies), onto
## Outer's "mid" field itself (struct var.scopeBindings, reused from the same field a local var-decl's own
## initializer already populates) - not recomputed per call site.
type Mid struct(s scope, leaf Point&s) {
    leaf
}

type Outer struct(s scope, x int32, y int32) {
    mid Mid&s = Mid(s, Point{x, y})
}

## Outer's own "s" is bound to "a" here, so "o.mid.leaf" is really "a"-scoped - a chain through TWO levels
## of constructor-declared scope params (Outer's own field tag, then Mid's own internal one), not just one.
func fieldOfFieldChecked(a scope, x int32, y int32) Point&a {
    o mut Outer& = Outer(a, x, y)
    return o.mid.leaf
}

## a BARE-PUN field ("{ wrapped }" alone, forwarding a same-named constructor PARAMETER directly, rather
## than constructing a fresh value the way Mid's "leaf" field above does) needed its own, separate fix: a
## parameter never gets its own scopeBindings populated (unlike a local var-decl or a field's own explicit
## initializer, both of which do) - so a bare-pun field's persisted map used to always be empty even when
## the parameter's own type was constructor-bearing, and the substitution fell through to "foreign,
## unverifiable, allow," silently accepting an actually-wrong scope. Fixed two ways: OperandFuncCall now
## merges a non-scope argument's own scopeBindings into the call's own map (so whatever substitution the
## "WrappedPoint(a, ...)" argument already carries survives the "PunnedBox(...)" call boundary), and
## OperandMember carries a base's own map forward onto a further member access (since a bare-pun field has
## no persisted map of its own to compose through) - see the report.
type WrappedPoint struct(s scope, inner Point&s) {
    inner
}

type PunnedBox struct(s scope, wrapped WrappedPoint&s) {
    wrapped
}

func makePunnedBoxChecked(a scope, x int32, y int32) Point&a {
    b mut PunnedBox& = PunnedBox(a, WrappedPoint(a, Point{x, y}))
    return b.wrapped.inner
}

## a real precision gap the bare-pun fix above left open, closed separately: TWO bare-pun fields at ONE
## constructor sharing the exact same underlying constructor-bearing type ("WrappedPoint" for both "left"
## and "right"). WrappedPoint's own internal "s" is the SAME struct var* key regardless of which field it's
## reached through, so merging both arguments' own scopeBindings into DualWrapped's own map used to collide
## - with no way to tell "this WrappedPoint.s entry came from left" from "this one came from right," a real
## disagreement (left tagged to "a", right tagged to "own") forced BOTH "d.left.inner" and "d.right.inner"
## to SCOPE_AMBIGUOUS, correctly rejecting the truly-unsound access but ALSO the truly-sound one. Fixed by
## tagging each merged entry with WHICH of DualWrapped's own constructor parameters it flowed through
## (struct scopeBinding.viaPath, set in OperandFuncCall's merge loop) and, at a bare-pun field access,
## filtering the base's carried-forward map down to only the entries that flowed through THIS field's own
## punned parameter (struct var.punParam, OperandMember's carry-forward step) - see the report.
## "d.left.inner" below is now a real, independently-verified match, not a blanket ambiguous rejection.
type DualWrapped struct(ls scope, rs scope, left WrappedPoint&ls, right WrappedPoint&rs) {
    left, right
}

func dualWrappedFieldChecked(a scope, leftX int32, leftY int32, rightX int32, rightY int32) Point&a {
    d mut DualWrapped& = DualWrapped(a, own, WrappedPoint(a, Point{leftX, leftY}), WrappedPoint(own, Point{rightX, rightY}))
    return d.left.inner
}

## viaPath (above) was originally a single scalar, overwritten rather than composed at each call boundary -
## which meant it could disambiguate exactly ONE level of nested bare-pun forwarding and had to fall back to
## SCOPE_AMBIGUOUS beyond that, even when the deeper access was actually sound. Generalized into a real
## stack (a list of struct var*, nearest-first): OperandFuncCall's merge step now PUSHES the current call's
## own parameter onto whatever path an entry already carried instead of overwriting it, and OperandMember's
## carry-forward step POPS exactly the one frame it's responsible for, leaving any remaining frames intact
## for a further member access to pop in turn - see the report. "h.box.left.inner" below chains THREE
## levels of bare-pun forwarding (Holder's own "box", DualWrapped's own "left", WrappedPoint's own "inner")
## and still resolves to a real, single, verified scope - not an ambiguous rejection.
type Holder struct(hs scope, box DualWrapped&hs) {
    box
}

func holderFieldChecked(a scope, leftX int32, leftY int32, rightX int32, rightY int32) Point&a {
    h mut Holder& = Holder(a, DualWrapped(a, own, WrappedPoint(a, Point{leftX, leftY}), WrappedPoint(own, Point{rightX, rightY})))
    return h.box.left.inner
}

## the "deep corner" the entry above left open on paper - "two entries with the exact same fully-popped
## remaining path colliding if two independently-nested chains happen to converge on it" - turns out, on
## careful analysis, not to be a reachable gap at all, so there's no further mechanism to add here: see the
## report for the induction. "one" reaches WrappedPoint's own internal "s" with ONE push ("one"); "two"
## reaches the SAME typeParam (WrappedPoint is used both times) with TWO pushes ("two" then "leaf") - a
## constructor's own parameter names are always unique within one signature, so two DIFFERENT arguments of
## the SAME call can never be pushed with the same frame, which is exactly what guarantees these two chains
## can never collide, at any depth, without one of them already being SCOPE_AMBIGUOUS at its true origin.
## "p.one.inner" and "p.two.leaf.inner" below independently resolve to two DIFFERENT, genuinely correct
## scopes ("a" and "b") despite sharing the exact same innermost typeParam key.
type LeafWrap struct(s scope, leaf WrappedPoint&s) {
    leaf
}

type SiblingPair struct(s1 scope, s2 scope, one WrappedPoint&s1, two LeafWrap&s2) {
    one, two
}

func siblingPairOneChecked(a scope, b scope, x1 int32, y1 int32, x2 int32, y2 int32) Point&a {
    p mut SiblingPair& = SiblingPair(a, b, WrappedPoint(a, Point{x1, y1}), LeafWrap(b, WrappedPoint(b, Point{x2, y2})))
    return p.one.inner
}

func siblingPairTwoLeafChecked(a scope, b scope, x1 int32, y1 int32, x2 int32, y2 int32) Point&b {
    p mut SiblingPair& = SiblingPair(a, b, WrappedPoint(a, Point{x1, y1}), LeafWrap(b, WrappedPoint(b, Point{x2, y2})))
    return p.two.leaf.inner
}

## reassignment tracking: a var's own scope-binding map used to be set once, at its own declaration, and
## never revisited - so "box = ScopedBox(otherScope, ...)" here left box's OWN tracked binding stale,
## silently still saying "a" even after box was reassigned to point at something else entirely. A plain
## "x = y" now re-binds x's own map to y's, the same propagation a var-decl's own initializer already gets
## (buildAssignStmnt in semantic.c) - "box"'s own binding correctly tracks "a" through BOTH declaration and
## reassignment here, so "return box.inner" is a real, verified match, not a stale leftover. Reassigning
## "box" to an UNRELATED scope ("ScopedBox(otherScope, ...)") is correctly rejected at compile time - not
## testable here since a rejected program can't run as a test{} block; verified ad hoc during development.
func reassignSameScopeChecked(a scope, x int32, y int32) Point&a {
    box mut ScopedBox& = ScopedBox(a, Point{1, 2})
    box = ScopedBox(a, Point{x, y})
    return box.inner
}

## branching: two branches that each reassign a var to a DIFFERENT scope leave it genuinely ambiguous once
## control reaches past the "if" - correctly rejected (verified ad hoc, not testable here, same as above).
## When both branches instead agree (as here - both reassign "box" to the SAME "a"), the merge correctly
## keeps that agreed value rather than conservatively giving up the moment ANY branching is involved -
## buildIfStmnt's own snapshot/merge (see the report) proves this, not just an in-place update that would
## only ever see whichever branch happened to run last during the check.
func reassignBothBranchesAgreeChecked(a scope, cond bool, x int32, y int32) Point&a {
    box mut ScopedBox& = ScopedBox(a, Point{1, 2})
    if cond {
        box = ScopedBox(a, Point{x, y})
    } else {
        box = ScopedBox(a, Point{y, x})
    }
    return box.inner
}

## the type-level generalization of "a bare '&' field's scope inherits its container's own scope" - see
## the report. NestedBox is a plain type (no constructor, so "inner" can't carry a "&name" tag the way
## ScopedBox's field can - see the note above), yet "inner" still needs to survive wherever the whole
## NestedBox instance ends up: when a NestedBox literal is itself being promoted into a "&" target
## (cgValueForTarget/cgBoundaryValue set the ambient ctx->targetScopeOverride before building it), a bare
## field's own malloc now uses that same ambient scope (cgAggregateLiteral) instead of unconditionally
## defaulting to whatever function happens to be executing right now.
type NestedBox struct {
    inner Point&
}

func makeNestedBox(s scope, x int32, y int32) NestedBox&s {
    return NestedBox{Point{x, y}}
}

## two levels of bare "&" nesting, to stress cgResolveEffectiveScope's walk past the immediate base -
## "co.mid.leaf = ..." (see the test below) has "co.mid" (bare - no scope of its own) as its immediate
## base, which only resolves correctly by walking one hop further, into "co" itself.
type ChainMid struct {
    leaf Point&
}

type ChainOuter struct {
    mid ChainMid&
}

func setChainLeaf(s scope, co mut ChainOuter&s, x int32, y int32) int32 {
    co.mid.leaf = Point{x, y}
    return 0
}

## not constructor-specific - any parameter whose type names an EARLIER parameter of the same signature
## as its scope tag (not just a struct field's constructor param) used to crash at every call site that
## needed to malloc-promote a plain literal into it: the tag's name ("s") only has meaning inside the
## callee's own body, not at the caller, so trying to resolve it there via the normal local-lookup path
## found nothing and crashed. See cgResolveParamScopeOverride in codegen.c.
func takesScopedPoint(s scope, p Point&s) int32 {
    return p.x
}

test "factorial of small numbers" {
    assert(factorial(0) == 1)
    assert(factorial(1) == 1)
    assert(factorial(5) == 120)
}

test "add sums its two arguments" {
    assert(add(2, 3) == 5)
    assert(add(-2, 5) == 3)
}

test "float32 arithmetic" {
    assert(average(2.0, 4.0) == 3.0)
}

test "byte comparisons" {
    assert(isDigit('5'))
    assert(!isDigit('x'))
}

test "bitwise or, and, xor, shift" {
    assert(setBit(0, 3) == 8)
    assert((5 & 3) == 1)
    assert((5 ^ 3) == 6)
}

## int64/float64 used to be completely unreachable - no literal syntax produced either, and nothing
## implicitly widened into them (see the report). A numeric literal (including one negated by a single
## leading unary "-", now itself considered a literal - see the report) implicitly widens into any
## numeric type it's used against, wherever exact type-matching would otherwise be required: an
## assignability context (a var-decl, here) or a same-type-requiring binary operator (arithmetic,
## comparison, and bitwise alike - not just "+ - * / %", which is all the spec originally promised).
test "a numeric literal widens into int64/float64, including negative ones, everywhere exact matching is required" {
    a mut int64 = 5
    assert(a == 5)
    b mut int64 = -5
    assert(b == -5)
    c mut float64 = 5.5
    assert(c == 5.5)
    d mut float64 = -5.5
    assert(d == -5.5)
    e mut float32 = 5
    assert(e == 5.0)
    x mut int64 = 100
    assert(x + 5 == 105)
    assert(x - 5 == 95)
    assert(x % 3 == 1)
    assert((x & 12) == 4)
    assert(x < 200)
    assert(x > 50)
}

## addLong was declared but never callable at all before this - there was no way to construct an int64
## value to pass it (see the report).
test "addLong, previously unreachable for lack of any way to construct an int64, now works" {
    assert(addLong(3, 4) == 7)
}

## the explicit TypeName(x) conversion builtin (see the report) - the counterpart to implicit literal
## widening above, covering every direction that never widens a literal: a non-literal value crossing
## numeric types (either direction), and narrowing in particular. byte(300) truncates to 44 (300 mod
## 256) - unchecked, the same well-defined-but-unverified behavior this language already accepts at
## every other point a value can lose information (e.g. array indexing, E16).
test "TypeName(x) explicitly converts a non-literal numeric value in either direction" {
    n mut int32 = 300
    assert(int64(n) == 300)
    big mut int64 = 70000
    assert(int32(big) == 70000)
    bt mut byte = 'A'
    assert(int32(bt) == 65)
    assert(byte(n) == byte(44))
    f mut float32 = 3.75
    assert(int32(f) == 3)
    assert(float32(n) == 300.0)
    assert(float32(bt) == 65.0)
    d64 mut float64 = 2.5
    assert(float32(d64) == 2.5)
    f32 mut float32 = 2.5
    assert(float64(f32) == float64(2.5))
    assert(int32(n) == 300)
}

test "a function passed by name as a value can be called through the receiving parameter" {
    assert(applyToFive(doubleIt) == 10)
    g mut func(n int32) int32 = doubleIt
    assert(g(3) == 6)
}

test "vocab values: construction, equality, and match/case" {
    n mut Direction = Direction.NORTH
    assert(n == Direction.NORTH)
    assert(n != Direction.SOUTH)
    assert(opposite(Direction.NORTH) == Direction.SOUTH)
    assert(opposite(Direction.EAST) == Direction.WEST)
}

test "match selects the right case" {
    assert(describe(1) == 100)
    assert(describe(2) == 200)
    assert(describe(99) == -1)
}

test "do-while accumulates" {
    assert(sumUntil(5) == 15)
}

test "fixed byte arrays compare by value, not identity" {
    a mut byte[] = "hello"
    b mut byte[] = "hello"
    c mut byte[] = "world"
    assert(a == b)
    assert(a != c)
}

test "struct literal construction and structural equality" {
    p mut Point = Point{1, 2}
    q mut Point = Point{1, 2}
    r mut Point = Point{3, 4}
    assert(p.x == 1)
    assert(p.y == 2)
    assert(p == q)
    assert(p != r)
}

test "single-value struct literal" {
    w mut Wrapper = Wrapper{42}
    assert(w.v == 42)
}

test "nested struct literals" {
    l mut Line = Line{Point{1, 2}, Point{3, 4}}
    assert(l.a.x == 1)
    assert(l.a.y == 2)
    assert(l.b.x == 3)
    assert(l.b.y == 4)
}

## a declared runtime-length type ("T[]") whose initializer has a compile-time length adopts it into the
## TYPE, not just the allocation (D12a) - so this is really an int32[3] and interchanges with one. Before
## this the length was inferred for the copy and then discarded: len() compiled to a runtime read even
## here, and an "int32[]" holding 3 was type-identical to one holding 4 (TypeIsSame skips the length
## whenever arrMalloc is set). An initializer with no compile-time length of its own leaves the
## declaration runtime-length, which is the only shape that had a length worth keeping to begin with.
func takesExactlyThree(a int32[3]) int32 {
    return a[0] + a[1] + a[2]
}

func declaredRuntimeLengthAdoptsIt() int32 {
    y mut int32[] = int32[4, 5, 6]
    return takesExactlyThree(y)
}

func initializerWithNoCompileTimeLength(s scope, n int32) int32 {
    src mut int32[n]&s
    src[0] = 11
    z mut int32[] = src
    return len(z) + z[0]
}

## generics (§12): a function is generic exactly when a type variable appears in its signature - there is
## no declaration list, the set IS whatever appears. Type arguments are never written at a call; they are
## inferred by matching the actual argument types against the declared parameter types (G9), which is
## sound because every variable must appear in at least one parameter (G4). Each distinct set of type
## arguments produces one monomorphized copy (G16) - an ordinary function with the variables substituted
## away, to which every other rule in the language then applies unchanged.
func maxOf(a<T>, b<T>) <T> {
    if a > b {
        return a
    }
    return b
}

## a generic calling a generic: checking one copy's body discovers further instantiations, so the
## instantiation queue is drained to a fixed point rather than in a single pass
func maxOfThree(a<T>, b<T>, c<T>) <T> {
    return maxOf(maxOf(a, b), c)
}

## instantiated over a user-defined struct - "==" is the ordinary structural comparison, needing no
## generic-aware version, precisely because by codegen time nothing generic is left
func sameValue(a<T>, b<T>) bool {
    return a == b
}

test "one generic instantiated over several types" {
    assert(maxOf(3, 7) == 7)
    assert(maxOf(int64(3), int64(9)) == int64(9))
    assert(maxOf(float64(1), float64(2)) == float64(2))
}

test "a generic calling a generic cascades instantiation" {
    assert(maxOfThree(1, 5, 3) == 5)
}

test "a generic over a struct type uses ordinary structural equality" {
    assert(sameValue(Point{1, 2}, Point{1, 2}))
    assert(!sameValue(Point{1, 2}, Point{3, 4}))
}

test "the same type arguments reuse one instantiation" {
    assert(maxOf(1, 2) == 2)
    assert(maxOf(8, 4) == 8)
}

## a generic STRUCT type declares its parameters in a "<...>" list after the name (G6). Unlike a
## function's, that list is required, because a type's arguments cannot be inferred - nothing at
## "Pair<int32, int64>" determines them but the writing - so they are supplied positionally, and the
## declared order is what makes positional meaningful (G7). Each distinct argument set is a distinct type
## (G10), which falls out for free: struct identity is owner+name, and an instantiation's name carries
## its own arguments.
type Pair<A, B> struct {
    first <A>,
    second <B>
}

type Box<T> struct {
    v <T>
}

func pairSum(p Pair<int32, int32>) int32 {
    return p.first + p.second
}

func nestedGeneric() int32 {
    n mut Box<Pair<int32, int32>> = Box<Pair<int32, int32>>{Pair<int32, int32>{4, 5}}
    return n.v.first + n.v.second
}

test "a generic struct type instantiates, and its fields take the argument types" {
    p mut Pair<int32, int64> = Pair<int32, int64>{7, int64(9)}
    assert(p.first == 7)
    assert(p.second == int64(9))
}

test "an instantiated generic type crosses a function boundary" {
    assert(pairSum(Pair<int32, int32>{8, 1}) == 9)
}

test "a generic instantiated with another generic's instantiation" {
    assert(nestedGeneric() == 9)
}

## "match <T>" (G13-G15) dispatches on a type parameter. It is resolved when the generic is instantiated,
## not at run time: there is no comparison and no branch in the generated code, only the selected arm's
## statements. Two properties make it more than a runtime switch. G14: inside the selected arm the type
## variable IS the concrete type, so "v + 1" below is valid only in the int32 arm and "v.x" only in the
## Point arm - unselected arms are never built at all. G15: unlike a match over a value (S13), a match
## over a type is exhaustiveness-checked at the instantiation, since falling through silently would
## compile a generic that does nothing for some of its instantiations.
func describeType(v<T>) int32 {
    match <T> {
        case int32 {
            return v + 1
        }
        case int64 {
            return 64
        }
        case Point {
            return v.x
        }
    }
}

test "a type match selects a different arm per instantiation" {
    assert(describeType(41) == 42)
    assert(describeType(int64(1)) == 64)
    assert(describeType(Point{7, 8}) == 7)
}

## a type variable is usable as an ordinary type inside a generic body, not only in the signature
func copyThrough(a<T>) <T> {
    x mut <T> = a
    return x
}

test "a type variable used as a type inside the body" {
    assert(copyThrough(42) == 42)
    assert(copyThrough(int64(7)) == int64(7))
}

## D14a: a constructor field may be a run-time-sized array, sized by an expression that can name the
## constructor's own parameters. This is what makes a struct able to OWN a buffer at all - before it,
## "T[expr]" was var-decl-only and nothing produced a runtime-sized array as a value, so no struct could
## hold one. The field's scope tag is required, not optional: an untagged one is allocated into the
## constructor's own scope, which closes before the constructed value reaches its caller. That was not
## merely a leak - the freed chunk was immediately reused for the constructed struct itself, so a later
## write through the field landed on the struct's own length word and corrupted it.
type Buffer struct(s scope, cap int64) {
    data mut byte[cap]&s,
    used int64 = 0
}

func bufferLenAfterWrite(n int64) int64 {
    b mut Buffer& = Buffer(own, n)
    b.data[0] = byte(65)
    return int64(len(b.data))
}

func bufferReadAfterWrite(n int64) int64 {
    b mut Buffer& = Buffer(own, n)
    b.data[0] = byte(65)
    return int64(b.data[0])
}

test "a run-time-sized constructor field is sized per construction" {
    assert(bufferLenAfterWrite(10) == 10)
    assert(bufferLenAfterWrite(3) == 3)
}

test "writing through a run-time-sized constructor field does not corrupt its length" {
    assert(bufferReadAfterWrite(10) == 65)
    assert(bufferLenAfterWrite(10) == 10)
}

## D14a and generics together: a generic struct type declaring a CONSTRUCTOR - which is what makes a real
## "Vec<T>" expressible, and is exactly the example G6 states. Both halves of the type are generic and
## both are monomorphized: the copy gets its own layout AND its own constructor, whose parameters and
## field expressions are built against the substituted types (G16). Before this the whole combination was
## unreachable: there was no "Vec<int32>(...)" call syntax at all, and since a type declaring a
## constructor rejects the "Type{...}" literal (C8), a generic type with one could not be constructed by
## any spelling - merely declaring one crashed the compiler, because the generic's own constructor was
## emitted as if it were an ordinary function and its parameters still named type variables.
type Vec<T> struct(s scope, cap int64) {
    items mut <T>[cap]&s,
    len mut int64 = 0
}

func vecRoundTrip() int32 {
    v mut Vec<int32> = Vec<int32>(own, 4)
    v.items[0] = 11
    v.items[3] = 22
    v.len = 2
    return v.items[0] + v.items[3] + int32(v.len) + int32(len(v.items))
}

## two instantiations of one generic type are separate types with separate layouts and separate
## constructors - the element sizes here differ, so a shared constructor would mis-size the buffer
func vecFloatRoundTrip() float64 {
    v mut Vec<float64> = Vec<float64>(own, 2)
    v.items[1] = 2.5
    return v.items[1] + float64(len(v.items))
}

test "a generic type's constructor is monomorphized alongside the type" {
    assert(vecRoundTrip() == 39)
    assert(vecFloatRoundTrip() == 4.5)
}

## a generic type's constructor body is checked and built per instantiation like any other body, so it can
## call a generic function - which instantiates further copies while the type copies are still draining
type Wrapped<T> struct(v <T>) {
    val <T> = copyThrough(v)
}

test "a generic type's constructor calling a generic function" {
    w mut Wrapped<int32> = Wrapped<int32>(9)
    q mut Wrapped<int64> = Wrapped<int64>(int64(3))
    assert(w.val == 9)
    assert(q.val == int64(3))
}

## a generic type may declare a destructor, and it is monomorphized too - each instantiation gets its own
## destructor symbol. C11 applies unchanged: the type is reference-only, so every use writes the marker.
## (The instantiated constructor's return type must be the copy's own stable slot, not a snapshot taken
## before its destructor was attached - a snapshot froze the GENERIC's destructor into the constructed
## value's type, so every construction registered a symbol that was never emitted.)
type Tracked<T> struct(v <T>) {
    val <T> = v
} destruct {
    resourcesClosed = resourcesClosed + 1
}

func trackedInt() int32 {
    t mut Tracked<int32>& = Tracked<int32>(4)
    return t.val
}

func trackedFloat() float64 {
    t mut Tracked<float64>& = Tracked<float64>(2.5)
    return t.val
}

test "a generic type's destructor is monomorphized per instantiation" {
    resourcesClosed = 0
    assert(trackedInt() == 4)
    assert(resourcesClosed == 1)
    assert(trackedFloat() == 2.5)
    assert(resourcesClosed == 2)
}

## exercises the scope runtime under load: every allocation is rounded up to 8 bytes so the next one
## starts aligned (a raw byte bump left a 12-byte "int32[3]" followed by an i64- or pointer-bearing
## allocation misaligned - UB at the LLVM level even where the hardware tolerates it); destructor list
## nodes are bump-allocated from the scope's own arena rather than each getting its own malloc/free; and
## closing splices the chunk list onto the global pool in O(1) via a recorded tail rather than walking to
## find it. 200 scope closes x 50 iterations, mixing all three allocation shapes.
type Wide struct {
    a int64,
    b int64
}

func mixedAlignment(n int32) int32 {
    total mut int64 = 0
    for i mut int32 = 0, i < n, i++ {
        odd mut int32[]& = int32[1, 2, 3]
        w mut Wide& = Wide{7, 8}
        h mut Handle& = Handle(i)
        total = total + w.a + int64(odd[0]) + int64(h.id)
    }
    return int32(total)
}

func manyChunks(rounds int32, per int32) int32 {
    acc mut int32 = 0
    for r mut int32 = 0, r < rounds, r++ {
        acc = acc + mixedAlignment(per)
    }
    return acc
}

test "scope runtime: mixed-alignment allocations interleaved across many scope closes" {
    resourcesClosed = 0
    n int32 = manyChunks(200, 50)
    assert(n == 200 * (50 * 8 + 49 * 50 / 2))
    assert(resourcesClosed == 200 * 50)
}

## "&" on a parameter names the CALLER's own instance, and "mut" means what it means everywhere else
## (this can be assigned to). The two are independent axes: "&" says whose instance it is, "mut" says
## whether it can be written. So mutation visibility is readable from the signature alone, with no
## reasoning about scopes or durability at the call site.
##   p Point       a copy;                  caller unaffected either way
##   p mut Point   a copy the callee writes; caller still unaffected
##   p Point&      the caller's instance, read-only
##   p mut Point&  the caller's instance, writable - the caller sees it
## This only holds because a VALUE may no longer be silently promoted into a "&" parameter when the
## caller named it (an lvalue): otherwise "&" would sometimes mean "your instance" and sometimes "a copy
## of it", and a "mut" parameter could write to a copy the caller never sees. A freshly built temporary
## (a literal, or a constructor call's result) has no caller-side instance to preserve and still promotes.
func writesThroughRef(p mut Point&) int32 {
    p.x = 99
    return p.x
}

func readsThroughRef(p Point&) int32 {
    return p.x
}

func callerSeesTheWrite() int32 {
    r mut Point& = Point{1, 2}
    n int32 = writesThroughRef(r)
    return r.x + n * 0
}

test "a 'mut &' parameter writes to the caller's own instance" {
    assert(callerSeesTheWrite() == 99)
}

test "a non-mut '&' parameter still reads it" {
    r mut Point& = Point{5, 6}
    assert(readsThroughRef(r) == 5)
}

## C3: a constructor field is mutable only if declared "mut". This was recorded correctly at declaration
## but never checked: OperandIsMutableLvalue's OPERATION_MEMBER case recursed on the BASE alone, so every
## field of a mutable variable was writable regardless of how it was declared. A plain (T13) struct's
## fields carry mut = true (that grammar has no "mut" at all) and are unaffected - both are covered here.
type MutFields struct(locked int32, open int32) {
    locked,
    open mut
}

type PlainFields struct {
    a int32,
    b int32
}

func writesMutCtorField() int32 {
    c mut MutFields = MutFields(1, 2)
    c.open = 99
    return c.open + c.locked
}

func writesPlainField() int32 {
    p mut PlainFields = PlainFields{1, 2}
    p.a = 99
    return p.a
}

test "a 'mut' constructor field is writable" {
    assert(writesMutCtorField() == 100)
}

test "a plain struct's fields stay writable" {
    assert(writesPlainField() == 99)
}

test "a declared 'T[]' adopts its initializer's compile-time length into the type" {
    assert(declaredRuntimeLengthAdoptsIt() == 15)
}

test "a 'T[]' initialized from a runtime-length value stays runtime-length" {
    assert(initializerWithNoCompileTimeLength(own, 4) == 15)
}

test "array literal construction, compile-time- and runtime-length" {
    fixed mut int32[] = int32[10, 20, 30]
    dyn mut int32[] = int32[10, 20, 30]
    assert(fixed[0] == 10)
    assert(fixed[2] == 30)
    assert(dyn[0] == 10)
    assert(dyn[2] == 30)
}

## the compile-time-to-runtime-length promotion above used to only fire for a FRESH literal (op->isLiteral in
## OperandFitsType) - an already-existing compile-time-length-array VALUE (a plain variable, not a literal) flowing into
## a runtime-length target was rejected outright. Relaxed once confirmed there's no real mechanism difference for
## codegen to worry about (unlike int->float widening, which genuinely needs different instructions for a
## literal vs. a non-literal): cgPromoteFixedToRuntimeLength only ever needs a source ADDRESS to copy from,
## which cgValue's by-ref convention already provides for any embedded array regardless of where it came
## from - see the report. "src" here is a genuine local variable, not a literal; mutating it afterward
## proves the promotion is a real, independent copy, not an alias of the source's own storage.
test "an existing (non-literal) compile-time-length-array value promotes into a runtime-length target too" {
    src := int32[10, 20, 30]
    copied mut int32[] = src
    src[0] = 999
    assert(copied[0] == 10)
    assert(copied[1] == 20)
    assert(copied[2] == 30)
}

## a single-value (or empty) array literal was structurally impossible under the old "T[N][v1, ...]"/
## "T[][v1, ...]" syntax (the mandatory value-list bracket was indistinguishable from a trailing size
## suffix, so it got silently swallowed and the whole literal misparsed as indexing instead) - the new
## "T[v1, ...]" syntax has no suffix loop to cause that, so both now just work.
test "a single-value and an empty array literal both parse correctly" {
    one mut int32[] = int32[42]
    assert(one[0] == 42)
    empty mut int32[] = int32[]
    assert(len(empty) == 0)
}

## the array literal itself never restates a type - "Point" (a struct type) works exactly like "int32"
## does, each element checked against it the same way a struct literal checks each field
test "an array literal of struct values" {
    pts mut Point[] = Point[Point{1, 2}, Point{3, 4}]
    assert(pts[0].x == 1)
    assert(pts[1].y == 4)
}

## an int literal correctly widens to float here the same way it does anywhere else an int-to-float fit is
## checked (OperandFitsType) - also exercises a real, pre-existing bug this surfaced and fixed: widening
## only ever updated the operand's TYPE, never its VALUE, so cgFloatConst (codegen.c) read an
## uninitialized floatLiteralVal and silently produced 0.0 - invisible before now because nothing in the
## existing suite passed a bare int literal where a float was expected.
test "an int literal widens to float inside an array literal" {
    f mut float32[] = float32[1, 2.5]
    assert(f[0] == 1.0)
    assert(f[1] == 2.5)
}

## "&"/"&name" now apply to arrays exactly the same way they already apply to structs - reusing
## structMAlloc/scopeParam generically rather than duplicating the whole marker mechanism (see the
## report). Only the compile-time-length case is wired up so far: a "&"-heap-indirect array with a known
## compile-time length ("int32[3]&") is just a bare pointer, the same free lunch a struct reference
## already gets, going through the exact same malloc-promotion/scope-arena machinery. A genuinely
## runtime-length ("int32[]&") reference is deliberately not addressed yet - see the report.
func makeFixedArrayRef(s scope) int32[3]&s {
    return int32[7, 8, 9]
}

## array suffixes wrap outer-first: "int32[2][3]" is an array of 2, each element an int32[3] - reading
## the dimensions left to right, not the old (pre-this-feature) inside-out wrapping order. The literal
## itself never restates this - "int32" (the scalar base) is only ever stated once, at the very front;
## each nested "[...]" row needs no type of its own - see the report.
func makeFixed2DRef(s scope) int32[2][3]&s {
    return int32[[1, 2, 3], [4, 5, 6]]
}

## "T[expr]" with no initializer (expr not a compile-time constant) - a runtime-sized array, arena-
## allocated into the declared "&name" tag rather than "own" (see the report and OPERATION_SIZED_ARRAY_
## ALLOC): unlike a compile-time-length reference, this can never be embedded (no compile-time offset is possible
## for a runtime-known length), so it's implicitly reference-shaped even here, without writing "&s" a
## second time on the local itself.
func makeSizedArrayRef(s scope, n int32) int32[]&s {
    result mut int32[n]&s
    result[0] = 42
    return result
}

test "a compile-time-length array reference survives crossing a function boundary via a named scope" {
    a mut int32[3]& = makeFixedArrayRef(own)
    assert(a[0] == 7)
    assert(a[2] == 9)
}

test "a 2D compile-time-length array reference - outer dimension first" {
    m mut int32[2][3]& = makeFixed2DRef(own)
    assert(m[0][0] == 1)
    assert(m[1][2] == 6)
}

## unlike C, an olang array always carries its own length - len() is the sanctioned way to read it.
## Compile-time-known dimensions (embedded, or a compile-time-length "&" reference) cost nothing at runtime;
## only a genuinely runtime-length array reads its length from the runtime slice - see OperandLen/cgLen.
test "len() works uniformly across embedded, fixed-reference, 2D, and runtime-length arrays" {
    embedded mut int32[] = int32[1, 2, 3, 4]
    assert(len(embedded) == 4)

    ref mut int32[3]& = makeFixedArrayRef(own)
    assert(len(ref) == 3)

    m mut int32[2][3]& = makeFixed2DRef(own)
    assert(len(m) == 2)
    assert(len(m[0]) == 3)

    dyn mut int32[] = int32[10, 20, 30]
    assert(len(dyn) == 3)
}

test "struct literal as a match case value" {
    assert(classifyPoint(Point{1, 2}) == 100)
    assert(classifyPoint(Point{3, 4}) == 200)
    assert(classifyPoint(Point{9, 9}) == -1)
}

test ":= infers a variable's type from its literal initializer" {
    x := 5
    y mut := 7
    y = y + 1
    assert(x == 5)
    assert(y == 8)
}

test "try/catch: SafeDiv succeeds on a non-zero divisor" {
    failed mut bool = false
    try SafeDiv(10, 2) catch MathError {
        failed = true
    }
    assert(!failed)
}

test "try/catch: SafeDiv reports failure on divide by zero" {
    failed mut bool = false
    try SafeDiv(10, 0) catch MathError {
        failed = true
    }
    assert(failed)
}

test "the bare error: success path is unaffected by the mixed error union" {
    failed mut bool = false
    try mightFailWithBareError(5) catch error + RangeError {
        failed = true
    }
    assert(!failed)
}

test "the bare error: a real named type sharing the same union is still caught separately" {
    result mut int32 = 0
    try mightFailWithBareError(200) catch error + RangeError {
        result = -1
    }
    assert(result == -1)
}

## "catch error" matches only the bare error, never a real named type sharing the same union - proven
## by construction, not by testing a wrong answer: onlyGenericEscapes handles RangeError fully itself
## (never needs to appear in its own signature, R13), leaving only the bare error to actually escape -
## so "catch error" alone is sufficient to cover it below, which it provably would NOT be if the generic
## marker matched RangeError too (RangeError would then need declaring here as well, and doesn't).
func onlyGenericEscapes(n int32) int32 ? error {
    try mightFailWithBareError(n) catch RangeError {
        return -2
    }
    return n
}

test "the bare error: catch matches only the bare error, not a real named type also in the union" {
    result mut int32 = 0
    try onlyGenericEscapes(-1) catch error {
        result = -99
    }
    assert(result == -99)
}

test "own passes a test's own scope down to a scope-parameterized function" {
    p mut Point& = makePoint(3, 4, own)
    assert(p.x == 3)
    assert(p.y == 4)
}

test "a plain struct literal promotes correctly into a heap-indirect parameter and return type" {
    assert(takesHeapPoint(Point{5, 6}) == 5)
    q mut Point& = returnsHeapPoint(own)
    assert(q.x == 9)
    assert(q.y == 8)
}

test "the real arena allocator handles chunk growth and reuse across many scope open/close cycles" {
    expectedOneRound mut int32 = 0
    i mut int32 = 0
    do {
        expectedOneRound = expectedOneRound + i
        i++
    } while i < 300
    round mut int32 = 0
    total mut int32 = 0
    do {
        total = total + sumManyPoints(300, own)
        round++
    } while round < 10
    assert(total == expectedOneRound * 10)
}

test "constructor: every field a bare pun" {
    c mut Counter = Counter(5)
    assert(c.start == 5)
}

test "constructor: a computed field alongside a punned one" {
    r mut Rectangle = Rectangle(3)
    assert(r.n == 3)
    assert(r.doubled == 6)
}

test "constructor: a fallible field initializer propagates through the constructor's own declared error union" {
    failed mut bool = false
    try Measurement(-1) catch ValidationError {
        failed = true
    }
    assert(failed)

    failed2 mut bool = false
    try measurementValue(5) catch ValidationError {
        failed2 = true
    }
    assert(!failed2)
}

test "destructor runs when the instance's own scope closes at function return" {
    before mut int32 = resourcesClosed
    result mut int32 = useHandleLocally()
    assert(result == 7)
    assert(resourcesClosed == before + 1)
}

test "an instance tagged to a passed-in scope outlives the function that constructed it" {
    before mut int32 = resourcesClosed
    h mut Handle& = makeHandle(42, own)
    ## makeHandle has already returned - h was registered with the caller's scope at construction, so
    ## nothing fired when makeHandle returned; if it had, resourcesClosed would be before+1 here
    assert(resourcesClosed == before)
    assert(h.id == 42)
}

test "deferral is scoped to exactly the caller-tagged instance, not every instance in that function" {
    before mut int32 = resourcesClosed
    kept mut Handle& = makeAndDiscardOne(1, own)
    ## "discard" (tagged to makeAndDiscardOne's own scope) is already destructed by the time that
    ## function returns; "kept" survives into this scope, so exactly one destructor has fired so far
    assert(resourcesClosed == before + 1)
    assert(kept.id == 1)
}

test "destructor runs for every heap-indirect instance when their scope closes, in one batch" {
    before mut int32 = resourcesClosed
    total mut int32 = useManyHandlesLocally(5)
    assert(total == 0 + 1 + 2 + 3 + 4)
    assert(resourcesClosed == before + 5)
}

## the two marker POSITIONS are different types, and both are meaningful: "Point&[3]" is 3 separately
## allocated references (elements have identity), "Point[3]&" is one reference to 3 inline values. Before
## the pre-suffix position existed, an array of references was not expressible at all - for any type, not
## just destructor-bearing ones - and this had to be faked with a value struct wrapping a reference.
func makePointsRef(s scope) Point&[2]&s {
    return Point&[Point{1, 2}, Point{3, 4}]
}

## an element-position marker may not carry a scope NAME: a reference nested inside a larger value always
## inherits its container's scope (never an independent tag), so codegen allocates every element into the
## array's own scope regardless of what the element marker says. Accepting a name would compile
## "Handle&s[3]" and "Handle&[3]" identically - an accepted-but-meaningless tag - so it is rejected.
## Confirmed by construction: a bare-"&"-element array returned as "&s" has its elements survive into s,
## not die with the callee's own scope, which is exactly why an independent element tag is meaningless.
func elementsFollowTheArraysScope(s scope) Handle&[2]&s {
    return Handle&[Handle(50), Handle(51)]
}

test "elements of a returned array follow the array's own scope, not the callee's" {
    before mut int32 = resourcesClosed
    arr mut Handle&[2]& = elementsFollowTheArraysScope(own)
    ## elementsFollowTheArraysScope has returned and its own scope has closed; if the bare-"&" elements
    ## had been allocated there they would already be destructed rather than still readable here
    assert(resourcesClosed == before)
    assert(arr[0].id == 50)
}

test "an array of references and a reference to an array of values are both expressible" {
    refs mut Point&[2]& = makePointsRef(own)
    assert(refs[0].x == 1)
    assert(refs[1].y == 4)
    vals mut int32[3]& = makeFixedArrayRef(own)
    assert(vals[0] == 7)
}

test "destructor runs for every handle held through an array of references" {
    before mut int32 = resourcesClosed
    total mut int32 = useHandleArrayLocally()
    assert(total == 20 + 21 + 22)
    assert(resourcesClosed == before + 3)
}

test "destructor runs for every handle in a fixed literal promoted into a runtime-length array" {
    before mut int32 = resourcesClosed
    total mut int32 = useHandleArrayLocallyRuntimeLength()
    assert(total == 30 + 31 + 32)
    assert(resourcesClosed == before + 3)
}

## the old "every slot of a runtime-sized ('T[expr]') array of destructor-bearing elements registers a
## destructor up front, zero-filled or not" behaviour is deliberately gone: zero-filling constructs no
## instances (O16), so there is nothing to destruct, and a destructor-declaring element type is
## reference-only (C11) - which the existing zero-fill rule already rejects outright, since a reference
## has no zero value. Both halves are covered: this file's ZERO_FILL_CONTAINS_REFERENCE cases cover the
## rejection, and the two array tests above cover the shape that does work.
## the three bugs the reference-only rule closed, kept as permanent regression coverage. All three were
## the same root cause - a destructor is an identity claim, and value semantics has no instance count:
## (1) passing by value destructed the CALLEE's copy at its return, releasing the caller's resource while
## the caller's own variable was still live (then destructing it again later); (2) a destructor-bearing
## field of a plain struct never destructed at all, while the constructor's own parameter copy destructed
## early; (3) a plain local array of destructor-bearing values registered nothing whatsoever. None are
## expressible any more - a destructor-declaring type is reference-only - so what these now check is that
## the surviving shapes count instances, not storage locations.
func consumeHandle(h Handle&) int32 {
    return h.id
}

func passAndCheck() int32 {
    local mut Handle& = Handle(3)
    n int32 = consumeHandle(local)
    ## read while local is still live: nothing may have fired yet
    return resourcesClosed + n * 0
}

func copyHandleAround() int32 {
    a mut Handle& = Handle(9)
    b mut Handle& = a
    return b.id
}

test "passing an instance to a function does not release the caller's resource" {
    resourcesClosed = 0
    seen int32 = passAndCheck()
    assert(seen == 0)
}

test "copying a reference is the same instance, destructed exactly once" {
    before mut int32 = resourcesClosed
    n int32 = copyHandleAround()
    assert(n == 9)
    assert(resourcesClosed == before + 1)
}

test "constructing zero instances runs zero destructors" {
    before mut int32 = resourcesClosed
    total mut int32 = useManyHandlesLocally(0)
    assert(total == 0)
    assert(resourcesClosed == before)
}

## "assert" is a statement (takes its operand directly like "return" does), not a function call - every
## other test in this file still spells it "assert(cond)", which keeps working unchanged since "(cond)" is
## just an ordinary parenthesized sub-expression; this is the one test exercising the bare "assert cond"
## form with no parens at all, to keep both spellings under test
test "assert without parentheses" {
    x mut int32 = 5
    assert x == 5
    assert add(2, 3) == 5
    assert !(x == 6)
}

test "a bare '&' field assigned through a scope-tagged parameter survives the callee's return" {
    box mut BoxedPoint& = BoxedPoint{1, Point{0, 0}}
    result mut int32 = fillBoxedPoint(own, box, 7, 8)
    assert(result == 7)

    ## force reuse of fillBoxedPoint's own now-closed private scope's chunk - would corrupt "inner" if it
    ## had dangled into that scope instead of the one actually passed in
    noise mut int32 = 0
    i mut int32 = 0
    do {
        noise = noise + noisePoint(i)
        i++
    } while i < 20

    assert(box.inner.x == 7)
    assert(box.inner.y == 8)
}

test "a parameter type may reference an earlier parameter as its scope tag" {
    r mut int32 = takesScopedPoint(own, Point{1, 2})
    assert(r == 1)
}

test "a constructor field's scope tag, referencing the constructor's own scope parameter, survives the constructor call returning" {
    q mut Point& = fillBoxViaCtor(own)
    assert(q.x == 7)
    assert(q.y == 8)

    ## force reuse of fillBoxViaCtor's own now-closed private scope's chunk - would corrupt "q" if
    ## ScopedBox's "inner" field had actually landed there instead of in "outer" (own, passed in)
    noise mut int32 = 0
    i mut int32 = 0
    do {
        noise = noise + noisePoint(i)
        i++
    } while i < 20

    assert(q.x == 7)
    assert(q.y == 8)
}

test "a struct returned entirely by value still compiles fine when its nested reference field is named, not bare" {
    box mut ScopedBox = makeScopedBoxPlain(own, 3, 4)
    assert(box.inner.x == 3)
    assert(box.inner.y == 4)
}

test "a plain struct's bare '&' field survives a function boundary by inheriting its container's own target scope" {
    nb mut NestedBox& = makeNestedBox(own, 11, 22)
    assert(nb.inner.x == 11)
    assert(nb.inner.y == 22)

    ## force reuse of makeNestedBox's own now-closed private scope's chunk - would corrupt nb.inner if
    ## "inner" had actually landed there instead of in the caller's own scope, tagged via "s"
    noise mut int32 = 0
    i mut int32 = 0
    do {
        noise = noise + noisePoint(i)
        i++
    } while i < 20

    assert(nb.inner.x == 11)
    assert(nb.inner.y == 22)
}

test "a bare '&' field assigned through a two-hop chain of bare '&' bases resolves to the outermost named scope" {
    co mut ChainOuter& = ChainOuter{ChainMid{Point{0, 0}}}
    r mut int32 = setChainLeaf(own, co, 5, 6)
    assert(r == 0)
    assert(co.mid.leaf.x == 5)
    assert(co.mid.leaf.y == 6)

    ## force reuse of setChainLeaf's own now-closed private scope's chunk - would corrupt co.mid.leaf if
    ## the old one-hop-only resolution (which only ever looked at "co.mid" itself, always bare, and so
    ## always fell back to "whatever function is executing right now") had actually been used here
    noise mut int32 = 0
    i mut int32 = 0
    do {
        noise = noise + noisePoint(i)
        i++
    } while i < 20

    assert(co.mid.leaf.x == 5)
    assert(co.mid.leaf.y == 6)
}

test "the static scope checker allows a received named scope to narrow into this function's own bare '&' scope" {
    r mut int32 = narrowNamedIntoOwn(own)
    assert(r == 7)
}

test "the static scope checker verifies a constructor field's scope tag through a call's own binding map" {
    b mut Point& = fillBoxViaCtorChecked(own, 3, 4)
    assert(b.x == 3)
    assert(b.y == 4)
}

test "the static scope checker verifies an ordinary function's return-type scope tag through a call's own binding map" {
    p mut Point& = makePointChecked(own, 5, 6)
    assert(p.x == 5)
    assert(p.y == 6)
}

test "the static scope checker traces a scope tag through a field of a field, not just one level" {
    p mut Point& = fieldOfFieldChecked(own, 9, 10)
    assert(p.x == 9)
    assert(p.y == 10)
}

test "the static scope checker traces a scope tag through a bare-pun field, not just an explicit one" {
    p mut Point& = makePunnedBoxChecked(own, 11, 12)
    assert(p.x == 11)
    assert(p.y == 12)
}

test "the static scope checker disambiguates two bare-pun fields of the same type tagged to different scopes" {
    p mut Point& = dualWrappedFieldChecked(own, 13, 14, 15, 16)
    assert(p.x == 13)
    assert(p.y == 14)
}

test "the static scope checker resolves a scope tag through three levels of nested bare-pun forwarding" {
    p mut Point& = holderFieldChecked(own, 17, 18, 19, 20)
    assert(p.x == 17)
    assert(p.y == 18)
}

test "two same-typed sibling fields at different nesting depths never collide" {
    a mut Point& = siblingPairOneChecked(own, own, 21, 22, 23, 24)
    assert(a.x == 21)
    assert(a.y == 22)
    b mut Point& = siblingPairTwoLeafChecked(own, own, 21, 22, 23, 24)
    assert(b.x == 23)
    assert(b.y == 24)
}

test "the static scope checker tracks a var's scope binding through a plain reassignment" {
    p mut Point& = reassignSameScopeChecked(own, 11, 12)
    assert(p.x == 11)
    assert(p.y == 12)
}

test "the static scope checker merges two branches that reassign a var to the same agreed scope" {
    p mut Point& = reassignBothBranchesAgreeChecked(own, true, 13, 14)
    assert(p.x == 13)
    assert(p.y == 14)
    q mut Point& = reassignBothBranchesAgreeChecked(own, false, 13, 14)
    assert(q.x == 14)
    assert(q.y == 13)
}

## scopeCanFlowInto used to treat a scope tag it couldn't trace back to the current function's own
## parameters as "unverifiable, so allow" - optimistic, not sound. User-caught: a compile-time-length array whose element
## type is itself constructor-bearing with a "&name"-tagged field (e.g. "Wrapper struct(s scope, inner
## Point&s) { inner }") lets two Wrapper values, each tagged to a genuinely different scope, live side by
## side in one array; reading one back out via an index ("arr[1].inner") composes no scope-tracing at all
## (OPERATION_INDEX, unlike OPERATION_MEMBER, carries no scopeBindings forward), so the resulting reference
## reaches OperandFitsType with its *raw*, unresolved "s" tag - "unverifiable" under the old rule, so it was
## silently accepted regardless of whether the two scopes involved actually agreed. Confirmed by temporarily
## reverting just this one default back to "allow": the array-index example below compiled and ran with no
## complaint at all - a real, exploitable hole, not a hypothetical one.
## Fixed at the root: scopeCanFlowInto now rejects anything it cannot trace, the same as an actually-proven-
## unsafe flow (semantic.c) - "can't prove it's safe" must mean reject, not optimistically pass, for a
## checker whose whole point is a compile-time proof. This did require a real, separate fix alongside the
## flip, not just the flip alone: a callee's own parameter type can carry a "&name" tag naming one of
## *that callee's own* scope parameters (never the caller's, e.g. fillBoxedPoint/setChainLeaf above, both
## already exercised by permanent tests) - OperandFuncCall now resolves that tag through the call's own
## argument-to-parameter binding before checking fit, so the common, actually-sound case doesn't spuriously
## reject once "unverifiable" stopped meaning "allow."
## The array-index shape is now correctly rejected at compile time - not testable here since a rejected
## program can't run as a test{} block; verified ad hoc during development instead:
##   wa mut Wrapper = Wrapper(a, Point{1, 2})
##   wb mut Wrapper = Wrapper(b, Point{3, 4})
##   arr mut Wrapper[] = Wrapper[wa, wb]
##   leaked mut Point&a = arr[1].inner   ## rejected: arr[1]'s own scope tag is untraceable, not "a"

## "T[N]" with no initializer - real BSS-style zero-fill (see the report and zeroGlobal's own declaration
## above). Both a global and a local go through the exact same mechanism: leaving the var-decl's rhs NULL,
## so codegen (cgVarDecl) stores cgZeroValue's "zeroinitializer" instead of evaluating anything.
test "'T[N]' with no initializer zero-fills a global (real BSS)" {
    assert(zeroGlobal[0] == 0)
    assert(zeroGlobal[4] == 0)
    zeroGlobal[1] = 3
    assert(zeroGlobal[1] == 3)
}

test "'T[N]' with no initializer zero-fills a local" {
    a mut int32[5]
    assert(a[0] == 0)
    assert(a[4] == 0)
    a[2] = 9
    assert(a[2] == 9)
}

## "T[expr]" with no initializer, expr not a compile-time constant - arena-allocated (own by default) and
## zero-filled, like C's alloca but tied to a scope's FILO lifetime rather than the call stack (see
## OPERATION_SIZED_ARRAY_ALLOC and the report). "n" is an ordinary mutable local, never folded by
## tryEvalConstIntExpr, so this always takes the runtime-sized path, never the constant "T[N]" one.
test "'T[expr]' with no initializer arena-allocates a zero-filled array sized at runtime, own scope by default" {
    n mut int32 = 4
    a mut int32[n]
    assert(len(a) == 4)
    assert(a[0] == 0)
    assert(a[3] == 0)
    a[2] = 7
    assert(a[2] == 7)
}

test "a runtime-sized array tagged to a named scope survives a function boundary" {
    a mut int32[]& = makeSizedArrayRef(own, 5)
    assert(len(a) == 5)
    assert(a[0] == 42)
    assert(a[1] == 0)
    assert(a[4] == 0)
}

## The zero-fill above is only sound because int32/Point/etc. have a real, meaningful zero value at every
## level. A reference ("&"/"&name", or a runtime-length array, T11's "always reference-shaped, marker or not")
## has none - there is no null literal anywhere in this language, so zero-filling one would silently
## produce an invisible dangling/null reference (a struct or compile-time-length array's own marker) or a phantom "empty"
## array that was never actually allocated (a runtime-length array nested somewhere inside an otherwise
## zero-fillable compile-time-length declaration). typeContainsReference (semantic.c) now rejects any no-initializer
## array var-decl - compile-time-length or runtime-sized alike - whose declared type contains a reference anywhere
## within it, not just at its own outermost level. All three shapes below are now correctly rejected at
## compile time - not testable here since a rejected program can't run as a test{} block; verified ad hoc
## during development instead:
##   x mut int32[2][]                             (a nested runtime-length array - "jagged", per-row-sized)
##   x mut Point[3]&                              (the declared type is itself a reference)
##   x mut Wrapper[n]                              (Wrapper's own field is "&name"-tagged, n runtime-sized)

## "extern func" (§11): declares a real libc/POSIX symbol, resolved by the linker at build time - see the
## report. getpid takes no arguments and returns a plain scalar; write exercises the array-marshalling path
## (X3: a "byte[]" argument becomes a raw pointer to its first element, length dropped, passed separately).
extern func getpid() int32
extern func write(fd int32, buf byte[], count int64) int64

test "'extern func' links against and calls a real external scalar-only function" {
    pid int32 = getpid()
    assert(pid > 0)
}

test "'extern func' marshals a byte[] argument to a raw pointer at the call boundary" {
    msg mut byte[] = "unused - fd -1 always fails before this is read"
    n int64 = write(-1, msg, int64(len(msg)))
    assert(n < 0)
}
