# Foundational types and functions - no imports. The base of this suite's import graph; worker.olang
# and runner.olang both import this file, and also import each other (a genuine cycle - see runner.olang).

type Point struct(x I32, y I32) {
    x mut
    y mut
}

type Line struct(a Point, b Point) {
    a mut
    b mut
}

# a genuinely single-field struct - single-value struct literals ("Wrapper(42)") were impossible before
# the hand-written, type-aware parser (a lone value inside "{}" was always indistinguishable from an
# ordinary index/block by the old table-driven engine - see CLAUDE.md), so this exists specifically to
# keep that capability under test, not just the multi-field case every other Point literal already covers
type Wrapper struct(v I32) {
    v mut
}

type Direction enum {
    NORTH
    SOUTH
    EAST
    WEST
}

error MathError {
    DIV_BY_ZERO
    OVERFLOW
}

error RangeError {
    TOO_SMALL
    TOO_LARGE
}

fn add(a I32, b I32) I32 {
    return a + b
}

fn factorial(n I32) I32 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn addLong(a I64, b I64) I64 {
    return a + b
}

fn takesByte(b U8) U8 {
    return b
}

fn average(a F32, b F32) F32 {
    return (a + b) / 2.0
}

fn isDigit(c U8) Bool {
    return c >= '0' and c <= '9'
}

fn setBit(flags I32, bit I32) I32 {
    return flags | (1 << bit)
}

fn doubleIt(n I32) I32 {
    return n * 2
}

# a bare read of a global FUNCTION (as opposed to a local/parameter that merely *holds* a function
# pointer) used to have no real storage slot to load through - the mangled function symbol IS its own
# address already (an LLVM `define`, not a `global`) - so loading "through" it read the function's own
# machine code as if it were a stored pointer, segfaulting the instant it was called. See cgValue in
# codegen.c.
fn applyToFive(f fn(n I32) I32) I32 {
    return f(5)
}

# enum values ("Type.WORD") communicate a fixed set and a selection from it - not a C-enum-style number:
# no ordering/arithmetic (rejected the same way any non-numeric type is, see TypeIsNumeric/TypeIsInt),
# only equality/inequality and match/case, both already generic over every type with no enum-specific
# codegen needed.
fn opposite(d Direction) Direction {
    result Direction = Direction.NORTH
    match d {
        case Direction.NORTH {
            result = Direction.SOUTH
        }
        case Direction.SOUTH {
            result = Direction.NORTH
        }
        case Direction.EAST {
            result = Direction.WEST
        }
        case Direction.WEST {
            result = Direction.EAST
        }
        nomatch {
            result = Direction.NORTH
        }
    }
    return result
}

fn describe(n I32) I32 {
    result I32 = 0
    match n {
        case 1 {
            result = 100
        }
        case 2 {
            result = 200
        }
        nomatch {
            result = -1
        }
    }
    return result
}

# match's case values may be struct/array literals, not just scalars - a case value is checked
# structurally against the matched expression (cgDeepEq in codegen.c), not by identity
fn classifyPoint(p Point) I32 {
    result I32 = 0
    match p {
        case Point(1, 2) {
            result = 100
        }
        case Point(3, 4) {
            result = 200
        }
        nomatch {
            result = -1
        }
    }
    return result
}

# O13/O26: a bare "&" result is built where the caller puts it, and "&return" names that scope - so the Point
# is allocated there rather than in makePoint's, which closes at the return.
fn makePoint(x I32, y I32) Point& {
    p Point&return = Point(x, y)
    return p
}

# A plain struct literal (structMAlloc false) fitting a "&"-heap-indirect target (structMAlloc true) is
# allowed by the type checker (TypeIsSame deliberately ignores structMAlloc for structs), so codegen must
# malloc-and-copy at every point that promotion can happen - a var-decl, a call argument, and a return
# value - rather than just aliasing the literal's own (about-to-be-gone) stack storage. See cgStoreInto/
# cgBoundaryValue in codegen.c.
fn takesHeapPoint(p Point&) I32 {
    return p.x
}

fn returnsHeapPoint() Point& {
    return Point(9, 8)
}

# Exercises the real arena allocator (emitScopeRuntime in codegen.c), not just the type-checking: many
# allocations into one still-open scope forces chunk growth (linking on more than one chunk), and calling
# this repeatedly forces __olang_scope_close/__olang_scope_alloc to actually recycle chunks through the
# free pool rather than just malloc-and-leak.
fn sumManyPoints(n I32) I32 {
    total I32 = 0
    for i in range n {
        p Point& = Point(i, i)
        total = total + p.x
    }
    return total
}

# a bare "&" struct field (fields can't carry an explicit "&name" tag yet - no scope-generic struct
# types, see the report) has no declared scope of its own; a field write's promoted literal used to
# always land in "whatever function is executing right now" regardless of which scope the containing
# instance actually belongs to - a real dangling-pointer hazard the instant that function returns, for
# exactly the shape a self-referential struct (a linked list node, say) would need. BoxedPoint exists to
# put that fix under test: its "inner" field is heap-indirect, and NestedBox writes it from inside a
# different function than the one that allocated the containing instance.
type BoxedPoint struct(tag I32, inner mut Point&) {
    tag mut
    inner mut
}

# the narrow fix (not the general one - see the report): when the base of "base.field = ..." is itself a
# "&"-heap-indirect value, the freshly-promoted literal inherits its scope - the parameter's own (O4b) -
# instead of this function's own (about-to-close) private scope
fn fillBoxedPoint(b mut BoxedPoint&, x I32, y I32) I32 {
    b.inner = Point(x, y)
    return b.inner.x
}

# forces reuse of whatever arena chunk fillBoxedPoint's own (now-closed) private scope just freed, by
# allocating something comparably sized right after - if "inner" had dangled into fillBoxedPoint's own
# scope instead of the caller's, this corrupts it and the later read in the test below fails
fn noisePoint(n I32) I32 {
    p Point& = Point(n, n)
    return p.x
}

fn sumUntil(n I32) I32 {
    total I32 = 0
    for i in range 1, n + 1 {
        total = total + i
    }
    return total
}

fn SafeDiv(a I32, b I32) I32 ? MathError {
    if b == 0 {
        error MathError.DIV_BY_ZERO
    }
    return a / b
}

fn CheckRange(n I32, lo I32, hi I32) I32 ? RangeError {
    if n < lo {
        error RangeError.TOO_SMALL
    }
    if n > hi {
        error RangeError.TOO_LARGE
    }
    return n
}

# combines both of this file's error types in one signature, in declaration order (MathError first) -
# worker.olang re-declares the same pair in the OPPOSITE order when it propagates this, exercising the
# error-union ABI's ordinal remap across two differently-ordered signatures
fn ComputeChecked(a I32, b I32, lo I32, hi I32) I32 ? MathError + RangeError {
    if b == 0 {
        error MathError.DIV_BY_ZERO
    }
    result I32 = a / b
    if result < lo {
        error RangeError.TOO_SMALL
    }
    if result > hi {
        error RangeError.TOO_LARGE
    }
    return result
}

# the default error (R15): "?" alone declares a function that can fail without saying how - a plain "error"
# raises it, and an untyped "catch" catches it. A function naming its errors fails with those and nothing else.
fn mightFailWithBareError(n I32) I32 ? {
    if n < 0 { error }
    return n * 2
}

fn mightFailWithRange(n I32) I32 ? RangeError {
    if n > 100 { error RangeError.TOO_LARGE }
    return n * 2
}

# constructors: "type Name struct(params) errorList? { ctor-body } destruct?" - params are the
# constructor's own declared arguments; the body is an ordinary statement block in which a field
# declaration is one more kind of statement (see the report). A field is either a bare pun (binds
# directly to a same-named parameter, type inferred from it - no separate declaration needed) or an
# ordinary var-decl-shaped "name Type = expr" / "name := expr" (never silently inferred - a field always
# states its own type unless it opts into ":=" the same way any other var-decl would). A
# constructor-declaring type stays buildable by the positional "Type{...}" literal too (C6) - the literal
# assembles the fields directly and is the one path back from values already known to be valid.
# Counter is the plain case: every field is a pun, and the whole body is one line - a closing "}"
# terminates the statement before it (L20), so any block at all may be written on one line.
type Counter struct(start I32) { start }

# a field may also be computed from the constructor's parameters via an ordinary expression, alongside a
# punned one - "doubled" has its own type/initializer, "n" is a bare pun
type Rectangle struct(n I32) {
    n
    doubled mut I32 = n * 2
}

error ValidationError {
    NEGATIVE
}

fn checkNonNegative(n I32) I32 ? ValidationError {
    if n < 0 {
        error ValidationError.NEGATIVE
    }
    return n
}

# a constructor may declare its own error union, exactly like a function signature - a fallible field
# initializer needs "try" the same way any fallible call does, and "Measurement(...)" itself becomes a
# fallible call site at every caller, handled by the exact same try/catch machinery as any other function
type Measurement struct(n I32) ? ValidationError {
    v mut I32 = try checkNonNegative(n)
    n
}

fn measurementValue(n I32) I32 ? ValidationError {
    m Measurement = try Measurement(n)
    return m.v
}

error MeasureError {
    NEGATIVE
    TOO_BIG
}

# a constructor's body is a real statement block: "error" raises the constructor's own declared error
# directly (no fallible helper needed), and a field declaration is just one more statement among the
# checks around it. The fields ARE the constructor's own top-level locals, so a later field's initializer
# and a later statement alike can read one that was already built ("half" reads "doubled", and the
# second check tests "doubled" rather than re-deriving it from "n").
type Measure struct(n I32) ? MeasureError {
    if n < 0 {
        error MeasureError.NEGATIVE
    }
    doubled I32 = n * 2
    if doubled > 100 {
        error MeasureError.TOO_BIG
    }
    n
    half I32 = doubled / 4
}

measuredDoubled mut I32 = 0
measuredHalf mut I32 = 0

fn recordMeasure(n I32) ? MeasureError {
    m Measure = try Measure(n)
    measuredDoubled = m.doubled
    measuredHalf = m.half
}

# a constructor declaring NO error union of its own may still catch one entirely, exactly as a test{}
# block or a destructor can - nothing escapes, so there is nothing to propagate. "v" is a field, and the
# catch body assigns to it: a field's own local is writable inside the body regardless of whether the
# FIELD is "mut", and the instance is assembled from whatever the local holds at the end.
type Guarded struct(n I32) {
    v mut I32 = n
    try checkNonNegative(n) catch ValidationError {
        v = -1
    }
    tag I32 = 7
}

resourcesClosed mut I32 = 0

# "T[N]" with no initializer - real BSS-style zero-fill (see the report). A global's own storage is
# already emitted as "zeroinitializer" unconditionally (emitGlobalDecls); leaving initExpr NULL, rather
# than writing a literal, is the entire mechanism - no dedicated zero-fill codegen exists or is needed.
zeroGlobal mut Array<I32> = Array<I32>(5)

# "destruct { }" is the only other special block a type can declare (see the report - general
# "Type.funcName" methods were considered and explicitly dropped in favor of just these two). It has no
# error union of its own - same rule as a test{} block - so a fallible call inside must be fully caught
# right there; a destructor can never propagate a failure to anyone (there's no caller to hand it to,
# especially once many queued destructors can fire in one scope-close batch - see the report).
error CloseError {
    FAIL
}

fn alwaysCloses() Bool ? CloseError {
    return true
}

# bare field names inside destruct (like "id" below) read as that field directly, no "self."-style prefix
type Handle struct(id I32) {
    id
} destruct {
    try alwaysCloses() catch CloseError {
        fail
    }
    resourcesClosed = resourcesClosed + 1
}

# a destructor-declaring type is reference-only (C11), so every instance lives in some scope and its
# destructor runs when that scope closes (C9/O15) - there is no plain-local, function-return-governed
# case any more. Bare "&" means this function's own private scope, so this instance is torn down the
# moment useHandleLocally returns.
fn useHandleLocally() I32 {
    h Handle& = Handle(7)
    return h.id
}

# an instance tagged to a PASSED-IN scope outlives the function that constructed it - it was registered
# with the caller's scope at construction (O16), not with makeHandle's own, so nothing fires when
# makeHandle returns. This replaces the old "return <bare local> skips its own destructor" special case:
# the scope tag now expresses that fact directly, so no dataflow exception is needed for it at all.
fn makeHandle(n I32) Handle& {
    h Handle&return = Handle(n)
    return h
}

# proves the deferral is scoped to exactly the instance tagged to the caller's scope, not a blanket "no
# destructors fire in this function": "discard" is tagged to makeAndDiscardOne's OWN scope, so it is
# destructed when that function returns, while "keep" survives into the caller's.
fn makeAndDiscardOne(n I32) Handle& {
    keep Handle&return = Handle(n)
    discard Handle& = Handle(n + 100)
    return keep
}

# every "&" instance constructed in a loop registers with the enclosing scope individually, and all of
# them are torn down together in LIFO order the moment that scope closes.
fn useManyHandlesLocally(n I32) I32 {
    total I32 = 0
    for i in range n {
        h Handle& = Handle(i)
        total = total + h.id
    }
    return total
}

# an ARRAY of destructor-bearing instances. A destructor-declaring type can never be an array element by
# VALUE (C11), so this needs an array OF references - the marker written BEFORE the array suffix
# ("Handle&[3]") rather than after it ("Handle[3]&", one reference to an array of values). Each Handle is
# constructed and registered individually (O16); no per-element destructor walk is involved anywhere,
# that machinery is gone.
fn makeHandleArrayRef() Array<Handle&>& {
    return Handle&[Handle(20), Handle(21), Handle(22)]
}

fn useHandleArrayLocally() I32 {
    arr Array<Handle&>& = makeHandleArrayRef()
    return arr[0].id + arr[1].id + arr[2].id
}

# the same through the OTHER array-promotion path (a compile-time-length literal flowing into a genuinely runtime-length
# "Array<T>" target - cgPromoteFixedToRuntimeLength, an orthogonal mechanism from the compile-time-length-array-reference
# one above). Still no destructor registration in the promotion itself: the three Handles registered
# themselves when they were constructed, wherever the references to them later end up.
fn useHandleArrayLocallyRuntimeLength() I32 {
    arr Array<Handle&>& = Handle&[Handle(30), Handle(31), Handle(32)]
    return arr[0].id + arr[1].id + arr[2].id
}

# constructors give a struct field a real, type-level scope: a field written "&p" lives where the
# constructor's argument for p does (C2d), tracked per instance, so a ScopedBox may refer into storage that
# outlives it. The "Checked" functions below build their intermediates where their result lives, "&return"
# (O26), and return a part of them.
type ScopedBox struct(seed mut Point&) {
    inner mut Point&seed = seed
}

fn fillBoxViaCtor() Point& {
    b := ScopedBox&return(Point(7, 8))
    return b.inner
}

# a by-value result holding a reference: its references live in the result scope (O13), and "inner" keeps
# seed's own scope, which outlives this function - so returning the box is sound
fn makeScopedBoxPlain(seed mut Point&) ScopedBox {
    return ScopedBox(seed)
}

# a value tagged with a scope RECEIVED as a parameter is always safe to read through a local adopting it:
# every received scope outlives the function's own (O10a)
fn narrowNamedIntoOwn(seed Point&) I32 {
    p Point&seed = seed
    q Point&p = p
    return q.x
}

# a call operand (constructor or function) carries what each of the callee's scopes was bound to, and a
# later member access is checked against the caller's frame: box's "seed" is bound to the result scope here,
# so returning box.inner is a verified exact match
fn fillBoxViaCtorChecked(x I32, y I32) Point& {
    box := ScopedBox&return(Point(x, y))
    return box.inner
}

# the same for an ordinary call: makePoint's result lands where this function's result does
fn makePointChecked(x I32, y I32) Point& {
    return makePoint(x, y)
}

# "field of a field": Mid's "leaf" tracks Mid's argument; Outer's bare "mid" field lives with the Outer, and
# Mid's Point, a temporary, is built there too - so o.mid.leaf lives where o does
type Mid struct(p mut Point&) {
    leaf mut Point&p = p
}

type Outer struct(x I32, y I32) {
    mid mut Mid& = Mid(Point(x, y))
}

fn fieldOfFieldChecked(x I32, y I32) Point& {
    o := Outer&return(x, y)
    return o.mid.leaf
}

# nested forwarding: each field tracks its own argument, through any number of levels
type WrappedPoint struct(p mut Point&) {
    inner mut Point&p = p
}

type PunnedBox struct(w mut WrappedPoint&) {
    wrapped mut WrappedPoint&w = w
}

fn makePunnedBoxChecked(x I32, y I32) Point& {
    b := PunnedBox&return(WrappedPoint(Point(x, y)))
    return b.wrapped.inner
}

# two fields of one same-typed shape, from arguments in different scopes: each field's binding is told apart,
# so d.left.inner is in the result scope and d.right.inner in this block's - and only the first is returned
type DualWrapped struct(l mut WrappedPoint&, r mut WrappedPoint&) {
    left mut WrappedPoint&l = l
    right mut WrappedPoint&r = r
}

fn dualWrappedFieldChecked(leftX I32, leftY I32, rightX I32, rightY I32) Point& {
    l WrappedPoint&return = WrappedPoint(Point(leftX, leftY))
    r WrappedPoint& = WrappedPoint(Point(rightX, rightY))
    d DualWrapped& = DualWrapped(l, r)
    return d.left.inner
}

# three levels of forwarding (Holder's "box", DualWrapped's "left", WrappedPoint's "inner")
type Holder struct(b DualWrapped&) {
    box DualWrapped&b = b
}

fn holderFieldChecked(leftX I32, leftY I32, rightX I32, rightY I32) Point& {
    l WrappedPoint&return = WrappedPoint(Point(leftX, leftY))
    r WrappedPoint& = WrappedPoint(Point(rightX, rightY))
    d DualWrapped&return = DualWrapped(l, r)
    h Holder& = Holder(d)
    return h.box.left.inner
}

# two chains reaching one shared type's field through different paths resolve to two different scopes
type LeafWrap struct(w mut WrappedPoint&) {
    leaf mut WrappedPoint&w = w
}

type SiblingPair struct(o WrappedPoint&, t LeafWrap&) {
    one WrappedPoint&o = o
    two LeafWrap&t = t
}

fn siblingPairOneChecked(x1 I32, y1 I32, x2 I32, y2 I32) Point& {
    one WrappedPoint&return = WrappedPoint(Point(x1, y1))
    two LeafWrap& = LeafWrap(WrappedPoint(Point(x2, y2)))
    p SiblingPair& = SiblingPair(one, two)
    return p.one.inner
}

fn siblingPairTwoLeafChecked(x1 I32, y1 I32, x2 I32, y2 I32) Point& {
    one WrappedPoint& = WrappedPoint(Point(x1, y1))
    two LeafWrap&return = LeafWrap(WrappedPoint(Point(x2, y2)))
    p SiblingPair& = SiblingPair(one, two)
    return p.two.leaf.inner
}

# reassignment tracking: "box = ScopedBox(...)" re-binds box's own map, so box.inner after it is checked
# against what box holds now
fn reassignSameScopeChecked(x I32, y I32) Point& {
    box ScopedBox&return = ScopedBox(Point(1, 2))
    box = ScopedBox(Point(x, y))
    return box.inner
}

# two branches reassigning box into one agreed scope merge to that scope
fn reassignBothBranchesAgreeChecked(cond Bool, x I32, y I32) Point& {
    box ScopedBox&return = ScopedBox(Point(1, 2))
    if cond {
        box = ScopedBox(Point(x, y))
    } else {
        box = ScopedBox(Point(y, x))
    }
    return box.inner
}

# a bare "&" field lives where its instance does (C2d): when the instance is built into a reference, the
# field's referent is built there too, not in whatever function happens to be executing
type NestedBox struct(inner mut Point&) {
    inner mut
}

fn makeNestedBox(x I32, y I32) NestedBox& {
    return NestedBox(Point(x, y))
}

# two levels of bare "&" nesting: "co.mid.leaf = ..." walks past co.mid (bare, no scope of its own) to co
type ChainMid struct(leaf mut Point&) {
    leaf mut
}

type ChainOuter struct(mid mut ChainMid&) {
    mid mut
}

fn setChainLeaf(co mut ChainOuter&, x I32, y I32) I32 {
    co.mid.leaf = Point(x, y)
    return 0
}

fn takesScopedPoint(p Point&) I32 {
    return p.x
}
test "factorial of small numbers" {
    assert factorial(0) == 1
    assert factorial(1) == 1
    assert factorial(5) == 120
}

test "add sums its two arguments" {
    assert add(2, 3) == 5
    assert add(-2, 5) == 3
}

test "F32 arithmetic" {
    assert average(2.0, 4.0) == 3.0
}

test "U8 comparisons" {
    assert isDigit('5')
    assert not isDigit('x')
}

test "bitwise or, and, xor, shift" {
    assert setBit(0, 3) == 8
    assert (5 & 3) == 1
    assert (5 ^ 3) == 6
}

# I64/F64 used to be completely unreachable - no literal syntax produced either, and nothing
# implicitly widened into them (see the report). A numeric literal (including one negated by a single
# leading unary "-", now itself considered a literal - see the report) implicitly widens into any
# numeric type it's used against, wherever exact type-matching would otherwise be required: an
# assignability context (a var-decl, here) or a same-type-requiring binary operator (arithmetic,
# comparison, and bitwise alike - not just "+ - * / %", which is all the spec originally promised).
test "a numeric literal widens into I64/F64, including negative ones, everywhere exact matching is required" {
    a I64 = 5
    assert a == 5
    b I64 = -5
    assert b == -5
    c F64 = 5.5
    assert c == 5.5
    d F64 = -5.5
    assert d == -5.5
    e F32 = 5
    assert e == 5.0
    x I64 = 100
    assert x + 5 == 105
    assert x - 5 == 95
    assert x % 3 == 1
    assert (x & 12) == 4
    assert x < 200
    assert x > 50
}

# T6 is representability, not direction: a numeric literal adapts to whatever numeric type it is used
# against as long as the value written fits there. Before this, widening was the whole rule, so "U8"
# was unreachable by any integer literal at all - "x byte = 1", "buf[i] = 2" and "b == 1" were type
# errors, and the only ways to get a byte value were an explicit U8(1) or a character literal (already
# typed byte). Found while probing whether a fixed-size byte buffer could be passed anywhere.
test "an integer literal adapts to U8 whenever its value fits, in every context exact matching is required" {
    x U8 = 1
    assert x == 1
    x = 200
    assert x == 200
    assert x > 100
    assert (x & 15) == 8
    b := Array<U8>(4, 0)        # D15c: a local array is uninitialized unless filled
    b[0] = 2
    b[1] = 255
    assert b[0] == 2
    assert b[1] == 255
    assert b[2] == 0
    assert takesByte(65) == 65
}

# a character literal is already typed byte (it always was), so it adapts the same way in the other
# direction now - into I32/I64/float, which the old widening rule never allowed from byte either.
test "a character literal adapts out of U8 the same way an integer literal adapts into it" {
    c U8 = 'a'
    assert c == 97
    n I32 = 'a'
    assert n == 97
    assert 'a' + 1 == 98
}

# both operands literals of differing numeric types: neither has a representation to preserve, so the
# narrower adapts to the wider rather than the pair being rejected. The direction matters - adapting the
# wider one DOWN would make "200 + 100" byte arithmetic, which wraps.
test "when both operands are literals of differing numeric types, the narrower adapts to the wider" {
    assert 'a' + 1 == 98
    assert 200 + 100 == 300
    m F32 = 0.0
    m = 2.5
    assert m + 1 == 3.5
}

# T6a: an integer literal's own type follows its value - I32 when it fits one, I64 otherwise. Without
# that, a literal too large for I32 was tagged I32 anyway, so an I32 target matched it EXACTLY,
# skipped T6 entirely and truncated it silently at codegen.
test "an integer literal too large for I32 is typed I64, so it is never silently truncated" {
    n := 5000000000
    assert n == 5000000000
    m I64 = 5000000000
    m = n
    assert m == 5000000000
}

# addLong was declared but never callable at all before this - there was no way to construct an I64
# value to pass it (see the report).
test "addLong, previously unreachable for lack of any way to construct an I64, now works" {
    assert addLong(3, 4) == 7
}

# the explicit TypeName(x) conversion builtin (see the report) - the counterpart to implicit literal
# widening above, covering every direction that never widens a literal: a non-literal value crossing
# numeric types (either direction), and narrowing in particular. U8(300) truncates to 44 (300 mod
# 256) - unchecked, the same well-defined-but-unverified behavior this language already accepts at
# every other point a value can lose information (e.g. array indexing, E16).
test "TypeName(x) explicitly converts a non-literal numeric value in either direction" {
    n I32 = 300
    assert I64(n) == 300
    big I64 = 70000
    assert I32(big) == 70000
    bt U8 = 'A'
    assert I32(bt) == 65
    assert U8(n) == U8(44)
    f F32 = 3.75
    assert I32(f) == 3
    assert F32(n) == 300.0
    assert F32(bt) == 65.0
    d64 F64 = 2.5
    assert F32(d64) == 2.5
    f32 F32 = 2.5
    assert F64(f32) == F64(2.5)
    assert I32(n) == 300
}

test "a function passed by name as a value can be called through the receiving parameter" {
    assert applyToFive(doubleIt) == 10
    g fn(n I32) I32 = doubleIt
    assert g(3) == 6
}

test "enum values: construction, equality, and match/case" {
    n Direction = Direction.NORTH
    assert n == Direction.NORTH
    assert n != Direction.SOUTH
    assert opposite(Direction.NORTH) == Direction.SOUTH
    assert opposite(Direction.EAST) == Direction.WEST
}

test "match selects the right case" {
    assert describe(1) == 100
    assert describe(2) == 200
    assert describe(99) == -1
}

test "do-while accumulates" {
    assert sumUntil(5) == 15
}

test "fixed U8 arrays compare by value, not identity" {
    a Array<U8> = "hello"
    b Array<U8> = "hello"
    c Array<U8> = "world"
    assert a == b
    assert a != c
}

test "struct literal construction and structural equality" {
    p Point = Point(1, 2)
    q Point = Point(1, 2)
    r Point = Point(3, 4)
    assert p.x == 1
    assert p.y == 2
    assert p == q
    assert p != r
}

test "single-value struct literal" {
    w Wrapper = Wrapper(42)
    assert w.v == 42
}

test "nested struct literals" {
    l Line = Line(Point(1, 2), Point(3, 4))
    assert l.a.x == 1
    assert l.a.y == 2
    assert l.b.x == 3
    assert l.b.y == 4
}

# a declared runtime-length type ("Array<T>") whose initializer has a compile-time length adopts it into the
# TYPE, not just the allocation (D12a) - so this is really an I32[3] and interchanges with one. Before
# this the length was inferred for the copy and then discarded: len() compiled to a runtime read even
# here, and an "Array<I32>" holding 3 was type-identical to one holding 4 (TypeIsSame skips the length
# whenever arrMalloc is set). An initializer with no compile-time length of its own leaves the
# declaration runtime-length, which is the only shape that had a length worth keeping to begin with.
fn takesExactlyThree(a Array<I32>&) I32 {
    return a[0] + a[1] + a[2]
}

fn declaredRuntimeLengthAdoptsIt() I32 {
        # a VALUE declaration adopts the literal's length, so this is an I32[3] that a "I32[3]&" parameter
        # borrows. (A reference declaration no longer does - D15a: its length rides beside its pointer.)
    y Array<I32> = I32[4, 5, 6]
    return takesExactlyThree(y)
}

fn initializerWithNoCompileTimeLength(n I32) I32 {
    src := Array<I32>(n)
    src[0] = 11
    z Array<I32> = src
    return I32(z.Len()) + z[0]
}

# generics (§12): a function is generic exactly when a type variable appears in its signature - there is
# no declaration list, the set IS whatever appears. Type arguments are never written at a call; they are
# inferred by matching the actual argument types against the declared parameter types (G9), which is
# sound because every variable must appear in at least one parameter (G4). Each distinct set of type
# arguments produces one monomorphized copy (G16) - an ordinary function with the variables substituted
# away, to which every other rule in the language then applies unchanged.
fn maxOf(a<T>, b<T>) <T> {
    if a > b {
        return a
    }
    return b
}

# a generic calling a generic: checking one copy's body discovers further instantiations, so the
# instantiation queue is drained to a fixed point rather than in a single pass
fn maxOfThree(a<T>, b<T>, c<T>) <T> {
    return maxOf(maxOf(a, b), c)
}

# instantiated over a user-defined struct - "==" is the ordinary structural comparison, needing no
# generic-aware version, precisely because by codegen time nothing generic is left
fn sameValue(a<T>, b<T>) Bool {
    return a == b
}

test "one generic instantiated over several types" {
    assert maxOf(3, 7) == 7
    assert maxOf(I64(3), I64(9)) == I64(9)
    assert maxOf(F64(1), F64(2)) == F64(2)
}

test "a generic calling a generic cascades instantiation" {
    assert maxOfThree(1, 5, 3) == 5
}

test "a generic over a struct type uses ordinary structural equality" {
    assert sameValue(Point(1, 2), Point(1, 2))
    assert not sameValue(Point(1, 2), Point(3, 4))
}

test "the same type arguments reuse one instantiation" {
    assert maxOf(1, 2) == 2
    assert maxOf(8, 4) == 8
}

# a generic STRUCT type declares its parameters in a "<...>" list after the name (G6). Unlike a
# function's, that list is required, because a type named in a declaration has nothing its arguments could be
# inferred from - nothing at "Couple<I32, I64>" determines them but the writing - so they are supplied
# positionally, and the declared order is what makes positional meaningful (G7). A constructor call may leave
# them to be inferred from its arguments (G10c), as a generic function's are. Each distinct argument set is a distinct type
# (G10), which falls out for free: struct identity is owner+name, and an instantiation's name carries
# its own arguments.
type Couple<A, B> struct(first <A>, second <B>) {
    first mut
    second mut
}

type Box<T> struct(v <T>) {
    v mut
}

fn pairSum(p Couple<I32, I32>) I32 {
    return p.first + p.second
}

fn nestedGeneric() I32 {
    n Box<Couple<I32, I32>> = Box<Couple<I32, I32>>(Couple<I32, I32>(4, 5))
    return n.v.first + n.v.second
}

test "a generic struct type instantiates, and its fields take the argument types" {
    p Couple<I32, I64> = Couple<I32, I64>(7, I64(9))
    assert p.first == 7
    assert p.second == I64(9)
}

test "an instantiated generic type crosses a function boundary" {
    assert pairSum(Couple<I32, I32>(8, 1)) == 9
}

test "G10c: a generic constructor's type arguments are inferred from its arguments" {
    p := Couple(7, I64(9))
    assert p.first == 7 and p.second == I64(9)
    assert pairSum(Couple(8, 1)) == 9
    n := Box(Couple(4, 5))
    assert n.v.first + n.v.second == 9
}

test "a generic instantiated with another generic's instantiation" {
    assert nestedGeneric() == 9
}

# "match <T>" (G13-G15) dispatches on a type parameter. It is resolved when the generic is instantiated,
# not at run time: there is no comparison and no branch in the generated code, only the selected arm's
# statements. Two properties make it more than a runtime switch. G14: inside the selected arm the type
# variable IS the concrete type, so "v + 1" below is valid only in the I32 arm and "v.x" only in the
# Point arm - unselected arms are never built at all. G15: unlike a match over a value (S13), a match
# over a type is exhaustiveness-checked at the instantiation, since falling through silently would
# compile a generic that does nothing for some of its instantiations.
fn describeType(v<T>) I32 {
    match <T> {
        case I32 {
            return v + 1
        }
        case I64 {
            return 64
        }
        case Point {
            return v.x
        }
    }
}

test "a type match selects a different arm per instantiation" {
    assert describeType(41) == 42
    assert describeType(I64(1)) == 64
    assert describeType(Point(7, 8)) == 7
}

# a type variable is usable as an ordinary type inside a generic body, not only in the signature
fn copyThrough(a<T>) <T> {
    x <T> = a
    return x
}

test "a type variable used as a type inside the body" {
    assert copyThrough(42) == 42
    assert copyThrough(I64(7)) == I64(7)
}

# D14a: a constructor field may be a run-time-sized array, sized by an expression that can name the
# constructor's own parameters. This is what makes a struct able to OWN a buffer at all - before it,
# "T[expr]" was var-decl-only and nothing produced a runtime-sized array as a value, so no struct could
# hold one. The field's scope tag is required, not optional: an untagged one is allocated into the
# constructor's own scope, which closes before the constructed value reaches its caller. That was not
# merely a leak - the freed chunk was immediately reused for the constructed struct itself, so a later
# write through the field landed on the struct's own length word and corrupted it.
type Buffer struct(cap I64) {
    data mut Array<U8>& = Array<U8>(cap)
    used I64 = 0
}

fn bufferLenAfterWrite(n I64) I64 {
    b Buffer& = Buffer(n)
    b.data[0] = U8(65)
    return I64(b.data.Len())
}

fn bufferReadAfterWrite(n I64) I64 {
    b Buffer& = Buffer(n)
    b.data[0] = U8(65)
    return b.data[0]
}

test "a run-time-sized constructor field is sized per construction" {
    assert bufferLenAfterWrite(10) == 10
    assert bufferLenAfterWrite(3) == 3
}

test "writing through a run-time-sized constructor field does not corrupt its length" {
    assert bufferReadAfterWrite(10) == 65
    assert bufferLenAfterWrite(10) == 10
}

# D14a and generics together: a generic struct type declaring a CONSTRUCTOR - which is what makes a real
# "Vec<T>" expressible, and is exactly the example G6 states. Both halves of the type are generic and
# both are monomorphized: the copy gets its own layout AND its own constructor, whose parameters and
# field expressions are built against the substituted types (G16). Before this the whole combination was
# unreachable: there was no "Vec<I32>(...)" call syntax at all, and since a type declaring a
# constructor rejects the "Type{...}" literal (C8), a generic type with one could not be constructed by
# any spelling - merely declaring one crashed the compiler, because the generic's own constructor was
# emitted as if it were an ordinary function and its parameters still named type variables.
type Vec<T> struct(cap I64) {
    items mut Array<<T>>& = Array<<T>>(cap)
    len mut I64 = 0
}

fn vecRoundTrip() I32 {
    v Vec<I32> = Vec<I32>(4)
    v.items[0] = 11
    v.items[3] = 22
    v.len = 2
    return v.items[0] + v.items[3] + I32(v.len) + I32(v.items.Len())
}

# two instantiations of one generic type are separate types with separate layouts and separate
# constructors - the element sizes here differ, so a shared constructor would mis-size the buffer
fn vecFloatRoundTrip() F64 {
    v Vec<F64> = Vec<F64>(2)
    v.items[1] = 2.5
    return v.items[1] + F64(v.items.Len())
}

test "a generic type's constructor is monomorphized alongside the type" {
    assert vecRoundTrip() == 39
    assert vecFloatRoundTrip() == 4.5
}

# a generic type's constructor body is checked and built per instantiation like any other body, so it can
# call a generic function - which instantiates further copies while the type copies are still draining
type Wrapped<T> struct(v <T>) {
    val <T> = copyThrough(v)
}

test "a generic type's constructor calling a generic function" {
    w Wrapped<I32> = Wrapped<I32>(9)
    q Wrapped<I64> = Wrapped<I64>(I64(3))
    assert w.val == 9
    assert q.val == I64(3)
}

# a generic type may declare a destructor, and it is monomorphized too - each instantiation gets its own
# destructor symbol. C11 applies unchanged: the type is reference-only, so every use writes the marker.
# (The instantiated constructor's return type must be the copy's own stable slot, not a snapshot taken
# before its destructor was attached - a snapshot froze the GENERIC's destructor into the constructed
# value's type, so every construction registered a symbol that was never emitted.)
type Tracked<T> struct(v <T>) {
    val <T> = v
} destruct {
    resourcesClosed = resourcesClosed + 1
}

fn trackedInt() I32 {
    t Tracked<I32>& = Tracked<I32>(4)
    return t.val
}

fn trackedFloat() F64 {
    t Tracked<F64>& = Tracked<F64>(2.5)
    return t.val
}

test "a generic type's destructor is monomorphized per instantiation" {
    resourcesClosed = 0
    assert trackedInt() == 4
    assert resourcesClosed == 1
    assert trackedFloat() == 2.5
    assert resourcesClosed == 2
}

# a constructor-declaring type is buildable BOTH ways (C6): "Type(...)" runs the constructor, "Type{...}"
# assembles it field by field, positionally, in field-declaration order like any other struct literal.
# The two forms are deliberately kept apart rather than folded into one: a literal is visibly infallible
# at the use site, where a call's fallibility is a property of the declaration you would have to look up.
type Counted struct(start I32) {
    n mut I32 = start
    tag I32 = 9
}

test "a constructor-declaring type built by its constructor" {
    c Counted = Counted(4)
    assert c.n == 4
    assert c.tag == 9
}

# ":=" infers from a constructor call as well as from a literal (D15). The rule was always about the type
# being evident at the declaration, and "p := Counted(4)" names it just as plainly as a literal does -
# unlike "x := f()", which is still rejected.
test "':=' infers a type from a constructor call" {
    c := Counted(5)
    assert c.n == 5
}

# D8a/D8b: a parameter may declare a default value, and defaulted parameters must be trailing. The
# default must be a LITERAL - not a call or any other expression - because it is evaluated on behalf of
# callers the declaration cannot see, so it must have a value and no other behaviour: no allocation, no
# scope to name, nothing that can fail. That restriction is also what lets one checked operand, built
# once in the declaring module, serve every call site.
fn connect(host I32, port I32 = 80, timeout I32 = 30, retries I32 = 3) I32 {
    return host + port + timeout + retries
}

test "a call may omit trailing arguments" {
    assert connect(1) == 114
    assert connect(1, 8080) == 8114
    assert connect(1, 8080, 5) == 8089
    assert connect(1, 8080, 5, 9) == 8095
}

# E14a: "default" reaches past a defaulted parameter without restating the values before it. This is
# deliberately positional rather than named: parameter names stay internal to the declaration, so
# renaming one is never a change to any caller's contract. It buys reachability, not documentation -
# for the latter, distinct types (which the checker verifies) beat argument names (which it cannot).
test "'default' reaches a later parameter" {
    assert connect(1, default, default, 9) == 120
    assert connect(1, default, 5) == 89
    assert connect(1, default, default, default) == 114
}

# defaults work identically on a constructor - the same param-list rules (C1 defers to D8) with no
# constructor-specific handling anywhere
type Server struct(host I32, port I32 = 80) {
    host
    port
}

test "defaults on a constructor's parameter list" {
    a Server = Server(7)
    b Server = Server(7, 9)
    c Server = Server(7, default)
    assert a.port == 80
    assert b.port == 9
    assert c.port == 80
}

# a struct literal is a valid default - it is a literal expression (E4), with a value and nothing else
fn offsetOf(p Point = Point(3, 4)) I32 {
    return p.x + p.y
}

test "a struct literal as a parameter default" {
    assert offsetOf() == 7
    assert offsetOf(Point(1, 1)) == 2
    assert offsetOf(default) == 7
}

# exercises the scope runtime under load: every allocation is rounded up to 8 bytes so the next one
# starts aligned (a raw byte bump left a 12-byte "I32[3]" followed by an i64- or pointer-bearing
# allocation misaligned - UB at the LLVM level even where the hardware tolerates it); destructor list
# nodes are bump-allocated from the scope's own arena rather than each getting its own malloc/free; and
# closing splices the chunk list onto the global pool in O(1) via a recorded tail rather than walking to
# find it. 200 scope closes x 50 iterations, mixing all three allocation shapes.
type Wide struct(a I64, b I64) {
    a mut
    b mut
}

fn mixedAlignment(n I32) I32 {
    total I64 = 0
    for i in range n {
        odd Array<I32>& = I32[1, 2, 3]
        w Wide& = Wide(7, 8)
        h Handle& = Handle(i)
        total = total + w.a + odd[0] + h.id
    }
    return I32(total)
}

fn manyChunks(rounds I32, per I32) I32 {
    acc I32 = 0
    for r in range rounds {
        acc = acc + mixedAlignment(per)
    }
    return acc
}

test "scope runtime: mixed-alignment allocations interleaved across many scope closes" {
    resourcesClosed = 0
    n I32 = manyChunks(200, 50)
    assert n == 200 * (50 * 8 + 49 * 50 / 2)
    assert resourcesClosed == 200 * 50
}

# "&" on a parameter names the CALLER's own instance, and "mut" means what it means everywhere else
# (this can be assigned to). The two are independent axes: "&" says whose instance it is, "mut" says
# whether it can be written. So mutation visibility is readable from the signature alone, with no
# reasoning about scopes or durability at the call site.
#   p Point       a copy;                  caller unaffected either way
#   p mut Point   a copy the callee writes; caller still unaffected
#   p Point&      the caller's instance, read-only
#   p mut Point&  the caller's instance, writable - the caller sees it
# This only holds because a VALUE may no longer be silently promoted into a "&" parameter when the
# caller named it (an lvalue): otherwise "&" would sometimes mean "your instance" and sometimes "a copy
# of it", and a "mut" parameter could write to a copy the caller never sees. A freshly built temporary
# (a literal, or a constructor call's result) has no caller-side instance to preserve and still promotes.
fn writesThroughRef(p mut Point&) I32 {
    p.x = 99
    return p.x
}

fn readsThroughRef(p Point&) I32 {
    return p.x
}

fn callerSeesTheWrite() I32 {
    r Point& = Point(1, 2)
    n I32 = writesThroughRef(r)
    return r.x + n * 0
}

test "a 'mut &' parameter writes to the caller's own instance" {
    assert callerSeesTheWrite() == 99
}

test "a non-mut '&' parameter still reads it" {
    r Point& = Point(5, 6)
    assert readsThroughRef(r) == 5
}

# C3: a constructor field is mutable only if declared "mut". This was recorded correctly at declaration
# but never checked: OperandIsMutableLvalue's OPERATION_MEMBER case recursed on the BASE alone, so every
# field of a mutable variable was writable regardless of how it was declared. A plain (T13) struct's
# fields carry mut = true (that grammar has no "mut" at all) and are unaffected - both are covered here.
type MutFields struct(locked I32, open I32) {
    locked
    open mut
}

type PlainFields struct(a I32, b I32) {
    a mut
    b mut
}

fn writesMutCtorField() I32 {
    c MutFields = MutFields(1, 2)
    c.open = 99
    return c.open + c.locked
}

fn writesPlainField() I32 {
    p PlainFields = PlainFields(1, 2)
    p.a = 99
    return p.a
}

test "a 'mut' constructor field is writable" {
    assert writesMutCtorField() == 100
}

test "a plain struct's fields stay writable" {
    assert writesPlainField() == 99
}

test "a declared 'Array<T>' adopts its initializer's compile-time length into the type" {
    assert declaredRuntimeLengthAdoptsIt() == 15
}

test "a 'Array<T>' initialized from a runtime-length value stays runtime-length" {
    assert initializerWithNoCompileTimeLength(4) == 15
}

test "array literal construction, compile-time- and runtime-length" {
    fixed Array<I32> = I32[10, 20, 30]
    dyn Array<I32> = I32[10, 20, 30]
    assert fixed[0] == 10
    assert fixed[2] == 30
    assert dyn[0] == 10
    assert dyn[2] == 30
}

# the compile-time-to-runtime-length promotion above used to only fire for a FRESH literal (op->isLiteral in
# OperandFitsType) - an already-existing compile-time-length-array VALUE (a plain variable, not a literal) flowing into
# a runtime-length target was rejected outright. Relaxed once confirmed there's no real mechanism difference for
# codegen to worry about (unlike int->float widening, which genuinely needs different instructions for a
# literal vs. a non-literal): cgPromoteFixedToRuntimeLength only ever needs a source ADDRESS to copy from,
# which cgValue's by-ref convention already provides for any embedded array regardless of where it came
# from - see the report. "src" here is a genuine local variable, not a literal; mutating it afterward
# proves the promotion is a real, independent copy, not an alias of the source's own storage.
test "an existing (non-literal) compile-time-length-array value promotes into a runtime-length target too" {
    src := I32[10, 20, 30]
    copied Array<I32> = src
    src[0] = 999
    assert copied[0] == 10
    assert copied[1] == 20
    assert copied[2] == 30
}

# T24: a reference marker binds to whatever is written immediately to its left - the head marker to the
# element type, each array suffix's own marker to the level that suffix introduces. Since suffixes are
# written outermost-first, a type carries one optional marker per array level plus one for the element
# type, and the levels are independent. Before this the grammar had exactly two marker slots however many
# suffixes there were, so no interior level could be marked at all.
# Written outermost-first, this literal's own type is "I32[2][3]&": 2 elements, each a reference to an
# inline I32[3]. Rectangular by construction - the element type states the row length once, so every row
# has it.
test "an array of references to compile-time-length rows: each row separately allocated, all the same length" {
    r0 := I32[1, 2, 3]
    r1 := I32[4, 5, 6]
    rows := Array<I32>&[r0, r1]
    assert rows.Len() == 2
    assert rows[0].Len() == 3
    assert rows[1][2] == 6
    assert rows[0][0] == 1
}

# T11 is gone: whether an array is reference-shaped is decided by its marker and nothing else, identically
# for "T[N]" and "Array<T>". When the length becomes known is a difference in representation, never in
# behaviour. The old rule left the implementation incoherent in both directions at once - assignment to an
# unmarked "Array<T>" ALIASED while "==" on it compared CONTENTS, and "==" on a marked "Array<T>&" also compared
# contents where E10 promises identity.
test "an unmarked runtime-length array is a value: assignment copies, == compares elements" {
    n I32 = 3
    a := Array<I32>(n)
    b := Array<I32>(n)
    a[0] = 1
    assert a != b
    b = a
    assert a == b
    b[0] = 9
    assert a[0] == 1
    assert a != b
}

test "assigning a runtime-length array keeps its own storage when the length already matches" {
    n I32 = 3
    a := Array<I32>(n)
    b := Array<I32>(n)
    a[0] = 1
    a[2] = 3
    b = a
    assert b[0] == 1
    assert b[2] == 3
        # still a copy, not an alias - reuse is an allocation the assignment does not need, never a change of
        # meaning, so it is deliberately unobservable from the language
    b[0] = 9
    assert a[0] == 1
}

test "assigning a longer runtime-length array grows into fresh storage" {
    short I32 = 2
    long I32 = 5
    a := Array<I32>(long)
    b := Array<I32>(short)
    a[4] = 7
    b = a
    assert b.Len() == 5
    assert b[4] == 7
}

test "self-assignment of a runtime-length array is safe" {
    n I32 = 3
    a := Array<I32>(n)
    a[1] = 5
    a = a
    assert a[1] == 5
    assert a.Len() == 3
}

# T29: a declared type is NOMINAL even when its underlying shape is a primitive. "type Meters I32" and
# "type Feet I32" are different types, and both differ from I32 - which is the point of naming one, and
# what lets a method belong to it. Before this a named primitive was a transparent alias: it had a name but
# no identity, so nothing could be attached to it and nothing it was passed to could tell it apart. They extend
# I32 (T29f), so I32's arithmetic makes Meters from Meters.
type Meters extends I32
type Feet extends I32

# M19: a method is declared with a receiver clause, "fn (a Meters) Name(...)", and called only as
# "x.Name(...)" - never as a plain function. The receiver is an ordinary parameter 0 once resolved, so every
# existing rule about it applies unchanged: D9's mut/&, E12's conversions, the borrow and race checks.
# "The type's own module" is the coherence rule: only the module that owns a type may give it methods.
fn (a Meters) AddM(b Meters) Meters { return a + b }
fn (a Meters) DoubledM() Meters { return a + a }

type Tick struct(n I32) {
    count mut I32 = n
}

fn (t mut Tick&) Bump(by I32) { t.count = t.count + by }
fn (t Tick&) Peek() I32 { return t.count }

test "a declared type over a primitive is distinct from it and from its siblings" {
    m Meters = 3
    n Meters = 4
    assert m.AddM(n) == 7
        # a literal still adapts into it, and it converts both ways
    assert m.AddM(1) == 4
    plain I32 = I32(m)
    assert plain == 3
    back Meters = Meters(plain)
    assert back == 3
        # "m.AddM(aFeetValue)" and "m.AddM(plain)" are compile errors - that is what nominal buys
}

test "methods work on a named primitive and on a struct alike" {
    m Meters = 3
    assert m.AddM(4) == 7
    assert m.DoubledM() == 6

    t Tick& = Tick(10)
    t.Bump(5)        # receiver is "mut Tick&": writes through
    assert t.Peek() == 15        # receiver is "Tick&": reads only

        # "DoubledM(m)" and "Peek(t)" are compile errors: a method is called on its receiver and no other way
}

# a method may not share a name with a field of its type - "x.f" has exactly one meaning, always. The
# rejected shape is "fn (t Tick&) count()", which is a compile error and so can only be named here.

# M19: the receiver is the whole chain before the method name, not just one identifier - "a.b.f()" calls
# f with receiver "a.b", to any depth. M20's alias reservation is what makes that readable: a leading name that is a
# value in scope is never also an import alias, so "a.b.f()" and a cross-module "lib.b.F()" can never both
# apply to the same text.
type Wheel struct(r I32) {
    radius mut I32 = r
}

type Axle struct(w mut Wheel&) {
    wheel mut Wheel& = w
}

type Car struct(a mut Axle&) {
    axle mut Axle& = a
}

fn (w mut Wheel&) Inflate(by I32) { w.radius = w.radius + by }
fn (w Wheel&) Radius() I32 { return w.radius }

test "a method receiver may be a member-access chain of any depth" {
    w Wheel& = Wheel(10)
    a Axle& = Axle(w)
    c Car& = Car(a)

    assert a.wheel.Radius() == 10        # two hops
    assert c.axle.wheel.Radius() == 10        # three

    c.axle.wheel.Inflate(5)        # writes through the chain to the very same instance
    assert w.Radius() == 15
}

# E12's copy-out direction at a CALL boundary: a reference argument reaching a by-value parameter loads
# the aggregate out of the pointer. cgStoreInto had done this for a var-decl and an assignment since E12c;
# cgBoundaryValue never did, and handed the loaded pointer straight to a parameter expecting the struct -
# invalid IR rather than a wrong answer, so nothing silently mis-ran, but nothing caught it either until
# all four receiver shapes were written out together.
type RecvP struct(a I32) {
    val mut I32 = a
}

fn recvByVal(p RecvP) I32 { return p.val }
fn recvByRef(p RecvP&) I32 { return p.val }
fn recvMutRef(p mut RecvP&) { p.val = 99 }
fn recvMutVal(p mut RecvP) { p.val = 99 }

test "every combination of value/reference argument and value/reference parameter" {
    v RecvP = RecvP(1)
    r RecvP& = RecvP(2)

    assert recvByVal(v) == 1        # value -> value
    assert recvByVal(r) == 2        # reference -> value: copies out
    assert recvByRef(v) == 1        # value -> reference: borrows
    assert recvByRef(r) == 2        # reference -> reference

        # and D9's two axes still read off the signature alone
    recvMutRef(v)
    assert v.val == 99        # wrote through to the caller's own value
    recvMutVal(r)
    assert r.val == 2        # wrote to the callee's copy, invisible here
}

# P1: "spawn CALL" starts one task; "join { ... }" waits for every spawn written directly inside it. The
# lifetime half needs no new rule at all: a task's arguments are borrows of the spawner's storage (E12c),
# and the spawner provably outlives every task because it cannot leave the join block until they finish.
# The two halves are separate statements because the block used to be BOTH - every statement in it was a
# task, so a join block could hold no ordinary code, no result could be read between two spawns, and a
# loop could not start a task per iteration. What the split does NOT change is the join's position: it is
# still a block, not the function, since joining at the function's exit would let the spawner read a
# task's results before the join, which is the very race the design exists to prevent.
type Tally struct(n I32) {
    val mut I32 = n
}

fn addUp(t mut Tally&, times I32) {
    for i in range times {
        t.val = t.val + 1
    }
}

fn readOut(t Tally&) I32 {
    return t.val
}

test "two tasks run concurrently and are joined before the block ends" {
    a Tally& = Tally(0)
    b Tally& = Tally(0)
    join {
        spawn addUp(a, 2000)
        spawn addUp(b, 3000)
    }
    assert a.val == 2000
    assert b.val == 3000
}

# P3 is withdrawn: "spawn" checks nothing about what tasks reach. It used to forbid handing one variable
# to two tasks when either could write it, which sounded like a data-race rule and was not one - it
# compared the ROOTS written in the block, and equal roots is sufficient for a clash, never necessary.
# A global needs no argument, so a task's use of one was never visible in the block; and two arguments can
# be one instance, since "b Tally& = a" gives two names for one allocation (S4a). Closing either needs
# to decide whether two references alias, which is what an ownership-and-borrow discipline exists to make
# decidable - and this language deliberately has none.
# What settled it is that it rejected ONE SPELLING of a race and admitted every other: "f(a)" twice was an
# error, "b = a" then "f(a), f(b)" was not, and two tasks writing one global was not. Same program three
# times. So a program that spawns owns its own data races, beside extern (X1a) and out-of-range indexing
# (E16e). What is still guaranteed is structural rather than checked: every task is joined before the
# block ends, and a task's arguments cannot outlive it.
test "several tasks may be handed the same instance" {
    a Tally& = Tally(0)
    join {
        spawn addUp(a, 1000)
        spawn readOut(a)
    }
        # no claim about a.val here - one task writes it while another reads. That is the program's business
        # now, and the point of the test is that it compiles and runs rather than what it computes.
    assert a.val >= 0
}

test "the same instance may be shared read-only by several tasks" {
    a Tally& = Tally(7)
    join {
        spawn readOut(a)
        spawn readOut(a)
    }
    assert a.val == 7
}

# a join block nests like any other block, and each join takes exactly the spawns written in its own
# block - the inner one here waits for b before the outer one waits for a
test "join blocks nest" {
    a Tally& = Tally(0)
    b Tally& = Tally(0)
    join {
        spawn addUp(a, 10)
        join {
            spawn addUp(b, 20)
        }
        assert b.val == 20
    }
    assert a.val == 10
}

# and two sibling joins are simply two joins
test "sibling join blocks" {
    a Tally& = Tally(0)
    b Tally& = Tally(0)
    join {
        spawn addUp(a, 10)
    }
    join {
        spawn addUp(b, 20)
    }
    assert a.val == 10
    assert b.val == 20
}

# P1a: a join sees only the spawns written LEXICALLY inside it. A function it calls that spawns needs a
# join of its own - the callee's spawns bind there, and its join has finished before it returns, so the
# caller's join never learns about them. Binding a callee's spawn to a caller's join would need a
# signature effect ("this function spawns") and is deliberately not done; a bare spawn with no enclosing
# join in the same function is an error instead.
fn spawnsInternally(t mut Tally&) {
    join {
        spawn addUp(t, 5)
    }
}

test "a callee's join is entirely its own" {
    a Tally& = Tally(0)
    b Tally& = Tally(0)
    join {
        spawn addUp(a, 7)
        spawnsInternally(b)
        # the callee joined before it returned, so this is settled here even though the outer join has not
        # run yet
        assert b.val == 5
    }
    assert a.val == 7
}

# the three programs P1/P1a reject, which can only be named here:
#   spawn f()                              # no enclosing join in THIS function
#   join { assert true }                   # a join that waits for nothing
#   join { join { spawn f() } }            # ... including one whose only spawn belongs to an inner join
#   join { for i := 0, i < 2, i++ { t Tally& = Tally(0)  spawn addUp(t, 1) } }
#                                          # the argument is declared in a block that closes before the
#                                          # join does, so the task could outlive its own storage

# S18b/P1d: leaving a test EARLY unwinds before it jumps. "done" ends a test as passed and "assert
# false" ends it as failed, but both leave by the same longjmp, so both take the same path - which is why
# these can be written as passing tests at all. Before this, the jump ran no join and no scope close: the
# task below kept running into the next test, and none of the handles were destructed. The closes could
# not simply be emitted at the harness's landing block, because LLVM does not model longjmp's edge and
# proves them no-ops on the only path it can see; the runtime now keeps a chain of the scopes actually
# open, so the unwind happens while the frames are still alive.
finishedEarly mut I32 = 0

fn slowlyFinish(n I32) {
    for i in range n {
        c Crate2& = Crate2(i)
        finishedEarly = finishedEarly + c.v - c.v
    }
    finishedEarly = 1
}

test "a test left early still waits for its tasks" {
    finishedEarly = 0
    join {
        spawn slowlyFinish(400000)
        done
    }
}

test "...and the task really had finished before the next test began" {
    assert finishedEarly == 1
}

# the destructor half, and it reaches through frames: the handles below live in three different scopes -
# this test body's, a callee's own, and a block nested inside that callee - and all three are unwound
fn handlesDeeper() I32 {
    h Handle& = makeHandle(1)
    for i in range 1 {
        g Handle& = makeHandle(2)
        resourcesClosed = resourcesClosed + 0
    }
    return 0
}

test "a test left early runs the destructors of every scope it abandons" {
    resourcesClosed = 0
    top Handle& = makeHandle(0)
    handlesDeeper()
    done
}

test "...all three of them ran" {
        # the callee's nested block closed normally on the way out, so it had already run one; the unwind
        # did the callee's own and this test body's
    assert resourcesClosed == 3
}

# P1g: "spawn TARGET = CALL" binds what the task returns. Without it the only way to get a value out of
# a task was a "mut &" out-parameter, which infects the callee's signature - a function you would write as
# "fn square(n I32) I32" had to be rewritten to take a slot it does not otherwise want, purely so it
# could be spawned. The store happens on the task's own thread the instant the call returns, so the types
# must agree outright: there is no caller frame left in which to run a conversion.
fn square(n I32) I32 { return n * n }

test "P1g: a spawned call's result is bound to a target" {
    r I32 = 0
    join {
        spawn r = square(7)
    }
    assert r == 49
}

# and this is what it really buys - parallel map, with no lock, no helper and no new type. Each task
# writes a slot nobody else touches, so there is nothing to synchronise; the join supplies the
# happens-before that makes the results readable (P8).
test "P1g: one slot per task is parallel map" {
    out := Array<I32>(8, 0)
    join {
        for i in range 8 { spawn out[i] = square(i) }
    }
    total I32 = 0
    for i in range 8 { total = total + out[i] }
    assert total == 140        # 0+1+4+9+16+25+36+49
}

# the target is evaluated at the SPAWN, not whenever the task runs, which is what makes "out[i]" above
# mean slot i rather than whatever i happens to be later
test "P1g: the plain form is unchanged" {
    r I32 = 5
    join {
        spawn square(3)
    }
    assert r == 5
}

# rejected, and nameable only here:
#   spawn r = voidFunc()                 # nothing to bind
#   r I64 = 0 ... spawn r = square(1)   # I32 result into an I64 target
#   spawn r += square(1)                 # compound assignment reads r on the task's thread
#   join { for ... { r I32 = 0  spawn r = square(1) } }   # target closes before the join

# O2c: every alloca belongs in the function's ENTRY block. A local or temporary declared inside a loop
# used to be alloca'd where it was written, so the stack grew by a slot per iteration and overflowed at
# around a million. O2 records this exact trap for scope headers and hoisted THOSE; ordinary locals were
# missed, and mem2reg hid it at -O3 wherever it could promote them - which it cannot when the address
# escapes into a call it cannot inline, i.e. an ordinary cross-module call. So it was a live bug in
# optimized builds, not only under -d, and it needs a million iterations to show.
type Pt struct(a I32, b I32) {
    X mut I32 = a
    Y mut I32 = b
}

# takes the local by reference, so its address escapes and the slot cannot be promoted away
fn touchPt(p mut Pt&) { p.X = p.X + 1 }

test "O2c: a local declared in a loop does not grow the stack" {
    total I32 = 0
    for i in range 2000000 {
        p Pt = Pt(1, 2)
        touchPt(p)
        total = total + p.X - p.X
    }
    assert total == 0
}

test "O2c: and a temporary in a loop does not either" {
    n I32 = 0
    for i in range 2000000 {
        q Pt = Pt(i, i)
        touchPt(q)
        n = q.X - i
    }
    assert n == 1
}

# E11a/E6b: "$" renders a value as text and "+" concatenates arrays. The rendering is fixed by the
# operand's type, and a byte renders as a CHARACTER - byte is this language's character type, so one of
# them renders as one character exactly as an array of them renders as that many.
type Pt3 struct(x I32, y I32) {
    x
    y }

# E10 compares a reference by IDENTITY, so there is no content comparison for a "Array<U8>&" anywhere in
# the language - a gap "$" makes newly visible, since every rendering it produces is one. Until a string
# library exists, comparing text means writing the loop.
fn bytesEq(a Array<U8>&, b Array<U8>&) Bool {
    if a.Len() != b.Len() { return false }
    for i in range a.Len() {
        if a[i] != b[i] { return false }
    }
    return true
}

test "E11a: every built-in rendering" {
    n I32 = 42
    big I64 = -9000000000
    b Bool = true
    f Bool = false
    c Char = 'A'
    u U8 = 65
    assert bytesEq($n, "42")
    assert bytesEq($u, "65")              # T29h: a U8 is a number; a Char is text
    assert bytesEq($big, "-9000000000")
    assert bytesEq($b, "true")
    assert bytesEq($f, "false")
    assert bytesEq($c, "A")
    assert ($c).Len() == 1
}

test "E11a: a Char array renders as text, in every shape; a U8 array as numbers (T29h)" {
    fixed := Array<Char>(2, 'z')
    assert bytesEq($fixed, "zz")
    assert bytesEq($(fixed[0:1]), "z")
    run Array<Char> = "hi"
    assert bytesEq($run, "hi")
    nums := U8[104, 105]
    assert bytesEq($nums, "U8[104, 105]")
}

test "E11a: a declared type renders from its fields, whatever methods it has" {
    p Pt3& = Pt3(7, 9)
    assert bytesEq($p, "Pt3(7, 9)")
}

test "E11b: text pieces side by side are joined" {
    assert bytesEq("ab" "cd", "abcd")
    assert bytesEq("a" "b" "c" "d", "abcd")
    n I32 = 7
    assert bytesEq("n is " $n "!", "n is 7!")
    assert bytesEq($n $n, "77")
}

# E11a: every value renders, from what it holds and the way it would be written: a struct as Name(fields),
# an array as Type[items], an enum case as Type.Case(payload). Text inside a composite is quoted, so its
# boundaries show; at the top level a byte array is simply its bytes. Nothing overrides a rendering.
type RenderPair struct(label mut String&, n I32, c Char, on Bool) {
    label mut
    n mut
    c mut
    on mut
}

type RenderLink struct(v I32, n mut RenderLink&) {
    v
    next mut RenderLink& = n
}

type RenderMeters I32

type RenderHolder struct(at mut Pt3&, tag mut String&) {
    at mut
    tag mut
}

test "E11a: a struct, an array and an enum render from their parts" {
    assert bytesEq($Point(1, -2), "Point(1, -2)")
    assert bytesEq($I32[1, 2, 3], "I32[1, 2, 3]")
    assert bytesEq($RenderPair("ab", 7, 'z', false), "RenderPair(\"ab\", 7, 'z', false)")
    assert bytesEq($Figure.Rect(3, 4), "Figure.Rect(3, 4)")
    assert bytesEq($Figure.Nothing, "Figure.Nothing")
    assert bytesEq($Direction.SOUTH, "Direction.SOUTH")
    pts := Point[Point(1, 2), Point(3, 4)]
    assert bytesEq($pts, "Point[Point(1, 2), Point(3, 4)]")
    m RenderMeters = RenderMeters(5)
    assert bytesEq($m, "5")
}

type RenderQuoted struct(t mut String&, q Char, b Char) {
    t mut
    q mut
    b mut
}

test "E11a: nested text is escaped the way a literal would write it" {
    r := RenderQuoted("a\"b\\\n\0", '\'', '"')
    assert bytesEq($r, "RenderQuoted(\"a\\\"b\\\\\\n\\0\", '\\'', '\"')")
    tab := Char['\t', 'x']
    assert bytesEq($tab, "\tx")
}

test "E11a: a run-time-length array renders all its elements, and an empty one renders as Type[]" {
    n := 3
    xs := Array<I64>(n, 9)
    assert bytesEq($xs, "I64[9, 9, 9]")
    none := Array<I32>(0)
    assert bytesEq($none, "I32[]")
}

test "E11a: a reference renders its referent, null as null, and a cycle is cut off" {
    l RenderLink& = RenderLink(1, null)
    l.next = RenderLink(2, null)
    assert bytesEq($l, "RenderLink(1, RenderLink(2, null))")
    c RenderLink& = RenderLink(7, null)
    c.next = c
    assert bytesEq($c, "RenderLink(7, RenderLink(7, RenderLink(7, RenderLink(7, RenderLink(7, RenderLink(7, RenderLink(7, RenderLink(7, ...))))))))")
}

test "E11a: a reference inside a struct renders its referent" {
    h := RenderHolder(Pt3(7, 9), "x")
    assert bytesEq($h, "RenderHolder(Pt3(7, 9), \"x\")")
}

# E11a: a function is its signature, named when it is named directly - what it is, not what it holds
fn renderAdd(a I32, b I32) I32 { return a + b }

type RenderFnHolder struct(f fn(a I32, b I32) I32) { f mut }

fn renderTwo() (I32, String&) { return 1, "x" }

test "E11a: a call's several results render together" {
    assert bytesEq($renderTwo(), "(1, \"x\")")
    assert bytesEq("r=" $renderTwo(), "r=(1, \"x\")")
}

test "E11a: functions render as signatures" {
    assert bytesEq($renderAdd, "renderAdd(a I32, b I32) I32")
    h := RenderFnHolder(renderAdd)
    assert bytesEq($h, "RenderFnHolder(fn(a I32, b I32) I32)")
    rs := Point&[Point(1, 2)]
    assert bytesEq($rs, "Point&[Point(1, 2)]")
}

test "E11a: '$' on text is a copy - it is a value, not a second name for the storage" {
    buf := Array<Char>(2, 'a')
    t := $buf
    t[0] = 'b'
    assert buf[0] == 'a'
    assert bytesEq(t, "ba")
}

# E11a/E11b: a rendering and a join are TEMPORARIES - they have no storage of their own, so they
# are built in the TARGET's scope exactly as a struct literal is (E12c). Building them in the block the
# expression sits in instead made every string-building function impossible.
fn greet3(name String&) String& { return "Hello, " $name "!" }
fn label3(n I32, tag String&) String& { return $tag "=" $n }

test "E11a/E11b: a function can build text and return it into its caller's scope" {
    assert bytesEq(greet3("world"), "Hello, world!")
    assert bytesEq(label3(42, "answer"), "answer=42")
}

# O17/T11: a temporary passed to a "Array<T>&s" parameter SEGFAULTED the compiler. The parameter's tag names
# the CALLEE's scope variable, which has to be resolved through this call's own binding - and the helper
# that does that excluded run-time-length arrays, so the callee's variable was looked up in the caller's
# frame and mangled as a global with no owner. Only a literal reached it: an lvalue argument borrows and
# takes a different path, which is why nothing had hit it.
fn head3(b Array<U8>&) Array<U8>&b { return b[0:2] }

test "T11: a literal passed to a 'Array<T>&' parameter" {
    assert bytesEq(head3("abcd"), "ab")
}

test "E11b: a join is a value in the block's own scope, usable like any other array" {
    n I32 = 3
    msg := "x=" $n
    assert msg.Len() == 3
    assert msg[0] == 'x'
    assert msg[2] == '3'
}

# T29 reaches an ARRAY: a declared type over one is nominal, so it has methods and its own identity while
# keeping the same representation - it still indexes, still slices, still marshals to C. That is the bridge
# between the built-in types and the object model; without it a named array was a transparent alias with a
# name and nothing attached to it.
type Txt Array<Char>

fn (t Txt&) Size() I32 { return I32(t.Len()) }
fn (t Txt&) Head() Char { return t[0] }
fn (a Txt&) Same(b Txt&) Bool { return bytesEq(a, b) }

test "T29: a declared type over an array has methods" {
    t Txt& = Txt("hello")
    assert t.Size() == 5
    assert t.Head() == 'h'
}

test "T29: a LITERAL adapts to it, exactly as a numeric literal adapts to a named numeric type" {
    t Txt& = "world"
    assert t.Size() == 5
    assert t.Same(Txt("world"))
}

# M19/M19d: a method is declared with a receiver clause - with no clause to say so, every
# "fn helper(n I32)" would have become a method of I32. A built-in type's methods belong to the
# prelude alone, so a program gives methods to a type of its own declared over a built-in one (T29).
type Num extends I32
type Nums extends Array<I32>

fn (n Num) Tripled() Num { return n * 3 }

fn (a Nums&) Summed() I64 {
    t I64 = 0
    for i in range a.Len() { t = t + a[i] }
    return t
}

# methods live in a namespace of their own, keyed by receiver, so a plain function may share the name
fn Summed(a I32, b I32) I32 { return a + b }

test "M19: methods on types declared over a primitive and over an array" {
    n Num = 7
    assert n.Tripled() == 21
    lit Nums& = I32[1, 2, 3]
    assert lit.Summed() == 6
    k I32 = 4
    run := Array<I32>(k, 5)
    assert Nums(run).Summed() == 20
    assert lit[1:].Summed() == 5        # a slice of a Nums is a Nums
    assert Summed(2, 3) == 5        # the plain function, untouched by the method
}

test "T29: and the built-in operators still reach it - it IS an array" {
    t Txt& = "abcdef"
    assert t.Len() == 6
    assert t[1] == 'b'
    assert bytesEq(t[1:3], "bc")
    assert bytesEq($t "!", "abcdef!")
    assert bytesEq($t, "abcdef")
}

# the rejection, which can only be named here:
#   x Txt& = someByteArray   # a VALUE keeps its own type; Txt(v) is how it changes

# a one-element array holding a variable, as a fill or as a literal (E20a went with the declaration form
# "buf I32[k]" it was distinguishing this from)
test "a one-element array holding a variable" {
    k I32 = 3
    one := Array<I32>(1, k)
    assert one.Len() == 1
    assert one[0] == 3
    two := I32[k, k]
    assert two.Len() == 2
    lit := I32[k]
    assert lit.Len() == 1 and lit[0] == 3
}

# T29b: an array satisfies a trait like anything else - a type of one's own over an array qualifies (a built-in's
# methods are the prelude's, M19d)
type Measured trait {
    Size() I32
}
fn (a Nums&) Size() I32 { return I32(a.Len()) * 10 }
fn (a mut Nums&) Zero() { a[0] = 0 }
type Zeroer trait {
    mut Zero()
}

fn measureOf(m <M Measured>&) I32 { return m.Size() }
fn zeroOf(z mut <Z Zeroer>&) { z.Zero() }

test "T29b: arrays satisfy traits" {
    t Txt& = "hello"
    assert measureOf(t) == 5        # Txt's own Size
    k I32 = 3
    buf := Array<I32>(k, 1)
    r Nums& = Nums(buf[:])
    assert measureOf(r) == 30
    v Nums = Nums(buf[:])
    assert measureOf(v) == 30        # an unmarked value, borrowed
    zeroOf(r)        # writes through to the very storage r names
    assert r[0] == 0
}

# C9/C11: registration is per CONSTRUCTOR CALL, never per storage location - so exactly-once holds however
# many names an instance has, and does NOT depend on C11's reference-only rule. That matters because C11's
# reason used to be stated as "a well-defined instance count", which this test shows was already solved
# elsewhere. What C11 actually buys is that every name reaching the resource carries a scope tag §8 can
# check: a by-value copy carries none, so it could still name the released thing after the destructor ran.
# The rejected program can only be named here:
#   h Handle11 = Handle11(1)   # by value - C11 rejects it
closes11 mut I32 = 0
type Handle11 struct(id I32) { id } destruct { closes11 = closes11 + 1 }
fn take11(h Handle11&) I32 { return h.id }
type Holder11 struct(h Handle11&) { h }

test "C9: one constructor call is one destructor run, however many names it has" {
    closes11 = 0
    for i in range 1 {
        a Handle11& = Handle11(1)
        b Handle11& = a
        c Handle11& = b
        take11(a)
        take11(c)
        w Holder11& = Holder11(a)
        assert w.h.id == 1
        assert closes11 == 0
    }
    assert closes11 == 1
}

test "C9: three constructor calls are three destructor runs" {
    closes11 = 0
    for i in range 1 {
        x Handle11& = Handle11(1)
        y Handle11& = Handle11(2)
        z Handle11& = Handle11(3)
        assert x.id + y.id + z.id == 6
    }
    assert closes11 == 3
}

# T36: two cases whose payloads put DIFFERENT primitive types in the same bytes. This is the one place
# olang can look like a union, and so the one place TBAA could wrongly tell LLVM that two accesses to one
# location cannot alias. It is safe because changing which case is live is always a whole-value store of
# the enum, and an aggregate store carries no tag - so it aliases everything and nothing can be hoisted
# across it. These tests exist to fail if that ever stops being true; they agree at -O0 and -O3.
type Either enum {
    Small(a I32)
    Big(b I64)
    Frac(c F64)
}

fn readSmall(e Either) I32 {
    match e {
        case Either.Small(a) { return a }
        nomatch { return -1 }
    }
}
fn readBig(e Either) I64 {
    match e {
        case Either.Big(b) { return b }
        nomatch { return -1 }
    }
}
fn readFrac(e Either) F64 {
    match e {
        case Either.Frac(c) { return c }
        nomatch { return -1.0 }
    }
}

test "T36: alternating enum cases over the same payload bytes read back correctly" {
    e Either = Either.Small(7)
    assert readSmall(e) == 7
    e = Either.Big(9000000000)
    assert readBig(e) == 9000000000
    e = Either.Frac(2.5)
    assert readFrac(e) == 2.5
    e = Either.Small(11)
    assert readSmall(e) == 11
    assert readBig(e) == -1
}

test "T36: and in a loop, where a reordering optimizer has room to move things" {
    total I64 = 0
    for i in range 1000 {
        e Either = Either.Small(i)
        total = total + readSmall(e)
        e = Either.Big(I64(i) * 1000000)
        total = total + readBig(e)
    }
    assert total == 499500499500
}

# T36: an array literal's element stores and a later indexed read must use the SAME tag family, or LLVM is
# told two accesses to one location cannot alias. Written as a value round-trip that would go wrong if the
# two ever diverged.
test "T36: an array literal's elements read back through indexing" {
    a Array<I32> = I32[3, 1, 4, 1, 5, 9]
    s I32 = 0
    for i in range 6 { s = s + a[i] }
    assert s == 23
    a[0] = 100
    assert a[0] == 100
    b Array<Point> = Point[Point(1, 2), Point(3, 4)]
    assert b[1].y == 4
    b[1].y = 7
    assert b[1].y == 7
}

# O2d: a call's scope variable, when an ARGUMENT determines it (O17), refers to the block that argument's
# referent lives in - not to the block the call happens to be written in. Codegen used the innermost open
# block, so a call inside an "if" whose scope came from a local declared outside it allocated into the
# "if"'s own arena, which closes at the ")" - the caller was left holding a reference into a reclaimed
# chunk. Verified by churning the arena afterwards and reading the value back.
type Growable struct(cap I32) {
    data mut Array<I32>& = Array<I32>(cap)
    n mut I32 = 0
}

fn (c Growable&) regrow(newCap I32) mut Growable&c {
    w Growable&c = Growable(newCap)
    for i in range c.n { w.data[i] = c.data[i] }
    w.n = c.n
    return w
}

test "O2d: a call inside a block allocates into the scope its argument names, not the block's" {
    c Growable& = Growable(2)
    c.data[0] = 11
    c.data[1] = 22
    c.n = 2
    if c.n == 2 {
        c = c.regrow(4)
    }
    assert churnArena() == 2469000
    assert c.data.Len() == 4
    assert c.data[0] == 11
    assert c.data[1] == 22
}

test "O2d: and the same through a loop, which is what growing a buffer actually looks like" {
    c Growable& = Growable(1)
    for i in range 500 {
        if c.n == c.data.Len() { c = c.regrow(c.n * 2) }
        c.data[c.n] = i
        c.n = c.n + 1
    }
    assert churnArena() == 2469000
    assert c.n == 500
    assert c.data[0] == 0
    assert c.data[499] == 499
}

# D15b leaves a declared-size array uninitialized because zeroing one costs time proportional to its
# length. A REFERENCE to one is a single pointer, so that reason does not apply - and skipping the store
# left a wild pointer which "== null" reported as non-null and which faulted on the first write.
type Held4 struct(v I32) {
    fixed mut Array<I32>&
    v }

test "D15a: an array reference with no initializer is null, not garbage" {
    h Held4& = Held4(1)
    assert h.fixed == null
    local Array<I32>&
    assert local == null
}

# T11a: on a reference a size is never part of the type - in a declaration it is how much to allocate, a
# constant exactly as a run-time value, and the variable is an "Array<I32>&" that may later be repointed at an
# array of any length
test "T11a: a sized reference declaration allocates, and its type is length-free" {
    buf Array<I32>& = Array<I32>(4, 7)
    assert buf.Len() == 4
    assert buf[3] == 7
    other := I32[1, 2]
    buf = other
    assert buf.Len() == 2
}

# G16a: an instantiation's NAME is its identity, so it must distinguish every type argument that is a
# different type. Two things used to collapse into one name, and both rejected correct programs with a
# diagnostic pointing somewhere else: a struct contributed only its bare name (so two modules each
# declaring a "Point" - different types by owner+name - shared one instantiation), and EVERY array
# contributed the literal "arr". Neither miscompiled, because the reuse always failed a later fit check.
# an array is held in a struct by reference (T7a), so the generic takes its type argument as one
fn PassArray(a Array<<T>>&) Array<<T>>&a { return a }

test "G16a: two array instantiations of one generic are distinct" {
    a := Array<I32>(2, 7)
    b := Array<I64>(4, 9)
    ra := PassArray(a)
    rb := PassArray(b)
        # both were "$arr" before, so the second silently reused the first
    assert ra[0] == 7
    assert rb[3] == 9
}

test "G16a: and a generic function over both" {
    a := Array<I32>(2, 7)
    b := Array<I64>(4, 9)
    ra Array<I32> = PassArray(a)
    rb Array<I64> = PassArray(b)
    assert ra[0] == 7
    assert rb[3] == 9
}

# G8a: generics COMPOSE - a type variable may be written as a type argument, so one generic can be
# expressed in terms of another. Before this, generics worked for leaf types (Chan<I32>) and for
# functions over a bare <T>, but "Vec<T>" could not be written at all: the type-args resolver only looked
# a name up as a declared type. That blocked every helper a container library is made of.
type Cell<T> struct(n <T>) {
    v mut <T> = n
}

# a generic FUNCTION over a generic type - T is bound by matching Cell<T> against the argument's own
# Cell<I32>, which needs the instantiation to remember what generic it came from and with what
fn CellValue(c mut Cell<<T>>&) <T> { return c.v }

# a method over one specific application of a generic type
fn (c mut Cell<I32>&) CellDoubled() I32 { return c.v + c.v }

# and a generic METHOD: declared over the still-generic Cell<T>, it is a method of EVERY application of
# Cell, so it is written once rather than once per type. T is introduced by the return type - the receiver
# is parameter 0 of the signature, and G8a resolves type variables over the whole of it.
fn (c Cell<<T>>&) CellGet() <T> { return c.v }

# a generic TYPE holding another generic parameterised by its own variable
type Wrap<T> struct(inner Cell<<T>>&) {
    inner
}

test "G8a: a generic function over a generic type" {
    c Cell<I32>& = Cell<I32>(7)
    d Cell<I64>& = Cell<I64>(9)
    assert CellValue(c) == 7
    assert CellValue(d) == 9        # one declaration, two instantiations
}

test "G8a: a generic type holding a generic" {
    c Cell<I32>& = Cell<I32>(4)
    w Wrap<I32>& = Wrap<I32>(c)
    assert w.inner.v == 4
}

# the substitution that makes it work: Cell<T> inside Wrap<T> has to become Cell<Point> when Wrap<Point>
# is built, which means re-deriving the instantiation's NAME from the new arguments rather than only
# rewriting its field types
test "G8a: composition with a struct as the type argument" {
    p Cell<Point>& = Cell<Point>(Point(3, 4))
    w Wrap<Point>& = Wrap<Point>(p)
    assert w.inner.v.y == 4
    assert CellValue(p).x == 3
}

test "G8a: nested application" {
    i Cell<I32>& = Cell<I32>(11)
    o Cell<Cell<I32>>& = Cell<Cell<I32>>(i)
    assert o.v.v == 11
}

test "G8a: a method over a concrete application still wins" {
    c Cell<I32>& = Cell<I32>(6)
    assert c.CellDoubled() == 12
}

# G9a: a numeric literal binds no type variable while another argument can, and adapts to what that
# argument bound - so a literal beside an I64 does not force the call to I32 and fail to unify
fn PickSecond(a <T>, b <T>) <T> { return b }

test "G9a: a literal adapts to a type variable another argument bound" {
    v I64 = 8000000000
    assert PickSecond(v, 7) == 7
    assert PickSecond(7, v) == 8000000000
    b U8 = 'a'
    assert PickSecond(b, 98) == 'b'
    f F64 = 1.5
    assert PickSecond(f, 2) == 2.0
    assert PickSecond(1, 2.5) == 2.5        # only literals: the widest of their types
}

test "G8a: a generic method serves every application" {
    c Cell<I32>& = Cell<I32>(6)
    d Cell<I64>& = Cell<I64>(8000000000)
    assert c.CellGet() == 6
    assert d.CellGet() == 8000000000
}

# a type variable appearing ONLY inside type-args has to be introduced somewhere, and "<T>" is the one
# spelling that does that anywhere else in the language. "<<" opening the list is split there (G8b).
fn CellHeld(c mut Cell<<T>>&) I32 { return 1 }

# G8b: a type variable is "<T>" in type arguments too, so "Cell<<T>>" opens with the "<<" token and a list
# ending in a variable closes with ">>" - both split only where a type-argument list is being parsed.
# Rejected, and nameable only here:  fn f(c Cell<T>&)   # "write it Cell<<T>>"
type Duo<A, B> struct(a <A>, b <B>) {
    a
    b
}
fn duoFirst(d Duo<<A>, <B>>&) <A> { return d.a }
fn innermost(c Cell<Cell<<T>>>&) <T> { return c.v.v }

test "G8b: type variables in type arguments, and shifts beside them" {
    d Duo<I32, I64>& = Duo<I32, I64>(3, 4)
    assert duoFirst(d) == 3
    i Cell<I32>& = Cell<I32>(8)
    o Cell<Cell<I32>>& = Cell<Cell<I32>>(i)
    assert innermost(o) == 8
    x I32 = 1
    assert (x << 3 >> 1) == 4        # an ordinary shift is never split
}

test "G8a: a variable introduced inside type-args" {
    c Cell<I32>& = Cell<I32>(0)
    assert CellHeld(c) == 1
}

# rejected, and nameable only here:
#   fn f(c Cell<Poont>&)     # a misspelled type in type-args stays "unknown type" - a bare name there
#                              # is always a declared type (G8b), which is what keeps a typo from
#                              # silently making the function generic

# P9: the atomic builtins. Five of them, every one lowering to exactly one LLVM atomic instruction and
# every one sequentially consistent - there is no ordering argument, because relaxed orderings are the
# easiest thing in systems programming to get subtly wrong and are purely additive if they are ever
# wanted. They are the first synchronisation olang can express on its own rather than by calling pthread
# through "extern", which is why P7's invariant had to be re-checked: TSan does follow them (verified -
# the same program with plain increments is reported and this one is not).
type Ctr struct(n I32) { v mut I32 = n }

fn bumpAtomic(c mut Ctr&, times I32) {
    for i in range times { atomicAdd(c.v, 1) }
}

test "P9: the five builtins, and what each returns" {
    x I32 = 0
    atomicStore(x, 7)
    assert atomicLoad(x) == 7
    assert atomicAdd(x, 3) == 7        # the OLD value, as fetch-and-add
    assert atomicLoad(x) == 10
    assert atomicSwap(x, 99) == 10        # likewise the old value
    assert atomicLoad(x) == 99
        # a strong compare-exchange returns what it found, so "== expected" IS the success condition -
        # which is also why it needs no second return value the language does not have
    assert atomicCas(x, 99, 5) == 99        # found 99, so it swapped
    assert atomicLoad(x) == 5
    assert atomicCas(x, 99, 8) == 5        # found 5, not 99, so it did not
    assert atomicLoad(x) == 5
}

# the point of the whole feature: this is exact, where "c.v = c.v + 1" would lose updates and be a race
test "P9: an atomic counter across two tasks is exact" {
    c Ctr& = Ctr(0)
    join {
        spawn bumpAtomic(c, 50000)
        spawn bumpAtomic(c, 50000)
    }
    assert c.v == 100000
}

test "P9: U8 and I64 targets" {
    b U8 = 0
    q I64 = 0
    atomicAdd(b, 5)
    atomicAdd(q, 5)
    assert atomicLoad(b) == 5
    assert atomicLoad(q) == 5
}

# rejected, and nameable only here:
#   atomicAdd(f, 1.0)        # a float target - atomicity is a property of one machine word
#   atomicAdd(g, 1)          # an immutable target, or any non-lvalue
#   atomicAdd(x32, y64)      # a value argument of a different type - one instruction, no conversion
#   atomicLoad(x)            # as a statement: it only reads, so it really is a discarded value

# P8: the memory model, which is three edges and nothing else. These pass trivially on a correct
# implementation and are here because a change that broke an edge would otherwise go unnoticed until it
# produced a wrong answer somewhere unrelated.
type Relay struct(n I32) {
    sent mut I32 = n
    seen mut I32 = 0
}

fn readSent(r mut Relay&) { r.seen = r.sent }
fn writeSent(r mut Relay&, v I32) { r.sent = v }

test "P8: a task sees everything the spawner did before the spawn" {
    r Relay& = Relay(0)
    r.sent = 12345        # written before the spawn, so it happens-before the task
    join {
        spawn readSent(r)
    }
    assert r.seen == 12345
}

test "P8: the spawner sees what a task did, after the join" {
    r Relay& = Relay(0)
    join {
        spawn writeSent(r, 999)
    }
        # the join block's end is the edge - before it this read would be a race
    assert r.sent == 999
}

# and the two compose: a task in a later join block sees what a task in an earlier one wrote, through
# the spawner, with no direct ordering between the two tasks themselves
test "P8: ordering composes across two join blocks" {
    r Relay& = Relay(0)
    join {
        spawn writeSent(r, 77)
    }
    join {
        spawn readSent(r)
    }
    assert r.seen == 77
}

# P1b: the join is not just the block's last statement - it is on every path OUT of the block. A return,
# a break, a continue or a propagated error all leave the block, and the block's arena is reclaimed on the
# way out, so a task still holding storage from it has to be waited for first. Both of these fail loudly
# without that: the task writes 100000 times, and the reader sees a partial count (or reads a chunk
# already handed back to the pool).
fn returnsOutOfJoin(t mut Tally&) I32 {
    join {
        spawn addUp(t, 100000)
        return 1
    }
    return 0
}

test "leaving a join block by return still waits for its tasks" {
    t Tally& = Tally(0)
    assert returnsOutOfJoin(t) == 1
    assert t.val == 100000
}

fn continuesOutOfJoin(t mut Tally&) I32 {
    for round in range 3 {
        join {
            spawn addUp(t, 50000)
            continue
        }
    }
    return t.val
}

test "leaving a join block by continue still waits for its tasks" {
    t Tally& = Tally(0)
    assert continuesOutOfJoin(t) == 150000
}

# "lexically inside the block" reaches through ordinary blocks nested in it - an if, a loop - since those
# are not joins. Only a function boundary stops it.
test "a spawn nested in an if inside a join still binds to that join" {
    t Tally& = Tally(0)
    n I32 = t.val + 3        # read through a reference, so known only at run time (a fixed n would be S8a's dead code)
    join {
        if n > 1 {
            spawn addUp(t, 50000)
        }
    }
    assert t.val == 50000
}

fn breaksOutOfJoin(t mut Tally&) I32 {
    for round in range 3 {
        join {
            spawn addUp(t, 100000)
            break
        }
    }
    return t.val
}

test "leaving a join block by break still waits for its tasks" {
    t Tally& = Tally(0)
    assert breaksOutOfJoin(t) == 100000
}

# and this is why a "spawns" signature effect is deferred rather than missing. A helper that wants to
# fan out on its caller's behalf joins its own fan-out and is itself spawned - the caller's join then
# waits for everything transitively, the caller's own work still overlaps, and the join point is the
# same. What the effect would save is the one parked thread per helper call, not any expressibility.
fn fanOut(ts mut Array<mut Tally&>&, lo I32, hi I32) {
    join {
        for i in range lo, hi { spawn addUp(ts[i], 50000) }
    }
}

test "a helper's fan-out overlaps the caller's own work with no signature effect" {
    ts Array<mut Tally&>& = Tally&[Tally(0), Tally(0), Tally(0), Tally(0), Tally(0), Tally(0), Tally(0), Tally(0)]
    ran I32 = 0
    join {
        spawn fanOut(ts, 0, 4)
        ran = 1        # the caller runs this while all eight tasks are live
        spawn fanOut(ts, 4, 8)
    }
    total I32 = 0
    for i in range 8 { total = total + ts[i].val }
    assert total == 8 * 50000
    assert ran == 1
}

# ordinary code may sit anywhere in a join block, which is the whole point of the split
test "a join block runs ordinary code between its spawns" {
    a Tally& = Tally(0)
    b Tally& = Tally(0)
    seen I32 = 0
    join {
        spawn addUp(a, 10)
        seen = seen + 1
        for i in range 3 {
            seen = seen + 1
        }
        spawn addUp(b, 20)
        seen = seen + 1
    }
    assert seen == 5
    assert a.val == 10
    assert b.val == 20
}

# and a spawn inside a loop starts one task per iteration, which the old block form could not express at
# all: every task is live at once and they are all joined together at the block's end
fn addUpIdx(ts mut Array<mut Tally&>&, i I32, times I32) {
    addUp(ts[i], times)
}

test "a loop inside a join starts one task per iteration" {
    ts Array<mut Tally&>& = Tally&[Tally(0), Tally(0), Tally(0), Tally(0), Tally(0), Tally(0), Tally(0), Tally(0)]
    join {
        for i in range 8 {
            spawn addUpIdx(ts, i, 1000)
        }
    }
    total I32 = 0
    for i in range 8 { total = total + ts[i].val }
    assert total == 8000
}

# P2: a scope is an arena with a bump cursor, and a task handed one used to bump it directly - so two
# tasks sharing a scope raced on that cursor, handed each other the same chunk and prepended two chunks
# onto one list head. That is glibc-level heap corruption, not a lost update: this test aborted inside
# malloc's own consistency assertion roughly four runs in five. Each task now allocates into a private
# arena standing in for the scope it was given, and the spawner folds them back in after the join.
fn churnInto(times I32) Crate2& {
    last Crate2&return = Crate2(0)
    for i in range times {
        last = Crate2(i)
    }
    return last
}

test "two tasks may allocate into one scope" {
    join {
        spawn churnInto(20000)
        spawn churnInto(20000)
    }
    assert true
}

# the correctness half of that fold: a value a task allocated into the caller's scope has to still be
# there, and still reachable, once the block ends. "Held3&o(...)" builds it where the container lives, which
# is what O20 requires of anything stored through a longer-lived container.
fn produceInto(o mut Box3&, n I32) {
    o.inner = Held3&o(Crate2(n))
}

test "a value a task allocates into the caller's scope survives the join" {
    a Box3& = Box3(Held3(Crate2(0)))
    b Box3& = Box3(Held3(Crate2(0)))
    join {
        spawn produceInto(a, 11)
        spawn produceInto(b, 22)
    }
    assert a.inner.held.v == 11
    assert b.inner.held.v == 22
        # and the spawner's own arena still works after taking two sub-arenas back
    c Crate2& = Crate2(33)
    assert c.v == 33
}

# the other half of a scope is its destructor list, so that is folded back too - a task's nodes go in
# front, which destructs what the task built before what was already there when it was spawned.
# Which scope that is follows from O2 with no concurrency rule of its own: a join block is an ordinary
# block and so an ordinary arena, and "own" inside it is that arena - so a task allocating into its
# caller's own scope allocates into the JOIN BLOCK's, and its destructors run when the block closes.
# A task that allocates into something longer-lived says so the ordinary way, with a named scope
# (produceInto above), and the test below it shows that surviving the join.
fn handlesOnTasks() I32 {
    join {
        spawn makeHandle(1)
        spawn makeHandle(2)
    }
    return resourcesClosed
}

# P2a: scope memory is pooled per thread, so a task's chunks used to be lost with the thread that held
# them - a leak proportional to the number of tasks that allocate rather than to what they allocate, and
# measured at 132MB over 32,000 tasks against 3.2MB after the pool is handed back. Nothing reachable is
# released: every chunk on the pool belongs to an already-closed scope, and a scope the task was HANDED
# is spliced into its parent at the join instead.
fn allocatesOnTask(n I32) I32 {
    c Crate2& = Crate2(n)
    return c.v
}

test "a task that allocates repeatedly does not accumulate memory" {
    for round in range 50 {
        join {
            spawn allocatesOnTask(round)
            spawn allocatesOnTask(round)
        }
    }
    assert true
}

test "destructors registered on a task thread run when the spawner's scope closes" {
    resourcesClosed = 0
    assert handlesOnTasks() == 2
}

# G16: an instantiation copies the generic's var wholesale, including the body syntax it will be checked
# against - so that syntax has to exist before any instantiation is created. It used to be recorded while
# bodies were being checked, which is too late twice over: for a generic used before its own declaration in
# the same file, and for one in an imported module whose bodies are checked after the caller's. Either way
# the copy got an empty body and codegen emitted a function returning a zero value, with no diagnostic
# anywhere. Recorded in the signature pass now, which runs for every module before any body is checked.
fn IdentityLater(x <T>) <T> { return x }

test "a generic used before its own declaration still gets its body" {
    assert IdentityUsedFirst(7) == 7
    assert IdentityLater(9) == 9
    assert IdentityLater(U8(3)) == 3
}

fn IdentityUsedFirst(x <T>) <T> { return x }

# G3a: a function TYPE is never generic in its own right. A "<T>" written in a callback parameter's type
# names the ENCLOSING declaration's variable and introduces nothing of its own - olang has no higher-rank
# polymorphism. Marking it generic (G3's rule for a DECLARATION, applied where it does not belong) made
# every call *through* such a parameter look like a call to a generic needing its own inference, so a
# generic could accept a callback but never call it. That is the shape of every sort, find and map there
# is, so nothing in this family was writable at all.
fn lessInt(a I32, b I32) Bool { return a < b }
fn moreInt(a I32, b I32) Bool { return a > b }
fn isTwo(x I32) Bool { return x == 2 }

fn SortBy(v mut Array<<T>>&, less fn(a <T>, b <T>) Bool) {
    for i in range 1, v.Len() {
        j I64 = i
        do {
            if j > 0 {
                if less(v[j], v[j-1]) {
                    tmp <T> = v[j]
                    v[j] = v[j-1]
                    v[j-1] = tmp
                    j--
                } else { j = 0 }
            }
        } for j > 0
    }
}

fn FindBy(v Array<<T>>&, pred fn(x <T>) Bool) I64 {
    for i in range v.Len() {
        if pred(v[i]) { return i }
    }
    return v.Len()
}

# T appears ONLY inside the callback's own type here - TypeUnify already walked a fn type's parameters,
# so inference reaches it
fn CallIt(cmp fn(a <T>, b <T>) Bool) Bool {
    return cmp(1, 2)
}

test "a generic parameterised by a callback can actually call it" {
    a Array<I32> = I32[3, 1, 2]
    SortBy(a, lessInt)
    assert a[0] == 1
    assert a[2] == 3
    SortBy(a, moreInt)
    assert a[0] == 3
    assert FindBy(a, isTwo) == 1
    assert CallIt(lessInt)
}

# E16a: "a[lo:hi]" is a borrow of a's own storage with the pointer and length adjusted - one GEP and two
# insertvalues, never a copy and never an allocation. Either bound may be omitted, defaulting to 0 and
# len(a). The result is a "Array<T>&" tagged to the scope a's storage belongs to, so a slice can be handed
# anywhere the array itself could and nowhere it could not.
fn sumSlice(b Array<I32>&) I32 {
    total I32 = 0
    for i in range b.Len() {
        total = total + b[i]
    }
    return total
}

test "slicing a compile-time-length array, with either bound omitted" {
    a := I32[1, 2, 3, 4, 5]
    assert a[1:4].Len() == 3
    assert sumSlice(a[1:4]) == 9
    assert sumSlice(a[:2]) == 3
    assert sumSlice(a[3:]) == 9
    assert sumSlice(a[:]) == 15
    assert a[2:2].Len() == 0
}

# D15 admits a slice initializer for ":=" alongside a literal and a constructor call: the rule is that the
# type is written at the declaration, and a slice's is - its base's element type with a runtime length.
# An ordinary call stays rejected, since its return type lives in another declaration entirely.
test "':=' infers a slice's type from the slice expression" {
    a := I32[1, 2, 3, 4, 5]
    s := a[1:4]
    assert s.Len() == 3
    assert s[0] == 2
        # still a borrow, inferred type or not
    s[0] = 9
    assert a[1] == 9
    inner := s[1:]
    assert inner.Len() == 2
}

test "slicing a runtime-length array, and slicing a slice" {
    n I32 = 5
    b := Array<I32>(n)
    b[2] = 9
    assert b[1:4].Len() == 3
    assert b[1:4][1] == 9
    inner Array<I32>& = b[1:4]
    assert inner[1:].Len() == 2
    assert inner[1:][0] == 9
}

# E16c: "try a[lo:hi]" makes the slice fallible instead of aborting - the ordinary try expression on the
# ordinary terms. The error is the BARE error (R16): out of range is one fact with no further detail worth
# tracking, so no new error type is needed and "?"/"catch { }" already compose. A slice with no
# "try" keeps E16b's abort, so bounds that provably hold cost nothing and force no signature change on any
# caller - which is why this is opt-in rather than making every slice fallible.
fn sliceLenOrPropagate(buf Array<U8>&, n I32) I64 ? {
    b := try buf[2:2+n]
    return b.Len()
}

fn expectSliceLen(buf Array<U8>&, n I32, want I32) ? {
    got I64 = try sliceLenOrPropagate(buf, n)
    assert got == want
}

test "a tried slice yields its value when the bounds hold" {
    buf := U8[1, 2, 3, 4, 5, 6]
    ok Bool = true
    try expectSliceLen(buf, 3, 3) catch {
        ok = false
    }
    assert ok
}

test "an out-of-range tried slice propagates rather than aborting" {
    buf := U8[1, 2, 3, 4, 5, 6]
    failed Bool = false
    try expectSliceLen(buf, 99, 0) catch {
        failed = true
    }
    assert failed
}

# E16b: a slice's bounds ARE checked, unlike an ordinary index (E16). The asymmetry is about blast radius,
# not consistency: a bad index is one wrong access where it is written, while a bad slice manufactures a
# value that stays wrong for as long as it lives - returned, stored, passed on, read a million times - so
# the failure surfaces arbitrarily far from the mistake. The check is also cheap exactly where an index
# check would not be: you slice once and read the slice N times. A violation calls the same hard-abort an
# "assert" does and never returns, so nothing continues with a bad slice - which is why the three failing
# shapes ("a[0:4]", "a[2:1]", "a[n:2]" with n negative, on a 3-element array) cannot be written as tests
# here: they would abort the run rather than report anything.
test "the in-range edges of a slice are all accepted" {
    a := I32[1, 2, 3]
    assert a[0:3].Len() == 3
    assert a[3:3].Len() == 0
    assert a[0:a.Len()].Len() == 3
}

test "a slice borrows: writing through it is writing the source" {
    a := Array<I32>(4)
    s Array<I32>& = a[1:3]
    s[0] = 7
    assert a[1] == 7
    a[2] = 5
    assert s[1] == 5
}

# a slice carries its base's mutability for the same reason an index does. Without that, slicing would
# launder an immutable array into a "mut Array<T>&" parameter - two characters to defeat D9's whole point - and
# it did, until OperandIsMutableLvalue learned about slices. The rejected shape is
# "fn passer(a Array<I32>&) { writes(a[0:2]) }", a compile error and so unwritable here.
test "a slice of a mutable array is mutable, and reaches a 'mut' parameter" {
    a := Array<I32>(4)
    fillFirstInt(a[1:3])
    assert a[1] == 42
}

fn fillFirstInt(b mut Array<I32>&) { b[0] = 42 }

# E12a is gone: passing an lvalue to a "&" parameter borrows the caller's instance (E12c) rather than
# copying it, so "&" reliably names what the caller passed - the property E12a used to secure by rejecting
# the case outright, at the cost of forcing every passable array to be declared "&" up front. Both length
# kinds work, and neither needs a marker at the declaration.
fn fillFirstByte(b mut Array<U8>&) { b[0] = 'X' }

type BorrowedCell struct(v I32) {
    val mut I32 = v
}

fn writeThrough(p mut BorrowedCell&) { p.val = 9 }

test "an unmarked local is borrowed by a '&' parameter, of either array length kind" {
    n I32 = 4
    runtimeLen := Array<U8>(n)
    fillFirstByte(runtimeLen)
    assert runtimeLen[0] == 'X'

    fixedLen Array<U8> = U8[0, 0, 0, 0]
    fillFirstByte(fixedLen)
    assert fixedLen[0] == 'X'
    assert fixedLen.Len() == 4
}

test "an unmarked struct local is borrowed by a '&' parameter too" {
    p BorrowedCell = BorrowedCell(1)
    writeThrough(p)
    assert p.val == 9
}

# D9's other half, which E12a was masking: "mut" says whether the callee may write. Binding an IMMUTABLE
# argument to a "mut &" parameter would launder that away, and was accepted for as long as E12a stood -
# an immutable "p P&" parameter passed straight into a "mut P&" one let the callee write it, even though
# writing "p.val = 9" in the passing function was correctly rejected. Both shapes are compile errors now
# and so cannot be written here.
test "a temporary still promotes into a '&' parameter rather than borrowing" {
    assert writeThroughTemp() == 9
}

fn writeThroughTemp() I32 {
    p BorrowedCell& = BorrowedCell(1)
    writeThrough(p)
    return p.val
}

# E12c applies to every type, not just arrays: the three value/reference directions behave identically for
# a struct and for an array, which is the point - "&" means "this instance" regardless of what is behind
# it. A struct's value-into-reference used to copy while an array's borrowed, and the copy hid the same
# lifetime bug for structs that it hid for arrays.
type BorrowP struct(v I32) {
    val mut I32 = v
}

test "a struct behaves exactly as an array does across the three value/reference directions" {
        # value -> value: copies
    a BorrowP = BorrowP(1)
    b BorrowP = a
    b.val = 9
    assert a.val == 1

        # reference -> value: copies out
    r BorrowP& = BorrowP(1)
    outOfRef BorrowP = r
    outOfRef.val = 9
    assert r.val == 1

        # value -> reference: borrows, so the reference IS that instance
    v BorrowP = BorrowP(1)
    borrowed BorrowP& = v
    borrowed.val = 9
    assert v.val == 9
}

# E12b: taking a reference to an existing array BORROWS its storage - an array is never copied implicitly,
# so the reference names the very elements the value has, in both directions. That makes it a lifetime
# claim rather than an allocation, and the claim is checked: scope-local storage cannot satisfy a reference
# that outlives the function (see the "own" case below). Only a temporary, which has no storage to borrow,
# is allocated into the target's scope - construction, not copying.
test "taking a reference to an array borrows its storage rather than copying it" {
    n I32 = 3
    v := Array<I32>(n)
    r Array<I32>& = v
    r[0] = 9
    assert v[0] == 9
    v[1] = 4
    assert r[1] == 4
}

# the borrow is a lifetime claim, so it is checked: an array living in this function's own scope cannot
# satisfy a reference tagged to a longer-lived one. Rejecting that is the whole point - "we didn't copy" is
# not the bug, handing scope-local storage to a longer-lived reference is. (The rejected shape is
# "dst = local" inside "fn keep(dst mut Array<I32>&s)", which is a compile error and so cannot be written
# here; O10d's own diagnostic names it.)
test "borrowing an array from a scope that outlives the reference is fine in the safe direction" {
    n I32 = 3
    v := Array<I32>(n)
    v[0] = 1
    inner Array<I32>& = v
    assert inner[0] == 1
}

test "reference into value copies out rather than aliasing the reference" {
    n I32 = 3
    r Array<I32>& = Array<I32>(n, 0)
    v Array<I32> = r
    v[0] = 9
    assert r[0] == 0
}

test "a marked runtime-length array is a reference: assignment repoints, == is identity" {
    n I32 = 3
    a Array<I32>& = Array<I32>(n)
    b Array<I32>& = Array<I32>(n)
    assert a != b
    b = a
    assert b == a
    b[0] = 9
    assert a[0] == 9
}

test "a marked compile-time-length array is a reference too - same rule, other length kind" {
    pv := I32[1, 2, 3]
    qv := I32[1, 2, 3]
    p Array<I32>& = pv
    q Array<I32>& = qv
    assert p != q
    r Array<I32>& = p
    assert r == p
}

# T27: reference-shapedness IS part of a type's identity - "Cell" and "Cell&" are different types, one an
# aggregate and the other a pointer to one. Converting between them is an assignability rule (E12), not a
# claim that they were the same type: a value into a reference is promotion (allocate, point at it), a
# reference into a value is a copy out (load the aggregate), and both exist only at the OUTERMOST level,
# because that is the only place codegen has either step. Identity used to ignore the marker at the level
# compared, which recursed into element types where no conversion exists at all: "RefCell&[2]" (two
# pointers) type-checked against "RefCell[2]" (two inline structs) and the pointers were read straight back
# as field data. Lengths and element types agreed, so nothing caught it.
type RefCell struct(v I32) {
    val mut I32 = v
}

fn makeCellRefs(a RefCell&, b RefCell&a) Array<RefCell&>&a {
    return RefCell&[a, b]
}

test "an array of references keeps its elements' reference-shapedness as part of its own type" {
    a RefCell& = RefCell(1)
    b RefCell& = RefCell(2)
    g := makeCellRefs(a, b)
    assert g[0].val == 1
    assert g[1].val == 2
        # the elements are the very instances passed in, not copies - which is what "&" buys, and exactly what
        # the old leniency destroyed by letting the same value be read back as inline structs
    assert g[0] == a
    assert g[1] == b
}

# both outermost-level conversions still hold, and each is a real operation rather than a no-op retag.
# The copy-out direction is D9a's own advice for a callee that wants its own copy of an array parameter:
# declare a local and assign, so the copy is written down where it happens.
fn copyOutOfRef(src Array<I32>&) I32 {
    mine Array<I32> = src
    mine[0] = 99
    return src[0] + mine[0]
}

test "a value promotes into a reference target, and a reference copies out into a value target" {
    p RefCell& = RefCell(1)
    q RefCell = p
    assert q.val == 1
    r := I32[1, 2, 3]
    assert copyOutOfRef(r) == 100
}

# T11a: an array of references to arrays - each row a separate array with its own length, since a
# reference takes its length from what it points to. The whole thing crosses a function boundary like any
# other reference, its rows inheriting its scope.
fn makeRows(a Array<I32>&, b Array<I32>&a) Array<Array<I32>&>&a {
    return Array<I32>&[a, b]
}

test "T11a: an array of array references, rows of their own lengths" {
    r0 := I32[1, 2, 3]
    r1 := I32[4, 5]
    g Array<Array<I32>&>& = makeRows(r0, r1)
    assert g.Len() == 2
    assert g[0].Len() == 3
    assert g[1].Len() == 2
    assert g[1][1] == 5
}

# a single-value (or empty) array literal was structurally impossible under the old "T[N][v1, ...]"/
# "Array<T>[v1, ...]" syntax (the mandatory value-list bracket was indistinguishable from a trailing size
# suffix, so it got silently swallowed and the whole literal misparsed as indexing instead) - the new
# "T[v1, ...]" syntax has no suffix loop to cause that, so both now just work.
test "a single-value and an empty array literal both parse correctly" {
    one Array<I32> = I32[42]
    assert one[0] == 42
    empty Array<I32> = I32[]
    assert empty.Len() == 0
}

# the array literal itself never restates a type - "Point" (a struct type) works exactly like "I32"
# does, each element checked against it the same way a struct literal checks each field
test "an array literal of struct values" {
    pts Array<Point> = Point[Point(1, 2), Point(3, 4)]
    assert pts[0].x == 1
    assert pts[1].y == 4
}

# an int literal correctly widens to float here the same way it does anywhere else an int-to-float fit is
# checked (OperandFitsType) - also exercises a real, pre-existing bug this surfaced and fixed: widening
# only ever updated the operand's TYPE, never its VALUE, so cgFloatConst (codegen.c) read an
# uninitialized floatLiteralVal and silently produced 0.0 - invisible before now because nothing in the
# existing suite passed a bare int literal where a float was expected.
test "an int literal widens to float inside an array literal" {
    f Array<F32> = F32[1, 2.5]
    assert f[0] == 1.0
    assert f[1] == 2.5
}

# "&"/"&name" now apply to arrays exactly the same way they already apply to structs - reusing
# structMAlloc/scopeParam generically rather than duplicating the whole marker mechanism (see the
# report). Only the compile-time-length case is wired up so far: a "&"-heap-indirect array with a known
# compile-time length ("I32[3]&") is just a bare pointer, the same free lunch a struct reference
# already gets, going through the exact same malloc-promotion/scope-arena machinery. A genuinely
# runtime-length ("Array<I32>&") reference is deliberately not addressed yet - see the report.
fn makeFixedArrayRef() Array<I32>& {
    return I32[7, 8, 9]
}

# "T[expr]" with no initializer (expr not a compile-time constant) - a runtime-sized array, arena-
# allocated into the declared "&name" tag rather than "own" (see the report and OPERATION_SIZED_ARRAY_
# ALLOC): unlike a compile-time-length reference, this can never be embedded (no compile-time offset is possible
# for a runtime-known length), so it's implicitly reference-shaped even here, without writing "&s" a
# second time on the local itself.
fn makeSizedArrayRef(n I32) Array<I32>& {
    result Array<I32>&return = Array<I32>(n, 0)
    result[0] = 42
    return result
}

test "a compile-time-length array reference survives crossing a function boundary via a named scope" {
    a Array<I32>& = makeFixedArrayRef()
    assert a[0] == 7
    assert a[2] == 9
}

# unlike C, an olang array always carries its own length - len() is the sanctioned way to read it.
# Compile-time-known dimensions (embedded, or a compile-time-length "&" reference) cost nothing at runtime;
# only a genuinely runtime-length array reads its length from the runtime slice - see OperandLen/cgLen.
test "Len() works uniformly across embedded, fixed-reference, and runtime-length arrays" {
    embedded Array<I32> = I32[1, 2, 3, 4]
    assert embedded.Len() == 4

    ref Array<I32>& = makeFixedArrayRef()
    assert ref.Len() == 3

    dyn Array<I32> = I32[10, 20, 30]
    assert dyn.Len() == 3
}

test "struct literal as a match case value" {
    assert classifyPoint(Point(1, 2)) == 100
    assert classifyPoint(Point(3, 4)) == 200
    assert classifyPoint(Point(9, 9)) == -1
}

test ":= infers a variable's type from its literal initializer" {
    x := 5
    y := 7
    y = y + 1
    assert x == 5
    assert y == 8
}

test "try/catch: SafeDiv succeeds on a non-zero divisor" {
    failed Bool = false
    try SafeDiv(10, 2) catch MathError {
        failed = true
    }
    assert not failed
}

test "try/catch: SafeDiv reports failure on divide by zero" {
    failed Bool = false
    try SafeDiv(10, 0) catch MathError {
        failed = true
    }
    assert failed
}

test "the default error: success path is unaffected by the mixed error union" {
    failed Bool = false
    try mightFailWithBareError(5) catch {
        failed = true
    }
    assert not failed
}

test "a function naming its errors is fully handled by catching them" {
    result I32 = 0
    try mightFailWithRange(200) catch RangeError {
        result = -1
    }
    assert result == -1
}

# R17: a bare "?" function lets what it tries through as its own unnamed failure - RangeError leaves it as the
# default error
fn onlyGenericEscapes(n I32) I32 ? {
    v := try mightFailWithRange(n)
    return v
}

test "the default error: an untyped catch catches it" {
    result I32 = 0
    try onlyGenericEscapes(200) catch {
        result = -99
    }
    assert result == -99
}

test "an undetermined scope variable binds to the caller's own scope" {
    p Point& = makePoint(3, 4)
    assert p.x == 3
    assert p.y == 4
}

test "a plain struct literal promotes correctly into a heap-indirect parameter and return type" {
    assert takesHeapPoint(Point(5, 6)) == 5
    q Point& = returnsHeapPoint()
    assert q.x == 9
    assert q.y == 8
}

test "the real arena allocator handles chunk growth and reuse across many scope open/close cycles" {
    expectedOneRound I32 = 0
    for i in range 300 {
        expectedOneRound = expectedOneRound + i
    }
    total I32 = 0
    for round in range 10 {
        total = total + sumManyPoints(300)
    }
    assert total == expectedOneRound * 10
}

test "constructor: every field a bare pun" {
    c Counter = Counter(5)
    assert c.start == 5
}

# L20: a closing "}" ends the statement before it, so a whole block fits on one line - a function
# body, a constructor body (Counter, above), an if/for/do/match arm, or a test block. Nothing but the
# block's own end can follow a statement inside a block, so this can never swallow a token a longer
# parse would have wanted.
fn oneLineBody(a I32) I32 { return a }

fn oneLineBlocks(a mut I32) I32 {
    if a > 3 { a = 3 }
    for i in range 2 { a++ }
    do { a++ } for a < 6
    return a
}

fn oneLineMatch(n I32) I32 {
    r I32 = 0
    match n { case 6 { r = 60 } nomatch { r = 9 } }
    return r
}

fn oneLineEmpty() { }

test "one-line blocks: a whole body between braces on a single line" {
    assert oneLineBody(7) == 7
    assert oneLineBlocks(1) == 6
    assert oneLineBlocks(9) == 6
    assert oneLineMatch(6) == 60
    assert oneLineMatch(2) == 9
    oneLineEmpty()
    c Counter = Counter(4)
    assert c.start == 4
}

test "constructor: a computed field alongside a punned one" {
    r Rectangle = Rectangle(3)
    assert r.n == 3
    assert r.doubled == 6
}

test "constructor: a fallible field initializer propagates through the constructor's own declared error union" {
    failed Bool = false
    try Measurement(-1) catch ValidationError {
        failed = true
    }
    assert failed

    failed2 Bool = false
    try measurementValue(5) catch ValidationError {
        failed2 = true
    }
    assert not failed2
}

test "constructor: 'error' raises the constructor's own declared error before any field is built" {
    failed Bool = false
    try recordMeasure(-1) catch MeasureError {
        failed = true
    }
    assert failed
}

test "constructor: a check placed after a field tests the field it just built" {
    failed Bool = false
    try recordMeasure(60) catch MeasureError {
        failed = true
    }
    assert failed
}

test "constructor: a later field reads an earlier one, and the whole body completes" {
    failed Bool = false
    try recordMeasure(8) catch MeasureError {
        failed = true
    }
    assert not failed
    assert measuredDoubled == 16
    assert measuredHalf == 4
}

test "constructor: a body with no declared errors catches a fallible call entirely" {
    a Guarded = Guarded(5)
    assert a.v == 5
    assert a.tag == 7

        # the catch body ran and wrote the field, so the assembled instance carries -1, not the argument
    b Guarded = Guarded(-3)
    assert b.v == -1
    assert b.tag == 7
}

test "destructor runs when the instance's own scope closes at function return" {
    before I32 = resourcesClosed
    result I32 = useHandleLocally()
    assert result == 7
    assert resourcesClosed == before + 1
}

test "an instance tagged to a passed-in scope outlives the function that constructed it" {
    before I32 = resourcesClosed
    h Handle& = makeHandle(42)
        # makeHandle has already returned - h was registered with the caller's scope at construction, so
        # nothing fired when makeHandle returned; if it had, resourcesClosed would be before+1 here
    assert resourcesClosed == before
    assert h.id == 42
}

test "deferral is scoped to exactly the caller-tagged instance, not every instance in that function" {
    before I32 = resourcesClosed
    kept Handle& = makeAndDiscardOne(1)
        # "discard" (tagged to makeAndDiscardOne's own scope) is already destructed by the time that
        # function returns; "kept" survives into this scope, so exactly one destructor has fired so far
    assert resourcesClosed == before + 1
    assert kept.id == 1
}

test "destructor runs for every heap-indirect instance when their scope closes, in one batch" {
    before I32 = resourcesClosed
    total I32 = useManyHandlesLocally(5)
    assert total == 0 + 1 + 2 + 3 + 4
    assert resourcesClosed == before + 5
}

# the two marker POSITIONS are different types, and both are meaningful: "Point&[3]" is 3 separately
# allocated references (elements have identity), "Point[3]&" is one reference to 3 inline values. Before
# the pre-suffix position existed, an array of references was not expressible at all - for any type, not
# just destructor-bearing ones - and this had to be faked with a value struct wrapping a reference.
fn makePointsRef() Array<Point&>& {
    return Point&[Point(1, 2), Point(3, 4)]
}

# an element-position marker may not carry a scope NAME: a reference nested inside a larger value always
# inherits its container's scope (never an independent tag), so codegen allocates every element into the
# array's own scope regardless of what the element marker says. Accepting a name would compile
# "Handle&s[3]" and "Handle&[3]" identically - an accepted-but-meaningless tag - so it is rejected.
# Confirmed by construction: a bare-"&"-element array returned as "&s" has its elements survive into s,
# not die with the callee's own scope, which is exactly why an independent element tag is meaningless.
fn elementsFollowTheArraysScope() Array<Handle&>& {
    return Handle&[Handle(50), Handle(51)]
}

test "elements of a returned array follow the array's own scope, not the callee's" {
    before I32 = resourcesClosed
    arr Array<Handle&>& = elementsFollowTheArraysScope()
        # elementsFollowTheArraysScope has returned and its own scope has closed; if the bare-"&" elements
        # had been allocated there they would already be destructed rather than still readable here
    assert resourcesClosed == before
    assert arr[0].id == 50
}

test "an array of references and a reference to an array of values are both expressible" {
    refs Array<Point&>& = makePointsRef()
    assert refs[0].x == 1
    assert refs[1].y == 4
    vals Array<I32>& = makeFixedArrayRef()
    assert vals[0] == 7
}

test "destructor runs for every handle held through an array of references" {
    before I32 = resourcesClosed
    total I32 = useHandleArrayLocally()
    assert total == 20 + 21 + 22
    assert resourcesClosed == before + 3
}

test "destructor runs for every handle in a fixed literal promoted into a runtime-length array" {
    before I32 = resourcesClosed
    total I32 = useHandleArrayLocallyRuntimeLength()
    assert total == 30 + 31 + 32
    assert resourcesClosed == before + 3
}

# the old "every slot of a runtime-sized ('T[expr]') array of destructor-bearing elements registers a
# destructor up front, zero-filled or not" behaviour is deliberately gone: zero-filling constructs no
# instances (O16), so there is nothing to destruct, and a destructor-declaring element type is
# reference-only (C11) - which the existing zero-fill rule already rejects outright, since a reference
# has no zero value. Both halves are covered: this file's ZERO_FILL_CONTAINS_REFERENCE cases cover the
# rejection, and the two array tests above cover the shape that does work.
# the three bugs the reference-only rule closed, kept as permanent regression coverage. All three were
# the same root cause - a destructor is an identity claim, and value semantics has no instance count:
# (1) passing by value destructed the CALLEE's copy at its return, releasing the caller's resource while
# the caller's own variable was still live (then destructing it again later); (2) a destructor-bearing
# field of a plain struct never destructed at all, while the constructor's own parameter copy destructed
# early; (3) a plain local array of destructor-bearing values registered nothing whatsoever. None are
# expressible any more - a destructor-declaring type is reference-only - so what these now check is that
# the surviving shapes count instances, not storage locations.
fn consumeHandle(h Handle&) I32 {
    return h.id
}

fn passAndCheck() I32 {
    local Handle& = Handle(3)
    n I32 = consumeHandle(local)
        # read while local is still live: nothing may have fired yet
    return resourcesClosed + n * 0
}

fn copyHandleAround() I32 {
    a Handle& = Handle(9)
    b Handle& = a
    return b.id
}

test "passing an instance to a function does not release the caller's resource" {
    resourcesClosed = 0
    seen I32 = passAndCheck()
    assert seen == 0
}

test "copying a reference is the same instance, destructed exactly once" {
    before I32 = resourcesClosed
    n I32 = copyHandleAround()
    assert n == 9
    assert resourcesClosed == before + 1
}

test "constructing zero instances runs zero destructors" {
    before I32 = resourcesClosed
    total I32 = useManyHandlesLocally(0)
    assert total == 0
    assert resourcesClosed == before
}

# "assert" is a statement - it takes its operand directly, the way "return" does - and not a function
# call. Every other test in this file now writes the bare "assert cond", which is the form that says so;
# "assert(cond)" keeps working unchanged, since "(cond)" is just an ordinary parenthesized sub-expression,
# and this test is the one that keeps that second spelling under test.
test "assert with and without parentheses" {
    x I32 = 5
    assert(x == 5)
    assert((x) == 5)
    assert x == 5
    assert add(2, 3) == 5
    assert not (x == 6)
}

test "a bare '&' field assigned through a scope-tagged parameter survives the callee's return" {
    box BoxedPoint& = BoxedPoint(1, Point(0, 0))
    result I32 = fillBoxedPoint(box, 7, 8)
    assert result == 7

        # force reuse of fillBoxedPoint's own now-closed private scope's chunk - would corrupt "inner" if it
        # had dangled into that scope instead of the one actually passed in
    noise I32 = 0
    for i in range 20 {
        noise = noise + noisePoint(i)
    }

    assert box.inner.x == 7
    assert box.inner.y == 8
}

test "a parameter type may reference an earlier parameter as its scope tag" {
    r I32 = takesScopedPoint(Point(1, 2))
    assert r == 1
}

test "a constructor field's scope tag, naming the constructor's own scope variable, survives the constructor call returning" {
    q Point& = fillBoxViaCtor()
    assert q.x == 7
    assert q.y == 8

        # force reuse of fillBoxViaCtor's own now-closed private scope's chunk - would corrupt "q" if
        # ScopedBox's "inner" field had actually landed there instead of in "outer" (passed in)
    noise I32 = 0
    for i in range 20 {
        noise = noise + noisePoint(i)
    }

    assert q.x == 7
    assert q.y == 8
}

test "a struct returned entirely by value still compiles fine when its nested reference field is named, not bare" {
    seed Point& = Point(3, 4)
    box ScopedBox = makeScopedBoxPlain(seed)
    assert box.inner.x == 3
    assert box.inner.y == 4
}

# C2d: a constructor field holding a reference with no scope name is built in the scope the INSTANCE lands
# in, which every constructor receives as a hidden parameter. It used to be built in the constructor's own
# scope - freed as the constructor returned - so each of these read a reused chunk after the churn.
type C2dBox struct(v I32) { inner Point& = Point(v, v + 1) }
type C2dPair struct(v I32) { box C2dBox& = C2dBox(v) }

fn makeC2dBox(v I32) C2dBox& { return C2dBox(v) }

fn c2dChurn() {
    noise I32 = 0
    for i in range 20 { noise = noise + noisePoint(i) }
}

test "C2d: a field built in the constructor body survives the constructor returning" {
    b C2dBox& = C2dBox(5)
    c2dChurn()
    assert b.inner.x == 5
    assert b.inner.y == 6
}

test "C2d: a by-value instance's field lives in the caller's scope" {
    b C2dBox = C2dBox(7)
    c2dChurn()
    assert b.inner.y == 8
}

test "C2d: an instance returned into a named scope takes its fields with it" {
    b C2dBox& = makeC2dBox(9)
    c2dChurn()
    assert b.inner.x == 9
}

test "C2d: a constructor call inside a field initializer lands with the outer instance" {
    p C2dPair& = C2dPair(3)
    c2dChurn()
    assert p.box.inner.y == 4
}

test "a plain struct's bare '&' field survives a function boundary by inheriting its container's own target scope" {
    nb NestedBox& = makeNestedBox(11, 22)
    assert nb.inner.x == 11
    assert nb.inner.y == 22

        # force reuse of makeNestedBox's own now-closed private scope's chunk - would corrupt nb.inner if
        # "inner" had actually landed there instead of in the caller's own scope, tagged via "s"
    noise I32 = 0
    for i in range 20 {
        noise = noise + noisePoint(i)
    }

    assert nb.inner.x == 11
    assert nb.inner.y == 22
}

test "a bare '&' field assigned through a two-hop chain of bare '&' bases resolves to the outermost named scope" {
    co ChainOuter& = ChainOuter(ChainMid(Point(0, 0)))
    r I32 = setChainLeaf(co, 5, 6)
    assert r == 0
    assert co.mid.leaf.x == 5
    assert co.mid.leaf.y == 6

        # force reuse of setChainLeaf's own now-closed private scope's chunk - would corrupt co.mid.leaf if
        # the old one-hop-only resolution (which only ever looked at "co.mid" itself, always bare, and so
        # always fell back to "whatever function is executing right now") had actually been used here
    noise I32 = 0
    for i in range 20 {
        noise = noise + noisePoint(i)
    }

    assert co.mid.leaf.x == 5
    assert co.mid.leaf.y == 6
}

test "the static scope checker allows a received named scope to narrow into this function's own bare '&' scope" {
    seed Point& = Point(7, 0)
    r I32 = narrowNamedIntoOwn(seed)
    assert r == 7
}

test "the static scope checker verifies a constructor field's scope tag through a call's own binding map" {
    b Point& = fillBoxViaCtorChecked(3, 4)
    assert b.x == 3
    assert b.y == 4
}

test "the static scope checker verifies an ordinary function's return-type scope tag through a call's own binding map" {
    p Point& = makePointChecked(5, 6)
    assert p.x == 5
    assert p.y == 6
}

test "the static scope checker traces a scope tag through a field of a field, not just one level" {
    p Point& = fieldOfFieldChecked(9, 10)
    assert p.x == 9
    assert p.y == 10
}

test "the static scope checker traces a scope tag through a bare-pun field, not just an explicit one" {
    p Point& = makePunnedBoxChecked(11, 12)
    assert p.x == 11
    assert p.y == 12
}

test "the static scope checker disambiguates two bare-pun fields of the same type tagged to different scopes" {
    p Point& = dualWrappedFieldChecked(13, 14, 15, 16)
    assert p.x == 13
    assert p.y == 14
}

test "the static scope checker resolves a scope tag through three levels of nested bare-pun forwarding" {
    p Point& = holderFieldChecked(17, 18, 19, 20)
    assert p.x == 17
    assert p.y == 18
}

# O25: a reference never narrows. q is written as living where p does - so nothing is moved or copied, E10's
# identity survives, and a later write through q allocates where p's referent lives rather than in this
# function's arena.
fn longerScopeIntoOwn(p Point&) I32 {
    q Point&p = p
    return q.x
}

# scratch lives in this function's block and keep where the result goes - two scopes, neither of them named
fn twoScopeVars(n I32) Point& {
    scratch Point& = Point(n, n)
    keep Point&return = Point(scratch.x, n)
    return keep
}

# O10b: the body needs "seed's scope outlives slot's", which O10a cannot decide from this signature alone - so
# it is recorded as an obligation rather than rejected, and every caller has to discharge it (O10c). A store
# of a reference to plain data is one of the places a relation may still be "outlives" rather than "equal"
# (O25c): Point holds no reference, so nothing written through the slot can be misplaced. (This used to be
# shown by returning seed under a result-only scope; that is a borrowed result now, written Point&seed, O14.)
type PointSlot struct() { p mut Point& = null }

fn obligationRelate(slot mut PointSlot&, seed mut Point&) { slot.p = seed }

# discharged here because both live in this function's own block
fn dischargesObligation(n I32) I32 {
    src Point& = Point(n, n)
    slot := PointSlot()
    obligationRelate(slot, src)
    return slot.p.x
}

test "a longer-lived scope satisfies a target asking for a shorter-lived one" {
    p Point& = Point(9, 4)
    assert longerScopeIntoOwn(p) == 9
}

test "a built result is built where the caller puts it" {
    r Point& = twoScopeVars(5)
    assert r.x == 5
    q Point& = twoScopeVars(6)
    assert q.y == 6
}

test "a scope obligation recorded from a body is discharged at every call" {
    src Point& = Point(7, 7)
    slot := PointSlot()
    obligationRelate(slot, src)
    assert slot.p.x == 7
    assert dischargesObligation(8) == 8
}

test "two same-typed sibling fields at different nesting depths never collide" {
    a Point& = siblingPairOneChecked(21, 22, 23, 24)
    assert a.x == 21
    assert a.y == 22
    b Point& = siblingPairTwoLeafChecked(21, 22, 23, 24)
    assert b.x == 23
    assert b.y == 24
}

test "the static scope checker tracks a var's scope binding through a plain reassignment" {
    p Point& = reassignSameScopeChecked(11, 12)
    assert p.x == 11
    assert p.y == 12
}

test "the static scope checker merges two branches that reassign a var to the same agreed scope" {
    p Point& = reassignBothBranchesAgreeChecked(true, 13, 14)
    assert p.x == 13
    assert p.y == 14
    q Point& = reassignBothBranchesAgreeChecked(false, 13, 14)
    assert q.x == 14
    assert q.y == 13
}

# scopeCanFlowInto used to treat a scope tag it couldn't trace back to the current function's own
# parameters as "unverifiable, so allow" - optimistic, not sound. User-caught: a compile-time-length array whose element
# type is itself constructor-bearing with a "&name"-tagged field (e.g. "Wrapper struct(inner
# Point&s) { inner }") lets two Wrapper values, each tagged to a genuinely different scope, live side by
# side in one array; reading one back out via an index ("arr[1].inner") composes no scope-tracing at all
# (OPERATION_INDEX, unlike OPERATION_MEMBER, carries no scopeBindings forward), so the resulting reference
# reaches OperandFitsType with its *raw*, unresolved "s" tag - "unverifiable" under the old rule, so it was
# silently accepted regardless of whether the two scopes involved actually agreed. Confirmed by temporarily
# reverting just this one default back to "allow": the array-index example below compiled and ran with no
# complaint at all - a real, exploitable hole, not a hypothetical one.
# Fixed at the root: scopeCanFlowInto now rejects anything it cannot trace, the same as an actually-proven-
# unsafe flow (semantic.c) - "can't prove it's safe" must mean reject, not optimistically pass, for a
# checker whose whole point is a compile-time proof. This did require a real, separate fix alongside the
# flip, not just the flip alone: a callee's own parameter type can carry a "&name" tag naming one of
# *that callee's own* scope variables (never the caller's, e.g. fillBoxedPoint/setChainLeaf above, both
# already exercised by permanent tests) - OperandFuncCall now resolves that tag through the call's own
# argument-to-parameter binding before checking fit, so the common, actually-sound case doesn't spuriously
# reject once "unverifiable" stopped meaning "allow."
# The array-index shape is now correctly rejected at compile time - not testable here since a rejected
# program can't run as a test{} block; verified ad hoc during development instead:
#   wa Wrapper = Wrapper(a, Point(1, 2))
#   wb Wrapper = Wrapper(b, Point(3, 4))
#   arr Array<Wrapper> = Wrapper[wa, wb]
#   leaked Point&a = arr[1].inner   # rejected: arr[1]'s own scope tag is untraceable, not "a"

# D15a: a GLOBAL with no initializer is its type's zero value - real BSS, which the loader provides, so
# there is no memset to pay for and nothing to opt out of. That is exactly why globals kept the zero and
# locals did not.
test "'T[N]' with no initializer zero-fills a global (real BSS)" {
    assert zeroGlobal[0] == 0
    assert zeroGlobal[4] == 0
    zeroGlobal[1] = 3
    assert zeroGlobal[1] == 3
}

# D15a: a local that is NOT a declared-size array is its zero value too - which for anything
# reference-shaped is null (T2a). All three of these were compile errors before there was a null to give
# them ("a variable declaration needs an initializer").
test "D15a: an uninitialized local is its own zero value" {
    n I32
    b Bool
    p Crate2&
    assert n == 0
    assert not b
    assert p == null
}

# D15b: a declared-size array local is left as its storage comes - no memset, which is the whole reason to
# write a size and no value. Its contents are whatever was there, so nothing can be asserted about them;
# what IS testable is that the length is right and that writing then reading works.
test "D15b: 'T[N]' with no initializer is uninitialized, not zero-filled" {
    a := Array<I32>(5)
    assert a.Len() == 5
    a[2] = 9
    assert a[2] == 9
}

# D15c: "= v" fills every element with v, which is how you ask for the zero back. "= 0" costs exactly what
# the old unconditional zero-fill did (LLVM turns the fill loop back into a memset); a non-zero fill is
# the same loop with a different value, and falls out for free rather than being a separate feature.
test "D15c: a declared-size array fills from one element value" {
    a := Array<I32>(5, 0)
    assert a[0] == 0
    assert a[4] == 0
    a[2] = 9
    assert a[2] == 9

    h := Array<I32>(4, -1)
    assert h[0] == -1
    assert h[3] == -1

    r := Array<Crate2&>(3, null)
    assert r[0] == null
    assert r[2] == null
}

# "T[expr]", expr not a compile-time constant - arena-allocated (own by default), like C's alloca but tied
# to a scope's FILO lifetime rather than the call stack (see OPERATION_SIZED_ARRAY_ALLOC). "n" is an
# ordinary mutable local, never folded by tryEvalConstIntExpr, so this always takes the runtime-sized
# path, never the constant "T[N]" one. Uninitialized like any other declared-size array (D15b), and filled
# the same way (D15c) - the fill loop runs over the run-time length.
test "'T[expr]' arena-allocates an array sized at runtime, own scope by default" {
    n I32 = 4
    a := Array<I32>(n)
    assert a.Len() == 4
    a[2] = 7
    assert a[2] == 7

    z := Array<I32>(n, 0)
    assert z.Len() == 4
    assert z[0] == 0
    assert z[3] == 0

    f := Array<I32>(n, 5)
    assert f[0] == 5
    assert f[3] == 5

        # D14b: zero is a real length, not a degenerate case - it produces a genuinely empty array
    none I32 = 0
    e := Array<I32>(none)
    assert e.Len() == 0
}

# D14b: a NEGATIVE runtime length aborts. It cannot be written as a running test, so it is named here:
#   neg I32 = -4
#   a I32[neg]
# Before the check this was silent heap corruption rather than an error. A negative length multiplies out
# to a negative byte count; __olang_new_chunk's comparison is unsigned, so it reads that as an enormous
# capacity, mallocs a handful of bytes, records the huge cap, and every later allocation from the same
# scope bumps straight past the end of the chunk. It surfaced as "malloc(): corrupted top size" two
# allocations later, nowhere near the cause. The check is one compare per ALLOCATION - the same reason a
# slice's bounds are checked (E16b) while an index's are not (E16), which is about where the cost lands.
# A negative CONSTANT was already rejected at compile time; only the runtime path was open.

test "a runtime-sized array tagged to a named scope survives a function boundary" {
    a Array<I32>& = makeSizedArrayRef(5)
    assert a.Len() == 5
    assert a[0] == 42
    assert a[1] == 0
    assert a[4] == 0
}

# ---- D10a / S16c / S16d: every path returns, and the two ways to say "not here" ----

# A function declaring a result type must produce one on every path. Falling off the end used to return a
# silently zero value - 0 for a number, an all-zero struct, or a NULL reference - with no diagnostic
# anywhere. The whole corpus had exactly one function that failed the new check, and it was a false
# positive worth fixing rather than a bug: a selected "match <T>" arm (G15) collapses to an "if" whose
# condition is a literal true, which always runs its block.
# The analysis is deliberately structural - no dataflow, no constant folding - so it rejects some
# functions that do always return. That is what "unreachable" is for, and it is the only one of these
# statements a checker ever REQUIRES.
fn everyPathReturns(c Bool) I32 {
    if c {
        return 1
    } else {
        return 2
    }
}

fn viaExhaustiveMatch(d Direction) I32 {
    match d {
        case Direction.NORTH { return 1 }
        case Direction.SOUTH { return 2 }
        case Direction.EAST { return 3 }
        case Direction.WEST { return 4 }
    }
}

# a loop never counts toward the rule, even one that provably never exits: with break (S11), the body
# leaving and the loop leaving are different questions. "unreachable" is how you say which you meant.
fn loopsUntilFound(n I32) I32 {
    for i I32 = 0, true, i++ {
        if i == n {
            return i
        }
    }
    unreachable
}

test "D10a: every path produces a result" {
    assert everyPathReturns(true) == 1
    assert everyPathReturns(false) == 2
    assert viaExhaustiveMatch(Direction.EAST) == 3
    assert loopsUntilFound(3) == 3
}

# these can only be named here - the first is a compile error, the other two abort:
#   fn f(c bool) I32 { if c { return 1 } }      D10a: control reaches the end without returning
#   abort                                           "aborted", the OS abort status, a core dump
#   unreachable                                     "reached unreachable code", the same abort
# Both behave exactly as a failed assert does, recoverable per-test while a test is running - which is
# the reason "abort" is worth having at all: "assert false" already did precisely this and said nothing
# about why. "unreachable" says something different again, and says it to the compiler as well as to a
# reader. Neither is ever ASSUMED: a wrong "unreachable" is a diagnosed abort, not undefined behaviour,
# which is the opposite of what the name means in C++ and in Rust's unchecked form.

# ---- L10a / L10b / L10c / L12a: hexadecimal, binary, separators, exponents ----

# "0x" is still the modern spelling - C, Rust, Go, Zig, Swift, Java and Python all use it and nothing has
# displaced it. A hex literal denotes a BIT PATTERN, so the full width is writable rather than saturating.
# A leading zero stays decimal: there is no octal syntax, C's bare-0 form being widely held to be a
# mistake, and reading "0755" as octal would have silently changed what existing programs meant.
test "L10a: hexadecimal literals" {
    assert 0xF56E == 62830
    assert 0xff == 0xFF
    assert 0X10 == 16
    assert -0x10 == -16
    assert 07 == 7        # a leading zero is decimal, not octal
    assert 0xFFFFFFFF == 4294967295        # wider than I32, so I64 by T6a
    assert 0xFFFFFFFFFFFFFFFF == -1        # the full width, as a bit pattern
    assert (0xF0 | 0x0F) == 0xFF
    b U8 = 0xFF
    assert b == 255
}

# L10c: binary, same shape as hex. L10b: "_" is a separator with no meaning, removed before the value is
# read - the rule is simply that it must be FOLLOWED by another digit, which is what makes "1_", "1_.5"
# and "1_e5" errors. Nothing needs saying about the other end: a leading "_" is a letter, so "_1" is an
# identifier and never reaches the number path.
test "L10c: binary literals" {
    assert 0b1010 == 10
    assert 0B1111 == 15
    assert 0b0 == 0
    assert -0b101 == -5
    flags U8 = 0b11111111
    assert flags == 255
}

test "L10b: digit separators" {
    assert 1_000_000 == 1000000
    assert 0xFF_FF == 65535
    assert 0b1010_1010 == 170
    assert 1_000.5 == 1000.5
    assert 1.000_5 > 1.0
    assert 1e1_0 > 1000000000.0
}

# an exponent makes a literal a float whether or not a "." appeared, and is recognised only when the
# whole of it is there - so "1e" is still an int literal followed by an identifier and nothing that
# parsed before changed meaning.
test "L12a: exponent literals" {
    assert 1.0e3 == 1000.0
    assert 1e3 == 1000.0
    assert 2.5E2 == 250.0
    assert 1.0e+3 == 1000.0
    assert 1.0e-3 < 0.01
    big F64 = 1.0e30
    assert big > 1.0e29
}

test "an 'e' that is not an exponent lexes as it always did" {
    e3 I32 = 7        # an identifier, not a malformed literal
    assert e3 == 7
}

# these are errors, named here since they cannot be written as running tests:
#   0x      0b          no digits after the prefix
#   1_      1_.5   1_e5 a separator not followed by a digit
#   0b12                a digit that is not of the literal's own base - reported as a mistake in the
#                       literal rather than lexed as binary 1 beside a stray 2

# ---- E8a / E26a: two operations with no defined result, left undefined ----

# A shift amount outside [0, width) and a float-to-int conversion the target cannot represent are both
# undefined behaviour, and neither is checked at run time. Both WERE checked briefly, and measuring is
# what settled it: on loops doing nothing else, the shift check cost about 30% and the conversion check
# 3.3x. The conversion was the instructive one - the cost is not the compare but the vectorisation it
# prevents, since a per-element branch stops the loop being vectorised at all (C emits cvttpd2dq over two
# doubles at a time; the checked version emitted no vector conversion whatsoever).
# A runtime check that costs per operation does not belong in this language, whatever it buys. What stays
# is what costs nothing: a constant shift amount out of range is still rejected at compile time.
fn shiftBy(x I32, n I32) I32 {
    return x << n
}

test "shifts inside the width are unaffected" {
    assert shiftBy(1, 0) == 1
    assert shiftBy(1, 3) == 8
    assert shiftBy(1, 31) == -2147483648        # the top bit: still in range, still defined
    assert 256 >> 4 == 16
}

test "float-to-int conversions inside the range are unaffected" {
    ok F64 = 42.9
    assert I32(ok) == 42        # truncates toward zero, as always
    neg F64 = -42.9
    assert I32(neg) == -42
    b F64 = 255.5
    assert U8(b) == 255
}

test "an integer narrowing conversion still wraps, and is still not checked" {
    big I32 = 300
    assert U8(big) == 44        # defined, documented, deliberately unchecked
}

# these are undefined behaviour and so cannot be tested at all:
#   x << Shift    with Shift = 32 or -1     on x86 the count is masked, so "1 << 32" yields 1
#   I32(Big)    with Big = 999999999999.0 on x86 yields the target's most negative value
#   I32(nan)    and I32(inf)            the same
# what remains is free, so it stays: a constant shift amount is settled at compile time -
#   x << 32                                 a compile error, since the compiler can already see it

# ---- E6a: integer division is not checked ----

# Two operand pairs are undefined: a zero divisor, and the most negative value over -1, whose true
# quotient is one past the type's maximum ("%" too, since srem is the same instruction even though
# MIN % -1 is mathematically 0). Neither is checked at run time. Unlike an out-of-range shift or float
# conversion, both fault on common hardware - #DE on x86, reported as SIGFPE - so they are usually fatal
# rather than silent, though that is the target's behaviour and not a guarantee: being undefined, the
# operation may be removed before it ever runs.
# Float division is not undefined at all - IEEE gives it infinity and NaN, which are values.
fn divideRaw(a I32, b I32) I32 {
    return a / b
}

test "ordinary integer division and modulo are unaffected" {
    assert divideRaw(10, 3) == 3
    assert 10 % 3 == 1
    assert -7 / 2 == -3
    assert -7 % 2 == -1
}

test "float division by zero is a value, not a failure" {
    z F64 = 0.0
    inf F64 = 1.0 / z
    assert inf > 1000000.0
    assert -1.0 / z < -1000000.0
}

# and what costs nothing still stands: a constant zero divisor is rejected where it is written -
#   n I32 = 10 / 0                    a compile error, not something to find out at run time

# ---- S16/S16a/S16b: done and fail ----

# Both end the INNERMOST thing that can end: the current test if one is running, the process otherwise.
# Which applies is decided at run time, not by where the statement is written - the same rule a failed
# assert already followed (S18), so a "fail" in a helper called from a test ends that test rather than
# the run. That is what makes them one rule instead of two.
# "fail" replaced "crash", which named the wrong thing: it is an orderly exit the program chose, running
# the normal exit path and reporting the OS-standard failure status. The violent kind - no cleanup, a core
# dump - is reachable only by a runtime check failing, never by anything a program can write, which is why
# S16b records the decision NOT to add an "abort" statement: it would differ from "fail" only in leaving a
# core file.
fn endsTheTestAsPassed() I32 {
    done
    return -1        # never reached
}

test "done ends the current test as passed" {
    assert true
    done
    unreachable        # never reached
}

test "done from a helper ends the test too - the rule is dynamic, not lexical" {
    endsTheTestAsPassed()
    unreachable        # never reached
}

test "a test after one that ended early still runs" {
    assert true
}

# "fail" cannot be demonstrated in a passing test - it would mark this one failed - so it is named here:
#   test "..." { fail }                          marks this test failed, the run continues
#   fn main() ? E { fail }                     exits the process with status 1
# and outside a test run both keep their process meaning: "done" exits 0, "fail" exits 1.

# S18a: each runtime check now names what failed instead of all three printing "assertion failed":
#   assertion failed / slice bounds out of range / negative array length
# S18b: a test abandoned partway - by a failed assert, a failed check, or done/fail - does NOT run the
# destructors of values still live in it. The recovery path is a longjmp, and unwinding after one cannot
# be expressed in a way an optimizer keeps: LLVM does not model the jump, so from the landing block the
# only edge in comes from before the setjmp, where the scopes are still empty - it proves any close
# emitted there is a no-op and deletes it. Confirmed by building the same IR at -O0 (destructors ran) and
# -O3 (elided); neither a call-site "noinline" nor volatile reads inside the close were enough. Doing it
# properly means unwinding BEFORE the jump, which needs the runtime to track open scopes - a push and pop
# on every scope open and close, i.e. on the per-block path O2 just made hot.

# ---- S11/S11a: break and continue ----

# Both are bare statements applying to the INNERMOST enclosing loop - no labels, no way to target an outer
# one. "break" leaves without re-checking the condition or running a for's post-expression; "continue"
# ends the iteration, landing on the post-expression in a "for" and on the condition in a "do", so the
# loop still advances either way.
fn firstOver(limit I32) I32 {
    found I32 = -1
    for i in range 10 {
        if i > limit {
            found = i
            break
        }
    }
    return found
}

fn sumEvens(n I32) I32 {
    total I32 = 0
    for i in range n {
        if i % 2 != 0 {
            continue
        }
        total = total + i
    }
    return total
}

fn doBreak() I32 {
    n I32 = 0
    do {
        n = n + 1
        if n == 3 {
            break
        }
    } for n < 100
    return n
}

fn doContinue() I32 {
    n I32 = 0
    hits I32 = 0
    do {
        n = n + 1
        if n % 2 == 0 {
            continue
        }
        hits = hits + 1
    } for n < 6
    return hits
}

# a break applies to the loop it is written in, never the one outside it
fn nestedBreak() I32 {
    hits I32 = 0
    for i in range 3 {
        for j in range 10 {
            if j == 2 {
                break
            }
            hits = hits + 1
        }
        hits = hits + 100
    }
    return hits
}

test "break leaves the innermost loop, continue advances it" {
    assert firstOver(3) == 4
    assert doBreak() == 3
    assert sumEvens(10) == 20
    assert doContinue() == 3
    assert nestedBreak() == 306
}

# S11a: this is the half that had to be built rather than parsed. Both statements jump PAST the closing
# brace that would have reclaimed the iteration's arena, so they have to close every block scope they
# leave themselves, innermost first - the loop body's own included, and any block nested inside it. Two
# handles are constructed per iteration, one of them inside a nested block that "continue" abandons, and
# all of them are destructed.
fn continueUnwinds(n I32) I32 {
    for i in range n {
        h Handle& = Handle(i)
        if h.id >= 0 {
            g Handle& = Handle(100 + i)
            continue
        }
    }
    return resourcesClosed
}

fn breakUnwinds(n I32) I32 {
    for i in range n {
        h Handle& = Handle(i)
        if h.id == 2 {
            break
        }
    }
    return resourcesClosed
}

test "S11a: break and continue close every block scope they leave" {
    resourcesClosed = 0
    assert continueUnwinds(4) == 8        # two per iteration, the nested one included
    resourcesClosed = 0
    assert breakUnwinds(10) == 3        # i = 0, 1, 2 constructed, then break; all three destructed
}

# outside a loop both are compile errors, so they can only be named here:
#   fn f() I32 { break }
#   join { spawn f() break }       # a join is not a loop, so there is nothing here for break to target.
#                                  # Inside a loop it targets that loop, and the join block is a scope
#                                  # it crosses on the way out (P1b) rather than the thing it leaves.

# ---- O2/O2a: every block is a scope ----

# A bare "&" means the scope of the BLOCK it is written in, not the whole function. At a body's top level
# that is the body's own, exactly as before; inside a loop body it is that iteration's. So an allocation
# in a loop is reclaimed each time round instead of accumulating for the whole call - measured at 128MB
# against 1.7MB on four million iterations, and the 128MB version also had not run a single destructor by
# the time the function returned.
fn perIterationCount(times I32) I32 {
    for i in range times {
        h Handle& = Handle(i)
        # every PREVIOUS iteration's handle has already been destructed by now
        if resourcesClosed != i {
            return -1
        }
    }
    return resourcesClosed
}

test "a destructor-bearing value in a loop body is destructed each iteration" {
    resourcesClosed = 0
    assert perIterationCount(5) == 5
    assert resourcesClosed == 5
}

fn wholeCallLifetime() I32 {
    h Handle& = Handle(1)
    if resourcesClosed != 0 {        # a top-level declaration still lives for the whole call
        return -1
    }
    return h.id
}

test "a value at a body's top level still lives for the whole call" {
    resourcesClosed = 0
    assert wholeCallLifetime() == 1
    assert resourcesClosed == 1
}

# the case that miscompiles if a bare "&" resolved to the innermost OPEN block rather than to the depth
# its own type was declared at: Crate2(7) has to land where "r" lives, not in the if-block that closes
# first. churnArena reuses the arena hard enough that a dangling reference would read someone else's bytes.
fn churnArena() I32 {
    t I32 = 0
    for i in range 200 {
        b Crate2& = Crate2(12345)
        t = t + b.v
    }
    return t
}

fn assignOutOfBlock(c Bool) I32 {
    r Crate2& = Crate2(0)
    if c {
        r = Crate2(7)
        churnArena()
    }
    churnArena()
    return r.v
}

test "a value assigned out of a block is allocated where the target lives" {
    assert assignOutOfBlock(true) == 7
    assert assignOutOfBlock(false) == 0
}

# O2a orders block scopes by nesting, so a value tagged to an inner block cannot flow outward. These are
# compile errors and so can only be named here - and both are rejected by O10's ordinary containment rule
# with nothing added for blocks:
#   r mut Crate2& = Crate2(0)
#   if c { tmp mut Crate2& = Crate2(7)  r = tmp }        # tmp's block is shorter than r's
#   for i ... { tmp mut Crate2& = Crate2(i)  arr[i] = tmp }
# A bare "&" on a PARAMETER is untouched by any of this: it is the caller's instance (O4a), never a block
# of this body, so passing a block-local to one is as ordinary as it ever was.

# ---- C2a/C5: a constructor field is a local of the constructor ----

# A field IS one of the constructor's own top-level locals - it differs from an ordinary local in exactly
# one respect, that it outlives the call by being assembled into the constructed value. So every
# initialization rule applies to it unchanged: D13's zero value with no initializer, D13a's uninitialized
# storage for a declared-size array, D13b's element fill. A D14a "T[expr]&s" field used to be the one
# exception, always zero-filled with no way to ask for anything else.
type Bin struct(cap I32) {
    raw mut Array<I32>& = Array<I32>(cap)        # D13a: uninitialized, like any declared-size array
    zeroed mut Array<I32>& = Array<I32>(cap, 0)        # D13b: filled, over the run-time length
    marked mut Array<I32>& = Array<I32>(cap, -1)
    slots mut Array<Crate2&>& = Array<Crate2&>(cap, null)
    used mut I32        # D13: no initializer - the zero value
    head mut Crate2&        # D13: ...which for a reference is null
    fixed mut Array<I32> = Array<I32>(4)        # D13a again, at a compile-time size
    filled mut Array<I32> = Array<I32>(4, 9)
}

test "C2a: every local-variable initialization rule applies to a constructor field" {
    b Bin& = Bin(3)
    assert b.raw.Len() == 3
    b.raw[0] = 5
    assert b.raw[0] == 5

    assert b.zeroed[0] == 0 and b.zeroed[2] == 0
    assert b.marked[0] == -1 and b.marked[2] == -1
    assert b.slots[0] == null and b.slots[2] == null

    assert b.used == 0
    assert b.head == null

    b.fixed[1] = 8
    assert b.fixed[1] == 8
    assert b.filled[0] == 9 and b.filled[3] == 9
}

# ---- T2a: the null reference ----

# "null" is a literal with no type of its own: it adapts to whichever nullable type it meets, exactly as a
# numeric literal adapts to whichever numeric one. Nullable means the types whose runtime value is (or
# begins with) a pointer: a "&"-marked struct or compile-time-length array, a runtime-length array, and an
# interface. Its representation is all-zero bits at every one of them, which is what makes a zero-filled
# global all-null for free and gives a null "Array<T>" - which is { 0, null } - a len() of 0.
# O13 still rejects a bare "&" return type, null or not: the rule is about the TYPE a caller receives,
# which needs a scope it can name, and "return null" does not change what the signature promises. Naming
# the scope is what makes it returnable - and null then flows into it freely, having no scope of its own.
fn firstOrNull(a Array<Crate2&>&, i I32) Crate2&a {
    return null
}

fn isAbsent(c Crate2& = null) Bool {
    return c == null
}

test "T2a: null in every position a reference is written" {
    p Crate2& = Crate2(3)
    assert p != null
    p = null        # assignment
    assert p == null

    q Crate2& = null        # declaration
    assert q == null
    assert isAbsent(q)        # argument
    assert isAbsent()        # and as a declared default (D8b - null is a literal, E4)
    assert not isAbsent(Crate2(1))

    r Array<Crate2&>& = null
    assert firstOrNull(r, 0) == null        # return
}

test "T2a: null is all-zero bits, so the two-word shapes read as empty" {
    a Array<I32>& = null
    assert a == null
    assert a.Len() == 0
}

test "T2a: a null field is an ordinary field" {
    h Held3& = Held3(null)
    assert h.held == null
    h.held = Crate2(9)
    assert h.held != null
    assert h.held.v == 9
}

# "x := null" is a compile error and so can only be named here: null is the one literal that writes no
# type at all, so there is nothing for ":=" to read off it (D15). Every other literal names its own type.

# D13 is gone, and null is why. It rejected any no-initializer array whose declared type contained a
# reference anywhere within it, at any depth - on the grounds that a zero-filled reference was an
# invisible dangling pointer with no way to test it, and a zero-filled runtime-length array was a phantom
# "empty" one that never went through a real allocation. Both objections were about the absence of null,
# and both end with T2a: a zero-filled reference is null, which is a legal value you can compare; a
# zero-filled "Array<T>" is { 0, null }, so len() is 0 and it reads as genuinely empty. All three shapes D13
# used to reject are ordinary declarations now:
#   x mut I32[2][]         a nested runtime-length array - each row null until assigned
#   x mut Crate2[3]&         the declared type is itself a reference - null
#   x mut Wrapper[n]         Wrapper's own field is "&name"-tagged - null within each element
# What D13's removal does NOT do is make an uninitialized array of references safe: those slots hold
# whatever was in the arena, not null. "= null" (D15c) is what asks for null, and a global gets it for
# free (D15a).

# "extern fn" (§11): declares a real libc/POSIX symbol, resolved by the linker at build time - see the
# report. getpid takes no arguments and returns a plain scalar; write exercises the array-marshalling path
# (X3: a "Array<U8>" argument becomes a raw pointer to its first element, length dropped, passed separately).
extern fn getpid() I32
extern fn write(fd I32, buf Array<U8>, count I64) I64

# D9a on an ARRAY parameter. "b mut Array<U8>&" is the caller's own array, so writes through it are visible
# at the call site - which is what makes an out-parameter expressible at all. The marker is load-bearing:
# an unmarked "b mut Array<U8>" is a by-value parameter, which D9a rejects outright rather than let it copy.
# Both spellings once failed at the same time - E12a rejected the marked one for an unmarked argument
# while the unmarked one silently copied - and there was no way to write this at all (see the report).
fn fillFirst(b mut Array<U8>&) I64 {
    b[0] = 'X'
    return b.Len()
}

test "a 'mut Array<T>&' parameter writes to the caller's own array" {
    buf := Array<U8>(4, 0)
    n I64 = fillFirst(buf)
    assert n == 4
    assert buf[0] == 'X'
}

# S4a: assignment to a reference overwrites the POINTER, never the pointed-to value, in every position.
# On a parameter that repoints this function's own copy - a cursor, local to the call - so the caller's
# instance is untouched. That is not a defect to be rejected: it is the same rule as everywhere else, and
# it lets a reference parameter double as a cursor with no separate local. Write-through was considered
# and rejected: "x = y" must imply "x == y", and E10 compares references by identity, so copying contents
# would leave two things equal-by-value but unequal - and would break C11's whole reason for existing.
fn cursorRebind(p mut Point&, q mut Point&) I32 {
    start I32 = p.x
    p = q
    return start + p.x
}

test "assigning to a reference parameter repoints this function's own cursor" {
    a Point& = Point(1, 0)
    b Point& = Point(2, 0)
    assert cursorRebind(a, b) == 3
    assert a.x == 1
    assert b.x == 2
}

# T24 gives a type-ref two marker positions - before the array suffixes (the element type) and after
# them (the array as a whole) - so a type carries one reference level per array level and no more. With
# NO array suffix the two positions are the same place, so "Point&s&a" is not a double reference, it is
# one position written twice with one of the two scope tags necessarily discarded. Rejected rather than
# silently resolved by precedence, since a dropped scope tag is a dropped safety claim. Not testable as a
# runtime test (a rejected program can't run as a test{} block) - verified ad hoc, and the shapes that
# remain legal are exercised throughout this file: "Point&[3]" (elements), "Point[3]&" (the array),
# "Point&[3]&" (both).

# E12's reference widening: a "T[N]&" argument reaching a "Array<T>&" parameter keeps its pointer and
# materialises the length it already knows statically - no allocation and no copy, so the callee writes
# to the caller's own storage. It is what lets ONE "Array<U8>&" parameter accept every length. The by-VALUE
# counterpart above it (T[N] -> Array<T>) does allocate and copy, which is why the two must not be confused:
# this path used to run through that one and emit invalid IR, GEP-ing a bare "ptr" as an "[N x T]".
test "a compile-time-length array reference widens into a runtime-length reference parameter" {
    a Array<U8>& = U8[U8(1), U8(2), U8(3)]
    n I64 = fillFirst(a)
    assert n == 3
    assert a[0] == 'X'
    assert a[1] == U8(2)
}

test "'extern fn' links against and calls a real external scalar-only function" {
    pid I32 = getpid()
    assert pid > 0
}

test "'extern fn' marshals a Array<U8> argument to a raw pointer at the call boundary" {
    msg Array<U8> = "unused - fd -1 always fails before this is read"
    n I64 = write(-1, msg, I64(msg.Len()))
    assert n < 0
}

# ---- traits (T30-T35, G19, M19e, M21) ----

# T30: a trait declares a set of method signatures and nothing else, and is only ever a CONSTRAINT on a type
# variable (G19) - never the type of a value. T31: a type satisfies it structurally and implicitly - no declaration of
# intent on either side - when its own module declares a matching method per method. Code over a trait is generic,
# compiled per type with direct calls.
type Shape trait {
    Area() I32
    Sides() I32
}

# M21: two types in ONE module can both satisfy a trait, which needs several methods to share a name - one per
# receiver type
type Square struct(s I32) {
    side mut I32 = s
}
fn (q Square&) Area() I32 { return q.side * q.side }
fn (q Square&) Sides() I32 { return 4 }

type Tri struct(b I32, h I32) {
    base mut I32 = b
    high mut I32 = h
}
fn (t Tri&) Area() I32 { return t.base * t.high / 2 }
fn (t Tri&) Sides() I32 { return 3 }

# a BY-VALUE receiver satisfies too (T31 gives the receiver the same latitude E12 gives any argument)
type Dot struct(v I32) {
    x mut I32 = v
}
fn (d Dot) Area() I32 { return 0 }
fn (d Dot) Sides() I32 { return 1 }

# a named primitive is a type like any other (T29), so it can carry methods and satisfy a trait
type Ring I32
fn (r Ring) Area() I32 { return r }
fn (r Ring) Sides() I32 { return 0 }

# M19e: a default - a method of every type satisfying the trait, declared once in the trait's module on a type
# variable the trait constrains
fn (s <S Shape>) Describe() I32 { return s.Area() + s.Sides() }

fn areaOf(s <S Shape>) I32 { return s.Area() }

test "a trait constrains generic code, compiled per type with direct calls" {
    q Square& = Square(4)
    t Tri& = Tri(6, 4)
    assert areaOf(q) == 16 and areaOf(t) == 12
    assert areaOf(Dot(9)) == 0 and areaOf(Ring(7)) == 7
    assert q.Describe() == 20        # M19e: the default, on every Shape
    assert Ring(7).Describe() == 7
}

# T30's "mut" is the receiver half of D9's two axes: a method that writes declares it, and a type satisfies it only
# with a "mut" receiver
type Ticker trait {
    Reading() I32
    mut Nudge(n I32)
}

type Ledger struct(v I32) {
    n mut I32 = v
}
fn (t Ledger&) Reading() I32 { return t.n }
fn (t mut Ledger&) Nudge(n I32) { t.n = t.n + n }

fn bumpTwice(c mut <C Ticker>&, n I32) {
    c.Nudge(n)
    c.Nudge(n)
}

test "a mut trait method writes through to the very instance" {
    t Ledger& = Ledger(1)
    bumpTwice(t, 10)
    assert t.n == 21 and t.Reading() == 21
}

# a fallible method is an ordinary one: the trait declares the error list, and T31 requires the concrete method's to
# match it exactly and in order
error SinkError { Full }

type Sink trait {
    mut Put(n I32) ? SinkError
    Total() I32
}

type Cap struct(limit I32) {
    max I32 = limit
    sum mut I32 = 0
}
fn (c mut Cap&) Put(n I32) ? SinkError {
    if c.sum + n > c.max { error SinkError.Full }
    c.sum = c.sum + n
}
fn (c Cap&) Total() I32 { return c.sum }

fn sinkFill(s mut <K Sink>&, n I32) I32 {
    caught I32 = 0
    for i in range 3 {
        try s.Put(n) catch SinkError { caught++ }
    }
    return caught
}

test "a fallible trait method propagates through generic code" {
    c Cap& = Cap(10)
    assert sinkFill(c, 4) == 1 and c.Total() == 8
}

test "a generic call runs as a spawned task" {
    a Ledger& = Ledger(0)
    b Ledger& = Ledger(0)
    join {
        spawn bumpTwice(a, 3)
        spawn bumpTwice(b, 4)
    }
    assert a.n == 6 and b.n == 8
}

# several concrete types in ONE collection: an enum of them (T17), whose match is checked for every case - the static
# counterpart of what a trait object would be elsewhere
type AnyShape enum {
    Sq(q Square&)
    Tr(t Tri&)
    Rg(r Ring)
}

fn (a AnyShape) Area() I32 {
    match a {
        case AnyShape.Sq(q) { return q.Area() }
        case AnyShape.Tr(t) { return t.Area() }
        case AnyShape.Rg(r) { return r.Area() }
    }
}

test "a collection of mixed types is an enum of them" {
    items := AnyShape[AnyShape.Sq(Square(3)), AnyShape.Tr(Tri(4, 5)), AnyShape.Rg(Ring(6))]
    sum I32 = 0
    for x in items { sum += x.Area() }
    assert sum == 25
}

# these are compile errors, so they can only be named here: a trait written as a type ("s Shape&") - it is a
# constraint (T30); a type missing a method (or with the wrong receiver mutability) does not satisfy it; a method
# signature may not be generic (T35); two methods of the SAME type may not share a name (M21); and no method may be
# called plainly - "Area(q)" is rejected, only "q.Area()" calls it (M19).

# ---- enum payloads (T17, T17a, T17b, S13a) ----

# T17: a case may carry a payload, written as a parameter list. The payload is modelled as an anonymous
# struct behind the scenes, which is why sizing, field access and codegen needed almost nothing new. A
# case with no payload is exactly what every case was before payloads existed, and an enum where NO case
# carries one keeps the bare-i32 representation it always had.
type Figure enum {
    Circle(r I32)
    Rect(w I32, h I32)
    Nothing
}

# there is no constructor on an enum and deliberately so: picking a case IS the interesting logic, and
# an ordinary function expresses it - fallibly if it wants to, unlike a struct's infallible literal
fn classify(w I32, h I32) Figure {
    if w == 0 { return Figure.Nothing }
    if w == h { return Figure.Circle(w) }
    return Figure.Rect(w, h)
}

# T17b: "case Type.Case(a, b)" matches the tag AND binds the payload's fields to fresh locals that exist
# only inside that arm. The identifiers are always binding occurrences, never expressions - which is what
# makes the form unambiguous against a construction written with the same characters.
fn area(s Figure) I32 {
    match s {
        case Figure.Circle(r) { return r * r * 3 }
        case Figure.Rect(w, h) { return w * h }
        case Figure.Nothing { return 0 }
    }
    return -1
}

test "an enum case carries a payload, and match binds it" {
    c Figure = Figure.Circle(4)
    r Figure = Figure.Rect(3, 5)
    n Figure = Figure.Nothing
    assert area(c) == 48
    assert area(r) == 15
    assert area(n) == 0
}

test "an enum value is created by naming a case, and nothing else" {
        # the two creation forms, and no third: a bare case, and a case with its payload
    a Figure = Figure.Nothing
    b Figure = Figure.Circle(2)
    assert area(a) == 0
    assert area(b) == 12
        # D15 admits both - the type is written right there at the declaration
    c := Figure.Rect(4, 4)
    assert area(c) == 16
        # and "construction with logic" is an ordinary function returning the type
    assert area(classify(0, 9)) == 0
    assert area(classify(3, 3)) == 27
    assert area(classify(2, 6)) == 12
}

# the payload buffer is sized for the LARGEST case, so a bigger case can follow a smaller one into the
# same variable with nothing left over from before - the whole space saving an enum has over a struct
# holding every alternative at once
test "assigning a different case overwrites the payload entirely" {
    s Figure = Figure.Rect(7, 9)
    assert area(s) == 63
    s = Figure.Circle(1)
    assert area(s) == 3
    s = Figure.Nothing
    assert area(s) == 0
}

# S13a: a match over an enum must cover every case, or say with "nomatch" that it deliberately does not.
# This is the one type where exhaustiveness is decidable and worth deciding - the set of cases is closed
# and written in one declaration - and it is most of the reason to declare an enum at all: adding a case
# tells you every place that now has to handle it.
fn isRound(s Figure) I32 {
    match s {
        case Figure.Circle(r) { return 1 }
        nomatch { return 0 }
    }
    return -1
}

test "nomatch is the opt-out from exhaustiveness, and still runs" {
    assert isRound(Figure.Circle(1)) == 1
    assert isRound(Figure.Rect(1, 2)) == 0
    assert isRound(Figure.Nothing) == 0
}

# a payload-carrying enum is an ordinary value: it goes in a struct field, crosses a call boundary by
# value, and is returned - no reference marker anywhere, because an enum is sized (largest case + tag)
type FigBox struct(s Figure) {
    inner mut Figure = s
}

test "an enum with a payload is an ordinary value type" {
    h FigBox& = FigBox(Figure.Rect(2, 8))
    assert area(h.inner) == 16
    h.inner = Figure.Circle(3)
    assert area(h.inner) == 27
}

# T17a: "==" on a payload-carrying enum compares the tag and then the LIVE case's payload. The
# comparison branches - which values get compared depends on a run-time tag - so it is emitted as one
# linkonce_odr function per enum type whose arms each return, rather than inline where a branch would
# need phi nodes threaded back through every level of the recursion. Reading a payload as case N is sound
# there for the same reason a match arm's bindings are: the tag test above the switch already established
# that N is the live case.
type Tagged enum {
    Num(f F64)
    Ref(c Recv&)
    Pair(p Pair2)
    Bytes(b Array<U8>&)
    Nest(i Figure)
    Void
}

type Recv struct(v I32) {
    val mut I32 = v
}

type Pair2 struct(a I32, b I32) {
    x mut I32 = a
    y mut I32 = b
}

test "enum equality compares the tag, then the live case's payload" {
    a Figure = Figure.Circle(3)
    b Figure = Figure.Circle(3)
    c Figure = Figure.Circle(4)
    r Figure = Figure.Rect(3, 5)
    r2 Figure = Figure.Rect(5, 3)
    n Figure = Figure.Nothing
    n2 Figure = Figure.Nothing
    assert a == b        # same case, same payload
    assert a != c        # same case, different payload
    assert a != r        # different case
    assert r != r2        # field order matters
    assert n == n2        # a payload-free case: equal tags is the whole answer
    assert n != a
}

# each payload field follows E10's own rule for its kind, because the payload is an ordinary struct and
# this is the ordinary structural comparison. Two of these are exactly why the comparison is not done by
# comparing the payload buffer bytewise: 0.0 and -0.0 are equal but differ in every bit, and a
# reference-shaped payload read as the wrong case would have dereferenced a garbage pointer.
test "a payload's fields compare by their own kind, not by their bytes" {
    z Tagged = Tagged.Num(0.0)
    nz Tagged = Tagged.Num(-0.0)
    assert z == nz

    c1 Recv& = Recv(5)
    c2 Recv& = Recv(5)
    assert Tagged.Ref(c1) == Tagged.Ref(c1)        # a reference compares by identity (E10)
    assert Tagged.Ref(c1) != Tagged.Ref(c2)        # ...even though the two Recvs hold the same value

    assert Tagged.Pair(Pair2(1, 2)) == Tagged.Pair(Pair2(1, 2))        # a value struct, memberwise
    assert Tagged.Pair(Pair2(1, 2)) != Tagged.Pair(Pair2(1, 3))

    buf Array<U8> = U8[U8(1), U8(2), U8(3)]
    assert Tagged.Bytes(buf) == Tagged.Bytes(buf)
    assert Tagged.Bytes(buf) != Tagged.Void

        # a nested enum recurses through its own comparison function
    assert Tagged.Nest(Figure.Circle(1)) == Tagged.Nest(Figure.Circle(1))
    assert Tagged.Nest(Figure.Circle(1)) != Tagged.Nest(Figure.Circle(2))
    assert Tagged.Nest(Figure.Circle(1)) != Tagged.Nest(Figure.Nothing)
    assert Tagged.Void == Tagged.Void
}

# O3: a payload may carry a "&name" scope tag, declared by appearing exactly as it is in a function
# signature. The ENUM TYPE owns the list, so every case's payload shares one namespace, and the name is
# bound at construction from the argument's own tag the way a call binds a callee's scope variables -
# which is what lets an enum carry a reference OUT of the function that built it.
type Crate struct(n I32) {
    v mut I32 = n
}

type Parcel enum {
    Held(c Crate&)
    Empty
}

fn parcelOf(c Crate&) Parcel { return Parcel.Held(c) }

# O13/O18a: a fresh payload has nothing to determine its scope, so it is built where the value lands - here
# the result scope, which follows the call. This is the factory shape: build a new payload directly where
# the caller puts it.
fn freshParcel(seed I32) Parcel { return Parcel.Held(Crate(seed)) }

test "a scope argument supplies the scope a fresh payload is built into" {
    p Parcel = freshParcel(4)
    match p {
        case Parcel.Held(c) { assert c.v == 4 }
        case Parcel.Empty { unreachable }
    }
}

# two arms of two different matches binding the SAME name are two different locals. They are separate
# scopes on the semantic side, and codegen has to push one per arm to agree - without it the second
# binding allocated its own slot, stored into it, and then every read resolved to the FIRST arm's slot by
# name, so the second match silently reported the first match's payload.
test "two match arms may bind the same name without colliding" {
    a Parcel = parcelOf(Crate(1))
    b Parcel = parcelOf(Crate(2))
    match a {
        case Parcel.Held(c) { assert c.v == 1 }
        case Parcel.Empty { unreachable }
    }
    match b {
        case Parcel.Held(c) { assert c.v == 2 }
        case Parcel.Empty { unreachable }
    }
}

test "an enum carries a reference out of the function that built it" {
    outer Crate& = Crate(7)
    p Parcel = parcelOf(outer)
    match p {
        case Parcel.Held(c) { assert c.v == 7 }
        case Parcel.Empty { unreachable }
    }
    outer.v = 9
    match p {
        case Parcel.Held(c) { assert c.v == 9 }        # the same instance, borrowed - never a copy
        case Parcel.Empty { unreachable }
    }
}

# O13 reaches into an enum's payloads: returning an enum whose case holds a bare "&" reference hands
# back whatever that reference points at, and if this function allocated it, it dies at the return. That
# was NOT checked until an enum could hold a reference at all - "return Val.Held(localBox)" compiled and
# read the freed chunk, which happened to still hold the right bytes.
# The same escape survives a NAMED tag, and that half was never enum-specific: bind "&s" from an
# own-scoped argument and return the value, and the binding carries a reference out through a name the
# signature never mentions. A constructor-bearing struct with a "&s" field had exactly the same hole.
# Both are rejected now, by judging the BINDING on the returned operand rather than the tag on the return
# type. A known gap remains: a value returned with no recorded binding - a parameter handed straight back
# out - is not judged, because treating "no entry" as "own" would reject every pass-through function.

# these are compile errors, so they can only be named here. A match over an enum that misses a case and
# has no "nomatch" is rejected (S13a). A case pattern must name every field of its payload. And D13
# reaches into an enum's payloads now: a zero-filled array of an enum whose case holds a reference used
# to produce null references that matched the case and dereferenced cleanly to nothing - a real segfault,
# found by writing exactly that.

# ---- array indexing (E16) ----

# E16: an index is NOT checked at run time - the same reading C gives it, and one of exactly two places
# in the language where a program can reach storage it does not own (the other is extern, X1a). The check
# that used to be here was measured against C on the same work: about 50% on a data-dependent gather,
# where nothing about the index is provable, and nothing at all on a counted loop, where LLVM hoists it
# out. So it bought safety in one shape and was already free in the other, and removing it buys the first
# back. "try a[i]" went with it - there is no run-time check left to opt out of, so it would name a
# failure nothing can detect.
# What survives costs nothing: a constant index into a fixed-size array is still settled at compile time
# (below), and a SLICE's bounds are still checked (E16b), because a slice is taken once and read many
# times - that cost is per slice expression, never per element access.

test "indexing in range is unaffected" {
    a Array<I32> = I32[10, 20, 30]
    assert a[0] == 10
    assert a[2] == 30
    sum I32 = 0
    for i in range a.Len() { sum = sum + a[i] }
    assert sum == 60
    a[1] = 99
    assert a[1] == 99
}

# where the index and the length are BOTH compile-time known there is nothing to defer: an out-of-range
# constant is an error where it is written rather than undefined behaviour when it is reached - which
# covers most indexing into fixed-size arrays, and costs nothing at run time either way. "a[7]" on an
# "I32[3]" is named here because it is a compile error and so cannot be written as a running test.
# "try a[i]" is a compile error too now, for the same reason: an index has no run-time check to opt out
# of, so it is rejected as a try on something infallible.
test "a constant index into a fixed-size array needs no run-time check" {
    fixed := Array<I32>(3)
    fixed[0] = 1
    fixed[2] = 3
    assert fixed[0] + fixed[2] == 4
}

# ---- temporal safety through nesting (O5/O15) ----

# a bare "&" slot reached THROUGH a reference-shaped container lives in the CONTAINER's scope, not in the
# storing function's. Its own tag says "own" (O4), so the ordinary fit check compared own against own and
# accepted storing a local's reference into storage that outlives the call - a use-after-free the moment
# the container is read again. It was reachable through a struct field, an array element and an enum
# payload alike; all three are rejected now.
type Crate2 struct(n I32) {
    v mut I32 = n
}

# these are compile errors and so can only be named here:
#   fn stash(dst mut Array<Crate2&>&) { local mut Crate2& = Crate2(9)  dst[0] = local }
#   fn stash(dst mut Keeper&)    { local mut Crate2& = Crate2(9)  dst.slot = Slot.Held(local) }
# Both stored a reference to this function's own scope into a slot belonging to a longer-lived container.
# The array case was verified to genuinely dangle: after the call, churning the arena to reuse the freed
# chunk left the stored reference reading someone else's bytes.

# what stays legal is the case E12c makes safe: a TEMPORARY has no storage to borrow, so it is allocated
# into the target's own scope rather than this function's - which is why assigning a fresh literal
# through a "&s"-tagged container is fine and must not be caught by the rule above
type Cradle struct(inner mut Crate2&) {
    inner mut
}

fn fillCradle(c mut Cradle&, n I32) I32 {
    c.inner = Crate2(n)        # a literal: constructed into c's scope, not borrowed from own
    return c.inner.v
}

test "a temporary assigned through a reference container is built in the container's scope" {
    c Cradle& = Cradle(Crate2(0))
    assert fillCradle(c, 7) == 7
    assert c.inner.v == 7
}

# ---- D13 through monomorphization (G18) ----

# a generic's own declaration cannot answer "does this field's element type contain a reference?" - the
# element is a type VARIABLE, and a variable contains no reference, so the check passed at declaration and
# nothing re-asked once T became a struct holding one. That produced zero-filled storage full of null
# references in a language with no null, and a segfault on the first read through one. Every rule about
# what a type CONTAINS is re-checked per instantiation now.
type Cell2<T> struct(n I32) {
    Data mut Array<<T>>& = Array<<T>>(n)
}

# "Cell2<WithRef>(4)", where WithRef holds a "Box&", is a compile error and so can only be named here.
# The safe instantiations still work, which is the half that has to keep working:
test "a generic run-time-sized field still works for reference-free element types" {
    c Cell2<I32>& = Cell2<I32>(4)
    c.Data[0] = 7
    c.Data[3] = 9
    assert c.Data[0] + c.Data[3] == 16
    assert c.Data.Len() == 4

    b Cell2<U8>& = Cell2<U8>(2)
    b.Data[1] = U8(5)
    assert b.Data[1] == U8(5)
}

# ---- a returned struct whose validity depends on a reference field ----

# whether such a struct is valid depends on what its reference field holds, and that field can be written
# more than once - so the question is what stops an invalid write. The answer is that the TAG IS PART OF
# THE FIELD'S TYPE, making validity an invariant checked at every write rather than a property of the
# value that some paths establish and others break. Three gates compose, and none needs path analysis:
#   O14  - a struct with a BARE "&" field cannot be returned at all, so there is no untagged escape
#   the tag - every assignment into a "&s" field is checked against s, where it is written
#   O13a - the binding made at construction is checked at the return
type Parcel3 struct(b mut Crate2&) {
    held mut Crate2&b = b
}

fn wrapValid(valid mut Crate2&) Parcel3 { return Parcel3(valid) }

test "a struct holding a reference can be returned when the scope is named" {
    outer Crate2& = Crate2(5)
    p Parcel3 = wrapValid(outer)
    assert p.held.v == 5
    outer.v = 6
    assert p.held.v == 6        # the same instance, borrowed, still live
}

# these are compile errors and so can only be named here. Each is one of the three gates:
#   type H struct(r Crate2&) { r mut }            fn mk(b Crate2&) H { return H(b) }
#     - O14: a bare "&" field in a returned struct, rejected outright
#   fn mk() Parcel3 { local mut Crate2& = Crate2(1)  return Parcel3(local) }
#     - O13a: s bound to this function's own scope at construction, caught at the return
#   fn mk(valid Crate2&s) Parcel3 { p mut Parcel3 = Parcel3(valid)
#                                     local mut Crate2& = Crate2(1)
#                                     p.held = local  return p }
#     - the field's own tag: rejected AT THE ASSIGNMENT, not deferred to the return
#   ...and the same assignment inside one arm of an "if" is rejected on that arm's own terms, so
#      branches never have to be merged to decide validity.

# ---- merging scope-variable bindings across branches ----

# a value built by a constructor records what each of its type's scope variables was bound to AT THAT
# CONSTRUCTION. Reassigning it in one arm of an "if" rebinds them, so after the branch the checker has to
# say what the binding is: agreeing arms keep the agreed scope, disagreeing arms are marked definitely
# ambiguous rather than silently picking one. Ambiguous is then treated as unverifiable and rejected,
# because "it could be more than one thing" includes "it could be this function's own scope" whenever any
# arm bound it there - and that arm would return a reference to a scope that closed at the return.
fn mergedSame(a mut Crate2&, b mut Crate2&a, c Bool) Parcel3 {
    h Parcel3 = Parcel3(a)
    if c { h = Parcel3(b) }        # both arms bind s to p - they agree
    return h
}

# arms binding two DIFFERENT named scopes: no single name for the meet, but both candidates outlive the
# call, so every check against them passes and the value is returnable
fn mergedDiffer(a mut Crate2&, b mut Crate2&, c Bool) Parcel3 {
    h Parcel3 = Parcel3(a)
    if c { h = Parcel3(b) }
    return h
}

test "branches that agree on a scope keep it" {
    x Crate2& = Crate2(4)
    y Crate2& = Crate2(9)
    assert mergedSame(x, y, false).held.v == 4
    assert mergedSame(x, y, true).held.v == 9
    assert mergedDiffer(x, y, false).held.v == 4
    assert mergedDiffer(x, y, true).held.v == 9
}

# these are compile errors and so can only be named here:
#   fn f(a Crate2&p, c bool) Parcel3 { h mut Parcel3 = Parcel3(a)
#       if c { local mut Crate2& = Crate2(1)  h = Parcel3(local) }
#       return h }
#     - one arm binds s to this function's own scope; the merge marks s ambiguous and the return is
#       rejected. Before ambiguity was treated as unverifiable this was ACCEPTED, returning a dangling
#       reference on exactly one path.
# Two different named scopes are NOT rejected, and that is the point of keeping candidates rather than
# collapsing to "unverifiable": the meet of p and q has no single name here, but every question asked of
# it distributes - "min(p,q) outlives T" is exactly "p outlives T and q outlives T" - so each candidate is
# checked and both pass. Works for a match's N arms as well as an if's two.

# ---- a stored value's references must outlive the CONTAINER, not just this call ----

# the rule the whole scope system exists for, stated plainly: whatever a struct points at must live at
# least as long as the struct does. Checking only for "bound to this function's own scope" caught the
# case where the short-lived reference was created right here, and missed the one where it arrived as a
# "&s" parameter while the container was tagged "&t" - nothing related s to t, so a caller could pass its
# own local and have it stored somewhere that outlives the call. That was a real use-after-free: after the
# call returned, churning the arena left the stored reference reading someone else's bytes.
type Held3 struct(b mut Crate2&) {
    held mut Crate2&b = b
}
type Box3 struct(x Held3) {
    inner mut Held3 = x
}

# the body needs "b's scope outlives o's": an obligation (O10b) every caller discharges through its own
# bindings (O10c)
fn stash3(o mut Box3&, b mut Crate2&) { o.inner = Held3(b) }

test "storing into a container of the same scope discharges the obligation" {
    seed Crate2& = Crate2(1)
    o Box3& = Box3(Held3(seed))
    payload Crate2& = Crate2(42)
    stash3(o, payload)        # both own of this test: s and t agree
    assert o.inner.held.v == 42
}

# the caller that cannot discharge it is a compile error and so can only be named here:
#   fn caller(o mut Box3&far) { local mut Crate2& = Crate2(777)
#                                 stash3(o, local) }
# local dies when caller returns; o outlives it. Rejected AT THE CALL, by the obligation stash3 recorded.

# a field's own "&name" tag names a scope variable of the TYPE, never anything in the writing function's
# frame - so it has to be resolved through the target's own binding map before being compared, exactly as
# a call resolves a parameter's tag through the call's bindings. The call path always did this; the
# assignment path never did, so writing a value back into a field of a locally-constructed container was
# rejected even though the construction had bound that very scope to the value's own.
fn roundTrip(b mut Crate2&) I32 {
    h Held3& = Held3(b)        # binds Held3's own scope variable to b's
    h.held = b        # ...so writing b back in is the same scope, and must be allowed
    return h.held.v
}

test "a value can be written back into a field of a container built from it" {
    payload Crate2& = Crate2(11)
    assert roundTrip(payload) == 11
}

# and the unsafe direction is still caught, which is what makes the above a fix rather than a loosening:
#   fn mk(b Crate2&s) I32 { h mut Held3& = Held3(b)
#                               local mut Crate2& = Crate2(1)
#                               h.held = local  return h.held.v }
# local dies before the scope Held3's field is tagged to, so the write is rejected.

# ---- O22: a derived obligation, so a field of a container PARAMETER can be written ----

# "o.held = b" was not writable. The field's tag names a scope variable of the TYPE, bound wherever the
# container was constructed - possibly in another function - so this body can neither decide the relation
# nor name it in its own signature, and an ordinary obligation cannot carry it either.
# What it can do is record the requirement against the PARAMETER the container arrived through, and let
# the caller resolve it: the caller holds that binding, on the very argument it is about to pass. Where
# even that caller only has a parameter, it records its own derived obligation and the question moves one
# frame up - terminating at whoever constructed the container, exactly as O10c already terminates.
fn putHeld(o mut Held3&, b mut Crate2&) { o.held = b }

test "a field of a container parameter can be written, and the caller discharges it" {
    seed Crate2& = Crate2(1)
    h Held3& = Held3(seed)
    payload Crate2& = Crate2(55)
    putHeld(h, payload)        # both own of this test, so the obligation discharges
    assert h.held.v == 55
}

# the alternative - forgetting the construction binding and falling back to the container's scope for
# both reads and writes - is sound, and was tried and rejected. It costs per-field precision: a container
# whose two fields live in DIFFERENT scopes has only one tag to offer, so the longer-lived field stops
# being returnable. The corpus has exactly that shape (DualWrapped, above), and a single container tag
# cannot be both "a" and "own". Derived obligations keep the precision and make the write legal.
# Worth stating, since it is the reason this is safe rather than merely convenient: a binding recorded at
# construction cannot go stale. Every write into the field is checked against that same scope variable -
# which is what this rule adds - so no write that would falsify it is admitted in the first place.

# these are compile errors and so can only be named here:
#   fn putHeld(o mut Held3&s) { local mut Crate2& = Crate2(1)  o.held = local }
#     - own can satisfy no named scope, and no caller could change that
#   fn bad(o mut Held3&far) { local mut Crate2& = Crate2(1)  putHeld(o, local) }
#     - the obligation reaches this caller and it cannot discharge it: local dies before far does

# ---- O23: a field of a container parameter reads at the container's scope ----

# a bare "&" means own (O4), which is literally true and useless for a PARAMETER: whatever the caller
# passed provably outlives the call, so calling it own throws information away and makes a field of that
# parameter unreadable for anything that has to outlive the call. Give the container's scope a name and
# the field falls back to it.
# Sound because it is an underestimate, never a claim: every value that can be in the field was required
# to outlive the container's construction scope, which outlives wherever the container now sits. And it
# only works because O22 keeps the WRITE side precise - weakening both halves to the container's scope
# costs per-field precision, weakening only the read costs nothing.
fn innerOf(w Held3&) Crate2&w { return w.held }

test "a field of a container parameter can be read out at the container's scope" {
    c Crate2& = Crate2(31)
    h Held3& = Held3(c)
    assert innerOf(h).v == 31
}

# ---- building through a container parameter (C2d) ----

# a field that lives with its instance - bare "&" - lives where the container does, and a container
# parameter carries its scope (O4b), so a temporary written into it is built in the caller's arena.
type Held5 struct(b mut Crate2&) { held mut Crate2& = b }

fn fillNamed(o mut Held5&) { o.held = Crate2(9) }

test "a temporary written through a container parameter lands in the caller's scope" {
    seed Crate2& = Crate2(1)
    h Held5& = Held5(seed)
    fillNamed(h)
    assert h.held.v == 9
}

# a field written "&p" lives where its constructor argument did, which a function receiving the container
# does not know - so it may read through it, and pass it on, but not build through it. The rejected program
# can only be named here: "fn fill(o mut Held3&) { o.held = Crate2(9) }".
type Wrap2 struct(i mut Crate2&) {
    inner mut Crate2&i = i
}

# a local naming where it lives - here where w does, which is where its field's referent is read at (O23)
fn narrows(w Wrap2&) I32 {
    r Crate2&w = w.inner
    return r.v
}

fn takesNamed(c Crate2&) I32 { return c.v }
fn passesOn(w Wrap2&) I32 { return takesNamed(w.inner) }

# an instance-scoped field can be built into and returned, borrowed from the container
fn namedBoth(w mut Held5&) Crate2&w {
    w.held = Crate2(4)        # allocation: lands in w's scope, the caller's arena
    return w.held
}

test "a field is read through and passed on; an instance-scoped one is built into and returned" {
    seed Crate2& = Crate2(7)
    w Wrap2& = Wrap2(seed)
    assert narrows(w) == 7
    assert passesOn(w) == 7
    h Held5& = Held5(seed)
    assert namedBoth(h).v == 4
    assert h.held.v == 4
}

# these are compile errors and so can only be named here:
#   fn f(w Wrap2&) Crate2&a { return w.inner }   - an unnameable scope cannot appear in a return type
#   fn f(w mut Wrap2&) { w.inner = Crate2(1) }   - nothing may be allocated into it (O24)
# Both said "own cannot outlive" before, which was true of the letter and false of the remedy: the fix is
# one token, not a redesign. They now say so.

# L13/L14: "\0" and "\r" are escapes in both literal forms. A STRING literal used to decode "\0" as the
# character '0' - only the character-literal decoder knew the escape - so "a\0" held 'a', '0'.
test "escapes: \0 and \r decode to their bytes in strings and characters" {
    s := "a\0b\r"
    assert s.Len() == 4
    assert s[1] == 0
    assert s[3] == 13
    assert '\0' == 0
    assert '\r' == 13
}

# a self-referential struct's field held a SNAPSHOT of the struct taken while it was still being resolved,
# with only the fields declared before the self-reference - so "a.next.v" worked and "a.next.next" was an
# unknown member. Every such field now points at the finished declaration, so a chain reads at any depth.
type Link struct(x I32) {
    v mut I32 = x
    next mut Link& = null
}

test "a self-referential struct reads through a chain of any length" {
    a Link& = Link(1)
    a.next = Link(2)
    a.next.next = Link(3)
    a.next.next.next = Link(4)
    assert a.next.next.next.v == 4
    assert a.next.next.next.next == null
}

# G8: a generic type may name ITSELF in a field - a generic linked node. It was rejected as "not generic"
# (its parameters were set only after its fields resolved) and, once allowed, instantiated itself forever
# (an instantiation was registered only after its fields were substituted).
type GLink<T> struct(x <T>) {
    v mut <T> = x
    next mut GLink<<T>>& = null
}

# S9: the post clause is a simple statement, so a loop can advance by assignment - and a post that
# computes a value and discards it ("i + 1", which never advances) is S3's error rather than a silent
# infinite loop
test "a generic linked node, walked by a for loop that advances by assignment" {
    a GLink<I64>& = GLink<I64>(1)
    a.next = GLink<I64>(20)
    a.next.next = GLink<I64>(300)
    sum I64 = 0
    for c GLink<I64>& = a, c != null, c = c.next {
        sum = sum + c.v
    }
    assert sum == 321
}

# O3: a scope name is not a value, so a local may share one - and codegen keyed both by bare name, so
# "return res" below found the hidden scope argument's slot and returned the scope pointer as the array
fn sizedIn(n I32) Array<I32>& {
    res Array<I32>&return = Array<I32>(n, 7)
    return res
}

test "a returned local is built where the result goes" {
    a Array<I32>& = sizedIn(3)
    assert a.Len() == 3
    assert a[2] == 7
}

# O25: a reference NEVER narrows. Its tag is the exact scope its referent was allocated in, so anything
# written through it is allocated where that referent lives. Narrowing used to be allowed and was the
# hole: "a mut Link& = p" retagged the caller's node to this function's scope, and "a.next = Link(5)" then
# allocated the new node in this function's arena and hung it off the caller's list - read back as garbage
# once the arena was reused. Now a local says where it lives - here, where p does.
fn linkThrough(p mut Link&) {
    a Link&p = p        # a is exactly p's scope, not this function's own
    a.next = Link(5)        # so the new node is allocated there
}

fn churnLinks() I32 {
    t I32 = 0
    for i in range 200 {
        q Link& = Link(77)
        t = t + q.v
    }
    return t
}

test "O25: a write through an adopted local lands in the referent's scope" {
    root Link& = Link(1)
    linkThrough(root)
    churnLinks()
    assert root.next.v == 5
}

# the same hole one hop further: a FIELD read determined a callee's scope variable by the field's own bare
# tag rather than by its container's scope, so the callee allocated into the inner block's arena
fn growLink(p mut Link&) { p.next = Link(9) }

test "O25: a field read determines a callee's scope as its container's" {
    a Link& = Link(1)
    a.next = Link(2)
    if a.v == 1 {
        growLink(a.next)
    }
    churnLinks()
    assert a.next.next.v == 9
}

# what exactness makes legal that the old blanket rule rejected: two locals of one block linking to each
# other, and a cursor in an inner block writing through what it walks
test "O25: same-scope locals link, and an inner-block cursor writes into the outer structure" {
    a Link& = Link(1)
    b Link& = Link(2)
    a.next = b
    if a.v == 1 {
        c Link&a = a        # exactly a's scope, not the if's
        c.next.next = Link(3)
    }
    churnLinks()
    sum I32 = 0
    for c Link& = a, c != null, c = c.next { sum = sum + c.v }
    assert sum == 6
}

# a bare "&" parameter's scope has no name here (O4a): adopting it is fine for reading, and nothing can be
# allocated into it or stored through it
fn sumLinks(p Link&) I32 {
    sum I32 = 0
    for c Link&p = p, c != null, c = c.next { sum = sum + c.v }
    return sum
}

test "O25: a bare parameter's scope is adopted for reading" {
    a Link& = Link(4)
    a.next = Link(5)
    assert sumLinks(a) == 9
}

# rejected, and nameable only here:
#   r mut Link& = Link(2)  ... r = outer        # r is this block's; outer is not - a reassignment never narrows
#   fn f(b mut Box&s, p Link&t) { b.inner = p }   # Link holds references, so the slot's scope must BE t
#   fn f(p Link&t) Link&s { return p }         # the same, at a return
#   fn f(p mut Link&) { growLink(p) }          # p's scope has no name here, and growLink writes through it
#   fn f(p mut Link&) { a mut Link& = p   a.next = Link(1) }   # the same, through an adopted local

# D15: ":=" takes its type from any call returning a value, "try" calls included. A reference result takes
# the call's exact scope (O25a), so it is written through exactly as a declared one would be.
fn sevenFold(n I32) I32 { return n * 7 }
fn freshLink(n I32) Link& { return Link(n) }

test "D15: := from a call" {
    a := sevenFold(3)
    assert a == 21
    l := freshLink(4)
    l.next = Link(5)
    churnLinks()
    assert l.next.v == 5
}

# D8c: a function may return several values - "(T1, T2)" after its parameters, "return a, b" in its body.
# They are received by destructuring, or passed as all of a call's arguments (D8d), and are never one value: there
# is no tuple type to store or pass (two values held together are a Pair).
# "_" discards one, ":=" declares, "=" assigns into existing places, and "try" and "spawn" both apply.
fn divmodD(a I32, b I32) (I32, I32) { return a / b, a % b }
fn passD(a I32, b I32) (I32, I32) { return divmodD(a, b) }        # several results passed on whole

error DivError { ZERO }
fn safeDivD(a I32, b I32) (I32, I32) ? DivError {
    if b == 0 { error DivError.ZERO }
    return a / b, a % b
}
fn digitsD(a I32, b I32) I32 ? DivError {
    q, r := try safeDivD(a, b)
    return q * 10 + r
}

# each result keeps its own scope tag, and every scope rule applies to it separately
fn linkAndDouble(n I32) (Link&, I32) { return Link(n), n * 2 }

fn swapD(a <T>, b <T>) (<T>, <T>) { return b, a }

type RangeD struct(l I32, h I32) {
    lo mut I32 = l
    hi mut I32 = h
}
fn (r RangeD&) Bounds() (I32, I32) { return r.lo, r.hi }
type BoundedD trait { Bounds() (I32, I32) }
fn widthD(b <B BoundedD>&) I32 {
    lo, hi := b.Bounds()
    return hi - lo
}

test "D8c: several results, destructured" {
    q, r := divmodD(17, 5)
    assert q == 3
    assert r == 2
    a := 0
    b := 0
    a, b = passD(20, 6)
    assert a == 3
    assert b == 2
    _, only := divmodD(9, 4)
    assert only == 1
    arr := Array<I32>(2, 0)
    arr[0], arr[1] = divmodD(11, 3)
    assert arr[0] == 3
    assert arr[1] == 2
}

test "D8c: with try, scopes, generics, methods and interfaces" {
    ok := true
    try digitsD(7, 0) catch DivError { ok = false }
    assert not ok
    l, twice := linkAndDouble(21)
    l.next = Link(22)
    churnLinks()
    assert l.next.v == 22
    assert twice == 42
    x, y := swapD(I64(5), 7)
    assert x == 7
    assert y == 5
    rg := RangeD(3, 10)
    lo, hi := rg.Bounds()
    assert hi - lo == 7
    assert widthD(rg) == 7
}

test "D8c: spawn binds several results" {
    q := 0
    r := 0
    only := 0
    join {
        spawn q, r = divmodD(17, 5)
        spawn _, only = divmodD(9, 4)
    }
    assert q == 3
    assert r == 2
    assert only == 1
}

# D8d: a call returning several values, as the only argument of a call, passes them as its arguments - each
# result to one parameter, in order, the call evaluated once. Functions, generics, methods and constructors alike.
spreadCallsD mut I32 = 0
fn countedDivmodD(a I32, b I32) (I32, I32) {
    spreadCallsD++
    return a / b, a % b
}
fn addD(a I32, b I32) I32 { return a + b }
fn pickSecondD(a <T>, b <T>) <T> { return b }
fn (r RangeD&) ShiftedD(dlo I32, dhi I32) I32 { return r.lo + dlo + r.hi + dhi }
fn digitSumD(n I32) I32 ? DivError { return addD(try safeDivD(n, 10)) }
fn twiceD(f fn(a I32) I32, v I32) (I32, I32) { return f(v), f(f(v)) }
# a reference among the results lands where the outer call's result does (O18a)
fn linkPairD(n I32) (Link&, I32) { return Link(n), n }
fn keepLinkD(l mut Link&, n I32) mut Link&l {
    l.v = l.v + n
    return l
}
fn spreadFromInnerD() Link& { return keepLinkD(linkPairD(9)) }
SpreadBakedD I32 = addD(divmodD(17, 5))   # K2: computed while compiling

test "D8d: several results passed as a call's arguments" {
    before I32 = spreadCallsD
    assert addD(countedDivmodD(17, 5)) == 5
    assert spreadCallsD == before + 1
    assert pickSecondD(divmodD(9, 4)) == 1
    rg := RangeD(divmodD(7, 2))
    assert rg.lo == 3 and rg.hi == 1
    assert rg.ShiftedD(divmodD(7, 2)) == 8
    assert (try digitSumD(42) catch default -1) == 6
    k I32 = 3
    assert addD(twiceD(fn(a I32) I32 { return a * k }, 5)) == 60
    assert addD(divmodD(23, 4)) == 8     # S18c: decided while compiling
    assert SpreadBakedD == 5
}

test "D8d: a spread reference lives where the outer result lands" {
    x := keepLinkD(linkPairD(7))
    y := spreadFromInnerD()
    churnLinks()
    assert x.v == 14 and y.v == 18
}

# O14a: a function value is returned from a parameter with no borrowed form - each call checks that the argument
# outlives where the result lands
fn idFnO(f fn(a I32) I32) fn(a I32) I32 { return f }
fn chooseFnO(c Bool, f fn(a I32) I32, g fn(a I32) I32) fn(a I32) I32 {
    if c { return f }
    return g
}
fn doubleO(a I32) I32 { return a * 2 }
fn viaIdO(n I32) I32 {
    g := idFnO(doubleO)
    return g(n)
}
ViaIdBakedO I32 = viaIdO(21)   # K2: computed while compiling

test "O14a: a function value passes back through a function" {
    d := idFnO(doubleO)
    assert d(3) == 6
    k I32 = 10
    addK := fn(a I32) I32 { return a + k }
    h := idFnO(addK)
    churnLinks()
    assert h(1) == 11
    p := chooseFnO(false, doubleO, addK)
    assert p(2) == 12
    assert viaIdO(4) == 8          # S18c: decided while compiling
    assert ViaIdBakedO == 42
}

# E13b: "(args)" after any expression calls the function value it gives - a call's result, an element, a
# parenthesized expression - evaluated before the arguments; "try" covers the last call of the chain
fn adderE(k I32) fn(a I32) I32 { return fn(a I32) I32 { return a + k } }
fn limiterE(lim I32) fn(a I32) I32 ? DivError {
    return fn(a I32) I32 ? DivError {
        if a > lim { error DivError.ZERO }
        return a
    }
}
fn limitedE(n I32) I32 ? DivError { return try limiterE(5)(n) }
ChainBakedE I32 = adderE(3)(4)   # K2: computed while compiling

test "E13b: a call's result, an element or a parenthesized value is called directly" {
    assert idFnO(doubleO)(3) == 6
    assert adderE(10)(1) == 11
    fs := Array<fn(a I32) I32>(2)
    fs[0] = doubleO
    fs[1] = adderE(1)
    assert fs[1](fs[0](5)) == 11
    assert (idFnO(doubleO))(4) == 8
    assert (try limitedE(3) catch default -1) == 3
    assert (try limitedE(9) catch default -1) == -1
    assert adderE(2)(2) == 4       # S18c: decided while compiling
    assert ChainBakedE == 7
}

test "E13b: a parenthesized expression on the next line is a statement of its own" {
    y fn(a I32) I32 = doubleO
    (y)(2)
    k := adderE(1)(1)
    (doubleO)(k)
    assert k == 2
}

# rejected, and nameable only here:
#   t := divmodD(1, 2)            several results are not one value
#   divmodD(1, 2) + 1             nor an operand
#   a, b, c := divmodD(1, 2)      one target per result
#   arr[0], d := divmodD(1, 2)    ":=" declares plain names; "=" assigns into places
#   _ := 3                        "_" names nothing and cannot be declared

# R9a: "try X catch default d" - the value on failure, in place of propagating

tdCalls mut I32 = 0

fn tdFallback(v I32) I32 {
    tdCalls++
    return v
}

fn tdWide(ok Bool) I64 ? MathError {
    if not ok { error MathError.DIV_BY_ZERO }
    return 5000000000
}

fn tdPair() (I32, I32) {
    return try safeDivD(1, 0) catch default 9, 8
}

fn tdAdd(a I32, b I32) I32 {
    return a + b
}

# declares no errors: a try with a catch default handles everything the call can produce
fn tdNoErrors(b I32) I32 {
    return try SafeDiv(10, b) catch default -1
}

test "R9a: a default stands in for a failed call, and the success value is untouched" {
    x := try SafeDiv(10, 0) catch default 7
    assert x == 7
    y := try SafeDiv(10, 2) catch default 7
    assert y == 5
    assert tdNoErrors(0) == -1
    assert tdNoErrors(5) == 2
}

test "R9a: several results take one default each, where they are destructured or returned" {
    n, m := try safeDivD(7, 0) catch default 3, 2
    assert n == 3
    assert m == 2
    q, r := try safeDivD(7, 2) catch default 3, 2
    assert q == 3
    assert r == 1
    a, b := tdPair()
    assert a == 9
    assert b == 8
}

test "R9a: the default is evaluated only on failure" {
    tdCalls = 0
    v := try SafeDiv(8, 2) catch default tdFallback(1)
    assert v == 4
    assert tdCalls == 0
    w := try SafeDiv(8, 0) catch default tdFallback(6)
    assert w == 6
    assert tdCalls == 1
}

tdZero mut I32 = 0        # a divisor known only at run time: with a constant one the condition below is fixed (S8a)

test "R9a: a default binds as tightly as the try, and is one value inside an argument list" {
    if try SafeDiv(1, tdZero) catch default 0 == 0 {
        tdCalls = 100
    }
    assert tdCalls == 100
    assert 1 + (try SafeDiv(1, 0) catch default 10) == 11
    assert tdAdd(try SafeDiv(1, 0) catch default 1, 2) == 3
    big := try tdWide(false) catch default 3
    assert big == I64(3)
    assert (try tdWide(true) catch default 3) == 5000000000
}

test "R9a: a checked index and a slice take a default for out-of-range" {
    a Array<I32> = I32[1, 2, 3]
    assert (try a[1] catch default -1) == 2
    three I32 = 3
    assert (try a[three] catch default -1) == -1
    i I32 = -4
    assert (try a[i] catch default 42) == 42
    s := try a[2:9] catch default null
    assert s.Len() == 0
    t := try a[0:2] catch default null
    assert t.Len() == 2
}

type TdBox struct(v I32) {
    v mut
}

fn tdPick(b TdBox&, ok Bool) TdBox&b ? MathError {
    if not ok { error MathError.DIV_BY_ZERO }
    return b
}

# the default is another reference in the result's own scope - p's, which q shares
fn tdOther(p TdBox&, q TdBox&p) TdBox&p {
    return try tdPick(p, false) catch default q
}

# the default is a temporary: it has no scope of its own, so it is built where the result lives - the
# p's scope - and must survive this function's return
fn tdFresh(p TdBox&) TdBox&p {
    return try tdPick(p, false) catch default TdBox(7)
}

test "R9a: a reference default lives in exactly the result's scope, or is built there, or is null" {
    a TdBox& = TdBox(1)
    b TdBox& = TdBox(2)
    r := try tdPick(a, false) catch default b
    assert r.v == 2
    assert r == b
    k := try tdPick(a, true) catch default b
    assert k == a
    n := try tdPick(a, false) catch default null
    assert n == null
    t := try tdPick(a, false) catch default TdBox(9)
    assert t.v == 9
    assert tdOther(a, b) == b
    f := tdFresh(a)
    for i in range 64 {
        churn TdBox& = TdBox(i)
        assert churn.v == i
    }
    assert f.v == 7
}

# R9b: several catch clauses, tried in order; in value position each leaves or gives its own default

error R9E {
    A
    B
}

error R9F {
    C
}

r9Seen mut I32 = 0

fn r9f(k I32) I32 ? R9E + R9F {
    if k == 1 { error R9E.A }
    if k == 2 { error R9E.B }
    if k == 3 { error R9F.C }
    return k * 10
}

# clauses on their own lines; the second runs its block and then gives its default
fn r9v(k I32) I32 {
    return try r9f(k)
        catch R9E.A default 100
        catch R9E { r9Seen = k } default 200
        catch default 300
}

# a clause that leaves needs no default - the assignment never runs on that path
fn r9leave(k I32) I32 {
    x := try r9f(k) catch R9F { return -1 } catch default 0
    return x + 1
}

# an error no clause names propagates, default or not
fn r9prop(k I32) I32 ? R9F {
    return try r9f(k) catch R9E default 7
}

test "R9b: catch statements take several clauses, the first that names the error runs" {
    hit := 0
    try r9f(1) catch R9E.A { hit = 1 } catch R9E { hit = 2 } catch { hit = 3 }
    assert hit == 1
    try r9f(2) catch R9E.A { hit = 1 } catch R9E { hit = 2 } catch { hit = 3 }
    assert hit == 2
    try r9f(3) catch R9E.A { hit = 1 } catch R9E { hit = 2 } catch { hit = 3 }
    assert hit == 3
    hit = 0
    try r9f(4) catch R9E.A { hit = 1 } catch R9E { hit = 2 } catch { hit = 3 }
    assert hit == 0
}

test "R9b: in value position each clause gives its own default, after its block" {
    r9Seen = 0
    assert r9v(1) == 100
    assert r9Seen == 0
    assert r9v(2) == 200
    assert r9Seen == 2
    assert r9v(3) == 300
    assert r9v(4) == 40
}

test "R9b: a clause that leaves needs no default" {
    assert r9leave(3) == -1
    assert r9leave(1) == 1
    assert r9leave(4) == 41
}

test "R9b: an error no clause names still propagates" {
    assert (try r9prop(1) catch default 0) == 7
    got := false
    try r9prop(3) catch R9F { got = true }
    assert got
}

test "R9b: break and continue leave a clause in value position" {
    ks Array<I32> = I32[4, 1, 5, 2, 3, 6]
    total := 0
    for i in range ks.Len() {
        v := try r9f(ks[i]) catch R9E { continue } catch R9F { break }
        total = total + v
    }
    assert total == 90
}

test "R9b: a checked index names the bare error, and several defaults sit in one clause" {
    a Array<I32> = I32[1, 2]
    j I32 = 7
    assert (try a[j] catch default -1) == -1
    n, m := try safeDivD(7, 0) catch DivError default 5, 6
    assert n == 5
    assert m == 6
}

# B5a: read by runner.olang's own global initializer, which must run after this one
fn sharedSeven() I32 {
    return 7
}

InitSeven I32 = sharedSeven()

# B9: a top-level if is conditional compilation - only the taken branch's declarations exist

if TestBuild {
    ccMode I32 = 1
} else {
    ccMode I32 = 2
}

if TestBuild and TargetOs == "no-such-os" {
    fn ccPick() I32 { return 10 }
} else if TestBuild {
        # a type declared inside a branch is known to the parser like any other (built by literal below)
    type CcBox struct(v I32) {
        v mut
    }

    fn ccPick() I32 { return 20 }

    if 2 * 3 == 6 and not (1.5 > 2) {
        fn ccNested() I32 { return 30 }
    }
} else {
    fn ccPick() I32 { return 40 }
}

# the branch not taken is never checked: nothing it names has to exist
if false {
    fn ccBroken() NoSuchType { return doesNotExist() }
}

# this test uses declarations that exist only in a test build, so it exists only there too
if TestBuild {
    test "B9: only the taken branch of a top-level if is compiled" {
        assert ccMode == 1
        assert ccPick() == 20
        assert ccNested() == 30
        b CcBox = CcBox(5)
        assert b.v == 5
    }
}

test "B10a: the built-in build constants are ordinary immutable globals" {
    assert TestBuild
    assert not RaceBuild or RaceBuild
    assert TargetOs.Len() > 0
    assert TargetArch.Len() > 0
}

# B9a: a top-level condition may read an immutable global computed from literals and build constants
ccLevel I32 = 2 + 1
ccRatio F64 = 1

if ccLevel * 2 == 6 and ccRatio < 1.5 {
    fn ccFromGlobal() I32 { return 1 }
} else {
    fn ccFromGlobal() I32 { return 2 }
}

test "B9a: a top-level condition reads immutable globals" {
    assert ccFromGlobal() == 1
}

# D15 for globals: read by runner.olang, whose bodies are checked before this module's
SharedUnits Array<U8> = "cm"
SharedInferred := 42

# K2: an immutable global whose initializer can be computed at compile time is - including through calls,
# loops, recursion, structs, arrays, references used along the way, and errors caught by a clause. Each
# of these is also checked to be written out as data (checks/checks.olang reads the emitted IR).

type KtCell struct(v I32) {
    v mut
}

fn ktFib(n I32) I32 {
    if n < 2 { return n }
    return ktFib(n - 1) + ktFib(n - 2)
}

fn ktSquares() Array<I32>& {
    t Array<I32>&return = Array<I32>(8)
    for i in range 8 {
        t[i] = i * i
    }
    return t
}

# a reference built and written through along the way, then read back into plain data
fn ktViaRef(n I32) I32 {
    c KtCell& = KtCell(n)
    ktBump(c)
    ktBump(c)
    return c.v
}

fn ktBump(c mut KtCell&) {
    c.v = c.v * 2
}

fn ktSumTo(n I32) I64 {
    total I64 = 0
    i := 0
    do {
        i++
        if i % 2 == 0 { continue }
        total = total + i
    } for i < n
    return total
}

KtFib20 I32 = ktFib(20)
KtSquares Array<I32>& = ktSquares()
KtCellVal KtCell = KtCell(ktFib(10))
KtViaRef I32 = ktViaRef(3)
KtOddSum I64 = ktSumTo(100)
KtCaught I32 = try SafeDiv(1, 0) catch default -7
KtRatio F32 = F32(KtFib20) / 2
KtWrapped U8 = U8(300)

# this one cannot be computed at compile time - it reads a mutable global - and is set at startup as before
ktRuntimeSeed mut I32 = 5
KtFromMutable I32 = ktRuntimeSeed + 1

# an assert that holds is no obstacle
KtFailsAssert I32 = ktChecked(0)

fn ktChecked(n I32) I32 {
    assert n == 0
    return n + 1
}

test "K2: globals computed at compile time hold what running their initializers would give" {
    assert KtFib20 == 6765
    assert KtSquares[7] == 49
    assert KtSquares[3] == 9
    assert KtCellVal.v == 55
    assert KtViaRef == 12
    assert KtOddSum == 2500
    assert KtCaught == -7
    assert KtRatio == 3382.5
    assert KtWrapped == U8(44)
    assert KtFromMutable == 6
    assert KtFailsAssert == 1
}

# K1: repointing a reference parameter moves only the callee's cursor (S4a), at compile time as at run time
fn ktRepoint(a mut KtCell&, b mut KtCell&) I32 {
    a = b
    return a.v
}

fn ktRepointOuter() I32 {
    x KtCell& = KtCell(1)
    y KtCell& = KtCell(2)
    r := ktRepoint(x, y)
    return x.v * 10 + r
}

# K1: an error an argument's own "try" propagates leaves the enclosing function - the call's clauses never
# see it
fn ktRaise() I32 ? MathError {
    error MathError.DIV_BY_ZERO
}

fn ktTake(n I32) I32 ? MathError {
    return n
}

fn ktOuterArg() I32 ? MathError {
    return try ktTake(try ktRaise()) catch default 5
}

KtRepoint I32 = ktRepointOuter()
KtBypass I32 = try ktOuterArg() catch default 9

test "K1: compile-time evaluation keeps a parameter's repoint local and an argument's error out of the call's clauses" {
    assert KtRepoint == 12
    assert KtBypass == 9
    assert (try ktOuterArg() catch default 9) == 9
}

# B9c: a top-level condition the token evaluator cannot decide - a call, a global computed by one - is
# decided by compile-time evaluation, and a branch it chooses may hold another such condition
fn ccPage() I32 {
    size I32 = 1
    for i in range 13 { size = size * 2 }
    return size
}

CcHalfPage I32 = ccPage() / 2

if ccPage() > 4096 and CcHalfPage == 4096 {
    fn ccDeferred() I32 { return 1 }

    if ccDeferred() + ccPage() == 8193 {
        fn ccDeferredNested() I32 { return 2 }
    }
} else {
    fn ccDeferred() I32 { return 3 }
}

test "B9c: conditions decided by compile-time evaluation, nested two deep" {
    assert ccDeferred() == 1
    assert ccDeferredNested() == 2
}

# S8b: a local if the build decides is conditional compilation - only the chosen branch is parsed and
# checked, so the others may name what does not exist on this target
fn ccLocalChoice() I32 {
    if TargetOs == "no-such-os" {
        return NoSuchType{1}.v + noSuchFunction()
    } else if TestBuild or not TestBuild {
        return 7
    } else {
        return alsoMissing()
    }
}

fn ccRuntimeThenDecided(x I32) I32 {
    if x > 3 {
        return 1
    } else if TargetOs == "no-such-os" {
        return noSuchFunction()
    }
    return 2
}

test "S8b: a local if the build decides compiles only the branch it chooses" {
    assert ccLocalChoice() == 7
    assert ccRuntimeThenDecided(5) == 1
    assert ccRuntimeThenDecided(0) == 2
}

# S8b: a local if on any compile-time-computable condition that depends on the build - here through
# functions - compiles only its chosen branch, even one that does not parse anywhere else
fn ccOnRealOs() Bool {
    return TargetOs.Len() > 0
}

fn ccPlatformPage() I32 {
    if ccOnRealOs() {
        return 4096
    } else {
        return NoSuchPlatformType{0}.size
    }
}

# this condition calls ccPlatformPage, whose own if is decided first
fn ccUsesPlatformPage() I32 {
    if ccPlatformPage() == 4096 and ccOnRealOs() {
        return 1
    } else {
        return AnotherMissingType{0}.size
    }
}

test "S8b: local ifs decided by compile-time evaluation, one inside a function another condition calls" {
    assert ccPlatformPage() == 4096
    assert ccUsesPlatformPage() == 1
}

# S8b: a local that provably holds one value - a plain scalar never written after its initializer - counts
# as compile-time too, so it can decide an if the build decides
fn ccFixedLocal() I32 {
    arch I64 = TargetArch.Len()
    if arch > 0 and ccOnRealOs() {
        return 1
    } else {
        return MissingOnThisTarget{0}.v
    }
}

# ...while one that is written anywhere in its function is the running program's
fn ccWrittenLocal(steps I32) I32 {
    k := 0
    for i in range steps { k++ }
    if k > 2 {
        return 1
    }
    return 0
}

test "S8b: a provably fixed local decides an if; a written one does not" {
    assert ccFixedLocal() == 1
    assert ccWrittenLocal(3) == 1
    assert ccWrittenLocal(1) == 0
}

# K1: building a value whose type has a destructor is not evaluable at compile time - the destructor's effect
# would be lost - so this global is set at startup, and its destructor runs then
ktDtorRuns mut I32 = 0

type KtDropped struct(v I32) {
    v
} destruct {
    ktDtorRuns++
}

fn ktMakeAndDrop() I32 {
    d KtDropped& = KtDropped(7)
    return d.v
}

KtFromDropped I32 = ktMakeAndDrop()

test "K1: a global whose initializer runs a destructor is set at startup, destructor and all" {
    assert KtFromDropped == 7
    assert ktDtorRuns == 1
}

# S9/S9a/S10: the loop keyword is "for" in every position. "for { }" runs until something leaves it,
# "for cond { }" while cond holds, the three-clause form as before, and "do { } for cond" at least once.
# "for x in a" walks an array (a copy of each element), or an Iterator<T> - the built-in interface, a type
# with "mut Next() (T, bool)". A collection hands one out with an ordinary method, called explicitly.
type ForCounter struct(n I32, max I32) {
    n mut
    max mut
}

fn (c mut ForCounter&) Next() I32 ? Exhausted {
    if c.n >= c.max { error Exhausted.END }
    c.n++
    return c.n
}

type ForBag struct(size I32) {
    size mut
}

fn (b ForBag&) Iter() ForCounter { return ForCounter(0, b.size) }

test "S9: for with no clauses and with only a condition" {
    n := 0
    for n < 3 { n++ }
    assert n == 3
    for {
        n++
        if n == 7 { break }
    }
    assert n == 7
    do { n-- } for n > 5
    assert n == 5
}

test "S9a: for-in over an array gives each element, and the index when asked" {
    a := I32[10, 20, 30]
    sum := 0
    for x in a { sum += x }
    assert sum == 60
    weighted := 0
    for i, x in a { weighted += I32(i) * x }
    assert weighted == 80
    count := 0
    for c in "hey" { if c == 'e' { count++ } }
    assert count == 1
}

test "S9a: the element is a copy - writing it leaves the array alone" {
    a := I32[1, 2]
    for x in a { x = 99 }
    assert a[0] == 1
    for i, x in a { a[i] = x * 10 }
    assert a[1] == 20
}

test "S9a: for-in over an iterator, and over one a collection hands out" {
    c := ForCounter(0, 4)
    total := 0
    for v in c { total += v }
    assert total == 10
    seen := 0
    for i, v in ForBag(3).Iter() {
        assert v == I32(i) + 1
        seen++
    }
    assert seen == 3
}

test "S9a: break and continue in a for-in" {
    a := I32[1, 2, 3, 4, 5]
    s := 0
    for x in a {
        if x == 2 { continue }
        if x == 4 { break }
        s += x
    }
    assert s == 4
}

test "E7a: and, or, not - not binds looser than a comparison" {
    x := 3
    assert not x == 4
    assert x == 3 and not (x > 5)
    assert x == 9 or x == 3
    assert not not true
    assert x == 3 xor x == 4
    assert not (x == 3 xor x == 3)
}

# S9b: "range end" or "range start, end [, step]" - start (default 0, included) up to end (excluded), step
# (default 1) apart. It only counts upward: nothing runs unless start is below end and step is positive.
fn rangeSum(n I32) I32 {
    s := 0
    for i in range n { s += i }
    return s
}

RangeSumTen := rangeSum(10)

fn rangeText(end I32, start I32, step I32) String& {
    t String&return = ""
    for v in range start, end, step { t = $t $v "," }
    return t
}

test "S9b: range with one, two and three arguments" {
    assert RangeSumTen == 45
    assert bytesEq(rangeText(5, 0, 1), "0,1,2,3,4,")
    assert bytesEq(rangeText(10, 7, 1), "7,8,9,")
    assert bytesEq(rangeText(10, 0, 3), "0,3,6,9,")
    assert bytesEq(rangeText(9, 0, 3), "0,3,6,")
}

test "S9b: a range whose start is not below its end, or whose step is not positive, runs nothing" {
    assert bytesEq(rangeText(0, 4, 1), "")
    assert bytesEq(rangeText(3, 3, 1), "")
    assert bytesEq(rangeText(10, 0, 0), "")
    assert bytesEq(rangeText(10, 0, -1), "")
}

test "S9b: a range's index form, and its type follows its bounds" {
    n I64 = 3
    total I64 = 0
    for i, v in range 1, n {
        total += v
        assert i == v - 1        # the counter has the range's own type, I64 here
    }
    assert total == 3
}

# E7: "and" and "or" short-circuit - the right side runs only when the left has not decided the result, so
# a null test guards the read after it. "xor" cannot: its result always depends on both sides.
fn scBump(c mut Array<I32>&) Bool {
    c[0]++
    return true
}

test "E7: and/or skip their right side once the left decides" {
    calls := Array<I32>(1, 0)
    f Bool = calls[0] == 1
    assert not (f and scBump(calls))
    assert calls[0] == 0
    assert (not f) or scBump(calls)
    assert calls[0] == 0
    assert (not f) and scBump(calls)
    assert calls[0] == 1
    p Point& = null
    assert p == null or p.x == 0
}

# D15a: a reference to a run-time-length array carries its length beside its pointer, and reassigning it
# replaces both - so a declaration from a literal stays run-time-length instead of adopting the literal's
# length, and text can be grown from a literal start. A VALUE declaration still adopts it (D15).
test "D15a: a reference declared from a literal can be repointed at an array of another length" {
    x String& = "q"
    assert x.Len() == 1        # it has the literal's length - held beside the pointer, not in the type
    x = "longer" $x
    assert x.Len() == 7
    assert bytesEq(x, "longerq")
    x = ""
    assert x.Len() == 0
    v Array<U8> = "abc"
    assert v.Len() == 3
}

# T35a: an interface may be generic, and each instantiation is an ordinary interface - its methods concrete,
# its dispatch table one function per entry. A generic type's method satisfies it through its instantiation.
# Iterator<T> is the built-in one: nameable everywhere, and what "for ... in" walks.
type GenSource<T> trait {
    mut Next() <T> ? Exhausted
}

type GenOnce<T> struct(v <T>, used Bool) {
    v mut
    used mut
}

fn (o mut GenOnce<<T>>&) Next() <T> ? Exhausted {
    if o.used { error Exhausted.END }
    o.used = true
    return o.v
}

fn genDrain(s mut <G GenSource<I32>>&) I32 {
    t := 0
    for {
        v := try s.Next() catch Exhausted { break }
        t += v
    }
    return t
}

fn genFirst(s mut <G GenSource<<T>>>&) <T> ? Exhausted {
    return try s.Next()
}

fn iterSum(it mut <I Iterator<I32>>&) I32 {
    t := 0
    for v in it { t += v }
    return t
}

test "T35a: a generic interface, satisfied by a plain type and by a generic one" {
    c ForCounter& = ForCounter(0, 4)
    assert genDrain(c) == 10
    o GenOnce<I32>& = GenOnce<I32>(7, false)
    assert genDrain(o) == 7
    c2 ForCounter& = ForCounter(0, 4)
    assert try genFirst(c2) catch default 0 == 1
}

fn iterTotal(it mut <I Iterator<<T>>>&) <T> {
    t <T> = 0
    for v in it { t += v }
    return t
}

test "G9c: a concrete type passed to a generic interface binds its variables through its methods" {
    c ForCounter& = ForCounter(0, 4)
    assert try genFirst(c) catch default 0 == 1
    o GenOnce<I64>& = GenOnce<I64>(9000000000, false)
    x := try genFirst(o) catch { unreachable }
    assert x == 9000000000
    c2 ForCounter& = ForCounter(0, 4)
    assert iterTotal(c2) == 10
}

# K1: compile-time evaluation runs generic code over a trait, each instantiation with its concrete type's methods
fn iterTotalOf(n I32) I32 {
    c ForCounter& = ForCounter(0, n)
    return iterTotal(c)
}

fn drainBoth() I32 {
    c ForCounter& = ForCounter(0, 3)
    o GenOnce<I32>& = GenOnce<I32>(10, false)
    return genDrain(c) + genDrain(o)
}

fn arrayIterTotal() I64 {
    a := I64[4, 5, 6]
    return iterTotal(a.Iter())
}

IterTotalBaked := iterTotalOf(5)
ArrayIterBaked := arrayIterTotal()
DrainBothBaked := drainBoth()

test "K1: interface calls are evaluated while compiling, and agree with the run time" {
    assert IterTotalBaked == 15
    assert DrainBothBaked == 16
    n := 5
    n++
    assert iterTotalOf(n - 1) == IterTotalBaked
    assert drainBoth() == DrainBothBaked
}

test "T35b: every array hands out an Iterator, so code written over Iterator takes arrays too" {
    assert ArrayIterBaked == 15
    a := I32[1, 2, 3]
    a[2] = 30
    assert iterTotal(a.Iter()) == 33
    it := a.Iter()
    n := 0
    for x in it { n++ }
    assert n == 3
    for x in it { n++ } # S9a: the loop walks its own copy of a by-value iterator, so "it" was not advanced
    assert n == 6
    empty := Array<I32>(0)
    assert iterTotal(empty.Iter()) == 0
    t String& = "ab"
    st := t.Iter()
    c := try st.Next() catch { unreachable }
    assert c == 'a'
}

# E27: a comprehension - a new array of one expression per value walked, those the filter keeps. The element type
# is written, as an array literal's is; the array is built where it lands, like "Array<T>(n)".
fn comprEvens(a Array<I32>&) Array<I32> {
    return I32[x * 2 for x in a if x > 3]
}

fn comprSquares(n I32) Array<I64> {
    return I64[I64(i) * I64(i) for i in range n]
}

# returned through a built reference result: it must be built in the result's scope, not the function's
fn comprKeep(a Array<I32>&) Array<I32>& {
    return I32[x for x in a if x != 0]
}

fn allocKeep() Array<I32>& {
    return Array<I32>(2, 5)
}

fn comprChurn() Array<I32>& {
    return Array<I32>(1000, 7)
}

type ComprPt struct(x I32, y I32) {
    x
    y
}

ComprSquaresBaked := comprSquares(5)
ComprEvensBaked := comprEvens(I32[1, 5, 2, 7])

test "E27: comprehensions over arrays, ranges and text, with and without a filter" {
    a := I32[1, 5, 2, 7]
    e := comprEvens(a)
    assert e.Len() == 2
    assert e[0] == 10 and e[1] == 14
    s := comprSquares(4)
    assert s.Len() == 4 and s[3] == 9
    idx := I64[i * 10 + x for i, x in a]
    assert idx[3] == 37
    none := I32[x for x in a if x > 100]
    assert none.Len() == 0
    t := "hello"
    up := U8[c - 32 for c in t]
    assert String(up).Eq("HELLO")
    nested := I64[I32[y for y in range x].Len() for x in range 4]
    assert nested[3] == 3
    ps := ComprPt[ComprPt(i, i * i) for i in range 3]
    assert ps[2].y == 4
    total := 0
    for r in range 1000 {
        row := I32[x + r for x in range 3]
        total += row[2]
    }
    assert total == 501500
}

test "E27: a comprehension is evaluated while compiling, and agrees with the run time" {
    assert ComprSquaresBaked[4] == 16 and ComprSquaresBaked.Len() == 5
    assert ComprEvensBaked.Len() == 2 and ComprEvensBaked[1] == 14
    n := 5
    n++
    assert comprSquares(n - 1)[4] == ComprSquaresBaked[4]
    assert comprEvens(I32[1, 5, 2, 7])[1] == ComprEvensBaked[1]
    assert I32[x for x in range 4 if x % 2 == 1][1] == 3
}

test "E27/T7: a comprehension or Array<T>(n) returned through a reference result is built in the result's scope" {
    k := comprKeep(I32[0, 1, 0, 2])
    c := comprChurn()
    assert k.Len() == 2
    assert k[1] == 2
    m := allocKeep()
    c2 := comprChurn()
    assert m[1] == 5
}

# E28: "a if c else b" - only the chosen value is evaluated; both have one type, a literal adapting
fn condMax(a I32, b I32) I32 { return a if a > b else b }

fn condSign(x I32) I32 { return 1 if x > 0 else -1 if x < 0 else 0 }

type CondLog struct() {
    s mut I32 = 0
}

fn condMark(l mut CondLog&, d I32) I32 {
    l.s = l.s * 10 + d
    return d
}

fn condColl(l mut CondLog&) Array<I32> {
    condMark(l, 2)
    return I32[1, 2]
}

CondMaxBaked := condMax(3, 9)
ChainBaked Bool = 0 <= 5 < 10
InBaked Bool = 3 in I32[1, 2, 3]

test "E28: a conditional expression evaluates only the value its condition chooses" {
    assert condMax(4, 2) == 4 and condMax(1, 7) == 7
    assert condSign(5) == 1 and condSign(-2) == -1 and condSign(0) == 0
    l CondLog& = CondLog()
    v := condMark(l, 1) if l.s == 0 else condMark(l, 2)
    assert v == 1 and l.s == 1
    name String& = "bob"
    n := 3
    label String& = name if n > 2 else "anon"
    assert label.Eq("bob")
    t := $n if n > 5 else "small"
    assert t.Eq("small")
    clipped := I32[x if x > 0 else 0 for x in I32[-1, 2, -3]]
    assert clipped[0] == 0 and clipped[1] == 2
    pt := ComprPt(1, 2) if n > 0 else ComprPt(3, 4)
    assert pt.y == 2
}

test "E30: ordering comparisons chain, each operand evaluated once; == does not chain" {
    i := 5
    assert 0 <= i < 10
    assert not (0 <= i < 3)
    assert 1 < 2 <= 2 < 3
    l CondLog& = CondLog()
    assert 0 < condMark(l, 1) < 5
    assert l.s == 1
    assert not (9 < condMark(l, 2) < 20)
    assert l.s == 12
    f := false
    assert f == f == true
}

test "E29: membership - Has for an element, Contains for a run of the collection's own type" {
    a := I32[1, 2, 3]
    assert 2 in a
    assert 7 not in a
    s := "hello"
    assert 'e' in s and 'z' not in s
    assert "ll" in s and "lx" not in s
    assert "" in s
    vowels := "aeiou"
    found := I32[1 for ch in "banana" if ch in vowels]
    assert found.Len() == 3
    l CondLog& = CondLog()
    assert condMark(l, 1) in condColl(l)
    assert l.s == 12
}

test "E28/E29/E30: evaluated while compiling, as at run time" {
    assert CondMaxBaked == 9 and ChainBaked and InBaked
    n := 9
    n++
    assert condMax(3, n - 1) == CondMaxBaked
}

# S4c/D12b: parallel assignment - every value evaluated before any target is written - and several names
# declared with one type, as locals, globals and constructor fields
ParX, ParY mut I32 = 3, 4
ParA, ParB I64

type ParV struct(x I32, y I32) {
    x, y mut
    p, q I32 = x + y, x * y
    r, s := 1, 2
}

fn parFib(n I32) I64 {
    a, b I64 = 0, 1
    for i in range n { a, b = b, a + b }
    return a
}

ParFibBaked := parFib(10)

test "S4c/D12b: parallel assignment swaps; several names share one type" {
    a, b := 1, 2
    a, b = b, a
    assert a == 2 and b == 1
    arr := I32[5, 6, 7]
    arr[0], arr[2] = arr[2], arr[0]
    assert arr[0] == 7 and arr[2] == 5
    assert parFib(10) == 55 and ParFibBaked == 55
    x, y I32
    assert x == 0 and y == 0
    s, t String& = "a", "b"
    s, t = t, s
    assert s.Eq("b") and t.Eq("a")
    assert ParY == 4 and ParA == 0 and ParB == 0
    ParX, ParY = ParY, ParX
    assert ParX == 4 and ParY == 3
    v ParV& = ParV(2, 3)
    assert v.p == 5 and v.q == 6 and v.r == 1 and v.s == 2
    v.x, v.y = v.y, v.x
    assert v.x == 3 and v.y == 2
    _, c := 9, 8
    assert c == 8
    l CondLog& = CondLog()
    m, n := condMark(l, 1), condMark(l, 2)
    assert l.s == 12 and m == 1 and n == 2
}

# L4a: a block comment, opened by two hashes and closed by the next two
fn blockCommented() I32 {
    x I32 = 1 ## inside a line ## + 2
    y := 3 ##
    across lines, it ends the statement as a line break would ##
    return x + y
}

test "L4a: a block comment is whitespace, and a line break where it spans one" {
    assert blockCommented() == 6
}

# G19: an interface as a constraint on a type variable - checked where the variable is inferred or written, the
# code compiled per type with direct calls. A variable named only in a constraint is inferred through it.
type CnShape trait {
    Area() I32
}

type CnSq struct(s I32) {
    s
}

fn (q CnSq) Area() I32 { return q.s * q.s }

fn cnArea(x <T CnShape>) I32 { return x.Area() }

fn cnDrain(it mut <I GenSource<<E>>>) <E> {
    t <E> = 0
    for {
        v := try it.Next() catch Exhausted { break }
        t = t + v
    }
    return t
}

type CnHolder<T CnShape> struct(v <T>) {
    v
}

CnAreaBaked := cnArea(CnSq(4))

test "G19: interfaces constrain type variables of functions and of generic types" {
    assert cnArea(CnSq(3)) == 9
    c ForCounter& = ForCounter(0, 4)
    assert cnDrain(c) == 10
    h CnHolder<CnSq>& = CnHolder<CnSq>(CnSq(2))
    assert h.v.Area() == 4
    h2 := CnHolder(CnSq(5))
    assert h2.v.Area() == 25
    assert I32[1, 2].Has(2)
    assert CnAreaBaked == 16
}

# E31: an operator calls a method named for it - Plus, Minus, Mul, Div, Rem, Neg, Less, MatMul, and At, SetAt and
# Slice for indexing. A lowercase first letter is the module's private operator. "<" is the one ordering a type
# declares; ">", "<=" and ">=" come from it, and chains of them work (E30).
type OpVec struct(x I32, y I32) {
    x mut
    y mut
}

fn (a OpVec) Plus(b OpVec) OpVec { return OpVec(a.x + b.x, a.y + b.y) }
fn (a OpVec) Minus(b OpVec) OpVec { return OpVec(a.x - b.x, a.y - b.y) }
fn (a OpVec) Neg() OpVec { return OpVec(-a.x, -a.y) }
fn (a OpVec) Mul(k I32) OpVec { return OpVec(a.x * k, a.y * k) }
fn (a OpVec) Less(b OpVec) Bool { return a.x * a.x + a.y * a.y < b.x * b.x + b.y * b.y }
fn (a OpVec) MatMul(b OpVec) I32 { return a.x * b.x + a.y * b.y }

type OpMoney I64

fn (a OpMoney) plus(b OpMoney) OpMoney { return OpMoney(I64(a) + I64(b) + 1) }

type OpAddable<T> trait {
    Plus(b <T>) <T>
}

fn opTwice(x <T OpAddable<<T>>>) <T> { return x + x }

fn opSum(xs Array<<T>>&, zero <T>) <T> {
    t <T> = zero
    for x in xs { t = t + x }
    return t
}

type OpGrid struct(w I64, h I64) {
    w
    h
    cells mut Array<I32>& = Array<I32>(w * h)
}

fn (g OpGrid&) At(i I64) I32 { return g.cells[i] }
fn (g mut OpGrid&) SetAt(i I64, v I32) { g.cells[i] = v }
fn (g OpGrid&) Len() I64 { return g.cells.Len() }
fn (g OpGrid&) Slice(lo I64, hi I64) Array<I32> { return I32[g.cells[i] for i in range lo, hi] }

# O20: a slice of a reference field lives where the field's array does - its container's scope - so returning one
# borrowed from the receiver is legal
fn (g OpGrid&) Row(lo I64, hi I64) Array<I32>&g { return g.cells[lo:hi] }

type OpBits struct(v I64) {
    v
}

fn (a OpBits) BitAnd(b OpBits) OpBits { return OpBits(a.v & b.v) }
fn (a OpBits) BitOr(b OpBits) OpBits { return OpBits(a.v | b.v) }
fn (a OpBits) BitXor(b OpBits) OpBits { return OpBits(a.v ^ b.v) }
fn (a OpBits) ShiftLeft(n I32) OpBits { return OpBits(a.v << I64(n)) }
fn (a OpBits) ShiftRight(n I32) OpBits { return OpBits(a.v >> I64(n)) }
fn (a OpBits) BitNot() OpBits { return OpBits(~a.v) }

type OpCtr struct(n I32) {
    n
}

fn (c OpCtr) Plus(k I32) OpCtr { return OpCtr(c.n + k) }
fn (c OpCtr) Minus(k I32) OpCtr { return OpCtr(c.n - k) }

type OpStep struct(n I32) {
    n
}

fn (s OpStep) Inc() OpStep { return OpStep(s.n + 10) }
fn (s OpStep) Dec() OpStep { return OpStep(s.n - 10) }

fn opBitsBaked() I64 {
    c OpBits = OpBits(12) & OpBits(10)
    c |= OpBits(1)
    k OpCtr = OpCtr(5)
    k++
    return c.v + k.n
}

OpBitsBaked := opBitsBaked()

# E31: Call - a value whose type declares it is called like a function, and passed where one is wanted
type OpIdGen struct() {
    n mut I32 = 0
}

fn (g mut OpIdGen&) Call() I32 {
    g.n++
    return g.n
}

type OpSeen struct() {
    n mut I32 = 0
}

fn (c mut OpSeen&) Call(x I32) Bool {
    c.n++
    return x > 3
}

type OpScale struct(k I32) {
    k
}

fn (s OpScale) Call(x I32) I32 { return x * s.k }

fn opApply(f fn(x I32) I32, v I32) I32 { return f(v) }

error OpGridError {
    OUT
}

type OpSafe struct(n I64) {
    n
    cells mut Array<I32>& = Array<I32>(n)
}

fn (g OpSafe&) TryAt(i I64) I32 ? OpGridError {
    if i < 0 or i >= g.n { error OpGridError.OUT }
    return g.cells[i]
}

fn (g OpSafe&) TrySlice(lo I64, hi I64) Array<I32> ? OpGridError {
    if lo < 0 or hi > g.n { error OpGridError.OUT }
    return I32[g.cells[i] for i in range lo, hi]
}

fn (g OpSafe&) Len() I64 { return g.n }

fn opMaybeArray(n I32) Array<I32> ? {
    if n > 3 { error }
    return I32[1, 2]
}

OpCallBaked := OpScale(3)(7)

OpDotBaked I32 = (OpVec(1, 2) + OpVec(3, 4)) @ OpVec(1, 1)

test "E31: operators call methods named for them - arithmetic, negation, ordering, @, compound assignment" {
    a := OpVec(1, 2)
    b := OpVec(3, 4)
    c := a + b
    assert c.x == 4 and c.y == 6
    d := -a
    assert d.x == -1 and d.y == -2
    e := (b - a) * 2
    assert e.x == 4 and e.y == 4
    assert a < b and b > a and a <= b and not (a >= b)
    assert a < b < OpVec(10, 10)
    assert a @ b == 11
    v OpVec = a
    v += b
    assert v.x == 4 and v.y == 6
    m := OpMoney(5) + OpMoney(6)
    assert I64(m) == 12
}

test "E31: bitwise and shift operators, and ++/-- from Inc/Dec or derived from Plus/Minus" {
    a := OpBits(12)
    b := OpBits(10)
    assert (a & b).v == 8 and (a | b).v == 14 and (a ^ b).v == 6
    assert (a << 2).v == 48 and (a >> 2).v == 3
    assert (~OpBits(0)).v == -1
    c OpBits = a
    c |= OpBits(1)
    assert c.v == 13
    k OpCtr = OpCtr(5)
    k++
    assert k.n == 6
    ++k
    assert k.n == 7
    k--
    assert k.n == 6
    st OpStep = OpStep(0)
    st++
    assert st.n == 10
    --st
    assert st.n == 0
    assert OpBitsBaked == 15
}

test "E31: Call makes a value callable and passable as a function; try calls TryAt and TrySlice" {
    next OpIdGen& = OpIdGen()
    a := next()
    b := next()
    assert a == 1 and b == 2
    double := OpScale(2)
    assert double(21) == 42 and opApply(double, 5) == 10
    seen OpSeen& = OpSeen()
    big := I32[1, 5, 2, 7].Iter().Filter(seen)
    assert big.Len() == 2 and seen.n == 4
    assert OpCallBaked == 21
    g OpSafe& = OpSafe(3)
    g.cells[1] = 5
    assert (try g[1] catch default -1) == 5
    assert (try g[7] catch OpGridError.OUT default -2) == -2
    s := try g[0:2] catch default I32[9]
    assert s.Len() == 2
    t := try g[0:9] catch default I32[9]
    assert t.Len() == 1
    u := try opMaybeArray(5) catch default I32[4, 4, 4]
    assert u.Len() == 3
}

test "E31: indexing calls At, assigning through it SetAt, slicing Slice" {
    g OpGrid& = OpGrid(2, 3)
    g[4] = 7
    g[4] += 1
    assert g[4] == 8 and g.At(4) == 8
    s := g[3:5]
    assert s.Len() == 2 and s[1] == 8
    t := g[4:]
    assert t.Len() == 2
    v OpVec = OpVec(1, 1)
    assert v.Plus(v).x == 2
    r := g.Row(3, 5)
    c := opChurn()
    g[3] = 9
    assert r[0] == 9 and r.Len() == 2
}

fn opChurn() Array<I32>& { return Array<I32>(1000, 7) }

test "E31: operators in generic code, in a constraint, and while compiling" {
    a := OpVec(1, 2)
    s := opSum(OpVec[a, OpVec(3, 4)], OpVec(0, 0))
    assert s.y == 6
    t := opTwice(a)
    assert t.x == 2
    assert OpDotBaked == 10
}

# M19e: a default - a method on a type variable a trait constrains - is callable on any value whose type satisfies the
# trait, and a type's own method of the same name and signature overrides it, wherever it is called from
type IfmNamed trait {
    IfmName() I32
}

fn (n <N IfmNamed>) Shout() I32 { return n.IfmName() * 2 }
fn (n <N IfmNamed>) Whisper() I32 { return n.IfmName() - 1 }

fn ifmWhisper(n <N IfmNamed>) I32 { return n.Whisper() }

type IfmP struct(v I32) {
    v
}

fn (p IfmP) IfmName() I32 { return p.v }

type IfmQ struct(v I32) {
    v
}

fn (q IfmQ) IfmName() I32 { return q.v }
fn (p IfmP) Whisper() I32 { return 100 }

IfmCountBaked := I32[1, 2, 3, 4].Iter().Count(fn(x) { return x > 2 })

test "M19e: defaults reach satisfying types; a type's own method wins" {
    p := IfmP(5)
    assert p.Shout() == 10
    assert p.Whisper() == 100
    assert ifmWhisper(p) == 100 # from generic code the type's own version runs too
    m := IfmQ(5)
    assert m.Whisper() == 4 and m.Shout() == 10 and ifmWhisper(m) == 4
    assert I32[1, 2, 3].Iter().Any(fn(x) { return x == 3 })
    assert IfmCountBaked == 2
}

# T17: an enum's payload is held as whole 8-byte words. A payload smaller than a word was counted short of LLVM's
# layout (12 bytes against 16), so an array of such values was allocated short and corrupted the heap.
type SmallPay enum {
    SpA(x I32)
    SpB(y I32)
}

fn smallPayVal(e SmallPay) I32 {
    match e {
        case SmallPay.SpA(x) { return x }
        case SmallPay.SpB(y) { return y }
    }
}

test "T17: an array of enums with a small payload is laid out at its real stride" {
    n I64 = 1000
    es := Array<SmallPay>(n)
    for i in range n { es[i] = SmallPay.SpA(I32(i)) if i % 2 == 0 else SmallPay.SpB(I32(i) * 2) }
    churn := Array<I64>(1000, 9)
    t I64 = 0
    for i in range n { t = t + smallPayVal(es[i]) }
    assert t == 749500 and churn[0] == 9
}

# S9d: a type with At and Len is walked by for-in as an array is - a counted loop - unless it has a Next or an Iter of
# its own, which says how it wants to be walked; Indexable derives an Iter for the iterator helpers
type IxGrid struct(n I64) {
    n
    cells mut Array<I32>& = Array<I32>(n)
}

fn (g IxGrid&) At(i I64) I32 { return g.cells[i] }
fn (g mut IxGrid&) SetAt(i I64, v I32) { g.cells[i] = v }
fn (g IxGrid&) Len() I64 { return g.n }

# At and Len, but an Iter of its own too - which for-in prefers (it yields 100s, not the cells)
type IxOwn struct() {
    v I32 = 1
}

fn (o IxOwn&) At(i I64) I32 { return o.v }
fn (o IxOwn&) Len() I64 { return 3 }
# an override of Indexable's default Iter - the same signature (M19e), starting one position in
fn (o IxOwn&) Iter() IndexIter<I32, IxOwn> {
    it := IndexIter<I32, IxOwn>(o)
    try it.Next() catch Exhausted { }
    return it
}

fn ixSum(c <C Indexable<<T>>>) <T> {
    t <T> = 0
    for x in c { t = t + x }
    return t
}

fn ixBaked() I64 {
    g IxGrid& = IxGrid(4)
    for i in range I64(4) { g[i] = I32(i) * 10 }
    t I64 = 0
    for i, x in g { t = t + i + x }
    return t
}

IxBaked := ixBaked()

test "S9d: for-in walks At and Len as a counted loop; an own Iter wins; Indexable derives Iter" {
    g IxGrid& = IxGrid(5)
    for i in range I64(5) { g[i] = I32(i) }
    t := 0
    for x in g { t += x }
    assert t == 10
    n I64 = 0
    for i, x in g { n = n + i }
    assert n == 10
    assert g.Iter().Count(fn(x) { return x > 2 }) == 2
    assert ixSum(g) == 10
    assert IxBaked == 66
    o IxOwn& = IxOwn()
    u := 0
    for x in o { u += x }
    assert u == 2        # the own Iter's two values, not the counted loop's three
}

# E31/S9e: the checked forms. "try" calls TryAt, TrySlice, TrySetAt, TryDiv, TryInc ... when a type declares them, and
# derives TryAt, TrySlice and TrySetAt from At, Slice, SetAt and Len otherwise; "try" before a store or an increment
# checks the statement; "for x in try c" covers what the loop calls by itself
type TxGrid struct(n I64) {
    n
    cells mut Array<I32>& = Array<I32>(n)
}

fn (g TxGrid&) At(i I64) I32 { return g.cells[i] }
fn (g mut TxGrid&) SetAt(i I64, v I32) { g.cells[i] = v }
fn (g TxGrid&) Len() I64 { return g.n }
fn (g TxGrid&) Slice(lo I64, hi I64) Array<I32>&g { return g.cells[lo:hi] }

error TxErr {
    MISSING
    ZERO
}

type TxSparse struct(bad I64) {
    bad
}

fn (s TxSparse&) TryAt(i I64) I32 ? TxErr {
    if i == s.bad { error TxErr.MISSING }
    return I32(i) * 10
}
fn (s TxSparse&) Len() I64 { return 4 }

type TxQ struct(v I32) {
    v
}

fn (a TxQ) Div(b TxQ) TxQ { return TxQ(a.v / b.v) }
fn (a TxQ) TryDiv(b TxQ) TxQ ? TxErr {
    if b.v == 0 { error TxErr.ZERO }
    return TxQ(a.v / b.v)
}
fn (a TxQ) Plus(b TxQ) TxQ { return TxQ(a.v + b.v) }

type TxCtr struct(n I32) {
    n mut
}

fn (c TxCtr) TryInc() TxCtr ? TxErr {
    if c.n >= 2 { error TxErr.ZERO }
    return TxCtr(c.n + 1)
}

type TxLines struct(n I32, failAt I32) {
    n
    failAt
    i mut I32 = 0
}

fn (l mut TxLines&) Next() I32 ? TxErr + Exhausted {
    if l.i == l.failAt { error TxErr.MISSING }
    if l.i >= l.n { error Exhausted.END }
    l.i++
    return l.i
}

# only stores: "x[i] = v" calls SetAt with no At beside it
type TxSink struct() {
    last mut I32 = 0
}

fn (k mut TxSink&) SetAt(i I64, v I32) { k.last = v + I32(i) }

fn txReads() I32 {
    g TxGrid& = TxGrid(4)
    for i in range I64(4) { g[i] = I32(i) * 10 }
    a := try g[2] catch default -1
    b := try g[7] catch BuiltinError.OUT_OF_BOUNDS default -1
    s := try g[1:3] catch default I32[0]
    t := try g[3:9] catch default I32[5, 5, 5]
    sp TxSparse& = TxSparse(1)
    x := try sp[3] catch default 0
    y := try sp[1] catch TxErr default 7
    z := try (TxQ(10) / TxQ(0) + TxQ(1)) catch TxErr default TxQ(99)
    w := try (TxQ(10) / TxQ(2) + TxQ(1)) catch TxErr default TxQ(99)
    return a + b + I32(s.Len()) + I32(t.Len()) + x + y + z.v + w.v
}

fn txStores() I32 {
    g TxGrid& = TxGrid(3)
    m := 0
    try g[1] = 5 catch { m += 1 }
    try g[5] = 9 catch BuiltinError.OUT_OF_BOUNDS { m += 10 }
    try g[1] += 2 catch { m += 100 }
    a := I32[1, 2]
    try a[2] = 3 catch { m += 1000 }
    n I32 = 2147483647
    try n++ catch BuiltinError.OVERFLOW { m += 10000 }
    c TxCtr = TxCtr(1)
    try c++ catch { m += 100000 }
    try c++ catch { m += 200000 }
    return m + g[1] + c.n
}

fn txWalk(n I32, failAt I32) I32 {
    t := 0
    l TxLines& = TxLines(n, failAt)
    for x in try l {
        if x == 2 { continue }
        t += x
    } catch TxErr {
        t += 1000
    }
    sp TxSparse& = TxSparse(failAt)
    for x in try sp {
        t += x
    } catch { t += 100 }
    return t
}

fn txWalkPropagates() I32 ? TxErr {
    t := 0
    l TxLines& = TxLines(5, 2)
    for x in try l { t += x }
    return t
}

TxReadsBaked := txReads()
TxStoresBaked := txStores()
TxWalkBaked := txWalk(5, 3)

test "E31/S9e: try calls the Try forms or derives them from Len; try on a store or an increment; for x in try c" {
    assert txReads() == 20 - 1 + 2 + 3 + 30 + 7 + 99 + 6
    assert TxReadsBaked == txReads()
    assert txStores() == 10 + 1000 + 10000 + 200000 + 7 + 2
    assert TxStoresBaked == txStores()
    assert txWalk(3, 99) == 4 + 60
    assert txWalk(5, 3) == 1004 + 30 + 100
    assert TxWalkBaked == txWalk(5, 3)
    k TxSink& = TxSink()
    k[2] = 40
    assert k.last == 42
    try txWalkPropagates() catch TxErr { done }
    fail
}

# E29/S9e: "try (x in c)" reaches a Has that can fail; "try T[e for x in c]" covers a comprehension's own calls, an
# error from deep inside its loop leaving the loop's blocks before the clause runs
type TxRemote struct(down Bool) {
    down
}

fn (r TxRemote&) Has(x I32) Bool ? TxErr {
    if r.down { error TxErr.MISSING }
    return x > 3
}

fn txMember(down Bool) I32 {
    r TxRemote& = TxRemote(down)
    t := 0
    if try (5 in r) catch default false { t += 1 }
    if try (2 not in r) catch default false { t += 10 }
    return t
}

fn txCollect(n I32, failAt I32) I32 {
    l TxLines& = TxLines(n, failAt)
    xs := try I32[x * 2 for x in l if x != 2] catch TxErr + BuiltinError default I32[-1]
    t := 0
    for x in xs { t += x }
    return t
}

TxMemberBaked := txMember(false)
TxCollectBaked := txCollect(4, 3)

test "E29/S9e: try reaches a fallible Has, and a comprehension's own calls" {
    assert txMember(false) == 11 and TxMemberBaked == 11
    assert txMember(true) == 0
    assert txCollect(4, 99) == 16
    assert txCollect(4, 3) == -1 and TxCollectBaked == -1
    for k in range 1000 { assert txCollect(4, 3) == -1 }
}

# E32: "is" and "as" - what an interface value holds (a concrete type, or another interface), which case an enum value
# is; "match" with type cases on an interface value; a wider interface widening to a narrower one implicitly
type IcShape trait {
    Area() I32
}

type IcNamed trait {
    Name() String&
}

type IcBoth trait {
    Area() I32
    Name() String&
}

type IcCircle struct(r I32) {
    r mut
}

fn (c IcCircle&) Area() I32 { return 3 * c.r * c.r }
fn (c IcCircle&) Name() String& { return "circle" }

type IcSquare struct(s I32) {
    s
}

fn (q IcSquare) Area() I32 { return q.s * q.s }

type IcTok enum {
    Num(v I32)
    Pair(a I32, b I64)
    End
}

fn icToks() I64 {
    t := 0
    x := IcTok.Num(5)
    y := IcTok.Pair(2, 40)
    if x is IcTok.Num { t += 1 }
    if y is IcTok.Num { t += 100 }
    e := IcTok.End
    if e is IcTok.End { t += 1000 }
    v := x as IcTok.Num
    a, b := y as IcTok.Pair
    w := try (y as IcTok.Num) catch default -1
    return t + v + a + w + b
}

IcToksBaked := icToks()

test "E32: is and as on enum values" {
    assert icToks() == 1 + 1000 + 5 + 2 - 1 + 40
    assert IcToksBaked == icToks()
}

test "M19d: a prelude generic type is named bare with its arguments written, as an expression too" {
    p := Pair<I32, I64>(1, 2)
    assert p.Second == 2
}

test "T35a: Iterator<T> is built in, and a type satisfying it is walked by for-in" {
    c ForCounter& = ForCounter(0, 3)
    assert iterSum(c) == 6
    o GenOnce<I32>& = GenOnce<I32>(5, false)
    t := 0
    for v in o { t += v }
    assert t == 5
}

# E11b: a join RETURNED is built in the result's scope. It used to be built in the function's own block
# scope and returned dangling - read back correctly only until something reused the freed chunk, which is
# what the allocation between the call and the read does here.
fn joinWrap(t String&) String& {
    out String& = "<"
    return $out $t ">"
}

fn joinChurn() String& {
    return "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" $"yyyyyyyyyyyyyyyyyyyy"
}

fn joinBare(dir String&) Bool {
    q := joinWrap(dir)
    churn := joinChurn()
    return bytesEq(q, "</some/dir>") and churn.Len() == 68
}

test "E11b: a returned join survives later allocations" {
    d String& = "/some/dir"
    assert joinBare(d)
}

# ---- C2e: an "Array<T>(n)" field whose n is computed at compile time is stored in the instance ----

C2eSide I32 = 4
fn c2eSquare(x I32) I32 { return x * x }

type C2eBlock struct(seed I32) {
    m mut Array<F32> = Array<F32>(16)           # a literal size
    b := Array<I32>(C2eSide * 2, 7)                     # a constant global, with a fill
    c mut Array<I64> = Array<I64>(c2eSquare(3))       # a call, computed by the compile-time evaluator
    k mut I32 = seed
}

test "C2e: inline array fields have the length their constructor call computed" {
    x C2eBlock = C2eBlock(1)
    assert x.m.Len() == 16 and x.b.Len() == 8 and x.c.Len() == 9
    assert x.b[7] == 7 and x.c[8] == 0
}

test "C2e: copying an instance copies its inline arrays - nothing is shared" {
    x C2eBlock = C2eBlock(1)
    y C2eBlock = x
    y.m[0] = 2.5
    y.c[1] = 9
    assert x.m[0] == 0.0 and x.c[1] == 0
    assert y.m[0] == 2.5
}

fn c2eFill(x mut C2eBlock&, n I32) {
    v := Array<I64>(n, 3)
    x.c = v                                               # a run-time length, checked once against 9
}

test "C2e: an array of a run-time length fits fixed storage of its length" {
    x C2eBlock& = C2eBlock(1)
    c2eFill(x, 9)
    assert x.c[8] == 3
}

fn c2eTotal(a Array<F32>&) F32 {
    t F32 = 0.0
    for v in a { t = t + v }
    return t
}

test "C2e: an inline field is borrowed as an ordinary array" {
    x C2eBlock& = C2eBlock(1)
    x.m[3] = 1.5
    assert c2eTotal(x.m) == 1.5
}

# T7/D15: an array a declaration holds has no length in its type - one initialized from a literal, either
# way it is declared, may later be given an array of any length
test "an array declared from a literal can later hold one of another length" {
    x Array<I32> = I32[1, 2, 3]
    y := I32[1, 2]
    x = Array<I32>(5)
    y = Array<I32>(7)
    assert x.Len() == 5 and y.Len() == 7
}

# S9c: "for x in e" walks an ITERABLE - something with an Iter() handing out a fresh iterator - through
# that iterator, so the collection keeps no position. A generic iterator's element type is read off its
# instantiated Next(); before, it was read off the generic declaration, so no generic iterator could be
# walked by "for ... in" at all.
type S9cIt<T> struct(v <T>, n I32) {
    v mut
    n mut
}
fn (c mut S9cIt<<T>>&) Next() <T> ? Exhausted {
    if c.n == 0 { error Exhausted.END }
    c.n--
    return c.v
}
type S9cBag<T> struct(v <T>) { v }
fn (b S9cBag<<T>>&) Iter() S9cIt<<T>> { return S9cIt<<T>>(b.v, 2) }

test "S9c: a generic iterator is walked by for-in" {
    it S9cIt<I64>& = S9cIt<I64>(5, 2)
    t I64 = 0
    for x in it { t += x }
    assert t == 10
}

test "S9c: an iterable is walked through a fresh iterator each time, temporaries included" {
    b S9cBag<I64>& = S9cBag<I64>(5)
    t I64 = 0
    for x in b { t += x }
    for x in b { for y in b { t += y } }        # nested loops: each has its own iterator
    assert t == 30
    for x in S9cBag<I64>(1) { t += x }
    assert t == 32
}

# a new reference stored into an ELEMENT of an array that is itself reached through a reference was built in
# the writing function's own scope, because codegen did not count a run-time-length array as a container -
# the stored node dangled as the method returned, and a hash map built this way chained into its own reused
# memory. Found by writing one.
type PreNode struct(v I32, next mut PreNode&) {
    v
    next mut
}
type PreBuckets struct() { a mut Array<mut PreNode&>& = Array<mut PreNode&>(2) }
fn (b mut PreBuckets&) push(v I32) { b.a[0] = PreNode(v, b.a[0]) }

test "a reference stored into an element of a reference-reached array lives in the array's scope" {
    b PreBuckets& = PreBuckets()
    b.push(1)
    b.push(2)
    b.push(3)
    noise I32 = 0
    for i in range 20 { noise = noise + noisePoint(i) }        # reuses any chunk a returned call freed
    n I32 = 0
    for p PreNode& = b.a[0], p != null and n < 10, p = p.next { n++ }
    assert n == 3 and b.a[0].v == 3 and b.a[0].next.next.v == 1
}

# O4b: every reference parameter is passed with its scope, so a function may allocate into one and store
# through it, and what it needs between two of them is an obligation its callers discharge. A map keyed by
# text, written with no scope names at all: the key must outlive the map, which each caller shows.
type O4bSlot struct(key String&, val I32, next mut O4bSlot&) {
    key
    val mut
    next mut
}
type O4bMap struct() { first mut O4bSlot& = null }
fn (m mut O4bMap&) Put(key String&, val I32) {
    for s O4bSlot&m = m.first, s != null, s = s.next {
        if s.key.Eq(key) {
            s.val = val
            return
        }
    }
    m.first = O4bSlot(key, val, m.first)
}
fn (m O4bMap&) Get(key String&) I32 {
    for s O4bSlot&m = m.first, s != null, s = s.next {
        if s.key.Eq(key) { return s.val }
    }
    return -1
}

test "O4b: a structure built through bare reference parameters, with no scope written anywhere" {
    m O4bMap& = O4bMap()
    m.Put("a", 1)
    m.Put("b", 2)
    m.Put("a", 3)
    noise I32 = 0
    for i in range 20 { noise = noise + noisePoint(i) }
    assert m.Get("a") == 3 and m.Get("b") == 2 and m.Get("c") == -1
}

# O18a: a scope only the result names follows the result - it is bound to wherever the result lands, so a
# builder calling builders needs no scope arguments. Each landing is checked by churning the arena.
type LandE struct(v I32, l LandE&) {
    v
    l
}
fn landMk(v I32) LandE& { return LandE(v, null) }
fn landPair(a I32, b I32) LandE& { return LandE(a, landMk(b)) }
fn landChain(n I32) LandE& {
    left LandE&return = landMk(0)
    for i in range n { left = LandE(i + 1, left) }
    return left
}

test "O18a: a result lands in an outer variable from an inner block" {
    x LandE& = landMk(1)
    if x.v == 1 { x = landMk(2) }
    noise I32 = 0
    for i in range 30 { noise = noise + noisePoint(i) }
    assert x.v == 2
}

test "O18a: nested builders land with their caller's result" {
    p LandE& = landPair(3, 4)
    c LandE& = landChain(3)
    noise I32 = 0
    for i in range 30 { noise = noise + noisePoint(i) }
    assert p.v == 3 and p.l.v == 4
    assert c.v == 3 and c.l.l.l.v == 0
}

# O4a: "&x" says "lives where x lives" - a parameter naming an earlier one, a borrowed result naming the
# parameter it is part of, and locals naming a parameter or a block-scoped local, from an inner block
type OxN struct(v I32, nx mut OxN&) {
    v
    next mut OxN& = nx
}

fn oxLink(a mut OxN&, b mut OxN&a) { a.next = b }

fn (l OxN&) OxFirst() OxN&l { return l.next }

fn (l mut OxN&) OxGrow(v I32) {
    e OxN&l = OxN(v, null)
    e.next = l.next
    l.next = e
}

fn oxChain(seed mut OxN&) {
    for i in range 3 {
        left OxN&seed = OxN(10, null)
        right OxN&left = OxN(11, null)
        left.next = right
        seed.next = left
    }
}

fn oxMk(v I32) OxN& { return OxN(v, null) }

# reuses every chunk a closed block gave back, so a value wrongly built in one reads back as garbage
fn oxChurn() I32 {
    t := 0
    for i in range 200 {
        y := OxN(I32(i), OxN(1, null))
        t = t + y.next.v
    }
    return t
}

fn oxGraft(at mut OxN&) {
    for i in range 1 {
        x := oxMk&at(5)
        at.next = x
        x.next = oxMk&at(6)
    }
}

test "O4a: &x on parameters, results and locals" {
    a := OxN(1, null)
    b := OxN(2, null)
    oxLink(a, b)
    assert a.OxFirst().v == 2
    a.OxGrow(5)
    assert a.next.v == 5
    assert a.next.next.v == 2
    oxChain(a)
    assert oxChurn() > 0
    assert a.next.v == 10
    assert a.next.next.v == 11
}

test "O4a: &x naming a block-scoped local builds there, from an inner block" {
    outer := OxN(1, null)
    for i in range 1 {
        inner OxN&outer = OxN(7, null)
        called OxN&outer = oxMk(8)
        outer.next = inner
        inner.next = called
    }
    assert oxChurn() > 0
    assert outer.next.v == 7
    assert outer.next.next.v == 8
}

test "E25: f&x() builds the result where x lives" {
    outer := OxN(1, null)
    for i in range 1 {
        x := oxMk&outer(4)
        outer.next = x
    }
    assert oxChurn() > 0
    assert outer.next.v == 4
    oxGraft(outer)
    assert oxChurn() > 0
    assert outer.next.v == 5
    assert outer.next.next.v == 6
}

# O13/O26: a built result (bare "&", or by value holding references) is in the result scope, which follows
# the call's result. A returned local lives there, so a body never names it; a helper flowing into one says
# where it lives with "&left". A borrowed result names its parameter. Each is read back after the arena has
# been churned, so a value built in a closed scope would read back as garbage.
type OE struct(v I32, l mut OE&, r mut OE&) {
    v
    left mut OE& = l
    right mut OE& = r
}

type OHolder struct(x mut OxN&) { n mut OxN& = x }

fn oNum(v I32) OE& { return OE(v, null, null) }

fn oTerm(n I32) OE& {
    left OE&return = oNum(1)
    for i in range n {
        right OE&left = oNum(I32(i) + 2)
        left = OE(0, left, right)
    }
    return left
}

fn oBuild(v I32) OHolder {
    h := OHolder&return(OxN(v, null))
    h.n.next = OxN(v + 1, null)
    return h
}

fn (l OxN&) oLast() OxN&l {
    c OxN&l = l
    for c.next != null { c = c.next }
    return c
}

fn oFresh() OxN& {
    x OxN&return = null
    for i in range 3 { x = OxN(I32(i), x) }
    return x
}

fn oPair() (OxN&, OxN&) { return OxN(1, null), OxN(2, null) }

fn oSum(e OE&) I32 {
    if e == null { return 0 }
    return e.v + oSum(e.left) + oSum(e.right)
}

test "O13/O26: built results and returned locals live where the result goes" {
    outer := oNum(0)
    hh := oBuild(0)
    for i in range 1 {
        outer.left = oTerm(3)
        hh = oBuild(7)
    }
    assert oxChurn() > 0
    assert oSum(outer) == 2 + 3 + 4 + 1
    assert hh.n.v == 7
    assert hh.n.next.v == 8
    a := OxN(1, OxN(2, OxN(3, null)))
    assert a.oLast().v == 3
    assert oFresh().v == 2
    p, q := oPair()
    assert p.v + q.v == 3
}

test "O18a: a by-value result copied out of an inner block was built in the function's own scope" {
    h := oBuild(0)
    for i in range 1 {
        tmp := oBuild(9)
        h = tmp
    }
    assert oxChurn() > 0
    assert h.n.v == 9
    assert h.n.next.v == 10
}

# C2d: a field written "&p" lives where its constructor argument does, so a cursor may be shorter-lived than
# what it walks, and a write through it builds where the walked structure lives. C2c/E25: a scope argument on
# a constructor call builds the instance where the named variable lives.
type OCursor struct(of mut OxN&) {
    at mut OxN&of = of
    steps mut I32 = 0
}

fn (c mut OCursor&) OAdvance() {
    c.at = c.at.next
    c.steps++
}

test "C2d/E25: a cursor over a longer-lived list, and a constructor built where a variable lives" {
    list := OxN(1, OxN(2, OxN(3, null)))
    for i in range 1 {
        c := OCursor(list)
        c.OAdvance()
        assert c.at.v == 2
        c.at.next = OxN(9, null)
        made OxN&list = OxN&list(7, null)
        list.next.next.next = made
    }
    assert oxChurn() > 0
    assert list.next.next.v == 9
    assert list.next.next.next.v == 7
}

# O26/E25: "f&return()" builds a call's result in this function's result scope, and ":=" takes that scope, so
# the local can be built on and returned. A typed local says where it lives - "x OxN&l" - and never adopts.
fn oChainRet(n I32) OxN& {
    x := oxMk&return(n)
    x.next = oxMk(n + 1)
    return x
}

fn (l OxN&) oSecond() OxN&l {
    c OxN&l = l.next
    return c
}

test "O26/O25a: &return as a scope argument, := adopting it, and a typed local naming its scope" {
    out := OxN(0, null)
    for i in range 1 { out.next = oChainRet(5) }
    assert oxChurn() > 0
    assert out.next.v == 5
    assert out.next.next.v == 6
    assert out.oSecond().v == 5
}

# T29d: a declared primitive type may have a constructor. Its one parameter is the value, which the body may
# check (failing through its own error union) or change; "Pct(x)" runs it instead of the plain conversion. A
# literal entering such a type runs it too, while compiling, and arithmetic produces it without running the constructor - Pct extends
# I32 (T29f), so it has I32's operators.
error PctError { NEGATIVE }
type Pct extends I32(v mut I32) {
    if v > 100 { v = 100 }
}
type PctChecked I32(v I32) ? PctError {
    if v < 0 { error PctError.NEGATIVE }
}

fn (p Pct) PHalf() Pct { return p / 2 }

fn pctCheck(n I32) I32 ? PctError {
    c := try PctChecked(n)
    return c
}

PctFull Pct = Pct(250)
PctLit Pct = 180          # T29d: a literal enters through the constructor, run while compiling - 100
fn pctLit() Pct { return 150 }

test "T29d: a primitive type's constructor checks the way in, and arithmetic keeps working" {
    assert I32(Pct(150)) == 100
    q := Pct(40)
    assert I32(q + q + q) == 120
    assert I32(q.PHalf()) == 20
    assert q + 1 == Pct(41)
    assert I32(PctFull) == 100
    lit Pct = 150
    assert I32(lit) == 100 and I32(PctLit) == 100 and I32(pctLit()) == 100
    assert (try pctCheck(5) catch default -1) == 5
    assert (try pctCheck(-5) catch default -1) == -1
}

# D15: ":=" takes a field read - the field's declared type, and where its referent lives (O25a) - which is how
# a cursor starts
fn oSumFrom(l OxN&) I32 {
    t := 0
    for c := l.next, c != null, c = c.next { t = t + c.v }
    return t
}

test "D15: a cursor declared with := from a field read" {
    a := OxN(1, OxN(2, OxN(3, null)))
    assert oSumFrom(a) == 5
}

# E6c: integer arithmetic wraps, two's complement for the signed types and unsigned for U8 - at run time and in
# compile-time evaluation alike
fn wrapAdd(a I32, b I32) I32 { return a + b }
WrappedAtCompileTime I32 = wrapAdd(2147483647, 1)

test "E6c: integer arithmetic wraps" {
    big I32 = 2147483647
    n := 1
    assert big + I32(n) == -2147483648
    assert WrappedAtCompileTime == -2147483648
    b U8 = 255
    one U8 = 1
    assert b + one == 0
    z U8 = 0
    assert z - one == 255
    low I64 = -9223372036854775807 - 1
    assert -low == low
    assert I32(1) << 31 == -2147483648
}

# a checked index or slice fails with BuiltinError.OUT_OF_BOUNDS, from the prelude - caught by name, or let
# through by a signature naming it, as any error type is
fn builtinAt(a Array<I32>&, i I64) I32 ? BuiltinError {
    v I32 = try a[i]
    return v
}

fn builtinCode(a Array<I32>&, i I64) I32 {
    v := try builtinAt(a, i) catch BuiltinError default -1
    return v
}

test "BuiltinError.OUT_OF_BOUNDS from a checked index, caught by name and propagated" {
    a := I32[4, 5, 6]
    assert builtinCode(a, 1) == 5
    assert builtinCode(a, 7) == -1
    assert (try a[9] catch BuiltinError.OUT_OF_BOUNDS default -2) == -2
    n := 3
    s := try a[1:n] catch BuiltinError default a[0:0]
    assert s.Len() == 2
    t := try a[2:n + 5] catch BuiltinError default a[0:0]        # n + 5 is checked too: OVERFLOW is possible
    assert t.Len() == 0
    near U8 = 1
    far U8 = 200
    assert (try a[near] catch default -1) == 5        # a U8 index is unsigned
    assert (try a[far] catch default -1) == -1
}

# R20: "try (...)" checks every operation inside that can fail - integer overflow, a zero divisor, a shift amount
# outside the width, a conversion out of range, a float result becoming infinite or NaN, a negative array length,
# an index - each failing with its BuiltinError word, caught or propagated like any error
fn ckAdd32(a I32, b I32) I32 ? BuiltinError {
    r I32 = try (a + b)
    return r
}
fn ckSafe(a I32, b I32) I32 {
    r I32 = try (a + b) catch BuiltinError.OVERFLOW default -1
    return r
}
fn ckDivide(a I32, b I32) I32 {
    r I32 = try (a / b) catch BuiltinError.DIVIDE_BY_ZERO default -1 catch BuiltinError.OVERFLOW default -2
    return r
}
fn ckShift(a I64, n I32) I64 { return try (a << n) catch default -1 }
fn ckNarrow(v I64) I32 { return try I32(v) catch default -1 }
fn ckToInt(f F64) I32 { return try I32(f) catch BuiltinError.INVALID default -2 catch BuiltinError.OVERFLOW default -1 }
fn ckFdiv(a F64, b F64) F64 { return try (a / b) catch BuiltinError.DIVIDE_BY_ZERO default -1.0 catch default -2.0 }
fn ckFmul(a F64, b F64) F64 { return try (a * b) catch BuiltinError.OVERFLOW default -1.0 catch default -2.0 }
fn ckByteAdd(a U8, b U8) I32 { return try (a + b) catch default 0 }
fn ckNeg(a I32) I32 { return try (-a) catch default 7 }
fn ckLen(n I32) I64 {
    a := try Array<I32>(n) catch default Array<I32>(0)
    return a.Len()
}
fn ckMixed(a Array<I32>&, i I64, k I32) I32 { return try (a[i] * k) catch BuiltinError.OUT_OF_BOUNDS default -1 catch default -2 }

test "R20: try (...) checks arithmetic, shifts, conversions and lengths" {
    big I32 = 2147483647
    one I32 = 1
    assert ckSafe(big, one) == -1 and ckSafe(1, 2) == 3
    assert (try ckAdd32(big, one) catch default 99) == 99
    zero I32 = 0
    m I32 = -2147483647 - 1
    assert ckDivide(7, zero) == -1 and ckDivide(m, -1) == -2 and ckDivide(7, 2) == 3
    assert ckShift(1, 3) == 8 and ckShift(1, 64) == -1 and ckShift(1, -1) == -1
    assert ckNarrow(5) == 5 and ckNarrow(3000000000) == -1
    f F64 = 1.5
    zf F64 = 0.0
    nan F64 = zf / zf
    assert ckToInt(f) == 1 and ckToInt(1.0e12) == -1 and ckToInt(nan) == -2
    assert ckFdiv(1.0, 0.0) == -1.0 and ckFdiv(1.0, 2.0) == 0.5
    huge F64 = 1.0e300
    assert ckFmul(huge, huge) == -1.0 and ckFmul(2.0, 3.0) == 6.0
    b U8 = 200
    assert ckByteAdd(b, b) == 0 and ckByteAdd(1, 2) == 3
    assert ckNeg(m) == 7 and ckNeg(5) == -5
    assert ckLen(3) == 3 and ckLen(-1) == 0
    arr := I32[1, 2]
    assert ckMixed(arr, 1, 3) == 6 and ckMixed(arr, 5, 3) == -1 and ckMixed(arr, 1, big) == -2
}

# T6b/R20: a tried value that widens where it lands - returned (ckByteAdd above), declared, an operand, an argument -
# keeps its checks. The widening moved the try to a new node and its checks went on naming the old one, so a failing
# check found no clauses and was emitted as unreachable. CkWideIn is mutable, so the test runs them at run time;
# CkWideBaked runs the same calls while compiling (K2).
fn ckWidenDecl(a U8, b U8) I32 {
    x I32 = try (a + b) catch default 0
    return x
}
fn ckWidenOperand(a U8, b U8, w I32) I32 { return (try (a + b) catch default 7) + w }
fn ckId64(n I64) I64 { return n }
fn ckWidenArg(a U8, b U8) I64 { return ckId64(try (a * b) catch default 9) }
CkWideIn mut U8 = 200
CkWideBaked I64 = ckByteAdd(200, 200) + ckWidenDecl(200, 200) + ckWidenOperand(200, 200, 1000) + ckWidenArg(200, 200)

test "T6b/R20: a tried value widened where it lands keeps its checks" {
    v U8 = CkWideIn
    assert ckByteAdd(v, v) == 0 and ckWidenDecl(v, v) == 0 and ckWidenOperand(v, v, 1000) == 1007
    assert ckWidenArg(v, v) == 9 and ckWidenArg(v, 1) == 200
    assert CkWideBaked == 1016
}

# R20/K1: the compile-time evaluator runs checked operations as the generated code does - each global below is
# baked from a check that failed and was caught (one through a call), and the test reads the same at run time
fn ctSafe(a I32, b I32) I32 { return try (a + b) catch BuiltinError.OVERFLOW default -1 }
fn ctDiv(a I32, b I32) I32 { return try (a / b) catch BuiltinError.DIVIDE_BY_ZERO default -1 catch BuiltinError.OVERFLOW default -2 }
fn ctShift(a I64, n I32) I64 { return try (a << n) catch default -1 }
fn ctNarrow(v I64) I32 { return try I32(v) catch default -1 }
fn ctToInt(f F64) I32 { return try I32(f) catch BuiltinError.INVALID default -2 catch BuiltinError.OVERFLOW default -1 }
fn ctFmul(a F64, b F64) F64 { return try (a * b) catch BuiltinError.OVERFLOW default -1.0 catch default -2.0 }
fn ctIdx(i I64) I32 {
    a := I32[1, 2, 3]
    return try (a[i] * 2) catch BuiltinError.OUT_OF_BOUNDS default -1 catch default -2
}
fn ctProp(a I32, b I32) I32 ? BuiltinError { return try (a * b) }
fn ctOuter(a I32) I32 { return try ctProp(a, a) catch BuiltinError.OVERFLOW default -9 catch default -8 }

CtBaked1 I32 = ctSafe(2147483647, 1)
CtBaked2 I32 = ctDiv(-2147483647 - 1, -1)
CtBaked3 I32 = ctToInt(1.0e12)
CtBaked4 I32 = ctOuter(100000)

test "the evaluator runs checked operations as the generated code does" {
    assert CtBaked1 == -1 and CtBaked2 == -2 and CtBaked3 == -1 and CtBaked4 == -9
    assert ctSafe(1, 2) == 3
    assert ctDiv(7, 0) == -1
    assert ctShift(1, 64) == -1 and ctShift(1, 2) == 4
    assert ctNarrow(3000000000) == -1
    assert ctFmul(1.0e300, 1.0e300) == -1.0
    assert ctIdx(5) == -1 and ctIdx(1) == 4
    assert ctOuter(3) == 9
}

# K1: the compile-time evaluator models slices (borrows sharing the base), text ($x and joins, rendered as the run time
# renders it) and enum payloads (built, compared and matched). Each global below is baked while compiling; the test
# computes the same at run time - from a mutable global, which the evaluator cannot read - and compares
type CtW struct(t String&) { t }
type CtP struct(x I32, y I32) {
    x
    y
}
type CtN struct(v I32, nx mut CtN&) {
    v
    next mut CtN& = nx
}
type CtShape enum {
    Circle(r I32)
    Rect(w I32, h I32)
    Empty
}

fn ctArea(s CtShape) I32 {
    match s {
        case CtShape.Circle(r) { return r * r * 3 }
        case CtShape.Rect(w, h) { return w * h }
        case CtShape.Empty { return 0 }
    }
}

fn ctSliceSum(k I32) I32 {
    a := I32[1, 2, 3, 4, 5]
    s := a[1:4]
    s[0] = s[0] + k
    t I32 = 0
    for v in s { t = t + v }
    return t + a[1]
}

fn ctRender(k I32) String {
    p := CtP(1 + k, -2)
    n := CtN(3, CtN(4, null))
    f F64 = 2.5
    b U8 = 'q'
    word := "say \"hi\"\n"
    return $p " " $I32[k, 2] " " $CtShape.Rect(3, 4) " " $CtShape.Empty " " $n " " $f " " $b " " $true " " $word " " $CtW(word)
}

CtArea I32 = ctArea(CtShape.Rect(3, 4)) + ctArea(CtShape.Circle(2))
CtSum I32 = ctSliceSum(10)
CtText String = ctRender(0)
ctRuntimeZero mut I32 = 0

test "the evaluator models slices, text and enum payloads as the run time does" {
    assert CtArea == 24
    assert CtSum == 9 + 10 + 2 + 10
    k I32 = ctRuntimeZero
    assert CtText.Eq(ctRender(k))
    assert CtSum == ctSliceSum(k + 10)
}

# K1: a function value is modelled too - "$" renders it, "==" compares it by identity
fn ctTwice(n I32) I32 { return n * 2 }
fn ctThrice(n I32) I32 { return n * 3 }
fn ctPick(k I32) fn(n I32) I32 {
    if k == 0 { return ctTwice }
    return ctThrice
}
fn ctFaces(k I32) String {
    return $ctTwice " " $ctPick(k)
}
CtFaces := ctFaces(0)
CtSameFn Bool = ctPick(0) == ctPick(0) and ctPick(0) != ctPick(1)

# K2d: an enum carrying a payload is baked as data - its live case's fields written as the bytes they occupy
type CtInner struct(a U8, b I64) {
    a
    b
}
type CtMixed enum {
    Dot
    Real(r F64)
    Pair(w I32, h I32)
    Odd(k CtShape, f F32, i CtInner, t Bool)
}
fn ctMixed(k I32) CtMixed {
    if k == 0 { return CtMixed.Dot }
    if k == 1 { return CtMixed.Real(2.5) }
    if k == 2 { return CtMixed.Pair(-3, 40000) }
    return CtMixed.Odd(CtShape.Rect(1, 2), 1.25, CtInner(200, -9000000000), true)
}
type CtMixedBox struct(m CtMixed, x I32) {
    m
    x
}
CtMixed0 := ctMixed(0)
CtMixed1 := ctMixed(1)
CtMixed2 := ctMixed(2)
CtMixed3 := ctMixed(3)
CtMixedIn := CtMixedBox(ctMixed(3), 7)

# T29c: written text declares a String with ":=" wherever ":=" is written - a global too
CtWritten := "n=" $3

CtWrittenIs Bool = CtWritten == "n=3" and "n=4" != CtWritten

test "written text declared with := is a String as a global" {
    assert CtWritten.Eq("n=3") and CtWritten.Trim().Eq("n=3")
}

# Split: the pieces borrow the text they were split from, and the array holding them lives where that text
# does - so pieces split inside an inner block outlive it with their text
CtSplitN I64 = "a,b,,c".Split(",").Len()
CtSplitLast String& = "k=v".Split("=")[1]

test "Split's pieces live with the text, and the evaluator splits as the run time does" {
    k I32 = ctRuntimeZero
    line String& = "x" $k ",yy,zzz"
    parts Array<String&>&line = line.Split("!")
    if k == 0 {
        parts = line.Split(",")
    }
    assert churnArena() == 2469000
    assert parts.Len() == 3 and parts[0].Eq("x0") and parts[2].Eq("zzz")
    assert CtSplitN == 4 and CtSplitLast.Eq("v")
    assert CtSplitN == ("a,b,,c" $"").Split(",").Len()
}

# T29c: written text beside a String value in "==" is a String too - compared by content, since a String
# value is a value (E10); decided at compile time (the global above) and at run time alike
test "written text compares with a String value" {
    u String = "cm"
    k I32 = ctRuntimeZero
    v String = $k
    assert u == "cm" and "cm" == u and u != "mm"
    assert v == "0" and CtWrittenIs
}

test "the evaluator models function values and interfaces, and bakes enums carrying payloads" {
    k I32 = ctRuntimeZero
    assert CtFaces.Eq(ctFaces(k))
    assert CtFaces.Eq("ctTwice(n I32) I32 fn(n I32) I32")
    assert CtSameFn
    assert CtMixed0 == ctMixed(k) and CtMixed1 == ctMixed(k + 1) and CtMixed2 == ctMixed(k + 2)
    assert CtMixed3 == ctMixed(k + 3) and CtMixedIn.m == ctMixed(k + 3) and CtMixedIn.x == 7
    assert ($CtMixed3).Eq($ctMixed(k + 3)) and ($CtMixed1).Eq($ctMixed(k + 1))
}

# D16: lambdas - a function written where it is used. Its parameter types, result and errors come from the
# function type it is passed as (D16a), or from its own signature and body (D16b); "return" is always written
fn lamApply(f fn(x I32) I32, n I32) I32 { return f(n) }
fn lamMap(a Array<<T>>&, f fn(x <T>) <U>) Array<<U>> {
    out := Array<<U>>(a.Len())
    for i, x in a {
        out[i] = f(x)
    }
    return out
}
fn lamCount(a Array<<T>>&, keep fn(x <T>) Bool) I32 {
    n I32 = 0
    for x in a {
        if keep(x) { n++ }
    }
    return n
}
fn lamTry(f fn(a I32) I32 ? LamErr, a I32) I32 ? LamErr { return try f(a) }
fn lamDoubler() fn(x I32) I32 { return fn(x) { return x * 2 } }
error LamErr { NEG }

LamBaked I32 = lamApply(fn(x) { return x * 7 }, 6)
LamMapped := lamMap(I32[1, 2, 3], fn(x) { return I64(x) * 10 })
LamCounted I32 = lamCount(I32[1, 5, 2, 8], fn(x) { return x > 3 })

test "D16: lambdas take their types from where they are passed, and from their bodies" {
    k I32 = ctRuntimeZero
    assert lamApply(fn(x) { return x + 1 }, k + 3) == 4
    assert lamApply(fn(x I32) I32 { return x * x }, k + 3) == 9
    sub := fn(x I32) { return x - 1 }         # result from the body
    assert lamApply(sub, k + 3) == 2
    tens fn(x I32) I32 = fn(y) { return y * 10 }
    assert tens(k + 3) == 30
    assert lamApply(lamDoubler(), k + 3) == 6
    evens := lamMap(I32[1, 2, 3, 4], fn(x) { return x % 2 == 0 })   # <U> bound from the result
    assert evens[1] and not evens[2]
    assert LamBaked == lamApply(fn(x) { return x * 7 }, k + 6)
    assert LamMapped[2] == 30 and LamCounted == lamCount(I32[1, 5, 2, 8 + k], fn(x) { return x > 3 })
    assert (try lamTry(fn(a) {
        if a < 0 { error LamErr.NEG }
        return a + 1
    }, k - 1) catch default 99) == 99
    neg := fn(a I32) {                         # errors from the body
        if a < 0 { error LamErr.NEG }
        return a
    }
    assert (try neg(k - 5) catch LamErr default 7) == 7
    assert ($fn(x I32) { return x }).Eq("fn(x I32) I32")
}

# D16c/D16d: a lambda captures what it uses from the body around it - a value copied and read-only, a
# reference still naming its instance - and lives where the references it captured do
type LamCounter struct() {
    n mut I32 = 0
}
type LamPoint struct(x I32) {
    x mut
}
fn lamEach(a Array<<T>>&, f fn(x <T>)) {
    for x in a { f(x) }
}
fn lamAdder(n I32) fn(x I32) I32 { return fn(x) { return x + n } }
fn lamBorrow(p LamPoint&) fn(x I32) I32 { return fn(x) { return x + p.x } }
fn lamCountOver(a Array<I32>&, limit I32) I32 {
    keep := fn(x I32) { return x > limit }
    n I32 = 0
    for x in a {
        if keep(x) { n++ }
    }
    return n
}
fn lamIdentity(n I32) Bool {
    f := lamAdder(n)
    g fn(x I32) I32 = f
    return f == g and lamAdder(n) != lamAdder(n) and lamApply == lamApply
}
LamAdded I32 = lamApply(lamAdder(5), 2)
LamOver I32 = lamCountOver(I32[1, 5, 9], 4)
LamSame Bool = lamIdentity(1)

test "D16c: a lambda captures values by copy and references by reference" {
    k I32 = ctRuntimeZero
    limit I32 = k + 3
    a := I32[1, 2, 3, 4, 5]
    assert lamCount(a, fn(x) { return x > limit }) == 2
    f := fn(x I32) { return x * limit }       # a copy of limit, taken now
    limit = 100
    assert f(2) == 6
    stats LamCounter& = LamCounter()            # a reference: writes through it are seen outside
    lamEach(a, fn(x) { stats.n = stats.n + x })
    assert stats.n == 15
    ar Array<I32>& = a
    nested := fn(x I32) { return lamCount(ar, fn(y) { return y > x + limit }) }
    assert nested(-100) == 5 and nested(-96) == 1
    add5 := lamAdder(k + 5)                     # returned: built in the caller's scope
    p LamPoint& = LamPoint(k + 7)
    plus := lamBorrow(p)                         # lives where p does
    assert churnArena() == 2469000
    assert add5(1) == 6 and plus(1) == 8
    p.x = 10
    assert plus(1) == 11
    assert LamAdded == lamApply(lamAdder(k + 5), 2) and LamOver == lamCountOver(I32[1, 5, 9], k + 4)
    assert LamSame == lamIdentity(k + 1) and LamSame
    none fn(x I32) I32 = null
    assert none == null and ($none).Eq("null")
}

# D16e: "spawn fn() { ... }" - a task running a lambda's body, each one handed its own copies of what it captured
test "D16e: a spawned lambda captures its loop's variables per task" {
    out Array<mut LamCounter&>& = Array<mut LamCounter&>(8)
    for i in range 8 { out[i] = LamCounter() }
    sums Array<I64>& = Array<I64>(8)
    scale I32 = ctRuntimeZero + 3
    join {
        for i in range 8 {
            k I32 = I32(i) * scale
            spawn fn() {
                c := churnArena()
                out[i].n = k
                sums[i] = I64(k) * 2
            }
        }
    }
    assert out[7].n == 21 and sums[5] == 30
}

# T29e/T29f: a declared array type extending its base inherits every array method - text counts, maps and searches
# like any array
type LamNums extends Array<I32>
fn (n LamNums&) Total() I32 { return n.Fold(0, fn(acc, x) { return acc + x }) }
LamVowels I64 = "olang inherits".Count(fn(c) { return c == 'a' or c == 'e' or c == 'i' or c == 'o' or c == 'u' })

test "T29e: String and a program's own array type inherit the array methods" {
    s := "hello world"
    assert s.Count(fn(c) { return c == 'o' }) == 2 and s.Any(fn(c) { return c == ' ' })
    assert s.FindIndex(fn(c) { return c == 'w' }) == 6 and s.Find("world") == 6   # String's own Find too
    n := LamNums(I32[3, 1, 2])
    n.Sort(fn(x, y) { return x < y })
    assert n[0] == 1 and n.Total() == 6
    assert LamVowels == 5
}

# D16c/T7b: a value array is never copied implicitly - a lambda borrows it, read-only, and sees later writes
fn lamTwoArrays() (Array<I32>, I32) { return Array<I32>(1000, 7), 2 }
fn lamBorrowSees(k I32) I32 {
    a := I32[1, 2]
    second := fn() { return a[1] }
    a[1] = k
    return second()
}
LamBorrowed I32 = lamBorrowSees(5)

test "T7b: a captured array is borrowed, and a destructured array result is taken, not copied" {
    name := "bob"
    words := "x bob y bob".Split(" ")
    assert lamCount(words, fn(w) { return w.Eq(name) }) == 2
    hits := I32[5, 6]
    at := fn(i I64) { return hits[i] }
    hits[0] = 50                                # the lambda reads the array itself
    assert at(0) == 50
    big, n := lamTwoArrays()
    assert churnArena() == 2469000
    assert big[999] + n == 9 and big.Len() == 1000
    assert LamBorrowed == 5 and lamBorrowSees(ctRuntimeZero + 5) == 5
}

# T25b/T25c: permission is part of a reference's type - "mut T&" writable, "T&" read-only - at every level
type PermNode struct(v I32, next mut PermNode&) {
    v mut
    next mut
}
fn permFirst(l PermNode&) PermNode&l { return l }               # borrowed read-only
fn permGrab(l mut PermNode&) mut PermNode&l { return l }        # borrowed writable
fn permFresh(n I32) PermNode& { return PermNode(n, null) }    # built: writable
fn permBump(p mut PermNode&) { p.v++ }
fn permSum(a Array<PermNode&>&) I32 {                         # reads through read-only elements
    t I32 = 0
    for p in a { t = t + p.v }
    return t
}
PermRO PermNode& = PermNode(1, null)

test "T25b: writable and read-only references, by type" {
    k I32 = ctRuntimeZero
    n := permFresh(k + 3)              # a built result is writable
    permBump(n)
    assert n.v == 4
    g := permGrab(n)
    g.v = 10
    assert n.v == 10
    other := permFresh(k + 1)
    r := permFirst(n)                  # read-only: may be read and repointed, not written through
    assert r.v == 10
    r = permFirst(other)
    assert r.v == 1 and PermRO.v == 1
    keep Array<PermNode&>& = Array<PermNode&>(2)
    keep[0] = r                        # an array of read-only references takes a read-only one
    keep[1] = n                        # ...and a writable one, giving up the permission
    assert permSum(keep) == 11
    many Array<mut PermNode&>& = PermNode&[PermNode(1, null), PermNode(2, null)]   # a literal adapts
    for p in many { permBump(p) }
    assert many[0].v == 2 and many[1].v == 3
    words := "b a".Split(" ")          # its own array is writable, its pieces read-only
    words.Sort(fn(x, y) { return x.Compare(y) < 0 })
    assert words[0].Eq("a")
}

# E10/E10a: "==" goes through a declared Eq, at every depth - a field, an element, an enum's payload, through a
# reference (a null kept away from Eq), in a match and in "x in c"; same(a, b) is identity whatever Eq says.
# A mutable global makes every comparison below happen at run time; eqGlobal's are made while compiling (K2).
type EqLabel struct(s String&) {
    s
}
# two labels are equal when their texts are the same length - deliberately not what the bytes say
fn (a EqLabel&) Eq(b EqLabel&) Bool { return a.s.Len() == b.s.Len() }
type EqBox struct(l EqLabel, n I32) {
    l
    n
}
type EqShape enum {
    Named(l EqLabel)
    Both(x I32, l EqLabel)
    Blank
}
EqLen mut I32 = 2
fn eqText(n I32) String { return $("abcdefgh"[:n]) }
fn eqMatch(l EqLabel) I32 {
    match l {
        case EqLabel("x") { return 1 }
        case EqLabel("yy") { return 2 }
        nomatch { return 0 }
    }
}
fn eqWords(s String&) I32 {
    match s {
        case "ab" { return 1 }
        case "cd" { return 2 }
        nomatch { return 0 }
    }
}
fn eqAll() Bool {
    t := eqText(EqLen)
    a := EqLabel(t)
    own Bool = a == EqLabel("zz") and a != EqLabel("zzz")
    field Bool = EqBox(a, 1) == EqBox(EqLabel("qq"), 1) and EqBox(a, 1) != EqBox(EqLabel("qq"), 2)
    elems Bool = EqLabel[a, EqLabel("x")] == EqLabel[EqLabel("12"), EqLabel("y")]
    payload Bool = EqShape.Named(a) == EqShape.Named(EqLabel("..")) and EqShape.Both(1, a) != EqShape.Both(2, a)
    cases Bool = EqShape.Blank != EqShape.Named(a) and eqMatch(a) == 2 and EqLabel("..") in EqLabel[EqLabel("1"), a]
    return own and field and elems and payload and cases
}
EqBaked := eqAll()

test "E10a: == consults a declared Eq at every depth, while compiling and at run time" {
    assert eqAll()
    assert EqBaked
    s String& = eqText(EqLen)
    r String& = "ab"
    assert s == r and s == "ab" and "ab" == s and s != "abc" and not same(s, r) and same(s, s)
    assert eqWords(s) == 1 and eqWords(eqText(1)) == 0
    n String& = null
    m String& = null
    assert n == m and n != s and s != n and n == null
    p EqLabel& = EqLabel(s)
    q EqLabel& = EqLabel("zz")
    assert p == q and not same(p, q)
}

# E11c: "$" renders a type through its own Str - at the top level, inside another value, behind a reference -
# while compiling (StrBaked, K2) exactly as at run time
type StrMoney struct(cents I64) {
    cents
}
fn (m StrMoney&) Str() String { return "$" $(m.cents / 100) "." $(m.cents % 100) }
type StrCents I64
fn (c StrCents) Str() String { return $I64(c) "c" }
type StrOrder struct(id I32, price StrMoney, tip StrMoney&, parts Array<StrMoney>&) {
    id
    price
    tip
    parts
}
StrCount mut I64 = 250
StrBaked := $StrOrder(7, StrMoney(199), StrMoney(5), StrMoney[StrMoney(1), StrMoney(100)])

test "E11c: $ renders through a declared Str, wherever the value sits" {
    m := StrMoney(StrCount)
    assert $m == "$2.50"
    o := StrOrder(7, StrMoney(199), StrMoney(5), StrMoney[StrMoney(1), StrMoney(StrCount)])
    assert $o == "StrOrder(7, $1.99, $0.5, StrMoney[$0.1, $2.50])"
    assert StrBaked == "StrOrder(7, $1.99, $0.5, StrMoney[$0.1, $1.0])"
    n StrMoney& = null
    assert $n == "null"
    assert $StrCents(StrCount) == "250c"
}

# T6b: a number flows implicitly into a wider type of its own family - U8 into I32 into I64, F32 into
# F64 - and a declared type into its base; two numbers in an operator meet at the wider; a generic variable a
# number bound widens to a later, wider one. Run while compiling (WidenBaked, K2) and at run time.
type WdMeters I32
WdMutable mut I32 = 2000000000
fn wdWide(x I64) I64 { return x }
fn wdByte(b U8) I64 { return b }
fn wdBig(a <T>, b <T>) <T> { return a if a > b else b }
fn wdAll(a I32) Bool {
    b I64 = 3000000000
    c I64 = a + b
    d I64 = a
    d += a
    by U8 = 200
    i I32 = by
    f F32 = 1.5
    g F64 = f
    m := WdMeters(3)
    n I64 = m
    l := List<I32>()
    l.Push(by)
    sites Bool = c == I64(a) + 3000000000 and d == I64(a) * 2 and wdWide(a) == I64(a) and wdByte(by) == 200
    ops Bool = i == 200 and a < b and by < a and g + f == 3.0 and m + a == a + 3 and m < b and n == 3
    generic Bool = wdBig(a, b) == 3000000000 and wdBig(b, a) == 3000000000 and l.Len() == 1
    return sites and ops and generic
}
WidenBaked := wdAll(2000000000)

test "T6b: numbers widen within their family, and meet at the wider" {
    assert wdAll(WdMutable)
    assert WidenBaked
}

# T29f: "extends" - a declared type takes its base's methods and operators. An extending number inherits I64's Hash
# (so it is a Map key) and its arithmetic, giving the declared type; an extending array's method returning the
# receiver's own type gives the declared type (a String's Filter is a String). Without "extends", a type reads as
# its base - compared, or beside a base value - and makes nothing of itself.
type ExId extends I64
type ExPlain I32
fn exAll(n I32) Bool {
    a := ExId(I64(n))
    b ExId = a + a
    h Bool = a.Hash() == I64(n).Hash() and b == ExId(I64(n) * 2)
    s := "a-b-c".Filter(fn(c) { return c != '-' })
    v String = "abc"
    t Bool = s == "abc" and s.Trim() == "abc" and v.Trim() == "abc"   # a borrowed result held for Eq keeps its scope
    p := ExPlain(n)
    q I32 = p + 1
    r I64 = p * I64(2)
    plain Bool = p < ExPlain(n + 1) and p == ExPlain(n) and q == n + 1 and r == I64(n) * 2
    return h and t and plain
}
ExBaked := exAll(4)

test "T29f: extends inherits the base's methods and operators; without it a type reads as its base" {
    assert exAll(WdMutable)
    assert ExBaked
}

# D13c: a declaration with no value is its type's zero value, and a type with a constructor makes its own - the
# constructor run on zeros, taking parameters' defaults. Pure, so how often it runs cannot show: zero bits stay a
# memset, any other plain value is that value, one holding references gets a constructor call per declaration.
type ZOne I32(v mut I32) {
    if v == 0 { v = 1 }
}
type ZSized struct(cap I32 = 16, fill I32 = 7) {
    cap
    fill
}
type ZHolds struct(o ZOne) {
    o
}
type ZBag struct() {
    items mut List<I32>& = List<I32>()
}
ZGlobal ZOne
fn zeroAll() Bool {
    o ZOne
    z ZSized
    h ZHolds
    ones := Array<ZOne>(3)
    b ZBag
    c ZBag
    b.items.Push(1)
    values Bool = I32(o) == 1 and I32(ZGlobal) == 1 and z.cap == 16 and z.fill == 7 and I32(h.o) == 1
    return values and I32(ones[2]) == 1 and b.items.Len() == 1 and c.items.Len() == 0
}
ZeroBaked := zeroAll()

test "D13c: a type with a constructor makes its own zero value" {
    assert zeroAll()
    assert ZeroBaked
}

# T4: the numeric primitives - I8..I64 signed, U8..U64 unsigned (wrapping, dividing, comparing and shifting as
# unsigned), F16 and BF16 rounded as the hardware rounds them. Run while compiling (PrimsBaked, K2) and at run time.
fn primAll(one I32) Bool {
    u8 U8 = 255
    u8 = u8 + U8(one)
    i8 I8 = 127
    i8 = i8 + I8(one)
    u16 U16 = 0
    u16 = u16 - U16(one)
    umax U64 = U64(0) - U64(one)
    wrap Bool = u8 == 0 and i8 == -128 and u16 == 65535 and umax > U64(one)
    half U64 = umax / 2
    sdiv I8 = I8(-7) / I8(2)
    u32 U32 = U32(0) - U32(one)
    shifted U32 = u32 >> 28
    s16 I16 = I16(-16) >> 2
    divs Bool = half == U64(9223372036854775807) and sdiv == -3 and shifted == 15 and s16 == -4
    w16 I16 = U8(200)                 # T6b: an unsigned type flows into a wider signed one
    w64 I64 = u32
    f F32 = F16(1.5)
    flows Bool = w16 == 200 and w64 == 4294967295 and f == 1.5 and U8(I8(-1)) == 255
    h F16 = F16(0.1)
    b BF16 = BF16(1.0 / 3.0)
    floats Bool = F64(h) == 0.0999755859375 and F64(b) == 0.333984375 and F64(h * F16(2)) == 0.199951171875
    text Bool = $umax == "18446744073709551615" and $I8(-5) == "-5" and $F16(1.5) == "1.5" and $U16(65535) == "65535"
    big I32 = 300 * one
    tried Bool = (try U8(big) catch default U8(7)) == 7 and (try (i8 - I8(1)) catch default I8(0)) == 0
    return wrap and divs and flows and floats and text and tried
}
PrimsBaked := primAll(1)

test "T4: signed, unsigned and half-width float types" {
    assert primAll(WdMutable / 2000000000)
    assert PrimsBaked
}

# T29h: a Char is one byte of text - the type of 'a', rendering as a character where a U8 renders as a number, with
# U8's arithmetic ('a' + 1 is 'b'). A String is Chars; it goes wherever an Array<U8> is wanted, and String(bytes) is
# text again, neither copying anything.
fn charBytes(b Array<U8>&) I64 { return b[0] + b.Len() }
fn charAll(n I32) Bool {
    c Char = 'a'
    next Char = c + 1
    k I32 = 'A'
    u U8 = c
    s := "Hi 9"
    methods Bool = next == 'b' and c.IsLower() and s[0].IsUpper() and s[2].IsSpace() and s[3].IsDigit() and c.ToUpper() == 'A'
    text Bool = $c == "a" and $u == "97" and $Char['x', 'y'] == "xy" and $s[0] == "H" and k == 65
    raw := Array<U8>(2, U8(104 + n))
    bytes Bool = charBytes(s) == 72 + 4 and String(raw) == "ii" and $raw == "U8[105, 105]"
    return methods and text and bytes
}
CharBaked := charAll(1)

test "T29h: Char is text's unit and String holds Chars" {
    assert charAll(WdMutable / 2000000000)
    assert CharBaked
}

# M19e: a type's own method overrides a default of a GENERIC trait, from generic code too
type OvSrc<T> trait {
    Get() <T>
}
fn (s <S OvSrc<<T>>>&) OvPlain(k I32) I32 { return 1 }
fn ovPlainOf(s <S OvSrc<<T>>>&) I32 { return s.OvPlain(1) }
fn ovCount(it mut <I Iterator<I32>>&) I64 { return it.Count(fn(x) { return true }) }
type OvOne struct(v I32) {
    v
}
fn (o OvOne&) Get() I32 { return o.v }
fn (o OvOne&) OvPlain(k I32) I32 { return 2 }
type OvOnes struct(n I32) {
    left mut I32 = n
}
fn (o mut OvOnes&) Next() I32 ? Exhausted {
    if o.left == 0 { error Exhausted.END }
    o.left--
    return 1
}
fn (o mut OvOnes&) Count(keep fn(x I32) Bool) I64 { return 99 }

test "M19e: an override of a generic trait's default runs from generic code" {
    s OvOne& = OvOne(WdMutable)
    assert s.OvPlain(1) == 2 and ovPlainOf(s) == 2
    it OvOnes& = OvOnes(3)
    assert ovCount(it) == 99
}
