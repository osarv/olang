## Foundational types and functions - no imports. The base of this suite's import graph; worker.olang
## and runner.olang both import this file, and also import each other (a genuine cycle - see runner.olang).

type Point struct {
    x int32,
    y int32
}

type Direction vocab {
    NORTH,
    SOUTH,
    EAST,
    WEST
}

error MathError {
    DIV_BY_ZERO,
    OVERFLOW
}

error RangeError {
    TOO_SMALL,
    TOO_LARGE
}

func add(a int32, b int32) ? int32 {
    return a + b
}

func factorial(n int32) ? int32 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

func addLong(a int64, b int64) ? int64 {
    return a + b
}

func average(a float32, b float32) ? float32 {
    return (a + b) / 2.0
}

func isDigit(c byte) ? bool {
    return c >= '0' && c <= '9'
}

func setBit(flags int32, bit int32) ? int32 {
    return flags | (1 << bit)
}

func describe(n int32) ? int32 {
    result mut int32 = 0
    match n {
        case 1 {
            result = 100
        }
        case 2 {
            result = 200
        }
        nomatch {
            result = -1
        }
    }
    return result
}

func sumUntil(n int32) ? int32 {
    total mut int32 = 0
    i mut int32 = 1
    do {
        total = total + i
        i++
    } while i <= n
    return total
}

func SafeDiv(a int32, b int32) MathError ? int32 {
    if b == 0 {
        error MathError.DIV_BY_ZERO
    }
    return a / b
}

func CheckRange(n int32, lo int32, hi int32) RangeError ? int32 {
    if n < lo {
        error RangeError.TOO_SMALL
    }
    if n > hi {
        error RangeError.TOO_LARGE
    }
    return n
}

## combines both of this file's error types in one signature, in declaration order (MathError first) -
## worker.olang re-declares the same pair in the OPPOSITE order when it propagates this, exercising the
## error-union ABI's ordinal remap across two differently-ordered signatures
func ComputeChecked(a int32, b int32, lo int32, hi int32) MathError + RangeError ? int32 {
    if b == 0 {
        error MathError.DIV_BY_ZERO
    }
    result int32 = a / b
    if result < lo {
        error RangeError.TOO_SMALL
    }
    if result > hi {
        error RangeError.TOO_LARGE
    }
    return result
}

test "factorial of small numbers" {
    assert(factorial(0) == 1)
    assert(factorial(1) == 1)
    assert(factorial(5) == 120)
}

test "add sums its two arguments" {
    assert(add(2, 3) == 5)
    assert(add(-2, 5) == 3)
}

test "float32 arithmetic" {
    assert(average(2.0, 4.0) == 3.0)
}

test "byte comparisons" {
    assert(isDigit('5'))
    assert(!isDigit('x'))
}

test "bitwise or, and, xor, shift" {
    assert(setBit(0, 3) == 8)
    assert((5 & 3) == 1)
    assert((5 ^ 3) == 6)
}

test "match selects the right case" {
    assert(describe(1) == 100)
    assert(describe(2) == 200)
    assert(describe(99) == -1)
}

test "do-while accumulates" {
    assert(sumUntil(5) == 15)
}

test "fixed byte arrays compare by value, not identity" {
    a mut byte[5] = "hello"
    b mut byte[5] = "hello"
    c mut byte[5] = "world"
    assert(a == b)
    assert(a != c)
}

test "try/catch: SafeDiv succeeds on a non-zero divisor" {
    failed mut bool = false
    try SafeDiv(10, 2) catch MathError {
        failed = true
    }
    assert(!failed)
}

test "try/catch: SafeDiv reports failure on divide by zero" {
    failed mut bool = false
    try SafeDiv(10, 0) catch MathError {
        failed = true
    }
    assert(failed)
}
