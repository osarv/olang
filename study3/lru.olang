# lru - a generic least-recently-used cache: a map from key to node, the nodes on a doubly linked list in recency
# order, an eviction callback. Checked against a naive list-based model on a pseudo-random access pattern.

import "std/rand"

type Node<K, V> struct(key K, value V) {
    key
    value
    prev mut Node<K, V>&
    next mut Node<K, V>&
}

type Lru<K Hashable<K>, V> struct(capacity I64) {
    capacity
    nodes Map<K, mut Node<K, V>&>
    head mut Node<K, V>&             # most recently used
    tail mut Node<K, V>&             # least recently used
    hits I64 = 0
    misses I64 = 0
    onEvict fn(k K, v V) = null
}

fn (c mut Lru<<K>, <V>>&) unlink(n mut Node<K, V>&) {
    if n.prev != null { n.prev.next = n.next } else { c.head = n.next }
    if n.next != null { n.next.prev = n.prev } else { c.tail = n.prev }
    n.prev = null
    n.next = null
}

fn (c mut Lru<<K>, <V>>&) pushFront(n mut Node<K, V>&) {
    n.next = c.head
    if c.head != null { c.head.prev = n }
    c.head = n
    if c.tail == null { c.tail = n }
}

fn (c mut Lru<<K>, <V>>&) Get(key K) V ? {
    n := try c.nodes.Get(key) catch {
        c.misses++
        error
    }
    c.hits++
    c.unlink(n)
    c.pushFront(n)
    return n.value
}

fn (c mut Lru<<K>, <V>>&) Put(key K, value V) {
    existing := try c.nodes.Get(key) catch default null
    if existing != null {
        existing.value = value
        c.unlink(existing)
        c.pushFront(existing)
        return
    }
    if c.nodes.Len() == c.capacity {
        old := c.tail
        c.unlink(old)
        c.nodes.Remove(old.key)
        if c.onEvict != null { c.onEvict(old.key, old.value) }
    }
    n mut Node<K, V>&c = Node(key, value)
    c.nodes.Put(key, n)
    c.pushFront(n)
}

fn (c Lru<<K>, <V>>&) Len() I64 { return c.nodes.Len() }

# keys from most to least recent
fn (c Lru<<K>, <V>>&) Keys() List<K> {
    out := List<K>()
    for n := c.head, n != null, n = n.next { out.Push(n.key) }
    return out
}

# ---- a naive model: a list, most recent first ----

type Model struct(capacity I64) {
    capacity
    keys List<I64>
    vals List<I64>
}

fn (m mut Model&) get(k I64) I64 ? {
    for i in range m.keys.Len() {
        if m.keys[i] == k {
            v := m.vals[i]
            m.keys.RemoveAt(i)
            m.vals.RemoveAt(i)
            m.keys.Insert(0, k)
            m.vals.Insert(0, v)
            return v
        }
    }
    error
}

fn (m mut Model&) put(k I64, v I64) {
    try m.get(k) catch {
        if m.keys.Len() == m.capacity {
            try m.keys.Pop() catch {}
            try m.vals.Pop() catch {}
        }
        m.keys.Insert(0, k)
        m.vals.Insert(0, v)
        return
    }
    m.vals[0] = v
}

type Counter struct() {
    n I64
}

fn simulate(steps I64, seed U64) (I64, I64, Bool) {
    c := Lru<I64, I64>(16)
    m := Model(16)
    r := rand.Rand(seed)
    agree := true
    evicted mut Counter& = Counter()
    c.onEvict = fn(k I64, v I64) { evicted.n++ }
    for i in range steps {
        k := r.Below(40) if r.Below(4) != 0 else r.Below(8)
        if r.Below(3) == 0 {
            c.Put(k, i)
            m.put(k, i)
        } else {
            a := try c.Get(k) catch default -1
            b := try m.get(k) catch default -1
            if a != b { agree = false }
        }
    }
    agree = agree and c.Keys().ToArray().Equal(m.keys.ToArray())
    return c.hits, c.misses, agree
}

Sim := simulate(500, 7)

fn main() ? {
    names := Lru<String&, I32>(3)
    gone := List<String&>()
    goneRef mut List<String&>&gone = gone
    names.onEvict = fn(k String&, v I32) { goneRef.Push($k) }
    for w in String&["a", "b", "c", "a", "d", "b", "e"] {
        names.Put(w, I32(w[0]))
    }
    println("names: " $names.Keys().ToArray() " evicted " $gone.ToArray())
    hits, misses, agree := simulate(20000, 42)
    println("hits " $hits " misses " $misses " model agrees " $agree)
    println("baked: " $Sim)
}
