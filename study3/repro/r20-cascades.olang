type Sq<T, N I64> struct() {
    data Array<T, N * N>
}
fn (a Sq<<T>, <N I64>>&) Times(b Sq<T, N>&) Sq<T, N> { return Sq<T, N>() }
fn (a Sq<<T>, <N I64>>&) Size() I64 { return N }
fn grid(rows Array<String&>&) Array<Array<Char, <W I64>>, <H I64>> {
    out Array<Array<Char, W>, H>
    for y in range H {
        for x in range W { out[y][x] = rows[y][x] }
    }
    return out
}
fn main() ? {
    a := Sq<I64, 2>()
    b := Sq<I64, 3>()
    c := a.Times(b)
    println($c.Size())
}
