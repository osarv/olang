# r18 DIAGNOSTIC - O10c/B11 notes: an entry parsed out of a line that is new each iteration (as io.Lines gives) is
# stored into a longer-lived table. The rejection is right - the line dies at the end of the turn - but the note
# blames 'e' and proposes a scope argument: "'e' is made here, in a block that closes first - make it where 's'
# lives: 'parse&s(...)'". Following it (run2) only moves the error into parse: e's references are the LINE's, so the
# fix is to copy what is kept ($e.service) or keep the line. Other notes of this kind seen in the study:
# "make it where 'g' lives: 'At&g(...)'" (a List element), "'Recv&total(...)'" (a channel receive).
#
# expected: a note pointing at 'line' (where e's references come from), suggesting a copy
# actual: line 23 O10c with the note quoted (at line 22); line 31 (the suggested fix) O10c again, now inside parse
type Entry struct(service String&) {
    service
}
fn parse(line String&) Entry { return Entry(line[0:2]) }
type Stats struct() {
    names Map<String&, I64>
}
fn (s mut Stats&) add(e Entry) { s.names.Put(e.service, 1) }
fn run(lines Array<String&>&) I64 {
    s := Stats()
    for l in lines {
        line := $l "!"            # a fresh line each turn
        e := parse(line)
        s.add(e)
    }
    return s.names.Len()
}
fn run2(lines Array<String&>&) I64 {
    s := Stats()
    for l in lines {
        line := $l "!"
        e := parse&s(line)
        s.add(e)
    }
    return s.names.Len()
}
fn main() ? { println($run(String&["ab", "cd"]) $run2(String&["ab", "cd"])) }
