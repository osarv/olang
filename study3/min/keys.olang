fn f() I64 {
    m := Map<String&, I64>()
    m.Put("a", 1)
    m.Put("b", 2)
    l := List<String&>()
    for k in m.Keys() { l.Push(k) }
    return l.Len()
}
fn g() I64 {
    m := Map<String&, I64>()
    m.Put("a", 1)
    l := List<String&>()
    for e in m { l.Push(e.Key) }
    return l.Len()
}
fn h() I64 {
    src := List<String&>()
    src.Push("a")
    l := List<String&>()
    for s in src { l.Push(s) }
    for i in range src.Len() { l.Push(src[i]) }
    return l.Len()
}
fn main() ? { println($f() " " $g() " " $h()) }
