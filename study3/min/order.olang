fn mk(words Array<String&>&) mut Map<String&, I64>& {
    m mut Map<String&, I64>&return = Map<String&, I64>()
    for w in words { m.Update(w.ToLower(), 0, fn(n I64) I64 { return n + 1 }) }
    return m
}
fn merge(into mut Map<String&, I64>&, from Map<String&, I64>&) {
    for e in from { into.Put(e.Key, e.Value) }
}
fn a(words Array<String&>&) I64 {
    parts := Array<mut Map<String&, I64>&>(2)
    for t in range 2 { parts[t] = mk(words) }
    total := Map<String&, I64>()
    for i in range parts.Len() { merge(total, parts[i]) }
    return total.Len()
}
fn b(words Array<String&>&) I64 {
    total := Map<String&, I64>()
    parts := Array<mut Map<String&, I64>&>(2)
    for t in range 2 { parts[t] = mk(words) }
    for i in range parts.Len() { merge(total, parts[i]) }
    return total.Len()
}
fn main() ? { println($a(String&["X", "y"]) " " $b(String&["X", "y"])) }
