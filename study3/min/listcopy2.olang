fn main() ? {
    lists := Array<List<I64>>(3, List<I64>())
    lists[0].Push(7)
    lists[2].Push(99)
    println("lists[0][0] = " $lists[0][0] " (pushed 7)")
    a := List<I64>()
    a.Push(1)
    b := a
    b.Push(2)
    a.Push(3)
    println("b[1] = " $b[1] " (pushed 2)")
    m := Map<String&, I64>()
    for k in String&["a", "b", "c", "d", "e", "f", "g"] { m.Put(k, 1) }
    n := m
    n.Remove("a")
    println("m.Len " $m.Len() ", m.Has(a) " $m.Has("a") ", keys walked " $m.Keys().ToList().Len())
}
