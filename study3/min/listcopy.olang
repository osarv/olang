fn main() ? {
    a := List<I64>()
    a.Push(1)
    b := a              # a copy of a List value
    b.Push(2)
    a.Push(3)
    println("a " $a.ToArray() "  b " $b.ToArray())
    m := Map<String&, I64>()
    m.Put("x", 1)
    n := m
    n.Put("y", 2)
    println("m.Len " $m.Len() " m has y: " $m.Has("y") "  n.Len " $n.Len())
}
