type Entry struct(service String&) {
    service
}
fn parse(line String&) Entry {
    return Entry(line[0:2])
}
type Stats struct() {
    names Map<String&, I64>
}
fn (s mut Stats&) add(e Entry) {
    s.names.Put(e.service, 1)
}
fn run(lines Array<String&>&) I64 {
    s := Stats()
    for l in lines {
        line := $l "!"            # a fresh line each turn, as io.Lines gives
        e := parse(line)
        s.add(e)
    }
    return s.names.Len()
}
fn run2(lines Array<String&>&) I64 {
    s := Stats()
    for l in lines {
        line := $l "!"
        e := parse&s(line)
        s.add(e)
    }
    return s.names.Len()
}
fn main() ? { println($run(String&["ab", "cd"]) $run2(String&["ab", "cd"])) }
