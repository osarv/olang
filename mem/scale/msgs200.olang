fn TakeNotOwn(ty String&) Msg { return Msg(Diag.TakeNotOwn, "E34", "'take' moves an owner out of an own slot, and this is " $ty) }

# ERR_TAKE_READ_ONLY
fn TakeReadOnly() Msg { return Msg(Diag.TakeReadOnly, "E34", "'take' writes the slot it moves out of, and it is read-only here") }

# ERR_TAKE_BORROWED_COPY
fn TakeBorrowedCopy(text1 String&, text2 String&, text3 String&) Msg { return Msg(Diag.TakeBorrowedCopy, "E34", "'" $text1 "' is a borrowed copy and owns nothing - take from '" $text2 "', which owns what it holds, 'take " $text3 "'") }

# ERR_OWN_COPY_ASSIGNED
fn OwnCopyAssigned(text1 String&, text2 String&) Msg { return Msg(Diag.OwnCopyAssigned, "O32", "'" $text1 "' is a borrowed copy of '" $text2 "' and owns nothing, so it is not assigned - declare another with ':='") }

# ERR_OWN_COPY_PART
fn OwnCopyPart(text1 String&, text2 String&) Msg { return Msg(Diag.OwnCopyPart, "O32", "'" $text1 "' belongs to what '" $text2 "' was copied from - assign it there") }

# ERR_OWN_VALUE_SOURCE
fn OwnValueSource(ty String&) Msg { return Msg(Diag.OwnValueSource, "O32", $ty " owns objects: ':=' declares an owner from a value made here, a call's result or 'take', and a borrowed copy from a local holding one ('b := a') - this is neither") }

# ERR_OWN_VALUE_NOT_AN_OWNER
fn OwnValueNotAnOwner(ty String&) Msg { return Msg(Diag.OwnValueNotAnOwner, "O34", "a local of " $ty ", which owns objects, is given an owner - a value made here, a call's result, or 'take' of another - and this is not one") }

# ERR_OWN_VALUE_DEFAULT
fn OwnValueDefault(ty String&) Msg { return Msg(Diag.OwnValueDefault, "O34", $ty " owns objects, and a 'catch default' giving one is not supported yet - give the clause a block that leaves") }

# ERR_OWN_RELEASE_UNDER_LOAN
fn OwnReleaseUnderLoan(text String&, ty String&, n I64) Msg { return Msg(Diag.OwnReleaseUnderLoan, "O39", $text " may release the " $ty " borrowed on line " $n ", which is used after it") }

# ERR_OWN_MOVE_UNDER_LOAN
fn OwnMoveUnderLoan(text String&, ty String&, n I64) Msg { return Msg(Diag.OwnMoveUnderLoan, "O39", $text " moves the " $ty " borrowed on line " $n ", which is used after it - a borrowed object is not moved until its borrow is done") }

# ERR_OWN_RELEASE_UNDER_TASK
fn OwnReleaseUnderTask(text String&, ty String&, n I64) Msg { return Msg(Diag.OwnReleaseUnderTask, "O41", $text " may release the " $ty " the task spawned on line " $n " may be using until the join - release it after the join") }

# ERR_OWN_RELEASE_UNDER_TASK_ANY
fn OwnReleaseUnderTaskAny(text String&, n I64) Msg { return Msg(Diag.OwnReleaseUnderTaskAny, "O41", $text " may release what the task spawned on line " $n " may be using until the join - it calls a function value, which may reach any owned object; release it after the join") }

# ERR_OWN_CAPTURED
fn OwnCaptured(text1 String&, text2 String&) Msg { return Msg(Diag.OwnCaptured, "O32", "a lambda does not capture the owner local '" $text1 "' - capture a borrow of it, 'b := " $text2 "' outside the lambda") }

# ERR_OWN_TASK_RELEASE
fn OwnTaskRelease(text String&) Msg { return Msg(Diag.OwnTaskRelease, "O41", "a task may not release owned objects yet, and '" $text "' may - release them before the spawn or after the join") }

# ERR_OWN_FUNC_VALUE_RELEASE
fn OwnFuncValueRelease(text String&) Msg { return Msg(Diag.OwnFuncValueRelease, "O40", $text " releases owned objects, so it cannot be a function value - a function value releases nothing yet") }

# ERR_OWN_DESTRUCTOR_RELEASE
fn OwnDestructorRelease() Msg { return Msg(Diag.OwnDestructorRelease, "O40", "a destructor may not release owned objects - its instance's own fields are released after it runs") }

# ERR_TRAIT_NOT_A_TYPE
fn TraitNotAType(ty String&) Msg { return Msg(Diag.TraitNotAType, "T30", $ty " is a trait - a constraint on a type variable, never the type of a value") }

# ERR_ENUM_CASE_IN_USE
fn EnumCaseInUse(tok String&) Msg { return Msg(Diag.EnumCaseInUse, "T17", "enum case " $tok " is already declared") }

# ERR_DECLARED_TWICE
fn DeclaredTwice(tok String&) Msg { return Msg(Diag.DeclaredTwice, "", $tok " is declared twice") }

# ERR_FIELD_HAS_PARAM_NAME
fn FieldHasParamName(tok String&) Msg { return Msg(Diag.FieldHasParamName, "C2a", "field " $tok " has a parameter's name - write it bare to take the parameter's value, or name it apart") }

# ERR_TRAIT_METHOD_GENERIC
fn TraitMethodGeneric(tok String&) Msg { return Msg(Diag.TraitMethodGeneric, "T35", "trait method " $tok " may not be generic in a type of its own") }

# ERR_CTOR_FIELD_NO_VALUE
