# B (RetSole): a borrow of the returned local handed back as the SECOND result of a call - canKeep reads only
# ResultFrom(fty, 0), so the call is taken to keep nothing and the local is returned uncopied: the caller's value and
# the list's element are one storage
fn two(a I64, x String&) I64, String&x { return a, x }
type Keeper struct(l mut List<String&>&) { l }
fn (k mut Keeper&) Take(a I64, x String&) { k.l.Push(x) }
fn f(k mut Keeper&, i I64) String {
    s := "abc" $i
    k.Take(two(i, s))
    return s
}
fn probe(i I64) String {
    keep := List<String&>()
    k := Keeper(keep)
    v := f(k, i)
    v[0] = 'Q'
    return "keep " $keep " v " $v
}
G := probe(1)
fn main() {
    say("run:   " $probe(1))
    say("baked: " $G)
}
