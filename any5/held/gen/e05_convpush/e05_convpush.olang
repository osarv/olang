import "std/io"
# T29a: a conversion of a block's local text pushed into an outer list of the declared type, and assigned to an outer
# reference - a reference made from it borrows the local's storage (T29a), which closes with the block
type Lab extends String
type H struct() {
    r Lab& = Lab("init")
}
fn main() {
    l := List<Lab&>()
    h := H()
    for i in range 3 {
        s := "abc" $i "-" $(i * 7)
        l.Push(Lab(s))
    }
    churn()
    say("l " $l)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
