import "std/io"
# A: a scoped call through a function value, its text stored into an outer reference field and pushed into an outer
# list - is it judged (rv for a function value's type)?
type H struct() {
    s String& = "none"
}
fn mk(i I64) String { return "mk" $i "-" $(i * 7) }
fn main() {
    h := H()
    keep := List<String&>()
    f := mk
    for i in range 3 {
        u := "inner" $i
        h.s = f&u(i)
        keep.Push(f&u(i + 10))
    }
    churn()
    say("h.s " $h.s " keep " $keep)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
