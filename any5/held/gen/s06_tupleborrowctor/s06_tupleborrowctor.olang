import "std/io"
# B (RetSole): s01 again - a borrow of the returned local handed back as the SECOND result of a call (ResultFrom(fty, 1)),
# passed on whole (D8d) to a constructor whose instance is pushed into the caller's list
fn two(a I64, x String&) I64, String&x { return a, x }
type P2 struct(a I64, x String&) {
    a
    x
}
fn f(keep mut List<P2&>&, i I64) String {
    s := "abc" $i
    keep.Push(P2(two(i, s)))
    return s
}
fn probe(i I64) String {
    keep := List<P2&>()
    v := f(keep, i)
    v[0] = 'Q'
    return "keep " $keep[0].x " v " $v
}
G := probe(1)
fn main() {
    say("run:   " $probe(1))
    say("baked: " $G)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
