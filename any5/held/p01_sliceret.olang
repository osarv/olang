# value semantics: a function returning a slice of its parameter as an array value
fn sl(p String&) String { return p[0:3] }
fn mk(i I64) String {
    t := "abc" $i "def"
    return sl(t)
}
fn main() {
    t := "abcdef" $1
    x := sl(t)
    x[0] = 'Z'
    say("t " $t " x " $x)
    keep := List<String&>()
    for i in range 3 { keep.Push(mk(i)) }
    churn()
    say("kept " $keep)
}
