type Lab extends String
type W trait {
    mut Bump()
}
fn (l mut Lab&) Bump() { l[0] = 'Z' }
fn gid<T>(x T) T { return x }
fn probe(i I64) String {
    s := "abc" $i
    b mut any W& = Lab(gid(s))
    b.Bump()
    x := gid(s)
    x[1] = 'Q'
    return "src " $s " b " $b " x " $x
}
G := probe(1)
fn main() {
    say("run:   " $probe(1))
    say("baked: " $G)
}
