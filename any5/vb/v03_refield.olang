type Lab extends String
type W trait {
    mut Bump()
}
fn (l mut Lab&) Bump() { l[0] = 'Z' }
type K struct(s String&) { s }
fn get(k K&) String { return k.s }
fn probe(i I64) String {
    k := K("abc" $i)
    b mut any W& = Lab(get(k))
    b.Bump()
    x := get(k)
    x[1] = 'Q'
    return "src " $k.s " b " $b " x " $x
}
G := probe(1)
fn main() {
    say("run:   " $probe(1))
    say("baked: " $G)
}
