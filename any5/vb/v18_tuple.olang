type Lab extends String
type W trait {
    mut Bump()
}
fn (l mut Lab&) Bump() { l[0] = 'Z' }
fn two(p String&) String, I64 { return p, 1 }
fn get(p String&) String {
    a, n := two(p)
    return a
}
fn probe(i I64) String {
    s := "abc" $i
    b mut any W& = Lab(get(s))
    b.Bump()
    x := get(s)
    x[1] = 'Q'
    return "src " $s " b " $b " x " $x
}
G := probe(1)
fn main() {
    say("run:   " $probe(1))
    say("baked: " $G)
}
