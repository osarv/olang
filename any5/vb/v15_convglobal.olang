type Lab extends String
type W trait {
    mut Bump()
}
fn (l mut Lab&) Bump() { l[0] = 'Z' }
GS mut String = "abc"
fn get() Lab { return Lab(GS) }
fn probe(i I64) String {

    b mut any W& = Lab(get())
    b.Bump()
    x := get()
    x[1] = 'Q'
    return "src " $GS " b " $b " x " $x
}
G := probe(1)
fn main() {
    say("run:   " $probe(1))
    say("baked: " $G)
}
