type Lab extends String
type W trait {
    mut Bump()
}
fn (l mut Lab&) Bump() { l[0] = 'Z' }
fn get(l List<String&>&) String { return l[0] }
fn probe(i I64) String {
    l := List<String&>()
    l.Push("abc" $i)
    b mut any W& = Lab(get(l))
    b.Bump()
    x := get(l)
    x[1] = 'Q'
    return "src " $l " b " $b " x " $x
}
G := probe(1)
fn main() {
    say("run:   " $probe(1))
    say("baked: " $G)
}
