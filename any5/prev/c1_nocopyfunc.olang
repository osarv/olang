# T32 AnyNoCopy through a function type: a default returning a closure that gives its receiver by value (fn() G) is
# not refused when called through an any - the result is a function giving an any without its marker
type Ups struct(n I64) {
    n
    at I64 = 0
}
type Gen trait {
    mut Step() I64
}
fn (u mut Ups&) Step() I64 {
    u.at += 1
    return u.at
}
type Wrap<T> struct(l List<T>&) { l }
fn (g mut G&) Later<G Gen>() fn() G {
    return fn() G { return g }
}
fn main() {
    a mut any Gen& = Ups(5)
    f := a.Later()
    x := f()
    say("made")
}
