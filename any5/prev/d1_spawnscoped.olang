type P struct(n I64) { n }
type H struct(p P?&) { p }
fn mkp(i I64) P& { return P(i) }
fn main() {
    h := H(null)
    x P?& = null
    join {
        for i in range 2 {
            t := "inner" $i
            spawn x = mkp(i * 11 + 1)
        }
    }
    join {
        for i in range 2 {
            t := "inner" $i
            spawn x = mkp&t(i * 11 + 1)
        }
    }
}
