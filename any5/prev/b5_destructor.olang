# T7b, O26a: a returned local (moved to the result scope, returned as it is) borrowed writably by a destructor-bearing
# local of the same block; the destructor runs as the function's scopes close - after the result was computed - and
# writes the caller's value (T7b: "nothing those scopes do as they close can reach it")
type Res struct(r mut String&) { r } destruct { r[0] = 'Z' }
fn f(i I64) String {
    s := "abc" $i
    d := Res(s)
    return s
}
fn main() {
    x := f(1)
    say("x " $x)
    assert x == "abc1", "the callee's destructor wrote the caller's value"
}
