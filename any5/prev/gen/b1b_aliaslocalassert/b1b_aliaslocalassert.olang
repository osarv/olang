import "std/io"
# r20 through an assert: decided true while compiling and dropped; the same comparison fails at run time
fn f(lst mut List<String&>&, i I64) String {
    s := "abc" $i
    l := lst
    l.Push(s)
    return s
}
fn probe() String {
    lst := List<String&>()
    x := f(lst, 1)
    x[0] = 'Q'
    return $lst[0]
}
fn main() {
    assert probe() == "abc1"
    r := probe()
    say("run: lst[0] " $r)
    assert r == "abc1", "the caller's list changed when it wrote its own value"
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
