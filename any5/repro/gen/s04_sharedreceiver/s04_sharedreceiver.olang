import "std/io"
# B (RetSole): s03 with a method whose parameter shares its receiver's scope (x String&h) - a container's natural "add
# an element living where I live"; and the shared variable written on the container parameter instead (l ...&x)
type Holder struct(l mut List<String&>&) { l }
fn (h mut Holder&) Add(x String&h) I64 {
    h.l.Push(x)
    return 1
}
fn tie2(x String&, l mut List<String&>&x) I64 {
    l.Push(x)
    return 2
}
fn f(h mut Holder&, i I64) String {
    s := "abc" $i
    h.Add(s)
    return s
}
fn g(keep mut List<String&>&, i I64) String {
    s := "def" $i
    tie2(s, keep)
    return s
}
fn probe(i I64) String {
    keep := List<String&>()
    h := Holder(keep)
    v := f(h, i)
    v[0] = 'Q'
    w := g(keep, i)
    w[0] = 'R'
    return "keep " $keep " v " $v " w " $w
}
G := probe(1)
fn main() {
    say("run:   " $probe(1))
    say("baked: " $G)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
