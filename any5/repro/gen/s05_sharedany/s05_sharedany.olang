import "std/io"
# s04 through an any (decision 1): AnyItemNew takes the unscoped call's array for new storage and the box holds it as
# it is - which the list's element still names; a write through the any writes the list at run time, not while compiling
type Lab extends String
type W trait {
    mut Bump()
}
fn (l mut Lab&) Bump() { l[0] = 'Z' }
type Holder struct(l mut List<String&>&) { l }
fn (h mut Holder&) Add(x String&h) I64 {
    h.l.Push(x)
    return 1
}
fn f(h mut Holder&, i I64) String {
    s := "abc" $i
    h.Add(s)
    return s
}
fn probe(i I64) String {
    keep := List<String&>()
    h := Holder(keep)
    b mut any W& = Lab(f(h, i))
    b.Bump()
    return "keep " $keep
}
G := probe(1)
fn main() {
    say("run:   " $probe(1))
    say("baked: " $G)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
