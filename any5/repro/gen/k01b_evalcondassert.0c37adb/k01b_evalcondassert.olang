import "std/io"
# k01 asserted: a correct assertion (true at run time, as the built program shows) decided false while compiling, so
# the program is refused
fn pick(p String&, q String&, c Bool) String { return p if c else q }
fn probe(i I64) String {
    s := "cond" $i
    x := pick(s, s, i > 0)
    x[0] = 'Q'
    return $s
}
fn main() {
    assert probe(1) == "cond1"
    say("passed")
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
