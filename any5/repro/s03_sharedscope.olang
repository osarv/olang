# B (RetSole): the returned local lent to a callee whose parameter SHARES another parameter's scope (x String&l) and
# which keeps it there - the signature says so, so the body records no obligation and canKeep finds none: the local is
# returned uncopied, and the caller's value and the list's element are one storage
fn tie(l mut List<String&>&, x String&l) I64 {
    l.Push(x)
    return l.Len()
}
fn f(keep mut List<String&>&, i I64) String {
    s := "abc" $i
    tie(keep, s)
    return s
}
fn probe(i I64) String {
    keep := List<String&>()
    v := f(keep, i)
    v[0] = 'Q'
    return "keep " $keep " v " $v
}
G := probe(1)
fn main() {
    say("run:   " $probe(1))
    say("baked: " $G)
}
