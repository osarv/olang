type Sym struct(name String&) { name }
type Mod struct() {
    top mut Map<String&, Sym&>
}
type R struct() {
    mods mut List<mut Mod&>
}
fn (r R&) find1(n String&) Sym&r {
    m := r.mods[0]
    t := try m.top.Get(n) catch default null
    return t
}
fn (r R&) find2(n String&) Sym&r {
    m Mod&r = r.mods[0]
    t Sym&r = try m.top.Get(n) catch default null
    return t
}
fn main() ? {
    r := R()
    r.mods.Push(Mod())
    println($r.find1("a") " " $r.find2("a"))
}
