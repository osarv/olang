type Box struct(name String&) {
    name
    items mut List<I64>
}
fn make() Box {
    b := Box("x")
    for i in range 100 { b.items.Push(i) }
    return b
}
fn churn() I64 {
    t I64 = 0
    for i in range 100 {
        a := Array<I64>(64, 7)
        t += a[3]
    }
    return t
}
fn main() ? {
    b := make()
    x := churn()
    s I64 = 0
    for v in b.items { s += v }
    println($x " " $s)
}
