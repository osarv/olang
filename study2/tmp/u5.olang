fn mk() List<I64> {
    l := List<I64>()
    for i in range 100 { l.Push(i) }
    return l
}
fn churn() I64 {
    t I64 = 0
    for i in range 100 {
        a := Array<I64>(64, 7)
        t += a[3]
    }
    return t
}
fn main() ? {
    l := mk()
    x := churn()
    s I64 = 0
    for v in l { s += v }
    println($x " " $s)
}
