# The scoping and parameters rework (docs/rework.md section 13): a conditional or a match choosing places, given a bare
# type variable's parameter bound to a reference - a Vec<String&>'s Push - is held as given, as any argument there is
# (no E28 or E31b: nothing is written through it). Run by `make verify-params` under the switches.

fn line(allocates Bool, grows Bool) String {
    parts Vec<String&>
    parts.Push("x")
    parts.Push("allocates" if allocates else "allocates nothing")
    parts.Push(match grows {
        case true: "may grow"
        case false: "stays"
    })
    return parts.Join(", ")
}

test line "keeps a choice of constant text" {
    assert line(true, false) == "x, allocates, stays"
    assert line(false, true) == "x, allocates nothing, may grow"
}

Line String = line(true, true)
assert Line == "x, allocates, may grow"
