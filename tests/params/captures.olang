# The scoping and parameters rework (docs/rework.md section 13): a lambda captures a bare struct or enum parameter as
# the value it is - a copy of the caller's, as by value (D16c) - not the pointer it is passed by. Run by
# `make verify-params` under OLANG_PARAMS=new OLANG_SCOPES=infer.

type span struct(a I32, b I32) {
    a
    b
}

type deferred struct(n I64) {
    n
    later := Vec<fn() I64>()
}

fn (d deferred&) keep(sp span) { d.later.Push(fn() I64 { return I64(sp.a) * 10 + I64(sp.b) }) }

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

test deferred "a kept lambda reads its own copy of a bare parameter" {
    d := deferred(0)
    sp := span(4, 2)
    d.keep(sp)
    sp = span(9, 9)
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    assert s > 0 and d.later[0]() == 42
}
