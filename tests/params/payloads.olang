# The scoping and parameters rework (docs/rework.md section 13): a reference field of an enum case's payload no code
# writes through is read-only by inference, as a struct's is (round 2c) - so a case built from what a bare parameter
# reaches is a writable value whose payload is read-only. Run by `make verify-params` under OLANG_PARAMS=new
# OLANG_SCOPES=infer, as fields.olang is.

type typeRef enum {
    Named(path Array<I64>&, depth I64)
    Plain
}

type expr enum {
    Generic(path Array<I64>&)
    Name(n I64)
}

type resolver struct(n I64) {
    n
    seen := Vec<typeRef&>()
}

# keeps what it is given, reads through it, writes nothing through its payload
fn (r resolver&) resolve(t typeRef&) I64 {
    r.seen.Push(t)
    return match t {
        case typeRef.Named(p, d): p.Len() * 10 + d
        case _: 0
    }
}

# a case built from what a bare parameter reaches, handed to a "&" parameter
fn (r resolver&) named(x expr) I64 {
    match x {
        case expr.Generic(path) { return r.resolve(typeRef.Named(path, 1)) }
        case _ { }
    }
    return -1
}

test resolver "a case built from a bare parameter's reach is kept where it may be written, its payload read-only" {
    r := resolver(0)
    path := I64[4, 5, 6]
    assert r.named(expr.Generic(path)) == 31
    path[0] = 7
    match r.seen[0] {
        case typeRef.Named(p, _) { assert p[0] == 7 and p.Len() == 3 }
        case _ { unreachable }
    }
}

# the evaluator agrees
Kept I64 = resolver(0).named(expr.Generic(I64[1, 2]))
assert Kept == 21
