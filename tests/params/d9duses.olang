# The scoping and parameters rework (round 2f, D9d): what a "&" parameter reaches through a call's result - "fr :=
# c.frames[0]; fr.used[j] = true" - written is a use of it, so it stays "&"; a reference result met with "default null"
# is used as a reference. Run by `make verify-params` under OLANG_PARAMS=new OLANG_SCOPES=infer.

type frame struct() {
    used Vec<Bool>
}

type checker struct() {
    frames Vec<frame&>
}

fn (c checker&) mark(j I64) {
    fr := c.frames[0]
    fr.used[j] = true
}

type glob struct(name String&) {
    name
}

type scope struct() {
    gs Vec<glob&>
}

fn (s scope&) find(name String) glob& ? Missing {
    for g in s.gs {
        if g.name == name: return g
    }
    error Missing
}

test checker.mark "a write through an element a & receiver's Vec gives is its use" {
    c := checker()
    f := frame()
    f.used.Push(false)
    c.frames.Push(f)
    c.mark(0)
    assert f.used[0]
}

test scope.find "a reference result met with null stays a reference" {
    s := scope()
    s.gs.Push(glob("a"))
    g := try s.find("a") catch default null
    assert g is not null
    h := try s.find("b") catch default null
    assert h is null
}
