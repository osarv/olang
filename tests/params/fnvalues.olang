# The scoping and parameters rework (docs/rework.md section 14, open point 5): a function type's reference result may
# hand back what its "&" parameters reach, so a function doing so is a value of the type, and a call through the value
# holds each such argument to outlive the result. Run by `make verify-params` under OLANG_PARAMS=new OLANG_SCOPES=infer.

fn first(a Array<I64>&) Array<I64>& { return a }

fn pick(a Array<I64>&, b Array<I64>&, k I64) Array<I64>& { return a if k == 0 else b }

fn apply(f fn(a Array<I64>&) Array<I64>&, x Array<I64>&) Array<I64>& { return f(x) }

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

# what the value hands back kept past the loop turn its argument was made in: the argument made where it is kept
fn collect(f fn(a Array<I64>&) Array<I64>&) Vec<Array<I64>&> {
    kept := Vec<Array<I64>&>()
    for i in range 3 {
        xs := Array<I64>(i + 3, i)
        kept.Push(f(xs))
    }
    return kept
}

test first "a function handing back its & argument is a value, the result shared" {
    xs := I64[1, 2, 3]
    r := apply(first, xs)
    r[0] = 9
    assert xs[0] == 9
}

test pick "two & parameters, either handed back" {
    a := I64[1]
    b := I64[2]
    f := pick
    assert f(a, b, 0)[0] == 1 and f(a, b, 1)[0] == 2
}

test collect "a result through a value, kept past its argument's loop turn, read after the arena churns" {
    k := collect(first)
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    assert s > 0 and k[0][0] == 0 and k[1][0] == 1 and k[2][0] == 2 and k[2].Len() == 5
}
