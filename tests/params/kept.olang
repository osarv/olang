# The scoping and parameters rework (docs/rework.md section 14): a bare parameter is the callee's own value, so what a
# body builds from it and keeps past the call - a constructed value returned - holds the callee's own copy, never the
# caller's storage the parameter is passed by pointer to: a caller's later write does not show through, in a build and
# while compiling alike. The copy is the caller's, made only where its argument may change (KeptOwn, plan.ArgCopy). Run
# by `make verify-params` under OLANG_PARAMS=new OLANG_SCOPES=infer.

type holder struct(s String&) {
    s
}

type pt struct(name String&, n I64) {
    name
    n
}

type ptHolder struct(q pt&) {
    q
}

type maybe enum {
    None
    Some(s String&)
}

# a bare parameter's own storage kept whole, a view of it kept, a struct kept whole, a case's payload
fn mk(t String) holder { return holder(t) }
fn mkView(t String) holder { return holder(t[1:]) }
fn mkPt(p pt) ptHolder { return ptHolder(p) }
fn some(t String) maybe { return maybe.Some(t) }

# kept through a callee that keeps it: this function keeps it too, so its own callers copy
fn twice(t String) holder { return mk(t) }

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

fn afterWrite() String {
    t := $"abc"
    h := mk(t)
    v := mkView(t)
    w := twice(t)
    t[0] = 'x'
    return $h.s " " $v.s " " $w.s
}

# the evaluator's reading (K2: baked while compiling) - it must agree with the run time's
Baked String = afterWrite()

test holder "a value built from a bare parameter keeps the callee's own copy" {
    t := $"abc"
    h := mk(t)
    v := mkView(t)
    w := twice(t)
    t[0] = 'x'
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    assert s > 0 and h.s == "abc" and v.s == "bc" and w.s == "abc" and t == "xbc"
}

test ptHolder "a bare struct kept whole is the callee's copy" {
    nm := $"abc"
    a := pt(nm, 3)
    h := mkPt(a)
    a.n = 9
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    assert s > 0 and h.q.n == 3 and h.q.name == "abc"
}

test maybe "a case's payload is the callee's copy" {
    t := $"abc"
    m := some(t)
    t[2] = 'z'
    match m {
        case maybe.Some(x) { assert x == "abc" }
        case _ { unreachable }
    }
}

test holder "the evaluator agrees: baked while compiling, and an assert it decides" {
    assert Baked == "abc bc abc"
    assert afterWrite() == "abc bc abc"
}

# an argument that cannot change is passed as it is: constant data, and a local nothing writes after it is made
test holder "an argument that cannot change is not copied, and reads the same" {
    t := $"stays"
    h := mk(t)
    g := mk("data")
    assert h.s == "stays" and g.s == "data"
}
