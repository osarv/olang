# The scoping and parameters rework (docs/rework.md sections 14, 15): a bare parameter is the callee's own value, so a
# body may not keep its storage past the call (D9e, tests/params/fail/keptbare*.olang) - it keeps a copy of its own,
# written as a value assigned from the parameter ('c String = t'), and the caller's later write does not show through,
# in a build and while compiling alike. Run by `make verify-params` under OLANG_PARAMS=new OLANG_SCOPES=infer.

type holder struct(s String&) {
    s
}

type pt struct(name String&, n I64) {
    name
    n
}

type ptHolder struct(q pt&) {
    q
}

type maybe enum {
    None
    Some(s String&)
}

# a copy of a bare parameter's own storage kept whole, a view of it kept, a struct kept whole, a case's payload
fn mk(t String) holder {
    c String = t
    return holder(c)
}
fn mkView(t String) holder {
    c String = t[1:]
    return holder(c)
}
fn mkPt(p pt) ptHolder { return ptHolder(pt(p.name, p.n)) }
fn some(t String) maybe {
    c String = t
    return maybe.Some(c)
}

# handed to a callee that keeps a copy of its own: this function keeps nothing of it
fn twice(t String) holder { return mk(t) }

# (a kept lambda capturing a copy - 'c String = t', then 'fn() String { return $c }' - is refused under the switches by
# O10d: a local a returned closure captures is not lifted to the result scope by the inference, a recorded limit)

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

fn afterWrite() String {
    t := $"abc"
    h := mk(t)
    v := mkView(t)
    w := twice(t)
    t[0] = 'x'
    return $h.s " " $v.s " " $w.s
}

# the evaluator's reading (K2: baked while compiling) - it must agree with the run time's
Baked String = afterWrite()

test holder "a value built from a copy of a bare parameter keeps the callee's own" {
    t := $"abc"
    h := mk(t)
    v := mkView(t)
    w := twice(t)
    t[0] = 'x'
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    assert s > 0 and h.s == "abc" and v.s == "bc" and w.s == "abc" and t == "xbc"
}

test ptHolder "a copy of a bare struct kept whole is the callee's" {
    nm := $"abc"
    a := pt(nm, 3)
    h := mkPt(a)
    a.n = 9
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    assert s > 0 and h.q.n == 3 and h.q.name == "abc"
}

test maybe "a case's payload of a copy is the callee's" {
    t := $"abc"
    m := some(t)
    t[2] = 'z'
    match m {
        case maybe.Some(x) { assert x == "abc" }
        case _ { unreachable }
    }
}

test holder "the evaluator agrees: baked while compiling, and an assert it decides" {
    assert Baked == "abc bc abc"
    assert afterWrite() == "abc bc abc"
}

# an argument that cannot change is passed as it is: constant data, and a local nothing writes after it is made
test holder "an argument that cannot change is not copied, and reads the same" {
    t := $"stays"
    h := mk(t)
    g := mk("data")
    assert h.s == "stays" and g.s == "data"
}

type span struct(a I32, b I32) {
    a
    b
}

type spanned enum {
    At(sp span, k I64)
}

# ":=" of a bare parameter holding no reference declares its own value, a copy - so it may be given another value
# without tying the two parameters' storage together
fn spannedAt(sp span, other span, k I64) spanned {
    asp := sp
    if k > 0: asp = other
    return spanned.At(asp, k)
}

test spannedAt "a := of a bare plain struct is a value of its own" {
    a := span(1, 2)
    s := spannedAt(a, span(9, 9), 0)
    t := spannedAt(a, span(9, 9), 1)
    a.a = 5
    assert s == spanned.At(span(1, 2), 0) and t == spanned.At(span(9, 9), 1)
}
