# check: fail error[T25c]: a copy of a read-only holder cannot be returned as a writable value
# an instance holding a view of a bare parameter's text, its field written through elsewhere: no writable value
type holder struct(s String&) {
    s
}
fn mk(t String) holder { return holder(t) }
fn main() {
    a := $"abc"
    h := mk(a)
    h.s[0] = 'x'
    assert a == "abc"
}
