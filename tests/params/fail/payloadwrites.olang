# check: fail error[T25c]: this is read-only here
# a case's payload field written through elsewhere is writable, so a case built from a bare parameter's reach is refused
type typeRef enum {
    Named(path Array<I64>&, depth I64)
    Plain
}
type expr enum {
    Generic(path Array<I64>&)
    Name(n I64)
}
fn resolve(t typeRef&) {
    match t {
        case typeRef.Named(p, _) { p[0] = 9 }
        case _ { }
    }
}
fn named(x expr) {
    match x {
        case expr.Generic(path) { resolve(typeRef.Named(path, 1)) }
        case _ { }
    }
}
fn main() { named(expr.Generic(I64[1])) }
