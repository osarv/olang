# check: fail error[C2d]: this instance holds a reference to an argument it would outlive
# a bare parameter's own storage kept in existing storage - a record pushed into what a "&" receiver reaches - is
# refused, noting the bare parameter (D9e: kept only in what the function hands back, the callee's copy there; it had
# been kept by the round 2e's summary, its callers copying into the call's result scope, which outlives nothing here)
type expr enum {
    Lit(n I64)
    Wrap(x expr&)
}
type rec struct(k I64, x expr&) {
    k
    x
}
type fun struct() {
    recs Vec<rec>
}
type walker struct(f fun&) {
    f
}
fn (w walker&) made(k I64, x expr) {
    w.f.recs.Push(rec(k, x))
}
fn main() {
    w := walker(fun())
    e := expr.Wrap(expr.Lit(1))
    w.made(1, e)
    io.Println($w.f.recs.Len())!
}
import "std/io"
