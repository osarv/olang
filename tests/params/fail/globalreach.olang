# check: fail error[T25c]: this writes through a reference a read-only copy holds
# bulk review 5 (F1), its reproducer global_reach_write.olang: refused under the switches
# under the switches an immutable global's reach is written: a node a global struct refers to (written directly,
# and lent to a "&" parameter), and the text literal a global struct holds - constant data, which faults
import "std/io"

type node struct(v I64) {
    v
}

type box struct(n node&) {
    n
}

type named struct(s String&) {
    s
}

G box = box(node(1))
N named = named("abc")

fn poke(n node&) { n.v += 1 }

fn main() {
    G.n.v = 5
    poke(G.n)
    io.Println($G.n.v)!
    x := N.s
    x[0] = 'q'
    io.Println($N.s " " $x)!
}
