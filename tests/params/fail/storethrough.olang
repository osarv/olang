# check: fail error[O25h]: this value holds references into a scope the target outlives
# a writable element read through a field holding the caller's array, grown at the field's container's scope: refused
# (checks/cases/derivedcopybuild.olang without its marker, which the default path still lets read freed storage)
type Node struct(v I64) {
    v
    next Node?& = null
}
type View struct(ns Array<Node&>&) {
    at Array<Node&>& = ns
}
fn grow(x Node&) { x.next = Node(x.v + 100) }
fn visit(w View&) {
    x := w.at[0]
    grow(x)
}
fn work(a Array<Node&>&) { visit(View(a)) }
fn main() {
    a := Array<Node&>(1, Node(3))
    work(a)
    assert a[0].next!.v == 103
}
