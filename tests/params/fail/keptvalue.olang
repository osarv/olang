# check: fail error[T22a]: 'mk' relates its arguments' scopes
# a function keeping a bare parameter's own storage (D9e) is no value: its callers copy an argument that may change,
# which a call through a value cannot know to do
type holder struct(s String&) {
    s
}
fn mk(t String) holder { return holder(t) }
fn main() {
    f := mk
    a := $"abc"
    h := f(a)
    assert h.s == "abc"
}
