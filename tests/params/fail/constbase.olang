# check: fail error[T25d]: this hands data written in the program to 'a', which may write it
# round 3b: text written in the program given a "&" parameter of the type text is declared over (Array<Char>) - it
# was converted to a read-only Array<Char>& and handed over as the constant itself, the callee's write landing in the
# program's constant data (the MIR verifier refused it only in a test build)
import "std/io"

fn take(a Array<Char>&) I64 {
    a[0] = a[1]
    return a.Len()
}

fn main() {
    io.Println($take("abc"))!
}
