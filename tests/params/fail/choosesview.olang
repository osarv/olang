# check: fail error[T25c]
# a conditional choosing between a writable reference and a bare parameter's view: the view is read-only through "x!"
# too, so nothing is written through the choice (it had written the caller's node)
type node struct(v I64) {
    v
    next node?& = null
}
fn pick(k I64, a node, b node&) I64 {
    n := b if k == 0 else a.next!
    n.v = 9
    return n.v
}
fn main() {
    z := node(5)
    x := node(1)
    x.next = z
    y := node(2)
    pick(1, x, y)
}
