# check: fail an atomic read of 'g', a bare parameter, reads this function's own value
# D9 under the rework's round 2: an atomic read is there to see another thread's write, and a bare parameter is this
# function's own value, which no other thread writes - the error names 'g T&' (param_migrate takes it)
type Gate struct() {
    flag I32 = 0
}

fn open(g Gate) Bool { return g.flag.AtomicLoad() != 0 }

fn main() {
    g := Gate()
    assert not open(g)
}
