# check: fail error[E28]: a conditional or a match gives a copy of the value it chooses
# a conditional choosing a place given a constructor's "&" parameter kept in a field something writes through: the
# writes would go to the copy (round 2f defers E28 only where every field it lands in is read-only by inference)
type label struct(text String&) {
    text
}
fn (l label&) Shout() { l.text[0] = 'X' }
fn mk(long Bool) I64 {
    a := $"abc"
    b := $"de"
    l := label(a if long else b)
    l.Shout()
    return l.text.Len() + a.Len() + b.Len()
}
fn main() {
    assert mk(true) == 8
}
