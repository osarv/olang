# check: fail error[T25c]: this is read-only here
# a constructor writing through what it is given: a bare parameter's Vec given it would grow the caller's
fn first(v Vec<I64>&) I64 {
    v.Push(99)
    return v[0]
}
type popper struct(v Vec<I64>&) {
    v
    n I64 = first(v)
}
fn take(xs Vec<I64>) I64 {
    p := popper(xs)
    return p.n
}
fn main() {
    xs := Vec<I64>()
    xs.Push(1)
    assert take(xs) == 1
}
