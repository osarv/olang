# check: fail error[D9e]: 't' is a bare parameter - this function's own value - and what it hands back keeps its storage
# The scoping and parameters rework (round 2f, the user's decision): a bare parameter's own storage kept in what the
# function hands back - here a constructor's reference field - is refused, never copied by the caller unseen: the body
# keeps a copy of its own ('c String = t') or takes 't String&' to share the caller's.
type holder struct(s String&) {
    s
}

fn mk(t String) holder { return holder(t) }

fn main() {
    t := $"abc"
    h := mk(t)
    t[0] = 'x'
    assert h.s == "abc"
}
