# The scoping and parameters rework (docs/rework.md section 12): reference fields read-only by inference. Written in the
# rework's spelling (a bare parameter read-only, "&" may write) and run by `make verify-params` under OLANG_PARAMS=new
# OLANG_SCOPES=infer - not by `make verify`, whose compiler reads today's spelling.

# a cursor over text it never writes: its text field is read-only by inference, so one made from a bare parameter is
# no read-only copy - it is returned, and advanced by a method writing only its own position
type cursor struct(of String&) {
    text String& = of
    at I64 = 0
}

fn (c cursor&) next() Char ? Exhausted {
    if c.at >= c.text.Len() { error Exhausted.End }
    c.at++
    return c.text[c.at - 1]
}

# (a bare parameter's own storage is not kept - D9e - so the cursor is over a copy of its own, written)
fn cursorOf(t String) cursor {
    c String = t
    return cursor(c)
}

fn vowels(t String) I64 {
    c := cursorOf(t)
    n I64 = 0
    for {
        ch := try c.next() catch Exhausted { break }
        if ch == 'a' or ch == 'e' or ch == 'i' or ch == 'o' or ch == 'u': n++
    }
    return n
}

# a search state holding a fresh instance made from read-only data, and a buffer of its own it writes
type window struct(of String&, size I64) {
    seen Vec<I64> = Vec<I64>()
    at cursor& = cursor(of)
    size
}

fn (w window&) step() Bool ? Exhausted {
    ch := try w.at.next()
    w.seen.Push(I64(ch))
    return w.seen.Len() >= w.size
}

fn filled(t String, size I64) I64 {
    w := window(t, size)
    for {
        full := try w.step() catch Exhausted { break }
        if full: break
    }
    return w.seen.Len()
}

# computed while compiling as the run time computes it (K2, S17a)
Vowels I64 = vowels("education")
assert Vowels == 5

test vowels "a cursor made from a bare parameter's text is returned and walked" {
    assert vowels("rework") == 2
    assert vowels("") == 0
    assert Vowels == 5
}

test filled "an instance holding a fresh instance made from read-only text writes its own buffer" {
    assert filled("abcdef", 3) == 3
    assert filled("ab", 3) == 2
}
