# The scoping and parameters rework (X22, docs/rework.md 2.10): a C function's pointer not "const" given an owned
# array borrows it writably, as an olang "&" parameter does (E12c) - no copy; given what may not be lent writably it is
# given a copy, since old C interfaces leave "const" out of what they only read: a bare parameter whole is the body's own
# copy, made on entry (as for an olang "&" parameter, D9), and a read-only view, an immutable global or constant data a
# copy made for the call. A "const" pointer is trusted - no copy - unless an export fn of the program may write the
# storage while C runs (C may call back into one): then what may change, a mutable global's storage, is copied for the
# call. The compile-time evaluator calls no C (K1), so this is tested at run time. Run by `make verify-params`.
import cp "cptr/cptr.c"

Fixed Array<U8>& = U8[1, 1, 1]

Shared mut Array<U8>& = Array<U8>(3, 1)

export fn cpHook() { Shared[0] = 9 }

fn viaBare(b Array<U8>) I64 {
    cp.cp_fill(b, 3)
    return cp.cp_sum(b, 3)
}

fn viaView(b Array<U8>) I64 {
    cp.cp_fill(b[0:2], 2)
    return cp.cp_sum(b, 3)
}

fn viaGlobal() I64 {
    cp.cp_fill(Fixed, 3)
    return cp.cp_sum(Fixed, 3)
}

fn viaOwned() I64 {
    a := Array<U8>(4)
    cp.cp_fill(a, 4)
    return cp.cp_sum(a, 4)
}

fn viaConst(b Array<U8>) I64 { return cp.cp_sum(b, 3) }

test "a bare parameter given a C function's pointer not const is the body's own copy" {
    c := Array<U8>(3, 1)
    assert viaBare(c) == 24 and c[0] == 1
}

test "a read-only view or an immutable global given one is copied for the call" {
    c := Array<U8>(3, 1)
    assert viaView(c) == 3 and c[0] == 1
    assert viaGlobal() == 3 and Fixed[0] == 1
}

test "an owned array given one is lent as it is, and a const pointer reads the caller's storage" {
    c := Array<U8>(3, 2)
    assert viaOwned() == 34 and viaConst(c) == 6
}

test "a mutable global given a const pointer is copied where an export fn may write it" {
    Shared[0] = 1
    assert cp.cp_peek(Shared, cpHook) == 101 and Shared[0] == 9
}
