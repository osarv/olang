# The scoping and parameters rework, round 3b (docs/rework.md section 17): a value holding views in place of the copy
# it would be - Split's pieces, a walk's elements, an iterator holding its array, a reader's result - where nothing
# could tell the two apart: what it views changes by nothing while it lives. Each test writes what a value was made from
# where it may, after it was made, and reads the value back after an arena churn: it must read as its own copy.
# Run by `make verify-params` under OLANG_PARAMS=new OLANG_SCOPES=infer.

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

fn settle() I64 {
    s I64 = 0
    for i in range 1, 50 { s += churn(i * 8) }
    return s
}

# the words of a text, counted by their lengths: the pieces and each walk's element read where they stand
fn letters(t String) I64 {
    n I64 = 0
    for w in t.Split(" ") { n += w.Len() }
    return n
}

fn lineLengths(t String) I64 {
    n I64 = 0
    for l in t.Lines() { n += l.Len() * 10 }
    return n
}

fn total(a Array<I64>) I64 {
    s I64 = 0
    it := a.Iter()
    for x in it { s += x }
    return s + a.Iter().Fold(I64(0), fn(acc I64, x I64) I64 { return acc + x })
}

# a piece kept past the text it was cut from changing: its own copy
fn firstWord(t String) String {
    ps := t.Split(" ")
    return ps[0]
}

test letters "reads Split's pieces and walks over them where they stand" {
    assert letters("a bb ccc") == 6 and lineLengths("x\nyy\n") == 30 and total(I64[1, 2, 3]) == 12
}

test firstWord "a piece handed back is a copy the caller keeps" {
    t := $"one two"
    w := firstWord(t)
    t[0] = 'O'
    assert settle() > 0 and w == "one" and t == "One two"
}

test "pieces of a text changed after they were cut are their own" {
    t := $"ab cd"
    ps := t.Split(" ")
    t[0] = 'X'
    t[3] = 'Y'
    assert settle() > 0 and ps[0] == "ab" and ps[1] == "cd"
}

test lineLengths "lines walked while the text changes are the text as it was" {
    t := $"ab\ncd\nef"
    seen := Vec<String>()
    for l in t.Lines() {
        seen.Push(l)
        t[7] = 'Z'
    }
    assert settle() > 0 and seen[0] == "ab" and seen[2] == "ef" and t == "ab\ncd\neZ"
}

test total "an iterator over an array changed while it walks walks the array as it was" {
    a := I64[1, 2, 3]
    it := a.Iter()
    s I64 = 0
    for x in it {
        s += x
        a[2] = 100
    }
    assert settle() > 0 and s == 6 and a[2] == 100
}

test letters "elements of an array of text written in the walk are the elements as they were" {
    t := $"aa bb"
    ps := t.Split(" ")
    n I64 = 0
    for p in ps {
        ps[1] = "z"
        n += p.Len()
    }
    assert settle() > 0 and n == 3 and ps[1] == "z"
}

test letters "pieces kept in a Vec are its own" {
    t := $"p q r"
    kept := Vec<String>()
    for w in t.Split(" ") { kept.Push(w) }
    t[0] = 'P'
    assert settle() > 0 and kept.Len() == 3 and kept[0] == "p" and kept[2] == "r"
}

test total "a built result read where it stands, then kept as a copy" {
    v := Vec<I64>()
    v.Push(4)
    v.Push(5)
    a := v.ToArray()
    s := a.Iter().Fold(I64(0), fn(acc I64, x I64) I64 { return acc + x })
    v[0] = 40
    assert settle() > 0 and s == 9 and a[0] == 4
}

# the evaluator's reading (K2: baked while compiling) - it copies wherever the run time reads in place, so the two agree
Baked I64 = letters("a bb ccc") + lineLengths("x\nyy\n") + total(I64[1, 2, 3])
assert Baked == 48

KeptWord String = firstWord("one two")
assert KeptWord == "one"

test letters "the run time agrees with what the evaluator baked" {
    assert Baked == letters("a bb ccc") + lineLengths("x\nyy\n") + total(I64[1, 2, 3]) and KeptWord == firstWord("one two")
}
