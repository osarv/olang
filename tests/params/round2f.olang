# The scoping and parameters rework (docs/rework.md section 15, round 2f): what compiler/'s migration needed. Run by
# `make verify-params` under OLANG_PARAMS=new OLANG_SCOPES=infer, as handover.olang is.

type cell struct(v I64) {
    v
}

type row struct(C cell&, n I64) {
    C, n
}

type table struct() {
    rows Vec<row>
}

# a value read out of what a call a bare receiver's field is given hands back - a Vec's At - follows the receiver: as
# writable as the caller's
fn (t table) RowAt(i I64) row { return t.rows[i] }

type node enum {
    Leaf(c cell&)
    Pair(parts Array<node&>&)
}

# a value match handing back what a bare parameter reaches follows it, as a conditional does
fn firstPart(x node) node {
    return match x {
        case node.Pair(parts): parts[0]
        case _: x
    }
}

fn bump(n node&) {
    match n {
        case node.Leaf(c) { c.v++ }
        case _ { }
    }
}

fn value(n node) I64 {
    return match n {
        case node.Leaf(c): c.v
        case _: -1
    }
}

# a lambda handing on its capture of a "&" parameter around it to a "&" parameter uses that parameter (D9d)
fn add(c cell&, k I64) I32 {
    c.v += k
    return 0
}
fn run(f fn() I32) I32 { return f() }
fn addLater(c cell&, k I64) I32 { return run(fn() I32 { return add(c, k) }) }

# a conditional choosing a place given a constructor's "&" parameter that lands only in fields read-only by inference
type label struct(text String&) {
    text
    n := 0
}
fn labelOf(own String) I64 {
    l := label($own if own != "" else "")
    return l.text.Len()
}

test table.RowAt "hands back a row as writable as the table" {
    t := table()
    t.rows.Push(row(cell(1), 2))
    r := t.RowAt(0)
    r.C.v = 5
    assert t.rows[0].C.v == 5
}

test firstPart "hands back what a bare parameter reaches through a value match" {
    x := node.Pair(node&[node.Leaf(cell(3)), node.Leaf(cell(9))])
    bump(firstPart(x))
    assert value(firstPart(x)) == 4
}

test addLater "a capture of a & parameter handed on writes the caller's" {
    c := cell(1)
    assert addLater(c, 4) == 0
    assert c.v == 5
}

test labelOf "a conditional of text kept read-only by a constructor" {
    assert labelOf("abc") == 3 and labelOf("") == 0
}

# the evaluator agrees
Four I64 = value(firstPart(node.Pair(node&[node.Leaf(cell(4))])))
assert Four == 4
Three I64 = labelOf("xyz")
assert Three == 3
