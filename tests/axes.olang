# subscripts by axes (E16f) and nested literals (E21), on small matrices: x[i, j] calls At, a subscript with a range,
# ":" or "..." among its items calls Slice with one Axis per item, and Matrix[[1, 2], [3, 4]] is built row by row
# through the type's FromIter

# a row-major matrix of F64
type Matrix struct(rows I64, cols I64) {
    rows, cols
    data := Vec<F64>()
    for _ in range rows * cols: data.Push(0.0)
}

fn (m Matrix&) At(i I64, j I64) F64 { return m.data[i * m.cols + j] }
fn (m mut Matrix&) SetAt(i I64, j I64, v F64) { m.data[i * m.cols + j] = v }

# the part of m the two axes select, a copy; "..." first is every row, as ":" is
fn (m Matrix&) Slice(r Axis, c Axis) Matrix {
    r0, r1 := r.Bounds(m.rows)
    c0, c1 := c.Bounds(m.cols)
    out := Matrix(r1 - r0, c1 - c0)
    for i in range r0, r1 {
        for j in range c0, c1: out[i - r0, j - c0] = m[i, j]
    }
    return out
}

# a matrix of the rows a literal gives: Matrix[[1, 2], [3, 4]]
fn Matrix.FromIter<I Iterator<Array<F64> ? E> ? E>(it mut I&) Matrix ? E {
    data := Vec<F64>()
    rows, cols I64
    for row in try it {
        cols = row.Len()
        for x in row: data.Push(x)
        rows++
    }
    m := Matrix(rows, cols)
    for k in range data.Len(): m.data[k] = data[k]
    return m
}

# an n x n x n cube holding 0, 1, 2, ... in order, sliced by any number of axes: "..." stands for the axes not written
type Cube struct(n I64) {
    n
    data := Vec<I64>()
    for k in range n * n * n: data.Push(k)
}

fn (c Cube&) At(i I64, j I64, k I64) I64 { return c.data[(i * c.n + j) * c.n + k] }

# the sum of the elements the axes select
fn (c Cube&) Slice(axes ...Axis) I64 {
    lo := Array<I64>[0, 0, 0]
    hi := Array<I64>[c.n, c.n, c.n]
    d I64 = 0
    for i, a in axes {
        if a == Axis.Rest {
            d = 3 - (axes.Len() - i - 1)
            continue
        }
        l, h := a.Bounds(c.n)
        lo[d] = l
        hi[d] = h
        d++
    }
    total I64 = 0
    for i in range lo[0], hi[0] {
        for j in range lo[1], hi[1] {
            for k in range lo[2], hi[2]: total += c[i, j, k]
        }
    }
    return total
}

test Matrix.Slice "rows, columns and the rest" {
    m := Matrix[[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    assert m.rows == 3 and m.cols == 3 and m[1, 2] == 6.0
    top := m[0:2, :]
    assert top.rows == 2 and top.cols == 3 and top[1, 0] == 4.0
    col := m[..., 1]
    assert col.rows == 3 and col.cols == 1 and col[2, 0] == 8.0
    corner := m[1:, :2]
    assert corner.rows == 2 and corner.cols == 2 and corner[1, 1] == 8.0
    row := m[2, :]
    assert row.rows == 1 and row[0, 2] == 9.0
    m[1, 1] = 50.0
    assert m[0:3, 1:2][1, 0] == 50.0
}

test Cube.Slice "any number of axes, '...' the rest" {
    c := Cube(3)
    assert c[1, 2, 0] == 15
    assert c[..., 0] == 0 + 3 + 6 + 9 + 12 + 15 + 18 + 21 + 24
    assert c[0, ...] == 36
    assert c[0, :, 1:] == 1 + 2 + 4 + 5 + 7 + 8
    assert c[0:1, 0:1, 0:1] == 0
    assert c[2, ..., 2] == 20 + 23 + 26
}

test "an axis's bounds" {
    l, h := Axis.Range(2, I64.Max).Bounds(10)
    assert l == 2 and h == 10
    i, j := Axis.Index(4).Bounds(10)
    assert i == 4 and j == 5
}

test "nested literals of arrays and Vecs" {
    a := Array<Array<I64>>[[1, 2], [3, 4], [5, 6]]
    assert a.Len() == 3 and a[2][1] == 6
    v := Vec<Vec<I64>>[[1], [2, 3], []]
    assert v.Len() == 3 and v[1][1] == 3 and v[2].Len() == 0
}

# a generic 2-D tensor: the nested literal and the subscript by axes compose with generics
type Tensor<T> struct(rows I64, cols I64, data Vec<T>) { rows, cols, data }

fn Tensor<T>.FromIter<I Iterator<Array<T> ? E> ? E>(it mut I&) Tensor<T> ? E {
    data := Vec<T>()
    rows, cols I64
    for row in try it {
        cols = row.Len()
        for x in row: data.Push(x)
        rows++
    }
    return Tensor<T>(rows, cols, data)
}

fn (t Tensor<T>&) At(i I64, j I64) T { return t.data[i * t.cols + j] }

# the elements the two axes select, row by row
fn (t Tensor<T>&) Slice(r Axis, c Axis) Vec<T> {
    out := Vec<T>()
    r0, r1 := r.Bounds(t.rows)
    c0, c1 := c.Bounds(t.cols)
    for i in range r0, r1 {
        for j in range c0, c1: out.Push(t[i, j])
    }
    return out
}

test Tensor.Slice "a generic tensor's literal and slices" {
    t := Tensor<F32>[[1, 2, 3], [4, 5, 6]]
    assert t[1, 0] == 4.0
    col := t[:, 1]
    assert col.Len() == 2 and col[1] == 5.0
    assert t[1, ...].Len() == 3
    assert t[0:1, 1:].Len() == 2
}

# the compile-time evaluator agrees (K1, S17a): decided while compiling
assert Matrix[[1, 2], [3, 4]][..., 1][1, 0] == 4.0
assert Cube(2)[..., 1] == 1 + 3 + 5 + 7
assert Array<Array<I64>>[[1, 2], [3, 4]][1][0] == 3
assert Tensor<I64>[[1, 2], [3, 4]][..., 0][1] == 3

# a rank-3 cube whose At, SetAt and SetSlice take any number of indexes or axes (E31e): the variadic parameter holds
# them, a SetAt's and SetSlice's value follows it
type Voxels struct(n I64) {
    n
    data := Vec<I64>()
    for _ in range n * n * n: data.Push(0)
}

# the offset of a (possibly short) index, the first index the outermost
fn offsetOf(n I64, idx Array<I64>&) I64 {
    o I64 = 0
    for i in idx: o = o * n + i
    return o
}

fn (v Voxels&) At(i ...I64) I64 { return v.data[offsetOf(v.n, i)] }
fn (v mut Voxels&) SetAt(i ...I64, x I64) { v.data[offsetOf(v.n, i)] = x }

# every element the axes select set to x; an axis not written is whole
fn (v mut Voxels&) SetSlice(axes ...Axis, x I64) {
    lo := Array<I64>[0, 0, 0]
    hi := Array<I64>[v.n, v.n, v.n]
    d I64 = 0
    for i, a in axes {
        if a == Axis.Rest {
            d = 3 - (axes.Len() - i - 1)
            continue
        }
        l, h := a.Bounds(v.n)
        lo[d] = l
        hi[d] = h
        d++
    }
    for i in range lo[0], hi[0] {
        for j in range lo[1], hi[1] {
            for k in range lo[2], hi[2]: v.data[(i * v.n + j) * v.n + k] = x
        }
    }
}

fn (v Voxels&) total() I64 {
    t I64 = 0
    for x in v.data: t += x
    return t
}

# a SetSlice taking one Axis per axis, the value after them
type Plane struct(w I64) {
    w
    cells := Vec<I64>()
    for _ in range w * w: cells.Push(0)
}
fn (p mut Plane&) SetSlice(r Axis, c Axis, x I64) {
    r0, r1 := r.Bounds(p.w)
    c0, c1 := c.Bounds(p.w)
    for i in range r0, r1 {
        for j in range c0, c1: p.cells[i * p.w + j] = x
    }
}

test Voxels.At "one to three indexes, read and stored" {
    v := Voxels(3)
    v[1] = 5
    assert v[1] == 5 and v.data[1] == 5
    v[1, 2] = 7
    assert v[1, 2] == 7 and v.data[5] == 7
    v[1, 2, 0] = 9
    assert v[1, 2, 0] == 9 and v.data[15] == 9
}

# the indexes are evaluated once, left to right, and before the value (S4)
fn tick(log mut Vec<I64>&, k I64) I64 {
    log.Push(k)
    return k
}

test Voxels.At "indexes and value evaluated in order" {
    v := Voxels(4)
    log := Vec<I64>()
    v[tick(log, 1), tick(log, 2)] = tick(log, 3)
    assert log.Len() == 3 and log[0] == 1 and log[1] == 2 and log[2] == 3
    assert v[1, 2] == 3
    v[tick(log, 1), tick(log, 2)] += tick(log, 1)
    assert log.Len() == 6 and v[1, 2] == 4
}

test Voxels.SetAt "compound stores and parallel assignment" {
    v := Voxels(3)
    v[1, 2] = 7
    v[1, 2] += 3
    assert v[1, 2] == 10
    v[1, 2, 0] = 4
    v[1, 2, 0] *= 2
    assert v[1, 2, 0] == 8
    v[2]++
    assert v[2] == 1
    v[0, 1], v[1, 2], v[2, 2, 2] = 1, 2, 3
    assert v[0, 1] == 1 and v[1, 2] == 2 and v[2, 2, 2] == 3
    v[0, 1], v[1, 2] = v[1, 2], v[0, 1]
    assert v[0, 1] == 2 and v[1, 2] == 1
}

test Voxels.SetSlice "a store into a slice takes the axes, then the value" {
    v := Voxels(3)
    v[0:2, :, 1] = 4
    assert v.total() == 4 * 6 and v[1, 2, 1] == 4 and v[2, 0, 1] == 0
    v[..., 0] = 1
    assert v[2, 2, 0] == 1 and v[0, 0, 1] == 4
    v[1:2] = 8
    assert v[1, 2, 2] == 8 and v[2, 2, 2] == 0
    p := Plane(3)
    p[1:, :2] = 6
    assert p.cells[3] == 6 and p.cells[7] == 6 and p.cells[2] == 0 and p.cells[5] == 0
}

# a generic tensor whose indexing fails (E31a): a variadic At and SetAt may declare errors
type Cells<T> struct(n I64) {
    n
    data := Vec<T>()
    for _ in range n * n * n {
        z T
        data.Push(z)
    }
}
fn (c Cells<T>&) At(i ...I64) T ? OutOfRange {
    if i.Len() > 3: error OutOfRange
    return c.data[offsetOf(c.n, i)]
}
fn (c mut Cells<T>&) SetAt(i ...I64, x T) ? OutOfRange {
    if i.Len() > 3: error OutOfRange
    c.data[offsetOf(c.n, i)] = x
}

test Cells.At "fallible, generic and nested in a Vec" {
    c := Cells<F32>(2)
    try c[1, 1] = 2.5
    try c[1, 1] += 1.0
    assert (try c[1, 1]) == 3.5
    try c.SetAt(0, 1, 6.0)
    assert (try c.At(0, 1)) == 6.0
    r := try c[1, 1, 1, 1] catch default -1.0
    assert r == -1.0
    vs := Vec<Cells<I64>>()
    vs.Push(Cells<I64>(2))
    try vs[0][1, 1] = 4
    try vs[0][1, 1] += 1
    assert (try vs[0][1, 1]) == 5
}

fn voxelSum() I64 {
    v := Voxels(2)
    v[0, 1] = 5
    v[1, 1, 1] = 7
    v[1, 1, 1] += 1
    v[:, 0, 0] = 3
    return v[0, 1] + v[1, 1, 1] + v.total()
}

# the compile-time evaluator agrees (K1, S17a): the same stores and reads, decided while compiling
assert voxelSum() == 5 + 8 + (6 + 5 + 8)

# a variadic At beside a SetAt of two indexes (E31e): x[i, j, ...] reads through At with any number, x[i, j] = v and a
# compound store through x[i, j] - At's read, then SetAt's write-back - take two, each index evaluated once
type Grid struct(d mut Array<I64>&, w I64, asked I64) {
    d
    w
    asked
}

fn (g Grid&) At(i ...I64) I64 { return g.d[i[0] * g.w + i[1] + (i[2] if i.Len() > 2 else 0)] }
fn (g mut Grid&) SetAt(i I64, j I64, v I64) { g.d[i * g.w + j] = v }
fn (g mut Grid&) Ask() I64 {
    g.asked++
    return g.asked
}

fn gridSum() I64 {
    g := Grid(Array<I64>(9), 3, 0)
    g[1, 1] = 4
    g[1, 1] += 3
    g[2, 0]++
    g[g.Ask(), 2] *= 5
    g[0, 0] = g.asked
    vs := Vec<Grid>()
    vs.Push(Grid(Array<I64>(4), 2, 0))
    vs[0][1, 0] += 9
    return g[1, 1] + g[2, 0] + g[1, 1, 1] + g[0, 0] + vs[0][1, 0]
}

test Grid.At "a variadic At with a SetAt of two indexes" {
    g := Grid(Array<I64>(9), 3, 0)
    g[0, 2] = 2
    g[0, 2] += 1
    g[g.Ask(), 1] -= 4
    assert g[0, 2] == 3 and g[0, 1, 1] == 3 and g[1, 1] == -4 and g.asked == 1
    assert gridSum() == 7 + 1 + 0 + 1 + 9
}

assert gridSum() == 18
