# S16e: unreachable where a value is expected - beside a conditional's other value, a match's, a catch default, an
# argument. Each test holds the run time to what the compile-time evaluator bakes (K2) and decides (S18c)
import "std/io"

type Shape enum { Circle(r F64), Square(s F64) }

fn pick(s String&, b Bool) String&s { return s if b else unreachable "never " $b }

fn area(sh Shape) F64 {
    return match sh {
        case Shape.Circle(r): r * r * 3.0
        case Shape.Square(s): s * s if s > 0.0 else unreachable
    }
}

fn get(m Map<String&, I64>&, k String&) I64 {
    return try m.Get(k) catch default unreachable "missing " $k
}

fn sum(xs Array<I64>&) I64 {
    t I64 = 0
    for x in xs: t += x if x >= 0 else unreachable "negative"
    return t
}

fn first(xs Vec<String&>&) String&xs { return xs[0] if xs.Len() > 0 else unreachable }

fn twice(x I64) I64 { return x * 2 }

fn sign(n I64) I64 {
    return match n {
        case 0: 0
        case 1: 1
        case _: unreachable "a sign is 0 or 1"
    }
}

fn half(n I64) I64 { return n / 2 if n % 2 == 0 else unreachable "odd: " $n }

BakedSum I64 = sum(I64[1, 2, 3])
BakedHalf I64 = twice(half(10) if true else unreachable)

test "unreachable gives way to the values beside it" {
    assert pick("a", true) == "a"
    assert area(Shape.Square(2.0)) == 4.0 and area(Shape.Circle(1.0)) == 3.0
    m := Map<String&, I64>()
    m.Put("x", 4)
    assert get(m, "x") == 4
    v := Vec<String&>()
    v.Push("q")
    assert first(v) == "q"
    assert twice(3 if v.Len() == 1 else unreachable) == 6
    assert sign(1) == 1 and sign(0) == 0
    io.Println(pick("unreachable: ok", true))!
}

test "the evaluator agrees" {
    assert BakedSum == 6 and BakedSum == sum(I64[3, 2, 1])
    assert BakedHalf == 10 and half(10) == 5
    assert sum(I64[1, 2]) == 3 # decided while compiling (S18c)
    assert half(8) == 4
}
