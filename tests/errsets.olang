# T19, T19a, R11b, R3a: error types declared as types, named error sets, and the name a catch clause gives the error it
# took. Each computation is done twice - as a global the evaluator bakes and an assert it decides while compiling (K2,
# S18c), and on an input the evaluator cannot see (Live, a mutable global), at run time - so the two must agree.

import "std/os"

type ParseErr error { EMPTY, BAD }
type NetErr error {
    DOWN
    SLOW
}
# a set: its members, flattened, then its own words
type LoadErr error os.Error, ParseErr { TIMEOUT }
# a set of a set and a single word
type AnyErr error LoadErr, NetErr.DOWN

Live mut I64 = 0

fn load(n I64) I64 ? LoadErr {
    if n == 0 { error ParseErr.EMPTY }
    if n == 1 { error ParseErr.BAD }
    if n == 2 { error LoadErr.TIMEOUT }
    if n == 3 { error os.Error.DENIED }
    return n * 10
}

fn fetch(n I64) I64 ? AnyErr {
    if n == 9 { error NetErr.DOWN }
    return try load(n)
}

# the same set written out
fn loadAgain(n I64) I64 ? os.Error, ParseErr, LoadErr { return try load(n) }

fn label(n I64) String {
    return try $load(n) catch e default ("failed: " $e)
}

fn kind(n I64) I64 {
    return try fetch(n) catch e {
        match e {
            case ParseErr.EMPTY { return 100 }
            case ParseErr { return 200 }
            case LoadErr.TIMEOUT { return 300 }
            case NetErr { return 400 }
            nomatch { return 500 }
        }
    }
}

fn kindValue(n I64) I64 {
    return try fetch(n) catch e default (match e {
        case ParseErr => 1
        case LoadErr.TIMEOUT, NetErr.DOWN => 2
        case os.Error => 3
    })
}

# what a test narrows: after "e != ParseErr" leaves, e can only be ParseErr, which the set promises
fn onlyParse(n I64) I64 ? ParseErr {
    return try load(n) catch e {
        if e != ParseErr { return -1 }
        error e
    }
}

fn twice(n I64) I64 ? ParseErr {
    return try onlyParse(n) catch ParseErr.BAD default 7 catch e { error e }
}

BakedLabel := label(0)
BakedTimeout := label(2)
BakedKinds := I64[kind(0), kind(1), kind(2), kind(3), kind(9), kind(5)]
BakedValues := I64[kindValue(1), kindValue(2), kindValue(3), kindValue(9)]
BakedTwice := I64[try twice(0) catch ParseErr e default (10 if e == ParseErr.EMPTY else 20), try twice(1) catch default -9, try twice(3) catch default -9]

test "an error type and a set are declared as types, and a set stands for its members" {
    f fn(n I64) I64 ? os.Error, ParseErr, LoadErr = load
    assert (try f(4) catch default 0) == 40
    g fn(n I64) I64 ? LoadErr = loadAgain
    assert (try g(1 + Live) catch ParseErr.BAD default -1 catch default 0) == -1
    assert (try fetch(9 + Live) catch AnyErr default 1) == 1
    assert (try fetch(Live) catch LoadErr default 2 catch NetErr default 3) == 2
}

test "a caught error renders as its name prints, decided while compiling and at run time alike" {
    assert BakedLabel == "failed: ParseErr.EMPTY"
    assert BakedTimeout == "failed: LoadErr.TIMEOUT"
    assert label(0) == "failed: ParseErr.EMPTY"
    assert label(Live + 3) == "failed: os.Error.DENIED"
    assert label(Live + 1) == "failed: ParseErr.BAD"
    assert label(Live + 5) == "50"
}

test "a caught error is compared, narrowed and matched" {
    assert BakedKinds == I64[100, 200, 300, 500, 400, 50]
    for i, n in I64[0, 1, 2, 3, 9, 5] { assert kind(n + Live) == BakedKinds[i] }
    assert BakedValues == I64[1, 2, 3, 2]
    assert kindValue(Live + 9) == 2 and kindValue(Live + 3) == 3
}

test "a caught error is raised again, held to the set the narrowing leaves" {
    assert BakedTwice == I64[10, 7, -1]
    assert (try onlyParse(Live) catch ParseErr e default (1 if e == ParseErr.EMPTY else 2)) == 1
    assert (try twice(Live + 1) catch default -1) == 7
    assert (try onlyParse(Live + 3) catch default -9) == -1
}

test "a clause's name reaches its block and its default; each clause its own" {
    r := try load(Live + 2) catch ParseErr p default ($p).Len() catch LoadErr.TIMEOUT t {
        assert $t == "LoadErr.TIMEOUT"
    } default 99
    assert r == 99
    s := try $load(Live) catch e default $e
    assert s == "ParseErr.EMPTY"
}
