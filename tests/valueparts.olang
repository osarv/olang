# QCE (T7a, docs/rework.md sections 16 and 18): an array of a run-time length held by value inside another value - a
# struct's field, an array's element, an enum's payload, a type argument - is that value's own, its elements stored
# where the value is. A store copies what it is given in, a copy of the whole copies them too, a by-value parameter is
# its callee's own copy, and nothing another name holds changes it. The text the tests write to show it is an
# Array<Char> (a String never changes, T13a).

type person struct(name Array<Char>, age I64) {
    name, age
}

type shape enum {
    Named(label Array<Char>, n I64)
    Plain
}

type team struct(title String) {
    title
    members Vec<String> = Vec<String>()
    tags Array<String> = Array<String>["a", "bc"]
}

# a holder of what it is given: its own copy, not the caller's storage kept
type holder struct(s Array<Char>) {
    s
}

fn holder.mk(t Array<Char>&) holder { return holder(t) }

# a part stored from a block's own text outlives the block, and a later write to that text is not seen
fn person.stored() person {
    p := person($"x", 1)
    {
        t Array<Char> = $"inner"
        p.name = t
        t[0] = 'X'
    }
    return p
}

fn words() Array<Array<Char>> {
    out := Array<Array<Char>>(3)
    for i in range 3 {
        w Array<Char> = $"w" + $i
        out[i] = w
        w[0] = 'z'
    }
    return out
}

fn person.renamed() person {
    p := person($"bob", 3)
    q := p
    q.name[0] = 'B'
    return q
}

# evaluated while compiling (K2, S17a): the evaluator copies as the run time does
Baked person = person.renamed()
assert person.renamed().name == "Bob" and person.stored().name == "inner"
assert words()[2] == "w2"

test "a part store copies its value in" {
    p := person.stored()
    assert p.name == "inner"
    a := words()
    assert a[0] == "w0" and a[2] == "w2"
    h := holder.mk($"kept")
    assert h.s == "kept"
    t Array<Char> = $"abc"
    g := holder.mk(t)
    t[0] = 'x'
    assert g.s == "abc"
}

test "a Vec and a Map own what they hold" {
    v := Vec<Array<Char>>()
    for i in range 4 {
        t Array<Char> = $"n" + $i
        v.Push(t)
        t[0] = '?'
    }
    assert v[0] == "n0" and v[3] == "n3" and v.Len() == 4
    m := Map<Array<Char>, I64>()
    k Array<Char> = $"abc"
    m.Put(k, 1)
    k[0] = 'x'
    assert m.Has("abc") and not m.Has("xbc") and (try m.Get("abc")) == 1
}

test "payloads, literals and fills" {
    t Array<Char> = $"lab"
    s := shape.Named(t, 2)
    t[0] = 'L'
    assert s == shape.Named("lab", 2)
    xs := Array<String>["a", "bc", "def"]
    assert xs[2] == "def" and xs.Len() == 3
    f := Array<Array<Char>>(3, "ab")
    f[0][0] = 'X'
    assert f[0] == "Xb" and f[1] == "ab"
}

test "a whole copy is its own" {
    p := person($"bob", 3)
    q := p
    q.name[0] = 'B'
    assert p.name == "bob" and q.name == "Bob"
    tm := team($"t")
    tm.members.Push($"m1")
    tm.tags[0] = $"z"
    assert tm.members.Len() == 1 and tm.members[0] == "m1" and tm.title == "t" and tm.tags[0] == "z"
    assert Baked.name == "Bob" and person.renamed() == Baked
}

type node struct(v I64) { v }

fn churn() I64 {
    n I64 = 0
    for i in range 100 {
        s := $"xyzw" + $i
        n += s.Len()
    }
    return n
}

test "a comprehension's elements are its own" {
    ws := Array<Array<Char>>["ab", "c", "def"]
    up := Array<String>[$w + "!" for w in ws]
    same := Array<Array<Char>>[w for w in ws]
    some := Array<Array<Char>>[w for w in ws if w.Len() > 1]
    ns := Array<node>[node(i) for i in range 3]
    ws[0][0] = 'X'
    assert churn() > 0
    assert up[0] == "ab!" and up[2] == "def!" and same[0] == "ab" and same[1] == "c" and some[1] == "def" and some[0] == "ab"
    assert ns[2].v == 2 and ws[0] == "Xb"
}

# a by-value parameter is its callee's own copy, its parts too
fn shout(p person) Array<Char> {
    p.name[0] = 'X'
    return p.name
}

test "a by-value parameter owns its parts" {
    p := person($"amy", 9)
    assert shout(p) == "Xmy" and p.name == "amy"
}

# ... given an element read out of a collection - a view call's value - it is still its own: written, the element is not
fn whisper(p person) I64 {
    p.name[0] = 'Y'
    return p.name.Len() if p.name[0] == 'Y' else 0
}

test "a by-value parameter given an element owns its parts" {
    ps Vec<person>
    ps.Push(person($"amy", 9))
    assert whisper(ps[0]) == 3 and ps[0].name == "amy"
    assert shout(ps[0]) == "Xmy" and ps[0].name == "amy"
}

test "a store into an element's part read through At is its own copy" {
    ts Vec<team>
    ts.Push(team("a"))
    w := team("b")
    w.members.Push("x")
    ts[0].members = w.members
    w.members[0] = "y"
    assert ts[0].members[0] == "x" and w.members[0] == "y"
}

# a part stored through a "&" parameter is built where its container is - so a caller must say exactly where that is,
# even through a local found by a lookup (the store needs the scope exact, as a reference field's does: O25g)
type opt struct(name String) {
    name
    t String = ""
}

type opts struct() {
    all Vec<mut opt&> = Vec<mut opt&>()
}

fn (s opts&) byName(name String&) mut opt& ? NotFound {
    for f in s.all {
        if f.name == name: return f
    }
    error NotFound
}

fn (s opts&) setValue(f mut opt&, value String&) {
    f.t = $value
}

fn (s opts&) parse(arg String&) {
    f mut opt?& = null
    f ~ try s.byName(arg[:3]) catch NotFound { return }
    fl :~ f
    s.setValue(fl, arg[4:])
}

test "a part stored through a parameter outlives the call" {
    s := opts()
    s.all.Push(opt($"out"))
    s.parse($"out=x.txt")
    assert churn() > 0
    assert s.all[0].t == "x.txt"
}

test "a clone of an array is its own, its elements' parts too" {
    a := Array<I64>[1, 2, 3]
    b := a.Copy()
    b[0] = 9
    ws := Array<Array<Char>>["ab", "c"]
    vs := ws.Copy()
    vs[0][0] = 'X'
    assert a[0] == 1 and b[0] == 9 and ws[0] == "ab" and vs[0] == "Xb"
}

# Handles as values (QCE, 2026-11-01): a for-in over a reference parameter's Vec of values owning storage reads each
# element where it is while nothing in the loop's body can write storage of the element's types (D9h); where the body
# can - pushing into the same Vec through another name, writing an element in place - each element is the walk's own
# copy, as written. The same baked while compiling (VecWalksBaked, K2) and at run time
type vwCell struct() {
    xs Vec<I64> = Vec<I64>()
    n I64 = 0
}
fn vwOther(o mut Vec<String&>&, k I64) { o.Push("x" if k > 0 else "") }
fn vwSum(cs Vec<vwCell>&, o mut Vec<String&>&) I64 {
    t I64 = 0
    for c in cs {
        vwOther(o, c.xs.Len())          # writes a Vec<String&>'s storage - no vwCell's, nothing it holds
        t += c.xs.Len() * 10 + c.n
    }
    return t
}
fn vwGrowing(cs Vec<vwCell>&, w mut Vec<vwCell>&) I64 {
    t I64 = 0
    for c in cs {
        w.RefMut(0).xs.Push(1)           # the same Vec's first element, through another name
        w[0].n += 100                    # in place (E31b)
        t += c.xs.Len() * 1000 + c.n
    }
    return t
}
fn vecWalks(k I64) I64 {
    cs := Vec<vwCell>()
    for i in range 3 {
        c := vwCell()
        for j in range i + k: c.xs.Push(j)
        c.n = i
        cs.Push(c)
    }
    o := Vec<String&>()
    a := vwSum(cs, o)
    b := vwGrowing(cs, cs)
    return a * 1000000 + b * 10 + o.Len()
}
VecWalksBaked := vecWalks(1)
VwOne mut I64 = 1
test "a walk of a Vec reads elements in place only where nothing can write them" {
    assert churn() > 0
    assert vecWalks(VwOne) == VecWalksBaked and VecWalksBaked == 63060033, $VecWalksBaked
}

# a walk's name of an element and a match binding of a payload are copies of their own where they own storage (S9a,
# S13b): growing them changes neither the element nor the payload
type gcBox enum {
    Some(v Vec<String>)
    None
}
fn gcTexts(k I64) Vec<String> {
    v Vec<String>
    for j in range 6 + k: v.Push($"s" + $j)
    return v
}
fn grownCopies(k I64) String {
    rows := Array<Vec<String>>(2, Vec<String>())
    for i in range 2: rows[i] = gcTexts(k + i)
    t I64 = 0
    for row in rows {
        for _ in range 20: row.Push("x")
        t += row.Len()
    }
    b := gcBox.Some(gcTexts(k))
    match b {
        case gcBox.Some(x) {
            for _ in range 20: x.Push("y")
            t += x.Len()
        }
        case _ { }
    }
    assert churn() > 0
    got := $t + " " + rows[1][3] + $rows[1].Len()
    match b {
        case gcBox.Some(x): got = got + " " + x[3] + $x.Len()
        case _ { }
    }
    return got
}
GrownCopiesBaked := grownCopies(1)
test "a walk's name and a match binding grown leave the element and the payload as they were" {
    got := grownCopies(VwOne)
    assert got == GrownCopiesBaked and got == "82 s38 s37", got
}

# a value built in a loop's turn and stored into a part of x[i] (E31b's write-back, in place through RefMut) is built
# where the collection's parts live, not in the turn: text, a call's text, a conditional's, an element of an element,
# a field of a field, through a collection's At and SetAt
type wbQ struct(n String) { n }

type wbR struct(q wbQ) { q }

type wbS struct(s String) { s }

type wbBag struct() {
    v Vec<wbQ> = Vec<wbQ>()
}

fn (b wbBag&) At(i I64) wbQ { return b.v[i] }
fn (b mut wbBag&) SetAt(i I64, x wbQ) { b.v[i] = x }

fn wbText(i I64) String { return $"f" + $i }

fn elemTexts(k I64) String {
    v Vec<wbQ>
    rs Vec<wbR>
    vv Vec<Vec<wbQ>>
    ts Vec<Array<wbS>>
    b wbBag
    for _ in range 4 {
        v.Push(wbQ($""))
        rs.Push(wbR(wbQ($"")))
        ts.Push(Array<wbS>[wbS($""), wbS($"")])
        b.v.Push(wbQ($""))
    }
    for _ in range 2: vv.Push(Vec<wbQ>[wbQ($""), wbQ($"")])
    for i in range 20 {
        v[i % 4].n = $"m" + $(i * k)
        rs[i % 4].q.n = wbText(i)
        vv[i % 2][(i / 2) % 2].n = $"e" + $i
        ts[i % 4][1].s = "c" + $i if i > 10 else "d"
        b[i % 4].n = $"b" + $i
    }
    out := ""
    for i in range 4: out = out + v[i].n + rs[i].q.n + ts[i][1].s + b.v[i].n + vv[i / 2][i % 2].n + " "
    return out
}

ElemTextsBaked := elemTexts(1)
EtOne mut I64 = 1

test "a value stored into a part of x[i] in a loop lives where the collection does" {
    got := elemTexts(EtOne)
    assert churn() > 0
    assert got == ElemTextsBaked and got == "m16f16c16b16e16 m17f17c17b17e18 m18f18c18b18e17 m19f19c19b19e19 ", got
}

# a struct of two texts pushed with a joined text built in the call (oagent e55): the copy into the element splits the
# value (free.PartSplit) - the joined text into the element's part region, the other text into its parent's scope - and
# the part region is settled by the joined text alone, never by the other text, which has no region word before it
type pjItem struct(name String, tag String) {
    name, tag
}

fn pjFill(v mut Vec<pjItem>&, s String) {
    for i in range 3: v.Push(pjItem("item " + s + $i, "k"))
}

fn pushJoined(k I64) String {
    s := "s" + $k
    v := Vec<pjItem>()
    v.Push(pjItem("a " + s, "k"))
    v.Push(pjItem("b " + s, s))
    pjFill(v, s)
    out := ""
    for x in v: out = out + x.name + "/" + x.tag + " "
    return out
}

PushJoinedBaked := pushJoined(1)

test "a struct of texts pushed with a joined text built in the call" {
    got := pushJoined(EtOne)
    assert churn() > 0
    assert got == PushJoinedBaked and got == "a s1/k b s1/s1 item s10/k item s11/k item s12/k ", got
}

# a fill whose item holds a reference to storage the item makes - `Array<fiRef>(2, fiRef(Vec<I64>(), $"x" + $i))` - holds
# that storage in each element's copy (the copy is shallow at references): the item's storage is built where the fill
# goes, not where the statement stands (review8: valMake built it in the loop's turn, then a function's, and the
# elements read freed text)
type fiRef struct(v Vec<I64>, t String&) {
    v, t
}

fn fiMake(k I64) Array<fiRef> { return Array<fiRef>(3, fiRef(Vec<I64>(), $"y" + $k)) }

fn fillRefs(k I64) String {
    a := Array<fiRef>(2, fiRef(Vec<I64>(), "init"))
    for i in range k + 3: a = Array<fiRef>(2, fiRef(Vec<I64>(), $"x" + $i))
    assert churn() > 0
    b := fiMake(k)
    assert churn() > 0
    a[0].v.Push(7)
    return a[0].t + "/" + a[1].t + "/" + b[2].t + "/" + $a[0].v[0]
}

FillRefsBaked := fillRefs(1)

test "a fill whose item holds a reference to text it makes keeps that text where the fill goes" {
    got := fillRefs(EtOne)
    assert churn() > 0
    assert got == FillRefsBaked and got == "x3/x3/y1/7", got
}
