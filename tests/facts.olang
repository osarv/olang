# G42: a function's facts read while compiling - through its name, an instance's, a descriptor's in a walk of a
# module's functions - pinned by top-level asserts (S17a, decided by the evaluator) and read by the program itself; and
# the declared facts of G41 (NoReturn, Exported, Extern, Commutes)
import "std/io"
import "std/os"
import me "facts"

Count mut I64 = 0

fn Scale(out mut Array<F64>&, a Array<F64>&, k F64) {
    for i in range a.Len(): out[i] = a[i] * k
}

fn Bump() { Count++ }

Seen mut Vec<I64> = Vec<I64>()

# a store into a global made by a method it is lent to (bulk review 6 F1: it went unsaid)
fn Note(x I64) { Seen.Push(x) }

fn Fact(n I64) I64 { return 1 if n < 2 else n * Fact(n - 1) }

fn Shout(t String&) ? io.Error { try io.PutLine(t) }

fn Label(n I64) String { return $"#" $n }

fn Settle(x I64) I64 {
    v := x
    for v > 1: v = v / 2
    return v
}

fn Gather(n I64) I64 {
    total I64 = 0
    join {
        for i in range n { spawn Fact(i) }
    }
    return total
}

fn Leave() noreturn { os.Exit(3) }

fn Twice(f fn&(x I64) I64, x I64) I64 { return f(f(x)) }

fn first<T>(a T, b T) T { return a }

type Vec2 struct(X F64, Y F64) { X, Y }

fn (v Vec2) Mul(k F64) Vec2 commutes { return Vec2(v.X * k, v.Y * k) }

fn (v Vec2) Len2() F64 { return v.X * v.X + v.Y * v.Y }

# through the name
assert not Scale.Allocates, "Scale allocates nothing"
assert Scale.Terminates and not Scale.Blocks and not Scale.CallsC and not Scale.Recursive
assert Bump.WritesGlobals and not Scale.WritesGlobals
assert Note.WritesGlobals, "Seen.Push writes the global Seen"
assert Fact.Recursive and not Fact.Terminates
assert Shout.CallsC and Shout.Blocks and not Shout.Terminates
assert Label.Allocates and Label.Terminates
assert not Settle.Terminates, "a loop on a condition is never bounded"
assert Gather.Spawns and Gather.Blocks
assert Twice.Allocates and Twice.Blocks and not Twice.Terminates, "a call through a function value is anything"
assert not first<I64>.Allocates and first<I64>.Terminates
# through function values (section 4.5 of docs/fnvalues.md): a call through a parameter is what its type promises, read
# through the name; a call of a body calling through one is what that call gives it
fn Apply(f fn&(x I64) I64 noalloc, x I64) I64 { return f(x) }

fn Sum(xs Array<I64>&) I64 {
    t I64 = 0
    for x in xs: t += x
    return t
}

fn inc(x I64) I64 { return x + 1 }

fn Use(x I64) I64 { return Twice(inc, x) }

fn Settled(f fn&(x I64) I64 returns pure, x I64) I64 { return f(x) }

fn Chosen(up Bool) I64 {
    g := inc if up else Use
    return Apply(fn(x I64) I64: return g(x), 1)
}

assert not Apply.Allocates and Apply.Blocks and not Apply.Pure, "f promises noalloc, and nothing else"
assert Sum.Pure and Sum.Returns and Scale.Pure
assert not Use.Allocates and Use.Pure and Use.Returns, "Twice given inc does what inc does"
assert Settled.Returns and Settled.Pure and not Settled.Recursive
assert not Twice.Pure and not Twice.Returns and not Bump.Pure and not Note.Pure
assert not Leave.Returns and not Fact.Returns and not Shout.Pure
assert Chosen.Returns and not Chosen.Blocks and Chosen.Allocates, "Apply given a lambda calling what g may be (its environment allocated)"
# how it is declared
assert Leave.NoReturn and not Scale.NoReturn
assert not Scale.Exported and not Scale.Extern

# through descriptors: each copy of the walk its own function's
fn terminating() I64 {
    n I64 = 0
    for f in me.Functions {
        if f.Terminates { n++ }
    }
    return n
}

fn commuting() I64 {
    n I64 = 0
    for m in Vec2.Methods {
        if m.Commutes { n++ }
    }
    return n
}

Terminating := terminating()

assert Terminating == 10, "Scale, Bump, Label, terminating, commuting, Sum, inc, Use, Settled, Chosen"
assert commuting() == 1

test "facts are constants the running program reads too" {
    assert terminating() == 10 and Terminating == 10
    assert commuting() == 1
    assert Scale.Terminates and not Settle.Terminates
    out := Array<F64>(2)
    Scale(out, Array<F64>[1.0, 2.0], 2.0)
    assert out[1] == 4.0 and Fact(5) == 120 and Settle(9) == 1 and Label(3) == "#3"
    Bump()
    Note(7)
    assert Seen.Len() == 1 and Seen[0] == 7
    assert Count == 1 and Gather(3) == 0 and Twice(fn(x I64) I64: return x + 1, 1) == 3 and first(1, 2) == 1
    assert (Vec2(1.0, 2.0) * 2.0).Len2() == 20.0 and (2.0 * Vec2(1.0, 0.0)).X == 2.0
}

test "facts through function values: what is called through a parameter is what each call gives it" {
    assert Apply(inc, 1) == 2 and Sum(Array<I64>[1, 2, 3]) == 6 and Use(1) == 3 and Settled(inc, 2) == 3
    assert Chosen(true) == 2 and Chosen(false) == 3
    assert Apply.Blocks and not Use.Allocates and Sum.Pure
}
