# A for loop's name is the element's value (S9a, S9g): over an array reached writably (a ViewMut, a mut parameter)
# too, a struct element or a row is a copy and the slot is written by the index form, a[i] or a[i].f; a write to the
# name that nothing reads after it is refused (checks/cases/lostloopwrite*.olang)

type P struct(x I64, name String) {
    x
    name
}

# storage made and dropped, so a reference to reclaimed storage would read it overwritten
fn churn() I64 {
    n I64 = 0
    for i in range 100 {
        s := $"xyzw" + $i
        n += s.Len()
    }
    return n
}

fn people() Vec<P> {
    ps := Vec<P>[]
    ps.Push(P(1, $"a"))
    ps.Push(P(2, $"b"))
    return ps
}

test "a ViewMut walk's index form writes each struct element, reaching the Vec" {
    ps := people()
    w := ps.ViewMut()
    for i, p in w {
        n := churn()
        w[i].x = p.x * 10 + n
        w[i].name = $p.name + "!" + $n
    }
    m := churn()
    assert ps[0].x == 10 + m and ps[1].x == 20 + m
    assert ps[0].name == $"a!" + $m and ps[1].name == $"b!" + $m
}

fn bump(w mut Array<P>&, by I64) {
    for i in range w.Len(): w[i].x += by
}

test "a mut parameter's elements written by index" {
    a := Array<P>[P(1, $"a"), P(2, $"b")]
    bump(a, 5)
    assert a[0].x == 6 and a[1].x == 7
}

test "a walk of an array value names copies" {
    a := Array<P>[P(1, $"a")]
    for p in a {
        p.x = 9
        assert p.x == 9
    }
    assert a[0].x == 1
}

test "numbers are values: the index form writes them" {
    v := Vec<I64>[1, 2, 3]
    w := v.ViewMut()
    for i, x in w: w[i] = x * 10
    assert v[0] == 10 and v[2] == 30
    total I64 = 0
    for x in v.ViewMut() {
        x += 1          # read after: legal, the copy changed
        total += x
    }
    assert total == 63 and v[0] == 10
}

type Row struct(cells Array<I64>) {
    cells
}

test "a struct holding an array is written by index" {
    rs := Vec<Row>[]
    rs.Push(Row([1, 2]))
    rs.Push(Row([3, 4]))
    w := rs.ViewMut()
    for i, r in w: w[i].cells[0] = r.cells[1] * 2
    assert churn() > 0
    assert rs[0].cells[0] == 4 and rs[1].cells[0] == 8 and rs[1].cells[1] == 4
}

test "assigning the copy read later is kept" {
    a := Array<P>[P(1, $"a"), P(2, $"b")]
    other := P(7, $"o")
    seen I64 = 0
    w mut Array<P>& = a
    for p in w {
        if p.x == 2: p = other
        seen += p.x
    }
    assert seen == 8 and a[1].x == 2 and other.x == 7
}

fn walked() I64 {
    a := Array<P>[P(1, "a"), P(2, "b")]
    bump(a, 3)
    w mut Array<P>& = a
    for i, p in w: w[i].x = p.x * 2
    return a[0].x * 100 + a[1].x
}

# decided while compiling (S18c): the evaluator names the elements as the build does
assert walked() == 810
Walked I64 = walked()

test "the baked global agrees" {
    assert Walked == 810 and walked() == 810
}

# rows (T7c): over an array of arrays reached writably, x is a copy of the row; the index form writes it in place
fn zeroFirst(rows mut Array<Array<I64>>&) {
    for i in range rows.Len(): rows[i][0] = 0
}

test "the index form over a writable walk of rows in place writes them" {
    m := [[1, 2], [3, 4], [5, 6]]
    rows mut Array<Array<I64>>& = m
    for i, r in rows: rows[i][0] = r[1] * 10 + churn()
    n := churn()
    assert m[0][0] == 20 + n and m[1][0] == 40 + n and m[2][0] == 60 + n and m[2][1] == 6
    tail := rows[1:]
    for i in range tail.Len(): tail[i][1] = -1
    assert m[0][1] == 2 and m[1][1] == -1 and m[2][1] == -1
    zeroFirst(m)
    assert churn() > 0
    assert m[0][0] == 0 and m[2][0] == 0 and m[1].Len() == 2
}

test "a ViewMut walk's index form writes a Vec's rows" {
    v := Vec<Array<I64>>[]
    v.Push([1, 2, 3])
    v.Push([4, 5])
    w := v.ViewMut()
    for i in range w.Len() {
        n := churn()
        w[i][1] = 7 + n
    }
    m := churn()
    assert v[0][1] == 7 + m and v[1][1] == 7 + m and v[0][2] == 3 and v[1].Len() == 2
}

test "rows walked read-only are copies" {
    m := [[1, 2], [3, 4]]
    total I64 = 0
    for r in m {
        r[0] = 9
        total += r[0] + r[1]
    }
    assert total == 24 and m[0][0] == 1 and m[1][0] == 3
}

fn rowsWalked() I64 {
    m := [[1, 2], [3, 4]]
    rows mut Array<Array<I64>>& = m
    for i, r in rows: rows[i][1] = r[1] * 5
    zeroFirst(m)
    return m[0][1] * 100 + m[1][1] + m[0][0] + m[1][0]
}

assert rowsWalked() == 1020
RowsWalked I64 = rowsWalked()

test "the baked rows global agrees" {
    assert RowsWalked == 1020 and rowsWalked() == 1020
}
