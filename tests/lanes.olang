# lane-by-lane array operators (E39): an array's operators work element by element - array with array, array with a
# value every lane shares - and a whole expression of them, with the total or the lane method taking it, is one loop
# and no array between. Fixed lengths give fixed arrays (T7c); run-time ones a new array where the expression lands,
# their lengths checked once per operation. What the evaluator bakes and decides agrees with the run time

type Vec3 extends Array<F64>

fn count(n I64) Array<I32> {
    a := Array<I32>(n)
    for i in range n { a[i] = I32(i) }
    return a
}

fn floats(n I64, step F64) Array<F64> {
    a := Array<F64>(n)
    for i in range n { a[i] = F64(i) * step }
    return a
}

fn dot(a Array<F64>&, b Array<F64>&) F64 { return (a * b).Sum() }

fn axpy(k F32, x Array<F32>&, y mut Array<F32>&) { y += x * k }

fn lesser(a Array<F64>&, b Array<F64>&) Array<F64> { return a.LanesLess(b).Select(a, b) }

fn all(n I64) Bool {
    a := floats(n, 1.0) # 0 1 2 3 ...
    b := floats(n, 0.5) # 0 0.5 1 1.5 ...
    i := count(n)
    sums Bool = $(a + b) == "F64[0, 1.5, 3, 4.5]" and $(a - b * 2.0) == "F64[0, 0, 0, 0]" and $(2.0 * a + 1.0) == "F64[1, 3, 5, 7]"
    ints Bool = $(i % 2) == "I32[0, 1, 0, 1]" and $(i << 1) == "I32[0, 2, 4, 6]" and $(~i) == "I32[-1, -2, -3, -4]" and
        $(i * 2 + i) == "I32[0, 3, 6, 9]" and $(i & 1 | 4) == "I32[4, 5, 4, 5]" and $(i ^ 3) == "I32[3, 2, 1, 0]"
    neg Bool = $(-a) == "F64[-0, -1, -2, -3]" and $(-i) == "I32[0, -1, -2, -3]"
    # numbers meet as they do in one operation (T6b): an I32 lane and an I64 one give I64 lanes
    meet Bool = $(i * I64(3)) == "I64[0, 3, 6, 9]" and $(a * F32(2.0)) == "F64[0, 2, 4, 6]"
    totals Bool = dot(a, b) == 7.0 and (a * b).Sum() == 7.0 and i.Sum() == 6 and (i * i).Sum() == 14 and
        (try i.Max() catch default -1) == 3 and (try (i - 2).Min() catch default 9) == -2 and
        (try count(0).Max() catch default -1) == -1 and count(0).Sum() == 0
    masks Bool = $a.LanesLess(b * 3.0) == "Bool[false, true, true, true]" and $i.LanesEqual(i * 0 + 2) == "Bool[false, false, true, false]" and
        $(not a.LanesLess(b)) == "Bool[true, true, true, true]" and a.LanesLess(b * 3.0).Some() and not a.LanesLess(b * 3.0).Every() and
        $(a.LanesLess(b * 3.0) and i.LanesLess(i * 0 + 3)) == "Bool[false, true, true, false]" and
        $(a.LanesLess(b * 3.0) or i.LanesEqual(i * 0)) == "Bool[true, true, true, true]" and
        $(a.LanesLess(b * 3.0) xor i.LanesEqual(i * 0 + 1)) == "Bool[false, false, true, true]"
    sel Bool = $lesser(a, b * 3.0) == "F64[0, 1, 2, 3]" and $lesser(b * 3.0, a) == "F64[0, 1, 2, 3]" and
        $a.LanesLess(b * 3.0).Select(a, 0.0) == "F64[0, 1, 2, 3]" and $i.LanesEqual(i * 0 + 1).Select(i, -1) == "I32[-1, 1, -1, -1]"
    fixed Bool = $(F64[1.0, 2.0] + F64[3.0, 4.0]) == "F64[4, 6]" and (F64[1.0, 2.0] * F64[3.0, 4.0]).Sum() == 11.0
    wrap Bool = U8[200, 100].Sum() == 44 and $(U8[250, 5] + U8[10, 1]) == "U8[4, 6]"
    v := Vec3(F64[1.0, 2.0])
    w Vec3 = v + v * 2.0 # an extending type's operands give it again (T29e)
    kept Bool = $w == "F64[3, 6]" and w.Sum() == 9.0
    c := C64[C64(1.0, 2.0), C64(3.0, 4.0)]
    complex Bool = $(c * c) == "C64[C64(-3, 4), C64(-7, 24)]" and (c * c).Sum() == C64(-10.0, 28.0) and $(c + C64(1.0, 0.0)) == "C64[C64(2, 2), C64(4, 4)]"
    y := Array<F32>(n, 1.0)
    axpy(2.0, Array<F32>(n, 0.5), y)
    y += y
    inplace Bool = $y == "F32[4, 4, 4, 4]"
    t := 0.0
    for e in a * 2.0 { t += e }
    walked Bool = t == 12.0 and (a + 1.0).Len() == 4 and (a * b)[3] == 4.5
    return sums and ints and neg and meet and totals and masks and sel and fixed and wrap and kept and complex and inplace and
        walked
}

AllBaked := all(4)
DotBaked := (F64[1.0, 2.0, 3.0] * F64[4.0, 5.0, 6.0]).Sum()
MaxBaked := try (I64[3, 9, 2] * 2).Max() catch default -1
LanesBaked := F64[1.0, 2.0] * 3.0 + 1.0

Four mut I64 = 4 # read at run time, so all() runs as the program as well as in the evaluator

test "E39: lane operators - built, fused, totalled, compared and chosen - baked, decided while compiling and run" {
    assert all(Four)
    assert all(4) # S18c: decided while compiling
    assert AllBaked and DotBaked == 32.0 and MaxBaked == 18 and $LanesBaked == "F64[4, 7]"
}

test "E39: a fused total makes no array, and an empty one" {
    a := floats(Four, 1.0)
    assert (a * a - a).Sum() == 8.0
    assert (try floats(0, 1.0).Min() catch default -1.0) == -1.0
    assert floats(0, 1.0).Sum() == 0.0
    e := floats(0, 1.0)
    assert not e.LanesLess(e).Some() and e.LanesLess(e).Every()
}

test "E39: Min and Max by '<', a float's NaN the answer once met, ties the first" {
    nan := F64.NaN
    a := F64[2.0, nan, 1.0]
    assert (try a.Min() catch default 9.0).IsNan() and (try a.Max() catch default 9.0).IsNan()
    b := F64[nan, 1.0]
    assert (try b.Min() catch default 9.0).IsNan() and (try F64[1.0, 3.0].Max() catch default 9.0) == 3.0
    assert (try F64[0.0, -0.0].Min() catch default 9.0).Bits() == F64(0.0).Bits()
}

fn churn() I64 {
    t I64 = 0
    for i in range 1000 {
        x := Array<I64>(64, i)
        t += x[3]
    }
    return t
}

fn made(n I64) Array<F64> {
    a := floats(n, 1.0)
    return a * a + 1.0
}

test "E39: lanes made in a function and returned are read back after an arena churn" {
    m := made(Four)
    assert churn() > 0
    assert $m == "F64[1, 2, 5, 10]"
}

# E39 through x[i] (E31b): "x[i].a op= v" on an inline array of the element reads it, stores lane by lane into the
# copy and writes it back with SetAt - the operand's lanes evaluated before the read, so one reading the element itself
# reads it as it was; through a reference read out of x[i] the store goes where the reference points, nothing written
# back (the second bulk review's F3: these were dropped)
type Holds struct() {
    arr := Array<I64>(3)
    xs mut Array<I64>& = Array<I64>(3, 1)
}

# the operand's own effect on the element comes before the element is read, so it is kept
fn give(v mut Vec<Holds>&) Array<I64> {
    v[0].arr[0] = 100
    return Array<I64>(3, 1)
}

fn throughAt(n I64) String {
    v := Vec<Holds>()
    v.Push(Holds())
    v[0].arr[2] += 5
    v[0].arr += n
    v[0].arr += v[0].arr
    v[0].arr += give(v)
    v[0].xs += 7
    w := Vec<mut Array<I64>&>()
    w.Push(Array<I64>(3))
    w[0] += 2
    w[0] *= w[0] + n
    return $v[0].arr " " $v[0].xs " " $w[0]
}

# in place, each lane is computed and stored before the next is read, as the loop written by hand: an operand
# overlapping the target reads the lanes already stored (E39) - a running sum here
fn overlap(n I64) String {
    a := Array<I64>(n, 1)
    s := a[1:n]
    s += a[0:n - 1]
    assert s.Len() == n - 1
    return $a
}

ThroughAtBaked := throughAt(5)
OverlapBaked := overlap(5)
WantThroughAt := "I64[101, 11, 21] I64[8, 8, 8] I64[14, 14, 14]"
WantOverlap := "I64[1, 2, 3, 4, 5]"
Five mut I64 = 5

test "E39, E31b: an in-place lane store through x[i] is written back, or goes where a reference read out of it points" {
    assert ThroughAtBaked == WantThroughAt
    assert throughAt(Five) == WantThroughAt
    assert throughAt(5) == WantThroughAt # S18c: decided while compiling
}

test "E39: an in-place operand overlapping its target reads the lanes already stored" {
    assert OverlapBaked == WantOverlap
    assert overlap(Five) == WantOverlap
    assert overlap(5) == WantOverlap # S18c: decided while compiling
}

# Min and Max build each lane once: an operator method lanes call runs once a lane (the second bulk review's F7)
PlusCalls mut I64 = 0
type Counted struct(v I64) { v }
fn (a Counted) Plus(b Counted) Counted {
    PlusCalls++
    return Counted(a.v + b.v)
}
fn (a Counted) Less(b Counted) Bool { return a.v < b.v }

test "E39: Max runs the operation once a lane" {
    a := Array<Counted>(Four, Counted(1))
    PlusCalls = 0
    m := try (a + a).Max() catch default Counted(-1)
    assert m.v == 2 and PlusCalls == 4
    PlusCalls = 0
    n := try (a + a).Min() catch default Counted(-1)
    assert n.v == 2 and PlusCalls == 4
}
