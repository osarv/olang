# T32-T34: run-time trait values - "any Trait&", a reference to an instance of any type satisfying the trait and a
# table of the functions its type meets the trait with. Every test reads what it holds back after the arena has been
# churned, so a value built in the wrong scope would read someone else's bytes; the module's globals are computed
# through tables while compiling (K2) and compared with the same computation at run time.

import sh "shared"

type Named trait {
    Name() String
}

type Cat struct(n String&) {
    n
}
fn (c Cat&) Name() String { return "cat " $c.n }

type Lev enum {
    Low
    High
}
fn (l Lev) Name() String { return "low" if l == Lev.Low else "high" }

type Count extends I64
fn (c Count) Name() String { return "count " $I64(c) }

type Label extends String
fn (l Label&) Name() String { return "label " $String(l) }

# the arena worked hard enough that a dangling reference reads what came after it
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        c := Cat("junk " $i)
        t += c.n.Len()
    }
    return t
}

fn names(xs List<any Named&>&) String {
    b := StringBuilder()
    for x in xs {
        if b.Len() > 0 { b.Push(", ") }
        b.Push(x.Name())
    }
    return b.ToString()
}

fn kept() List<any Named&> {
    xs := List<any Named&>()
    for i in range 3 { xs.Push(Cat("c" $i)) }
    xs.Push(Count(7))
    xs.Push(Lev.Low)
    return xs
}

test "T32a: an any holds a struct borrowed, temporaries built where it lands, numbers, enums and text copied" {
    xs := List<any Named&>()
    c := Cat("tom")
    xs.Push(c)
    xs.Push(Cat("kit"))
    xs.Push(Lev.High)
    n := Count(5)
    xs.Push(n)
    lab := Label("hi")
    xs.Push(lab)
    n = Count(9)
    lab = Label("no")
    c.n = "tim"
    assert churn() > 0
    assert names(xs) == "cat tim, cat kit, high, count 5, label hi"
    k := kept()
    assert churn() > 0
    assert names(k) == "cat c0, cat c1, cat c2, count 7, low"
}

# T32: the instance borrowed is the very instance - its changes seen, a mut method writing it
type Counter trait {
    mut Bump() I64
    Seen() I64
}
type Tally struct(at I64) {
    at
}
fn (t mut Tally&) Bump() I64 {
    t.at += 1
    return t.at
}
fn (t Tally&) Seen() I64 { return t.at }

fn bumpAll(xs mut List<mut any Counter&>&) I64 {
    s I64 = 0
    for x in xs { s += x.Bump() }
    return s
}

test "T32b: a mut method through a mut any writes the instance itself" {
    a := Tally(1)
    b := Tally(10)
    xs := List<mut any Counter&>()
    xs.Push(a)
    xs.Push(b)
    xs.Push(Tally(100))
    assert bumpAll(xs) == 2 + 11 + 101
    assert a.at == 2 and b.at == 11
    assert churn() > 0
    assert xs[2].Seen() == 101
    r any Counter& = a
    assert r.Seen() == 2
}

# T32b, T32c: another module's trait, its default dispatched, a by-value receiver and a type over a number in one list;
# generic code taking the any as its type argument
fn areas(xs Array<any sh.Shape&>&) I32 {
    t I32 = 0
    for x in xs { t += x.Area() }
    return t
}
fn describeAll<S sh.Shape>(xs List<S>&) I32 {
    t I32 = 0
    for x in xs { t += x.Describe() }
    return t
}

test "T32c: an any of another module's trait, its default through the table, generic code over it" {
    q := sh.Square(3)
    xs := List<any sh.Shape&>()
    xs.Push(q)
    xs.Push(sh.Tri(4, 3))
    xs.Push(sh.Dot(1))
    xs.Push(sh.Ring(5))
    assert churn() > 0
    a := xs.ToArray()
    assert areas(a) == 9 + 6 + 0 + 5
    assert xs[0].Describe() == 13 and xs[3].Describe() == 5
    assert describeAll(xs) == 13 + 9 + 1 + 5
    assert xs[0].Sides() == 4
}

# T33: identity, null, $
test "T33: == is the same instance; an any renders its instance" {
    c := Cat("tom")
    x any Named& = c
    y any Named& = c
    z any Named& = Cat("tom")
    assert x == y and x != z
    m any Named?& = null
    assert m is null
    m = c
    assert m == x
    assert $x == "Cat(\"tom\")"
    w any Named& = Lev.High
    assert $w == "Lev.High"
    v any Named& = Count(4)
    assert $v == "4"
    xs := List<any Named&>()
    xs.Push(Lev.Low)
    assert $xs == "List<any Named&>[Lev.Low]"
}

# T34: a closed trait's any matched by type, and "as"
type Widget trait for Button, Slider, Level {
    Draw() String
}
type Button struct(label String&) {
    label
}
fn (b Button&) Draw() String { return "[" $b.label "]" }
type Slider struct(at I64) {
    at
}
fn (s Slider&) Draw() String { return "<" $s.at ">" }
type Level extends I64
fn (l Level) Draw() String { return "L" $I64(l) }

fn kind(w any Widget&) String {
    match w {
        case Button b { return "button " $b.label }
        case Slider s if s.at > 50 { return "slider far" }
        case Slider s { return "slider " $s.at }
        case Level n { return "level " $I64(n) }
    }
}

fn slide(w mut any Widget&) {
    match w {
        case Slider s { s.at += 1 }
        case Button _, Level _ { }
    }
}

fn labelLen(w any Widget&) I64 {
    b := try w as Button catch CaseError.WRONG_CASE default Button("none")
    return b.label.Len()
}

test "T34: type cases bind the instance itself; as gives it, or fails under checked" {
    sl := Slider(3)
    ws := List<mut any Widget&>()
    ws.Push(Button("ok"))
    ws.Push(sl)
    ws.Push(Level(9))
    ws.Push(Slider(70))
    assert churn() > 0
    assert kind(ws[0]) == "button ok" and kind(ws[1]) == "slider 3"
    assert kind(ws[2]) == "level 9" and kind(ws[3]) == "slider far"
    slide(ws[1])
    assert sl.at == 4
    assert (ws[1] as Slider)!.at == 4
    assert (ws[2] as Level)! == Level(9)
    assert labelLen(ws[0]) == 2 and labelLen(ws[1]) == 4
    t := 0
    for w in ws { t += w.Draw().Len() }
    assert t == 4 + 3 + 2 + 4
}

# D17f: a trait's requirements held to every call through an any, before dispatch; the instance's own on its entry
type Account trait {
    mut Withdraw(n I64) [n > 0] I64
}
type Wallet struct(cash I64) {
    cash
}
fn (w mut Wallet&) Withdraw(n I64) [n <= 100] I64 {
    w.cash -= n
    return w.cash
}
fn draw(a mut any Account&, n I64) I64 { return try a.Withdraw(n) catch ArgumentError.INVALID default -1 }

test "D17f: a trait's contract and the instance's own, checked through an any" {
    w := Wallet(500)
    assert draw(w, 10) == 490
    assert draw(w, 0) == -1          # the trait's requirement
    assert draw(w, 200) == -1        # the wallet's own, on its entry
    assert w.cash == 490
    v := Wallet(50)
    assert draw(v, 60) == -10        # both hold: the call is made
    assert v.cash == -10
}

# T32b: iterators through an any - for-in, the trait's defaults, a generic one (Fold) instantiated for the any
fn sumIt(it mut any Iterator<I64>&) I64 {
    t I64 = 0
    for x in it { t += x }
    return t
}

test "T32b: an any Iterator walked by for-in and its defaults" {
    l := List<I64>()
    for i in range 5 { l.Push(i) }
    assert sumIt(l.Iter()) == 10
    a := I64[1, 2, 3]
    assert sumIt(a.Iter()) == 6
    it mut any Iterator<I64>& = a.Iter()
    assert it.Count(fn(x I64) Bool { return x > 1 }) == 2
    jt mut any Iterator<I64>& = l.Iter()
    assert jt.Fold(0, fn(s I64, x I64) I64 { return s + x }) == 10
}

# K1, K2: the evaluator calls through tables as the program does - globals baked from calls through anys, compared
# with the same calls made at run time on inputs it cannot know
fn mix(n I64) String {
    xs := List<any Named&>()
    xs.Push(Count(n))
    xs.Push(Lev.High if n > 2 else Lev.Low)
    xs.Push(Cat("n" $n))
    return names(xs)
}
fn widgets(n I64) I64 {
    ws := List<mut any Widget&>()
    ws.Push(Slider(n))
    ws.Push(Level(n))
    for w in ws { slide(w) }
    return (ws[0] as Slider)!.at + I64((ws[1] as Level)!)
}
BakedMix String = mix(3)
BakedWidgets I64 = widgets(5)
Live mut I64 = 3

test "K2: anys evaluated while compiling agree with the run time" {
    assert BakedMix == "count 3, high, cat n3"
    assert BakedMix == mix(Live)
    assert BakedWidgets == 11
    assert BakedWidgets == widgets(Live + 2)
    assert mix(1) == "count 1, low, cat n1"
}

# T32a (the any review, findings 1 and 2): an array is copied into the any's box - a local's text converted to a
# declared type over it (Lab(s), T29a) as much as a plain one - so writing through a mut any changes the box, never
# the local, and the box lives where the any goes; baked while compiling and run alike
type Bump trait {
    mut Bump()
}
type BLab extends String
fn (l mut BLab&) Bump() { l[0] = 'Z' }
type BNums extends Array<I64>
fn (n mut BNums&) Bump() { n[0] = 99 }

fn bumped(k I64) String {
    s := "hello"
    b mut any Bump& = BLab(s)
    b.Bump()
    a := I64[1, 2, k]
    c mut any Bump& = BNums(a)
    c.Bump()
    l := List<mut any Bump&>()
    l.Push(BLab(s))
    l.Push(BNums(a))
    for x in l { x.Bump() }
    return $s " " $a " " $b
}
BakedBumped String = bumped(3)

fn labels(n I64) String {
    xs := List<any Named&>()
    for i in range n {
        t := "lab" $i "-" $(i * 7)
        xs.Push(Label(t))
    }
    churn()
    return names(xs)
}
BakedLabels String = labels(2)

test "T32a: arrays and conversions of them are copied into the box" {
    assert BakedBumped == "hello I64[1, 2, 3] Zello"
    assert bumped(Live) == BakedBumped
    assert BakedLabels == "label lab0-0, label lab1-7"
    assert labels(Live - 1) == BakedLabels
}

# T32a (the second any review, finding 1): an array chosen by a conditional, a value match or a catch default is
# existing storage too, so the box copies it - a block's text put in an any that outlives the block reads back after
# the arena churns, and writing through a mut any changes the box, never the text it was made of
type ChOops error {
    BAD
}
fn chBad(k I64) String ? ChOops {
    if k < 100 { error ChOops.BAD }
    return "never"
}
fn chosen(n I64) String {
    xs := List<any Named&>()
    for i in range n {
        s := "s" $i
        u := "u" $i
        xs.Push(Label(s if s.Len() > 1 else u))
        xs.Push(Label(match s.Len() { case 0 => u case _ => s }))
        xs.Push(Label(try chBad(i) catch default s))
    }
    churn()
    return names(xs)
}
BakedChosen String = chosen(2)

fn chosenBump(k I64) String {
    s := "cond"
    u := "else"
    m := "match"
    d := "dflt"
    a mut any Bump& = BLab(s if k > 0 else u)
    a.Bump()
    b mut any Bump& = BLab(match k { case 0 => u case _ => m })
    b.Bump()
    c mut any Bump& = BLab(try chBad(k) catch default d)
    c.Bump()
    return $s " " $m " " $d " " $a " " $b " " $c
}
BakedChosenBump String = chosenBump(3)

test "T32a: a conditional, a match or a catch default put in an any is copied into its box" {
    want := "label s0, label s0, label s0, label s1, label s1, label s1"
    assert BakedChosen == want
    assert chosen(Live - 1) == want
    assert BakedChosenBump == "cond match dflt Zond Zatch Zflt"
    assert chosenBump(Live) == BakedChosenBump
}

# E11a, T33 (the any review, finding 3): an any is a reference to $, followed 8 deep and then "...", so a chain through
# any fields renders as one through plain references does, and a node whose any holds itself stops
type RNode struct(v I64) {
    v
    next any Named?& = null
}
fn (n RNode&) Name() String { return "node" }
type RPlain struct(v I64) {
    v
    next RPlain?& = null
}
fn chains(n I64) String {
    h := RNode(0)
    p := RPlain(0)
    for i in range 1, n {
        a mut RNode&h = RNode(i)
        a.next = h.next
        h.next = a
        q mut RPlain&p = RPlain(i)
        q.next = p.next
        p.next = q
    }
    self mut RNode& = RNode(7)
    self.next = self
    s any Named& = self
    return $h "|" $p "|" $s
}
BakedChains String = chains(12)

test "E11a: $ counts an any as a reference, 8 deep" {
    want := "RNode(0, RNode(11, RNode(10, RNode(9, RNode(8, RNode(7, RNode(6, RNode(5, RNode(4, ...)))))))))|" "RPlain(0, RPlain(11, RPlain(10, RPlain(9, RPlain(8, RPlain(7, RPlain(6, RPlain(5, RPlain(4, ...)))))))))|" "RNode(7, RNode(7, RNode(7, RNode(7, RNode(7, RNode(7, RNode(7, RNode(7, ...))))))))"
    assert BakedChains == want
    churn()
    assert chains(Live + 9) == want
}

# T32a (the any review, finding 4): a table's default slots are instantiated for the instance's type only where a call
# through an any of the trait reaches them, so an any Iterator of text or of structs exists though Sum's "T Number"
# and Min's "<" do not fit them
type Words struct(n I64) {
    n
    at I64 = 0
}
fn (w mut Words&) Next() String ? Exhausted {
    if w.at >= w.n { error Exhausted.END }
    w.at += 1
    return "w" $w.at
}
type WPt struct(x I64) { x }
type WPtIt struct(n I64) {
    n
    at I64 = 0
}
fn (w mut WPtIt&) Next() WPt ? Exhausted {
    if w.at >= w.n { error Exhausted.END }
    w.at += 1
    return WPt(w.at)
}
fn walked(n I64) String {
    b := StringBuilder()
    w := Words(n)
    it mut any Iterator<String>& = w
    for x in it { b.Push(x) }
    p := WPtIt(n)
    jt mut any Iterator<WPt>& = p
    b.Push($jt.Count(fn(q WPt) Bool { return q.x > 1 }))
    return b.ToString()
}
BakedWalked String = walked(3)

test "T32a: an any Iterator whose element type some defaults do not fit" {
    assert BakedWalked == "w1w2w32"
    churn()
    assert walked(Live) == BakedWalked
}

# T34 (the any review, finding 5): a closed trait listing instances of a generic type, matched by type cases naming
# them with their arguments
type GShape trait for GBox<I64>, GBox<String&>, GDot {
    Area() I64
}
type GBox<T> struct(v T, n I64) {
    v
    n
}
fn (b GBox<T>&) Area() I64 { return b.n }
type GDot struct(k I64) { k }
fn (d GDot&) Area() I64 { return d.k }
fn gkind(s any GShape&) String {
    match s {
        case GBox<I64> b { return "box " $(b.v + b.Area()) }
        case GBox<String&> t { return "text " $t.v }
        case GDot _ { return "dot" }
    }
}
fn gkinds(n I64) String {
    xs := List<any GShape&>()
    xs.Push(GBox<I64>(n, 2))
    xs.Push(GBox<String&>("t" $n, 3))
    xs.Push(GDot(4))
    churn()
    b := StringBuilder()
    for x in xs { b.Push($gkind(x) " ") }
    return b.ToString()
}
BakedGKinds String = gkinds(5)

test "T34: type cases naming a generic's instances" {
    assert BakedGKinds == "box 7 text t5 dot "
    assert gkinds(Live + 2) == BakedGKinds
}

# T32b, D8a (the any review, finding 6): an argument left off a call through an any takes the trait's default, which is
# all the call sees; a call of the type's own method, or generic code over it, takes the method's own
type Drawn trait {
    Draw(scale I64 = 2) I64
}
type DBtn struct(n I64) { n }
fn (b DBtn&) Draw(scale I64 = 5) I64 { return b.n * scale }
fn drawnGen<S Drawn>(s S) I64 { return s.Draw() }
fn drawn(n I64) String {
    b := DBtn(n)
    w any Drawn& = b
    return $w.Draw() " " $b.Draw() " " $drawnGen(b) " " $drawnGen(w) " " $w.Draw(3)
}
BakedDrawn String = drawn(10)

test "D8a: a trait's defaults through an any" {
    assert BakedDrawn == "20 50 50 20 30"
    assert drawn(Live + 7) == BakedDrawn
}

# E19, E11a (the any review, finding 6): an array of anys is written as $ renders it, "any Named&[...]", and reads back
fn listed(n I64) String {
    c := Cat("c" $n)
    xs := any Named&[c, Count(n), Lev.High]
    ys := any Named?&[null, c]
    return $xs " " $ys " " $xs.Len()
}
BakedListed String = listed(4)

test "E19: an array literal of anys, rendered as written" {
    assert BakedListed == "any Named&[Cat(\"c4\"), 4, Lev.High] any Named?&[null, Cat(\"c4\")] 3"
    churn()
    assert listed(Live + 1) == BakedListed
}

# M19, M21 (the any review, pre-existing): a method declared for one instance of a generic type belongs to that instance
# alone - another takes the trait's default, called directly, from generic code or through an any
type IShape trait {
    Area() I64
}
fn (s S) Describe<S IShape>() String { return "default " $s.Area() }
type IBox<T> struct(v T, n I64) {
    v
    n
}
fn (b IBox<T>&) Area() I64 { return b.n }
fn (b IBox<String&>&) Describe() String { return "text box " $b.v }
fn describeGen<S IShape>(s S) String { return s.Describe() }
fn described(n I64) String {
    a := IBox<I64>(5, n)
    t := IBox<String&>("t" $n, n)
    x any IShape& = a
    y any IShape& = t
    return $a.Describe() "|" $describeGen(a) "|" $x.Describe() "|" $t.Describe() "|" $describeGen(t) "|" $y.Describe()
}
BakedDescribed String = described(2)

test "M21: a method of one instance is not another's" {
    assert BakedDescribed == "default 2|default 2|default 2|text box t2|text box t2|text box t2"
    assert described(Live - 1) == BakedDescribed
}

# M21 (the second any review, finding 2): two instances of one generic type each declaring the method are each found
# for their own instance, and one declared for an instance exactly beats one written with a variable, whichever is
# declared first - directly, from generic code and through an any alike
type KBox<T> struct(v T, n I64) {
    v
    n
}
fn (b KBox<T>&) Area() I64 { return b.n }
fn (b KBox<String&>&) Describe() String { return "text box " $b.v }
fn (b KBox<I64>&) Describe() String { return "int box " $b.v }
type JBox<T> struct(v T, n I64) {
    v
    n
}
fn (b JBox<T>&) Area() I64 { return b.n }
fn (b JBox<I64>&) Describe() String { return "int jbox " $b.v }
fn (b JBox<T>&) Describe() String { return "jbox " $b.n }
fn twoInstances(n I64) String {
    a := KBox<I64>(5, n)
    t := KBox<String&>("t" $n, n)
    j := JBox<I64>(7, n)
    k := JBox<Bool>(true, n)
    xs := List<any IShape&>()
    xs.Push(a)
    xs.Push(t)
    xs.Push(j)
    xs.Push(k)
    b := StringBuilder()
    b.Push($a.Describe() "|" $t.Describe() "|" $describeGen(a) "|" $describeGen(t) "|" $j.Describe() "|" $k.Describe())
    for x in xs { b.Push("|" $x.Describe()) }
    return b.ToString()
}
BakedTwoInstances String = twoInstances(2)

test "M21: two instances' methods each found for their own instance, an exact receiver first" {
    want := "int box 5|text box t2|int box 5|text box t2|int jbox 7|jbox 2|int box 5|text box t2|int jbox 7|jbox 2"
    assert BakedTwoInstances == want
    churn()
    assert twoInstances(Live - 1) == want
}

# T32, G4, G8a (the second any review, finding 5): a type variable inside "any Iterator<T>&" is substituted in a generic
# type's instance and inferred at a generic function's call; and Map to a reference result works through an any
type AUps struct(n I64) {
    n
    at I64 = 0
}
fn (u mut AUps&) Next() I64 ? Exhausted {
    if u.at >= u.n { error Exhausted.END }
    u.at += 1
    return u.at * 10
}
fn anyCount<T>(it mut any Iterator<T>&) I64 { return it.Count(fn(x T) Bool { return true }) }
type ASrc<T> struct(it mut any Iterator<T>&) { it }
fn (s mut ASrc<T>&) First() T ? Exhausted { return try s.it.Next() }
fn (s mut ASrc<T>&) Rest() List<T>& { return s.it.ToList() }
fn anyGeneric(n I64) String {
    a mut any Iterator<I64>& = AUps(n)
    s := ASrc<I64>(AUps(n + 1))
    f := try s.First() catch default -1
    m mut any Iterator<I64>& = AUps(n)
    mapped := m.Map(fn(x I64) String& { return "m" $x })
    return $anyCount(a) " " $f " " $s.Rest() " " $mapped
}
BakedAnyGeneric String = anyGeneric(2)

test "T32: a type variable in an any's trait, substituted and inferred; Map to a reference through an any" {
    want := "2 10 List<I64>[20, 30] List<String&>[\"m10\", \"m20\"]"
    assert BakedAnyGeneric == want
    churn()
    assert anyGeneric(Live - 1) == want
}

# T32a, E25 (the third any review, finding 1): a call given a scope argument builds its array where that says, not
# where the box lands - so the box copies it, and a block's scope argument does not leave the box dangling
fn sArg(i I64) String { return "text" $i "-" $(i * 7) }
fn sArgStash(l mut List<any Named&>&, i I64) String {
    l.Push(Label(sArg&return(i)))
    return "r" $i
}
fn scopeArgs(n I64) String {
    xs := List<any Named&>()
    for i in range n {
        t := "inner" $i
        xs.Push(Label(sArg&t(i)))
        xs.Push(Label(sArg&t(i) if i >= 0 else "x" $i))
        r := sArgStash(xs, i)
    }
    churn()
    return names(xs)
}
BakedScopeArgs String = scopeArgs(2)

test "T32a: a call's array a scope argument puts elsewhere is copied into the box" {
    want := "label text0-0, label text0-0, label text0-0, label text1-7, label text1-7, label text1-7"
    assert BakedScopeArgs == want
    assert scopeArgs(Live - 1) == want
}

# O26a, T7b (the third any review, finding 3): a returned local that a borrow kept elsewhere names too is copied at its
# return - the caller's value is its own, and an any made of the call writes neither the log nor the field; baked while
# compiling exactly as at run time
type RsH struct(s String&) { s }
fn rsKeep(k mut RsH&, i I64) String {
    s := "abc" $i
    k.s = s
    return s
}
fn rsLog(log mut List<String&>&, i I64) String {
    s := "item" $i
    log.Push(s)
    return s
}
fn retShared(i I64) String {
    h := RsH("x")
    x := rsKeep(h, i)
    x[0] = 'Q'
    h2 := RsH("y")
    b mut any Bump& = BLab(rsKeep(h2, i + 1))
    b.Bump()
    log := List<String&>()
    y := rsLog(log, i)
    y[0] = 'Q'
    c mut any Bump& = BLab(rsLog(log, i + 1))
    c.Bump()
    churn()
    return $h.s " " $x " " $h2.s " " $y " " $log
}
BakedRetShared String = retShared(1)

test "O26a: a returned local a kept borrow names is copied at its return" {
    want := "abc1 Qbc1 abc2 Qtem1 List<String&>[\"item1\", \"item2\"]"
    assert BakedRetShared == want
    assert retShared(Live - 2) == want
}

# M21, E10a, E10b (the third any review, finding 5): Eq and Hash declared for one instance of a generic type are that
# instance's alone - another instance of it has the supplied Hash and part-by-part ==, so it is a Map key too
type EqBox<T> struct(v T) {
    v
}
fn (b EqBox<I64>&) Eq(o EqBox<I64>&) Bool { return b.v % 10 == o.v % 10 }
fn (b EqBox<I64>&) Hash() I64 { return b.v % 10 }
fn instanceEq(k I64) String {
    m := Map<EqBox<I64>, I64>()
    m.Put(EqBox<I64>(13), 1)
    m.Put(EqBox<I64>(23 + k), 2)
    n := Map<EqBox<Bool>, I64>()
    n.Put(EqBox<Bool>(true), 1)
    n.Put(EqBox<Bool>(k > 0), 2)
    return $m.Len() " " $n.Len() " " $(EqBox<I64>(13) == EqBox<I64>(23)) " " $(EqBox<Bool>(true) == EqBox<Bool>(false))
}
BakedInstanceEq String = instanceEq(0)

test "M21: Eq and Hash of one instance are not another's" {
    assert BakedInstanceEq == "1 2 true false"
    assert instanceEq(Live - 3) == BakedInstanceEq
}

# T7b, E25, O26a (the fourth any review, A): a call given a scope argument puts its array where that says whatever it
# holds - text and arrays of numbers too - so a function returning one copies it into its result, a local declared from
# one is not moved, and a box of a call returning one is a copy; each value read back after a churn
fn saArr(i I64) Array<I64> { return I64[i, i * 2] }
fn saText(p String&, i I64) String { return sArg&p(i) }
fn saChain(p String&, i I64) String { return saText(p, i) }
fn saNums(p String&, i I64) Array<I64> { return saArr&p(i) }
fn saLocal(i I64) String {
    t := "local" $i
    r := sArg&t(i)
    return r
}
fn saTuple(i I64) String, I64 {
    t := "tuple" $i
    return sArg&t(i), i
}
fn saTry(i I64) String {
    t := "try" $i
    return try saFail&t(i) catch default "no"
}
fn saFail(i I64) String ? ChOops {
    if i < 0 { error ChOops.BAD }
    return sArg(i)
}
fn aScoped(n I64) String {
    xs := List<any Named&>()
    out := ""
    for i in range n {
        t := "inner" $i
        xs.Push(Label(saText(t, i)))
        xs.Push(Label(saChain(t, i)))
        a := saLocal(i)
        b, k := saTuple(i)
        c := saNums(t, i)
        d := saTry(i)
        churn()
        out = $out $a " " $b " " $k " " $c " " $d "; "
    }
    churn()
    return $out $names(xs)
}
BakedAScoped String = aScoped(2)

test "T7b, E25: a scoped call's array of plain data is copied where it is returned or boxed" {
    want := "text0-0 text0-0 0 I64[0, 0] text0-0; text1-7 text1-7 1 I64[1, 2] text1-7; "
    want = $want "label text0-0, label text0-0, label text1-7, label text1-7"
    assert BakedAScoped == want
    assert aScoped(Live - 1) == want
}

# O26a, T7b (the fourth any review, B): a returned array local is returned as it is only where nothing else can name
# it - a push through a reference local, a handle's copy, a call on an element, a chain of borrows longer than any pass
# count, a destructor of the block - else it is copied; baked while compiling exactly as at run time, and an assert the
# compiler decides agrees
type SnK struct(s String&) { s }
fn (k mut SnK&) Set(t String&) { k.s = t }
fn snAlias(lst mut List<String&>&, i I64) String {
    s := "abc" $i
    l := lst
    l.Push(s)
    return s
}
fn snHandle(lst List<String&>, i I64) String {
    s := "hnd" $i
    l := lst
    l.Push(s)
    return s
}
fn snElem(ks mut List<mut SnK&>&, i I64) String {
    s := "elm" $i
    ks[0].Set(s)
    return s
}
fn snChain(k mut SnK&, i I64) String {
    s := "chn" $i
    r1 String&s = ""
    r2 String&s = ""
    r3 String&s = ""
    r4 String&s = ""
    r5 String&s = ""
    r6 String&s = ""
    r7 String&s = ""
    r8 String&s = ""
    for j in range 10 {
        k.s = r8
        r8 = r7
        r7 = r6
        r6 = r5
        r5 = r4
        r4 = r3
        r3 = r2
        r2 = r1
        r1 = s
    }
    return s
}
type SnRes struct(r mut String&) { r } destruct { r[0] = 'Z' }
fn snDtor(i I64) String {
    s := "dtr" $i
    d := SnRes(s)
    return s
}
fn secondNames(i I64) String {
    a := List<String&>()
    x := snAlias(a, i)
    x[0] = 'Q'
    b := List<String&>()
    y := snHandle(b, i)
    y[0] = 'Q'
    ks := List<mut SnK&>()
    ks.Push(SnK("k"))
    z := snElem(ks, i)
    z[0] = 'Q'
    k := SnK("c")
    w := snChain(k, i)
    w[0] = 'Q'
    v := snDtor(i)
    churn()
    return $a " " $x " " $b " " $y " " $ks[0].s " " $z " " $k.s " " $w " " $v
}
BakedSecondNames String = secondNames(1)

test "O26a, T7b: a returned array local something else names is copied at its return" {
    want := "List<String&>[\"abc1\"] Qbc1 List<String&>[\"hnd1\"] Qnd1 elm1 Qlm1 chn1 Qhn1 dtr1"
    assert secondNames(1) == want
    assert BakedSecondNames == want
    assert secondNames(Live - 2) == want
}

# E25, P1g (the fourth any review, D): a spawn target set from a call given a scope argument is the same call declared
# first - built where the argument says, here a local living past the join
type SpP struct(n I64) { n }
fn spMk(i I64) SpP& { return SpP(i) }
fn spawnScoped(k I64) String {
    t := "outer" $k
    x SpP?&t = null
    y SpP?&t = null
    join {
        spawn x = spMk&t(k * 11 + 1)
        spawn y = spMk&t(k * 11 + 2)
    }
    churn()
    return $x!.n " " $y!.n
}

test "E25, P1g: a spawn target set by a call given a scope argument" {
    assert spawnScoped(Live - 2) == "12 13"
}

# P1g, T11b (the fifth any review, 1): a spawn target holding an array by value is stored as the assignment it is
# judged as - a scoped call's array copied where the target's storage is, on the task's thread; one of several results,
# a catch default and an array of numbers alike; a target of the same length written in place, as T11b says
fn spTwo(i I64) String, I64 { return "two" $i "-" $(i * 7), i }
fn spTry(i I64) String ? ChOops {
    if i > 100 { error ChOops.BAD }
    return "try" $i "-" $(i * 7)
}
fn spNums(i I64) Array<I64> { return I64[i, i * 7, i * 11] }
fn spawnStores(k I64) String {
    a := ""
    n I64 = 0
    b := ""
    c := Array<I64>(0)
    same := "xxxxxxx"
    before := same[0:3]
    for i in range k + 1 {
        u := "inner" $i
        join {
            spawn a, n = spTwo&u(i)
            spawn b = try spTry&u(i) catch default "dflt"
            spawn c = spNums&u(i)
        }
    }
    {
        w := "w"
        join { spawn same = sArg&w(1) }
    }
    churn()
    return $a " " $n " " $b " " $c " " $same " " $before
}
BakedSpawnStores String = spawnStores(2)

test "P1g, T11b: a spawn target holding an array by value is stored as its assignment" {
    want := "two2-14 2 try2-14 I64[2, 14, 22] text1-7 tex"
    assert BakedSpawnStores == want
    assert spawnStores(Live - 1) == want
}

# O26a, T7b (the fifth any review, 2): a callee one of whose other parameters - its receiver too - shares a scope
# with the returned local's borrow may keep it with no obligation, so the local is copied at its return; a slice of
# it lent the same way; baked as at run time, and an assert the compiler decides agrees
type ShHolder struct(l mut List<String&>&) { l }
fn (h mut ShHolder&) Add(x String&h) I64 {
    h.l.Push(x)
    return 1
}
fn (x String&) AddTo(h mut ShHolder&x) I64 {
    h.l.Push(x)
    return 3
}
fn shTie(l mut List<String&>&, x String&l) I64 {
    l.Push(x)
    return 2
}
fn shAdd(h mut ShHolder&, i I64) String {
    s := "abc" $i
    h.Add(s)
    return s
}
fn shTieRet(keep mut List<String&>&, i I64) String {
    s := "def" $i
    shTie(keep, s)
    return s
}
fn shSlice(h mut ShHolder&, i I64) String {
    s := "ghi" $i
    h.Add(s[0:2])
    return s
}
fn shMethod(h mut ShHolder&, i I64) String {
    s := "jkl" $i
    s.AddTo(h)
    return s
}
fn sharedKeep(i I64) String {
    keep := List<String&>()
    h := ShHolder(keep)
    v := shAdd(h, i)
    v[0] = 'Q'
    w := shTieRet(keep, i)
    w[0] = 'R'
    x := shSlice(h, i)
    x[0] = 'S'
    y := shMethod(h, i)
    y[0] = 'T'
    churn()
    return $keep " " $v " " $w " " $x " " $y
}
BakedSharedKeep String = sharedKeep(1)

test "O26a, T7b: a callee sharing a parameter's scope keeps it, so the returned local is copied" {
    want := "List<String&>[\"abc1\", \"def1\", \"gh\", \"jkl1\"] Qbc1 Ref1 Shi1 Tkl1"
    assert sharedKeep(1) == want
    assert BakedSharedKeep == want
    assert sharedKeep(Live - 2) == want
}

# T29a, T7b (the fifth any review, 3): a conversion of a place to a type declared over String names its storage - a
# value declared or returned from it is a copy, a borrow of it writes the place - for a conditional, a match, a catch
# default and one of several results too, and boxed into an any; an immutable global is never written through one
type CvLab extends String
fn (l CvLab&) Name() String { return "cv " $String(l) }
type CvPath String
CvG := "global"
fn cvLocal(i I64) CvLab {
    s := "abc" $i
    return CvLab(s)
}
fn cvCond(i I64) CvLab {
    s := "cond" $i
    u := "else" $i
    return CvLab(s) if i % 2 == 0 else CvLab(u)
}
fn cvMatch(i I64) CvLab {
    s := "match" $i
    return match i { case 0 => CvLab(s) case _ => CvLab(s) }
}
fn cvBad(k I64) CvLab ? ChOops {
    if k < 100 { error ChOops.BAD }
    return CvLab("never")
}
fn cvTry(i I64) CvLab {
    s := "dflt" $i
    return try cvBad(i) catch default CvLab(s)
}
fn cvTup(i I64) CvLab, I64 {
    s := "tup" $i
    return CvLab(s), i
}
fn cvGlobal() CvPath { return CvPath(CvG) }
fn cvWr(l mut CvLab&) { l[0] = 'W' }
fn conversions(i I64) String {
    cvKept := List<CvLab&>()
    xs := List<any Named&>()
    for k in range 3 {
        cvKept.Push(cvLocal(k + i))
        xs.Push(cvLocal(k + i))
        churn()
    }
    a := cvCond(i + 1)
    b := cvMatch(i + 2)
    c := cvTry(i + 3)
    d, n := cvTup(i + 4)
    g := cvGlobal()
    g[0] = 'Q'
    s := "abc"
    x := CvLab(s)
    x[1] = 'X'
    cvWr(CvLab(s))
    churn()
    return $cvKept " " $names(xs) " " $a " " $b " " $c " " $d " " $n " " $g " " $CvG " " $s " " $x
}
BakedConversions String = conversions(0)

test "T29a: a conversion of a place to a type over String names its storage" {
    want := ("List<CvLab&>[\"abc0\", \"abc1\", \"abc2\"] cv abc0, cv abc1, cv abc2 else1 match2 dflt3 tup4 4 Qlobal global Wbc "
             "aXc")
    assert BakedConversions == want
    assert conversions(Live - 3) == want
}

# T7b, K1 (the fifth any review, 4): a returned conditional, match or catch default of a parameter's array is a copy
# while compiling as at run time
fn evPick(p String&, q String&, c Bool) String { return p if c else q }
fn evPickM(p String&, k I64) String { return match k { case 0 => p case _ => p } }
fn evPickT(p String&, k I64) String { return try chBad(k) catch default p }
fn evalCopies(i I64) String {
    s := "cond" $i
    x := evPick(s, s, i > 0)
    x[0] = 'Q'
    t := "match" $i
    y := evPickM(t, i)
    y[0] = 'Q'
    u := "dflt" $i
    z := evPickT(u, i)
    z[0] = 'Q'
    return $s " " $t " " $u " " $x " " $y " " $z
}
BakedEvalCopies String = evalCopies(1)

test "T7b, K1: a returned conditional, match or catch default is copied while compiling as at run time" {
    want := "cond1 match1 dflt1 Qond1 Qatch1 Qflt1"
    assert evalCopies(1) == want
    assert BakedEvalCopies == want
    assert evalCopies(Live - 2) == want
}

# E25, O25a (the fifth any review, 5): a local a call given a scope argument declares lives where the argument puts it
fn soMk(i I64) String { return "mk" $i }
fn soReturn(keep mut List<String&>&, i I64) String {
    x := soMk&return(i)
    keep.Push(x)
    return x
}
fn soKeep(keep mut List<String&>&, i I64) String {
    x := soMk&keep(i)
    keep.Push(x)
    return x
}
fn scopedLocals(i I64) String {
    keep := List<String&>()
    a := soReturn(keep, i)
    b := soKeep(keep, i + 1)
    a[0] = 'Q'
    b[0] = 'R'
    churn()
    return $keep " " $a " " $b
}

test "E25, O25a: a local a scoped call declares lives where the argument puts it" {
    assert scopedLocals(Live - 2) == "List<String&>[\"mk1\", \"mk2\"] Qk1 Rk2"
}
