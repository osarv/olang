# Benchmarks (B19b): tests whose bodies hand std/bench the work to measure. A plain "olang test" runs each once, as a
# test; "olang test -bench tests/bench.olang [WORD...]" measures them.

import "std/bench"

# n numbers in a scrambled order, the same every run
fn scrambled(n I64) Array<I64> {
    return Array<I64>[(i * 7919 + 13) % n for i in range n]
}

fn sorted(xs Array<I64>) Array<I64> {
    ys := xs
    ys.Sort(fn(a I64, b I64) Bool { return a < b })
    return ys
}

test sorted "ten thousand numbers" {
    xs := scrambled(10000)
    bench.Run(fn() {
        ys := sorted(xs)
        bench.Keep(ys[0] + ys[9999])
    })
    ys := sorted(xs)
    assert ys[0] == 0 and ys[9999] == 9999
}

# how many times each word occurs in words
fn counts(words Array<String>&) Map<String, I64> {
    m := Map<String, I64>()
    for w in words { m.Put(w, (try m.Get(w) catch MapError default 0) + 1) }
    return m
}

test counts "a thousand words into a map" {
    words := Array<String>["word" $(i % 100) for i in range 1000]
    bench.Run(fn() { bench.Keep(counts(words).Len()) })
    bench.Run(fn() { bench.Keep(counts(words[:10]).Len()) }, label = "ten")
    assert counts(words).Len() == 100 and counts(words).Get("word7")! == 10
}

test "the sum of a million numbers, by lanes" {
    xs := Array<F64>[F64(i) for i in range 1000000]
    bench.Run(fn() { bench.Keep(xs.Sum()) })
    assert xs.Sum() == 499999500000.0
}
