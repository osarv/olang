# S21: become f(x) - a guaranteed tail call. Each test holds the run time to what the compile-time evaluator bakes
# (K2) and decides (S18c); the deep ones would overflow the stack as calls
import "std/io"

fn sum(n I64, acc I64) I64 {
    if n == 0: return acc
    become sum(n - 1, acc + n)
}

fn isEven(n I64) Bool {
    if n == 0: return true
    become isOdd(n - 1)
}

fn isOdd(n I64) Bool {
    if n == 0: return false
    become isEven(n - 1)
}

type Odd error { Negative, TooDeep }

# the callee's failure is the function's own: one set, in one order
fn steps(n I64, acc I64) I64 ? Odd {
    if n < 0: error Odd.Negative
    if n == 0: return acc
    become hop(n - 1, acc + 1)
}

fn hop(n I64, acc I64) I64 ? Odd {
    if acc > 20000000: error Odd.TooDeep
    become steps(n, acc)
}

# what the function was given is handed on - a reference parameter's scope is its caller's
fn count(t String&, i I64, n I64) I64 {
    if i >= t.Len(): return n
    become count(t, i + 1, n + (1 if t[i] == 'a' else 0))
}

# a built result: an argument made for the callee lives where the result goes, which outlives every frame of the chain
fn pad(n I64, acc String&) String {
    if n == 0: return $acc
    become pad(n - 1, $acc ".")
}

type Counter struct(step I64) {
    step
}

fn (c Counter&) Run(n I64, acc I64) I64 {
    if n == 0: return acc
    become c.Run(n - 1, acc + c.step)
}

fn twice<T>(x T, n I64) T {
    if n == 0: return x
    become twice(x, n - 1)
}

# a run-time-length array or text bound to a by-value type variable is the caller's storage (D9b): handed on, it is
# what the function was given (S21)
fn ends<T>(a T, n I64) I64 {
    if n == 0: return a[0] + a[a.Len() - 1]
    become ends(a, n - 1)
}

GivenArray := Array<I64>(5, 3)

# a state machine: each state a function of one signature
fn start(t String&, i I64) I64 {
    if i >= t.Len(): return 0
    if t[i] == '(': become inside(t, i + 1)
    become start(t, i + 1)
}

fn inside(t String&, i I64) I64 {
    if i >= t.Len(): return -1
    if t[i] == ')': return 1 + start(t, i + 1)
    become inside(t, i + 1)
}

# the tail scope (S21): what a step makes and hands on is built where the chain's first call's result lands, so each
# step's array is kept until then - as the return form keeps its frames' - in one frame
fn grow(a Array<I64>&, i I64, n I64) I64 {
    if i >= n: return a.Len() * 1000 + a[0]
    b := Array<I64>(a.Len() + 1, i)
    become grow(b, i + 1, n)
}

# ... and two states, one making, one handing on what it was given
fn widen(a Array<I64>&, n I64) I64 {
    if n == 0: return a.Len()
    b := Array<I64>(a.Len() + 1, n)
    become narrow(b, n - 1)
}

fn narrow(a Array<I64>&, n I64) I64 {
    if n == 0: return a[0]
    become widen(a, n - 1)
}

# text rendered at the become, handed to a by-value type variable
fn spell<T>(t T, n I64) I64 {
    if n == 0: return t.Len()
    become spell($t "ab", n - 1)
}

# instances with a destructor made in the blocks a become closes are ended as the tail scope closes, last made first
Ended mut I64 = 0
EndOrder mut I64 = 0

type Probe unique struct(n I64) { n } destruct {
    Ended++
    EndOrder = EndOrder * 10 + n
}

fn probe(n I64) I64 {
    p := Probe(n)
    if n == 1: return p.n + Ended * 100
    become probe(n - 1)
}

fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}

BakedGrow I64 = grow(Array<I64>[7], 0, 30)
BakedSpell I64 = spell("x", 4)

BakedSum I64 = sum(1000, 0)
BakedEven Bool = isEven(1001)
BakedPad String = pad(3, "x")
BakedRun I64 = Counter(2).Run(100, 0)
BakedEnds I64 = ends(GivenArray, 10)

test "become runs a chain of any depth in one frame" {
    assert sum(10000000, 0) == 50000005000000
    assert not isEven(10000001) and isOdd(10000001)
    assert Counter(3).Run(10000000, 0) == 30000000
}

test "a become's failure is the function's own" {
    assert steps(1000000, 0)! == 1000000
    try steps(-1, 0) catch Odd.Negative { } catch Odd { unreachable }
    try steps(30000000, 0) catch Odd.TooDeep { } catch Odd { unreachable }
}

test "references given are handed on, results built where they go" {
    assert count("banana", 0, 0) == 3
    p := pad(1000, "x")
    assert p.Len() == 1001 and p[1000] == '.'
    assert twice("t", 5) == "t" and twice(7, 1000000) == 7
    assert start("a(b)c(d)", 0) == 2 and start("((", 0) == -1
}

test "a run-time array a generic was given is handed on" {
    k := sum(3, 0) + 1
    a := Array<I64>(k, 2)
    a[k - 1] = 5
    assert ends(a, 100000) == 7 and ends(GivenArray, 3) == 6
    t := $k " end"
    assert ends(t, 10) == I64('7') + I64('d')
}

test grow "what a chain makes and hands on is kept in its tail scope" {
    for n in range 3 {
        r := grow(Array<I64>[5, 6], 0, n + 100)
        churn()
        assert r == (102 + n) * 1000 + n + 99
    }
    assert widen(Array<I64>[1], 7) == 1
    assert spell("q", 1000) == 2001
    f := grow
    assert f(Array<I64>[1], 0, 3) == 4002
}

test probe "instances a become's blocks made end as the tail scope closes, last made first" {
    Ended = 0
    EndOrder = 0
    {
        assert probe(3) == 1
        assert Ended == 0
    }
    assert Ended == 3 and EndOrder == 123
    g := probe
    assert g(4) == 301 and Ended == 7 and EndOrder == 1231234
}

test "the evaluator agrees" {
    assert BakedGrow == grow(Array<I64>[7], 0, 30) and BakedGrow == 31029
    assert BakedSpell == spell("x", 4) and BakedSpell == 9
    assert grow(Array<I64>[1, 1], 0, 5) == 7004   # decided while compiling (S18c)
    assert BakedSum == sum(1000, 0) and BakedSum == 500500
    assert BakedEven == isEven(1001) and not BakedEven
    assert BakedPad == "x..." and BakedPad == pad(3, "x")
    assert BakedRun == 200 and BakedEnds == 6
    assert sum(100, 0) == 5050                # decided while compiling (S18c)
    assert count("aaa", 0, 0) == 3
    io.Println("become: " $BakedSum)!
}
