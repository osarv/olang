# T19b: errors carrying data - payload words raised with their fields, taken by clauses, read where narrowed, rendered,
# compared, hashed, stored, raised again, recoded between sets, carried from tasks to their joins. Each computation is
# done twice where it can be - as a global the evaluator bakes and an assert it decides while compiling (K2, S18c), and
# on an input the evaluator cannot see (Live, a mutable global), at run time - so the two must agree.

type ParseErr error {
    Bad(line I64, col I64)
    Eof
    Named(what String)
}
type NetErr error { Gone(host String), Slow }
type LoadErr error ParseErr, NetErr

Live mut I64 = 0

fn parse(n I64) I64 ? ParseErr {
    if n == 0: error ParseErr.Eof
    if n < 0: error ParseErr.Bad(n, 7)
    if n > 100: error ParseErr.Named("big " $n)
    return n * 2
}

fn fetch(n I64) I64 ? NetErr {
    if n == 1001: error NetErr.Slow
    error NetErr.Gone("host" $n)
}

fn load(n I64) I64 ? LoadErr {
    if n >= 1000: return try fetch(n)
    return try parse(n)
}

# what n's parse said, as "$" renders it
fn said(n I64) String {
    return try $parse(n) catch ParseErr e default $e
}

# the line of a Bad, read off the clause's name
fn line(n I64) I64 {
    return try parse(n) catch ParseErr.Bad e default e.line catch default -1
}

# the payload read where narrowing leaves one word
fn named(n I64) String {
    v := try parse(n) catch ParseErr e {
        if e == ParseErr.Named: return e.what
        return "other"
    }
    return $v
}

# error e raises what e holds, payload and all
fn again(n I64) I64 ? ParseErr {
    return try parse(n) catch ParseErr e {
        error e
    }
}

fn againSaid(n I64) String {
    return try $again(n) catch ParseErr e default $e
}

# errors kept for later, each its own copy
fn kept(ns Array<I64>&) Vec<LoadErr> {
    out := Vec<LoadErr>()
    for n in ns {
        try load(n) catch LoadErr e {
            out.Push(e)
        }
    }
    return out
}

# the join's error: the earliest-spawned failure's, its payload with it
fn fanned(base I64) String {
    out := Array<I64>(8)
    try join {
        for i in range 8 {
            spawn out[i] = try parse(base + 5 - i)
        }
    } catch ParseErr e {
        return $e
    }
    return $out
}

Said String = said(-3)
assert Said == "ParseErr.Bad(-3, 7)"
assert said(500) == "ParseErr.Named(\"big 500\")"
assert said(0) == "ParseErr.Eof"
assert line(-9) == -9 and line(0) == -1
assert named(200) == "big 200"
assert againSaid(-4) == "ParseErr.Bad(-4, 7)"
Kept Vec<LoadErr> = kept(Array<I64>[0, -2, 300, 1000, 1001])
assert Kept.Len() == 5
assert $Kept[2] == "ParseErr.Named(\"big 300\")" and $Kept[3] == "NetErr.Gone(\"host1000\")"

test "a payload is read in the clause and where narrowing leaves one word" {
    assert said(Live - 3) == "ParseErr.Bad(-3, 7)"
    assert said(Live + 500) == "ParseErr.Named(\"big 500\")"
    assert line(Live - 9) == -9 and line(Live) == -1
    assert named(Live + 200) == "big 200" and named(Live) == "other"
    assert said(Live + 4) == "8"
}

test "error e raises the payload it holds" {
    assert againSaid(Live - 4) == "ParseErr.Bad(-4, 7)"
}

test "a value kept outlives the clause and the scopes after it" {
    ks := kept(Array<I64>[Live, Live - 2, Live + 300, Live + 1000, Live + 1001])
    for i in range 50 {
        v := Vec<String>()
        v.Push("churn" $i)
    }
    assert ks.Len() == 5
    assert $ks[0] == "ParseErr.Eof" and $ks[1] == "ParseErr.Bad(-2, 7)"
    assert $ks[2] == "ParseErr.Named(\"big 300\")" and $ks[3] == "NetErr.Gone(\"host1000\")" and $ks[4] == "NetErr.Slow"
    assert ks.View() == Kept.View()
}

test "values compare and hash by word and payload" {
    a := ParseErr.Bad(Live + 1, 2)
    assert a == ParseErr.Bad(1, 2) and a != ParseErr.Bad(1, 3) and a != ParseErr.Eof
    assert a.Hash() == ParseErr.Bad(1, 2).Hash()
    m := Map<ParseErr, I64>()
    m.Put(ParseErr.Named("a"), 1)
    m.Put(ParseErr.Named("b"), 2)
    m.Put(ParseErr.Named("a"), 3)
    assert m.Len() == 2 and (try m.Get(ParseErr.Named("a")) catch default 0) == 3
    w LoadErr = a
    assert w == ParseErr.Bad(1, 2) and $w == "ParseErr.Bad(1, 2)"
    z LoadErr = null
    assert z is null and z != w
}

test "a payload rides from a task to its join, the earliest-spawned failure's kept" {
    assert fanned(Live) == "ParseErr.Eof"
    out := Array<I64>(8)
    join {
        for i in range 4 {
            spawn out[i] = try parse(Live - i) catch ParseErr default -1
        }
    }
    assert out[1] == -1
}

test "a loop raising and taking payloads stays flat" {
    total := 0
    for i in range 200000 {
        total += try parse(Live - i - 1) catch ParseErr.Bad e default e.col catch default 0
        total += try parse(Live + 101 + i) catch default 1
    }
    assert total == 1600000
}

# R3b with T19b: an error raised by name carries what its raise names - a pun's field named as the name is, any other
# value written "name = value" - typed by the module's first raise (a reference's referent, copied in)
fn find(key String&, at I64) I64 ? {
    if at < 0: error OutOfRange(index = at, limit = 10)
    if key == "": error NoKey(key)
    if at > 10: error OutOfRange(index = at, limit = 10 * 2)
    return at
}

# what find said, as "$" renders it
fn found(key String&, at I64) String {
    return try $find(key, at) catch OutOfRange e default $e catch NoKey e default $e
}

# the index an OutOfRange carried
fn indexOf(key String&, at I64) I64 {
    return try find(key, at) catch OutOfRange e default (e.index - e.limit) catch default -1
}

Found String = found("k", -4)
FoundKey String = found("", 3)

test "an error raised by name carries what its raise names" {
    assert Found == "OutOfRange(-4, 10)" and found("k", -4) == Found
    assert FoundKey == "NoKey(\"\")" and found("", Live + 3) == FoundKey
    assert found("k", 12 + Live) == "OutOfRange(12, 20)"
    assert indexOf("k", -4) == -14 and indexOf("k", Live + 30) == 10
    try find("k", -1) catch OutOfRange e { assert e == OutOfRange(-1, 10) and e != OutOfRange(-1, 20) } catch NoKey { unreachable }
}

# T20: an error type's own methods, declared in its module; a named set has methods of its own, none of its members'
fn (e ParseErr) Where() String {
    if e == ParseErr.Bad: return $e.line ":" $e.col
    return "nowhere"
}

fn (e LoadErr) Remote() Bool { return e == NetErr }

fn whereOf(n I64) String { return try $parse(n) catch ParseErr e default e.Where() }

fn remote(n I64) Bool { return try load(n) > 0 catch LoadErr e default e.Remote() }

WhereBaked String = whereOf(-5)

test "an error type's methods read what it carries" {
    assert WhereBaked == "-5:7" and whereOf(Live - 5) == WhereBaked and whereOf(Live) == "nowhere"
    assert remote(Live + 1000) and not remote(Live - 1) and remote(Live + 1001)
    try parse(Live - 2) catch ParseErr.Bad e { assert e.Where() == "-2:7" }
}

# D17, T19b: a false requirement's ArgumentError.Invalid carries the function's name and the condition
fn half(n I64) [n % 2 == 0] I64 ? { return n / 2 }

fn why(n I64) String { return try $half(n) catch ArgumentError e default $e }

WhyHalf String = why(3)

test "a false requirement's ArgumentError carries the condition" {
    assert WhyHalf == "ArgumentError.Invalid(\"half: n % 2 == 0\")" and why(Live + 3) == WhyHalf
    assert why(Live + 4) == "2"
    try half(Live + 5) catch ArgumentError.Invalid e { assert e.what == "half: n % 2 == 0" }
}

# T19b, S13b: a payload matched as an enum case's is - fields by position, then by name, a name binding, "_" anything,
# a value compared - in a match on the error a clause named
fn kind(n I64) String {
    try parse(n) catch ParseErr e {
        match e {
            case ParseErr.Bad(_, col = 0): return "no column"
            case ParseErr.Bad(-1, _): return "line -1"
            case ParseErr.Bad(at, c) { return "bad " $at ":" $c }
            case ParseErr.Named(what) { return what }
            case ParseErr.Eof: return "eof"
        }
    }
    return "ok"
}

KindBaked String = kind(-1)

test "a payload is matched by position and by name" {
    assert KindBaked == "line -1" and kind(Live - 1) == KindBaked
    assert kind(Live - 9) == "bad -9:7" and kind(Live + 200) == "big 200" and kind(Live) == "eof" and kind(Live + 1) == "ok"
}

# P4b, T19b (bulk review 8): an error of a join block's own leaves with its own payload - the tasks' failures, payloads
# and all, dropped by the join's wait (it had put the earliest task's record on top, which the clause then read)
type JoinErr error { Task(msg String), Own(n I64, msg String) }
type Halt error { Now }

fn task(i I64) I64 ? JoinErr { error JoinErr.Task("task " $i) }

fn ownFails(n I64) ? JoinErr { error JoinErr.Own(n, "own") }

fn joinOwn(n I64) String ? JoinErr {
    out := Array<I64>(4)
    try join {
        for i in range 4 {
            spawn out[i] = try task(i + n)
        }
        try ownFails(n)
    } catch JoinErr e {
        return "inner " $e
    }
    return "none"
}

fn joinedOwn(n I64) String { return try joinOwn(n) catch JoinErr e default "outer " $e }

# the block's own error carrying nothing: the tasks' payloads dropped all the same, so the next payload read is its own
fn joinHalts(n I64) String ? Halt {
    out := Array<I64>(4)
    try join {
        for i in range 4 {
            spawn out[i] = try task(i + n) catch JoinErr default 0
        }
        spawn out[0] = try task(n)
        if n >= 0: error Halt.Now
    } catch JoinErr e {
        return "inner " $e
    }
    return "none"
}

fn haltedThenRead(n I64) String {
    a := try joinHalts(n) catch Halt e default $e
    return $a " " $(try $parse(-n - 1) catch ParseErr e default $e)
}

JoinOwnBaked String = joinedOwn(3)
assert haltedThenRead(2) == "Halt.Now ParseErr.Bad(-3, 7)"

test "a join block's own error leaves with its own payload, the tasks' dropped" {
    assert JoinOwnBaked == "outer JoinErr.Own(3, \"own\")" and joinedOwn(Live + 3) == JoinOwnBaked
    for i in range 50 {
        assert joinedOwn(Live + i) == "outer JoinErr.Own(" $i ", \"own\")"
        assert haltedThenRead(Live + i) == "Halt.Now ParseErr.Bad(" $(-i - 1) ", 7)"
    }
}

# T19b (bulk review 8): a payload field narrowed to its word is read as any value is - indexed, sliced, measured
type BufErr error { Short(data Array<I64>, msg String), Gone }

fn third(n I64) I64 {
    e BufErr = BufErr.Short(Array<I64>[n, n + 1, n + 2], "short")
    if e == BufErr.Short: return e.data[2] + e.data.Len() + e.msg[1:3].Len() + e.data[0:2][1]
    return -1
}

fn shortAt(n I64) I64 ? BufErr {
    if n < 0: error BufErr.Short(Array<I64>[n, 2 * n], "neg")
    return n
}

fn second(n I64) I64 { return try shortAt(n) catch BufErr.Short e default e.data[1] catch default 0 }

ThirdBaked I64 = third(4)
assert second(-5) == -10

test "a narrowed payload's array field is indexed in place" {
    assert ThirdBaked == 16 and third(Live + 4) == ThirdBaked
    assert second(Live - 5) == -10 and second(Live + 2) == 2
}

# R3b (bulk review 8): the module's first raise in source order settles a raised error's fields, whichever is checked
# first - lateA's, though lateA calls lateB, whose raise is met before it
fn lateA(n I32) I64 ? {
    if n > 5: return try lateB(n - 1)
    error Late(v = n)
}

fn lateB(n I32) I64 ? { error Late(v = n) }

fn lateSaid(n I32) String { return try $lateA(n) catch Late e default $e }

LateBaked String = lateSaid(9)

test "the first raise in source order settles a raised error's fields" {
    assert LateBaked == "Late(8)" and lateSaid(I32(Live) + 9) == LateBaked and lateSaid(I32(Live) + 2) == "Late(2)"
}
