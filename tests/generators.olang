# generators (D18, S20, QAG): a function whose result is written Iterator<T ? E> and whose body yields gives a
# Generator<T ? E>, whose Next runs the body on from where it stopped to its next yield

type Bad error {
    NEG
}

type Res struct(id I64) {
    id
} destruct {
    Dropped++
}

Dropped mut I64 = 0
Ten mut I64 = 10 # read at run time: what the evaluator bakes below is computed again from it

fn evens(n I64) Iterator<I64> {
    i I64 = 0
    for i < n {
        yield i
        i += 2
    }
}

fn countdown(n I64) Iterator<I64 ? Bad> {
    for n > 0 {
        if n == 3 { error Bad.NEG }
        yield n
        n--
    }
}

fn repeat<T>(x T, n I64) Iterator<T> {
    for _ in range n { yield x }
}

fn (l Vec<T>&) Twice() Iterator<T> {
    for x in l {
        yield x
        yield x
    }
}

fn words(t String&) Iterator<String> {
    for w in t.Split(" ") {
        if w.Len() == 0 { continue }
        yield $w "!"
    }
}

fn guarded(n I64) Iterator<I64> {
    for i in range n {
        r := Res(i)
        yield r.id
    }
}

fn nested(n I64) Iterator<I64> {
    for x in evens(n) {
        for y in repeat(x, 2) { yield 10 * x + y }
    }
}

fn firstTwo(n I64) Iterator<I64> {
    yield n
    if n > 5 { return }
    yield n + 1
}

fn pairs<I Iterator<I64>>(it mut I&) Iterator<I64> {
    for {
        a := try it.Next()
        b := try it.Next() catch Exhausted default 0
        yield a + b
    }
}

# K2: globals baked from generators, beside the same walks at run time
Total I64 = evens(10).Sum()
Walked I64 = nested(4).Sum()
Said I64 = words("a bb  ccc").Count(fn(s) { return s.Len() > 2 })

type Holder struct(g Generator<I64>) {
    g
}

test "D18: a generator walked by for-in and by the iterator helpers, while compiling and at run time" {
    assert Total == 20
    assert evens(Ten).Sum() == Total
    assert evens(4).Sum() == 2 # decided while compiling (S18c)
    n I64 = 0
    for x in evens(Ten) { n += x }
    assert n == 20
    assert Walked == 44
    assert nested(Ten - 6).Sum() == Walked
    assert Said == 2
}

test "D18: a generic generator, a generator method, text built for each value" {
    assert repeat("ab", 3).Count(fn(s) { return s == "ab" }) == 3
    l := Vec<I64>()
    l.Push(1)
    l.Push(Ten)
    out := Vec<I64>()
    for x in l.Twice() { out.Push(x) }
    assert out.Len() == 4 and out[2] == 10 and out[3] == 10
    n I64 = 0
    for w in words("the  quick brown") {
        n++
        if n == 2 { assert w == "quick!" }
    }
    assert n == 3
}

test "D18: errors - the error leaves, Exhausted after it" {
    got := Vec<I64>()
    failed := false
    for x in try countdown(5) { got.Push(x) } catch Bad { failed = true }
    assert failed and got.Len() == 2 and got[1] == 4
    g := countdown(Ten)
    total I64 = 0
    for { total += try g.Next() catch Bad { break } catch Exhausted { break } }
    over := false
    try g.Next() catch Exhausted { over = true } catch Bad { }
    assert over
    assert total == 10 + 9 + 8 + 7 + 6 + 5 + 4
}

test "D18a: return ends a walk, and Next after the end fails with Exhausted again" {
    g := firstTwo(Ten)
    a := try g.Next() catch default -1
    b := try g.Next() catch default -1
    c := try g.Next() catch default -1
    assert a == 10 and b == -1 and c == -1
    assert firstTwo(1).Sum() == 3
}

test "D18: a generator over another iterator ends where that one does" {
    it := evens(Ten)
    assert pairs(it).Sum() == 20
    assert pairs(evens(6)).Sum() == 6
}

test "D18: a copy of a Generator is the same walk; a field holds one" {
    h := Holder(repeat(7, 2))
    c := h.g
    x1 := try h.g.Next() catch default -1
    x2 := try c.Next() catch default -1
    x3 := try c.Next() catch default -1
    assert x1 == 7 and x2 == 7 and x3 == -1
    a mut any Iterator<I64>& = repeat(5, 3)
    n I64 = 0
    for v in a { n += v }
    assert n == 15
}

test "D18b: a walk stopped part way closes its scopes with the scope the generator lives in" {
    d := Dropped
    {
        g := guarded(Ten)
        a := try g.Next() catch default -1
        b := try g.Next() catch default -1
        assert a == 0 and b == 1
        assert Dropped == d + 1 # the first turn's scope closed as the walk went on
    }
    assert Dropped == d + 2 # the second's, as the walk was dropped
    for x in guarded(3) {
        if x == 1 { break }
    }
    assert Dropped == d + 4
    for _ in guarded(2) { }
    assert Dropped == d + 6
}

test "D18: a walk churned between values reads what it made, not reused storage" {
    for w in words("one two three") {
        junk := Vec<I64>()
        for i in range 50 { junk.Push(($i "-" $i).Len()) }
        assert w.EndsWith("!") and junk.Len() == 50
    }
}

fn logged(n I64, log mut Vec<String&>&) Iterator<I64> {
    for i in range n {
        log.Push($i "!")
        yield i
    }
}

test "D18b: a generator builds into what it was given, where that lives" {
    log := Vec<String&>()
    s I64 = 0
    for x in logged(Ten - 6, log) { s += x }
    assert s == 6 and log.Len() == 4 and log[3] == "3!"
}

fn copies(t String&) Iterator<String> {
    at I64 = 0
    for k in range t.Len() {
        if t[k] == ',' {
            yield $t[at:k]
            at = k + 1
        }
    }
    yield $t[at:]
}

test "D18c: a generator yields copies of what it was given" {
    n I64 = 0
    for p in copies("a,bb,,ccc") {
        n++
        if n == 2 { assert p == "bb" }
        if n == 3 { assert p.Len() == 0 }
    }
    assert n == 4
}

# S19e: an errdefer in a block of a generator's body that closes before its yield runs when the walk's error leaves it
EdLog mut I64 = 0

fn edCheck(n I64) ? Bad {
    if n < 0 { error Bad.NEG }
}

fn edWalk(n I64) Iterator<I64 ? Bad> {
    for i in range 3 {
        {
            errdefer EdLog = EdLog * 10 + 1
            try edCheck(n - i)
        }
        yield i
    }
}

fn edTotal(n I64) I64 {
    t I64 = 0
    for x in try edWalk(n) { t += x } catch Bad { t += 100 }
    return t
}

test "S19e: an errdefer in a generator's body runs when the walk fails, not when it ends" {
    EdLog = 0
    assert edTotal(5) == 3 and EdLog == 0
    assert edTotal(1) == 101 and EdLog == 1
}

# D18, D17 (the bulk review's F9): a generator's conditions are checked as its first Next begins - a false one is that
# Next's ArgumentError, and the walk is over after it; the call making the generator runs none of them
fn halves(n I64, d I64) [n >= 0, d > 0] Iterator<I64 ? ArgumentError> {
    for i in range n { yield i / d }
}

fn halvesSum(n I64, d I64) I64 {
    t I64 = 0
    for x in try halves(n, d) { t += x } catch ArgumentError { return -1 }
    return t
}

HalvesBaked := halvesSum(10, 2) * 100 + halvesSum(-1, 2)

test "D18: a generator's contract, failing its first Next" {
    assert HalvesBaked == 20 * 100 - 1
    assert halvesSum(Ten, 2) == 20 and halvesSum(Ten, 0) == -1 and halvesSum(-Ten, 1) == -1
    g := halves(Ten - 20, 1)          # made: nothing checked yet
    a := try g.Next() catch ArgumentError default -5 catch Exhausted default -6
    b := try g.Next() catch ArgumentError default -5 catch Exhausted default -6
    assert a == -5 and b == -6
}

# a walk whose loops build nothing holds no scope header at a yield: dropped part way it has nothing to close, and one
# whose loop body does (guarded's Res) still closes it - side by side, a thousand times
test "D18b: walks holding no scope and walks holding one, stopped part way, side by side" {
    d := Dropped
    t I64 = 0
    for _ in range 1000 {
        for x in evens(Ten) {
            if x == 4 { break }
            t += x
        }
        for y in guarded(Ten) {
            if y == 1 { break }
            t += y
        }
    }
    assert t == 2000
    assert Dropped == d + 2000
}

# D18e: a walk left by a return from inside two loops and by an error leaving its function closes its scopes once; in
# a test build the drop stays registered, so a failed check closes them too (checks/fixtures/generators/exitst.olang),
# and a build outside tests destroys the walk itself on each of these exits (exits.olang)
fn firstOver(n I64, k I64) I64 {
    for p in range 3 {
        for x in guarded(n) {
            if x + p > k { return x + 10 * p }
        }
    }
    return -1
}

fn guardedFails(n I64) I64 ? Bad {
    t I64 = 0
    for x in guarded(n) {
        if x == 2 { error Bad.NEG }
        t += x
    }
    return t
}

test "D18e: a walk left by a return out of two loops, or by an error, closes its scopes once" {
    d := Dropped
    assert firstOver(Ten, 10) == 29
    assert Dropped == d + 30
    assert (try guardedFails(Ten) catch Bad default -1) == -1
    assert Dropped == d + 33
}

# ---- D18c: elements borrowed from what a generator was given, or kept by its walk ----

# the words of t, each a view of t's own text
fn spans(t String&) Iterator<String&t> {
    i I64 = 0
    for i < t.Len() {
        for i < t.Len() and t[i] == ' ' { i++ }
        j := i
        for j < t.Len() and t[j] != ' ' { j++ }
        if j > i { yield t[i:j] }
        i = j
    }
}

# what spans gives, kept where the caller's text lives - an obligation on the caller (O10b)
fn keepSpans(t String&, out mut Vec<String&>&) {
    for w in spans(t) { out.Push(w) }
}

fn spanTotal(t String&) I64 {
    n I64 = 0
    for w in spans(t) { n += w.Len() }
    return n
}

# text built and dropped in blocks of its own: storage freed early, or closed with a block, would be written over
fn churnText() I64 {
    n I64 = 0
    for i in range 200 {
        junk := Vec<String&>()
        for k in range 4 { junk.Push($i "-churn-" $k) }
        n += junk[3].Len()
    }
    return n
}

SpanTotal := spanTotal("one two three") # baked while compiling (K2)

test "D18c: a generator's elements borrowed from what it was given live where that does" {
    t := $"alpha beta" " gamma"
    kept := Vec<String&>()
    keepSpans(t, kept)
    for w in spans(t) {
        churnText()
        kept.Push(w)
    }
    churnText()
    assert kept.Len() == 6 and kept[0] == "alpha" and kept[4] == "beta" and kept[5] == "gamma"
    assert spans(t).Count(fn(w) { return w.Len() == 5 }) == 2
    g := spans(t)
    a := try g.Next() catch default ""
    b := try g.Next() catch default ""
    churnText()
    assert a == "alpha" and b == "beta"
    lens := I64[w.Len() for w in spans(t)]
    assert lens.Len() == 3 and lens[2] == 5
    assert SpanTotal == 11 and spanTotal("ab c") == 3 # decided while compiling (S18c)
    assert spanTotal(t) == 14
}

type Pt struct(x I64) {
    x
}

# each point made once and kept by the walk, handed out as it is made and then all again
fn points(n I64) Iterator<Pt&return> {
    all mut Vec<Pt&>&return = Vec<Pt&>()
    for i in range n {
        p Pt&return = Pt(i * 10)
        all.Push(p)
        yield p
    }
    for p in all { yield p }
}

fn labels(n I64) Iterator<String&return> {
    for i in range n {
        s String&return = $"label " $i
        yield s
    }
}

fn labelTotal(n I64) I64 {
    t I64 = 0
    for s in labels(n) { t += s.Len() }
    return t
}

LabelTotal := labelTotal(3) # baked while compiling (K2)

test "D18c: a generator's elements kept by its walk live where the generator does" {
    g := labels(3)
    a := try g.Next() catch default ""
    b := try g.Next() catch default ""
    churnText()
    c := try g.Next() catch default ""
    churnText()
    assert a == "label 0" and b == "label 1" and c == "label 2"
    pg := points(3)
    seen := Vec<Pt&>()
    for p in pg {
        churnText()
        seen.Push(p)
    }
    churnText()
    assert seen.Len() == 6 and seen[1].x == 10 and seen[4].x == 10 and seen[5].x == 20
    total I64 = 0
    for p in points(4) { total += p.x }
    assert total == 120
    assert LabelTotal == 21 and labelTotal(2) == 14 # decided while compiling (S18c)
}

# holds a value with a destructor in its frame, given constant text - which lives in the program's scope
fn holding(t String&) Iterator<I64> {
    r := Res(t.Len())
    yield r.id
    yield r.id + 1
}

test "D18e: a walk a for-in makes is dropped as the loop's block is left, whatever it was given" {
    d := Dropped
    for _ in holding("constant") { break }
    assert Dropped == d + 1
    n I64 = 0
    for x in holding("eight ch") { n += x }
    assert n == 17 and Dropped == d + 2
}

# D18e: a generator a local holds, walked once in its block by a for-in or a comprehension and named nowhere else, is
# that walk's own - dropped as the local's block closes; walked twice, in a loop, or named again, it keeps D18b's path
HeldData := I64[3, 1, 4, 1, 5, 9, 2, 6]

fn heldEach(a Array<I64>&) Iterator<I64> {
    for x in a { yield x }
}

fn heldCompr() I64 {
    g := heldEach(HeldData)
    xs := I64[x * 2 for x in g if x > 2]
    return xs.Len() * 100 + xs[0]
}

fn heldTwice() I64 {
    t I64 = 0
    g := heldEach(HeldData)
    for x in g {
        t += x
        if x == 4 { break }
    }
    for x in g { t += 100 * x }
    return t
}

fn heldInLoop() I64 {
    t I64 = 0
    g := heldEach(HeldData)
    for _ in range 2 {
        for x in g {
            t += x
            if x == 1 { break }
        }
    }
    return t
}

fn heldEarly(k I64) I64 {
    g := heldEach(HeldData)
    if k > 0 { return -1 }
    t I64 = 0
    for x in g { t += x }
    return t
}

fn heldPassed() I64 {
    g := heldEach(HeldData)
    for x in g { if x == 4 { break } }
    return g.Sum()
}

fn heldDropped(t String&) I64 {
    g := holding(t)
    n I64 = 0
    for x in g {
        n += x
        break
    }
    return n
}

HeldBaked := heldCompr() * 1000000 + heldTwice() * 100 + heldInLoop()

test "D18e: a generator held in a local and walked once there is dropped as the local's block closes" {
    assert heldCompr() == 506 and heldTwice() == 2308 and heldInLoop() == 9
    assert heldEarly(0) == 31 and heldEarly(1) == -1 and heldPassed() == 23
    assert HeldBaked == 506 * 1000000 + 2308 * 100 + 9
    d := Dropped
    assert heldDropped("constant") == 8 and Dropped == d + 1
    for _ in range 1000 { assert heldCompr() == 506 }
}
