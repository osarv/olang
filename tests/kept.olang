# A local kept past its block or loop turn is built where it is kept (O28, O17, D9i - item 17): a new value each time its
# declaration runs, so the references a loop keeps each name their own turn's value. Each test reads them back after an
# arena churn (what a closed turn left would be written over), and the evaluator - its placement its own - decides the
# same values while compiling.

type P struct(x I64, y I64) {
    x, y
}

type H struct(p P&) {
    R P& = p
}

type VH struct(v Vec<I64>&) {
    V Vec<I64>& = v
}

type AH struct(a Array<I64>&) {
    A Array<I64>& = a
}

# what a closed scope left behind is written over
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i + "-" + $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn sumOf(hs Vec<H>&) I64 {
    s := 0
    for h in hs: s += h.R.x * 10 + h.R.y
    return s
}

# a struct local kept by reference every turn
fn everyTurn(n I64) Vec<H> {
    hs := Vec<H>()
    for i in range n {
        p := P(i, 1)
        hs.Push(H(p))
    }
    return hs
}

# kept on some turns only: the turns kept are each their own
fn someTurns(n I64) Vec<H> {
    hs := Vec<H>()
    for i in range n {
        p := P(i, 2)
        if i % 3 == 0: hs.Push(H(p))
    }
    return hs
}

# a Vec kept by a holder: its elements pushed after it is kept are seen through the holder
fn vecs(n I64) I64 {
    hs := Vec<VH>()
    for i in range n {
        v := Vec<I64>()
        hs.Push(VH(v))
        for j in range i + 1: v.Push(i * 100 + j)
    }
    churn()
    s := 0
    for h in hs: s += h.V.Len() * 1000 + h.V[h.V.Len() - 1]
    return s
}

# an array local lent whole to a holder
fn arrays(n I64) I64 {
    hs := Vec<AH>()
    for i in range n {
        a := Array<I64>(i + 1, i)
        hs.Push(AH(a))
    }
    churn()
    s := 0
    for h in hs: s += h.A.Len() * 100 + h.A[0]
    return s
}

# kept in an outer block that is itself a loop turn: each outer turn's values are its own, and gone with it
fn nested(n I64) I64 {
    total := 0
    for j in range n {
        hs := Vec<H>()
        for i in range 4 {
            p := P(i + j, j)
            hs.Push(H(p))
        }
        churn()
        total += sumOf(hs)
    }
    return total
}

# a local assigned whole after a reference to it is kept: the reference names the local's storage, which now holds the
# new value - still one storage per turn
fn reassigned(n I64) I64 {
    hs := Vec<H>()
    for i in range n {
        p := P(i, 0)
        hs.Push(H(p))
        p = P(i + 100, 0)
        assert p.x == i + 100
    }
    churn()
    return sumOf(hs)
}

# a local copied whole at its last mention into what outlives its turn is moved there (D9i): its text lives with it
fn rows(n I64) I64 {
    all := Vec<Vec<String&>>()
    for k in range n {
        rec := Vec<String&>()
        rec.Push($k + "-text")
        rec.Push($(k * 2))
        all.Push(rec)
    }
    churn()
    s := 0
    for r in all: s += r[0].Len() * 100 + r[1].Len()
    return s
}

# text a turn builds, converted and stored into a result (os.Args' shape): built where the result keeps it
fn texts(n I64) Array<String&> {
    out := Array<String&>(n, "")
    for i in range n {
        chars := Array<Char>(i + 1, 'a')
        chars[0] = 'z'
        out[i] = String(chars)
    }
    return out
}

fn textsSum(n I64) I64 {
    t := texts(n)
    churn()
    s := 0
    for x in t { s += x.Len() * 10 + (1 if x[0] == 'z' else 0) }
    return s
}

# a local given a call's value and another each turn, then stored into an element (O8f, docs/freeing.md 2.4): its old
# value let go of at each assignment, the store a copy - a Vec of text, and a struct holding text its constructor built
# in the callee (handed back directly or through a local), whose text a settle closed before
type Named struct(name String, n I64) {
    name
    n
}

fn Named.Of(i I64) Named { return Named("n" + $i + "-name", i) }

fn Named.Via(i I64) Named {
    r := Named("v" + $i + "-name", i)
    return r
}

fn words(i I64) Vec<String> {
    v Vec<String>
    for k in range 3: v.Push("w" + $(i + k))
    return v
}

fn secondValues(n I64) I64 {
    kept := Array<Vec<String>>(4)
    recs Vec<Named>
    for k in range 4: recs.Push(Named.Of(k))
    r := words(0)
    q := Named.Of(0)
    for i in range n {
        r = words(i)
        kept[i % 4] = r
        q = Named.Of(i)
        if i % 3 == 0: q = Named.Via(i + 1)
        recs[i % 4] = q
    }
    churn()
    s := 0
    for v in kept {
        for w in v: s += w.Len()
    }
    for x in recs: s += x.name.Len() * 100 + x.n + (1000000 if x.name[0] == 'v' else 0)
    return s + q.name.Len()
}

# the same for a struct holding a Vec of text beside its text (O8f, 2.4): its constructor's instance copied where the
# result goes, given a second value or declared in the loop, and read where it stands as an element (`v[j].n`)
type Labeled struct(name String, tags Vec<String>, n I64) {
    name
    tags
    n
}

fn Labeled.Of(i I64) Labeled {
    t Vec<String>
    for k in range 2: t.Push("t" + $(i + k))
    return Labeled("l" + $i + "-label", t, i)
}

fn labeledValues(n I64) I64 {
    outer Vec<Labeled>
    inner Vec<Labeled>
    for k in range 4 {
        outer.Push(Labeled.Of(k))
        inner.Push(Labeled.Of(k))
    }
    q := Labeled.Of(0)
    s := 0
    for i in range n {
        q = Labeled.Of(i)
        outer[i % 4] = q
        p := Labeled.Of(i + 10)
        inner[i % 4] = p
        s += outer[(i + 1) % 4].n + inner[(i + 2) % 4].tags.Len()
    }
    churn()
    for x in outer: s += x.name.Len() * 100 + x.tags[1].Len() * 10000
    for x in inner: s += x.name.Len() * 1000000 + x.n
    return s + q.tags[0].Len()
}

# O8f: a constructor's instance viewing two Maps it is given, copied where the result goes - each Map's parts in part
# regions of their own (free.viewCtor's parted, lower.ownersCopy), freed at the element's let-go
type TwoMaps struct(a Map<String, I64>, b Map<String, String>) {
    a
    b
}

fn TwoMaps.Of(i I64) TwoMaps {
    a Map<String, I64>
    b Map<String, String>
    for j in range 3 {
        a.Put("a" + $i + "-" + $j, i * 10 + j)
        b.Put("b" + $j, "v" + $i + "-" + $j)
    }
    return TwoMaps(a, b)
}

fn twoOwners(n I64) I64 {
    held Vec<TwoMaps>
    for k in range 4: held.Push(TwoMaps.Of(k))
    q := TwoMaps.Of(0)
    s := 0
    for i in range n {
        held[i % 4] = TwoMaps.Of(i)
        q = TwoMaps.Of(i + 1)
        held[(i + 2) % 4] = q
        s += held[(i + 1) % 4].a.Len() + q.b.Len()
    }
    churn()
    for x in held {
        for v in x.a.Values(): s += v
        s += (try x.b.Get("b2") catch default "").Len() * 1000
    }
    return s + (try q.a.Get("a" + $n + "-1") catch default -1)
}

# O8f (wt-copygaps): a view call's value read where it stands through a Len or a slice, beside a later piece replacing
# the element (lower.readHere, free.readCall), and a by-value argument's copy a callee hands back a view of, its parts in
# part regions of their own (lower.ownersCopy) - each element read back after a churn
type Tagged struct(name String, tags Vec<String>) {
    name
    tags
}

fn Tagged.Of(i I64) Tagged {
    t Vec<String>
    for k in range 2: t.Push("t" + $(i + k))
    return Tagged("n" + $i + "-name", t)
}

fn swapFirst(v mut Vec<Tagged>&, i I64) I64 {
    v[0] = Tagged.Of(i)
    return i
}

type Holder struct(v Vec<I64>) {
    v
}

fn viewOf(b Holder) Array<I64>& { return b.v.View() }

fn copyReads(n I64) I64 {
    v Vec<Tagged>
    for k in range 3: v.Push(Tagged.Of(k))
    out Vec<String>
    s := 0
    for i in range n {
        out.Push($v[0].name.Len() + " " + v[0].name[0:3] + " " + $swapFirst(v, i * 10) + " " + v[0].tags[1])
        v[i % 2 + 1] = Tagged.Of(i + 100)
        s += v[1].tags[0].Len() + v[2].name[1:3].Len()
        h := Holder(Vec<I64>[i, i + 1, i + 2])
        r := viewOf(h)
        h.v = Vec<I64>[7]
        s += r[2] * 1000 + h.v[0]
    }
    churn()
    for x in out: s += x.Len()
    return s + v[0].name.Len() * 100000 + v[1].tags[1].Len() * 1000000
}

# a struct held in place given a value each turn, its type holding a reference beside its owners (O8f, origins per
# path): the instance's local lets go of its leaves at its turn's end, the struct's old leaves at the store
type HP struct(a Vec<String>, b Vec<I64>, r String&) {
    a
    b
    r
}

type HO struct(inner HP, n I64) {
    inner
    n
}

fn heldRefs(n I64) I64 {
    base := "base"
    o := HO(HP(Vec<String>["h0", "h1"], Vec<I64>[0, 0, 0], base), 0)
    names Vec<String>
    s := 0
    for i in range n {
        q := HP(Vec<String>["q" + $i, "w" + $(i * 3)], Vec<I64>[i, i + 1], base)
        if i % 2 == 0: o.inner = q
        names.Push(o.inner.a[1] + q.a[0])
        s += o.inner.b[1] + q.b[0] * 10
    }
    churn()
    for x in names: s += x.Len() * 100
    return s + o.inner.a[0].Len() * 100000 + o.inner.r.Len() * 1000000
}

# a value local's copy and a call's value given to a constructor whose instance views them and is copied as the call
# returns (O8f, 2.4): built in the turn, read only until that copy is made, never where the instance's local lives
fn twoOf(i I64) Vec<I64> {
    v Vec<I64>
    v.Push(i)
    v.Push(i * 2)
    return v
}

fn keptArgs(n I64) I64 {
    base := "base"
    o := HO(HP(Vec<String>["k0", "k1"], Vec<I64>[0, 0, 0], base), 0)
    names Vec<String>
    s := 0
    for i in range n {
        a := Vec<String>["a" + $i, "z" + $(i * 5)]
        q := HP(a, twoOf(i), base)
        if i % 3 != 2: o.inner = q
        names.Push(o.inner.a[1] + q.a[0])
        s += o.inner.b[1] + q.b[0] * 10
    }
    churn()
    for x in names: s += x.Len() * 100
    return s + o.inner.a[1].Len() * 100000 + o.inner.r.Len() * 1000000
}

fn everyTurnSum(n I64) I64 {
    hs := everyTurn(n)
    churn()
    return sumOf(hs)
}

fn someTurnsSum(n I64) I64 {
    hs := someTurns(n)
    churn()
    return sumOf(hs)
}

test everyTurn "keeps each turn's local, each its own" {
    assert everyTurnSum(5) == 105
}

test someTurns "keeps the turns that keep it, each its own" {
    assert someTurnsSum(7) == 96
}

test vecs "keeps a Vec by reference and sees what is pushed after" {
    assert vecs(4) == 10606
}

test arrays "keeps an array lent whole" {
    assert arrays(3) == 603
}

test nested "keeps in an outer turn's block" {
    assert nested(3) == 312
}

test reassigned "keeps the local's storage, which a later assignment writes" {
    assert reassigned(3) == 3030
}

test rows "moves a whole local into what outlives its turn" {
    assert rows(4) == 2404
}

test texts "builds text where the result keeps it" {
    assert textsSum(4) == 104
}

# an enum case holding a by-value parameter that holds a reference, given to a local - declared as one, assigned one,
# or pushed into a local's collection (T17c, C2): the payload lives where its value does, so the local's references live
# where the parameter's do (lifted there, as a local kept is); writing through the payload's reference reaches the
# caller's
type Note struct() {
    seen := Vec<I64>()
}

type W struct(id I64, log mut Note&) {
    id, log
}

type Opt enum { None, Some(w W) }

fn caseLocals(w W, keep Bool) I64 {
    a := Opt.Some(w)
    b := Opt.None
    if keep: b = Opt.Some(w)
    ms := Vec<Opt>()
    for _ in range 3: ms.Push(Opt.Some(w))
    churn()
    n := 0
    if a == Opt.Some {
        a.w.log.seen.Push(a.w.id)
        n += a.w.id
    }
    if b == Opt.Some: n += b.w.id * 10
    for m in ms {
        if m == Opt.Some: n += m.w.id * 100
    }
    return n * 10 + w.log.seen.Len()
}

fn caseLocalsSum() I64 {
    t := Note()
    return caseLocals(W(2, t), true) + caseLocals(W(3, t), false)
}

# a joined task's clause default (P4a) built where the task's result would be - for two targets in the scope the call's
# result is given, and by a handler reading text it captured - each turn's kept in a long-lived Vec past its turn
type tdErr error { Odd }

fn tdTwo(i I64) Vec<String>, String ? tdErr {
    if i % 2 == 1: error tdErr.Odd
    return Vec<String>["v" + $i], "w" + $i
}

fn tdVec(i I64) Vec<String> ? tdErr {
    if i % 3 == 1: error tdErr.Odd
    return Vec<String>["u" + $i]
}

fn taskDefaults(n I64) String {
    kept Vec<Vec<String>>
    for _ in range 4: kept.Push(Vec<String>())
    bs := ""
    for i in range n {
        pre := "p" + $i
        a Vec<String>
        b String
        c Vec<String>
        join {
            spawn a, b = try tdTwo(i) catch default Vec<String>[pre + "a", pre], pre + "b"
            spawn c = try tdVec(i) catch default Vec<String>[pre + "c", pre]
        }
        kept[i % 4] = a if i % 2 == 1 else c
        bs += b
    }
    churn()
    out := bs
    for v in kept {
        out += ";"
        for x in v: out += x + ","
    }
    return out
}

test secondValues "lets go of a local's old value and copies its new one into an element" {
    assert secondValues(10) == 2002967
}

test labeledValues "copies a struct holding a Vec of text into an element each turn and reads elements where they stand" {
    assert labeledValues(10) == 36093319
}

test twoOwners "copies a constructor's instance of two Maps into an element each turn" {
    assert twoOwners(10) == 18253
}

test copyReads "reads elements where they stand beside their replacement, and views a by-value argument's copy" {
    assert copyReads(10) == 4865248
}

test heldRefs "gives a struct held in place, holding a reference beside its owners, a new instance each turn" {
    assert heldRefs(10) == 4205100
}

test keptArgs "gives a constructor whose instance is copied a value local's copy and a call's value each turn" {
    assert keptArgs(10) == 4305234
assert taskDefaults(8) == "w0p1bw2p3bw4p5bw6p7b;p4c,p4,;p5a,p5,;u6,;p7a,p7,"
}

# a clause's handler capturing a Vec of text made before the loop (P4a) - built at its join, or where the targets are
# where its default hands back the copy it captured - each turn's default kept in a long-lived Vec past its turn
fn taskCaptures(n I64) String {
    ov Vec<String>
    ov.Push("o")
    kept Vec<Vec<String>>
    for _ in range 3: kept.Push(Vec<String>())
    for i in range n {
        a Vec<String>
        b Vec<String>
        join {
            spawn a = try tdVec(i) catch default Vec<String>[ov[0] + $i, $ov.Len()]
            spawn b = try tdVec(i + 1) catch default ov
        }
        kept[i % 3] = a if i % 2 == 0 else b
    }
    churn()
    out := ""
    for v in kept {
        out += ";"
        for x in v: out += x + ","
    }
    return out
}

test taskCaptures "keeps tasks' clause defaults made by handlers capturing a Vec of text, past their turn" {
    assert taskCaptures(6) == ";o,;o4,1,;u6,"
}

test taskDefaults "keeps tasks' clause defaults, built where their results would be, past their turn" {
    assert taskDefaults(8) == "w0p1bw2p3bw4p5bw6p7b;p4c,p4,;p5a,p5,;u6,;p7a,p7,"
}

test caseLocals "gives locals an enum case holding a parameter's reference" {
    assert caseLocalsSum() == 15253 and secondValues(10) == 2002967
}

# the same, computed while compiling
assert everyTurnSum(5) == 105 and someTurnsSum(7) == 96 and vecs(4) == 10606 and arrays(3) == 603
assert nested(3) == 312 and reassigned(3) == 3030 and rows(4) == 2404 and textsSum(4) == 104
assert caseLocalsSum() == 15253 and secondValues(10) == 2002967
assert labeledValues(10) == 36093319 and twoOwners(10) == 18253 and copyReads(10) == 4865248
assert heldRefs(10) == 4205100
assert keptArgs(10) == 4305234
assert taskDefaults(8) == "w0p1bw2p3bw4p5bw6p7b;p4c,p4,;p5a,p5,;u6,;p7a,p7,"
assert taskCaptures(6) == ";o,;o4,1,;u6,"
