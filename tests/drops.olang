# O15, T13b: a value with a destructor is held by value in one place written for it - a variable, a parameter, a
# result, a field, a payload - and its destructor runs once, where its last holder lets go: a block's variable as the
# block is left, a by-value parameter's at the callee's end unless it handed the value on, a holder's parts with it, an
# old value where a store replaces it. A value nothing holds by value is held where its
# call lands (O16), as before.

import "std/deque"

# what the destructors saw, in order
type Tally struct() {
    seen := Vec<I64>()
}

fn (t Tally&) Text() String {
    b := StringBuilder()
    for x in t.seen { b.Push($x) }
    return b.ToString()
}

type Res unique struct(id I64, log mut Tally&) {
    id, log
} destruct { log.seen.Push(id) }

# a holder of one by value, with no destructor of its own: its part's runs with it
type Pair struct(a Res, b Res) {
    a, b
}

# a holder declaring Copy makes its part anew: no unique type, each copy a value of its own, ended by its own holder
type Kept struct(r Res) {
    r
}

fn (k Kept&) Copy() Kept { return Kept(Res(k.r.id + 100, k.r.log)) }

# a constructor that may fail ends the fields it built where it fails, the last first
type Two struct(a Res, n I64) ? Bad {
    a
    b Res = Res(n, a.log)
    if n > 5: error Bad
}

# a case carrying one
type Maybe enum {
    None
    Some(r Res)
}

fn take(r Res) I64 { return r.id }

fn give(r Res) Res { return r }

fn Res.make(id I64, log mut Tally&) Res { return Res(id, log) }

# handed on into a value made on one path only: the other's ends with the callee
fn wrapIf(r Res, keep Bool) I64 {
    if keep {
        k Res = give(r)
        return k.id
    }
    return 0
}

fn failing(r Res) ? Gone {
    if r.id > 0: error Gone
}

# the order the destructors run in, while compiling (K2) and running alike
fn order() String {
    t := Tally()
    take(Res(1, t))
    {
        k Res = give(Res(2, t))
        assert t.Text() == "1"
        k = Res.make(3, t)
        assert t.Text() == "12"
    }
    {
        p Pair = Pair(Res(4, t), Res(5, t))
        assert p.a.id == 4
    }
    wrapIf(Res(6, t), true)
    wrapIf(Res(7, t), false)
    try failing(Res(8, t)) catch Gone { }
    {
        d Res = Res(9, t)
        assert d.id == 9
    }
    assert t.Text() == "123546789"
    for i in range 2 {
        x Res = Res(10 + i, t)
        if i == 0: continue
    }
    return t.Text()
}

Order := order()

assert Order == "1235467891011", "decided while compiling: " $Order

test "a by-value holder's destructors run where it lets go, once each" {
    assert order() == "1235467891011"
    assert Order == order()
}

test "a value a call gave that nothing holds by value is held where the call lands (O16)" {
    t := Tally()
    {
        r := Res(1, t)
        assert r.id == 1 and t.Text() == ""
        Res.make(2, t)
        assert t.Text() == ""
    }
    assert t.Text() == "21" or t.Text() == "12"
}

test "a reference to a by-value variable is no holder" {
    t := Tally()
    {
        v Res = Res(3, t)
        w := v
        assert w.id == 3
    }
    assert t.Text() == "3"
}

test "a holder declaring Copy is no unique type: each copy its own, ended by its own holder" {
    t := Tally()
    {
        k Kept = Kept(Res(1, t))
        c := k
        assert c.r.id == 101 and t.Text() == ""
    }
    assert t.Text() == "1011"
}

test "a constructor failing part way ends the fields it built, the last first" {
    t := Tally()
    {
        x := try Two(Res(1, t), 9) catch default Two(Res(7, t), 3)!
        assert x.a.id == 7 and t.Text() == "91"
    }
    assert t.Text() == "9137"
}

# a holder declared in a join block lets go after the join's wait: its tasks still read it until then (bulk review 7,
# F2)
fn seenBy(r Res&) I64 {
    s := 0
    for i in range 200000 { s += i % 7 }
    return r.id + s - s + r.log.seen.Len() * 1000
}

fn joinHeld() I64 {
    t := Tally()
    n := 0
    join {
        x Res = Res(1, t)
        spawn n = seenBy(x)
    }
    return n * 10 + t.seen.Len()
}

test seenBy "reads a join block's holder while its task runs, ended after the wait" {
    assert joinHeld() == 11
}
assert joinHeld() == 11

# a holder whose storage flows out of its function - returned as a reference, held by a returned value's reference
# field, pushed by reference into a parameter's collection, captured by a returned closure - lets go where that storage
# lives, as a call's value no slot takes is held where it lands (O16), never at the function's end (bulk review 7, F4)
type RefTo struct(r Res&) {
    r
}

type Shelf struct() {
    items := Vec<Res&>()
}

fn Res.mkRef(n I64, t mut Tally&) Res& {
    x Res = Res(n, t)
    return x
}

fn RefTo.wrapRef(n I64, t mut Tally&) RefTo {
    x Res = Res(n, t)
    return RefTo(x)
}

fn shelve(s mut Shelf&, n I64, t mut Tally&) {
    x Res = Res(n, t)
    s.items.Push(x)
}

fn closeOver(n I64, t mut Tally&) fn&() I64 {
    x Res = Res(n, t)
    return fn() I64 { return x.id }
}

fn flowedOut() String {
    t := Tally()
    seen := ""
    {
        a := Res.mkRef(5, t)
        b := RefTo.wrapRef(6, t)
        s := Shelf()
        shelve(s, 7, t)
        f := closeOver(8, t)
        seen = $a.id $b.r.id $s.items[0].id $f() "/" $t.Text()
    }
    return $seen "/" $t.Text()
}

test Res.mkRef "ends a holder whose storage flowed out where that storage lives" {
    assert flowedOut() == "5678//8765"
}

# (decided only at run time: the values flowing out are registered where they land, which the evaluator refuses
# while compiling - K2c)

# a by-value parameter handed on as an argument lets go of its value only once the call is made: a later argument
# leaving first - an error passed on, a clause's return - leaves the value with it, ended as it is (bulk review 7, F3)
fn eat(r Res, n I64) I64 { return r.id + n }

fn count(bad Bool) I64 ? Gone {
    if bad: error Gone
    return 4
}

fn handOver(r Res, bad Bool) I64 ? Gone { return eat(r, try count(bad)) }

fn handOverClause(r Res, bad Bool) I64 { return eat(r, try count(bad) catch Gone { return -1 }) }

fn leftBehind() String {
    t := Tally()
    try handOver(Res(1, t), true) catch Gone { }
    a := t.Text()
    handOverClause(Res(2, t), true)
    b := t.Text()
    handOverClause(Res(3, t), false)
    return $a "/" $b "/" $t.Text()
}

test handOver "ends a value handed on to a call that is never made" {
    assert leftBehind() == "1/12/123"
}

LeftBehind := leftBehind()

assert LeftBehind == "1/12/123", "decided while compiling: " $LeftBehind

# a requirement failing the call ends the by-value parameters it took (D17; bulk review 7, F10)
type Guarded struct(r Res, n I64) [n > 0] ? {
    r
}

fn guarded(r Res, n I64) [n > 0] I64 ? { return r.id }

fn refused() String {
    t := Tally()
    k := try guarded(Res(3, t), 0) catch ArgumentError default -1
    a := t.Text()
    {
        g Guarded = try Guarded(Res(1, t), 0) catch ArgumentError default Guarded(Res(2, t), 1)!
        a = $a "/" $t.Text() "/" $g.r.id
    }
    return $k "/" $a "/" $t.Text()
}

test guarded "ends what a failed requirement's call was given" {
    assert refused() == "-1/3/31/2/312"
}

Refused := refused()

assert Refused == "-1/3/31/2/312", "decided while compiling: " $Refused

# a store over a holder - or a declaration - from what a try, a "!" or a catch default gives is a fresh value, as from
# the call alone: the old value ended after the new one is made (bulk review 7, F14)
fn Res.mkFresh(id I64, bad Bool, t mut Tally&) Res ? Gone {
    if bad: error Gone
    return Res(id, t)
}

fn storedOver() String {
    t := Tally()
    {
        x Res = Res(1, t)
        x = Res.mkFresh(2, false, t)!
        x = try Res.mkFresh(3, true, t) catch Gone default Res(4, t)
        y Res = try Res.mkFresh(5, true, t) catch Gone default Res(6, t)
        x = try Res.mkFresh(7, false, t) catch Gone default Res(8, t)
        assert x.id == 7 and y.id == 6
    }
    return t.Text()
}

test Res.mkFresh "stores over a holder what a try gives" {
    assert storedOver() == "12467"
}

StoredOver := storedOver()

assert StoredOver == "12467", "decided while compiling: " $StoredOver

# a holder left by a return, an error left with the holder returned instead, and a holder given a new value in a block
# and in a loop: each ends only what it holds when it lets go
fn deferredEnd(id I64, t mut Tally&) I64 {
    x Res = Res(id, t)
    return x.id
}

fn Res.opened(id I64, bad Bool, t mut Tally&) Res ? Gone {
    x Res = Res(id, t)
    if bad: error Gone
    return x
}

fn ended() String {
    t := Tally()
    n := deferredEnd(1, t)
    {
        a Res = try Res.opened(2, false, t) catch Gone default Res(0, t)
        b Res = try Res.opened(3, true, t) catch Gone default Res(4, t)
        n += a.id + b.id
    }
    {
        y Res = Res(5, t)
        y = Res(6, t)
        for i in range 2 { y = Res(7 + i, t) }
        assert y.id == 8
    }
    return $n "/" $t.Text()
}

test deferredEnd "ends a held value as its function is left, and a holder given a new one" {
    assert ended() == "7/13425678"
}

Ended := ended()

assert Ended == "7/13425678", "decided while compiling: " $Ended

# a by-value parameter handed on on every path lets go of nothing at its end: effects read a holder's drop where its
# flag may be set (A5), so a holder's declared Copy may call such a function - and one handing it on in one branch only
# runs its destructor on the other (G42's facts say so)
type Wrapped struct(r Res) {
    r
}

fn Wrapped.wrapOn(r Res) Wrapped { return Wrapped(r) }

fn (w Wrapped&) Copy() Wrapped { return Wrapped.wrapOn(Res(w.r.id + 50, w.r.log)) }

fn wrappedCopies() String {
    t := Tally()
    {
        a Wrapped = Wrapped(Res(1, t))
        b := a
        assert b.r.id == 51
    }
    return t.Text()
}

test Wrapped.wrapOn "hands its parameter on, so a declared Copy may call it" {
    assert wrappedCopies() == "511"
}

assert wrappedCopies() == "511", "decided while compiling"

Ends mut I64 = 0

type GRes unique struct(id I64) {
    id
} destruct { Ends += id }

type GHeld struct(r GRes) {
    r
}

fn GHeld.gEvery(r GRes, keep Bool) GHeld {
    if keep: return GHeld(r)
    return GHeld(r)
}

fn gSome(r GRes, keep Bool) I64 {
    if keep {
        h GHeld = GHeld(r)
        return h.r.id
    }
    return 0
}

assert not GHeld.gEvery.WritesGlobals and gSome.WritesGlobals, "decided while compiling (G42)"

test gSome "runs its parameter's destructor where it does not hand it on" {
    Ends = 0
    assert gSome(GRes(3), true) == 3 and Ends == 3
    assert gSome(GRes(4), false) == 0 and Ends == 7
    {
        h := GHeld.gEvery(GRes(5), false)
        assert h.r.id == 5 and Ends == 7
    }
    assert Ends == 12
}

# a destructor calling a method that builds through the instance's reference field (a Vec there grown - C1): the field's
# referent outlives the instance, which may be made in an inner block or a loop's turn; what the method builds goes to
# a scope that outlives the referent (the program's - where that lives exists at no run time in the destructor), as the
# same write written inline already did
fn (t mut Tally&) Saw(id I64) { t.seen.Push(id) }

type Logged unique struct(id I64, log mut Tally&) {
    id, log
} destruct { log.Saw(id) }

fn churn() I64 {
    n := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        n += s.Len() + a[3]
    }
    return n
}

fn logged() String {
    t := Tally()
    {
        a Logged = Logged(1, t)
        assert a.id == 1
    }
    for k in range 2, 40 {
        b Logged = Logged(k, t)
        assert b.id == k
    }
    churn()
    s := 0
    for x in t.seen { s += x }
    return $t.seen.Len() "/" $s
}

test Logged "builds through its field from its destructor, the instance made in an inner block" {
    assert logged() == "39/780"
}

assert logged() == "39/780", "decided while compiling"

# a by-value holder given a constructor's value holding a by-value parameter that holds a reference (C3), and a local
# declared as an enum case holding one (T17c, C2): the holder's and the local's references live where the parameter's
# do, their own storage and their destructors where they are - each ended at its function's end
type HeldTwo struct(r Res, n I64) {
    r, n
}

fn heldTwo(r Res) I64 {
    h HeldTwo = HeldTwo(r, 4)
    return h.n + h.r.id
}

fn caseHeld(r Res) I64 {
    m := Maybe.Some(r)
    return m.r.id * 10 if m == Maybe.Some else 0
}

fn heldTwos() String {
    t := Tally()
    s := 0
    for k in range 1, 4 {
        s += heldTwo(Res(k, t))
        s += caseHeld(Res(k + 3, t))
    }
    churn()
    return $s "/" $t.Text()
}

test heldTwo "holds a parameter's reference where the parameter's references live, ended at its end" {
    assert heldTwos() == "168/142536"
}

assert heldTwos() == "168/142536", "decided while compiling"

# ---- collections holding values with destructors by value (C11, O15) ----
# A Vec, a Map, a Deque of values with destructors is unique as they are and ends them: a removal that gives nothing
# ends what it removes, one that gives hands the value out, a store over an element ends the old one, growth moves and
# ends nothing, and the holder letting go of the collection ends its live elements, the last first - decided while
# compiling (by-value holders, so nothing waits for a scope to close) as at run time

fn (t Tally&) Listed() String {
    b := StringBuilder()
    for i in range t.seen.Len() {
        if i > 0: b.Push(".")
        b.Push($t.seen[i])
    }
    return b.ToString()
}

fn vecEnds() String {
    t := Tally()
    {
        v Vec<Res> = Vec<Res>()
        for i in range 6 { v.Push(Res(i, t)) }
        p Res = v.Pop()!
        v.RemoveAt(1)!
        q Res = v.TakeAt(0)!
        v.SwapRemove(0)!
        v.Insert(0, Res(6, t))!
        v[2] = Res(7, t)
        r Res = v.SwapTake(0)!
        v.Push(Res(8, t))
        v.Push(Res(9, t))
        v.Truncate(2)
        assert p.id == 5 and q.id == 0 and r.id == 6 and v[0].id == 7 and v.Ref(1).id == 4
    }
    {
        w Vec<Res> = Vec<Res>()
        for i in range 10, 13 { w.Push(Res(i, t)) }
        w.Clear()
        w.Push(Res(13, t))
    }
    return t.Listed()
}

VecEnds := vecEnds()
assert VecEnds == "1.2.3.9.8.6.0.5.4.7.12.11.10.13", "decided while compiling: " $VecEnds

test vecEnds "ends what a Vec of destructor values removes, the last first, and every element where it is let go" {
    assert vecEnds() == "1.2.3.9.8.6.0.5.4.7.12.11.10.13"
}

fn mapEnds() String {
    t := Tally()
    {
        m Map<String, Res> = Map<String, Res>()
        m.Put("a", Res(1, t))
        m.Put("b", Res(2, t))
        m.Put("c", Res(3, t))
        m.Put("d", Res(4, t))
        m.Put("b", Res(5, t))
        m.Remove("a")
        x Res = m.Take("c")!
        m.Put("e", Res(6, t))
        assert x.id == 3 and m.Ref("e")!.id == 6 and m.Len() == 3
    }
    {
        n Map<I64, Res> = Map<I64, Res>()
        for k in range 3 { n.Put(k, Res(7 + k, t)) }
        n.Remove(1)
        n.Clear()
        n.Put(5, Res(10, t))
    }
    return t.Listed()
}

MapEnds := mapEnds()
assert MapEnds == "2.1.3.4.6.5.8.9.7.10", "decided while compiling: " $MapEnds

test mapEnds "ends what a Map of destructor values removes or replaces, and its live entries where it is let go" {
    assert mapEnds() == "2.1.3.4.6.5.8.9.7.10"
}

fn dequeEnds() String {
    t := Tally()
    {
        d deque.Deque<Res> = deque.Deque<Res>()
        for i in range 20, 23 { d.PushBack(Res(i, t)) }
        d.PushFront(Res(19, t))
        f Res = d.PopFront()!
        b Res = d.PopBack()!
        d[0] = Res(23, t)
        for i in range 24, 34 { d.PushBack(Res(i, t)) }
        assert f.id == 19 and b.id == 22 and d.Len() == 12
    }
    {
        e deque.Deque<Res> = deque.Deque<Res>()
        e.PushBack(Res(40, t))
        e.PushFront(Res(41, t))
        e.Clear()
        e.PushBack(Res(42, t))
    }
    return t.Listed()
}

DequeEnds := dequeEnds()
assert DequeEnds == "20.22.19.33.32.31.30.29.28.27.26.25.24.21.23.40.41.42", "decided while compiling: " $DequeEnds

test dequeEnds "a Deque of destructor values ends its ring back to front, and what Clear removes" {
    assert dequeEnds() == "20.22.19.33.32.31.30.29.28.27.26.25.24.21.23.40.41.42"
}

# collections in collections and in values: each part let go with its holder, the last first
type Pool struct() {
    files Vec<Res>
}

type Boxed<T> struct(v T) {
    v
}

fn nestedEnds() String {
    t := Tally()
    {
        p Pool = Pool()
        p.files.Push(Res(1, t))
        p.files.Push(Res(2, t))
        bx Boxed<Res> = Boxed<Res>(Res(3, t))
        vv Vec<Vec<Res>> = Vec<Vec<Res>>()
        vv.Push(Vec<Res>())
        vv.RefMut(0).Push(Res(4, t))
        vv.RefMut(0).Push(Res(5, t))
        vv.Push(Vec<Res>())
        vv.RefMut(1).Push(Res(6, t))
        mv Map<I64, Vec<Res>> = Map<I64, Vec<Res>>()
        mv.Put(1, Vec<Res>())
        mv.RefMut(1)!.Push(Res(7, t))
        mv.Put(1, Vec<Res>())
        assert vv[0][1].id == 5 and bx.v.id == 3 and p.files[1].id == 2 and t.Listed() == "7"
    }
    return t.Listed()
}

NestedEnds := nestedEnds()
assert NestedEnds == "7.6.5.4.3.2.1", "decided while compiling: " $NestedEnds

test nestedEnds "a collection held in a collection or a value is let go with its holder" {
    assert nestedEnds() == "7.6.5.4.3.2.1"
}

# a Vec of them ended at its function's end, handed to a by-value parameter (ended at the callee's end), returned (the caller's)
fn destroyedVec(t mut Tally&) {
    w Vec<Res> = Vec<Res>()
    w.Push(Res(1, t))
    w.Push(Res(2, t))
}

fn madeVec(n I64, from I64, t mut Tally&) Vec<Res> {
    v Vec<Res> = Vec<Res>()
    for i in range n { v.Push(Res(from + i, t)) }
    return v
}

fn consumedVec(v Vec<Res>) I64 { return v.Len() }

fn passedVecs() String {
    t := Tally()
    destroyedVec(t)
    t.seen.Push(0)
    n := consumedVec(madeVec(3, 3, t))
    t.seen.Push(0)
    {
        k Vec<Res> = madeVec(2, 6, t)
        assert k[1].id == 7 and n == 3
    }
    return t.Listed()
}

PassedVecs := passedVecs()
assert PassedVecs == "2.1.0.5.4.3.0.7.6", "decided while compiling: " $PassedVecs

test destroyedVec "a Vec of destructor values ended by its function, by its by-value parameter, by its caller" {
    assert passedVecs() == "2.1.0.5.4.3.0.7.6"
}

# what the elements hold, built in a loop, read back after an arena churn - and ended once each
type Named unique struct(name String, log mut Tally&) {
    name, log
} destruct { log.seen.Push(name.Len()) }

fn namedKept() String {
    t := Tally()
    b := StringBuilder()
    {
        v Vec<Named> = Vec<Named>()
        for i in range 5 { v.Push(Named($i "-" $(i * 11), t)) }
        churn()
        for x in v {
            b.Push(x.name)
            b.Push(" ")
        }
    }
    churn()
    return $b.ToString() "/" $t.Listed()
}

test Named "a Vec of destructor values built in a loop reads its elements back after a churn" {
    assert namedKept() == "0-0 1-11 2-22 3-33 4-44 /4.4.4.4.3"
}

assert namedKept() == "0-0 1-11 2-22 3-33 4-44 /4.4.4.4.3", "decided while compiling"

# the effect summaries see a collection's elements ended (G42): where its holder lets go, not where it hands it on
fn gVecHeld(r GRes) I64 {
    v Vec<GRes> = Vec<GRes>()
    v.Push(r)
    return v.Len()
}

fn gVecGiven(r GRes) Vec<GRes> {
    v Vec<GRes> = Vec<GRes>()
    v.Push(r)
    return v
}

assert gVecHeld.WritesGlobals and not gVecGiven.WritesGlobals, "decided while compiling (G42)"

# a store over a value with destructors reached through what a call gives: the call made once, the old value ended
# through what it gave, then the new one stored (O15; a checker gap until 2026-11-07)
type BoxR struct(r Res) {
    r
}

fn getBox(b mut BoxR&) mut BoxR& { return b }

fn throughCall() String {
    t := Tally()
    {
        b BoxR = BoxR(Res(1, t))
        getBox(b).r = Res(3, t)
        assert b.r.id == 3 and t.Listed() == "1"
    }
    return t.Listed()
}

ThroughCall := throughCall()
assert ThroughCall == "1.3", "decided while compiling: " $ThroughCall

test getBox "a store over a holder's part through what a call gives ends the old value, once" {
    assert throughCall() == "1.3"
}

# a by-value holder declared in a loop's body: each turn declares it anew and ends it at the turn's end
fn loopDestroyed() String {
    t := Tally()
    for i in range 3 {
        x Res = Res(i, t)
        assert x.id == i
    }
    return t.Listed()
}

LoopDestroyed := loopDestroyed()
assert LoopDestroyed == "0.1.2", "decided while compiling: " $LoopDestroyed

test loopDestroyed "ends a holder its loop's body declares, every turn" {
    assert loopDestroyed() == "0.1.2"
}

# ---- holders ended before what they hold (O15, QCZ) ----

# a value with a destructor that says, at its end, whether it was still open - read by what holds it
type Lamp unique struct(id I64, log mut Tally&) {
    id, log
    open := true
} destruct {
    log.seen.Push(id)
    open = false
}

# holds a reference to a Lamp and nothing else, so its references live where it does: at its end it reads the Lamp
# (ten times its id, one more where the Lamp was still open)
type Grip unique struct(id I64) {
    id
    held Lamp?& = null
} destruct {
    if held is not null: held!.log.seen.Push(id * 10 + (1 if held!.open else 0))
}

fn (g mut Grip&) Hold(l Lamp&) { g.held = l }

# holds a reference to a shelf, which holds references to Lamps: at its end it reads each
type Rack unique struct(id I64) {
    id
    shelf Lamps?& = null
} destruct {
    if shelf is null: return
    for l in shelf!.items { l.log.seen.Push(id * 10 + (1 if l.open else 0)) }
}

type Lamps struct() {
    items := Vec<Lamp&>()
}

# holds a function value, called at its end
type Hook unique struct(id I64) {
    id
    then fn?&() = null
} destruct {
    if then is not null: then!()
}

# can hold no reference at all: given beside a Lamp, it holds none
type Stone unique struct(id I64, log mut Tally&) {
    id, log
} destruct { log.seen.Push(id) }

fn touch(s mut Stone&, l Lamp&) { s.id += l.id - l.id }

fn holders() String {
    t := Tally()
    {
        g Grip = Grip(1)
        l Lamp = Lamp(2, t)
        g.held = l
    }
    {
        g Grip = Grip(3)
        l Lamp = Lamp(4, t)
        g.Hold(l)
    }
    {
        g Grip = Grip(5)
        defer t.seen.Push(9)
        l Lamp = Lamp(6, t)
        g.held = l
    }
    {
        k Rack = Rack(7)
        s := Lamps()
        k.shelf = s
        l Lamp = Lamp(8, t)
        s.items.Push(l)
    }
    {
        h Hook = Hook(1)
        l Lamp = Lamp(2, t)
        h.then = fn() { l.log.seen.Push(30 + (1 if l.open else 0)) }
    }
    {
        l Lamp = Lamp(4, t)
        g Grip = Grip(5)
        g.held = l
    }
    {
        s Stone = Stone(6, t)
        l Lamp = Lamp(7, t)
        touch(s, l)
    }
    return t.Listed()
}

HoldersEnded := holders()
assert HoldersEnded == "11.2.31.4.9.51.6.71.8.31.2.51.4.7.6", "decided while compiling: " $HoldersEnded

test "a holder is ended before what it holds - stored, through a call, past deferred code, through a shelf, in a closure" {
    assert holders() == "11.2.31.4.9.51.6.71.8.31.2.51.4.7.6"
    assert HoldersEnded == holders()
}

# ---- holders in collections, and values registered with a scope (O15, O16; bulk review 8, F2) ----

# a collection held by value whose elements hold references to a variable of its block is ended before it - an element
# reached through RefMut, a Map's value, a call given both; registered with the scope (`gs := Vec<Grip>()`) it would be
# ended after its block's variables, which is O15's error naming this by-value form (checks' o15registered*). Values
# registered with one scope end the last registered first, so one holding a value registered before it needs nothing
fn gripsHeld() String {
    t := Tally()
    {
        gs Vec<Grip> = Vec<Grip>()
        gs.Push(Grip(1))
        l Lamp = Lamp(2, t)
        gs[0].held = l
    }
    {
        ms Map<I64, Grip> = Map<I64, Grip>()
        ms.Put(1, Grip(3))
        l Lamp = Lamp(4, t)
        ms.RefMut(1)!.held = l
    }
    {
        gs Vec<Grip> = Vec<Grip>()
        gs.Push(Grip(5))
        l Lamp = Lamp(6, t)
        set := fn(x mut Vec<Grip>&, y Lamp&) { x.RefMut(0).held = y }
        set(gs, l)
    }
    return t.Listed()
}

GripsHeld := gripsHeld()
assert GripsHeld == "11.2.31.4.51.6", "decided while compiling: " $GripsHeld

test gripsHeld "ends a collection by value before what its elements hold" {
    assert gripsHeld() == "11.2.31.4.51.6"
}

# (registered values end at their scope's close, which the evaluator does not run while compiling - K2c - so this one
# is held to the run time and to interpret alone)
fn registeredHeld() String {
    t := Tally()
    {
        l := Lamp(8, t)
        g := Grip(7)
        g.held = l
    }
    return t.Listed()
}

test registeredHeld "ends a registered holder before a value registered before it" {
    assert registeredHeld() == "71.8"
}

# ---- a hand-on in deferred code (T13b; bulk review 8, F4) ----

# deferred code runs after everything, so a by-value parameter handed on there is handed on at its last mention: once,
# on every way out - an errdefer's only where an error leaves, the parameter ended at the callee's end otherwise
fn deferPush(v mut Vec<Res>&, r Res) { defer v.Push(r) }

type Late error { No }

fn errdeferPush(v mut Vec<Res>&, r Res, fail Bool) ? {
    errdefer v.Push(r)
    if fail: error Late.No
}

fn deferredHandOn() String {
    t := Tally()
    {
        v Vec<Res> = Vec<Res>()
        deferPush(v, Res(1, t))
        try errdeferPush(v, Res(2, t), false) catch { }
        try errdeferPush(v, Res(3, t), true) catch { }
        t.seen.Push(0)
    }
    return t.Text()
}

DeferredHandOn := deferredHandOn()
assert DeferredHandOn == "2031", "decided while compiling: " $DeferredHandOn

test deferPush "hands its by-value parameter on from deferred code, once" {
    assert deferredHandOn() == "2031"
}
