# jpeg decoding against libjpeg's own decode (PIL, tests/embedded/img/jpeg_*.jpg with jpeg_*.raw: the 53x37 image its
# decoder gave, 8 bits a channel): baseline and progressive, 4:4:4, 4:2:2 and 4:2:0, greyscale, restart intervals,
# optimized tables. The decoder uses libjpeg's integer IDCT, upsampling and colour formulas, so the differences stay tiny.

import "std/jpeg"
import "std/pair"

# the mean and the largest absolute difference (the mean in hundredths) between the decoded file and want
fn diff(file Array<U8>&, want Array<U8>&, channels I64) pair.Pair<I64, I64> {
    img := try jpeg.Decode(file) catch jpeg.Error { return pair.Pair<I64, I64>(-1, -1) }
    if img.Width != 53 or img.Height != 37 or img.Channels != channels or img.Pixels.Len() != want.Len(): return pair.Pair<I64, I64>(-1, -1)
    sum I64 = 0
    worst I64 = 0
    for i in range want.Len() {
        e := (I64(img.Pixels[i]) - I64(want[i])).Abs()
        sum += e
        worst = worst.Max(e)
    }
    return pair.Pair<I64, I64>(sum * 100 / want.Len(), worst)
}

test "jpeg 444b" {
    d := diff(embed "embedded/img/jpeg_444b.jpg", embed "embedded/img/jpeg_444b.raw", 3)
    assert d.First >= 0 and d.First < 10 and d.Second <= 1
}
test "jpeg 444p" {
    d := diff(embed "embedded/img/jpeg_444p.jpg", embed "embedded/img/jpeg_444p.raw", 3)
    assert d.First >= 0 and d.First < 10 and d.Second <= 1
