test "files that are no JPEG, cut, or in a format not read" {
    f := embed "embedded/img/jpeg_420b.jpg"
    try jpeg.Decode(Array<U8>[1, 2, 3, 4, 5]) catch jpeg.Error.NotJpeg { }
    try jpeg.Decode(f[:f.Len() / 2]) catch jpeg.Error.Truncated { }
    bad := Array<U8>(f.Len())
    for i in range f.Len(): bad[i] = f[i]
    for i in range f.Len() - 1 {
        if bad[i] == 0xFF and bad[i + 1] == 0xC0 { bad[i + 1] = 0xC9 }
    }
    try jpeg.Decode(bad) catch jpeg.Error.Unsupported { return }
    assert false
}

test "corrupt entropy data does not crash" {
    f := embed "embedded/img/jpeg_420p.jpg"
    bad := Array<U8>(f.Len())
    for i in range f.Len(): bad[i] = f[i] ^ U8(i * 7 % 5 if i > 600 else 0)
    img := try jpeg.Decode(bad) catch jpeg.Error { return }
    assert img.Width == 53
}
