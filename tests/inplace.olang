# D9h (docs/rework.md sections 17 and 18): a value holding views in place of the copy it would be - a value result
# viewing what a function is given, a walk's elements, a built result read where it stands - where nothing could tell
# the two apart: what it views changes by nothing while it lives. Each test writes what a value was made from where it
# may, after it was made, and reads the value back after an arena churn: it must read as its own copy.

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

fn settle() I64 {
    s I64 = 0
    for i in range 1, 50 { s += churn(i * 8) }
    return s
}

# the words of a text, counted by their lengths: the pieces and each walk's element read where they stand
fn letters(t String&) I64 {
    n I64 = 0
    for w in t.Split(" ") { n += w.Len() }
    return n
}

fn lineLengths(t String&) I64 {
    n I64 = 0
    for l in t.Lines() { n += l.Len() * 10 }
    return n
}

fn total(a Array<I64>&) I64 {
    s I64 = 0
    it := a.Iter()
    for x in it { s += x }
    return s + a.Iter().Fold(I64(0), fn(acc I64, x I64) I64 { return acc + x })
}

# a piece kept past the text it was cut from changing: its own copy (text that changes is an Array<Char>, a String never
# does - T13a - so its pieces are cut by Windows)
fn firstWord(t Array<Char>&) Array<Char> {
    ps := t.Windows(3)
    return ps[0]
}

test letters "reads Split's pieces and walks over them where they stand" {
    assert letters("a bb ccc") == 6 and lineLengths("x\nyy\n") == 30 and total(I64[1, 2, 3]) == 12
}

test firstWord "a piece handed back is a copy the caller keeps" {
    t Array<Char> = $"one two"
    w := firstWord(t)
    t[0] = 'O'
    assert settle() > 0 and w == "one" and t == "One two"
}

test letters "elements of an array of text written in the walk are the elements as they were" {
    t := $"aa bb"
    ps := t.Split(" ")
    n I64 = 0
    for p in ps {
        ps[1] = "z"
        n += p.Len()
    }
    assert settle() > 0 and n == 3 and ps[1] == "z"
}

test letters "pieces kept in a Vec are its own" {
    t Array<Char> = $"pqr"
    kept := Vec<Array<Char>>()
    for w in t.Windows(1) { kept.Push(w) }
    t[0] = 'P'
    assert settle() > 0 and kept.Len() == 3 and kept[0] == "p" and kept[2] == "r"
}

test total "a built result read where it stands, then kept as a copy" {
    v := Vec<I64>()
    v.Push(4)
    v.Push(5)
    a := v.ToArray()
    s := a.Iter().Fold(I64(0), fn(acc I64, x I64) I64 { return acc + x })
    v[0] = 40
    assert settle() > 0 and s == 9 and a[0] == 4
}

# the evaluator's reading (K2: baked while compiling) - it copies wherever the run time reads in place, so the two agree
Baked I64 = letters("a bb ccc") + lineLengths("x\nyy\n") + total(I64[1, 2, 3])
assert Baked == 48

KeptWord Array<Char> = firstWord("one two")
assert KeptWord == "one"

test letters "the run time agrees with what the evaluator baked" {
    assert Baked == letters("a bb ccc") + lineLengths("x\nyy\n") + total(I64[1, 2, 3]) and KeptWord == firstWord("one two")
}

type Kid struct(w I64) {
    w
    kids Vec<I32> = Vec<I32>()
}

type Tree struct() {
    nodes Vec<Kid> = Vec<Kid>()
}

fn (t mut Tree&) add(w I64) I32 {
    t.nodes.Push(Kid(w))
    return I32(t.nodes.Len() - 1)
}

fn (t mut Tree&) child(p I32, w I64) I32 {
    c := t.add(w)
    t.nodes[p].kids.Push(c)
    return c
}

fn kidSum(t Tree&) I64 {
    s := 0
    for n in t.nodes {
        for k in n.kids: s += t.nodes[k].w
    }
    return s
}

fn grown() I64 {
    t := Tree()
    t.add(1)
    for k in range 20: t.nodes[0].kids.Push(t.add(k))
    t.child(1, 100)
    return kidSum(t) * 1000 + t.nodes[0].kids.Len()
}

test Tree.child "pushes onto a field of an element in place, an argument that grows the collection taken first" {
    t := Tree()
    t.add(1)
    for k in range 10: t.child(I32(k % 3), k)
    assert t.nodes[0].kids.Len() == 4 and t.nodes[1].kids.Len() == 3 and t.nodes[2].kids.Len() == 3
    assert grown() == 290020, $grown()
}

# the evaluator, which takes the element in place as the run time does, decides the same
assert grown() == 290020
