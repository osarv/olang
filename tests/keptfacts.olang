# G42's count of a value local kept past its block (typed.RefsKept.Kept) - only where something may keep it: a callee
# writing through what it is lent, a fixed array given as an array reference, a part sliced for a lane operator, a
# parameter or an outer local given a task its join waits for, a value built of a reference to it and only read - none
# keeps it, and the facts say so; where a callee or the value built keeps it, they do (oann's kernels and settle)

type lanes struct() {
    v := Array<F32>(16)
}

fn step(acc mut lanes&, n I64) {
    for j in range n: acc.v[j] = acc.v[j] + 1.0
}

fn lent(n I64) F32 {
    acc := lanes()
    step(acc, n)
    return acc.v[0]
}

# a fixed array given as an array of run-time length, read through slices a lane operator adds
fn total8(v Array<F32>&) F32 {
    h := v[0:4] + v[4:8]
    return h[0] + h[1] + h[2] + h[3]
}

fn fill8(a mut Array<F32>&) {
    for j in range 8: a[j] = F32(j)
}

fn converted() F32 {
    acc := Array<F32>(8)
    fill8(acc)
    return total8(acc)
}

# a parameter and an outer local given tasks the join waits for
type opd struct(d Array<F32>&, ld I64) {
    d
    ld
}

fn rows(sa opd, lo I64, bk lanes&, ap mut Array<F32>&) {
    ap[lo] = sa.d[lo] + F32(sa.ld) + bk.v[0]
}

fn inTasks(sa opd, tasks I64, ap mut Array<F32>&) {
    bk := lanes()
    join {
        for t in range tasks: spawn rows(sa, t, bk, ap)
    }
}

# a value made of a reference to a local, only read: the view a constructor builds and a reader takes
type mt struct(Data mut Array<F32>&, Off I64) {
    Data
    Off
}

fn read(m mt&) F32 { return m.Data[m.Off] }

fn fwd(s mut Array<F32>&) F32 {
    from := mt(s, 1)
    return read(from)
}

fn viewed(x F32) F32 {
    acc := Array<F32>(8)
    acc[1] = x
    return fwd(acc)
}

assert not lent.Allocates, "a local lent to a body writing through it allocates"
assert not converted.Allocates, "a fixed array given as an array reference allocates"
assert not inTasks.Allocates, "a parameter or an outer local given a joined task allocates"
assert not viewed.Allocates, "a local a value only read is built of allocates"

# the place an atomic or E39's LaneDots writes - a lane of a field reached through a mut parameter, a slice of it, an
# array parameter's - is lent for that operation alone: the caller's local is kept by nothing (oann's GemmI8 tiles)
type acc32 struct() {
    v := Array<I32>(32)
    n := Array<I64>(2)
}

type accOf<T> struct() {
    v := Array<T>(32)
}

type nest struct() {
    in := acc32()
}

fn dotsSlice(x Array<U8>&, b Array<I8>&, t mut acc32&) { t.v[16:32] += (x * b).Sum<I32>(4) }
fn dotsWhole(x Array<U8>&, b Array<I8>&, t mut acc32&) { t.v += (x * b).Sum<I32>(4) }
fn dotsGeneric(x Array<U8>&, b Array<I8>&, t mut accOf<I32>&) { t.v[0:16] += (x * b).Sum<I32>(4) }
fn dotsNested(x Array<U8>&, b Array<I8>&, t mut nest&) { t.in.v[0:16] += (x * b).Sum<I32>(4) }
fn dotsArray(x Array<U8>&, b Array<I8>&, v mut Array<I32>&) { v[0:16] += (x * b).Sum<I32>(4) }
fn bumped(t mut acc32&) { t.n[1].AtomicAdd(3) }

fn dotsInto(x Array<U8>&, b Array<I8>&) I64 {
    t := acc32()
    dotsSlice(x[0:4], b, t)
    g := accOf<I32>()
    dotsGeneric(x[0:4], b, g)
    w := nest()
    dotsNested(x[0:4], b, w)
    a := Array<I32>(16)
    dotsArray(x[0:4], b, a)
    bumped(t)
    return I64(t.v[17]) + I64(g.v[0]) + I64(w.in.v[15]) + I64(a[3]) + t.n[1]
}

fn dotsAll(x Array<U8>&, b Array<I8>&) I64 {
    t := acc32()
    dotsWhole(x, b, t)
    return I64(t.v[31])
}

assert not dotsInto.Allocates, "a local an atomic or a grouped total writes through a mut parameter allocates"
assert not dotsAll.Allocates, "a local a grouped total writes whole through a mut parameter allocates"

# kept: a value built of a local stored where it outlives the call, or of a part of what a callee is lent
type holder struct(d mut Array<F32>&) {
    d
}

fn keepPart(h mut holder&, m mt&) { h.d = m.Data }

fn keptDeep(h mut holder&) {
    acc := Array<F32>(8)
    from := mt(acc, 0)
    keepPart(h, from)
}

fn copyOut(h mut holder&, m mt) { h.d = m.Data }

fn keptCopy(h mut holder&) {
    acc := Array<F32>(8)
    from := mt(acc, 0)
    copyOut(h, from)
}

fn mt.Over(x F32) mt {
    acc := Array<F32>(8)
    acc[0] = x
    return mt(acc, 0)
}

assert keptDeep.Allocates and keptCopy.Allocates and mt.Over.Allocates, "a local a kept value is built of is given storage"

# an array of a run-time length held by value copied out of existing storage (T7b) - declared, assigned - or widened
# from a fixed one (T7c), and a view handed back copied where its caller keeps it (D9h): each builds storage
type held struct(S Array<F32>) {
    S
}

fn copiedOut(h held&) F32 {
    pre := h.S
    pre[0] = 5.0
    return pre[0] + h.S[0]
}

fn widenedThenAssigned(h held&) F32 {
    q := Array<F32>(4)
    q = h.S
    q[0] = 1.0
    return q[0] + h.S[0]
}

fn storedInto(h held&, into mut held&) { into.S = h.S }

fn handedBack(h held&) Array<F32> { return h.S }

fn keptView(h held&) F32 {
    x := handedBack(h)
    x[0] = 1.0
    return x[0] + h.S[0]
}

assert copiedOut.Allocates and widenedThenAssigned.Allocates and storedInto.Allocates and keptView.Allocates, "an array value's copy builds storage"
assert not handedBack.Allocates, "a view handed back is copied by its caller"

test lent "a local kept by nothing is the frame's, and reads back what was written" {
    assert lent(3) == 1.0 and converted() == 28.0 and viewed(2.5) == 2.5
    # each group 2 * (1 + 2 + 3 + 4) = 20 - four bytes shared by every group, or all 128 bytes - and the atomic 3
    xs := Array<U8>[U8(1 + p % 4) for p in range 128]
    assert dotsInto(xs, Array<I8>(64, 2)) == 4 * 20 + 3 and dotsAll(xs, Array<I8>(128, 2)) == 20
    assert dotsInto(Array<U8>[1, 2, 3, 4], Array<I8>(64, 2)) == 83 # S18c: decided while compiling
    d := Array<F32>(4)
    for i in range 4: d[i] = F32(i)
    out := Array<F32>(4)
    inTasks(opd(d, 1), 4, out)
    assert out[0] == 1.0 and out[3] == 4.0
    base := Array<F32>(2)
    h := holder(base)
    keptDeep(h)
    keptCopy(h)
    assert h.d.Len() == 8 and mt.Over(1.5).Data[0] == 1.5
    hs := held(Array<F32>(4))
    assert copiedOut(hs) == 5.0 and widenedThenAssigned(hs) == 1.0 and keptView(hs) == 1.0 and hs.S[0] == 0.0
    into := held(Array<F32>(2))
    storedInto(hs, into)
    into.S[0] = 7.0
    assert into.S.Len() == 4 and hs.S[0] == 0.0 and handedBack(hs).Len() == 4
}
