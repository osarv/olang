# S13h: array patterns - "case String&["test", file, ...words]": a literal compares an element, a name binds one, a
# "...name" binds the elements the others do not name as a view, a bare "..." skips them; with no "..." the length is
# exact. The length is tested first, so nothing is read out of range, and the lengths are the constructors S13a covers
# ("I64[]" and "I64[first, ...rest]" every array). Arrays, text, a payload's array and a type with At and Len (a Vec).
# Each computation is a global the evaluator bakes and an assert it decides (K2, S18c), and on an input it cannot see
# (Live), at run time

Live mut I64 = 0

fn describe(args Array<String&>&) String {
    return match args {
        case Array<String&>[]: "nothing"
        case Array<String&>["test", file, ...words]: "test " $file " with " $words.Len() " words"
        case Array<String&>["run", ...]: "run"
        case Array<String&>[only]: "one: " $only
        case Array<String&>[first, ...rest, last]: $first ".." $last " (" $rest.Len() " between)"
    }
}

fn describeAll(z I64) String {
    w := "x" if z == 0 else "?"
    b := StringBuilder()
    for a in Array<Array<String&>&>[Array<String&>[], Array<String&>["test", "a.olang", w, "y"], Array<String&>["run", "z"], Array<String&>["hi"]] {
        b.Push(describe(a))
        b.Push("; ")
    }
    b.Push(describe(Array<String&>["a", "b", "c", "d"]))
    b.Push("; ")
    b.Push(describe(Array<String&>["a", w]))
    return b.ToString()
}

DescribeBaked := describeAll(0)

fn total(xs Array<I64>&) I64 {
    return match xs {
        case Array<I64>[]: 0
        case Array<I64>[first, ...rest]: first + total(rest)
    }
}

# the elements after a rest counted from the end
fn ends(xs Array<I64>&) I64 {
    return match xs {
        case Array<I64>[a, ..., 0]: a
        case Array<I64>[..., b, c]: b * 10 + c
        case _: -1
    }
}

fn shape(t String&) String {
    return match t {
        case Array<Char>['-', '-', ...name]: "long " $name
        case Array<Char>['-', c]: "short " $c
        case _: "word " $t
    }
}

type Cmd enum {
    Run(args Array<String&>&)
    Quit
}

fn cmd(c Cmd) String {
    match c {
        case Cmd.Run(Array<String&>["ls", ...rest]) { return "ls " $rest.Len() }
        case Cmd.Run(_) { return "run" }
        case Cmd.Quit { return "quit" }
    }
}

fn vecs(v Vec<I64>&) String {
    return match v {
        case Array<I64>[a, b]: "two " $(a + b)
        case Array<I64>[a, ...]: "many from " $a
        case _: "none"
    }
}

fn others(z I64) String {
    v := Vec<I64>()
    s0 := vecs(v)
    v.Push(3 + z)
    v.Push(4)
    s2 := vecs(v)
    v.Push(5)
    xs := Array<I64>[1, 2, 3 + z, 4]
    a := $total(xs) " " $ends(Array<I64>[7, 8, 0]) " " $ends(Array<I64>[7, 8, 9]) " " $ends(Array<I64>[1])
    b := $shape("--help") " " $shape("-v") " " $shape("go")
    c := $cmd(Cmd.Run(Array<String&>["ls", "-l"])) " " $cmd(Cmd.Run(Array<String&>["x"])) " " $cmd(Cmd.Quit)
    return $a " " $b " " $c " " $s0 " " $s2 " " $vecs(v)
}

OthersBaked := others(0)

test "S13h: an array pattern's literals compare, its names bind, its rest is a view" {
    want := "nothing; test a.olang with 2 words; run; one: hi; a..d (2 between); a..x (0 between)"
    assert describeAll(Live) == want and DescribeBaked == want
    assert describeAll(0) == want    # decided while compiling (S18c)
}

test "S13h: from the end after a rest, text, a payload's array, a Vec" {
    want := "10 7 89 -1 long help short v word go ls 1 run quit none two 7 many from 3"
    assert others(Live) == want and OthersBaked == want
}
