# Weak references and generational types (T2d, T13d): a doubly linked list whose back links are weak, a tree whose
# parent links are, an LRU cache whose Map owns the nodes while its list's four links point at them weakly, and a
# generational value held by reference ("n := Node(1)" names a new instance, aliasing read back). A weak place reads
# its node while some owning place holds it and null from the moment none does (the count in the node's header word,
# genrefs 2.4 (b), 4.2) - and a node let go of may be reclaimed (O8e, tests/reclaim.olang), what it owned let go of in
# turn. Each test reads its values back after an arena churn; the evaluator decides the same values while
# compiling where every node read is held (a baked global, top-level asserts), and interpret runs the rest as built.

type Node struct(v I64) {
    v
    next mut Node?& = null
    prev weak mut Node?& = null # points back: the list holds each node through 'head' or the 'next' before it
}

type DList struct() {
    head mut Node?& = null
    tail weak mut Node?& = null
    n I64 = 0
}

fn (l mut DList&) PushBack(v I64) {
    nd := Node(v)
    t := l.tail
    if t is null { l.head = nd } else {
        t.next = nd
        nd.prev = t
    }
    l.tail = nd
    l.n++
}

fn (l mut DList&) PopFront() I64 {
    h := l.head!
    q := h.next
    l.head = q
    if q is null { l.tail = null } else { q.prev = null }
    l.n--
    return h.v
}

# the list read forward through 'next' and back through the weak 'prev', as digits
fn (l DList&) Forward() I64 {
    s := 0
    at Node?& = l.head
    for at is not null {
        s = s * 10 + at.v
        at = at.next
    }
    return s
}

fn (l DList&) Backward() I64 {
    s := 0
    at Node?& = l.tail
    for at is not null {
        s = s * 10 + at.v
        at = at.prev
    }
    return s
}

# what a closed scope left behind is written over
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn listed(n I64, pops I64) I64 {
    l := DList()
    for i in range 1, n + 1 { l.PushBack(i) }
    p := 0
    for _ in range pops { p = p * 10 + l.PopFront() }
    churn()
    return l.Forward() * 1000000 + l.Backward() * 100 + p
}

# a binary search tree with weak parent links: the tree holds each node through 'root', 'left' and 'right'
type TNode struct(key I64, up mut TNode?&) {
    key
    parent weak mut TNode?& = up
    left mut TNode?& = null
    right mut TNode?& = null
}

type Tree struct() {
    root mut TNode?& = null
}

fn (t mut Tree&) Insert(k I64) mut TNode& {
    r := t.root
    if r is null {
        n := TNode(k, null)
        t.root = n
        return n
    }
    at := r
    for {
        if k < at.key {
            l := at.left
            if l is null {
                n := TNode(k, at)
                at.left = n
                return n
            }
            at = l
        } else {
            g := at.right
            if g is null {
                n := TNode(k, at)
                at.right = n
                return n
            }
            at = g
        }
    }
    unreachable
}

# the keys from a node up to the root, through the weak parent links
fn pathUp(n TNode&) I64 {
    s := 0
    at TNode?& = n
    for at is not null {
        s = s * 10 + at.key
        at = at.parent
    }
    return s
}

fn treePath() I64 {
    t := Tree()
    t.Insert(5)
    t.Insert(3)
    t.Insert(8)
    t.Insert(4)
    leaf := t.Insert(1)
    churn()
    return pathUp(leaf) * 10 + pathUp(t.Insert(9))
}

# an LRU cache: the Map owns its nodes, the list links between them are weak
type Entry struct(key String, v I64) {
    key
    v
    next weak mut Entry?& = null
    prev weak mut Entry?& = null
}

type Lru struct(cap I64) {
    cap
    head weak mut Entry?& = null
    tail weak mut Entry?& = null
    at Map<String, mut Entry&> = Map<String, mut Entry&>()
}

fn (c mut Lru&) unlink(n mut Entry&) {
    p := n.prev
    q := n.next
    if p is null { c.head = q } else { p.next = q }
    if q is null { c.tail = p } else { q.prev = p }
    n.prev = null
    n.next = null
}

fn (c mut Lru&) pushFront(n mut Entry&) {
    h := c.head
    n.next = h
    if h is null { c.tail = n } else { h.prev = n }
    c.head = n
}

# the value of key k, made as v where it is missing; the least recently used entry evicted at the cap
fn (c mut Lru&) Get(k String&, v I64) I64 {
    n := try c.at.Get(k) catch {
        if c.at.Len() >= c.cap {
            old := c.tail!
            c.unlink(old)
            assert c.at.Remove(old.key)
        }
        fresh := Entry(k, v)
        c.at.Put(k, fresh)
        c.pushFront(fresh)
        return v
    }
    c.unlink(n)
    c.pushFront(n)
    return n.v
}

# the keys from most to least recently used
fn (c Lru&) Order() String {
    b := StringBuilder()
    at Entry?& = c.head
    for at is not null {
        b.Push(at.key)
        at = at.next
    }
    return b.ToString()
}

fn cached() String {
    c := Lru(3)
    for k in Array<String&>["a", "b", "c", "a", "d", "b", "e"] { c.Get(k, k.Len()) }
    churn()
    return c.Order()
}

# T13d: a generational value is held by reference - ":=" names a new instance, and a second name for it is the same one
fn aliased() I64 {
    a := Node(1)
    b := a
    b.v = 7
    l := DList()
    l.PushBack(2)
    h := l.head!
    h.v = 4
    churn()
    return a.v * 100 + l.Forward() * 10 + (1 if a == b else 0)
}

# ---- removals: a weak place gives null once no owning place holds its node ----

# the node after p taken out of the list - p's 'next' let go of it - and the one after it pointed back to p
fn (l mut DList&) RemoveAfter(p mut Node&) {
    n := p.next!
    q := n.next
    p.next = q
    if q is null { l.tail = p } else { q.prev = p }
}

# a weak place naming each of five nodes, then the second and the fourth taken out, the head given up and the tail
# moved in front: which of the five the weak places still name, as digits (0 for null)
type Seen struct(n mut Node?&) {
    w weak mut Node?& = n
}

fn digits(xs Array<Seen>&) I64 {
    s := 0
    for x in xs {
        at := x.w
        s = s * 10 + (at.v if at is not null else 0)
    }
    return s
}

fn removed() I64 {
    l := DList()
    for i in range 1, 6 { l.PushBack(i) }
    a := l.head!
    seen := Array<Seen>[Seen(a), Seen(a.next), Seen(a.next!.next), Seen(a.next!.next!.next), Seen(l.tail)]
    l.RemoveAfter(a)                  # 2 out
    l.RemoveAfter(a.next!)            # 4 out
    churn()
    first := digits(seen)
    l.head = a.next                   # 1 out: the head let go of it (an owning place of a struct that is no node)
    churn()
    return first * 1000000 + digits(seen) * 10 + (1 if l.Backward() == 53 else 0)
}

# a tree's subtree cut off: the node at the cut is held by nothing and reclaimed, what it owned let go of in turn - the
# leaf kept by a local stays, its parent link reading null at the cut
fn cutPath() I64 {
    t := Tree()
    t.Insert(5)
    t.Insert(3)
    t.Insert(8)
    t.Insert(4)
    leaf := t.Insert(1)
    root := t.root!
    root.left = null                  # 3 cut off, with 1 and 4 below it
    churn()
    return pathUp(leaf) * 10 + (1 if leaf.parent is not null else 0)
}

# an LRU cache's evicted entry, named by a weak place outside it: null once the cache's Map gave it up
type Recent struct() {
    last weak mut Entry?& = null
}

fn evicted() I64 {
    c := Lru(2)
    r := Recent()
    c.Get("a", 1)
    r.last = c.head
    c.Get("b", 2)
    held := r.last is not null
    c.Get("c", 3)                     # "a" evicted: the Map removed it
    churn()
    return (10 if held else 0) + (1 if r.last is null else 0)
}

# ...and one whose Map grows as it fills (its entries moved into new slots, still held once each): the first entry
# evicted reads null, the newest still its entry
fn grownEvicted() I64 {
    c := Lru(40)
    first, newest := Recent(), Recent()
    for i in range 100 {
        c.Get($i, i)
        if i == 0: first.last = c.head
    }
    newest.last = c.head
    churn()
    f := first.last
    n := newest.last
    return (10 if f is null else 0) + (n.v if n is not null else -1)
}

# a Vec of nodes: a node popped is held by nothing owning, and held again once pushed back - the count follows the
# program's own stores
fn popped() I64 {
    v := Vec<mut Node&>()
    for i in range 1, 4 { v.Push(Node(i)) }
    r := Seen(v[2])
    x := v.Pop()!
    churn()
    gone := r.w is null
    v.Push(x)
    back := r.w is not null
    return (10 if gone else 0) + (1 if back else 0)
}

# the evaluator decides the same while compiling
Listed := listed(5, 2)
assert Listed == 345054312
assert listed(4, 0) == 1234432100 and listed(3, 3) == 123
assert treePath() == 2335 and cached() == "ebd"
assert aliased() == 741

test "a doubly linked list read forward through its owning links and back through its weak ones" {
    assert listed(4, 0) == 1234432100
    assert listed(5, 2) == Listed
    assert listed(3, 3) == 123
}

test "a tree's weak parent links read back up to its root" {
    assert treePath() == 2335
    t := Tree()
    assert pathUp(t.Insert(6)) == 6
}

test "an LRU cache whose Map owns its entries and whose list links are weak" {
    assert cached() == "ebd"
}

test "a generational value is held by reference" {
    assert aliased() == 741
}

test "a weak place reads null once no owning place holds its node" {
    assert removed() == 10305003051
}

test "a subtree cut off: its nodes' weak parent links read null at the cut" {
    assert cutPath() == 10
}

test "an LRU cache's evicted entry reads null through a weak place outside it" {
    assert evicted() == 11
}

test "an LRU cache whose Map grows: an entry evicted reads null, the newest its entry" {
    assert grownEvicted() == 109
}

test "a node popped from a Vec reads null through a weak place, and its node again once pushed back" {
    assert popped() == 11
}
