# D9h (docs/rework.md sections 13 and 18): value results that are views of what a function is given, handed over
# without a copy where the caller only reads them and copied where it keeps them.

type entry struct(name mut String&, next entry?&) {
    name
    next
}

# a value result that is a view of what a parameter reaches
fn nameOf(e entry) String { return e.name }

fn inner(t String&) String { return t[1:t.Len() - 1] }

# a view of a view, handed back as it is
fn twice(t String&) String { return inner(inner(t)) }

# one of two views, or new text
fn pick(a String&, b String&, k I64) String {
    if k == 0: return a
    if k == 1: return b[1:]
    return $a $b
}

fn count(t String&) I64 { return t.Len() }

type named trait {
    Label() String
}

type tag struct(text mut String&) {
    text
}

# a method an "any" calls through its table: the table's slot copies what it hands back
fn (g tag) Label() String { return g.text[1:] }

# a function a value calls: its copying wrapper copies what it hands back
fn apply(f fn(t String&) String, t String&) String { return f(t) }

test inner "hands a view over where the caller only reads it, and copies it where the caller keeps it" {
    s := $"[abcd]"
    assert inner(s) == "abcd"
    assert count(twice(s)) == 2
    kept := twice(s)
    s[2] = 'X'
    assert kept == "bc"
    assert twice(s) == "Xc"
    assert $inner(s) "!" == "aXcd!"
}

test pick "copies a view kept beside new text, whatever it gives" {
    a, b := $"one", $"two"
    xs := Vec<String&>()
    for k in range 3 { xs.Push(pick(a, b, k)) }
    a[0] = 'O'
    b[1] = 'W'
    assert xs[0] == "one" and xs[1] == "wo" and xs[2] == "onetwo"
}

test nameOf "keeps a view of a field's text its own when the entry changes" {
    e := entry($"first", null)
    n := nameOf(e)
    e.name[0] = 'F'
    assert n == "first" and nameOf(e) == "First"
}

test apply "copies a view handed back through a function value and through an any" {
    t := $"<xy>"
    r := apply(inner, t)
    t[1] = 'Q'
    assert r == "xy"
    g := tag($"#tag")
    w any named& = g
    l := w.Label()
    g.text[1] = 'T'
    assert l == "tag" and w.Label() == "Tag"
}

# a type whose Call is a function handing back a view, as a function value (E31): its adapter copies what it gives
type cutter struct(n I64) {
    n
}

fn (k cutter) Call(t String&) String { return t[k.n:] }

fn cutWith(f fn(t String&) String, t String&) String { return f(t) }

# a guaranteed tail call of a function handing back a view of its own argument: handed back as it is too
fn skipSpaces(t String&, i I64) String {
    if i < t.Len() and t[i] == ' ': become skipSpaces(t, i + 1)
    return t[i:]
}

# ... and one viewing new text, which no caller can know: copied at every call (ViewOther)
fn spacedOut(t String&, i I64) String { become skipSpaces($" " $t, i) }

test cutWith "copies the view an adapter's Call hands back" {
    t := $"abcdef"
    r := cutWith(cutter(2), t)
    t[3] = 'D'
    assert r == "cdef"
}

test skipSpaces "hands a tail call's view back, and copies one of new text" {
    t := $"   ok"
    k := skipSpaces(t, 0)
    t[3] = 'O'
    assert k == "ok" and skipSpaces(t, 0) == "Ok"
    j := spacedOut(t[2:], 0)
    t[4] = 'K'
    assert j == "Ok" and spacedOut(t[2:], 0) == "OK"
}

# the evaluator copies every returned array value: a baked global and a decided assert agree with the run time
Twice String = twice("((ok))")
assert Twice == "ok"
assert pick("ab", "cd", 1) == "d"
assert skipSpaces("  hi", 0) == "hi" and spacedOut("ab", 0) == "ab"

# a call given only read-only arguments may still write through a closure one of them holds (a "mut" reference it
# captured): a view read after such a call in its statement is the copy it would be
type sink struct(f fn()) {
    f
}

fn fired(s sink&) String {
    s.f()
    return "!"
}

# a join's operands are evaluated before any piece renders (E11b): mid's result is its own copy before fired runs
fn joinedFired(t String&, s sink&) String { return $inner(t) $fired(s) }

test joinedFired "copies a view where a closure an argument holds may write what it views before it is read" {
    text := $"[abcd]"
    r mut String& = text
    s := sink(fn() { r[1] = 'X' })
    assert joinedFired(text, s) == "abcd!"
    assert text == "[Xbcd]"
}
