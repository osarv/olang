# O23b per instance (docs/fieldscopes.md B.1, docs/freeing.md 2.4): a helper whose writable field has a binding of its
# own keeps it wherever it is named - a local, a parameter, a result - and an instance of it stored into an element is
# bound exactly where the element's references are, so a read through the element (or a copy of it) knows where the
# field points: the declaration is not given back for the whole program, and the helper used from a local elsewhere
# stays relaxed. Read back after an arena churn

type Node struct(v I64) {
    v
    next mut Node?& = null
}

type Pass struct(C mut Node&) {
    C
}

fn (p mut Pass&) link(x mut Node&) { p.C.next ~ x }

# (a helper placed by its own uses: its field bound where root lives, the helper itself in the frame)
fn use(root mut Node&, k I64) {
    p := Pass(root)
    p.link(Node(k))
}

fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30: l.Push(i)
    if d == 0: return 0
    return churn(d - 1) + a[3] - d
}

# an element copied out and linked through: the copy is bound where the vector's elements are, so x lives there
fn stash(root mut Node&) I64 {
    ps := Vec<Pass>()
    ps.Push(Pass(root))
    x := Node(42)
    q := ps[0]
    q.link(x)
    return churn(40)
}

# a parameter held by value stored into an element: its binding is its caller's argument's, asked to be the vector's
fn keep(ps mut Vec<Pass>&, p Pass) { ps.Push(p) }

fn relink(ps mut Vec<Pass>&, x mut Node&) {
    q := ps[0]
    q.link(x)
}

# an array literal's element
fn literal() I64 {
    n := Node(3)
    arr := Array<Pass>[Pass(n), Pass(n)]
    q := arr[1]
    q.link(Node(5))
    t := churn(40)
    return n.next!.v + t
}

fn demo() I64 {
    r := Node(1)
    ps := Vec<Pass>()
    ps.Push(Pass(r))
    x := Node(42)
    q := ps[0]
    q.link(x)
    return r.next!.v
}

# (decided while compiling: the evaluator agrees, K1)
assert demo() == 42

test "an instance stored into an element is bound where the element's references are" {
    r := Node(1)
    use(r, 7)
    assert r.next!.v == 7
    assert stash(r) == 0 and r.next!.v == 42
    ps := Vec<Pass>()
    keep(ps, Pass(r))
    relink(ps, Node(9))
    assert churn(40) == 0 and r.next!.v == 9
    assert literal() == 5
    assert demo() == 42
}
