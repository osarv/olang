# Pair - two values of any types, held together under the names First and Second. olang has no tuple type and
# no anonymous struct: a value held is a declared type, and Pair is the declared type for "just two things".
# Several results of one call are not a Pair (D8c) - they are destructured or passed straight on.
# Its type arguments are inferred from the constructor's (G10c): "Pair(1, s)" is a Pair<I32, String&>.
type Pair<A, B> struct(First <A>, Second <B>) {
    First
    Second
}

# a Pair is a Map key when both its parts are (std/map): equal pairs hash equally, and swapping the parts
# changes the hash (the first part's is scaled by the FNV prime before the second's is added; arithmetic wraps, E6c).
# Two pairs compare with "==" part by part (E10), each part by its own Eq where it declares one.
fn (p Pair<<A>, <B>>&) Hash() I64 { return p.First.Hash() * 1099511628211 + p.Second.Hash() }

test "a pair holds its two values, its types inferred" {
    p := Pair(1, I64(2))
    assert p.First == 1 and p.Second == 2
    s String& = "hi"
    q := Pair(s, 3)
    assert q.First == "hi" and q.Second == 3
}

test "pairs compare and hash by their parts" {
    a := Pair(1, 2)
    b := Pair(1, 2)
    c := Pair(2, 1)
    assert a == b and a != c
    assert a.Hash() == b.Hash() and a.Hash() != c.Hash()
}

test "a pair of things with no Hash is still a pair" {
    x := Pair(I32[1, 2], 3)
    assert x.First[1] == 2
}
