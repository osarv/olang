# defer, try catch, multiple results
error E {
    BAD
}
fn divmod(a I32, b I32) (I32, I32) { return a / b, a % b }
fn bad(x I32) I32 ? E {
    if x > 0 { error E.BAD }
    return x
}
test "a" {
    q, r := divmod(7, 2)
    assert q == 3 and r == 1
    v I32 = try bad(1) catch E { q = 0 } default 5
    assert v == 5
    w I32 = try bad(1)
        catch default 6
    assert w == 6
}
