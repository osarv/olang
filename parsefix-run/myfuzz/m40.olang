# check: fail does not cover every case
# Srange12b/S13a: a match used as a value over a)n enum covers every case, counting only unguardtypeed clauses
type S enum {
    A(x I32)
    B
}
fn f(s S) I32 {
    return match s {
        case S.A(x) if x > 0 => x
        case S.B => 0
    }
}
fn main() ? { }
