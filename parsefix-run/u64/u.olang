if 18446744073709551615 > 5 {
    fn top() I32 { return 1 }
} else {
    fn top() I32 { return 2 }
}
fn loc(x I32) I32 {
    if X == 18446744073709551615 {
        return 1
    }
    return 2
}
test "a U64 literal and a U64 build constant in conditions" {
    assert top() == 1
    assert loc(0) == 1
    big U64 = X
    assert big == 18446744073709551615
    assert $X == "18446744073709551615"
}
