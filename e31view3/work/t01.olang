# T1h's tightening: other ways to write into a field of a try-default
type Pt struct() {
    X I64 = 0
    arr Array<I64, 2>
}
type Acc struct() {
    P Pt
}
fn bumpArr(x mut Array<I64>&) { x[0] = x[0] + 1 }
fn run() I64 {
    a := Array<Acc>(1)
    (try a[1] catch default Acc()).P.X.AtomicAdd(5)
    bumpArr((try a[1] catch default Acc()).P.arr[0:1])
    (try a[1] catch default Acc()).P.X, a[0].P.X = 3, 4
    return a[0].P.X * 100 + a[0].P.arr[0]
}
Baked I64 = run()
fn main() ? {
    println("baked " $Baked " run " $run())
}
