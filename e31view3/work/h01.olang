# a program's own handle; a read-only receiver building through its writable reference (shallow), reached through a
# handle a call gives (F3): ll[0] of a List of Bags, m.Get(k), a user function's result
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
type Node struct(v I64, next mut Node&) {
    v
    next
}
type BagState struct() {
    head mut Node& = null
}
type Bag struct() {
    s mut BagState& = BagState()
}
fn (b Bag&) Sneak(v I64) { b.s.head = Node(v, b.s.head) }
fn (b Bag&) Sum() I64 {
    t I64 = 0
    for n := b.s.head, n != null, n = n.next { t = t * 10 + n.v }
    return t
}
fn sneak2(b Bag&, v I64) { b.Sneak(v) }
fn first(l mut List<Bag>&) Bag ? { return try l.First() }
fn main() ? {
    l := List<Bag>()
    l.Push(Bag())
    m := Map<I64, Bag>()
    m.Put(1, Bag())
    for i in range 3 {
        l[0].Sneak(i + 1)
        sneak2(l[0], i + 4)
        (try m.Get(1)).Sneak(i + 1)
        (try first(l)).Sneak(7)
        churn()
    }
    churn()
    println("l " $l[0].Sum() " m " $(try m.Get(1)).Sum())
}
