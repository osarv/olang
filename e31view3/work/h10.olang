# minimal: function result (a struct holding a mut Node& field) lent to a reference param, callee builds through it.
# compare: lent to a BY-VALUE param (should be safe - the copy's refs are judged).
type Node struct(v I64, next mut Node&) {
    v
    next
}
type Box struct() {
    head mut Node& = Node(0, null)
}
fn idBox(seed mut Box&) Box { return seed }
fn addRef(b mut Box&, v I64) { b.head.next = Node(v, b.head.next) }
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
fn main() ? {
    seed := Box()
    addRef(idBox(seed), 5)
    churn()
    n := 0
    for x := seed.head, x != null, x = x.next { n = n * 10 + x.v }
    println("chain " $n)
}
