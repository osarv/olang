# a handle whose one reference is read-only, but leads to a writable one: is pick's obligation exact?
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
type Node struct(v I64) {
    v
    next mut Node& = null
}
type St struct() {
    head mut Node& = Node(0)
}
type RH struct() {
    s St& = St()
}
fn pick(a mut List<RH>&, b mut List<RH>&, c Bool) RH {
    if c { return a[0] }
    return b[0]
}
fn addVia(h RH&, v I64) { h.s.head.next = Node(v) }
fn main() ? {
    outer := List<RH>()
    outer.Push(RH())
    for i in range 3 {
        inner := List<RH>()
        inner.Push(RH())
        addVia(pick(outer, inner, true), i + 7)
        churn()
    }
    churn()
    println("got " $outer[0].s.head.next.v)
}
