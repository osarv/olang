# nested blocks: a two-level List local to an inner block, pushed from a loop two blocks deeper through ll[0][0]
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
fn main() ? {
    {
        lll := List<List<List<I64>>>()
        lll.Push(List<List<I64>>())
        lll[0].Push(List<I64>())
        for i in range 20 {
            if i >= 0 {
                lll[0][0].Push(i + 7)
                h := lll[0][0]
                h.Push(i + 100)
                churn()
            }
        }
        churn()
        n I64 = 0
        for s in lll[0][0] { n = n + s }
        println("sum " $n " len " $lll[0][0].Len())
    }
}
