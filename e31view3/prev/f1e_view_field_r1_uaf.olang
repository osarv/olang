# F1 through r1: g(l[0].w) where g lends m.inner on to a view that builds - the top-level field lend is the hole;
# the same chain from a whole element, step(l[0]) (hf/v07), is O17's error
type Node struct(v I64, next mut Node&) {
    v
    next
}
type In struct(r mut Node&, k I64) {
    r
    k
}
type M struct(r mut Node&, off I64) {
    r
    off
    inner In = In(Node(0, null), 0)
}
type Layer struct(w M, n I64) {
    w
    n
}
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
fn gi(i mut In&, v I64) { i.r.next = Node(v, null) }
fn g(m mut M&, v I64) { gi(m.inner, v) }
fn add(l mut List<Layer>&, v I64) { g(l[0].w, v) }
fn main() ? {
    l := List<Layer>()
    l.Push(Layer(M(Node(1, null), 0), 0))
    add(l, 12)
    churn()
    println($l[0].w.inner.r.next.v)
}
