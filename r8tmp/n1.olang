import "std/io"
import "std/os"
type E error {
    Bad
}
type Node struct(v I64) {
    v
}
fn Node.mk(n I64) Node& ? E {
    if n < 0 { error E.Bad }
    return Node(n)
}
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}
fn main() ? {
    r Node?& = null
    for i in range 2 {
        fallback Node& = Node(40 + i + os.Args().Len())
        join {
            spawn r = try Node.mk(-1) catch default fallback
        }
    }
    churn()
    try io.Println($r!.v)
}
