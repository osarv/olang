import "std/os"
type E error { Empty }
type Node struct(v I64) {
    v
}
fn Node.make(v I64) mut Node& ? E {
    if v < 0 { error E.Empty }
    return Node(v)
}
fn main() {
    a mut Node& = Node(1)
    n := os.Args().Len()
    {
        b mut Node& = Node(2)
        d := a
        if n > 0 { d = b }
        m := try Node.make(n - 5) catch default d
        m.v = 3
        assert b.v == 3
    }
}
