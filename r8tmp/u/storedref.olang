type E error { Empty }
type Node struct(v I64) {
    v
}
type Box struct(n mut Node?&) {
    n
}
fn Node.make(v I64) mut Node& ? E {
    if v < 0 { error E.Empty }
    return Node(v)
}
fn set(b mut Box&, other mut Node&, v I64) {
    r := try Node.make(v) catch default other
    r.v = 3
    b.n = r
}
fn main() {
    b := Box(null)
    o := Node(1)
    set(b, o, -1)
    assert b.n!.v == 3
}
