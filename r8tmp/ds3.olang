type E error { Empty }
type Node struct(v I64) {
    v
}
fn Node.make(v I64) mut Node& ? E {
    if v < 0 { error E.Empty }
    return Node(v)
}
fn set(x mut Node&, y mut Node&, c Bool, v I64) I64 {
    d := x
    if c { d = y }
    r := try Node.make(v) catch default d
    r.v = 3
    return r.v
}
fn main() {
    a := Node(1)
    b := Node(2)
    assert set(a, b, true, -1) == 3
    assert b.v == 3
}
