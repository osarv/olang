extern fn usleep(us U32) I32
type Hold struct(f fn()) { f }
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn main() ? {
    c mut Array<I64>& = Array<I64>(4, 0)
    join {
        for t in range 4 {
            b := Array<I64>(4, t + 1)
            h := Hold(fn() {
                usleep(50000)
                c[t] = b[t]
            })
            spawn h.f()
        }
        churn()
    }
    println($c[0] " " $c[1] " " $c[2] " " $c[3])
}
