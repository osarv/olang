type P struct(v I64) { v }
fn each(xs Array<<T>>&, f fn(x T)) {
    for x in xs { f(x) }
}
fn each2(f fn(x <T>), xs Array<T>&) {
    for x in xs { f(x) }
}
Pts := P&[P(1), P(2)]
fn main() ? {
    each(Pts, fn(x mut P&) { x.v = 99 })
    each2(fn(x mut P&) { x.v = 77 }, Pts)
    println($Pts[0].v)
}
