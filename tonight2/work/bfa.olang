fn main() ? {
    h U64 = 1469598103934665603
    s U64 = 88172645463325252
    for k in range 200000000 {
        s ^= s << 13
        s ^= s >> 7
        s ^= s << 17
        a := U16(s & 65535).BF16FromBits()
        b := U16((s >> 16) & 65535).BF16FromBits()
        x := a + b
        y := a * b
        z := a / b
        w := a - b
        c := a < b
        h = (h ^ U64(x.Bits())) * 1099511628211
        h = (h ^ U64(y.Bits())) * 1099511628211
        h = (h ^ U64(z.Bits())) * 1099511628211
        h = (h ^ U64(w.Bits())) * 1099511628211
        if c { h = h * 3 }
    }
    println($h)
}
