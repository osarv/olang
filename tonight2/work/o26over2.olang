type Wrap struct(l mut List<I64>&) {
    l
    count I64 = 0
}
fn f(p mut List<I64>&) List<I64> {
    out := List<I64>()
    tmp mut Wrap& = Wrap(p)
    tmp.count = p.Len()
    out.Push(tmp.count)
    return out
}
fn main() ? {
    long := List<I64>()
    long.Push(3)
    r I64 = 0
    {
        res := f(long)
        r = res[0]
    }
    println($r)
}
