+    # computedDirectly: the shapes either side of each of its bounds, every element a small integer so that both paths'
+    # sums are exact and so equal
+    test "products either side of the direct path's bounds are the plain sum" {
+        shapes := I64[8, 8, 8, 10, 10, 10, 11, 11, 11, 5, 64, 64, 11, 64, 64, 12, 64, 64, 8, 32, 32, 64, 32, 64, 5, 1024, 64,
+                      5, 1025, 64, 7, 64, 3]
+        for s in range shapes.Len() / 3 {
+            m I64 = shapes[3 * s]
+            k I64 = shapes[3 * s + 1]
+            n I64 = shapes[3 * s + 2]
+            for transA in Bool[false, true] {
+                a := Matrix<F32>(k, m) if transA else Matrix<F32>(m, k)
+                b := Matrix<F32>(k, n)
+                for i in range a.Data.Len() { a.Data[i] = F32(i * 5 % 7 - 3) }
+                for i in range b.Data.Len() { b.Data[i] = F32(i * 3 % 5 - 2) }
+                want := referenceProduct(a, transA, b, false)
+                c := Matrix<F32>(m, n)
+                Gemm(c, a, transA, b, false)
+                assert c.ToF64() == want, "the product " $m "x" $k "x" $n
+                ai := Matrix<I32>(a.Rows, a.Cols)
+                ai.Convert(a)
+                bi := Matrix<I32>(k, n)
+                bi.Convert(b)
+                ci := Matrix<I32>(m, n)
+                Gemm(ci, ai, transA, bi, false)
+                assert ci.ToF64() == want, "the integer product " $m "x" $k "x" $n
+            }
+        }
+    }
+
