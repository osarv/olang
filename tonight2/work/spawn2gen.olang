type Node struct() {
    next mut Node& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
    tag I64 = 0
}
fn mkNode() mut Node& {
    n := Node()
    n.v = 42
    return n
}
fn two() (mut Node&, I64) { return mkNode(), 5 }
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn grow(b mut Box&) {
    k I64 = 0
    join { spawn b.head.next, k = two() }
}
fn main() ? {
    w := Box()
    {
        k I64 = 0
        join { spawn w.head.next, k = two() }
    }
    churn()
    println($w.head.next.v)
    x := Box()
    {
        grow(x)
    }
    churn()
    println($x.head.next.v)
}
