type Node struct(v I64) { v }
type G<T> struct() {
    vals List<T> = List<T>()
}
type Layer struct(g mut G<<T>>&, seed T) {
    {
        g.vals.Push(seed)
    }
    n I64 = 1
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn main() ? {
    gs := G<String&>()
    gn := G<Node&>()
    gi := G<I64>()
    s := "abc" $1
    n := Node(5)
    {
        a := Layer(gs, s)
        b := Layer(gn, n)
        c := Layer(gi, 7)
    }
    churn()
    println($gs.vals[0] " " $gn.vals[0].v " " $gi.vals[0] " " $gs.vals.Len())
}
