type Node struct() {
    next mut Node& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
    tag I64 = 0
}
type W struct(b Box) { b }
fn bump(src mut W&) {
    b := src.b
    br mut Box& = b
    br.head.next = Node()
    br.head.next.v = 42
}
fn bump2(src mut W&) {
    b := src.b
    br := b
    br.head.next = Node()
    br.head.next.v = 43
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn main() ? {
    w := W(Box())
    bump(w)
    churn()
    println($w.b.head.next.v)
    w2 := W(Box())
    bump2(w2)
    churn()
    println($w2.b.head.next.v)
}
