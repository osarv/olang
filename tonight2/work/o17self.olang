type Node struct() {
    owner mut Box& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
    tag I64 = 0
}
type W struct(b Box) { b }
fn tie(b mut Box&) {
    b.head.owner = b
}
fn bump(src mut W&) {
    b := src.b
    b.tag = 42
    tie(b)
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn main() ? {
    w := W(Box())
    bump(w)
    churn()
    println($w.b.head.owner.tag)
}
