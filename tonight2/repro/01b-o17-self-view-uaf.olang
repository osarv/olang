# Variant of 01 (O17, readFromRegion): the callee stores a view of the lent value's own inline array - storage that is
# the value itself, in bump's block - into a node that lives where src's references do. readFromRegion counts "b.data" as
# read out of the region because it is rooted at the parameter, though no reference is followed on the way.
# expected: error[O17] at tie(b) (472373d rejects it), or 42
# actual:   compiles; -b prints 32768, -d prints 0 (read through the dead block), -i 42
type Node struct() {
    view Array<I64>& = null
}
type Box struct() {
    head mut Node& = Node()
    data Array<I64, 4>
}
type W struct(b Box) { b }
fn tie(b mut Box&) {
    b.data[1] = 42
    b.head.view = b.data
}
fn bump(src mut W&) {
    b := src.b
    tie(b)
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn main() ? {
    w := W(Box())
    bump(w)
    churn()
    println($w.b.head.view[1])
}
