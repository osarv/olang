# NEW (the depth-0 rule): memory growth. y's scopeDepth 0 now means the function's top level in codegen too, so what
# mk builds into y's scope accumulates for the whole loop instead of going with each clause.
#     -b peak RSS: 24.7MB (this build) vs 1.6MB (master), linear in the iteration count
type P struct(v I64) { v }
type E enum {
    A(p P)
    Z
}
fn mk(b P&) P&b { return P(b.v + 1) }
fn main() ? {
    e := E.A(P(10))
    t I64 = 0
    for i in range 3000000 {
        match e {
            case E.A(y) {
                k := mk(y)
                l := List<P&>()
                l.Push(k)
                t += l[0].v
            }
            case _ { }
        }
    }
    println($t)
}
