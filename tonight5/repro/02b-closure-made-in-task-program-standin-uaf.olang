# PRE-EXISTING (master segfaults the same): finding 2 through the task's stand-in for the PROGRAM scope - a local copied
# from a global reference is captured by a closure made on the task and kept in a global List.
#     expected: 42 42 (-i); actual -b: status 139; -b -s: "use after scope closed"
type Node struct(v I64) {
    v
    next mut Node& = null
}
G mut Node& = Node(1)
Fns mut List<fn() I64> = List<fn() I64>()
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn work() {
    x := G
    Fns.Push(fn() I64 {
        x.next = Node(x.v + 41)
        return x.next.v
    })
}
fn main() ? {
    join {
        spawn work()
    }
    churn()
    f := Fns[0]
    println($f())
    churn()
    println($G.next.v)
}
