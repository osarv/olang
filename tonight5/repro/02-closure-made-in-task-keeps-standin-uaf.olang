# PRE-EXISTING (master a6a6d9c segfaults the same). A closure made INSIDE a task, capturing a reference whose scope is
# one of the task's P2 stand-ins (a scope argument's sub-scope; or, in 02b, the program scope's stand-in), carries that
# stand-in's address in its environment. The closure itself is built where its capture lives (folded back at the join),
# so the checker lets it be kept as long as n - but its environment still names the stand-in, whose header lives in the
# join block's arena: after the join, calling it allocates through a dead scope header.
#     expected: 42 42 (as -i prints)
#     actual:   -b segfaults (139), also on master; -b -s: "use after scope closed"
# This batch's env stand-ins make the same thing reachable through captured closures (finding 1) but did not add it.
type Node struct(v I64) {
    v
    next mut Node& = null
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn work(n mut Node&, fns mut List<fn() I64>&) {
    fns.Push(fn() I64 {
        n.next = Node(n.v + 41)
        return n.next.v
    })
}
fn main() ? {
    n mut Node& = Node(1)
    fns mut List<fn() I64>& = List<fn() I64>()
    join {
        spawn work(n, fns)
    }
    churn()
    f := fns[0]
    println($f())
    churn()
    println($n.next.v)
}
