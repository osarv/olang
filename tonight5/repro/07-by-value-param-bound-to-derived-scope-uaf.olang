# PRE-EXISTING (master prints -7 too), and the by-value half of this batch's fix (tonight3 2b, O25h/O4b) misses it. A
# reference read through a '&p' field of a parameter (h.b, at f's derived scope "where the argument for h bound p",
# O23a) passed for a BY-VALUE parameter binds growv's scope variable to that derived scope directly (bindCallScopeVars'
# by-value branch checks only SCOPE_AMBIGUOUS). Nothing is built into a derived scope on the reference path - "grow(h.b)"
# with a mut Box& parameter, and "d Box = h.b; d.head.next = ..." are both error[C2d] "this builds through a '&p' field
# whose scope is not known here" - but here growv builds through b.head into it, which at run time is the scope h was
# read through (the inner block), and hangs the node off outer's head, which outlives that block.
#     expected: error[C2d], as for grow(h.b); or 44 (as -i prints)
#     actual:   accepted; -b prints -7; -d -s: "use after scope closed"
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() { head mut Node& = Node(1) }
type Holder struct(p mut Box&) {
    b mut Box&p = p
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn growv(b Box) { b.head.next = Node(44) }
fn f(h Holder&) { growv(h.b) }
fn rd(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
fn main() ? {
    outer mut Box& = Box()
    k := outer.head
    {
        h := Holder(outer)
        f(h)
    }
    churn()
    println($rd(k))
}
