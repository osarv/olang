# NEW mechanism (environment copies made where the closure lives, with handing a held value on allowed by decision 40).
# A task is handed a struct holding a closure and only hands the closure on - "spawn use(h.f)" in a nested join, which
# decision 40 allows. The spawn runs __olang_env_standin on the TASK's thread, and it allocates the copy, and each
# stand-in header, in the closure's home: the first scope it captured, which is main's own scope. Meanwhile main is
# allocating into that same scope inside the join block.
#     expected: "wrong: 0 a 2000 c 200000", and no report under -r
#     actual:   -r: data race in __olang_scope_alloc_a (__olang_env_standin <- relay on T1, against main's own
#               __olang_scope_alloc_a); -b: 2 of 10 runs segfault, 2 of 10 print "wrong: 2" / "wrong: 3"
# (Master races here too, through the call itself - the struct case known before decision 40. Here the call is
# safe and the copy is what races.) os.RunOnStack(bytes, h.f) on a task would do the same through its own stand-in
# copy.
type N struct(v I64) {
    v
    w I64 = v * 3
}
type H struct(f fn(i I64)) { f }
fn use(f fn(i I64)) { f(1) }
fn relay(h H&, k I64) {
    for j in range k {
        join {
            spawn use(h.f)
        }
    }
}
fn main() ? {
    a mut List<N&>& = List<N&>()
    c mut List<N&>& = List<N&>()
    h := H(fn(i I64) { a.Push(N(i)) })
    join {
        spawn relay(h, 2000)
        for i in range 200000 { c.Push(N(i)) }
    }
    bad I64 = 0
    i I64 = 0
    for x in c { if x.v != i or x.w != 3 * i { bad++ } i++ }
    println("wrong: " $bad " a " $a.Len() " c " $c.Len())
}
