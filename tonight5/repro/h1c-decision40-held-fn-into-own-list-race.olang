# NEW (decision 40 hole): the task pushes the held function value into a List it makes and calls l[0]. expected
# error[P2]; actual accepted, -b wrong elements / segfault, -r data race in __olang_scope_alloc_a
type N struct(v I64) {
    v
    w I64 = v * 3
}
type H struct(f fn(i I64)) { f }
fn report(a List<N&>&, b List<N&>&) {
    bad I64 = 0
    i I64 = 0
    for x in a { if x.v != i or x.w != 3 * i { bad++ } i++ }
    i = 0
    for x in b { if x.v != i + 1000000 or x.w != 3 * (i + 1000000) { bad++ } i++ }
    println("wrong elements: " $bad " of " $(a.Len() + b.Len()))
}

fn work(h H&, base I64) {
    l := List<fn(i I64)>()
    l.Push(h.f)
    for i in range 100000 { l[0](i + base) }
}
fn main() ? {
    a mut List<N&>& = List<N&>()
    b mut List<N&>& = List<N&>()
    ha := H(fn(i I64) { a.Push(N(i)) })
    hb := H(fn(i I64) { b.Push(N(i)) })
    join {
        spawn work(ha, 0)
        spawn work(hb, 1000000)
    }
    report(a, b)
}
