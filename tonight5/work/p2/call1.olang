type N struct(v I64) {
    v
    w I64 = v * 3
}
type Acc struct(l mut List<N&>&) { l }
fn (a mut Acc&) Call(i I64) { a.l.Push(N(i)) }
fn work(f fn(i I64), base I64) { for i in range 100000 { f(i + base) } }
fn main() ? {
    a mut List<N&>& = List<N&>()
    b mut List<N&>& = List<N&>()
    ha mut Acc& = Acc(a)
    hb mut Acc& = Acc(b)
    join {
        spawn work(ha, 0)
        spawn work(hb, 1000000)
    }
    bad I64 = 0
    i I64 = 0
    for x in a { if x.v != i or x.w != 3 * i { bad++ } i++ }
    i = 0
    for x in b { if x.v != i + 1000000 or x.w != 3 * (i + 1000000) { bad++ } i++ }
    println("wrong elements: " $bad " of " $(a.Len() + b.Len()))
}
