type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct(v I64) {
    v
    head mut Node& = Node(1)
}
type E enum {
    A(b Box)
    Z
}
fn borrow(b Box&) Box&b { return b }
fn main() ? {
    keep Box& = Box(0)
    e := E.A(Box(10))
    for i in range 3 {
        match e {
            case E.A(y) { if i == 0 { keep = y } else { y.v = 99 } }
            case _ { }
        }
    }
    println($keep.v)
}
