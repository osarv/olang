type P struct(v I64) { v }
fn borrow(b P&) P&b { return b }
fn deep(n I64) I64 {
    a := Array<I64, 64>()
    for i in range 64 { a[i] = -7 }
    if n == 0 { return a[3] }
    return deep(n - 1) + a[5]
}
type H struct(n I64) {
    tmp := P(42)
    keep P& = borrow(tmp)
}
fn main() ? {
    h := H(1)
    deep(50)
    println($h.keep.v)
}
