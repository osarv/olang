type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct(v I64) {
    v
    head mut Node& = Node(1)
}
type E enum {
    A(b Box)
    Z
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn borrow(b Box&) Box&b { return b }
fn two() (Box, I64) { return Box(5), 1 }
fn main() ? {
    keep Box& = Box(0)
    e := E.A(Box(3))
    for i in range 1 {
        y := e as E.A
        keep = borrow(y)
    }
    churn()
    println($keep.v)
}
