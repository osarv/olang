type P struct(v I64) { v }
fn deep(n I64) I64 {
    a := Array<I64, 64>()
    for i in range 64 { a[i] = -7 }
    if n == 0 { return a[3] }
    return deep(n - 1) + a[5]
}
type H struct(n I64) {
    keep P& = P(0)
    for i in range n {
        x := P(42 + i)
        keep = x
    }
}
fn main() ? {
    h := H(1)
    deep(50)
    println($h.keep.v)
}
