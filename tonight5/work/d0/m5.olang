type P struct(v I64) { v }
type E enum {
    A(p P)
    Z
}
fn borrow(b P&) P&b { return b }
fn main() ? {
    fs := List<fn() I64>()
    for i in range 3 {
        e := E.A(P(i + 10))
        match e {
            case E.A(y) {
                r := borrow(y)
                fs.Push(fn() I64 { return r.v })
            }
            case _ { }
        }
    }
    f := fs[0]
    println($f())
}
