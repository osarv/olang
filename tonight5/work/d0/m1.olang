type P struct(v I64) { v }
type E enum {
    A(p P)
    B(p P)
    Z
}
fn borrow(b P&) P&b { return b }
fn main() ? {
    keep P& = P(0)
    for i in range 3 {
        e := E.A(P(i + 10))
        k2 := match e {
            case E.A(y) => borrow(y)
            case _ => keep
        }
        if i == 0 { keep = k2 }
    }
    println($keep.v)
}
