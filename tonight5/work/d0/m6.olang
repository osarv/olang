type P struct(v I64) { v }
type E enum {
    A(p P)
    Z
}
fn borrow(b P&) P&b { return b }
fn mk(b P&) P&b { return P(b.v + 1) }
fn main() ? {
    z P& = P(0)
    for i in range 3 {
        e := E.A(P(i + 10))
        k2 := match e {
            case E.A(y) => borrow(y)
            case _ => z
        }
        k3 := mk(k2)
        println($k2.v " " $k3.v)
    }
}
