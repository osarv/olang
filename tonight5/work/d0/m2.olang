type P struct(v I64) { v }
type E enum {
    A(p P)
    B(p P)
    Z
}
fn borrow(b P&) P&b { return b }
fn main() ? {
    keep P& = P(0)
    for i in range 3 {
        e := E.A(P(i + 10))
        match e {
            case E.A(y), E.B(y) { if i == 0 { keep = borrow(y) } }
            case _ { }
        }
    }
    println($keep.v)
}
