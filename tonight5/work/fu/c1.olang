type Node struct(v I64) {
    v
    next mut Node& = null
}
type P struct(v I64) {
    v
    r mut Node& = null
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn mk(b P&) Node&b { return Node(b.v) }
fn bm(b mut P&) mut P&b { return b }
fn rd(b P&) I64 {
    if b.r == null { return 0 }
    return b.r.v
}
type H struct(p P) {
    {
        t := mk(p)
        bm(p).r = t
    }
    c := churn()
    out I64 = rd(p)
}
fn main() ? {
    h := H(P(42))
    println($h.out)
}
