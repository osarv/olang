import "std/os"
type Node struct(v I64) {
    v
    next mut Node& = null
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn main() ? {
    n mut Node& = Node(1)
    g := fn() I64 {
        n.next = Node(n.v + 41)
        return n.next.v
    }
    fns mut List<fn() I64>& = List<fn() I64>()
    os.RunOnStack(1 << 20, fn() { fns.Push(g) })
    churn()
    f := fns[0]
    println($f())
    churn()
    println($n.next.v)
}
