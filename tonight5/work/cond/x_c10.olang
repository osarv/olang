type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() { head mut Node& = Node(1) }
type E enum {
    A(b Box)
    Z
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn grow(b mut Box&) { b.head.next = Node(43) }
fn growv(b Box) { b.head.next = Node(44) }
fn rd(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
type W struct() { b Box = Box() }
fn pickw(w mut W&) mut W&w { return w }
fn pickwv(w mut W&) W { return w }
fn main() ? {
    c := churn() < 0
    a1 := Array<Box>(1)
    k1 := a1[0].head
    {
        a2 := Array<Box>(1)
        h := (a1 if c else a2)[0]
        growv(h)
    }
    churn()
    println($rd(k1))
}
