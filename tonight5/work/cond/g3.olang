type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() { head mut Node& = Node(1) }
type Holder struct(p mut Box&) {
    b mut Box&p = p
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn f(h Holder&) {
    d Box = h.b
    d.head.next = Node(45)
}
fn rd(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
fn main() ? {
    outer mut Box& = Box()
    k := outer.head
    {
        h := Holder(outer)
        f(h)
    }
    churn()
    println($rd(k))
}
