import "std/io"
type Res unique struct(n I64) {
    n
} destruct { io.Println("end " $n)! }
fn see(r Res&) I64 { return r.n }
fn main() ? {
    out := Array<I64>(4)
    join {
        for i in range 4 {
            r := Res(i)
            spawn out[i] = see(r)
        }
    }
    try io.Println($out[3])
}
