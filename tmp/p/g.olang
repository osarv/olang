import "std/io"
extern fn usleep(us U32) I32
type Node struct(v I64) { v }
fn main() ? {
    ns := Array<Node>[Node(1), Node(2)]
    out mut Array<I64>& = Array<I64>(2)
    join {
        for i, n in ns {
            spawn fn() {
                usleep(10000)
                out[i] = n.v
            }
        }
    }
    try io.Println($out[0] " " $out[1])
}
