import "std/io"
type Node struct(v I64, a Array<I64>&) { v
 a }
fn main() ? {
    ns := Array<Node>[Node(1, Array<I64>[5]), Node(2, Array<I64>[6])]
    out mut Array<I64>& = Array<I64>(2)
    join {
        for i, n in ns {
            spawn fn() { out[i] = n.v + n.a[0] }
        }
    }
    try io.Println($out[0] " " $out[1])
}
