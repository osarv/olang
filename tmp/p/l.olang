import "std/io"
type Node struct(v I64, a Array<I64>&) { v
 a }
fn see(n Node&) I64 { return n.v + n.a[0] }
fn main() ? {
    ns := Array<Node>[Node(1, Array<I64>[5]), Node(2, Array<I64>[6])]
    out := Array<I64>(2)
    join {
        for i, n in ns {
            f := fn() I64 { return n.v }
            spawn out[i] = f()
        }
    }
    try io.Println($out[0] " " $out[1])
}
