# finding 8: a method that returns meets a 'noreturn' trait method; the error surfaces as D10a inside the generic
import "std/os"
type Quitter trait {
    Quit() noreturn
}
type Q struct() { }
fn (q Q&) Quit() { os.Exit(1) }
fn stop(q <T Quitter>&) I64 { q.Quit() }
fn main() {
    q := Q()
    x := stop(q)
}
