import "std/io"
type N struct(v I32) { v }
type Cur struct(of mut N&) { at mut N&of = of }
fn churn() {
    for i in range 2000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n N& = N(I32(i))
    }
}
fn f(p mut N&, c Bool) N&p {
    a mut Cur& = Cur(p)              # a's instance in f's block; at bound to p's scope
    n0 mut N& = N(42)                # f's block
    b mut Cur& = Cur(n0)             # also in f's block; at bound to f's block
    x := a                           # x names a's instance, a's binding
    if c { x = b }                   # exact for the reference (both in f's block); bindings merge
    x.at = n0                        # judged against the merge
    return a.at                      # a's binding says p's scope
}
fn main() ? {
    outer mut N& = N(1)
    r := f(outer, false)
    churn()
    try io.Print($r.v "\n")
}
