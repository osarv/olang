# S18a: a guaranteed check that fails says where it was written too - a slice out of range, an array length out of
# range, an 'as' that does not hold, a copy into fixed storage of another length - built and interpreted alike. Which
# one fails is chosen by the number of arguments, so nothing here is decided while compiling
import "std/os"
type Shape enum {
    Dot
    Circle(r F64)
}
fn main() ? {
    n := os.Args().Len()
    s := "abc"
    if n == 1 { println(s[1:n + 3]) }
    if n == 2 { println($Array<I64>(n - 5).Len()) }
    sh Shape = Shape.Dot if n == 3 else Shape.Circle(1.0)
    if n == 3 { println($(sh as Shape.Circle)) }
    fixed Array<I64, 2> = I64[1, 2]
    if n == 4 { fixed = Array<I64>(n) }
    println($fixed)
}
