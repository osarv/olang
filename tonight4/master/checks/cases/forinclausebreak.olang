# check: fail error[S9e]: a loop's catch clause runs after the loop has ended, so it has no loop to break or continue
# S9e: break in a for-in's catch clause
error E {
    X
}
type It struct() {
    i I32 = 0
}
fn (t mut It&) Next() I32 ? E + Exhausted {
    error E.X
}
fn main() ? {
    for k in range 3 {
        t mut It& = It()
        for x in try t { } catch { break }
    }
}
