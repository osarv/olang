# check: fail error[M19e]: two traits P satisfies both declare a default 'Shout'
# M19e: a default two satisfied traits both declare cannot be chosen between
type Named trait {
    Name() I32
}
type Labelled trait {
    Name() I32
}
fn (n <N Named>) Shout() I32 { return n.Name() * 2 }
fn (l <L Labelled>) Shout() I32 { return l.Name() * 3 }
type P struct(v I32) {
    v
}
fn (p P) Name() I32 { return p.v }
fn main() ? {
    p := P(1)
    x := p.Shout()
}
