# check: fail error[P2, D16e]: this function value closes before the join does
# P2/E13b: a task calling a function value read out of a field ("spawn h.f()") is held to P2 as an argument is: the
# closure lives no shorter than the storage it was read from, here a loop body's, which closes while the task runs
extern fn usleep(us U32) I32
type Hold struct(f fn()) { f }
fn main() ? {
    c mut Array<I64>& = Array<I64>(4, 0)
    join {
        for t in range 4 {
            b := Array<I64>(4, t + 1)
            h := Hold(fn() {
                usleep(50000)
                c[t] = b[t]
            })
            spawn h.f()
        }
    }
    println($c[0] " " $c[1] " " $c[2] " " $c[3])
}
