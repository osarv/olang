type Shape trait {
    Area() I32
}
fn (s <S Shape>&) Twice() I32 { return s.Area() * 2 }
type Sq struct(n I32) {
    n
}
fn (q Sq&) Area() I32 { return q.n * q.n }
fn (q Sq&) Twice(k I32) I32 { return k }
fn main() ? { }
