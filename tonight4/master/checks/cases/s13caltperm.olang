# check: fail this writes through a read-only reference
# S13c: alternatives binding one name meet - a writable payload and a read-only one bind a read-only x, so writing
# through it is rejected (it used to take the first alternative's permission, and write through R's read-only one)
type Node struct(v I32) {
    v
}
type Box enum {
    W(a mut Node&)
    R(n Node&)
}
fn poke(b Box) {
    match b {
        case Box.W(x), Box.R(x) { x.v = 99 }
    }
}
fn main() ? {
    n Node& = Node(7)
    poke(Box.R(n))
}
