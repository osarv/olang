# check: fail error[M6b]: '==' needs K's eq, which is private to its module
# also: in the standard library's code
# also: e10aprivateeq.olang:12:5: error[M6b]
# M6b: a private eq is "==" in its own module - and only there: the prelude's Map compares keys in its own code, which
# cannot call it, so the error is the program's, at the use that instantiated the Map
type K struct(n I32) { n }
fn (a K) eq(b K) Bool { return a.n % 10 == b.n % 10 }
fn (a K) Hash() I64 { return I64(a.n % 10) }
fn main() ? {
  assert K(1) == K(11)
  m := Map<K, I32>()
  m.Put(K(1), 5)
}
