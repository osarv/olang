# check: run
# O13a/O26a: a value built here and returned inside another one ("return W(e)", W holding it) lives where the result
# goes, as one returned itself does (o13afieldstore.olang) - so text stored into it is built there and outlives the
# return, read back after an arena churn. It used to be built in this block, a compile-time error (O26)
type H struct(r mut String&) {
    r
}
type W struct(h H) {
    h
}
fn mk(n I64, s mut String&) W {
    e := H(s)
    e.r = $n $n
    return W(e)
}
fn main() ? {
    q mut String& = "x"
    w := mk(12, q)
    churn()
    assert w.h.r.Len() == 4 and w.h.r == "1212"
}
fn churn() I64 {
    t I64 = 0
    for i in range 50 {
        a := Array<I64>(64, -7)
        t += a[3]
        x := $i $i $i $i
        t += x.Len()
    }
    return t
}
