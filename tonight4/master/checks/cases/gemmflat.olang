# check: run
# O8b: a loop of matrix products keeps its memory flat. A plain Gemm packs B into a panel of its own and then A into a
# smaller one, gives both back at its return, and the pool hands the same panels to the next product (it used to map a
# new B panel each time, the A panel lying on top of the old one - 400KB a product here, 120MB over the first loop); a
# GemmWorkspace keeps its panels from one product to the next itself, so the second loop allocates nothing at all
import "std/linalg"
import "std/os"

# the most this process has held resident, in kB
fn peakKb() I64 {
    status := try os.ReadFile("/proc/self/status") catch default ""
    at := try status.Find("VmHWM:") catch default -1
    if at < 0 { return -1 }
    line := status[at + 6:]
    end := try line.FindByte('\n') catch default line.Len()
    return try line[:end].Trim().Split(" ")[0].ParseInt() catch default -1
}

fn main() ? {
    a := linalg.Matrix<F32>(64, 128)
    b := linalg.Matrix<F32>(128, 784)
    c := linalg.Matrix<F32>(64, 784)
    a.Fill(1.0)
    b.Fill(0.5)
    for i in range 300 { linalg.Gemm(c, a, false, b, false) }
    ws := linalg.GemmWorkspace<F32>()
    for i in range 300 { ws.Gemm(c, a, false, b, false, 1.0, 1.0) }
    assert c.Get(0, 0) == 64.0 + 300.0 * 64.0 and c.Get(63, 783) == c.Get(0, 0)
    kb := peakKb()
    assert kb > 0 and kb < 30000
}
