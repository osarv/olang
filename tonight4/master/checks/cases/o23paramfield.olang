# check: fail error[O23, O11]: this stores into a '&p' field whose binding is not known through this path
# O23/O11: a '&of' field reached through a field of a parameter - its binding is the inner instance's, which nothing in
# setDeep can see, so the store is unverifiable
type N struct(v I32) {
    v
}
type Cur struct(of mut N&) {
    at mut N&of = of
}
type Outer struct(c mut Cur&) {
    c
}
fn setDeep(o mut Outer&, x mut N&) { o.c.at = x }
fn main() ? {
    outer mut N& = N(1)
    x mut N& = N(42)
    c := Cur(outer)
    o := Outer(c)
    setDeep(o, x)
}
