# check: fail expected an expression
# never: unknown function
# also: compilation failed with 2 errors
# a function whose body does not parse is still declared by its signature: the one syntax error is the one error, and
# every call to it - a method's too - is checked against its signature rather than reported as an unknown function
type P struct(x I32) { x }
fn t(x I32) I32 {
    y := (x +
    return y
}
fn (p P&) Get() I32 {
    return p.x +
}
fn u() I32 { return t(1) + t(2) }
fn main() ? {
    assert t(3) == 3 and u() == 3
}
