# check: run
# O26a: a reference local built here and returned - directly, inside a returned instance, as a Call instance given as a
# function value, or as a try's default - lives in the result scope, so each shape that once failed here is correct
type P struct(x I32) { x }
type NB struct(inner P&) { inner }
fn wrapped(x I32) NB& {
    q P& = P(x)
    return NB(q)
}
type Counter struct(start I64) {
    n I64 = start
}
fn (c mut Counter&) Call() I64 {
    c.n++
    return c.n
}
fn counter() fn() I64 {
    c mut Counter& = Counter(41)
    return c
}
type Node struct(v I32) {
    v
}
fn mk(k I64) Node& ? {
    if k > -5 { error }
    return Node(7)
}
fn fallback() Node& {
    n mut Node& = Node(42)
    return try mk(1) catch default n
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn main() ? {
    w := wrapped(5)
    g := counter()
    d := fallback()
    churn()
    assert w.inner.x == 5
    assert g() == 42 and g() == 43
    assert d.v == 42
}
