# check: fail error[O10c]: the callee needs one argument's scope to outlive another's
# O14b/T22a: a lambda handing back one of its arguments fits Fold's callback - whose type-variable result requires each
# argument to outlive the result - so Fold's result lives no longer than the words; kept past their block, it would not
fn main() ? {
    keep := List<String&>()
    keep.Push("x")
    longest String&keep = keep[0]
    for i in range 2 {
        words := List<String&>()
        words.Push($i "abc")
        longest = words.Iter().Fold(words[0], fn(best, w) { return w if w.Len() > best.Len() else best })
    }
}
