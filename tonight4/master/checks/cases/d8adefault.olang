# check: fail error[D8a]: a default is computed while compiling, and this one cannot be: it reads a mutable global, whose value is the running program's
# a default parameter value is evaluated on behalf of callers the declaration cannot see, so it must be
# computable at compile time - reading a mutable global is not
counter mut I32 = 0
fn f(n I32 = counter) I32 { return n }
test "never runs" { assert f() == 0 }
