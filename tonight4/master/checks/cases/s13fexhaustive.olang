# check: run
# S13f: an unguarded "case _" covers every value - a match used as a value over a number needs no nomatch, and a match
# statement every clause of which leaves leaves (D10a)
fn f(x I64) I64 {
    match x {
        case 1 { return 10 }
        case _ { return 20 }
    }
}
fn g(x F64) String {
    return match x {
        case _ if x < 0.0 => "negative"
        case _ => "not"
    }
}
fn main() ? {
    assert f(1) == 10 and f(5) == 20 and g(-1.0) == "negative" and g(2.0) == "not"
}
