# fannkuch-redux: every permutation of 0..n-1, each flipped (its first k+1 elements reversed, k its first element)
# until a 0 leads, counting flips (the Benchmarks Game's algorithm) - small integer arrays, indexed and swapped
import "std/io"
import "std/os"

# the checksum and the most flips any permutation took
fn fannkuch(n I64) (I64, I32) {
    perm := Array<I32>(n)
    perm1 := Array<I32>(n)
    count := Array<I32>(n)
    for i in range n { perm1[i] = I32(i) }
    maxFlips I32 = 0
    checksum I64 = 0
    permCount I64 = 0
    r I64 = n
    for {
        for r != 1 {
            count[r - 1] = I32(r)
            r--
        }
        for i in range n { perm[i] = perm1[i] }
        flips I32 = 0
        for perm[0] != 0 {
            k := perm[0]
            for i in range (k + 1) >> 1 {
                perm[i], perm[k - i] = perm[k - i], perm[i]
            }
            flips++
        }
        if flips > maxFlips { maxFlips = flips }
        checksum += flips if permCount % 2 == 0 else -flips
        # the next permutation: rotate the first r + 1 elements, as many times as count says
        for {
            if r == n { return checksum, maxFlips }
            first := perm1[0]
            for i in range r { perm1[i] = perm1[i + 1] }
            perm1[r] = first
            count[r]--
            if count[r] > 0 { break }
            r++
        }
        permCount++
    }
    unreachable        # the loop leaves only by its return (D10a counts no loop as leaving)
}

fn main() ? {
    args := os.Args()
    n I64 = 7
    times I64 = 1                # the whole run repeated, so a small size still times long enough
    if args.Len() > 1 { n = try args[1].ParseInt() }
    if args.Len() > 2 { times = try args[2].ParseInt() }
    checksum, maxFlips := fannkuch(n)
    for t in range times - 1 { checksum, maxFlips = fannkuch(n) }
    try io.Print($checksum "\nPfannkuchen(" $n ") = " $maxFlips "\n")
}
