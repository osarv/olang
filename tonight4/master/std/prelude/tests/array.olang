# the prelude's newer array methods, tested - a module of its own, not part of the prelude, so these are compiled only
# when they are run

test "CountOf counts runs from the start, without overlapping" {
    assert I32[1, 2, 1, 2, 1].CountOf(I32[1, 2]) == 2
    assert I32[1, 1, 1, 1].CountOf(I32[1, 1]) == 2              # not three: occurrences do not overlap
    assert I32[1, 2, 3].CountOf(I32[4]) == 0
    assert I32[1, 2].CountOf(I32[1, 2, 3]) == 0                 # longer than the array
    assert I32[1, 2, 3].CountOf(Array<I32>(0)) == 4             # the empty run is at every position
    assert Array<I32>(0).CountOf(Array<I32>(0)) == 1
    assert "banana".CountOf("an") == 2 and "aaaa".CountOf("aa") == 2 and "abc".CountOf("") == 4
}

test "Replace puts new in place of every run old, building the array once" {
    a := I32[1, 2, 3, 1, 2].Replace(I32[1, 2], I32[9])
    assert a.Len() == 3 and a[0] == 9 and a[1] == 3 and a[2] == 9
    assert I32[1, 2, 3].Replace(I32[7], I32[8, 8]).Len() == 3                      # nothing to replace
    b := I32[5, 5, 5].Replace(I32[5], Array<I32>(0))                            # removing every one
    assert b.Len() == 0
    assert "a-b-c".Replace("-", ", ") == "a, b, c"
    assert "aaaa".Replace("aa", "b") == "bb" and "aaa".Replace("aa", "b") == "ba"
    assert "abc".Replace("", "-") == "-a-b-c-" and "".Replace("", "x") == "x"   # the empty run is everywhere
    assert "".Replace("a", "b") == "" and "hello".Replace("hello", "") == ""
    assert "x".Replace("x", "xx").Replace("x", "xx") == "xxxx"
    t := "one two".Replace(" ", "  ")                     # an inherited array method gives a String back
    assert t.ToUpper() == "ONE  TWO"
}

test "Repeat and Reverse" {
    assert "ab".Repeat(3) == "ababab" and "ab".Repeat(1) == "ab"
    assert "ab".Repeat(0) == "" and "ab".Repeat(-2) == "" and "".Repeat(5) == ""
    r := I32[1, 2].Repeat(2)
    assert r.Len() == 4 and r[2] == 1 and r[3] == 2
    a := I32[1, 2, 3, 4, 5]
    a.Reverse()
    assert a[0] == 5 and a[2] == 3 and a[4] == 1
    e := Array<I32>(0)
    e.Reverse()
    one := I32[7]
    one.Reverse()
    assert one[0] == 7 and e.Len() == 0
    s := String(Array<Char>(3, 'x'))
    s[0] = 'a'
    s.Reverse()                                          # text reverses byte by byte
    assert s == "xxa"
    words := "c b a".Split(" ")
    words.Reverse()
    assert words.Join(" ") == "a b c"
}

# the same, computed while compiling (K2)
fn arrayReshaped() I64 {
    t := "a,b,,c".Replace(",", "::").Repeat(2)
    n := t.CountOf("::")
    r := I64[1, 2, 3, 4]
    r.Reverse()
    return n * 1000 + t.Len() * 10 + r[0]
}
arrayReshapedBaked := arrayReshaped()

test "CountOf, Replace, Repeat and Reverse, evaluated while compiling as at run time" {
    assert arrayReshapedBaked == 6 * 1000 + 18 * 10 + 4
    assert arrayReshaped() == arrayReshapedBaked
}
