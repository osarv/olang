# the neighbour of rect.olang, which imports it while it imports rect.olang back - a cycle between two
# files of one directory, legal as any import cycle is (M2).

import "rect"

fn Area(r rect.Rect) I32 {
    return r.W * r.H
}

# a method on a type this module declares over a primitive: reached through its receiver, from this
# module and from every module holding a value of it
type Side extends I32

fn (n Side) Squared() Side {
    return n * n
}

test "a value of a type declared in the neighbouring file" {
    r rect.Rect = rect.Rect(2, 5)
    assert Area(r) == 10
    four Side = 4
    assert four.Squared() == 16
}

GeomUnits String = "cm"

test "B9a: a condition reads a global of an imported module" {
    assert rect.UnitName().Eq("cm")
}

# G19: a key type whose Eq and Hash are declared here, named as a Map's key in rect.olang's signatures - and rect.olang
# is resolved before this module, so the constraint on the key waits until every signature is
type Tag extends Array<Char>
fn (a Tag&) Eq(b Tag&) Bool { return a.Len() == 0 and b.Len() == 0 or a.Len() > 0 and b.Len() > 0 and a[0] == b[0] }
fn (a Tag&) Hash() I64 { return 0 if a.Len() == 0 else I64(a[0]) }
