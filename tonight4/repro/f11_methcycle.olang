type Cell struct() {
    v I64 = 0
    kept mut Box& = null
}
type Box struct() { c mut Cell& = Cell() }
fn (h mut Box&) g(m mut Map<I64, Box>&, n I64) ? {
    h.c.kept = h
    if n > 0 { try f(m, n - 1) }
}
fn f(m mut Map<I64, Box>&, n I64) ? {
    b := try m.Get(1)
    try b.g(m, n)
}
fn main() ? {
    m := Map<I64, Box>()
    m.Put(1, Box())
    try f(m, 3)
}
