type V struct(xs Array<I64>&) { xs }
fn mk(n I64) V {
    a := I64[1, 2, 3, 4, 5]
    a[0] = n
    s := a[1:4]
    a = I64[9, 9, 9]
    return V(s)
}
fn churn() I64 {
    t I64 = 0
    for i in range 6000 {
        b := Array<I64>(5, i)
        t += b[0]
    }
    return t
}
fn main() ? {
    v := mk(1)
    churn()
    println($v.xs.Len() " " $v.xs[0] " " $v.xs[2])
}
