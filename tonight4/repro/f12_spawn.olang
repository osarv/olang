# the handle passed to a spawned callee that keeps its own storage
type Cell struct() {
    v I64 = 0
    kept mut Box& = null
}
type Box struct() { c mut Cell& = Cell() }
fn keepit(h mut Box&) { h.c.kept = h }
fn stash(h mut Box&) {
    join {
        spawn keepit(h)
    }
}
fn run(m mut Map<I64, Box>&) ? {
    for i in range 3 {
        c := try m.Get(1)
        stash(c)
    }
}
fn main() ? {
    m := Map<I64, Box>()
    m.Put(1, Box())
    try run(m)
}
