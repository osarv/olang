import "std/io"

type Token unique struct(id I64) {
    id
    uses I64 = 0
}

fn (t mut Token&) Use() { t.uses++ }

fn main() ? {
    v := Vec<Token>()
    v.Push(Token(1))
    c := v.View().Cycle()
    a := try c.Next()
    b := try c.Next()
    a.Use()
    io.Println($a.uses " " $b.uses " " $v[0].uses)!
}
