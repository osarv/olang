import "std/io"

type Buf struct(a Array<I64>) {
    a
}

fn (r Buf&) Peek(own Buf) I64 {
    own.a[0] = 99
    return r.a[0]
}

fn part(r Array<I64>&, own Buf) I64 {
    own.a[0] = 98
    return r[0]
}

fn arr(r Array<I64>&, own Array<I64>) I64 {
    own[0] = 97
    return r[0]
}

fn main() {
    t := Buf(Array<I64>(3, 1))
    a := t.Peek(t)
    t2 := Buf(Array<I64>(3, 1))
    b := part(t2.a, t2)
    t3 := Array<I64>(3, 1)
    c := arr(t3, t3)
    t4 := Array<I64>(3, 1)
    d := arr(t4[0:2], t4)
    io.Println($a " " $b " " $c " " $d)!
}
