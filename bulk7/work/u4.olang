import "std/io"

type Token unique struct(id I64) {
    id
    uses I64 = 0
}

fn (t mut Token&) Use() { t.uses++ }

fn dup<T>(x T) T, T { return x, x }

fn comp<T>(x T) Array<T> { return T[x for _ in range 2] }

fn main() {
    a, b := dup(Token(1))
    a.Use()
    io.Println($a.uses " " $b.uses)!
    c := comp(Token(2))
    c[0].Use()
    io.Println($c[0].uses " " $c[1].uses)!
}
