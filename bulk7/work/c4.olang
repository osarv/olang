import "std/io"

type Big struct(xs Array<I64>) {
    xs
}

fn run() String {
    g := Big(Array<I64>(2, 0))
    m, n := g, g
    m.xs[0] = 5
    n.xs[1] = 6
    v := Vec<I64>()
    v.Push(1)
    w, u := v, v
    w.Push(2)
    w[0] = 9
    arr := Array<I64>(2, 0)
    c, d := arr, arr
    c[0] = 3
    return $g.xs " " $m.xs " " $n.xs " | " $v " " $w " " $u " | " $arr " " $c " " $d
}

G := run()

fn main() {
    io.Println(run())!
    io.Println(G)!
}
