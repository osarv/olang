import "std/io"

type Res unique struct(id I64) {
    id
    open Bool = true
} destruct {
    io.Println("ended " $id)!
}

fn (r mut Res&) Close() { r.open = false }

type Holder struct(r Res) {
    r
}

fn keep(t Res) {
    alias := t   # a reference to t (T13b)
    {
        h Holder = Holder(t)   # t handed on: its last mention
        h.r.Close()
    }                          # h ends here: "ended 1"
    io.Println("alias, after its value ended: id " $alias.id " open " $alias.open)!
}

fn main() {
    keep(Res(1))
}
