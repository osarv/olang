import "std/io"

Ended mut I64 = 0

type Res unique struct(id I64) {
    id
} destruct {
    Ended = Ended * 10 + id
}

type Holder struct(r Res, n I64) {
    r, n
}

fn num(bad Bool) I64 ? Nope {
    if bad: error Nope
    return 4
}

# r handed on as the constructor's first argument; a later argument returns early first
fn pass(r Res, bad Bool) I64 {
    h := Holder(r, try num(bad) catch Nope { return -1 })
    return h.n
}

fn main() {
    pass(Res(1), true)
    io.Println("after an early return: " $Ended)!
}
