# F8 (wrong result vs SPEC D16c/E31d): a lambda capturing a struct that owns storage (an array field) or a Vec copies
# it shallowly - the lambda sees a later write to the array part (D16c: "a value is copied ... changing the variable
# afterwards does not change the lambda"; only a value ARRAY variable is borrowed) - and a capture never runs a
# declared Copy (E31d lists "a capture" among the copies that call it): see work/c3.olang, where `f := fn() { a.gen }`
# reads gen 0 with a Copy giving gen + 1, also for a Big holding an array.
# Expected "0 6 0" (g.xs and v copied, a borrowed); got "5 6 7" (built and interpret).
#   /home/user/wt/review7/build/olang f8_capture_copy.olang
import "std/io"

type Big struct(xs Array<I64>) {
    xs
}

fn main() {
    g := Big(Array<I64>(2, 0))
    h := fn() I64 { return g.xs[0] }
    g.xs[0] = 5
    a := Array<I64>(2, 0)
    k := fn() I64 { return a[0] }
    a[0] = 6
    v := Vec<I64>()
    v.Push(0)
    q := fn() I64 { return v[0] }
    v[0] = 7
    io.Println($h() " " $k() " " $q())!
}
