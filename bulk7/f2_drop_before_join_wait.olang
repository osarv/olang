# F2 (use after release; NEW, O15 48a4e5b): a by-value holder of a value with a destructor declared in a join block is
# ended by deferred code (check.dropOnExit), and deferred code runs BEFORE a join's wait (S19) - so the destructor runs
# while a spawned task still holds a reference to the value. The task here sees the destructor's effect (log has 1
# entry) while it is using the value: prints "1001 1"; expected "1 1" (destructor after the wait).
# Written `x := Res(1, l)` (held where the call lands, O16) it prints "1 1".
#   /home/user/wt/review7/build/olang f2_drop_before_join_wait.olang            -> 1001 1
#   /home/user/wt/review7/build/olang interpret f2_drop_before_join_wait.olang  -> 1001 1
import "std/io"

type Log struct() {
    seen := Vec<I64>()
}

type Res unique struct(id I64, log mut Log&) {
    id, log
    live Bool = true
} destruct {
    log.seen.Push(id)
}

fn use(r Res&) I64 {
    s I64 = 0
    for i in range 2000000 { s += i % 7 }
    return r.id + s - s + I64(r.log.seen.Len()) * 1000
}

fn main() {
    l := Log()
    n I64 = 0
    join {
        x Res = Res(1, l)
        spawn n = use(x)
    }
    io.Println($n " " $l.seen.Len())!
}
