Count mut I64 = 0
type R struct(v I64) {
    v
} destruct { Count.AtomicAdd(1) }
type Node struct(v I64) {
    v
    r mut R& = null
}
fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn run() {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    c mut Node& = Node(0)
    fa := fn(i I64) { a.r = R(i) }
    fb := fn(i I64) { b.r = R(i) }
    join {
        spawn work(fa, 1000)
        spawn work(fb, 1000)
        for i in range 1000 { c.r = R(i) }
    }
    fa(5)
    if Count != 0 { fail }
}
fn main() ? {
    run()
    println($Count)
}
