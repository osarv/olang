type Node struct(v I64) {
    v
    next mut Node& = null
}
type Holder struct(m mut Node&) {
    n mut Node&m = m
}
fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn main() ? {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    ha mut Holder& = Holder(a)
    hb mut Holder& = Holder(b)
    fa := fn(i I64) { ha.n.next = Node(i) }
    fb := fn(i I64) { hb.n.next = Node(i) }
    c mut Node& = Node(0)
    join {
        spawn work(fa, 300000)
        spawn work(fb, 300000)
        for i in range 300000 { c.next = Node(i) }
    }
    println($a.next.v " " $b.next.v " " $c.next.v)
}
