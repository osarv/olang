import "std/os"
type Node struct(v I64) {
    v
    w I64 = v * 3
    next mut Node& = null
}
type Acc struct(v I64) {
    v
}
fn mk(r Node&, i I64) Node&r { return Node(i) }
fn work(f fn(i I64) I64, n I64) I64 {
    s I64 = 0
    for i in range n { s += f(i) }
    return s
}
fn inner(f fn(i I64) I64, n I64) I64 {
    s1, s2, s4 I64
    box mut Acc& = Acc(0)
    join {
        spawn s1 = work(f, n)
        spawn s2 = work(f, n)
        os.RunOnStack(1 << 20, fn() { box.v = work(f, n) })
        s4 = work(f, n)
    }
    return s1 + s2 + box.v + s4
}
fn main() ? {
    root Node& = Node(0)
    f := fn(i I64) I64 {
        n := mk(root, i)
        return n.v + n.w
    }
    t1, t2, t4 I64
    box mut Acc& = Acc(0)
    join {
        spawn t1 = inner(f, 20000)
        spawn t2 = inner(f, 20000)
        os.RunOnStack(1 << 20, fn() { box.v = inner(f, 20000) })
        for i in range 20000 { t4 += mk(root, i).v }
    }
    want I64 = 0
    for i in range 20000 { want += 4 * i }
    println($(t1 == 4 * want) " " $(t2 == 4 * want) " " $(box.v == 4 * want) " " $(t4 * 4 == want))
}
