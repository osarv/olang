type Node struct(v I64) {
    v
    next mut Node& = null
}
fn orNew(n Node&, i I64) Node&n { return n if i < 0 else Node(i) }
fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn main() ? {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    fa := fn(i I64) { x := orNew(a, i) }
    fb := fn(i I64) { x := orNew(b, i) }
    c mut Node& = Node(0)
    join {
        spawn work(fa, 300000)
        spawn work(fb, 300000)
        for i in range 300000 { c.next = Node(i) }
    }
    println($a.next.v " " $b.next.v " " $c.next.v)
}
