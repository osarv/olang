type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() {
    f fn(i I64) = null
}
fn make(b mut Box&, x mut Node&) {
    b.f = fn(i I64) { x.next = Node(i) }
}
fn main() ? {
    b mut Box& = Box()
    for k in range 2 {
        x mut Node& = Node(0)
        join { spawn make(b, x) }
    }
    b.f(3)
}
