import "std/os"
Count mut I64 = 0
type R struct(v I64) {
    v
} destruct { Count.AtomicAdd(1) }
type Node struct(v I64) {
    v
    w I64 = v * 3
}
fn mk(r Node&, i I64) Node&r { return Node(i) }
fn mkr(r Node&, i I64) R&r { return R(i) }
fn maker(root Node&) fn(i I64) I64 {
    return fn(i I64) I64 {
        n := mk(root, i)
        k := mkr(root, i)
        return n.v + n.w + k.v - i
    }
}
fn work(f fn(i I64) I64, n I64) I64 {
    s I64 = 0
    for i in range n { s += f(i) }
    return s
}
fn deep(f fn(i I64) I64, n I64) I64 {
    a, b I64
    box mut Node& = Node(0)
    join {
        spawn a = work(f, n)
        os.RunOnStack(1 << 20, fn() { box.v = work(f, n) })
        b = work(f, n)
    }
    return a + b + box.v
}
fn run() I64 {
    root Node& = Node(0)
    f fn(i I64) I64 = null
    join { spawn f = maker(root) }
    x, y, z I64
    join {
        spawn x = deep(f, 2000)
        spawn y = deep(f, 2000)
        z = deep(f, 2000)
    }
    want I64 = 0
    for i in range 2000 { want += 4 * i }
    return 1 if x == 3 * want and y == 3 * want and z == 3 * want else 0
}
fn main() ? {
    ok := run()
    println("ok " $ok " dtors " $Count)
}
