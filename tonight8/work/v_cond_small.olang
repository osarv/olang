type Node struct(v I64) {
    v
    next mut Node& = null
}

fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn main() ? {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    fa := fn(i I64) { a.next = a.next if i < 0 else Node(i) }
    fb := fn(i I64) { b.next = b.next if i < 0 else Node(i) }
    c mut Node& = Node(0)
    join {
        spawn work(fa, 2000)
        spawn work(fb, 2000)
        for i in range 2000 { c.next = Node(i) }
    }
    println($a.next.v " " $b.next.v " " $c.next.v)
}
