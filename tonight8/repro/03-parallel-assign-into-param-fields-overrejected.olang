# PRE-EXISTING over-rejection (48f82fb gives the same errors), low: a parallel assignment of a new node and a number
# into fields of a reference parameter (or of a lambda's captured reference) is refused, where the same assignment in
# main, or "a.next = Node(i)" alone in the function, is accepted (S4c: the held value is judged split, O17a, then O25).
#   expected: builds, prints "4 4"
#   actual:   error[O17a] and error[O25] at line 10 (the "set" line)
type Node struct(v I64) {
    v
    next mut Node& = null
}
fn set(a mut Node&, i I64) { a.next, a.v = Node(i), i }
fn main() ? {
    a mut Node& = Node(0)
    set(a, 3)
    a.next, a.v = Node(4), 4
    println($a.next.v " " $a.v)
}
