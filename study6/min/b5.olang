type Value enum {
    Nil
    Num(n F64)
    Fn(c Closure&)
}
type Closure struct(arity I64) {
    arity

}
type Env struct(parent Env&) {
    vars mut Map<String&, Value>& = Map<String&, Value>()
    parent
}
fn main() ? {
    g := Env(null)
    g.vars.Put("x", Value.Num(1.0))
    g.vars.Put("f", Value.Fn(Closure(2)))
    println($g.vars.Len())
}
