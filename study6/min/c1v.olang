type Env struct(parent mut Env&) {
    n mut I64 = 0
    parent
}
type Closure struct(env mut Env&) {
    env
}
type Value enum {
    Nil
    Fn(c Closure&)
}
fn depth(f Value&) I64 {
    match f {
        case Value.Fn(c) {
            e := c.env
            local := Env(e)
            local.n = 1
            return local.n + c.env.n
        }
        nomatch { return 0 }
    }
}
fn main() ? {
    g mut Env& = Env(null)
    f Value& = Value.Fn(Closure(g))
    println($depth(f))
}
