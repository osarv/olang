# (a) BUG, use after scope closed / wrong output: a mutating method called on an element read out of a List -
# 'users[i].Push(x)' with users a List<List<I64>> (or 'boxes[i].items.Push(x)', a List field of a struct element) -
# inside a loop allocates the inner list's new chunk in the loop body's arena (the arena the element copy At gave back
# landed in), while the chunk is linked into the inner list's state, which lives where users does. The next turn reuses
# the arena: -b and -d print "1 3552632 3552632", -s aborts with "use after scope closed", -i prints the right
# "1 30 300".
#   l := users[i]; l.Push(x)        in the loop: correct
#   users[3].Push(x)                outside a loop: correct
#   m.Put(i, List<I64>()); l := try m.Get(i); l.Push(x)    correct
#   (try m.Get(i)).Push(x)          in a loop: the same use after scope closed - any call's value result
#   for l in lists { l.Push(x) }, for e in m { e.Value.Push(x) }, boxes[i].items.Push(x) with boxes a List<Box&>: correct
# Found as a segfault (no output at all) in progs/mk.olang: 'g.users[j].Push(i)', filling a dependency graph's reverse
# edges - the adjacency list every graph program has.
# Expected: the callee allocates where the element's state lives (the receiver's referents), not where the copy of
# the handle landed - or the call is rejected as study 5's r02 asked for a mut method on an At value.
type Box struct(v I64) {
    v
    items mut List<I64>& = List<I64>()
}
fn main() ? {
    users := List<List<I64>>()
    boxes := List<Box>()
    for i in range 5 {
        users.Push(List<I64>())
        boxes.Push(Box(i))
    }
    for i in range 5 {
        users[i].Push(i * 10)
        boxes[i].items.Push(i * 100)
    }
    churn := List<String&>()
    for i in range 1000 { churn.Push("x" $i) }
    println($users[3].Len() " " $users[3][0] " " $boxes[3].items[0])
}
