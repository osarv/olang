import "std/io"
type Node struct(v I32) { v mut }
type Box enum {
    Has(n Node&)
    Two(a Node&, b Node&)
    Empty
}
fn churn() {
    for i in range 2000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n Node& = Node(I32(i))
    }
}
fn ro(n Node&) Node&n { return n }
fn main() ? {
    outer Node& = Node(1)
    keep := ro(outer)
    for i in range 2 {
        inner Node& = Node(42)
        b := Box.Two(outer, inner)
        match b {
            case Box.Two(x, y) { keep = y }
            nomatch { }
        }
    }
    churn()
    try io.Print($keep.v "\n")
}
