import "std/io"
fn f() I32 {
    x I32 = 1
    defer { x = 5 }
    return x
}
fn g() I32 {
    total I32 = 0
    for i in range 5 {
        defer { total += 10 }
        if i == 1 { continue }
        if i == 3 { break }
        total += 1
    }
    return total
}
fn h() Array<I32> {
    a := Array<I32>(3, 7)
    defer { a[0] = 99 }
    return a
}
fn k() I32 {
    r I32 = 0
    for once in range 1 {
        defer { r = r * 2 }
        defer { r = r + 3 }
        r = 1
    }
    return r
}
G1 I32 = f()
G2 I32 = g()
G3 I32 = h()[0]
G4 I32 = k()
fn main() ? {
    a := f()
    b := g()
    c := h()[0]
    d := k()
    try io.Print($G1 " " $G2 " " $G3 " " $G4 " | " $a " " $b " " $c " " $d "\n")
}
