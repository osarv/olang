# match value: a reference from an inner block flows to an outer one
import "std/io"
type Node struct(v I32) { v mut }
fn churn() {
    for i in range 2000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n Node& = Node(I32(i))
    }
}
fn main() ? {
    outer Node& = Node(1)
    keep Node& = outer
    for i in range 2 {
        inner Node& = Node(42)
        keep = match i { case 0, 1 => inner  nomatch => outer }
    }
    churn()
    try io.Print($keep.v "\n")
}
