import "std/io"
type Box enum {
    Has(a Array<I64>&)
    No
}
fn apply(f fn() I64) I64 { return f() }
fn sumB(b Box) I64 { return (b as Box.Has)[0] }
fn main() ? {
    out := Array<I64>(4)
    join {
        for i in range 4 {
            a := Array<I64>(1000, i + 1)
            spawn out[i] = apply(fn() { return a[0] })
            spawn out[i] = sumB(Box.Has(a))
        }
    }
    try io.Print($out[0] "\n")
}
