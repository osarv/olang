# try catch default: a temporary default, the result landing in an outer variable
import "std/io"
type Node struct(v I32) { v mut }
fn churn() {
    for i in range 2000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n Node& = Node(I32(i))
    }
}
fn mk(k I64) Node& ? {
    if k > -5 { error }
    return Node(7)
}
fn main() ? {
    keep Node& = Node(1)
    for i in range 2 {
        keep = try mk(i) catch default Node(42)
    }
    churn()
    try io.Print($keep.v "\n")
}
