# an element of a call's built result, stored in an outer variable
import "std/io"
type Node struct(v I32) { v mut }
fn churn() {
    for i in range 3000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n Node& = Node(I32(i))
        a := Array<I32>(8, 7)
    }
}
fn mkNodes(v I32) Array<mut Node&>& {
    n Node&return = Node(v)
    return Array<mut Node&>(2, n)
}
fn main() ? {
    k2 Node& = Node(1)
    for i in range 2 {
        k2 = mkNodes(43)[0]
    }
    churn()
    try io.Print($k2.v "\n")
}
