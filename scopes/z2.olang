import "std/io"
type Node struct(v I32) { v mut }
type H2 struct(a Node&, b Node&) {
    a
    b
}
fn churn() {
    for i in range 3000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n Node& = Node(I32(i))
    }
}
fn mkH(o Node&, v I32) H2 { return H2(o, Node(v)) }
fn ro(n Node&) Node&n { return n }
fn main() ? {
    outer Node& = Node(1)
    keep := ro(outer)
    for i in range 2 {
        h := mkH(outer, 42)
        keep = h.b
    }
    churn()
    try io.Print($keep.v "\n")
}
