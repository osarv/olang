import "std/io"
type Counter struct(start I64) { n mut I64 = start }
fn (c mut Counter&) Call() I64 {
    c.n++
    return c.n
}
type Cbox struct(f fn() I64) { f }
type Cb2 struct() { f mut fn() I64 = null }
fn churn() {
    for i in range 3000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        a := Array<I64>(8, 7)
    }
}
fn main() ? {
    keep Cbox& = Cbox(fn() { return 0 })
    cb Cb2& = Cb2()
    for i in range 2 {
        c Counter& = Counter(41)
        keep = Cbox(c)
        cb.f = c
    }
    churn()
    try io.Print($(keep.f)() " " $(cb.f)() "\n")
}
