import "std/io"
type Node struct(v I32) { v mut }
type Holder struct(n Node&) { n }
fn churn() {
    for i in range 3000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n Node& = Node(I32(i))
    }
}
fn ro(n Node&) Node&n { return n }
fn main() ? {
    outer Node& = Node(1)
    keep := ro(outer)
    for i in range 2 {
        inner Node& = Node(42)
        arr := Holder[Holder(inner), Holder(inner)]
        for h in arr { keep = h.n }
        keep = arr[0].n
    }
    churn()
    try io.Print($keep.v "\n")
}
