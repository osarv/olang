# non-generic: a by-value Holder parameter returned as is
import "std/io"
type Node struct(v I32) { v mut }
type Holder struct(n Node&) { n }
fn churn() {
    for i in range 2000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n Node& = Node(I32(i))
    }
}
fn idh(x Holder) Holder { return x }
fn main() ? {
    outer Node& = Node(1)
    keep Holder = Holder(outer)
    for i in range 2 {
        inner Node& = Node(42)
        h2 := Holder(inner)
        keep = idh(Holder(inner))
    }
    churn()
    try io.Print($keep.n.v "\n")
}
