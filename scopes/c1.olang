# spawn target: borrowed result of an argument declared in the join block
import "std/io"
type Node struct(v I32) { v mut }
fn churn() {
    for i in range 2000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n Node& = Node(I32(i))
    }
}
fn same(n Node&) Node&n { return n }
fn mk(v I32) Node& { return Node(v) }
fn main() ? {
    keep Node& = Node(1)
    keep2 Node& = Node(1)
    join {
        spawn keep2 = mk(43)
    }
    churn()
    try io.Print($keep.v " " $keep2.v "\n")
}
