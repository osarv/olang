import "std/io"
type Node struct(v I32) { v mut }
fn churn() {
    for i in range 2000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n Node& = Node(I32(i))
    }
}
fn f(a Node&, b Node&, c Bool) Node&a { return a if c else b }
fn g(a Node&, b Node&, k I32) Node&a { return match k { case 1 => a  nomatch => b } }
fn h(a Node&, b Node&, c Bool) Node&a {
    if c { return a }
    return try fail1() catch default b
}
fn fail1() Node& ? { error }
fn ro(n Node&) Node&n { return n }
fn main() ? {
    outer Node& = Node(1)
    k1 := ro(outer)
    for i in range 2 {
        inner Node& = Node(42)
        k1 = h(outer, inner, false)
    }
    churn()
    try io.Print($k1.v "\n")
}
