# the same through a method and a returned cursor
import "std/io"
type N struct(v I32) {
    v mut
    next mut N& = null
}
type Cur struct(of mut N&) { at mut N&of = of }
fn churn() {
    for i in range 2000 {
        s := $i "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        n N& = N(I32(i))
    }
}
fn (c mut Cur&) Set(x mut N&) { c.at = x }
fn mkCur(n mut N&) Cur& { return Cur(n) }
fn main() ? {
    outer N& = N(1)
    c := mkCur(outer)
    for i in range 2 {
        inner N& = N(42)
        c.Set(inner)
    }
    churn()
    try io.Print($c.at.v "\n")
}
