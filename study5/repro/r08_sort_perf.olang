# PERF: Array.Sort (stable, in place by rotation, O(n log^2 n)) on 1M F64/I64: 0.50 s; C qsort 0.20 s,
# std::stable_sort 0.12 s, std::sort 0.11 s (r08_sort_perf.cpp, clang++ -O3 -march=native).
import "std/rand"
import "std/time"
fn main() ? {
    r := rand.Rand(3)
    n := 1000000
    a := Array<F64>(n)
    for i in range n { a[i] = r.Float() }
    t := time.Now()
    a.Sort(fn(x, y) { return x < y })
    println("olang Sort 1M F64: " $(F64(time.Since(t)) / 1e9) " s, sorted " $(a[0] <= a[n / 2] and a[n / 2] <= a[n - 1]))
    b := Array<I64>(n)
    for i in range n { b[i] = I64(r.Below(1000000000)) }
    t = time.Now()
    b.Sort(fn(x, y) { return x < y })
    println("olang Sort 1M I64: " $(F64(time.Since(t)) / 1e9))
}
