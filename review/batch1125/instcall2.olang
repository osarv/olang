import "std/io"

# per-value condition 6, instCall: a struct given by value (W, holding a Vec, no reference - InstPlain to instRoot)
# beside the root; the result views the struct's Vec; the struct local's Vec then replaced
N I64 = 2000

type W struct(v Vec<I64>) {
    v
}

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 30: w.Push(i + j)
    return w
}

fn pick(a Array<Vec<I64>>&, b W) Array<I64>& {
    if a.Len() > 100: return a[0].View()
    return b.v.View()
}

fn main() {
    t := 0
    for i in range N {
        rows := Array<Vec<I64>>(4, Vec<I64>())
        for k in range 4: rows[k] = mk(k + i)
        w := W(mk(i * 5))
        r := pick(rows, w)
        w.v = mk(i * 3)
        junk := mk(777)
        t += r[1] + junk[1] + w.v[2]
    }
    io.PutLn($t)!
}
