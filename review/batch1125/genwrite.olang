import "std/io"

# per-value condition 6: a generator given a mut reference to the root writes an element between Next calls - the
# let-go is `g.Next()`, its text names g
N I64 = 2000

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 30: w.Push(i + j)
    return w
}

fn regen(p mut Array<Vec<I64>>&, i I64) Iterator<I64> {
    for k in range 3 {
        p[0] = mk(i + k)
        yield k
    }
}

fn main() {
    t := 0
    for i in range N {
        rows := Array<Vec<I64>>(4, Vec<I64>())
        for k in range 4: rows[k] = mk(k + i)
        r Array<I64>& = rows[0].View()
        g := regen(rows, i * 3)
        a := try g.Next() catch default 0
        junk := mk(777)
        t += r[1] + junk[1] + rows[0][2] + a
    }
    io.PutLn($t)!
}
