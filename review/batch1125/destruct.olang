import "std/io"

# per-value condition 6: a mut reference to the root given by a destructuring (S4b) of a call returning it beside a
# number, then written through
N I64 = 2000

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 30: w.Push(i + j)
    return w
}

fn both(a mut Array<Vec<I64>>&) mut Array<Vec<I64>>&, I64 { return a, 1 }

fn main() {
    t := 0
    for i in range N {
        rows := Array<Vec<I64>>(4, Vec<I64>())
        for k in range 4: rows[k] = mk(k + i)
        r Array<I64>& = rows[0].View()
        p, n := both(rows)
        p[0] = mk(i * 3)
        junk := mk(777)
        t += r[1] + junk[1] + rows[0][2] + n
    }
    io.PutLn($t)!
}
