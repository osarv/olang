import "std/io"

# gap 17a keptView: a constructor's instance viewing a Map local, the argument's copy left out - the local then written
# (grown past its slots) while the instance lives, in the builder and in the loop
N I64 = 2000

type S struct(m Map<String, I64>) {
    m
}

fn S.mk(i I64) S {
    m Map<String, I64>
    for j in range 4: m.Put($i + "-" + $j + " padded out a little", j)
    s := S(m)
    for j in range 60: m.Put($j + "+" + $i + " grown past the first slots", j)
    m.Put("zz", 5)
    return s
}

fn main() {
    rows := Array<S>(10, S(Map<String, I64>()))
    t := 0
    for i in range N {
        rows[i % 10] = S.mk(i)
        m Map<String, I64>
        for j in range 4: m.Put($j + "-" + $i + " padded out a little", i + j)
        s := S(m)
        for j in range 60: m.Put($j + "*" + $i + " grown past the first slots", j)
        junk Map<String, I64>
        for j in range 60: junk.Put($j + "/" + $i + " junk junk junk junk junk", j)
        rows[(i + 5) % 10] = s
        t += rows[i % 10].m.Len() + s.m.Len() + (try s.m.Get("0-" + $i) catch default -1) + (try rows[i % 10].m.Get($i + "-3 padded out a little") catch default -1)
    }
    io.PutLn($t + " " + $rows[3].m.Len())!
}
