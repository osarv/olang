import "std/io"

# per-value condition 6: a struct local holding a mut reference, declared pointing at another array and repointed at
# the root through its field, then written through (`h.a[0] = ...`)
N I64 = 2000

type H struct(a mut Array<Vec<I64>>&) {
    a
}

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 30: w.Push(i + j)
    return w
}

fn main() {
    t := 0
    spare := Array<Vec<I64>>(4, Vec<I64>())
    for i in range N {
        rows := Array<Vec<I64>>(4, Vec<I64>())
        for k in range 4: rows[k] = mk(k + i)
        h := H(spare)
        r Array<I64>& = rows[0].View()
        h.a = rows
        g := h
        g.a[0] = mk(i * 3)
        junk := mk(777)
        t += r[1] + junk[1] + rows[0][2]
    }
    io.PutLn($t)!
}
