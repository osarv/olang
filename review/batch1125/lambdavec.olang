import "std/io"

# per-value condition 6: a second name (p, a mut reference to the root rows) captured by a lambda that a Vec holds,
# not a local; the let-go is the Vec's element called (`fs[0]()`), whose text names neither rows nor p
N I64 = 2000

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 30: w.Push(i + j)
    return w
}

fn main() {
    t := 0
    for i in range N {
        rows := Array<Vec<I64>>(4, Vec<I64>())
        for k in range 4: rows[k] = mk(k + i)
        p mut Array<Vec<I64>>& = rows
        fs Vec<fn&()>
        fs.Push(fn() { p[0] = mk(i * 3) })
        r Array<I64>& = rows[0].View()
        fs[0]()
        junk := mk(777)
        t += r[1] + junk[1] + rows[0][2]
    }
    io.PutLn($t)!
}
