import "std/io"

type Node struct(v I64) {
    v
    next mut Node?& = null
}

type Box struct() { head mut Node& = Node(1) }

fn churn() I64 {
    t I64 = 0
    for _ in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}

fn grow(b mut Box&, v I64) {
    n := b.head
    for i in range 5 { n.next = Node(v + i) }
}

fn rd(n Node&) I64 {
    if n.next is null { return 0 }
    return n.next!.v
}

fn main() ? {
    c := churn() < 0
    w1 mut Box& = Box()
    k1 := w1.head
    {
        w2 mut Box& = Box()
        t := w1 if c else w2
        u := w2 if c else w1
        join {
            spawn grow(t, 10)
            spawn grow(u, 20)
        }
        assert rd(w2.head) == 24
    }
    churn()
    assert rd(k1) == 14
    try io.Println($rd(k1))
}
