type Node struct(v I64) {
    v
}
type Holder struct(f fn() I64) {
    g fn() I64 = f
}
fn mk(n Node&) Holder {
    return Holder(fn() I64 { return n.v + 1 })
}
fn smash(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return smash(d - 1) + a[5] - d
}
fn main() ? {
    n := Node(41)
    h := mk(n)
    t := smash(50)
    println($h.g() " " $t)
}
