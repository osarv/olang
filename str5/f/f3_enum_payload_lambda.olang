type Node struct(v I64) {
    v
}
type E enum {
    F(f fn() I64)
    No
}
fn mk(n Node&) E {
    return E.F(fn() I64 { return n.v + 1 })
}
fn smash(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return smash(d - 1) + a[5] - d
}
fn main() ? {
    n := Node(41)
    e := mk(n)
    t := smash(50)
    match e {
        case E.F(f) { println($f() " " $t) }
        case E.No { }
    }
}
