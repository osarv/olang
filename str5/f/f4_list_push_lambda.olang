type Node struct(v I64) {
    v
}
fn mk(n Node&, l mut List<fn() I64>&) {
    l.Push(fn() I64 { return n.v + 1 })
}
fn smash(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return smash(d - 1) + a[5] - d
}
fn main() ? {
    n := Node(41)
    l := List<fn() I64>()
    mk(n, l)
    t := smash(50)
    println($l[0]() " " $t)
}
