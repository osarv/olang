type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn nv(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
fn grow(x mut Node&) { x.next = Node(x.v + 100) }
type E enum {
    One(n mut Node&)
    Two
}
type B2 struct(e E) {
    e
}
fn (b B2&) Str() String {
    match b.e {
        case E.One(n) { n.next = Node(5) }
        case E.Two { }
    }
    return "e"
}
fn work(b Bag&) String {
    x := B2(E.One(b.head))
    return $x
}
fn main() ? {
    b := Bag(Node(1), 3)
    println(work(b))
    t := churn(100)
    println($nv(b.head) " " $t)
}
