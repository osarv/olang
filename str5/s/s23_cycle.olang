type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn nv(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
fn grow(x mut Node&) { x.next = Node(x.v + 100) }
fn ra(n mut Node&, c I64) {
    if c > 0 { rb(n, c - 1) }
}
fn rb(n mut Node&, c I64) {
    if c == 0 { n.next = Node(5) } else { ra(n, c) }
}
fn (b Bag&) Str() String {
    ra(b.head, 3)
    return "b" $b.k
}
fn main() ? {
    b := Bag(Node(1), 3)
    println($b)
    t := churn(100)
    println($nv(b.head) " " $t)
}
