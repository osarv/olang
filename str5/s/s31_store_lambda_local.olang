type Node struct(v I64) {
    v
    next mut Node& = null
    f fn() I64 = null
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn nv(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
fn fv(n Node&) I64 {
    if n.f == null { return -1 }
    return n.f()
}
fn (b Bag&) Str() String {
    f := fn() I64 { return b.head.v + 10 }
    b.head.f = f
    return "b" $b.k
}
fn main() ? {
    b := Bag(Node(1), 3)
    println($b)
    t := churn(100)
    println($nv(b.head) " " $fv(b.head) " " $t)
}
