type Node struct(v I64) {
    v
    next mut Node& = null
}
type Cell struct(n mut Node&) {
    n
}
type Col struct(c mut Array<Cell>&) {
    c
}
fn (c Col&) At(i I64) Cell { return c.c[i] }
fn (c mut Col&) SetAt(i I64, v Cell) { c.c[i] = v }
type Bag struct(col mut Col&, k I64) {
    col
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn (b Bag&) Str() String {
    b.col[0].n = Node(5)
    return "b" $b.k
}
fn main() ? {
    b := Bag(Col(Array<Cell>(1, Cell(Node(1)))), 3)
    println($b)
    t := churn(100)
    println($b.col[0].n.v " " $t)
}
