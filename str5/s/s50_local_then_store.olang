type Node struct(v I64) {
    v
    next mut Node& = null
    p Pr = Pr(null)
}
type Pr struct(n mut Node&) {
    n
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn pv(n Node&) I64 {
    if n.p.n == null { return 0 }
    return n.p.n.v
}
fn mkv(v I64) Pr { return Pr(Node(v)) }
fn mayf(n mut Node&) Pr ? {
    if n.v > 0 { error }
    return Pr(n)
}
fn (b Bag&) Str() String {
    x := mkv(5)
    b.head.p = x
    return "b" $b.k
}
fn main() ? {
    b := Bag(Node(1), 3)
    println($b)
    t := churn(100)
    println($pv(b.head) " " $t)
}
