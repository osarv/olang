# CONFIRMED, as c1, through the prelude: Map.Get's result lives where the receiver's map keeps its values, so the default
# g(5) is built in "$"'s scope and hung off the receiver's node. -b: "b / 100 0"; -b -s: "use after scope closed" (134);
# -i: "b / 5 0". bbf115f the same; e27b83b refused
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(head mut Node&, m Map<I64, mut Node&>) {
    head
    m
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn g(v I64) mut Node& { return Node(v) }
fn (b Bag&) Str() String {
    b.head.next = try b.m.Get(7) catch default g(5)
    return "b"
}
fn main() ? {
    b := Bag(Node(1), Map<I64, mut Node&>())
    println($b)
    t := churn(100)
    w := 0 if b.head.next == null else b.head.next.v
    println($w " " $t)
}
