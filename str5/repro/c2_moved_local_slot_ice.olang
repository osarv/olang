# CONFIRMED (since round 4, bbf115f; e27b83b refused it), an internal compiler error: a value local that O26a moves into a
# borrowed result's home (h returns p.n, borrowed from n) has its own slot allocated there (cgVarDecl, storeInResult ->
# cgArenaAllocFor(slot, resultHere)). The walk's STATEMENT_VAR_DECL counts the initializer's builds at mbiDeclIs, never the
# slot itself, so h's memo for &n says "no", Str is accepted, and codegen's hold stops the compiler:
#   olang: internal compiler error: 'h' builds where '&n' lives, which the checker's walk (E11c, SemanticMayBuildInto) found
#   it never does - a bug in the compiler, not in the program
# (-b, -b -s, -b -d alike; -i prints "b31 / 0 0"). With "n.pp = p" added (a borrow of p kept in the receiver's node) it is
# the same internal error - which is what stops it being a use-after-free.
type Node struct(v I64) {
    v
    next mut Node& = null
    pp P2& = null
}
type P2 struct(n mut Node&) {
    n
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn h(n mut Node&) mut Node&n {
    p := P2(n)
    return p.n
}
fn (b Bag&) Str() String {
    x := h(b.head)
    return "b" $b.k $x.v
}
fn main() ? {
    b := Bag(Node(1), 3)
    println($b)
    t := churn(100)
    w := 0 if b.head.pp == null else b.head.pp.n.v
    println($w " " $t)
}
