# CONFIRMED, as c1, for a checked index: cgTrySlotType gives where the element lives (cgWhereBuilt), the receiver's
# array, as the default's landing scope. -b: "b3 / 99 0"; -b -s: "use after scope closed" (134); -i: "b3 / 5 0".
# The same on bbf115f AND on e27b83b (round 3): this form predates round 4
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(arr Array<mut Node&>&, k I64) {
    arr
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn g(v I64) mut Node& { return Node(v) }
fn (b Bag&) Str() String {
    b.arr[0].next = try b.arr[b.k] catch default g(5)
    return "b" $b.k
}
fn main() ? {
    b := Bag(Array<mut Node&>(1, Node(1)), 3)
    println($b)
    t := churn(100)
    w := 0 if b.arr[0].next == null else b.arr[0].next.v
    println($w " " $t)
}
