# CONFIRMED, as c1, one call down: pick's memo for &n says "no" (the same miss in pick's body), so codegen holds pick to it -
# but pick allocates nothing itself, it only hands &n to g as g's landing result scope, so cgCheckMayBuild (which sees
# allocations made in the body being emitted) never fires: silent. -b: "b3 / 100 0"; -b -s: "use after scope closed";
# -i: "b3 / 5 0"
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn nv(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
fn grow(x mut Node&) { x.next = Node(x.v + 100) }
fn f(n mut Node&) mut Node&n ? {
    if n.v > 0 { error }
    return n
}
fn g(v I64) mut Node& { return Node(v) }
fn pick(n mut Node&) mut Node&n { return try f(n) catch default g(5) }
fn (b Bag&) Str() String {
    b.head.next = pick(b.head)
    return "b" $b.k
}
fn main() ? {
    b := Bag(Node(1), 3)
    println($b)
    t := churn(100)
    println($nv(b.head) " " $t)
}
