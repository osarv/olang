# CONFIRMED, as c1, inside a spawned lambda capturing the receiver: the lambda's memo for its capture misses the default, so
# the task builds g(5) in its part of "$"'s scope (__olang_capture_scope), folded and freed with it. -b: "b3 / 99 0";
# -b -r: "b3 / 99 0" (no race - the task has its own part); -b -s: "use after scope closed"; -i: "b3 / 5 0".
# Also as a transient lambda (ap(fn() { ... })), in a defer, through a generic or a call cycle, as an assignment, as an argument
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn nv(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
fn grow(x mut Node&) { x.next = Node(x.v + 100) }
fn f(n mut Node&) mut Node&n ? {
    if n.v > 0 { error }
    return n
}
fn g(v I64) mut Node& { return Node(v) }
fn (b Bag&) Str() String {
    join { spawn fn() {
        x := try f(b.head) catch default g(5)
        b.head.next = x
    }() }
    return "b" $b.k
}
fn main() ? {
    b := Bag(Node(1), 3)
    println($b)
    t := churn(100)
    println($nv(b.head) " " $t)
}
