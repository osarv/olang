# CONFIRMED (since round 4, bbf115f; e27b83b refused it): a try's catch default is built where the try's result lives
# (cgTryDefaultStore puts op->cgResultScope in targetScopeOverride), and a call in the default whose result scope is still
# landing takes that scope (cgCallTargetAndArgs: landing && targetScopeOverride). Here f's result is borrowed from b.head, so
# g(5)'s Node is built in the scope "$" opened for Str's receiver. The walk (mbiCall) asks a callee only about variables
# mbiBound says are bound to the receiver - a landing one is not, and tgt is never consulted for it - so Str is accepted.
# -b: "b3 / 100 0"; -b -d: "b3 / 100 0"; -b -s: "use after scope closed" (134); -i: "b3 / 5 0"
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn nv(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
fn grow(x mut Node&) { x.next = Node(x.v + 100) }
fn f(n mut Node&) mut Node&n ? {
    if n.v > 0 { error }
    return n
}
fn g(v I64) mut Node& { return Node(v) }
fn (b Bag&) Str() String {
    b.head.next = try f(b.head) catch default g(5)
    return "b" $b.k
}
fn main() ? {
    b := Bag(Node(1), 3)
    println($b)
    t := churn(100)
    println($nv(b.head) " " $t)
}
