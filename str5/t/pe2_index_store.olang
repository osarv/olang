type Node struct(v I64) {
    v
    next mut Node& = null
}
type View struct(rows Array<mut Array<mut Node&>&>&) {
    at Array<mut Array<mut Node&>&>&rows = rows
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn visit(w View&) {
    xs := w.at[0]
    xs[0] = Node(77)
}
fn work(r Array<mut Array<mut Node&>&>&) { visit(View(r)) }
fn main() ? {
    row := Array<mut Node&>(1, Node(3))
    r := Array<mut Array<mut Node&>&>(1, row)
    work(r)
    t := churn(100)
    println($row[0].v " " $t)
}
