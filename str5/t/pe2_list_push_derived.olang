type Node struct(v I64) {
    v
}
type View struct(ls Array<mut List<mut Node&>&>&) {
    at Array<mut List<mut Node&>&>&ls = ls
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn visit(w View&) {
    l := w.at[0]
    l.Push(Node(77))
}
fn work(r Array<mut List<mut Node&>&>&) { visit(View(r)) }
fn main() ? {
    lst mut List<mut Node&>& = List<mut Node&>()
    r := Array<mut List<mut Node&>&>(1, lst)
    work(r)
    t := churn(100)
    println($lst[0].v " " $t)
}
