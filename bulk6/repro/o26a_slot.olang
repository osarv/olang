# O26a: a returned reference local's own slot stays in its block; what it refers to lives where the result goes
import "std/io"

type node struct(v I64, next node?& = null) { v, next }

fn last(n node&) node& {
    cur := n
    for cur.next is not null { cur = cur.next! }
    return cur
}

fn build(k I64) node& {
    head := node(0)
    cur := head
    for i in range 1, k {
        nn := node(i)
        cur.next = nn
        cur = nn
    }
    return cur
}

fn mkfn(k I64) fn&() I64 {
    r := build(k)
    return fn() I64 { return r.v }
}

fn walker(k I64) Iterator<I64> {
    cur := build(k)
    for i in range 3 {
        yield cur.v + i
    }
}

fn main() {
    out := Vec<node&>()
    fs := Vec<fn&() I64>()
    for k in range 1, 50 {
        out.Push(build(k))
        fs.Push(mkfn(k))
    }
    s := 0
    for x in out { s += x.v }
    for f in fs { s += f() }
    for x in walker(7) { s += x }
    junk := Vec<node&>()
    for i in range 5000 { junk.Push(node(-i)) }
    io.Println("sum " $s " (2352+21)")!
}
