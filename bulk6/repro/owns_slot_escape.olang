# O17's 'owns' exemption: a reference to a value local that owns storage (a Vec) kept in a caller's collection - the
# local's own storage (the Vec's record, a frame slot) is gone when the function returns
import "std/io"

type holder struct(v Vec<I64>&) { v }

fn fill(hs mut Vec<holder>&, k I64) {
    v := Vec<I64>()
    for i in range k { v.Push(i) }
    hs.Push(holder(v))
}

fn stomp(n I64) I64 {
    a := Array<I64>(16, n)
    b := Vec<I64>()
    for x in a { b.Push(x * 3) }
    return b.Len()
}

fn main() {
    hs := Vec<holder>()
    for k in range 1, 6 { fill(hs, k) }
    x := stomp(123456)
    s := 0
    for h in hs { s += h.v.Len() }
    io.Println("vec lens " $s " (15) " $x)!
    io.Println($hs[0].v)!
}
