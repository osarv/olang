# a loop turn's value local, a reference to which is kept past the turn (in a Vec declared outside the loop): every
# turn's reference names one slot, so the kept references all see the last turn's value
import "std/io"

type holder struct(v Vec<I64>&) { v }

fn main() {
    hs := Vec<holder>()
    for k in range 1, 6 {
        v := Vec<I64>()
        for i in range k { v.Push(i) }
        hs.Push(holder(v))
    }
    s := 0
    for h in hs { s += h.v.Len() }
    io.Println("vec lens " $s " (15)")!
}
