# D18c inferred: a generator yielding views of storage its walk keeps (a local copy of its parameter), its elements
# kept past the walk by the consumer
import "std/io"

fn pieces(t String&) Iterator<String&> {
    c := $t
    for i in range c.Len() { yield c[i:i + 1] }
}

fn main() {
    x := "abc"
    out := Vec<String&>()
    for w in pieces(x) { out.Push(w) }
    g := pieces(x)
    for w in g { out.Push(w) }
    junk := Vec<String>()
    for i in range 100 { junk.Push("zzzzzzzzzzzzzzzzzz" $i) }
    io.Println($out " " $junk.Len())!
}
