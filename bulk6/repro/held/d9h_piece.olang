# D9h pieceView / E11b: a join's operands are evaluated before any piece renders; a later operand changes an earlier
# one's storage through a writable reference a struct argument holds
import "std/io"

type hold struct(v mut Vec<I64>&) { v }

fn poke(h hold) I64 {
    h.v.ViewMut()[0] = 99
    return 0
}

fn pokeDirect(v mut Vec<I64>&) I64 {
    v.ViewMut()[0] = 98
    return 0
}

fn main() {
    v := Vec<I64>()
    v.Push(1)
    t := $v " " $poke(hold(v))
    w := Vec<I64>()
    w.Push(1)
    u := $w " " $pokeDirect(w)
    io.Println($t " | " $u " (Vec<I64>[1] 0 | Vec<I64>[1] 0)")!
}
