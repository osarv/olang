# D9h argView: a by-value argument read where it is because the callee only reads it - while the callee writes the
# argument's source through a writable reference another argument holds
import "std/io"

type hold struct(v mut Vec<I64>&) { v }
type rhold struct(v mut Array<I64>&) { v }

fn f(a Vec<I64>, h hold) I64 {
    h.v.ViewMut()[0] = 9
    return a[0]
}

fn g(a Vec<I64>, h mut Vec<I64>&) I64 {
    h.ViewMut()[0] = 8
    return a[0]
}

fn k(a Array<I64>, h rhold) I64 {
    h.v[0] = 7
    return a[0]
}

fn main() {
    v := Vec<I64>()
    v.Push(1)
    x := f(v, hold(v))
    w := Vec<I64>()
    w.Push(1)
    y := g(w, w)
    arr := Array<I64>(4, 1)
    z := k(arr, rhold(arr))
    io.Println("f " $x " g " $y " k " $z " (by value: 1 1 1)")!
}
