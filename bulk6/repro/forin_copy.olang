# S9: a for-in's element is a copy; the body changes the element's owned storage in the Vec it walks
import "std/io"

type blk struct(xs Vec<I64>) { xs }

fn direct() I64 {
    v := Vec<blk>()
    xs := Vec<I64>()
    xs.Push(1)
    v.Push(blk(xs))
    s := 0
    for e in v {
        v.RefMut(0).xs.ViewMut()[0] = 99
        s += e.xs[0]
    }
    return s
}

fn viaRef(v mut Vec<blk>&) I64 {
    s := 0
    for e in v {
        v.RefMut(0).xs.ViewMut()[0] = 99
        s += e.xs[0]
    }
    return s
}

fn main() {
    v := Vec<blk>()
    xs := Vec<I64>()
    xs.Push(1)
    v.Push(blk(xs))
    io.Println("direct " $direct() " viaRef " $viaRef(v) " (copies: 1 1)")!
}
