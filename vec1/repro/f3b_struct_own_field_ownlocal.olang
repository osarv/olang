# As f3, but the owner is an own-reference LOCAL ('o own mut CB&'), and the own field is reinstalled by a
# direct assignment to o.data. Still not refused (the nominal String result loses the loan).
#   -b -d -s -> "use after scope closed"    -i -> "ab"    -b -> "ab"
fn churn() I64 {
    t := 0
    for i in range 2000 { s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len() }
    return t
}
type CB struct() {
    data own mut Array<Char>& = Array<Char>(2)
}
fn (c CB&) Text() String&c { return String(c.data) }
fn main() ? {
    o own mut CB& = CB()
    o.data[0] = 'a'
    o.data[1] = 'b'
    t := o.Text()
    o.data = Array<Char>(64)
    churn()
    println(t)
}
