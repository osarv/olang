# Shows: a borrowed own result (View) reached THROUGH a function value gets no loan on the buffer,
# so a Push that frees the buffer is accepted and the view dangles. Called by name it is refused.
# Relaxation 1 (O37/O38): ownResultRegionOf returns NULL when op->callee is set (a function-value call).
#   -b -d -s  -> "use after scope closed" (UAF)      -i -> "10 20" (reference)      -b -> garbage/10 20
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn view(v Vec<I64>&) Array<I64>&v { return v.View() }
fn grow(w mut Vec<I64>&) {
    f := view            # view as a function value
    d := f(w)            # borrowed own result through a function value - no loan is made
    for i in range 1000 { w.Push(i + 100) }   # frees the buffer; NOT refused
    churn()
    println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    grow(v)
}
