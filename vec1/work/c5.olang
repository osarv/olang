fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}

fn grow(w mut Vec<I64>&) {
    d := firstPart(w)
    for i in range 1000 { w.Push(i + 100) }
    churn()
    println($d[0] " " $d[1])
}
fn firstPart(v Vec<I64>&) Array<I64>&v { return v.View() }
fn main() ? {
    v := Vec<I64>()
    v.Push(1)
    v.Push(2)
    grow(v)
}
