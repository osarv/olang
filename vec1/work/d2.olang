fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}
type Pt struct(x I64, y I64) {
    x
    y
}
type Outer struct() {
    data own mut Array<Pt>& = Array<Pt>(2, Pt(3, 4))
}
fn (o Outer&) P() Pt&o { return o.data[0] }
fn use(o mut Outer&) {
    p := o.P()
    o.data = Array<Pt>(5, Pt(9, 9))
    churn()
    println($p.x " " $p.y)
}
fn main() ? {
    o := Outer()
    use(o)
}
