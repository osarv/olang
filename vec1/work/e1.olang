fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}
fn asRaw(v Vec<Char>&) Array<Char>&v { return v.View() }
fn asText(v Vec<Char>&) String&v { return String(v.View()) }
fn main() ? {
    v := Vec<Char>()
    v.Push('a')
    v.Push('a')
    r := asRaw(v)
    println($r.Len())
    v.Push('b')
}
