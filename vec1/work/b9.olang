fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}
fn view(v Vec<I64>&) Array<I64>&v { return v.View() }
fn apply(f fn(x Vec<I64>&) Array<I64>&x, v Vec<I64>&) Array<I64>&v { return f(v) }
fn main() ? {
    v := Vec<I64>()
    v.Push(1)
    v.Push(2)
    d := apply(view, v)
    for i in range 1000 { v.Push(i + 100) }
    churn()
    println($d[0] " " $d[1])
}
