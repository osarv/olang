fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}
fn grow2(w mut Vec<Char>&) {
    t String&w = String(w.View())
    for i in range 1000 { w.Push('b') }
    churn()
    println(t)
}
fn main() ? {
    v := Vec<Char>()
    v.Push('a')
    v.Push('a')
    grow2(v)
}
