fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}
fn main() ? {
    vv := List<mut Vec<I64>&>()
    vv.Push(Vec<I64>(64))
    churn()
    x := vv[0]
    println($x.Len() " " $x.Cap())
    x[3] = 9
    println($x.View().Len())
    x.Push(1)
    println($x[0])
}
