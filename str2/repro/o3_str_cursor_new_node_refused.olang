# NEW in 7345ff9, over-rejection by design (minor). A cursor that starts at a receiver node and is then given a new
# node: 'x := b.head; x = Node(7, null)' - x lives where the receiver does (O25a), so the node would be built there.
# 'x Node& = b.head' is O25a's error, so a Str has no spelling for it short of a second local.
# new -b: error[E11c, O12]. d6c7f52 and d0abfe8: 7.
type Node struct(v I64, next mut Node&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&) {
    head
}
fn (b Bag&) Str() String {
    x := b.head
    x = Node(7, null)
    return $x.v
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    println(s)
}
