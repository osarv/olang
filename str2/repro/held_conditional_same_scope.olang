# HELD (no over-rejection). The same with a global or a parameter, or both values in one scope, compiles and runs.
type P struct(v I64) {
    v
}
type Hold struct() {
    f P& = null
}
G P& = P(9)
fn setIt(h mut Hold&, local P&, c Bool) { h.f = local if c else P(7) }
fn main() ? {
    h mut Hold& = Hold()
    for i in range 3 {
        h.f = G if i == 0 else P(7)
        println($h.f.v)
    }
    l P& = P(4)
    setIt(h, l, true)
    println($h.f.v)
    setIt(h, l, false)
    println($h.f.v)
}
