type Node struct(v I64, next mut Node&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&) {
    head
}
fn peek(n Node&) I64 {
    join { spawn fn() { println($n.v) } }
    return n.v
}
fn (b Bag&) Str() String {
    return $peek(b.head)
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    println(s)
}
