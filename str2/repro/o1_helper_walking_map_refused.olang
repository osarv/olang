# NEW in 7345ff9, CONFIRMED over-rejection. A helper walking a Map ('for e in m', 'm.Keys()') cannot be called from a
# Str with the receiver's Map, though the same loop written in Str's body compiles (checks/cases/strwalks): in the
# helper the hidden iterator's result scope lands by its obligations where m lives (O18c), and Iter's constructor
# call counts as built there, so the helper 'builds' where the receiver lives. Nothing is allocated there at run time.
# new -b: error[E11c, O12] twice (at Str and at r.m). d6c7f52 and d0abfe8: 3 ab.
fn total(m Map<String&, I64>&) I64 {
    t I64 = 0
    for e in m { t += e.Value }
    return t
}
fn keys(m Map<String&, I64>&) String {
    sb := StringBuilder()
    for k in m.Keys() { sb.Push(k) }
    return sb.ToString()
}
type Reg struct() {
    m Map<String&, I64> = Map<String&, I64>()
}
fn (r Reg&) Str() String {
    return $total(r.m) " " $keys(r.m)
}
fn main() ? {
    r := Reg()
    r.m.Put("a", 1)
    r.m.Put("b", 2)
    println($r)
}
