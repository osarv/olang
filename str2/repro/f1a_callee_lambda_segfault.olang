# NEW in 7345ff9, CONFIRMED. A callee bound where Str's receiver lives makes a capturing lambda: its closure lives
# where the capture does (D16d) - the receiver's scope, which '$' passes as null - and the allocation faults.
# regionBuiltIn does not count a closure as built, so the callee's settled body 'builds nothing' there.
# new -b, -b -d, -b -s: Segmentation fault in __olang_scope_alloc_a (peek <- Str), exit 139
# -i prints 4; d6c7f52 and d0abfe8 print 4
type Node struct(v I64, next mut Node&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&) {
    head
}
fn peek(n Node&) I64 {
    f := fn() I64 { return n.v }
    return f()
}
fn (b Bag&) Str() String {
    return $peek(b.head)
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    println(s)
}
