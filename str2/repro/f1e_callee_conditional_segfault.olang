# NEW in 7345ff9, CONFIRMED. A callee bound where Str's receiver lives declares a conditional of its parameter and a
# new node (E28): the node is built where the parameter lives - null. Not counted as built (regionBuiltIn).
# new -b: Segmentation fault, exit 139. d6c7f52 and d0abfe8: 1.
type Node struct(v I64, next mut Node&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&) {
    head
}
fn pick(n Node&) I64 {
    x := n if n.v == 0 else Node(1, null)
    return x.v
}
fn (b Bag&) Str() String {
    return $pick(b.head)
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    println(s)
}
