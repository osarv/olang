# fuzz - the differential fuzzer for K1: the compile-time evaluator gives exactly the run time's answer or refuses.
#
# Each seed is one program from gen (see gen.olang), whose every case computes one value three ways - an immutable
# global baked while compiling, the same call at run time on mut globals, and an assert decided while compiling - and
# runs it four ways:
#     1. built at -O0 (-d) and run: its "<case>: <global> | <run time>" lines, each pair the same
#     2. the same program with the asserts added, each asserting that the case renders as step 1 printed it - built
#        (-O3 and LTO, -b), where an assert the evaluator decides false is a compile error; then run
#     3. that program interpreted (-i), the evaluator running all of it
# and every output must be step 1's. What differs is a finding: the program, the outputs and a reproducer of the one
# case go to RUN/found/<seed>, and a line to RUN/findings.txt.
#
# A run works in a directory of its own, RUN = build/fz/runXXXXXX (os.MkTemp), so two runs - or one left over from an
# earlier, still writing - never share a file. RUN is removed at the end when nothing was found, and named otherwise.
#
#     fuzz run START COUNT [JOBS [CASES]]   seeds START.. START+COUNT-1, JOBS at a time (2), CASES cases each (30)
#     fuzz show SEED [CASES [ONLY]]         prints a program - or only its case ONLY
#
# The scope fuzzer (B2f) is the same driver over scopegen's programs, which stress where values live (see
# scopegen.olang): each is built under the scope sanitizer (-d -s) and interpreted (-i), and the two outputs must be
# the same - a value used after its scope closed reads poison or faults under -s, while -i keeps every value alive.
# -i runs no destructors, so a program with destructor-bearing types (one in four, scopegen.HasDtors) is built -b
# instead, which must print what -d -s does, ending "dtors 0": every resource made was destructed.
# A scenario the compiler refuses is left out and the rest built again; what was refused is counted, not a finding.
#
#     fuzz scope START COUNT [JOBS [SCENARIOS [avoid]]]   seeds START.., SCENARIOS scenarios each (12); "avoid" leaves
#                                                   out the shapes of use-after-frees known when it was written
#     fuzz scopeshow SEED [SCENARIOS [ONLY]]      prints a scope program - or only its scenario ONLY (-1: all)
#
# Its early-free mode (docs/memory.md 3.6) runs scopegen's FreeProgram instead - scenarios replacing and removing in
# long-lived places, views kept across the let-goes and stored elsewhere, resources taken out of a Map and destroyed
# (C9b) - built -d -s -memory, and interpreted in the
# evaluator's dead-region mode (OLANG_DEADREGIONS), which stops at a read of a region a release reclaimed:
#
#     fuzz free START COUNT [JOBS [SCENARIOS]]    seeds START.., the places the -memory reports free at once counted
#     fuzz freeshow SEED [SCENARIOS]              prints an early-free program
#
# FUZZ_WIDTHS=odd runs either with the signed integers at I9, I17 and I33 (gen.olang).
# Everything a check runs is under "nice -n 19". The compiler is $OLANG, else build/olang (make bootstrap) - relative to the working directory when it is relative.
import "std/io"
import "std/os"
import "std/chan"
import "gen"
import "scopegen"

Olang mut String& = ""
Root mut String& = ""
Cases mut I64 = 30
Ran mut I64 = 0
Found mut I64 = 0
Baked mut I64 = 0
Total mut I64 = 0
Scenarios mut I64 = 12
Refused mut I64 = 0
Run mut String& = "" # this run's own directory (newRun)
FreeMode mut Bool = false   # "fuzz free": scopegen's early-free programs (FreeProgram), interpreted in dead-region mode
Frees mut I64 = 0           # ... the places their builds' -memory reports say free at once, summed

fn main() ? {
    args := os.Args()
    if args.Len() < 3 { try usage() }
    Root = try os.Cwd() catch default "."
    Olang = try os.Env("OLANG") catch default "build/olang"
    if not Olang.StartsWith("/") { Olang = $Root "/" $Olang }
    if args[1] == "show" {
        seed := try args[2].ParseInt() catch default 1
        if args.Len() > 3 { Cases = try args[3].ParseInt() catch default 30 }
        only I64 = -1
        if args.Len() > 4 { only = try args[4].ParseInt() catch default -1 }
        try io.Print(gen.Program(U64(seed), Cases, only, true, Array<String&>(0), Array<Bool>(0)))
        return
    }
    if args[1] == "scopeshow" {
        seed := try args[2].ParseInt() catch default 1
        if args.Len() > 3 { Scenarios = try args[3].ParseInt() catch default 12 }
        if args.Len() > 5 and args[5] == "avoid" { scopegen.AvoidKnown = true }
        keep := Array<Bool>(0)
        only := try args[4].ParseInt() catch default -1 if args.Len() > 4 else -1    # (-1: every scenario)
        if only >= 0 and only < Scenarios {
            keep = Array<Bool>(Scenarios)
            keep[only] = true
        }
        try io.Print(scopegen.Program(U64(seed), Scenarios, keep))
        return
    }
    if args[1] == "scope" and args.Len() >= 4 {
        try scopeMain(args)
        return
    }
    if args[1] == "free" and args.Len() >= 4 {
        FreeMode = true
        try scopeMain(args)
        return
    }
    if args[1] == "freeshow" {
        seed := try args[2].ParseInt() catch default 1
        if args.Len() > 3 { Scenarios = try args[3].ParseInt() catch default 12 }
        try io.Print(scopegen.FreeProgram(U64(seed), Scenarios, Array<Bool>(0)))
        return
    }
    if args[1] != "run" or args.Len() < 4 { try usage() }
    start := try args[2].ParseInt() catch default 1
    count := try args[3].ParseInt() catch default 1
    jobs I64 = 2
    if args.Len() > 4 { jobs = try args[4].ParseInt() catch default 2 }
    if args.Len() > 5 { Cases = try args[5].ParseInt() catch default 30 }
    try newRun()
    os.Run("mkdir -p " $os.Quote($Run "/found"))
    queue mut chan.Chan<I64>& = chan.Chan<I64>(count)
    chan.Init(queue)
    for i in range count { chan.Send(queue, start + i)! }
    chan.Close(queue)
    join {
        for w in range jobs { spawn worker(queue, w) }
    }
    summary String& = "fuzz: " $Ran " programs, " $Total " cases (" $Baked " globals baked while compiling)"
    try io.Print($summary ", " $Found " findings" $endRun() "\n")
    if Found > 0 { os.Exit(1) }
}

# this run's own directory under build/fz, so nothing another run writes - a leftover one included - is read here
fn newRun() ? io.Error {
    os.Run("mkdir -p " $os.Quote($Root "/build/fz"))
    Run = try os.MkTemp($Root "/build/fz", "run") catch {
        try io.PrintErr("fuzz: cannot make a run directory under build/fz\n")
        os.Exit(1)
    }
}

# the run's directory removed when nothing was found - else its work directories only, and where the findings are
fn endRun() String& {
    if Found == 0 {
        try os.RemoveAll(Run) catch { }
        return ""
    }
    os.Run("rm -rf " $os.Quote(Run) "/w[0-9]* " $os.Quote(Run) "/sw[0-9]*")
    return " (in " $Run ")"
}

fn usage() ? io.Error {
    try io.PrintErr(("usage: fuzz run START COUNT [JOBS [CASES]] | fuzz show SEED [CASES [ONLY]]"
                     " | fuzz scope START COUNT [JOBS [SCENARIOS [avoid]]] | fuzz scopeshow SEED [SCENARIOS [ONLY [avoid]]]"
                     " | fuzz free START COUNT [JOBS [SCENARIOS]] | fuzz freeshow SEED [SCENARIOS]\n"))
    os.Exit(1)
}

fn worker(queue mut chan.Chan<I64>&, w I64) {
    dir String& = $Run "/w" $w
    os.Run("mkdir -p " $os.Quote(dir))
    for seed in queue {
        try runSeed(seed, dir) catch io.Error { }
        Ran.AtomicAdd(1)
    }
}

# runs cmd inside dir, niced, with OLANG set
fn sh(dir String&, cmd String&) I32 {
    return os.Run("cd " $os.Quote(dir) " && OLANG=" $os.Quote(Olang) " && " $cmd)
}

fn read(dir String&, name String&) String& {
    return try os.ReadFile($dir "/" $name) catch default ""
}

# what seed's program finds, in dir
fn runSeed(seed I64, dir String&) ? io.Error {
    expect Array<String&> = Array<String&>(Cases, "")
    has Array<Bool> = Array<Bool>(Cases)
    if not try write(dir, seed, expect, has) { return }
    if sh(dir, "timeout 600 nice -n 19 \"$OLANG\" build -debug p.olang > c1.txt 2>&1") != 0 {
        try finding(dir, seed, -1, "does not compile at -d (step 1)", read(dir, "c1.txt"))
        return
    }
    if sh(dir, "timeout 120 ./build/p.debug > d.txt 2> derr.txt") != 0 {
        try finding(dir, seed, -1, "-d run failed (step 1)", read(dir, "derr.txt"))
        return
    }
    out := read(dir, "d.txt")
    lines := out.Split("\n")
    for line in lines {
        at := try line.Find(": ") catch { continue }
        bar := try line.Find(" | ") catch { continue }
        if bar < at { continue }
        ci := try line[:at].ParseInt() catch default -1
        if ci < 0 or ci >= Cases { continue }
        k := line[at + 2:bar]
        r := line[bar + 3:]
        expect[ci] = r
        has[ci] = true
        if k != r { try finding(dir, seed, ci, "global baked while compiling is not the -d run time's value", line) }
    }
    # step 2: the asserts, built -O3; one decided false is a finding, and is left out to see the rest
    for _ in range 3 {
        if not try write(dir, seed, expect, has) { return }
        if sh(dir, "timeout 600 nice -n 19 \"$OLANG\" build p.olang > c2.txt 2>&1") == 0 { break }
        c2 := read(dir, "c2.txt")
        bad := falseAsserts(c2)
        if bad.Len() == 0 {
            try finding(dir, seed, -1, "does not compile with its asserts (step 2)", c2)
            return
        }
        for ci in bad {
            try finding(dir, seed, ci, "assert decided false while compiling: the evaluator disagrees with the -d run time", "")
            has[ci] = false
        }
    }
    sh(dir, "grep -cE 'store .* ptr @p_K[0-9]+(,|$)' build/p.main.ll > bakes.txt")
    bakes := read(dir, "bakes.txt")
    startup := try bakes.Trim().ParseInt() catch default 0
    Baked.AtomicAdd(Cases - startup)
    Total.AtomicAdd(Cases)
    st := sh(dir, "timeout 120 ./build/p > b.txt 2> berr.txt")
    try compare(dir, seed, out, read(dir, "b.txt"), "-b")
    if st != 0 { try finding(dir, seed, -1, "-b run failed", read(dir, "berr.txt")) }
    st = sh(dir, "timeout 600 nice -n 19 \"$OLANG\" interpret p.olang > i.txt 2> ierr.txt")
    try compare(dir, seed, out, read(dir, "i.txt"), "-i")
    if st != 0 { try finding(dir, seed, -1, "-i run failed", read(dir, "ierr.txt")) }
}

# writes seed's program into dir, asserting expect[i] where has[i]
fn write(dir String&, seed I64, expect Array<String&>&, has Array<Bool>&) Bool ? io.Error {
    src := gen.Program(U64(seed), Cases, -1, true, expect, has)
    try os.WriteFile($dir "/p.olang", src) catch {
        try finding(dir, seed, -1, "cannot write the program", "")
        return false
    }
    return true
}

# the cases whose asserts the compiler decided false, from its diagnostics
fn falseAsserts(diag String&) Vec<I64>& {
    bad mut Vec<I64>&return = Vec<I64>()
    rest := diag[:]
    for {
        at := try rest.Find("error[S18c]") catch { break }
        rest = rest[at:]
        c := try rest.Find("assert $c") catch { break }
        rest = rest[c + 9:]
        end := try rest.FindByte('(') catch { break }
        ci := try rest[:end].ParseInt() catch default -1
        if ci >= 0 { bad.Push(ci) }
    }
    return bad
}

# every line of got must be want's: a case whose line differs, or is missing, is a finding
fn compare(dir String&, seed I64, want String&, got String&, mode String&) ? io.Error {
    w := want.Split("\n")
    g := got.Split("\n")
    for i, line in w {
        if line.Len() == 0 { continue }
        if i < g.Len() and g[i] == line { continue }
        detail String& = $line "\n<missing>"
        if i < g.Len() { detail = $line "\n" $g[i] }
        at := try line.Find(": ") catch default 0
        ci := try line[:at].ParseInt() catch default -1
        try finding(dir, seed, ci, $mode " disagrees with the -d run", detail)
    }
}

# records a finding: the program and what was found in RUN/found/<seed>, case ci's own program beside it
fn finding(dir String&, seed I64, ci I64, what String&, detail String&) ? io.Error {
    Found.AtomicAdd(1)
    to String& = $Run "/found/" $seed
    os.Run("mkdir -p " $os.Quote(to) " && cp " $os.Quote(dir) "/p.olang " $os.Quote(dir) "/*.txt " $os.Quote(to) " 2> /dev/null")
    if ci >= 0 {
        one := gen.Program(U64(seed), Cases, ci, true, Array<String&>(0), Array<Bool>(0))
        try os.WriteFile($to "/case" $ci ".olang", one) catch { }
    }
    line String& = "seed " $seed " case " $ci ": " $what "\n"
    try io.Print(line)
    os.Run("printf '%s' " $os.Quote(line) " >> " $os.Quote($Run "/findings.txt"))
    if detail.Len() > 0 {
        try os.WriteFile($to "/detail" $ci ".txt", detail) catch { }
    }
}

# ---- the scope fuzzer ----

fn scopeMain(args Array<String&>&) ? io.Error {
    start := try args[2].ParseInt() catch default 1
    count := try args[3].ParseInt() catch default 1
    jobs I64 = 2
    if args.Len() > 4 { jobs = try args[4].ParseInt() catch default 2 }
    if args.Len() > 5 { Scenarios = try args[5].ParseInt() catch default 12 }
    if args.Len() > 6 and args[6] == "avoid" { scopegen.AvoidKnown = true }
    try newRun()
    os.Run("mkdir -p " $os.Quote($Run "/scope"))
    queue mut chan.Chan<I64>& = chan.Chan<I64>(count)
    chan.Init(queue)
    for i in range count { chan.Send(queue, start + i)! }
    chan.Close(queue)
    join {
        for w in range jobs { spawn scopeWorker(queue, w) }
    }
    summary mut String& = "fuzz scope: " $Ran " programs, " $Total " scenarios run, " $Refused " refused by the compiler"
    if FreeMode { summary = $"fuzz free: " $Ran " programs, " $Total " scenarios run, " $Refused " refused, " $Frees " places freeing at once" }
    try io.Print($summary ", " $Found " findings" $endRun() "\n")
    if Found > 0 { os.Exit(1) }
}

fn scopeWorker(queue mut chan.Chan<I64>&, w I64) {
    dir String& = $Run "/sw" $w
    os.Run("mkdir -p " $os.Quote(dir))
    for seed in queue {
        try scopeSeed(seed, dir) catch io.Error { }
        Ran.AtomicAdd(1)
    }
}

# seed's scope program, built -d -s and interpreted, in dir
fn scopeSeed(seed I64, dir String&) ? io.Error {
    keep mut Array<Bool>& = Array<Bool>(Scenarios, true)
    built := false
    for _ in range 6 {
        src := scopegen.FreeProgram(U64(seed), Scenarios, keep) if FreeMode else scopegen.Program(U64(seed), Scenarios, keep)
        try os.WriteFile($dir "/p.olang", src) catch {
            try scopeFinding(dir, seed, -1, "cannot write the program", "")
            return
        }
        mem := " -memory" if FreeMode else ""
        if sh(dir, $"timeout 600 nice -n 19 \"$OLANG\" build -debug -sanitize" $mem " p.olang > c.txt 2>&1") == 0 {
            built = true
            break
        }
        diag := read(dir, "c.txt")
        dropped := dropRefused(src, diag, keep)
        if dropped == 0 {
            try scopeFinding(dir, seed, -1, "does not compile, and no scenario is to blame", diag)
            return
        }
        Refused.AtomicAdd(dropped)
    }
    if not built {
        try scopeFinding(dir, seed, -1, "still does not compile after leaving scenarios out", read(dir, "c.txt"))
        return
    }
    n I64 = 0
    for k in keep { if k { n++ } }
    if n == 0 { return }
    Total.AtomicAdd(n)
    if FreeMode { Frees.AtomicAdd(freesIn(read(dir, "c.txt"))) }
    st := sh(dir, "timeout 120 ./build/p.debug.san > s.txt 2> serr.txt")
    sOut := read(dir, "s.txt")
    # a scenario that checks itself - a baked global against the same computation at run time, a value a destructor must
    # not reach - says "BAD k: ..." when the check fails (scopegen's second-name scenarios)
    for line in sOut.Split("\n") {
        if not line.StartsWith("BAD ") { continue }
        rest := line[(try line[4:].FindByte(' ') catch default 0) + 5:]
        at := try rest.Find(":") catch default 0
        k := try rest[:at].ParseInt() catch default -1
        try scopeFinding(dir, seed, k, "a scenario's own check failed (a baked global or the caller's value differs)", line)
        return
    }
    #-i runs no destructors, so a program with them is held to itself: built -b, it must print what -d -s does, and every
    #resource made must have been destructed (the last line, "dtors 0")
    if scopegen.HasDtors(U64(seed)) and not FreeMode {
        if sh(dir, "timeout 600 nice -n 19 \"$OLANG\" build p.olang > cb.txt 2>&1") != 0 {
            try scopeFinding(dir, seed, -1, "builds -d -s but not -b", read(dir, "cb.txt"))
            return
        }
        bst := sh(dir, "timeout 120 ./build/p > i.txt 2> ierr.txt")
        bOut := read(dir, "i.txt")
        if st == 0 and bst == 0 and sOut == bOut and sOut.Contains("\ndtors 0\n") { return }
        if st == 0 and bst == 0 and sOut == bOut {
            try scopeFinding(dir, seed, -1, "a destructor did not run (made and destructed differ)", sOut)
            return
        }
        if bst != 0 {
            try scopeFinding(dir, seed, -1, "-b run failed", read(dir, "ierr.txt"))
            return
        }
    } else {
        # dead-region mode: a read of storage a release reclaimed stops -i at once (exit 70, an internal error)
        dead := "env OLANG_DEADREGIONS=1 " if FreeMode else ""
        ist := sh(dir, $"timeout 600 nice -n 19 " $dead "\"$OLANG\" interpret p.olang > i.txt 2> ierr.txt")
        if ist != 0 {
            try scopeFinding(dir, seed, -1, "-i failed", read(dir, "ierr.txt"))
            return
        }
        if st == 0 and sOut == read(dir, "i.txt") { return }
    }
    iOut := read(dir, "i.txt")
    # the first scenario whose line differs or is missing is the one to blame; with none, the run ended early
    want := iOut.Split("\n")
    got := sOut.Split("\n")
    for i, line in want {
        if line.Len() == 0 { continue }
        if i < got.Len() and got[i] == line { continue }
        at := try line.Find(": ") catch default 0
        k := try line[:at].ParseInt() catch default -1
        detail String& = $line "\n<missing>"
        if i < got.Len() { detail = $line "\n" $got[i] }
        detail = $detail "\n" $read(dir, "serr.txt")
        try scopeFinding(dir, seed, k, "-d -s disagrees with -i (or -b) (a use after a scope closed)", detail)
        return
    }
    try scopeFinding(dir, seed, -1, "-d -s run failed", read(dir, "serr.txt"))
}

# the number of places a build's -memory report says free at once: "... - N free(s) it at once, ..."
fn freesIn(out String&) I64 {
    at := try out.Find("in code that runs again - ") catch { return 0 }
    rest := out[at + 26:]
    end := try rest.FindByte(' ') catch { return 0 }
    return try rest[:end].ParseInt() catch default 0
}

# leaves out every scenario an error in diag is reported in, from the "# scenario k" lines of src; how many it left out
fn dropRefused(src String&, diag String&, keep mut Array<Bool>&) I64 {
    lines := src.Split("\n")
    owner := Array<I64>(lines.Len() + 1, -1)
    cur I64 = -1
    for i, line in lines {
        if line.StartsWith("# scenario ") { cur = try line[11:].ParseInt() catch default -1 }
        if line.StartsWith("fn main()") { cur = -1 }
        owner[i + 1] = cur
    }
    dropped I64 = 0
    for d in diag.Split("\n") {
        if not d.StartsWith("p.olang:") { continue }
        if not d.Contains(": error") { continue }
        rest := d[8:]
        end := try rest.FindByte(':') catch { continue }
        ln := try rest[:end].ParseInt() catch { continue }
        if ln < 1 or ln >= owner.Len() { continue }
        k := owner[ln]
        if k >= 0 and k < keep.Len() and keep[k] {
            keep[k] = false
            dropped++
        }
    }
    return dropped
}

# records a scope finding: the program in RUN/scope/<seed>, scenario k's own program beside it
fn scopeFinding(dir String&, seed I64, k I64, what String&, detail String&) ? io.Error {
    Found.AtomicAdd(1)
    to String& = $Run "/scope/" $seed
    os.Run("mkdir -p " $os.Quote(to) " && cp " $os.Quote(dir) "/p.olang " $os.Quote(dir) "/*.txt " $os.Quote(to) " 2> /dev/null")
    if k >= 0 {
        keep := Array<Bool>(Scenarios)
        keep[k] = true
        try os.WriteFile($to "/scenario" $k ".olang", scopegen.Program(U64(seed), Scenarios, keep)) catch { }
    }
    line String& = "scope seed " $seed " scenario " $k ": " $what "\n"
    try io.Print(line)
    os.Run("printf '%s' " $os.Quote(line) " >> " $os.Quote($Run "/scope/findings.txt"))
    if detail.Len() > 0 { try os.WriteFile($to "/detail" $k ".txt", detail) catch { } }
}
