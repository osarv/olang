# F4: the same in a global's initializer (walked as an expression statement, never confined).
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    text own mut String& = "bb"
}
G own mut CB& = CB()
T := G.text                    # a global holding a borrow of G's own slot directly
fn main() ? {
    G.text = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println(T)
}
