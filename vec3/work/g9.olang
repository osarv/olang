fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type Doc struct() {
    title own mut String& = "bb"
    alias String& = null
}

fn main() ? {
    Docs own mut Doc& = Doc()
    Docs.alias = Docs.title
    Docs.title = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println(Docs.alias)
}
