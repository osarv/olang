fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type Doc struct() { title own mut String& = "bb" }
Docs own mut Doc& = Doc()
Titles := List<String&>()
fn main() ? {
    Titles.Push(Docs.title)                 # a global List keeping a borrow of a global's own object
    Docs.title = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println(Titles[0])
}
