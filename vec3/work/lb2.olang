fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type W struct(a mut Array<Char>&) { a }
fn id(x <T>) T { return x }
fn mk(a mut Array<Char>&) mut W& { return W(id(a)) }
fn main() ? {
    v := Vec<Char>()
    v.Push('a')
    v.Push('b')
    w := mk(v.ViewMut())
    for i in range 1000 { v.Push('z') }
    churn()
    println($w.a[0])
}
