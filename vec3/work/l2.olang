fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    data own mut Array<Char>& = Array<Char>(2, 'a')
    text own mut String& = "bb"
}
fn (c CB&) Text() String&c { return c.text }
fn use(c mut CB&) {
    f fn(x CB&) String&x = fn(x) { return x.Text() }
    t := f(c)
    c.text = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println(t)
}
fn main() ? {
    c := CB()
    use(c)
}
