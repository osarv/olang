fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn mk(v Vec<Char>&) mut String& { return String(v.View()) }
fn main() ? {
    v := Vec<Char>()
    v.Push('a')
    v.Push('b')
    d := mk(v)
    for i in range 1000 { v.Push('z') }
    churn()
    println(d)
}
