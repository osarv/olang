fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn k(a mut Array<Char>&, b mut Array<Char>&) mut Array<Char>& {
    r := a
    if b.Len() > a.Len() { r = b }
    return r
}
fn main() ? {
    v := Vec<Char>()
    v.Push('a')
    v.Push('b')
    o mut Array<Char>& = Array<Char>(1)
    d := k(v.ViewMut(), o)
    for i in range 1000 { v.Push('z') }
    churn()
    println($d[0] $d[1])
}
