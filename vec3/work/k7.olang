fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn k(a mut Array<Char>&, c Bool) mut Array<Char>& { return a if c else Array<Char>(2) }
fn main() ? {
    v := Vec<Char>()
    v.Push('a')
    v.Push('b')
    d := k(v.ViewMut(), true)
    for i in range 1000 { v.Push('z') }
    churn()
    println($d[0] $d[1])
}
