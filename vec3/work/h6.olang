fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type E enum {
    A(a Array<I64>&)
    B
}
fn grow(w mut Vec<I64>&) {
    e := E.A(w.View())
    for i in range 1000 { w.Push(i + 100) }
    churn()
    match e {
        case E.A(d) { println($d[0]) }
        case E.B { println("b") }
    }
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    grow(v)
}
