fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    text own mut String& = "bb"
}
fn (c CB&) Text() String&c { return c.text }
fn f(c own mut CB&) String&c { return c.Text() }
fn main() ? {
    t := f(CB())
    churn()
    println(t)
}
