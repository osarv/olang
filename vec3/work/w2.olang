fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    text own mut String& = "bb"
}
fn (c CB&) Text() String&c { return c.text }
type W struct(c CB&) {
    t := c.Text()
}
fn use(c mut CB&) {
    w := W(c)
    c.text = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println(w.t)
}
fn main() ? {
    c := CB()
    use(c)
}
