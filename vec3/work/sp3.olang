fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    text own mut String& = "bb"
}
fn pass(s String&) String&s { return s }
fn use(c mut CB&) {
    d String&c = null
    join {
        spawn d = pass(c.text)        # the borrow of c.text handed to a task whose result is d
    }
    c.text = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"   # releases it
    churn()
    println(d)
}
fn main() ? {
    c := CB()
    use(c)
}
