fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    text own mut String& = "bb"
}
G own mut CB& = CB()
T String& = G.text             # a typed global
fn main() ? {
    G = CB()                   # releases the whole object
    churn()
    println(T)
}
