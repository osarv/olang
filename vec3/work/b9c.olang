fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn three() I64 { return 3 }
if three() == 3 {
    fn mode() I64 { return 1 }
} else {
    fn mode() I64 { return 2 }
}
fn grow(w mut Vec<I64>&) {
    d := w.View()
    for i in range 1000 * mode() { w.Push(i) }
    churn()
    println($d[0])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    grow(v)
}
