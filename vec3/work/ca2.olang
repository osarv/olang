fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type G struct() { }
fn (g G&) Call(v Vec<I64>&) Array<I64>&v { return v.View() }
fn grow(w mut Vec<I64>&) {
    f fn(x Vec<I64>&) Array<I64>&x = G() if w.Len() > 0 else G()
    d := f(w)
    for i in range 1000 { w.Push(i + 100) }
    churn()
    println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(1)
    v.Push(2)
    grow(v)
}
