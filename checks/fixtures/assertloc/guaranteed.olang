# S18a: a guaranteed check that fails says where it was written too - a slice out of range, an array length out of
# range, an 'as' that does not hold - built and interpreted alike. Which
# one fails is chosen by the number of arguments, so nothing here is decided while compiling
import "std/os"
import "std/io"
type Shape enum {
    Dot
    Circle(r F64)
}
fn main() ? {
    n := os.Args().Len()
    s := "abc"
    if n == 1 { try io.Println(s[1:n + 3]) }
    if n == 2 { try io.Println($Array<I64>(n - 5).Len()) }
    sh Shape = Shape.Dot if n == 3 else Shape.Circle(1.0)
    if n == 3 { try io.Println($(sh as Shape.Circle)) }
    try io.Println($n)
}
