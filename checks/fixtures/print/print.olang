# M19f: std/io's words for writing text - fallible with io.Error, written with try; built and interpreted alike
import "std/io"
fn main() ? io.Error {
    n := 42
    try io.Put("n is ")
    try io.PutLine($n)
    try io.PutLine("joined " $n " and " $(n + 1))
    try io.PutLine()
    try io.PutErr("to the ")
    try io.PutErrLine("standard error")
    say := io.PutLine                # a function value, as any function is
    try say("through a value")
}
