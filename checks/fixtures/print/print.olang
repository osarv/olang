# M19f: the prelude's words for writing text - no try, no error set on main; built and interpreted alike
fn main() ? {
    n := 42
    print("n is ")
    println($n)
    println("joined " $n " and " $(n + 1))
    println()
    eprint("to the ")
    eprintln("standard error")
    say := println                # a function value, as any function is
    say("through a value")
}
