# D16c: a capturing lambda held in a local is kept in its frame only when every use of the local is a call through it
# (read off the checked operands, never the tokens) - here each local is also passed on, stored, captured by a later
# lambda, spawned, compared with "is", assigned to another local or returned, so each environment is built where its
# capture lives, never on the stack: the closures returned and stored are called after the frames that made them are gone
type Node struct(v I64) {
    v
}
type Holder struct(f fn() I64) {
    f
}
fn apply(f fn() I64) I64 { return f() }
fn passed(n Node&) I64 {
    f := fn() I64 { return n.v }
    return apply(f) + f()
}
fn stored(n Node&) Holder {
    f := fn() I64 { return n.v + 1 }
    return Holder(f)
}
fn captured(n Node&) fn() I64 {
    f := fn() I64 { return n.v + 2 }
    return fn() I64 { return f() }
}
fn spawned(n Node&) I64 {
    f := fn() I64 { return n.v + 3 }
    x I64 = 0
    join { spawn x = f() }
    return x
}
fn compared(n Node&) I64 {
    f := fn() I64 { return n.v + 4 }
    same := f is f
    return f() if same else 0
}
fn assigned(n Node&) fn() I64 {
    f := fn() I64 { return n.v + 5 }
    g := f
    return g
}
fn returned(n Node&) fn() I64 {
    f := fn() I64 { return n.v + 6 }
    return f
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    n := Node(10)
    h := stored(n)
    c := captured(n)
    a := assigned(n)
    r := returned(n)
    t := churn(200)
    assert t == 0 and passed(n) == 20 and h.f() == 11 and c() == 12 and spawned(n) == 13 and compared(n) == 14
    assert a() == 15 and r() == 16, "closures called after their frames are gone"
}
