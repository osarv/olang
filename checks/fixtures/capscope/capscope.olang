# P2 (decision 48): every shape that builds a temporary where a conditional, a match or a "catch default" lands - in the
# lambda, in a callee it calls, in a Call method - built into the scope a closure captured, on two tasks at once while the
# main thread builds into that scope too. SemanticMayBuild missed each of them, so the closure asked for nothing as its
# call started and the tasks bumped the main thread's arena unsynchronised. The checks scenario "capscope" builds this
# and reads its IR: every lambda here asks for its captured scope (__olang_capture_scope), the Call adapter for its
# instance's (__olang_scope_mine)
type Node struct(v I64) {
    v
    next mut Node& = null
}
fn find(n mut Node&) mut Node&n ? {
    if n.v >= 0 { error }
    return n
}
fn setNext(n mut Node&, i I64) { n.next = n.next if i < 0 else Node(i) }
fn orNew(n mut Node&, i I64) mut Node&n { return n.next if i < 0 else Node(i) }
fn keep(a mut Node&, n mut Node&a) { a.next = n }
fn two(a mut Node&, i I64) (mut Node&a, I64) { return a.next if i < 0 else Node(i), i }
fn mk(i I64) Node { return Node(i) }
type Adder struct(n mut Node&) {
    n
}
fn (a Adder) Call(i I64) { a.n.next = a.n.next if i < 0 else Node(i) }

N I64 = 20000
fn work(f fn(i I64)) {
    for i in range N { f(i) }
}
fn both(f fn(i I64), g fn(i I64)) {
    c mut Node& = Node(0)
    join {
        spawn work(f)
        spawn work(g)
        for i in range N { c.next = Node(i) }
    }
}
fn main() ? {
    nodes := Array<mut Node&>(20)
    for k in range 20 { nodes[k] = Node(k) }
    a0, a1, a2, a3, a4, a5, a6, a7, a8, a9 := nodes[0], nodes[1], nodes[2], nodes[3], nodes[4], nodes[5], nodes[6], nodes[7], nodes[8], nodes[9]
    b0, b1, b2, b3, b4, b5, b6, b7, b8, b9 := nodes[10], nodes[11], nodes[12], nodes[13], nodes[14], nodes[15], nodes[16], nodes[17], nodes[18], nodes[19]
    both(fn(i I64) { a0.next = a0.next if i < 0 else Node(i) }, fn(i I64) { b0.next = b0.next if i < 0 else Node(i) })
    both(fn(i I64) { a1.next = match i { case -1 => a1.next nomatch => Node(i) } },
         fn(i I64) { b1.next = match i { case -1 => b1.next nomatch => Node(i) } })
    both(fn(i I64) { a2.next = try find(a2) catch default Node(i) }, fn(i I64) { b2.next = try find(b2) catch default Node(i) })
    both(fn(i I64) { setNext(a3, i) }, fn(i I64) { setNext(b3, i) })
    both(Adder(a4), Adder(b4))
    both(fn(i I64) { a5.next = orNew(a5, i) }, fn(i I64) { b5.next = orNew(b5, i) })
    both(fn(i I64) {
        x := a6.next if i < 0 else Node(i)
        a6.next = x
    }, fn(i I64) {
        x := b6.next if i < 0 else Node(i)
        b6.next = x
    })
    both(fn(i I64) { keep(a7, a7.next if i < 0 else Node(i)) }, fn(i I64) { keep(b7, b7.next if i < 0 else Node(i)) })
    both(fn(i I64) {
        n, k := two(a8, i)
        a8.next = n
        a8.v = k
    }, fn(i I64) {
        n, k := two(b8, i)
        b8.next = n
        b8.v = k
    })
    both(fn(i I64) { a9.next = a9.next if i < 0 else mk(i) }, fn(i I64) { b9.next = b9.next if i < 0 else mk(i) })
    for k in range 20 {
        if nodes[k].next == null or nodes[k].next.v != N - 1 { fail }
    }
    println("capscope: ok")
}
