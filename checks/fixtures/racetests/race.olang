# B3a, P7: a test that starts a task runs in a build of the race detector, the others in the ordinary one. Each test says
# which it ran in (RaceBuild is decided by the build, so no assert of it could hold in both)

type Counter struct(n I64) { n }

fn bump(c mut Counter&, times I64) {
    for _ in range times: c.n = c.n + 1
}

# a flag one task raises and the other waits on: both tasks of the racing test meet before writing, so each runs on a
# thread of its own while the other does - never one after the other on one cached thread (P1e), where the detector
# would see no race. The flags are atomics, which order nothing between the two tasks' writes
type Flag struct(v I64) { v }

# then each adds one to every counter, one task from the front, the other from the back. The detector checks a
# thread's first write to a word only (a repeat of the same access is skipped), and two first writes made at the same
# instant - as both tasks leave the meeting - can pass each other in its shadow cells unseen; walking in opposite
# directions, each task writes the far end's words long after the other did (P1e, HISTORY)
fn meetThenSweep(c mut Array<I64>&, mine mut Flag&, theirs mut Flag&, up Bool) {
    mine.v.AtomicStore(1)
    for theirs.v.AtomicLoad() == 0 { }
    n := c.Len()
    for i in range n {
        j := i if up else n - 1 - i
        c[j] = c[j] + 1
    }
}

fn says(what String&) {
    Println($what + ": race build " + $RaceBuild)
}

test "plain" {
    says("plain")
}

test "tasks writing counters of their own" {
    says("own")
    a mut Counter& = Counter(0)
    b mut Counter& = Counter(0)
    join {
        spawn bump(a, 100000)
        spawn bump(b, 100000)
    }
    assert a.n == 100000 and b.n == 100000
}

test "a call reaching a task" {
    says("through a call")
    assert tasked() == 1
}

fn tasked() I64 {
    a mut Counter& = Counter(0)
    join { spawn bump(a, 1) }
    return a.n
}

test "two tasks writing one counter" {
    says("racing")
    a mut Array<I64>& = Array<I64>(4096)
    l mut Flag& = Flag(0)
    r mut Flag& = Flag(0)
    join {
        spawn meetThenSweep(a, l, r, true)
        spawn meetThenSweep(a, r, l, false)
    }
    assert a[0] > 0
}

test "after the race" {
    says("after")
}
