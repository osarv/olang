# B3i's incremental build: a library with a struct, importing the deep module
import "deep"

type Counter struct(start I64) {
    n := start
}

fn (c mut Counter&) Add(k I64) { c.n += k }

fn (c Counter&) Total() I64 { return c.n + deep.Baked }

fn Num(t String&) I64 ? { return try deep.Parse(t) }

# M19g: a view of a Vec held across a call of deep's Touch - an error where Touch may grow it
fn Viewed() I64 {
    a Vec<I64>
    a.Push(1)
    v := a.View()
    deep.Touch(a)
    return v[0]
}

fn Kept() I64 {
    a Vec<String&>
    deep.Keep(a, "kept")
    return a.Len()
}

# W2 (wholeprog 2.1): a place let go of in this module, its decision the program's
type Log struct() {
    last String& = ""
}

fn (l mut Log&) Note(n I64) { l.last = "note " $n }

fn (l Log&) Last() String& { return l.last }

fn Said() String { return $deep.Quiet() " " $deep.Run() " " $deep.Data.Trim() }

# T22c: a function value's parameter a caller's function may be followed into (the edit "a twin added")
fn Apply(f fn&(a mut Vec<String&>&, s String&), a mut Vec<String&>&) { f(a, "applied") }

fn KeepIt(a mut Vec<String&>&, s String&) { a.Push(s) }
