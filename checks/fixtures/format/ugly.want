# B13: every rule of the layout, once
import "std/io"
type Pair2 struct(a I64, b I64) {
    a
    b
}
fn (p Pair2&) Sum() I64 { return p.a + p.b } # a trailing comment
fn two() I64, I64 { return 1, -2 }           # aligned with the one above

fn (p Pair2&) Pick<T>(x T) T { return x }
fn opt(p Pair2?&) Pair2?&p { return p }
fn main() ? io.Error {
    xs := I64[1, 2, 3]
    l := Vec<Vec<I64>>()
    n := xs.Len() + xs[0] * -xs[1]
    if n > 2 and
        n < 100 {
        try io.Println($n)
    }
    s := xs[1:2]
    f := fn(x I64) I64 { return x + 1 }
    a, b := two()
    try io.Println($f(a) $b $s.Len() $l.Len()) ## a block comment ##
    for _ in range 3 { }
    if n < 0: return
    for x in xs: io.Println($x)!
}
