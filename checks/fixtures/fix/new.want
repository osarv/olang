# written when a type variable was <T> everywhere, an error set joined by +, io's error was IoError, and a match gave
# its values with "=>" and took the rest with "nomatch", and null was tested with "is null"
import "std/io"

type Bad error { Word }

fn id<T>(x T) T { return x }

fn half(n I64) I64 ? Bad, io.Error {
    if n < 0 { error Bad.Word }
    return n / 2
}

fn name(n I64) String {
    return match n {
        case 0: "zero"
        case _: "some"
    }
}

fn count(s String?&) I64 {
    if s == null { return 0 }
    return s.Len()
}

fn main() ? io.Error {
    try io.PutLine("fixed " $id(7))
    r := try half(8) catch Bad default 0
    try io.PutLine($r " " $name(r + count(null)))
}
