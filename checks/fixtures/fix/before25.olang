# B17 (the lang25 review): a program written before 2026-10-25 - checked, a try reading only its postfix, a contract after
# the result - which olang fix rewrites where the meaning holds and lists where the text cannot settle it
import "std/io"
import "std/os"
error E { BAD }
type Shape enum {
  Circle(r F64)
  Square(s F64)
}
fn f(n I64) I64 ? E { if n > 100 { error E.Bad } return n }
fn g(b Bool) Bool ? E { if not b { error E.Bad } return b }
fn pick(x I64, y I64) I64 [y > x] { return y - x }
fn main() ? {
  a := I64[1, 2, 3]
  n := os.Args().Len()
  x := 2 * checked a[n] + 1
  y := try f(n) + 1
  z := 10 + try f(n) * 3
  w := (try f(n)) * 2 + 1
  v := try (f(n) + 4) catch default 0
  u := checked a[n] catch default 9
  b := (not try g(n > 0)
    and true)
  s := Shape.Circle(2.0) if n > 0 else Shape.Square(1.0)
  r := checked (s as Shape.Circle) catch default -1.0
  k := checked I32(n * 2) catch default 0
  q := checked pick(1, 3)
  io.Println($x " " $y " " $z " " $w " " $v " " $u " " $b " " $r " " $k " " $q)!
}
