# B3: an object built against the prelude is stale once a prelude file changes - the root's object holds the
# instantiations of the prelude's generics it uses (B3d), here Vec<I32>'s Probe

import "std/io"

fn main() ? io.Error {
    l := Vec<I32>()
    l.Push(5)
    l.Push(6)
    try io.Write(io.Stdout, $l.Probe())
}
