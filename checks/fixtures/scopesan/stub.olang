# the scope sanitizer's runtime for drive.c (B2f): built with -b -d -s, its objects linked with drive.c in place of main
# (which reaches Touch, so a compiler emitting only what a program reaches emits it too; it never runs)
import "std/os"
fn Touch(n I64) I64 {
    a := Array<I64>(n, 1)
    l := Vec<I64>()
    for x in a { l.Push(x) }
    return l.Len()
}

fn main() ? {
    if Touch(os.Args().Len()) < 0 { os.Exit(1) }
}
