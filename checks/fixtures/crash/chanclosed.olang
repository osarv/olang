# std/chan: a Send on a closed channel fails with ChanError.CLOSED - after what was buffered before the close has been
# received
import "std/chan"
import "std/io"

fn main() ? {
    c mut chan.Chan<I32>& = chan.Chan<I32>(2)
    chan.Init(c)
    try chan.Send(c, 1)
    chan.Close(c)
    try io.Println("got " $(try chan.Recv(c) catch default -1))
    try chan.Send(c, 2)
    try io.Println("not reached")
}
