# S2 under -i: a crash in a foreign function the program calls, after os.OnCrash - the program's message written first
import "std/os"
import "std/io"

extern fn raise(sig I32) I32

fn main() ? {
    os.OnCrash("foreign.olang crashed\n")
    try io.Println($raise(11))   # SIGSEGV, raised inside the foreign function
}
