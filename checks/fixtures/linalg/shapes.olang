# std/linalg's shapes: a mismatch aborts as a failed assert does, and under try it is ShapeError.MISMATCH
import "std/os"
import "std/io"
import "std/linalg"

fn main() ? {
    which := os.Args()[1]
    a := linalg.Matrix<F32>(2, 3)
    b := linalg.Matrix<F32>(3, 2)
    if which == "add" {
        c := a + b
        io.Print($c.Rows)
    } else if which == "matmul" {
        c := a @ a
        io.Print($c.Rows)
    } else if which == "gemm" {
        linalg.Gemm(a, a, false, b, false)
    } else if which == "caught" {
        c := try (a @ a) catch linalg.ShapeError.MISMATCH {
            io.Print("caught\n")
            return
        }
        io.Print($c.Rows)
    }
    io.Print("not reached\n")
}
