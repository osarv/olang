import "std/io"

# QF, QZ2: a long-running Map whose values are Vecs held by reference - each value replaced by a new one, some removed -
# stays flat: what the Map lets go of is freed at once (O8d), each Vec's record and buffer with it. The Vec is made by a
# function and handed straight to Put, so it is built for the Map's value place. (Vecs held by value in the Map - a
# Vec a value since 2026-11-01 - are no place of early freeing: what a replaced one owned is kept until the Map's scope
# closes, a recorded limit; and a walk of the Map ("for e in m") copies each entry's reference out, which makes the
# value place no sole holder, so the values are read back by key)
N I64 = 1000000

fn mk(i I64) Vec<I64> {
    v := Vec<I64>()
    for j in range 8 { v.Push(i + j) }
    return v
}

fn main() {
    m := Map<I64, Vec<I64>&>()
    for i in range N {
        m.Put(i % 64, mk(i))
        if i % 7 == 0 { m.Remove((i + 3) % 64) }
    }
    t I64 = 0
    for k in range 64 { t += (try m.Get(k) catch { continue }).Len() }
    io.Println($m.Len() " " $t)!
}
