import "std/io"
import "std/net"

# O15: a server holding std sockets by value in a Map, each removed when done with - its descriptor closed and its
# storage freed at once, so memory and descriptors stay flat however many it ever held
N I64 = 100000

type Server struct() {
    socks Map<I64, net.UDP>
}

fn (s mut Server&) open(i I64) ? net.Error { s.socks.Put(i, try net.UDP.Listen(net.Addr(net.IP.Loopback4(), 0))) }

fn (s mut Server&) done(i I64) { s.socks.Remove(i) }

fn main() ? {
    s mut Server& = Server()
    for i in range N {
        try s.open(i)
        if i >= 16 { s.done(i - 16) }
    }
    io.Println($s.socks.Len())!
}
