import "std/io"

# O8d, T13b (the unique hand-on move): a Map of unique values put and removed half the time - Put hands the value on
# without a copy, Remove ends it and frees its storage right there (388 MB kept before, over 1,000,000 values of 256
# bytes each, when every hand-on copied)
N I64 = 1000000

Ended mut I64 = 0

type Res unique struct(id I64, n I64) {
    id
    data := Array<I64>(n, id)
} destruct { Ended++ }

fn main() {
    m := Map<I64, Res>()
    for i in range N {
        m.Put(i % 64, Res(i, 32))
        if i % 2 == 1: m.Remove(i % 64)
    }
    io.PutLine($Ended " " $m.Len())!
}
