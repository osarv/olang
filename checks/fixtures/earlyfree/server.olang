import "std/io"

# 2.7 (docs/memory.md): a server's connections, each allocating per request - every old request and header map
# freed at once (O8d), so 64 connections hold what they hold now and nothing else
N I64 = 200000

type Conn struct() {
    fd I64 = -1
    req String& = ""                     # the request being handled
    hdrs Map<String&, String&>           # its header lines, by name
}

type Server struct(n I64) {
    conns mut Array<mut Conn&>& = Array<mut Conn&>(n, Conn())
    for i in range 1, n { conns[i] = Conn() }
}

fn parseHeaders(raw String&) Map<String&, String&> {
    m := Map<String&, String&>()
    for line in raw.Lines() {
        i := try line.FindByte(':') catch { continue }
        m.Put($line[:i], $line[i + 1:].Trim())
    }
    return m
}

fn (s mut Server&) OnRequest(i I64, raw String&) {
    s.conns[i].req = raw.ToUpper()
    s.conns[i].hdrs = parseHeaders(raw)
}

fn main() {
    s := Server(64)
    for k in range N {
        s.OnRequest(k % 64, "GET /index.html HTTP/1.1\nHost: example.com\nAccept: text/html\nX-Request: " $k "\n")
    }
    n := try s.conns[5].hdrs.Get("Host") catch { unreachable }
    io.Println(n)!
}
