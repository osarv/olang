import "std/io"

# O8d: a global is a place like any other - a Vec global given a Vec built in a local and one a call builds, each turn,
# and a Map global whose Vec values are replaced and removed - each value in a region of its own, released as the
# global is given another (the first form peaked at 705 MB over 2,000 turns of 10,000 elements before)
N I64 = 2000

cache mut Vec<I64> = Vec<I64>[1, 2, 3]
made mut Vec<I64> = Vec<I64>()
table mut Map<I64, Vec<I64>> = Map<I64, Vec<I64>>()

fn fill(n I64, k I64) {
    v := Vec<I64>()
    for i in range n { v.Push(i + k) }
    cache = v
}

fn mk(n I64) Vec<I64> {
    v := Vec<I64>()
    for i in range n { v.Push(i) }
    return v
}

fn sum(v Vec<I64>&) I64 {
    s := 0
    for x in v { s += x }
    return s
}

fn main() {
    t := 0
    for k in range N {
        fill(10000, k)
        t += sum(cache)
        made = mk(5000)
        t += made.Len()
        table.Put(k % 3, mk(1000))
        if k % 3 == 2: table.Remove(0)
    }
    io.PutLine($t " " $cache.Len() " " $table.Len())!
}
