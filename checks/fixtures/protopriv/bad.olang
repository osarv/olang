import "kk"
fn main() ? {
    a := kk.Key(1) == kk.Key(11)
    s := $kk.Key(5)
    v := kk.Vec2(1) + kk.Vec2(2)
    l := kk.Vec2(1) > kk.Vec2(2)
    b := kk.Bag()
    x := b[0]
    for _ in b { }
    y := 4 in b
    g := kk.Gen()
    for _ in g { }
    c := kk.Adder(1)
    n := c(2)
    w := kk.Wrap(kk.Key(1)) == kk.Wrap(kk.Key(2))
    r := $kk.Wrap(kk.Key(1))
    ks := kk.Key[kk.Key(1)] == kk.Key[kk.Key(1)]
    h := kk.Wrap(kk.Key(1)).Hash()
    f fn(x I32) I32 = c
    assert seen(a) and seen(s) and seen(v) and seen(l) and seen(x) and seen(y) and seen(n) and seen(w) and seen(r) and
        seen(ks) and seen(h) and seen(f)
}

fn seen<T>(x T) Bool { return true }
