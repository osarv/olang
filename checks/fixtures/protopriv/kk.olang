# M6b: a type whose protocol methods are private - each works in this module, and nowhere else
type Key struct(n I32) {
    N I32 = n
}
fn (a Key) eq(b Key) Bool { return a.N % 10 == b.N % 10 }
fn (a Key) hash() I64 { return I64(a.N % 10) }
fn (k Key) str() String { return "K" $k.N }

type Vec struct(x I32) {
    X I32 = x
}
fn (a Vec) plus(b Vec) Vec { return Vec(a.X + b.X) }
fn (a Vec) less(b Vec) Bool { return a.X < b.X }

type Bag struct() {
    items mut List<I32>& = List<I32>()
}
fn (b Bag&) at(i I64) I32 { return b.items[i] }
fn (b Bag&) len() I64 { return b.items.Len() }
fn (b Bag&) has(x I32) Bool { return x in b.items }

type Gen struct() {
    i mut I64 = 0
}
fn (g mut Gen&) next() I64 ? Exhausted {
    if g.i == 3 { error Exhausted.END }
    g.i++
    return g.i
}

type Adder struct(k I32) {
    K I32 = k
}
fn (a Adder) call(x I32) I32 { return a.K + x }

type Wrap struct(k Key) {
    K Key = k
}

fn apply(f fn(x I32) I32, x I32) I32 { return f(x) }

# a generic of this module: its code sees this module's private methods, wherever it is instantiated
fn Same(a <T>, b T) Bool { return a == b }

# every operation, in the module that may use the private methods
fn Inside() Bool {
    b := Bag()
    b.items.Push(4)
    b.items.Push(5)
    total I64 = 0
    for x in b { total += x }
    g := Gen()
    for y in g { total += y }
    keys := Key[Key(1), Key(2)]
    add := Adder(2)
    ok := Key(1) == Key(11) and $Key(5) == "K5" and (Vec(1) + Vec(2)).X == 3 and Vec(1) < Vec(2) and Vec(3) > Vec(2)
    ok = ok and b[1] == 5 and 4 in b and add(3) == 5 and apply(add, 4) == 6 and total == 15
    ok = ok and Wrap(Key(3)) == Wrap(Key(13)) and keys == Key[Key(11), Key(12)] and $Wrap(Key(2)) == "Wrap(K2)"
    return ok and Wrap(Key(4)).Hash() == Wrap(Key(14)).Hash() and keys.Hash() == Key[Key(21), Key(32)].Hash()
}

# the same, decided while compiling (S18c) and baked into a global (K2), as at run time
Baked := Inside()
fn checkedWhileCompiling() { assert Inside() }
