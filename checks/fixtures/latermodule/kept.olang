# beside view.olang: mat.View's result holds its data, so a view of an array made in a loop's body cannot be kept in a
# list outliving the loop (O10c) - it was accepted, and read freed memory: Mat's Data field is a conditional (a slice of
# the data, else a new array), and a constructor field given one was not held to the instance (C2d). d is fixed storage
# (T7d), lent to View as its widened reference: the instance View returns holding it is what is said
import "std/io"
import "mat"

fn main() ? {
    ms := Vec<mat.Mat<F64>>()
    for i in range 3 {
        d := Array<F64>(4, F64(i))
        ms.Push(try mat.View(d, 0, 2, 2))
    }
    io.Println($ms[0].Get(1, 1) " " $ms[2].Get(1, 1))!
}
