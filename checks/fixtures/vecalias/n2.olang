# M19g: a view handed back through an import alias ("vlib.View2(w)") - an array borrowed from a Vec it was given counts
# as a view of it. (Made a value, "f := vlib.View2" is T22a's error: what it hands back lives where its argument does,
# an obligation a call through a function value cannot check - QCB)
import "vlib"
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn grow(w mut Vec<I64>&) ? io.Error {
    d := vlib.View2(w)
    for i in range 1000 { w.Push(i + 100) }
    churn()
    try io.PutLine($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    try grow(v)
}
