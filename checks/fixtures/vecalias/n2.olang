# M19g: a view handed back through a function value made through an import alias ("f := vlib.View2") - a body not
# known handing back an array borrowed from a Vec it was given counts as a view of it
import "vlib"
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn grow(w mut Vec<I64>&) ? io.IoError {
    f := vlib.View2
    d := f(w)
    for i in range 1000 { w.Push(i + 100) }
    churn()
    try io.Println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    try grow(v)
}
