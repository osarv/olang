# vec3 F3: a spawn target set from a borrowed own result reached through an import alias chain (mid.Vl.View2)
import "mid"
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn grow(w mut Vec<I64>&) ? io.IoError {
    d Array<I64>&w = null
    join {
        spawn d = mid.Vl.View2(w)
    }
    for i in range 1000 { w.Push(i + 100) }
    churn()
    try io.Println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    try grow(v)
}
