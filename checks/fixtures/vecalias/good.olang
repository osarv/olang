import "vlib"
import "olib"
import "std/io"
# what stays legal through an import alias: a borrowed result called by name and used before the Vec grows, a
# plain function made a value, and a scope-relating one called by name
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    d := vlib.View2(v)
    s := d[0] + d[1]
    v.Push(30)
    f := vlib.Sum
    h := olib.Holder()
    n olib.Node& = olib.Node(7)
    olib.Stash(h, n)
    try io.Println($s " " $f(v) " " $h.N.V)
}
