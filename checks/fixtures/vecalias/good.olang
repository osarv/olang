import "vlib"
import "olib"
import "glib"
import "std/io"
# what stays legal through an import alias: a borrowed own result called by name and used before the owner changes, a
# plain function made a value, a scope-relating one called by name, a releasing one called once nothing is borrowed
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    d := vlib.View2(v)
    s := d[0] + d[1]
    v.Push(30)
    f := vlib.Sum
    h := olib.Holder()
    n olib.Node& = olib.Node(7)
    olib.Stash(h, n)
    glib.Drop()
    io.Println($s " " $f(v) " " $h.N.V " " $glib.G.Data[0])
}
