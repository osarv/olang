# E35, S18d: a "!" in a program with no "?" - the error and where it went, in a -d build and under -i
error FxErr {
    GONE
}
Depth mut I64 = 3
fn inner(n I64) I64 ? {
    if n > 0 { error FxErr.GONE }
    return n
}
fn middle(n I64) I64 ? {
    return try inner(n)
}
fn main() {
    x := middle(Depth)!
}
