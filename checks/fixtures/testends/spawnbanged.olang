# E35, P4, P6: "spawn f(x)!" - the task's failure ends the program from its thread, in a -d build and under -i too
error TaskErr {
    LOST
}
Left mut I64 = 0
fn step(n I64) I64 ? {
    if n == 0 { error TaskErr.LOST }
    return n
}
fn main() {
    r := Array<I64>(1)
    join {
        spawn r[0] = step(Left)!
    }
    unreachable
}
