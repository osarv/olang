# B5, S19, S19e, O15, T19b (bulk review 8): an error escaping main leaves main's blocks first - its deferred code, its
# errdefers and the destructors of what it holds - whether or not its word carries a payload, then is said
import "std/io"
type E error { Bad(n I64), Plain }
type R unique struct(id I64) { id } destruct { io.Println("destruct " $id)! }
Live mut I64 = 0
fn f(n I64) I64 ? E {
    if n < 0: error E.Plain
    error E.Bad(n)
}
fn main() ? {
    r := R(1)
    defer io.Println("deferred " $r.id)!
    errdefer io.Println("errdeferred")!
    {
        defer io.Println("inner deferred")!
        x := try f(Live + 2)
        io.Println($x)!
    }
}
