# T25b: literals reaching read-only references are the constant data itself; a local's is its own copy
Live mut Int32 = 1
fn total(a Array<Int32>&) Int32 {
    t Int32 = 0
    for x in a { t = t + x }
    return t
}
fn lenOf(s String&) Int64 { return s.Len() }
error E { X }
fn main() ? E {
    assert total(Int32[3, 4, 5]) + Live == 13
    assert lenOf("static text") + Int64(Live) == 12
    mine := "copied"
    mine[0] = 'C'
    assert mine.Eq("Copied")
}
