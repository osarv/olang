# B3e: interpret refuses what a build refuses, section 8's errors included - a reference default given where something
# can be stored through the result lives exactly where the result does (R11, O25g). (It was a global keeping a lambda
# over what a by-value parameter's payload refers to until R8 built that in the program's scope - refusals question 1;
# before that a view of a match binding's own copy kept outside its clause until R3, and a view of a block's resource
# until O27 built such storage where the view is kept - docs/refusals.md 5.3)
import "std/os"
type E error { Empty }
type Node struct(v I64, next mut Node?&) {
    v
    next
}
fn Node.make(v I64) mut Node& ? E {
    if v < 0 { error E.Empty }
    return Node(v, null)
}
fn main() {
    a mut Node& = Node(1, null)
    n := os.Args().Len()
    {
        b mut Node& = Node(2, null)
        d := a
        if n > 0 { d = b }
        m := try Node.make(n - 5) catch default d
        m.next = Node(3, null)
        assert b.next!.v == 3
    }
}
