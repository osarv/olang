# B3e: a program -i runs as the built program runs - globals, std's maps and lists, text, an extern from libm, a
# file written and read back through the C library, deferred code (S19), a tree of enums held by reference (T17d), and
# main ending in an error nothing catches
import "std/io"
import "std/os"

extern fn sqrt(x F64) F64

Count mut I32 = 10
Names Array<String&> = String&["ada", "bob"]

type P struct(x I32, y I32) {
    x
    y
}
fn (p P&) Sum() I32 { return p.x + p.y }

type Expr enum {
    Lit(v I64)
    Add(a Expr&, b Expr&)
    Neg(e Expr&)
}
fn fold(e Expr&) Expr&e {
    return match e {
        case Expr.Add(Expr.Lit(a), Expr.Lit(b)) => Expr.Lit(a + b)
        case Expr.Add(a, b) => Expr.Add(fold(a), fold(b))
        case Expr.Neg(Expr.Lit(v)) => Expr.Lit(-v)
        case Expr.Neg(x) => Expr.Neg(fold(x))
        nomatch => e
    }
}

error Oops {
    BAD
}
fn risky(n I32) I32 ? Oops {
    if n > 2 { error Oops.BAD }
    return n * 10
}

fn steps() String {
    b := StringBuilder()
    for i in range 4 {
        defer b.Push("d" $i " ")
        if i == 1 { continue }
        if i == 3 { break }
        b.Push("s" $i " ")
    }
    return b.ToString()
}
fn main() ? Oops + io.IoError + os.OsError {
    defer try io.Print("main's deferred code ran\n") catch { }
    Count++
    m := Map<String&, I32>()
    for i, n in Names { m.Put(n, I32(i) + Count) }
    total I32 = 0
    for e in m { total += e.Value }
    p := P(3, 4)
    l := List<I64>()
    for i in range 5 { l.Push(i * i) }
    try io.Print("count " $Count " total " $total " sum " $p.Sum() " squares " $l.ToArray() "\n")
    try io.Print("steps " $steps() "\n")
    tree Expr& = Expr.Add(Expr.Add(Expr.Lit(1), Expr.Lit(2)), Expr.Neg(Expr.Add(Expr.Lit(3), Expr.Neg(Expr.Lit(4)))))
    try io.Print("tree " $tree " folds to " $fold(tree) "\n")
    try io.Print("sqrt " $sqrt(2.0) " evens " $I32[x for x in range 10 if x % 2 == 0] "\n")
    os.Run("echo written > prog.txt")
    t := try os.ReadFile("prog.txt")
    try io.Print("read " $t.Trim() " " $(try risky(1) catch default -1) " " $(try risky(5) catch default -1) "\n")
    y := try risky(3)
    try io.Print("not reached " $y "\n")
}
