# B3e (bulk review 7, F11): a construct the checker does not check yet - a slice with no end of a type with no Len (E31)
# - stops interpret as it stops a build, never runs on (until 2026-11-07 this was a store over a value with destructors
# reached through what a call gives, which is checked now: tests/drops.olang's throughCall)
import "std/io"

type S struct(n I64) {
    n
}

fn (s S&) Slice(lo I64, hi I64) I64 { return hi - lo }

fn main() {
    s := S(5)
    io.Println("sliced " $s[1:])!
}
