# O30-O42: owned objects - built into own slots, moved with take, released, borrowed - the same built, built -d -s (a use
# after a release would be reported) and interpreted. No destructors: -i does not run them yet (B3e)
import "std/io"
type Item struct(v I64) {
    v
    label String& = "i" $v
    next own mut Item&
}
type Shelf struct() {
    top own mut Item&
    spare own mut Item&
}
fn sumOf(l Item&) I64 {
    if l == null { return 0 }
    return l.v + sumOf(l.next)
}
fn (s mut Shelf&) push(v I64) {
    old := take s.top
    s.top = Item(v)
    s.top.next = take old
}
fn (s mut Shelf&) pop() I64 {
    if s.top == null { return -1 }
    v := s.top.v
    s.top = take s.top.next
    return v
}
fn build(n I64) I64 {
    head own mut Item& = null
    for i in range n {
        x own mut Item& = Item(i)
        x.next = take head
        head = take x
    }
    return sumOf(head)
}
Built I64 = build(20)
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        s := $i "-" $(i * 3)
        t += s.Len()
    }
    return t
}
# O31/O32: an owning value held by a local - borrowed copies, take, copies made by a method, owned results
type Buf struct() {
    data own mut Array<I64>& = Array<I64>(2)
    n I64 = 0
}
fn grown(old Array<I64>&, cap I64) own mut Array<I64>& {
    a own mut Array<I64>& = Array<I64>(cap)
    for i in range old.Len() { a[i] = old[i] }
    return a
}
fn (b mut Buf&) add(x I64) {
    if b.n == b.data.Len() { b.data = grown(b.data, b.n * 2) }
    b.data[b.n] = x
    b.n++
}
fn (b Buf&) total() I64 {
    t := 0
    for i in range b.n { t += b.data[i] }
    return t
}
fn (b Buf&) copy() Buf {
    c := Buf()
    for i in range b.n { c.add(b.data[i]) }
    return c
}
fn bufs(k I64) I64 {
    a := Buf()
    for i in range 12 { a.add(i * k) }
    v := a
    t := v.total() + v.n
    c := a.copy()
    c.add(1000)
    d := take c
    a = take d
    a.copy()
    return t * 100000 + a.total() + c.n + d.n
}
Bufs I64 = bufs(3)
fn main() ? {
    s := Shelf()
    for i in range 50 { s.push(i) }
    io.Println($sumOf(s.top) " " $s.top.label)
    for i in range 10 { s.pop() }
    churn()
    io.Println($sumOf(s.top) " " $s.top.label " " $s.top.next.label)
    s.spare = take s.top.next
    c := s.top
    s.top.next = take s.spare.next
    io.Println($c.v " " $sumOf(s.top) " " $s.spare.v)
    take s.spare
    churn()
    io.Println($Built " " $build(5) " " $(s.spare == null) " " $s.top.label)
    a := Buf()
    for i in range 30 { a.add(i) }
    v := a
    io.Println($v.total() " " $v.n " " $v.data.Len())
    churn()
    w := a.copy()
    w.add(7)
    x := take w
    a = take x
    churn()
    io.Println($a.total() " " $a.n " " $w.n " " $x.n " " $Bufs " " $bufs(2))
}
