# R1a (was R17): an error leaving a bare "?" function keeps its name - the set is inferred - so main reports it by name,
# built, built -d with its trace (S18d) and interpreted alike
import "std/io"
type Err error {
    LOUD
}
run mut I64 = 1
fn inner(n I64) ? Err {
    if n > 0 { error Err.LOUD }
}
fn outer(n I64) ? {
    try inner(n)
}
fn main() ? {
    try io.Print("before\n")
    try outer(run)
}
