# X8: the C math library's functions, computed while compiling (the baked globals), by the built program at -O3 and at
# -O0, and under -i - every line printed by each of the three, and all three the same; the integers' methods too
import "std/io"
import "std/arith"

x mut F64 = 0.7
y mut F64 = -2.25

SqrtTwo F64 = 2.0.Sqrt()
ExpSeven F64 = 0.7.Exp()
PowBaked F64 = 0.7.Pow(-2.25)
TanhBaked F32 = F32(0.7).Tanh()
ErfBaked F16 = F16(0.7).Erf()
FmaBaked F64 = 0.1.Fma(10.0, -1.0)
RoundBaked BF16 = BF16(2.5).RoundEven()
IntPowBaked I32 = I32(7).Pow(12)
IntSqrtBaked U64 = U64(18446744073709551615).Sqrt()

fn line(t String&) ? io.Error { try io.Print($t "\n") }

fn main() ? io.Error {
    try line($SqrtTwo " " $ExpSeven " " $PowBaked " " $TanhBaked " " $ErfBaked " " $FmaBaked " " $RoundBaked)
    try line($x.Sqrt() " " $y.Cbrt() " " $x.Exp() " " $y.Exp2() " " $x.Expm1() " " $x.Log())
    try line($x.Log2() " " $x.Log10() " " $y.Log1p() " " $x.Pow(y) " " $x.Hypot(y))
    try line($y.Sin() " " $y.Cos() " " $y.Tan() " " $x.Asin() " " $x.Acos() " " $y.Atan())
    try line($y.Atan2(x) " " $y.Sinh() " " $y.Cosh() " " $y.Tanh() " " $y.Erf() " " $y.Erfc())
    try line($y.Floor() " " $y.Ceil() " " $y.Trunc() " " $y.Round() " " $y.RoundEven())
    try line($x.Fma(y, x) " " $y.Abs() " " $x.CopySign(y) " " $x.Min(y) " " $x.Max(y))
    f F32 = F32(x)
    g F32 = F32(y)
    try line($f.Sqrt() " " $f.Exp() " " $f.Pow(g) " " $g.Sin() " " $f.Fma(g, f) " " $f.Log1p())
    h F16 = F16(x)
    k F16 = F16(y)
    try line($h.Sqrt() " " $h.Exp() " " $h.Pow(k) " " $k.Atan2(h) " " $h.Fma(k, h) " " $k.Cbrt())
    b BF16 = BF16(x)
    c BF16 = BF16(y)
    try line($b.Sqrt() " " $b.Exp() " " $b.Log() " " $c.Tanh() " " $b.Fma(c, b) " " $c.Round())
    try line($y.Sqrt().IsNan() " " $(-y * 1000.0).Exp().IsInf() " " $0.0.Log() " " $(-0.0).Sqrt())
    try line($y.Clamp(-1.0, 1.0) " " $NaN.Min(x) " " $(-0.0).Max(0.0) " " $(-0.0).Min(0.0))
    n I64 = I64(x * 1000.0)
    m U64 = U64(n) * 123456789
    try line($n.Pow(5) " " $(try arith.Pow(n, 9) catch default -1) " " $m.Sqrt() " " $(try (-n).Sqrt() catch default -7) " " $(-n).Abs() " " $n.Clamp(0, 9))
    try line($IntPowBaked " " $IntSqrtBaked " " $Pi.Sin() " " $Euler.Log())
}
