# own5 F3: an owner made, taken or given for an owning parameter while a later argument fails a guaranteed check - a
# slice's bounds, an 'as' that does not hold, an array's length - abandons the test (S18, P1d), whose unwinder releases
# the owner from its hidden slot. Every argument but literals, reads, and unchecked operators on numbers holds it there
# (cgMayLeave's whitelist). The last test sees every owner made released.
Made mut I64 = 0
Dropped mut I64 = 0
type Res struct(n I64) {
    n
    Made = Made + 1
} destruct {
    Dropped = Dropped + 1
}
type Box struct() {
    r own mut Res&
}
type E enum {
    A(k I64)
    B(k I64)
}
fn eat(o own mut Res&, s Array<I64>&) I64 { return o.n + s.Len() }
fn eat3(o own mut Res&, k I64) I64 { return o.n + k }
test "a slice out of range after an owner is made" {
    a := I64[1, 2, 3]
    lo := 2
    hi := 1
    x := eat(Res(1), a[lo:hi])
    println($x)
}
test "an 'as' that does not hold after an owner is made" {
    e := E.B(3)
    x := eat3(Res(2), (e as E.A))
    println($x)
}
test "an array length out of range after an owner is made" {
    n := -1
    x := eat(Res(3), Array<I64>(n))
    println($x)
}
test "a constructor's region made before its argument fails a check" {
    b := Box()
    a := I64[1, 2, 3]
    lo := 3
    b.r = Res(a[lo:1].Len())
}
test "an owner moved out of a slot before a later argument fails a check" {
    b := Box()
    b.r = Res(4)
    e := E.B(5)
    x := eat3(take b.r, (e as E.A))
    println($x)
}
test "every owner made was released" {
    println("made " $Made " dropped " $Dropped)
    assert Made == Dropped
}
