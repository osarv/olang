import "std/io"

# O8f (docs/freeing.md gap 17): an element owning storage only as a Vec's buffer of plain values, given another Vec - in
# an array, and through a Vec's SetAt - frees the buffer the old one held (106 MB at 50,000 turns before)
N I64 = 20000

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 100: w.Push(i + j)
    return w
}

fn main() {
    rows := Array<Vec<I64>>(10)
    v Vec<Vec<I64>>
    for _ in range 10: v.Push(Vec<I64>())
    t := 0
    for i in range N {
        rows[i % 10] = mk(i)
        v[i % 10] = mk(i + 1)
        t += rows[i % 10][99] + v[i % 10][0]
    }
    io.PutLine($t + " " + $rows[3].Len() + " " + $v[3].Len())!
}
