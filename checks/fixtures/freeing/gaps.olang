import "std/io"

# B18a: -memory -check fails on a let-go early freeing does not follow - a Map of Vecs of text copied (O8f,
# docs/freeing.md 2.3: a copy of a Map whose values are Vecs of text is made with no store into its places: they keep)
fn main() {
    rows := Array<Map<String, Vec<String>>>(10)
    for i in range 1000 {
        rows[i % 10] = Map<String, Vec<String>>[$i: Vec<String>[$i]]
        c := rows[(i + 3) % 10]
        c.Put("x", Vec<String>["y"])
        io.PutLn($c.Len())!
    }
}
