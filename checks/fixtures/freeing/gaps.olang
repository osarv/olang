import "std/io"

# B18a: -memory -check fails on a let-go early freeing does not follow - an element given a Vec of text (O8f's gap 17:
# its buffer is freed, the text it holds kept)
fn main() {
    rows := Array<Vec<String>>(10)
    for i in range 1000 { rows[i % 10] = Vec<String>[$i] }
    io.PutLine($rows[3].Len())!
}
