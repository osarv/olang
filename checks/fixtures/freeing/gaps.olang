import "std/io"

# B18a: -memory -check fails on a let-go early freeing does not follow - a Map of Vecs of text built by its literal (O8f,
# docs/freeing.md 2.4: FromIter's entries are the iterator's values copied, made with no store into their places: the
# value place keeps, and with it the Put on the copy)
fn main() {
    rows := Array<Map<String, Vec<String>>>(10)
    for i in range 1000 {
        rows[i % 10] = Map<String, Vec<String>>[$i: Vec<String>[$i]]
        c := rows[(i + 3) % 10]
        c.Put("x", Vec<String>["y"])
        io.PutLn($c.Len())!
    }
}
