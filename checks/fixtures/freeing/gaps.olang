import "std/io"

# B18a: -memory -check fails on a let-go early freeing does not follow - a Vec of text copied (O8f, docs/freeing.md
# 2.3: a copy's text is built in no slot, so the text place keeps; building it in slots costs each copy ~5 ns a string)
fn main() {
    rows := Array<Vec<String>>(10)
    for i in range 1000 {
        rows[i % 10] = Vec<String>[$i, $i + " more"]
        c := rows[(i + 3) % 10]
        c.Push("x")
        io.PutLine($c.Len())!
    }
}
