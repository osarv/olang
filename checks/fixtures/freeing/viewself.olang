import "std/io"

# O8f, condition 6 per value (docs/freeing.md 2.5): the case that keeps - a view of an element's Vec<I64> in use across
# that same element given another: the view reads the old storage, so the element's let-go keeps it, and a place is
# decided as one, so every Vec<I64>'s growth keeps with it (named at the call growing one)
N I64 = 2000

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 30: w.Push(i + j)
    return w
}

fn main() {
    rows Array<Vec<I64>> = Array<Vec<I64>>(4, Vec<I64>())
    t := 0
    for i in range N {
        r Array<I64>& = rows[i % 4].View()
        rows[i % 4] = mk(i)
        t += r.Len() + rows[i % 4][29]
    }
    io.PutLn($t)!
}
