import "std/io"

# O8f (docs/freeing.md 2.4): a Map local filled by Put and stored into an element at its last use is moved there - its
# slot arrays each in their part region, released by the element's next let-go - beside a struct of two Vecs and a Vec
# of text likewise built in a turn and stored (the Map grew by itself a turn, -memory -check passing, before)
N I64 = 20000

type P struct(a Vec<I64>, b Vec<I64>) {
    a
    b
}

fn main() {
    rows := Array<Map<I64, I64>>(10)
    ps := Array<P>(10)
    ts := Array<Vec<String>>(10)
    t := 0
    for i in range N {
        m := Map<I64, I64>()
        for j in range 20: m.Put(i + j, j)
        rows[i % 10] = m
        p := P(Vec<I64>(), Vec<I64>())
        for j in range 20 {
            p.a.Push(i + j)
            p.b.Push(j)
        }
        ps[i % 10] = p
        v Vec<String>
        for j in range 4: v.Push("t" + $(i + j) + " padded out to some length")
        ts[i % 10] = v
        t += rows[i % 10].Get(i + 3)! + ps[(i + 7) % 10].a.Len() + ps[i % 10].b[19] + ts[(i + 3) % 10].Len()
    }
    io.PutLn($t + " " + $rows[3].Get(N - 7 + 5)! + " " + ts[2][3])!
}
