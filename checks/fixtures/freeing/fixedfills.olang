import "std/io"

# O8f (docs/freeing.md, keptlast2): a fill of a constant length whose elements are fixed arrays of text,
# `Array<Array<String>>(3, Array<String>(2, "z"))` - each element's copy built with its text in slots, as the text place's
# stores build it (free.FillText, FixedText): an element replaced in a loop frees what the fill built and every later
# value at once - a local's elements, and one element's element replaced beside them
N I64 = 200000

fn main() {
    a := Array<Array<String>>(3, Array<String>(2, "z"))
    b := Array<Array<String>>(2, Array<String>(3, $"y"))
    s := 0
    for i in range N {
        j := i % 3
        a[j] = Array<String>(2, $"a" + $i + " padded out to some length")
        b[i % 2][i % 3] = $"b" + $i + " padded out to some length"
        s += a[(j + 1) % 3][1].Len() + b[(i + 1) % 2][2].Len()
    }
    try io.PutLn($s + " " + a[0][1] + " " + a[2][0] + " " + b[0][1]) catch io.Error { }
}
