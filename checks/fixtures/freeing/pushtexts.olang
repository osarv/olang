import "std/io"
import "std/os"

# E12c, O6 (D9i; wt-argmove): a fresh text given to a reference a Vec keeps - `v.Push($s)` and `v.Push(b.ToString())`
# into a Vec<String&> held where the call does not close - is built where the reference goes, once. Before, each was
# built there and copied there again, the first copy left behind until that scope closed: twice the text resident. The
# measure is the peak address space gained (VmPeak, as growth.olang's): N texts of 256 KB, each in a chunk mapped for
# itself, are 25 MB at N = 100 for each shape; a program building each twice is at 50, and the limit is midway, 37 MB.
# (wt-copyonce) The same for a conditional's chosen arm (`s if c else $s`) and a try's call (`try f(s)`); (wt-copyonce2)
# a try with a default (`try f(s) catch default ""`), and a call's result stored in a field early freeing gives a region
# (`h.last = copied(s)`), its body handing back an allocation's start: N such results kept in N holders
N I64 = 100

type Fail error { No }

type Holder struct() {
    texts Vec<String&>
    last String&
}

fn (h mut Holder&) add(s String&) { h.texts.Push($s) }

fn (h mut Holder&) made(s String&) {
    b := StringBuilder()
    b.Push(s)
    h.texts.Push(b.ToString())
}

fn (h mut Holder&) chosen(s String&, c Bool) { h.texts.Push(s if c else $s) }

fn built(s String&, ok Bool) String ? Fail {
    if not ok: error Fail.No
    b := StringBuilder()
    b.Push(s)
    return b.ToString()
}

fn (h mut Holder&) tried(s String&) ? Fail { h.texts.Push(try built(s, true)) }

fn (h mut Holder&) defaulted(s String&) { h.texts.Push(try built(s, true) catch default "") }

fn copied(s String&) String {
    b := StringBuilder()
    b.Push(s)
    return b.ToString()
}

fn (h mut Holder&) kept(s String&) { h.last = copied(s) }

# the peak address space, in KB (VmPeak)
fn peak() I64 {
    st := try os.ReadFile("/proc/self/status") catch default ""
    for line in st.Lines() {
        if line.StartsWith("VmPeak:"): return try line[7:line.Len() - 3].Trim().ParseInt(10) catch default 0
    }
    return 0
}

fn verdict(gained I64) String { return "once" if gained < 37 else "twice, " + $gained + " MB" }

fn main() {
    b := StringBuilder()
    for _ in range 256 * 1024: b.Push("x")
    s := b.ToString()
    h mut Holder& = Holder()
    p0 := peak()
    for _ in range N: h.add(s)
    p1 := peak()
    for _ in range N: h.made(s)
    p2 := peak()
    for _ in range N: h.chosen(s, false)
    p3 := peak()
    for _ in range N: h.tried(s)!
    p4 := peak()
    for _ in range N: h.defaulted(s)
    p5 := peak()
    hs Vec<Holder&>
    for _ in range N {
        k mut Holder& = Holder()
        k.kept(s)
        hs.Push(k)
    }
    p6 := peak()
    t := 0
    for x in h.texts: t += x.Len()
    for k in hs: t += k.last.Len()
    io.PutLn($t + " " + verdict((p1 - p0) / 1024) + " " + verdict((p2 - p1) / 1024) + " " + verdict((p3 - p2) / 1024) + " " + verdict((p4 - p3) / 1024) + " " + verdict((p5 - p4) / 1024) + " " + verdict((p6 - p5) / 1024))!
}
