import "std/io"

# O8f (docs/freeing.md gap 22): an element holding a struct with a Vec field by value whose owner place is not sole (a
# change in place, Q.Mk's Push), given another - in an array, and through a Vec's SetAt, whose copy builds the field's
# buffer in a part region (lower.ownerCopy): the old buffer released through the field (lower.partReleases); each kept
# a buffer a turn before
N I64 = 400000

type Q struct() { a Vec<I64> }

fn Q.Mk(i I64) Q {
    q := Q()
    q.a.Push(i)
    return q
}

fn main() {
    rows := Array<Q>(10)
    v Vec<Q>
    for k in range 10: v.Push(Q.Mk(k))
    t := 0
    for i in range N {
        q := Q()
        q.a = Vec<I64>[i, i]
        rows[i % 10] = q
        v[i % 10] = Q.Mk(i)
        t += rows[i % 10].a[0] + v[i % 10].a[0]
    }
    io.PutLn($t)!
}
