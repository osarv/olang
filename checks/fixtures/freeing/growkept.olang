import "std/io"

# O8f, condition 6 per value (review10, docs/freeing.md 2.5): a view of one Vec<I64> - a reference to it, `r Vec<I64>& =
# base` - in use across a call growing another (mk(i)) and an element given another: every Vec<I64>'s buffer is one
# place, but the view is of base's, which neither reaches, so the growth and the element free what they let go of - flat
N I64 = 200000

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 30: w.Push(i + j)
    return w
}

fn main() {
    base := mk(0)
    rows Array<Vec<I64>> = Array<Vec<I64>>(4, Vec<I64>())
    t := 0
    for i in range N {
        r Vec<I64>& = base
        rows[i % 4] = mk(i)
        t += r[1] + rows[i % 4][29]
    }
    io.PutLn($t)!
}
