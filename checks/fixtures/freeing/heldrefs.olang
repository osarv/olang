import "std/io"

# O8f (docs/freeing.md 2.4, wt-origins): a struct held in place given a value, its type holding a reference beside its
# owners - `o.inner = q` with `P{a Vec<String>, b Vec<I64>, r String&}`. Before, a later read of `o` counted as a view
# of the leaves the store let go of (condition 6: a reference field could view them), and `q`'s own leaves, built where
# its references must live (the function's scope), were never let go: master grew ~370 MB at 200,000 turns. Now what
# `o`'s references may view is told from what it holds by value (origins per path, free.refsOf), and `q` lets go of
# its leaves where its turn ends (free.madeLocal). The shapes that must still keep are heldkeeps.olang
N I64 = 20000

type P struct(a Vec<String>, b Vec<I64>, r String&) {
    a
    b
    r
}

type O struct(inner P, n I64) {
    inner
    n
}

fn mkA(i I64) Vec<String> {
    v Vec<String>
    for k in range 3: v.Push(("s" + $(i + k)).PadEnd(200, '.'))
    return v
}

fn mkB(i I64) Vec<I64> {
    v Vec<I64>
    for k in range 40: v.Push(i * k)
    return v
}

# the closed shape: each turn's instance stored into the struct held in place, read again after
fn churn(n I64, base String&) I64 {
    o := O(P(mkA(0), mkB(0), base), 0)
    t := 0
    for i in range n {
        q := P(mkA(i), mkB(i), base)
        o.inner = q
        t += o.inner.a[1].Len() + o.inner.b[3] + o.inner.r.Len() + I64(o.inner.a[0][1])
    }
    return t
}

# the instance read again after it is stored, its leaves let go of at its turn's end
fn readAfter(n I64, base String&) I64 {
    o := O(P(mkA(0), mkB(0), base), 0)
    t := 0
    for i in range n {
        q := P(mkA(i), mkB(i), base)
        if i % 3 != 1: o.inner = q
        t += o.inner.b[5] + q.b[2] + I64(q.a[2][1])
    }
    return t
}

fn main() {
    base := "the base text"
    io.PutLn($churn(N, base) + " " + $readAfter(N, base))!
}
