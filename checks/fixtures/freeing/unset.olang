import "std/io"

# O8f (docs/freeing.md gap 16): a local declared with no value (D13d) is a place like any other - it holds zero bits
# until its first assignment, which releases nothing - so a Vec and a struct holding text given new values each turn
# free what they held (274 MB at 20,000 turns before)
N I64 = 20000

fn mk(i I64) Vec<I64> {
    v Vec<I64>
    for j in range 100: v.Push(i + j)
    return v
}

type Doc struct(text String) { text }

fn main() {
    v Vec<I64>
    v = mk(0)
    for i in range N: v = mk(i)
    d Doc
    d = Doc("")
    for _ in range N: d = Doc(d.text + "x")
    io.PutLn($v[0] + " " + $d.text.Len())!
}
