import "std/io"

# O8f: a Vec literal's item a local's value (`Vec<Big>[b]`), its element then copied out and stored back each turn. The
# item, read into the literal's new storage, is no view in use across the statement's let-goes (Vec.FromIter's); before,
# that read kept the element place, so every turn's replaced element - its array - was kept until main's scope closed.
# Both a struct holding an array alone and one holding a Vec of arrays beside it
N I64 = 20000

type Big struct(count I64) {
    w Array<F64> = Array<F64>(count, 1.5)
}

type Bigger struct(count I64) {
    w Array<F64> = Array<F64>(count, 2.5)
    ws Vec<Array<F64>> = Vec<Array<F64>>()
}

fn main() {
    b := Big(3000)
    v := Vec<Big>[b]
    c := Bigger(3000)
    u := Vec<Bigger>[c]
    t := 0.0
    for i in range N {
        x := v[0]
        x.w[i % 3000] += 1.0
        v[0] = x
        y := u[0]
        y.w[i % 3000] += 1.0
        u[0] = y
        t += v[0].w[0] + u[0].w[1]
    }
    io.PutLn($t + " " + $v[0].w[2999] + " " + $u[0].ws.Len())!
}
