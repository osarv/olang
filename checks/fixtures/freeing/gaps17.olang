import "std/io"

# O8f, docs/freeing.md gap 17's open part: an array's element holding a struct whose field is a Map by value, given
# another built by its constructor from a local and returned - `return S(m)` copies the instance where the result goes
# as `s := S(m)` would (free.retCtorOf), and the local is only read for that copy, never moved there (scope.dropViewed,
# lower.keptView): the old element's Map released at the store, flat under 8 MB (was 13 MB to 100 MB at 20,000 turns)
N I64 = 20000

type S struct(m Map<String, I64>) {
    m
}

fn S.mk(i I64) S {
    m Map<String, I64>
    for j in range 20: m.Put($i + "-" + $j + " padded out a little", j)
    return S(m)
}

fn main() {
    rows := Array<S>(10, S(Map<String, I64>()))
    t := 0
    for i in range N {
        rows[i % 10] = S.mk(i)
        t += rows[i % 10].m.Len()
    }
    io.PutLn($t)!
}
