import "std/io"

# B18a, docs/freeing.md gap 17's open part (2026-11-24, wt-gaps1719): an array's element holding a struct whose field is
# a Map by value, given another built by its constructor from a local - S(m) is a call's value copied, and a copy
# holding a Map stays untracked (as gaps.olang's literal): the old element's Map is kept until main's scope closes,
# 13 MB to 100 MB at 20,000 turns. -memory -check names it
N I64 = 20000

type S struct(m Map<String, I64>) {
    m
}

fn S.mk(i I64) S {
    m Map<String, I64>
    for j in range 20: m.Put($i + "-" + $j + " padded out a little", j)
    return S(m)
}

fn main() {
    rows := Array<S>(10, S(Map<String, I64>()))
    t := 0
    for i in range N {
        rows[i % 10] = S.mk(i)
        t += rows[i % 10].m.Len()
    }
    io.PutLn($t)!
}
