import "std/io"

# B18a, docs/freeing.md gap 17's open part: a struct holding a Map by value built by its constructor from a Map local -
# the instance views the local (D9h) and is copied where it is kept, so the local is only read for that copy
# (lower.keptView) and stays in its own block (never lifted, or moved where the result goes - scope.dropViewed): a
# builder's `s := S(m); return s`, a store into an array's element in the loop itself, a Vec<S>'s element given one
# through SetAt, and a local read again after the constructor's copy - each flat
N I64 = 20000

type S struct(m Map<String, I64>) {
    m
}

fn S.mk(i I64) S {
    m Map<String, I64>
    for j in range 20: m.Put($i + "-" + $j + " padded out a little", j)
    s := S(m)
    return s
}

fn main() {
    rows := Array<S>(10, S(Map<String, I64>()))
    vs := Vec<S>()
    for _ in range 10: vs.Push(S(Map<String, I64>()))
    t := 0
    for i in range N {
        rows[i % 10] = S.mk(i)
        m Map<String, I64>
        for j in range 10: m.Put($j + "-" + $i + " padded out a little", i + j)
        vs[i % 10] = S(m)
        k Map<String, I64>
        for j in range 5: k.Put("k" + $j + "-" + $i, j)
        rows[(i + 5) % 10] = S(k)
        t += rows[i % 10].m.Len() + vs[i % 10].m.Len() + k.Len() + rows[(i + 5) % 10].m.Len()
    }
    io.PutLn($t + " " + $vs[3].m.Len())!
}
