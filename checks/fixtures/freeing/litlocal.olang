import "std/io"

# O8f (docs/freeing.md 2.4): array literals holding a local's value given each turn to a place - a call's Vec of text and
# a Vec of numbers built by pushes beside items built for the literal. The local's value is copied into the literal's
# region as each item is built there (typed.LastUses.Literal: never moved, so never lifted to where the place lives), and
# read only until that copy is made - so each turn's arrays, items and locals are freed. Before, the place kept (the
# local, moved where it lives, was outside the region: "one of whose items is not built for it")
N I64 = 20000

fn build(i I64) Vec<String> {
    v Vec<String>
    for k in range 3: v.Push("t" + $(i + k) + " padded out to some length")
    return v
}

fn main() {
    rows Array<Vec<String>>
    nums Array<Vec<I64>>
    t := 0
    for i in range N {
        v := build(i)
        rows = Array<Vec<String>>[Vec<String>["x"], v, Vec<String>[$"y" + $i]]
        w Vec<I64>
        for k in range 30: w.Push(i + k)
        nums = Array<Vec<I64>>[w, Vec<I64>[7]]
        t += rows[1].Len() + rows[2][0].Len() + nums[0][29] + nums[1][0]
    }
    io.PutLn($t + " " + rows[1][2] + " " + rows[2][0] + " " + $nums[0][0])!
}
