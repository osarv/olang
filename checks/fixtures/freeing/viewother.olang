import "std/io"

# O8f, condition 6 per value (docs/freeing.md 2.5): views of one Vec<I64> - a reference to it, its View(), a for-in's
# walk - in use across let-goes of other Vec<I64>s' storage (a call growing its own, an element given another, a local
# pushed to) free what those let go of: the place is every Vec<I64>'s buffer, but the views are of base's, which nothing
# there reaches. Before, they kept every Vec<I64>'s growth in the program (review10)
N I64 = 200000

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 30: w.Push(i + j)
    return w
}

fn main() {
    base := mk(0)
    rows Array<Vec<I64>> = Array<Vec<I64>>(4, Vec<I64>())
    t := 0
    for i in range N {
        r Vec<I64>& = base
        v Array<I64>& = base.View()
        rows[i % 4] = mk(i)
        other Vec<I64>
        for x in base: other.Push(x + i)
        t += r[1] + v[3] + rows[i % 4][29] + other[29]
    }
    io.PutLn($t)!
}
