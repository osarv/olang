import "std/io"

# docs/freeing.md gap 19's open part (wt-gaps1719; wt-gap19): a returned value local landing in an array's element
# keeps storage there each call where it is text given a second value before the return (`again`, ~450 bytes a call: its
# last value's region, made where the result goes, which the element's slot let-go does not release) or a choice of two
# Vec locals (`pick`, 48 bytes a call: the copy its return makes, in no region); a returned text local (`txt`, rettext)
# and the two Vec locals are freed. Over 8 MB at 400,000 turns, both named by -memory -check; output right everywhere
N I64 = 400000

fn txt(i I64) String {
    s := $i + " padded out a little"
    return s
}

fn again(i I64) String {
    s := $i + " padded out a little"
    s = s + "!"
    return s
}

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 4: w.Push(i + j)
    return w
}

fn pick(i I64) Vec<I64> {
    a := mk(i)
    b := mk(i + 1)
    return a if i % 2 == 0 else b
}

fn main() {
    c := Array<String>(10)
    d := Array<String>(10)
    w := Array<Vec<I64>>(10)
    t := 0
    for i in range N {
        c[i % 10] = txt(i)
        d[i % 10] = again(i)
        w[i % 10] = pick(i)
        t += c[i % 10].Len() + d[i % 10].Len() + w[i % 10][0]
    }
    io.PutLn($t)!
}
