import "std/io"

# O8f (docs/freeing.md gap 22): an array's element holding a struct whose field is a Vec by value, given another - the
# old element's buffer is released (a part leaf reached through the owner field, free.ReleaseLeaves); it kept every
# buffer before (777 MB at 1,600,000 turns)
N I64 = 400000

type P struct(a Vec<I64>) { a }

fn main() {
    ps := Array<P>(10, P(Vec<I64>[0]))
    t := 0
    for i in range N {
        ps[i % 10] = P(Vec<I64>[i, i + 1])
        t += ps[i % 10].a[1]
    }
    io.PutLn($t + " " + $ps[3].a.Len())!
}
