# C11/O16: 26 shapes of destructor temporaries, each block balanced
import "std/pair"
import "std/io"
Made mut I64 = 0
Gone mut I64 = 0
Twice mut I64 = 0
type Res unique struct(k I64) {
    k
    gone Bool = false
    Made++
} destruct {
    if gone { Twice++ }
    gone = true
    Gone++
}
type E error { X }
type FRes unique struct(k I64) ? E {
    k
    gone Bool = false
    if k < 0 { error E.X }
    Made++
} destruct {
    if gone { Twice++ }
    gone = true
    Gone++
}
fn id<T>(x T) T { return x }
fn pick<T>(a T, b T, c Bool) T { return a if c else b }
fn first<T, U>(a T, b U) T { return a }
type Box<T> struct(x T) {
    x
}
fn takeR(r Res&) I64 { return r.k }
fn Res.mkR(k I64) Res& ? E {
    if k < 0 { error E.X }
    return Res(k)
}
fn Res.mkV(k I64) Res& ? E {
    if k < 0 { error E.X }
    return Res(k)
}
fn Res.retCond(c Bool) Res& { return Res(1) if c else Res(2) }
fn Res.retMatch(k I64) Res& {
    return match k {
        case 1: Res(1)
        case _: Res(2)
    }
}
fn task(r mut Res&) { r.k++ }
fn Res.mk(k I64) Res& { return Res(k) }
fn main() ? {
    c := true
    {
        a := try Res.mkR(1) catch default Res(2)
    }
    try io.PutLine("0: " $(Made - Gone))
    {
        a2 := try Res.mkR(-1) catch default Res(3)
    }
    try io.PutLine("1: " $(Made - Gone))
    {
        b FRes& = try FRes(1) catch { unreachable }
    }
    try io.PutLine("2: " $(Made - Gone))
    {
        b2 := try FRes(4) catch { unreachable }
    }
    try io.PutLine("3: " $(Made - Gone))
    {
        b3 := id(try FRes(5) catch { unreachable })
    }
    try io.PutLine("4: " $(Made - Gone))
    {
        d := id(id(Res(5)))
    }
    try io.PutLine("5: " $(Made - Gone))
    {
        e := pick(Res(6), Res(7), c)
    }
    try io.PutLine("6: " $(Made - Gone))
    {
        f := first(Res(8), Res(9))
    }
    try io.PutLine("7: " $(Made - Gone))
    {
        g := Box(Res(10))
        assert g.x.k == 10
    }
    try io.PutLine("8: " $(Made - Gone))
    {
        h := pair.Pair(Res(11), 3)
        assert h.Second == 3
    }
    try io.PutLine("9: " $(Made - Gone))
    {
        i := Res(12) if c else (Res(13) if c else Res(14))
    }
    try io.PutLine("10: " $(Made - Gone))
    {
        j := takeR(id(Res(15)) if c else Res(16))
        assert j == 15 or j == 16
    }
    try io.PutLine("11: " $(Made - Gone))
    {
        k := Res.retCond(c)
    }
    try io.PutLine("12: " $(Made - Gone))
    {
        l := Res.retMatch(1)
    }
    try io.PutLine("13: " $(Made - Gone))
    {
        m := Map<I64, Res&>()
        m.Put(1, Res(17))
        m.Put(2, id(Res(18)))
    }
    try io.PutLine("14: " $(Made - Gone))
    {
        n := Array<Res&>[Res(19), id(Res(20))]
        assert n.Len() == 2
    }
    try io.PutLine("15: " $(Made - Gone))
    {
        o := Array<Res&>(3, Res(21))
        assert o.Len() == 3
    }
    try io.PutLine("16: " $(Made - Gone))
    {
        r := Vec<Res&>()
        r.Push(Res(22) if c else Res(23))
    }
    try io.PutLine("17: " $(Made - Gone))
    {
        join {
            spawn task(Res(24))
            spawn task(id(Res(25)))
        }
    }
    try io.PutLine("18: " $(Made - Gone))
    {
        s Res& = Res(0)
        join { spawn s = Res.mk(26) }
    }
    try io.PutLine("19: " $(Made - Gone))
    {
        t := id(try Res.mkR(-1) catch default Res(2))
    }
    try io.PutLine("20: " $(Made - Gone))
    {
        u := (try Res.mkR(-5) catch default Res(9)) if c else Res(10)
    }
    try io.PutLine("21: " $(Made - Gone))
    {
        u2 := try Res.mkV(-5) catch default Res(9)
    }
    try io.PutLine("22: " $(Made - Gone))
    {
        v := $id(Res(30))
        assert v.Len() > 0
    }
    try io.PutLine("23: " $(Made - Gone))
    {
        w := id(Res(31)).k
        assert w == 31
    }
    try io.PutLine("24: " $(Made - Gone))
    {
        x := takeR(pair.Pair(Res(32), 1).First)
        assert x == 32
    }
    try io.PutLine("25: " $(Made - Gone))
    try io.PutLine("made " $Made " gone " $Gone " twice " $Twice)
}
