# E11b/E11c: a test failing inside a Str reached through a List element and a struct field - what the Str made is
# destructed on the way out
import "std/io"
type Res struct(k I64) {
    k
} destruct { try io.Println("Res destructed " $k) catch io.Error { } }
type Bag struct(n I64) {
    n
}
fn (b Bag&) Str() String {
    r Res&return = Res(b.n)
    assert b.n != 7, "a Str stops its test"
    return "b-" $b.n
}
type Outer struct(a Bag, b Bag) {
    a
    b
}
test "failing inside a List element's Str" {
    l := Vec<Bag>()
    l.Push(Bag(1))
    l.Push(Bag(7))
    l.Push(Bag(3))
    s := $l
    try io.Println("not reached " $s) catch io.Error { }
}
test "failing inside a field's Str" {
    o := Outer(Bag(2), Bag(7))
    s := "x" $o "y"
    try io.Println("not reached " $s) catch io.Error { }
}
test "after" {
    try io.Println("third test runs") catch io.Error { }
}
