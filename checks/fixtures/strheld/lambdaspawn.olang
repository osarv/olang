# E11c/D16e: a Str spawning a lambda that renders a receiver field
type Cell struct() {
    v I64 = 3
}
type Bag struct(c mut Cell&) {
    c
}
fn (b Bag&) Str() String {
    join {
        spawn fn() {
            s := $b.c.v "x"
            b.c.v.AtomicAdd(s.Len())
        }
    }
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    println($b)
}
