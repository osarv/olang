# T25d: constant text as a read-only conditional's value is the constant itself
import "std/io"
type Bag struct(name String&) {
    name
}
fn (b Bag&) Str() String {
    name := b.name if b.name.Len() > 0 else "anon"
    return $name
}
fn main() ? {
    try io.Println($Bag(""))
    try io.Println($Bag("x"))
}
