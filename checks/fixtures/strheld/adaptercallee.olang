# E11c/E31: the same inside a helper handed the part
import "std/io"
type Ctr struct(v I64) {
    v
}
fn (c Ctr&) Call() I64 {
    s := $c.v "x"
    return s.Len()
}
fn hh(c Ctr&) I64 {
    g fn() I64 = c
    return g()
}
type Bag struct(c Ctr&) {
    c
}
fn (b Bag&) Str() String { return "b" $hh(b.c) }
fn main() ? { try io.Println($Bag(Ctr(5))) }
