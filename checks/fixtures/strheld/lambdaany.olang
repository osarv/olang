# E11c/D16c: a Str making a capturing lambda for Some - the receiver's scope is a real one, which the closure's escape
# reads
import "std/io"
type Item struct(id I64) {
    id
    tags Vec<String&> = Vec<String&>()
}
fn (it Item&) Str() String {
    hit := it.tags.Iter().Some(fn(t String&) Bool { return t == $it.id })
    return $it.id " " $hit
}
fn main() ? {
    it := Item(7)
    it.tags.Push("a")
    it.tags.Push("7")
    try io.Println($it)
}
