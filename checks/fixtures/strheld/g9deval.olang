# G9d: the evaluator and the run time agree on generic calls of destructor temporaries
import "std/io"
Made mut I64 = 0
type Res struct(k I64) {
    k
} destruct {
    Made++
}
fn id<T>(x T) T { return x }
fn pick<T>(a T, b T, c Bool) T { return a if c else b }
fn twice<T>(x T) Array<T> { return T[x, x] }
G := id(Res(5))
H := pick(Res(6), Res(7), false)
A := twice(Res(8))
fn count<T>(l Vec<T>&, x T) I64 { return l.Len() }
fn main() ? {
    l := Vec<Res&>()
    l.Push(Res(1))
    try io.Println($G.k " " $H.k " " $A.Len() " " $(A[0] == A[1]) " " $count(l, Res(2)))
    assert id(Res(9)).k == 9
}
