# E11b/E11c: joins reaching a Str in a lambda, a global initializer, a destructor, defer, a match block, constructors,
# a catch
# default, tasks and a for condition
type Big struct(n I64) {
    n
}
fn (b Big&) Str() String {
    sb := StringBuilder()
    for i in range 10 { sb.Push("0123456789") }
    sb.Push("-" $b.n)
    return sb.ToString()
}
G String& = $Big(1) "g"
type Res struct(k I64) {
    k
} destruct { println("dtor " $Big(k) "!") }
type Holder struct(k I64) {
    k
    t String& = $Big(k) "h"
    u String& = "x"
} 
type Holder2 struct(k I64) {
    k
    t mut String& = "none"
    if k > 0 {
        t = $Big(k) "nested"
    }
}
fn fails(k I64) String ? {
    if k > 0 { error }
    return "ok"
}
fn main() ? {
    f := fn(k I64) I64 { s := $Big(k) "lam"
        return s.Len() }
    println($f(3) " " $G.Len())
    {
        r := Res(4)
        defer { println("defer " $Big(5) "!") }
        match r.k {
            case 4 {
                x := $Big(6) "m"
                println(x)
            }
            nomatch { }
        }
    }
    h := Holder(7)
    h2 := Holder2(8)
    println($h.t " " $h2.t)
    d := try fails(1) catch default $Big(9) "d"
    println(d)
    out := Array<I64>(2)
    join { for k in range 2 { spawn out[k] = f(10 + k) } }
    println($out)
    i I64 = 0
    for ($Big(11) " " $i).Len() > 0 and i < 3 { i++ }
    println($i)
}
