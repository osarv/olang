# a module three programs import, built side by side in one directory (checks.olang's sidebyside)

fn Sum(n I64) I64 {
    s I64 = 0
    for i in range n { s += i * i % 7 }
    return s
}

fn Words(n I64) I64 {
    l := List<String&>()
    for i in range n { l.Push($"w" $i) }
    m := Map<String&, I64>()
    for w in l { m.Put(w, w.Len()) }
    return m.Len()
}
