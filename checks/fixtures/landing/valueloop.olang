# O18a: a value local's references live in its own block, so a loop body's are reclaimed with each iteration - they
# went to the function's own scope, about 16 bytes a pass kept for the whole call. Run under a small address-space
# limit that ten million passes would exceed
import "std/io"
import "std/os"

type Link struct(v I64, next Link&) {
    v
    next
}

fn work(n I64) I64 {
    t I64 = 0
    for i in range n {
        m := Link(i, Link(i + 2, null))
        t = t + m.next.v
    }
    return t
}

fn main() ? io.IoError {
    n I64 = 10000000 * os.Args().Len()
    try io.Print($work(n) "\n")
}
