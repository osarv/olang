# B3i: a module calling instances the root's object makes (List<Item>), and a leaf's function
import "leaf"

type Item struct(N I64) {
    N
}

fn Make(n I64) Vec<Item> {
    l := Vec<Item>()
    for i in range n { l.Push(Item(leaf.Scale(i))) }
    return l
}

fn Total(l Vec<Item>&) I64 {
    t I64 = 0
    for x in l { t += x.N }
    return t
}
