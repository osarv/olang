# check: run
# O23/O23a, W4 (field sets): a field written '= of' lives where the instance's constructor argument did, which every
# reader of c believes (c.at reads at outer's scope). Storing through an element that aliases c was refused (O23, O11)
# until 2026-11-10: now the field's binding through the element is the body's field set - the bindings main's own
# constructor calls gave it, outer's scope alone - so x is held to it and built where outer is (O28), a new one each
# turn, and 'keep' read after the loop and an arena churn still names the last turn's
type N struct(v I32) {
    v
}
type Cur struct(of mut N&) {
    at mut N& = of
}
fn churn() {
    for i in range 50 {
        junk := Array<I64>(1000, i)
        assert junk[999] == i
    }
}
fn main() ? {
    outer mut N& = N(1)
    keep N& = outer
    for i in range 2 {
        x mut N& = N(I32(42 + i))
        c := Cur(outer)
        arr Array<mut Cur&> = Array<Cur&>[c]
        arr[0].at = x
        keep = c.at
    }
    churn()
    assert $keep != ""
    assert keep.v == 43
}
