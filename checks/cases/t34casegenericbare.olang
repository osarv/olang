# check: fail type arguments for aBox: expected 1, found 0
# never: is not covered
# T34, G7 (the any review, finding 5): a type case naming a generic type names one of its instances, with its arguments
# - "case aBox b" says so at the case, and is the one error
type aShape trait for aBox<I64>, aDot {
    Area() I64
}
type aBox<T> struct(v T, n I64) {
    v
    n
}
fn (b aBox<T>&) Area() I64 { return b.n }
type aDot struct(k I64) { k }
fn (d aDot&) Area() I64 { return 0 }
fn kind(s any aShape&) I64 {
    match s {
        case aBox b { return b.n }
        case aDot _ { return 0 }
    }
}
fn main() { }
