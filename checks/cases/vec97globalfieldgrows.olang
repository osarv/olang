# check: fail error[M19g]: 'd' holds a view of 'GL.toks' taken before 'GL.toks' may have grown
# Vec phase 2a (O31/O39): a global struct holding a Vec - a function pushing to it may release a view's buffer
# M19g, round 2 (brought back from round 1's deletion): the same Vec is seen on both sides, so the view is refused
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
GL mut Lexer = Lexer(1)
fn bump() { GL.toks.Push(5) }
fn main() ? {
    for i in range 3 { GL.toks.Push(i) }
    d := GL.toks.View()
    bump()
    try io.Println($d[0])
}
