# check: run
# E11c: "$" calls a Str once per rendering, whatever it writes - a cursor holding a field of the receiver, written by a
# helper: once per "$", while compiling (Baked, K2) as at run time
type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
type Cur2 struct(c mut Cell&) {
    c
}
fn poke2(p mut Cur2&) { p.c.v++ }
fn (b Bag&) Str() String {
    cur := Cur2(b.c)
    poke2(cur)
    return "b" $b.c.v
}
fn render(k I64) String {
    b := Bag(Cell())
    b.c.v += k
    t := $b
    return $t " " $b " v=" $b.c.v
}
Baked := render(0)
Zero mut I64 = 0                        # read at run time: the call below is made there
fn main() ? {
    assert Baked == "b1 b2 v=1"                 # v read where it is evaluated, before the pieces render (E11b)
    assert render(Zero) == Baked
}
