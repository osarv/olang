# check: run
# T25c, QCE: 'x := G' copies an immutable global's Vec - a Vec of its own since 2026-11-01, so a 'mut' receiver may write
# it and G stays as it was (a handle's copy was read-only: Push would have changed G's list)
G Vec<I64> = I64[1].ToVec()
fn main() ? {
    x := G
    x.Push(1)
    assert x.Len() == 2 and G.Len() == 1
}
