# check: fail error[C11]: Conn has a destructor to run, and List<Conn> keeps values of it
# C11: std/list's List keeps its elements in chunks a reference names - its copies are second holders, so nothing would
# end them - where a Vec of them, Vec<Conn>, ends them (was the refusal of every type argument until 2026-11-07)
import "std/list"
Closed mut I64 = 0
type Conn unique struct(fd I32) {
    fd
} destruct { Closed++ }
fn main() {
    v := list.List<Conn>()
    assert v.Len() == 0
}
