# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# D9/O4b: a callee may build through the references a by-value parameter holds wherever they may be stored through, as
# through a writable reference parameter - so a generic taking an array of such references by value is not given one
# read through a '&p' field, whose scope is not known here
type N struct(v I32) {
    v
    next mut N?& = null
}
type Cur struct(of mut Array<mut N&>&) { at mut Array<mut N&>& = of }
fn growFirst<T>(k T, x T) { x[0].next = N(9) }
fn fill(c mut Cur&) {
    local := Array<mut N&>(0)
    growFirst(local, c.at)
}
fn main() ? { }
