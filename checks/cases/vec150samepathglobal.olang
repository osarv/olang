# check: fail error[O25h]: this value holds references into a scope the target outlives
# round 1 of docs/memory.md: a Vec is a handle, so 'take' no longer moves one - its record stays in the first own
# object's region, and storing the handle into another region is refused by O25h (O1b for a global, O38 for a borrow)
# vec7 F1 through a global reference repointed between the two reads
import "std/io"
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
    more Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
G mut Parser& = Parser()
H mut Parser& = Parser()
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    keep := G
    G.lx = Lexer()
    H.lx = Lexer()
    for i in range 3 { H.lx.toks.Push($i "-word-in-H's-lexer-region") }
    q := G.lx
    G = H
    q.more = G.lx.toks
    H.lx = null
    churn()
    try io.Println(keep.lx.more[0])
}
