# check: run
# flags: -debug -sanitize
# vec7 F2: a field's Vec given a clone of a Vec reached through a call's built result held in a local (round 1 of
# docs/memory.md: a Vec is a handle, so storage of its own in the own object's region is a Clone)
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn fresh(n I64) mut Lexer& {
    l mut Lexer& = Lexer()
    for i in range n { l.toks.Push($i "-fresh") }
    return l
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    d := Parser()
    d.lx = Lexer()
    q := fresh(3)
    d.lx.toks = q.toks.Clone()
    churn()
    assert d.lx.toks.Len() == 3 and d.lx.toks[1] == "1-fresh" and q.toks.Len() == 3
}
