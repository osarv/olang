# check: fail error[O39]: calling 'Push' may release the Array<Char> borrowed on line
# vec3 F1: the same through a List - the argument pushed and read back with l[0]
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn k(a mut Array<Char>&) mut Array<Char>& { l := List<mut Array<Char>&>()
    l.Push(a)
    return l[0] }
fn main() ? {
    v := Vec<Char>()
    v.Push('a')
    v.Push('b')
    d := k(v.ViewMut())
    for i in range 1000 { v.Push('z') }
    churn()
    println($d[0] $d[1])
}
