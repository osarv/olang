# check: fail error[O39]: calling 'add' may release the Array<I64> borrowed on line
# a borrowed copy's loan lasts until its last use - a call that may release its source's buffer is refused before it
import "std/io"
type Buf struct() {
    data own mut Array<I64>& = Array<I64>(2)
    n I64 = 0
}
fn grown(old Array<I64>&, cap I64) own mut Array<I64>& {
    a own mut Array<I64>& = Array<I64>(cap)
    for i in range old.Len() { a[i] = old[i] }
    return a
}
fn (b mut Buf&) add(x I64) {
    if b.n == b.data.Len() { b.data = grown(b.data, b.n * 2) }
    b.data[b.n] = x
    b.n++
}
fn (b Buf&) copy() Buf {
    c := Buf()
    for i in range b.n { c.add(b.data[i]) }
    return c
}
fn main() ? {
    a := Buf()
    b := a
    a.add(1)
    try io.Println($b.n)
}
