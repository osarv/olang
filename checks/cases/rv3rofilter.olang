# check: run
# T25c, QCE: Filter copies the elements it keeps into a new array, writable - each Vec a copy of its own since
# 2026-11-01 (a handle's copy was a second name, so a read-only array of them was refused), so a read-only array of Vecs
# is filtered, and pushing to what Filter gives changes nothing the array holds
fn f(ro Array<Vec<I64>>&) I64 {
    kept := ro.Filter(fn(x Vec<I64>) Bool { return x.Len() > 0 })
    kept[0].Push(9)
    return kept.Len() * 10 + kept[0].Len() * 100 + ro[0].Len()
}
fn main() ? {
    a := Array<Vec<I64>>(2, Vec<I64>())
    a[0].Push(1)
    assert f(a) == 211
}
