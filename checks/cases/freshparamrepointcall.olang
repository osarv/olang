# check: fail error[S4e]: 'n' is repointed at a new value: the caller still sees what it passed
# S4e: a call returning a value is storage given here too (E12c), whatever function builds it
type N struct(v I64) {
    v
}

fn make(v I64) N { return N(v) }

fn Bump(n N&) I64 {
    n = make(n.v + 1)
    return n.v
}

fn main() {
    a := N(1)
    Println(Bump(a))
}
