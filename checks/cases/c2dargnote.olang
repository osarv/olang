# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# B11/C2d: the error names the argument the instance would outlive, and the note says where to make it
import "std/io"
type Module struct(Path String&, Dir String&, Src String&) {
    Path
    Dir
    Src
}
type R struct() {
    mods Vec<mut Module&>
}
fn (r mut R&) load(path String&) {
    src := "text" $path
    m mut Module& = Module(path, path[0:1], src)
    r.mods.Push(m)
}
fn main() ? {
    r := R()
    r.load("abc")
    try io.PutLine($r.mods.Len())
}
