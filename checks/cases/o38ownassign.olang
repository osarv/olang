# check: fail error[O38]: this value borrows an own object, and an owner, or a value with a destructor, would hold it past its loans
# O38: ...assigned to an owner local (own4 N4)
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
type Box struct(x Outer&) {
    x
}
fn withFirst(x Outer&) own mut Array<Box&>& {
    a own mut Array<Box&>& = Array<Box&>(1)
    a[0] = Box(x)
    return a
}
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    arr own mut Array<Box&>& = null
    arr = withFirst(b)
    println($arr[0].x.o.k)
}
