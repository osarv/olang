# check: run
# O25g, O28: a value local's field viewing its constructor argument's referent, reassigned a longer-lived reference -
# the argument (a value local of the block) built where the new referent lives, the binding exact there; read back after
# an arena churn (review A, r1)

type Tally struct() {
    seen := Vec<I64>()
}

type Logger struct(log mut Tally&) {
    log
}

fn (l mut Logger&) Note(id I64) { l.log.seen.Push(id) }

fn churn() I64 {
    n := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        n += s.Len() + a[3]
    }
    return n
}

fn main() {
    out := Tally()
    {
        inner := Tally()
        lg := Logger(inner)
        lg.log = out
        for k in range 100 { lg.Note(k) }
        inner.seen.Push(1)
    }
    churn()
    s := 0
    for x in out.seen { s += x }
    assert out.seen.Len() == 100 and s == 4950

}
