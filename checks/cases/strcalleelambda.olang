# check: run
# flags: -s
# E11c/D16c: a helper handed the receiver's node makes a lambda capturing it, only ever called - its environment is in
# the helper's frame, so nothing is built where the node lives
type Node struct(v I64, next mut Node&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&) {
    head
}
fn peek(n Node&) I64 {
    f := fn() I64 { return n.v }
    return f()
}
fn (b Bag&) Str() String {
    return $peek(b.head)
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    println(s)
}
