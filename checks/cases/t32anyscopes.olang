# check: run
# flags: -debug -sanitize
# T30c (was a T32a refusal): a method whose result borrows from the instance is within its trait's method's bound - the
# result may borrow from the receiver, as a function type's from its parameters (T22b) - and a call through the "any"
# is held to it: the item read back after storage was made and let go many times
type aItem struct(v I64) { v }
type aHas trait {
    Get() aItem&
}
type aBox struct(it aItem&) { it }
fn (b aBox&) Get() aItem& { return b.it }
fn churn(n I64) I64 {
    t := 0
    for i in range n {
        v := Vec<aItem>()
        for j in range 16 { v.Push(aItem(i * j)) }
        t += v[15].v
    }
    return t
}
fn main() {
    b := aBox(aItem(1))
    x any aHas& = b
    r := x.Get()
    churn(100)
    assert r.v == 1
}
