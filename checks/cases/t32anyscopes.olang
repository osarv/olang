# check: fail error[T32a, T22a]: aBox's 'Get' relates its arguments' scopes, which a call through an 'any aHas&' cannot check - call it directly, or through generic code
# T32a, T22: run-time trait values
type aItem struct(v I64) { v }
type aHas trait {
    Get() aItem&
}
type aBox struct(it aItem&) { it }
fn (b aBox&) Get() aItem& { return b.it }
fn f(x any aHas&) { }
fn main() {
    b := aBox(aItem(1))
    f(b)
}
