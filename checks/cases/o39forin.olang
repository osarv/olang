# check: fail error[O39]: assigning 't.bag' may release the Bag borrowed on line
# a for-in walks what it was given until the loop ends
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
type Bag struct() {
    items List<I64>
}
type Top struct() {
    bag own mut Bag&
}
fn main() ? {
    t := Top()
    t.bag = Bag()
    t.bag.items.Push(1)
    for x in t.bag.items {
        t.bag = null
        io.Println($x)
    }
}
