# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# B11/O10c: an entry parsed from a line made each turn is kept in a longer-lived table. The entry's references are the
# line's (parse requires its argument to outlive its result), so the note points at the line, not at a scope argument
# for parse - which would only move the error into parse
import "std/io"
type Entry struct(service String&) {
    service
}
fn Entry.parse(line String&) Entry { return Entry(line[0:2]) }
type Stats struct() {
    names Map<String&, I64>
}
fn (s mut Stats&) add(e Entry) { s.names.Put(e.service, 1) }
fn run(lines Array<String&>&) I64 {
    s := Stats()
    for l in lines {
        line := $l "!"
        e := Entry.parse(line)
        s.add(e)
    }
    return s.names.Len()
}
fn main() ? { try io.Println($run(String&["ab", "cd"])) }
