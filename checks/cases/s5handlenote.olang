# check: run
# R2 (refusals 5.2): compiles now - the text built where 'names' lives, which the inner list's SetAt keeps (O28 through
# O10c); it was refused, as what follows says
# B11 (G4): the note on a store into an element of a handle element names the collection as written, never the copy
# the compiler held for it
fn main() ? {
    names := Vec<Vec<String&>>()
    names.Push(Vec<String&>())
    names[0].Push("x")
    for k in range 3 {
        t := $k "-loop-text-of-moderate-length"
        names[0][0] = t
    }
    assert names[0][0] == "2-loop-text-of-moderate-length"
}
