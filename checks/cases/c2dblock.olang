# check: run
# the instance assigned to an outer variable outlives the inner block its argument is written in - so the argument is
# built where the instance lives (inferred, QCB), and read after the block
type P struct(x I32) { x }
type NB struct(inner P&) { inner }
fn bad(c Bool) I32 {
    nb NB& = NB(P(1))
    if c {
        q P& = P(2)
        nb = NB(q)
    }
    return nb.inner.x
}
fn main() { assert bad(true) == 2 }
