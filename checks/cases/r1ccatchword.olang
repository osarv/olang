# check: fail error[R14]: the call does not fail with LE.Empty - it fails with LE.Gone
# R1c/R14: catching a word the callee's set does not hold is no more a catch than naming a type it does not
type LE error {
    Empty
    Gone
}
fn g(n I64) I64 ? LE.Gone {
    if n == 0 { error LE.Gone }
    return n
}
fn main() { x := try g(1) catch LE.Empty default 0 catch LE.Gone default 1 }
