# check: fail error[O32]: 'b' is a borrowed copy of 'a' and owns nothing, so it is not assigned
# a borrowed copy is not given another value - it would own what it was given
type Buf struct() {
    data own mut Array<I64>& = Array<I64>(2)
    n I64 = 0
}
fn grown(old Array<I64>&, cap I64) own mut Array<I64>& {
    a own mut Array<I64>& = Array<I64>(cap)
    for i in range old.Len() { a[i] = old[i] }
    return a
}
fn (b mut Buf&) add(x I64) {
    if b.n == b.data.Len() { b.data = grown(b.data, b.n * 2) }
    b.data[b.n] = x
    b.n++
}
fn (b Buf&) copy() Buf {
    c := Buf()
    for i in range b.n { c.add(b.data[i]) }
    return c
}
fn main() ? {
    a := Buf()
    b := a
    b = Buf()
}
