# check: fail error[O10c]: the callee needs one argument's scope to outlive another's, and nothing here shows it - pass them from one scope
# P1g: with several targets, each is judged as the assignment of its own result, as a single target is - here a
# reference borrowed from a local of the join block, stored into one declared before it, which outlives that block
import "std/io"
type Node struct() {
    v I64 = 0
}
fn pick(n Node&) Node&, I64 { return n, 1 }
fn main() ? {
    x Node& = Node()
    k I64 = 0
    join {
        m := Node()
        m.v = 42
        spawn x, k = pick(m)
    }
    try io.Println($x.v " " $k)
}
