# check: run
# E31b, two-phase (2026-11-03, the values study's B4): a call writing through x[i] whose other argument is a call that
# grows the collection - a number its value - has the argument evaluated first, into a local of its own, and the
# element reached after it, so the element's reference names the buffer the growth left (it was refused, the call
# staying the copy's)
fn grow(v mut Vec<Vec<I64>>&) I64 {
    v.Push(Vec<I64>())
    return 1
}
fn main() ? {
    v := Vec<Vec<I64>>()
    v.Push(Vec<I64>())
    for _ in range 50: v[0].Push(grow(v))
    assert v.Len() == 51 and v[0].Len() == 50 and v[0][49] == 1
}
