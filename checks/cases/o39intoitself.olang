# check: fail error[O39]: taking 's.top' may release the Item borrowed on line
# an owner moved into its own region: reaching the slot borrows the object, and the move lets it go (O34)
type Item struct(v I64) {
    v
    next own mut Item&
}
type Shelf struct() {
    top own mut Item&
}
fn main() ? {
    s := Shelf()
    s.top = Item(1)
    s.top.next = take s.top
}
