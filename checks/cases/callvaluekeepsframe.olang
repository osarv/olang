# check: run
# flags: -debug -sanitize
# T22c (was a T22b refusal), E31, C8: a Call adapter keeping a function value it is handed, reached through a
# helper - followed into keepVia, c outlives kp in main
import "std/io"
type Node struct(v I64) {
    v
}
type Keeper struct() {
    kept fn?&() I64 = null
}
fn (k mut Keeper&) Call(x fn&() I64) { k.kept = x }
type Ctr struct(v I64) {
    v
}
fn (c Ctr&) Call() I64 { return c.v + 1 }
fn keepVia(s fn&(x fn&() I64), g fn&() I64) { s(g) }
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn fill(c Ctr&, kp mut Keeper&) {
    keepVia(kp, c)
}
fn main() ? {
    c := Ctr(10)
    kp := Keeper()
    fill(c, kp)
    t := churn(300)
    try io.Println($kp.kept!() " " $t)
}
