# check: fail error[O36]: a function value's parameters and result never own
# a function type's parameter never owns
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn apply(f fn(c own mut Conn&) I64) I64 { return 0 }
fn main() ? { }
