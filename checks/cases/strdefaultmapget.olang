# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/R9a: the same through Map.Get's borrowed result (C1b)
import "std/io"
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type Bag struct(head mut Node&, m Map<I64, mut Node&>) {
    head
    m
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn Node.g(v I64) mut Node& { return Node(v) }
fn (b Bag&) Str() String {
    b.head.next = try b.m.Get(7) catch default Node.g(5)
    return "b"
}
fn main() ? {
    b := Bag(Node(1), Map<I64, mut Node&>())
    try io.PutLine($b)
    t := churn(100)
    w := 0 if b.head.next is null else b.head.next!.v
    try io.PutLine($w " " $t)
}
