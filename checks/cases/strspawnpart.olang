# check: run
# flags: -s
# E11c/P2: a task handed a part of the receiver, whose call builds nothing there - no stand-in is made
type Node struct(v I64, next mut Node&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&) {
    head
}
fn show(n Node&) { println($n.v) }
fn (b Bag&) Str() String {
    join { spawn show(b.head) }
    return "b"
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    println(s)
}
