# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/P2: a task handed a part of the receiver - its stand-in is made where the part lives, even for a call building
# nothing there, so it is refused (no raw scope for a task, C2/C4)
import "std/io"
type Node struct(v I64, next mut Node?&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&) {
    head
}
fn show(n Node&) { try io.Println($n.v) catch io.Error { } }
fn (b Bag&) Str() String {
    join { spawn show(b.head) }
    return "b"
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    try io.Println(s)
}
