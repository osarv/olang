# check: run
# flags: -debug -sanitize
# S21, section 8 (docs/refusals.md 5.5; refused - "this argument is storage made in one of them" - until the user's
# "Yes, do A" of 2026-11-08): a local array lent at a become is built in the chain's tail scope, where main's call
# lands - so a chain keeps what each step built, as the return form's frames do, in constant stack
fn walk(a Array<I64>&, i I64) I64 {
    if i >= 3: return a[0] * 100 + a.Len()
    b := Array<I64>(a.Len() + 1, i + 1)
    become walk(b, i + 1)
}
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}
fn main() {
    for n in range 3 {
        r := walk(Array<I64>[1, 2], n)
        churn()
        assert r == 300 + 5 - n
    }
}
