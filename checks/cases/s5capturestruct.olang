# check: fail the callee needs one argument's scope to outlive another's
# D16c/D16d: a lambda capturing a value holding references lives where they do - here the loop's block, which the list
# of functions outlives
type Reading struct(Sensor String&, Value F64) {
    Sensor
    Value
}

fn main() ? {
    fs := List<fn() I64>()
    for k in range 3 {
        t := $k "-text"
        x := Reading(t, 1.5)
        fs.Push(fn() I64 { return x.Sensor.Len() })
    }
    for f in fs { println($f()) }
}
