# check: fail error[T13d]: Node is generational - a weak reference names it - so its values are held only by reference: write 'Node&' here
# T13d: a field holding a generational value by value, in another type than the weak reference
type Node struct(v I64) {
    v
    next mut Node?& = null
    prev weak Node?& = null
}
type Holder struct() {
    n Node = Node(1)
}
fn main() { assert Holder().n.v == 1 }
