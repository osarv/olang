# check: fail error[M19g]: 'd' holds a view of 'v' taken before 'v' may have grown
# also: note: 'v' may grow here, in 'add'
# M19g: a Vec is a handle (M19d), so a by-value parameter names the caller's Vec - a body pushing to it grows it
import "std/io"
fn add(w Vec<I64>) { for i in range 100 { w.Push(i) } }
fn main() ? {
    v := Vec<I64>()
    v.Push(1)
    d := v.View()
    add(v)
    try io.Println($d[0])
}
