# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# P1g/O25b: a task's result is stored into its target as an assignment's value is - here a reference into l, which
# lives in a block r outlives. The store used to be checked for its type only
type Node struct(v I64) {
    v
}
fn keepOf(n mut Node&) mut Node& { return n }
N mut I64 = 1
fn main() ? {
    r Node?& = null
    if N > 0 {
        l mut Node& = Node(4)
        join {
            spawn r = keepOf(l)
        }
    }
    assert $r != ""
}
