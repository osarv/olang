# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# E11c/E31: a Call adapter made of a receiver part runs Call with its receiver where the part lives - a Call building there
# is refused through the adapter as it is called directly (the walk reads Call's body)
import "std/io"
type Ctr struct(v I64) {
    v
}
fn (c Ctr&) Call() I64 {
    x Ctr& = Ctr(c.v + 1)
    return x.v
}
type Bag struct(c mut Ctr&) {
    c
}
fn (b Bag&) Str() String {
    g fn() I64 = b.c
    return "b" $g()
}
fn main() ? {
    b := Bag(Ctr(2))
    try io.Println($b)
}
