# check: fail error[C2d]
# C2d/E11a: a value built only to be rendered is checked where it is built, as any other - here its field's
# destructor stores into a node outliving it
type Node struct(v I64, next mut Node&) {
    v
    next
}
type Res struct(a mut Node&) {
    a
} destruct { a.next = Node(9, null) }
type Wrap struct(a mut Node&) {
    a
    r Res& = Res(a)
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn f(x mut Node&) I64 {
    s := $Wrap(x)
    return s.Len()
}
fn main() ? {
    n := Node(1, null)
    k := f(n)
    churn()
    println($k)
    println($n.next.v)
}
