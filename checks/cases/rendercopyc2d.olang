# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# C2d/E11a: a value built only to be rendered is checked where it is built, as any other - here its field's
# destructor stores into a node outliving it
import "std/io"
type Node struct(v I64, next mut Node?&) {
    v
    next
}
type Res unique struct(a mut Node&) {
    a
} destruct { a.next = Node(9, null) }
type Wrap struct(a mut Node&) {
    a
    r Res& = Res(a)
}
fn churn() I64 {
    t I64 = 0
    for _ in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn f(x mut Node&) I64 {
    s := $Wrap(x)
    return s.Len()
}
fn main() ? {
    n := Node(1, null)
    k := f(n)
    churn()
    try io.PutLine($k)
    try io.PutLine($n.next!.v)
}
