# check: fail error[E20]: [] makes the type expected where it stands, and nothing is expected here
# E20: a literal with no type before it makes the type expected where it stands, or its own - an empty one has none
# (a comprehension with no type takes its element's own: tests/barelits.olang)
fn main() {
    a := []
    assert a.Len() == 0
}
