# check: fail error[O38]: this argument borrows an own object, and the callee may keep it beyond the call
# O38 (own6 N1): one of several results of a method called on a borrowed copy (O32) holds what the copy reads - a List
# does not keep it
import "std/io"
type Inner struct(k I64) {
    k
}
type Outer struct() {
    o own mut Inner&
}
type View struct(x Outer&) {
    x
}
fn (a Outer&) Two() (View&a, I64) { return View(a), 1 }
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    b := v
    l := List<View>()
    a, n := b.Two()
    l.Push(a)
    try io.Println($l.Len() " " $n)
}
