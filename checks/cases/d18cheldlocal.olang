# check: run
# flags: -debug -sanitize
# D18c, O27 as placement: a generator held in a local, walked twice - its kept elements live where it does, and the list
# outliving the inner block has it built where the list lives (it was O10c's error); read back after a churn
fn labels(n I64) Iterator<String&> {
    for i in range n {
        s String& = $"label " $i
        yield s
    }
}

import "std/io"
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}
fn main() {
    kept := Vec<String&>()
    {
        g := labels(2)
        for w in g { kept.Push(w) }
        for w in g { kept.Push(w) }
    }
    churn()
    io.Println($kept)!
}
