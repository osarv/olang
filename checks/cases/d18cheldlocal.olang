# check: fail error[O10c]: the callee needs one argument's scope to outlive another's, and nothing here shows it - pass them from one scope
# D18c: a generator held in a local, walked twice - its kept elements live where it does, in the inner block
fn labels(n I64) Iterator<String&return> {
    for i in range n {
        s String&return = $"label " $i
        yield s
    }
}

fn main() {
    kept := Vec<String&>()
    {
        g := labels(2)
        for w in g { kept.Push(w) }
        for w in g { kept.Push(w) }
    }
}
