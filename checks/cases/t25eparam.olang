# check: fail error[T25e]: 'own' is written on a field's, a local's or a global's type, or a declared function's parameter or result - here it is not supported yet
# a constructor's parameter does not own yet
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
type Wrap struct(c own mut Conn&) {
    c
}
fn main() ? { }
