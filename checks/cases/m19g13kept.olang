# check: fail error[M19g]: 'l' holds a view of 'v' taken before 'v' may have grown
# M19g: a view kept by a call in another of its arguments - "l.Push(v.View())" stores it in l - so l holds it
import "std/io"
fn main() ? {
    v := Vec<Char>()
    v.Push('a')
    l := Vec<Array<Char>&>()
    l.Push(v.View())
    for _ in range 100 { v.Push('b') }
    try io.PutLine($l[0])
}
