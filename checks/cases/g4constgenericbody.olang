# check: fail error[G4, G24]: constant variable N appears in no parameter's type
# also: compilation failed with 2 errors
# never: error[G21]
# G4: a generic function whose constant variable no call can give a value is reported once, at its declaration - its
# body is not checked, in the generic or in any instantiation, and its calls report nothing more
import "std/io"
fn mk<N>() Array<I64, N> {
    a Array<I64, N>
    return a
}
fn mk2<T, N I64>(x T) Array<T, N> {
    a Array<T, N>
    return a
}
fn main() ? {
    a := mk()
    b := mk2(3)
    try io.Println($a.Len() " " $b.Len())
}
