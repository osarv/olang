# check: fail error[L9a]: 'done' is a keyword, not a name - a field named by one is reached only after '.'
# L9a: a keyword may name a field - "done I64 = 0" - which is then reached after "." alone: in its constructor's body it
# is no name, so a later field reading it by the keyword is an error saying so
type Task struct() {
    done Bool = false
    left := done
}
fn main() ? { }
