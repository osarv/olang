# check: run
# flags: -debug -sanitize
# T22a, open point 5, O27 as placement: through a function value, a reference argument outlives where the result lands -
# exactly where something is stored through both: a loop turn's text given beside a list the result is, then pushed
# into it, is built where the list lives, as called by name (it was O10c's error); read back after a churn
import "std/io"
fn pick(a mut Vec<String&>&, b String&) mut Vec<String&>& { return a }
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}
fn main() {
    g := pick
    v Vec<String&>
    for i in range 3 {
        t := $i
        w := g(v, t)
        w.Push(t)
    }
    churn()
    io.PutLine($v)!
}
