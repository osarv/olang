# check: fail error[E6d]: this literal does not fit U64, and U64 does not flow into I64
# E4a/E6d: beside an operand whose type cannot hold all its values, a conditional of literals meets it at its own type,
# as one literal does - and a U64 does not flow into an I64, so they do not meet
C mut Bool = true

fn main() ? {
    u U64 = 5
    v := u - (-1 if C else 1)
    println($v)
}
