# check: fail error[O39]: calling 'reset' may release the Array<I64> borrowed on line 12, which is used after it
# Vec phase 2a (O35/O39): a method giving the field another Vec releases the old one's buffer
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn (l mut Lexer&) reset() { l.toks = Vec<I64>() }
fn main() ? {
    l := Lexer(3)
    for i in range 3 { l.toks.Push(i) }
    d := l.toks.View()
    l.reset()
    try io.Println($d[0])
}
