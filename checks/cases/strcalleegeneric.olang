# check: run
# flags: -s
# E11c/D16c: a lambda over the receiver's parts, in a generic function and in a trait's default, held in a local that is
# only ever called - its environment is in the frame, so nothing is built where the parts live
type Sized trait {
    Len() I64
}
fn (x <T Sized>&) Twice() I64 {
    f := fn() I64 { return x.Len() * 2 }
    return f()
}
fn count(xs Array<<T>>&) I64 {
    f := fn() I64 { return xs.Len() }
    return f()
}
type Box struct(n I64) {
    n
}
fn (b Box&) Len() I64 { return b.n }
type Bag struct(arr Array<I64>&, box Box&) {
    arr
    box
}
fn (b Bag&) Str() String {
    return $count(b.arr) " " $b.box.Twice()
}
fn main() ? {
    println($Bag(I64[1, 2, 3], Box(5)))
}
