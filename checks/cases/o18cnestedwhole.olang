# check: run
# flags: -debug -sanitize
# O18c/O17b (F3): "e := ll[0][0]; e.S.Push(x)"
import "std/io"
type Blk struct() {
    S Vec<I64>
    t I64 = 0
}
fn churn() ? io.Error {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { try io.Println("x") }
    }
}
fn add(ll mut Vec<Vec<Blk>>&, x I64) {
    e := ll[0][0]
    e.S.Push(x)
}
fn main() ? {
    ll := Vec<Vec<Blk>>()
    ll.Push(Vec<Blk>())
    ll[0].Push(Blk())
    add(ll, 7)
    try churn()
    assert ll[0][0].S.Len() == 1 and ll[0][0].S[0] == 7, $ll[0][0].S
}
