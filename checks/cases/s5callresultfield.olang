# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O18c/O20: a reference read out of a call's value result leads where that result's references are - here the text the
# loop's block holds - so it cannot be kept in a list the loop's block does not outlive
import "std/io"
type Box struct(s String&) { s }
fn box(s String&) Box { return Box(s) }

fn main() ? {
    ss := Vec<String&>()
    for k in range 4 {
        t := $k "-text"
        ss.Push(box(t).s)
    }
    for s in ss { try io.Println(s) }
}
