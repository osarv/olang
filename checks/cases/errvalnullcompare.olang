# check: fail error[E10c]: null is tested with 'is', never compared - write 'e is null'
# also: error[E10c]: null is tested with 'is', never compared - write 'e is not null'
# T20, E10c: an error value holding no error is tested with 'is null', the one null test - never compared with null
type PErr error { BAD }
fn main() {
    e PErr = null
    a := e == null
    b := e != null
    c := e is null
}
