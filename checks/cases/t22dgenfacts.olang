# check: run
# T22d, G42: a for-in over a generator calls through Generator's fixed field "next" - its walk, made by the generator,
# whose facts the caller has: so the caller never blocks and starts no task (S17a), where a call through the field's
# type alone would say anything
fn count(n I64) Iterator<I64> {
    for i in range n { yield i }
}

fn total() I64 {
    t I64 = 0
    for x in count(5) { t += x }
    return t
}

fn lazy(xs Array<I64>&) I64 {
    t I64 = 0
    for x in xs.Iter().TakeWhile(fn(x) { return x < 3 }) { t += x }
    return t
}

assert not total.Blocks and not total.Spawns and not lazy.Blocks and not lazy.CallsC

fn main() {
    assert total() == 10
    assert lazy(Array<I64>[1, 2, 3, 4]) == 3
}
