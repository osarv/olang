# check: run
# S12b: a match statement's clause is a block or one statement after a ':' - its expression running on as a statement's
# does
type Tok enum {
    Num
    Str
}
fn one(t Tok) I32 { return 1 }
fn b(t Tok) I32 {
    n I32 = 0
    match t {
        case Tok.Num: return one(t) +
            one(t)
        case _: n++
    }
    return n
}
fn main() ? {
    assert b(Tok.Num) == 2 and b(Tok.Str) == 1
}
