# check: fail error[O41]: assigning 's.cur' may release the Node the task spawned on line
# a task's clause, run on its thread, borrowing while the spawner releases
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn look(n Node&) { try io.Println(n.name) catch io.IoError { } }
fn fails(h Holder&) ? { if h.cur == null { error } }
fn main() ? {
    s mut Holder& = Holder()
    s.cur = Node(1)
    join {
        spawn try fails(s) catch { look(s.cur) }
        s.cur = null
    }
}
