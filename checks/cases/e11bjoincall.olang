# check: fail error[E11b]: '(' after a piece of text calls it - to join the value inside, write '$(...)'
# never: is not a function
# never: this function returns
# E11b: a parenthesized value after a piece of a join is a call of the piece, never what was meant
import "std/io"
fn a(tried Bool, op String&) String { return "(" $op (" try" if tried else "") }
fn b(negated Bool) String { return "(is" (" not " if negated else " ") }
fn main() ? {
    io.Println($a(true, "=") $b(false))
}
