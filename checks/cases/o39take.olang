# check: fail error[O39]: taking 's.cur' moves the Conn borrowed on line
# 'take' moves the object to an owner that may let it go - a borrow of it used after is refused
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn main() ? {
    s := Server()
    s.cur = Conn(3)
    c := s.cur
    d := take s.cur
    try io.Println(c.name)
    try io.Println(d.name)
}
