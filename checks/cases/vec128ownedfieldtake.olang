# check: fail error[O34]: the owner refers to what lives shorter than the slot it is moved into
# Vec phase 2a review R1 (O33): a Vec field of an owned object keeps what its elements refer to in that object's region -
# moved into another owned object's field, it would outlive the region 'p.lx = null' frees
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    p := Parser()
    p.lx = Lexer()
    for i in range 3 { p.lx.toks.Push($i "-word-built-in-the-lexer's-region") }
    d := Parser()
    d.lx = Lexer()
    d.lx.toks = take p.lx.toks
    p.lx = null
    churn()
    println(d.lx.toks[0])
}
