# check: fail error[T13b]: Vec<Conn> is unique
# C11, T13b: a Vec of values with destructors is unique, as they are - never copied
Closed mut I64 = 0
type Conn unique struct(fd I32) {
    fd
} destruct { Closed++ }
fn main() {
    v Vec<Conn> = Vec<Conn>()
    v.Push(Conn(3))
    c Vec<Conn> = v
    assert c.Len() == 1
}
