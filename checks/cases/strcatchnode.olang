# check: fail error[E11c, O12]: '$' does not say where a value it renders lives, so Str builds and stores nothing where its receiver reaches
# E11c/O12: a catch default for a call borrowing from the receiver, built where the call's result lives (R9a): refused
type Node struct(v I64, next Node&) {
    v
    next
}
type Bag struct(head Node&) {
    head
}
fn find(n Node&, k I64) Node&n ? {
    for c := n, c != null, c = c.next { if c.v == k { return c } }
    error
}
fn (b Bag&) Str() String {
    x := try find(b.head, 9) catch default Node(0, null)
    return $x.v
}
fn main() ? {
    println($Bag(Node(1, Node(5, null))))
}
