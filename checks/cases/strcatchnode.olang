# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/O12: a catch default for a call borrowing from the receiver, built where the call's result lives (R9a): refused
import "std/io"
type Stop error {
    Here
}
type Node struct(v I64, next Node?&) {
    v
    next
}
type Bag struct(head Node&) {
    head
}
fn find(n Node&, k I64) Node& ? {
    for c Node?& = n, c is not null, c = c.next { if c.v == k { return c } }
    error Stop.Here
}
fn (b Bag&) Str() String {
    x := try find(b.head, 9) catch default Node(0, null)
    return $x.v
}
fn main() ? {
    try io.PutLine($Bag(Node(1, Node(5, null))))
}
