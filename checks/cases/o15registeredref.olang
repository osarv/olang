# check: fail error[O15, O16]: 'g' holds a value where its call landed, ended as that scope closes - after 'l'
# also: declare it by value, 'g Grip = ...', and its block ends it first
# O15, O16: a reference local written for a call's value with a destructor stands for a value registered with its scope,
# ended as that scope closes - after the block's variables, one of which it may hold (the ':=' form is a holder, call 8)
type Tally struct() {
    n I64 = 0
}

type Lamp unique struct(id I64, log mut Tally&) {
    id, log
    alive := true
} destruct {
    log.n += id
    alive = false
}

type Grip unique struct(id I64) {
    id
    held Lamp?& = null
} destruct {
    if held is not null {
        assert held!.alive, "a Grip read its Lamp ended"
        held!.log.n += held!.id * 10
    }
}

fn run(t mut Tally&) {
    l Lamp = Lamp(10, t)
    {
        g Grip& = Grip(9)
        g.held = l
    }
    assert t.n == 100
}

fn main() ? {
    t := Tally()
    run(t)
    assert t.n == 110
}
