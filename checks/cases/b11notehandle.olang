# check: fail error[O10c]: the callee needs one argument's scope to outlive another's
# also: declare it where 'l' lives: 't mut String&l = ...'
# B11: a Vec taken in place out of a map (RefMut, a reference into the map's storage, QCE) is where what is pushed onto it
# must outlive - "&l" names where l's referent lives, the map's (checks/cases/b11notehandlefix.olang builds the fix, and
# "&l" builds too; before Vec was a value the handle was copied out, and "&l" named its slot in the loop's block)
fn main() ? {
    m := Map<I64, Vec<String&>>()
    m.Put(0, Vec<String&>())
    m.Put(1, Vec<String&>())
    for i in range 3 {
        l := try m.RefMut(i % 2)
        t := "x" $i
        l.Push(t)
    }
}
