# check: fail error[D18c, S20]: this generator's elements live where the generator does, and this value is not shown to last as long - yield a part of what lives there, or values ('Iterator<T>') and a copy ('$x', 'x.Clone()')
# D18c: an element kept by the walk lives where the generator does - not in a block of the generator's body,
# closed as the walk goes on
fn texts(n I64) Iterator<String&return> {
    for i in range n {
        s := $i
        yield s
    }
}

fn main() {
    for x in texts(2) { }
}
