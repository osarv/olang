# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# D18c: an element kept by the walk lives where the generator does - not in a block of the generator's body,
# closed as the walk goes on
fn texts(n I64) Iterator<String&> {
    for i in range n {
        s := $i
        yield s
    }
}

fn main() {
    for _ in texts(2) { }
}
