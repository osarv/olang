# check: fail a guarantee reads 'a' at entry through what the call may write
# D17b: a part of a guarantee holding references is read at return, so one reaching what the call writes is an error
fn same(x Array<I64>&, y Array<I64>&) Bool { return x == y }

fn fill(a mut Array<I64>&) [same(return a, a)] { a[0] = 1 }

fn main() {
    a := Array<I64>(3)
    fill(a)
}
