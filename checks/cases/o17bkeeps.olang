# check: run
# R1 (refusals 5.1): compiles now - a split value lent where its references live, its own storage lifted there where
# the callee keeps it (O17b generalized); it was refused, as what follows says
# O17b: a handle is lent as its reference only to a callee using it only through it - one storing a reference to the
# handle's own storage into what it reaches (a back link), or handing it out, is judged as any split lend is
type St struct() {
    x I64 = 0
    back mut H?& = null
}
type H struct() { s mut St& = St() }
fn (h mut H&) backlink() { h.s.back = h }
fn main() ? {
    m := Map<I64, H>()
    m.Put(1, H())
    for _ in range 3 {
        c := try m.Get(1)
        c.backlink()
    }
}
