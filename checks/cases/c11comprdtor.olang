# check: fail error[C11]: R has a destructor to run, and Array<R> keeps values of it where no holder ends them - write R&, or keep them in a Vec<R>
# C11: a comprehension of a run-time length makes values with destructors no holder ends (found 2026-11-07: they were
# made and never ended; a count known while compiling makes a fixed array, which ends them)
Ended mut I64 = 0
type R unique struct(id I64) {
    id
} destruct { Ended++ }
fn mk(n I64) I64 {
    xs := Array<R>[R(i) for i in range n]
    return xs.Len()
}
fn main() { assert mk(3) == 3 }
