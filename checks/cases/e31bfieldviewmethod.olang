# check: run
# E31b/O17 (F1): as e31bfieldviewbuild, the view a method on the field, "l[0].w.Build(v)" - made on the element's field
# in place through RefMut since 2026-11-03 (two-phase, the values study's B4), so what Build makes lands where the
# element's reference reaches, as "l.RefMut(0).w.Build(v)" written out does (it was refused, the call the copy's)
import "std/io"
type Node struct(v I64, next mut Node?&) {
    v
    next
}
type In struct(r mut Node&, k I64) {
    r
    k
}
type M struct(r mut Node&, off I64) {
    r
    off
    inner In = In(Node(0, null), 0)
}
type Layer struct(w M, n I64) {
    w
    n
}
fn churn() ? io.Error {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { try io.Println("x") }
    }
}
fn (m mut M&) Build(v I64) { m.r.next = Node(v, null) }
fn add(l mut Vec<Layer>&, v I64) { l[0].w.Build(v) }
fn main() ? {
    l := Vec<Layer>()
    l.Push(Layer(M(Node(1, null), 0), 0))
    add(l, 12)
    try churn()
    try io.Println($l[0].w.r.next!.v)
}
