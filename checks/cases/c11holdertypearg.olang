# check: fail error[C11]: Pool has a destructor to run, and Buf<Pool> keeps values of it where no holder ends them - write Pool&, or keep them in a Vec<Pool>
# C11: a holder of a value with a destructor by value has its destructor to run too - an array of a run-time length a
# type of the program's holds says nothing of which elements are live, so nothing would end them (a Vec<Pool> does)
Closed mut I64 = 0
type Conn unique struct(fd I32) {
    fd
} destruct { Closed++ }
type Pool struct(c Conn) { c }
type Buf<T> struct() {
    a Array<T>
}
fn main() {
    v := Buf<Pool>()
    assert v.a.Len() == 0
}
