# check: fail error[O39]: calling 'mv' may release the Node borrowed on line
# a call moving an object out from below its argument, while a borrow of it is in use
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn mv(h mut Holder&) { h.other = take h.cur }
fn main() ? {
    o own mut Holder& = Holder()
    o.cur = Node(1)
    c := o.cur
    mv(o)
    o.other = null
    io.Println(c.name)
}
