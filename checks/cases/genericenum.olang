# check: run
# G6b: an enum may be generic (once, section 12 said it never was) - its case written bare takes the instance it lands in
type Opt<T> enum {
  None
  Some(v T)
}
fn show(o Opt<I32>) I32 {
  match o {
    case Opt.Some(v) { return v }
    case _ { return 0 }
  }
}
fn main() ? {
  n := show(Opt.None)
  assert n == 0 and show(Opt.Some(4)) == 4
}
