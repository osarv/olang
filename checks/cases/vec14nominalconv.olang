# check: fail error[O39]: calling 'Push' may release the Array<I64> borrowed on line 13
# vec1 F1: as vec13, with a program's own declared array type and an explicit conversion
fn churn() I64 {
    t := 0
    for i in range 2000 { s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len() }
    return t
}
fn id(a Array<I64>&) Array<I64>&a { return a }
type Ix Array<I64>
fn f(v Vec<I64>&) Ix&v { return Ix(v.View()) }
fn grow(w mut Vec<I64>&) {
    d := f(w)
    for i in range 1000 { w.Push(i + 100) }
    churn()
    println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(1)
    v.Push(2)
    grow(v)
}
