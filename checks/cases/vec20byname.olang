# check: fail error[T22a]: 'first' relates its arguments' scopes, which a call through a function value cannot check - call it directly
# what stays legal: a borrowed result handing back a Vec's view, called by name and used before the Vec grows, whether
# its type is the buffer's or a declared array type converted from it; a conversion copied into a value (a typed value
# declaration - ':=' declares the reference the conversion names, T29a) is the copy's own; a function giving a plain
# borrowed result is still a value
import "std/io"
type Ix Array<I64>
fn view(v Vec<I64>&) Array<I64>& { return v.View() }
fn asIx(v Vec<I64>&) Ix& { return Ix(v.View()) }
fn asText(v Vec<Char>&) String& { return String(v.View()) }
fn first(a Array<I64>&) Array<I64>& { return a[:1] }
type CB struct() {
    data mut Array<Char>& = Array<Char>(2, 'x')
}
fn (c CB&) Text() String& { return String(c.data) }
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    d := view(v)
    x := asIx(v)
    assert d[1] == 20 and x[0] == 10
    v.Push(30)
    t := Vec<Char>()
    t.Push('h')
    t.Push('i')
    s := asText(t)
    assert s == "hi"
    copied String = String(t.View())
    t.Push('!')
    assert copied == "hi" and t.Len() == 3
    c := CB()
    assert c.Text() == "xx"
    f := first
    a := I64[4, 5]
    assert f(a)[0] == 4
    try io.Println("ok")
}
