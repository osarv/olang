# check: run
# vec1 review: what stays legal - a borrowed own result called by name, used before the owner changes, whether its type is
# the buffer's or a declared array type converted from it; a conversion copied into a value is the copy's own; a function
# giving a plain borrowed result is still a value
type Ix Array<I64>
fn view(v Vec<I64>&) Array<I64>&v { return v.View() }
fn asIx(v Vec<I64>&) Ix&v { return Ix(v.View()) }
fn asText(v Vec<Char>&) String&v { return String(v.View()) }
fn first(a Array<I64>&) Array<I64>&a { return a[:1] }
type CB struct() {
    data own mut Array<Char>& = Array<Char>(2, 'x')
}
fn (c CB&) Text() String&c { return String(c.data) }
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    d := view(v)
    x := asIx(v)
    assert d[1] == 20 and x[0] == 10
    v.Push(30)
    t := Vec<Char>()
    t.Push('h')
    t.Push('i')
    s := asText(t)
    assert s == "hi"
    copied := String(t.View())
    t.Push('!')
    assert copied == "hi" and t.Len() == 3
    c := CB()
    assert c.Text() == "xx"
    f := first
    a := I64[4, 5]
    assert f(a)[0] == 4
    println("ok")
}
