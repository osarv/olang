# check: fail error[S17]: an error may not leave an unreachable's message - catch it here
# S16d: an unreachable's message may not leave, as an assert's may not
type E error {
    BAD
}
fn h(k I64) I64 ? E {
    if k > 0 { error E.BAD }
    return k
}
fn f(k I64) I64 ? E {
    if k > 100 { unreachable $(try h(k)) }
    return 3
}
fn main() ? E {
    assert (try f(1)) == 3
}
