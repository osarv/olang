# check: fail error[S19b]: deferred code may not return
# S19b, S19e: an errdefer's code runs while its block is being left by an error, so it may not return
type E error { BAD }
fn f(n I32) I32 ? E {
    errdefer {
        if n > 1 { return 3 }
    }
    if n > 0 { error E.BAD }
    return n
}
fn main() ? { assert (try f(0) catch default -1) == 0 }
