# check: fail error[O33]: this value would be built where the object of 's.cur' lives, which a later argument reads
# a region is known once the borrow naming it is read, so nothing is built into it by an argument before that borrow
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Hold struct(v I64) {
    v
    n mut Node& = Node(v)
}
type Holder struct() {
    cur own mut Hold&
}
fn setN(x mut Node&, h mut Hold&) { h.n = x }
fn main() ? {
    s := Holder()
    s.cur = Hold(1)
    setN(Node(9), s.cur)
}
