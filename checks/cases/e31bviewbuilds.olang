# check: fail x[i] gives a copy, and the call can build into what it holds where the copy is
# E31b/O17: x[i] lent to a callee that writes only through the element's references, with no write-back - but the
# callee builds text and pushes it through the copy's List, which would build it where the copy is (the statement's
# block), not where the collection's list lives
type R struct(l mut List<String&>&, n I64) {
    l
    n
}
type Rs struct(l mut List<String&>&) {
    l
}
fn (s Rs&) At(i I64) R { return R(s.l, i) }
fn f(r mut R&) { r.l.Push($r.n) }

fn main() ? {
    s := Rs(List<String&>())
    for k in range 3 { f(s[k]) }
    println($s.l)
}
