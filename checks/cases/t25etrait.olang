# check: fail error[T25e]: 'own' is written on a field's
# a trait method's parameter does not own yet
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
type Eater trait {
    Eat(c own mut Conn&) I64
}
fn main() ? { }
