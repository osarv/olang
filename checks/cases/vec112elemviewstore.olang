# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O20: an element's field written through a view keeps what lives where the Vec does - not a
# loop turn's text
import "std/io"
type Tok struct(text String&, line I64) {
    text
    line
}
fn main() ? {
    v := Vec<Tok>()
    v.Push(Tok("a", 1))
    for i in range 3 {
        t := "w" $i
        m := v.ViewMut()
        m[0].text = t
    }
    try io.Println($v[0].text)
}
