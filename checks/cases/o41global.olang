# check: fail error[O41]: assigning 'G.cur' may release the Node the task spawned on line
# a task borrowing through a global while the spawner releases it
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
G := Holder()
fn work() {
    c := G.cur
    try io.Println(c.name) catch io.IoError { }
}
fn main() ? {
    G.cur = Node(1)
    join {
        spawn work()
        G.cur = null
    }
}
