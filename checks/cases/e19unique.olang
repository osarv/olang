# check: fail error[E19, T13b]: a literal or comprehension of Vec<Tok>
# also: error[E19, T13b]: a literal or comprehension of Map<I64, Tok>
# never: needs a copy
# E19, T13b (bulk review 8): a collection made through FromIter has no literal of unique values - said at the literal,
# naming Push and Put, not as a copy inside the prelude's FromIter; an array's literal is laid out and has one
type Tok unique struct(id I64) { id }

fn main() {
    a := Array<Tok>[Tok(1), Tok(2)]
    v := Vec<Tok>[Tok(3), Tok(4)]
    m := Map<I64, Tok>[1: Tok(5)]
    w := Vec<Tok>()
    w.Push(Tok(6))
    assert a[1].id + v.Len() + m.Len() + w.Len() > 0
}
