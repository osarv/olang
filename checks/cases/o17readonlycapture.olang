# check: run
# R1 (refusals 5.1): compiles now - a split value lent where its references live, its own storage lifted there where
# the callee keeps it (O17b generalized); it was refused, as what follows says
# O17/D16c: a lambda storing through a read-only capture's writable field stores into the region it was lent - so a copy
# whose references live elsewhere than its storage may not be lent to the method making it (read back as -7)
import "std/io"
type Node struct(v I64, next mut Node?&) {
    v
    next
}
type Box struct(n I64) {
    head mut Node& = Node(n, null)
}
type W struct(b Box) {
    b
}
fn (b Box&) grow() {
    f := fn() { b.head.next = Node(7, null) }
    f()
}
fn bump(src mut W&) {
    b := src.b
    b.grow()
}
fn churn() I64 {
    t I64 = 0
    for _ in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn main() ? {
    w := W(Box(3))
    bump(w)
    churn()
    try io.Println($w.b.head.next!.v)
}
