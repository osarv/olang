# check: fail error[O39]: taking 'x' moves the Node borrowed on line
# an owner local taken out of a slot and handed on to another owner, while borrowed
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn main() ? {
    o1 own mut Holder& = Holder()
    o1.cur = Node(1)
    x := take o1.cur
    c := x
    o2 own mut Holder& = Holder()
    o2.cur = take x
    o2.cur = null
    println(c.name)
}
