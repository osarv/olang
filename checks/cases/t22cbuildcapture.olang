# check: fail error[T22c]: the function given for this call's callee keeps this argument in what it captured, where this call cannot build - make the argument in the caller and pass it in
# also: note: the functions given here followed into it (T22c)
# T22c: a function value followed into a callee keeps what it is given in what it captured (an adapter's instance) -
# a temporary the callee makes for it would have to be built where that capture lives, which the callee is not told
type N struct(v I64) {
    v
}
type Keeper struct() {
    kept Vec<N&>
}
fn (k mut Keeper&) Call(n N&) { k.kept.Push(n) }
fn feed(s fn&(n N&), base I64) {
    for i in range 3 { s(N(base + i)) }
}
fn main() {
    k := Keeper()
    feed(k, 20)
    assert k.kept.Len() == 3
}
