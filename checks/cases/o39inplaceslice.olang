# check: fail error[O39]: assigning 'h.cur' may release the In3 borrowed on line 11
# O39 (own7 F1): a slice of an owned object's inline array, kept in a local, borrows the object
type In3 struct(k I64) {
    data Array<I64, 8> = Array<I64, 8>()
}
type H3 struct() {
    cur own mut In3&
}
fn sl(h mut H3&) I64 {
    h.cur = In3(1)
    s := h.cur.data[0:8]
    h.cur = null
    return s[0]
}
fn main() ? {
    h mut H3& = H3()
    println($sl(h))
}
