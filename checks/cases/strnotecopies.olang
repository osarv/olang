# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# B11/E11c: the note for a list in a Str that cannot hold references to the receiver's nodes does not suggest declaring it
# where they live, which a Str cannot do
import "std/io"
type Node struct(v I64, next mut Node?&) {
    v
    next
}
type Bag struct(head mut Node&) {
    head
}
fn (b Bag&) Str() String {
    l := Vec<Node&>()
    for n Node?& = b.head, n is not null, n = n.next { l.Push(n) }
    return $l.Len() " " $l[0].v
}
fn main() ? {
    b := Bag(Node(1, Node(2, null)))
    try io.Println($b)
}
