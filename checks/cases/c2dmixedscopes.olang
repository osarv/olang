# check: fail error[C2d]: this instance holds a reference to an argument it would outlive
# C2d/O25e: a context struct whose writable field can be written through (diag) and whose other field refers to a Vec
# the instance holds - built again in an inner block from that block's sink, it would outlive what it holds there
import "std/io"
Run mut I64 = 1
type Diag struct() {
    col I64 = 0
}
type Ctx struct(diag mut Diag&, nums Vec<I64>&) {
    diag
    nums
}
fn check() I64 {
    nums := Vec<I64>()
    nums.Push(4)
    c := Ctx(Diag(), nums)
    if Run > 0 {
        d := Diag()
        c = Ctx(d, nums)
    }
    return c.nums.Len()
}
fn main() ? { try io.Println($check()) }
