# check: run
# E31b (F1): the callee moves element 0 to slot 1 and puts a new element in slot 0, then writes "its" element through
# the view - from a List the copy follows the moved element (slot 1), from an Array the view is slot 0
type V struct(d mut Array<I64>&, n I64) {
    d
    n
}
fn (v mut V&) Mark(l mut List<V>&) {
    l[1] = l[0]
    l[0] = V(Array<I64>(1), 0)
    v.d[0] = 99
}
fn (v mut V&) MarkA(a mut Array<V>&) {
    a[1] = a[0]
    a[0] = V(Array<I64>(1), 0)
    v.d[0] = 99
}
fn main() ? {
    l := List<V>()
    l.Push(V(Array<I64>(1), 0))
    l.Push(V(Array<I64>(1), 0))
    l[0].Mark(l)
    assert l[0].d[0] == 0 and l[1].d[0] == 99, "list " $l[0].d[0] " " $l[1].d[0]
    a := V[V(Array<I64>(1), 0), V(Array<I64>(1), 0)]
    a[0].MarkA(a)
    assert a[0].d[0] == 99 and a[1].d[0] == 0, "array " $a[0].d[0] " " $a[1].d[0]
}
