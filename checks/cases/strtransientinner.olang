# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/D16c: a capturing lambda handed to a callee keeping nothing of it makes, in its own body, a closure living
# where its capture does - the receiver's - which the walk of that body sees (the transient flag is the call's, C5)
import "std/io"
type Node struct(v I64) {
    v
}
type Bag struct(head Node&) {
    head
}
fn apply(f fn&() I64) I64 { return f() }
fn (b Bag&) Str() String {
    n := apply(fn() I64 {
        h := fn() I64 { return b.head.v }
        t := h == h
        return h() if t else 0
    })
    return "b" $n
}
fn main() ? {
    try io.Println($Bag(Node(4)))
}
