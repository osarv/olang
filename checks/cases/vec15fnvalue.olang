# check: fail error[O37]: 'view' gives a borrowed own result, so it is called by name only
# vec1 F2: a borrowed own result's loan is made by a call by name - such a function is never a value
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn view(v Vec<I64>&) Array<I64>&v { return v.View() }
fn grow(w mut Vec<I64>&) {
    f := view            # view as a function value
    d := f(w)            # borrowed own result through a function value - no loan is made
    for i in range 1000 { w.Push(i + 100) }   # frees the buffer; NOT refused
    churn()
    io.Println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    grow(v)
}
