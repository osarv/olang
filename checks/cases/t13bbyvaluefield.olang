# check: fail error[T13b]: File is unique: this value is held elsewhere, and a field holds one of its own
# T13b: a field typed with the value's type, stored an existing value
type File unique struct(fd I32) { fd }
type Box struct() {
    f File = File(0)
}
fn main() {
    b := Box()
    f := File(3)
    b.f = f
    assert b.f.fd == 3
}
