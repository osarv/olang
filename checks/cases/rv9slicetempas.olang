# check: run
# flags: -debug -sanitize
# E16a, O27 as placement: a payload read with "as" from an enum held by value is a copy made where it is read - a
# temporary - and a slice of it kept in a parameter's field has it built where the field lives (it was O20's error;
# once accepted unsoundly, h.r read a dead frame: 0 where 8 was right); read back after a churn
import "std/io"
type Q struct() { a := Array<I64>(4) }
type E enum {
    C(q Q)
    D
}
type H struct(k I64) {
    k
    r Array<I64>& = Array<I64>(0)
}
fn E.mkE(n I64) E {
    q := Q()
    q.a[1] = n + 1
    return E.C(q)
}
fn set(h mut H&, n I64) {
    h.r = (E.mkE(n) as E.C)!.a[0:2]
}
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}
fn main() ? {
    h mut H& = H(1)
    set(h, 7)
    churn()
    try io.PutLine($h.r[1])
}
