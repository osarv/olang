# check: fail error[O31]: Server owns objects - a field of it is 'own' - so only a local, a field, a global or a result holds one by value
# an owning type is held by value as a local, a field, a global or a result - an element or a type argument holds a
# reference, owning or not (a copy of the element would be a second owner of what it owns)
# also: Array<Server>
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
type Shop struct() {
    s Server
    xs Array<Server>& = null
}
fn main() ? {
    h := Shop()
}
