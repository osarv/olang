# check: fail error[O31]: 
# an owning type is held only by reference
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn main() ? {
    s Server = Server()
}
