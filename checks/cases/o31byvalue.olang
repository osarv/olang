# check: fail error[O31]: 
# an owning type is held by value only as a local or a result - a field holds a reference, owning or not
# also: only a local or a result holds one by value
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
type Shop struct() {
    s Server
}
fn main() ? {
    h := Shop()
}
