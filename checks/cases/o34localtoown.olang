# check: fail error[O34]: moving out of 'x' would leave it empty - write 'take x'
# an owner local passed for an owning parameter without take
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn consume(c own mut Conn&) I64 { return c.fd }
fn main() ? {
    x own mut Conn& = Conn(3)
    io.Println($consume(x))
}
