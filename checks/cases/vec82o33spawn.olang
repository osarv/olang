# check: fail error[O33]: this value would be built where the object of 's.cur' lives, which a later argument reads
# vec5 (o33_order_spawned_call): O33's order check runs for a spawned call too
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Hold struct(v I64) {
    v
    n mut Node& = Node(v)
}
type Holder struct() {
    cur own mut Hold&
}
fn setN(x mut Node&, h mut Hold&) { h.n = x }
fn main() ? {
    s := Holder()
    for i in range 3 {
        s.cur = Hold(i)
        join { spawn setN(Node(9 + i), s.cur) }
        churn()
        println($s.cur.n.v)
    }
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
