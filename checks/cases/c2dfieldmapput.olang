# check: run
# flags: -debug -sanitize
# C2d, O15 (review A): a ":=" field holding a Map of values with destructors - a Put over a key ends the value it
# replaces, read back after the arena churned. (Until 2026-11-09 the holder was placed where the Tally its elements write
# lives, so its last two elements ended where that scope closed, after the count; it stays in its block now, O17, and
# ends them there.)
import "std/io"

type Tally struct() {
    seen := Vec<I64>()
}

fn (t mut Tally&) Saw(id I64) { t.seen.Push(id) }

type Logged unique struct(id I64, log mut Tally&) {
    id, log
} destruct { log.Saw(id) }

fn churn() I64 {
    n := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        n += s.Len() + a[3]
    }
    return n
}

fn sum(t Tally&) I64 {
    s := 0
    for x in t.seen { s += x }
    return s
}
type Holder struct(t mut Tally&) {
    t
    m := Map<I64, Logged>()
}

fn (h mut Holder&) Set(k I64, id I64) { h.m.Put(k, Logged(id, h.t)) }

fn main() ? {
    t := Tally()
    m := Map<I64, Logged>()
    for k in range 40 { m.Put(k % 3, Logged(k, t)) }
    {
        h := Holder(t)
        for k in range 30 { h.Set(k % 2, 1000 + k) }
    }
    churn()
    assert t.seen.Len() >= 37 + 28 and t.seen.Len() <= 37 + 30
    try io.Println($t.seen.Len() " " $sum(t))
}
