# check: fail error[O26]: this value refers to this function's own storage
# D16d: a lambda returned where it is made is built in the result scope, each scope it captures from outliving that -
# which this function's own block does not
type Counter struct() {
    n I64 = 0
}
fn mk(f fn(x I64) I64) fn(x I64) I64 {
    c mut Counter& = Counter()
    return fn(x I64) I64 {
        c.n++
        return f(x) + c.n
    }
}
fn main() ? {
    g := mk(fn(x I64) I64 { return x })
    assert g(1) == 2
}
