# check: fail error[C2d]: this instance holds a reference to an argument it would outlive
# Vec phase 2a (T25e/C2d): a Vec<Tok>'s elements hold what lives where the Vec does - not a loop turn's text
import "std/io"
type Tok struct(text String&, line I64) {
    text
    line
}
fn main() ? {
    v := Vec<Tok>()
    for i in range 3 {
        t := "w" $i
        v.Push(Tok(t, i))
    }
    io.Println($v[0].text)
}
