# check: fail error[O39]: assigning 'h.cur' may release the In3 borrowed on line 11
# O39 (own7 F1): so does an 'as' view of it (E32b)
import "std/io"
type In3 struct(k I64) {
    data Array<I64, 8> = Array<I64, 8>()
}
type H3 struct() {
    cur own mut In3&
}
fn asView(h mut H3&) I64 {
    h.cur = In3(1)
    v := h.cur.data as Array<I64, 8>&
    h.cur = null
    return v[2]
}
fn main() ? {
    h mut H3& = H3()
    try io.Println($asView(h))
}
