# check: fail error[T25e]: 'own' is written on a field's
# one of several results never owns
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn mk(n I64) (own mut Conn&, I64) { return Conn(n), 1 }
fn main() ? { }
