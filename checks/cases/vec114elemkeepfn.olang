# check: fail error[O10c]: the callee needs one argument's scope to outlive another's
# Vec phase 2a (O10c): a function pushing a Tok of its text argument into a Vec it is given needs the text to outlive
# the Vec
import "std/io"
type Tok struct(text String&, line I64) {
    text
    line
}
fn keep(v mut Vec<Tok>&, t String&) {
    v.Push(Tok(t, 0))
}
fn main() ? {
    v := Vec<Tok>()
    for i in range 3 {
        t := "w" $i
        keep(v, t)
    }
    io.Println($v[0].text)
}
