# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# Vec phase 2a (O10c): a function pushing a Tok of its text argument into a Vec it is given needs the text to outlive
# the Vec
import "std/io"
type Tok struct(text String&, line I64) {
    text
    line
}
fn keep(v mut Vec<Tok>&, t String&) {
    v.Push(Tok(t, 0))
}
fn main() ? {
    v := Vec<Tok>()
    for i in range 3 {
        t := "w" $i
        keep(v, t)
    }
    try io.PutLine($v[0].text)
}
