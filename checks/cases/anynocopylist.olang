# check: fail error[T32]: 'Twice' keeps a copy of the value it is called on, and an any Gen& has none - call it on the instance's own type
# T32 (the third any review, finding 4): a default keeping its receiver in a List - through the List's reference to its
# state - has as little a copy of an any to keep as one holding it in a field; refused at the call, never a List of
# anys without their marker
type Ups struct(n I64) {
    n
    at I64 = 0
}
type Gen trait {
    mut Step() I64
}
fn (u mut Ups&) Step() I64 {
    u.at += 1
    return u.at
}
fn (g mut G&) Twice<G Gen>() List<G>& {
    l := List<G>()
    l.Push(g)
    l.Push(g)
    return l
}
fn main() {
    a mut any Gen& = Ups(5)
    l := a.Twice()
}
