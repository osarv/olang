# check: run
# flags: -sanitize
# O26a (bulk review 6 F8: refused until then - a copy declared from a place was no local O26a moves): the copy flows
# into the result, its references with it, so the text lives where the result goes; read back after an arena churn
fn mk(n I64) Array<String&> {
    a := Array<String&>(2)
    a[0] = $n $n
    b := a
    return b[0:1]
}
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn main() ? {
    a := mk(12)
    churn()
    assert a.Len() == 1 and a[0] == "1212"
}
