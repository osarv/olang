# check: fail unknown name 'nope'
# also: compilation failed with 4 errors
# never: operands of one type
# never: do not meet
# never: takes a Bool
# an unknown name stands for whatever it is used as, so each misspelling is one error - not also a mismatched
# comparison or a non-boolean operand
fn main() ? {
    s String& = "a"
    assert s == nope
    assert nope + 1 == 2
    assert not nope2
    assert nope3 < 3.5
}
