# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# vec4 (over-rejection 1's counterpart): a global reference made from a global's own text keeps the loan, which nothing here sees
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type Doc struct() {
    title own mut String& = $1 "-title-built-at-run-time"
}
type Wrap struct(s String&) { s }
Docs own mut Doc& = Doc()
T String& = Docs.title
fn main() ? {
    Docs.title = $2 "-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    try io.Println("x")
}
