# check: fail error[O41]: assigning 's.cur' may release the Node the task spawned on line
# a loop in a join block gives the slot a new owner while the last turn's task may still use the old one
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn look(n Node&) { io.Println(n.name) }
fn main() ? {
    s := Holder()
    join {
        for i in range 3 {
            s.cur = Node(i)
            spawn look(s.cur)
        }
    }
}
