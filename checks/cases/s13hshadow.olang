# check: fail is declared twice
# S13h, D3a: a name in an array pattern is always a new binding, never a local's value read - compare with a guard
fn f(xs Array<I64>&, z I64) I64 {
    match xs {
        case I64[z] { return 1 }
        case _ { return 0 }
    }
}

fn main() {
    assert f(I64[1], 1) == 1
}
