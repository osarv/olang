# check: run
# E11c: Str is an ordinary method - a helper walking an iterator it is handed compiles (it was refused when a Str could
# have no effect)
import "std/list"
type Reg struct(l list.List<I64>) {
    l
}
fn h1(it mut list.Iter<I64>&) I64 {
    n I64 = 0
    for x in it { n += x }
    return n
}
fn (r Reg&) Str() String {
    it := r.l.Iter()
    n := h1(it)
    return "x"
}
fn main() ? {
    l := list.List<I64>()
    l.Push(3)
    r := Reg(l)
    assert $r == "x"
}
