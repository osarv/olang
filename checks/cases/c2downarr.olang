# check: fail error[C2d]: this instance holds a reference to an argument it would outlive - make the argument where the instance goes, or the instance where the argument lives ('T&x(...)')
# a constructor's own array of references holding its parameter's text, the instance kept past that text: must fail
import "std/io"
type W struct(s String&) {
    names own mut Array<String&>& = Array<String&>(2)
    names[0] = s
}
fn main() ? {
    w := W("a")
    {
        x := $5 "abc"
        w = W(x)
    }
    io.Println(w.names[0])
}
