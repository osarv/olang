# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# a constructor's array of references holding its parameter's text, the instance kept past that text: must fail
import "std/io"
type W struct(s String&) {
    names mut Array<String&>& = Array<String&>(2)
    names[0] = s
}
fn main() ? {
    w := W("a")
    {
        x := $5 "abc"
        w = W(x)
    }
    try io.Println(w.names[0])
}
