# check: run
# E11c: a Str writing through its receiver's reference - here through a helper it hands the reference to - is called
# once per "$", so each rendering counts once, built (-b, -d) and interpreted (-i) alike
type Ctr struct() {
    n I64 = 0
}
fn bump(c mut Ctr&) { c.n++ }
type B struct(c mut Ctr&) { c }
fn (a B&) Str() String {
    bump(a.c)
    return "b" $a.c.n
}
fn main() ? {
    b := B(Ctr())
    assert $b == "b1"
    assert $b " " $b == "b2 b3" and b.c.n == 3
}
