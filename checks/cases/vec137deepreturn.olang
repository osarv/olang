# check: fail error[O38, O26a]: this result reaches the owner value local 'o' by reference
# D (own5 F2): a reference to an owner value local carries its owners' loans 8 levels down too
import "std/io"
type L0 struct() {
    toks Vec<I64> = Vec<I64>()
}
type L1 struct() {
    x L0 = L0()
}
type L2 struct() {
    x L1 = L1()
}
type L3 struct() {
    x L2 = L2()
}
type L4 struct() {
    x L3 = L3()
}
type L5 struct() {
    x L4 = L4()
}
type L6 struct() {
    x L5 = L5()
}
type L7 struct() {
    x L6 = L6()
}
type L8 struct() {
    x L7 = L7()
}
fn mk() mut L8& {
    o := L8()
    for i in range 100 { o.x.x.x.x.x.x.x.x.toks.Push(i + 1) }
    return o
}
type Hold struct(x L8&) {
    x
}
fn mkHold() Hold {
    o := L8()
    for i in range 100 { o.x.x.x.x.x.x.x.x.toks.Push(i + 7) }
