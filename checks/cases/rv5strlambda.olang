# check: run
# E11c (review of rv3fix, #5): a Str calling a lambda it made, which writes through a capture reaching the value being
# rendered - once per "$"
type C struct() { n I64 = 0 }
type B struct(c mut C&) { c }
fn (a B&) Str() String {
    k := a.c
    f := fn() { k.n = k.n + 1 }
    f()
    return "b"
}
fn main() ? {
    c mut C& = C()
    b := B(c)
    s := $b
    assert $s " " $c.n == "b 1"
    assert $b $b == "bb" and c.n == 3
}
