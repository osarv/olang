# check: fail error[O39]: calling 'Push' may release the Array<String&> borrowed on line 16
# vec2: a type-variable result bound to a reference returns what its body gives it - its argument too (O14b) - so it
# is not taken for new storage, and keeps the loan of a view handed to it
fn id(x <T>) T { return x }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    v := Vec<String&>()
    v.Push("a")
    d := id(v.View())
    for i in range 100 { v.Push("b") }
    churn()
    println(d[0])
}
