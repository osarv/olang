# check: fail error[O39]: calling 'Push' may release the Array<I64> borrowed on line 11, which is used after it
# Vec phase 2a (O37/O39): a function handing back a view of its parameter's Vec field is a borrowed own result
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn view(l Lexer&) Array<I64>&l { return l.toks.View() }
fn main() ? {
    l := Lexer(1)
    l.toks.Push(1)
    d := view(l)
    l.toks.Push(2)
    io.Println($d[0])
}
