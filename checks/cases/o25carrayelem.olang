# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O25c/T7: an array's elements live where the array does - a literal or a fill holding a local, returned or stored
# further out than the local, is rejected where it lands
type Node struct(v I32) {
    v
}
fn f() Array<mut Node&>& {
    n mut Node& = Node(41)
    return Array<mut Node&>(2, n)
}
fn g() Array<mut Node&>& {
    n mut Node& = Node(42)
    return Array<Node&>[n]
}
fn main() ? {
    outer mut Node& = Node(1)
    c Array<mut Node&>& = Array<mut Node&>(1, outer)
    d Array<mut Node&>& = Array<Node&>[outer]
    for _ in range 2 {
        inner mut Node& = Node(43)
        c = Array<mut Node&>(1, inner)
        d = Array<Node&>[inner]
    }
    assert $c != ""
    assert $d != ""
}
