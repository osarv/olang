# check: run
# flags: -d -s
# P2 (review of rv3fix, #1): the same stored into a List outside the join
type Node struct(v I64) {
    v
    next mut Node& = null
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn keep(l mut List<fn() I64>&, g fn() I64) { l.Push(g) }
fn main() ? {
    n mut Node& = Node(1)
    g := fn() I64 {
        n.next = Node(n.v + 41)
        return n.next.v
    }
    fns mut List<fn() I64>& = List<fn() I64>()
    join {
        spawn keep(fns, g)
    }
    churn()
    f := fns[0]
    if f() != 42 { fail }
    churn()
    if n.next.v != 42 { fail }
}
