# check: run
# never: standard library
# QCE (T7a relaxed): a lambda's result binding a type variable the generic holds in an array is held by value - a
# Vec<String> of its own texts (it was T7a's error at the lambda's result, study 4's r19)
import "std/io"
fn main() ? {
    nums := Array<I64>[1, 2, 3]
    ws := nums.Map(fn(n I64) String { return "#" $n })
    assert ws.Len() == 3 and ws[2] == "#3"
    try io.Println($ws[0] " " $ws[1])
}
