# check: run
# E11c: a Str stepping a cursor it made, through a helper writing what the cursor reaches - the value being rendered -
# once per "$"
type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
type Cur struct(of Bag&) {
    c mut Cell&of = of.c
    n I64 = 0
}
fn poke(p mut Cur&) {
    p.n++
    p.c.v++
}
fn poke2(p mut Cur&) { poke(p) }
fn (b Bag&) Str() String {
    cur := Cur(b)
    poke2(cur)
    return "b" $cur.n $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    assert $b == "b11"
    assert $b == "b12" and b.c.v == 2
}
