# check: fail error[C2d]: this instance holds a reference to an argument it would outlive
# Vec phase 2a (T25e/C2d): v[i] = Tok(t) with t a loop turn's text
type Tok struct(text String&, line I64) {
    text
    line
}
fn main() ? {
    v := Vec<Tok>()
    v.Push(Tok("a", 1))
    for i in range 3 {
        t := "w" $i
        v[0] = Tok(t, 2)
    }
    println($v[0].text)
}
