# check: fail error[O25]: a reference never narrows - declare it with ':=' from what it is given
# R9a: a default is judged where the call's result lands - here the outer variable keep - not where the try is
# written; inner dies with the loop body, so keep would be left pointing into a reclaimed arena
type Stop error {
    Here
}
type Node struct(v I32) {
    v
}
fn Node.mk(k I64) Node& ? {
    if k > -5 { error Stop.Here }
    return Node(7)
}
fn main() ? {
    outer Node& = Node(1)
    keep Node& = outer
    for i in range 2 {
        inner mut Node& = Node(42)
        keep = try Node.mk(i) catch default inner
    }
    assert $keep != ""
}
