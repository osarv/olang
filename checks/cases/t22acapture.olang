# check: fail error[T22b]: 'link' keeps 'b' in 'a', and the function type of this capture says nothing of that - write 'keeps b in a' after its signature
# T22a (decision 15): a capture is a boundary - inside the lambda's body the captured value is judged by its type alone
type N struct(v I64) {
    v
    next N?& = null
}
fn link(a mut N&, b N&) { a.next = b }
fn main() {
    x mut N& = N(1)
    g := link
    f := fn() { g(x, N(2)) }
    f()
}
