# check: run
# E11b: a join's operands are evaluated left to right before any piece is rendered, each to its value - a number, a
# struct as they are then, an array its length and storage then and its elements when rendered - so a later piece's
# call changing what an earlier piece reads is never written past what was measured (measured first and written last,
# the array was written past the end of its text: "I64[123457" and the arena overrun), built (-b, -d) and interpreted
# (-i) alike; a Str runs as its piece renders, after every operand
G mut Array<I64> = I64[1, 2]
Name mut String& = "ab"
X mut I64 = 1
type S struct(v I64) { v }
P mut S = S(5)
fn bump() I64 {
    G[0] = 123456789012345
    G[1] = 987654321098765
    return 7
}
fn rename() I64 {
    Name[0] = 'x'
    return 8
}
fn inc() I64 {
    X = 40
    P.v = 50
    return 9
}
type H struct(n I64) { n }
fn (h H&) Str() String {
    P.v = 77
    G[1] = 3
    return "h"
}
fn main() ? {
    s := $G $bump()
    assert s == "I64[123456789012345, 987654321098765]7"
    t := $Name $rename() $Name
    assert t == "xb8xb"
    u := $X $P $inc() $X $P
    assert u == "1S(5)940S(50)"
    w := $H(1) $P $G       # a Str runs as its piece renders: the struct was taken before, the array's elements after
    assert w == "hS(50)I64[123456789012345, 3]"
    assert P.v == 77
}
