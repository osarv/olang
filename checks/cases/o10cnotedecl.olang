# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# B11: an obligation an argument from a loop body cannot meet - the note names the declaration to change
type Counter struct() {
    n I64 = 0
}
type Button struct(label String&) {
    label
    onClick fn?&() = null
}
fn wire(b mut Button&, c mut Counter&) {
    b.onClick = fn() { c.n++ }
}
fn main() ? {
    ok mut Button& = Button("OK")
    for _ in range 2 {
        c mut Counter& = Counter()
        wire(ok, c)
    }
    ok.onClick!()
}
