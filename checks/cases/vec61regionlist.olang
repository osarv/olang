# check: fail error[O39]: assigning 'c.items' may release the List<String&> borrowed on line
# vec4 (r1d_owned_list_text): the review's repro
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# s3 shape as the note above suggests it: text made where an owned List lives, kept past the List's release
type CB struct() {
    items own mut List<String&>& = List<String&>()
}
fn main() ? {
    c := CB()
    l := c.items
    s mut String&l = $5 "-new-text-made-where-the-list-lives"
    l.Push(s)
    c.items = List<String&>()
    churn()
    println(s)
}
