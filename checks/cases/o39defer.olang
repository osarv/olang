# check: fail error[O39]: assigning 's.cur' may release the Conn borrowed on line
# deferred code reading a borrow uses it at the end of its block
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn main() ? {
    s := Server()
    s.cur = Conn(1)
    c := s.cur
    defer { println(c.name) }
    s.cur = null
}
