# check: fail error[O39]: calling 'drop' may release the Conn borrowed on line
# a call whose body may release below its argument, while a borrow below it is used after
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn drop(s mut Server&) { s.cur = null }
fn main() ? {
    s := Server()
    s.cur = Conn(3)
    c := s.cur
    drop(s)
    try io.Println(c.name)
}
