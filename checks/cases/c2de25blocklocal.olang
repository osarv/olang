# check: fail error[C2d]: this instance holds a reference to an argument it would outlive
# C2d/E25: an instance built where a scope argument says ('Env&c(...)') is judged there - holding a block's local,
# which can be stored through, it is refused (study 6's r07 relaxed the same call holding c.env)
type Env struct(parent mut Env&) {
    n I64 = 0
    parent
}
type Closure struct(env mut Env&) {
    env
}
type Value enum {
    Nil
    Fn(c Closure&)
}
fn depth(f Value&) I64 {
    match f {
        case Value.Fn(c) {
            other := Env(null)
            local := Env&c(other)
            local.n = 1
            return local.n
        }
        nomatch { return 0 }
    }
}
fn main() ? {
    g mut Env& = Env(null)
    f Value& = Value.Fn(Closure(g))
    println($depth(f))
}
