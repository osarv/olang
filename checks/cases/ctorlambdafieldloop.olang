# check: run
# flags: -sanitize
# C2g, D16d (the unpar review): a constructor field's lambda captures the argument, so the instance holds it - kept in a
# list outliving the loop body. It was accepted with the closure in the constructor's frame, reading freed memory, then
# refused; since item 17 the argument, a loop turn's local, is built where the instance keeping it is - read back after
# an arena churn
import "std/io"

type M struct(n I64, data Array<I64>&) {
    n
    F fn&() I64 = fn() I64 { return data[1] }
}

fn main() {
    ms := Vec<M>()
    for i in range 3 {
        d := Array<I64>(4, i + 1)
        ms.Push(M(2, d))
    }
    churn()
    io.PutLine($ms[0].F() " " $ms[2].F())!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := Vec<I64>()
        b.Push(a[3])
        m := Map<I64, Vec<I64>>()
        m.Put(i, b)
        assert a[3] == i
    }
}
