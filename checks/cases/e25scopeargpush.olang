# check: fail error[O10c]: the callee needs one argument's scope to outlive another's, and nothing here shows it
# E25, O10c (the third any review, finding 2): a built reference a scope argument puts in a loop body's scope, pushed
# into a list outside the loop - as an argument it is existing storage where the scope argument says
type P struct(n I64) { n }
fn mkp(i I64) P& { return P(i) }
fn main() {
    xs := List<P&>()
    for i in range 3 {
        t := "inner" $i
        xs.Push(mkp&t(i))
    }
}
