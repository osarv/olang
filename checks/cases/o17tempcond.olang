# check: fail this value's references live where its own storage does not, and the callee can store through it
# O17 (U2): a conditional of two local values lent to a read-only reference parameter that builds through them
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
type Node struct(v I64, next mut Node&) {
    v
    next
}
type Box struct() {
    head mut Node& = Node(0, null)
    tag I64 = 0
}
fn addVia(b Box&, v I64) { b.head.next = Node(v, b.head.next) }
fn sum(b Box&) I64 {
    t I64 = 0
    for n := b.head, n != null, n = n.next { t = t * 10 + n.v }
    return t
}
fn main() ? {
    b1 := Box()
    b2 := Box()
    for i in range 3 {
        addVia(b1 if i >= 0 else b2, i + 1)
        churn()
    }
    churn()
    println("b1 " $sum(b1))
}
