# check: fail error[E14b]: 'timout' names no parameter of 'connect' - did you mean 'timeout'?
# E14b: arguments by name give defaulted parameters, after the arguments by position, each once
fn connect(host String&, port I64 = 80, timeout I64 = 30) I64 { return port + timeout }
fn main() { x := connect("h", timout = 3) }
