# check: run
# O8e (genrefs round 4): the doubly linked list of docs/genrefs/dlist.olang, its peak asserted - each node let go of is
# reclaimed where its last owning place lets go of it, its slot reused, so 1M operations stay near what is live
import "std/os"
type Node struct(v I64) {
    v
    pad Array<I64> = Array<I64>(8, 0)
    next mut Node?& = null
    prev weak mut Node?& = null # points back: reads null once nothing owning holds the node it names (T2d)
}

type DList struct() {
    head mut Node?& = null
    tail weak mut Node?& = null
    n I64 = 0
}

fn (l mut DList&) PushBack(v I64) {
    nd := Node(v)
    t := l.tail
    if t is null {
        l.head = nd
    } else {
        t.next = nd
        nd.prev = t
    }
    l.tail = nd
    l.n++
}

fn (l mut DList&) PopFront() I64 {
    h := l.head!
    v := h.v
    q := h.next
    l.head = q
    if q is null { l.tail = null } else { q.prev = null }
    l.n--
    return v
}

fn peakKb() I64 {
    status := try os.ReadFile("/proc/self/status") catch default ""
    at := try status.Find("VmHWM:") catch default -1
    if at < 0 { return -1 }
    line := status[at + 6:]
    end := try line.FindByte('\n') catch default line.Len()
    return try line[:end].Trim().Split(" ")[0].ParseInt() catch default -1
}

fn main() ? {
    l := DList()
    total := 0
    for i in range 1000000 {
        l.PushBack(i)
        if l.n > 100: total += l.PopFront()
    }
    assert total == 499899505050
    kb := peakKb()
    assert kb > 0 and kb < 8000, $kb
}
