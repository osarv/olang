# check: fail error[O39]: calling 'grow' may release the Array<I64> borrowed on line 11, which is used after it
# Vec phase 2a (O39): a method of the struct that pushes to its Vec field may release the buffer a view borrows
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn (l mut Lexer&) grow() { l.toks.Push(1) }
fn main() ? {
    l := Lexer(3)
    for i in range 3 { l.toks.Push(i) }
    d := l.toks.View()
    l.grow()
    try io.Println($d[0])
}
