# check: fail error[O36]: 'mk' owns a parameter or gives an owned result, so it is called by name only
# nor one giving an owned result
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn mk(n I64) own mut Conn& { return Conn(n) }
fn main() ? {
    f := mk
}
