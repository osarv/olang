# check: run
# R1 (refusals 5.1): compiles now - a split value lent where its references live, its own storage lifted there where
# the callee keeps it (O17b generalized); it was refused, as what follows says
# O17b: a callee keeping the handle itself in something else it is given, or returning it, uses the handle's own storage
# - which may die first - so the handle is lent as its storage, and refused
type St struct() { x I64 = 0 }
type H struct() { s mut St& = St() }
type Keeper struct() { h mut H?& = null }
fn (h mut H&) me() mut H& { return h }
fn main() ? {
    m := Map<I64, H>()
    m.Put(1, H())
    for _ in range 3 {
        c := try m.Get(1)
        r := c.me()
        r.s.x++
    }
}
