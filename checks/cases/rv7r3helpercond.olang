# check: run
# E11c: "$" calls a Str once per rendering, whatever it writes - a helper handing on a field of a conditional of its two
# parameters: once per "$"
type In struct() {
    k I64 = 0
}
type Mid struct() {
    inner In = In()
}
type Bag struct(m mut Mid&, other mut Mid&) {
    m
    other
}
fn poke(p mut In&) { p.k++ }
fn either(p mut Mid&, q mut Mid&, c Bool) { poke((p if c else q).inner) }
fn (b Bag&) Str() String {
    either(b.m, b.other, true)
    return "b"
}
fn main() ? {
    b := Bag(Mid(), Mid())
    assert $b $b " k=" $b.m.inner.k == "bb k=2"
}
