# check: run
# E35/B4: "!" ends the program on what fails as written, so main needs no "?" for it; here nothing fails
import "std/io"
type E error {
    Bad
}
fn half(n I64) I64 ? {
    if n % 2 != 0 { error E.Bad }
    return n / 2
}
fn main() {
    io.Println("half of 8 is " $(half(8)!))!
    x := half(half(8)!)!
    assert x == 2
}
