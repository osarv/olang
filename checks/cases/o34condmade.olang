# check: fail error[O34]: a conditional or a match gives an own slot nothing yet - assign each case's owner in its own branch
# O34: owners made in a conditional's values go nowhere yet - each case's owner is assigned in its own branch (own7: the
# message for values made there, not the one for owner value locals chosen by copying)
type Leaf struct(n I64) {
    n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Holder struct() {
    cur own mut Inner&
}
fn main() ? {
    c := Args().Len() > 0
    h mut Holder& = Holder()
    h.cur = Inner(1) if c else Inner(2)
}
fn Args() Array<I64>& { return Array<I64>(0) }
