# check: run
# vec5 O33: what stays legal - the region read into a local first, then the call (a plain one and a spawned one)
import "std/io"
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Hold struct(v I64) {
    v
    n mut Node& = Node(v)
}
type Holder struct() {
    cur own mut Hold&
}
fn setN(x mut Node&, h mut Hold&) { h.n = x }
fn main() ? {
    s := Holder()
    for i in range 3 {
        s.cur = Hold(i)
        o := match i % 2 { case 7 { unreachable } case _ => s.cur }
        setN(Node(9 + i), o)
        assert s.cur.n.v == 9 + i
        p := s.cur
        join { spawn setN(Node(20 + i), p) }
        assert s.cur.n.v == 20 + i
    }
    io.Println("ok")
}
