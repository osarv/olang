# check: fail error[G1a]: 'T' is a type variable, not an error set - an error-set parameter is written after '?' in its list, '<T ? E>'
# G1a: a type variable stands where a type does - an error set names error types and error-set parameters
fn keep<T>(x T) T ? T { return x }

fn main() {
    keep(1)
}
