# check: run
# T29d/R1c: one base error - every base is a Radix; a literal one, written out ("Radix(16)") or not, is decided while
# compiling and needs no try, and a computed one fails with TextError.BadBase alone
B mut I64 = 40
fn main() {
    r := Radix(16)
    n I64 = 255
    assert n.Format(r) == "ff" and (try "ff".ParseInt(r) catch default 0) == 255
    assert (try "ff".ParseInt(16) catch ParseError default 0) == 255
    bad := try Radix(B) catch TextError.BadBase default Radix(10)
    assert n.Format(bad) == "255" and I64(255).Format(0) == "255"
    assert (try "0x10".ParseInt(0) catch default 0) == 16
}
