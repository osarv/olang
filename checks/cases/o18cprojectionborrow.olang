# check: fail error[O25i]: this reads 'held', which an assignment may have given storage that no longer lives here - assign it a copy ('$x' or 'x.Copy()'), or what lives here
# O18c/O17: a part read off a call's result keeps its references where the call landed, but its own storage is its
# block - a reference to it that outlives the block is refused (the relaxation of study 6's r05 must not reach it)
# (O25i: 'held' is typed per assignment now, so the error is at the read after the loop, which the version
# 'held = x' reaches, x's storage being the loop body's - not at the assignment)
import "std/io"
type Inner struct(s String&) { s }
type Outer struct(inner Inner) { inner }
type Store struct() {
    items mut Vec<Outer>& = Vec<Outer>()
}
fn (st Store&) get(i I64) Outer { return st.items[i] }
fn main() ? {
    st := Store()
    st.items.Push(Outer(Inner("t")))
    held Inner?& = null
    for _ in range 3 {
        x := st.get(0).inner
        held = x
    }
    try io.Println(held!.s)
}
