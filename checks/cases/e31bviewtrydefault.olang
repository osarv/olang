# check: fail x[i] gives a copy of the element, which this call would write
# E31b (r2, a recorded over-rejection): "try x[i] catch default v" derived from Len is never lent as a view, even to
# a callee writing none of its own storage - its copy is not held apart from its try
import "std/io"
type V struct(d mut Array<I64>&, n I64) {
    d
    n
}
type Vs struct(d mut Array<I64>&) {
    d
}
fn (s Vs&) At(i I64) V { return V(s.d, i) }
fn (s Vs&) Len() I64 { return s.d.Len() }
fn put(v mut V&, x I64) { v.d[v.n] = x }
fn main() ? {
    s := Vs(Array<I64>(4))
    put(try s[2] catch default V(Array<I64>(1), 0), 9)

    try io.Println($s.d)
}
