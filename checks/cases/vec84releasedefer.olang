# check: fail error[O39]: assigning 'c.text' may release the String borrowed on line
# vec5 R2b: deferred code building in a borrow's region runs at the block's end, after the release
import "std/io"
type CB struct() {
    text own mut String& = $1 "-ttttttttttttttt"
}
fn main() ? {
    c := CB()
    x := c.text
    defer {
        d mut String&x = $5 "-built-on-the-way-out"
        try io.Println(d) catch io.IoError { }
    }
    c.text = $2 "-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
}
