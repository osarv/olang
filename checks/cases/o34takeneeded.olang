# check: fail error[O34]: moving out of 's.cur' would leave it empty - write 'take s.cur'
# an own slot still holds what it owns unless it is taken
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn main() ? {
    s := Server()
    s.cur = Conn(1)
    s.other = s.cur
}
