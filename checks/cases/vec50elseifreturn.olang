# check: fail error[O39]: calling 'Push' may release the Array<I64> borrowed on line
# vec4 (f1a_else_if_catch_return): the review's repro
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# F1 residue (the natural-looking form): "if parsing fails, fall back to the caller's buffer" written as an
# else-if whose condition's catch block returns. ownFreshReturns never walks an else-if's condition, so the
# function is "proven fresh", the loan on the Vec's buffer is spared, and the Push below frees what d points at.
fn pick(c Bool, x <T>, y T) T { return x if c else y }
fn bufFor(spec String&, a mut Array<I64>&, b mut Array<I64>&) mut Array<I64>& {
    if spec == "new" { return Array<I64>(4) }
    else if (try spec.ParseInt() catch { return pick(a.Len() >= b.Len(), a, b) }) > 0 { return Array<I64>(2) }
    return Array<I64>(1)
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    other mut Array<I64>& = Array<I64>(1)
    d := bufFor("?", v.ViewMut(), other)
    for i in range 1000 { v.Push(i) }
    churn()
    try io.Println($d[0] " " $d[1])
}
