# check: fail error[O10]: this reference lives in a scope that may not outlive where it is put
# vec2: a built result keeps no loan on an owned object's buffer only because it cannot be that buffer - an own slot's
# object, or a slice of it, returned as a built result, is refused at the return (its region outlives nothing, O33)
import "std/io"
type B struct() {
    buf own mut Array<String&>& = Array<String&>(2)
}
fn leak(b mut B&) mut Array<String&>& { return b.buf[0:1] }
fn main() ? {
    b := B()
    a := leak(b)
    b.buf = Array<String&>(3)
    io.Println(a[0])
}
