# check: fail writes through a read-only reference
# T25b: a result borrowed from an immutable global is read-only - writing through it used to change the global
G Array<Char> = "abc"
type E error { X }
fn front(a Array<Char>&) Array<Char>& { return a[0:2] }
fn main() ? E {
    x := front(G)
    x[0] = 'z'
}
