# check: fail error[O20]: the container outlives what this refers to
# also: note: this borrows a value made here
# E16a/E32b (tonight9's review): an "as" view of a temporary is a slice of it, made in the block it is written in -
# here a new array, built in set's own scope and viewed past its return
type H struct(k I64) {
    k
    r Array<I64, 4>& = null
}
fn set(h mut H&, n I64) {
    h.r = Array<I64>(4, n) as Array<I64, 4>&
}
fn main() ? {
    h mut H& = H(1)
    set(h, 7)
    println($h.r[1])
}
