# check: run
# flags: -debug -sanitize
# E16a, O27 as placement: a slice of a known length of a temporary - a new array - kept in a parameter's field has it
# built where the field lives (it was O20's error: built in set's own scope and viewed past its return); read back
# after a churn
import "std/io"
type H struct(k I64) {
    k
    r Array<I64>& = Array<I64>(0)
}
fn set(h mut H&, n I64) {
    h.r = Array<I64>(4, n)[0:4]
}
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}
fn main() ? {
    h mut H& = H(1)
    set(h, 7)
    churn()
    try io.PutLine($h.r[1])
}
