# check: fail error[O31]: Buf owns objects - a field of it is 'own' - so only a local, a field, a global or a result holds one by value
# a parameter takes an owning value by reference
import "std/io"
type Buf struct() {
    data own mut Array<I64>& = Array<I64>(2)
    n I64 = 0
}
fn grown(old Array<I64>&, cap I64) own mut Array<I64>& {
    a own mut Array<I64>& = Array<I64>(cap)
    for i in range old.Len() { a[i] = old[i] }
    return a
}
fn (b mut Buf&) add(x I64) {
    if b.n == b.data.Len() { b.data = grown(b.data, b.n * 2) }
    b.data[b.n] = x
    b.n++
}
fn (b Buf&) copy() Buf {
    c := Buf()
    for i in range b.n { c.add(b.data[i]) }
    return c
}
fn f(b Buf) I64 {
    return b.n
}
fn main() ? {
    a := Buf()
    io.Println($f(a))
}
