# check: fail error[O36]: a function value's parameters and result never own
# nor does a lambda's
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn main() ? {
    f := fn(c own mut Conn&) I64 { return c.fd }
}
