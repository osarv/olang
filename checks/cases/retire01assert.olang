# check: fail error[S18c, K1]: evaluated while compiling, this assertion stops on a stale view
# also: note: the Vec grew here, after the view was taken
# round 1 of docs/memory.md (K1): a view of a Vec kept across a growth it cannot see - through a second name stored in a
# structure - reads the old elements at run time; the evaluator knows which Vec the view came from and stops on the read,
# naming the read and the program's Push
type Job struct() {
    items Vec<I64>
}
fn add(j mut Job&) { for i in range 100 { j.items.Push(9) } }
fn report(v Vec<I64>, j mut Job&) I64 {
    head := v.View()
    add(j)
    return head[0]
}
fn work(k I64) I64 {
    j := Job()
    j.items.Push(k)
    return report(j.items, j)
}
fn main() {
    assert work(5) == 5
}
