# check: fail error[O17]: this value's references live where its own storage does not, and the callee can store through it
# O17/O25h: a copy of a local enum's payload keeps its references where the enum's are, while its storage is the copy's
# block - lent to a callee that builds through it, what the callee built would go into the copy's block
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() { head mut Node& = Node(1) }
type E enum {
    A(b Box)
    Z
}
fn grow(b mut Box&) { b.head.next = Node(43) }
fn main() ? {
    e := E.A(Box())
    {
        y := e as E.A
        grow(y)
    }
}
