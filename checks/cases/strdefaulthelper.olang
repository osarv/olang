# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/R9a: the same one call down - the helper hands its parameter's scope to the default's landing call, so the helper
# builds there; codegen also holds a body to it where it only passes a scope on to a callee building there (C1d)
import "std/io"
type Stop error {
    Here
}
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn nv(n Node&) I64 {
    if n.next is null { return 0 }
    return n.next!.v
}
fn grow(x mut Node&) { x.next = Node(x.v + 100) }
fn f(n mut Node&) mut Node& ? {
    if n.v > 0 { error Stop.Here }
    return n
}
fn Node.g(v I64) mut Node& { return Node(v) }
fn pick(n mut Node&) mut Node& { return try f(n) catch default Node.g(5) }
fn (b Bag&) Str() String {
    b.head.next = pick(b.head)
    return "b" $b.k
}
fn main() ? {
    b := Bag(Node(1), 3)
    try io.PutLine($b)
    t := churn(100)
    try io.PutLine($nv(b.head) " " $t)
}
