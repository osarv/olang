# check: fail error[E11c, O12]: '$' does not say where a value it renders lives, so Str builds and stores nothing where its receiver reaches
# E11c/R9a: the same one call down - the helper hands its parameter's scope to the default's landing call, so the helper
# builds there; codegen also holds a body to it where it only passes a scope on to a callee building there (C1d)
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn nv(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
fn grow(x mut Node&) { x.next = Node(x.v + 100) }
fn f(n mut Node&) mut Node&n ? {
    if n.v > 0 { error }
    return n
}
fn g(v I64) mut Node& { return Node(v) }
fn pick(n mut Node&) mut Node&n { return try f(n) catch default g(5) }
fn (b Bag&) Str() String {
    b.head.next = pick(b.head)
    return "b" $b.k
}
fn main() ? {
    b := Bag(Node(1), 3)
    println($b)
    t := churn(100)
    println($nv(b.head) " " $t)
}
