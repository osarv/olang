# check: fail error[O25h]: this value holds references into a scope the target outlives
# round 1 of docs/memory.md: a Vec is a handle, so 'take' no longer moves one - its record stays in the first own
# object's region, and storing the handle into another region is refused by O25h (O1b for a global, O38 for a borrow)
# vec7 F2: a Vec taken through a getter giving a borrowed own result (O37) - which region the object is in is not known
# where the is checked, so the is refused (O34)
import "std/io"
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn (p mut Parser&) Lx() mut Lexer&p { return p.lx }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    p := Parser()
    p.lx = Lexer()
    for i in range 3 { p.lx.toks.Push($i "-word-built-in-the-lexer's-region") }
    d := Parser()
    d.lx = Lexer()
    d.lx.toks = p.Lx().toks
    p.lx = null
    churn()
    try io.Println(d.lx.toks[0])
}
