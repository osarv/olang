# check: fail error[E11c, O12]: '$' does not say where a value it renders lives, so Str builds and stores nothing where its receiver reaches
# E11c/R9a: the same for a checked index, whose default lands where the element lives (C1c, pre-existing)
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(arr Array<mut Node&>&, k I64) {
    arr
    k
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := List<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn g(v I64) mut Node& { return Node(v) }
fn (b Bag&) Str() String {
    b.arr[0].next = try b.arr[b.k] catch default g(5)
    return "b" $b.k
}
fn main() ? {
    b := Bag(Array<mut Node&>(1, Node(1)), 3)
    println($b)
    t := churn(100)
    w := 0 if b.arr[0].next == null else b.arr[0].next.v
    println($w " " $t)
}
