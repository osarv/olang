# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/R9a: the same for a checked index, whose default lands where the element lives (C1c, pre-existing)
import "std/io"
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type Bag struct(arr Array<mut Node&>&, k I64) {
    arr
    k
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn Node.g(v I64) mut Node& { return Node(v) }
fn (b Bag&) Str() String {
    b.arr[0].next = try b.arr.Get(b.k) catch default Node.g(5)
    return "b" $b.k
}
fn main() ? {
    b := Bag(Array<mut Node&>(1, Node(1)), 3)
    try io.PutLine($b)
    t := churn(100)
    w := 0 if b.arr[0].next is null else b.arr[0].next!.v
    try io.PutLine($w " " $t)
}
