# check: fail error[O39]: assigning 'w.lx' may release the Array<I64> borrowed on line 13, which is used after it
# Vec phase 2a (O31/O35): ...and replacing the inner one, the field holding the Vec's holder
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
type Wrap struct() {
    lx Lexer = Lexer(1)
}
fn main() ? {
    w := Wrap()
    w.lx.toks.Push(1)
    d := w.lx.toks.View()
    w.lx = Lexer(2)
    try io.Println($d[0])
}
