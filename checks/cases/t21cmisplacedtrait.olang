# check: run
# T30c (was a T21c refusal): a trait's method writes its promises, as a function type does - Sq's Area keeps them
type Shape trait {
    Area() F64 pure
}
type Sq struct(s F64) { s }
fn (q Sq&) Area() F64 { return q.s * q.s }
fn area(x any Shape&) F64 { return x.Area() }
fn main() {
    assert area(Sq(3.0)) == 9.0
}
