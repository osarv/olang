# check: run
# flags: -debug -sanitize
# E16a/R9a (U3), O27 as placement: a slice of "try a.Get(0) catch default v" returned - the try's value is a copy made
# where it is read, a temporary, and returned as a view it is built in the result scope (it was O10d's error: it lived
# in the function's own block); read back after a churn and a recursion over the stack
import "std/io"
fn churn() ? io.Error {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { try io.PutLine("x") }
    }
}
fn view(a Array<Array<I64>>&) Array<I64>& { return (try a.Get(0) catch default Array<I64>(2))[0:2] }
fn deep(n I64) I64 {
    b := Array<I64>(8)
    for i in range 8 { b[i] = n * 1000 + i }
    if n == 0 { return b[3] }
    return deep(n - 1) + b[1]
}
fn main() ? {
    a := Array<Array<I64>>(1, Array<I64>(2))
    a[0][0] = 11
    a[0][1] = 22
    v := view(a)
    t := deep(5)
    try churn()
    x := v[0]
    y := v[1]
    try io.PutLine("v " $x " " $y " t " $t)
}
