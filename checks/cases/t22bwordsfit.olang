# check: build
# T22b: the effect words judged by what each function a value may call does - a named function, a lambda calling what
# a local may hold, Twice given one, a parameter whose own type promises as much
fn helper(x I64) I64 { return x * 2 }

fn Run(f fn&(x I64) I64 noalloc returns pure norecurse noblock nospawn noextern, x I64) I64 { return f(x) }

fn Twice(f fn&(x I64) I64 noalloc, x I64) I64 { return f(f(x)) }

fn Pass(g fn&(x I64) I64 noalloc noblock, x I64) I64 { return Twice(g, x) }

fn main() {
    h := helper
    assert Run(fn(x I64) I64 { return h(x) + 1 }, 3) == 7
    assert Run(helper, 1) == 2
    assert Twice(fn(x I64) I64 { return Run(helper, x) }, 1) == 4
    assert Pass(helper, 1) == 4
}
