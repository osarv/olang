# check: run
# flags: -debug -sanitize
# T22c (was a T22b refusal, bulk review 8 F5 naming the instance): keepIt<Blob> keeps x in v - followed into use,
# each Blob(k + 1) is built where v lives (use's twin, code of its own); "other" churns the arena after
import "std/io"

type Blob unique struct(n I64) {
    n
    data := Array<I64>(n.Mod(7) + 2, n)
}

fn keepIt<T>(v mut Vec<T>&, x T) { v.Push(x) }

fn use(f fn&(v mut Vec<Blob>&, x Blob), v mut Vec<Blob>&) {
    for k in range 5 { f(v, Blob(k + 1)) }
}

fn main() {
    v := Vec<Blob>()
    use(keepIt<Blob>, v)
    other := Vec<Blob>()
    for _ in range 5 { other.Push(Blob(-7)) }
    acc := 0
    for b in v { acc = acc * 10 + b.data[0] }
    io.PutLine($acc)!
}
