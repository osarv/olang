# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# C2d: a field written "&p" keeps its argument's scope, so the instance may refer into longer-lived storage but must not
# outlive what it refers to - bi outlives the loop, inner dies with each iteration
type Node struct(v I64) {
    v
}
type View struct(of Node&) {
    n Node& = of
}
fn main() ? {
    base Node& = Node(0)
    bi View& = View(base)
    for i in range 3 {
        inner Node& = Node(i)
        bi = View(inner)
    }
    assert $bi != ""
}
