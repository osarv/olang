# check: run
# R1 (refusals 5.1): compiles now - a split value lent where its references live, its own storage lifted there where
# the callee keeps it (O17b generalized); it was refused, as what follows says
# O17 (F1): as o17templambdakeep, the split value a conditional of two places
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { unreachable }
    }
}
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type Box struct() {
    head mut Node& = Node(3)
}
fn leak(b Box&) fn&() I64 { return fn() I64 { return b.head.v } }
fn main() ? {
    b1 := Box()
    b2 := Box()
    fs := Vec<fn&() I64>()
    for i in range 3 {
        fs.Push(leak(b1 if i >= 0 else b2))
        churn()
    }
    churn()
    t := 0
    for f in fs { t = t + f() }
    assert t == 9, $t
}
