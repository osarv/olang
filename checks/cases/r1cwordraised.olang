# check: fail error[R3]: this function's '?' names LE.Empty, not this word - add it after '?'
# R1c/R3: a written set naming words is held word by word - an 'error' statement may raise only those
type LE error {
    Empty
    Gone
}
fn f(n I64) I64 ? LE.Empty {
    if n == 0 { error LE.Gone }
    return n
}
fn main() { x := f(1)! }
