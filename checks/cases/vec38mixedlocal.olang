# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# vec3 F2: the unrecorded return is a local holding a borrowed own result
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    data own mut Array<Char>& = Array<Char>(2, 'a')
    text own mut String& = "bb"
}
fn (c CB&) Text() String&c { return c.text }
fn (c CB&) Pick(raw Bool) String&c {
    if raw { return String(c.data) }   # recorded: Pick borrows an Array<Char> below c
    t := c.Text()                      # a local holding Text's borrowed own result (a String): not recorded
    return t                           # O38's return check skips its loan - rooted at c, a parameter Pick borrows from
}
fn use(c mut CB&) {
    t := c.Pick(false)                 # loan on Array<Char> below c only
    c.text = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"   # releases the String: not refused
    churn()
    println(t)
}
fn main() ? {
    c := CB()
    use(c)
}
