# check: fail error[T22b]: 'link' keeps 'b' in 'a', and the function type of this argument says nothing of that - write 'keeps b in a' after its signature
# T22a: a local holding a function with relations, handed on as an argument (here into a Vec's elements): a boundary
type N struct(v I64) {
    v
    next N?& = null
}
fn link(a mut N&, b N&) { a.next = b }
fn main() {
    fs := Vec<fn&(a mut N&, b N&)>()
    g := link
    fs.Push(g)
    x mut N& = N(1)
    fs[0](x, N(3))
}
