# check: fail error[S4e]: the write to 'out' is lost: nothing reads 'out' after it
# S4e: '=' on a reference parameter repoints the callee's copy (S4a) - never read again, the caller's value is unchanged
type Box struct() {
    Xs mut Array<F64>& = Array<F64>(0)
    N I64 = 0
}
fn Box.Make(n I64) Box {
    b := Box()
    b.Xs = Array<F64>(n)
    b.N = n
    return b
}
fn fill(out mut Box&) {
    out = Box.Make(3)
}
fn main() {
    b := Box()
    fill(b)
    Println(b.N)
}
