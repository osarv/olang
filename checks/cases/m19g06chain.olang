# check: fail error[M19g]: 'd' holds a view of 'v' taken before 'v' may have grown
# also: note: 'v' may grow here, in 'outer'
# M19g: a chain of callees - outer hands the Vec to middle, which hands it to inner, which grows it (a fixed point over
# their bodies)
import "std/io"
fn inner(a mut Vec<I64>&) { for i in range 100 { a.Push(i) } }
fn middle(b mut Vec<I64>&) { inner(b) }
fn outer(c mut Vec<I64>&) { middle(c) }
fn main() ? {
    v := Vec<I64>()
    v.Push(1)
    d := v.View()
    outer(v)
    try io.Println($d[0])
}
