# check: fail error[O39]: assigning 's.cur' may release the Conn borrowed on line
# a closure capturing a borrow holds it until the closure's last use
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn main() ? {
    s := Server()
    s.cur = Conn(1)
    c := s.cur
    f := fn() { try io.Println(c.name) }
    s.cur = null
    try f()
}
