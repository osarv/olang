# check: fail error[T22b]: this lambda may allocate
# also: note: its call of 'PutLine' may allocate
# T22b: a lambda given for a type promising noalloc is judged by what it does - printing allocates its text
import "std/io"

fn Apply(f fn&(x I64) I64 noalloc, x I64) I64 { return f(x) }

fn main() {
    k := Apply(fn(x I64) I64 {
        try io.PutLine($x) catch { }
        return x
    }, 3)
    assert k == 3
}
