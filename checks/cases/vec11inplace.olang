# check: fail error[O39]: calling 'Push' may release the Array<Pt> borrowed on line 9
# Vec phase 1: a callee's reference into an element held in the buffer by value keeps the buffer's loan - only a result
# that can refer neither to the buffer nor to its elements held by value is spared
import "std/io"
type Pt struct(x I64) { x }
fn el(v Vec<Pt>&) Pt&v { return v.View()[0] }
fn main() ? {
    v := Vec<Pt>()
    v.Push(Pt(4))
    p := el(v)
    for i in range 100 { v.Push(Pt(i)) }
    try io.Println($p.x)
}
