# check: fail error[O20]
# O20/E28: a conditional or a match of an existing reference and a new value stored into a longer-lived field, an element,
# through a callee, through a local, nested: each refused
type P struct(v I64) {
    v
}
type Hold struct() {
    f P& = null
    arr mut Array<P&>& = Array<P&>(2, null)
}
fn put(h mut Hold&, n P&) { h.f = n }
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn main() ? {
    h mut Hold& = Hold()
    for i in range 1 {
        local P& = P(42)
        h.f = match i {
            case 0 => local
            nomatch => P(7)
        }
    }
    churn()
    println($h.f.v)
    for i in range 1 {
        local P& = P(43)
        h.arr[0] = local if i == 0 else P(7)
    }
    churn()
    println($h.arr[0].v)
    for i in range 1 {
        local P& = P(44)
        put(h, local if i == 0 else P(7))
    }
    churn()
    println($h.f.v)
    for i in range 1 {
        local P& = P(45)
        x := local if i == 0 else P(7)
        h.f = x
    }
    churn()
    println($h.f.v)
    for i in range 1 {
        local P& = P(46)
        h.f = (local if i == 0 else P(7)) if i < 5 else P(8)
    }
    churn()
    println($h.f.v)
}
