# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O12: a local of two references from different scopes lives where neither is known, so no declaration may say it lives
# there (a new node built for 'x' would have been built where neither lives)
import "std/io"
type Node struct(v I64) {
    v
}
fn main() ? {
    a Node& = Node(1)
    k := a.v == 1
    {
        b Node& = Node(2)
        l := a if k else b
        x Node& = Node(3)
        try io.PutLine($x.v " " $l.v)
    }
}
