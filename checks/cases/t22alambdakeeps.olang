# check: fail error[T22b]: this lambda keeps 'k' in what it captured, and the function type of this store says nothing of that - write 'keeps k' after its signature
# never: lambda$
# T22a/B11: a lambda has no written name - the error names the parameter it keeps
import "std/io"
type Cache struct() {
    onEvict fn?&(k String&) = null
}
fn main() ? {
    c := Cache()
    gone := Vec<String&>()
    goneRef mut Vec<String&>& = gone
    c.onEvict = fn(k String&) { goneRef.Push(k) }
    c.onEvict!("a")
    try io.PutLine($gone.Len())
}
