# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O4b/O14c: the same through a generic instantiated at a struct holding a reference
type Node struct(v I32) {
    v
}
type Holder struct(n Node&) {
    n
}
fn id<T>(x T) T { return x }
fn main() ? {
    outer Node& = Node(1)
    keep Holder = Holder(outer)
    for _ in range 2 {
        inner Node& = Node(42)
        h2 := Holder(inner)
        keep = id(h2)
    }
    assert $keep != ""
}
