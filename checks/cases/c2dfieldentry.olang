# check: fail error[C2d]: this instance holds a reference to an argument it would outlive
# C2d: a value a constructor field builds from the constructor's parameter lands in the instance, so the parameter's
# argument is held to wherever the instance lands - here it dies with each iteration while the instance outlives it
type FeEnt struct(v mut Vec<I64>&) { V mut Vec<I64>& = v }
type FeSlot struct(v mut Vec<I64>&) { e FeEnt = FeEnt(v) }

fn main() ? {
    s FeSlot& = FeSlot(Vec<I64>())
    for i in range 3 {
        l := Vec<I64>()
        s = FeSlot(l)
    }
}
