# check: run
# flags: -debug -sanitize
# R8 (refusals question 1, the user's yes of 2026-11-08: "if the global holds something, the global never goes out of
# scope, therefore it's held in the global scope"): a lambda a global keeps captures what a by-value parameter's payload
# refers to - the callers' obligation that it live in the program's scope, so each turn's 'inner' is built there. It was
# refused ("a global holds only what lives as long as the program"); read back after a churn
import "std/io"
type Node struct(v I32) {
    v
}
type Box enum {
    Has(n Node&)
    No
}
GF mut fn?&() I32 = null
fn stash(b Box) {
    match b {
        case Box.Has(n) { GF = fn() { return n.v } }
        case _ { }
    }
}
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}
fn main() ? {
    for i in range 2 {
        inner Node& = Node(I32(40 + i))
        stash(Box.Has(inner))
        churn()
    }
    churn()
    try io.Println($GF!())
}
