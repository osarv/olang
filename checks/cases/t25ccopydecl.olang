# check: run
# T25c, QCE: a written type declares a writable value - a copy of an immutable global's Vec initializes one, a Vec of its
# own since 2026-11-01 (a handle's copy was read-only, and refused here)
import "std/io"
G Vec<I64> = Array<I64>[1].ToVec()
fn main() ? {
    y Vec<I64> = G
    y.Push(2)
    assert y.Len() == 2 and G.Len() == 1
    try io.PutLine($y.Len())
}
