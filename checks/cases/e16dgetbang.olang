# check: run
# E16d/E35: a checked index under '!' or a 'try' - the try covering it within a call's argument or an operator's operand
At mut I64 = 1
fn read(a Array<I64>&, i I64) I64 { return a.Get(i)! }
fn plusOne(a Array<I64>&, i I64) I64 ? { return try a.Get(i) + 1 }
fn guarded(a Array<I64>&, i I64) I64 { return try a.Get(i) catch ArrayError.OUT_OF_RANGE default -1 }
fn use(n I64) { }
fn stmt(a Array<I64>&, i I64) I64 {
    try use(a.Get(i)) catch ArrayError.OUT_OF_RANGE { return -5 }
    return 0
}
Baked I64 = guarded(I64[1, 2], 7) + stmt(I64[1], 4)
fn main() {
    a := I64[10, 20, 30]
    assert read(a, At) == 20 and (try plusOne(a, At) catch default 0) == 21 and (try plusOne(a, 9) catch default 0) == 0
    assert guarded(a, 9) == -1 and guarded(a, 2) == 30 and stmt(a, 9) == -5 and stmt(a, 0) == 0 and Baked == -6
}
