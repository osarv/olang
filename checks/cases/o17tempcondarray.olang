# check: fail this value's references live where its own storage does not, and the callee can store through it
# O17 (U2): a conditional of two built-in array elements, lent the same way
import "std/io"
fn churn() ? io.IoError {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { try io.Println("x") }
    }
}
type Node struct(v I64, next mut Node&) {
    v
    next
}
type Box struct() {
    head mut Node& = Node(0, null)
    tag I64 = 0
}
fn addVia(b Box&, v I64) { b.head.next = Node(v, b.head.next) }
fn sum(b Box&) I64 {
    t I64 = 0
    for n := b.head, n != null, n = n.next { t = t * 10 + n.v }
    return t
}
fn main() ? {
    a := Array<Box>(2, Box())
    a[1] = Box()
    for i in range 3 {
        addVia(a[0] if i >= 0 else a[1], i + 1)
        try churn()
    }
    try churn()
    try io.Println("a " $sum(a[0]))
}
