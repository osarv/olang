# check: run
# flags: -debug -sanitize
# E31b/O18c (F2): a handle in a value field of the element's value field, "f.Blocks[b].inner.S.Push(x)"
import "std/io"
type Blk struct() {
    S List<I64>
    t I64 = 0
}
fn churn() ? io.IoError {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { try io.Println("x") }
    }
}
type In struct() {
    S List<I64>
    u I64 = 0
}
type Blk2 struct() {
    inner In
    t I64 = 0
}
type F struct(K I64) {
    K
    Blocks List<Blk2>
}
fn add(f mut F&, b I64, x I64) { f.Blocks[b].inner.S.Push(x) }
fn main() ? {
    f := F(1)
    f.Blocks.Push(Blk2())
    add(f, 0, 7)
    try churn()
    assert f.Blocks[0].inner.S.Len() == 1 and f.Blocks[0].inner.S[0] == 7, $f.Blocks[0].inner.S
}
