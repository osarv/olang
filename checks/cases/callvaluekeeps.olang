# check: fail error[T22a, E31]: Keeper's Call relates its arguments' scopes, which a call through a function value cannot check
# T22a/E31: a value adapted through a Call that keeps its argument beyond the call is called through a function value,
# which checks nothing of it - refused as a lambda keeping its parameter is (PE1a)
type Node struct(v I64) {
    v
}
type Keeper struct() {
    kept fn() I64 = null
}
fn (k mut Keeper&) Call(x fn() I64) { k.kept = x }
fn keepVia(s fn(x fn() I64), g fn() I64) { s(g) }
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn fill(n Node&, kp mut Keeper&) {
    k := n.v
    keepVia(kp, fn() I64 { return n.v + k })
}
fn main() ? {
    n := Node(10)
    kp := Keeper()
    fill(n, kp)
    t := churn(300)
    println($kp.kept() " " $t)
}
