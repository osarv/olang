# check: fail error[G4]: type variable T of mk appears in no parameter's type, so the call writes it - mk<...>(...)
# G4: a type variable written only in the result is given by type arguments at the call - every "<T>" in a signature
# is in scope for all of it, which must not count as the variable appearing in a parameter
fn mk<T>(n I64) Array<T> { return Array<T>(n) }
fn main() ? {
  a Array<I32> = mk(3)
}
