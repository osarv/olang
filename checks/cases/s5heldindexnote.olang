# check: run
# R2 (refusals 5.2): compiles now - the rendered index held for At and SetAt built where 'm' lives (O28 through O10c);
# it was refused, as what follows says
# B11 (the review of study 5's fixes, F9): "m[$k ...] += v" holds the rendered key for At and SetAt in its block - the
# note says so, not "write '$' before it", which the key already is
type TMap struct() {
    keys Vec<String&> = Vec<String&>()
    vals Vec<I64> = Vec<I64>()
}
fn (m TMap&) At(k String&) I64 {
    for i in range m.keys.Len() {
        if m.keys[i] == k { return m.vals[i] }
    }
    return -1
}
fn (m mut TMap&) SetAt(k String&, v I64) {
    m.keys.Push(k)
    m.vals.Push(v)
}

fn main() ? {
    m := TMap()
    for k in range 3 { m[$k "-key"] += 100 }
    assert m.keys.Len() == 3 and m.keys[2] == "2-key" and m.vals[2] == 99
}
