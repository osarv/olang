# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O26a: a number computed from a line carries nothing into the result - but a function storing the line itself into the
# returned summary does, which flow by numbers does not see: the call is held to it (O10c), and the note's fix compiles
import "std/io"
type S struct() {
    best I64 = 0
    names Vec<String&> = Vec<String&>()
}
fn mk(i I64) String& { return "line " $i }
fn sneak(t String&, s mut S&) I64 {
    s.names.Push(t)
    return t.Len()
}
fn S.scan(n I64) S {
    s := S()
    for i in range n {
        line := mk(i)
        v := sneak(line, s)
        if v > s.best { s.best = v }
    }
    return s
}
fn main() ? { try io.PutLine($S.scan(3).names.Len()) }
