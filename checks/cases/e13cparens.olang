# check: run
# E13c: in parentheses, negated or as arithmetic of literals, a number written as a literal is a receiver of its own
# type (I64, F64); a minus sign before a call on one negates the call's result
fn main() ? {
    t := (255).Format(16)
    b := (-0.0).Bits()
    h := (1 + 2).Hash()
    assert t == "ff" and b == 0x8000000000000000 and h == I64(3).Hash()
    assert -2.0.Sqrt() == -(F64(2).Sqrt()) and (-2.0).Abs() == 2.0 and 255.Format(16) == t
    u := 18446744073709551615.Sqrt()
    assert u == 4294967295
}
