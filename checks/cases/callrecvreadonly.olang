# check: fail error[T25c]: a read-only reference cannot become writable
# T25c/E31: a Call writing its receiver, reached through a read-only reference, is no function value - calling it
# would write the instance through a reference that may not
type Counter struct() {
  n I32 = 0
}
fn (c mut Counter&) Call() I32 {
  c.n++
  return c.n
}
fn run(f fn() I32) I32 { return f() }
fn peek(c Counter&) I32 { return run(c) }
fn main() ? { }
