# check: fail error[O15, O16]: this value is held where its call lands, ended as that scope closes - after 'l'
# also: declare it by value first, 'x Grip = ...', and give the call that
# O15, O16 (bulk review 8, F2): a temporary given to a reference parameter is registered where its call lands and ended
# as that scope closes - after the block's variables; a call given it and a variable may make it hold the variable
type Tally struct() {
    n I64 = 0
}

type Lamp unique struct(id I64, log mut Tally&) {
    id, log
} destruct {
    log.n += id
}

type Grip unique struct(id I64) {
    id
    held Lamp?& = null
} destruct {
    if held is not null: held!.log.n += held!.id * 10
}

fn hold(g mut Grip&, l Lamp&) { g.held = l }

fn main() {
    t := Tally()
    l Lamp = Lamp(2, t)
    hold(Grip(1), l)
}
