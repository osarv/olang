# check: run
# flags: -debug -sanitize
# O15, O16 (docs/refusals.md 5.6, R7; refused until call 8 of 2026-11-08): a temporary given writably to a call standing
# as a statement is a hidden holder of the statement's block - QCZ's order ends it before the variable the call made
# it hold
import "std/io"
type Tally struct() {
    n I64 = 0
}

type Lamp unique struct(id I64, log mut Tally&) {
    id, log
    alive := true
} destruct {
    log.n += id
    alive = false
}

type Grip unique struct(id I64) {
    id
    held Lamp?& = null
} destruct {
    if held is not null {
        assert held!.alive, "a Grip read its Lamp ended"
        held!.log.n += held!.id * 10
    }
}

fn hold(g mut Grip&, l Lamp&) { g.held = l }

fn run(t mut Tally&) {
    l Lamp = Lamp(2, t)
    hold(Grip(1), l)
    assert t.n == 0
}

fn main() ? {
    t := Tally()
    run(t)
    assert t.n == 22
    try io.Println("n " $t.n)
}
