# check: fail error[O38]: this argument borrows an own object, and the callee may keep it beyond the call
# O38: ...nor kept by a call (own5 F2)
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn main() ? {
    l := List<Outer&>()
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    l.Push(v)
    io.Println($l[0].o.k)
}
