# check: fail error[C2d]: this instance holds a reference to an argument it would outlive - make the argument where the instance goes, or the instance where the argument lives ('T&x(...)')
# a constructor's field set from a field read through its parameter, the instance kept past what that field refers
# to: must fail
import "std/io"
type Node struct(t String&) { t }
type H struct() {
    kid mut Node?& = null
}
type W struct(h mut H&) {
    inner mut Node& = h.kid!
}
fn main() ? {
    h0 := H()
    w := W(h0)
    {
        h := H()
        x := $5 "abc"
        h.kid = Node(x)
        w = W(h)
    }
    a := Array<I64>(64, 9)
    try io.Println($w.inner.t " " $a[0])
}
