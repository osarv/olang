# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# a constructor's field set from a field read through its parameter, the instance kept past what that field refers
# to: must fail
import "std/io"
type Node struct(t String&) { t }
type H struct() {
    kid mut Node?& = null
}
type W struct(h mut H&) {
    inner mut Node& = h.kid!
}
fn main() ? {
    h0 := H()
    h0.kid = Node("z")
    w := W(h0)
    {
        h := H()
        x := $5 "abc"
        h.kid = Node(x)
        w = W(h)
    }
    a := Array<I64>(64, 9)
    try io.PutLine($w.inner.t " " $a[0])
}
