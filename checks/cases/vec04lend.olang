# check: fail error[M19g]: this view of 'v' is given to 'grow', which may grow 'v'
# a Vec's view lent to a callee that grows the same Vec
# M19g, round 2 (brought back from round 1's deletion): the same Vec is seen on both sides, so the view is refused
import "std/io"
fn grow(v mut Vec<I64>&, d Array<I64>&) I64 {
    for i in range 100 { v.Push(i) }
    return d[0]
}
fn main() ? {
    v := Vec<I64>()
    v.Push(4)
    try io.Println($grow(v, v.View()))
}
