# check: run
# flags: -debug -sanitize
# S21, O16 (docs/refusals.md 5.5; refused - "an instance is built in one of them whose destructor would run then" -
# until the user's "Yes, do A" of 2026-11-08): an enum whose case holds a reference to an instance with a destructor,
# given by a call in a block a become closes, is built in the chain's tail scope and ended as it closes
import "std/io"

type Res unique struct(n I64) { n } destruct { io.Println("destroy " $n)! }

type Slot enum { Full(r Res&), Empty }

fn Slot.mk(n I64) Slot { return Slot.Full(Res(n)) }

fn size(s Slot) I64 { return 1 if s == Slot.Full else 0 }

fn f(n I64) I64 {
    if n == 0: return 0
    if size(Slot.mk(n)) > 0 {
        become f(n - 1)
    }
    return n
}

fn main() { io.Println("result " $f(2))! }
