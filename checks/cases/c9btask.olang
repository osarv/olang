# check: fail error[C9b]: 't.Destroy()' needs 't' to be the only way left to reach its instance
# C9b: a task given the instance may still use it after the Destroy()
type Res struct(id I64) {
    id
} destruct {
    Closed += 1
}
Closed mut I64 = 0
fn show(r Res&) { assert r.id == 6 }
fn main() {
    t := Res(6)
    join {
        spawn show(t)
    }
    t.Destroy()
}
