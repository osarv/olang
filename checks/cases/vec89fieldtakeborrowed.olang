# check: fail error[O39]: taking 'l.toks' moves the Array<I64> borrowed on line 10
# Vec phase 2a (E34/O39): a field's Vec is not taken while a borrow of its buffer is used
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn main() ? {
    l := Lexer(3)
    for i in range 3 { l.toks.Push(i) }
    d := l.toks.View()
    t := take l.toks
    try io.Println($d[0] " " $t.Len())
}
