# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O26a: a local holding no reference follows a flow into what is returned only - text stored into a parameter's field
# still lives in its block, which the parameter's referent outlives
import "std/io"
type Holder struct() {
    name String& = ""
}
fn put(p mut Holder&) {
    a := "alpha" $3
    p.name = a
}
fn main() ? {
    h := Holder()
    put(h)
    try io.PutLine($h.name)
}
