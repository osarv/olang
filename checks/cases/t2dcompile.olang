# check: fail error[S17a]: a top-level assert is decided while compiling, and this one cannot be: it reads a weak place whose referent no owning place holds, which the running program may read as null (t2dcompile.olang:22) - assert it in a function or a test, where it is checked at run time
# K1, T2d: the evaluator decides a weak read only while an owning place holds its node; a node let go of is read as
# null by the running program, and never guessed while compiling - the read is left to the run time
type Node struct(v I64) {
    v
    next mut Node?& = null
    prev weak mut Node?& = null
}

type Chain struct() {
    head mut Node?& = null
}

fn gone() Bool {
    c := Chain()
    h := Node(1)
    c.head = h
    h.next = Node(2)
    n := h.next!
    n.prev = h
    c.head = null
    return n.prev is null
}

assert gone()

fn main() {
    assert gone()
}
