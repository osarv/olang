# check: fail error[C9b]: 'd' is used after 'd.Destroy()' (line 12)
# C9b: the local is not read after its Destroy() - its instance is gone
type Res struct(id I64) {
    id
} destruct {
    Closed += 1
}
Closed mut I64 = 0
fn main() {
    d := Res(4)
    n := d.id
    d.Destroy()
    assert n + d.id == 8
}
