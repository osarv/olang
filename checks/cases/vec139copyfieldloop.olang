# check: fail error[O32]: 'c.b' belongs to what 't' was copied from - assign it there
# also: error[O32]: 'c.a' belongs to what 't' was copied from
# L1: in a loop it grew without bound
import "std/io"
type X struct(k I64) {
    k
    text String& = "x" $k "-text-of-x-object"
}
type Lexer struct(n I64) {
    n
    o own mut X& = X(n)
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn main() ? {
    t := Two()
    for i in range 20000 {
        c := t
        c.a = Lexer(7)
        c.b = Lexer(8)
    }
    try io.Println(t.a.o.text)
}
