# check: run
# R4 (refusals 5.4): compiles now - the lambda a task calls through is built at the join's level, one per turn; it was
# refused, as what follows says
# P2: a lambda made inside the join block lives in the block it was made in - a task calling through it could
# outlive it
import "std/io"
extern fn usleep(us U32) I32
fn main() ? {
    out mut Array<I32>& = Array<I32>(4)
    join {
        for i in range 4 {
            w := fn(t mut Array<I32>&) {
                usleep(20000)
                t[i] = I32(i + 1)
            }
            spawn w(out)
        }
    }
    try io.Println($out[0] " " $out[1] " " $out[2] " " $out[3])
}
