# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# C2d/O23: a field written '&p' lives where its argument did - unknown through an element of an array, where only its
# container's scope is known, an underestimate a local would wrongly claim as its own
type N struct(v I32, nx mut N&) {
    v
    next mut N& = nx
}
type Cur struct(of mut N&) { at mut N& = of }
fn fill(cs Array<mut Cur&>&) I32 {
    x := cs[0].at
    return x.v
}
fn main() ? { }
