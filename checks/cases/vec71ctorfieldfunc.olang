# check: fail error[C2d]: this instance holds a reference to an argument it would outlive
# vec5 (r2a_ctor_field_no_own_function): the same instance made through a function - the function's result keeps its
# argument (C2d, O10c)
import "std/io"
type H struct(x String&, n I64) {
    y String&x = $n "-new-text-in-x's-scope"
}
fn mk(p String&) H { return H(p, 5) }
fn main() ? {
    h := mk("outer")
    for i in range 2 {
        t := $i "-inner-block-text"
        h = mk(t)
    }
    churn()
    io.Println(h.y)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
