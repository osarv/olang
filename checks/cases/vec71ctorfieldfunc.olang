# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# vec5 (r2a_ctor_field_no_own_function): the same instance made through a function - the function's result keeps its
# argument (C2d, O10c)
import "std/io"
type H struct(x String&, n I64) {
    y String& = $n "-new-text-in-x's-scope"
}
fn H.mk(p String&) H { return H(p, 5) }
fn main() ? {
    h := H.mk("outer")
    for i in range 2 {
        t := $i "-inner-block-text"
        h = H.mk(t)
    }
    churn()
    try io.PutLine(h.y)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
