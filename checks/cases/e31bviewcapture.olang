# check: fail x[i] gives a copy of the element, which this call would write
# E31b: the parameter captured by a lambda - what the lambda does with it is not followed
import "std/io"
type V struct(d mut Array<I64>&, n I64) {
    d
    n
}
type Vs struct(d mut Array<I64>&) {
    d
}
fn (s Vs&) At(i I64) V { return V(s.d, i) }
fn f(v mut V&) {
    g := fn() I64 { return v.n }
    try io.Print($g()) catch io.Error { }
}

fn main() ? {
    s := Vs(Array<I64>(4))
    f(s[0])
}
