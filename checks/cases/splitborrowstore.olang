# check: run
# R1 (refusals 5.1): compiles now - a split value lent where its references live, its own storage lifted there where
# the callee keeps it (O17b generalized); it was refused, as what follows says
# O17a: a read-only reference too - what is read through it (a writable "mut Node&" field) is taken to live where the
# copy does, so a node built through it would be built in the copy's block
import "std/io"
type Node struct() {
    next mut Node?& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
}
type W struct(b Box) { b }
fn readOnly(src mut W&) {
    b := src.b
    br Box& = b
    n := br.head
    n.next = Node()
}
fn main() ? {
    w := W(Box())
    readOnly(w)
    try io.PutLine($w.b.head.v)
}
