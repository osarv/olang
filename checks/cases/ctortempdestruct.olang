# check: run
# flags: -s
# C11/O16: every constructor call of a type declaring a destructor is one instance, destructed once when the scope it
# was built in closes - a call standing as a statement, read through, rendered, passed, stored, kept in a conditional
# or pushed alike (the first three were never destructed), and an instance a conditional or a match chooses, or one passed
# to a generic's bare type variable, once (they were destructed twice)
type Node struct(v I64) {
    v
}
Count mut I64 = 0
type Wrap struct(a Node&) {
    a
} destruct { Count++ }
type Box struct(w Wrap&) {
    w
}
fn take(w Wrap&) I64 { return w.a.v }
fn id(x <T>) T { return x }
fn kept(x <T>) T {
    y := x
    return y
}
fn main() ? {
    local := Node(42)
    {
        Wrap(local)
        k := Wrap(local).a.v
        s := $Wrap(local)
        w Wrap& = Wrap(local)
        x := Wrap(local)
        b := Box(Wrap(local))
        n := take(Wrap(local))
        c := k == 42
        y Wrap& = Wrap(local) if c else Wrap(local)
        z := (Wrap(local) if c else Wrap(local)).a.v
        l := List<Wrap&>()
        l.Push(Wrap(local))
        g := id(Wrap(local))
        id(Wrap(local))
        h := kept(Wrap(local))
        m := match k {
            case 42 => Wrap(local)
            nomatch => Wrap(local)
        }
        t := take(Wrap(local) if c else Wrap(local))
        assert Count == 0
        assert k + n + z == 126 and s == "Wrap(Node(42))"
    }
    assert Count == 15
}
