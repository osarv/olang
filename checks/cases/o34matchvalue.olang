# check: fail error[O34]: a conditional's or a match's values own objects (Outer), and one is chosen by copying it
# O34 (own6 N2): so does a match whose values are owner value locals
import "std/io"
type Inner struct(k I64) {
    k
}
type Outer struct() {
    o own mut Inner&
}
fn pick(k I64) I64 {
    v := Outer()
    v.o = Inner(3)
    w := Outer()
    r mut Outer& = match k {
        case 1 => v
        case _ => w
    }
    r.o = null
    return 0 if v.o == null else v.o.k
}
fn main() ? {
    io.Println($pick(1))
}
