# check: fail CheckedMinus is Minus's checked form, so it fails with every error Minus can - add MoneyError
# E31a: a checked form only adds checks, so its errors include every error its plain form can fail with
error MoneyError {
    NEGATIVE
}
type Money struct(c I64) {
    c
}
fn (a Money&) Minus(b Money&) Money ? MoneyError {
    if b.c > a.c { error MoneyError.NEGATIVE }
    return Money(a.c - b.c)
}
fn (a Money&) CheckedMinus(b Money&) Money ? CheckError { return Money(checked (a.c - b.c)) }
fn main() { }
