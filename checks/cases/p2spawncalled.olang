# check: run
# R4 (refusals 5.4): compiles now - the lambda called where it is spawned and what it captured are built at the join's
# level, one per turn; it was refused, as what follows says
# P2/D16e: a lambda called where it is spawned is the spawned lambda with arguments - capturing a loop body's reference
# it is refused exactly as "spawn fn() { ... }" is
import "std/io"
extern fn usleep(us U32) I32
type Node struct(v I32) {
    v
}
fn main() ? {
    total mut Array<I32>& = Array<I32>(4)
    join {
        for i in range 4 {
            n Node& = Node(I32(i * 10))
            spawn fn(k I32) {
                usleep(20000)
                total[i] = n.v + k
            }(1)
        }
    }
    try io.PutLine($total[0] " " $total[1] " " $total[2] " " $total[3])
}
