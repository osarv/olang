# check: fail error[T2c]: String?& may be null, so it meets no trait
# T2c (bulk review 6 F12, F14): a reference that may be null meets no trait - said at the program's call, not in the
# prelude's Map where its key is hashed
fn main() {
    m := Map<String?&, I64>()
    z String?& = null
    m.Put(z, 1)
    assert m.Len() == 1
}
