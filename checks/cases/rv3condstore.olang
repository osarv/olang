# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# O12: a value copied from a conditional whose values' references live in different scopes keeps them in one not known
# here - nothing new is built into it
type Node struct() {
    next mut Node?& = null
}
type Box struct() {
    head mut Node& = Node()
}
fn f(c Bool, r mut Box&) {
    l mut Box& = Box()
    d Box = r if c else l
    d.head = Node()
}
fn main() ? {
}
