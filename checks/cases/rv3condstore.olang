# here - nothing new is built into it
type Node struct() {
    next mut Node& = null
}
type Box struct() {
    head mut Node& = Node()
}
fn f(c Bool, r mut Box&) {
    l mut Box& = Box()
    d Box = r if c else l
    d.head = Node()
}
fn main() ? {
}
