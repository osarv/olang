# check: fail error[T25c, O14]: a built result is new storage and writable, and this reference is read-only - borrow it: 'Item&l'
# T25c/O14: returning an element read through a parameter from a built result ("Item&") - no "mut" was written to drop;
# the result is to be borrowed from the parameter
import "std/io"
type Item struct(name String&) { name }
fn first(l Vec<Item&>&) Item& {
    return l[0]
}
fn main() ? {
    l := Vec<Item&>()
    l.Push(Item("a"))
    try io.Println(first(l).name)
}
