# check: fail error[T22a]: 'hang' ties where what it is given lives to what it keeps or gives back, and this argument holds only what its written function type says of every call
# T22a: hang requires b to outlive a, which a call through a function value would never check
type Node struct(v I32) {
    v
    next mut Node?& = null
}
fn hang(a mut Node&, b Node&) {
    a.next = b
}
fn apply(f fn&(a mut Node&, b Node&), a mut Node&, b Node&) {
    f(a, b)
}
type E error { X }
fn main() ? E {
    a mut Node& = Node(1)
    b Node& = Node(2)
    apply(hang, a, b)
}
