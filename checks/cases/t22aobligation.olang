# check: fail error[T22b]: 'hang' keeps 'b' in 'a', and the function type of this argument says nothing of that - write 'keeps b in a' after its signature
# T22a: hang requires b to outlive a, which a call through a function value would never check
type Node struct(v I32) {
    v
    next mut Node?& = null
}
fn hang(a mut Node&, b Node&) {
    a.next = b
}
fn apply(f fn&(a mut Node&, b Node&), a mut Node&, b Node&) {
    f(a, b)
}
type E error { X }
fn main() ? E {
    a mut Node& = Node(1)
    b Node& = Node(2)
    apply(hang, a, b)
}
