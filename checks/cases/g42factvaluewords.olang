# check: build
# G42: a call through a function value does what its type promises - here no allocation - so Apply allocates nothing
# (g42factvalue's twin, its parameter's type writing the word)
fn Apply(f fn&(x I64) I64 noalloc, x I64) I64 { return f(x) }

assert not Apply.Allocates, "f promises noalloc"
assert Apply.Blocks, "and nothing else"

fn main() { assert Apply(fn(x I64) I64: return x, 1) == 1 }
