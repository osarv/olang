# check: fail error[T13b]: 'f' is handed on here, and File is unique
# T13b: a by-value parameter hands its value on once, at its last mention - reading it after reads what is held elsewhere
type File unique struct(fd I32) { fd }
type Box struct(f File) { f }
fn boxed(f File) I32 {
    b := Box(f)
    return f.fd + b.f.fd
}
fn main() { assert boxed(File(3)) == 6 }
