# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# E28/O12/O25c (the batch 6 review): ...an element of an array literal kept outside the loop
import "std/io"
fn main() ? {
    outer String& = "outer"
    keep Array<String&>& = Array<String&>[""]
    for i in range 2 {
        x String& = "w" $i
        keep = Array<String&>[x if i == 1 else outer]
    }
    try io.Println(keep[0])
}
