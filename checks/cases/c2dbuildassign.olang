## C2d/O23: a field written '&p' lives where its argument did, unknown to a function given the container
type N struct(v Int32, nx N&) {
    v
    next mut N& = nx
}
type Cur struct(of N&) { at mut N&of = of }
fn fill(c mut Cur&) { c.at.next = N(9, null) }
fn main() ? { }
