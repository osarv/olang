# check: fail error[O38]: this argument borrows an own object, and the callee may keep it beyond the call
# O38: ...a Map.Put
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    m := Map<I64, Outer&>()
    m.Put(1, b)
    v.o = null
    for e in m { io.Println($e.Value.o.k) }
}
