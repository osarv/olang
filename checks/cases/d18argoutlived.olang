# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# D18b: a generator holds its arguments for as long as it is walked - it may not outlive them
fn chars(t String&) Iterator<Char> {
    for c in t { yield c }
}

fn main() ? {
    g := chars("init")
    {
        s := $5 "abc"
        g = chars(s)
    }
    for _ in g {
    }
}
