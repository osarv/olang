# check: fail error[O34]: 'take' gives an owner, which only an own slot receives
# an owner taken out of its slot goes into another own slot, never into a plain reference
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn show(c Conn&) { println($c.fd) }
fn main() ? {
    s := Server()
    s.cur = Conn(1)
    show(take s.cur)
}
