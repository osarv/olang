# check: run
# flags: -debug -sanitize
# T22c (was a T22b refusal), G16a: keep gives back what it was given - followed into it, its result holds 'link', so
# f(x, N(5)) is judged as link's direct call (N(5) built where x lives); 'copy' needs nothing followed
type N struct(v I64) {
    v
    next N?& = null
}
fn link(a mut N&, b N&) { a.next = b }
fn copy(a mut N&, b N&) { a.v = b.v }
fn keep<F>(f F) F { return f }

# storage made and let go many times, so a value kept in a scope already closed would read another's
fn churn(n I64) I64 {
    t := 0
    for i in range n {
        v := Vec<N>()
        for j in range 16 { v.Push(N(i * j)) }
        t += v[15].v
    }
    return t
}

fn main() {
    g := keep(copy)
    f := keep(link)
    x mut N& = N(1)
    f(x, N(5))
    g(x, N(6))
    t := churn(200)
    assert x.next!.v == 5 and x.v == 6 and t > 0
}
