# check: run
# O17: the over-rejection derivedhelpercount pins for a List, met through a Vec until 2026-11-01 (Indexable's IndexIter
# held the Vec's record in an "&p" field) - a Vec a value since, its walk's callback reading what it is given builds
import "std/io"
type Bag struct() {
    items Vec<I64>& = Vec<I64>()
}
fn main() ? {
    bags := Vec<Bag&>()
    bags.Push(Bag())
    assert bags.Iter().Count(fn(b) { return b.items.Len() == 0 }) == 1
    try io.Println("")
}
