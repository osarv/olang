# check: run
# R1 (refusals 5.1, with 5.2's shape): compiles now - the case a reference local is declared with proposes its claim
# where x lives, and y, fitted exactly there, is built there too; it was refused, as what follows says
# T17c/O25: two writable payload references must both live exactly where the value does, so they cannot come from two
# different blocks
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type Link enum {
    Two(a mut Node&, b mut Node&)
}
fn main() ? {
    x mut Node& = Node(1)
    if TargetOs == "linux" {
        y mut Node& = Node(2)
        l Link& = Link.Two(x, y)
        match l {
            case Link.Two(a, b) { assert a.v + b.v == 3 }
        }
    }
}
