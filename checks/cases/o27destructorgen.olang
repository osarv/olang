# check: run
# flags: -debug -sanitize
# never: error[O10c]
# C4, O27 as placement, O15, D18c (docs/fnvalues.md section 10; it was refused in the generator - "this keeps a view of
# 'f', whose destructor runs when its block ends"): a generator yielding views of a local that holds a value with a
# destructor, and a consumer keeping them - each turn's 'f' is built where the generator lives and ended as that scope
# closes, after the consumer read the views (after a churn, under the scope sanitizer)
import "std/io"
type Res unique struct(n String&) {
    name := $n
} destruct { io.Println("end " $name)! }
fn names(n I64) Iterator<String&> {
    for i in range n {
        f := Res($i "-file")
        yield f.name[0:1]
    }
}
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}
fn main() {
    out := Vec<String&>()
    for w in names(3) { out.Push(w) }
    churn()
    io.Println($out)!
}
