# check: fail error[T13d]: Node is generational - a weak reference names it - so its values are held only by reference: write 'Node&' here
# T13d: a local laid out for a generational value
type Node struct(v I64) {
    v
    next mut Node?& = null
    prev weak Node?& = null
}
fn main() {
    n Node = Node(1)
    assert n.v == 1
}
