# check: run
# flags: -debug -sanitize
# S21, O16 (docs/refusals.md 5.5; refused - "it holds a value of Res&, which may hold an instance whose destructor would
# run then" - until the user's "Yes, do A" of 2026-11-08): each step's instance is built in the chain's tail scope and
# ended as that scope closes, last made first - the order "return f(n - 1)" ends them in - after main used the result
import "std/io"
type Res unique struct(n I64) {
    n
} destruct {
    io.Println("closed " $n)!
}
fn f(n I64) I64 {
    r := Res(n)
    if n == 0: return r.n
    become f(n - 1)
}
fn main() {
    {
        assert f(2) == 0
        io.Println("used")!
    }
    io.Println("after")!
}
