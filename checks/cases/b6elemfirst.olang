# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O18c (the batch 6 review): ...through what a List's First hands back
type Cell struct() {
    s String& = ""
}
fn main() ? {
    cells mut Vec<mut Cell&>& = Vec<mut Cell&>()
    cells.Push(Cell())
    for i in range 3 {
        x String& = "w" $i
        (try cells.First()).s = x
    }
}
