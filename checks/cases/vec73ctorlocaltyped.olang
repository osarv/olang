# check: fail error[C2d]: this instance would outlive what its '&p' field refers to
# vec5 (r2a_ctor_local_typed_no_own): the text built in a constructor local typed in a parameter's scope, then the field
# given that local
import "std/io"
type H struct(x String&, n I64) {
    t String&x = $n "-new-text-in-x's-scope"
    y := t
}
fn main() ? {
    h := H("outer", 1)
    for i in range 2 {
        s := $i "-inner-block-text"
        h = H(s, 5 + i)
    }
    churn()
    io.Println(h.y)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
