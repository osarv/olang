# check: run
# flags: -sanitize
# P2: a temporary argument is built in the join block, holding a reference to a loop body's array - refused while the
# array closed with the turn, while the task might still read it; since item 17 the array is built where the temporary
# keeping it is (the join block), one each turn, so each task reads its own
type W struct(a Array<I64>&) {
    a
}
fn total(w W&) I64 {
    t I64 = 0
    for x in w.a { t += x }
    return t
}
fn main() ? {
    out := Array<I64>(4)
    join {
        for i in range 4 {
            a := Array<I64>(1000, i + 1)
            spawn out[i] = total(W(a))
        }
    }
    assert out[0] == 1000 and out[1] == 2000 and out[2] == 3000 and out[3] == 4000
}
