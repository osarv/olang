# check: fail error[O41]: assigning 's.cur' may release the Node the task spawned on line
# a task borrowing through the holder it is handed, its use ordered after the spawner's release by channels
import "std/chan"
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn work(h Holder&, a mut chan.Chan<I64>&, b mut chan.Chan<I64>&) {
    c := h.cur
    chan.Send(a, 1)
    k := try chan.Recv(b) catch { return }
    io.Println(c.name)
}
fn main() ? {
    s := Holder()
    s.cur = Node(3)
    a := chan.Chan<I64>(1)
    chan.Init(a)
    b := chan.Chan<I64>(1)
    chan.Init(b)
    join {
        spawn work(s, a, b)
        k := try chan.Recv(a) catch { return }
        s.cur = null
        chan.Send(b, 1)
    }
}
