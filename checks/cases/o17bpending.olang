# check: fail error[O17]: this value's references live where its own storage does not, and the callee can store through it
# O17b: a lend decided while the callee's body was still being checked (g calls f, which lends a handle copy to g) is
# taken on trust and verified once every body is checked - g keeps the handle, so the call is O17's error
type Cell struct() {
    v I64 = 0
    kept mut Box& = null
}
type Box struct() { c mut Cell& = Cell() }
fn g(h mut Box&, m mut Map<I64, Box>&, n I64) ? {
    h.c.kept = h
    if n > 0 { try f(m, n - 1) }
}
fn f(m mut Map<I64, Box>&, n I64) ? {
    b := try m.Get(1)
    try g(b, m, n)
}
fn main() ? {
    m := Map<I64, Box>()
    m.Put(1, Box())
    try f(m, 3)
}
