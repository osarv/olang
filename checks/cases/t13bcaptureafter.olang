# check: fail error[T13b]: 't' is handed on here, and
# T13b (bulk review 7, F16): a lambda capturing a by-value parameter (a borrow, D16c), called after the parameter's
# value was handed on
Ended mut I64 = 0

type Res unique struct(id I64) {
    id
} destruct { Ended++ }

type Holder struct(r Res) {
    r
}

fn keep(t Res) I64 {
    f := fn() I64 { return t.id }
    h Holder = Holder(t)
    return f() + h.r.id
}

fn main() { assert keep(Res(1)) == 2 }
