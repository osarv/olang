# check: fail error[O41]: calling 'drop' may release the Node the task spawned on line
# a call releasing, in a join block after a task borrowing the same
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn work(h Holder&) {
    c := h.cur
    io.Println(c.name)
}
fn drop(h mut Holder&) { h.cur = null }
fn main() ? {
    s := Holder()
    s.cur = Node(1)
    join {
        spawn work(s)
        drop(s)
    }
}
