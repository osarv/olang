# check: run
# flags: -debug -sanitize
# T30c, O28: "keeps n" relied on - a call through the "any" holds n to outlive the instance, so a node of an inner block
# is built where the instance lives: read back after storage was made and let go many times
type aNode struct(v I64) { v }
type aSink trait {
    mut Put(n aNode&) keeps n
}
type aBag struct() {
    last aNode?& = null
}
fn (b mut aBag&) Put(n aNode&) { b.last = n }
fn put(x mut any aSink&, n aNode&) { x.Put(n) }
fn main() {
    b := aBag()
    {
        n := aNode(4)
        put(b, n)
    }
    churn(100)
    assert b.last!.v == 4
}

fn churn(n I64) I64 {
    t := 0
    for i in range n {
        v := Vec<aNode>()
        for j in range 16 { v.Push(aNode(i * j)) }
        t += v[15].v
    }
    return t
}
