# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O18c (the batch 6 review): ...through a program's own generic At giving its element type
type Cell struct() {
    s String& = ""
}
type Bx<T> struct() {
    l mut Vec<T>& = Vec<T>()
}
fn (c Bx<T>&) At(i I64) T {
    return c.l[i]
}
fn main() ? {
    cells mut Bx<mut Cell&>& = Bx<mut Cell&>()
    for _ in range 3 { cells.l.Push(Cell()) }
    for i in range 3 {
        x String& = "w" $i
        cells[i].s = x
    }
}
