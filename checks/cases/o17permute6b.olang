# check: fail error[O17]: this value's references live where its own storage does not, and the callee can store th
# O17 (Vec phase 1): a callee lent a split value only permutes its elements - ...the same function value handed in from outside is a store from outside
type N2 struct(v I64) {
    v
    next mut N2& = null
}
type Rec struct(name String&, n I64) {
    name
    n
}
type RecN struct(nd mut N2&) {
    nd
}
type H struct() {
    arr Array<Rec> = Array<Rec>(3)
    ns Array<RecN> = Array<RecN>(2)
}
fn mkText(k I64) String& { return "t" $k }
fn setName(r mut Rec&, s String&) { r.name = s }
fn each(a mut Array<RecN>&, g fn(x RecN)) {
    for i in range a.Len() { g(a[i]) }
}
fn run(h mut H&, g fn(x RecN)) {
    ns := h.ns
    each(ns, g)
}
fn main() ? {
    h mut H& = H()
    run(h, fn(x RecN) { if x.nd != null { x.nd.next = N2(5) } })
}
