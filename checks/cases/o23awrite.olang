# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O23a: a method writing a field written "&of" of its receiver is held to where the receiver's argument bound that field,
# not to where the receiver lives - so a node from the iterator's own block cannot be put where the outer box's
# storage is expected, which a later read of bi.cur from that outer scope would take it for
type Node struct(v I64) {
    v
}
type Box struct() {
    n I64 = 0
}
type Cursor struct(of Box&) {
    box Box& = of
    cur mut Node?& = null
}
fn (c mut Cursor&) Set(n mut Node&) { c.cur = n }
fn main() ? {
    ws Box& = Box()
    for i in range 3 {
        bi mut Cursor& = Cursor(ws)
        n mut Node& = Node(i)
        bi.Set(n)
    }
}
