# check: fail error[C2d]: this instance holds a reference to an argument it would outlive
# C2g, D16d (the unpar review's neighbours): a constructor field's lambda captures a by-value parameter holding a
# reference, which lives with what it refers to - a node made in an inner block - so the instance kept outside it is
# refused
type Box struct(v I64) {
    v
}
type W struct(h Box&) { h }
type M struct(w W) {
    F fn() I64 = fn() I64 { return w.h.v }
}

fn main() {
    m := M(W(Box(1)))
    if m.F() == 1 {
        b := Box(5)
        m = M(W(b))
    }
    assert m.F() == 5
}
