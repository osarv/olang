# check: fail error[E11c, O12]: '$' does not say where a value it renders lives, so Str builds and stores nothing where its receiver reaches
# E11c/O12: the same with a spawned lambda capturing the node (D16e): refused
type Node struct(v I64, next mut Node&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&) {
    head
}
fn peek(n Node&) I64 {
    join { spawn fn() { println($n.v) } }
    return n.v
}
fn (b Bag&) Str() String {
    return $peek(b.head)
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    println(s)
}
