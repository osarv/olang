# check: run
# R1 (refusals 5.1): compiles now - a split value lent where its references live, its own storage lifted there where
# the callee keeps it (O17b generalized); it was refused, as what follows says
# E31b/O17 (the second review of the view lend, F1): a struct value field of x[i] lent to a view callee that builds
# through a reference of it - its hidden copy's references are where the collection's are, so it is O17's split lend, as
# the whole element is
import "std/io"
type Node struct(v I64, next mut Node?&) {
    v
    next
}
type M struct(r mut Node&, off I64) {
    r
    off
}
type Layer struct(w M, n I64) {
    w
    n
}
fn g(m mut M&, v I64) { m.r.next = Node(v, null) }
fn churn() ? io.Error {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { try io.Println("x") }
    }
}
fn main() ? {
    l := Vec<Layer>()
    l.Push(Layer(M(Node(1, null), 0), 0))
    for i in range 3 { g(l[0].w, i + 10) }
    try churn()
    try io.Println($l[0].w.r.next!.v)
}
