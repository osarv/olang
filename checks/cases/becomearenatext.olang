# check: run
# flags: -debug -sanitize
# S21 (docs/refusals.md 5.5; refused - "this argument is storage made in one of them" - until the user's "Yes, do A" of
# 2026-11-08): text rendered at a become and handed to a by-value type variable is built in the chain's tail scope
import "std/io"

fn walk<T>(a T, n I64) String {
    if n == 0: return $a
    become walk($n " text " $a, n - 1)
}

fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}

fn main() {
    r := walk("abc", 2)
    churn()
    io.Println(r)!
}
