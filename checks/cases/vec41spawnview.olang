# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# vec3 F3: a spawn target set from a task's borrowed own result keeps it past the join - the call's own loan, not an
# argument's
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn grow(w mut Vec<I64>&) ? io.IoError {
    d Array<I64>&w = null
    join {
        spawn d = w.View()          # the task's call gives a borrowed own result into d
    }
    for i in range 1000 { w.Push(i + 100) }   # frees the buffer d views: not refused
    churn()
    try io.Println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    try grow(v)
}
