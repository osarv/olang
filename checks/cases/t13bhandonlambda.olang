# check: run
# flags: -debug -sanitize
# T13b, O8d: a lambda taking a unique value owning storage by value and storing it keeps its own copy - it is called
# through a function value, whose caller can meet no obligation (T22a) - while a function called directly moves it, the
# argument built where the value is kept; both read back after the arena churned
import "std/io"

type Buf unique struct(n I64) {
    n
    data := Array<I64>(n % 5 + 3, n)
}

fn churn() I64 {
    t I64 = 0
    for i in range 100 {
        a := Array<I64>(64, -7)
        t += a[i % 64]
    }
    return t
}

fn feed(f fn&(b Buf), n I64) {
    for i in range n { f(Buf(i + 10)) }
}

fn keepIt(v mut Vec<Buf>&, b Buf) { v.Push(b) }

fn main() {
    v := Vec<Buf>()
    vr mut Vec<Buf>& = v
    keep := fn(b Buf) { vr.Push(b) }
    feed(keep, 20)
    for i in range 10 { keepIt(v, Buf(i)) }
    churn()
    t := 0
    for b in v { t += b.data[0] + b.data.Len() }
    io.Println($t " " $v.Len())!
}
