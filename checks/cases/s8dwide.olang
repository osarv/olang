# check: run
# S8d: every narrowing place reads one walk - a case test narrows where a null test does: the right of "and" and "or",
# a conditional's values, after an assert, a loop's body and post clause, after a loop with no break, and in
# conditions built of them; an error value's test (T20) narrows in the same places
type Shape enum {
    Circle(r I64)
    Rect(w I64, h I64)
    Dot
}
type AErr error { X, Y }
type BErr error { Z }
type Both error AErr, BErr

fn big(e Shape) Bool { return e == Shape.Circle and e.r > 1 }
fn small(e Shape) Bool { return e != Shape.Circle or e.r < 2 }
fn area(e Shape) I64 { return e.w * e.h if e == Shape.Rect else 0 }
fn round(e Shape) I64 { return 0 if e != Shape.Circle else e.r }
fn width(e Shape) I64 {
    assert e == Shape.Rect
    return e.w
}
fn both(a Shape, b Shape) I64 {
    if a == Shape.Circle and not (b != Shape.Rect) { return a.r + b.w }
    return -1
}
fn walk(e Shape) I64 {
    total := 0
    for e == Shape.Circle {
        total += e.r
        e = Shape.Rect(e.r, 1) if e.r > 3 else Shape.Circle(e.r + 1)
    }
    return total
}
fn until(e Shape) I64 {
    for e != Shape.Rect {
        e = Shape.Rect(2, 5)
    }
    return e.h
}
fn three(e Shape) I64 {
    n := 0
    for i := 0, e == Shape.Circle and i < 10, i += e.r {
        n++
    }
    return n
}
fn onlyA(x AErr) I64 { return 1 if x == AErr.X else 2 }
fn which(e Both) I64 { return onlyA(e) if e == AErr else 3 }
fn whichAnd(e Both) Bool { return e == AErr and onlyA(e) == 1 }

Baked := big(Shape.Circle(3)) and not big(Shape.Dot) and area(Shape.Rect(2, 3)) == 6 and width(Shape.Rect(4, 1)) == 4 and
    walk(Shape.Circle(1)) == 10 and until(Shape.Dot) == 5 and three(Shape.Circle(3)) == 4 and which(AErr.Y) == 2

fn main() {
    assert Baked
    assert big(Shape.Circle(2)) and not big(Shape.Circle(1)) and not big(Shape.Rect(5, 5))
    assert small(Shape.Dot) and small(Shape.Circle(1)) and not small(Shape.Circle(7))
    assert area(Shape.Rect(3, 4)) == 12 and area(Shape.Dot) == 0
    assert round(Shape.Circle(5)) == 5 and round(Shape.Dot) == 0
    assert width(Shape.Rect(9, 1)) == 9
    assert both(Shape.Circle(1), Shape.Rect(2, 3)) == 3 and both(Shape.Dot, Shape.Rect(2, 3)) == -1
    assert walk(Shape.Circle(2)) == 9 and walk(Shape.Dot) == 0
    assert until(Shape.Circle(1)) == 5 and until(Shape.Rect(1, 7)) == 7
    assert three(Shape.Circle(5)) == 2 and three(Shape.Dot) == 0
    assert which(AErr.X) == 1 and which(AErr.Y) == 2 and which(BErr.Z) == 3
    assert whichAnd(AErr.X) and not whichAnd(BErr.Z)
}

