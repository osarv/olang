import "std/io"

type MyErr error { First, Second }
type Shape enum { Circle, Square }
type Box struct(value I64) { value }
fn (b Box) Area() I64 { return b.value }

fn pick(count I64) I64 ? MyErr {
    if count < 0 { error MyErr.FIRTS }
    return cout
}

fn main() ? {
    b := Box(2)
    n := b.valeu + b.Aera()
    s := Shape.Cricle
    try io.Prinln($n $s)
    try pick(1)
}
