# check: fail error[S12b]: '=>' gives a value, and 'return' gives none - a clause that leaves is a block: '{ return 0 }'
# S12b: a clause that leaves gives no value - written as a block ("=> unreachable" is a value, S16e)
import "std/io"
fn sign(n I64) I64 {
    return match n {
        case 0 => 0
        case 1 => 1
        nomatch => return 0
    }
}
fn main() ? { try io.Println($sign(1)) }
