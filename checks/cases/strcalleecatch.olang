# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/O12: a helper handed the receiver's node gives a new node as a catch default for a call borrowing from it, built where
# the call's result lives (R9a): refused
import "std/io"
type Stop error {
    Here
}
type Node struct(v I64, next mut Node?&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&) {
    head
}
fn find(n Node&, k I64) Node& ? {
    if k > 0 { error Stop.Here }
    return n
}
fn pick(n Node&) I64 {
    x := try find(n, 1) catch default Node(1, null)
    return x.v
}
fn (b Bag&) Str() String {
    return $pick(b.head)
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    try io.PutLine(s)
}
