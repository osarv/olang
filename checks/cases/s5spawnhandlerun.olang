# check: run
# flags: -sanitize
# E31b/P2: the spawned form of "users[i].Push(v)" is a function taking the collection, one task per inner list - what
# it builds is built where the inner lists' state lives, so it is there after the join and an arena churn
fn pushTo(users mut Vec<Vec<I64>>&, i I64) {
    for j in range 20 { users[i].Push(i * 100 + j) }
}

fn main() ? {
    users := Vec<Vec<I64>>()
    for _ in range 4 { users.Push(Vec<I64>()) }
    join {
        for i in range 4 { spawn pushTo(users, i) }
    }
    churn := Vec<String&>()
    for i in range 1000 { churn.Push("x" $i) }
    t I64 = 0
    for u in users { t += u.Len() }
    assert t == 80
}
