# check: fail error[O17]: this value's references live where its own storage does not, and the callee can store th
# O17 (Vec phase 1): a callee lent a split value only permutes its elements - ...written through a writable reference to it is a store from outside
type N2 struct(v I64) {
    v
    next mut N2& = null
}
type Rec struct(name String&, n I64) {
    name
    n
}
type RecN struct(nd mut N2&) {
    nd
}
type H struct() {
    arr Array<Rec, 3> = Array<Rec, 3>()
    ns Array<RecN, 2> = Array<RecN, 2>()
}
fn mkText(k I64) String& { return "t" $k }
fn setName(r mut Rec&, s String&) { r.name = s }
fn f(a mut Array<Rec>&, s String&) {
    t := a[0]
    u mut Rec& = t
    u.name = s
    a[1] = t
}
fn run(h mut H&) {
    recs := h.arr
    f(recs, mkText(7))
}
fn main() ? {
    h mut H& = H()
    run(h)
}
