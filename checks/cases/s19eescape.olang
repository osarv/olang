# check: fail error[S19b]: an error may not leave deferred code - catch it here
# S19b, S19e: an errdefer's code may not let an error out either - it runs while one is already leaving
type E error { Bad }
fn g() ? E { error E.Bad }
fn f() ? E {
    errdefer try g()
    error E.Bad
}
fn main() ? { try f() catch { } }
