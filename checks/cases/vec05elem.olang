# check: fail error[O39]: calling 'grow' may release the Array<Pt> borrowed on line 11
# Vec phase 1 (f1d's shape, O38/O39): an element of a Vec's view lent by reference to a callee that grows the same Vec
import "std/io"
type Pt struct(x I64) { x }
fn grow(v mut Vec<Pt>&, p Pt&) I64 {
    for i in range 100 { v.Push(Pt(i)) }
    return p.x
}
fn main() ? {
    v := Vec<Pt>()
    v.Push(Pt(4))
    try io.Println($grow(v, v.View()[0]))
}
