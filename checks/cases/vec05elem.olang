# check: fail error[M19g]: this view of 'v' is given to 'grow', which may grow 'v'
# an element of a Vec's view lent by reference to a callee that grows the same Vec
# M19g, round 2 (brought back from round 1's deletion): the same Vec is seen on both sides, so the view is refused
import "std/io"
type Pt struct(x I64) { x }
fn grow(v mut Vec<Pt>&, p Pt&) I64 {
    for i in range 100 { v.Push(Pt(i)) }
    return p.x
}
fn main() ? {
    v := Vec<Pt>()
    v.Push(Pt(4))
    try io.Println($grow(v, v.View()[0]))
}
