# check: run
# flags: -d -s
# P2 (decision 48, replacing decision 40's refusal): a spawned lambda calling a closure held in what it captured - the
# closure builds, from the task's thread, into its own part of the scope it captured
type H struct(f fn(i I64)) { f }
fn main() ? {
    a mut List<I64>& = List<I64>()
    ha H& = H(fn(i I64) { a.Push(i) })
    join {
        spawn fn() { for i in range 10 { ha.f(i) } }
    }
    if a.Len() != 10 { fail }
    for i, x in a { if x != i { fail } }
}
