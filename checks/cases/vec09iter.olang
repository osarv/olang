# check: fail error[O39]: calling 'Push' may release the Array<I64> borrowed on line 7
# Vec phase 1: an iterator over a Vec holds the Vec, so a Push while it is used is refused (as Rust refuses it)
import "std/io"
fn main() ? {
    v := Vec<I64>()
    v.Push(1)
    it := v.Iter()
    v.Push(2)
    try io.Println($(try it.Next() catch default 0))
}
