# check: fail error[O38]: this value borrows an own object, and an owner, or a value with a destructor, would hold it past its loans
# O38: ...or handed to an owning parameter (own4 N4)
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
type Box struct(x Outer&) {
    x
}
type Big2 struct() {
    bx Box& = null
}
fn withFirst(x Outer&) own mut Array<Box&>& {
    a own mut Array<Box&>& = Array<Box&>(1)
    a[0] = Box(x)
    return a
}
fn keepFirst(dst mut Big2&, a own mut Array<Box&>&) { dst.bx = a[0] }
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    g := Big2()
    keepFirst(g, withFirst(b))
    io.Println($g.bx.x.o.k)
}
