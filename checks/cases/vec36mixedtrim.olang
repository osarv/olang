# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# vec3 F2: a borrowed own result function whose other return borrows an object of another type (a String, through
# Trim) than its recorded one (Array<Char>) - its callers' loan would never meet that release
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    data own mut Array<Char>& = Array<Char>(2, 'a')
    text own mut String& = "bb"
}
fn h(c CB&) String&c { return c.text }

fn f(c CB&, n I64) String&c {
    if n == 0 { return String(c.data) }
    return h(c).Trim()
}
fn use(c mut CB&) {
    t := f(c, 1)
    c.text = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    io.Println(t)
}
fn main() ? {
    c := CB()
    use(c)
}
