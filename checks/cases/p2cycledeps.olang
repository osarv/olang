# check: run
# flags: -s
# P2: a task whose call reaches a call cycle handing a building callback on - every task gets a stand-in for each scope
# its call binds, so four tasks building into their nodes' block never share an arena (C2)
type Node struct(v I64) {
    v
    next mut Node& = null
}
fn ca(g fn(x mut Node&), n mut Node&, c I64) {
    if c > 0 { cb(n, c - 1) }
    g(n)
}
fn cb(n mut Node&, c I64) {
    ca(fn(x mut Node&) { x.next = Node(x.v + 1) }, n, c)
}
fn cc(n mut Node&) { ca(fn(x mut Node&) { }, n, 400) }
fn main() ? {
    total I64 = 0
    for r in range 300 {
        a := Node(1)
        b := Node(2)
        c := Node(3)
        d := Node(4)
        join {
            spawn cc(a)
            spawn cc(b)
            spawn cc(c)
            spawn cc(d)
        }
        total += a.next.v + b.next.v + c.next.v + d.next.v
    }
    assert total == 4200, $total
}
