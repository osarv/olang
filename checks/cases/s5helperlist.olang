# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O18c: a helper's List holding its parameter, pushed outward from the loop the text is made in
import "std/io"
fn one(s String&) Vec<String&> {
    c := Vec<String&>()
    c.Push(s)
    return c
}

fn main() ? {
    rows := Vec<Vec<String&>>()
    for k in range 4 {
        t := $k "-text"
        rows.Push(one(t))
    }
    for r in rows { try io.Println(r[0]) }
}
