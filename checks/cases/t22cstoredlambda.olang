# check: run
# flags: -debug -sanitize
# T22c, O29: a lambda held in a local (never assigned again) and followed into a callee's twin, its captured reference
# one of two scopes - the twin's temporaries built where the captured Keeper is found to live, not in the program's
# scope - read back after an arena churn
import "std/io"
type N struct(v I64) {
    v
}
type Keeper struct() {
    kept Vec<N&>
}
fn feed(s fn&(n N&), base I64) {
    for i in range 3 { s(N(base + i)) }
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    k mut Keeper& = Keeper()
    t := 0
    for j in range 3 {
        k2 mut Keeper& = Keeper()
        f mut Keeper& = k if j == 1 else k2
        g := fn(n N&) { f.kept.Push(n) }
        feed(g, 20)
        t += churn(20) + k2.kept.Len()
    }
    s := 0
    for n in k.kept { s += n.v }
    try io.PutLine($k.kept.Len() " " $s " " $t)
}
