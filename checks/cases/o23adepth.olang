# check: run
# flags: -debug -sanitize
# O2a/O23a, O27 as placement: a field written "&p" read through a local reads at the block its argument lives in - which
# depth that is was dropped once, so v.n read as the function's outermost block and keep took a reference into the loop
# body's arena. With 'keep' typed per assignment (O25i) the read after the loop is reached by 'keep = v.n', a part of the
# loop body's instance which no field binding serves: with parts placed (O27) the instance and what it was made from
# are built where the read needs them, a new one each turn (it was O25i's error at the read); read back after a churn
type Node struct(v I64) {
    v
}
type View struct(of mut Node&) {
    n mut Node& = of
}
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}
fn main() ? {
    base Node& = Node(0)
    keep Node& = Node(0)
    for i in range 3 {
        inner mut Node& = Node(i)
        v := View(inner)
        keep = v.n
    }
    churn()
    assert $base != ""
    assert keep.v == 2, $keep
}
