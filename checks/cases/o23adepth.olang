# check: fail error[O25i]: this reads 'keep', which an assignment may have given storage that no longer lives here - assign it a copy ('$x' or 'x.Copy()'), or what lives here
# O2a/O23a: a field written "&p" read through a local reads at the block its argument lives in - which depth that is was
# dropped on the way through the member, so v.n read as the function's outermost block and keep took a reference into
# the loop body's arena
# (O25i: 'keep' is typed per assignment now, so the error is at the read after the loop, which the version
# 'keep = v.n' reaches - a part of the loop body's instance, which no field binding serves)
type Node struct(v I64) {
    v
}
type View struct(of mut Node&) {
    n mut Node& = of
}
fn main() ? {
    base Node& = Node(0)
    keep Node& = Node(0)
    for i in range 3 {
        inner mut Node& = Node(i)
        v := View(inner)
        keep = v.n
    }
    assert $base != ""
    assert $keep != ""
}
