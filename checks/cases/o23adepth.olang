# check: fail error[O20]: 'v.n' lives where 'v' does, which closes first - keep a copy ('$v.n'), or keep what 'v' was made from
# O2a/O23a: a field written "&p" read through a local reads at the block its argument lives in - which depth that is was
# dropped on the way through the member, so v.n read as the function's outermost block and keep took a reference into
# the loop body's arena
type Node struct(v I64) {
    v
}
type View struct(of mut Node&) {
    n mut Node& = of
}
fn main() ? {
    base Node& = Node(0)
    keep Node& = Node(0)
    for i in range 3 {
        inner mut Node& = Node(i)
        v := View(inner)
        keep = v.n
    }
    assert $base != ""
    assert $keep != ""
}
