# check: fail error[O27]: this returns a view of 'buf', which this function builds - return the value (a result written without '&' copies it), or a copy: '$x'
# D18c: an element kept by the walk lives where the generator does - not in the walk's own frame, which ends with it
fn heads(n I64) Iterator<Array<I64>&> {
    buf := Array<I64>(4)
    for i in range n {
        buf[0] = i
        yield buf[0:1]
    }
}

fn main() {
    for _ in heads(2) { }
}
