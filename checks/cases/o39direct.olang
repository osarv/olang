# check: fail error[O39]: assigning 's.cur' may release the Conn borrowed on line
# a borrow of an owned object is in use after its slot is given null
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn main() ? {
    s := Server()
    s.cur = Conn(3)
    c := s.cur
    s.cur = null
    try io.Println(c.name)
}
