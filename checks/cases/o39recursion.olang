# check: fail error[O39]: calling 'rec' may release the Conn borrowed on line
# what a body may release is found through calls, recursive ones included
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn rec(s mut Server&, n I64) { if n > 0 { rec2(s, n - 1) } }
fn rec2(s mut Server&, n I64) { if n == 0 { s.cur = null } else { rec(s, n) } }
fn main() ? {
    s := Server()
    s.cur = Conn(1)
    c := s.cur
    rec(s, 3)
    io.Println(c.name)
}
