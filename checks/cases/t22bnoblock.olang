# check: fail error[T22b]: a value of type 'fn&()' may do what 'fn&() noblock' does not say ('noblock'), and which functions it holds is not known here
# T22b: a value whose functions are not followed (a parameter's) fits a type with an effect word only where its own
# type writes it
type Box struct() {
    f fn?&() noblock = null
}

fn Keep(b mut Box&, g fn&()) { b.f = g }

fn main() {
    b mut Box& = Box()
    Keep(b, fn() { })
    b.f!()
}
