# check: fail error[E11b]: '(' after a piece of text calls it - to join the value inside, write '$(...)'
# never: is not a function
# E11b: a rendering of a non-text value followed by a parenthesized piece of text on one line is the piece called; the
# message names '$(...)' where the value is joined, not E13b's "F64 is not a function"
fn main() ? {
    alpha F64 = 0.5
    normalized := true
    text := "alpha " + $alpha (" normalized" if normalized else "")
    assert text.Len() > 0
}
