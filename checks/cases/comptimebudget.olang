# check: fail error[K3]: this comptime cannot be computed while compiling
# K3: what the evaluator cannot compute is an error at the comptime - never computed at run time instead
fn fib(n I64) I64 {
    if n < 2: return n
    return fib(n - 1) + fib(n - 2)
}
fn main() { assert comptime fib(40) > 0 }
