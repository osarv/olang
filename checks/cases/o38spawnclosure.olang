# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# O38: ...or a closure capturing one (own4 N2)
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn mkf(x Outer&) fn() I64 { return fn() I64 { return x.o.k } }
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    g fn() I64 = null
    join {
        spawn g = mkf(b)
    }
    println($g())
}
