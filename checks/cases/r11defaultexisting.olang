# check: run
# flags: -debug -sanitize
# R8 (refusals 5.7): compiles now - a by-value default holding references is judged as the call's result is: a copy of
# 'empty', whose references outlive where the result lands. It was refused ("a default for a value holding references
# builds all it holds"); read back after a churn
import "std/io"
type Bad error { No }
fn validate(text String&) Vec<String&> ? Bad {
    if text.Len() == 0 { error Bad.No }
    return Vec<String&>()
}
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}
fn main() ? {
    empty := Vec<String&>()
    empty.Push("kept " $empty.Len())
    n := (try validate("x") catch default empty).Len()
    got := try validate("") catch default empty
    churn()
    try io.PutLine($n " " $got.Len() " " $got[0])
}
