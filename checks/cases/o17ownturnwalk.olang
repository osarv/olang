# check: run
# flags: -sanitize
# O17 (bulk review 6 F3, item 17): a loop turn's Vec a callee's call gives, lent to a walk keeping a reference to it -
# refused while it was one slot every turn reused; since item 17 it is built where the walk is kept, one each turn - read
# back after a churn
import "std/io"

type walk struct(v Vec<String&>&, i I64 = 0) { v, i }

fn (w mut walk&) Next() String& ? Exhausted {
    if w.i >= w.v.Len(): error Exhausted.End
    w.i++
    return w.v[w.i - 1]
}

fn walk.over(v Vec<String&>&) walk { return walk(v) }

fn mkv(k I64, t String&) Vec<String&> {
    v := Vec<String&>()
    for _ in range k { v.Push(t) }
    return v
}

fn main() {
    t := "long-lived"
    ws := Vec<walk>()
    for k in range 1, 6 {
        v := mkv(k, t)
        ws.Push(walk.over(v))
    }
    junk := Vec<Vec<I64>>()
    for i in range 200 {
        junk.Push(Vec<I64>())
        junk.RefMut(i).Push(i)
    }
    s := 0
    for w in ws { s += w.v.Len() }
    io.Println("sum " $s " (15)")!
}
