# check: run
# O26a (bulk review 6 F8-F10): what flows into the result lives where it goes - a value local declared from a copy of
# another's ("cur := head") given a new value in a loop and returned, a reference local from a built call captured by
# a returned lambda, a slice of a call's view of a local returned whole
type node struct(v I64, next node?& = null) { v, next }

fn node.build(k I64) node& {
    head := node(0)
    cur := head
    for i in range 1, k {
        nn := node(i)
        cur.next = nn
        cur = nn
    }
    return cur
}

fn node.mk(k I64) node& { return node(k) }

fn mkfn(k I64) fn&() I64 {
    r := node.mk(k)
    return fn() I64 { return r.v }
}

fn part(k I64) Array<I64>& {
    v := Vec<I64>()
    for i in range 10 { v.Push(k * 10 + i) }
    return v.View()[2:4]
}

fn all() I64 {
    junk := Vec<String>()
    f := mkfn(3)
    p := part(2)
    b := node.build(5)
    for i in range 1000 { junk.Push($i) }
    return b.v + 10 * f() + 100 * p[1] + junk.Len()
}

Baked := all()

fn main() {
    assert all() == 3334 and Baked == 3334
}
