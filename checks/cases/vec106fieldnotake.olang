# check: fail error[O34]: moving out of 'm.toks' would leave it empty - write 'take m.toks'
# Vec phase 2a (O34): a field's Vec given to another moves only by 'take'
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn main() ? {
    l := Lexer(3)
    m := Lexer(4)
    l.toks = m.toks
    io.Println($l.toks.Len())
}
