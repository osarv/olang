# check: run
# D17a: a requirement is checked on entry at run time, where the evaluator cannot decide it
import "std/os"
fn pick(x I32, y I32) [y > x] I32 ? { return y - x }

fn main() ? {
    a := I32(5)
    if os.Args().Len() > 5 { a = 0 }
    b := try pick(1, a) catch ArgumentError.Invalid default -1
    assert b == 4
    a = 0
    c := try pick(1, a) catch ArgumentError.Invalid default -1
    assert c == -1
}
