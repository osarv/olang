# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# a built result handed to a callee that keeps it lands where the callee's obligation says - here where a loop
# body's text may not reach: must fail
import "std/io"
type Rec struct(t String&) {
    t
}
type H struct() {
    k mut Rec?& = null
}
fn Rec.mk(t String&) mut Rec& {
    r mut Rec& = Rec(t)
    return r
}
fn keep(s mut H&, r mut Rec&) { s.k = r }
fn main() ? {
    h mut H& = H()
    for i in range 3 {
        x := $i
        keep(h, Rec.mk(x))
    }
    try io.Println(h.k!.t)
}
