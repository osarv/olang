# check: run
# flags: -sanitize
# T17c, O28 (C2): a local declared as an enum case holding a by-value parameter's reference lives where that reference's
# referent does; assigned a case holding a reference to a local of the function, that local is placed there too (a new
# one each call) - read back through the case after an arena churn
import "std/io"

type Note struct() {
    seen := Vec<I64>()
}

type W struct(id I64, log mut Note&) {
    id, log
}

type Opt enum { None, Some(w W) }

fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn mix(w W, k I64) I64 {
    local := Note()
    m := Opt.Some(w)
    m = Opt.Some(W(k, local))
    if m == Opt.Some: m.w.log.seen.Push(k * 10)
    churn()
    return m.w.log.seen[0] + m.w.id if m == Opt.Some else 0
}

fn main() ? {
    t := Note()
    s := 0
    for k in range 1, 5 { s += mix(W(0, t), k) }
    try io.Println($s " " $t.seen.Len())
}
