# check: build
# flags: -memory
# also: note: 'a34' (line 59) is used here, after 'h.set(i)' (line 96), which lets go of it
# O8d (the bulk review's F3): a view handed down a chain of 34 locals, the origins' fixed point run to its end
import "std/io"

type Holder struct() {
    t String& = ""
}

fn (h mut Holder&) set(i I64) { h.t = $"text number " $i " padded out to many bytes ........................................" }

fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7) " some more text to fill the chunk ......"
        t += s.Len()
    }
    return t
}

# the text's view handed down a chain of locals written last to first, one step a turn of the loop - no let-go in it
fn step(h mut Holder&, i I64) {
    a1 String&h = ""
    a2 String&h = ""
    a3 String&h = ""
    a4 String&h = ""
    a5 String&h = ""
    a6 String&h = ""
    a7 String&h = ""
    a8 String&h = ""
    a9 String&h = ""
    a10 String&h = ""
    a11 String&h = ""
    a12 String&h = ""
    a13 String&h = ""
    a14 String&h = ""
    a15 String&h = ""
    a16 String&h = ""
    a17 String&h = ""
    a18 String&h = ""
    a19 String&h = ""
    a20 String&h = ""
    a21 String&h = ""
    a22 String&h = ""
    a23 String&h = ""
    a24 String&h = ""
    a25 String&h = ""
    a26 String&h = ""
    a27 String&h = ""
    a28 String&h = ""
    a29 String&h = ""
    a30 String&h = ""
    a31 String&h = ""
    a32 String&h = ""
    a33 String&h = ""
    a34 String&h = ""
    for _ in range 39 {
        a34 = a33
        a33 = a32
        a32 = a31
        a31 = a30
        a30 = a29
        a29 = a28
        a28 = a27
        a27 = a26
        a26 = a25
        a25 = a24
        a24 = a23
        a23 = a22
        a22 = a21
        a21 = a20
        a20 = a19
        a19 = a18
        a18 = a17
        a17 = a16
        a16 = a15
        a15 = a14
        a14 = a13
        a13 = a12
        a12 = a11
        a11 = a10
        a10 = a9
        a9 = a8
        a8 = a7
        a7 = a6
        a6 = a5
        a5 = a4
        a4 = a3
        a3 = a2
        a2 = a1
        a1 = h.t
    }
    h.set(i)            # lets go of the text the chain's last local holds
    churn()
    io.Println(a34)!
}

fn main() {
    h := Holder()
    h.set(-1)
    for i in range 5 { step(h, i) }
}
