# check: run
# flags: -debug -sanitize
# T29a/E12c, O27 as placement: a conversion of a local array names the local's storage - kept in a parameter's field, the
# local is built where the field lives (it was O20's error: the storage died at the return); read back after a churn
import "std/io"
type Bytes Array<U8>
type Holder struct() {
  s Bytes& = Bytes(Array<U8>(0))
}
fn keep(h mut Holder&) {
  local Array<U8> = Array<U8>[104, 105, 106]
  h.s = Bytes(local)
}
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}
fn main() ? {
    h mut Holder& = Holder()
    keep(h)
    churn()
    try io.Println($h.s[1])
}
