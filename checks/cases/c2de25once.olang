# check: run
# R2 (refusals 5.2): compiles now - the instance's argument built where 'c' refers, which the store into c.e keeps (O28
# through C2d); it was refused, as what follows says
# B11: one error per cause - a ':=' judging where a scope argument puts its instance, then the statement storing it
# there, reached the same fault at the same argument and reported it twice (review chk5)
import "std/io"
type Info struct(n I64) { n }
type Env struct(r Info&) {
    r
}
type Holder struct(e Env) {
    e
}
fn build(c mut Holder&) {
    for k in range 3 {
        local := Info(k + 100)
        x := Env(local)
        c.e = x
    }
}
fn main() ? {
    g := Info(1)
    c mut Holder& = Holder(Env(g))
    build(c)
    try io.Println($c.e.r.n)
}
