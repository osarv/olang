# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O25h/O10c: List.Push stores a value holding a reference that can be stored through - so the list and what the value
# refers to must be in one scope, an equality Push's callers show; this one's node is from a loop body
import "std/pair"
type Node struct(v I64) {
    v
    next mut Node?& = null
}
fn main() ? {
    fields := Vec<pair.Pair<String&, Node&>>()
    for i in range 2 {
        value Node& = Node(i)
        p := pair.Pair<String&, Node&>("k", value)
        fields.Push(p)
    }
}
