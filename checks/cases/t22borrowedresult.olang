# check: run
# flags: -debug -sanitize
# T22, T22a, O27 as placement: a function handing back its argument is a value (open point 5), and a call through the
# value holds the argument to outlive where the result lands - kept past the argument, the argument is built where the
# result goes (it was O27's error naming 't'); read back after a churn
import "std/io"
type N struct(v I64) {
    v
    next N?& = null
}
fn self(a mut N&) mut N& { return a }
fn keep(f fn&(a mut N&) mut N&, out mut N&, i I64) {
    t := N(i)
    out.next = f(t)
}
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn main() {
    x mut N& = N(1)
    keep(self, x, 42)
    churn()
    io.PutLine($x.next!.v)!
}
