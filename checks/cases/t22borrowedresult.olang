# check: fail error[T22a]: 'self' relates its arguments' scopes, which a call through a function value cannot check - call it directly
# T22: a borrowed result ('N&a', where a lives) is not a built one ('N&', where the call's result is put) - the caller of
# a value of the built type would keep the result past its argument
type N struct(v I64) {
    v
    next N?& = null
}
fn self(a mut N&) mut N& { return a }
fn keep(f fn(a mut N&) N&, out mut N&, i I64) {
    t := N(i)
    out.next = f(t)
}
fn main() {
    x mut N& = N(1)
    keep(self, x, 42)
}
