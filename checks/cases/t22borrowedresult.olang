# check: fail error[O27]: this keeps a view of 't', which lives only until its block or loop turn ends
# T22, T22a: a function handing back its argument is a value (open point 5), and a call through the value holds the
# argument to outlive where the result lands - kept past the argument, refused (it was T22a's error, the function no value)
type N struct(v I64) {
    v
    next N?& = null
}
fn self(a mut N&) mut N& { return a }
fn keep(f fn&(a mut N&) N&, out mut N&, i I64) {
    t := N(i)
    out.next = f(t)
}
fn main() {
    x mut N& = N(1)
    keep(self, x, 42)
}
