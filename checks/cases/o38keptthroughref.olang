# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# O38: ...stored through a reference to a local - refused, whatever the reference leads to
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
type Big struct() {
    x Outer& = null
}
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    g := Big()
    gr mut Big& = g
    gr.x = b
    v.o = null
    io.Println($g.x.o.k)
}
