# check: fail error[O39]: assigning 'v.o' may release the Inner borrowed on line
# also: note: kept here, until the end of the block it is kept in
# O38: ...stored through a reference to a local - kept where it leads, read through the local itself
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
type Big struct() {
    x Outer& = null
}
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    g := Big()
    gr mut Big& = g
    gr.x = b
    v.o = null
    println($g.x.o.k)
}
