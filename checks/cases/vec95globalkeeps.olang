# check: fail error[T25c]: a read-only reference cannot become writable - pass a writable one, or drop the 'mut'
# O1b: a global does not keep a view of a field's Vec
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
G mut Array<I64>& = Array<I64>(0)
fn main() ? {
    l := Lexer(3)
    for i in range 3 { l.toks.Push(i) }
    G = l.toks.View()
    l.toks.Push(4)
    try io.PutLine($G[0])
}
