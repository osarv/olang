# check: fail note: this object is reached through a call's result, a borrow of an owned object whose region is not known here
# vec7 F2 through a local assigned the getter's result after the take, on a later turn of the loop - what a variable may
# hold is read off the whole of its function
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
    next mut Lexer& = null
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn (p mut Parser&) Lx() mut Lexer&p { return p.lx }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    p := Parser()
    p.lx = Lexer()
    for i in range 3 { p.lx.toks.Push($i "-word") }
    d := Parser()
    d.lx = Lexer()
    q mut Lexer& = Lexer()
    for k in range 2 {
        d.lx.toks = take q.toks
        q = p.Lx()
    }
    p.lx = null
    churn()
    println(d.lx.toks[0])
}
