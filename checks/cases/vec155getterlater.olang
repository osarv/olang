# check: fail error[O25h]: this value holds references into a scope the target outlives
# round 1 of docs/memory.md: a Vec is a handle, so 'take' no longer moves one - its record stays in the first own
# object's region, and storing the handle into another region is refused by O25h (O1b for a global, O38 for a borrow)
# vec7 F2 through a local assigned the getter's result after the take, on a later turn of the loop - what a variable may
# hold is read off the whole of its function
import "std/io"
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
    next mut Lexer& = null
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn (p mut Parser&) Lx() mut Lexer&p { return p.lx }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    p := Parser()
    p.lx = Lexer()
    for i in range 3 { p.lx.toks.Push($i "-word") }
    d := Parser()
    d.lx = Lexer()
    q mut Lexer& = Lexer()
    for k in range 2 {
        d.lx.toks = q.toks
        q = p.Lx()
    }
    p.lx = null
    churn()
    try io.Println(d.lx.toks[0])
}
