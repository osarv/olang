# check: run
# R3 (refusals 5.3): compiles now - a by-value parameter kept past the call has its copy made at entry where it must live (the result scope, the
# instance's, a reference parameter's), read back after an arena churn; it was refused, as what follows says
# C2d, B11 (review 6b F6): an argument of a type with no Clone - a Vec, a value copied by assignment - is not told to
# give a copy by 'x.Copy()' or '$x'. The argument a by-value parameter, which nothing can build where the instance goes
# (a loop turn's local is built where it is kept since item 17 - o17ownturnvec)
import "std/io"
type holder struct(v Vec<I64>&) { v }
fn keepIn(out mut Vec<holder>&, v Vec<I64>) { out.Push(holder(v)) }
fn main() {
    out := Vec<holder>()
    for i in range 1, 6 {
        v := Vec<I64>()
        for j in range i { v.Push(j) }
        keepIn(out, v)
    }
    io.PutLine($out.Len() " " $out[4].v.Len() " " $out[4].v[3])!
}
