# check: fail error[T22a]: 'link' ties where what it is given lives to what it keeps or gives back, and this argument holds only what its written function type says of every call - call it directly, or hold it in a local and call it there
# T22: a function type may say its parameters share a scope ('b N&a'), and a call through a value of it is held to that
# as a direct call is
type N struct(v I64) {
    v
    next N?& = null
}
fn link(a mut N&, b N&) { a.next = b }
fn put(f fn&(a mut N&, b N&), a mut N&) {
    t := N(5)
    f(a, t)
}
fn main() {
    x mut N& = N(1)
    put(link, x)
}
