# check: fail error[O25h]: this value holds references into a scope the target outlives
# round 1 of docs/memory.md: a Vec is a handle, so 'take' no longer moves one - its record stays in the first own
# object's region, and storing the handle into another region is refused by O25h (O1b for a global, O38 for a borrow)
# R1: a Vec<Tok>, Tok holding its text
import "std/io"
type Tok struct(text String&, n I64) {
    text
    n
}
type Lex2 struct() {
    toks Vec<Tok> = Vec<Tok>()
}
type H struct() {
    lx own mut Lex2& = null
}
fn add(v mut Vec<Tok>&, t String&) { v.Push(Tok(t, 2)) }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    h := H()
    g := H()
    h.lx = Lex2()
    g.lx = Lex2()
    for i in range 3 { h.lx.toks.Push(Tok($i "-built-into-h-region", i)) }
    g.lx.toks = h.lx.toks
    h.lx = null
    churn()
    try io.Println(g.lx.toks[0].text)
}
