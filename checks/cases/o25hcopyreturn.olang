# check: fail error[O26]: this value refers to this function's own storage
# O25h/O14c: a copy of an element holding references keeps them where the element's are - here text made in this
# function's own block, which closes at the return. It used to be returned unchecked and read freed storage
type WC struct(word String&, count I64) {
    word
    count
}
fn mk(n I64) WC {
    a := Array<WC>(1)
    a[0] = WC($n $n, 1)
    return a[0]
}
fn main() ? {
    w := mk(12)
    assert w.count == 1
}
