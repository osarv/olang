# check: run
# R1a/D16b: a lambda's errors found from its body are in an inferred set's canonical order, whatever order they
# appear in, so it fits a function type writing them in that order
type Zeta error {
    Z
}
type Alpha error {
    A
}
N mut I64 = 1
fn z(n I64) I64 ? Zeta { if n == 1 { error Zeta.Z } return n }
fn a(n I64) I64 ? Alpha { if n == 2 { error Alpha.A } return n }
fn runIt(f (fn() I64 ? Alpha, Zeta)) I64 { return try f() catch Zeta default 10 catch Alpha default 20 }
fn main() {
    g := fn() I64 { return try z(N) + try a(N) }
    assert runIt(g) == 10
    h := fn() I64 { return try z(N + 1) + try a(N + 1) }
    assert runIt(h) == 20 and $g == "fn() I64 ? Alpha, Zeta"
}
