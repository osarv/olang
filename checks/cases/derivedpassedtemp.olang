# check: run
# flags: -sanitize
# O23a, C1: a temporary stored through an element read off a field with a binding of its own - built where that
# element lives, the derived scope the caller passes (work's own scope for its argument), found at run time before
# round 8 - read back after an arena churn
import "std/io"
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type View struct(ns Array<mut Node&>&) {
    at Array<mut Node&>& = ns
}
fn put(w View&, k I64) {
    x := w.at[k]
    x.next = Node(x.v + 100)
}
fn work(a Array<mut Node&>&) {
    w := View(a)
    put(w, 0)
    put(w, 1)
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    a := Array<mut Node&>(2, Node(3))
    work(a)
    t := churn(60)
    try io.PutLine($a[0].next!.v " " $a[1].next!.v " " $t)
}
