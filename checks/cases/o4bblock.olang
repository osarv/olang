# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O4b/O10c: a key stored into a map must outlive it, an obligation each caller discharges - and a key
# built in an inner block does not outlive a map from the outer one, which the block depths decide
type SSlot struct(key String&, val I32, next mut SSlot?&) {
    key
    val
    next
}
type SMap struct() { first mut SSlot?& = null }
fn (m mut SMap&) Put(key String&, val I32) {
    for s mut SSlot?& = m.first, s is not null, s = s.next {
        if s.key.Eq(key) {
            s.val = val
            return
        }
    }
    m.first = SSlot(key, val, m.first)
}
fn (m SMap&) Get(key String&) I32 {
    for s SSlot?& = m.first, s is not null, s = s.next {
        if s.key.Eq(key) { return s.val }
    }
    return -1
}
test "inner key" {
    m mut SMap& = SMap()
    if m.first is null {
        k String& = $1
        m.Put(k, 1)
    }
}
fn main() { }
