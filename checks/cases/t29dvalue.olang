# check: fail doesn't match the target's declared type
# T29d: only a literal adapts to a type with a constructor - a typed value enters through the constructor
type Percent Int32(v mut Int32) {
    if v > 100 { v = 100 }
}
fn main() ? {
    n Int32 = 150
    p Percent = n
    assert Int32(p) == 100
}
