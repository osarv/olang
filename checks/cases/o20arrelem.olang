# check: fail error[O20]: the container outlives what this refers to - build it where the container lives ('x T&c', 'f&c(...)')
# an array element's text that dies before the array's container: must fail
import "std/io"
type B struct() {
    data mut Array<String&>& = null
}
fn fill(b mut B&) {
    b.data = Array<String&>(2)
    for i in range 2 {
        t := $i
        b.data[i] = t
    }
}
fn main() ? {
    b := B()
    fill(b)
    try io.Println(b.data[0])
}
