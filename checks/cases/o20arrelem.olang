# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# an array element's text that dies before the array's container: must fail
import "std/io"
type B struct() {
    data mut Array<String&>& = Array<String&>(0)
}
fn fill(b mut B&) {
    b.data = Array<String&>(2)
    for i in range 2 {
        t := $i
        b.data[i] = t
    }
}
fn main() ? {
    b := B()
    fill(b)
    try io.PutLine(b.data[0])
}
