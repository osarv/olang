# check: run
# R1 (refusals 5.1): compiles now - a split value lent where its references live, its own storage lifted there where
# the callee keeps it (O17b generalized); it was refused, as what follows says
# O17b, a control for checks/cases/o17bbitand.olang: the same store written directly
type Cell struct() {
    v I64 = 0
    kept mut Box?& = null
}
type Box struct() { c mut Cell& = Cell() }
fn (h mut Box&) stash() {
    h.c.kept = h
}
fn run(m mut Map<I64, Box>&) ? {
    for _ in range 3 {
        b := try m.Get(1)
        b.stash()
    }
}
fn main() ? {
    m := Map<I64, Box>()
    m.Put(1, Box())
    try run(m)
}
