# check: run
# flags: -debug -sanitize
# S21 (docs/refusals.md 5.5; refused - "this argument is storage made in one of them" - until the user's "Yes, do A" of
# 2026-11-08): a call's run-time array result given to a by-value type variable at a become is built in the chain's
# tail scope, not in the step's frame
import "std/io"
import "std/os"

fn mk(n I64) Array<I64> { return Array<I64>(n, n * 7) }

fn walk<T>(a T, n I64) I64 {
    if n == 0: return a.Len() + a[0]
    become walk(mk(n + 2), n - 1)
}

fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}

fn main() {
    r := walk(Array<I64>(os.Args().Len() + 3, 1), 2)
    churn()
    io.PutLine($r)!
}
