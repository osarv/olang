# check: run
# flags: -debug -sanitize
# T22a/E31: the same Call adapter keeping a closure over a block-local node past its block (PE1b) - refused until
# 2026-11-07: a local's written function type is no boundary (docs/sec8.md 5.7), so 's(...)' is judged as the direct
# call to Keeper.Call it is, and the closure's 'm' is built where 'kp' lives (O27 as placement); read back after a churn
import "std/io"
type Node struct(v I64) {
    v
}
type Keeper struct() {
    kept fn?&() I64 = null
}
fn (k mut Keeper&) Call(x fn&() I64) { k.kept = x }
fn apply(s fn&(x fn&() I64), g fn&() I64) { s(g) }
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 40 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    kp := Keeper()
    s fn&(x fn&() I64) = kp
    {
        m := Node(10)
        s(fn() I64 { return m.v + 1 })
    }
    t := churn(100)
    try io.Println($kp.kept!() " " $t)
}
