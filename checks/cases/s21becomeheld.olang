# check: run
# flags: -debug -sanitize
# S21, O15, T13b (docs/refusals.md 5.5; refused - "not from a block whose variable holds a value with a destructor" -
# until the user's "Yes, do A" of 2026-11-08): a by-value parameter handed on at its last mention is moved, so nothing
# of this frame is ended before the call - the one value is ended once, as the chain's last step lets go of it
import "std/io"
Closed mut I64 = 0
type Conn unique struct(fd I64) {
    fd
} destruct { Closed++ }
fn down(c Conn, n I64) I64 {
    if n == 0: return c.fd + Closed * 100
    become down(c, n - 1)
}
fn main() {
    assert down(Conn(1), 3) == 1
    io.PutLine("closed " $Closed)!
}
