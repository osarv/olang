type Q struct(n I64, s String&) {
    n
    s
    arr Array<I64, 4> = Array<I64, 4>()
}
type B struct() {
    data own mut Array<Q>& = null
}
fn pick(q Q&) Q&q { return q }
fn main() ? {
    b := B()
    b.data = Array<Q>(2)
    x := pick(b.data[0])
    b.data = Array<Q>(1)
    io.Println($x.n)
}
