# check: fail error[O39]: calling 'Push' may release the Array<I64> borrowed on line
# vec3 F1: a written built result (mut Array<I64>&) is no proof of new storage - a helper handing back an argument
# through a generic (O14b) keeps the view's loan
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn pick(c Bool, x <T>, y T) T { return x if c else y }
# a helper with a written built result that hands back one of its arguments through a generic (O14b): natural code
fn longer(a mut Array<I64>&, b mut Array<I64>&) mut Array<I64>& { return pick(a.Len() >= b.Len(), a, b) }
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    other mut Array<I64>& = Array<I64>(1)
    d := longer(v.ViewMut(), other)   # the Vec's own buffer - and no loan on it
    for i in range 1000 { v.Push(i) } # frees the buffer: not refused
    churn()
    println($d[0] " " $d[1])
}
