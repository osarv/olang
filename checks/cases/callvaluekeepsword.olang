# check: run
# flags: -debug -sanitize
# T21c, T22b, E31: callvaluekeeps with the word written - an adapter whose Call keeps its argument in its instance fits
# 'keeps x', the receiver read as the value's home; the closure is built where the keeper lives; read back after a churn
import "std/io"
type Node struct(v I64) {
    v
}
type Keeper struct() {
    kept fn?&() I64 = null
}
fn (k mut Keeper&) Call(x fn&() I64) { k.kept = x }
fn keepVia(s fn&(x fn&() I64) keeps x, g fn&() I64) { s(g) }
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn fill(n Node&, kp mut Keeper&) {
    k := n.v
    keepVia(kp, fn() I64 { return n.v + k })
}
fn main() ? {
    n := Node(10)
    kp := Keeper()
    fill(n, kp)
    t := churn(300)
    try io.Println($kp.kept!() " " $t)
}
