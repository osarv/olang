# check: run
# E31b/O17b (decision 44, the handle analogue of e31bviewreplaced): a List element of a List, replaced through another
# path, then pushed through the hidden copy - the push lands in the replaced list, never in the element (a List is
# std/list's handle; a Vec, a value since 2026-11-01, is taken in place with RefMut instead - checks/cases/e31bvecinplace)
import "std/list"
fn work(c mut list.List<I64>&, l mut list.List<list.List<I64>>&) {
    l[0] = list.List<I64>()
    c.Push(5)
}
fn main() ? {
    l := list.List<list.List<I64>>()
    first := list.List<I64>()
    l.Push(first)
    work(l[0], l)
    assert l[0].Len() == 0 and first.Len() == 1, "element " $l[0].Len() " replaced " $first.Len()
}
