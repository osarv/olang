# check: run
# R1 (refusals 5.1): compiles now - a split value lent where its references live, its own storage lifted there where
# the callee keeps it (O17b generalized); it was refused, as what follows says
# O17/O17b (F1): a handle a call gives, lent to a callee capturing the parameter in a returned lambda - no use only
# through its reference, and kept: the same error
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { unreachable }
    }
}
fn idList(x mut Vec<I64>&) Vec<I64> { return x }
fn leak(l Vec<I64>&) fn&() I64 { return fn() I64 { return l.Len() } }
fn main() ? {
    base := Vec<I64>()
    base.Push(1)
    base.Push(2)
    fs := Vec<fn&() I64>()
    for _ in range 3 {
        fs.Push(leak(idList(base)))
        churn()
    }
    churn()
    t := 0
    for f in fs { t = t + f() }
    assert t == 6, $t
}
