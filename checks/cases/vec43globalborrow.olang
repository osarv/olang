# check: fail error[O1b]: a global holds only what lives as long as the program
# vec3 F4: a borrow of a global's own object is in the object's region, which may be released at any time - not the
# program's scope
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type Doc struct() {
    title own mut String& = "bb"
}
Docs own mut Doc& = Doc()
Current mut String& = "none"
fn remember() { Current = Docs.title }          # stores a borrow of a global's own object in a global
fn rename() { Docs.title = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz" }   # releases it
fn main() ? {
    remember()
    rename()
    churn()
    try io.Println(Current)
}
