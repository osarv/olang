# check: fail error[O10c]: the callee needs one argument's scope to outlive another's
# also: declare it where 'out' lives: 'p mut String&out = ...'
# never: 'Join&out(...)'
# B11: a scope argument builds a call's result where it says, which moves a reference local's referent but never a value
# local's own storage - so for a value local the note names a declaration instead, which compiles (study 4's r05)
import "std/filepath"
fn joined(dir String&, names Array<String&>&, out mut List<String&>&) {
    for name in names {
        p := filepath.Join&out(dir, name)
        out.Push(p)
    }
}
fn main() ? {
    l := List<String&>()
    joined("d", String&["a", "b"], l)
}
