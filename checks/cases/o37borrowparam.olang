# check: fail error[O37]: 'mk' gives an owner, which only an own slot receives
# an owned result handed to a borrowing parameter
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn mk(n I64) own mut Conn& { return Conn(n) }
fn fdOf(c Conn&) I64 { return c.fd }
fn main() ? {
    io.Println($fdOf(mk(3)))
}
