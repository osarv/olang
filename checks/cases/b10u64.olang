# check: run
# flags: -define X=18446744073709551615
# B10/L10: a -define integer is typed as its literal would be - a decimal one above I64's maximum is a U64 - and a condition
# reading one, or a U64 global's value, is decided by compile-time evaluation (B9c), the token evaluator's arithmetic being I64's
Big U64 = 18446744073709551615
if Big > 5 {
    fn top() I32 { return 1 }
} else {
    fn top() I32 { return 2 }
}
fn loc() I32 {
    if X == 18446744073709551615: return 1
    return 2
}
fn main() ? {
    assert top() == 1 and loc() == 1
    big U64 = X
    assert big == 18446744073709551615
    assert $X == "18446744073709551615"
}
