# check: fail error[O39]: assigning 'c.text' may release the String borrowed on line
# vec5 (r2b_typed_local_loop_after_release): the natural form: the next turn of a loop builds in the region the previous
# turn released
import "std/io"
type CB struct() {
    text own mut String& = $1 "-ttttttttttttttt"
}
fn main() ? {
    c := CB()
    x := c.text
    for i in range 3 {
        d mut String&x = $i "-new-text-in-x's-region"
        io.Println(d)
        c.text = $i "-replaced-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
        churn()
    }
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
