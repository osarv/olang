# check: fail error[O39]: assigning 'v.o' may release the Inner borrowed on line
# also: note: kept here, until the end of the block it is kept in
# O38: a borrowed copy kept by a call - List.Push - is borrowed until the end of the block the list lives in: what
# the list holds is b's storage, whose pointers name v's owners (the review of own phase 2a, F2)
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    l := List<Outer&>()
    l.Push(b)
    v.o = null
    println($l[0].o.deep.text)
}
