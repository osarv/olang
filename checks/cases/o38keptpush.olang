# check: fail error[O38]: this argument borrows an own object, and the callee may keep it beyond the call
# O38: a borrowed copy is held only by this function's locals - a call that can keep it (List.Push) is refused, where
# phase 2a's review (F2) held the loan until the list's block ended (reversed by own4: the holders could not all be found)
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    l := List<Outer&>()
    l.Push(b)
    v.o = null
    io.Println($l[0].o.deep.text)
}
