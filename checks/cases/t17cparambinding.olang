# check: fail error[T17c]: this value's payload refers to storage the value would outlive
# O4b/T17c: a by-value enum parameter's payload lives where its argument's references do - a scope of the parameter,
# not the program's - so a binding read out of it cannot be pushed into a longer-lived list
type Node struct(v I32) {
    v
}
type Box enum {
    Has(n Node&)
    No
}
fn stash(b Box, l mut Vec<Node&>&) {
    match b {
        case Box.Has(n) { l.Push(n) }
        case _ { }
    }
}
fn main() ? {
    l mut Vec<Node&>& = Vec<Node&>()
    for _ in range 2 {
        inner Node& = Node(42)
        stash(Box.Has(inner), l)
    }
}
