# check: fail error[E34]: 'take' writes the slot it moves out of, and it is read-only here
# taking out of a read-only path writes nothing
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn grab(s Server&) {
    x := take s.cur
}
fn main() ? {
    s := Server()
    grab(s)
}
