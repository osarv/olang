# check: run
# E11c: "$" calls a Str once per rendering, whatever it writes - a cursor with an "&of" field reached through a
# reference: once per "$"
type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
type Cur struct(of Bag&) {
    c mut Cell&of = of.c
}
type W struct(cur mut Cur&) {
    cur
}
fn poke(w mut W&) { w.cur.c.v++ }
fn (b Bag&) Str() String {
    w := W(Cur(b))
    poke(w)
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    assert $b == "b1"
    assert $b == "b2" and b.c.v == 2
}
