# check: fail error[T25c]: a copy of a read-only Box cannot be stored where it can be written
# T25c: an array's fill is copied into every element, each writable
type Box struct(P mut Array<I64>&) {
    P
}
GB Box = Box(Array<I64>(3))
G List<I64> = List<I64>()
fn main() ? {
    a := Array<Box>(2, GB)
    a[0].P[0] = 1
}
