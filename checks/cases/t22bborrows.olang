# check: run
# flags: -debug -sanitize
# T22c (was a T22b refusal): second gives back what b refers to, more than "borrows a" says - followed into use, its
# result is judged where b's argument lives
# T22b, T21c: "borrows a" says the result refers only into what a refers to
type N struct(v I64) { v }
fn second(a N&, b N&) N& { return b }
fn use(f fn&(a N&, b N&) N& borrows a, a N&) I64 {
    r := f(a, N(2))
    return r.v
}

# storage made and let go many times, so a value kept in a scope already closed would read another's
fn churn(n I64) I64 {
    t := 0
    for i in range n {
        v := Vec<N>()
        for j in range 16 { v.Push(N(i * j)) }
        t += v[15].v
    }
    return t
}
fn main() {
    k := use(second, N(1))
    churn(100)
    assert k == 2
}
