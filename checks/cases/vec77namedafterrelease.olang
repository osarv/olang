# check: fail error[O39]: assigning 'c.text' may release the String borrowed on line
# vec5 (r2b_after_release_region_reused_silent): a borrow named as a scope after its owner released it - building there
# is a use of the borrow's region (R2b)
import "std/io"
type CB struct() {
    text own mut String& = $1 "-ttttttttttttttt"
}
fn main() ? {
    c := CB()
    x := c.text
    c.text = $2 "-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    e := CB()
    d mut String&x = $5 "-new-text-in-a-reused-region"
    e.text = $3 "-wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww"
    churn()
    io.Println(d)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
