# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c: a callback parameter reassigned to one that builds - a parameter is the callee's own copy (D9), so a call
# through it is a body not known and is taken to build (C7)
import "std/io"
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type Bag struct(head mut Node&) {
    head
}
fn hook(g fn&(x mut Node&), n mut Node&) {
    g = fn(x mut Node&) { x.next = Node(x.v + 100) }
    g(n)
}
fn (b Bag&) Str() String {
    hook(fn(x mut Node&) { }, b.head)
    return "b" $b.head.v
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    b := Bag(Node(1))
    try io.Println($b)
    t := churn(100)
    try io.Println($b.head.next!.v " " $t)
}
