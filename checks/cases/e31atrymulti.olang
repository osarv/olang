# check: fail error[E31a]: 'checked' on several indices needs Grid to declare CheckedAt
# never: nothing here can fail
# E31a/R20: a checked multi-index with no CheckedAt is one error - the "checked" around it says nothing more
import "std/io"
type Grid struct(w I64) {
    w
    cells mut Array<I64>& = Array<I64>(w * w)
}
fn (g Grid&) At(r I64, c I64) I64 { return g.cells[r * g.w + c] }
fn (g Grid&) Len() I64 { return g.w * g.w }
fn main() ? {
    g := Grid(3)
    a := checked g[0, 1] catch default -1
    try io.Println($a)
}
