# check: run
# flags: -define Flag=true -define Ratio=0.75 -define Huge=5000000000 -define Level=3 -define Mode=fast -define Expect=30
error E { X }
if Level > 2 and Mode == "fast" {
    fn pick() I64 { return Level * 10 }
} else {
    fn pick() I64 { return -1 }
}
fn main() ? E {
    assert pick() == Expect
    assert Flag
    assert Ratio >= 0.5
    big I64 = Huge
    assert big == 5000000000
}
