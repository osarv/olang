# check: run
# flags: -D Flag=true -D Ratio=0.75 -D Huge=5000000000 -D Level=3 -D Mode=fast -D Expect=30
error E { X }
if Level > 2 and Mode == "fast" {
    fn pick() Int32 { return Level * 10 }
} else {
    fn pick() Int32 { return -1 }
}
fn main() ? E {
    assert pick() == Expect
    assert Flag
    assert Ratio >= 0.5
    big Int64 = Huge
    assert big == 5000000000
}
