# check: fail error[M19g]: 'l.toks' may grow here while a task holds a view of it - give the task a copy: 'l.toks.ToArray()'
# a task given a view of a field's Vec, the Vec grown before its join
# M19g, round 2 (brought back from round 1's deletion): the same Vec is seen on both sides, so the view is refused
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn look(d Array<I64>&) I64 { return d[0] }
fn main() ? {
    l := Lexer(3)
    for i in range 3 { l.toks.Push(i) }
    d := l.toks.View()
    join {
        spawn look(d)
        l.toks.Push(4)
    }
}
