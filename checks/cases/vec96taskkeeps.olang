# check: fail error[O39]: calling 'Push' may release the Array<I64> borrowed on line 11, which is used after it
# Vec phase 2a (O41/O39): a task given a view of a field's Vec holds the loan until its join
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn look(d Array<I64>&) I64 { return d[0] }
fn main() ? {
    l := Lexer(3)
    for i in range 3 { l.toks.Push(i) }
    d := l.toks.View()
    join {
        spawn look(d)
        l.toks.Push(4)
    }
}
