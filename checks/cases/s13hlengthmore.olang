# check: fail none matches an array of 3 elements or more
# S13h: past the longest pattern written, one length stands for every longer one
fn f(xs Array<I64>&) I64 {
    return match xs {
        case I64[]: 0
        case I64[a]: a
        case I64[a, b]: a + b
    }
}

fn main() {
    assert f(I64[1, 2]) == 3
}
