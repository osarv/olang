# check: fail does not cover every case
# S13a: a case with a value or another case inside its payload may let a value through, so it covers nothing
type T enum {
    P
    Q
}
type S enum {
    A(t T)
    B
}
fn f(s S) I32 {
    match s {
        case S.A(T.P) { return 1 }
        case S.A(T.Q) { return 2 }
        case S.B { return 0 }
    }
    return -1
}
fn main() ? { }
