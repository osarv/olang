# check: fail error[O39]: assigning 'c.text' may release the String borrowed on line
# vec4 (r1b_scope_argument_names_borrow): the review's repro
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# new storage built into an own object's region through a scope argument (E25) naming a borrow
type CB struct() {
    text own mut String& = $1 "-ttttttttttttttt"
}
fn mk(n I64) mut String& { return $n "-new-text-in-the-region" }
fn main() ? {
    c := CB()
    x := c.text
    d := mk&x(5)
    c.text = $2 "-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    io.Println(d)
}
