# check: fail error[T32]: 'Take' keeps a copy of the value it is called on, and an any Iterator<I64>& has none - call it on the instance's own type
# T32 (the second any review, finding 5): an adapter (Take, Skip, Enumerate, Zip, Chain) wraps a copy of the iterator it
# is made from, and an any - whose instance is of a type not known here - has no copy to give; a limit, said at the call
type Ups struct(n I64) {
    n
    at I64 = 0
}
fn (u mut Ups&) Next() I64 ? Exhausted {
    if u.at >= u.n { error Exhausted.End }
    u.at += 1
    return u.at
}
fn main() {
    it mut any Iterator<I64>& = Ups(3)
    n I64 = 0
    for x in it.Take(2) { n += x }
}
