# check: fail error[E31b]: x[i] gives a copy of the element, which this call would write while it can reach the collection
# never: error[E31, O17]
# R1 (refusals 5.1): the split lend is no longer refused; E31b's write-back stays (section 6)
# E31b, two-phase: an argument evaluated first must own nothing and hold no reference - one owning storage a call makes
# (a Vec) is no such value, so the call through x[i] stays the copy's and is refused
type B struct() {
    xs Vec<I64> = Vec<I64>()
}
fn (b mut B&) Take(v Vec<I64>) { b.xs = v }
fn grow(bs mut Vec<B>&) Vec<I64> {
    bs.Push(B())
    return Vec<I64>()
}
fn main() ? {
    bs := Vec<B>()
    bs.Push(B())
    bs[0].Take(grow(bs))
}
