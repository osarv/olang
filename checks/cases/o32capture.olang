# check: fail error[O32]: a lambda does not capture the owner local 'o' - capture a borrow of it
# a lambda's copy of an owner local would be a second owner, releasing or moving what the body still owns
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn main() ? {
    o own mut Holder& = Holder()
    o.cur = Node(4)
    f := fn() { o.cur = null }
    c := o.cur
    f()
    try io.Println(c.name)
}
