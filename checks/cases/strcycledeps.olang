# check: fail error[E11c, O12]: '$' does not say where a value it renders lives, so Str builds and stores nothing where its receiver reaches
# E11c: a call cycle handing on a callback - a call through a function-typed parameter is a body not known, so the
# higher-order functions are taken to build where they call it, whatever is passed (no parametric walk: C1)
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Bag struct(head mut Node&) {
    head
}
fn ca(g fn(x mut Node&), n mut Node&, c I64) {
    if c > 0 { cb(n, c - 1) }
    g(n)
}
fn cb(n mut Node&, c I64) {
    ca(fn(x mut Node&) { x.next = Node(x.v + 100) }, n, c)
}
fn (b Bag&) Str() String {
    ca(fn(x mut Node&) { }, b.head, 2)
    return "b" $b.head.v
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    b := Bag(Node(1))
    println($b)
    t := churn(200)
    l := List<Node&>()
    for i in range 50 { l.Push(Node(i)) }
    println($b.head.next.v " " $t)
}
