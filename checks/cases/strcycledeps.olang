# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c: a call cycle handing on a callback - a call through a function-typed parameter is a body not known, so the
# higher-order functions are taken to build where they call it, whatever is passed (no parametric walk: C1)
import "std/io"
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type Bag struct(head mut Node&) {
    head
}
fn ca(g fn&(x mut Node&), n mut Node&, c I64) {
    if c > 0 { cb(n, c - 1) }
    g(n)
}
fn cb(n mut Node&, c I64) {
    ca(fn(x mut Node&) { x.next = Node(x.v + 100) }, n, c)
}
fn (b Bag&) Str() String {
    ca(fn(x mut Node&) { }, b.head, 2)
    return "b" $b.head.v
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    b := Bag(Node(1))
    try io.PutLine($b)
    t := churn(200)
    l := Vec<Node&>()
    for i in range 50 { l.Push(Node(i)) }
    try io.PutLine($b.head.next!.v " " $t)
}
