# check: fail error[P4a]: a task's clause runs on the task and may not return - it ends where its block does
# P4a: a task's clause is code of the task, a function of its own - a return there would leave the task, not the spawner
error E {
    BAD
}
fn work(n I32) ? E {
    if n < 0 { error E.BAD }
}
fn run() I32 {
    join {
        spawn try work(-1) catch E { return 1 }
    }
    return 0
}
fn main() ? { println($run()) }
