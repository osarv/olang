# check: fail error[S17]: an assert's message may not return
# vec4 (f1e_assert_message_return): the review's repro
import "std/io"
type Stop error {
    Here
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# F1 evasion: a return hidden in an assert message's catch block
fn pick<T>(c Bool, x T, y T) T { return x if c else y }
fn g(k I64) I64 ? {
    if k < 5 { error Stop.Here }
    return k
}
fn h(k I64) String ? {
    if k < 5 { error Stop.Here }
    return "ok"
}
fn longer(a mut Array<I64>&, b mut Array<I64>&) mut Array<I64>& {
    assert a.Len() > 100, (try h(a.Len()) catch { return pick(true, a, b) })
    return Array<I64>(3)
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    other mut Array<I64>& = Array<I64>(1)
    d := longer(v.ViewMut(), other)   # a view of the Vec's buffer
    for i in range 1000 { v.Push(i) } # frees the buffer
    churn()
    try io.Println($d[0] " " $d[1])
}
