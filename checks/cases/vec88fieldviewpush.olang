# check: fail error[M19g]: 'd' holds a view of 'l.toks' taken before 'l.toks' may have grown
# Vec phase 2a (O31/O39): a view of a field's Vec is a loan on its buffer - a push through the struct while it is used
# M19g, round 2 (brought back from round 1's deletion): the same Vec is seen on both sides, so the view is refused
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn main() ? {
    l := Lexer(3)
    for i in range 3 { l.toks.Push(i) }
    d := l.toks.View()
    l.toks.Push(9)
    try io.Println($d[0])
}
