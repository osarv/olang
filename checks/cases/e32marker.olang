# check: run
# E32: an "&" after the type "as" names is the operator where an operand follows it on its line - no scope is written
# after a type (QCB) - so "b as Box.Val & mask" is "(b as Box.Val) & mask"
type Box enum {
    Val I32
    None
}
fn main() {
    mask I32 = 6
    b := Box.Val(7)
    x I32 = (b as Box.Val & mask)!
    assert x == 6
}
