# check: fail error[O39]: assigning 'v.o' may release the Inner borrowed
# O37/O38 (Vec phase 1): a borrowed own result - ...borrowed through a borrowed copy, released through the owner
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}
Made mut I64 = 0
Dropped mut I64 = 0
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
    data own mut Array<I64>&
}
type H struct() {
    o own mut Inner&
}
type Keep struct() {
    x Inner& = null
}
type Wrap struct(x Inner&) {
    x
}
type Res struct(x Inner&) {
    x
    Made = Made + 1
} destruct {
    Dropped = Dropped + 1
}
fn (v Outer&) First() Inner&v { return v.o }
fn (v Outer&) View() Array<I64>&v { return v.data }
fn (v mut Outer&) Grow() {
    v.data = Array<I64>(v.data.Len() * 2 + 1)
}
fn (v mut Outer&) Drop() { v.o = null }
fn (h H&) HFirst() Inner&h { return h.o }
fn (h mut H&) HDrop() { h.o = null }
fn (v Outer&) Deep() Inner&v { return v.First() }
fn mkO(k I64) Outer {
    v := Outer()
    v.o = Inner(k)
    v.o.deep = Leaf(k)
    v.data = Array<I64>(4, k)
    return v
}
fn useI(x Inner&, out mut Array<I64>&) { out[0] = x.k }
fn main() ? {
    v := mkO(3)
    b := v
    f := b.First()
    v.o = null
    churn()
    io.Println($f.k)
}
