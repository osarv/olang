# check: fail error[O39]: assigning 'b.data' may release the Array<Q> borrowed on line 15, which is used after it
# Vec phase 2a (O38): a value element read out of an own array borrows nothing of its buffer - a slice of a part of it
# borrows it where it is, in the buffer
type Q struct(n I64, s String&) {
    n
    s
    arr Array<I64, 4> = Array<I64, 4>()
}
type B struct() {
    data own mut Array<Q>& = null
}
fn main() ? {
    b := B()
    b.data = Array<Q>(2)
    sl := b.data[0].arr[0:2]
    b.data = Array<Q>(1)
    println($sl[0])
}
