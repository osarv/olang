# check: fail x[i] gives a copy of the element, which this call would write
# also: the callee is no view of the element because of this statement
# E31b (r3, a recorded over-rejection; D3): a "match" on an enum value field makes the callee no view - and the note
# points at the statement in the callee that did
import "std/io"
type K enum {
    A
    B
}
type Pt struct() {
    X I64 = 0
}
type V struct(d mut Array<I64>&, n I64) {
    d
    n
    kind K = K.A
    inl Array<I64> = Array<I64>(2)
    p Pt = Pt()
}
type Vs struct(d mut Array<I64>&) {
    d
}
fn (s Vs&) At(i I64) V { return V(s.d, i) }
fn f(c mut V&) {
    match c.kind {
        case K.A { c.d[0] = 1 }
        case K.B { }
    }
}
fn main() ? {
    s := Vs(Array<I64>(4))
    f(s[1])
    try io.Println($s.d)
}
