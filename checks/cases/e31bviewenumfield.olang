# check: run
# flags: -debug -sanitize
# R8 (refusals 5.7): compiles now - a "match" on an enum value field with no payload reads its ordinal, as a number
# field is read, so the callee is a view of the element (E31b) and its write lands in the array the element refers to.
# It was refused ("x[i] gives a copy of the element, which this call would write" - r3, a recorded over-rejection)
import "std/io"
type K enum {
    A
    B
}
type Pt struct() {
    X I64 = 0
}
type V struct(d mut Array<I64>&, n I64) {
    d
    n
    kind K = K.A
    inl Array<I64> = Array<I64>(2)
    p Pt = Pt()
}
type Vs struct(d mut Array<I64>&) {
    d
}
fn (s Vs&) At(i I64) V { return V(s.d, i) }
fn f(c mut V&) {
    match c.kind {
        case K.A { c.d[0] = 1 }
        case K.B { }
    }
}
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}
fn main() ? {
    s := Vs(Array<I64>(4))
    f(s[1])
    churn()
    try io.PutLine($s.d)
}
