# check: fail error[E31d]: a Copy only builds the new value, and this one writes a global - every copy of the value runs it, so it may do nothing else
# E31d: a Copy's one effect is allocating what it builds - this one counts the copies in a global
Copies mut I64 = 0
type tree struct(n mut I64&) { n }
fn (t tree&) Copy() tree {
    Copies++
    return tree(I64(t.n))
}
fn main() {
    a := tree(1)
    b := a
    assert I64(b.n) == 1
}
