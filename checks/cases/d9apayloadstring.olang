# check: run
# QCE (T7a relaxed): an enum case's payload holds an array of a run-time length by value, its own (it was D9a's error,
# "passed by reference" - review port1 r10, r10b)
import "std/io"
type E enum {
    A(s String)
    B(c Array<Char>)
    F(f Array<I64>)
    N
}
fn wrap(i I64) E { return E.A($i "-payload") }
fn main() ? io.Error {
    e := wrap(1)
    m := match e {
        case E.A(s): $s
        case _: "none"
    }
    try io.Println(m)
}
