# check: fail error[O39]: taking 'o.cur' moves the Node borrowed on line
# a move from an owner local's tree into a parameter's, while a borrow of it is in use - released through the parameter,
# the loan rooted at the owner local would not be met
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    sub own mut Holder&
}
fn f(p mut Holder&) {
    o own mut Holder& = take p.sub
    o.cur = Node(9)
    c := o.cur
    p.cur = take o.cur
    p.cur = null
    println(c.name)
    p.sub = take o
}
fn main() ? {
    h := Holder()
    h.sub = Holder()
    f(h)
}
