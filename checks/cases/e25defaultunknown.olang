# check: fail error[E25]: 'q' is no local or parameter here - a scope argument names where the result is built
# E25 (the fourth any review, D): a parameter's default naming another parameter in a scope argument names nothing - a
# default is built in the caller, where the parameters are no locals
type P struct(n I64) { n }
fn mkp(i I64) P& { return P(i) }
fn use(q P&, p P& = mkp&q(5)) I64 { return q.n + p.n }
fn main() {
    assert use(P(1)) == 6
}
