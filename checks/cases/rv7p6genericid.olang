# check: run
# E11c: "$" calls a Str once per rendering, whatever it writes - a part handed through a generic identity to a helper
# writing it: once per "$"
type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
fn id(x <T>) T { return x }
fn bump(c mut Cell&) { c.v++ }
fn (b Bag&) Str() String {
    bump(id(b.c))
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    assert $b == "b1"
    assert $b == "b2" and b.c.v == 2
}
