# check: fail error[O34]: 'take' gives an owner, which only an own slot receives
# a type variable binds a borrow, so take into one moves nowhere
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn id<T>(x T) T { return x }
fn main() ? {
    x own mut Conn& = Conn(1)
    n := id(take x)
}
