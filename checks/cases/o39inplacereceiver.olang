# check: fail error[O39]: calling 'Bump' may release the In3 borrowed on line 19
# O39 (own7 F1): so does one that is a method's receiver
import "std/io"
type Plain struct(k I64) {
    k
}
type In3 struct(k I64) {
    pl Plain = Plain(k)
}
type H3 struct() {
    cur own mut In3&
}
fn (p mut Plain&) Bump(h mut H3&) I64 {
    h.cur = null
    return p.k
}
fn main() ? {
    h mut H3& = H3()
    h.cur = In3(7)
    try io.Println($h.cur.pl.Bump(h))
}
