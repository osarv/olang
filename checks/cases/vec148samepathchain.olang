# check: fail error[O25h]: this value holds references into a scope the target outlives
# round 1 of docs/memory.md: a Vec is a handle, so 'take' no longer moves one - its record stays in the first own
# object's region, and storing the handle into another region is refused by O25h (O1b for a global, O38 for a borrow)
# vec7 F1, its natural form: a cursor walking a chain moves the next parser's words into a borrow of the previous one's lexer
# - 'prev.more' and 'c.lx.toks' are the same path by name (c, then lx), two different objects
import "std/io"
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
    more Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
    next mut Parser& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    first mut Parser& = Parser()
    first.lx = Lexer()
    first.next = Parser()
    first.next.lx = Lexer()
    for i in range 3 { first.next.lx.toks.Push($i "-word-in-the-second-lexer") }
    c mut Parser& = first
    prev := c.lx
    c = c.next
    prev.more = c.lx.toks
    c.lx = null
    churn()
    try io.Println(first.lx.more[0])
}
