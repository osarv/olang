# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# E28/O12 (the batch 6 review): ...a match giving values, stored into a local reference's field from a loop body
import "std/io"
type Bag struct() {
    last String& = ""
}
fn main() ? {
    b mut Bag& = Bag()
    for i in range 2 {
        x String& = "w" $i
        b.last = match i { case 1: x case _: "z" }
    }
    try io.PutLine(b.last)
}
