# check: run
# flags: -debug -sanitize
# R8 (refusals 5.7): compiles now - a task's default built here holding existing storage is judged as the task's own
# result is: 'anchor' outlives 'r'. It was refused ("a task's default ... names existing storage"); read back after a
# churn
import "std/io"
type E error {
    Bad
}
type Node struct(v I64, next Node?&) {
    v
    next
}
fn Node.mk(n I64) Node& ? E {
    if n < 0 { error E.Bad }
    return Node(n, null)
}
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}
fn main() ? {
    anchor Node& = Node(7, null)
    r Node?& = null
    join {
        spawn r = try Node.mk(-1) catch default Node(-1, anchor)
    }
    churn()
    try io.Println($r!.v " " $r!.next!.v)
}
