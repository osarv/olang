# check: fail error[S13f]: unknown name 'big'
# never: error: unknown name
# S13f: a lone unknown name in a case was meant to take the value - which "case _ if" does. One error: the guard reading
# the name is not reported again
import "std/io"
fn classify(n I64) String {
    return match n {
        case 0: "zero"
        case big if big > 100: "big"
        case _: "small"
    }
}
fn main() ? { try io.PutLine(classify(500)) }
