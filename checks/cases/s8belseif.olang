# check: run
# S8b: after the branch the build chose, the rest of the chain is skipped - an "else if" condition holding braces of
# its own (a match) included
fn f(x I32) I32 {
    if TargetOs == "linux" or TargetOs != "linux" {
        return 1
    } else if match x { case 1 => true nomatch => false } {
        return 2
    }
    return 3
}
fn main() ? { assert f(1) == 1 }
