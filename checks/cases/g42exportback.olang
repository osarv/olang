# may do what the export fn does - here write a global
import poke "../fixtures/callback/poke.c"
G mut I64 = 0
export fn olang_grow(n I64) { G = G + n }
fn bump() { poke.c_poke(1000) }
assert not bump.WritesGlobals
fn main() { bump() }
