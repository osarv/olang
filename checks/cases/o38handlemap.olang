# check: fail error[O38]: this argument borrows an own object, and the callee may keep it beyond the call
# O38: ...or a Map's copy (own4 N5)
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    m := Map<I64, Outer&>()
    {
        m2 := m
        m2.Put(1, b)
    }
    v.o = null
    x := try m.Get(1) catch default null
    try io.Println($x.o.k)
}
