# check: run
# E31/QQ1: a plain operator method may declare errors - the operator then fails as written, under 'try' like a call
# (it used to be E31a's "Mul cannot fail")
type VErr error {
    Zero
}
type V struct(x I32) {
    x
}
fn (a V) Mul(b V) V ? VErr {
    if b.x == 0 { error VErr.Zero }
    return V(a.x * b.x)
}
fn main() ? {
    p := try V(3) * V(4)
    assert p.x == 12
    q := try V(3) * V(0) catch VErr default V(-1)
    assert q.x == -1
}
