# check: fail this value's references live where its own storage does not, and the callee can store through it
# O17 (U1): as o17tempcallresult, the parameter read-only - the callee builds through the shallow "mut" field
import "std/io"
fn churn() ? io.Error {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { try io.Println("x") }
    }
}
type Node struct(v I64, next mut Node?&) {
    v
    next
}
type Box struct() {
    head mut Node& = Node(0, null)
    tag I64 = 0
}
fn mkBox(seed mut Box&) Box { return seed }
fn addVia(b Box&, v I64) { b.head.next = Node(v, b.head.next) }
fn sum(b Box&) I64 {
    t I64 = 0
    for n Node?&b = b.head, n is not null, n = n.next { t = t * 10 + n.v }
    return t
}
fn main() ? {
    seed := Box()
    for i in range 3 {
        addVia(mkBox(seed), i + 1)
        try churn()
    }
    try churn()
    try io.Println("seed " $sum(seed))
}
