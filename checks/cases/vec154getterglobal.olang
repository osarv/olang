# check: fail note: this object is reached through a call's result, a borrow of an owned object whose region is not known here
# vec7 F2 on a global, whose getter's result is tagged with the program's scope
import "std/io"
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn (p mut Parser&) Lx() mut Lexer&p { return p.lx }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
GP mut Parser = Parser()
G2 mut Vec<String&> = Vec<String&>()
fn main() ? {
    GP.lx = Lexer()
    for i in range 3 { GP.lx.toks.Push($i "-word-built-in-the-lexer's-region") }
    G2 = take GP.Lx().toks
    GP.lx = null
    churn()
    try io.Println(G2[0])
}
