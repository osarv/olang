# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# round 1 of docs/memory.md: a Vec is a handle, so 'take' no longer moves one - its record stays in the first own
# object's region, and storing the handle into another region is refused by O25h (O1b for a global, O38 for a borrow)
# vec7 F2 on a global, whose getter's result is tagged with the program's scope
import "std/io"
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn (p mut Parser&) Lx() mut Lexer&p { return p.lx }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
GP mut Parser = Parser()
G2 mut Vec<String&> = Vec<String&>()
fn main() ? {
    GP.lx = Lexer()
    for i in range 3 { GP.lx.toks.Push($i "-word-built-in-the-lexer's-region") }
    G2 = GP.Lx().toks
    GP.lx = null
    churn()
    try io.Println(G2[0])
}
