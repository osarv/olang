# check: fail error[X13a]: a C function pointer ('extern fn?&(x I32) I32') is made of an export fn, named
# X13a: C calls a function pointer by an export fn's C entry, which an ordinary function does not have
type Hooks struct() {
    twice extern fn?&(x I32) I32 = null
}

fn doubled(x I32) I32 { return 2 * x }

fn main() {
    h := Hooks()
    h.twice = doubled
}
