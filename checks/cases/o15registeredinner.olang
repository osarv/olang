# check: run
# flags: -debug -sanitize
# O15, O16 (docs/refusals.md 5.6, R7; refused until call 8 of 2026-11-08): a ":=" from a call of a destructor type in an
# inner block, holding a variable of an enclosing one through its own field, is a holder of its block - ended as that
# block is left, while the variable it holds is alive
import "std/io"
type Tally struct() {
    n I64 = 0
}

type Lamp unique struct(id I64, log mut Tally&) {
    id, log
    alive := true
} destruct {
    log.n += id
    alive = false
}

type Grip unique struct(id I64) {
    id
    held Lamp?& = null
} destruct {
    if held is not null {
        assert held!.alive, "a Grip read its Lamp ended"
        held!.log.n += held!.id * 10
    }
}

fn run(t mut Tally&) {
    l Lamp = Lamp(10, t)
    {
        g := Grip(9)
        g.held = l
    }
    assert t.n == 100
}

fn main() ? {
    t := Tally()
    run(t)
    assert t.n == 110
    try io.PutLine("n " $t.n)
}
