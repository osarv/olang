# check: fail error[E31b]: x[i] gives a copy of the element
# E31b (bulk review 6 F1): the call through x[i] is not made in place through RefMut where what it runs before its
# write lands - the method, a constructor an argument calls - may change the collection (here: a closure the element holds grows it) - the copy's error
import "std/io"

type blk struct(n I64, f fn&()) { n, f }

fn (b mut blk&) Run() {
    b.f()
    b.n = 99
}

fn main() {
    v := Vec<blk>()
    vr mut Vec<blk>& = v
    v.Push(blk(1, fn() { }))
    g := fn() { for i in range 1000 { vr.Push(blk(i, fn() { })) } }
    v[0].f = g
    v[0].Run()
    io.Println("v[0].n = " $v[0].n " len " $v.Len())!
}
