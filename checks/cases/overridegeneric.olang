# check: fail would override an interface's default that is generic in a type of its own
# M19e: Fold names a family of functions (its U), so it has no table slot - an override would hold only on a direct call
type Ones struct(n I32) {
    left mut I32 = n
}
fn (o mut Ones&) Next() I32 ? Exhausted {
    if o.left == 0 { error Exhausted.END }
    o.left--
    return 1
}
fn (o mut Ones&) Fold(init I32, f fn(acc I32, x I32) I32) I32 { return 0 }
fn main() ? { }
