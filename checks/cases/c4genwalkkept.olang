# check: run
# flags: -debug -sanitize
# C4 (bulk review 6's held/gen_walkkept), D18c, O27 as placement: a generator yielding views of storage its walk keeps (a
# local copy of its parameter) has that local built where the generator lives, and a consumer keeping the elements past
# the walk has the walk made where they are kept - it was two errors for one cause (O27 in the generator, O10c at the
# consumer); read back after a churn
import "std/io"

fn pieces(t String&) Iterator<String&> {
    c := $t
    for i in range c.Len() { yield c[i:i + 1] }
}

fn main() {
    x := "abc"
    out := Vec<String&>()
    for w in pieces(x) { out.Push(w) }
    g := pieces(x)
    for w in g { out.Push(w) }
    junk := Vec<String>()
    for i in range 100 { junk.Push("zzzzzzzzzzzzzzzzzz" $i) }
    io.PutLine($out " " $junk.Len())!
}
