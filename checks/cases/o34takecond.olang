# check: fail error[O34]: a conditional or a match gives an own slot nothing yet
# a conditional's value is no move: each branch assigns its owner
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn main() ? {
    s := Server()
    s.cur = Conn(1)
    s.other = (take s.cur) if s.cur != null else null
}
