# check: run
# R4 (refusals 5.4): compiles now - what the task's clause captured is built at the join's level, one per turn; it was
# refused, as what follows says
# P4a/P2: a task's clause is a lambda made at the spawn - what it captures lasts until the join, as a spawned lambda's does
import "std/io"
extern fn usleep(us U32) I32
type E error {
    Bad
}
type Node struct(v I64) {
    v
}
fn work(n I64) ? E {
    usleep(20000)
    if n < 0 { error E.Bad }
}
fn note(n Node&, seen mut Array<I64>&) { seen[n.v] = n.v * 10 }
fn main() ? {
    seen mut Array<I64>& = Array<I64>(4)
    join {
        for i in range 4 {
            n Node& = Node(i)
            spawn try work(i - 2) catch E { note(n, seen) }
        }
    }
    try io.Println($seen[0] " " $seen[1] " " $seen[2] " " $seen[3])
}
