# check: fail error[O39]: calling 'Push' may release the Array<Link> borrowed on line 18, which is used after it
# Vec phase 2a (O38/O39): ...and one read out of a view in the same statement
type Node struct(n I64) {
    n
}
type Link struct(name String&, to mut Node&) {
    name
    to
}
type Hold struct() {
    l Link& = null
}
fn main() ? {
    nd := Node(1)
    h := Hold()
    v := Vec<Link>()
    v.Push(Link("a", nd))
    h.l = v.View()[0]
    for i in range 40 { v.Push(Link("b", nd)) }
    println($h.l.name)
}
