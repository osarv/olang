# check: fail String does not satisfy the constraint Number on T
# also: 'Twice' is called through an 'any Source<String>&' here, so aWords needs it
# T32a (the any review, finding 4): a default reached through an any is instantiated for the instance's type, and one
# whose constraint the type does not meet is an error with a note at the call that reached it. (The prelude's Sum was
# the example until it took a variable of its own, A, G4a - a default introducing one is no table slot, T35)
import "std/io"
type Source<T> trait {
    Get() T
}
fn (s S&) Twice<S Source<T>, T Number>() T { return s.Get() + s.Get() }
type aWords struct(n I64) {
    n
}
fn (w aWords&) Get() String { return "w" + $w.n }
fn main() {
    w := aWords(3)
    it any Source<String>& = w
    io.PutLn($it.Twice())!
}
