# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c: a self-recursive function passing its recursive call a building callback - taken to build where it calls its
# callback (C1b)
import "std/io"
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type Bag struct(head mut Node&) {
    head
}
fn rec(g fn&(x mut Node&), n mut Node&, c I64) {
    if c > 0 { rec(fn(x mut Node&) { x.next = Node(x.v + 100) }, n, c - 1) }
    g(n)
}
fn (b Bag&) Str() String {
    rec(fn(x mut Node&) { }, b.head, 1)
    return "b" $b.head.v
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    b := Bag(Node(1))
    try io.Println($b)
    t := churn(100)
    try io.Println($b.head.next!.v " " $t)
}
