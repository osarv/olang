# check: fail CheckedPlus is Plus's checked form, so it fails with every error Plus can - add VErr after its '?'
# also: instantiated here, with T = V
# E31a: the superset rule is judged per instantiation, where a generic plain form's set is its type argument's
import "std/io"
error VErr {
    NEG
}
type V struct(n I64) {
    n
}
fn (a V) Plus(b V) V ? {
    if b.n < 0 { error VErr.NEG }
    return V(a.n + b.n)
}
type Box<T> struct(v T) {
    v
}
fn (a Box<T>) Plus(b Box<T>) Box<T> ? {
    return Box(try (a.v + b.v))
}
fn (a Box<T>) CheckedPlus(b Box<T>) Box<T> ? BuiltinError {
    return Box(checked (a.v + b.v) catch VErr default a.v)
}
Neg mut I64 = -1
fn main() {
    x := (Box(1) + Box(2)).v
    io.Println($x)!
    y := checked (Box(V(1)) + Box(V(Neg))) catch default Box(V(0))
    io.Println($y.v.n)!
}
