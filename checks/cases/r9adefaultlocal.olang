# check: fail error[O10d]: this value lives in this function's own scope, which closes first
# R9a: a returned call lands in the result scope, which the function's own by-value parameter does not live in. (A local
# built here and returned as the default lives in the result scope instead, O26a.)
type Stop error {
    Here
}
type Node struct(v I32) {
    v
}
fn Node.mk(k I64) Node& ? {
    if k > -5 { error Stop.Here }
    return Node(7)
}
fn get(seed Node) Node& {
    return try Node.mk(1) catch default seed
}
fn main() ? {
}
