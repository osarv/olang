# check: fail error[S17]: an assert's message may not return
# vec4 (x1_assert_message_return_i_vs_b): the review's repro
# -i and the built program disagree: a return inside an assert message's catch block
import "std/io"
type Stop error {
    Here
}
fn h(k I64) String ? {
    if k < 5 { error Stop.Here }
    return "ok"
}
fn f(k I64) I64 {
    assert k > 100, (try h(k) catch { return 7 })
    return 3
}
fn main() ? {
    try io.Println($f(1))
}
