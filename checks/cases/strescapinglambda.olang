# check: fail error[E11c, O12]: '$' does not say where a value it renders lives, so Str builds and stores nothing where its receiver reaches
# E11c/D16c: a helper's lambda over the receiver's node that is copied (not only called) lives where the node does (D16d)
# - its environment is built there, so it is refused
type Node struct(v I64) {
    v
}
type Bag struct(head Node&) {
    head
}
fn peek(n Node&) I64 {
    f := fn() I64 { return n.v }
    g := f
    return g()
}
fn (b Bag&) Str() String { return "b" $peek(b.head) }
fn main() ? { println($Bag(Node(4))) }
