# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/D16c: a helper's lambda over the receiver's node that is copied (not only called) lives where the node does (D16d)
# - its environment is built there, so it is refused
import "std/io"
type Node struct(v I64) {
    v
}
type Bag struct(head Node&) {
    head
}
fn peek(n Node&) I64 {
    f := fn() I64 { return n.v }
    g := f
    return g()
}
fn (b Bag&) Str() String { return "b" $peek(b.head) }
fn main() ? { try io.PutLine($Bag(Node(4))) }
