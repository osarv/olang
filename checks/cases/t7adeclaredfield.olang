# check: run
# QCE (T7a relaxed): a declared array type (String, "type Nums Array<I64>") held by value in a field is the instance's
# own, copied with it (it was T7a's error - review port1 r04, r06)
import "std/io"
type Nums Array<I64>
type Rec struct(n I64) {
    t := $n "-text"
    a Nums = Nums(Array<I64>(n, 7))
}
fn mk(n I64) Rec { return Rec(n) }
fn main() ? io.Error {
    k := mk(4)
    try io.Println($k.t " " $k.a[3])
}
