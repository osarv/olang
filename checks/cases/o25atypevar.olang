# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O25a: a local written as a bare type variable takes its initializer's scope - here x's - so pushing it into l is an
# obligation x outlive l, which this caller, passing a node from a loop body, does not meet
type Node struct(v I64) {
    v
}
fn put<T>(l mut Vec<T>&, x T) {
    v T = x
    l.Push(v)
}
fn main() ? {
    l := Vec<Node&>()
    for i in range 2 {
        n Node& = Node(i)
        put(l, n)
    }
}
