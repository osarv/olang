# check: run
# QCE (T7a relaxed): a type declared over an array of arrays holds its rows by value, each its own run-time array
# (the third any review's finding 7 had made it T7a's error: converting rows laid out in place to it read each row as a
# run-time array - a segfault, invalid IR - which must stay right)
type Grid extends Array<Array<I64>>
fn (g Grid&) Show() String { return "g " $g[0][0] }
fn main() {
    a := Array<Array<I64>>(2, Array<I64>(2, 5))
    g := Grid(a)
    assert g.Show() == "g 5"
}
