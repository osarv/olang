# check: run
# O17/O26a: a value returned inside another one lives where the result goes, its storage included, so lending it to a
# callee that stores through it builds what that stores there too (o17borrowsplit.olang returns the local itself).
# It used to keep its storage in this block, a compile-time error (O17)
type Box struct(n I64) {
    Data mut Array<I64>& = Array<I64>(n)
}
type W struct(b Box) {
    b
}
fn (b Box&) size() I64 { return b.Data.Len() }
fn (b mut Box&) regrow(v I64) {
    b.Data = Array<I64>(8, v)
}
fn make(n I64) W {
    b := Box&return(n)
    assert b.size() == n
    b.regrow(7)
    return W(b)
}
fn main() ? {
    w := make(3)
    churn()
    assert w.b.Data[0] == 7
}
fn churn() I64 {
    t I64 = 0
    for i in range 50 {
        a := Array<I64>(64, -7)
        t += a[3]
        x := $i $i $i $i
        t += x.Len()
    }
    return t
}
