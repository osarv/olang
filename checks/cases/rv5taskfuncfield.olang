# check: fail error[P2]: this task calls a function value held in what it is handed
# P2 (decision 40): a task calling a closure held in a struct it is given would build into the scopes the closure captured from the task's thread
type N struct(v I64) {
    v
    w I64 = v * 3
}
type H struct(f fn(i I64)) { f }
fn work(h H&, base I64) {
    for i in range 200000 { h.f(i + base) }
}
fn main() ? {
    a mut List<N&>& = List<N&>()
    b mut List<N&>& = List<N&>()
    ha := H(fn(i I64) { a.Push(N(i)) })
    hb := H(fn(i I64) { b.Push(N(i)) })
    join {
        spawn work(ha, 0)
        spawn work(hb, 1000000)
    }
    bad I64 = 0
    i I64 = 0
    for x in a { if x.v != i or x.w != 3 * i { bad++ } i++ }
    i = 0
    for x in b { if x.v != i + 1000000 or x.w != 3 * (i + 1000000) { bad++ } i++ }
    println("wrong elements: " $bad " of " $(a.Len() + b.Len()))
}
