# check: run
# flags: -d -s
# P2 (decision 48, replacing decision 40's refusal): tasks calling closures held in structs they are given - each closure
# builds into the scope it captured from the task's thread, into that thread's own part of it
type N struct(v I64) {
    v
    w I64 = v * 3
}
type H struct(f fn(i I64)) { f }
fn work(h H&, base I64) {
    for i in range 200000 { h.f(i + base) }
}
fn main() ? {
    a mut List<N&>& = List<N&>()
    b mut List<N&>& = List<N&>()
    ha := H(fn(i I64) { a.Push(N(i)) })
    hb := H(fn(i I64) { b.Push(N(i)) })
    join {
        spawn work(ha, 0)
        spawn work(hb, 1000000)
    }
    bad I64 = 0
    i I64 = 0
    for x in a { if x.v != i or x.w != 3 * i { bad++ } i++ }
    i = 0
    for x in b { if x.v != i + 1000000 or x.w != 3 * (i + 1000000) { bad++ } i++ }
    if bad != 0 or a.Len() + b.Len() != 400000 { fail }
}
