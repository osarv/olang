# check: fail error[O10c]: the callee needs one argument's scope to outlive another's, and nothing here shows it - pass them from one scope
# C2g (review of rv3fix, #6): nor a borrowed result of a call given it
import "std/io"
type P struct(v I64) { v }
fn borrow(b P&) P& { return b }
fn deep(n I64) I64 {
    a := Array<I64>(64)
    for i in range 64 { a[i] = -7 }
    if n == 0 { return a[3] }
    return deep(n - 1) + a[5]
}
type H struct(p P) {
    keep P& = borrow(p)
}
fn main() ? {
    h := H(P(42))
    deep(50)
    try io.Println($h.keep.v)
}
