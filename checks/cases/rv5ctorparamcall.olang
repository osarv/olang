# check: fail error[O10]: this reference lives in a scope that may not outlive where it is put
# C2g (review of rv3fix, #6): nor a borrowed result of a call given it
type P struct(v I64) { v }
fn borrow(b P&) P&b { return b }
fn deep(n I64) I64 {
    a := Array<I64, 64>()
    for i in range 64 { a[i] = -7 }
    if n == 0 { return a[3] }
    return deep(n - 1) + a[5]
}
type H struct(p P) {
    keep P& = borrow(p)
}
fn main() ? {
    h := H(P(42))
    deep(50)
    println($h.keep.v)
}
