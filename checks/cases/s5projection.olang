# check: run
# R2 (refusals 5.2): compiles now - the call whose field is pushed lands where 'bs' lives, its argument's text with it
# (O28 through O18c); it was refused, as what follows says
# O18c (the review of study 5's fixes, F5): a field or an element of a call's value result passed on is a copy out of
# it - its references are where that call's result landed, which its argument's block decides; pushed into a list that
# outlives the block, they would be read after it closed
type Box struct(s String&) { s }
type Pairish struct(a Box, n I64) {
    a
    n
}
fn Pairish.pairish(s String&) Pairish { return Pairish(Box(s), 1) }

fn main() ? {
    bs := Vec<Box>()
    for k in range 4 {
        t := $k "-text"
        bs.Push(Pairish.pairish(t).a)
    }
    assert bs[0].s == "0-text" and bs[3].s == "3-text"
}
