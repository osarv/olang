# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/O12: "$" calls Str on parts it renders without knowing where they live, so where its receiver lives is not known in
# Str's body - a helper building a node there and storing it into what the receiver reaches is refused, once
type Node struct(v I64, next mut Node?&) {
    v
    next
}
fn grow(n mut Node&) { n.next = Node(6, null) }
type Bag struct(head mut Node&) {
    head
}
fn (b Bag&) Str() String {
    grow(b.head)
    return "b"
}
fn main() ? {
    b := Bag(Node(1, null))
    s := $b
    assert s == "b" and b.head.next!.v == 6
}
