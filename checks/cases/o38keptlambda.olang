# check: fail error[O39]: assigning 'v.o' may release the Inner borrowed on line
# also: note: kept here, until the end of the block it is kept in
# O38: ...a lambda capturing it, pushed into a List of function values
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    fs := List<fn() I64>()
    fs.Push(fn() I64 { return b.o.deep.text.Len() })
    v.o = null
    println($fs[0]())
}
