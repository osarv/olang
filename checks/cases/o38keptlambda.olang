# check: fail error[O38]: this argument borrows an own object, and the callee may keep it beyond the call
# O38: ...a lambda capturing it, pushed into a List of function values
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    fs := List<fn() I64>()
    fs.Push(fn() I64 { return b.o.deep.text.Len() })
    v.o = null
    try io.Println($fs[0]())
}
