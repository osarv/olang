# check: run
# G12, G29: an array taken by value whose body decides nothing on its length is one function of every length (D9a,
# 2026-11-01), so its instance named with type arguments is a value
fn first<T>(a Array<T>) T { return a[0] }
fn main() {
    f := first<I64>
    assert f(Array<I64>[4, 5]) == 4 and f(Array<I64>(3, 7)) == 7
}
