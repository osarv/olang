# check: run
# X9: a library named by two extern blocks is linked once; "link" stays an ordinary name everywhere else
extern link "m" {
    fn cbrt(x F64) F64
}
extern link "m" {
    fn hypot(x F64, y F64) F64
}

fn link(n I64) I64 { return n + 1 }

fn main() ? {
    assert cbrt(8.0) == 2.0
    assert hypot(3.0, 4.0) == 5.0
    assert link(1) == 2
}
