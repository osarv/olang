# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c: a callback handed to a higher-order function over what the receiver reaches - the callback's own body is
# asked about the scope it is called with, directly and through a helper passing it on
import "std/io"
type Bag struct(words Array<String&>&) {
    words
}
fn via(a Array<String&>&, f fn&(x String&) Bool) I64 { return a.Count(f) }
fn (b Bag&) Str() String {
    n := b.words.Count(fn(s String&) Bool {
        t String& = $s "x"
        return t.Len() > 2
    })
    return "n" $n
}
type Bag2 struct(words Array<String&>&) {
    words
}
fn (b Bag2&) Str() String {
    n := via(b.words, fn(s String&) Bool {
        t String& = $s "x"
        return t.Len() > 2
    })
    return "n" $n
}
fn main() ? {
    try io.Println($Bag(Array<String&>["ab", "c"]))
    try io.Println($Bag2(Array<String&>["ab", "c"]))
}
