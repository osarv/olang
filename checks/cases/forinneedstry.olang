# check: fail so it is written 'for x in try c'
# S9e: a loop whose Next can fail is written with try
error E {
    X
}
type It struct() {
    i mut Int32 = 0
}
fn (t mut It&) Next() (Int32, Bool) ? E {
    if t.i > 2 { return 0, false }
    t.i++
    return t.i, true
}
fn main() ? E {
    t It& = It()
    for x in t { }
}
