# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# P2: every task gets a stand-in for each scope its call binds, made in that scope - so a task handed the receiver's
# node is refused even where its call builds nothing there (no raw scope for a task, C2/C4)
import "std/io"
type Node struct(v I64) {
    v
}
type Bag struct(head Node&) {
    head
}
fn hr(n Node&) I64 { return n.v }
fn hjoin(n Node&) I64 {
    x I64 = 0
    join { spawn x = hr(n) }
    return x
}
fn (b Bag&) Str() String { return "b" $hjoin(b.head) }
fn main() ? { try io.PutLine($Bag(Node(6))) }
