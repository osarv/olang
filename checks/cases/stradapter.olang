# check: run
# flags: -s
# E11c/E31/D16c: a part of the receiver with a Call method passed where a function value is wanted, to a callee that keeps
# nothing of it - the adapter is in the frame and Call builds nothing where the part lives, so it runs
type Node struct(v I64, next mut Node&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Getter struct(k I64) {
    k
}
fn (g Getter&) Call() I64 { return g.k * 2 }
type Bag struct(head mut Node&) {
    head
    g Getter = Getter(21)
}
fn applyI(f fn() I64) I64 { return f() }
fn (b Bag&) Str() String {
    return $applyI(b.g)
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    println(s)
}
