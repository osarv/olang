# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/E31: a part of the receiver with a Call method passed where a function value is wanted - the adapter is made where
# the part lives (no frame adapter: a callee keeping nothing of it may still hand it to a function value that keeps it,
# C8), so it is refused though Call builds nothing there
import "std/io"
type Node struct(v I64, next mut Node?&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Getter struct(k I64) {
    k
}
fn (g Getter&) Call() I64 { return g.k * 2 }
type Bag struct(head mut Node&) {
    head
    g Getter = Getter(21)
}
fn applyI(f fn&() I64) I64 { return f() }
fn (b Bag&) Str() String {
    return $applyI(b.g)
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    try io.Println(s)
}
