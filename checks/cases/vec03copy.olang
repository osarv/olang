# check: run
# a copy of a Vec kept across a Push on the Vec it was copied from
# M19g, round 2 (brought back): a copy is a second name and an iterator reads the Vec each step - no view is stale
import "std/io"
fn main() ? {
    v := Vec<I64>()
    v.Push(1)
    b := v
    v.Push(2)
    try io.Println($b.Len())
}
