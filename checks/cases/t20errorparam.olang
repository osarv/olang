# check: run
# T20: an error type is a value's type - a parameter, a local and a field of one; a word is a value; null is "no error"
import "std/io"
type E error {
    A
    B
}
type Holder struct(e E) { e }
fn final(e E) Bool { return e != E.A }
fn main() ? {
    x E
    try io.Println($x)
    assert x is null and final(x)
    h := Holder(E.B)
    assert final(h.e) and $h == "Holder(E.B)"
}
