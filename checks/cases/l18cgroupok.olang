# check: run
# L18c: an infallible function type as a result before its signature's "?" is parenthesized, so the "?" is not its own
type E error {
    BAD
}
Gate mut I64 = 1
fn make() (fn() I64) ? E {
    if Gate < 0 { error E.BAD }
    return fn() I64 { return 7 }
}
fn main() {
    f := try make() catch E { unreachable }
    assert f() == 7
}
