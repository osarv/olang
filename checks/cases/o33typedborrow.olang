# check: fail error[O10]: this reference lives in a scope that may not outlive where it is put
# a typed local lives in its block (O25a), and a borrow of an owned object lives in the object's region: ':=' holds one
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn main() ? {
    s := Holder()
    s.cur = Node(1)
    best Node& = s.cur
    try io.Println(best.name)
}
