# check: fail error[T2d]: a weak place reads null once nothing owning holds what it names, so 'weak' is written before a reference that may be null - write 'weak mut Node?&'
# T2d: "weak" only before the "?&" marker
type Node struct(v I64) {
    v
    next mut Node?& = null
    prev weak mut Node& = next!
}
fn main() { }
