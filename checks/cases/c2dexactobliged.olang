# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# C2d/O10c: an instance built from a parameter it can be stored through, landing in another parameter's referent, has
# to be in that referent's scope - which is an equality the function's callers show; this one passes a list from a
# block that closes first
type ME<K, V> struct(key K, value V) {
    Key K = key
    Value V = value
}
type MS<K, V> struct(key K, value V) {
    entry ME<K, V> = ME<K, V>(key, value)
}
type MM<K, V> struct() {
    slot mut MS<K, V>?& = null
}
fn (m mut MM<K, V>&) set(key K, value V) {
    if m.slot is null { m.slot = MS<K, V>(key, value) }
    else { m.slot!.entry = ME<K, V>(key, value) }
}
fn main() ? {
    m := MM<I32, mut Vec<I32>&>()
    for _ in range 2 {
        l mut Vec<I32>& = Vec<I32>()
        m.set(1, l)
    }
}
