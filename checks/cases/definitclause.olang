# check: fail error[D13d]: 'x' is read here before it is assigned on every path
# D13d: a catch clause runs from where its try began - nothing the try's operand assigned is assigned in it - so a
# clause reading the target reads it unassigned
type N struct(v I64) { v }
type E error { BAD }
fn g(k I64) N& ? E {
    if k < 0 { error E.BAD }
    return N(k)
}
fn a(k I64) I64 {
    x N&
    x = try g(k) catch E {
        y := x.v
        return y
    }
    return x.v
}
fn main() { a(1) }
