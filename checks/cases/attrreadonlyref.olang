# check: run
# G39, G40: an attribute's type may hold a read-only reference - read back as the attribute it is
import "std/io"

type Cell struct(n I64) { n }
type Holder struct(c Cell&) { c }

@Holder(Cell(41))
type T struct(x I64) { x }

fn main() {
    h := T.Attr<Holder>()!
    assert h.c.n == 41
    io.Println("attr cell " $h.c.n)!
}
