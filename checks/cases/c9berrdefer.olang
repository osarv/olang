# check: fail error[C9b]: 'r' is used after 'r.Destroy()' (line 21)
# C9b, S19e: an errdefer's Destroy() runs where an error leaves its block - here a join whose task failed, which the
# clause takes - and the function goes on: so 'r' is not read after that block
type Bad error {
    Neg
}
type Res struct(id I64) {
    id
} destruct {
    Closed += 1
}
Closed mut I64 = 0

fn fails(n I64) ? Bad {
    if n < 0 { error Bad.Neg }
}

fn main() {
    r := Res(4)
    try join {
        errdefer r.Destroy()
        spawn try fails(-1)
    } catch Bad { }
    assert r.id == 4
}
