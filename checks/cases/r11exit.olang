# check: build
# R11/B5b/D8e: os.Exit is 'noreturn', so a clause in value position ending in it leaves, as 'unreachable' would
# (study 4's r18 needed 'unreachable' after it)
import "std/os"
import "std/io"
fn main() ? {
    text := try os.ReadFile("/nonexistent") catch os.Error {
        try io.PrintErrln("cannot read")
        os.Exit(2)
    }
    try io.Println(text)
}
