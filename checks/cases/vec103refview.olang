# check: fail error[O39]: calling 'Push' may release the Array<I64> borrowed on line 11, which is used after it
# Vec phase 2a (O39): a view taken through a reference to the struct, the Vec grown through the struct
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn main() ? {
    l := Lexer(1)
    l.toks.Push(1)
    r Lexer& = l
    d := r.toks.View()
    l.toks.Push(2)
    io.Println($d[0])
}
