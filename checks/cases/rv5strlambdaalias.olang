# check: run
# E11c (review of rv3fix, #5): the same through a second local naming the lambda - once per "$"
type C struct() { n I64 = 0 }
type B struct(c mut C&) { c }
fn (a B&) Str() String {
    k := a.c
    f := fn() { k.n = k.n + 1 }
    g := f
    g()
    return "b"
}
fn main() ? {
    c mut C& = C()
    b := B(c)
    s := $b
    assert $s " " $c.n == "b 1"
}
