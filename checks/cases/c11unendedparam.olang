# check: fail error[C11]: Conn has a destructor to run, and Array<Conn> keeps values of it where no holder ends them - write Conn&, or keep them in a Vec<Conn>
# C11: a bare array of a run-time length holding values with destructors has no count of live elements, so nothing ends
# them - a parameter takes a Vec<Conn> (or Conn& elements)
Closed mut I64 = 0
type Conn unique struct(fd I32) {
    fd
} destruct { Closed++ }
fn count(a Array<Conn>) I64 { return a.Len() }
fn main() {
    assert Closed == 0
}
