# check: fail error[E11b]: a join piece is a text literal or a '$' rendering - write '$($'c').PadStart(3)'
# also: compilation failed with 1 error
# E11b, T29f: a character padded beside text - the hint is the rendering that compiles (a Char is padded as its text),
# not one more error away ('$'c'.PadStart(3)' is T29f's)
import "std/io"
fn main() {
    io.Println("x" 'c'.PadStart(3) "y")!
}
