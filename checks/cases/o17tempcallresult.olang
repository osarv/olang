# check: fail this value's references live where its own storage does not, and the callee can store through it
# O17 (the third review of the view lend, U1): a call's value result holding a writable reference, lent to a
# reference parameter whose callee builds through it in a loop - a split value: its copy is the block's, its references
# seed's; the node was built in the loop body and hung off seed
type Node struct(v I64, next mut Node&) {
    v
    next
}
type Box struct() {
    head mut Node& = Node(0, null)
    tag I64 = 0
}
fn idBox(seed mut Box&) Box { return seed }
fn addRef(b mut Box&, v I64) { b.head.next = Node(v, b.head.next) }
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
fn main() ? {
    seed := Box()
    for i in range 3 {
        addRef(idBox(seed), i + 1)
        churn()
    }
    churn()
    n := 0
    for x := seed.head, x != null, x = x.next { n = n * 10 + x.v }
    println("chain " $n)
}
