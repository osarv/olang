# check: run
# flags: -debug -sanitize
# C3 (bulk review 4's over-rejection, fixed on the way by D9i's widenings): 'x2 := x1; return x2' of a constructed
# local - a reference, a value holding one, a value - with x1 read after the copy and without, each result read back
# after a churn under the scope sanitizer
import "std/io"
type N struct(v I64) {
    v
    next N?& = null
}
type H struct(n N&) { n }
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
        s := $k "-" $(k * 7)
        assert s.Len() > 0
    }
}
fn mk1(i I64) N& {
    x1 mut N& = N(i)
    x1.next = N(i + 1)
    x2 := x1
    return x2
}
fn mk2(i I64) H {
    x1 := H(N(i))
    x2 := x1
    return x2
}
fn mk3(i I64) N {
    x1 := N(i)
    x1.next = N(i + 1)
    x2 := x1
    return x2
}
fn mk3after(i I64) N {
    x1 := N(i)
    x1.next = N(i + 1)
    x2 := x1
    x1.v = 9
    return x2
}
fn mk4after(i I64) H {
    x1 := H(N(i))
    x2 := x1
    assert x1.n.v == i
    return x2
}
fn main() ? {
    a := mk1(3)
    b := mk2(5)
    c := mk3(7)
    d := mk3after(11)
    e := mk4after(13)
    churn()
    assert a.next!.v == 4 and b.n.v == 5 and c.next!.v == 8 and d.v == 11 and d.next!.v == 12 and e.n.v == 13
    try io.Println($a.next!.v " " $b.n.v " " $c.next!.v " " $d.next!.v " " $e.n.v)
}
