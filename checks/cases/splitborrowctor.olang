# check: run
# R1 (refusals 5.1): compiles now - a split value lent where its references live, its own storage lifted there where
# the callee keeps it (O17b generalized); it was refused, as what follows says
# O17/O17a: a constructor keeping a reference parameter in its instance hands what it reaches to the caller, as a return
# does, so a copy whose references live elsewhere than its storage is not lent to it - "h.r.head.next = Node()" would
# build in the copy's block
import "std/io"
type Node struct() {
    next mut Node?& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
}
type W struct(b Box) { b }
type H struct(r mut Box&) { r }
fn viaCtor(src mut W&) {
    b := src.b
    h := H(b)
    h.r.head.next = Node()
}
fn main() ? {
    w := W(Box())
    viaCtor(w)
    try io.Println($w.b.head.v)
}
