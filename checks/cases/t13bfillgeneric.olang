# check: fail error[T13b, G18]: fill needs a copy, and Token is unique
# also: note: fill needs a copy here
# T13b, G18a (bulk review 7, F6): a generic's fill of a type its call binds unique, refused at that call
type Token unique struct(id I64) { id }
fn fill<T>(x T) Array<T> { return Array<T>(3, x) }
fn main() {
    a := fill(Token(1))
    assert a.Len() == 3
}
