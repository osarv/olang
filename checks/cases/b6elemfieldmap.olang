# check: fail error[O20]: the container outlives what this refers to
# O18c (the batch 6 review): ...through what a Map's Get hands back
type Cell struct() {
    s String& = ""
}
fn main() ? {
    m := Map<I64, mut Cell&>()
    for i in range 3 { m.Put(i, Cell()) }
    for i in range 3 {
        x String& = "w" $i
        (try m.Get(i)).s = x
    }
}
