# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O18c (the batch 6 review): ...through what a Map's Get hands back
type Cell struct() {
    s String& = ""
}
fn main() ? {
    m := Map<I64, mut Cell&>()
    for i in range 3 { m.Put(i, Cell()) }
    for i in range 3 {
        x String& = "w" $i
        (try m.Get(i)).s = x
    }
}
