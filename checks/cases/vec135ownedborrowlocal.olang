# check: fail error[O34]: the owner refers to what lives shorter than the slot it is moved into
# R1: through a borrow local 'q := p.lx'
import "std/io"
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    p := Parser()
    p.lx = Lexer()
    for i in range 3 { p.lx.toks.Push($i "-word-built-in-the-lexer's-region") }
    d := Parser()
    d.lx = Lexer()
    q := p.lx
    d.lx.toks = take q.toks
    p.lx = null
    churn()
    io.Println(d.lx.toks[0])
}
