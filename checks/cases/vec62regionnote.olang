# check: fail error[O20]: the container outlives what this refers to
# vec4 (r1e_note_source): the review's repro
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# what does the compiler suggest when an inner block's text is stored into a plain field of an owned object?
type Box struct() {
    s mut String& = "none"
}
type CB struct() {
    box own mut Box& = Box()
}
fn main() ? {
    c := CB()
    b := c.box
    for i in range 3 {
        s := $i "-new-text"
        b.s = s
    }
    io.Println(b.s)
}
