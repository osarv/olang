# check: run
# flags: -debug -sanitize
# O17 (the fourth review, F1): a lambda capturing the parameter, made as an argument of a callee that keeps nothing of it
# beyond the call - it never leaves the call, so a split value lent there is kept by no one; read back after a churn
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type Box struct() {
    head mut Node& = Node(7)
    tag I64 = 0
}
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { unreachable }
    }
}
fn idBox(seed mut Box&) Box { return seed }
fn twice(f fn() I64) I64 { return f() + f() }
fn viaArg(b Box&) I64 { return twice(fn() I64 { return b.head.v }) }
fn main() ? {
    seed := Box()
    t := 0
    for i in range 3 {
        t = t + viaArg(idBox(seed))
        churn()
    }
    assert t == 42, $t
}
