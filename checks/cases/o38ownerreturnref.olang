# check: fail error[O38, O26a]: this result reaches the owner value local 'v' by reference
# O38: a reference to an owner value local's storage is never returned - its owners are released as its block ends,
# whatever O26a moved its storage into; 'fn mk() Outer' moves the owner instead (own5 F2)
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn mk() mut Outer& {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    return v
}
fn main() ? {
    r := mk()
    io.Println($r.o.k)
}
