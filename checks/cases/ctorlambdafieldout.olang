# check: run
# flags: -sanitize
# C2g, D16d, E31 (the unpar review's neighbours): a constructor field's Call adapter holds its instance - a counter made
# in the loop body - so the holder, kept outside the loop, holds it too. Refused until item 17; the counter is now built
# where the holder keeping it is, one each turn; read back after an arena churn
type Ctr struct(n I64) {
    n
}
fn (c Ctr&) Call() I64 { return c.n }
type D struct(c Ctr&) {
    F fn&() I64 = c
}

fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn main() {
    ds := Vec<D>()
    for i in range 3 {
        ct := Ctr(i)
        ds.Push(D(ct))
    }
    churn()
    assert ds[0].F() == 0 and ds[1].F() == 1 and ds[2].F() == 2
}
