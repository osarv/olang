# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# O38: a reference to an owner value local's storage is confined to this function's locals - not stored into a resource
# whose destructor reads it after the owner's release (own5 F2, the review's n1v)
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
Seen mut I64 = 0
type Watch struct() {
    x Outer& = null
} destruct {
    if x != null { Seen = x.o.k }
}
fn main() ? {
    w := Watch()
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    w.x = v
}
