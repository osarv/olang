# check: fail error[R9]: ParseError
# D17: a check's own fallible call leaves the function with its error, which its set must declare
fn positive(t String&) I64 ? ArgumentError {
    if not (try t.ParseInt() > 0): error ArgumentError.Invalid("positive: try t.ParseInt() > 0")
    return 1
}

fn main() ? {
    t := "5"
    v := try positive(t) catch ArgumentError default 0
}
