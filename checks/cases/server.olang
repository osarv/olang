# check: build
# flags: -memory
type Conn struct() {
    fd I64 = -1
    req String& = ""                     # the request being handled
    hdrs Map<String&, String&>           # its header lines, by name
}
type Server struct(n I64) {
    conns mut Array<mut Conn&>& = Array<mut Conn&>(n, Conn())
    lastHost String& = ""
    for i in range 1, n { conns[i] = Conn() }
}
fn parseHeaders(raw String&) Map<String&, String&> {
    m := Map<String&, String&>()
    for line in raw.Lines() {
        i := try line.FindByte(':') catch { continue }
        m.Put($line[:i], $line[i + 1:].Trim())
    }
    return m
}

fn (s mut Server&) OnRequest(i I64, raw String&) {
    s.conns[i].req = raw.ToUpper()
    s.conns[i].hdrs = parseHeaders(raw)
    s.lastHost = try s.conns[i].hdrs.Get("Host") catch default ""
}

fn main() {
    s := Server(64)
    for k in range 1000 { s.OnRequest(k % 64, "GET / HTTP/1.1\nHost: example.com\nX-Request: " $k "\n") }
    assert s.lastHost == "example.com"
}
# also: server.olang:24:5: memory: 's.conns[i].hdrs' keeps what it lets go of until the Server's scope closes
# also: server.olang:25:5: note: a reference into it is stored here, in 's.lastHost'; store a copy, '$(...)'
