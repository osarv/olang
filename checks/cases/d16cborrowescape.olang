# check: run
# flags: -sanitize
# D16d, O26a (bulk review 6 F9: refused until then): a lambda borrowing a local array, returned - the array flows into
# the result through the capture, so it lives where the result goes; read back after an arena churn
fn leak() fn&(x I32) I32 {
    a := Array<I32>[1, 2, 3]
    return fn(x) { return a[0] + x }
}

fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn main() {
    f := leak()
    churn()
    assert f(1) == 2
}
