# check: fail error[O15]: 'h' and 'g' may each hold a reference to the other, and both have destructors to run
# O15 (QCZ): a cycle through a step - h holds a list holding g, and g holds h
Ended mut I64 = 0
type Hold unique struct(id I64) {
    id
    list Refs?& = null
    back Hold?& = null
} destruct {
    if back is not null: Ended += back!.id
}
type Refs struct() {
    items := Vec<Hold&>()
}
fn main() {
    h Hold = Hold(1)
    s := Refs()
    h.list = s
    g Hold = Hold(2)
    s.items.Push(g)
    g.back = h
}
