# check: fail error[O39]: calling 'f' may release the In3 borrowed on line 20
# O39 (own7 F1): an inline field of an owned object lent where it is - to a reference parameter (E12c) - borrows the
# object, whatever the field's type holds: the callee releasing the owner under it is refused
import "std/io"
type Plain struct(k I64) {
    k
}
type In3 struct(k I64) {
    pl Plain = Plain(k)
}
type H3 struct() {
    cur own mut In3&
}
fn f(h mut H3&, p mut Plain&) I64 {
    h.cur = null
    return p.k
}
fn main() ? {
    h mut H3& = H3()
    h.cur = In3(5)
    try io.Println($f(h, h.cur.pl))
}
