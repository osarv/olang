# check: run
# flags: -debug -sanitize
# O12, P1g, O29: a task's built result stored into an element of an array whose scope is one of two is built where the
# array is found to live at run time, the lookup made on the spawning thread - read back after an arena churn (it was
# refused before, review port1 l04)
import "std/io"
type Node struct(v I64) { v }
fn Node.mkNode(i I64) Node& { return Node(i) }

fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}

fn main() ? io.Error {
    outer mut Array<Node&>& = Array<Node&>(1, Node(0))
    total := 0
    for i in range 4 {
        inner mut Array<Node&>& = Array<Node&>(1, Node(0))
        arr := outer if i < 2 else inner
        join { spawn arr[0] = Node.mkNode(i + 50) }
        t := churn(20)
        total += inner[0].v + t
    }
    t := churn(20)
    try io.PutLine($outer[0].v " " $total " " $t)
}
