# check: fail error[O34]: a conditional's or a match's values own objects (Outer), and one is chosen by copying it
# O34 (own6 N2): a conditional of owner value locals chooses one by copying it - a second owner of what it owns, or a
# borrow built as a copy; a reference to one, repointed in a branch, says which
import "std/io"
type Inner struct(k I64) {
    k
}
type Outer struct() {
    o own mut Inner&
}
fn pick(c Bool) I64 {
    v := Outer()
    v.o = Inner(3)
    w := Outer()
    w.o = Inner(4)
    r mut Outer& = v if c else w
    r.o = null
    return 0 if v.o == null else v.o.k
}
fn main() ? {
    try io.Println($pick(true))
}
