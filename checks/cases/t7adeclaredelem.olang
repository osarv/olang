# check: run
# QCE (T7a relaxed): a String as an array's element, and as a generic struct's field bound by its type argument - held
# by value, each its own (it was T7a's error - review port1 r07, r11)
import "std/io"
type Box<T> struct(v T) { v }
fn main() ? io.Error {
    a := Array<String>(3, "init")
    b := Box<String>("start")
    try io.Println($a.Len() " " $b.v)
}
