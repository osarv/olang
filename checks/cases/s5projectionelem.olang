# check: fail the callee needs one argument's scope to outlive another's
# O18c (F5): an element of a call's value result, and a call's result built from such a field, likewise
type Box struct(s String&) { s }
fn boxes(s String&) Array<Box> { return Box[Box(s)] }

fn main() ? {
    bs := List<Box>()
    for k in range 4 {
        t := $k "-text"
        bs.Push(boxes(t)[0])
    }
}
