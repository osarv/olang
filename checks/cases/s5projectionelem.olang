# check: run
# R2 (refusals 5.2): compiles now - the call whose element is pushed lands where 'bs' lives, its argument's text with it
# (O28 through O18c); it was refused, as what follows says
# O18c (F5): an element of a call's value result, and a call's result built from such a field, likewise
type Box struct(s String&) { s }
fn boxes(s String&) Array<Box> { return Array<Box>[Box(s)] }

fn main() ? {
    bs := Vec<Box>()
    for k in range 4 {
        t := $k "-text"
        bs.Push(boxes(t)[0])
    }
    assert bs[0].s == "0-text" and bs[3].s == "3-text"
}
