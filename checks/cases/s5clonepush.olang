# check: fail the callee needs one argument's scope to outlive another's
# O18c: Clone copies a list's elements - for a List<String&>, the references - so a clone of a loop's list holds what
# the loop's block holds, and cannot be kept past it
import "std/io"
fn main() ? {
    rows := Vec<Vec<String&>>()
    for k in range 4 {
        rec := Vec<String&>()
        rec.Push($k "-text")
        rows.Push(rec.Clone())
    }
    for r in rows { try io.Println(r[0]) }
}
