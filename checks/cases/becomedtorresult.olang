# check: run
# flags: -debug -sanitize
# S21, O16 (docs/refusals.md 5.5; refused - "an instance is built in one of them whose destructor would run then" -
# until the user's "Yes, do A" of 2026-11-08): a by-value result holding a reference to an instance with a destructor,
# built by a callee in the frame's block a become closes, is built in the chain's tail scope and ended as it closes
import "std/io"

type Res unique struct(n I64) { n } destruct { io.PutLine("destroy " $n)! }

type Wrap struct(r Res&) { r }

fn Wrap.mkw(n I64) Wrap { return Wrap(Res(n)) }

fn peek(w Wrap) I64 { return w.r.n }

fn f(n I64) I64 {
    if n == 0: return 0
    k := peek(Wrap.mkw(n))
    become f(k - 1)
}

fn main() { io.PutLine("result " $f(2))! }
