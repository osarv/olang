# check: fail error[R11, O25]: a reference default lives where the call's result does
# R11, O25g: a default given where something can be stored through the result lives exactly where the result does -
# here 'd' is one of two blocks' storage, and the result is built in this one, so a write through 'm' could store into
# either
import "std/os"
type E error { Empty }
type Node struct(v I64, next mut Node?&) {
    v
    next
}
fn Node.make(v I64) mut Node& ? E {
    if v < 0 { error E.Empty }
    return Node(v, null)
}
fn main() {
    a mut Node& = Node(1, null)
    n := os.Args().Len()
    {
        b mut Node& = Node(2, null)
        d := a
        if n > 0 { d = b }
        m := try Node.make(n - 5) catch default d
        m.next = Node(3, null)
        assert b.next!.v == 3
    }
}
