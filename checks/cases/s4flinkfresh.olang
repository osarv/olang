# check: run
# S4f: ":~" of a constructor's call declares a reference to the new value, held in the declaring block as
# "r := Node(2)" would hold it ("r ~ Node(2)" links a reference held elsewhere to a new value, built where it is held)
type Node struct(v I64) { v }

fn main() {
    r :~ Node(2)
    r.v += 1
    assert r.v == 3
}
