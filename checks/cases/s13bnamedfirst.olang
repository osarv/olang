# check: fail error[S13b]: an item by position follows one by name
# S13b: a payload pattern gives its items by position first, then by name
type Shape enum {
    Rect(w I64, h I64)
    Dot
}
fn f(s Shape) I64 {
    match s {
        case Shape.Rect(h = 1, w) { return w }
        case _ { return 0 }
    }
}
fn main() { assert f(Shape.Rect(1, 1)) == 1 }
