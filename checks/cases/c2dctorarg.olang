# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# C2d/O18b: a constructor call passed as an argument lands where the callee puts it - here the outer list - so the
# existing storage it holds is checked there (it used to be checked nowhere, and the list kept a reclaimed node)
type Node struct(v I32) {
    v
}
type Wrap struct(n Node&) {
    n
}
fn main() ? {
    l mut Vec<Wrap&>& = Vec<Wrap&>()
    for _ in range 2 {
        inner Node& = Node(42)
        l.Push(Wrap(inner))
    }
}
