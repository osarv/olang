# check: run
# flags: -sanitize
# C2d/O23a: a callback handed elements read through a field with a binding of its own of a view over the receiver's array
# builds through the element's derived scope. It was refused (C3: where that scope resolves at the call is an
# underestimate); since C1 (2026-11-07) a build through a derived scope, which exists at no run time, goes to the
# program's scope, which outlives the element - read back after an arena churn
import "std/io"
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type View struct(ns Array<mut Node&>&) {
    at Array<mut Node&>& = ns
}
type Bag struct(ns Array<mut Node&>&) {
    ns
}
fn visit(w View&, g fn&(x mut Node&)) {
    for x in w.at { g(x) }
}
fn (b Bag&) Str() String {
    visit(View(b.ns), fn(x mut Node&) { x.next = Node(x.v + 100) })
    return "b" $b.ns[0].v
}
fn churn(d I64) I64 {
    a := I64[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    b := Bag(Array<mut Node&>(1, Node(3)))
    try io.Println($b)
    t := churn(100)
    try io.Println($b.ns[0].next!.v " " $t)
}
