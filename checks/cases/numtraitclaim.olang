# check: fail nfFake does not satisfy the constraint Float on T
# T31a/T35c: Float is closed - a type having every method a float has still is none of the types the trait lists
type nfFake struct(v F64) { v }
fn (f nfFake) Div(d F64) nfFake { return nfFake(f.v / d) }
fn nfHalf<T Float>(x T) T { return x / 2.0 }
fn main() ? {
    h := nfHalf(nfFake(1.0))
}
