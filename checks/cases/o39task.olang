# check: fail error[O39]: assigning 's.cur' may release the Conn borrowed on line
# a task's arguments are borrowed until its join
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn show(c Conn&) { println(c.name) }
fn main() ? {
    s := Server()
    s.cur = Conn(3)
    join {
        spawn show(s.cur)
        s.cur = null
    }
}
