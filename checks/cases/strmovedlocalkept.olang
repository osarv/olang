# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/O26a: the same with a borrow of the moved local kept in the receiver's node (C2b)
import "std/io"
type Node struct(v I64) {
    v
    next mut Node?& = null
    pp P2?& = null
}
type P2 struct(n mut Node&) {
    n
}
type Bag struct(head mut Node&, k I64) {
    head
    k
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn h(n mut Node&) mut Node& {
    p := P2(n)
    n.pp = p
    return p.n
}
fn (b Bag&) Str() String {
    x := h(b.head)
    return "b" $b.k $x.v
}
fn main() ? {
    b := Bag(Node(1), 3)
    try io.Println($b)
    t := churn(100)
    w := 0 if b.head.pp is null else b.head.pp!.n.v
    try io.Println($w " " $t)
}
