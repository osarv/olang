# check: fail error[T25c]: this lambda
# never: error[O17]
# R1 (refusals 5.1): the split lend is no longer refused; T25c stays (docs/fnvalues.md, round 7)
# O17 (Vec phase 1): a callee lent a split value only permutes its elements - ...a by-value parameter holding writable references is a store from outside
type N2 struct(v I64) {
    v
    next mut N2?& = null
}
type Rec struct(name String&, n I64) {
    name
    n
}
type RecN struct(nd mut N2?&) {
    nd
}
type H struct() {
    arr Array<Rec> = Array<Rec>(3)
    ns Array<RecN> = Array<RecN>(2)
}
fn mkText(k I64) String& { return "t" $k }
fn setName(r mut Rec&, s String&) { r.name = s }
fn each(a mut Array<RecN>&, g fn&(x RecN)) {
    for i in range a.Len() { g(a[i]) }
}
fn run(h mut H&) {
    ns := h.ns
    each(ns, fn(x RecN) { if x.nd is not null { x.nd!.next = N2(5) } })
}
fn main() ? {
    h mut H& = H()
    run(h)
}
