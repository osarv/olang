# check: fail x[i] gives a copy of the element, which this call would write
# E31b: x[i] of a struct element lent to a callee that assigns a field of the parameter's own storage - the write
# would go into the hidden copy and be lost
type V struct(d mut Array<I64>&, n I64) {
    d
    n
}
type Vs struct(d mut Array<I64>&) {
    d
}
fn (s Vs&) At(i I64) V { return V(s.d, i) }
fn f(v mut V&) { v.n = 5 }

fn main() ? {
    s := Vs(Array<I64>(4))
    f(s[0])
}
