# check: fail error[O10c]: the callee needs one argument's scope to outlive another's
# an owned result made for an owning parameter lands with it - here where a loop body's text may not reach
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
type Rec struct(t String&) {
    t
}
type H struct() {
    k own mut Rec& = null
}
fn mk(t String&) own mut Rec& {
    r own mut Rec& = Rec(t)
    return r
}
fn keep(s mut H&, r own mut Rec&) { s.k = take r }
fn main() ? {
    h mut H& = H()
    for i in range 3 {
        x := $i
        keep(h, mk(x))
    }
    io.Println(h.k.t)
}
