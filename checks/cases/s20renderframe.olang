# check: run
# flags: -sanitize
# D18, O29: a generator over two captured references renders a value it builds ("$") - the scope the walk's
# making passes for what only reads (Inert) is the frame's, never the program's - the text read back after an arena
# churn
import "std/io"
fn words(xs Array<I64>&, v Vec<I64>&) Iterator<String> {
    for x in xs {
        yield "w" $x " " $v.Len() " " $Array<I64>[x, x]
    }
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    v := Vec<I64>[4, 5]
    out := Vec<String>()
    for w in words(Array<I64>[1, 2, 3], v) {
        out.Push(w)
        churn(10)
    }
    churn(40)
    for w in out { try io.PutLine(w) }
}
