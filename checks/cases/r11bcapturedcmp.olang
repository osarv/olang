# check: run
# R11b, T20 (the bulk review's F10): a captured caught error is compared inside the lambda like any error value
import "std/io"
type P error { A, B }
fn f() ? P { error P.A }
fn main() {
    try f() catch e {
        xs := I64[1, 2]
        n := xs.Count(fn(x I64) Bool { return e == P.A })
        assert n == 2
        io.Println($n)!
    }
}
