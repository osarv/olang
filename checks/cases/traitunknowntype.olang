# check: fail error: unknown type 'Tensor'
# also: compilation failed with 1 error
# T4: an unknown type in a trait method's signature is said at the trait - it once went unreported, and a generic
# calling the method through an `any` failed in lowering (oann's repro/traittype)
type Shows trait {
    Value() Tensor<F32>
}

fn first<T>(d any Shows?&) T {
    if d == null: return T(0)
    match T {
        case F32 {
            v := d.Value()
            return T(v.Count())
        }
        case _ { unreachable }
    }
}

fn main() {
    Println($first<F32>(null))
}
