# check: fail error[O10c]: the callee needs one argument's scope to outlive another's
# an owned result holding a borrow of what its caller then releases
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
type Box struct(a Array<I64>&) {
    a
}
fn wrap(old Array<I64>&) own mut Box& {
    b own mut Box& = Box(old)
    return b
}
type H struct() {
    data own mut Array<I64>& = Array<I64>(2)
    bx own mut Box& = null
}
fn main() ? {
    h mut H& = H()
    h.bx = wrap(h.data)
    h.data = null
    io.Println($h.bx.a[0])
}
