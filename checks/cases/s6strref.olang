# check: run
# E11c: a cursor Str builds - held by a reference, or a temporary - whose "&p" field refers to the value being rendered,
# written through by a helper: once per "$", in rendering order
type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
type Cur struct(of Bag&) {
    c mut Cell&of = of.c
}
fn poke(p mut Cur&) { p.c.v++ }
type B1 struct(b Bag&) {
    b
}
fn (s B1&) Str() String {
    x mut Cur& = Cur(s.b)
    poke(x)
    return "x" $s.b.c.v
}
type B2 struct(b Bag&) {
    b
}
fn (s B2&) Str() String {
    poke(Cur(s.b))
    return "y" $s.b.c.v
}
fn main() ? {
    b := Bag(Cell())
    one := B1(b)
    two := B2(b)
    assert $one $two $b.c.v == "x1y20"           # v read before the pieces render (E11b)
    assert b.c.v == 2
}
