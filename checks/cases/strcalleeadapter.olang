# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c/E31: a helper handed a part of the receiver passes it, adapted through its Call, to a callee - the adapter is made
# where the part lives, which Str may not build in, so it is refused (no frame adapter, C8)
import "std/io"
type Node struct(v I64, next mut Node?&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Getter struct(k I64) {
    k
}
fn (g Getter&) Call() I64 { return g.k * 2 }
fn applyI(f fn&() I64) I64 { return f() }
fn peek(g Getter&) I64 { return applyI(g) }
type Bag struct(head mut Node&) {
    head
    g Getter& = Getter(21)
}
fn (b Bag&) Str() String {
    return $peek(b.g)
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    try io.Println(s)
}
