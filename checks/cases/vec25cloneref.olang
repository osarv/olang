# check: run
# vec2 over-rejection 1: Clone of a Vec whose elements are references - the clone's elements refer where the original's
# do, and it owns a buffer of its own, so the original may grow while the clone is used (no loan on its buffer)
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type N struct(k I64) { k }
fn main() ? {
    w := Vec<String&>()
    w.Push("a")
    w.Push($2 "b")
    c := w.Clone()
    c.Push("x")
    for i in range 100 { w.Push("y") }
    churn()
    io.Println($c)
    ns := Vec<N&>()
    ns.Push(N(4))
    m := ns.Clone()
    ns.Push(N(5))
    churn()
    io.Println($m.Len() " " $m[0].k " " $ns.Len())
}
