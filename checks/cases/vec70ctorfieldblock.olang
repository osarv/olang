# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# vec5 (r2a_ctor_field_no_own_block): a constructor field built in a parameter's scope ('y String&x = new text') holds
# that parameter - the instance may not outlive the argument's block (C2d)
import "std/io"
type H struct(x String&, n I64) {
    y String& = $n "-new-text-in-x's-scope"
}
fn main() ? {
    h := H("outer", 1)
    for i in range 2 {
        t := $i "-inner-block-text"
        h = H(t, 5 + i)
    }
    churn()
    try io.PutLine(h.y)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
