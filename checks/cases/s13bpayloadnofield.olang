# check: fail error[S13b]: case Shape.Rect has no field 'hh' - did you mean 'h'?
# S13b: a payload item by name names one of the case's fields, the nearest suggested
type Shape enum {
    Rect(w I64, h I64)
    Dot
}
fn f(s Shape) I64 {
    return match s {
        case Shape.Rect(hh = 1): 1
        case _: 0
    }
}
fn main() { assert f(Shape.Rect(1, 1)) == 1 }
