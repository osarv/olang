# check: run
# flags: -debug -sanitize
# O29 (round 6): refused until a scope no call knows while compiling was found while the program runs from the
# address of the storage built through - now built where that storage lives, read back after a churn. Before:
# E11c: an array callback over references the receiver reaches - the higher-order function's call through its callback
# binds the receiver's scope, and a body not known (a function value) is taken to build there (o6, an over-rejection)
import "std/io"
type Bag struct(words Array<String&>&) {
    words
}
fn (b Bag&) Str() String {
    long := b.words.Count(fn(s String&) Bool { return s.Len() > 1 })
    return "n" $long
}
fn main() ? { try io.PutLine($Bag(Array<String&>["ab", "c"])) }
