# check: fail error[P2]: this argument's storage closes before the join does
# an owner local in a block inside the join is released at that block's end, before the task it was lent to is joined
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn look(h Holder&) { try io.Println(h.cur.name) catch io.IoError { } }
fn main() ? {
    join {
        {
            o own mut Holder& = Holder()
            o.cur = Node(7)
            spawn look(o)
        }
    }
}
