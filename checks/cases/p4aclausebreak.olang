# check: fail error[P4a]: 'break' may not leave a task's clause - it runs on the task, outside the spawner's loops
# P4a: the clause runs on the task's thread, so the spawner's loop is not around it
error E {
    BAD
}
fn work(n I32) ? E {
    if n < 0 { error E.BAD }
}
fn main() ? {
    for i in range 4 {
        join {
            spawn try work(I32(i) - 2) catch E { break }
        }
    }
}
