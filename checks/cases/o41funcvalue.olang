# check: fail error[O41]: assigning 's.cur' may release what the task spawned on line
# a task calling a function value, which may borrow anything, while the spawner releases
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn apply(f fn()) { f() }
fn main() ? {
    s := Holder()
    s.cur = Node(1)
    f := fn() { try io.Println("x") catch io.IoError { } }
    join {
        spawn apply(f)
        s.cur = null
    }
}
