# check: fail error[O17, O33]: an own array's elements live where its slot's container keeps them, and the callee can store into it where the buffer is
# O17/O33: ...through a generic, the value made where the callee's variable is bound - the buffer's region
import "std/io"
type B struct() {
    names own mut Array<String&>& = Array<String&>(3)
}
fn setFirst<T>(a mut Array<T>&, v T) { a[0] = v }
fn main() ? {
    b := B()
    setFirst(b.names, $5 "via-generic")
    f := b.names[0]
    b.names = Array<String&>(1)
    try io.Println(f)
}
