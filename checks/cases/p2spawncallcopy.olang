# check: run
# R4 (refusals 5.4): a copy of a call's value (an At giving a value holding a reference) lent by reference to a task is
# built at the join's level, one per turn - it was built in the loop turn's block, which the next turn reused while the
# task read it (the scope sanitizer: use after scope closed; built plainly every task read the last turn's)
import "std/io"
extern fn usleep(us U32) I32
type Node struct(v I64, a Array<I64>&) { v
 a }
type Bag struct() { xs Vec<Node> = Vec<Node>() }
fn (b Bag&) At(i I64) Node { return b.xs.View()[i] }
fn see(n Node&) I64 {
    usleep(20000)
    return n.v + n.a[0]
}
fn main() ? {
    b mut Bag& = Bag()
    for i in range 4 { b.xs.Push(Node(i * 10, Array<I64>[i])) }
    out := Array<I64>(4)
    join {
        for i in range 4 {
            spawn out[i] = see(b[i])
            junk := Array<I64>(100, 7)
            assert junk[0] == 7
        }
    }
    try io.Println($out[0] " " $out[1] " " $out[2] " " $out[3])
}
