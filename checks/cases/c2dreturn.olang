# check: run
# R3 (refusals 5.3): compiles now - a by-value parameter kept past the call has its copy made at entry where it must live (the result scope, the
# instance's, a reference parameter's), read back after an arena churn; it was refused, as what follows says
# a constructor parameter whose reference names no scope stores its argument in the instance, so an
# instance returned into the caller's scope may not hold a reference to this function's own storage - here a by-value
# parameter, the function's own copy - one error for the one cause (B11), the instance's binding (O13a) found first.
# (A local built here and handed to the returned instance lives in the result scope instead, O26a.)
import "std/io"
fn churn() I64 {
    t I64 = 0
    for i in range 2000 {
        x := "churn " $i " " $(i * 3)
        t += x.Len()
    }
    return t
}
type P struct(x I32) { x }
type NB struct(inner P&) { inner }
fn NB.bad(p P) NB& {
    return NB(p)
}
fn main() ? {
    b := NB.bad(P(1))
    churn()
    try io.PutLine($b.inner.x)
}
