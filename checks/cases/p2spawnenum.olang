# check: fail does not outlive the enclosing 'join' block
# P2: an enum value and a lambda handed to a task, each holding the loop body's array
type Box enum {
    Has(a Array<I64>&)
    No
}
fn apply(f fn() I64) I64 { return f() }
fn first(b Box) I64 { return (b as Box.Has)[0] }
fn main() ? {
    out := Array<I64>(4)
    out2 := Array<I64>(4)
    join {
        for i in range 4 {
            a := Array<I64>(1000, i + 1)
            spawn out[i] = apply(fn() { return a[0] })
            spawn out2[i] = first(Box.Has(a))
        }
    }
}
