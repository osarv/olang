# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O18c: a call's value result holding what its argument refers to, passed straight to another call, lives where that
# argument does - here the loop's block, which the list outlives ("b := box(t); bs.Push(b)" is the same error)
import "std/io"
type Box struct(s String&) { s }
fn Box.box(s String&) Box { return Box(s) }

fn main() ? {
    bs := Vec<Box>()
    for k in range 4 {
        t := $k "-text"
        bs.Push(Box.box(t))
    }
    for b in bs { try io.PutLine(b.s) }
}
