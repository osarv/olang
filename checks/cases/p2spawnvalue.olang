# check: run
# flags: -sanitize
# P2: a by-value argument is copied to the task, holding a reference to the loop body's array - refused while the array
# closed with the turn; since item 17 it is built where the value keeping it is, one each turn, so each task reads its
# own
type W struct(a Array<I64>&) {
    a
}
fn total(w W) I64 {
    t I64 = 0
    for x in w.a { t += x }
    return t
}
fn main() ? {
    out := Array<I64>(4)
    join {
        for i in range 4 {
            a := Array<I64>(1000, i + 1)
            wv := W(a)
            spawn out[i] = total(wv)
        }
    }
    assert out[0] == 1000 and out[1] == 2000 and out[2] == 3000 and out[3] == 4000
}
