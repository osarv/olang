# check: fail error[S4e]: the write to 'p' is lost: nothing reads 'p' after it
# S4e: a by-value parameter is the callee's own copy (D9): a field stored into it that nothing reads is lost
type P struct() {
    A I64 = 0
}
fn bump(p P) {
    p.A = 5
}
fn main() {
    p := P()
    bump(p)
    Println(p.A)
}
