# check: run
# flags: -debug -sanitize
# T22c (was a T22b refusal), O13c: the closure adder gives keeps what it is called with in what it captured - followed
# into use, the constant text it is called with outlives anything it captured
fn adder(names mut Vec<String&>&) fn&(k String&) {
    return fn(k String&) { names.Push(k) }
}
fn use(f fn&(k String&)) { f("z") }
fn main() {
    gone := Vec<String&>()
    use(adder(gone))
    for i in range 100 {
        v := Vec<String>()
        v.Push($"t" $i)
    }
    assert gone.Len() == 1 and gone[0] == "z"
}
