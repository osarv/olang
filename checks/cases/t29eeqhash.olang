# check: fail error[G19, E10b]: Id does not satisfy the constraint Hashable on K: it has no Hash
# E10b/T29e: a type extending I64 that declares Eq must declare Hash too - the inherited one cannot agree with its Eq
import "std/map"
type Id extends I64
fn (a Id) Eq(b Id) Bool { return I64(a) % 100 == I64(b) % 100 }
fn main() ? {
  m := map.Map<Id, I32>()
}
