# check: fail error[O39]: calling 'Push' may release the Array<I64> borrowed on line 11, which is used after it
# Vec phase 2a (O32/O39): a copy of a field's Vec is a borrowed copy rooted where the field is
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn main() ? {
    l := Lexer(3)
    for i in range 3 { l.toks.Push(i) }
    c := l.toks
    l.toks.Push(9)
    try io.Println($c[0])
}
