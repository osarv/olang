# check: fail case aSlider of any aWidget& is not covered - add it, or 'case _ { }'
# S13a: run-time trait values
type aWidget trait for aButton, aSlider {
    Draw() I64
}
type aButton struct(n I64) { n }
fn (b aButton&) Draw() I64 { return b.n }
type aSlider struct(at I64) { at }
fn (s aSlider&) Draw() I64 { return s.at }

fn f(x any aWidget&) I64 {
    match x {
        case aButton b { return b.n }
    }
    return 0
}
fn main() { }
