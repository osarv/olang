# check: fail error[T30c, T22b]: aBag's 'Put' keeps 'n' in the instance, and aSink's 'Put' says nothing of that - write 'keeps n' after its signature in the trait
# T32a, T30c: a call through an "any" keeps nothing its trait's method does not say
type aNode struct(v I64) { v }
type aSink trait {
    mut Put(n aNode&)
}
type aBag struct() {
    last aNode?& = null
}
fn (b mut aBag&) Put(n aNode&) { b.last = n }
fn f(x mut any aSink&) { }
fn main() {
    b := aBag()
    f(b)
}
