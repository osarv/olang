# check: fail error[O39]: assigning 'v.o' may release the Leaf borrowed on line 20, which is used after it
# Vec phase 2a (O37): a function handing on another's deep borrowed own result
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf& = Leaf(k * 10)
}
type Outer struct() {
    o own mut Inner& = Inner(1)
    p Inner& = null
}
fn (x Outer&) First() Inner&x { return x.o }
fn (x Outer&) Deep() Leaf&x { return x.First().deep }
fn deeper(x Outer&) Leaf&x { return x.Deep() }
fn main() ? {
    v := Outer()
    d := deeper(v)
    v.o = Inner(4)
    io.Println(d.text)
}
