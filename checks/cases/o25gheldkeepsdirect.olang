# check: fail error[T22b]: 'keepFirst' keeps 'bs' in 'keep'
# O25g: an element read out of a vector and stored straight away (no local) is kept where the vector lives
type N struct() {
    v I64 = 0
}
fn keepFirst(bs mut Vec<mut N&>&, keep mut Vec<mut N&>&) {
    keep.Push(bs[0])
}
fn main() {
    fs := Vec<fn&(bs mut Vec<mut N&>&, keep mut Vec<mut N&>&)>()
    fs.Push(keepFirst)
    keep := Vec<mut N&>()
    bs := Vec<mut N&>()
    bs.Push(N())
    fs[0](bs, keep)
}
