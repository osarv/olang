# check: fail error[O34]: an owned result's 'catch default' is 'null' for now
# a default standing for an owner is null - one error
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
error E {
    X
}
fn mk(n I64) own mut Conn& ? E {
    if n < 0 { error E.X }
    return Conn(n)
}
fn main() ? {
    x := try mk(3) catch default Conn(4)
    io.Println($x.fd)
}
