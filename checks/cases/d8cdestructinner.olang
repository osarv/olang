# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# D8c/O18a: results destructured into new locals land in the loop body's block - a reference from there cannot be
# stored into the outer keep
type Node struct(v I32) {
    v
}
fn two(k I64) mut Node&, mut Node& {
    return Node(I32(k) + 40), Node(2)
}
fn main() ? {
    outer Node& = Node(1)
    keep Node& = outer
    for i in range 2 {
        a, _ := two(i)
        keep = a
    }
    assert $keep != ""
}
