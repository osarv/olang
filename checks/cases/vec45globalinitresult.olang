# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# vec3 F4: a global initialized with a borrowed own result of another global's own object
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    text own mut String& = "bb"
}
fn (c CB&) Text() String&c { return c.text }
G own mut CB& = CB()
T := G.Text()                  # a global holding a borrowed own result of G's text
fn main() ? {
    G.text = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"   # releases it
    churn()
    try io.Println(T)
}
