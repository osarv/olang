# check: fail error[O36]: a method is called on a borrow, so its receiver never owns
# a receiver never owns
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn (c own mut Conn&) Close() { }
fn main() ? { }
