# check: fail error[O40]: 'Str' may not release owned objects
# '$' calls a Str where a borrow may be in use
import "std/io"
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
type W struct(s mut Server&) {
    s
}
fn (w W&) Str() String {
    w.s.cur = null
    return "w"
}
fn main() ? {
    s := Server()
    w := W(s)
    try io.Println($w)
}
