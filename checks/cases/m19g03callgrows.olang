# check: fail error[M19g]: 'd' holds a view of 'v' taken before 'v' may have grown
# also: note: 'v' may grow here, in 'fill' - take the view after it
# also: note: 'fill' may grow it here
# M19g: a call given the Vec through a parameter its body may grow, between the view and its use
import "std/io"
fn fill(w mut Vec<I64>&, n I64) { for i in range n { w.Push(i) } }
fn main() ? {
    v := Vec<I64>()
    v.Push(1)
    d := v.View()
    fill(v, 100)
    try io.Println($d[0])
}
