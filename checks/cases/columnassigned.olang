# check: fail error[T7e]: a column is never assigned whole - its length is its table's
# T7e: a column's length is its table's, so it is written element by element or by lanes, never replaced
type P struct(X F32, Y F32) { X, Y }
fn main() {
    c := Columns<P>(3)
    c.X = F32[1.0, 2.0]
    assert c.Len() == 3
}
