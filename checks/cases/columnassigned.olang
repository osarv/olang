# check: fail error[T7e]: a column is assigned whole only alone - 'c.x = v', its length checked against its table's
# T7e: a column's length is its table's - "c.X = v" alone checks v's against it once; in a parallel assignment there is
# no one place for that check, so it is refused
type P struct(X F32, Y F32) { X, Y }
fn main() {
    c := Columns<P>(3)
    c.X, c.Y = c.Y, c.X
    assert c.Len() == 3
}
