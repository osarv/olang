# check: fail error[D13c]: NonZero has no zero value, so this needs one
# D13c: the zero value is the constructor run on zeros - one that rejects zero leaves the type with none, and a
# declaration read before anything assigned it needs one (D13d)
type RangeError error {
    Zero
}
type NonZero I32(v I32) ? RangeError {
    if v == 0 { error RangeError.Zero }
}
fn main() ? {
    n NonZero
    assert I32(n) != 0
}
