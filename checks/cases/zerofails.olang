# check: fail error[D13c]: NonZero has no zero value, so this needs one
# D13c: the zero value is the constructor run on zeros - one that rejects zero leaves the type with none
error RangeError {
    ZERO
}
type NonZero I32(v I32) ? RangeError {
    if v == 0 { error RangeError.ZERO }
}
fn main() ? {
    n NonZero
}
