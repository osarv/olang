# check: fail error[T13b]: File is unique: this value is held elsewhere, and 'g' holds one of its own - write a reference ('File&'), or make a new File here
# T13b: a local written with the value's type is laid out for a value - given an existing one, it cannot hold a reference
type File unique struct(fd I32) { fd }
fn main() {
    f := File(3)
    g File = f
    assert g.fd == f.fd
}
