# check: fail error[E11c]: Str runs as often as '$' needs, so it must have no effect
# E11c: "$" calls Str as often as building the text needs, so one that writes a global is rejected
Shown mut I32 = 0
type Pt struct(n I32) {
    n
}
fn (p Pt&) Str() String {
    Shown++
    return "pt"
}
fn main() ? {
    s := $Pt(1)
}
