# check: fail error[R9]: arith.Error.Overflow can escape here, and this function does not declare it
# R9: a checked division (std/arith) fails with DivideByZero and Overflow, so catching one word is not complete
import "std/arith"
fn div(a I32, b I32) I32 {
    r I32 = try arith.Div(a, b) catch arith.Error.DivideByZero default 0
    return r
}
fn main() { }
