# check: fail error[O41]: assigning 's.cur' may release the Node the task spawned on line
# a task's target is stored into when its call returns - the object holding it must last until then
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    other own mut Node&
}
fn nine() I64 { return 9 }
fn main() ? {
    s := Holder()
    s.cur = Node(3)
    join {
        spawn s.cur.n = nine()
        s.cur = null
    }
}
