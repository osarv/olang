# check: fail error[S20]: a yield with deferred code pending around it - a walk stopped there would never run it; yield outside the deferring block
# S19e, S20: an errdefer is in the defers' one list, so one may not be pending around a yield either
fn tidy() {
}

fn f() Iterator<I64> {
    errdefer tidy()
    yield 2
}

