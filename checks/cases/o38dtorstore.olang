# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# O38: a borrowed copy is held only by this function's locals - not by a local of a destructor type, which is a
# reference (C11): its destructor would read the copy after the owners were released at the block's close (own4 N1)
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
type Watch struct() {
    x Outer& = null
} destruct {
    if x != null { io.Println($x.o.k) }
}
fn main() ? {
    w := Watch()
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    w.x = b
}
