# check: fail error[O32]: Vec<I64> owns objects: ':=' declares an owner from a value made here, a call's result or 'take', and a borrowed copy from a local or a field holding one ('b := a', 'c := l.toks') - this is neither: for a global, 'take' it or call through it
# Vec phase 2a (O32): a borrowed copy is not declared from a global - any call may release what it owns
import "std/io"
type Lexer struct() {
    toks Vec<I64> = Vec<I64>()
}
G mut Vec<I64> = Vec<I64>()
GL mut Lexer = Lexer()
fn main() ? {
    G.Push(3)
    GL.toks.Push(4)
    x := G
    try io.Println($x.Len() " " $G.View()[0] " " $GL.toks.Len())
}
