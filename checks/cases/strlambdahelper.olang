# check: run
# flags: -s
# E11c/D16c: a lambda a Str makes calls a helper whose closure over the receiver's node is only ever called - nothing is
# built where the node lives, and nothing left behind over 2M renderings (the closure once read the null scope as the
# program's and was never reclaimed)
type Node struct(v I64) {
    v
}
type Bag struct(head Node&) {
    head
}
fn peek(n Node&) I64 {
    f := fn() I64 { return n.v }
    return f()
}
fn (b Bag&) Str() String {
    g := fn() I64 { return peek(b.head) }
    return $g()
}
fn main() ? {
    b := Bag(Node(4))
    t I64 = 0
    for i in range 2000000 {
        s := $b
        t += s.Len()
    }
    println($t)
}
