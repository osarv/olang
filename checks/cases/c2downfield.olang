import "std/io"
type Node struct(t String&) { t }
type W struct(s String&) {
    inner mut Node& = Node(s)
}
fn main() ? {
    w := W("a")
    {
        x := $5 "abc"
        w = W(x)
    }
    try io.Println(w.inner.t)
