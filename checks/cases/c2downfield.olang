# check: fail error[C2d]: this instance holds a reference to an argument it would outlive - make the argument where the instance goes, or the instance where the argument lives ('T&x(...)')
# a constructor's own field built from what its parameter refers to, the instance kept past that: must fail
import "std/io"
type Node struct(t String&) { t }
type W struct(s String&) {
    inner own mut Node& = Node(s)
}
fn main() ? {
    w := W("a")
    {
        x := $5 "abc"
        w = W(x)
    }
    io.Println(w.inner.t)
}
