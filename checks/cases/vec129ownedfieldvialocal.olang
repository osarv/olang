# check: fail error[O34]: the owner refers to what lives shorter than the slot it is moved into
# R1: taken out into a local - the region outlives nothing, so the words cannot leave it
type Lex3 struct() {
    toks Vec<String&> = Vec<String&>()
}
type H struct() {
    lx own mut Lex3& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    h := H()
    g := H()
    h.lx = Lex3()
    g.lx = Lex3()
    for i in range 3 { h.lx.toks.Push($i "-built-into-h-region") }
    m := take h.lx.toks
    g.lx.toks = take m
    h.lx = null
    churn()
    println(g.lx.toks[0])
}
