# check: run
# flags: -debug -sanitize
# never: error[O10d]
# B11, O27 as placement: arguments a signature requires in one scope, slices of text made in the function - kept in what
# the function returns, the text is built in the result scope (it was O27's error naming 'text'); read back after a churn
import "std/io"
type Store struct() {
    keys mut Vec<String&>& = Vec<String&>()
}
fn put(s mut Store&, k String&, v String&) {
    s.keys.Push(k)
    s.keys.Push(v)
}
fn mk(n I64) String& { return $n "x" }
fn Store.load(n I64) Store& {
    st mut Store& = Store()
    text := mk(n)
    put(st, text[:1], text[1:])
    return st
}
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn main() ? {
    s := Store.load(4)
    churn()
    assert s.keys.Len() == 2
    try io.Println($s.keys)
}
