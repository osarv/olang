# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# T32a (the any review, finding 1): an array copied into an any keeps its elements' references - text a loop body built,
# kept in an outer list, would dangle once the body closed
type aSized trait {
    Len() I64
}
fn main() {
    xs := Vec<any aSized&>()
    for i in range 4 {
        a := Array<String&>(2, "x")
        a[0] = "e" $i
        xs.Push(a)
    }
}
