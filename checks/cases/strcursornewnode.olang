# check: run
# flags: -debug -sanitize
# E11c/O25a: a cursor starting at the receiver's node lived where the receiver does, so a new node given to it would be
# built there: refused (E11c, O12). Since O25i a cursor is typed per assignment: 'x = Node(7, null)' is a version of
# its own, built in Str's frame, which builds nothing where its receiver reaches - so it renders, read after a churn
# under the scope sanitizer
import "std/io"
type Node struct(v I64, next mut Node?&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&) {
    head
}
fn (b Bag&) Str() String {
    x := b.head
    x = Node(7, null)
    return $x.v
}
fn main() ? {
    b := Bag(Node(4, null))
    s := $b
    churn()
    try io.PutLine(s)
}
