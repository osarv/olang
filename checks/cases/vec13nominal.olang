# check: fail error[M19g]: 't' holds a view of 'w' taken before 'w' may have grown
# vec1 F1: a borrowed own result of a declared array type (String) through a Vec parameter - its loan is on the buffer
# M19g, round 2 (brought back from round 1's deletion): the same Vec is seen on both sides, so the view is refused
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}
fn asText(v Vec<Char>&) String&v { return String(v.View()) }
fn grow(w mut Vec<Char>&) ? io.IoError {
    t := asText(w)                        # borrowed own result; type is String (nominal), not Array<Char>
    for i in range 1000 { w.Push('b') }   # grows/frees the buffer -- should be O39, is NOT refused
    churn()                               # reuse the freed buffer
    try io.Println(t)
}
fn main() ? {
    v := Vec<Char>()
    v.Push('a')
    v.Push('a')
    try grow(v)
}
