# check: run
# E31b/O17b (G2): Reset assigns the element's own field - which, made on a copy, would be lost - so the call is made on
# the element in place, through the Vec's RefMut (its arguments plain values): the element itself is reset
type State struct() {
    n I64 = 0
}
type Bag struct() {
    s mut State& = State()
}
fn (b mut Bag&) Add(v I64) { b.s.n = b.s.n + v }
fn (b mut Bag&) Reset() { b.s = State() }

fn main() ? {
    bags := Vec<Bag>()
    bags.Push(Bag())
    bags[0].Add(5)
    bags[0].Reset()
    bags[0].Add(2)
    assert bags[0].s.n == 2
}
