# check: run
# flags: -sanitize
# O14b/T22a: a lambda handing back one of its arguments fits Fold's callback - whose type-variable result requires each
# argument to outlive the result - so Fold's result lives no longer than the words. Refused while the words lived in
# the loop's block; since item 17 they are built where the reference keeping one is; read back after an arena churn

fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn main() ? {
    keep := Vec<String&>()
    keep.Push("x")
    longest String& = keep[0]
    for i in range 2 {
        words := Vec<String&>()
        words.Push($i "abc")
        longest = words.Iter().Fold(words[0], fn(best, w) { return w if w.Len() > best.Len() else best })
    }
    churn()
    assert longest == "1abc"
}
