# check: run
# E11c: "$" calls a Str once per rendering, whatever it writes - a field of a conditional of references, written
# directly: once per "$"
type In struct() {
    k I64 = 0
}
type Mid struct() {
    inner In = In()
}
type Bag struct(m mut Mid&) {
    m
}
fn (b Bag&) Str() String {
    loc mut Mid& = Mid()
    (b.m if b.m.inner.k >= 0 else loc).inner.k++
    return "b" $b.m.inner.k
}
fn main() ? {
    b := Bag(Mid())
    assert $b == "b1"
    assert $b == "b2" and b.m.inner.k == 2
}
