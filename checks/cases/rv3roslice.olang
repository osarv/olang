# check: fail error[T25c]: this writes through a reference a read-only copy holds
# T25c: a slice of a read-only copy reads the copy - its elements' writable references are read-only through it
type Node struct() {
    v I64 = 0
}
type B struct() {
    arr Array<mut Node&, 2>
}
fn mk() B {
    b := B()
    b.arr[0] = Node()
    b.arr[1] = Node()
    return b
}
G B = mk()
fn main() ? {
    x := G
    s := x.arr[0:2]
    s[0].v += 1
}
