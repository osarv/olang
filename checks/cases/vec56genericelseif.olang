# check: fail error[O39]: calling 'Push' may release the Array<I64> borrowed on line
# vec4 (f1g_generic_else_if_return): the review's repro
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# a generic version of h1: per instantiation
fn pick(c Bool, x <T>, y T) T { return x if c else y }
fn g(k I64) I64 ? {
    if k < 5 { error }
    return k
}
fn longerG(a mut Array<<T>>&, b mut Array<T>&) mut Array<T>& {
    if a.Len() == 0 { return Array<T>(1) }
    else if (try g(a.Len()) catch { return pick(true, a, b) }) > 0 { return Array<T>(2) }
    return Array<T>(3)
}
fn longer(a mut Array<I64>&, b mut Array<I64>&) mut Array<I64>& { return longerG(a, b) }
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    other mut Array<I64>& = Array<I64>(1)
    d := longer(v.ViewMut(), other)   # the Vec own buffer - and no loan on it?
    for i in range 1000 { v.Push(i) } # frees the buffer
    churn()
    io.Println($d[0] " " $d[1])
}
