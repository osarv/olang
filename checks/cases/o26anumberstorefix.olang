# check: run
# O26a/E25: the fix the note for checks/cases/o26anumberstore.olang names - the line built where the returned summary
# lives ("&s" of a local the function returns is the result scope) - read back after the arena has been churned
type S struct() {
    best I64 = 0
    names List<String&> = List<String&>()
}
fn mk(i I64) String& { return "line " $i }
fn sneak(t String&, s mut S&) I64 {
    s.names.Push(t)
    return t.Len()
}
fn scan(n I64) S {
    s := S()
    for i in range n {
        line := mk&s(i)
        v := sneak(line, s)
        if v > s.best { s.best = v }
    }
    return s
}
fn churn() I64 {
    t I64 = 0
    for i in range 2000 {
        x := "churn " $i " " $(i * 3)
        t += x.Len()
    }
    return t
}
fn main() ? {
    s := scan(12)
    churn()
    assert s.names.Len() == 12 and s.names[11] == "line 11" and s.best == 7
}
