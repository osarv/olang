# check: fail error[T22b]: 'link' keeps 'b' in 'a', and the function type of this argument says nothing of that - write 'keeps b in a' after its signature
# T22a, O13c: a function giving a function with relations, handed on as a value - every function a call of it may give
# is held to what a written function type says too
type N struct(v I64) {
    v
    next N?& = null
}
fn link(a mut N&, b N&) { a.next = b }
fn get() fn&(a mut N&, b N&) {
    g := link
    return g
}
fn put(mk fn&() fn&(a mut N&, b N&), x mut N&) { mk()(x, N(5)) }
fn main() {
    x mut N& = N(1)
    put(get, x)
}
