# check: run
# flags: -debug -sanitize
# T22c (was a T22b refusal), O13c: a function giving a function with relations, handed on as a value - followed into
# put, mk() gives 'link' there, and N(5) is built where x lives
type N struct(v I64) {
    v
    next N?& = null
}
fn link(a mut N&, b N&) { a.next = b }
fn get() fn&(a mut N&, b N&) {
    g := link
    return g
}
fn put(mk fn&() fn&(a mut N&, b N&), x mut N&) { mk()(x, N(5)) }

# storage made and let go many times, so a value kept in a scope already closed would read another's
fn churn(n I64) I64 {
    t := 0
    for i in range n {
        v := Vec<N>()
        for j in range 16 { v.Push(N(i * j)) }
        t += v[15].v
    }
    return t
}

fn main() {
    x mut N& = N(1)
    put(get, x)
    t := churn(200)
    assert x.next!.v == 5 and t > 0
}
