# check: fail error[E31d]: this Copy has the wrong shape
# E31d: a type's own Copy - what every copy of a value of it calls - reads its receiver through a read-only reference
type tree struct(n I64) { n }
fn (t mut tree&) Copy() tree { return tree(t.n) }
fn main() {
    a := tree(1)
    b := a
    assert b.n == 1
}
