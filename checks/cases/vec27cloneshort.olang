# check: run
# flags: -sanitize
# vec2, O25h: a copy's elements refer where the original's do - refused while the original lived in the loop's turn;
# since item 17 a local copied whole at its last mention into what outlives its block is built where the copy goes, its
# text with it - read back after an arena churn
import "std/io"

fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn main() ? {
    keep := Vec<String&>()
    for i in range 3 {
        w := Vec<String&>()
        w.Push($i "x")
        keep = w
    }
    churn()
    try io.PutLine($keep)
}
