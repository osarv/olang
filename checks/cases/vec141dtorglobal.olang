# check: fail vec141dtorglobal.olang:15:37: error[O40]: a destructor may not release owned objects
# also: note: 'Push' releases here
# Vec phase 2a review (B11): a destructor pushing to a global Vec is reported at its own call, not inside Push
G mut Vec<I64> = Vec<I64>()
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type R struct(k I64) {
    k
} destruct { for i in range 100 { G.Push(i) } }
fn main() ? {
    G.Push(1)
    d := G.View()
    {
        r R& = R(1)
    }
    churn()
    println($d[0])
}
