# check: run
# flags: -debug -sanitize
# O18c/O17b (the second review of the view lend, F3), QCE: "h := ll.RefMut(0).RefMut(0); h.S.Push(x)" - the outer
# RefMut's receiver is what the inner one gave, a reference to where the list's elements are, so the field read out of
# it is there too (a Vec was a handle until 2026-11-01, and "h := ll[0][0].S" its copy - a Vec of its own now)
import "std/io"
type Blk struct() {
    S Vec<I64>
    t I64 = 0
}
fn churn() ? io.Error {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { try io.Println("x") }
    }
}
fn add(ll mut Vec<Vec<Blk>>&, x I64) {
    h := ll.RefMut(0).RefMut(0)
    h.S.Push(x)
}
fn main() ? {
    ll := Vec<Vec<Blk>>()
    ll.Push(Vec<Blk>())
    ll.RefMut(0).Push(Blk())
    add(ll, 7)
    try churn()
    assert ll[0][0].S.Len() == 1 and ll[0][0].S[0] == 7, $ll[0][0].S
}
