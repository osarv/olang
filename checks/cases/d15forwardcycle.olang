# check: fail error[B5a]: these globals' initializers read each other, so none can be set first: A -> B -> C -> A
# D15/B5a: ':=' globals reading each other in a cycle have no type to give - reported as a typed cycle is, not as "?"
import "std/io"
A := B + 1
B := C * 2
C := A
fn main() ? { try io.Println($A) }
