# check: run
# flags: -debug -sanitize
# R8 (refusals 5.7): compiles now - a task's default naming existing storage is the targets' value, judged as the
# task's own result is: 'fallback' outlives 'r', so the default may name it. It was refused ("a task's default is built
# where its result lands, and this names existing storage"); read back after a churn
import "std/io"
type E error {
    Bad
}
type Node struct(v I64) {
    v
}
fn Node.mk(n I64) Node& ? E {
    if n < 0 { error E.Bad }
    return Node(n)
}
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}
fn main() ? {
    fallback Node& = Node(40)
    r Node?& = null
    s Node?& = null
    join {
        spawn r = try Node.mk(-1) catch default fallback
        spawn s = try Node.mk(2) catch default fallback
    }
    churn()
    try io.PutLine($r!.v " " $s!.v " " $(r! == fallback))
}
