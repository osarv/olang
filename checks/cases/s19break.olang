# check: fail error[S19b]: 'break' may not leave deferred code
# S19b: a break in deferred code may leave only a loop written in that deferred code
fn f() I32 {
    t I32 = 0
    for i in range I32(3) {
        defer {
            for j in range 2 {
                if j == 1 { break }
            }
            if t > 1 { break }
        }
        t += i
    }
    return t
}
fn main() ? { assert f() == 3 }
