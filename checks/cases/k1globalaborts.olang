# check: fail error[K2]: this global's initializer aborts the program
# also: it reaches unreachable code, which aborts the program
# never: k1globalaborts.olang:11:1
# K1/K2: a global whose initializer reaches what aborts the program - here unreachable - would abort it at startup, and
# is a compile-time error instead; a global reading it reaches the same place and is not reported a second time
fn pick(x I32) I32 {
    if x > 3 { unreachable }
    return x
}
G I32 = pick(5)
H I32 = G + 1
fn main() ? { }
