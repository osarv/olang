# check: run
# O26a: a returned local lives in the result scope, so the text stored into it is built there and outlives the call. This
# was an error (O13a/O25h - the text was built in the block, which O13a did not see until it judged the stored binding);
# o13afieldstorewrap.olang keeps that error where the local is not what is returned
type H struct(r mut String&) {
    r
}
fn mk(n I64, s mut String&) H {
    e := H(s)
    e.r = $n $n
    return e
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn main() ? {
    q mut String& = "x"
    w := mk(12, q)
    churn()
    assert w.r.Len() == 4 and w.r == "1212"
}
