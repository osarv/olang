# check: fail error[O26]: this value refers to this function's own storage
# O13a/O25h: a value built here is judged at a return by what its constructor bound - until something is stored into it,
# which puts references where its own are (its block): here text that dies at the return. It used to be judged by the
# constructor's binding alone, and returned freed storage
type H struct(r mut String&) {
    r
}
fn mk(n I64, s mut String&) H {
    e := H(s)
    e.r = $n $n
    return e
}
fn main() ? {
    q mut String& = "x"
    w := mk(12, q)
    assert w.r.Len() == 4
}
