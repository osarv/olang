# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# B11/O10c: a value reaching a longer-lived list through a call that keeps its arguments names every argument made in
# a block that closes first - each is a fault (study 6's r14: one note, for the first argument only)
import "std/io"
type Module struct(name String&, path String&) {
    name
    path
}
fn Module.parse(name String&, path String&) Module { return Module(name, path) }
fn load(dir String&, keep mut Vec<Module>&) {
    base := $dir "/"
    for i in range 2 {
        path := $base $i
        m := Module.parse(base, path)
        keep.Push(m)
    }
}
fn main() ? {
    keep := Vec<Module>()
    load("src", keep)
    try io.PutLine($keep.Len())
}
