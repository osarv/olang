# check: run
# M19g: what is not refused - never by element type, and only where the same Vec is visible on both sides. Another Vec
# of the same element type growing; a call given the Vec read-only, or one that only sets elements; a view taken after
# the growth; a view taken again each turn; a view used before the growth only; a copy of the Vec (a second name, no
# view) read after pushes through either; an iterator, which reads the Vec each step; the Vec given another one before
# the push, or a parameter given another one before its push; a Vec of Vecs whose inner Vec grows while a view of the outer one is held; a growth through a second name
# stored in a structure, which the compiler cannot see (the evaluator and -sanitize catch that - retire01assert)
fn sum(v Vec<I64>&) I64 {
    t := 0
    for x in v { t += x }
    return t
}
fn setAll(v mut Vec<I64>&, x I64) { for i in range v.Len() { v[i] = x } }
fn other(v Vec<I64>&, w mut Vec<I64>&) { w.Push(v.Len()) }
fn fresh(w mut Vec<I64>&) {
    w = Vec<I64>()                              # a parameter given another Vec names that one
    w.Push(1)
}
fn main() {
    v := Vec<I64>()
    w := Vec<I64>()
    v.Push(1)
    v.Push(2)
    d := v.View()
    for i in range 100 { w.Push(i) }           # another Vec of the same type
    assert d[0] == 1
    assert sum(v) == 3                          # read-only
    setAll(v, 5)                                # sets elements only
    assert d[1] == 5
    other(v, w)                                 # grows w, not v
    fresh(v)                                    # grows a Vec of its own
    assert d[0] == 5
    for i in range 100 { v.Push(i) }
    e := v.View()                               # taken after the growth
    assert e.Len() == 102
    t := 0
    for i in range 10 {                         # taken again each turn
        f := v.View()
        t += f[0]
        v.Push(i)
    }
    assert t == 50
    g := v.View()
    n := g.Len()                                # used before the growth only
    v.Push(1)
    assert n > 0
    c := v                                      # a second name, no view
    c.Push(3)
    v.Push(4)
    assert c.Len() == v.Len()
    it := v.Iter()                              # an iterator reads the Vec each step
    v.Push(5)
    assert (try it.Next() catch default 0) == 5
    u := Vec<I64>()
    u.Push(1)
    h := u.View()
    u = Vec<I64>()                              # given another Vec: the view is of the old one
    u.Push(2)
    assert h[0] == 1
    vv := Vec<Vec<I64>>()
    vv.Push(Vec<I64>())
    outer := vv.View()
    inner := vv[0]
    inner.Push(9)                               # the inner Vec grows; the outer buffer is not replaced
    assert outer.Len() == 1
}
