# check: fail error[E15]: this call can fail - write 'try', and catch or pass on its errors
# D17: a function whose check raises ArgumentError.Invalid can fail, so every call is handled
fn pick(x I32, y I32) I32 ? {
    if not y > x: error ArgumentError.Invalid("pick: y > x")
    return y - x
}

fn main() {
    a := I32(1)
    b := pick(a, 2)
    b++
}
