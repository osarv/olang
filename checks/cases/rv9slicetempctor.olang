# check: run
# flags: -debug -sanitize
# E16a/C2g, O27 as placement: a constructor field keeping a slice of a temporary has the temporary built where the
# instance lives (it was O10's error: the temporary was the constructor's frame storage, gone when it returned - over
# 64KB its own scope, a use after the scope closed and a wrong value once); read back after a churn
import "std/io"
type Big struct(n I64) {
    a := Array<I64>(20000)
    a[0] = n
    a[1] = n + 1
}
type K struct(n I64) {
    r Array<I64>& = Big(n).a[0:2]
}
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}
fn main() ? {
    k := K(7)
    churn()
    try io.Println($k.r[1])
}
