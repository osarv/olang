# check: run
# flags: -debug -sanitize
# T32a (the any review, finding 2): a local's text converted to a type declared over String (T29a names its argument's
# storage) is copied into the any's box like any array: the box outlives the loop body the text was made in, and
# writing through a mut any leaves the local alone
import "std/io"
type aSized trait {
    Len() I64
}
type aBump trait {
    mut Bump()
}
type aLab extends String
fn (l mut aLab&) Bump() { l[0] = 'Z' }
type aNums extends Array<I64>
fn main() {
    xs := Vec<any aSized&>()
    for i in range 3 {
        t := "lab" $i
        xs.Push(aLab(t))
        c := I64[i, 7]
        xs.Push(aNums(c[0:2]))
    }
    for k in range 200 {
        l := Vec<I64>()
        for j in range 40 { l.Push(k + j) }
        s := "junk " $k
    }
    for x in xs { io.Println($x)! }
    s := "hello"
    b mut any aBump& = aLab(s)
    b.Bump()
    io.Println($s " " $b)!
}
