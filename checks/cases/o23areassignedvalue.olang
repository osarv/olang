# check: run
# flags: -sanitize
# O23a, O29: the same through a function value, whose call passes no derived scope: each build found where its
# own field refers, the parameter assigned between - read back after an arena churn
import "std/io"
type Box struct(v I64) {
    v
}
type Tally struct() {
    last Box?& = null
}
type Holder struct(log mut Tally&) {
    log
}
fn note(h mut Holder&, id I64, other mut Holder&) {
    h.log.last = Box(id)
    h = other
    h.log.last = Box(id + 100)
}
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    b mut Tally& = Tally()
    f := note
    t := 0
    for k in range 20 {
        a mut Tally& = Tally()
        for _ in range 1 {
            ha := Holder(a)
            hb := Holder(b)
            f(ha, k, hb)
        }
        t += churn(5) + a.last!.v
    }
    t += churn(40)
    try io.PutLine($b.last!.v " " $t)
}
