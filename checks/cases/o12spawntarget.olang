# check: run
# flags: -sanitize
# O12/P1g, O29: a task's built result stored into an element of an array whose scope is one of two - judged as the plain
# assignment it is, built where the array is found to live at run time (it was refused; review port1 l04)
import "std/io"
type Node struct(v I64) { v }
fn Node.mkNode(i I64) Node& { return Node(i) }
fn main() ? io.Error {
    outer mut Array<Node&>& = Array<Node&>(1, Node(0))
    for i in range 3 {
        inner mut Array<Node&>& = Array<Node&>(1, Node(0))
        arr := outer if i < 10 else inner
        join { spawn arr[0] = Node.mkNode(i + 50) }
    }
    try io.Println($outer[0].v)
}
