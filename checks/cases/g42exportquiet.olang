# check: build
# G42, X13 (the sharper rule of 2026-11-03): a call of C may call an export fn back only where C is given one, the program
# is built -library, or it links C of its own - and never through the C library's input and output, text, memory and
# time functions: usleep here, with an export fn C is given (qsort's), writes no global
import unistd "unistd.h"

G mut I64 = 0

type Item struct(key I32) { key }

extern fn qsort(base mut Array<Item>&, n I64, size I64, cmp fn&(a Item&, b Item&) I32)

export fn olang_count(a Item&, b Item&) I32 {
    G = G + 1
    return a.key - b.key
}

fn pause() { unistd.usleep(0) }

assert not pause.WritesGlobals

fn main() {
    xs := Item[Item(2), Item(1)]
    qsort(xs, xs.Len(), 4, olang_count)
    pause()
}
