## check: fail doesn't match
## T22: a fallible function is not a value of an infallible function type - its errors are part of its type
error E { X }
fn bad(n Int32) Int32 ? E {
    if n > 0 { error E.X }
    return n
}
fn apply(f fn(n Int32) Int32, n Int32) Int32 { return f(n) }
fn main() ? E {
    k := apply(bad, 5)
}
