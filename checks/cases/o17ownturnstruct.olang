# check: fail error[C2d]: this instance holds a reference to an argument it would outlive - make the argument where the instance goes, hold it by value in a field
# O17 (bulk review 6 F3): a loop turn's value owning storage, lent to a callee keeping a reference to it, binds where
# its own storage is - one slot every turn reuses - so keeping it past the turn is refused (every kept reference named
# the last turn's value)
import "std/io"

type rec struct(s String) { s }
type rh struct(r rec&) { r }
type ah struct(a Array<I64>&) { a }

fn main() {
    hs := Vec<rh>()
    for k in range 1, 6 {
        r := rec($k)
        hs.Push(rh(r))
    }
    out := ""
    for h in hs { out = $out $h.r.s }
    ahs := Vec<ah>()
    for k in range 1, 6 {
        a := Array<I64>(k, k)
        ahs.Push(ah(a))
    }
    s := 0
    for h in ahs { s += h.a.Len() }
    io.Println("recs " $out " (12345) arrays " $s " (15)")!
}
