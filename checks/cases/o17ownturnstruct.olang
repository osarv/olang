# check: run
# flags: -sanitize
# O17 (bulk review 6 F3, item 17): a loop turn's value owning storage, lent to a callee keeping a reference to it, binds
# where its own storage is - refused while that was one slot every turn reused (every kept reference named the last
# turn's value); since item 17 it is built where what keeps it is, a new value each turn - read back after an arena churn
import "std/io"

type rec struct(s String) { s }
type rh struct(r rec&) { r }
type ah struct(a Array<I64>&) { a }

fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn main() {
    hs := Vec<rh>()
    for k in range 1, 6 {
        r := rec($k)
        hs.Push(rh(r))
    }
    ahs := Vec<ah>()
    for k in range 1, 6 {
        a := Array<I64>(k, k)
        ahs.Push(ah(a))
    }
    churn()
    out := ""
    for h in hs { out = $out $h.r.s }
    s := 0
    for h in ahs { s += h.a.Len() + h.a[0] }
    io.PutLine("recs " $out " (12345) arrays " $s " (30)")!
}
