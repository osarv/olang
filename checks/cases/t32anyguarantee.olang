# check: fail aAcct.Take's guarantee 'left >= 0' does not hold for a call evaluated while compiling
# D17e: run-time trait values
type aAcct trait {
    mut Take(n I64) left I64 [left >= 0]
}
type aWal struct(c I64) { c }
fn (w mut aWal&) Take(n I64) I64 {
    w.c -= n
    return w.c
}
fn take(a mut any aAcct&, n I64) I64 { return a.Take(n) }
fn spend() I64 {
    w := aWal(5)
    return take(w, 9)
}
G I64 = spend()
fn main() { }
