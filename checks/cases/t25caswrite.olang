# check: fail this writes through a read-only reference
# T25c: 'as' on a read-only payload, and a checked index of read-only elements, give read-only references
type Node struct(v I32) {
    v
}
type Box enum {
    R(n Node&)
    No
}
type World struct() {
    items mut List<Node&>& = List<Node&>()
}
fn viaAs(q Node&) {
    b := Box.R(q)
    (b as Box.R).v = 81
}
fn viaTry(w World&) ? {
    (try w.items[0]).v = 82
}
fn main() ? {
    a Node& = Node(1)
    viaAs(a)
}
