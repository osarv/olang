# check: fail error[T25c]: a read-only copy cannot be passed where it may be written
# T25c (refusals section 8: a kind with no case): a copy of what is reached read-only shares its references read-only -
# lent to a parameter that writes through them, it would write what it was promised not to
type Box struct(d mut Array<I64>&) {
    d
}
type Holder struct(b Box) {
    b
}
fn bump(b mut Box&) { b.d[0]++ }
fn main() {
    h := Holder(Box(Array<I64>(1)))
    r Holder& = h
    c := r.b
    bump(c)
    assert c.d[0] == 1
}
