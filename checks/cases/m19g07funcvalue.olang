# check: fail error[M19g]: 'd' holds a view of 'v' taken before 'v' may have grown
# also: note: 'v' may grow here, in a call through a function value
# M19g: a call through a function value given the Vec writably - a body not known may grow what it is given writably
import "std/io"
fn grow(w mut Vec<I64>&) { for i in range 100 { w.Push(i) } }
fn main() ? {
    v := Vec<I64>()
    v.Push(1)
    f := grow
    d := v.View()
    f(v)
    try io.Println($d[0])
}
