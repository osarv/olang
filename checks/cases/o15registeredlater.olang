# check: run
# flags: -debug -sanitize
# O15, O16 (docs/refusals.md 5.6, R7; refused until call 8 of 2026-11-08): two ":=" holders of one block, the first
# made to hold an element of the second - QCZ's order ends the first before the second, whatever their order, so the
# Grip's destructor reads its Lamp alive, after a churn
import "std/io"
type Tally struct() {
    n I64 = 0
}

type Lamp unique struct(id I64, log mut Tally&) {
    id, log
    data := Array<I64>(16 + id.Mod(2), id)
    alive := true
} destruct {
    log.n += id
    alive = false
}

type Grip unique struct(id I64) {
    id
    held Lamp?& = null
} destruct {
    if held is not null {
        assert held!.alive, "a Grip read its Lamp ended"
        held!.log.n += held!.data[3] * 10
    }
}

fn churn() I64 {
    n := 0
    for i in range 200 {
        s := $i "-" $(i * 7)
        n += s.Len()
    }
    return n
}

fn twoVecs(t mut Tally&, k I64) {
    gs := Vec<Grip>()
    gs.Push(Grip(5))
    ls := Vec<Lamp>()
    ls.Push(Lamp(k, t))
    gs[0].held = ls[0]
    churn()
}

fn main() ? {
    t := Tally()
    twoVecs(t, 4)
    assert t.n == 44
    try io.Println("n " $t.n)
}
