# check: fail error[S4e]: 's' is linked to a new value: the caller still sees what it passed
# S4e: a fresh value given to a reference parameter, then changed through it - the caller never sees either
type S struct(name String, xs Vec<I64>) {
    name
    xs
}

fn Reset(s mut S&) {
    s ~ S("new", Vec<I64>())
    s.xs.Push(1)
}

fn main() {
    a := S("old", Vec<I64>())
    Reset(a)
    Println(a.name + " " + $a.xs.Len())
}
