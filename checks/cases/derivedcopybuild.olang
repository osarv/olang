# check: run
# flags: -sanitize
# C2d/O23a: a reference read through a field with a binding of its own and copied into a local is built through as the
# direct form "grow(w.at[0])" is. It was refused - what grow builds would have been reclaimed with the view's scope, not
# where the element lives; since C1 (2026-11-07) a build through a derived scope, which exists at no run time, goes to
# the program's scope, which outlives the element - read back after an arena churn
import "std/io"
type Node struct(v I64) {
    v
    next mut Node?& = null
}
type View struct(ns Array<mut Node&>&) {
    at Array<mut Node&>& = ns
}
fn grow(x mut Node&) { x.next = Node(x.v + 100) }
fn visit(w View&) {
    x := w.at[0]
    grow(x)
}
fn work(a Array<mut Node&>&) { visit(View(a)) }
fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30 { l.Push(i) }
    if d == 0 { return 0 }
    return churn(d - 1) + a[3] - d
}
fn main() ? {
    a := Array<mut Node&>(1, Node(3))
    work(a)
    t := churn(100)
    try io.PutLine($a[0].next!.v " " $t)
}
