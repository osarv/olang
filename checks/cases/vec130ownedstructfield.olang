# check: fail error[O25h]: this value holds references into a scope the target outlives
# round 1 of docs/memory.md: a Vec is a handle, so 'take' no longer moves one - its record stays in the first own
# object's region, and storing the handle into another region is refused by O25h (O1b for a global, O38 for a borrow)
# R1: a struct holding the Vec, held by value in the owned object
import "std/io"
type Lex3 struct() {
    toks Vec<String&> = Vec<String&>()
}
type Mid struct() {
    l Lex3 = Lex3()
}
type H struct() {
    m own mut Mid& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    h := H()
    g := H()
    h.m = Mid()
    g.m = Mid()
    for i in range 3 { h.m.l.toks.Push($i "-built-into-h-region") }
    g.m.l = h.m.l
    h.m = null
    churn()
    try io.Println(g.m.l.toks[0])
}
