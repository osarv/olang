# check: run
# flags: -debug -sanitize
# D18c, O27 as placement: an element viewing a local the generator made ('l') has that local built where the generator
# lives (it was O27's error); read back after a churn
import "std/io"
fn initials(t String&) Iterator<String&> {
    l := $t "!"
    yield l[0:1]
    yield l[l.Len() - 1:]
}

fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn main() {
    out := Vec<String&>()
    for w in initials("ab") { out.Push(w) }
    churn()
    io.PutLine($out)!
}
