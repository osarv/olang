# check: fail error[O27]: this returns a view of 'l', which this function builds - return the value (a result written without '&' copies it), or a copy: '$x'
# D18c: an element borrowed from what 't' refers to is no part of a local the generator made
fn words(t String&) Iterator<String&> {
    i I64 = 0
    for i < t.Len() {
        for i < t.Len() and t[i] == 0x20 { i++ }
        j := i
        for j < t.Len() and t[j] != 0x20 { j++ }
        if j > i { yield t[i:j] }
        i = j
    }
}

fn initials(t String&) Iterator<String&> {
    l := $t "!"
    yield l[0:1]
}

fn main() {
    for _ in initials("ab") { }
}
