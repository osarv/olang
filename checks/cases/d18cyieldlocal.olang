# check: fail error[D18c, S20]: this generator's elements live with what 't' refers to, and this value is not shown to last as long - yield a part of what lives there, or values ('Iterator<T>') and a copy ('$x', 'x.Clone()')
# D18c: an element borrowed from what 't' refers to is no part of a local the generator made
fn words(t String&) Iterator<String&t> {
    i I64 = 0
    for i < t.Len() {
        for i < t.Len() and t[i] == 0x20 { i++ }
        j := i
        for j < t.Len() and t[j] != 0x20 { j++ }
        if j > i { yield t[i:j] }
        i = j
    }
}

fn initials(t String&) Iterator<String&t> {
    l := $t "!"
    yield l[0:1]
}

fn main() {
    for x in initials("ab") { }
}
