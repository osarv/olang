# check: fail error[E31b]: x[i] gives a copy of the element, which this call would write while it can reach the collection another way
# E31b (review 6b F1, the sharper rule of 2026-11-03): a method called through x[i] that calls C is not made on the
# element in place where C is given an export fn - C may call it before it returns (X13), and one that grows the
# collection left the element's reference naming the buffer the growth retired: the write was lost. (C's own input and
# output, text, memory and time functions call nothing back.)
import "std/io"
type blk struct(n I64) { n }
type Item struct(key I32) { key }
G mut Vec<blk>
extern fn qsort(base mut Array<Item>&, n I64, size I64, cmp fn&(a Item&, b Item&) I32)
export fn olang_grow(a Item&, b Item&) I32 {
    for i in range 4 { G.Push(blk(i)) }
    return a.key - b.key
}
fn (b mut blk&) Bump() {
    xs := Array<Item>[Item(2), Item(1)]
    qsort(xs, xs.Len(), 4, olang_grow)
    b.n = 99
}
fn main() {
    G.Push(blk(1))
    G[0].Bump()
    io.PutLine("G[0].n = " $G[0].n " len " $G.Len())!
}
