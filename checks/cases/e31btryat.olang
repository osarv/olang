# check: fail x[i] gives a copy
# E31b: "try x[i]" on a List - its check derived from Len - is a copy of the element as "x[i]" is; lent to a "mut &"
# parameter it was taken for any temporary and the write silently lost (bump left N at 0)
import "std/io"
type Acc struct() {
    N I64 = 0
}
fn bump(a mut Acc&) { a.N++ }

fn main() ? {
    l := Vec<Acc>()
    l.Push(Acc())
    bump(try l[0])
    try io.PutLine($l[0].N)
}
