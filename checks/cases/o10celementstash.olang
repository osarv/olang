# check: run
# flags: -debug -sanitize
# O20/O10c, O27 as placement: an element borrowed out of a reference parameter's array field lives where that parameter's
# instance does, so storing it into another parameter's holder is an obligation - a caller whose instance dies first
# has the instance built where the holder lives (it was O27's error naming 'g'), a new one each turn
import "std/io"
type Elem struct() { n I64 = 0 }
type G struct() { arr mut Array<Elem>& = Array<Elem>(3) }
type Keeper struct() { e Elem?& = null }
fn stash(g G&, h mut Keeper&) { h.e = g.arr[0] }
fn churn() I64 {
    t := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn main() ? {
    h := Keeper()
    for i in range 3 {
        g := G()
        g.arr[0].n = i
        stash(g, h)
    }
    churn()
    try io.Println($h.e!.n)
}
