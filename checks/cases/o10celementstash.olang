# check: fail error[O10c]: the callee needs one argument's scope to outlive another's
# also: 'g' is declared here, in a block that closes first - declare it where 'h' lives
# O20/O10c: an element borrowed out of a reference parameter's array field lives where that parameter's instance does,
# so storing it into another parameter's holder is an obligation - a caller whose instance dies first is refused
type Elem struct() { n I64 = 0 }
type G struct() { arr mut Array<Elem>& = Array<Elem>(3) }
type Keeper struct() { e Elem& = null }
fn stash(g G&, h mut Keeper&) { h.e = g.arr[0] }
fn main() ? {
    h := Keeper()
    for i in range 3 {
        g := G()
        g.arr[0].n = i
        stash(g, h)
    }
    println($h.e.n)
}
