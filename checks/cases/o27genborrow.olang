# check: run
# flags: -debug -sanitize
# O27 as placement (bulk review 6 F14): a loop turn's text kept past the turn through a generator's borrowed elements has
# the text built where the list lives, a new one each turn, as the same keep through a plain function does - a walk held
# in a local too (it was O27's error naming 't' and 'u'); read back after a churn of 50 strings
import "std/io"

fn words(t String&) Iterator<String&> {
    s := 0
    for i in range t.Len() {
        if t[i] == ' ' {
            yield t[s:i]
            s = i + 1
        }
    }
    yield t[s:]
}

fn main() {
    out := Vec<String&>()
    for i in range 5 {
        t := $i " a" " b"
        for w in words(t) { out.Push(w) }
    }
    g := Vec<String&>()
    for i in range 3 {
        u := $i " c d"
        it := words(u)
        for w in it { g.Push(w) }
    }
    junk := Vec<String>()
    for i in range 50 { junk.Push("zzzzzzzzzzzzzzzzzzzzzzz" $i) }
    io.Println($out " " $g " " $junk.Len())!
}
