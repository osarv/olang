# check: fail the callee needs one argument's scope to outlive another's
# beside o26alatermodule: linalg.View's result holds its data, so a view of an array made in a loop's body cannot be
# kept in a list outliving the loop (O10c) - it was accepted, and read freed memory: Matrix's Data field is a
# conditional (a slice of the data, else a new array), and a constructor field given one was not held to the instance
# (C2d)
import "std/io"
import "std/linalg"

fn main() ? {
    ms := List<linalg.Matrix<F64>>()
    for i in range 3 {
        d := Array<F64>(4, F64(i))
        ms.Push(try linalg.View(d, 0, 2, 2))
    }
    io.Println($ms[0].Get(1, 1) " " $ms[2].Get(1, 1))!
}
