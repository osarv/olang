# check: run
# flags: -d -s
# P2 (a review of rv3fix, h3): a fold into a stand-in folded already goes to what it forwards to. Here a closure a first
# task handed back holds that task's stand-in; a second task handed the closure gets a stand-in whose parent is the
# first one, and builds R(2) there. Folded into the forwarder itself, R(2) - and R(3), built after it on this thread -
# sat in a header no one closes and were never destructed; all three run when run's scope closes.
Dtors mut I64 = 0
type R struct(id I64) {
    id
} destruct {
    Dtors += id
}
type Holder struct() {
    res mut R& = null
}
fn pass(f fn(i I64)) fn(i I64) { return f }
fn call(f fn(i I64), i I64) { f(i) }
fn run() {
    n mut Holder& = Holder()
    g := fn(i I64) { n.res = R(i) }
    k fn(i I64) = g
    join {
        spawn k = pass(g)
    }
    join {
        spawn call(k, 2)
    }
    k(3)
    g(4)
}
fn main() ? {
    run()
    if Dtors != 9 { fail }
}
