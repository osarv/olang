# check: fail error[M19g]: 'r' holds a view of 'm' taken before 'm' may have grown
# M19g (bulk review 6 F7): a Ref/RefMut is a view of its collection's buffer - one used after the same collection may
# have grown in the same function is refused, as a View() is (it wrote the retired buffer)
import "std/io"

type rec struct(n I64) { n }

fn main() {
    m := Map<I64, rec>()
    m.Put(0, rec(1))
    r := try m.RefMut(0) catch { return }
    for i in range 1, 1000 { m.Put(i, rec(i)) }
    r.n = 77
    x := try m.Get(0) catch { return }
    io.Println("m[0].n " $x.n " r.n " $r.n " (77 77 in place)")!
}
