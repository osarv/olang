# check: fail error[O38]: this value borrows an own object, and is kept where only this function's locals may hold it
# O38: ...or one of several targets (own4 N2)
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn two(x Outer&) (Outer&x, I64) { return x, 7 }
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    r Outer& = null
    n I64 = 0
    join {
        spawn r, n = two(b)
    }
    println($r.o.k " " $n)
}
