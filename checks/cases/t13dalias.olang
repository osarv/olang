# check: run
# T13d: a generational value is held by reference: ":=" names a new instance, a second name the same instance; a
# destructor makes no generational type unique (C11), and runs once per instance. A weak place reads its node while an
# owning place holds it (keep.next here), and null once none does (T2d)
import "std/io"
type Node struct(v I64) {
    v
    next mut Node?& = null
    prev weak mut Node?& = null
} destruct { Ends++ }
Ends mut I64 = 0
fn made() I64 {
    a := Node(1)
    b := a
    b.v = 5
    c := Node(9)
    c.next = a
    a.next = Node(2)
    nx := a.next!
    nx.prev = a
    held := nx.prev == b
    c.next = null
    return a.v * 100 + c.v * 10 + (1 if held else 0) + (2 if nx.prev is null else 0)
}
fn main() ? io.Error {
    r := made()
    try io.Println($r " " $Ends)
}
