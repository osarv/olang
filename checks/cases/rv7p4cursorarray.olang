# check: run
# E11c: "$" calls a Str once per rendering, whatever it writes - a cursor in an array, written through directly: once
# per "$"
type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
type Cur struct(of Bag&) {
    c mut Cell&of = of.c
}
fn (b Bag&) Str() String {
    cs := Cur[Cur(b)]
    cs[0].c.v++
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    assert $b == "b1"
    assert $b == "b2" and b.c.v == 2
}
