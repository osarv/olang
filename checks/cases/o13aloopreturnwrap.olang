# check: fail error[O26]: this value refers to this function's own storage
# O13a: a loop body runs again after itself, so a return in it sees what the loop assigns the local later - here text
# made in this function's own block. It used to be judged by the first iteration's binding alone, and returned freed
# storage. A local returned itself lives in the result scope (O26a, o13aloopreturn.olang); one inside another does not
type H struct(r String&) {
    r
}
type W struct(h H) {
    h
}
fn mk(n I64, s String&) W {
    e := H(s)
    for i in range 3 {
        if i == 2 { return W(e) }
        e = H($n $n)
    }
    return W(H(s))
}
fn main() ? {
    w := mk(12, "x")
    assert w.h.r.Len() > 0
}
