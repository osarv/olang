# check: run
# flags: -sanitize
# O23a, O29 (field scopes, option B): a helper whose writable field has a binding of its own, building through it from
# bodies no caller passes the binding to - a method called through an "any", a lambda called where it is made, a task -
# each builds where the field's referent lives, passed where the call knows it and found from the referent's address
# while the program runs where it does not; read back after an arena churn
type Ctx struct() {
    names Vec<String&> = Vec<String&>()
}

type Noter trait {
    Note(i I64)
}

type Pass struct(C mut Ctx&) {
    C
}

fn (p Pass&) Note(i I64) { p.C.names.Push($i + "a") }

fn viaAny(n any Noter&, i I64) { n.Note(i) }

fn run(c mut Ctx&, i I64) {
    p := Pass(c)
    viaAny(p, i)
    g := fn(k I64) { p.Note(k + 100) }
    g(i)
    join {
        spawn p.Note(i + 1000)
    }
}

fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30: l.Push(i)
    if d == 0: return 0
    return churn(d - 1) + a[3] - d
}

fn main() {
    c := Ctx()
    for i in range 3: run(c, i)
    t := churn(60)
    b := StringBuilder()
    for n in c.names: b.Push(n + " ")
    assert b.ToString() == "0a 100a 1000a 1a 101a 1001a 2a 102a 1002a " and t == 0
}
