# check: fail error[P4c]: no task of this join can fail - drop the 'try'
# P4c: "try join" on a join none of whose tasks can fail - every error each task can be is taken by its own clause
error E {
    BAD
}
fn work(n I32) ? E {
    if n < 0 { error E.BAD }
}
fn main() ? {
    try join {
        spawn try work(-1) catch E { }
    }
}
