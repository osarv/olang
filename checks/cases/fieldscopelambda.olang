# check: run
# flags: -sanitize
# D16c, T22c (field scopes, option B): a lambda passed as a function value builds through a captured helper's field;
# its environment holds the helper by value, so the scope it builds in is the one the plan recorded for the capture
# (where the field's referent lives), never where the environment is - the evaluator and the native code agree. Read
# back after an arena churn; the top-level assert is decided by the compile-time evaluator, which runs the same code
type Ctx struct() {
    names Vec<String&> = Vec<String&>()
}

type Pass struct(C mut Ctx&) {
    C
}

fn viaValue(f fn&(k I64), i I64) { f(i) }

fn run(c mut Ctx&, i I64) {
    p := Pass(c)
    viaValue(fn(k I64) { p.C.names.Push($k + "b") }, i)
}

fn churn(d I64) I64 {
    a := Array<I64>[d, d, d, d, d, d, d, d]
    l := Vec<I64>()
    for i in range 30: l.Push(i)
    if d == 0: return 0
    return churn(d - 1) + a[3] - d
}

fn all(n I64) String {
    c := Ctx()
    for i in range n: run(c, i)
    t := churn(40)
    b := StringBuilder()
    for x in c.names: b.Push(x + " ")
    b.Push($t)
    return b.ToString()
}

assert all(3) == "0b 1b 2b 0"

fn main() {
    c := Ctx()
    for i in range 3: run(c, i)
    t := churn(60)
    b := StringBuilder()
    for x in c.names: b.Push(x + " ")
    assert b.ToString() == "0b 1b 2b " and t == 0 and all(3) == "0b 1b 2b 0"
}
