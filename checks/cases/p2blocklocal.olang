# check: fail error[P2]: this argument's storage closes before the join does
# a local of a block inside the join closes at that block's end, before the task it was lent to is joined: must fail
import "std/io"
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur mut Node&
}
fn look(h Holder&) { try io.Println(h.cur.name) catch io.IoError { } }
fn main() ? {
    join {
        {
            o mut Holder& = Holder()
            o.cur = Node(7)
            spawn look(o)
        }
    }
}
