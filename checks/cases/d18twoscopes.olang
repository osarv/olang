# check: fail error[C2d]: this instance holds a reference to an argument it would outlive - make the argument where the instance goes, or the instance where the argument lives ('T&x(...)')
# D18b, D16d: a generator holds every argument it was given, the second as the first - neither may die before it
fn both(a String&, b String&) Iterator<String> {
    yield $a
    yield $b
}

fn main() ? {
    a := "hello"
    g Generator<String>
    {
        b := $a "x"
        g = both(a, b)
    }
    for x in g {
    }
}
