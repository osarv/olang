# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# D18b, D16d: a generator holds every argument it was given, the second as the first - neither may die before it
fn both(a String&, b String&) Iterator<String> {
    yield $a
    yield $b
}

fn main() ? {
    a := "hello"
    g Generator<String>
    {
        b := $a "x"
        g = both(a, b)
    }
    for _ in g {
    }
}
