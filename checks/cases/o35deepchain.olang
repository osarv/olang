# check: run
# O35: releasing a chain of owners far longer than a stack is deep - three hundred thousand of them, on a 256KB stack -
# finishes, every destructor run once and in turn; a release nests only so deep, the rest finished in the order made
import "std/os"

RelNext mut I64 = 0
RelBad mut I64 = 0
type Deep struct(v I64) {
    v
    next own mut Deep&
} destruct {
    if v != RelNext { RelBad++ }
    RelNext--
}
fn release() {
    head own mut Deep& = null
    for i in range 300000 {
        n own mut Deep& = Deep(i)
        n.next = take head
        head = take n
    }
    RelNext = 299999
}
fn main() ? {
    os.RunOnStack(262144, release)
    assert not (RelNext != -1 or RelBad != 0)
}
