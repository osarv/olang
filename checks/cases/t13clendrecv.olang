# check: fail error[T13c]: 'h.i' is a field of a packed struct,
# T13c: a writable receiver is a reference to the field - the call would write bits no place holds
type Inner packed struct(a U4, b U4) { a, b }
fn (x mut Inner&) Bump() { x.a++ }
type H packed struct(i Inner, k U8) { i, k }
fn main() {
    h := H(Inner(1, 2), 3)
    h.i.Bump()
}
