# check: fail error[O34]: the array's elements can be stored through, so they must refer exactly where this slot's elements do - move it into a slot whose container lives where the source's does
# moving a buffer of store-through references into a slot of another element scope: must fail (O34)
type N struct(v I64) { v
 next mut N& = null }
type B struct() {
    data own mut Array<mut N&>& = null
}
fn main() ? {
    a := B()
    a.data = Array<mut N&>(2)
    a.data[0] = N(1)
    {
        b := B()
        b.data = take a.data
        b.data[0].next = N(2)
    }
}
