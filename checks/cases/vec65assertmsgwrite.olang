# check: fail error[O39]: calling 'Push' may release the Array<I64> borrowed on line
# vec4 F1': the local rebound to the argument inside an assert message's catch block - the write scan sees it, so the
# result is not proven fresh and keeps the loan on the Vec's buffer
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn pick(c Bool, x <T>, y T) T { return x if c else y }
fn g(k I64) I64 ? {
    if k < 5 { error }
    return k
}
fn longer(a mut Array<I64>&, b mut Array<I64>&) mut Array<I64>& {
    out mut Array<I64>&return = Array<I64>(2)
    assert a.Len() > 100, (try g(1) catch { out = pick(true, a, b) } default 0).Format()
    return out
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    other mut Array<I64>& = Array<I64>(1)
    d := longer(v.ViewMut(), other)
    for i in range 1000 { v.Push(i) }
    churn()
    try io.Println($d[0] " " $d[1])
}
