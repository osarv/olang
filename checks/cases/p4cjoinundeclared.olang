# check: fail error[R9]: E can escape here, and this function does not declare it - add it after '?', or catch it
# P4c/R13: what the clauses of a "try join" do not take propagates, so the function declares it
error E {
    BAD
    WORSE
}
fn work(n I32) ? E {
    if n < 0 { error E.BAD }
}
fn run() I32 {
    try join {
        spawn try work(-1)
    } catch E.BAD { return 1 }
    return 0
}
fn main() ? { println($run()) }
