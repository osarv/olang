# check: fail error[R1d]: E.Worse can escape here, and this function writes no '?'
# P4c/R13: what the clauses of a "try join" do not take propagates, so the function declares it
import "std/io"
type E error {
    Bad
    Worse
}
fn work(n I32) ? E {
    if n < 0 { error E.Bad }
}
fn run() I32 {
    try join {
        spawn try work(-1)
    } catch E.Bad { return 1 }
    return 0
}
fn main() ? { try io.PutLine($run()) }
