# check: fail error[O38]: this argument borrows an own object, and the callee may keep it beyond the call
# O38: ...through a method's receiver (own5 F1)
import "std/io"
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
type W struct(o Outer&) {
    f Outer&o = o
}
fn (w W&) into(l mut List<Outer&>&) { l.Push(w.f) }
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    l := List<Outer&>()
    w := W(b)
    w.into(l)
    v.o = null
    try io.Println($l[0].o.k)
}
