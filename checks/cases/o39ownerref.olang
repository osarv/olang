# check: fail error[O39]: assigning 'v.o' may release the Inner borrowed on line
# O39: the owner releases nothing through its own name while a reference to its storage is used (own5 F2)
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    r mut Outer& = v
    v.o = Inner(9)
    println($r.o.k)
}
