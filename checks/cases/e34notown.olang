# check: fail error[E34]: 'take' moves an owner out of an own slot
# 'take' is for own slots only
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn main() ? {
    c := Sock(1)
    d := take c
}
