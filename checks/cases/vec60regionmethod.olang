# check: fail error[O39]: assigning 'c.text' may release the String borrowed on line
# vec4 (r1c_in_a_method): the review's repro
import "std/io"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# s3 shape inside a method that is handed the owner: built into the region of a field, then the field released
type CB struct() {
    text own mut String& = $1 "-ttttttttttttttt"
}
fn (c mut CB&) Rebuild(n I64) {
    x := c.text
    d mut String&x = $n "-new-text-in-the-field-region"
    c.text = $2 "-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    io.Println(d)
}
fn main() ? {
    c := CB()
    c.Rebuild(5)
}
