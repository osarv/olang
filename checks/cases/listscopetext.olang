# check: run
# text made where a List lives ('s String&l') is pushed and read, and the List replaced afterwards
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    items mut Vec<String&>& = Vec<String&>()
}
fn main() ? {
    c := CB()
    l := c.items
    s mut String&l = $5 "-new-text-made-where-the-list-lives"
    l.Push(s)
    assert s == "5-new-text-made-where-the-list-lives"
    c.items = Vec<String&>()
    churn()
    assert c.items.Len() == 0
}
