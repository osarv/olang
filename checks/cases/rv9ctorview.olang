# check: run
# flags: -d -s
# E16a/C2d (tonight9's review): a constructor field the instance keeps a view of - a slice, an "as" view, a conditional
# of slices, a slice a nested instance keeps - is stored where the instance lands. It stayed the constructor's frame
# storage: for a field over 64KB its own scope, closed as it returned ("use after scope closed" here)
type Holder struct(a Array<I64>&) {
    a
}
type K struct(n I64) {
    big Array<I64, 20000>
    big[0] = n
    big[1] = n + 1
    view Array<I64>& = big[0:2]
    w := big as Array<I64, 20000>&
    c Array<I64>& = big[0:2] if n > 0 else big[1:3]
    h Holder& = Holder(big[0:2])
}
fn churn() I64 {
    s I64 = 0
    for j in range 20 {
        t := Array<I64>(30000, j)
        s = s + t[5]
    }
    return s
}
fn main() ? {
    k := K(7)
    x := churn()
    if k.view[1] != 8 or k.w[1] != 8 or k.c[1] != 8 or k.h.a[1] != 8 or x != 190 { fail }
}
