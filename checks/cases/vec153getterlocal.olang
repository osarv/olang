# check: fail note: this object is reached through a call's result, a borrow of an owned object whose region is not known here
# vec7 F2 through a local holding the getter's result
import "std/io"
type Lexer struct() {
    toks Vec<String&> = Vec<String&>()
}
type Parser struct() {
    lx own mut Lexer& = null
}
fn (p mut Parser&) Lx() mut Lexer&p { return p.lx }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
G Vec<String&> = Vec<String&>()
fn main() ? {
    p := Parser()
    p.lx = Lexer()
    for i in range 3 { p.lx.toks.Push($i "-word-built-in-the-lexer's-region") }
    q := p.Lx()
    d := Parser()
    d.lx = Lexer()
    d.lx.toks = take q.toks
    p.lx = null
    churn()
    try io.Println(d.lx.toks[0])
}
