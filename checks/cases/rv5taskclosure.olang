# check: run
# flags: -d -s
# P2 (review of rv3fix, #2): a closure made in a task capturing a stand-in, kept past the join, allocates through it once folded
type Node struct(v I64) {
    v
    next mut Node& = null
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn work(n mut Node&, fns mut List<fn() I64>&) {
    fns.Push(fn() I64 {
        n.next = Node(n.v + 41)
        return n.next.v
    })
}
fn main() ? {
    n mut Node& = Node(1)
    fns mut List<fn() I64>& = List<fn() I64>()
    join {
        spawn work(n, fns)
    }
    churn()
    f := fns[0]
    if f() != 42 { fail }
    churn()
    if n.next.v != 42 { fail }
}
