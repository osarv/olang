# check: fail error[T13c]: 'h.lanes' is a field of a packed struct,
# T13c: a walk of an array field reads it through a reference - its copy is written, "lanes := h.lanes"
type H packed struct(k U8) {
    k
    lanes := Array<U3>(4)
}
fn main() {
    h := H(1)
    n := 0
    for x in h.lanes { n += I64(x) }
    assert n == 0
}
