# check: fail x[i] gives a copy, and the call can build into what it holds where the copy is
# E31b/O17: a "mut" method called on x[i] - an element that is no handle. Tag writes nothing of the copy's own
# storage (it pushes through the List the element holds), so the copy is lent with nothing written back - but it builds
# the text where the copy is, the statement's block, not where the collection's list lives (O17's split value)
type Rec struct(name String&) {
    name
    tags List<String&> = List<String&>()
}
fn (r mut Rec&) Tag(t String&) { r.tags.Push(t) }

fn main() ? {
    l := List<Rec>()
    l.Push(Rec("a"))
    for k in range 3 { l[0].Tag("lit") }
}
