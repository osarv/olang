# check: run
# E31b/O17: a "mut" method called on x[i] - an element that is no handle - its other argument a plain value: made on the
# element in place, through the Vec's RefMut, so what Tag builds lands where the element lives and every push is the
# element's (it was refused while the call was the copy's: the copy built where the statement's block is, O17)
type Rec struct(name String&) {
    name
    tags Vec<String&> = Vec<String&>()
}
fn (r mut Rec&) Tag(t String&) { r.tags.Push(t) }

fn main() ? {
    l := Vec<Rec>()
    l.Push(Rec("a"))
    for _ in range 3 { l[0].Tag("lit") }
    assert l[0].tags.Len() == 3 and l[0].tags[2] == "lit"
}
