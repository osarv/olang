# check: fail error[O38]: this argument borrows an own object, and the callee may keep it beyond the call
# O38: ...into another argument's field (own5 F1)
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
type W struct(o Outer&) {
    f Outer&o = o
}
type Big struct() {
    x Outer& = null
}
fn setBig(g mut Big&, w W&) { g.x = w.f }
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v
    g := Big()
    w := W(b)
    setBig(g, w)
    v.o = null
    println($g.x.o.k)
}
