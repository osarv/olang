# check: run
# QCB: refused while scopes were written; inferred, each value is built where it is kept (O28), and the
# program runs - read after what it was built in closes, as the description below says it would be
# O23/O11: a '&of' field reached through a field of a parameter - its binding is the inner instance's, which nothing in
# setDeep can see, so the store is unverifiable
type N struct(v I32) {
    v
}
type Cur struct(of mut N&) {
    at mut N& = of
}
type Outer struct(c mut Cur&) {
    c
}
fn setDeep(o mut Outer&, x mut N&) { o.c.at = x }
fn main() ? {
    outer mut N& = N(1)
    x mut N& = N(42)
    c := Cur(outer)
    o := Outer(c)
    setDeep(o, x)
}
