# check: run
# Vec phase 2a (O32/O39): a copy of a struct holding a Vec is a borrowed copy - a loan on its buffer - so the original's
# M19g, round 2 (brought back): a copy is a second name and an iterator reads the Vec each step - no view is stale
# Vec does not grow while the copy is used
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn main() ? {
    l := Lexer(3)
    for i in range 3 { l.toks.Push(i) }
    c := l
    l.toks.Push(9)
    try io.Println($c.toks[0])
}
