# check: run
# a copy of a struct holding a Vec is a second name for the Vec, which grows while the copy is used
# M19g, round 2 (brought back): a copy is a second name and an iterator reads the Vec each step - no view is stale
import "std/io"
type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn main() ? {
    l := Lexer(3)
    for i in range 3 { l.toks.Push(i) }
    c := l
    l.toks.Push(9)
    try io.Println($c.toks[0])
}
