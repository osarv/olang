# check: fail error[C2d]: this builds through a '&p' field whose scope is not known here
# C2d/O23a (review of rv3fix, #7): a reference read through a '&p' field passed to a by-value parameter the callee builds through
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() { head mut Node& = Node(1) }
type Holder struct(p mut Box&) {
    b mut Box&p = p
}
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
    }
    return t
}
fn growv(b Box) { b.head.next = Node(44) }
fn f(h Holder&) { growv(h.b) }
fn rd(n Node&) I64 {
    if n.next == null { return 0 }
    return n.next.v
}
fn main() ? {
    outer mut Box& = Box()
    k := outer.head
    {
        h := Holder(outer)
        f(h)
    }
    churn()
    println($rd(k))
}
