# check: fail error[S8d]: Shape is an enum - its payload's 'r' is read where a test narrows
# S8d: a narrowing holds until a statement assigns the local - read before it, not after
type Shape enum { Dot, Ring(r I64) }
fn main() {
    s := Shape.Ring(2)
    if s == Shape.Ring {
        t := s.r
        s = Shape.Dot
        assert t + s.r == 4
    }
}
