# check: fail error[E11c, O12]: '$' does not say where a value it renders lives, so Str builds and stores nothing where its receiver reaches
# E11c/O12: a Str whose result borrows from its receiver gives a conditional of the receiver's text and a literal: refused
type Node struct(v I64, next mut Node&) {
    v
    next
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type Bag struct(head mut Node&, name String&, k I64) {
    head
    name
    k
}
fn (b Bag&) Str() String&b {
    return b.name if b.k == 0 else "lit"
}
fn main() ? {
    b := Bag(Node(4, null), "bag", 1)
    s := $b
    churn()
    println(s)
}
