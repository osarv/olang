# check: fail error[O41]: a task's call may not own a parameter or give an owned result yet
# a task cannot be handed an owner yet
type Sock struct(n I64) {
    n
}
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
    sock own mut Sock&
}
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn consume(c own mut Conn&) { }
fn main() ? {
    x own mut Conn& = Conn(1)
    join { spawn consume(take x) }
}
