# spec: generic Stack<T> with Push/Pop/Peek, generic largest(), generic swap pair, Stack<String> and Stack<I64>
type Stack<T> struct() {
    items Vec<T> = Vec<T>[]
}

fn (s mut Stack<T>&) Push(x T) { s.items.Push(x) }
fn (s mut Stack<T>&) Pop() T ? StackEmpty { return try s.items.Pop() catch { error StackEmpty } }
fn (s Stack<T>&) Peek() T ? StackEmpty { return try s.items.Last() catch { error StackEmpty } }

fn largest<T>(xs Array<T>&) T {
    best := xs[0]
    for x in xs {
        if best < x: best = x
    }
    return best
}

fn swap<A, B>(a A, b B) B, A { return b, a }

fn main() {
    s := Stack<I64>()
    s.Push(1)
    s.Push(2)
    Println($s.Pop()!)
    Println($s.Peek()!)
    t := Stack<String>()
    t.Push("a")
    Println($t.Pop()!)
    Println($largest([3, 9, 2]) + " " + $largest(["x", "abc"]))
    p, q := swap(1, "one")
    Println($p + " " + $q)
    e := Array<I64>(0)
    Println($largest(e))
}
