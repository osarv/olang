# spec: sum 1..N in parallel with 4 tasks, each summing a quarter into its own slot, then add; compare with serial
fn partSum(lo I64, hi I64) I64 {
    s := 0
    for i in range lo, hi { s += i }
    return s
}

fn main() {
    n := 1000
    parts := Array<I64>(4)
    join {
        for k in range 4 {
            spawn parts[k] = partSum(k * n / 4, (k + 1) * n / 4)
        }
    }
    Println($parts.Sum() " " $partSum(0, n))
}
