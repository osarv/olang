# spec: 0/1 knapsack by dynamic programming over weights and values; print max value and chosen items
fn knap(w Array<I64>&, v Array<I64>&, cap I64) I64, Vec<I64> {
    n := w.Len()
    dp := Array<I64>((n + 1) * (cap + 1))
    for i in range 1, n + 1 {
        for c in range cap + 1 {
            dp[i * (cap + 1) + c] = dp[(i - 1) * (cap + 1) + c]
            if c >= w[i - 1] {
                alt := dp[(i - 1) * (cap + 1) + c - w[i - 1]] + v[i - 1]
                if alt > dp[i * (cap + 1) + c] { dp[i * (cap + 1) + c] = alt }
            }
        }
    }
    chosen := Vec<I64>[]
    c := cap
    for k in range n {
        i := n - k
        if dp[i * (cap + 1) + c] != dp[(i - 1) * (cap + 1) + c] {
            chosen.Push(i - 1)
            c -= w[i - 1]
        }
    }
    return dp[n * (cap + 1) + cap], chosen
}

fn main() {
    best, items := knap([1, 3, 4, 5], [1, 4, 5, 7], 7)
    Println($best " " $items)
    b2, i2 := knap([2], [3], 1)
    Println($b2 " " $i2)
}
