# spec: Conway's game of life on a 6x6 torus-less grid, run a blinker and a glider for a few steps, print grid
fn step(g Array<Bool>&, n I64) Array<Bool> {
    out := Array<Bool>(n * n)
    for y in range n {
        for x in range n {
            c := 0
            for dy in range -1, 2 {
                for dx in range -1, 2 {
                    if dx == 0 and dy == 0: continue
                    if g[(y + dy) * n + x + dx]: c++
                }
            }
            alive := g[y * n + x]
            out[y * n + x] = (c == 3) or (alive and c == 2)
        }
    }
    return out
}

fn show(g Array<Bool>&, n I64) {
    for y in range n {
        sb := StringBuilder()
        for x in range n { sb.PushChar('#' if g[y * n + x] else '.') }
        Println(sb.ToString())
    }
    Println("")
}

fn main() {
    n := 6
    g := Array<Bool>(n * n)
    g[2 * n + 1] = true
    g[2 * n + 2] = true
    g[2 * n + 3] = true
    show(g, n)
    g = step(g, n)
    show(g, n)
}
