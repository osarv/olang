# spec: unweighted graph from edge list, BFS shortest path length from a source to every node
import "std/deque"
fn main() {
    edges := [[0, 1], [0, 2], [1, 3], [2, 3], [3, 4], [5, 6]]
    n := 7
    adj := Array<Vec<I64>>(n)
    for e in edges {
        adj[e[0]].Push(e[1])
        adj[e[1]].Push(e[0])
    }
    dist := Array<I64>(n)
    for i in range n { dist[i] = -1 }
    q := deque.Deque<I64>[]
    dist[0] = 0
    q.PushBack(0)
    for q.Len() > 0 {
        u := q.PopFront()!
        for v in adj[u] {
            if dist[v] < 0 {
                dist[v] = dist[u] + 1
                q.PushBack(v)
            }
        }
    }
    Println($dist)
}
