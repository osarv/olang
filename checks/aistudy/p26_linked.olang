# spec: singly linked list as recursive enum: push front, length, sum, reverse, nth element
type List enum {
    Nil
    Cons(head I64, tail List&)
}

fn push(l List&, x I64) List { return List.Cons(x, l) }

fn length(l List&) I64 {
    n := 0
    cur := l
    for cur == List.Cons {
        n++
        cur = cur.tail
    }
    return n
}

fn reverse(l List&) List {
    acc := List.Nil
    cur := l
    for cur == List.Cons {
        acc = List.Cons(cur.head, acc)
        cur = cur.tail
    }
    return acc
}

fn nth(l List&, n I64) I64 {
    cur := l
    for _ in range n {
        if cur == List.Cons: cur = cur.tail
    }
    if cur == List.Cons: return cur.head
    return 0
}

fn main() {
    l := List.Nil
    for i in range 5: l = push(l, i * i)
    r := reverse(l)
    Println($length(l) + " " + $nth(r, 2) + " " + $nth(r, 4))
    Println($nth(r, 9))
}
