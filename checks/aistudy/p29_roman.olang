# spec: convert integers 1..3999 to roman numerals and parse roman numerals back
fn toRoman(n I64) String {
    vals := [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    syms := ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    sb := StringBuilder()
    m := n
    for i in range vals.Len() {
        for m >= vals[i] {
            sb.Push(syms[i])
            m -= vals[i]
        }
    }
    return sb.ToString()
}

fn value(c Char) I64 {
    match c {
        case 'I': return 1
        case 'V': return 5
        case 'X': return 10
        case 'L': return 50
        case 'C': return 100
        case 'D': return 500
        case 'M': return 1000
        case _: return 0
    }
}

fn fromRoman(s String&) I64 {
    total := 0
    for i in range s.Len() {
        v := value(s[i])
        if i + 1 < s.Len() and v < value(s[i + 1]) { total -= v } else { total += v }
    }
    return total
}

fn main() {
    for n in [1, 4, 9, 14, 40, 90, 400, 1994, 3999] {
        r := toRoman(n)
        Println($n " " $r " " $fromRoman(r))
    }
    Println($toRoman(0) "|" $toRoman(-5) "|" $fromRoman("ABC"))
}
