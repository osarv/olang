# spec: Levenshtein edit distance and longest common subsequence length between two strings with DP tables
fn editDistance(a String&, b String&) I64 {
    m := a.Len()
    n := b.Len()
    d := Array<I64>((m + 1) * (n + 1))
    for i in range m + 1 { d[i * (n + 1)] = i }
    for j in range n + 1 { d[j] = j }
    for i in range 1, m + 1 {
        for j in range 1, n + 1 {
            cost := 0 if a[i - 1] == b[j - 1] else 1
            d[i * (n + 1) + j] = (d[(i - 1) * (n + 1) + j] + 1).Min(d[i * (n + 1) + j - 1] + 1).Min(d[(i - 1) * (n + 1) + j - 1] + cost)
        }
    }
    return d[m * (n + 1) + n]
}

fn lcs(a String&, b String&) I64 {
    prev := Array<I64>(b.Len() + 1)
    for i in range a.Len() {
        cur := Array<I64>(b.Len() + 1)
        for j in range b.Len() {
            if a[i] == b[j] { cur[j + 1] = prev[j] + 1 } else { cur[j + 1] = cur[j].Max(prev[j + 1]) }
        }
        prev = cur
    }
    return prev[b.Len()]
}

fn main() {
    Println($editDistance("kitten", "sitting") " " $editDistance("", "abc") " " $editDistance("same", "same"))
    Println($lcs("ABCBDAB", "BDCABA") " " $lcs("", "x"))
}
