# spec: count word frequencies in a text, print the top 3 by count then alphabetically
fn main() {
    text := "the cat and the dog and the bird saw a cat"
    counts := Map<String, I64>[]
    for w in text.Split(" ") {
        counts.Update(w, 0, fn(v): return v + 1)
    }
    keys := Vec<String>[]
    for e in counts { keys.Push(e.Key) }
    keys.Sort(fn(a, b): return (counts.Get(a)! > counts.Get(b)!) or (counts.Get(a)! == counts.Get(b)! and a < b))
    for i in range 3 {
        Println($keys[i] " " $counts.Get(keys[i])!)
    }
}
