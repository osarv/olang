# spec: task scheduler: tasks have priority and name; pop in priority order (higher first), ties by insertion order
import "std/heap"

type Task struct(name String, prio I64, seq I64) { name, prio, seq }

fn before(a Task, b Task) Bool {
    if a.prio != b.prio: return a.prio > b.prio
    return a.seq < b.seq
}

fn main() {
    h := heap.Heap<Task>(before)
    seq := 0
    for t in [["write", "2"], ["test", "5"], ["ship", "5"], ["rest", "1"]] {
        h.Push(Task(t[0], t[1].ParseInt()!, seq))
        seq++
    }
    for h.Len() > 0: Println($h.Pop()!.name)
    Println($h.Pop()!.name)
}
