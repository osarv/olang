# spec: caesar cipher shift (wrapping a-z A-Z, other chars untouched), palindrome check ignoring case and spaces, anagram check
fn shift(s String&, k I64) String {
    out := Array<Char>(s.Len())
    for i in range s.Len() {
        c := s[i]
        if c.IsLower() {
            out[i] = Char((I64(c) - 97 + k) % 26 + 97)
        } else if c.IsUpper() {
            out[i] = Char((I64(c) - 65 + k) % 26 + 65)
        } else {
            out[i] = c
        }
    }
    return String(out)
}

fn isPalindrome(s String&) Bool {
    t := Vec<Char>[]
    for c in s {
        if c != ' ' { t.Push(c.ToLower()) }
    }
    for i in range t.Len() / 2 {
        if t[i] != t[t.Len() - 1 - i] { return false }
    }
    return true
}

fn anagram(a String&, b String&) Bool {
    count := Array<I64>(26)
    for c in a.ToLower() { count[I64(c) - 97] += 1 }
    for c in b.ToLower() { count[I64(c) - 97] -= 1 }
    return count.Every(fn(n): return n == 0)
}

fn main() {
    e := shift("Hello, World", 3)
    Println($e " " $shift(e, 23))
    Println($shift("abc", -1))
    Println($isPalindrome("A man a plan a canal Panama") " " $isPalindrome("abc"))
    Println($anagram("Listen", "Silent") " " $anagram("ab", "a b"))
}
