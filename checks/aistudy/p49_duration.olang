# spec: format seconds as H:MM:SS, parse "H:MM:SS" back, add durations modulo 24h clock time
fn fmt(secs I64) String {
    h := secs / 3600
    m := secs % 3600 / 60
    s := secs % 60
    return $h + ":" + $m.PadStart(2, '0') + ":" + $s.PadStart(2, '0')
}

fn parse(t String&) I64 ? ParseError {
    p := t.Split(":")
    return try p[0].ParseInt() * 3600 + p[1].ParseInt() * 60 + p[2].ParseInt()
}

fn clock(secs I64) String { return fmt(secs % 86400) }

fn main() {
    Println($fmt(3725) + " " + $fmt(59) + " " + $fmt(86400))
    Println($parse("1:02:05")!)
    Println($clock(parse("23:30:00")! + 3600))
    Println($clock(-60))
    Println($parse("12:30")!)
}
