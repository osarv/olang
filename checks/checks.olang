                 "a call of At", dir)
}

# B3: every module sees the prelude, so a prelude file edited since an object was built makes that object stale -
# the root's above all, which holds the instantiations of the prelude's generics (B3d). It used to be reused, so a
# program kept running the prelude it was first built with. A copy of std, so the real one is never touched.
test "editing the prelude rebuilds what uses it" { assert passed("preludestale") }

fn preludestale(r mut report&) ? Failed {
    dir := fresh("preludestale")
    os.Run("cp checks/fixtures/preludestale/* " $os.Quote(dir) " && cp -r std " $os.Quote($dir "/std"))
    probe String& = "fn (p Pair<<A>, <B>>) Probe() A { return p.First }"
    try r.expect(sh(dir, "echo " $os.Quote(probe) " >> std/prelude/pair.olang") == 0, "adding Probe", dir)
    try r.expect(sh(dir, "OLANG_STD=std \"$OLANG\" -b probe.olang > out.txt 2>&1 && ./build/probe > got.txt") == 0,
                 "first build", dir)
    try r.expect(sh(dir, "grep -qx 3 got.txt") == 0, "first build output", dir)
    try r.expect(sh(dir, "sed -i 's/return p.First }/return p.Second }/' std/prelude/pair.olang") == 0,
                 "editing Probe", dir)
    try r.expect(sh(dir, "OLANG_STD=std \"$OLANG\" -b probe.olang > out.txt 2>&1 && ./build/probe > got.txt") == 0,
                 "second build", dir)
    try r.expect(sh(dir, "grep -qx 4 got.txt") == 0, "the edited prelude was not used", dir)
}

# a program written by the check itself: n levels of open, then the middle, then n levels of close
fn nested(head String&, open String&, middle String&, close String&, tail String&, n I64) String& {
    b := StringBuilder()
    b.Push(head)
    for i in range n { b.Push(open) }
    b.Push(middle)
    for i in range n { b.Push(close) }
    b.Push(tail)
    return b.ToString()
}

# several statement forms begin with an expression and only what follows tells them apart, so each read it - and every
# lambda and catch block inside - again: 3^depth readings, a depth of 10 taking seconds and 12 running out of memory.
# The parse is remembered by position now, so forty levels of each are read once - interpreted (-i), with no native
# build to wait for, and under a timeout that the old parser would have run far past
test "nested lambdas and try-catch statements parse in time linear in their depth" { assert passed("nestparse") }

fn nestparse(r mut report&) ? Failed {
    dir := fresh("nestparse")
    lambdas String& = nested("fn k() { }\nfn f(g fn()) { g() }\nfn main() ? {\n    ", "f(fn() { ", "k()", " })", "\n}\n", 40)
    try os.WriteFile($dir "/lambdas.olang", lambdas) catch { }
    try r.expect(sh(dir, "timeout 60 \"$OLANG\" -i lambdas.olang > out.txt 2>&1") == 0, "nested lambdas", dir)
    tries String& = nested("error E { X }\nfn k() { }\nfn g() ? E { error E.X }\nfn main() ? {\n    ",
                           "try g() catch E { ", "k()", " }", "\n}\n", 40)
    try os.WriteFile($dir "/tries.olang", tries) catch { }
    try r.expect(sh(dir, "timeout 60 \"$OLANG\" -i tries.olang > out.txt 2>&1") == 0, "nested try-catch", dir)
}

# every pass recurses once per level of nesting, so a program nested past what the compiler's stack holds is refused by
# the parser - one diagnostic - where it crashed the checker at about 2,000 parentheses. 5,000 is well within it
test "nesting is bounded with a diagnostic, never a crash" { assert passed("nestdeep") }

fn nestdeep(r mut report&) ? Failed {
    dir := fresh("nestdeep")
    ok String& = nested("fn main() ? {\n    x := ", "(", "1", ")", "\n    assert x == 1\n}\n", 5000)
    try os.WriteFile($dir "/ok.olang", ok) catch { }
    try r.expect(sh(dir, "\"$OLANG\" -i ok.olang > out.txt 2>&1") == 0, "5000 parentheses", dir)
    deep String& = nested("fn main() ? {\n    x := ", "(", "1", ")", "\n}\n", 25000)
    try os.WriteFile($dir "/deep.olang", deep) catch { }
    try r.expect(sh(dir, "\"$OLANG\" -c deep.olang > out.txt 2>&1") != 0, "25000 parentheses compiled", dir)
    try r.expect(outOf(dir).Contains("error[L21]: nested more than 20000 levels deep"), "25000 parentheses", dir)
    try r.expect(outOf(dir).Contains("compilation failed with 1 error"), "25000 parentheses, one error", dir)
}

# B9a/S8b: a module of many local ifs - each condition used to look its names up by reading the whole file again, and
# then by walking the whole function for the locals it reads, each once per condition
test "a function of many local ifs compiles in time linear in their number" { assert passed("manyifs") }

fn manyifs(r mut report&) ? Failed {
    dir := fresh("manyifs")
    many String& = nested("fn g(x I32) I32 { return x }\nfn f(x I32) I32 {\n    s := 0\n",
                          "    if g(x) > 5 { s += 1 }\n", "", "", "    return s\n}\nfn main() ? { assert f(9) == 20000 }\n", 20000)
    try os.WriteFile($dir "/many.olang", many) catch { }
    try r.expect(sh(dir, "timeout 60 \"$OLANG\" -i many.olang > out.txt 2>&1") == 0, "20000 local ifs", dir)
}

# a review of the code generator (2026-10-09): what only a whole build shows. A block inside a match value has an
# arena (a loop leaking into the function's scope would fail under the memory cap); an array length out of range
# aborts with its message; a declaration adopts the array made for it; a big struct compiles in seconds (it took
# minutes); a BF16 survives -d; and the helpers rendering tuples are named the same in every build
test "the code generator's review fixes, as whole builds" { assert passed("cgreview") }

fn cgreview(r mut report&) ? Failed {
    dir := fresh("cgreview")
    os.Run("cp checks/fixtures/cgreview/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b matcharena.olang > out.txt 2>&1") == 0, "matcharena build", dir)
    try r.expect(sh(dir, "(ulimit -v 400000 && ./build/matcharena a b c d e) > out.txt 2>&1") == 0, "matcharena", dir)
    try r.expect(outOf(dir) == "30600000\n", "matcharena output", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b arraylen.olang > out.txt 2>&1") == 0, "arraylen build", dir)
    try r.expect(sh(dir, "./build/arraylen > out.txt 2>&1") != 0, "arraylen ran cleanly", dir)
    try r.expect(outOf(dir).Contains("array length out of range"), "arraylen output", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b adopt.olang > out.txt 2>&1 && ./build/adopt > out.txt") == 0, "adopt", dir)
    try r.expect(sh(dir, "awk '/^define.*@adopt_main/,/^}/' build/adopt.main.ll | grep -q arrcopy") != 0,
                 "adopt copied", dir)
    try r.expect(sh(dir, "timeout 60 \"$OLANG\" -b big.olang > out.txt 2>&1 && ./build/big > out.txt") == 0, "big", dir)
    try r.expect(outOf(dir) == "4\n", "big output", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b -d bf16.olang > out.txt 2>&1 && ./build/bf16.debug > out.txt") == 0,
                 "bf16", dir)
    try r.expect(outOf(dir) == "0.5 4 5\n", "bf16 output", dir)
    names String& = "grep -o '@olang.rd.[A-Za-z0-9._$]*' build/tuples.main.ll | sort -u"
    try r.expect(sh(dir, "\"$OLANG\" -b tuples.olang > out.txt 2>&1 && " $names " > first.txt") == 0, "tuples", dir)
    try r.expect(sh(dir, "rm -rf build && \"$OLANG\" -b tuples.olang > out.txt 2>&1 && " $names " | cmp -s first.txt -") == 0,
                 "the tuple helpers were named differently", dir)
    try r.expect(sh(dir, "./build/tuples > out.txt") == 0 and outOf(dir) == "(1, \"x\") (2, 3, 0.5)\n",
                 "tuples output", dir)
}

# a review of the type checker (2026-10-09): what only several modules show. A case named after "is", "as" or in a
# pattern is resolved through its alias chain and is the case of that module's own enum, visible from here; and a
# name refused across the boundary - a private case, error word, method or type, an alias reused by a lambda - is one
# error, not the start of several
test "the type checker's review fixes, across modules" { assert passed("typereview") }

# prog.olang must not build, with exactly one error: one saying "want"
fn oneError(r mut report&, dir String&, prog String&, want String&) ? Failed {
    try r.expect(sh(dir, "\"$OLANG\" -b " $prog ".olang > out.txt 2>&1") != 0, $prog " compiled", dir)
    out := outOf(dir)
    try r.expect(out.Contains(want) and out.Contains("compilation failed with 1 error\n"), $prog ": expected one '" $want "'", dir)
}

fn typereview(r mut report&) ? Failed {
    dir := fresh("typereview")
    os.Run("cp -r checks/fixtures/cases/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b good.olang > out.txt 2>&1 && ./build/good > out.txt") == 0, "good", dir)
    try r.expect(outOf(dir) == "14 1 3 true 4\n", "good output", dir)
    try oneError(r, dir, "isother", "after 'is' or 'as' comes a case of")
    try oneError(r, dir, "matchother", "a pattern here names a case of")
    try oneError(r, dir, "isprivate", "error[M6a]: case")
    try oneError(r, dir, "matchprivate", "error[M6a]: case")
    try oneError(r, dir, "isnoalias", "unknown name 'nosuchalias'")    # E10c: naming no type, it is a value
    try oneError(r, dir, "privcase", "error[M6a]: case")
    try oneError(r, dir, "privword", "error[M6a]: error word")
    try oneError(r, dir, "privmethod", "error[M6]: method")
    try oneError(r, dir, "privtype", "error[M6]: type")
    try oneError(r, dir, "lambdaalias", "is an import's alias in this module")
}

# K1/K2b/B5a and the review of the evaluator (2026-10-09): what compile-time evaluation, the built program at -O3 and at
# -O0, and -i must agree on - each program printed once by each, all three the same and right - and the data baked
# globals are written out as: one instance where two globals name one, a slice as a place in its base's data, and what a
# writable reference reaches never read-only
test "the evaluator, the run time and -i agree" { assert passed("agree") }

fn agree(r mut report&) ? Failed {
    dir := fresh("agree")
    os.Run("cp checks/fixtures/agree/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b agree.olang > out.txt 2>&1 && ./build/agree > b.txt 2>&1") == 0, "agree", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b -d agree.olang > out.txt 2>&1 && ./build/agree.debug > d.txt 2>&1") == 0, "agree -d", dir)
    try r.expect(sh(dir, "\"$OLANG\" -i agree.olang > i.txt 2>&1") == 0, "agree -i", dir)
    try r.expect(sh(dir, "cmp -s agree.want b.txt && cmp -s b.txt d.txt && cmp -s b.txt i.txt") == 0, "agree output", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b bfrand.olang > out.txt 2>&1 && ./build/bfrand > b.txt 2>&1") == 0, "bfrand", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b -d bfrand.olang > out.txt 2>&1 && ./build/bfrand.debug > d.txt 2>&1") == 0,
                 "bfrand -d", dir)
    try r.expect(sh(dir, "\"$OLANG\" -i bfrand.olang > i.txt 2>&1") == 0, "bfrand -i", dir)
    try r.expect(sh(dir, "cmp -s b.txt d.txt && cmp -s b.txt i.txt") == 0, "bfrand output", dir)
    # X8: the C math library's functions, computed while compiling, by the run time at -O3 and -O0, and under -i
    try r.expect(sh(dir, "\"$OLANG\" -b math.olang > out.txt 2>&1 && ./build/math > b.txt 2>&1") == 0, "math", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b -d math.olang > out.txt 2>&1 && ./build/math.debug > d.txt 2>&1") == 0, "math -d", dir)
    try r.expect(sh(dir, "\"$OLANG\" -i math.olang > i.txt 2>&1") == 0, "math -i", dir)
    try r.expect(sh(dir, "test $(wc -l < b.txt) = 12 && cmp -s b.txt d.txt && cmp -s b.txt i.txt") == 0, "math output", dir)
    mll String& = " build/math.main.ll"
    try r.expect(sh(dir, "grep -q '^@math_SqrtTwo = constant double 0x3FF6A09E667F3BCD$'" $mll) == 0, "math baked", dir)
    try r.expect(sh(dir, "grep -q '^declare double @sqrt(double) memory(none) nounwind willreturn$'" $mll) == 0, "math exact", dir)
    try r.expect(sh(dir, "grep -q '^declare double @exp(double) nobuiltin '" $mll) == 0, "math inexact", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b r17.olang > out.txt 2>&1") == 0, "r17", dir)
    try r.expect(sh(dir, "./build/r17 > b.txt 2>&1") == 1 and sh(dir, "\"$OLANG\" -i r17.olang > i.txt 2>&1") == 1,
                 "r17 did not end in its error, built and interpreted", dir)
    try r.expect(sh(dir, "printf 'before\\nunhandled error\\n' | cmp -s - b.txt && cmp -s b.txt i.txt") == 0, "r17 output", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b share.olang > out.txt 2>&1 && ./build/share") == 0, "share", dir)
    ll String& = " build/share.main.ll"
    try r.expect(sh(dir, "grep -q '^@share_B = constant ptr @share_A.k[0-9]*$'" $ll) == 0, "share_B", dir)
    try r.expect(sh(dir, "grep -q '^@share_H.k[0-9]* = internal global .2 x i32.'" $ll) == 0, "share_H.k", dir)
    try r.expect(sh(dir, "grep -q '^@share_Sl = constant { i64, ptr } { i64 2, ptr getelementptr inbounds (.4 x i32., ptr @share_Arr.k[0-9]*, i64 0, i64 1) }'" $ll) == 0,
                 "share_Sl", dir)
}

# B11: what the diagnostics are held to. Every call passes as many arguments as its message's directives take - a wrong
# count is undefined behaviour in C's varargs, which nothing else would catch - and every rule a diagnostic names is one
# the specification states, so "olang -e RULE" finds it

# the index of the quote closing the C string or character literal whose opening quote is at open
fn cLiteralEnd(t String&, open I64) I64 {
    i I64 = open + 1
    for i < t.Len() {
        if t[i] == '\\' {
            i = i + 2
        } else if t[i] == t[open] {
            return i
        } else {
            i++
        }
    }
    return t.Len()
}

# how many arguments a message takes: its %-directives, "%%" aside
fn directiveCount(fmt String&) I64 {
    n := 0
    i := 0
    for i < fmt.Len() - 1 {
        if fmt[i] == '%' {
            if fmt[i + 1] != '%' { n++ }
            i = i + 2
        } else {
            i++
        }
    }
    return n
}

fn isIdentChar(c Char) Bool { return c.IsLetter() or c.IsDigit() or c == '_' }

# the call whose "(" is at open: where its diagnostic id is (start and end; -1 when no argument is one) and how many
# arguments follow it - read past nested brackets and C string and character literals
fn callShape(t String&, open I64) (I64, I64, I64) {
    idStart, idEnd, after := I64(-1), I64(-1), I64(0)
    depth := 0
    argStart I64 = open + 1
    i I64 = open + 1
    for i < t.Len() {
        c := t[i]
        if c == '"' or c == '\'' {
            i = cLiteralEnd(t, i) + 1
            continue
        }
        closes Bool = (c == ')' or c == ']' or c == '}') and depth == 0
        if closes or (c == ',' and depth == 0) {
            s, e := argStart, i
            for s < e and t[s].IsSpace() { s++ }
            for e > s and t[e - 1].IsSpace() { e-- }
            if idStart >= 0 {
                if e > s { after++ }
            } else if t[s:e].StartsWith("ERR_") or t[s:e].StartsWith("NOTE_") {
                whole := true
                for k in range s, e { whole = whole and isIdentChar(t[k]) }
                if whole { idStart, idEnd = s, e }
            }
            argStart = i + 1
            if closes { break }
        } else if c == '(' or c == '[' or c == '{' {
            depth++
        } else if c == ')' or c == ']' or c == '}' {
            depth--
        }
        i++
    }
    return idStart, idEnd, after
}

# the C string literal starting at the first quote at or after from, and where it ends
fn literalAfter(t String&, from I64) (I64, I64) {
    open I64 = from + (try t[from:].FindByte('"') catch default -1)
    return open + 1, cLiteralEnd(t, open)
}

# std/linalg: a shape that does not fit aborts as a failed assert does - built and interpreted - and is
# ShapeError.MISMATCH under try
test "a matrix shape that does not fit aborts, or is an error under try" { assert passed("linalg") }

fn linalg(r mut report&) ? Failed {
    dir := fresh("linalg")
    os.Run("cp checks/fixtures/linalg/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b shapes.olang > out.txt 2>&1") == 0, "shapes.olang did not build", dir)
    for which in String&["add", "matmul", "gemm"] {
        try r.expect(sh(dir, "./build/shapes " $which " > out.txt 2>&1") == 134, $which " did not abort", dir)
        out := outOf(dir)
        try r.expect(out.Contains("assertion failed") and not out.Contains("not reached"), $which " printed", dir)
    }
    try r.expect(sh(dir, "./build/shapes caught > out.txt 2>&1") == 0 and outOf(dir) == "caught\n", "caught", dir)
    try r.expect(sh(dir, "\"$OLANG\" -i shapes.olang gemm > out.txt 2>&1") == 134, "-i gemm did not abort", dir)
}

# O8b: the arena's pool is bounded, and gives the least recently given back chunks to the system beyond the bound -
# run with sysconf answering a machine of 8MB (a preloaded sysconf.c), so the bound is 1MB and a 16MB phase is far past
# it; so is the pool every thread shares, which parked workers fill. (That the pool finds any chunk big enough is a
# case, checks/cases/chunkpool.olang, and that a parked worker's chunks reach another thread checks/cases/parkedpool)
test "the arena's chunk pool gives memory back beyond its bound" { assert passed("chunkpool") }

fn chunkpool(r mut report&) ? Failed {
    dir := fresh("chunkpool")
    os.Run("cp checks/fixtures/chunkpool/* " $os.Quote(dir))
    try r.expect(sh(dir, "clang -shared -fPIC -o sysconf.so sysconf.c -ldl > out.txt 2>&1") == 0, "sysconf.so", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b budget.olang > out.txt 2>&1") == 0, "budget.olang did not build", dir)
    try r.expect(sh(dir, "LD_PRELOAD=./sysconf.so ./build/budget > out.txt 2>&1") == 0, "budget", dir)
}

# B12: a build is for this machine unless -a names another target - its vectors and FMA where it has them, none of
# them at baseline x86-64 - with the build constants following -a, objects of their own for each target (B12b), and
# the same results everywhere (B12c): what the loops computed is one line, built, interpreted, at every target
test "a build is for this machine unless -a names another target" { assert passed("target") }

fn target(r mut report&) ? Failed {
    dir := fresh("target")
    os.Run("cp checks/fixtures/target/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b loop.olang > out.txt 2>&1 && ./build/loop > native.txt") == 0, "native", dir)
    try r.expect(sh(dir, "stat -c '%n %.9Y' build/*.o | grep -v olang_build | sort > objects.txt") == 0, "objects", dir)
    native := try os.ReadFile($dir "/native.txt") catch default ""
    nl := try native.FindByte('\n') catch default -1
    try r.expect(nl > 0, "native printed " $native, dir)
    first := native[:nl]
    results := native[nl + 1:]
    # this machine's vectors, when it has wider ones than SSE's, and its FMA instruction for math.Fma, not a call
    if not first.EndsWith(" 128 false") {
        try r.expect(sh(dir, "objdump -d build/loop | grep -qE 'ymm|zmm'") == 0, "no wide vectors in " $first, dir)
    }
    if first.EndsWith(" true") {
        try r.expect(sh(dir, "objdump -d build/loop | grep -q vfmadd") == 0, "no FMA instruction in " $first, dir)
        try r.expect(sh(dir, "objdump -d build/loop | grep -qE 'call.*<fmaf?@plt>'") != 0, "an fma call in " $first, dir)
    }
    if TargetArch != "x86_64" { return }
    # baseline x86-64: SSE2's vectors only, fma the C library's function - and the same results
    try r.expect(sh(dir, "\"$OLANG\" -a x86-64 -b loop.olang > out.txt 2>&1 && ./build/loop > base.txt") == 0, "x86-64", dir)
    try r.expect((try os.ReadFile($dir "/base.txt") catch default "") == "x86-64 128 false\n" $results, "x86-64 printed", dir)
    try r.expect(sh(dir, "objdump -d build/loop | grep -qE 'ymm|zmm|vfmadd'") != 0, "x86-64 has wide vectors or FMA", dir)
    try r.expect(sh(dir, "objdump -d build/loop | grep -qE 'call.*<fmaf@plt>'") == 0, "x86-64 does not call fmaf", dir)
    # x86-64-v3 - AVX2's 256 bits and FMA, run where this machine has them
    if first.EndsWith(" true") {
        try r.expect(sh(dir, "\"$OLANG\" -a x86-64-v3 -b loop.olang > out.txt 2>&1 && ./build/loop > v3.txt") == 0, "v3", dir)
        try r.expect((try os.ReadFile($dir "/v3.txt") catch default "") == "x86-64-v3 256 true\n" $results, "v3 printed", dir)
        try r.expect(sh(dir, "objdump -d build/loop | grep -q zmm") != 0, "x86-64-v3 has 512-bit vectors", dir)
    }
    # back to this machine: every object it built is current, not rebuilt (the build constants' module always is)
    try r.expect(sh(dir, "\"$OLANG\" -b loop.olang > out.txt 2>&1 && ./build/loop | cmp -s - native.txt") == 0,
                 "native again", dir)
    try r.expect(sh(dir, "stat -c '%n %.9Y' $(cut -d' ' -f1 objects.txt) | sort | cmp -s - objects.txt") == 0,
                 "native's objects were rebuilt", dir)
    # interpreted: the build constants and the results the built program gives
    try r.expect(sh(dir, "\"$OLANG\" -i loop.olang | cmp -s - native.txt") == 0, "-i", dir)
    try r.expect(sh(dir, "\"$OLANG\" -a x86-64 -i loop.olang | cmp -s - base.txt") == 0, "-a x86-64 -i", dir)
    # another architecture: -c at most, and with this clang not even that
    try r.expect(sh(dir, "\"$OLANG\" -a aarch64-linux-gnu -b loop.olang > out.txt 2>&1") != 0
                 and outOf(dir).Contains("error[B12a]"), "aarch64", dir)
}

# G8b: a generic type first resolved from inside another module's signature - b.olang's ReadA names a.Wrap before a's
# types are resolved - resolves in a context of its own, so the signature's "<T>" is not the type's T. Which file's
# storage lay above the other's decided whether it went wrong, so b.olang is padded until it is stored apart, above
test "a generic type first reached from another module's signature" { assert passed("lazytype") }

fn lazytype(r mut report&) ? Failed {
    dir := fresh("lazytype")
    os.Run("cp checks/fixtures/lazytype/* " $os.Quote(dir))
    os.Run("yes '# padding' | head -n 20000 >> " $os.Quote($dir "/b.olang"))
    try r.expect(sh(dir, "\"$OLANG\" -t b.olang > out.txt 2>&1") == 0, "b.olang's tests", dir)
}

test "every diagnostic's call fits its message, and every rule it names is in the specification" {
    table := try os.ReadFile("bootstrap/errmsg.h") catch default ""
    spec := try os.ReadFile("SPEC.md") catch default ""
    assert table.Len() > 0 and spec.Len() > 0
    bad := 0
    entries := 0
    # each entry's rules - "L10a, L10c" names two
    rest String& = table
    for {
        at := try rest.Find("    X(") catch { break }
        rs, re := literalAfter(rest, at)
        rules := rest[rs:re]
        for rules.Len() > 0 {
            comma := try rules.Find(", ") catch default -1
            end I64 = rules.Len() if comma < 0 else comma
            r := rules[:end]
            if not spec.Contains("**" $r ".**") and not spec.Contains("**" $r " (") {
                try io.PrintErr("check FAIL: errmsg.h names rule " $r ", which SPEC.md does not state\n") catch { }
                bad++
            }
            rules = rules[end:] if comma < 0 else rules[end + 2:]
        }
        entries++
        rest = rest[re:]
    }
    assert entries > 0
    # each call naming a diagnostic, in every source file
    dir := fresh("diags")
    os.Run("ls bootstrap/*.c > " $os.Quote($dir "/sources.txt"))
    list := try os.ReadFile($dir "/sources.txt") catch default ""
    calls := 0
    for name in list.Split("\n") {
        if name.Len() == 0 { continue }
        src := try os.ReadFile(name) catch default ""
        for fname in String&["Err(", "ErrSyntax(", "ErrFile(", "ErrFatal(", "ErrUsage(", "Note("] {
            from := I64(0)
            for {
                hit := try src[from:].Find(fname) catch { break }
                at I64 = from + hit
                from = at + fname.Len()
                if at > 0 and isIdentChar(src[at - 1]) { continue }
                s, e, after := callShape(src, at + fname.Len() - 1)
                if s < 0 { continue }
                id := src[s:e]
                entry := try table.Find("    X(" $id ",") catch default -1
                if entry < 0 {
                    try io.PrintErr("check FAIL: " $name " names " $id ", which errmsg.h does not declare\n") catch { }
                    bad++
                    continue
                }
                _, re := literalAfter(table, entry)
                fs, fe := literalAfter(table, re + 1)
                want := directiveCount(table[fs:fe])
                if want != after {
                    try io.PrintErr("check FAIL: " $name ": " $fname $id ", ... passes " $after " arguments, its message takes " $want "\n") catch { }
                    bad++
                }
                calls++
            }
        }
    }
    assert calls > 0
    assert bad == 0
}

# K1: the differential fuzzer (fuzz/), on a few fixed seeds - each program built at -O3, built at -O0 and interpreted,
# every value computed while compiling the same as the run time's, and every output the same; "make fuzz" runs it longer
test "the differential fuzzer finds nothing on its fixed seeds" { assert passed("fuzz") }

fn fuzz(r mut report&) ? Failed {
    dir := fresh("fuzz")
    os.Run("cp fuzz/fuzz.olang fuzz/gen.olang fuzz/scopegen.olang " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b -d fuzz.olang > out.txt 2>&1") == 0, "fuzz did not build", dir)
    # the compiler it tests is this one, handed on: fuzz falls back to build/out under the directory it runs in
    try r.expect(sh(dir, "OLANG=\"$OLANG\" ./build/fuzz.debug run 1 2 1 12 > out.txt 2>&1") == 0, "fuzz found something (build/checks/fuzz/build/fz/found)", dir)
    # B2f: scope-stress programs built under the scope sanitizer and interpreted give one output (seeds that ran clean)
    try r.expect(sh(dir, "OLANG=\"$OLANG\" ./build/fuzz.debug scope 3 2 1 12 > out.txt 2>&1") == 0,
                 "fuzz scope found something (build/checks/fuzz/build/fz/scope)", dir)
}

# B2f: the scope sanitizer. Its runtime, driven from C: storage a closed scope gave back, read or written - a small chunk
# and a large one - a reference read out of it followed, a length read out of it allocated, each stopped with its message
# and status 134, as a failed check is; a fault that is not the sanitizer's ends the program as it would without it; a
# program's own os.OnCrash message is kept for those, and more scopes closed than are held back leave the newest still
# caught. Then tests that churn arenas pass under it (no use is reported that is not one), and only a -s build carries it
test "the scope sanitizer reports a use after a scope closed, and nothing else" { assert passed("scopesan") }

fn scopesan(r mut report&) ? Failed {
    dir := fresh("scopesan")
    os.Run("cp checks/fixtures/scopesan/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b -d -s stub.olang > out.txt 2>&1") == 0, "stub.olang did not build", dir)
    try r.expect(sh(dir, ("objcopy --redefine-sym main=olang_main build/stub.*.main.debug.san.o > out.txt 2>&1"
                          " && clang -O0 drive.c build/*.debug.san.o -o drive -lpthread -ldl -lm >> out.txt 2>&1")) == 0,
                 "drive.c did not link", dir)
    try r.expect(sh(dir, "./drive ok > out.txt 2>&1") == 0 and outOf(dir) == "ok 1499500\n", "drive ok", dir)
    mem String& = "use after scope closed: storage a closed scope gave back was read or written\n"
    ref String& = "use after scope closed: a reference read from storage a closed scope gave back was followed\n"
    len String& = "use after scope closed: an allocation of more than 2^60 bytes - a length read from storage a closed scope gave back\n"
    try driven(r, dir, "read", 134, mem)
    try driven(r, dir, "write", 134, mem)
    try driven(r, dir, "big", 134, mem)
    try driven(r, dir, "ref", 134, ref)
    try driven(r, dir, "len", 134, len)
    try driven(r, dir, "foreign", 139, "")
    try driven(r, dir, "churn", 134, "1499500\n" $mem)
    try driven(r, dir, "read crash", 134, $mem "crashed\n")
    try driven(r, dir, "foreign crash", 139, "crashed\n")
    # no use reported that is not one: arena-churning tests pass under it
    tests String& = " " $os.Quote($root() "/std/prelude/tests/list.olang") " " $os.Quote($root() "/std/prelude/tests/map.olang")
    try r.expect(sh(dir, "\"$OLANG\" -t -d -s" $tests " > out.txt 2>&1") == 0, "the tests under -d -s", dir)
    try r.expect(sh(dir, "grep -c ' 0 failed' out.txt | grep -qx 2") == 0, "the tests under -d -s did not all pass", dir)
    # zero cost outside -s: nothing of it in a plain build's IR, all of it in a -s build's
    try r.expect(sh(dir, "\"$OLANG\" -b -d stub.olang > out.txt 2>&1") == 0, "stub.olang did not build plainly", dir)
    try r.expect(sh(dir, "grep -q '__olang_san' build/stub.main.debug.ll") != 0, "a plain build carries the sanitizer", dir)
    try r.expect(sh(dir, "grep -q 'call void @__olang_san_quarantine_list' build/stub.main.debug.san.ll") == 0,
                 "a -s build does not quarantine what a scope closes", dir)
}

# runs drive.c's mode: it must end with status, its output (stdout and stderr together) beginning with want - after
# which the shell may say how it ended - and report no use after a scope closed unless want does
fn driven(r mut report&, dir String&, mode String&, status I32, want String&) ? Failed {
    st := sh(dir, "./drive " $mode " > out.txt 2>&1")
    out := outOf(dir)
    ok := st == status and out.StartsWith(want) and (want.Contains("use after") or not out.Contains("use after"))
    try r.expect(ok, "drive " $mode " ended " $st, dir)
}

# S1, S2: os.OnCrash's message is what the program writes when it crashes - on the main thread, on RunOnStack's and on
# a task's, a stack overflow included, and after a failed check's own line - and the process still ends as the signal
# ends it; os.RunOnStack's recursion finishes where the main thread's 8MB overflows, built and interpreted; and under -i
# a crash in a foreign function the program calls writes the program's message first
test "os.OnCrash reports a crash on every thread, and os.RunOnStack makes room" { assert passed("crash") }

# the fixture program, run in dir with its arguments and no core file left behind, through no shell of its own
fn crashRun(dir String&, args String&) os.Output {
    return try os.Exec(String&["sh", "-c", "cd " $os.Quote(dir) " && ulimit -c 0 && exec " $args]) catch { unreachable }
}

fn crashes(r mut report&) ? Failed {
    dir := fresh("crash")
    os.Run("cp checks/fixtures/crash/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b crash.olang > out.txt 2>&1") == 0, "crash did not build", dir)
    for how in String&["overflow", "small", "task", "shallow"] {
        o := crashRun(dir, "./build/crash " $how)
        try r.expect(o.Status == 139 and o.Stderr == "crash.olang crashed: " $how "\n" and o.Stdout == "",
                     "crash " $how ": status " $o.Status ", " $o.Stderr, dir)
    }
    a := crashRun(dir, "./build/crash assert")
    try r.expect(a.Status == 134 and a.Stderr.EndsWith("assertion failed: c.v is 0\ncrash.olang crashed: assert\n"),
                 "crash assert: status " $a.Status ", " $a.Stderr, dir)
    d := crashRun(dir, "./build/crash deep")
    try r.expect(d.Status == 0 and d.Stdout == "deep 1000000\n", "RunOnStack deep: status " $d.Status ", " $d.Stdout, dir)
    olang := $root() "/build/out"
    i := crashRun(dir, $os.Quote(olang) " -i crash.olang deep 20000")
    try r.expect(i.Status == 0 and i.Stdout == "deep 20000\n", "RunOnStack -i: " $i.Stdout $i.Stderr, dir)
    f := crashRun(dir, $os.Quote(olang) " -i foreign.olang")
    try r.expect(f.Status == 139 and f.Stderr.StartsWith("foreign.olang crashed\nolang: internal compiler error")
                 and f.Stderr.Contains("while interpreting"), "OnCrash -i: status " $f.Status ", " $f.Stderr, dir)
    # T2b: a read through null traps where it is written, optimized (where the optimizer can see the null) and not;
    # -i stops there, naming it
    for flags in String&["", "-d"] {
        try r.expect(sh(dir, "\"$OLANG\" -b " $flags " nullpeek.olang > out.txt 2>&1") == 0, "nullpeek did not build", dir)
        bin := "./build/nullpeek" $(".debug" if flags == "-d" else "")
        n := crashRun(dir, bin)
        try r.expect(n.Status == 139 and n.Stdout == "start\nafter a push: 4\n" and n.Stderr == "nullpeek crashed\n",
                     "nullpeek " $flags ": status " $n.Status ", " $n.Stdout $n.Stderr, dir)
    }
    ni := crashRun(dir, $os.Quote(olang) " -i nullpeek.olang")
    try r.expect(ni.Status == 1 and ni.Stdout == "start\nafter a push: 4\n" and ni.Stderr.Contains("reads through a null"),
                 "nullpeek -i: status " $ni.Status ", " $ni.Stderr, dir)
    # std/chan: a Send on a closed channel stops the program, naming it
    try r.expect(sh(dir, "\"$OLANG\" -b chanclosed.olang > out.txt 2>&1") == 0, "chanclosed did not build", dir)
    cc := crashRun(dir, "./build/chanclosed")
    try r.expect(cc.Status == 134 and cc.Stdout == "got 1\n" and cc.Stderr.Contains("send on a closed channel"),
                 "chanclosed: status " $cc.Status ", " $cc.Stdout $cc.Stderr, dir)
    # P7: under -r the crash handler is not instrumented (it can run while ThreadSanitizer holds its own locks); -c,
    # so no sanitizer runtime is needed to check it
    try r.expect(sh(dir, "\"$OLANG\" -c -r nullpeek.olang > out.txt 2>&1") == 0, "nullpeek -c -r did not build", dir)
    ll := try os.ReadFile($dir "/build/nullpeek.race.ll") catch default ""
    try r.expect(ll.Contains("@__olang_crash_handler(i32 %sig) #1 {") and ll.Contains("attributes #0 = { null_pointer_is_valid sanitize_thread")
                 and ll.Contains("attributes #1 = { null_pointer_is_valid \"target-cpu\""), "crash handler instrumented under -r", dir)
}
