    try r.expect(sh(dir, "grep -q '@bits_GH = constant half 0xH7C01'" $ll) == 0, "bits_GH", dir)
    try r.expect(sh(dir, "grep -q '@bits_GB = constant bfloat 0xRFFC1'" $ll) == 0, "bits_GB", dir)
    try r.expect(sh(dir, "grep -q '@bits_Baked = constant i1 true'" $ll) == 0, "bits_Baked", dir)
}

# a function returning an aggregate returns it through one slot and one exit block, so that inlined, its result's
# fields reach the caller as separate values LLVM can see into - without it an iterator loop never vectorized
test "an aggregate is returned through one slot" { assert passed("retslot") }

