# checks - what a test block cannot check about the compiler itself: programs that must NOT compile, and
# whole builds (a remote fetch, rebuilds under -D, the code generated). Every file in checks/cases is an
# ordinary olang program whose first lines say what it must do:
#     # check: fail <text>    it must fail to build, with <text> in the diagnostics
#     # also: <text>          and with <text> too - any number of these lines, each checked
#     # never: <text>         and without <text> anywhere in them - any number, each checked
#     # check: build          it must build
#     # check: run            it must build, and the program must exit 0 - and print what compiler/goldens/run.txt
#                             stores for it, captured from stage 0 (make rungold), where it stores a stable output
#     # check: doc [NAME]     "olang doc" must print its documentation (or NAME's), with every "# also:" text in it
#                             and no "# never:" text (B14)
#     # flags: <arguments>    passed to the compiler (a -D value, say)
# The multi-step scenarios below drive the compiler themselves, with their files in checks/fixtures.
# Everything is built under build/checks, so nothing touches the tree.
#
# Every check - each case, and each scenario - runs in a directory of its own, build/checks/cases/<case> or
# build/checks/<scenario>, so no two of them ever write one file, and they all run side by side, Workers at a time,
# before the first test starts (Outcomes). The tests then report what each found, in the order they are written: one
# for all the cases, and one per scenario.

import "std/os"
import "std/io"
import "std/chan"
import "std/time"

# how many checks run at once. A check is a compiler run, or several one after another, each using about one core and
# mostly a few hundred megabytes (the largest, agree's -i, 3.5GB), so four keep a four-core machine busy and leave its
# memory to spare
Workers I64 = workers()

# CHECKS_WORKERS, else 4
fn workers() I64 {
    t := try os.Env("CHECKS_WORKERS") catch default "4"
    n := try t.ParseInt(10) catch default 4
    return n if n > 0 else 4
}

# the scenarios below, by the directory each runs in - the longest first, as CHECKS_TIMES measured them (2026-10-24), so
# the last check to finish is a short one. A scenario is a function reporting into a report (r.expect(ok, what, dir) for
# each thing it checks), named here and in scenario(), with a test reporting it: one missing from either is reported as
# a failure, never skipped.
Scenarios := String&["fix", "strheld", "fuzz", "testfuzz", "bench", "agree", "latermodule", "landing", "cgreview", "vechandle", "testends"
                     "scopesan", "frameenv", "crash", "interp", "target", "assertloc", "objnames", "spawnerr", "generators", "runfile"
                     "chunkpool", "capscope", "reuse", "updir", "stale", "osargs", "print", "inferfield", "tbaa", "pkg"
                     "preludestale", "bits", "remote", "tcrash", "ttolerant", "vecalias", "output", "remotestale"
                     "format", "lazytype", "manymods", "k2", "listloop", "typereview", "osexit", "retslot", "protopriv"
                     "s18c", "regions", "manyifs", "enumwords", "twolists", "opvis", "static", "remotebad", "nestdeep"
                     "nestparse", "words", "diag", "sidebyside", "cinterop", "embed", "earlyfree", "widealign", "definit"
                     "profile"]

# what runs side by side: every scenario, a scenario with parts as its parts ("strheld/order") and then itself, which
# runs what is left of it. A scenario passes when all of it does
Checks Array<String&>& = withParts(Scenarios) if Target == "" and Only == "" else Array<String&>(0)

# CHECKS_ONLY: while developing, only the cases whose file names hold this text (or one of several, comma-separated), and no scenario - a run that passes
# says nothing of the rest
Only String& = try os.Env("CHECKS_ONLY") catch default ""

# CHECKS_TARGET (make cross): another architecture the cases are built for (B12a) - "-target" added to each case's
# flags, a run case run through the emulator olang finds - while the scenarios, which look at this machine's own builds,
# are not run
Target String& = try os.Env("CHECKS_TARGET") catch default ""

# the cases not built for another architecture: what links libffi for std/ffi's calls, which the cross C library of
# the distribution does not hold
CrossSkip := String&["externruntime2.olang"]

fn withParts(names Array<String&>&) Array<String&>& {
    all Vec<String&>
    for n in names {
        if n == "strheld" { for p in StrheldPrograms { all.Push($"strheld/" $p) } }
        all.Push($n)
    }
    return all.ToArray()
}

# the files in checks/cases
Cases Array<String&>& = only(try os.ReadDir("checks/cases") catch default Array<String&>(0))

# a case CHECKS_ONLY names: its file name holds one of the comma-separated texts
fn wanted(name String&) Bool { return Only.Split(",").Some(fn(w String&) Bool { return name.Contains(w) }) }

fn only(names Array<String&>&) Array<String&>&names {
    if Only == "" { return names }
    n := 0
    for x in names { if wanted(x): n++ }
    out mut Array<String&>&names = Array<String&>(n)
    k := 0
    for x in names {
        if wanted(x) {
            out[k] = x
            k++
        }
    }
    return out
}

# where the prelude's objects, and the runtime's (B3), are built once, before the cases start - as the cases did when
# they all shared one directory. Each has a directory of its own now, since each build also writes an olang_build
# module beside them, and building the prelude again costs every case that gets as far as code about 1.6s, two thirds
# of the cases' time again.
Seed String& = "prelude"

# the objects the cases' builds share (B3j, OLANG_OBJECTS): what one case's build made - the prelude's, std's, the
# runtime's for its modes - every other build that needs it takes, and so do the next run's builds while their IR is
# the same. It is kept across runs, and started again when it holds more than StoreMost objects (make clean removes it)
Store String& = "build/checks/objects"
StoreMost I64 = 8000

# the runs compiler/goldens/run.txt stores (compiler/tools/rungold.olang): a run case's program's status and output,
# captured as runCase builds and runs it
StoredRuns String& = try os.ReadFile("compiler/goldens/run.txt") catch default ""

# what every check found - the scenarios', then the cases', in the order of Scenarios and Cases: "" for a check that
# passed, and what went wrong for one that did not
Outcomes Array<String&>& = runAll()

# runs every check, Workers at a time: each worker takes the number of the next check from a queue, until the queue is
# closed and empty. The scenarios are queued first, and the cases once the prelude's objects they start from are built
# (Seed).
fn runAll() Array<String&>& {
    n I64 = Checks.Len() + Cases.Len()
    outcomes mut Array<String&>&return = Array<String&>(n)
    took mut Array<I64>& = Array<I64>(n)
    queue mut chan.Chan<I64>& = chan.Chan<I64>(n)
    chan.Init(queue)
    for k in range Checks.Len() { chan.Send(queue, k)! }
    kept := try os.ReadDir(Store) catch default Array<String&>(0)
    if kept.Len() > StoreMost { os.Run("rm -rf " $os.Quote(Store)) }
    join {
        for _ in range Workers { spawn worker(queue, outcomes, took) }
        seed := fresh(Seed)
        try os.WriteFile($seed "/seed.olang", "fn main() ? { }\n") catch { }
        sh(seed, $store() " \"$OLANG\" build seed.olang > out.txt 2>&1")
        for k in range Checks.Len(), n { chan.Send(queue, k)! }
        chan.Close(queue)
    }
    writeTimes(took)
    return outcomes
}

fn worker(queue mut chan.Chan<I64>&, outcomes mut Array<String&>&, took mut Array<I64>&) {
    for k in queue {
        t := time.Now()
        outcomes[k] = runCheck(k)
        took[k] = time.Since(t)
    }
}

# CHECKS_TIMES set to a path: how long each check took, a line each - milliseconds, then its name - longest first
fn writeTimes(took Array<I64>&) {
    path := try os.Env("CHECKS_TIMES") catch default ""
    if path == "" { return }
    order := Array<I64>(took.Len())
    for i in range took.Len() { order[i] = i }
    order.Sort(fn(a I64, b I64) Bool { return took[a] > took[b] })
    b := StringBuilder()
    for k in order {
        name := Checks[k] if k < Checks.Len() else $"cases/" $Cases[k - Checks.Len()]
        b.Push($(took[k] / 1000000) " " $name "\n")
    }
    try os.WriteFile(path, b.ToString()) catch os.Error { }
}

# check number k: a scenario, or a case after them
fn runCheck(k I64) String& {
    if k >= Checks.Len() { return runCase(Cases[k - Checks.Len()]) }
    r := report()
    try scenario(r, Checks[k]) catch Failed { }
    return $r.text
}

# whether the scenario named "name" passed, printing what went wrong when it did not
fn passed(name String&) Bool {
    if Target != "" or Only != "" { return true } # not run for another architecture, or while developing
    found := false
    ok := true
    for i, s in Checks {
        if s == name or s.StartsWith($name "/") {
            found = true
            if not reported(Outcomes[i]) { ok = false }
        }
    }
    if not found { return reported("check FAIL: no scenario is named " $name "\n") }
    return ok
}

# whether an outcome is a pass, printing it when it is not
fn reported(outcome String&) Bool {
    if outcome.Len() == 0 { return true }
    try io.PrintErr(outcome) catch io.Error { }
    return false
}

# what went wrong in a scenario, once something has: the first check of it that failed ends it
type report struct() {
    text mut String& = ""
}

type Failed error {
    CHECK
}

# ends the scenario as failed, with what went wrong and what the compiler said in dir
fn (r mut report&) failed(what String&, dir String&) ? Failed {
    r.text = failure(what, dir)
    error Failed.CHECK
}

# ends the scenario as failed - as failed() does - unless ok
fn (r mut report&) expect(ok Bool, what String&, dir String&) ? Failed {
    if not ok { try r.failed(what, dir) }
}

# the text after "<prefix>" on the line that starts with it, or "" when no line does
fn lineAfter(src String&, prefix String&) String&src {
    at := try src.Find(prefix) catch { return src[0:0] }
    rest := src[at + prefix.Len():]
    end := try rest.FindByte('\n') catch { return rest }
    return rest[:end]
}

# the repository root - where the tests run - as an absolute path
fn root() String& {
    return try os.Cwd() catch default ""
}

# the store the cases' builds share, as the environment a command is run in names it
fn store() String& {
    return "OLANG_OBJECTS=" $os.Quote($root() "/" $Store)
}

# a fresh, empty directory for one check, as an absolute path
fn fresh(tag String&) String& {
    dir mut String&return = $root() "/build/checks/" $tag
    os.Run("rm -rf " $os.Quote(dir) " && mkdir -p " $os.Quote(dir))
    return dir
}

# the compiler under test, as an absolute path: $OLANG - relative to the repository root when it is relative - else
# build/olang (make bootstrap) - compiler/DESIGN.md
# section 4; the makefile's OLANG
fn olang() String& {
    o := try os.Env("OLANG") catch default "build/olang"
    if o.StartsWith("/") { return $o }
    return $root() "/" $o
}

# runs cmd inside dir; the compiler is "$OLANG" there, and what it printed lands in dir/out.txt
fn sh(dir String&, cmd String&) I32 {
    return os.Run("cd " $os.Quote(dir) " && OLANG=" $os.Quote(olang()) " && " $cmd)
}

fn outOf(dir String&) String& {
    return try os.ReadFile($dir "/out.txt") catch default ""
}

# a failed check, with what the compiler said
fn failure(what String&, dir String&) String& {
    return "check FAIL: " $what "\n" $outOf(dir) "\n"
}

# a case's "# also:" texts each in what the compiler said, its "# never:" texts none of them: "" where so, else the
# failure
fn alsoNever(src String&, name String&, dir String&) String& {
    rest := src[:]
    for {
        at := try rest.Find("# also: ") catch { break }
        line := rest[at + 8:]
        end := try line.FindByte('\n') catch default line.Len()
        also := line[:end]
        if not outOf(dir).Contains(also) { return failure($name ": expected '" $also "'", dir) }
        rest = line[end:]
    }
    rest = src[:]
    for {
        at := try rest.Find("# never: ") catch { break }
        line := rest[at + 9:]
        end := try line.FindByte('\n') catch default line.Len()
        never := line[:end]
        if outOf(dir).Contains(never) { return failure($name ": did not expect '" $never "'", dir) }
        rest = line[end:]
    }
    return ""
}

# builds one case file, in a directory of its own, and judges it against its own header
fn runCase(name String&) String& {
    if not name.EndsWith(".olang") { return "" }
    src := try os.ReadFile("checks/cases/" $name) catch default ""
    check := lineAfter(src, "# check: ")
    written := lineAfter(src, "# flags: ")
    # for another architecture, every case but those naming their own target, and the documentation's (which no
    # target changes) - and those needing what a cross C library holds alone (CrossSkip)
    cross := Target != "" and not written.Contains("-target") and not check.StartsWith("doc")
    if Target != "" and CrossSkip.Has(name) { return "" }
    flags := $written " -target " $Target if cross else written
    base := name[:name.Len() - 6]
    dir := fresh("cases/" $base)
    os.Run("cp checks/cases/" $name " " $os.Quote(dir))
    if check.StartsWith("doc") {
        # the header's lines are comments too: the documentation is of the program without them
        body := StringBuilder()
        for line in src.Lines() {
            if not (line.StartsWith("# check: ") or line.StartsWith("# also: ") or line.StartsWith("# never: ") or
                    line.StartsWith("# flags: ")) {
                body.Push($line "\n")
            }
        }
        try os.WriteFile($dir "/" $name, body.ToString()) catch os.Error { return failure($name ": not copied", dir) }
        if sh(dir, $store() " \"$OLANG\" doc " $flags " " $name " " $check[3:].Trim() " > out.txt 2>&1") != 0 {
            return failure($name ": olang doc failed", dir)
        }
        return alsoNever(src, name, dir)
    }
    status := sh(dir, $store() " \"$OLANG\" build " $flags " " $name " > out.txt 2>&1")
    if check.StartsWith("fail ") {
        if status == 0 { return failure($name " compiled but should not have", dir) }
        want := check[5:]
        if not outOf(dir).Contains(want) { return failure($name ": expected '" $want "'", dir) }
        return alsoNever(src, name, dir)
    }
    if status != 0 { return failure($name " did not build", dir) }
    bin := base
    san := false
    for f in flags.Split(" ") {                 # -debug, -race and -sanitize name their binary for what it was built as
        if f == "-debug" { bin = $base ".debug" }
        if f == "-race" { bin = $base ".race" }
        if f == "-sanitize" { san = true }
    }
    if san { bin = $bin ".san" }
    if check.Eq("run") {
        # another architecture's program is run by olang, through its emulator (B3g, B12a)
        run := "./build/" $bin if not cross else $store() " \"$OLANG\" " $flags " " $name
        if sh(dir, $run " > out.txt 2> err.txt") != 0 {
            return $failure($name " built but did not run cleanly", dir) $(try os.ReadFile($dir "/err.txt") catch default "")
        }
        want := storedOutput(name)
        got := outOf(dir).Replace(dir, "$CASE").Replace(root(), "$ROOT")
        if want.Stored and want.Out != got {
            return ("check FAIL: " $name " printed other than compiler/goldens/run.txt stores (make rungold captures it " $
                    "again)\n-- stored:\n" $want.Out "-- printed:\n" $got "\n")
        }
    }
    return ""
}

# the output run.txt stores for a run case, where it stores one it holds (not "unstable")
type stored struct() {
    Stored Bool = false
    Out String& = ""
}

# a case's stored run, read from its section - "=== run NAME", "| status N", then its output a row "| ROW" each, and
# "\\ no newline at end" after the last when it ends in none (compiler/tools/toolkit.olang)
fn storedOutput(name String&) stored {
    r := stored()
    at := try StoredRuns.Find($"=== run " $name "\n") catch { return r }
    rest := StoredRuns[at:]
    first := true
    out := StringBuilder()
    for row in rest.Split("\n") {
        if first {
            first = false
            continue
        }
        if row.StartsWith("=== ") or row == "" { break }
        if not r.Stored {
            if not row.StartsWith("| status ") or row.EndsWith(" unstable") { return r }
            r.Stored = true
            continue
        }
        if row == "\\ no newline at end" {
            t := out.ToString()
            out.Clear()
            out.Push(t[:t.Len() - 1] if t.Len() > 0 else t)
        } else {
            out.Push(row[2:] if row.StartsWith("| ") else "")
            out.PushChar('\n')
        }
    }
    r.Out = out.ToString()
    return r
}

test "every case in checks/cases does what its header says" {
    bad := 0
    count := 0
    for i, name in Cases {
        if name.EndsWith(".olang") {
            count++
            if not reported(Outcomes[Checks.Len() + i]) { bad++ }
        }
    }
    assert count > 0
    assert bad == 0
}

# the scenario named "name", reporting into r
fn scenario(r mut report&, name String&) ? Failed {
    if name.StartsWith("strheld/") {
        try strheldProgram(r, name[8:])
        return
    }
    match name {
        case "landing" { try landing(r) }
        case "earlyfree" { try earlyfree(r) }
        case "fix" { try fixing(r) }
        case "twolists" { try twolists(r) }
        case "sidebyside" { try sidebyside(r) }
        case "remote" { try remote(r) }
        case "remotebad" { try remotebad(r) }
        case "objnames" { try objnames(r) }
        case "remotestale" { try remotestale(r) }
        case "ttolerant" { try ttolerant(r) }
        case "tcrash" { try tcrash(r) }
        case "manymods" { try manymods(r) }
        case "diag" { try diag(r) }
        case "pkg" { try pkg(r) }
        case "stale" { try stale(r) }
        case "reuse" { try reuse(r) }
        case "embed" { try embedded(r) }
        case "interp" { try interp(r) }
        case "osargs" { try osargs(r) }
        case "osexit" { try osexit(r) }
        case "assertloc" { try assertloc(r) }
        case "testfuzz" { try testfuzz(r) }
        case "print" { try printing(r) }
        case "s18c" { try s18c(r) }
        case "static" { try static(r) }
        case "k2" { try k2(r) }
        case "bits" { try bits(r) }
        case "retslot" { try retslot(r) }
        case "widealign" { try widealign(r) }
        case "definit" { try definit(r) }
        case "profile" { try profiled(r) }
        case "tbaa" { try tbaa(r) }
        case "opvis" { try opvis(r) }
        case "protopriv" { try protopriv(r) }
        case "enumwords" { try enumwords(r) }
        case "listloop" { try listloop(r) }
        case "preludestale" { try preludestale(r) }
        case "nestparse" { try nestparse(r) }
        case "nestdeep" { try nestdeep(r) }
        case "manyifs" { try manyifs(r) }
        case "cgreview" { try cgreview(r) }
        case "typereview" { try typereview(r) }
        case "agree" { try agree(r) }
        case "fuzz" { try fuzz(r) }
        case "latermodule" { try latermodule(r) }
        case "bench" { try benchmarks(r) }
        case "chunkpool" { try chunkpool(r) }
        case "cinterop" { try cinterop(r) }
        case "target" { try target(r) }
        case "lazytype" { try lazytype(r) }
        case "updir" { try updir(r) }
        case "crash" { try crashes(r) }
        case "scopesan" { try scopesan(r) }
        case "regions" { try regions(r) }
        case "vecalias" { try vecalias(r) }
        case "vechandle" { try vechandle(r) }
        case "inferfield" { try inferfield(r) }
        case "runfile" { try runfile(r) }
        case "output" { try output(r) }
        case "format" { try formatting(r) }
        case "words" { try words(r) }
        case "capscope" { try capscope(r) }
        case "strheld" { try strheld(r) }
        case "spawnerr" { try spawnerr(r) }
        case "generators" { try generators(r) }
        case "frameenv" { try frameenv(r) }
        case "testends" { try testends(r) }
        nomatch {
            r.text = "check FAIL: no scenario is named " $name "\n"
            error Failed.CHECK
        }
    }
}

# O1b/P2: tasks building into the program's scope at once, at -d where nothing hides the allocations (it corrupted the
# heap); O18a: a value local's references are reclaimed with its loop body's block, under an address-space limit ten
# million passes would exceed when they went to the function's own scope; E11b: a join left part way, or recursing
# O8d (docs/memory.md 2.7, round 6): the programs that replace in long-lived places free what they let go of at once -
# built, each stays under 8 MB; interpreted at a smaller size, the evaluator, which stops on a read of a freed region,
# prints what the program built at that size prints
test "what a long-lived place lets go of is freed at once" { assert passed("earlyfree") }

fn earlyfree(r mut report&) ? Failed {
    dir := fresh("earlyfree")
    os.Run("cp checks/fixtures/earlyfree/* " $os.Quote(dir))
    # C9b: conns and sockets hold values with destructors, freed by a Destroy() after each is taken out - sockets'
    # descriptors too, under a limit of 64 open at once
    # mapvec (QF): a Map of Vecs whose values are replaced and removed
    progs := String&["server", "frames", "mapremove", "session", "ast", "fixedconv", "conns", "sockets", "mapvec"]
    small := String&["300", "100", "2000", "2000", "5", "300", "2000", "200", "2000"]
    full := String&["example.com\n", "3000000\n", "100\n"
                    "line 999999 of the file - a status text padded out to about a hundred bytes ......................\n"
                    "3071\n", "12000000000000\n", "999936 64\n", "16\n", "63 504\n"]
    part := String&["example.com\n", "3000\n", "100\n"
                    "line 1999 of the file - a status text padded out to about a hundred bytes ......................\n"
                    "3071\n", "270000\n", "1936 64\n", "16\n", "64 512\n"]
    for i in range progs.Len() {
        p := progs[i]
        try r.expect(sh(dir, $"\"$OLANG\" build " $p ".olang > out.txt 2>&1") == 0, $p " build", dir)
        try r.expect(sh(dir, $"(ulimit -v 8192 && ulimit -n 64 && ./build/" $p ") > out.txt 2>&1") == 0, $p " under 8 MB", dir)
        try r.expect(outOf(dir) == full[i], $p " output", dir)
        try r.expect(sh(dir, $"\"$OLANG\" interpret -define N=" $small[i] " " $p ".olang > out.txt 2>&1") == 0, $p " interpreted", dir)
        try r.expect(outOf(dir) == part[i], $p " interpreted output", dir)
    }
}

test "where a value lands, as whole builds" { assert passed("landing") }

fn landing(r mut report&) ? Failed {
    dir := fresh("landing")
    os.Run("cp checks/fixtures/landing/* " $os.Quote(dir))
    progscope String& = "\"$OLANG\" build -debug progscope.olang > out.txt 2>&1 && ./build/progscope.debug > out.txt 2>&1"
    try r.expect(sh(dir, progscope) == 0, "progscope", dir)
    try r.expect(outOf(dir) == "0 0\n", "progscope output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build valueloop.olang > out.txt 2>&1") == 0, "valueloop build", dir)
    try r.expect(sh(dir, "(ulimit -v 150000 && ./build/valueloop) > out.txt 2>&1") == 0, "valueloop", dir)
    try r.expect(outOf(dir) == "50000015000000\n", "valueloop output", dir)
    # D18e: a generator a local holds and one for-in or comprehension walks is dropped as the local's block closes
    try r.expect(sh(dir, "\"$OLANG\" build genlocal.olang > out.txt 2>&1") == 0, "genlocal build", dir)
    try r.expect(sh(dir, "(ulimit -v 8192 && ./build/genlocal) > out.txt 2>&1") == 0, "genlocal under 8 MB", dir)
    try r.expect(outOf(dir) == "36000000\n", "genlocal output", dir)
    #O26a: a number carries nothing into the result - the master compiler's build needed 96 MB here
    try r.expect(sh(dir, "\"$OLANG\" build numberflow.olang > out.txt 2>&1") == 0, "numberflow build", dir)
    try r.expect(sh(dir, "(ulimit -v 50000 && ./build/numberflow) > out.txt 2>&1") == 0, "numberflow", dir)
    try r.expect(outOf(dir) == "22\n", "numberflow output", dir)
    #E11b: a join left part way leaves nothing behind (a builder freed only at its end lost 1.5GB), and one recursing
    #through its later piece holds nothing across the call (60,000 deep overflowed the stack)
    try r.expect(sh(dir, "\"$OLANG\" build joinleak.olang > out.txt 2>&1") == 0, "joinleak build", dir)
    try r.expect(sh(dir, "(ulimit -v 150000 && ./build/joinleak) > out.txt 2>&1") == 0, "joinleak", dir)
    try r.expect(outOf(dir) == "805138895\n", "joinleak output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build joindepth.olang > out.txt 2>&1 && ./build/joindepth > out.txt 2>&1") == 0
                 "joindepth", dir)
    try r.expect(outOf(dir) == "1\n", "joindepth output", dir)
    #...and one in a loop's condition leaves only its text in the block the loop stands in, never what its builder outgrew
    #(200 MB here where the builder grew in that block)
    try r.expect(sh(dir, "\"$OLANG\" build joincond.olang > out.txt 2>&1") == 0, "joincond build", dir)
    try r.expect(sh(dir, "(ulimit -v 110000 && ./build/joincond) > out.txt 2>&1") == 0, "joincond", dir)
    try r.expect(outOf(dir) == "50000\n", "joincond output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build condarg.olang > out.txt 2>&1") == 0, "condarg build", dir)
    try r.expect(sh(dir, "(ulimit -v 50000 && ./build/condarg) > out.txt 2>&1") == 0, "condarg", dir)
    try r.expect(outOf(dir) == "499999500000\n", "condarg output", dir)
    #S9: a loop's condition is evaluated in the turn it decides - what it builds is reclaimed with the turn (1.8 GB
    #here before, every evaluation's 72KB element kept while the loop ran)
    try r.expect(sh(dir, "\"$OLANG\" build loopcond.olang > out.txt 2>&1") == 0, "loopcond build", dir)
    try r.expect(sh(dir, "(ulimit -v 50000 && ./build/loopcond) > out.txt 2>&1") == 0, "loopcond", dir)
    try r.expect(outOf(dir) == "5000 5001 5000 15000\n", "loopcond output", dir)
    #O26a: a view's function keeps no local in the structure's scope that what it returns cannot hold - a copy handed to
    #a method or another module's function giving a number, numbers for a slice (the master compiler: out of memory)
    try r.expect(sh(dir, "\"$OLANG\" build resultviews.olang > out.txt 2>&1") == 0, "resultviews build", dir)
    try r.expect(sh(dir, "(ulimit -v 50000 && ./build/resultviews) > out.txt 2>&1") == 0, "resultviews", dir)
    try r.expect(outOf(dir) == "10000000 28000000\n", "resultviews output", dir)
    #O18c: a call building new text or a new array is its loop body's, reached whole, through a part of its result or
    #as a for-in's element
    #(the review's lexer and mk loops: 206 MB and 1 GB where the result landed where the lexer, or base, lives)
    try r.expect(sh(dir, "\"$OLANG\" build callparts.olang > out.txt 2>&1") == 0, "callparts build", dir)
    try r.expect(sh(dir, "(ulimit -v 50000 && ./build/callparts) > out.txt 2>&1") == 0, "callparts", dir)
    try r.expect(outOf(dir) == "43444445 47000000 11000000 43444445\n", "callparts output", dir)
    #T7c, O18a: an array literal or fill of a known length made a run-time-length array lands where it is put - given
    #to a call, a constructor, returned, assigned (34 MB here before: its storage went to the program's scope), and
    #under -debug -sanitize nothing it holds is read after a scope closed
    try r.expect(sh(dir, "\"$OLANG\" build litarg.olang > out.txt 2>&1") == 0, "litarg build", dir)
    try r.expect(sh(dir, "(ulimit -v 50000 && ./build/litarg) > out.txt 2>&1") == 0, "litarg", dir)
    try r.expect(outOf(dir) == "6000049111115\n", "litarg output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug -sanitize litarg.olang > out.txt 2>&1 && ./build/litarg.debug.san 20000 > out.txt 2>&1") == 0
                 "litarg -sanitize", dir)
    try r.expect(outOf(dir) == "600351115\n", "litarg -sanitize output", dir)
    #O17b: handles lent as their references - built, built -d and interpreted, read back after the arena churned
    try r.expect(sh(dir, "\"$OLANG\" build handles.olang > out.txt 2>&1 && ./build/handles > b.txt 2>&1") == 0, "handles", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug handles.olang > out.txt 2>&1 && ./build/handles.debug > d.txt 2>&1") == 0
                 "handles -d", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret handles.olang > i.txt 2>&1") == 0, "handles -i", dir)
    try r.expect(sh(dir, "cmp -s handles.want b.txt && cmp -s b.txt d.txt && cmp -s b.txt i.txt") == 0, "handles output", dir)
}

# M22a: a std module and a local file with the same base name are two modules - but one module may not
# import both under the one alias the name gives them
test "std/io beside a local io.olang" { assert passed("twolists") }

fn twolists(r mut report&) ? Failed {
    dir := fresh("twolists")
    os.Run("cp checks/fixtures/twolists/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build twolists.olang > out.txt 2>&1 && ./build/twolists") == 0, "twolists", dir)
    try r.expect(sh(dir, "\"$OLANG\" build samealias.olang > out.txt 2>&1") != 0, "samealias compiled", dir)
    try r.expect(outOf(dir).Contains("alias"), "samealias: expected 'alias'", dir)
}

# B3k: three programs importing one module, built side by side in one directory, each compile made once - the others
# wait for it (a clang on PATH writes down every object it is asked for) - each program as it should be, and nothing
# claimed or half written left behind
test "builds side by side in one directory compile each object once" { assert passed("sidebyside") }

fn sidebyside(r mut report&) ? Failed {
    dir := fresh("sidebyside")
    os.Run("cp checks/fixtures/sidebyside/* " $os.Quote(dir))
    wrap String& = ("mkdir bin && printf '#!/bin/sh\nfor a; do [ \"$p\" = -o ] && echo \"$a\" >> %s/compiles.txt; p=$a; done\nexec %s \"$@\"\n' "
                    $os.Quote(dir) " \"$(command -v clang)\" > bin/clang && chmod +x bin/clang")
    try r.expect(sh(dir, wrap) == 0, "no clang to wrap", dir)
    side String& = ("export PATH=$PWD/bin:$PATH; \"$OLANG\" build a.olang > a.txt 2>&1 & A=$!; \"$OLANG\" build b.olang > b.txt 2>&1 & " $
                    "B=$!; \"$OLANG\" build c.olang > c.txt 2>&1 & C=$!; wait $A; a=$?; wait $B; b=$?; wait $C; c=$?; [ $a$b$c = 000 ]")
    try r.expect(sh(dir, side) == 0, "a build side by side failed", dir)
    try r.expect(sh(dir, "./build/a > out.txt && ./build/b >> out.txt && ./build/c >> out.txt") == 0, "a program did not run", dir)
    try r.expect(outOf(dir) == "a 19 5\nb 19 5\nc 19 5\n", "what the programs printed", dir)
    try r.expect(sh(dir, "grep '\\.o\\.' compiles.txt | sed 's/\\.[0-9]*\\.tmp$//' | sort | uniq -d > out.txt; test ! -s out.txt") == 0
                 "an object compiled twice", dir)
    try r.expect(sh(dir, "ls build | grep -e '\\.lock$' -e '\\.tmp' > out.txt; test ! -s out.txt") == 0, "left behind", dir)
}

# M23a/M23b/M23c: a remote repository is fetched once with git into the cache, "@ref" pins a version beside the default
# branch, olang.lock pins each to a commit, -u moves them on, and a second build reads the cache and never touches
# git - the remote is removed to prove it
test "a file in a remote repository, fetched once into the cache" { assert passed("remote") }

fn remote(r mut report&) ? Failed {
    dir := fresh("remote")
    repo String& = $dir "/remote/example.com/me/tools"
    env String& = "OLANG_GIT_BASE=file://" $dir "/remote/ OLANG_CACHE=" $dir "/cache "
    src String& = "checks/fixtures/remote/"
    try r.expect(os.Run("mkdir -p " $os.Quote(repo) " && cp -r " $src "mathx " $src "mathy " $os.Quote(repo)) == 0
                 "copying the repository", dir)
    try r.expect(os.Run("cp " $src "*.olang " $os.Quote(dir)) == 0, "copying the program", dir)
    git String& = "git -c user.name=t -c user.email=t@t"
    try r.expect(sh(repo, "git init -q && git add . && " $git " commit -qm v1 && git tag v1") == 0, "v1", dir)
    try r.expect(sh(repo, "sed -i 's/n + 1/n + 100/' mathy/inc.olang && " $git " commit -qam v2") == 0, "v2", dir)
    try r.expect(sh(dir, $env "\"$OLANG\" build remote.olang > out.txt 2>&1 && ./build/remote") == 0, "remote build", dir)
    try r.expect(outOf(dir).Contains("fetching example.com/me/tools into"), "no fetch of the branch", dir)
    try r.expect(outOf(dir).Contains("fetching example.com/me/tools@v1 into"), "no fetch of v1", dir)
    try r.expect(sh(dir, "ls -d cache/example.com/me/tools/*/mathx > /dev/null") == 0, "nothing in the cache", dir)
    # M23b: both repositories are locked to the commits fetched, and the cache is keyed by commit
    try r.expect(sh(dir, "grep -q '^example.com/me/tools [0-9a-f]\\{40\\}$' olang.lock && grep -q '^example.com/me/tools@v1 ' olang.lock") == 0
                 "olang.lock", dir)
    # the branch moves on, and a locked build neither fetches nor follows it
    try r.expect(sh(repo, "sed -i 's/n + 100/n + 1000/' mathy/inc.olang && " $git " commit -qam v3") == 0, "v3", dir)
    try r.expect(sh(dir, "touch remote.olang && " $env "\"$OLANG\" build remote.olang > out.txt 2>&1 && ./build/remote") == 0
                 "locked rebuild", dir)
    try r.expect(not outOf(dir).Contains("fetching"), "a locked rebuild fetched", dir)
    # with the cache gone, the locked commit is fetched again - not the branch's new head
    try r.expect(sh(dir, "rm -rf cache && touch remote.olang && " $env "\"$OLANG\" build remote.olang > out.txt 2>&1 && ./build/remote") == 0
                 "locked refetch", dir)
    try r.expect(outOf(dir).Contains("as olang.lock says"), "locked refetch: expected 'as olang.lock says'", dir)
    # M23c: -u moves every repository the build reaches to its ref's current commit, once each - the branch's
    # new head (so remote.olang's assert fails while compiling) - and leaves v1, which has not moved, as it was
    try r.expect(sh(dir, "cp olang.lock before.lock && touch remote.olang && " $env "\"$OLANG\" build -update remote.olang > out.txt 2>&1") != 0
                 "-u: the program built", dir)
    try r.expect(outOf(dir).Contains("this assertion is false"), "-u: expected 'this assertion is false'", dir)
    try r.expect(outOf(dir).Contains("updated example.com/me/tools to") and outOf(dir).Contains("example.com/me/tools@v1 is already at")
                 "-u: what it updated", dir)
    try r.expect(sh(dir, "grep '^example.com/me/tools ' olang.lock > now.txt && ! grep -qFf now.txt before.lock") == 0
                 "-u did not move the branch's line", dir)
    try r.expect(sh(dir, "grep '^example.com/me/tools@v1 ' olang.lock > now.txt && grep -qFf now.txt before.lock") == 0
                 "-u moved v1's line", dir)
    try r.expect(sh(dir, "cp before.lock olang.lock") == 0, "restoring olang.lock", dir)
    # deleting a line updates that repository to its ref's current commit
    try r.expect(sh(dir, "cp olang.lock before.lock && sed -i '/^example.com\\/me\\/tools /d' olang.lock") == 0
                 "deleting a line of olang.lock", dir)
    try r.expect(sh(dir, "touch remote.olang && " $env "\"$OLANG\" build remote.olang > out.txt 2>&1") != 0
                 "a deleted line: the program built", dir)
    # it now adds 1000: remote.olang's assert says so
    try r.expect(outOf(dir).Contains("this assertion is false"), "a deleted line: expected 'this assertion is false'", dir)
    try r.expect(sh(dir, "grep '^example.com/me/tools ' olang.lock > now.txt && ! grep -qFf now.txt before.lock") == 0
                 "a deleted line was not updated", dir)
    try r.expect(sh(dir, "cp before.lock olang.lock && rm -rf remote && touch remote.olang") == 0
                 "removing the remote", dir)
    try r.expect(sh(dir, $env "\"$OLANG\" build remote.olang > out.txt 2>&1") == 0, "cached remote build", dir)
    try r.expect(not outOf(dir).Contains("fetching"), "a cached build fetched", dir)
    try r.expect(sh(dir, $env "\"$OLANG\" build missing.olang > out.txt 2>&1") != 0, "missing.olang built", dir)
    try r.expect(outOf(dir).Contains("fetch"), "missing.olang: expected 'fetch'", dir)
}

# M23a: the host, owner, repository and ref of a remote import, and a locked commit, are checked before git sees them,
# and git is never run through a shell - each of these ran "touch PWNED" while fetching. A locked commit that cannot be
# fetched leaves nothing in the cache a later build would take for it.
test "nothing in a remote import or the lock file is run" { assert passed("remotebad") }

fn remotebad(r mut report&) ? Failed {
    dir := fresh("remotebad")
    os.Run("cp -r checks/fixtures/remotebad/. " $os.Quote(dir))
    env String& = "OLANG_GIT_BASE=file://" $dir "/remote/ OLANG_CACHE=" $dir "/cache "
    try r.expect(sh($dir "/inj", $env "\"$OLANG\" build inj.olang > out.txt 2>&1") != 0, "inj.olang built", $dir "/inj")
    try r.expect(outOf($dir "/inj").Contains("may hold only letters"), "bad import", $dir "/inj")
    try r.expect(sh($dir "/lock", $env "\"$OLANG\" build p.olang > out.txt 2>&1") != 0, "a bad lock built", $dir "/lock")
    try r.expect(outOf($dir "/lock").Contains("names no commit"), "bad lock", $dir "/lock")
    try r.expect(sh(dir, "test ! -e inj/PWNED && test ! -e lock/PWNED && test ! -e PWNED") == 0, "PWNED", dir)
    git String& = "git -c user.name=t -c user.email=t@t"
    try r.expect(sh(dir, "mkdir -p remote/example.com/me/tools/mathx && echo 'fn Add1(n I32) I32 { return n + 1 }' > remote/example.com/me/tools/mathx/add.olang") == 0
                 "writing the repository", dir)
    try r.expect(sh($dir "/remote/example.com/me/tools", "git init -q && git add . && " $git " commit -qm v1") == 0
                 "committing the repository", dir)
    try r.expect(sh($dir "/missing", $env "\"$OLANG\" build p.olang > out.txt 2>&1") != 0
                 "a missing commit built", $dir "/missing")
    try r.expect(outOf($dir "/missing").Contains("could not fetch the commit olang.lock names")
                 "missing commit", $dir "/missing")
    try r.expect(sh(dir, "test -z \"$(ls -A cache/example.com/me/tools)\"") == 0, "a failed fetch left something", dir)
}

# B3/M22a: an object is named by what it is built from - every module's identity and real path in what it is compiled
# against - so two modules whose readable names coincide, two roots of one file name outside the working directory,
# and one module compiled against two commits of a remote repository each have objects of their own. And a symbol is
# named injectively: "geom/rect" and "geom_rect" are two modules of one program, as are module "a" naming "b_c" and
# module "a/b" naming "c". Each of these reused another's object, or failed to link
test "objects and symbols are named by what they are built from" { assert passed("objnames") }

fn objnames(r mut report&) ? Failed {
    dir := fresh("objnames")
    os.Run("cp -r checks/fixtures/objnames/. " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build app1.olang > out.txt 2>&1 && ./build/app1 > out.txt") == 0, "app1", dir)
    try r.expect(outOf(dir) == "app1 1\n", "app1 output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build app2.olang > out.txt 2>&1 && ./build/app2 > out.txt") == 0, "app2", dir)
    try r.expect(outOf(dir) == "app2 2\n", "app2 output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build both.olang > out.txt 2>&1 && ./build/both > out.txt") == 0, "both", dir)
    try r.expect(outOf(dir) == "1 2\n", "both output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build syms.olang > out.txt 2>&1 && ./build/syms > out.txt") == 0, "syms", dir)
    try r.expect(outOf(dir) == "1 2\n", "syms output", dir)
    work String& = $dir "/work"
    for _ in range 2 {
        try r.expect(sh(work, "\"$OLANG\" build ../x/main.olang > out.txt 2>&1 && ./build/main > out.txt") == 0, "x", work)
        try r.expect(outOf(work) == "I am X\n", "x output", work)
        try r.expect(sh(work, "\"$OLANG\" build ../y/main.olang > out.txt 2>&1 && ./build/main > out.txt") == 0, "y", work)
        try r.expect(outOf(work) == "I am Y\n", "y output", work)
    }
}

# B3: an object built against one commit of a remote repository is not taken for one built against another - locked to
# a commit, moved to a newer one, and locked back, the program is the first one again (it used to keep the second's
# object, whose files were newer than the first commit's)
test "a program locked back to an older commit is built from it" { assert passed("remotestale") }

fn remotestale(r mut report&) ? Failed {
    dir := fresh("remotestale")
    repo String& = $dir "/remote/example.com/me/tools"
    env String& = "OLANG_GIT_BASE=file://" $dir "/remote/ OLANG_CACHE=" $dir "/cache "
    src String& = "checks/fixtures/remote/"
    try r.expect(os.Run("mkdir -p " $os.Quote(repo) " && cp -r " $src "mathx " $src "mathy " $os.Quote(repo)) == 0
                 "copying the repository", dir)
    try r.expect(os.Run("cp " $src "printed.olang " $os.Quote(dir)) == 0, "copying the program", dir)
    git String& = "git -c user.name=t -c user.email=t@t"
    try r.expect(sh(repo, "git init -q && git add . && " $git " commit -qm v1") == 0, "v1", dir)
    build String& = $env "\"$OLANG\" build printed.olang > out.txt 2>&1 && ./build/printed > out.txt"
    try r.expect(sh(dir, build) == 0, "first commit", dir)
    try r.expect(outOf(dir) == "2\n", "first commit output", dir)
    try r.expect(sh(dir, "cp olang.lock first.lock && rm olang.lock") == 0, "unlocking", dir)
    try r.expect(sh(repo, "sed -i 's/n + 1/n + 100/' mathy/inc.olang && " $git " commit -qam v2") == 0, "v2", dir)
    try r.expect(sh(dir, build) == 0, "second commit", dir)
    try r.expect(outOf(dir) == "101\n", "second commit output", dir)
    try r.expect(sh(dir, "cp first.lock olang.lock && " $build) == 0, "first commit again", dir)
    try r.expect(outOf(dir) == "2\n", "the second commit's objects were reused", dir)
}

# B3a: each file -t is given is a build of its own - one that is missing, or a directory, is reported and the rest run
test "-t runs every file it can, whatever another one is" { assert passed("ttolerant") }

fn ttolerant(r mut report&) ? Failed {
    dir := fresh("ttolerant")
    os.Run("cp checks/fixtures/ttolerant/* " $os.Quote(dir) " && mkdir " $os.Quote($dir "/adir"))
    try r.expect(sh(dir, "\"$OLANG\" test nosuch.olang t1.olang adir t2.olang > out.txt 2>&1") != 0, "-t passed", dir)
    try r.expect(outOf(dir).Contains("ok - one") and outOf(dir).Contains("ok - two"), "-t stopped early", dir)
    try r.expect(outOf(dir).Contains("nosuch.olang: error: cannot open this file") and outOf(dir).Contains("adir: error[M1]: a directory"), "-t reports", dir)
}

# B3a: each listed file is built in a process of its own, so the compiler ending on one - here a crash, forced as the
# check below forces one, on a small stack with nesting that overflows it - ends that file's build alone, and the files
# after it still run. The stack is 1MB: the prelude's own tests, which every test build checks, need about 260KB of it
test "-t goes on past a file the compiler crashed on" { assert passed("tcrash") }

fn tcrash(r mut report&) ? Failed {
    dir := fresh("tcrash")
    os.Run("cp checks/fixtures/ttolerant/* " $os.Quote(dir))
    deep String& = nested("fn main() ? {\n    x := ", "(", "1", ")", "\n}\n", 5000)
    try os.WriteFile($dir "/deep.olang", deep) catch { }
    # (the status is kept in a file, so the shell that saw a crash is not the one that reports it)
    run String& = "( (ulimit -v 800000 && ulimit -s 1024 && \"$OLANG\" test t1.olang deep.olang t2.olang) > out.txt 2>&1; echo $? > rc.txt ) 2> /dev/null"
    try r.expect(sh(dir, $run " && test $(cat rc.txt) -eq 1") == 0
                 "-t did not fail for the crash, or crashed itself", dir)
    out := outOf(dir)
    try r.expect(out.Contains("internal compiler error") and out.Contains("deep.olang: the compiler ended")
                 "crash", dir)
    try r.expect(out.Contains("ok - one") and out.Contains("ok - two"), "-t stopped at the crash", dir)
}

# B3: a program's link is an argument list, never one command line cut to a fixed length - forty modules with 200-byte
# names used to lose the end of it
test "a program of many long-named modules links" { assert passed("manymods") }

fn manymods(r mut report&) ? Failed {
    dir := fresh("manymods")
    long String& = "_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    app := StringBuilder()
    app.Push("import \"std/io\"\n")
    for i in range 40 {
        name String& = "m" $i $long
        try os.WriteFile($dir "/" $name ".olang", "fn F() I32 { return " $i " }\n") catch { try r.failed("writing " $name, dir) }
        app.Push("import m" $i " \"" $name "\"\n")
    }
    app.Push("fn main() ? io.Error {\n    s := 0\n")
    for i in range 40 { app.Push("    s = s + m" $i ".F()\n") }
    app.Push("    try io.Print($s \"\\n\")\n}\n")
    try os.WriteFile($dir "/app.olang", app.ToString()) catch { try r.failed("writing app.olang", dir) }
    try r.expect(sh(dir, "\"$OLANG\" build app.olang > out.txt 2>&1 && ./build/app > out.txt") == 0, "many modules", dir)
    try r.expect(outOf(dir) == "780\n", "many modules output", dir)
}

# B1: every diagnostic is written to one stream, the unknown flag's included (its first half used to go to the other);
# and a crash of the compiler itself says so, even one that has run out of stack - here forced by running it on a small
# one: the address-space limit leaves no room for the large stack it asks for, so it runs on the one ulimit gives it
test "diagnostics are on one stream, and a crash says so" { assert passed("diag") }

fn diag(r mut report&) ? Failed {
    dir := fresh("diag")
    try r.expect(sh(dir, "\"$OLANG\" build -r x.olang > out.txt 2> err.txt") != 0, "-r was taken", dir)
    try r.expect(outOf(dir).Contains("olang: error[B1]: unknown option '-r'") and sh(dir, "test ! -s err.txt") == 0, "unknown option", dir)
    deep String& = nested("fn main() ? {\n    x := ", "(", "1", ")", "\n}\n", 5000)
    try os.WriteFile($dir "/deep.olang", deep) catch { }
    # (the status is kept in a file, so the shell that saw the crash is not the one that reports it)
    crash String& = "( (ulimit -v 800000 && ulimit -s 256 && \"$OLANG\" compile deep.olang) > out.txt 2>&1; echo $? > rc.txt ) 2> /dev/null"
    try r.expect(sh(dir, $crash " && test $(cat rc.txt) -ne 0") == 0, "the crash did not fail", dir)
    try r.expect(outOf(dir).Contains("internal compiler error"), "a crash was silent", dir)
}

# M23: what a program means does not depend on the directory it is compiled from - a module imported as "../x" imports
# its own neighbour, built from the directory above it or from the one below
test "a module outside the working directory imports its neighbours" { assert passed("updir") }

fn updir(r mut report&) ? Failed {
    dir := fresh("updir")
    os.Run("cp -r checks/fixtures/updir/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build sub/main.olang > out.txt 2>&1 && ./build/sub_main > out.txt") == 0, "from above", dir)
    try r.expect(outOf(dir) == "7\n", "from above: expected 7", dir)
    try r.expect(sh(dir, "cd sub && \"$OLANG\" build main.olang > ../out.txt 2>&1 && ./build/main > ../out.txt") == 0
                 "from below", dir)
    try r.expect(outOf(dir) == "7\n", "from below: expected 7", dir)
}

# M1/M22: a module is a file - a directory is not one, and files in one directory see each other only
# through imports
test "a directory groups files and is never a module" { assert passed("pkg") }

fn pkg(r mut report&) ? Failed {
    dir := fresh("pkg")
    os.Run("cp -r checks/fixtures/pkg " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" compile pkg/one.olang > out.txt 2>&1") == 0, "-c on a file in a directory", dir)
    try r.expect(sh(dir, "\"$OLANG\" test pkg/one.olang > out.txt 2>&1") == 0, "-t on a file in a directory", dir)
    try r.expect(outOf(dir).Contains("1 passed"), "-t on a file in a directory: expected '1 passed'", dir)
    try r.expect(sh(dir, "\"$OLANG\" test pkg > out.txt 2>&1") != 0, "-t on a directory passed", dir)
    try r.expect(outOf(dir).Contains("pkg: error[M1]: a directory"), "-t on a directory: expected 'pkg: error[M1]: a directory'", dir)
    try r.expect(sh(dir, "\"$OLANG\" compile pkg/three.olang > out.txt 2>&1") != 0, "pkg/three.olang compiled", dir)
    try r.expect(outOf(dir).Contains("unknown"), "pkg/three.olang: expected 'unknown'", dir)
}

# B10b: only a module whose import closure mentions a -D name is rebuilt when that value changes
test "a -D value rebuilds only the modules that mention it" { assert passed("stale") }

fn stale(r mut report&) ? Failed {
    dir := fresh("stale")
    os.Run("cp checks/fixtures/stale/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build -define Level=1 -define Want=2 uses.olang > out.txt 2>&1 && ./build/uses") == 0
                 "first build", dir)
    try r.expect(sh(dir, "stat -c %Y.%N build/plain.*.o > before.txt && ls build/uses.*.main.o | wc -l > first.txt") == 0
                 "reading the first build's objects", dir)
    try r.expect(sh(dir, "sleep 1 && \"$OLANG\" build -define Level=5 -define Want=6 uses.olang > out.txt 2>&1 && ./build/uses") == 0
                 "second build", dir)
    try r.expect(sh(dir, "stat -c %Y.%N build/plain.*.o | cmp -s - before.txt") == 0, "plain's object was rebuilt", dir)
    try r.expect(sh(dir, "test $(ls build/uses.*.main.o | wc -l) -gt $(cat first.txt)") == 0
                 "uses was not rebuilt", dir)
}

# B3i: a module none of whose inputs changed is neither lowered nor written again, its IR taken from its record - and
# the program so built is the one written afresh: OLANG_CHECKREUSE emits it again with nothing reused and compares every
# object, ending the build with 3 where one differs
test "an unchanged module's object is reused, and the program is the one written afresh" { assert passed("reuse") }

fn reuse(r mut report&) ? Failed {
    dir := fresh("reuse")
    os.Run("cp checks/fixtures/reuse/* " $os.Quote(dir))
    same := "modules reused, every object the same"
    try r.expect(sh(dir, "\"$OLANG\" build app.olang > out.txt 2>&1 && ./build/app > run.txt") == 0, "first build", dir)
    try r.expect(sh(dir, "grep -qx 'app 30 3' run.txt && ls build/rec/lib.* build/rec/leaf.* > /dev/null") == 0
                 "the first build's output, or the records of lib and leaf", dir)
    # the root edited: every other module reused
    try r.expect(sh(dir, "echo 'fn unused() I64 { return 1 }' >> app.olang && OLANG_CHECKREUSE=1 \"$OLANG\" build " $
                    "app.olang > out.txt 2>&1 && ./build/app > run.txt") == 0, "the build after the root's edit", dir)
    try r.expect(outOf(dir).Contains(same) and sh(dir, "grep -qx 'app 30 3' run.txt") == 0, "the build after the root's edit", dir)
    # leaf edited: leaf and lib, which imports it, written again, and what they compute now the program's
    try r.expect(sh(dir, "sed -i 's/i \\* 10/i * 100/' leaf.olang && OLANG_CHECKREUSE=1 \"$OLANG\" build app.olang > " $
                    "out.txt 2>&1 && ./build/app > run.txt") == 0, "the build after leaf's edit", dir)
    try r.expect(outOf(dir).Contains(same) and sh(dir, "grep -qx 'app 300 3' run.txt") == 0, "the build after leaf's edit", dir)
    # another program importing lib reuses the object app's build left
    try r.expect(sh(dir, "OLANG_CHECKREUSE=1 \"$OLANG\" build other.olang > out.txt 2>&1 && ./build/other > run.txt") == 0
                 "other's build", dir)
    try r.expect(outOf(dir).Contains(same) and sh(dir, "grep -qx 'other 1000' run.txt") == 0, "other's build", dir)
    # T32a: a table's default slot an importer starts calling through an any after the module that made the table was
    # built - its slot is the root's, so the reused object of anylib still reaches the default (it reached an
    # "unreachable" when the slot was in anylib's object)
    try r.expect(sh(dir, "\"$OLANG\" build anyapp.olang > out.txt 2>&1 && ./build/anyapp > run.txt") == 0, "anyapp's build", dir)
    try r.expect(sh(dir, "sed -i 's/^}$/    try io.Println(\"count \" $anylib.Make(5).Count(fn(x I64) Bool { return x > 2 })) " $
                    "catch { }\\n}/' anyapp.olang && OLANG_CHECKREUSE=1 \"$OLANG\" build anyapp.olang > out.txt 2>&1 && " $
                    "./build/anyapp > run.txt") == 0, "anyapp's build calling Count through the any", dir)
    try r.expect(outOf(dir).Contains(same) and sh(dir, "grep -qx 'count 3' run.txt") == 0, "anyapp's run calling Count", dir)
}

# E38, B3i: an embedded file is part of what its module's object is made from - a build after it changes makes that
# object again, with the new bytes, baked and read alike - and inside std an embed may not leave it
test "an embedded file changed rebuilds what embeds it; an embed in std stays in std" { assert passed("embed") }

fn embedded(r mut report&) ? Failed {
    dir := fresh("embed")
    os.Run("cp checks/fixtures/embed/* " $os.Quote(dir))
    same := "modules reused, every object the same"
    try r.expect(sh(dir, "\"$OLANG\" build app.olang > out.txt 2>&1 && ./build/app > run.txt") == 0, "first build", dir)
    try r.expect(sh(dir, "grep -qx 'lib 19 19' run.txt") == 0, "the first build's output", dir)
    # the file edited, nothing else: lib's object made again from it (CHECKREUSE says a stale reuse)
    try r.expect(sh(dir, "echo 'pink 100' >> data.txt && OLANG_CHECKREUSE=1 \"$OLANG\" build app.olang > out.txt 2>&1 " $
                    "&& ./build/app > run.txt") == 0, "the build after data.txt's edit", dir)
    try r.expect(outOf(dir).Contains(same) and sh(dir, "grep -qx 'lib 119 119' run.txt") == 0
                 "the build after data.txt's edit", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret app.olang > out.txt 2>&1") == 0 and outOf(dir) == "lib 119 119\n"
                 "interpret after data.txt's edit", dir)
    # a module of std embedding what is outside it
    try r.expect(sh(dir, "mkdir -p s && cp -r " $os.Quote($root() "/std") " s/std && echo 'X := embed \"../outside.txt\"' > " $
                    "s/std/leak.olang && echo x > s/outside.txt && OLANG_STD=$PWD/s/std \"$OLANG\" build leaks.olang > out.txt " $
                    "2>&1") != 0, "std/leak embedding outside std built", dir)
    try r.expect(outOf(dir).Contains("error[E38]: embed '../outside.txt' reads no file: it leaves std"), "std/leak's error", dir)
    # ...nor through a link inside it, named by its real path (the bulk review's F7)
    try r.expect(sh(dir, "ln -s ../outside.txt s/std/link.txt && echo 'X := embed \"link.txt\"' > s/std/leak.olang && " $
                    "OLANG_STD=$PWD/s/std \"$OLANG\" build leaks.olang > out.txt 2>&1") != 0, "std/leak embedding a link built", dir)
    try r.expect(outOf(dir).Contains("error[E38]: embed 'link.txt' reads no file: it leaves std, through a link"), "std/leak's link error", dir)
    # a remote repository's module: a file of its own embedded, a link to one outside refused
    repo String& = $dir "/remote/example.com/me/tools"
    env String& = "OLANG_GIT_BASE=file://" $dir "/remote/ OLANG_CACHE=" $dir "/cache "
    git String& = "git -c user.name=t -c user.email=t@t"
    try r.expect(os.Run("mkdir -p " $os.Quote($repo "/lib")) == 0, "making the repository", dir)
    try r.expect(sh(repo, "echo inside > lib/ok.txt && ln -s " $os.Quote($dir "/s/outside.txt") " lib/data.txt && " $
                    "echo 'Data := String(embed \"data.txt\")' > lib/peek.olang && echo 'Ok := String(embed \"ok.txt\")' > lib/good.olang && " $
                    "git init -q && git add . && " $git " commit -qm v1") == 0, "the repository", dir)
    try r.expect(sh(dir, "printf 'import \"std/io\"\\nimport \"example.com/me/tools/lib/good\"\\nfn main() { io.Print(good.Ok)! }\\n' > good.olang && " $
                    "printf 'import \"std/io\"\\nimport \"example.com/me/tools/lib/peek\"\\nfn main() { io.Print(peek.Data)! }\\n' > peek.olang") == 0
                 "the programs", dir)
    try r.expect(sh(dir, $env "\"$OLANG\" build good.olang > out.txt 2>&1 && ./build/good > out.txt") == 0 and outOf(dir) == "inside\n"
                 "a remote module embedding a file of its repository", dir)
    try r.expect(sh(dir, $env "\"$OLANG\" build peek.olang > out.txt 2>&1") != 0, "a remote module embedding a link out of it built", dir)
    try r.expect(outOf(dir).Contains("error[E38]: embed 'data.txt' reads no file: it leaves example.com/me/tools, through a link")
                 "the remote link's error", dir)
}

# B3e: -i runs a program as the built program runs - the same output, exit status and report of an error escaping
# main; it stops, saying where, at what the built program leaves undefined, and at what it does not run yet (tasks)
test "-i interprets a program as the built program runs" { assert passed("interp") }

fn interp(r mut report&) ? Failed {
    dir := fresh("interp")
    os.Run("cp checks/fixtures/interp/* " $os.Quote(dir))
    # built -debug, so the error escaping main prints its trace as -i does (S18d)
    try r.expect(sh(dir, "\"$OLANG\" build -debug prog.olang > out.txt 2>&1") == 0, "interp build", dir)
    try r.expect(sh(dir, "./build/prog.debug > want.txt 2>&1") == 1, "prog did not end in Oops.BAD", dir)   # main ends in Oops.BAD
    try r.expect(sh(dir, "\"$OLANG\" interpret prog.olang > out.txt 2>&1") == 1, "-i prog.olang did not end in Oops.BAD", dir)
    try r.expect(sh(dir, "cmp -s want.txt out.txt") == 0, "-i printed what the built program did not", dir)
    try r.expect(outOf(dir).Contains("unhandled error: Oops.BAD") and outOf(dir).Contains("read written 10 -1")
                 "-i prog.olang output", dir)
    # B3e: what a build refuses is not run - section 8's errors reported as a build reports them
    try r.expect(sh(dir, "\"$OLANG\" interpret refused.olang > out.txt 2>&1") == 1, "-i refused.olang ran", dir)
    try r.expect(outOf(dir).Contains("error[O10c]") and not outOf(dir).Contains("assertion"), "-i refused.olang output", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret ub.olang > out.txt 2>&1") == 1, "-i ub.olang did not stop", dir)
    try r.expect(outOf(dir).Contains("ub.olang:6: it indexes outside the array"), "-i ub.olang output", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret cyclic.olang > out.txt 2>&1") == 1, "-i cyclic.olang did not stop", dir)
    try r.expect(outOf(dir).Contains("cyclic.olang:9: the comparison recurses deeper than interpret allows")
                 "-i cyclic.olang output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build tasks.olang > out.txt 2>&1 && ./build/tasks > want.txt 2>&1") == 0, "tasks build", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret tasks.olang > out.txt 2>&1") == 0, "-i tasks.olang failed", dir)
    try r.expect(sh(dir, "cmp -s want.txt out.txt") == 0, "-i ran tasks.olang unlike the built program", dir)
    try r.expect(outOf(dir) == "squares I64[1, 4, 9, 16]\nsum 10\ncleanup ran\n", "-i tasks.olang output", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret tasks.olang x > out.txt 2>&1") == 1, "-i tasks.olang x did not stop", dir)
    try r.expect(outOf(dir).Contains("sum 10\ncleanup ran\nolang interpret: ") and outOf(dir).Contains(": it waits for another task") and
                 outOf(dir).Contains("in the task spawned at tasks.olang:39"), "-i tasks.olang x output", dir)
    # ... and every block a stop is in, in every frame, runs its deferred code as it leaves, innermost first
    try r.expect(sh(dir, "\"$OLANG\" interpret defers.olang > out.txt 2>&1") == 1, "-i defers.olang did not stop", dir)
    try r.expect(outOf(dir) == ("reach's\nturn 0\nreach's\nturn 1\nreach's\nturn 2\nreach's\nturn 3\nwalk's block\nwalk's\n" $
                                "main's second\nmain's first\nolang interpret: defers.olang:10: it indexes outside the " $
                                "array, which is undefined at run time\n"), "-i defers.olang output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build ends.olang > out.txt 2>&1 && ./build/ends > want.txt 2>&1") == 134
                 "ends did not abort", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret ends.olang > out.txt 2>&1") == 134, "-i ends.olang did not abort", dir)
    try r.expect(sh(dir, "cmp -s want.txt out.txt") == 0, "-i ended unlike the built program", dir)
    # X6: os.Exec runs a program through __olang_spawn, which -i provides itself; std/json the same either way
    try r.expect(sh(dir, "\"$OLANG\" build exec.olang > out.txt 2>&1 && ./build/exec > want.txt 2>&1") == 0, "exec build", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret exec.olang > out.txt 2>&1") == 0, "-i exec.olang failed", dir)
    try r.expect(sh(dir, "cmp -s want.txt out.txt") == 0, "-i ran exec.olang unlike the built program", dir)
    try r.expect(outOf(dir).Contains("4 [fed in] [err") and outOf(dir).Contains("missing yes") and
                 outOf(dir).Contains("in /\nlate yes [started] 137\n"), "-i exec.olang output", dir)
}

# B4a/B3f/X6: a program reads its command line and environment through the runtime, and std/os's file calls work -
# built and run, and interpreted, it prints the same; under -i what follows the file is the program's command line,
# flags included, and its own name is the file
test "a program reads its arguments and environment, and uses the file system" { assert passed("osargs") }

fn osargs(r mut report&) ? Failed {
    dir := fresh("osargs")
    os.Run("cp checks/fixtures/osargs/* " $os.Quote(dir))
    args String& = " one 'two words' -x > out.txt 2>&1"
    try r.expect(sh(dir, "\"$OLANG\" build osargs.olang > out.txt 2>&1") == 0, "osargs build", dir)
    try r.expect(sh(dir, "OLANG_CHECK_VALUE=hi ./build/osargs" $args " && cp out.txt want.txt") == 0, "osargs", dir)
    try r.expect(outOf(dir).Contains("program: ./build/osargs\n3 arguments, 3 seen by a global\n[one]\n[two words]\n[-x]\n")
                 "osargs output: the command line", dir)
    try r.expect(outOf(dir).Contains("value: hi\nsize 5 file true dated true\nin work/a: b\nin work/a: g.txt\n")
                 "osargs output: the environment and the files", dir)
    try r.expect(sh(dir, "rm -rf work && OLANG_CHECK_VALUE=hi \"$OLANG\" interpret osargs.olang" $args) == 0, "osargs -i", dir)
    try r.expect(outOf(dir).Contains("program: osargs.olang\n"), "osargs -i: expected 'program: osargs.olang'", dir)
    try r.expect(sh(dir, "tail -n +2 want.txt > w.txt && tail -n +2 out.txt | cmp -s w.txt -") == 0, "-i differs", dir)
    try r.expect(sh(dir, "rm -rf work && ./build/osargs > out.txt 2>&1") == 0, "osargs with no arguments", dir)
    try r.expect(outOf(dir).Contains("0 arguments, 0 seen by a global\nvalue: unset\n")
                 "osargs output with no arguments", dir)
}

# B5b: os.Exit ends the process with the status it is given, built and interpreted alike, after what was written
test "os.Exit ends the process with its status" { assert passed("osexit") }

fn osexit(r mut report&) ? Failed {
    dir := fresh("osexit")
    os.Run("cp checks/fixtures/osexit/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build osexit.olang > out.txt 2>&1 && ./build/osexit > out.txt 2>&1") == 42
                 "osexit", dir)
    try r.expect(outOf(dir) == "before\n", "osexit output", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret osexit.olang > out.txt 2>&1") == 42, "osexit -i", dir)
    try r.expect(outOf(dir) == "before\n", "osexit -i output", dir)
}

# M19f: io.Print, Println, PrintErr and PrintErrln write to the standard output and error, built and interpreted alike -
# and a write that fails is an io.Error like any other
test "io.Print and io.Println write, and fail with io.Error when the write fails" { assert passed("print") }

fn printing(r mut report&) ? Failed {
    dir := fresh("print")
    os.Run("cp checks/fixtures/print/* " $os.Quote(dir))
    out := "n is 42\njoined 42 and 43\n\nthrough a value\n"
    try r.expect(sh(dir, "\"$OLANG\" build print.olang > out.txt 2>&1 && ./build/print > out.txt 2> err.txt") == 0
                 "print", dir)
    try r.expect(outOf(dir) == out, "print: the standard output", dir)
    try r.expect((try os.ReadFile($dir "/err.txt") catch default "") == "to the standard error\n"
                 "print: the standard error", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret print.olang > out.txt 2> err.txt") == 0, "print -i", dir)
    try r.expect(outOf(dir) == out, "print -i: the standard output", dir)
    try r.expect(sh(dir, "./build/print >&- 2> out.txt") == 1, "print to a closed output fails", dir)
    try r.expect(outOf(dir).StartsWith("unhandled error: io.Error.FAILED\n"), "print to a closed output: the error", dir)
}

# B19, B19a: a test fuzzed by libFuzzer finds the planted bug within seconds and saves its input beside the file, which
# a plain test run replays and fails on; under -sanitize too; a word naming no test, and -fuzztime alone, are errors. A
# property's failing case is shrunk to its smallest input, printed, saved and replayed
test "olang test -fuzz finds a planted bug, and the test replays it" { assert passed("testfuzz") }

fn testfuzz(r mut report&) ? Failed {
    dir := fresh("testfuzz")
    os.Run("cp checks/fixtures/testfuzz/* " $os.Quote(dir))
    saved := "testdata/fuzz/parse_never_fails_a_check"
    try r.expect(sh(dir, "\"$OLANG\" test parse.olang > out.txt 2>&1") == 0, "the fuzz test passed on the empty input", dir)
    ran := sh(dir, "\"$OLANG\" test -fuzz parse -fuzztime 120 parse.olang > out.txt 2>&1")
    try r.expect(ran == 1 and outOf(dir).Contains("assertion failed: planted bug reached") and
                 outOf(dir).Contains($"an input failed, saved in " $saved "/"), "the planted bug found", dir)
    try r.expect(sh(dir, "ls " $saved " | grep -q crash-") == 0, "the failing input saved", dir)
    ran = sh(dir, "\"$OLANG\" test parse.olang > out.txt 2>&1")
    replayed := outOf(dir).Contains($"fuzz: replaying " $saved "/crash-") and outOf(dir).Contains("ok - plain")
    try r.expect(ran == 1 and replayed and outOf(dir).Contains("FAIL - parse: never fails a check"), "the input replayed", dir)
    os.Run("rm -rf " $os.Quote($dir "/testdata"))
    ran = sh(dir, "\"$OLANG\" test -sanitize -fuzz never -fuzztime 120 parse.olang > out.txt 2>&1")
    try r.expect(ran == 1 and outOf(dir).Contains("assertion failed: planted bug reached"), "-sanitize -fuzz", dir)
    ran = sh(dir, "\"$OLANG\" test -fuzz nosuch parse.olang > out.txt 2>&1")
    try r.expect(ran == 1 and outOf(dir).Contains("error[B19]: -fuzz nosuch names no test of this file"), "-fuzz naming no test", dir)
    ran = sh(dir, "\"$OLANG\" test -fuzztime 3 parse.olang > out.txt 2>&1")
    try r.expect(ran == 1 and outOf(dir).Contains("error[B19]: -fuzztime says how long -fuzz runs"), "-fuzztime alone", dir)
    ran = sh(dir, "\"$OLANG\" test planted.olang > out.txt 2>&1")
    try r.expect(ran == 1 and outOf(dir).Contains("prop: a failing case, shrunk to:\n  argument 1: I64[50]\n  argument 2: Pt(0, 0)\n") and
                 outOf(dir).Contains("assertion failed: an element of 50 or more"), "a property's failing case shrunk", dir)
    ran = sh(dir, "\"$OLANG\" test planted.olang > out.txt 2>&1")
    replayed = outOf(dir).Contains("prop: replaying testdata/fuzz/every_element_below_50/input-")
    try r.expect(ran == 1 and replayed, "a property's saved case replayed", dir)
}

# B20: olang profile builds the program with the sampler, runs it with its arguments and status, and names where the time
# went - the hottest function first, a method by its type, a spawned task's function under the task, the hot lines - and
# writes a flame graph (where -output says); a plain build carries none of the sampler, and options that do not apply
# are refused
test "olang profile names the hot function, its line and its callers" { assert passed("profile") }

fn profiled(r mut report&) ? Failed {
    dir := fresh("profile")
    os.Run("cp checks/fixtures/profile/* " $os.Quote(dir))
    ran := sh(dir, "\"$OLANG\" profile hot.olang 7 > out.txt 2>&1")
    out := outOf(dir)
    try r.expect(ran == 7, "the program's own status", dir)
    try r.expect(out.Contains("\nolang profile: hot - ") and out.Contains(" s of CPU time on 2 threads\n"), "what was sampled", dir)
    rows := try out.Find("   self   total  function\n") catch default -1
    first := out[rows + 26:] if rows >= 0 else ""
    firstLine := first[:(try first.Find("\n") catch default 0)]
    try r.expect(firstLine.EndsWith("  burn"), "the hottest function first", dir)
    try r.expect(out.Contains("%  Counter.Tick\n"), "a method by its type", dir)
    try r.expect(lineAfter(out, "%  hot.olang:9 ").Trim() == "burn", "the hottest line", dir)
    try r.expect(out.Contains("  burn  <-  main 100.0%\n") and out.Contains("  spin  <-  task 100.0%\n"), "the callers", dir)
    try r.expect(out.Contains("flame graph: ./build/profile/hot.html") and
                 sh(dir, "grep -q '<title>burn - ' build/profile/hot.html") == 0, "the flame graph", dir)
    try r.expect(sh(dir, "\"$OLANG\" profile -output fg.html hot.olang > out.txt 2>&1") == 0 and
                 sh(dir, "grep -q '<title>Counter.Tick - ' fg.html") == 0, "-output names the flame graph", dir)
    # nothing of the sampler in any other build: not its functions, not its frame pointers' attribute
    try r.expect(sh(dir, "\"$OLANG\" build hot.olang > out.txt 2>&1") == 0 and sh(dir, "nm build/hot | grep -q __olang_prof") != 0 and
                 sh(dir, "nm build/hot.prof | grep -q __olang_prof_handler") == 0 and
                 sh(dir, "grep -l frame-pointer build/*.ll | grep -qv '[.]prof[.]ll$'") != 0, "a plain build carries no sampler", dir)
    try r.expect(sh(dir, "\"$OLANG\" profile -target aarch64 hot.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("-target applies to"), "-target refused", dir)
    try r.expect(sh(dir, "\"$OLANG\" help profile > out.txt 2>&1") == 0 and outOf(dir).Contains("  -quick") and
                 not outOf(dir).Contains("-race"), "help profile", dir)
}

# S18a: a failed assert or unreachable says where it is - and an assert the message written after it - built,
# interpreted, and inside a test before the FAIL line
test "a failed check says where it is" { assert passed("assertloc") }

fn assertloc(r mut report&) ? Failed {
    dir := fresh("assertloc")
    os.Run("cp checks/fixtures/assertloc/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build located.olang > out.txt 2>&1") == 0, "located did not build", dir)
    # the shell adds its own "Aborted" line after what the program printed
    try r.expect(sh(dir, "./build/located > out.txt 2>&1") == 134 and
                 outOf(dir).StartsWith("located.olang:8: assertion failed: n is 1\n"), "an assert's location and message", dir)
    try r.expect(sh(dir, "./build/located a > out.txt 2>&1") == 134 and
                 outOf(dir).StartsWith("located.olang:6: unreachable reached\n"), "the first unreachable's location", dir)
    try r.expect(sh(dir, "./build/located a b > out.txt 2>&1") == 134 and
                 outOf(dir).StartsWith("located.olang:7: unreachable reached\n"), "an unreachable's location", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret located.olang > out.txt 2>&1") == 134 and
                 outOf(dir).StartsWith("located.olang:8: assertion failed: n is 1\n"), "-i: an assert's location and message", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret located.olang a b > out.txt 2>&1") == 134 and
                 outOf(dir).StartsWith("located.olang:7: unreachable reached\n"), "-i: an unreachable's location", dir)
    # and a check the language guarantees - a slice, an array length, an 'as' under '!' (a copy into fixed storage is never
    # checked: its length is known while compiling, T7d)
    try r.expect(sh(dir, "\"$OLANG\" build guaranteed.olang > out.txt 2>&1") == 0, "guaranteed did not build", dir)
    wants := String&["guaranteed.olang:15: slice bounds out of range\n", "guaranteed.olang:16: array length out of range\n"
                     "guaranteed.olang:19: CaseError.WRONG_CASE\n", "guaranteed.olang:21: null reached\n"
                     "guaranteed.olang:17: lane lengths differ\n"]
    args := String&["", " a", " a b", " a b c", " a b c d e"]
    for i, w in wants {
        try r.expect(sh(dir, "./build/guaranteed" $args[i] " > out.txt 2>&1") == 134 and outOf(dir).StartsWith(w), w, dir)
        try r.expect(sh(dir, "\"$OLANG\" interpret guaranteed.olang" $args[i] " > out.txt 2>&1") == 134 and
                     outOf(dir).StartsWith(w), "-i: " $w, dir)
    }
    # T20, R3a: raising a null error - a held error value saying "no error"
    try r.expect(sh(dir, "\"$OLANG\" build nullerror.olang > out.txt 2>&1") == 0, "nullerror did not build", dir)
    try r.expect(sh(dir, "./build/nullerror > out.txt 2>&1") == 134 and
                 outOf(dir).StartsWith("nullerror.olang:4: raised a null error\n"), "a null error raised", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret nullerror.olang > out.txt 2>&1") == 134 and
                 outOf(dir).StartsWith("nullerror.olang:4: raised a null error\n"), "-i: a null error raised", dir)
    # B7a: a test naming a target is reported by it; words after the file pick the tests to run
    ran := sh(dir, "\"$OLANG\" test targets.olang > out.txt 2>&1")
    all := outOf(dir)
    try r.expect(ran == 1 and all.Contains("ok - twice: doubles\n") and all.Contains("FAIL - twice: fails on purpose\n") and
                 all.Contains("ok - Box.Get: gives its value\n") and all.Contains("4 passed, 1 failed"), "a test's target", dir)
    ran = sh(dir, "\"$OLANG\" test targets.olang Box > out.txt 2>&1")
    picked String& = "ok - Box: holds a value\nok - Box.Get: gives its value\n2 passed, 0 failed"
    try r.expect(ran == 0 and outOf(dir).Contains(picked), "a type's tests picked, its methods' with them", dir)
    ran = sh(dir, "\"$OLANG\" test targets.olang plain Box.Get > out.txt 2>&1")
    picked = "ok - Box.Get: gives its value\nok - a plain one\n2 passed, 0 failed"
    try r.expect(ran == 0 and outOf(dir).Contains(picked), "a method's tests and a description's text picked", dir)
    # B7a: words naming no test fail the run, the nearest target or description suggested
    ran = sh(dir, "\"$OLANG\" test targets.olang Bax > out.txt 2>&1")
    nearest := outOf(dir).Contains("targets.olang: no test is named by 'Bax' - did you mean 'Box'?")
    try r.expect(ran == 3 and nearest, "a word naming no test, and the nearest", dir)
    ran = sh(dir, "\"$OLANG\" test targets.olang nosuch > out.txt 2>&1")
    try r.expect(ran == 3 and outOf(dir).Contains("targets.olang: no test is named by 'nosuch'\n"), "a word naming nothing near", dir)
    # B3a: over several files the words fail the run only where no listed file has a test they name
    ran = sh(dir, "\"$OLANG\" test targets.olang others.olang Box > out.txt 2>&1")
    some := outOf(dir)
    try r.expect(ran == 0 and some.Contains("ok - Box: holds a value\n") and
                 some.Contains("others.olang: no test is named by 'Box'\n"), "a word one listed file's tests answer", dir)
    ran = sh(dir, "\"$OLANG\" test targets.olang others.olang Bax > out.txt 2>&1")
    try r.expect(ran == 1 and outOf(dir).Contains("no listed file has a test named by 'Bax'\n"), "a word no listed file answers", dir)
    try r.expect(sh(dir, "\"$OLANG\" test tested.olang > out.txt 2>&1") == 1, "the failing tests passed", dir)
    want String& = "tested.olang:5: assertion failed: Seed is 1\nFAIL - located\ntested.olang:9: assertion failed\nFAIL - plain\n"
    try r.expect(outOf(dir).Contains(want), "a test's failed asserts", dir)
}

# whether build output holds a line an extended regular expression matches (grep -E). An IR shape is checked as the
# fact it states; where the two compilers spell one fact differently - a global's symbol, a constant's value - the
# spellings are alternatives of one expression, so the check holds the port to what it held stage 0 to
fn irHas(dir String&, files String&, re String&) Bool { return sh(dir, "grep -qE " $os.Quote(re) " " $files) == 0 }

# a global's symbol as either compiler writes it: stage 0's MODULE_NAME, the port's G.MODULE.NAME escaped (B3b)
fn gsym(module String&, name String&) String { return "@(G_2e)?" $module "(_|_2e)" $name }

# S18c: an assert the compiler proves emits no run-time check at all
test "a proven assert leaves no run-time check" { assert passed("s18c") }

fn s18c(r mut report&) ? Failed {
    dir := fresh("s18c")
    os.Run("cp checks/fixtures/s18c/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build s18c.olang > out.txt 2>&1 && ./build/s18c") == 0, "s18c", dir)
    try r.expect(sh(dir, "grep -q assert.fail build/s18c.main.ll") != 0, "a proven assert left a run-time check", dir)
}

# T25b: a literal handed to a read-only reference is read-only data, not an arena copy - while a local, which is
# writable, still gets a copy of its own
test "a literal reaching a read-only reference is static data" { assert passed("static") }

fn static(r mut report&) ? Failed {
    dir := fresh("static")
    os.Run("cp checks/fixtures/static/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build -debug lit.olang > out.txt 2>&1 && ./build/lit.debug") == 0, "static", dir)
    ll String& = "build/lit.main.debug.ll"
    # O8d: constant data has a zero word before it, the "no region" every object's word before it is read as
    try r.expect(irHas(dir, ll, "constant (<\\{ i64, )?.3 x i32. (\\}> <\\{ i64 0, \\[3 x i32\\] )?.i32 3, i32 4, i32 5."), "no constant array", dir)
    try r.expect(irHas(dir, ll, "lit(_|_2e)total\\(ptr %[a-z0-9.]*, \\{ i64, ptr \\} \\{ i64 3, ptr (getelementptr inbounds \\(.*, ptr )?@\\.(arr|d)")
                 "lit_total was not handed the constant array", dir)
    try r.expect(irHas(dir, ll, "lit(_|_2e)lenOf\\(ptr %[a-z0-9.]*, \\{ i64, ptr \\} \\{ i64 11, ptr (getelementptr inbounds \\(.*, ptr )?@\\.(str|d)")
                 "lit_lenOf was not handed the constant text", dir)
    # E10: its site's address, unmerged
    try r.expect(irHas(dir, ll, "^@\\.(str\\.|d)[0-9]* = private constant (<\\{ i64, )?.11 x i8."), "the text's site was merged", dir)
}

# K2: a global computed at compile time is written out as data; one reading a mutable global is set at startup
test "computed globals are written out as data" { assert passed("k2") }

fn k2(r mut report&) ? Failed {
    dir := fresh("k2")
    os.Run("cp checks/fixtures/k2/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build ct.olang > out.txt 2>&1 && ./build/ct") == 0, "k2", dir)
    # what ct asserts at run time checks each baked value; here, that it was baked - written as data, constant where
    # immutable, its initializer not run at startup - or that it was not
    ll String& = "build/ct.main.ll"
    try r.expect(irHas(dir, ll, $gsym("ct", "Fib") " = constant (i32 610|<\\{ \\[4 x i8\\] \\}> <\\{ \\[4 x i8\\] c\"\\\\62\\\\02\\\\00\\\\00\" \\}>)"), "ct_Fib", dir)
    try r.expect(irHas(dir, ll, $gsym("ct", "Table") " = constant (\\{ i64, ptr \\} \\{ i64 4, ptr @ct_Table\\.k0 \\}|<\\{ \\[8 x i8\\], ptr \\}> <\\{ \\[8 x i8\\] c\"\\\\04(\\\\00){7}\", ptr @G_2ect_2eTable\\.k1 \\}>)"), "ct_Table", dir)
    # E10c: identity
    try r.expect(irHas(dir, ll, $gsym("ct", "Looped") " = constant (i1 true|<\\{ \\[1 x i8\\] \\}> <\\{ \\[1 x i8\\] c\"\\\\01\" \\}>)"), "ct_Looped", dir)
    # K2c: never destructs, so baked
    try r.expect(irHas(dir, ll, $gsym("ct", "Kept") " = constant (ptr|<\\{ ptr \\}> <\\{ ptr) @(G_2e)?ct(_|_2e)Kept\\.k[01]"), "ct_Kept", dir)
    # its temporary's destructor runs
    try r.expect(irHas(dir, ll, $gsym("ct", "Dropped") " = global i32 zeroinitializer"), "ct_Dropped", dir)
    try r.expect(irHas(dir, ll, $gsym("ct", "P") " = constant (%ct\\.CtPair \\{ i32 8, double 0x3FE0000000000000 \\}|<\\{ \\[16 x i8\\] \\}> <\\{ \\[16 x i8\\] c\"\\\\08(\\\\00){11}\\\\00\\\\00\\\\E0\\\\3F\" \\}>)"), "ct_P", dir)
    try r.expect(irHas(dir, ll, $gsym("ct", "Later") " = global i32 zeroinitializer"), "ct_Later", dir)
    # S19: deferred code run while compiling
    try r.expect(irHas(dir, ll, $gsym("ct", "Deferred") " = constant (i32 7|<\\{ \\[4 x i8\\] \\}> <\\{ \\[4 x i8\\] c\"\\\\07(\\\\00){3}\" \\}>)"), "ct_Deferred", dir)
    # K2: an immutable baked global is a constant, which an importer declares with its value when it is plain data
    tile String& = " = constant (i64 12|<\\{ \\[8 x i8\\] \\}> <\\{ \\[8 x i8\\] c\"\\\\0C(\\\\00){7}\" \\}>, align 8)$"
    try r.expect(irHas(dir, "build/ctlib.ll", "^" $gsym("ctlib", "Tile") $tile), "ctlib_Tile", dir)
    try r.expect(irHas(dir, ll, "^" $gsym("ctlib", "Tile") " = available_externally" $tile[2:]), "ctlib_Tile imported", dir)
    # T7d: an immutable global given a literal holds it in fixed storage, plain data; a reference global's storage is its own
    try r.expect(irHas(dir, ll, "^" $gsym("ctlib", "Tiles") " = available_externally constant <\\{ \\[16 x i8\\] \\}>"), "ctlib_Tiles imported", dir)
    try r.expect(irHas(dir, ll, "^" $gsym("ctlib", "Rows") " = external (global \\{ i64, ptr \\}|constant <\\{ \\[8 x i8\\], ptr \\}>)$"), "ctlib_Rows imported", dir)
    try r.expect(irHas(dir, ll, "^" $gsym("ctlib", "Counter") " = external global i64$"), "ctlib_Counter imported", dir)
    # a mutable global whose initializer is plain data computed while compiling: its first value written as its storage's
    try r.expect(irHas(dir, ll, "^" $gsym("ct", "seed") " = global (i32 3|<\\{ \\[4 x i8\\] \\}> <\\{ \\[4 x i8\\] c\"\\\\03(\\\\00){3}\" \\}>)"), "ct_seed", dir)
    # K2b: a referent only a read-only reference reaches is constant; an instance holding itself is written as itself
    try r.expect(irHas(dir, ll, $gsym("ct", "Table") "\\.k[01] = internal constant (\\[4 x i32\\] \\[ i32 55, i32 89, i32 144, i32 233 \\]|<\\{ \\[16 x i8\\] \\}> <\\{ \\[16 x i8\\] c\"\\\\37(\\\\00){3}\\\\59(\\\\00){3}\\\\90(\\\\00){3}\\\\E9(\\\\00){3}\" \\}>)"), "ct_Table.k0", dir)
    try r.expect(irHas(dir, ll, $gsym("ct", "Ring") "\\.k[01] = internal global (%ct\\.Node \\{ i32 1, ptr @ct_Ring\\.k0 \\}|<\\{ \\[8 x i8\\], ptr \\}> <\\{ \\[8 x i8\\] c\"\\\\01(\\\\00){7}\", ptr @G_2ect_2eRing\\.k1 \\}>)"), "ct_Ring.k0", dir)
    try r.expect(irHas(dir, ll, $gsym("ct", "Chain") " = constant (ptr|<\\{ ptr \\}> <\\{ ptr) @(G_2e)?ct(_|_2e)Chain\\.k[01]"), "ct_Chain", dir)
}

# E33: a NaN made from bits keeps them when a global holding it is written out as data - F32's in the double form
# LLVM reads back exactly, the 16-bit ones in their own; and a BF16's sign bit, read from memory, is its own under -d
# as under -b (LLVM 18's selection took it for a known zero, so the SignBit of the floats failed at -d and -r)
test "a NaN made from bits is written out with its bits, and a BF16's sign bit read from memory" { assert passed("bits") }

fn bits(r mut report&) ? Failed {
    dir := fresh("bits")
    os.Run("cp checks/fixtures/bits/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build bits.olang > out.txt 2>&1 && ./build/bits") == 0, "bits", dir)
    # each written with exactly its bits: as LLVM's typed constant, or as the bytes the evaluator laid out
    ll String& = "build/bits.main.ll"
    try r.expect(irHas(dir, ll, $gsym("bits", "GS") " = constant (float 0x7FF0000020000000|<\\{ \\[4 x i8\\] \\}> <\\{ \\[4 x i8\\] c\"\\\\01\\\\00\\\\80\\\\7F\" \\}>)"), "bits_GS", dir)
    try r.expect(irHas(dir, ll, $gsym("bits", "GQ") " = constant (double 0xFFF8000000000123|<\\{ \\[8 x i8\\] \\}> <\\{ \\[8 x i8\\] c\"\\\\23\\\\01\\\\00\\\\00\\\\00\\\\00\\\\F8\\\\FF\" \\}>)"), "bits_GQ", dir)
    try r.expect(irHas(dir, ll, $gsym("bits", "GH") " = constant (half 0xH7C01|<\\{ \\[2 x i8\\] \\}> <\\{ \\[2 x i8\\] c\"\\\\01\\\\7C\" \\}>)"), "bits_GH", dir)
    try r.expect(irHas(dir, ll, $gsym("bits", "GB") " = constant (bfloat 0xRFFC1|<\\{ \\[2 x i8\\] \\}> <\\{ \\[2 x i8\\] c\"\\\\C1\\\\FF\" \\}>)"), "bits_GB", dir)
    try r.expect(irHas(dir, ll, $gsym("bits", "Baked") " = constant (i1 true|<\\{ \\[1 x i8\\] \\}> <\\{ \\[1 x i8\\] c\"\\\\01\" \\}>)"), "bits_Baked", dir)
    try r.expect(sh(dir, "\"$OLANG\" build bf16sign.olang > out.txt 2>&1 && ./build/bf16sign") == 0, "bf16sign", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug bf16sign.olang > out.txt 2>&1 && ./build/bf16sign.debug") == 0, "bf16sign -d", dir)
}

# a function returning an aggregate returns it through one slot and one exit block, so that inlined, its result's
# fields reach the caller as separate values LLVM can see into - without it an iterator loop never vectorized
test "an aggregate is returned through one slot" { assert passed("retslot") }

fn retslot(r mut report&) ? Failed {
    dir := fresh("retslot")
    os.Run("cp checks/fixtures/retslot/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build retslot.olang > out.txt 2>&1 && ./build/retslot") == 0, "retslot", dir)
    # divmod's every return stores into the one slot and branches to its one exit: a single ret
    once String& = "awk '/^define .*divmod/,/^}/' build/retslot.main.ll | grep -c '^  ret ' | grep -qx 1"
    try r.expect(sh(dir, once) == 0, "divmod returns from more than one block", dir)
}

# T4a: an array of elements LLVM holds 16-aligned (I65 to I128, and what holds them) asks the arena for at least that
# alignment - an array under 32 bytes otherwise takes 8 (the second bulk review's P1); its elements read back at -O3 and
# at -debug
test "an array of 128-bit elements is 16-aligned" { assert passed("widealign") }

fn widealign(r mut report&) ? Failed {
    dir := fresh("widealign")
    os.Run("cp checks/fixtures/widealign/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build widealign.olang > out.txt 2>&1 && ./build/widealign") == 0, "widealign", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug widealign.olang > out.txt 2>&1 && ./build/widealign.debug") == 0, "widealign -debug", dir)
    try r.expect(irHas(dir, "build/widealign.main.ll", "call ptr @__olang_scope_alloc(_zeroed)?_min\\(ptr [^,]*, i64 [^,]*, i64 16\\)"), "no 16-aligned array", dir)
}

# D13d, D13e, E27, D14d: what every path assigns before a read gets no zero first, and arrays filled once are made with no
# clear - a local Vec given its value after its declaration makes no zero Vec, a comprehension over a range and an
# Array<T>(n) the next loop fills allocate with no clear (the loop that may stop early keeps it), and a global given its
# value by a top-level if has that value as its initializer
test "what is assigned before it is read gets no zero first" { assert passed("definit") }

# the calls the IR of one function of ll makes, written as NAME( - a pattern grepped in that function's body alone
fn bodyHas(dir String&, ll String&, name String&, re String&) Bool {
    return sh(dir, "awk '/^define .*@[^(]*" $name "\\(/,/^}/' " $ll " | grep -qE " $os.Quote(re)) == 0
}

fn definit(r mut report&) ? Failed {
    dir := fresh("definit")
    os.Run("cp checks/fixtures/definit/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build definit.olang > out.txt 2>&1 && ./build/definit > out.txt 2>&1") == 0, "definit", dir)
    try r.expect(outOf(dir) == "1 F32[0, 1, 4, 9] F32[0, 0.5, 1, 1.5] F32[1, 1, 1, 0, 0] 7\n", "definit output", dir)
    ll String& = "build/definit.main.ll"
    try r.expect(not bodyHas(dir, ll, "assigned", "Vec[^ ]*ctor|scope_alloc"), "a zero Vec made before its first value", dir)
    for f in String&["squares", "filled"] {
        try r.expect(not bodyHas(dir, ll, f, "scope_alloc_zeroed|llvm\\.memset"), $f ": an array filled once is cleared", dir)
        try r.expect(bodyHas(dir, ll, f, "call ptr @__olang_scope_alloc\\("), $f ": no plain allocation", dir)
    }
    try r.expect(bodyHas(dir, ll, "stopped", "scope_alloc_zeroed"), "a loop that may stop early lost its clear", dir)
    try r.expect(irHas(dir, ll, $gsym("definit", "Root") " = constant <\\{ ptr \\}> <\\{ ptr @"), "Root is not baked", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret definit.olang > out.txt 2>&1") == 0, "definit interpreted", dir)
    try r.expect(outOf(dir) == "1 F32[0, 1, 4, 9] F32[0, 0.5, 1, 1.5] F32[1, 1, 1, 0, 0] 7\n", "definit interpreted output", dir)
}

# T36: every numeric primitive has alias tags of its own - a BF16 or F16 element stored through a struct carries one, as
# an F32's always did (untagged, the store might have changed the array's descriptor, so a loop through a struct reloaded
# it at every element and never vectorized). Arrays of every narrow type written through a struct, and a declared
# number's array beside its base's view of the same storage, read back the same at -O3 and at -d
test "every numeric primitive has its own alias tags" { assert passed("tbaa") }

fn tbaa(r mut report&) ? Failed {
    dir := fresh("tbaa")
    os.Run("cp checks/fixtures/tbaa/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build narrow.olang > out.txt 2>&1 && ./build/narrow > out.txt 2>&1") == 0, "narrow", dir)
    try r.expect(outOf(dir) == "narrow: ok\n", "narrow output", dir)
    ll String& = " build/narrow.main.ll"
    try r.expect(sh(dir, "grep -q 'store bfloat [^,]*, ptr [^,]*, !tbaa'" $ll) == 0, "a BF16 store carries no tag", dir)
    try r.expect(sh(dir, "grep -q 'store half [^,]*, ptr [^,]*, !tbaa'" $ll) == 0, "an F16 store carries no tag", dir)
    try r.expect(irHas(dir, ll[1:], "!\\{!\"bf16\\[\\]\", ![0-9]+, i64 0\\}"), "no BF16 element leaf", dir)
    debug String& = "\"$OLANG\" build -debug narrow.olang > out.txt 2>&1 && ./build/narrow.debug > out.txt 2>&1"
    try r.expect(sh(dir, debug) == 0, "narrow -d", dir)
    try r.expect(outOf(dir) == "narrow: ok\n", "narrow -d output", dir)
}

# E31: a capitalized operator method is the operator everywhere; a lowercase one only in its own module
test "a private operator works only in its own module" { assert passed("opvis") }

fn opvis(r mut report&) ? Failed {
    dir := fresh("opvis")
    os.Run("cp checks/fixtures/opvis/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build use.olang > out.txt 2>&1 && ./build/use") == 0, "opvis", dir)
    try r.expect(sh(dir, "\"$OLANG\" build usepriv.olang > out.txt 2>&1") != 0, "usepriv.olang compiled", dir)
}

# M6b: every method the compiler calls by itself - operators, ==, $, indexing, for, in, Call, Hash - may be private: it
# works in its own module, a generic of that module included, and using the operation anywhere else is an error naming
# the method. A generic of another module sees with that module's eyes. Inside() is also baked while compiling (K2)
test "a private protocol method works in its own module, and is an error elsewhere" { assert passed("protopriv") }

fn protopriv(r mut report&) ? Failed {
    dir := fresh("protopriv")
    os.Run("cp checks/fixtures/protopriv/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build use.olang > out.txt 2>&1 && ./build/use") == 0, "protopriv", dir)
    try r.expect(irHas(dir, "build/kk*.ll", $gsym("kk", "Baked") " = .*(i1 true|c\"\\\\01\")"), "Inside() was not baked", dir)
    try r.expect(sh(dir, "\"$OLANG\" build bad.olang > out.txt 2>&1") != 0, "bad.olang compiled", dir)
    for what in String&["'==' needs Key's eq", "'$' needs Key's str", "'+' needs Vec2's plus", "'>' needs Vec2's less"
                        "'[' needs Bag's at", "'for' needs Bag's at", "'in' needs Bag's has", "'for' needs Gen's next"
                        "needs Adder's call", "'Hash' needs Key's hash", "compilation failed with 14 errors"] {
        try r.expect(outOf(dir).Contains(what), "bad.olang: expected " $what, dir)
    }
    try r.expect(sh(dir, "\"$OLANG\" build badgen.olang > out.txt 2>&1") != 0, "badgen.olang compiled", dir)
    try r.expect(outOf(dir).Contains("gen.olang:2:40: error[M6b]: '==' needs Mine's eq"), "badgen.olang: the error", dir)
}

# T17: an enum's payload is whole words, so copying one is word moves, not one byte at a time - which is what let
# a match over a collection of enums run at the speed of a C switch
test "an enum's payload is held as words" { assert passed("enumwords") }

fn enumwords(r mut report&) ? Failed {
    dir := fresh("enumwords")
    os.Run("cp checks/fixtures/enumwords/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build enumwords.olang > out.txt 2>&1 && ./build/enumwords") == 0, "enumwords", dir)
    try r.expect(sh(dir, "grep -q '{ i64, \\[2 x i64\\] }' build/enumwords.main.ll") == 0, "no payload of words", dir)
}

# S9f/S9d: a List, which has RunFrom, Iter, At and Len, is walked run by run - by "for ... in", by a comprehension and
# in generic code constrained by Indexable - and its iterator's helpers walk its chunks; none of them calls At
test "a List is walked run by run, not by At" { assert passed("listloop") }

fn listloop(r mut report&) ? Failed {
    dir := fresh("listloop")
    os.Run("cp checks/fixtures/listloop/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build loop.olang > out.txt 2>&1 && ./build/loop") == 0, "listloop", dir)
    # the root's objects - the instances among them: stage 0's main, the port's main and inst - by either spelling of
    # List<I16>'s method (stage 0's List.I16.M.I16, the port's List<I16>.M<I16> escaped), std/list's since QZ2
    ll String& = "build/loop.*ll"
    try r.expect(irHas(dir, ll, "call .*@std_?(2f)?list.*List([$.]|_3c)I16([$.]|_3e_2e)RunFrom"), "no call of RunFrom", dir)
    try r.expect(not irHas(dir, ll, "call .*@std_?(2f)?list.*List([$.]|_3c)I16([$.]|_3e_2e)At([$.]|_3c)"), "a call of At", dir)
}

# B3: every module sees the prelude, so a prelude file edited since an object was built makes that object stale -
# the root's above all, which holds the instantiations of the prelude's generics (B3d). It used to be reused, so a
# program kept running the prelude it was first built with. A copy of std, so the real one is never touched.
test "editing the prelude rebuilds what uses it" { assert passed("preludestale") }

fn preludestale(r mut report&) ? Failed {
    dir := fresh("preludestale")
    os.Run("cp checks/fixtures/preludestale/* " $os.Quote(dir) " && cp -r std " $os.Quote($dir "/std"))
    probe String& = "fn (v Vec<T>&) Probe() I64 { return v.Len() + 1 }"
    try r.expect(sh(dir, "echo " $os.Quote(probe) " >> std/prelude/vec.olang") == 0, "adding Probe", dir)
    try r.expect(sh(dir, "OLANG_STD=std \"$OLANG\" build probe.olang > out.txt 2>&1 && ./build/probe > got.txt") == 0
                 "first build", dir)
    try r.expect(sh(dir, "grep -qx 3 got.txt") == 0, "first build output", dir)
    try r.expect(sh(dir, "sed -i 's/return v.Len() + 1 }/return v.Len() + 2 }/' std/prelude/vec.olang") == 0
                 "editing Probe", dir)
    try r.expect(sh(dir, "OLANG_STD=std \"$OLANG\" build probe.olang > out.txt 2>&1 && ./build/probe > got.txt") == 0
                 "second build", dir)
    try r.expect(sh(dir, "grep -qx 4 got.txt") == 0, "the edited prelude was not used", dir)
}

# a program written by the check itself: n levels of open, then the middle, then n levels of close
fn nested(head String&, open String&, middle String&, close String&, tail String&, n I64) String& {
    b := StringBuilder()
    b.Push(head)
    for _ in range n { b.Push(open) }
    b.Push(middle)
    for _ in range n { b.Push(close) }
    b.Push(tail)
    return b.ToString()
}

# several statement forms begin with an expression and only what follows tells them apart, so each read it - and every
# lambda and catch block inside - again: 3^depth readings, a depth of 10 taking seconds and 12 running out of memory.
# The parse is remembered by position now, so forty levels of each are read once - interpreted (-i), with no native
# build to wait for, and under a timeout that the old parser would have run far past
test "nested lambdas and try-catch statements parse in time linear in their depth" { assert passed("nestparse") }

fn nestparse(r mut report&) ? Failed {
    dir := fresh("nestparse")
    lambdas String& = nested("fn k() { }\nfn f(g fn()) { g() }\nfn main() ? {\n    ", "f(fn() { ", "k()", " })", "\n}\n", 40)
    try os.WriteFile($dir "/lambdas.olang", lambdas) catch { }
    try r.expect(sh(dir, "timeout 60 \"$OLANG\" interpret lambdas.olang > out.txt 2>&1") == 0, "nested lambdas", dir)
    tries String& = nested("type E error { X }\nfn k() { }\nfn g() ? E { error E.X }\nfn main() ? {\n    "
                           "try g() catch E { ", "k()", " }", "\n}\n", 40)
    try os.WriteFile($dir "/tries.olang", tries) catch { }
    try r.expect(sh(dir, "timeout 60 \"$OLANG\" interpret tries.olang > out.txt 2>&1") == 0, "nested try-catch", dir)
}

# every pass recurses once per level of nesting, so a program nested past what the compiler's stack holds is refused by
# the parser - one diagnostic - where it crashed the checker at about 2,000 parentheses. 5,000 is well within it
test "nesting is bounded with a diagnostic, never a crash" { assert passed("nestdeep") }

fn nestdeep(r mut report&) ? Failed {
    dir := fresh("nestdeep")
    ok String& = nested("fn main() ? {\n    x := ", "(", "1", ")", "\n    assert x == 1\n}\n", 5000)
    try os.WriteFile($dir "/ok.olang", ok) catch { }
    try r.expect(sh(dir, "\"$OLANG\" interpret ok.olang > out.txt 2>&1") == 0, "5000 parentheses", dir)
    deep String& = nested("fn main() ? {\n    x := ", "(", "1", ")", "\n}\n", 25000)
    try os.WriteFile($dir "/deep.olang", deep) catch { }
    try r.expect(sh(dir, "\"$OLANG\" compile deep.olang > out.txt 2>&1") != 0, "25000 parentheses compiled", dir)
    try r.expect(outOf(dir).Contains("error[L21]: nested more than 20000 levels deep"), "25000 parentheses", dir)
    try r.expect(outOf(dir).Contains("compilation failed with 1 error"), "25000 parentheses, one error", dir)
}

# B9a/S8b: a module of many local ifs - each condition used to look its names up by reading the whole file again, and
# then by walking the whole function for the locals it reads, each once per condition
test "a function of many local ifs compiles in time linear in their number" { assert passed("manyifs") }

fn manyifs(r mut report&) ? Failed {
    dir := fresh("manyifs")
    many String& = nested("fn g(x I32) I32 { return x }\nfn f(x I32) I64 {\n    s := 0\n"
                          "    if g(x) > 5 { s += 1 }\n", "", "", "    return s\n}\nfn main() ? { assert f(9) == 20000 }\n", 20000)
    try os.WriteFile($dir "/many.olang", many) catch { }
    try r.expect(sh(dir, "timeout 60 \"$OLANG\" interpret many.olang > out.txt 2>&1") == 0, "20000 local ifs", dir)
}

# a review of the code generator (2026-10-09): what only a whole build shows. A block inside a match value has an
# arena (a loop leaking into the function's scope would fail under the memory cap); an array length out of range
# aborts with its message; a declaration adopts the array made for it; a big struct compiles in seconds (it took
# minutes); a BF16 survives -d; and the helpers rendering tuples are named the same in every build
test "the code generator's review fixes, as whole builds" { assert passed("cgreview") }

fn cgreview(r mut report&) ? Failed {
    dir := fresh("cgreview")
    os.Run("cp checks/fixtures/cgreview/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build matcharena.olang > out.txt 2>&1") == 0, "matcharena build", dir)
    try r.expect(sh(dir, "(ulimit -v 400000 && ./build/matcharena a b c d e) > out.txt 2>&1") == 0, "matcharena", dir)
    try r.expect(outOf(dir) == "30600000\n", "matcharena output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build arraylen.olang > out.txt 2>&1") == 0, "arraylen build", dir)
    try r.expect(sh(dir, "./build/arraylen > out.txt 2>&1") != 0, "arraylen ran cleanly", dir)
    try r.expect(outOf(dir).Contains("array length out of range"), "arraylen output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build adopt.olang > out.txt 2>&1 && ./build/adopt > out.txt") == 0, "adopt", dir)
    try r.expect(sh(dir, "awk '/^define.*@adopt_main/,/^}/' build/adopt.main.ll | grep -q arrcopy") != 0
                 "adopt copied", dir)
    try r.expect(sh(dir, "timeout 60 \"$OLANG\" build big.olang > out.txt 2>&1 && ./build/big > out.txt") == 0, "big", dir)
    try r.expect(outOf(dir) == "4\n", "big output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug bf16.olang > out.txt 2>&1 && ./build/bf16.debug > out.txt") == 0
                 "bf16", dir)
    try r.expect(outOf(dir) == "0.5 4 5\n", "bf16 output", dir)
    names String& = "grep -o '@olang.rd.[A-Za-z0-9._$]*' build/tuples.main.ll | sort -u"
    try r.expect(sh(dir, "\"$OLANG\" build tuples.olang > out.txt 2>&1 && " $names " > first.txt") == 0, "tuples", dir)
    try r.expect(sh(dir, "rm -rf build && \"$OLANG\" build tuples.olang > out.txt 2>&1 && " $names " | cmp -s first.txt -") == 0
                 "the tuple helpers were named differently", dir)
    try r.expect(sh(dir, "./build/tuples > out.txt") == 0 and outOf(dir) == "(1, \"x\") (2, 3, 0.5)\n"
                 "tuples output", dir)
}

# a review of the type checker (2026-10-09): what only several modules show. A case named after "is", "as" or in a
# pattern is resolved through its alias chain and is the case of that module's own enum, visible from here; and a
# name refused across the boundary - a private case, error word, method or type, an alias reused by a lambda - is one
# error, not the start of several
test "the type checker's review fixes, across modules" { assert passed("typereview") }

# prog.olang must not build, with exactly one error: one saying "want"
fn oneError(r mut report&, dir String&, prog String&, want String&) ? Failed {
    try r.expect(sh(dir, "\"$OLANG\" build " $prog ".olang > out.txt 2>&1") != 0, $prog " compiled", dir)
    out := outOf(dir)
    try r.expect(out.Contains(want) and out.Contains("compilation failed with 1 error\n"), $prog ": expected one '" $want "'", dir)
}

fn typereview(r mut report&) ? Failed {
    dir := fresh("typereview")
    os.Run("cp -r checks/fixtures/cases/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build good.olang > out.txt 2>&1 && ./build/good > out.txt") == 0, "good", dir)
    try r.expect(outOf(dir) == "14 1 3 true 4\n", "good output", dir)
    try oneError(r, dir, "isother", "error[E32]: lib.Other.Dir.North is no case of Dir")
    try oneError(r, dir, "matchother", "a pattern here names a case of")
    try oneError(r, dir, "isprivate", "error[M6a]: case")
    try oneError(r, dir, "matchprivate", "error[M6a]: case")
    try oneError(r, dir, "isnoalias", "unknown name 'nosuchalias'")    # E10c: naming no type, it is a value
    try oneError(r, dir, "privcase", "error[M6a]: case")
    try oneError(r, dir, "privword", "error[M6a]: error word")
    try oneError(r, dir, "privmethod", "error[M6]: method")
    try oneError(r, dir, "privtype", "error[M6]: type")
    try oneError(r, dir, "privfn", "error[M6]: 'helper' is private to its module")
    try oneError(r, dir, "privglobal", "error[M6]: 'count' is private to its module")
    try oneError(r, dir, "privmember", "error[M6a]: member 'inner' of Box is private to its module")
    try oneError(r, dir, "lambdaalias", "is an import's alias in this module")
}

# vec2 N2: a function made a value through an import alias ("f := lib.F") is checked as one named bare is - G12 and
# T22a - where it once skipped them all; one error each, and what stays legal through an alias the same built and
# interpreted. (A Vec's View() is an ordinary borrowed result since Vec is a handle, so a function handing one back is a
# value like any other - and M19g follows a view through one, n2 and f3.)
test "a function value through an import alias is checked as one named bare" { assert passed("vecalias") }

fn vecalias(r mut report&) ? Failed {
    dir := fresh("vecalias")
    os.Run("cp checks/fixtures/vecalias/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build good.olang > out.txt 2>&1 && ./build/good > out.txt") == 0, "good", dir)
    try r.expect(outOf(dir) == "30 60 7\n", "good output", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret good.olang > out.txt 2>&1") == 0 and outOf(dir) == "30 60 7\n", "good under -i", dir)
    try oneError(r, dir, "p1", "error[T22a]: 'Stash' relates its arguments' scopes")
    try oneError(r, dir, "p3", "error[G12]: generic function 'Id' is not a value")
    try oneError(r, dir, "n2", "error[M19g]: 'd' holds a view of 'w' taken before 'w' may have grown")
    try oneError(r, dir, "f3", "error[M19g]: 'd' holds a view of 'w' taken before 'w' may have grown")
}

# M19d, B2f, K1 (round 1 of docs/memory.md): a Vec is a handle - copies second names, growth retiring the old buffer - and
# a program using it gives one output built, built -debug, built -sanitize and interpreted. A view kept across a growth
# made through a second name stored in a structure reads the old elements when built plainly, is reported by the scope
# sanitizer (its old buffer made unreadable) -sanitize and -debug -sanitize alike, and stops the evaluator under
# interpret with both places
test "a Vec is a handle, built, sanitized and interpreted alike, and a stale view is caught" { assert passed("vechandle") }

fn vechandle(r mut report&) ? Failed {
    dir := fresh("vechandle")
    os.Run("cp checks/fixtures/vechandle/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build handle.olang > out.txt 2>&1 && ./build/handle > b.txt") == 0, "handle", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug handle.olang > out.txt 2>&1 && ./build/handle.debug > d.txt") == 0
                 "handle -debug", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -sanitize handle.olang > out.txt 2>&1 && ./build/handle.san > s.txt") == 0
                 "handle -sanitize", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret handle.olang > i.txt 2> out.txt") == 0, "handle interpreted", dir)
    try r.expect(sh(dir, "cmp -s b.txt d.txt && cmp -s b.txt s.txt && cmp -s b.txt i.txt") == 0, "handle outputs differ", dir)
    try r.expect(sh(dir, "grep -q '^1051 1051 51 539924 -1 999$' b.txt") == 0, "handle output", dir)
    plain := "\"$OLANG\" build stale.olang > out.txt 2>&1 && ./build/stale > out.txt 2>&1 && grep -qx 5 out.txt"
    try r.expect(sh(dir, plain) == 0, "stale built plainly: the old element", dir)
    for flags in String&["-sanitize", "-debug -sanitize"] {
        bin := "./build/stale" $(".debug" if flags == "-debug -sanitize" else "") ".san"
        try r.expect(sh(dir, "\"$OLANG\" build " $flags " stale.olang > out.txt 2>&1") == 0, "stale " $flags, dir)
        try r.expect(sh(dir, $bin " > out.txt 2>&1") == 134 and outOf(dir).Contains("stale view: storage a collection replaced")
                     "stale " $flags " was not reported", dir)
    }
    try r.expect(sh(dir, "\"$OLANG\" interpret stale.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("stale.olang:12: it uses a view of a Vec's elements taken before the Vec grew") and
                 outOf(dir).Contains("stale.olang:8: the Vec grew here"), "stale interpreted", dir)
}

# P4-P4d: tasks that fail - the earliest spawned failure is the join's, a task's clauses run on its thread, defaults land
# where results do - the same built, built -d -s (where a use after a scope closed stops the program) and under -i, which
# runs a join's tasks in sequence; and an error no clause takes leaves main as an unhandled error in all three
test "failing tasks agree built, sanitized and interpreted" { assert passed("spawnerr") }

fn spawnerr(r mut report&) ? Failed {
    dir := fresh("spawnerr")
    os.Run("cp checks/fixtures/spawnerr/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build tasks.olang > out.txt 2>&1") == 0, "tasks", dir)
    try r.expect(sh(dir, "./build/tasks > b.txt 2>&1") == 1, "tasks did not end in its error", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug -sanitize tasks.olang > out.txt 2>&1") == 0, "tasks -d -s", dir)
    try r.expect(sh(dir, "./build/tasks.debug.san > d.txt 2>&1") == 1, "tasks -d -s did not end in its error", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret tasks.olang > i.txt 2>&1") == 1, "tasks -i did not end in its error", dir)
    # built plainly the error ends with the hint, built -d and interpreted with its trace (S18d)
    try r.expect(sh(dir, "cmp -s tasks.want b.txt && cmp -s tasks.d.want d.txt && cmp -s d.txt i.txt") == 0, "tasks output"
                 dir)
}

# D18: generators walked as built (an LLVM coroutine), built -d -s (where a use after a scope closed stops the program)
# and interpreted (the evaluator's suspended frames) - the same values, the same destructors run at the same points
test "generators agree built, sanitized and interpreted" { assert passed("generators") }

fn generators(r mut report&) ? Failed {
    dir := fresh("generators")
    os.Run("cp checks/fixtures/generators/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build walks.olang > out.txt 2>&1 && ./build/walks > b.txt 2>&1") == 0, "walks", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug -sanitize walks.olang > out.txt 2>&1") == 0, "walks -d -s", dir)
    try r.expect(sh(dir, "./build/walks.debug.san > d.txt 2>&1") == 0, "walks -d -s run", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret walks.olang > i.txt 2>&1") == 0, "walks -i", dir)
    try r.expect(sh(dir, "cmp -s walks.want b.txt && cmp -s b.txt d.txt && cmp -s b.txt i.txt") == 0, "walks output", dir)
    # S20: a Next asked inside the generator's own walk - a guaranteed check, failing alike built, -d -s and interpreted
    gone String& = "a generator asked for its next value inside its own walk"
    try r.expect(sh(dir, "\"$OLANG\" build reentry.olang > out.txt 2>&1 && ./build/reentry > b.txt 2>&1") == 134, "reentry", dir)
    try r.expect(sh(dir, $"grep -qx 'reentry.olang:9: " $gone "' b.txt && ! grep -q 'not reached' b.txt") == 0, "reentry's message", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug -sanitize reentry.olang > out.txt 2>&1 && ./build/reentry.debug.san > d.txt 2>&1") == 134
                 "reentry -d -s", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret reentry.olang > i.txt 2>&1") == 134 and sh(dir, $"grep -q '" $gone "' i.txt") == 0
                 "reentry -i", dir)
    try r.expect(sh(dir, "\"$OLANG\" test reentryt.olang > t.txt 2>&1") == 1, "reentryt", dir)
    try r.expect(sh(dir, $"grep -q 'reentryt.olang:6: " $gone "' t.txt && grep -q 'FAIL - a generator resumed inside its own walk' t.txt " $
                    "&& grep -q 'ok - the next test runs' t.txt") == 0, "reentryt's results", dir)
    # D18e: walks a for-in makes and finishes, left by every exit, alike built, -d -s and interpreted (dead regions
    # kept, so a read of reclaimed storage stops it) - and only those and a local walked once are walk forms, not a
    # result or a field
    try r.expect(sh(dir, "\"$OLANG\" build exits.olang > out.txt 2>&1 && ./build/exits > b.txt 2>&1") == 0, "exits", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug -sanitize exits.olang > out.txt 2>&1 && ./build/exits.debug.san > d.txt 2>&1") == 0
                 "exits -d -s", dir)
    try r.expect(sh(dir, "OLANG_DEADREGIONS=1 \"$OLANG\" interpret exits.olang > i.txt 2>&1") == 0, "exits -i", dir)
    try r.expect(sh(dir, "cmp -s exits.want b.txt && cmp -s b.txt d.txt && cmp -s b.txt i.txt") == 0, "exits output", dir)
    try r.expect(sh(dir, "grep -c 'call [^@]*@exits_2eheld\\.walk(' build/exits.main.ll > out.txt; " $
                    "grep -c 'call [^@]*@exits_2eupto\\.walk(' build/exits.main.ll >> out.txt") == 0 and outOf(dir) == "9\n2\n"
                 "exits' walk forms", dir)
    # D18c: views borrowed from what a generator was given and kept by its walk, read after churns, alike built, -d -s
    # and interpreted; D18e: a walk given a global's array is a walk form too, made and dropped in its loop's block
    try r.expect(sh(dir, "\"$OLANG\" build views.olang > out.txt 2>&1 && ./build/views > b.txt 2>&1") == 0, "views", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug -sanitize views.olang > out.txt 2>&1 && ./build/views.debug.san > d.txt 2>&1") == 0
                 "views -d -s", dir)
    try r.expect(sh(dir, "OLANG_DEADREGIONS=1 \"$OLANG\" interpret views.olang > i.txt 2>&1") == 0, "views -i", dir)
    try r.expect(sh(dir, "cmp -s views.want b.txt && cmp -s b.txt d.txt && cmp -s b.txt i.txt") == 0, "views output", dir)
    try r.expect(sh(dir, "grep -c 'call [^@]*@views_2espans\\.walk(' build/views.main.ll > out.txt; " $
                    "grep -c 'call [^@]*@views_2eeach\\.walk(' build/views.main.ll >> out.txt") == 0 and outOf(dir) == "4\n1\n"
                 "views' walk forms", dir)
    # a failed check leaving a walk in a test closes the generator's scopes once, and the next test runs
    try r.expect(sh(dir, "\"$OLANG\" test exitst.olang > t.txt 2>&1") == 1, "exitst", dir)
    try r.expect(sh(dir, "grep -c '^drop 70$' t.txt | grep -qx 1 && grep -q 'FAIL - a check fails inside the walk' t.txt && " $
                    "grep -q '^drop 71$' t.txt && grep -q '1 passed, 1 failed' t.txt") == 0, "exitst's results", dir)
}

# K1/K2b/B5a and the review of the evaluator (2026-10-09): what compile-time evaluation, the built program at -O3 and at
# -O0, and -i must agree on - each program printed once by each, all three the same and right - and the data baked
# globals are written out as: one instance where two globals name one, a slice as a place in its base's data, and what a
# writable reference reaches never read-only
test "the evaluator, the run time and -i agree" { assert passed("agree") }

fn agree(r mut report&) ? Failed {
    dir := fresh("agree")
    os.Run("cp checks/fixtures/agree/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build agree.olang > out.txt 2>&1 && ./build/agree > b.txt 2>&1") == 0, "agree", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug agree.olang > out.txt 2>&1 && ./build/agree.debug > d.txt 2>&1") == 0, "agree -d", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret agree.olang > i.txt 2>&1") == 0, "agree -i", dir)
    try r.expect(sh(dir, "cmp -s agree.want b.txt && cmp -s b.txt d.txt && cmp -s b.txt i.txt") == 0, "agree output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build bfrand.olang > out.txt 2>&1 && ./build/bfrand > b.txt 2>&1") == 0, "bfrand", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug bfrand.olang > out.txt 2>&1 && ./build/bfrand.debug > d.txt 2>&1") == 0
                 "bfrand -d", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret bfrand.olang > i.txt 2>&1") == 0, "bfrand -i", dir)
    try r.expect(sh(dir, "cmp -s b.txt d.txt && cmp -s b.txt i.txt") == 0, "bfrand output", dir)
    # X8: the C math library's functions, computed while compiling, by the run time at -O3 and -O0, and under -i
    try r.expect(sh(dir, "\"$OLANG\" build math.olang > out.txt 2>&1 && ./build/math > b.txt 2>&1") == 0, "math", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug math.olang > out.txt 2>&1 && ./build/math.debug > d.txt 2>&1") == 0, "math -d", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret math.olang > i.txt 2>&1") == 0, "math -i", dir)
    try r.expect(sh(dir, "test $(wc -l < b.txt) = 14 && cmp -s b.txt d.txt && cmp -s b.txt i.txt") == 0, "math output", dir)
    mll String& = "build/math.main.ll"
    try r.expect(irHas(dir, mll, "^" $gsym("math", "SqrtTwo") " = constant (double 0x3FF6A09E667F3BCD$|<\\{ \\[8 x i8\\] \\}> <\\{ \\[8 x i8\\] c\"\\\\CD\\\\3B\\\\7F\\\\66\\\\9E\\\\A0\\\\F6\\\\3F\" \\}>, align 8$)"), "math baked", dir)
    try r.expect(irHas(dir, mll, "^declare double @(sqrt\\(double\\) memory\\(none\\) nounwind willreturn|llvm\\.sqrt\\.f64\\(double\\))$"), "math exact", dir)
    try r.expect(irHas(dir, mll, "^declare double @exp\\(double\\) nobuiltin "), "math inexact", dir)
    try r.expect(sh(dir, "\"$OLANG\" build r17.olang > out.txt 2>&1") == 0, "r17", dir)
    try r.expect(sh(dir, "./build/r17 > b.txt 2>&1") == 1 and sh(dir, "\"$OLANG\" interpret r17.olang > i.txt 2>&1") == 1
                 "r17 did not end in its error, built and interpreted", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug r17.olang > out.txt 2>&1") == 0 and sh(dir, "./build/r17.debug > d.txt 2>&1") == 1
                 "r17 -d did not end in its error", dir)
    try r.expect(sh(dir, ("printf 'before\\nunhandled error: Err.LOUD\\n(build with -debug to see where it came from)\\n' | cmp -s - b.txt"
                          " && cmp -s d.txt i.txt && grep -q '^r17.olang:9: raised here$' d.txt")) == 0, "r17 output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build share.olang > out.txt 2>&1 && ./build/share") == 0, "share", dir)
    ll String& = "build/share.main.ll"
    try r.expect(irHas(dir, ll, "^" $gsym("share", "B") " = constant (ptr|<\\{ ptr \\}> <\\{ ptr) " $gsym("share", "A") "\\.k[0-9]+")
                 "share_B", dir)
    try r.expect(irHas(dir, ll, "^" $gsym("share", "H") "\\.k[0-9]* = internal global (.2 x i32.|<\\{ \\[8 x i8\\] \\}>)"), "share_H.k", dir)
    try r.expect(irHas(dir, ll, "^" $gsym("share", "Sl") " = constant (\\{ i64, ptr \\} \\{ i64 2, ptr getelementptr inbounds \\(.4 x i32., ptr @share_Arr\\.k[0-9]*, i64 0, i64 1\\) \\}|<\\{ \\[8 x i8\\], ptr \\}> <\\{ \\[8 x i8\\] c\"\\\\02(\\\\00){7}\", ptr getelementptr \\(i8, ptr @G_2eshare_2eArr\\.k[0-9]+, i64 4\\) \\}>)")
                 "share_Sl", dir)
}

# the index of the quote closing the string or character literal whose opening quote is at open
fn cLiteralEnd(t String&, open I64) I64 {
    i I64 = open + 1
    for i < t.Len() {
        if t[i] == '\\' {
            i = i + 2
        } else if t[i] == t[open] {
            return i
        } else {
            i++
        }
    }
    return t.Len()
}

# the string literal starting at the first quote at or after from, and where it ends
fn literalAfter(t String&, from I64) I64, I64 {
    open I64 = from + (try t[from:].FindByte('"') catch default -1)
    return open + 1, cLiteralEnd(t, open)
}
# O26a across modules: a call to a function of a module found after the caller's is read by its checked body - a
# view mat.View returns holds the local array it is given, which lives in the result scope (read back after a churn,
# under -debug -sanitize), and cannot be kept in a list outliving the loop that made it (C2d)
test "a view from a module found after the caller's holds the caller's array" { assert passed("latermodule") }

# every program in bench/ still compiles (-c: checked and compiled, not linked). They are timed by hand, never run by a
# test, so a rule tightened in the checker could break one unseen - a per-head product benchmark once did (E31b)
test "every benchmark program compiles" { assert passed("bench") }

fn benchmarks(r mut report&) ? Failed {
    dir := fresh("bench")
    os.Run("cp bench/*.olang " $os.Quote(dir))
    files := try os.ReadDir(dir) catch default Array<String&>(0)
    n I64 = 0
    for f in files {
        if f.EndsWith(".olang") {
            n++
            try r.expect(sh(dir, "\"$OLANG\" compile " $f " > out.txt 2>&1") == 0, $f " did not compile", dir)
        }
    }
    try r.expect(n >= 10, "bench/ holds no programs", dir)
}

fn latermodule(r mut report&) ? Failed {
    dir := fresh("latermodule")
    os.Run("cp checks/fixtures/latermodule/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build -debug -sanitize view.olang > out.txt 2>&1") == 0, "view build", dir)
    try r.expect(sh(dir, "./build/view.debug.san > out.txt 2>&1") == 0 and outOf(dir) == "1.5 2\n", "view", dir)
    try r.expect(sh(dir, "\"$OLANG\" build kept.olang > out.txt 2>&1") != 0, "kept.olang compiled", dir)
    want := "error[C2d]: this instance holds a reference to an argument it would outlive"
    try r.expect(outOf(dir).Contains(want), "kept.olang: expected C2d", dir)
}

# O8b: the arena's pool is bounded, and gives the least recently given back chunks to the system beyond the bound -
# run with sysconf answering a machine of 8MB (a preloaded sysconf.c), so the bound is 1MB and a 16MB phase is far past
# it; so is the pool every thread shares, which parked workers fill. (That the pool finds any chunk big enough is a
# case, checks/cases/chunkpool.olang, and that a parked worker's chunks reach another thread checks/cases/parkedpool)
test "the arena's chunk pool gives memory back beyond its bound" { assert passed("chunkpool") }

fn chunkpool(r mut report&) ? Failed {
    dir := fresh("chunkpool")
    os.Run("cp checks/fixtures/chunkpool/* " $os.Quote(dir))
    try r.expect(sh(dir, "clang -shared -fPIC -o sysconf.so sysconf.c -ldl > out.txt 2>&1") == 0, "sysconf.so", dir)
    try r.expect(sh(dir, "\"$OLANG\" build budget.olang > out.txt 2>&1") == 0, "budget.olang did not build", dir)
    try r.expect(sh(dir, "LD_PRELOAD=./sysconf.so ./build/budget > out.txt 2>&1") == 0, "budget", dir)
}

# X2, X9-X14: olang and C, both ways - a program calling C compiled by clang (structs by value and by pointer as the
# platform's C passes them, every number width, an opaque handle, callbacks on a thread C made), the same under -debug
# -sanitize, and a library built with -library called from a C program through its generated header and from Python's
# ctypes where python3 is there
test "olang calls C and C calls olang, as clang's code does" { assert passed("cinterop") }

# the Python side, written where the scenario runs (no Python is kept in the repository): the library's entries
# declared by hand for ctypes, as a caller with only the .so would
CtypesScript := ("import ctypes, sys\n" $
    "lib = ctypes.CDLL(sys.argv[1])\n" $
    "lib.add.argtypes = [ctypes.c_int32, ctypes.c_int32]; lib.add.restype = ctypes.c_int32\n" $
    "print('add', lib.add(2, 3))\n" $
    "xs = (ctypes.c_int64 * 4)(1, 2, 3, 4)\n" $
    "lib.sum.argtypes = [ctypes.POINTER(ctypes.c_int64), ctypes.c_int64]; lib.sum.restype = ctypes.c_int64\n" $
    "print('sum', lib.sum(xs, 4))\n" $
    "buf = ctypes.create_string_buffer(64)\n" $
    "lib.greet.argtypes = [ctypes.c_char_p, ctypes.c_int64, ctypes.c_char_p, ctypes.c_int64]; lib.greet.restype = ctypes.c_int64\n" $
    "n = lib.greet(b'python', 6, buf, 64)\n" $
    "print('greet', buf.raw[:n].decode())\n" $
    "r = ctypes.c_int64()\n" $
    "lib.check.argtypes = [ctypes.c_int64, ctypes.POINTER(ctypes.c_int64)]; lib.check.restype = ctypes.c_int32\n" $
    "print('check', lib.check(21, ctypes.byref(r)), r.value, lib.check(500, ctypes.byref(r)))\n" $
    "class Point(ctypes.Structure): _fields_ = [('x', ctypes.c_double), ('y', ctypes.c_double)]\n" $
    "lib.mid.argtypes = [Point, Point]; lib.mid.restype = Point\n" $
    "m = lib.mid(Point(1, 2), Point(3, 4))\n" $
    "print('mid', m.x, m.y)\n")

fn cinterop(r mut report&) ? Failed {
    dir := fresh("cinterop")
    os.Run("cp checks/fixtures/cinterop/* " $os.Quote(dir))
    try r.expect(sh(dir, "clang -c -O2 abi.c -o abi.o > out.txt 2>&1") == 0, "abi.c did not compile", dir)
    try r.expect(sh(dir, "\"$OLANG\" build abi.olang > out.txt 2>&1 && ./build/abi > abi.txt") == 0, "abi.olang", dir)
    try r.expect(sh(dir, "cmp -s abi.txt abi.out") == 0, "abi printed otherwise than abi.out says", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug -sanitize -output abi.ds abi.olang > out.txt 2>&1 && ./abi.ds > abi.ds.txt") == 0, "abi -debug -sanitize", dir)
    try r.expect(sh(dir, "cmp -s abi.ds.txt abi.out") == 0, "abi under -debug -sanitize printed otherwise", dir)
    # O8d: a view held across an extern call that calls back an export fn letting go of what it names
    try r.expect(sh(dir, "clang -c -O2 callback.c -o callback.o > out.txt 2>&1") == 0, "callback.c did not compile", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -memory -debug -sanitize -output cb.ds callback.olang > out.txt 2>&1 && ./cb.ds > cb.txt") == 0
                 "callback -debug -sanitize", dir)
    try r.expect(outOf(dir).Contains("memory: 'G.t' keeps what it lets go of") and sh(dir, "cmp -s cb.txt callback.out") == 0
                 "callback: the view across c_run(i) was not kept", dir)
    # X11 on AAPCS64: the same calls against abi.c compiled by GCC for aarch64 - another compiler's C ABI - run through
    # the emulator, where olang builds for aarch64 here (B12a)
    if crossLibc("aarch64") and hasEmulator("aarch64") and sh(dir, "command -v aarch64-linux-gnu-gcc > /dev/null") == 0 {
        os.Run("mkdir -p " $os.Quote($dir "/arm") " && cp " $os.Quote($dir "/abi.c") " " $os.Quote($dir "/abi.olang") " " $
               os.Quote($dir "/arm"))
        try r.expect(sh($dir "/arm", "aarch64-linux-gnu-gcc -c -O2 abi.c -o abi.o > out.txt 2>&1") == 0, "abi.c for aarch64", dir)
        if sh($dir "/arm", "\"$OLANG\" build -target aarch64-linux-gnu abi.olang > out.txt 2>&1") == 0 {
            ran := sh($dir "/arm", "\"$OLANG\" -target aarch64-linux-gnu abi.olang > abi.txt 2>&1 && cmp -s abi.txt ../abi.out")
            try r.expect(ran == 0, "abi on aarch64 printed otherwise than abi.out says", dir)
        } else {
            try r.expect(outOf($dir "/arm").Contains("error[B12a]"), "abi.olang for aarch64", dir)
        }
    }
    try r.expect(sh(dir, "\"$OLANG\" build -library mylib.olang > out.txt 2>&1") == 0, "mylib.olang did not build as a library", dir)
    try r.expect(sh(dir, "test -f build/libmylib.so && test -f build/mylib.h") == 0, "no libmylib.so and mylib.h", dir)
    # only the export fns' entries are shown
    try r.expect(sh(dir, "nm -D --defined-only build/libmylib.so | grep -v ' [TWV] \\(add\\|sum\\|seen\\|greet\\|parse\\|check\\|norm2\\|scale\\|mid\\|pidKnown\\|squares\\)$' | grep -q ' [TDBRW] '") != 0, "the library shows more than its entries", dir)
    try r.expect(sh(dir, "clang -O1 -Wall -Werror use.c -o use -Lbuild -lmylib -lpthread > out.txt 2>&1") == 0, "use.c did not compile against mylib.h", dir)
    try r.expect(sh(dir, "LD_LIBRARY_PATH=build ./use > use.txt && cmp -s use.txt use.out") == 0, "use printed otherwise than use.out says", dir)
    # X16: bindgen writes bind.h's declarations as bind.gen holds them, and a program using them calls bind.c's code
    try r.expect(sh(dir, "clang -c -O2 bind.c -o bind.o > out.txt 2>&1") == 0, "bind.c did not compile", dir)
    try r.expect(sh(dir, "\"$OLANG\" bindgen bind.h -output gen.olang > out.txt 2>&1 && cmp -s gen.olang bind.gen") == 0, "bindgen wrote otherwise than bind.gen", dir)
    try r.expect(sh(dir, "sed 's/^extern {$/extern link \"bind.o\" {/' gen.olang | cat - binduse.part > bindprog.olang && \"$OLANG\" build bindprog.olang > out.txt 2>&1") == 0, "bindprog.olang", dir)
    try r.expect(sh(dir, "./build/bindprog > bindprog.txt && cmp -s bindprog.txt bindprog.out") == 0, "bindprog printed otherwise than bindprog.out says", dir)
    # X17: bind.h imported - what bindgen writes of it, and its static inline function (X20), a macro taking arguments
    # (X19) and a variadic call (X21) besides
    try r.expect(sh(dir, "\"$OLANG\" build bindimport.olang > out.txt 2>&1 && ./build/bindimport > bi.txt && cmp -s bi.txt bindimport.out") == 0, "bindimport", dir)
    # X20: a C file's functions and its header's static inline one compiled into the program, inlined into the olang
    # loop calling them by the link's optimizer; and interpret, which loads that C as a shared library, agrees
    try r.expect(sh(dir, "\"$OLANG\" build fastuse.olang > out.txt 2>&1 && ./build/fastuse > fast.txt && grep -q '^fast 332334000 7$' fast.txt") == 0, "fastuse", dir)
    try r.expect(sh(dir, "objdump -d build/fastuse | grep 'call' | grep -q 'fast_\\|olang_ci_'") != 0, "fast.c's functions were not inlined into work", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret fastuse.olang > fasti.txt 2>&1 && cmp -s fast.txt fasti.txt") == 0, "fastuse interpreted", dir)
    if os.Exists("/usr/include/zlib.h") {
        # X17: zlib's header imported, the library named on the import: built and interpreted alike
        try r.expect(sh(dir, "\"$OLANG\" build zimport.olang > out.txt 2>&1 && ./build/zimport > zim.txt && grep -q 'back: hello hello' zim.txt") == 0, "zimport", dir)
        try r.expect(sh(dir, "\"$OLANG\" interpret zimport.olang > zimi.txt 2>&1 && cmp -s zim.txt zimi.txt") == 0, "zimport interpreted", dir)
        try r.expect(sh(dir, "\"$OLANG\" bindgen /usr/include/zlib.h -output zlib.olang > out.txt 2>&1 && sed 's/^extern {$/extern link \"z\" {/' zlib.olang | cat - zdemo.part > zdemo.olang") == 0, "bindgen of zlib.h", dir)
        try r.expect(sh(dir, "\"$OLANG\" build zdemo.olang > out.txt 2>&1 && ./build/zdemo > zdemo.txt && grep -q 'back: hello hello' zdemo.txt") == 0, "zdemo", dir)
        # B3e: interpret loads the libraries a program links, and says which it cannot
        try r.expect(sh(dir, "\"$OLANG\" zinterp.olang > zb.txt 2>&1 && \"$OLANG\" interpret zinterp.olang > zi.txt 2>&1 && cmp -s zb.txt zi.txt && grep -q 'crc 3610a686' zi.txt") == 0, "zinterp", dir)
        try r.expect(sh(dir, "sed 's/link \"z\"/link \"nosuchlib\"/' zinterp.olang > zbad.olang && \"$OLANG\" interpret zbad.olang > out.txt 2>&1") != 0 and
                     outOf(dir).Contains("error[B3e]: the library 'nosuchlib' a link names cannot be loaded"), "interpret's missing library", dir)
    }
    if sh(dir, "command -v python3 > /dev/null 2>&1") != 0 { return }
    try os.WriteFile($dir "/use_ctypes.py", CtypesScript) catch os.Error { try r.failed("use_ctypes.py", dir) }
    try r.expect(sh(dir, "python3 -I use_ctypes.py build/libmylib.so > py.txt 2>&1") == 0, "ctypes", dir)
    py := try os.ReadFile($dir "/py.txt") catch default ""
    try r.expect(py == "add 5\nsum 10\ngreet hello, python!\ncheck 0 42 131073\nmid 2.0 3.0\n", "ctypes printed " $py, dir)
}

# B12: a build is for this machine unless -a names another target - its vectors and FMA where it has them, none of
# them at baseline x86-64 - with the build constants following -a, objects of their own for each target (B12b), and
# the same results everywhere (B12c): what the loops computed is one line, built, interpreted, at every target
test "a build is for this machine unless -a names another target" { assert passed("target") }

fn target(r mut report&) ? Failed {
    dir := fresh("target")
    os.Run("cp checks/fixtures/target/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build loop.olang > out.txt 2>&1 && ./build/loop > native.txt") == 0, "native", dir)
    try r.expect(sh(dir, "stat -c '%n %.9Y' build/*.o | grep -v olang_build | sort > objects.txt") == 0, "objects", dir)
    native := try os.ReadFile($dir "/native.txt") catch default ""
    nl := try native.FindByte('\n') catch default -1
    try r.expect(nl > 0, "native printed " $native, dir)
    first := native[:nl]
    results := native[nl + 1:]
    # this machine's vectors, when it has wider ones than SSE's, and its FMA instruction for x.Fma(a, b), not a call
    if not first.EndsWith(" 128 false") {
        try r.expect(sh(dir, "objdump -d build/loop | grep -qE 'ymm|zmm'") == 0, "no wide vectors in " $first, dir)
    }
    if first.EndsWith(" true") {
        try r.expect(sh(dir, "objdump -d build/loop | grep -q vfmadd") == 0, "no FMA instruction in " $first, dir)
        try r.expect(sh(dir, "objdump -d build/loop | grep -qE 'call.*<fmaf?@plt>'") != 0, "an fma call in " $first, dir)
    }
    if TargetArch != "x86_64" { return }
    # baseline x86-64: SSE2's vectors only, fma the C library's function - and the same results
    try r.expect(sh(dir, "\"$OLANG\" build -target x86-64 loop.olang > out.txt 2>&1 && ./build/loop > base.txt") == 0, "x86-64", dir)
    try r.expect((try os.ReadFile($dir "/base.txt") catch default "") == "x86-64 128 false\n" $results, "x86-64 printed", dir)
    try r.expect(sh(dir, "objdump -d build/loop | grep -qE 'ymm|zmm|vfmadd'") != 0, "x86-64 has wide vectors or FMA", dir)
    try r.expect(sh(dir, "objdump -d build/loop | grep -qE 'call.*<fmaf@plt>'") == 0, "x86-64 does not call fmaf", dir)
    # x86-64-v3 - AVX2's 256 bits and FMA, run where this machine has them
    if first.EndsWith(" true") {
        try r.expect(sh(dir, "\"$OLANG\" build -target x86-64-v3 loop.olang > out.txt 2>&1 && ./build/loop > v3.txt") == 0, "v3", dir)
        try r.expect((try os.ReadFile($dir "/v3.txt") catch default "") == "x86-64-v3 256 true\n" $results, "v3 printed", dir)
        try r.expect(sh(dir, "objdump -d build/loop | grep -q zmm") != 0, "x86-64-v3 has 512-bit vectors", dir)
    }
    # back to this machine: every object it built is current, not rebuilt (the build constants' module always is)
    try r.expect(sh(dir, "\"$OLANG\" build loop.olang > out.txt 2>&1 && ./build/loop | cmp -s - native.txt") == 0
                 "native again", dir)
    try r.expect(sh(dir, "stat -c '%n %.9Y' $(cut -d' ' -f1 objects.txt) | sort | cmp -s - objects.txt") == 0
                 "native's objects were rebuilt", dir)
    # interpreted: the build constants and the results the built program gives
    try r.expect(sh(dir, "\"$OLANG\" interpret loop.olang | cmp -s - native.txt") == 0, "-i", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret -target x86-64 loop.olang | cmp -s - base.txt") == 0, "-a x86-64 -i", dir)
    # another architecture (B12a): built where this clang can and its C library is installed (else refused, naming
    # why), and run through an emulator where there is one - computing what this machine computed (B12c)
    if sh(dir, "\"$OLANG\" build -target aarch64-linux-gnu loop.olang > out.txt 2>&1") != 0 {
        try r.expect(outOf(dir).Contains("error[B12a]") or not crossLibc("aarch64"), "aarch64 refused for no reason", dir)
        return
    }
    try r.expect(sh(dir, "file build/loop | grep -q 'ARM aarch64'") == 0, "-target aarch64 built no aarch64 program", dir)
    if not hasEmulator("aarch64") { return }
    try r.expect(sh(dir, "\"$OLANG\" -target aarch64-linux-gnu loop.olang > arm.txt 2>&1") == 0, "aarch64 run", dir)
    arm := try os.ReadFile($dir "/arm.txt") catch default ""
    try r.expect(arm.StartsWith("generic ") and arm.EndsWith($"\n" $results), "aarch64 printed " $arm, dir)
}

# whether the C library of arch's Linux is installed where clang finds a cross one, or OLANG_SYSROOT names one (B12a)
fn crossLibc(arch String&) Bool {
    sysroot := try os.Env("OLANG_SYSROOT") catch default ""
    return sysroot != "" or os.Exists($"/usr/" $arch "-linux-gnu/lib/libc.so")
}

# whether an emulator olang would run arch's programs through is here (B12a)
fn hasEmulator(arch String&) Bool {
    e := try os.Env("OLANG_EMULATOR") catch default ""
    return e != "" or os.Run($"command -v qemu-" $arch " > /dev/null 2>&1 || command -v qemu-" $arch "-static > /dev/null 2>&1") == 0
}

# G8b: a generic type first resolved from inside another module's signature - b.olang's ReadA names a.Wrap before a's
# types are resolved - resolves in a context of its own, so the signature's "<T>" is not the type's T. Which file's
# storage lay above the other's decided whether it went wrong, so b.olang is padded until it is stored apart, above
test "a generic type first reached from another module's signature" { assert passed("lazytype") }

# C2: a ":=" field's type is settled as its constructor's body is built, which a body reading the field may need first -
# a function or method declared above the type, a generic type's instantiation, or a module importing the type's, whose
# bodies are checked first (the field read as "?", "? has no method 'Push'")
test "a ':=' field read before its constructor's body is built" { assert passed("inferfield") }

fn inferfield(r mut report&) ? Failed {
    dir := fresh("inferfield")
    os.Run("cp checks/fixtures/inferfield/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" test b.olang > out.txt 2>&1") == 0, "b.olang's tests", dir)
    try r.expect(sh(dir, "\"$OLANG\" test a.olang > out.txt 2>&1") == 0, "a.olang's tests", dir)
}

fn lazytype(r mut report&) ? Failed {
    dir := fresh("lazytype")
    os.Run("cp checks/fixtures/lazytype/* " $os.Quote(dir))
    os.Run("yes '# padding' | head -n 20000 >> " $os.Quote($dir "/b.olang"))
    try r.expect(sh(dir, "\"$OLANG\" test b.olang > out.txt 2>&1") == 0, "b.olang's tests", dir)
}

# B11: what the compiler's diagnostics are held to (compiler/msgs.olang, compiler/DESIGN.md section 1.3, the table's
# source). Every rule a message names is one the specification states, so "olang explain RULE" finds it; the Diag enum
# and the functions are one to one, each function's Kind its own case. Their arguments need no counting: they are typed
# parameters.
test "every message of compiler/msgs.olang names rules the specification states, and is its own Diag" {
    msgs := try os.ReadFile("compiler/msgs.olang") catch default ""
    spec := try os.ReadFile("SPEC.md") catch default ""
    assert msgs.Len() > 0 and spec.Len() > 0
    bad := 0
    # the enum's cases, in order
    from := try msgs.Find("\ntype Diag enum {\n") catch default -1
    assert from >= 0
    body := msgs[from + 18:]
    to := try body.Find("\n}\n") catch default -1
    assert to >= 0
    cases := Map<String&, Bool>()
    for line in body[:to].Split("\n") {
        name := line.Trim()
        if name.Len() == 0 { continue }
        if name in cases {
            try io.PrintErr("check FAIL: msgs.olang's Diag names " $name " twice\n") catch io.Error { }
            bad++
        }
        cases.Put(name, false)
    }
    assert cases.Len() > 0
    functions := 0
    rest String& = msgs
    for {
        at := try rest.Find("\nfn ") catch { break }
        rest = rest[at + 4:]
        open := try rest.FindByte('(') catch default 0
        name := rest[:open]
        call := try rest.Find(") Msg { return Msg(Diag.") catch default -1
        eol := try rest.FindByte('\n') catch default rest.Len()
        if call < 0 or call > eol { continue }
        functions++
        kindAt I64 = call + 24
        kindEnd I64 = kindAt + (try rest[kindAt:].FindByte(',') catch default 0)
        kind := rest[kindAt:kindEnd]
        if kind != name {
            try io.PrintErr("check FAIL: msgs.olang's " $name " gives Diag." $kind "\n") catch io.Error { }
            bad++
        }
        seen := try cases.Get(name) catch default false
        if name not in cases {
            try io.PrintErr("check FAIL: msgs.olang's " $name " is no case of Diag\n") catch io.Error { }
            bad++
        } else if seen {
            try io.PrintErr("check FAIL: msgs.olang has two functions " $name "\n") catch io.Error { }
            bad++
        } else {
            cases.Put(name, true)
        }
        rs, re := literalAfter(rest, kindEnd)
        rules := rest[rs:re]
        for r in rules.Split(", ") {
            if r.Len() > 0 and not spec.Contains("**" $r ".**") and not spec.Contains("**" $r " (") {
                try io.PrintErr("check FAIL: msgs.olang's " $name " names rule " $r ", which SPEC.md does not state\n") catch io.Error { }
                bad++
            }
        }
    }
    for e in cases.Iter() {
        if not e.Value {
            try io.PrintErr("check FAIL: msgs.olang's Diag." $e.Key " has no function\n") catch io.Error { }
            bad++
        }
    }
    assert functions == cases.Len()
    assert bad == 0
}

# K1: the differential fuzzer (fuzz/), on a few fixed seeds - each program built at -O3, built at -O0 and interpreted,
# every value computed while compiling the same as the run time's, and every output the same; "make fuzz" runs it longer
test "the differential fuzzer finds nothing on its fixed seeds" { assert passed("fuzz") }

fn fuzz(r mut report&) ? Failed {
    dir := fresh("fuzz")
    os.Run("cp fuzz/fuzz.olang fuzz/gen.olang fuzz/scopegen.olang " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build -debug fuzz.olang > out.txt 2>&1") == 0, "fuzz did not build", dir)
    # the compiler it tests is this one, handed on: fuzz's own default is under the directory it runs in
    try r.expect(sh(dir, "OLANG=\"$OLANG\" ./build/fuzz.debug run 1 2 2 12 > out.txt 2>&1") == 0, "fuzz found something (build/checks/fuzz/build/fz/run*/found)", dir)
    # B2f: scope-stress programs built under the scope sanitizer and interpreted give one output (seeds that ran clean)
    try r.expect(sh(dir, "OLANG=\"$OLANG\" ./build/fuzz.debug scope 3 2 2 12 > out.txt 2>&1") == 0
                 "fuzz scope found something (build/checks/fuzz/build/fz/run*/scope)", dir)
}

# B2f: the scope sanitizer. Its runtime, driven from C: storage a closed scope gave back, read or written - a small chunk
# and a large one - a reference read out of it followed, a length read out of it allocated, each stopped with its message
# and status 134, as a failed check is; a fault that is not the sanitizer's ends the program as it would without it; a
# program's own os.OnCrash message is kept for those, and more scopes closed than are held back leave the newest still
# caught. Then tests that churn arenas pass under it (no use is reported that is not one), and only a -s build carries it
test "the scope sanitizer reports a use after a scope closed, and nothing else" { assert passed("scopesan") }

fn scopesan(r mut report&) ? Failed {
    dir := fresh("scopesan")
    os.Run("cp checks/fixtures/scopesan/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build -debug -sanitize stub.olang > out.txt 2>&1") == 0, "stub.olang did not build", dir)
    # main renamed, and Touch named stub_Touch as drive.c declares it, whatever symbol the compiler gave it (B3b)
    rename String& = ("for o in build/*.debug.san.o; do for s in $(nm $o | awk '$2 == \"T\" && $3 ~ /Touch$/ { print $3 }'); do"
                      " objcopy --redefine-sym $s=stub_Touch $o || exit 1; done; done")
    try r.expect(sh(dir, ("objcopy --redefine-sym main=olang_main build/stub.*.main.debug.san.o > out.txt 2>&1 && " $rename
                          " && clang -O0 drive.c build/*.debug.san.o -o drive -lpthread -ldl -lm >> out.txt 2>&1")) == 0
                 "drive.c did not link", dir)
    try r.expect(sh(dir, "./drive ok > out.txt 2>&1") == 0 and outOf(dir) == "ok 1499500\n", "drive ok", dir)
    mem String& = "use after scope closed: storage a closed scope gave back was read or written\n"
    ref String& = "use after scope closed: a reference read from storage a closed scope gave back was followed\n"
    len String& = "use after scope closed: an allocation of more than 2^60 bytes - a length read from storage a closed scope gave back\n"
    try driven(r, dir, "read", 134, mem)
    try driven(r, dir, "write", 134, mem)
    try driven(r, dir, "big", 134, mem)
    try driven(r, dir, "ref", 134, ref)
    try driven(r, dir, "len", 134, len)
    try driven(r, dir, "foreign", 139, "")
    try driven(r, dir, "churn", 134, "1499500\n" $mem)
    try driven(r, dir, "read crash", 134, $mem "crashed\n")
    try driven(r, dir, "foreign crash", 139, "crashed\n")
    # no use reported that is not one: arena-churning tests pass under it
    tests String& = (" " $os.Quote($root() "/std/list.olang") " " $os.Quote($root() "/std/prelude/tests/map.olang") " "
        $os.Quote($root() "/std/prelude/tests/vec.olang"))
    try r.expect(sh(dir, "\"$OLANG\" test -debug -sanitize" $tests " > out.txt 2>&1") == 0, "the tests under -d -s", dir)
    try r.expect(sh(dir, "grep -c ' 0 failed' out.txt | grep -qx 3") == 0, "the tests under -d -s did not all pass", dir)
    # zero cost outside -s: nothing of it in a plain build's IR, all of it in a -s build's
    try r.expect(sh(dir, "\"$OLANG\" build -debug stub.olang > out.txt 2>&1") == 0, "stub.olang did not build plainly", dir)
    # (the runtime's comments name its parts; the code is every line that is not one)
    plain String& = "build/stub.main.debug.ll build/olang_runtime.*[0-9a-f].debug.ll"
    try r.expect(sh(dir, "grep -hv '^ *;' " $plain " | grep -q '__olang_san'") != 0, "a plain build carries the sanitizer"
                 dir)
    try r.expect(sh(dir, "grep -q 'call void @__olang_san_quarantine_list' build/olang_runtime.*.debug.san.ll") == 0
                 "a -s build does not quarantine what a scope closes", dir)
}

# runs drive.c's mode: it must end with status, its output (stdout and stderr together) beginning with want - after
# which the shell may say how it ended - and report no use after a scope closed unless want does
fn driven(r mut report&, dir String&, mode String&, status I32, want String&) ? Failed {
    st := sh(dir, "./drive " $mode " > out.txt 2>&1")
    out := outOf(dir)
    ok := st == status and out.StartsWith(want) and (want.Contains("use after") or not out.Contains("use after"))
    try r.expect(ok, "drive " $mode " ended " $st, dir)
}

# S1, S2: os.OnCrash's message is what the program writes when it crashes - on the main thread, on RunOnStack's and on
# a task's, a stack overflow included, and after a failed check's own line - and the process still ends as the signal
# ends it; os.RunOnStack's recursion finishes where the main thread's 8MB overflows, built and interpreted; and under -i
# a crash in a foreign function the program calls writes the program's message first
test "os.OnCrash reports a crash on every thread, and os.RunOnStack makes room" { assert passed("crash") }

# the fixture program, run in dir with its arguments and no core file left behind, through no shell of its own
fn crashRun(dir String&, args String&) os.Output {
    return try os.Exec(String&["sh", "-c", "cd " $os.Quote(dir) " && ulimit -c 0 && exec " $args]) catch { unreachable }
}

fn crashes(r mut report&) ? Failed {
    dir := fresh("crash")
    os.Run("cp checks/fixtures/crash/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build crash.olang > out.txt 2>&1") == 0, "crash did not build", dir)
    for how in String&["overflow", "small", "task", "shallow"] {
        o := crashRun(dir, "./build/crash " $how)
        try r.expect(o.Status == 139 and o.Stderr == "crash.olang crashed: " $how "\n" and o.Stdout == ""
                     "crash " $how ": status " $o.Status ", " $o.Stderr, dir)
    }
    a := crashRun(dir, "./build/crash assert")
    try r.expect(a.Status == 134 and a.Stderr.EndsWith("assertion failed: c.v is 0\ncrash.olang crashed: assert\n")
                 "crash assert: status " $a.Status ", " $a.Stderr, dir)
    d := crashRun(dir, "./build/crash deep")
    try r.expect(d.Status == 0 and d.Stdout == "deep 1000000\n", "RunOnStack deep: status " $d.Status ", " $d.Stdout, dir)
    compiler := olang()
    i := crashRun(dir, $os.Quote(compiler) " interpret crash.olang deep 20000")
    try r.expect(i.Status == 0 and i.Stdout == "deep 20000\n", "RunOnStack -i: " $i.Stdout $i.Stderr, dir)
    f := crashRun(dir, $os.Quote(compiler) " interpret foreign.olang")
    try r.expect(f.Status == 139 and f.Stderr.StartsWith("foreign.olang crashed\nolang: internal compiler error") and
                 f.Stderr.Contains("while interpreting"), "OnCrash -i: status " $f.Status ", " $f.Stderr, dir)
    # T2c, E35: "x!" on a null ends the program where it is written, optimized (where the optimizer can see the null)
    # and not - nothing after it runs - and interpret stops there alike
    for flags in String&["", "-debug"] {
        try r.expect(sh(dir, "\"$OLANG\" build " $flags " nullpeek.olang > out.txt 2>&1") == 0, "nullpeek did not build", dir)
        bin := "./build/nullpeek" $(".debug" if flags == "-debug" else "")
        n := crashRun(dir, bin)
        try r.expect(n.Status == 134 and n.Stdout == "start\nafter a push: 4\n" and n.Stderr == "nullpeek.olang:22: null reached\nnullpeek crashed\n"
                     "nullpeek " $flags ": status " $n.Status ", " $n.Stdout $n.Stderr, dir)
    }
    ni := crashRun(dir, $os.Quote(compiler) " interpret nullpeek.olang")
    try r.expect(ni.Status == 134 and ni.Stdout == "start\nafter a push: 4\n" and ni.Stderr.StartsWith("nullpeek.olang:22: null reached")
                 "nullpeek -i: status " $ni.Status ", " $ni.Stderr, dir)
    # std/chan: a Send on a closed channel fails with chan.Error.CLOSED, here escaping main
    try r.expect(sh(dir, "\"$OLANG\" build chanclosed.olang > out.txt 2>&1") == 0, "chanclosed did not build", dir)
    cc := crashRun(dir, "./build/chanclosed")
    try r.expect(cc.Status == 1 and cc.Stdout == "got 1\n" and cc.Stderr.Contains("unhandled error: chan.Error.CLOSED")
                 "chanclosed: status " $cc.Status ", " $cc.Stdout $cc.Stderr, dir)
    # P7: under -r the crash handler is not instrumented (it can run while ThreadSanitizer holds its own locks); -c,
    # so no sanitizer runtime is needed to check it
    try r.expect(sh(dir, "\"$OLANG\" compile -race nullpeek.olang > out.txt 2>&1") == 0, "nullpeek -c -r did not build", dir)
    # the crash handler is the runtime's, compiled once for the build (B3)
    try r.expect(sh(dir, "cat build/olang_runtime.*.race.ll > runtime.race.ll 2> out.txt") == 0, "no -r runtime IR", dir)
    ll := try os.ReadFile($dir "/runtime.race.ll") catch default ""
    try r.expect(ll.Contains("@__olang_crash_handler(i32 %sig) #1 {") and ll.Contains("attributes #0 = { null_pointer_is_valid sanitize_thread") and
                 ll.Contains("attributes #1 = { null_pointer_is_valid \"target-cpu\""), "crash handler instrumented under -r", dir)
}

# P2 (decision 48): a closure that may build into a scope it captured asks for it as its call starts - this thread's part
# of it on another thread's (__olang_capture_scope), as a Call adapter asks for its instance's (__olang_scope_mine). Each
# shape building a temporary where a conditional, a match value or a "catch default" lands - in the lambda, in a callee it
# calls, in a Call method, a borrowed result, a ":=" local, an argument, a destructured result, a value call's result -
# was missed by the walk deciding it (SemanticMayBuild), so the closure asked for nothing and its tasks bumped the main
# thread's arena (TSan: 24-32 reports each). The fixture calls them on two tasks while the main thread builds into the
# same scope; the code generator now stops on any build the walk did not foresee, and every lambda here asks
test "a closure that may build asks for the scopes it captured" { assert passed("capscope") }

fn capscope(r mut report&) ? Failed {
    dir := fresh("capscope")
    os.Run("cp checks/fixtures/capscope/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build capscope.olang > out.txt 2>&1 && ./build/capscope > out.txt 2>&1") == 0, "capscope", dir)
    try r.expect(outOf(dir) == "capscope: ok\n", "capscope output", dir)
    ll String& = " build/capscope.main.ll"
    asks String& = ("awk '/^define internal .*lambda[$_]/ { n++; inl = 1; has = 0 } inl && /call ptr @__olang_capture_scope/ { has = 1 }"
                    " inl && /^}/ { if (has) ok++; inl = 0 } END { exit !(n == 24 && ok == 24) }'")
    try r.expect(sh(dir, $asks $ll) == 0, "a lambda building into its captured scope does not ask for it", dir)
    # the Call adapter (stage 0's .callfv, the port's _adapter) passes Call the part of its instance's scope it asked for
    adapter String& = ("awk '/^define .*Adder.*(callfv|_adapter)/ { inl = 1 } inl && match($0, /%[a-z0-9]+ = call ptr @__olang_(scope_mine|capture_scope)/) { split($1, w, \" \"); got = w[1] }"
                       " inl && got != \"\" && $0 ~ (\"Adder(\\\\.|_2e)Call\\\\(ptr \" got \",\") { ok = 1 } inl && /^}/ { inl = 0 } END { exit !ok }'")
    try r.expect(sh(dir, $adapter $ll) == 0, "the Call adapter does not pass Call its scope", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret -define N=200 capscope.olang > out.txt 2>&1") == 0, "capscope -i", dir)
    try r.expect(outOf(dir) == "capscope: ok\n", "capscope -i output", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -debug -sanitize capscope.olang > out.txt 2>&1 && ./build/capscope.debug.san > out.txt 2>&1") == 0
                 "capscope -d -s", dir)
}

# E11b/E11c, D16c, E31, G9d, O16, O18a, P2, T25d: Strs, joins and destructor temporaries the reviews of decision 49 wrote -
# joins in Go's order, left part way, in deferred code and tasks, a Map's Str through a helper, lambdas and Call adapters
# made in a Str or a helper of one, callbacks over what the receiver reaches, generic calls of destructor temporaries -
# each built, built -s and built -d, and interpreted where -i runs it (not a destructor's, nor 20,000 joins: -i
# reclaims nothing), giving what it was reviewed to give
test "joins reaching a Str give what they did when reviewed" { assert passed("strheld") }

# the programs strheld builds, each a part of its own (Checks), in a directory of its own taking what the others built
# from the store (B3j): built, built -s and built -d, and interpreted but for the ones in StrheldNotInterpreted
StrheldPrograms Array<String&>& = String&["concurrent", "deferred", "earlyexits", "eqwrites", "globals", "manyplaces"
                                          "mapalone", "opmethods", "order", "samescope", "shrinks", "strchanges", "lambdaany"
                                          "lambdamade", "lambdafold", "lambdaspawn", "lambdabyvalue", "adapterlocal"
                                          "adaptercallee", "g9dorder", "condlanding", "trydefault", "helperlambda"
                                          "transientlambda", "condliteral", "regbattery", "regreturns", "g9deval"
                                          "g9dcontainers"]
StrheldNotInterpreted Array<String&>& = String&["earlyexits", "manyplaces", "g9dorder", "condlanding", "trydefault"
                                                "regbattery", "regreturns", "g9deval", "g9dcontainers"]

fn strheldProgram(r mut report&, n String&) ? Failed {
    dir := fresh($"strheld/" $n)
    os.Run("cp checks/fixtures/strheld/" $n ".olang checks/fixtures/strheld/" $n ".want " $os.Quote(dir))
    try r.expect(sh(dir, $store() " \"$OLANG\" build " $n ".olang > out.txt 2>&1 && ./build/" $n " > b.txt 2>&1 && cmp -s b.txt " $n ".want") ==
                 0, n, dir)
    try r.expect(sh(dir, ($store() " \"$OLANG\" build -sanitize " $n ".olang > out.txt 2>&1 && ./build/" $n ".san > s.txt 2>&1 && cmp -s s.txt "
                    $n ".want")) == 0, $n " -s", dir)
    try r.expect(sh(dir, ($store() " \"$OLANG\" build -debug " $n ".olang > out.txt 2>&1 && ./build/" $n ".debug > d.txt 2>&1 && cmp -s d.txt "
                    $n ".want")) == 0, $n " -d", dir)
    if n in StrheldNotInterpreted { return }
    try r.expect(sh(dir, "\"$OLANG\" interpret " $n ".olang > i.txt 2>&1 && cmp -s i.txt " $n ".want") == 0, $n " -i", dir)
}

fn strheld(r mut report&) ? Failed {
    dir := fresh("strheld/tail")
    os.Run("cp checks/fixtures/strheld/* " $os.Quote(dir))
    #S16, S18b: a test failing inside a Str unwinds what the Str made, and the next test runs
    try r.expect(sh(dir, "\"$OLANG\" test donenested.olang > out.txt 2>&1") != 0, "donenested", dir)
    try r.expect(outOf(dir).Contains("1 passed, 2 failed") and outOf(dir).CountOf("Res destructed 7") == 2
                 "donenested output", dir)
    #C6: a check failing after a rendering whose builder grew inside a render helper unwinds live frames only
    try r.expect(sh(dir, "timeout 120 \"$OLANG\" test builderunwind.olang > out.txt 2>&1") != 0, "builderunwind", dir)
    try r.expect(outOf(dir).Contains("1 passed, 1 failed"), "builderunwind output", dir)
    #N8: a recursion through a Str keeps no builder header in a frame whose text fits its room
    try r.expect(sh(dir, "\"$OLANG\" build strdepth.olang > out.txt 2>&1 && ./build/strdepth 28000 > out.txt 2>&1") == 0
                 "strdepth", dir)
    try r.expect(outOf(dir) == "156891\n", "strdepth output", dir)
}

# D16c: a capturing lambda held in a local keeps its environment in the frame exactly when every use the checker made of
# the local is a call through it - one passed on, stored, captured by a later lambda, spawned, compared with "is",
# assigned to another local or returned never does (envcheck.olang counts the environments made in a stack slot and in
# an arena), and each runs clean built, built -s and interpreted
test "a local lambda only ever called keeps its environment in the frame, and no other" { assert passed("frameenv") }

fn frameenv(r mut report&) ? Failed {
    dir := fresh("frameenv")
    os.Run("cp checks/fixtures/frameenv/* " $os.Quote(dir))
    for n in String&["frameonly", "frameescapes"] {
        try r.expect(sh(dir, "\"$OLANG\" build " $n ".olang > out.txt 2>&1 && ./build/" $n " > out.txt 2>&1") == 0, n, dir)
        try r.expect(sh(dir, "\"$OLANG\" build -sanitize " $n ".olang > out.txt 2>&1 && ./build/" $n ".san > out.txt 2>&1") == 0
                     $n " -s", dir)
        try r.expect(sh(dir, "\"$OLANG\" interpret " $n ".olang > out.txt 2>&1") == 0, $n " -i", dir)
    }
    try r.expect(sh(dir, "\"$OLANG\" build envcheck.olang > out.txt 2>&1") == 0, "envcheck", dir)
    try r.expect(sh(dir, "./build/envcheck build/frameonly.main.ll > out.txt") == 0 and outOf(dir) == "3 0\n"
                 "frameonly's three environments in the frame", dir)
    try r.expect(sh(dir, "./build/envcheck build/frameescapes.main.ll > out.txt") == 0 and outOf(dir) == "0 8\n"
                 "no environment of a local that leaves the frame in it", dir)
}

# the runtime's regions (docs/memory.md 3.4), driven from C: what is built in a region, small and large, its destructors
# run once as it is released, regions left in their scope closed with it, constant data and null naming none, and
# 200,000 regions nested in one another closed with constant stack - apart from the analysis that has lowering make them
test "the runtime's regions make, release and hand back what they hold" { assert passed("regions") }

fn regions(r mut report&) ? Failed {
    dir := fresh("regions")
    os.Run("cp checks/fixtures/regions/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" build -debug stub.olang > out.txt 2>&1") == 0, "stub.olang did not build", dir)
    try r.expect(sh(dir, "clang -O0 drive.c build/olang_runtime.*.debug.o -o drive -lpthread -ldl -lm > out.txt 2>&1") == 0
                 "drive.c did not link", dir)
    for want in String&["small 2 0", "large 2 0", "null 0 0", "kept 4 0", "chain 200000 0"] {
        mode := want[:try want.FindByte(' ') catch default 0]
        try r.expect(sh(dir, "./drive " $mode " > out.txt 2>&1") == 0 and outOf(dir) == $want "\n", "drive " $mode, dir)
    }
}

# S16, S18b, P1d, S19c: tests failing on purpose - in a join, frames down, in a Str, in a destructor, on another stack,
# by an error leaving the body, by a "!" (on a spawned call and a checked index too, E35) - each read back by the test
# after it; S18d: the error return trace, after an
# error ends a test, escapes main or reaches a "!", in a -d build and under -i, and a hint to get it in any other
test "tests that fail on purpose, and where an error went" { assert passed("testends") }

fn testends(r mut report&) ? Failed {
    dir := fresh("testends")
    os.Run("cp checks/fixtures/testends/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" test ends.olang > out.txt 2>&1") != 0, "ends", dir)
    try r.expect(sh(dir, "cmp -s out.txt ends.want") == 0, "ends output", dir)
    for n in String&["traced", "banged", "spawnbanged", "checkbanged", "contractbanged", "why"] {
        try r.expect(sh(dir, "\"$OLANG\" build " $n ".olang > out.txt 2>&1") == 0, $n " build", dir)
        # the shell adds its own "Aborted" line after what a program stopped by '!' printed
        try r.expect(sh(dir, "./build/" $n " > b.txt 2>&1; grep -v '^Aborted' b.txt | cmp -s - " $n ".b.want") == 0, n, dir)
        try r.expect(sh(dir, "\"$OLANG\" build -debug " $n ".olang > out.txt 2>&1") == 0, $n " -d build", dir)
        try r.expect(sh(dir, "./build/" $n ".debug > d.txt 2>&1; grep -v '^Aborted' d.txt | cmp -s - " $n ".d.want") == 0
                     $n " -d", dir)
        try r.expect(sh(dir, "\"$OLANG\" interpret " $n ".olang > i.txt 2>&1; grep -v '^Aborted' i.txt | cmp -s - " $n ".d.want") == 0
                     $n " -i", dir)
    }
}

# B3g: a file written where the mode would stand is built and run - its arguments after it, an option's spelling
# included, its status its own, a signal's as a shell reports it; a file starting "#!/usr/bin/env olang" runs as a
# script; a build error runs nothing
test "a file is built and run, and runs as a script" { assert passed("runfile") }

fn runfile(r mut report&) ? Failed {
    dir := fresh("runfile")
    os.Run(("cp checks/fixtures/runfile/* " $os.Quote(dir) " && mkdir " $os.Quote($dir "/bin") " && ln -s " $os.Quote(olang())
           " " $os.Quote($dir "/bin/olang")))
    try r.expect(sh(dir, "\"$OLANG\" script.olang a -debug --x > out.txt 2>&1") == 0, "olang script.olang", dir)
    try r.expect(outOf(dir) == "script.olang\na\n-debug\n--x\n", "the program's arguments", dir)
    try r.expect(sh(dir, "\"$OLANG\" script.olang seven > out.txt 2>&1") == 7, "the program's status", dir)
    try r.expect(sh(dir, "chmod +x script.olang && PATH=\"$PWD/bin:$PATH\" ./script.olang b > out.txt 2>&1") == 0
                 "./script.olang", dir)
    try r.expect(outOf(dir) == "./script.olang\nb\n", "the script's arguments", dir)
    try r.expect(sh(dir, "\"$OLANG\" -debug script.olang c > out.txt 2>&1 && test -x build/script.debug") == 0
                 "olang -debug script.olang", dir)
    try r.expect(outOf(dir) == "script.olang\nc\n", "-debug: the program's arguments", dir)
    try r.expect(sh(dir, "\"$OLANG\" bad.olang > out.txt 2>&1") == 1 and outOf(dir).Contains("bad.olang:3:") and
                 sh(dir, "test ! -e build/bad") == 0, "a build error", dir)
}

# B3h: -output names build's executable and compile's object - copied from build/, where it stays current - in a
# directory that must be there; no other mode takes it
test "-output names what build and compile write" { assert passed("output") }

fn output(r mut report&) ? Failed {
    dir := fresh("output")
    os.Run("cp checks/fixtures/output/* " $os.Quote(dir) " && mkdir " $os.Quote($dir "/out"))
    try r.expect(sh(dir, "\"$OLANG\" build -output out/p prog.olang > out.txt 2>&1 && test ! -e build/prog && ./out/p > out.txt") ==
                 0 and outOf(dir) == "written where -output said\n", "build -output", dir)
    try r.expect(sh(dir, "\"$OLANG\" compile prog.olang -output out/a.o > out.txt 2>&1 && test -s out/a.o") == 0
                 "compile -output", dir)
    try r.expect(sh(dir, "\"$OLANG\" compile -output out/b.o prog.olang > out.txt 2>&1 && cmp -s out/a.o out/b.o") == 0
                 "compile -output, the object current", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -output nodir/p prog.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("error[B3h]: -output nodir/p: there is no directory nodir"), "a missing directory", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -output out prog.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("is a directory"), "a directory", dir)
    try r.expect(sh(dir, "\"$OLANG\" test -output out/t prog.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("-output applies to build, compile, bindgen and profile, not to test"), "test -output", dir)
    try r.expect(sh(dir, "\"$OLANG\" -output out/q prog.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("not to running a file"), "running a file with -output", dir)
}

# B13: format rewrites a file in the layout and -check lists the files not in it; a file that does not parse is left as
# it is, its diagnostics said; formatting a formatted file changes nothing
test "format writes the layout, and -check lists what is not in it" { assert passed("format") }

fn formatting(r mut report&) ? Failed {
    dir := fresh("format")
    os.Run("cp checks/fixtures/format/* " $os.Quote(dir) " && cd " $os.Quote(dir) " && cp ugly.olang u.olang && cp ugly.want w.olang && cp broken.olang b.olang")
    try r.expect(sh(dir, "\"$OLANG\" format -check u.olang w.olang > out.txt 2> err.txt") == 1 and outOf(dir) == "u.olang\n"
                 "format -check lists the file not in the layout", dir)
    try r.expect(sh(dir, "cmp -s u.olang ugly.olang") == 0, "format -check rewrote a file", dir)
    try r.expect(sh(dir, "\"$OLANG\" format u.olang > out.txt 2>&1 && cmp -s u.olang ugly.want") == 0, "format's layout", dir)
    try r.expect(sh(dir, "\"$OLANG\" format -check u.olang > out.txt 2> err.txt") == 0 and outOf(dir) == "", "formatted twice", dir)
    try r.expect(sh(dir, "\"$OLANG\" u.olang > out.txt 2>&1") == 0, "the formatted program runs", dir)
    try r.expect(sh(dir, "\"$OLANG\" format b.olang > out.txt 2>&1") == 1 and outOf(dir).Contains("b.olang:3:1: error") and
                 sh(dir, "cmp -s b.olang broken.olang") == 0, "a file that does not parse", dir)
    try r.expect(sh(dir, "\"$OLANG\" format -debug u.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("-debug applies to"), "format -debug", dir)
}

# B17: fix runs the migration tools of tools/ over files written in an older language: -check lists the files it would
# change and writes nothing, fix rewrites them and lists them, a file already in today's language is left alone, and
# fixing a second time changes nothing. The tools are built into the cache the check gives it (OLANG_CACHE)
test "fix rewrites old code to the language of today, and -check only says so" { assert passed("fix") }

fn fixing(r mut report&) ? Failed {
    dir := fresh("fix")
    os.Run("cp checks/fixtures/fix/* checks/fixtures/output/prog.olang " $os.Quote(dir) " && cd " $os.Quote(dir) " && cp old.olang o.olang && cp prog.olang p.olang && cp prog.olang prog.keep")
    env := "export OLANG_CACHE=" $os.Quote($dir "/cache") " && "
    try r.expect(sh(dir, $env "\"$OLANG\" fix -check o.olang p.olang > out.txt 2> err.txt") == 1 and outOf(dir) == "o.olang\n"
                 "fix -check lists the old file and only that", dir)
    try r.expect(sh(dir, "cmp -s o.olang old.olang") == 0, "fix -check rewrote a file", dir)
    try r.expect(sh(dir, $env "\"$OLANG\" fix o.olang p.olang > out.txt 2> err.txt") == 0 and outOf(dir) == "o.olang\n"
                 "fix lists the file it rewrote", dir)
    try r.expect(sh(dir, "cmp -s o.olang new.want") == 0, "fix's result", dir)
    try r.expect(sh(dir, "cmp -s p.olang prog.keep") == 0, "a file of today changed", dir)
    try r.expect(sh(dir, $env "\"$OLANG\" fix -check o.olang p.olang > out.txt 2> err.txt") == 0 and outOf(dir) == "", "fixed twice", dir)
    try r.expect(sh(dir, "\"$OLANG\" o.olang > out.txt 2>&1") == 0 and outOf(dir) == "fixed 7\n4\n", "the fixed program runs", dir)
    try r.expect(sh(dir, "\"$OLANG\" fix -debug o.olang > out.txt 2>&1") == 1 and outOf(dir).Contains("-debug applies to"), "fix -debug", dir)
    try r.expect(sh(dir, "\"$OLANG\" fix missing.olang > out.txt 2>&1") == 2 and outOf(dir).Contains("missing.olang: cannot be read"), "a missing file", dir)
    # the lang25 review: what fix cannot settle from the text is listed and the status is 1; what it rewrites computes
    # what the program did when written (master's output, 2026-10-25)
    os.Run("cd " $os.Quote(dir) " && cp before25.olang b.olang")
    try r.expect(sh(dir, $env "\"$OLANG\" fix b.olang > out.txt 2> err.txt") == 1 and outOf(dir) == "b.olang\n" and
                 sh(dir, "grep -q '2 places above may mean something else' err.txt") == 0, "fix lists what it cannot settle", dir)
    try r.expect(sh(dir, "cmp -s b.olang before25.want") == 0, "fix's result for code before 2026-10-25", dir)
    try r.expect(sh(dir, "\"$OLANG\" b.olang > out.txt 2>&1") == 0 and outOf(dir) == "5 2 13 3 5 2 false 2 2 2\n", "the program fixed computes what it did", dir)
}

# B1: the command line is words - a mode, options checked against the modes they apply to, help - and a one-character
# flag is no option
test "the command line is words" { assert passed("words") }

fn words(r mut report&) ? Failed {
    dir := fresh("words")
    os.Run("cp checks/fixtures/output/prog.olang " $os.Quote(dir))
    os.Run("cp checks/cases/b14docbuilders.olang " $os.Quote(dir) "/b.olang")
    try r.expect(sh(dir, "\"$OLANG\" > out.txt 2>&1") == 1 and outOf(dir).Contains("error[B1]: nothing to do"), "no arguments", dir)
    try r.expect(sh(dir, "\"$OLANG\" bild prog.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("'bild' is not a mode - the modes are build, compile"), "an unknown mode", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -b prog.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("unknown option '-b'"), "an old flag", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret -debug prog.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("-debug applies to running a file, build, compile and test, not to interpret")
                 "an option for another mode", dir)
    try r.expect(sh(dir, "\"$OLANG\" -debug prog > out.txt 2>&1") == 1 and outOf(dir).Contains("'prog' is no olang file")
                 "running a file without .olang", dir)
    try r.expect(sh(dir, "\"$OLANG\" -debug build prog.olang > out.txt 2>&1") == 1 and
                 outOf(dir).Contains("the mode comes first"), "a mode after an option", dir)
    try r.expect(sh(dir, "\"$OLANG\" build -target > out.txt 2>&1") == 1 and outOf(dir).Contains("-target needs a value")
                 "an option missing its value", dir)
    try r.expect(sh(dir, "\"$OLANG\" help > out.txt 2>&1") == 0 and outOf(dir).Contains("  interpret ") and
                 outOf(dir).Contains("  format "), "help", dir)
    try r.expect(sh(dir, "\"$OLANG\" help format > out.txt 2>&1") == 0 and outOf(dir).Contains("-check"), "help format", dir)
    try r.expect(sh(dir, "\"$OLANG\" explain b.olang Color > out.txt 2>&1") == 0 and outOf(dir).Contains("    fn FromHex(t String&) Color ? ColorError\n    fn Gray(level U8) mut Color&\n    fn (c Color&) Hex()")
                 "explain lists a type's builders before its methods (B11b)", dir)
    try r.expect(sh(dir, "\"$OLANG\" explain B3g > out.txt 2>&1") == 0 and outOf(dir).Contains("running a file"), "explain", dir)
    try r.expect(sh(dir, "\"$OLANG\" interpret prog.olang > out.txt 2>&1") == 0 and
                 outOf(dir) == "written where -output said\n", "interpret", dir)
}

test "a run case's stored output is read back from compiler/goldens/run.txt" {
    one := storedOutput("c2dctorbuilds.olang")
    assert one.Stored and one.Out.Len() > 0 and one.Out.EndsWith("\n")
    none := storedOutput("c2swap.olang")
    assert none.Stored and none.Out == ""
    assert not storedOutput("no such case.olang").Stored
}
