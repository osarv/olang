# T36: every numeric primitive has alias tags of its own - a BF16 or F16 element stored through a struct carries one, as
# an F32's always did (untagged, the store might have changed the array's descriptor, so a loop through a struct reloaded
# it at every element and never vectorized). Arrays of every narrow type written through a struct, and a declared
# number's array beside its base's view of the same storage, read back the same at -O3 and at -d
test "every numeric primitive has its own alias tags" { assert passed("tbaa") }

fn tbaa(r mut report&) ? Failed {
    dir := fresh("tbaa")
    os.Run("cp checks/fixtures/tbaa/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b narrow.olang > out.txt 2>&1 && ./build/narrow > out.txt 2>&1") == 0, "narrow", dir)
    try r.expect(outOf(dir) == "narrow: ok\n", "narrow output", dir)
    ll String& = " build/narrow.main.ll"
    try r.expect(sh(dir, "grep -q 'store bfloat [^,]*, ptr [^,]*, !tbaa'" $ll) == 0, "a BF16 store carries no tag", dir)
    try r.expect(sh(dir, "grep -q 'store half [^,]*, ptr [^,]*, !tbaa'" $ll) == 0, "an F16 store carries no tag", dir)
    try r.expect(sh(dir, "grep -q '!{!\"bf16\\[\\]\", !20, i64 0}'" $ll) == 0, "no BF16 element leaf", dir)
    debug String& = "\"$OLANG\" -b -d narrow.olang > out.txt 2>&1 && ./build/narrow.debug > out.txt 2>&1"
    try r.expect(sh(dir, debug) == 0, "narrow -d", dir)
    try r.expect(outOf(dir) == "narrow: ok\n", "narrow -d output", dir)
}

# E31: a capitalized operator method is the operator everywhere; a lowercase one only in its own module
test "a private operator works only in its own module" { assert passed("opvis") }

fn opvis(r mut report&) ? Failed {
    dir := fresh("opvis")
    os.Run("cp checks/fixtures/opvis/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b use.olang > out.txt 2>&1 && ./build/use") == 0, "opvis", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b usepriv.olang > out.txt 2>&1") != 0, "usepriv.olang compiled", dir)
}

# M6b: every method the compiler calls by itself - operators, ==, $, indexing, for, in, Call, Hash - may be private: it
# works in its own module, a generic of that module included, and using the operation anywhere else is an error naming
# the method. A generic of another module sees with that module's eyes. Inside() is also baked while compiling (K2)
test "a private protocol method works in its own module, and is an error elsewhere" { assert passed("protopriv") }

fn protopriv(r mut report&) ? Failed {
    dir := fresh("protopriv")
    os.Run("cp checks/fixtures/protopriv/* " $os.Quote(dir))
    try r.expect(sh(dir, "\"$OLANG\" -b use.olang > out.txt 2>&1 && ./build/use") == 0, "protopriv", dir)
    try r.expect(sh(dir, "grep -q '@kk_Baked = .*i1 true' build/kk*.ll") == 0, "Inside() was not baked", dir)
    try r.expect(sh(dir, "\"$OLANG\" -b bad.olang > out.txt 2>&1") != 0, "bad.olang compiled", dir)
    for what in String&["'==' needs Key's eq", "'$' needs Key's str", "'+' needs Vec's plus", "'>' needs Vec's less",
                        "'[' needs Bag's at", "'for' needs Bag's at", "'in' needs Bag's has", "'for' needs Gen's next",
                        "needs Adder's call", "'Hash' needs Key's hash", "compilation failed with 14 errors"] {
        try r.expect(outOf(dir).Contains(what), "bad.olang: expected " $what, dir)
    }
    try r.expect(sh(dir, "\"$OLANG\" -b badgen.olang > out.txt 2>&1") != 0, "badgen.olang compiled", dir)
    try r.expect(outOf(dir).Contains("gen.olang:2:39: error[M6b]: '==' needs Mine's eq"), "badgen.olang: the error", dir)
}

# T17: an enum's payload is whole words, so copying one is word moves, not one byte at a time - which is what let
# a match over a collection of enums run at the speed of a C switch
test "an enum's payload is held as words" { assert passed("enumwords") }

