    try r.expect(sh(dir, "\"$OLANG\" -b loop.olang > out.txt 2>&1 && ./build/loop") == 0, "listloop", dir)
    try r.expect(sh(dir, "grep -q 'call .*@std_prelude_list.List.I16.RunFrom.I16' build/loop.main.ll") == 0,
                 "no call of RunFrom", dir)
