# a generic type holding an any whose trait's argument is the type's variable: is T substituted in the field's type?
type Ups struct(n I64) {
    n
    at I64 = 0
}
fn (u mut Ups&) Next() I64 ? Exhausted {
    if u.at >= u.n { error Exhausted.END }
    u.at += 1
    return u.at * 100
}
type Src<T> struct(it mut any Iterator<T>&) { it }
fn (s mut Src<T>&) First() T ? Exhausted { return try s.it.Next() }
fn (s mut Src<T>&) Twice() I64 { return s.it.Count(fn(x T) Bool { return true }) }
fn main() {
    s := Src<I64>(Ups(3))
    v := try s.First() catch default -1
    say($v " " $s.Twice())
}
