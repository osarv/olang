import "std/io"
# a plain String (no conversion) into an any, from a conditional, a match and a catch default of block-local text
type Up trait {
    ToUpper() String
}
error Oops {
    BAD
}
fn bad(k I64) String ? Oops {
    if k < 10 { error Oops.BAD }
    return "never"
}
fn main() {
    xs := List<any Up&>()
    for i in range 3 {
        s := "text" $i "-" $(i * 7)
        u := "other" $i "-" $(i * 7)
        xs.Push(s if s.Len() > 2 else u)
        xs.Push(match s.Len() { case 0 => u case _ => s })
        xs.Push(try bad(i) catch default s)
        xs.Push(s)
    }
    churn()
    for x in xs { say(x.ToUpper()) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
