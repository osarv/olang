import "std/io"
# E30: a < 5 < b with a an I8 and b a U64 is refused (T6b), where "a < 5 and 5 < b" compiles
fn chained(a I8, b U64) Bool { return a < 5 < b }
fn main() { say($chained(1, 7)) }
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
