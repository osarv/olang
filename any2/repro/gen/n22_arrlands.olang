import "std/io"
# an array of loop-built text copied into an any that lands in: a function's result, a parameter's field, a global
type Sized trait {
    Len() I64
}
type Hold struct() {
    s any Sized?& = null
}
GS mut any Sized?& = null
fn mk(i I64) any Sized& {
    a := Array<String&>(2, "x")
    a[0] = "e" $i
    return a
}
fn put(h mut Hold&, i I64) {
    a := Array<String&>(2, "x")
    a[0] = "p" $i
    h.s = a
}
fn glob(i I64) {
    a := Array<String&>(2, "x")
    a[0] = "g" $i
    GS = a
}
fn main() {
    xs := List<any Sized&>()
    h := Hold()
    for i in range 3 {
        xs.Push(mk(i))
        put(h, i)
        glob(i)
    }
    churn()
    for x in xs { say($x) }
    say($h.s)
    say($GS)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
