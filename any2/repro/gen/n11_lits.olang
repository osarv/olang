import "std/io"
# E30, E16, E4a, E10 against the evaluator: each computed baked (G*) and at run time from mutable inputs (L*)
fn chain(u U64, f F32, g F64, a I8, b U64) String {
    return $(5 > u >= 2) " " $(f < 0.1 < g) " " $(0.1 < g) " " $(2 <= u < 18446744073709551615)
}
fn idx(u U64, s U8, j I8) String {
    a := I64[10, 20, 30]
    x := checked a[u] catch default -1
    y := checked a[s] catch default -2
    z := checked a[j] catch default -3
    w := a[(match u { case 1 => U64(2) case _ => U64(0) })]
    return $x " " $y " " $z " " $w
}
fn lits() String {
    x := -9223372036854775808
    y := 9223372036854775808
    z := 9223372036854775807 + 1
    v := 18446744073709551615 - 1
    h := 0x8000000000000000
    m := -(9223372036854775807) - 1
    return $x " " $y " " $z " " $v " " $h " " $m
}
fn arrs(k I64) String {
    a := I64[1, 2]
    b := I64[1, 2, k]
    c := I64[1, 2]
    return $(a == b) " " $(a == c) " " $(I64[1, 2] == I64[1, 2, 3]) " " $(a != b)
}
GC String = chain(3, F32(0.1), 0.10000000001, 1, 7)
GI String = idx(18446744073709551615, 200, -1)
GI2 String = idx(1, 2, 0)
GL String = lits()
GA String = arrs(3)
LU mut U64 = 3
LF mut F32 = 0.1
LG mut F64 = 0.10000000001
LA mut I8 = 1
LB mut U64 = 7
LBig mut U64 = 18446744073709551615
LS mut U8 = 200
LJ mut I8 = -1
LK mut I64 = 3
fn main() {
    say(GC)
    say(chain(LU, LF, LG, LA, LB))
    say(GI)
    say(idx(LBig, LS, LJ))
    say(GI2)
    say(idx(LU - 2, LS - 198, LJ + 1))
    say(GL)
    say(lits())
    say(GA)
    say(arrs(LK))
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
