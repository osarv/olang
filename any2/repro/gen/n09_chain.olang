import "std/io"
# lazy default slots reached indirectly: a default whose body makes an any of its receiver and calls another default
# through it; an any of a trait extending the one declaring the defaults; a default called from generic code over the any
type A trait {
    Area() I64
}
type B trait extends A {
    Name() String
}
fn (s S) D1<S A>() I64 {
    a any A& = s
    return a.D2() + 1
}
fn (s S) D2<S A>() I64 { return s.Area() * 10 }
fn (s S) D3<S A>() I64 { return s.Area() * 100 }
type Sq struct(n I64) { n }
fn (q Sq&) Area() I64 { return q.n * q.n }
fn (q Sq&) Name() String { return "sq" }
fn gen<S B>(s S) I64 { return s.D3() }
fn run(n I64) String {
    q := Sq(n)
    b any B& = q
    a any A& = q
    return $b.D1() " " $gen(b) " " $a.D1() " " $b.Name()
}
G String = run(2)
fn main() {
    say(G)
    say(run(3))
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
