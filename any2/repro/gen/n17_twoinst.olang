import "std/io"
# two instances of one generic type each declaring its own Describe, beside the trait's default: which runs?
type IShape trait {
    Area() I64
}
fn (s S) Describe<S IShape>() String { return "default " $s.Area() }
type Box<T> struct(v T, n I64) {
    v
    n
}
fn (b Box<T>&) Area() I64 { return b.n }
fn (b Box<String&>&) Describe() String { return "text box " $b.v }
fn (b Box<I64>&) Describe() String { return "int box " $b.v }
fn gen<S IShape>(s S) String { return s.Describe() }
fn run(n I64) String {
    t := Box<String&>("t", n)
    i := Box<I64>(40, n)
    x any IShape& = t
    y any IShape& = i
    return $t.Describe() "|" $i.Describe() "|" $gen(t) "|" $gen(i) "|" $x.Describe() "|" $y.Describe()
}
G String = run(1)
fn main() {
    say(G)
    say(run(2))
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
