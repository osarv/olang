# a default slot reached only while compiling: a baked global, a top-level condition, an assert decided while compiling
type Ups struct(n I64) {
    n
    at I64 = 0
}
fn (u mut Ups&) Next() I64 ? Exhausted {
    if u.at >= u.n { error Exhausted.END }
    u.at += 1
    return u.at
}
fn counted(n I64) I64 {
    it mut any Iterator<I64>& = Ups(n)
    return it.Count(fn(x I64) Bool { return x > 1 })
}
G I64 = counted(4)
if counted(3) == 2 {
    fn which() String { return "two" }
} else {
    fn which() String { return "not two" }
}
fn main() {
    assert counted(5) == 4
    say("G " $G " " $which())
}
