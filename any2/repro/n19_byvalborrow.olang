# O14: a by-value parameter's own storage returned as borrowed from it, by shapes beside a plain "return p"
type Pt struct(x I64, y I64) {
    x
    y
}
type Two struct(a Pt, b Pt) {
    a
    b
}
type Named trait {
    Name() String
}
fn (p Pt&) Name() String { return "pt " $p.x }
fn f1(t Two) Pt&t { return t.a }
fn f2(t Two, c Bool) Pt&t { return t.a if c else t.b }
fn f3(t Two) Pt&t { return match t.a.x { case 0 => t.b case _ => t.a } }
fn f4(t Two) any Named&t { return t.b }
fn f5(p Pt) Pt&p {
    q := p
    return q
}
fn idr(p Pt&) Pt&p { return p }
fn f6(p Pt) Pt&p { return idr(p) }
fn main() {
    w := Two(Pt(1, 2), Pt(3, 4))
    r1 := f1(w)
    r2 := f2(w, true)
    r3 := f3(w)
    r4 := f4(w)
    r5 := f5(Pt(5, 6))
    r6 := f6(Pt(7, 8))
    churn()
    say($r1.x " " $r2.x " " $r3.x " " $r4.Name() " " $r5.x " " $r6.x)
}
