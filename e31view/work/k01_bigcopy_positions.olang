# an element over 64KB (its hidden copy comes from a block's arena, T7c) lent as a view in a loop's condition, a for's
# post clause, a do-for condition, a match guard, a catch default and the right side of 'and'
type Big struct() {
    a Array<I64, 9000> = Array<I64, 9000>()
}
type V struct(d mut Array<I64>&, n I64) {
    d
    n
    big Big = Big()
}
type Vs struct(d mut Array<I64>&) {
    d
}
fn (s Vs&) At(i I64) V { return V(s.d, i) }
fn put(v mut V&, x I64) I64 {
    v.d[v.n] = v.d[v.n] + x
    return v.d[v.n] + v.n
}
fn fails() I64 ? { error }
fn churn() {
    for k in range 30 {
        a := Array<I64>(300, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
fn run() I64 {
    s := Vs(Array<I64>(8))
    t I64 = 0
    for put(s[0], 1) < 3 {
        churn()
        t++
    }
    for i := 0, i < 3, i = put(s[1], 1) {
        churn()
        t++
    }
    do {
        churn()
        t++
    } for put(s[2], 1) < 5
    k := 3
    match k {
        case 3 if put(s[3], 2) > 0 { t += 1 }
        nomatch { }
    }
    t += try fails() catch default put(s[4], 3)
    if t > 0 and put(s[5], 6) > 0 { t += 1 }
    for j in range 3 {
        if put(s[6], j) > 100 { t += 1000 }
        churn()
    }
    return t * 1000000 + s.d[0] * 100000 + s.d[1] * 10000 + s.d[2] * 1000 + s.d[3] * 100 + s.d[4] * 10 + s.d[5] + s.d[6]
}
Baked I64 = run()
fn main() ? {
    println($run() " " $Baked)
}
