# the same, the copy written out by hand in the condition's place (base compiles this): t := s[0] in the body
type Big struct() {
    a Array<I64, 9000> = Array<I64, 9000>()
}
type V struct(d mut Array<I64>&, n I64) {
    d
    n
    big Big = Big()
}
type Vs struct(d mut Array<I64>&) {
    d
}
fn (s Vs&) At(i I64) V { return V(s.d, i) }
fn put(v mut V&, x I64) I64 {
    v.d[v.n] = v.d[v.n] + x
    return v.d[v.n]
}
fn cond(s Vs&) Bool {
    t := s[0]
    return put(t, 1) < 200000
}
fn main() ? {
    s := Vs(Array<I64>(8))
    for cond(s) { }
    println($s.d[0])
}
