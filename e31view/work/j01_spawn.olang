type V struct(d mut Array<I64>&, n I64) {
    d
    n
}
type Vs struct(d mut Array<I64>&) {
    d
}
fn (s Vs&) At(i I64) V { return V(s.d, i) }
fn put(v mut V&, x I64) I64 {
    v.d[v.n] = x
    return x
}
fn main() ? {
    s := Vs(Array<I64>(8))
    r I64 = 0
    join {
        for k in range 3 { spawn put(s[k], k + 1) }
        spawn r = put(s[5], 9)
        spawn fn() { put(s[6], 7) }()
    }
    println($s.d " " $r)
}
