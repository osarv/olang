# DIAGNOSTIC: one cause, two errors - the callee's own C2d error, then E31b at the caller because a body with errors
# is no view ("which this call would write while it can reach the collection another way")
type Node struct(v I64) {
    v
    next mut Node& = null
}
type E struct(h mut Node&, n I64) {
    head mut Node&h = h
    n
}
type Es struct(head mut Node&) {
    head
}
fn (s Es&) At(i I64) E { return E(s.head, i) }
fn hang(e mut E&, k I64) { e.head.next = Node(k) }
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
fn main() ? {
    s := Es(Node(1))
    for k in range 3 {

        hang(s[k], 100 + k)
    }
    churn()
    println($s.head.next.v)
}
