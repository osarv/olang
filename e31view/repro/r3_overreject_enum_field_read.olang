# OVER-REJECTION (survey): common read-only uses of the parameter that make a callee no view - each file o1N in work/
# match/== on an enum field, an inline array element read, $ of a value field are refused; reading c.p.X or $c.n is not
type K enum {
    A
    B
}
type Pt struct() {
    X I64 = 0
}
type V struct(d mut Array<I64>&, n I64) {
    d
    n
    kind K = K.A
    inl Array<I64, 2> = Array<I64, 2>()
    p Pt = Pt()
}
type Vs struct(d mut Array<I64>&) {
    d
}
fn (s Vs&) At(i I64) V { return V(s.d, i) }
fn f(c mut V&) {
    match c.kind {
        case K.A { c.d[0] = 1 }
        case K.B { }
    }
}
fn main() ? {
    s := Vs(Array<I64>(4))
    f(s[1])
    println($s.d)
}
