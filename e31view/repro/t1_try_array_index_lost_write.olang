# PRE-EXISTING, minor inconsistency: "try a[i] catch default v" on a BUILT-IN array is a value (the element or v), so lent
# to a "mut &" parameter it is a temporary and the write is silently lost (a[1] stays 0) - while c9d14a7 makes the List
# spelling, "bump(try l[0] catch default Acc())", E31b's error. "try a[i]" alone and "(try a[i]).M()" are the element
# and the writes land (a[0] 2, a[2] 10).
type Acc struct() {
    N I64 = 0
}
fn bump(a mut Acc&) { a.N++ }
fn (a mut Acc&) Add() { a.N += 10 }
fn main() ? {
    a := Acc[Acc(), Acc(), Acc()]
    bump(try a[0])
    bump(try a[1] catch default Acc())
    (try a[2]).Add()
    bump(a[0])
    println("N " $a[0].N " " $a[1].N " " $a[2].N)
}
