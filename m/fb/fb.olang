import "std/os"
import "std/io"
import "std/time"
fn foldSlots(body String&, nlocals I64) String {
    n := body.Len()
    starts Vec<I64>      # each line's start, its end, and the block it is in (a label line starts one)
    ends Vec<I64>
    blocks Vec<I64>
    s I64 = 0
    blk I64 = 0
    for s < n {
        e := s
        for e < n and body[e] != '\n' { e++ }
        if e > s and body[s] != ' ' and body[e - 1] == ':' { blk++ }
        starts.Push(s)
        ends.Push(e)
        blocks.Push(blk)
        s = e + 1
    }
    mentions := Array<I64>(nlocals)
    allocaAt := Array<I64>(nlocals, -1)
    storeAt := Array<I64>(nlocals, -1)
    loadAt := Array<I64>(nlocals, -1)
    for li in range starts.Len() {
        a := starts[li]
        z := ends[li]
        i := a
        for i < z {
            c := body[i]
            if c == '"' {
                i++
                for i < z and body[i] != '"' { i++ }
                i++
                continue
            }
            if c != '%' or i + 2 >= z or body[i + 1] != 'l' or not body[i + 2].IsDigit() {
                i++
                continue
            }
            j := i + 2
            v I64 = 0
            for j < z and body[j].IsDigit() {
                v = v * 10 + I64(body[j]) - I64('0')
                j++
            }
            if j < z and symbolChar(body[j]) or v >= nlocals {
                i = j
                continue
            }
            mentions[v] += 1
            atEnd := j == z or body[j] == ','
            if i == a + 2 and body[a:i] == "  " and body[j:z].StartsWith(" = alloca ") {
                allocaAt[v] = li
            } else if atEnd and i >= a + 6 and body[i - 6:i] == ", ptr " {
                if body[a:z].StartsWith("  store ") {
                    storeAt[v] = li
                } else if body[a:z].Contains(" = load ") {
                    loadAt[v] = li
                }
            }
            i = j
        }
    }
    skip := Array<Bool>(starts.Len())
    # by the number of the temporary a folded load defined (%tK, fnEm.tmp), the value it is named by instead: a
    # temporary's number read where it is written - a Map of names asked of every name in the body had been a third
    # of this function's work
    subst Vec<String&>
    folded := false
    for v in range nlocals {
        if mentions[v] != 3 or allocaAt[v] < 0 or storeAt[v] < 0 or loadAt[v] < 0 { continue }
        sl := storeAt[v]
        ll := loadAt[v]
        if not (blocks[sl] == blocks[ll] and sl < ll or blocks[sl] == 1 and blocks[ll] != 1) { continue }
        al := allocaAt[v]
        tyAt := try body[starts[al]:ends[al]].Find(" = alloca ") catch { continue }
        ty := body[starts[al] + tyAt + 10:ends[al]]
        if ty.Contains(", align") { continue }
        slot := $"%l" $v
        # the load: "  %X = load TY, ptr %lN..."
        ld := body[starts[ll]:ends[ll]]
        eq := try ld.Find(" = load ") catch { continue }
        if not ld[eq + 8:].StartsWith($ty ", ptr " $slot) { continue }
        name := ld[2:eq]
        if not name.StartsWith("%t") { continue }
        k := try name[2:].ParseInt() catch { continue }
        # the store: "  store TY V, ptr %lN...", V one token
        st := body[starts[sl]:ends[sl]]
        if not st[8:].StartsWith($ty " ") { continue }
        vs := 8 + ty.Len() + 1
        ve := try st.Find($", ptr " $slot) catch { continue }
        if ve <= vs { continue }
        val := st[vs:ve]
        if val.Contains(" ") or val.Contains(",") { continue }
        skip[al] = true
        skip[sl] = true
        skip[ll] = true
        for subst.Len() <= k { subst.Push("") }
        subst[k] = $val
        folded = true
    }
    if not folded { return $body }
    out := StringBuilder()
    for li in range starts.Len() {
        if skip[li] { continue }
        a := starts[li]
        z := ends[li]
        at := a
        i := a
        for i < z {
            c := body[i]
            if c == '"' {
                i++
                for i < z and body[i] != '"' { i++ }
                i++
                continue
            }
            if c != '%' {
                i++
                continue
            }
            j := i + 1
            m := tempNumber(body, i, z)
            for j < z and symbolChar(body[j]) { j++ }
            if m >= 0 and m < subst.Len() and subst[m] != "" {
                out.Push(body[at:i])
                r := subst[m]
                for {
                    q := tempNumber(r, 0, r.Len())
                    if q < 0 or q >= subst.Len() or subst[q] == "" { break }
                    r = subst[q]
                }
                out.Push(r)
                at = j
            }
            i = j
        }
        out.Push(body[at:z])
        if z < n { out.PushChar('\n') }
    }
    return out.ToString()
}
fn tempNumber(text String&, i I64, z I64) I64 {
    if i + 2 >= z or text[i + 1] != 't' or not text[i + 2].IsDigit() { return -1 }
    j := i + 2
    v I64 = 0
    for j < z and text[j].IsDigit() {
        v = v * 10 + I64(text[j]) - I64('0')
        j++
    }
    if j < z and symbolChar(text[j]) { return -1 }
    return v
}
fn symbolChar(c Char) Bool { return c.IsLetter() or c.IsDigit() or c == '_' or c == '.' or c == '$' or c == '-' }

fn maxSlot(t String&) I64 {
    m I64 = 0
    i I64 = 0
    for i + 2 < t.Len() {
        if t[i] == '%' and t[i + 1] == 'l' and t[i + 2].IsDigit() {
            j := i + 2
            v I64 = 0
            for j < t.Len() and t[j].IsDigit() {
                v = v * 10 + I64(t[j]) - I64('0')
                j++
            }
            if v + 1 > m { m = v + 1 }
            i = j
        } else {
            i++
        }
    }
    return m
}

fn main() {
    text := os.ReadFile("bodies.ll")!
    parts := text.Split("\n}\n")
    ns := Array<I64>(parts.Len())
    bodies := Array<String&>(parts.Len())
    for k, p in parts {
        bodies[k] = $p "\n}\n"
        ns[k] = maxSlot(bodies[k])
    }
    n I64 = 0
    t0 := time.Now()
    for round in range 5 {
        for k in range bodies.Len() {
            out := foldSlots(bodies[k], ns[k])
            n += out.Len()
        }
    }
    io.Println($"in " $(text.Len() * 5) " out " $n " ms " $((time.Now() - t0) / 1000000))!
}
