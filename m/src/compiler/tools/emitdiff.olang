# emitdiff - M9's acceptance, measured: each program built by the self-hosted pipeline (load, names, check, the scope
# pass, lower with its placement, emit - compiler/tools/emitdump.olang), run, and its run compared with stage 0's as
# compiler/goldens/run.txt stores it (captured by compiler/tools/rungold.olang, make rungold).
#
#     emitdiff [-v] [-standin] [-O LEVEL] [FILE...]
#
# A file of tests (the corpus, std's tests - the default list) is run as "olang test FILE" runs it, and compared test
# by test: a row per file, "same N" where every test ends as the stored run's does, else what each said - "golden P ok
# F fail; port P ok F fail; D differ" - and with -v each test that differs. A checks case ("# check: run") is a program,
# built and run, its output and status compared (its status alone where the stored output was unstable). Then the
# totals. The port's module is compiled by clang (at -O LEVEL, 0 by default) with the port's filled-in runtime beside it;
# a module clang refuses counts as "does not compile". The emitter is build/compiler_tools_emitdump (or $EMITDUMP); with
# -standin the port's modules are placed by lowering's stand-in placement instead of the scope pass's. Where the
# compiler ($OLANG, else build/olang) is built, the port's runtime is also compared
# with the one it fills in, as a row.

import "std/os"
import "std/io"
import "toolkit"

fn main() {
    args := os.Args()
    olang := absolute(toolkit.Compiler())
    emitdump := toolkit.Env("EMITDUMP", "build/compiler_tools_emitdump")
    verbose := false
    level := "0"
    standin := false
    files List<String&>
    k I64 = 1
    for k < args.Len() {
        if args[k] == "-v" {
            verbose = true
        } else if args[k] == "-standin" {
            standin = true
        } else if args[k] == "-O" and k + 1 < args.Len() {
            k++
            level = args[k]
        } else {
            files.Push(args[k])
        }
        k++
    }
    if files.Len() == 0 {
        for f in toolkit.Matching("tests", ".olang") { files.Push($f) }
        for f in toolkit.Matching("std", ".olang") { files.Push($f) }
        for f in toolkit.Matching("std/prelude/tests", ".olang") { files.Push($f) }
    }
    dir := "build/emitdiff"
    try os.MkDirAll($dir "/rt") catch os.OsError { toolkit.Die("emitdiff: cannot make " $dir) }
    rt := runtime(olang, emitdump, dir)
    gold := toolkit.GoldenRead("compiler/goldens/run.txt", "rungold")
    same, differ, broken I64 = 0, 0, 0
    tests, testsSame I64 = 0, 0
    for i in range files.Len() {
        f := files[i]
        program := f.StartsWith("checks/")
        # named as stage 0 names its binary (build/std_os_test), since a program may read its own name (os.Args)
        sub := $dir "/p" $i
        try os.MkDirAll(sub) catch os.OsError { toolkit.Die("emitdiff: cannot make " $sub) }
        base := f[:f.Len() - 6] if f.EndsWith(".olang") else f
        out := $sub "/" $base.Replace("/", "_") $("" if program else "_test")
        r := compare(gold, emitdump, level, rt, f, out, program, verbose, standin)
        toolkit.Say(r.Row)
        tests += r.Tests
        testsSame += r.Same
        if r.Broken {
            broken++
        } else if r.Equal {
            same++
        } else {
            differ++
        }
        try os.RemoveAll(sub) catch os.OsError { }
    }
    toolkit.Say(("== total: files " $files.Len() " same " $same " differ " $differ " broken " $broken "; tests " $tests
                 " ending as stored " $testsSame "\n"))
}

fn absolute(p String&) String {
    if p.StartsWith("/") { return $p }
    cwd := try os.Cwd() catch os.OsError { return $p }
    return $cwd "/" $p
}

# the runtime the port's modules are linked with: the port's own, filled in by emitdump (-rt, compiler/runtime.olang),
# and, where the compiler olang names is built, a row saying whether it is the text that compiler fills in for this
# machine (what a program declaring nothing but an import of std/ffi leaves in its build/)
fn runtime(olang String&, emitdump String&, dir String&) Array<String&> {
    try os.MkDirAll($dir "/rtport") catch os.OsError { toolkit.Die("emitdiff: cannot make " $dir "/rtport") }
    e := toolkit.Run(String&[emitdump, "-rt", $dir "/rtport"])
    if e.Status != 0 { toolkit.Die("emitdiff: the port's runtime was not filled in: " $e.Stderr) }
    prt String& = $dir "/rtport/olang_runtime.ll"
    pdc String& = $dir "/rtport/olang_dyncall.ll"
    if not toolkit.Built(olang) {
        toolkit.Say("runtime: not compared (no " $olang ")\n")
        return String&[prt, pdc]
    }
    toolkit.Write($dir "/rt/rt.olang", "import \"std/ffi\"\nfn main() { }\n")
    toolkit.Run(String&[$olang, "build", "rt.olang"], String&[], $dir "/rt")
    rt String& = ""
    dc String& = ""
    for n in toolkit.Matching($dir "/rt/build", ".ll") {
        if (try n.Find("olang_runtime.") catch default -1) >= 0 { rt = $n }
        if (try n.Find("olang_dyncall.") catch default -1) >= 0 { dc = $n }
    }
    if rt == "" or dc == "" { toolkit.Die("emitdiff: " $olang " left no runtime in " $dir "/rt/build") }
    same := toolkit.Read(prt) == toolkit.Read(rt) and toolkit.Read(pdc) == toolkit.Read(dc)
    toolkit.Say("runtime: " $(("the text " $olang " fills in") if same else ("differs from the text " $olang " fills in")) "\n")
    return String&[prt, pdc]
}

type result struct() {
    Row String& = ""
    Equal Bool = false
    Broken Bool = false
    Tests I64 = 0
    Same I64 = 0
}

fn compare(gold toolkit.Golden&, emitdump String&, level String&, rt Array<String&>&, f String&, out String&, program Bool, v Bool, standin Bool) result {
    r := result()
    # the stored run
    s0 := toolkit.RunStored(gold, f)
    if not s0.Found {
        r.Broken = true
        r.Row = $f ": no stored run in compiler/goldens/run.txt (make rungold)\n"
        return r
    }
    # the port's
    dump := List<String&>()
    dump.Push(emitdump)
    if not program { dump.Push("-t") }
    if standin { dump.Push("-standin") }
    dump.Push("-o")
    dump.Push($out ".ll")
    dump.Push(f)
    e := toolkit.Run(dump.ToArray())
    gaps := gapCount(e.Stderr)
    if e.Status != 0 {
        r.Broken = true
        r.Row = $f ": not emitted (status " $e.Status ")" "\n"
        return r
    }
    c := toolkit.Run(String&["clang", "-O" $level, "-w", $out ".ll", rt[0], rt[1], "-o", $out, "-lm", "-lpthread", "-ldl", "-lffi"])
    if c.Status != 0 {
        r.Broken = true
        r.Row = $f ": does not compile - " $firstLine(c.Stderr) "\n"
        return r
    }
    p := toolkit.Run(String&["timeout", "600", $out])
    if program {
        r.Equal = (not s0.Stable or toolkit.RunText(p.Stdout) == s0.Out) and p.Status == s0.Status
        r.Row = $f ": " $("same" if r.Equal else "differs (status " $s0.Status " / " $p.Status ")") $gapsText(gaps) "\n"
        return r
    }
    a := outcomes(toolkit.Rows(s0.Out))
    b := outcomes(toolkit.Rows(p.Stdout))
    r.Tests = a.Len()
    rows := StringBuilder()
    diffs I64 = 0
    for name in a.Keys() {
        x := try a.Get(name) catch default ""
        y := try b.Get(name) catch default "missing"
        if x == y {
            r.Same++
        } else {
            diffs++
            if v { rows.Push("    " $name ": golden " $x ", port " $y "\n") }
        }
    }
    r.Equal = diffs == 0 and p.Status == s0.Status
    if r.Equal {
        r.Row = $f ": same " $r.Tests $gapsText(gaps) "\n"
    } else {
        s0ok, s0f := counts(a)
        pok, pf := counts(b)
        r.Row = ($f ": golden " $s0ok " ok " $s0f " fail; port " $pok " ok " $pf " fail (status " $p.Status "); " $diffs
                 " differ" $gapsText(gaps) "\n" $rows.ToString())
    }
    return r
}

fn gapCount(t String&) I64 {
    n I64 = 0
    for row in toolkit.Rows(t) {
        if row.StartsWith("gap ") { n++ }
    }
    return n
}

fn gapsText(n I64) String { return "" if n == 0 else " (" $n " gaps)" }

fn firstLine(t String&) String {
    for row in toolkit.Rows(t) {
        if row.Len() > 0 { return $row }
    }
    return ""
}

# each test's ending, by name: "ok" or "FAIL"
fn outcomes(rows List<String&>&) Map<String&, String&> {
    m Map<String&, String&>
    for row in rows {
        if row.StartsWith("ok - ") {
            m.Put($row[5:], "ok")
        } else if row.StartsWith("FAIL - ") {
            n := row[7:]
            k := try n.Find(": ") catch default -1
            m.Put($n[:k] if k >= 0 else $n, "FAIL")
        }
    }
    return m
}

fn counts(m Map<String&, String&>&) I64, I64 {
    ok, bad I64 = 0, 0
    for v in m.Values() {
        if v == "ok" { ok++ } else { bad++ }
    }
    return ok, bad
}
