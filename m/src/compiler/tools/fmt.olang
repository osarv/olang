# fmt - the formatter "olang format" and "olang format -check" run (SPEC.md B13), over the self-hosted scanner and parser
# (compiler/fmt.olang). Built by the compiler, which finds this file beside itself.
#
#     fmt -f FILE...    each file rewritten in place in the one layout
#     fmt -l FILE...    each file not in the layout named, one a line; nothing written
#     fmt -p FILE...    each file's layout written to the standard output; nothing written
#     fmt -v FILE...    for the tests: each file formatted in memory, and checked - the tree read back is the file's
#                       (compiler/tools/unparse), its comments are its own, and formatting the result changes nothing.
#                       A line for each file that failed, what failed; then a count. Nothing written
#
# A file that does not parse is left as it is, and its diagnostics are written as the compiler writes them. The exit
# status is 1 when a file did not parse, could not be read or written, (-l) is not in the layout, or (-v) failed.

import "std/os"
import "std/io"
import "../source"
import "../scan"
import "../parse"
import "../diag"
import layout "../fmt"
import "../unparse"

fn main() ? {
    args := os.Args()
    mode := args[1] if args.Len() >= 2 else ""
    if (mode != "-f" and mode != "-l" and mode != "-p" and mode != "-v") or args.Len() < 3 {
        try io.PrintErrln("usage: fmt -f|-l|-p|-v FILE...") catch io.IoError { }
        os.Exit(2)
    }
    os.RunOnStack(1 << 30, fn() { os.Exit(run(mode, args)) })
}

fn run(mode String&, args Array<String&>&) I32 {
    std := try os.Env("OLANG_STD") catch default "std"
    if mode != "-v" { return layout.Files(mode, args[2:], std) }
    out := io.Writer(1)
    prelude := layout.PreludeTypes(std)
    status I32 = 0
    same I64 = 0
    changed I64 = 0
    skipped I64 = 0
    failed I64 = 0
    for k in range 2, args.Len() {
        path := args[k]
        src := try source.Read(path) catch os.OsError {
            try io.PrintErr("olang: " $path ": cannot be read\n") catch io.IoError { }
            status = 1
            continue
        }
        said := StringBuilder()
        text := try layout.FileLayout(src, std, prelude, false, said) catch {
            skipped++
            continue
        }
        what := verify(src, text, std, prelude)
        if what != "" {
            out.Write($path ": " $what "\n")
            failed++
            status = 1
        } else if text == src.Text {
            same++
        } else {
            changed++
        }
    }
    out.Write(($(same + changed + skipped + failed) " files: " $same " already formatted, " $changed " formatted, "
              $skipped " skipped (they do not parse), " $failed " failed\n"))
    try out.Flush() catch io.IoError { return 1 }
    return status
}

# what is wrong with text as the layout of src, or "": it parses, its tree is src's, it holds src's comments, and it is
# its own layout
fn verify(src source.Source&, text String&, std String&, prelude String&) String& {
    names := source.Names()
    o := layout.OracleFor(src.Path, std, prelude, names)
    diags := diag.Diagnostics(false)
    file := diags.AddFile(src.Path, src.Text)
    ts := scan.Scan(src.Text)
    p := parse.Parser(src, ts, names, o, diags, file)
    decls := p.File()
    before := unparse.Unparse(decls, names, src.Text, diags)
    written := source.Source(src.Path, text)
    diags2 := diag.Diagnostics(false)
    file2 := diags2.AddFile(src.Path, text)
    ts2 := scan.Scan(text)
    p2 := parse.Parser(written, ts2, names, o, diags2, file2)
    decls2 := p2.File()
    if ts2.Diags.Len() > 0 or diags2.AllSaid().Len() > 0 { return "the text written does not parse" }
    after := unparse.Unparse(decls2, names, text, diags2)
    if after != before {
        dbg := try os.Env("FMT_DEBUG") catch default ""
        if dbg != "" {
            try os.WriteFile($dbg ".before", before) catch os.OsError { }
            try os.WriteFile($dbg ".after", after) catch os.OsError { }
        }
        return "the tree read back differs: " $firstDifference(before, after)
    }
    if comments(src.Text) != comments(text) { return "the comments differ" }
    held2 := unparse.HeldBranches(decls2, names, text, diags2)
    again := layout.Format(text, ts2, p2.ArgAngles, p2.CloseAngles, held2, p2.TypeGroups)
    if again != text { return "formatting it again changes it: " $firstDifference(text, again) }
    return ""
}

fn firstDifference(a String&, b String&) String {
    i I64 = 0
    for i < a.Len() and i < b.Len() and a[i] == b[i] { i++ }
    line I64 = 1
    for j in range i {
        if a[j] == '\n' { line++ }
    }
    return "at line " $line
}

# every comment of a text, one after another, each followed by a newline - a line comment without the spaces ending its
# line. A comment is found where a token cannot be: outside string and character literals
fn comments(t String&) String {
    b := StringBuilder()
    n := t.Len()
    i I64 = 0
    for i < n {
        c := t[i]
        if c == '"' or c == '\'' {
            i++
            for i < n and t[i] != c and t[i] != '\n' {
                if t[i] == '\\' { i++ }
                i++
            }
            i++
        } else if c == '#' {
            e := i + 1
            if e < n and t[e] == '#' {
                e++
                for e + 1 < n and not (t[e] == '#' and t[e + 1] == '#') { e++ }
                e = e + 2 if e + 1 < n else n
                b.Push(t[i:e])
            } else {
                for e < n and t[e] != '\n' { e++ }
                f := e
                for f > i and (t[f - 1] == ' ' or t[f - 1] == '\t') { f-- }
                b.Push(t[i:f])
            }
            b.PushChar('\n')
            i = e
        } else {
            i++
        }
    }
    return b.ToString()
}
