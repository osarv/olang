fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# s4 with a Vec buffer over 2KB, through a scope argument
fn mk(n I64) mut String& { return $n "-new-text-in-the-buffer-region" }
fn main() ? {
    v := Vec<I64>()
    for i in range 600 { v.Push(i) }
    x := v.ViewMut()
    d := mk&x(5)
    for i in range 5000 { v.Push(i) }
    churn()
    println(d)
}
