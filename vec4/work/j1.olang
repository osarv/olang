fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# held? a fresh built result made by rendering/joining the argument: $ copies, so no loan is right
fn txt(a String&) mut String& { return "" $a }
fn txt2(a String&) mut String& { return $a }
type CB struct() {
    text own mut String& = $1 "-ttttttttttttttt"
}
fn main() ? {
    c := CB()
    d := txt(c.text)
    e := txt2(c.text)
    c.text = $2 "-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println(d)
    println(e)
}
