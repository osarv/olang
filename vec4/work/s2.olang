fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# new storage built into an own buffer's region through a scope argument (E25)
fn mk(n I64) mut Array<I64>& { return Array<I64>(n, 7) }
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    x := v.ViewMut()
    d := mk&x(2)
    for i in range 1000 { v.Push(i) }
    churn()
    println($d[0] " " $d[1])
}
