fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
# F4: a global initialized with a conditional choosing a borrow of a global's own object
type Doc struct() {
    title own mut String& = $1 "-title-built-at-run-time"
}
Docs own mut Doc& = Doc()
Flag := true
T := Docs.title if Flag else "x"
fn main() ? {
    Docs.title = $2 "-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println(T)
}
