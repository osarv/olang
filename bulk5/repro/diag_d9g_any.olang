# diagnostic: D9g on "fn boxed(p pt) any shape& { return p }" suggests the value result "any shape", which T32 refuses
# ("an any is always a reference"); with it the messages also spell the bare parameter as "pt&" (E12)
import "std/io"

type pt struct(x I64, y I64) {
    x
    y
}

type shape trait {
    Area() I64
}

fn (p pt) Area() I64 { return p.x * p.y }

fn wrap(t String) Vec<String&> {
    v := Vec<String&>()
    v.Push(t)
    return v
}

fn lit(t String) Array<String&> { return String&[t, t] }

fn boxed(p pt) any shape& { return p }

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

fn main() {
    t := $"abc"
    v := wrap(t)
    a := lit(t)
    p := pt(2, 3)
    b := boxed(p)
    t[0] = 'x'
    p.x = 10
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    io.Println($v[0] " " $a[0] " " $b.Area() " " $s)!
}
