# QCC: by-pointer passing is never observable - but an any made from a bare struct borrows the caller's storage,
# and any's == is identity (T32): the callee can tell its bare parameter is the caller's instance
import "std/io"

type pt struct(x I64, y I64) {
    x
    y
}

type shape trait {
    Area() I64
}

fn (p pt) Area() I64 { return p.x * p.y }

fn same(p pt, a any shape&) Bool {
    b any shape& = p
    return a == b
}

fn main() {
    p := pt(2, 3)
    a any shape& = p
    io.Println($same(p, a))!
}
