# round 2e: O25h - a temporary lent read-only to a bare parameter needs its references only to outlive it; the bare
# parameter's value result follows it, holding those references, and leaves the function that made them
import "std/io"

type node struct(v I64) {
    v
}

type w struct(n node&) {
    n
}

fn mkw(n node&) w { return w(n) }

fn get(x w) w { return x }

fn twice(x w) w { return get(get(x)) }

fn outer(i I64) w {
    nd := node(i)
    return twice(mkw(nd))
}

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

fn main() {
    ws := Vec<w>()
    for i in range 3 { ws.Push(outer(i)) }
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    io.Println($ws[0].n.v " " $ws[2].n.v " " $s)!
}
