# round 2d: E28/E31b skipped for an instance's type-variable reference parameter (scope.tvParam) - a conditional or
# a match choosing value places, or x[i] read through At, pushed onto a Vec<node&> declared outside the block
import "std/io"

type node struct(v I64) {
    v
}

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

fn main() {
    v := Vec<node&>()
    vals := Vec<node>()
    vals.Push(node(5))
    for i in range 3 {
        a := node(i)
        b := node(10 + i)
        v.Push(a if i == 1 else b)
        v.Push(match i {
            case 0: a
            case _: b
        })
    }
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    v[0].v = 99
    v[1].v = 77
    io.Println($v " " $vals[0].v " " $s)!
}
