# round 1: a field promoted to its constructor parameter's binding, then repointed by a method to a loop turn's text,
# the instance living past the turn
import "std/io"

type cursor struct(t String&) {
    t
    pos I64 = 0
}

fn open(t String&) cursor { return cursor(t) }

fn (c cursor&) reset(s String&) {
    c.t = s
    c.pos = 0
}

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

fn main() {
    base := $"base"
    c := open(base)
    for i in range 3 {
        s := $"turn" $i
        c.reset(s)
    }
    k := 0
    for i in range 1, 50 { k += churn(i * 8) }
    io.Println($c.t " " $k)!
}
