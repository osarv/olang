import "std/io"
type pt struct(x I64, y I64) {
    x
    y
}
type shape trait {
    Area() I64
}
fn (p pt) Area() I64 { return p.x * p.y }
fn keepVec(p pt) Vec<any shape&> {
    v := Vec<any shape&>()
    v.Push(p)
    return v
}
fn mk(i I64) Vec<any shape&> {
    p := pt(i, 3)
    return keepVec(p)
}
fn mk2(i I64) Vec<any shape&> {
    return keepVec(pt(i, 5))
}
fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}
fn main() {
    vs := Vec<Vec<any shape&>>()
    for i in range 3 {
        vs.Push(mk(i))
        vs.Push(mk2(i))
    }
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    io.Println($vs[0][0].Area() " " $vs[5][0].Area() " " $s)!
}
