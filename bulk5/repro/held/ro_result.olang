# round 2d: scope.readOnlyResult - a T?& result following its argument is judged as borrowed; give it a path that
# returns new storage built in the callee, and keep the result past the call
import "std/io"

type node struct(v I64) {
    v
    next node?& = null
}

fn pick(x node?&, k I64) node?& {
    if x is null or k > 0 { return node(k) }
    return x
}

fn walk(x node, k I64) node?& { return pick(x.next, k) }

fn churn(n I64) I64 {
    xs := Array<I64>(n, 7)
    return xs[n - 1]
}

fn keep(x node, k I64) Vec<node?&> {
    v := Vec<node?&>()
    v.Push(walk(x, k))
    return v
}

fn main() {
    n := node(1)
    n.next = node(2)
    kept := Vec<node?&>()
    for i in range 3 {
        kept.Push(walk(n, 40 + i))
        kept.Push(pick(null, 50 + i))
    }
    k2 := keep(n, 77)
    s := 0
    for i in range 1, 50 { s += churn(i * 8) }
    io.Println($kept[0]!.v " " $kept[3]!.v " " $k2[0]!.v " " $s)!
}
