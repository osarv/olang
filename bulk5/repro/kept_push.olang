# D9e (round 2e): a bare parameter's own storage kept past the call by a callee's type-variable parameter
# (Vec<String&>.Push) is the caller's storage, not the callee's copy: the caller's later write shows through
import "std/io"

fn wrap(t String) Vec<String&> {
    v := Vec<String&>()
    v.Push(t)
    return v
}

fn wrapMap(t String) Map<String&, I64> {
    m := Map<String&, I64>()
    m.Put(t, 1)
    return m
}

fn fresh() Vec<String&> {
    t := $"abc"
    return wrap(t)
}

fn main() {
    t := $"abc"
    v := wrap(t)
    m := wrapMap(t)
    t[0] = 'x'
    w := fresh()
    io.Println($v[0] " " $m.Has("abc") " " $m.Has("xbc") " " $w[0])!
}

fn afterWrite() String {
    t := $"abc"
    v := wrap(t)
    m := wrapMap(t)
    t[0] = 'x'
    return $v[0] " " $m.Has("abc")
}

# the evaluator's reading, baked while compiling (K2)
Baked String = afterWrite()

test "baked vs run time" {
    assert Baked == afterWrite(), "baked " $Baked ", run time " $afterWrite()
}
