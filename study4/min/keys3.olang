type S struct() {
    counts Map<String&, I64> = Map<String&, I64>()
    last List<String&> = List<String&>()
}
fn mk(i I64) String& ? { return "k" $(i % 5) " tail " $i }
fn collect(n I64) S {
    s := S()
    for i in range n {
        line := try mk(i) catch { continue }
        fields := line.Split(" ")
        s.counts.Update(fields[0], 0, fn(c I64) I64 { return c + 1 })
        s.last.Push(line)
    }
    return s
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        l := List<I64>()
        for k in range 60 { l.Push(k * 7 + i) }
        t += l[3]
    }
    return t
}
fn main() ? {
    s := collect(1000)
    for i in range 20 { churn() }
    keys := s.counts.Keys().ToList()
    keys.Sort(fn(a String&, b String&) Bool { return a < b })
    for k in keys { println($k " " $(try s.counts.Get(k) catch default -1)) }
}
