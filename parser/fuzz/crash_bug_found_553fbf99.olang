# Imports shared.olang for its types/errors/functions, and imports runner.olang - which imports this
# file right back, forming a genuine import cycle (see runner.olang for the other half).

import sh "shared"

# unnamed import (see the report) - its own alias is derived from the file name, "Base". Capitalized, so
# it's re-exported: a THIRD module importing worker.olang can reach Base.olang through it too, two hops
# away ("wk.Base.Whatever") - see runner.olang's own tests, which exercise exactly that. Declared BEFORE
# "rn" below on purpose, not just by convention: worker's own "imports" list has to be fully built,
# "Base" included, before runner.olang's own parse can recognize a "wk.Base.Whatever" literal as one at
# all (see isKnownTypeForParsing's own comment) - and since "rn" recurses right back into worker.olang
# itself (the same raw cycle described below), *whichever* of worker's own imports is declared first is
# the one guaranteed ready by the time that recursion's own parse runs. Confirmed directly: reversing this
# order breaks exactly the literal-chain tests in runner.olang, only when worker.olang (not runner.olang)
# is the one used as the compile root - see the report's own honest note on this narrow, accepted edge.
import "Base"
import rn "runner"

error WorkerError {
    BAD_INPUT
}

error InputError {
    NEGATIVE
    TOO_BIG
}

fn Classify(n I32) I32 ? sh.RangeError + WorkerError {
    if n < 0 {
        error WorkerError.BAD_INPUT
    }
    return try sh.CheckRange(n, 0, 100)
}

