import "std/io"

type Node struct(v I64) {
    v
    t String& = $"node " $v " with text padded out to a fair length ..........................."
    next mut Node?& = null
}

type Holder struct() {
    n mut Node& = Node(0)
}

fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7) " some more text to fill the chunk ......"
        t += s.Len()
    }
    return t
}

fn main() {
    a := Holder()
    b := Holder()
    for i in range 6 {
        b.n = Node(i + 1)
        a.n.next = b.n          # the node of one holder linked from another holder's node
        b.n = Node(100 + i)     # which lets go of it
        churn()
        io.Println(a.n.next!.t)!
    }
}
