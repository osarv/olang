        a11 = a10
        a10 = a9
        a9 = a8
        a8 = a7
        a7 = a6
        a6 = a5
        a5 = a4
        a4 = a3
        a3 = a2
        a2 = a1
        a1 = h.t
    }
    h.set(i)            # lets go of the text the chain's last local holds
    churn()
    io.Println(a56)!
}

fn main() {
    h := Holder()
    h.set(-1)
    for i in range 5 { step(h, i) }
}
