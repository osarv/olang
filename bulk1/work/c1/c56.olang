    a45 String&h = ""
    a46 String&h = ""
    a47 String&h = ""
    a48 String&h = ""
    a49 String&h = ""
    a50 String&h = ""
    a51 String&h = ""
    a52 String&h = ""
    a53 String&h = ""
    a54 String&h = ""
    a55 String&h = ""
    a56 String&h = ""
    for k in range 61 {
        a56 = a55
        a55 = a54
        a54 = a53
        a53 = a52
        a52 = a51
        a51 = a50
        a50 = a49
        a49 = a48
        a48 = a47
        a47 = a46
        a46 = a45
        a45 = a44
