# S4c: two hidden "$par" locals of one name in nested blocks - one from holdForRefTarget, one from holdInHidden
type Node struct(v I64) {
    v
}
type H struct() {
    n mut Node& = null
}
fn mk(i I64) Node& {
    return Node(i)
}
fn main() ? {
    h mut H& = H()
    k I64 = 0
    h.n, k = Node(7), 1
    if k == 1 {
        j I64 = 0
        a mut Node& = Node(0)
        a, j = mk(5), k + 1
        println($a.v " " $j " " $h.n.v)
    }
    println($h.n.v " " $k)
}
