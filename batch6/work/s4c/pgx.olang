# S4c: two parallel assignments in one function, the second a value with references - hidden locals collide
type Node struct(v I64) {
    v
}
fn mk(i I64) Node& {
    return Node(i)
}
fn main() ? {
    k I64 = 0
    a mut Node& = Node(0)
    l mut List<I64>& = List<I64>()
    l, k = List<I64>(), 1
    a, k = mk(2), k
    a, k = mk(3), k
    println($a.v " " $k)
}
