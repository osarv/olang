# P4a: defaults and clauses capturing per-iteration values; global targets given a default; a clause building into a
# captured list from the task's thread
error E {
    NEG
}
type Node struct(v I64) {
    v
}
type GH struct() {
    n mut Node& = null
}
G mut Node& = null
H mut GH& = GH()
fn mk(n I64) Node& ? E {
    if n < 0 { error E.NEG }
    return Node(n)
}
fn sq(n I64) I64 ? E {
    if n < 0 { error E.NEG }
    return n * n
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
        nn := Node(i)
        t = t + nn.v
    }
    return t
}
fn main() ? {
    out := Array<I64>(16)
    log mut List<String&>& = List<String&>()
    join {
        for i in range 16 {
            k := i * 100
            spawn out[i] = try sq(i - 8) catch default -k
        }
    }
    println($out)
    join {
        spawn G = try mk(-1) catch default Node(-77)
        spawn H.n = try mk(-1) catch default Node(-88)
    }
    churn()
    println($G.v " " $H.n.v)
    join {
        for i in range 8 {
            spawn try sq(i - 4) catch E { log.Push("failed " $i "-abcdefghijklmnopqrstuvwxyz") }
        }
    }
    churn()
    println($log.Len())
}
