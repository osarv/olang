# P1g: a String value target that is also the function's returned local (O26a: its storage is in the result scope)
type Node struct(v I64) {
    v
}
fn render(n I64) String {
    return "r" $n "-abcdefghijklmnopqrstuvwxyz0123456789"
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
        nn := Node(i)
        t = t + nn.v
    }
    return t
}
fn f(k I64) String {
    s String = "init"
    join { spawn s = render(k) }
    churn()
    return s
}
fn g(k I64) String {
    s := "init"
    join { spawn s = render(k) }
    return s
}
fn h(k I64) List<I64> {
    l := List<I64>()
    join { spawn l = mkList(k) }
    return l
}
fn mkList(k I64) List<I64> {
    l := List<I64>()
    for i in range k { l.Push(i * 7) }
    return l
}
fn main() ? {
    a := f(3)
    b := g(4)
    c := h(40)
    churn()
    println(a)
    println(b)
    println($c.Len() " " $c[39])
}
