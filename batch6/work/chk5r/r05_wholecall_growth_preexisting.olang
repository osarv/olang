# PRE-EXISTING (c2a38f0 too): the whole-call form of r05_projection_growth, "tk := lx.next(); t := tk.text" - O18c has
# landed a ":=" from a call by its obligations since study 5's batch, so the fresh half of the result goes where the
# lexer lives. 30M tokens: new 214-227 MB, c2a38f0 239 MB. r05 extended this to a field read off the call.
type Token struct(kind I64, text String&) {
    kind
    text
}
type Lexer struct(src String&) {
    src
    at I64 = 0
}
fn (lx mut Lexer&) next() Token {
    lx.at++
    if lx.at % 2 == 0 { return Token(1, lx.src[0:3]) }  # a slice of the source: lives where the lexer's text does
    return Token(2, "n" $lx.at)                          # fresh text, built in the result scope
}
fn count(lx mut Lexer&, n I64) I64 {
    total I64 = 0
    for k in range n {
        tk := lx.next()
        t := tk.text
        total += t.Len() + I64(t[t.Len() - 1])
    }
    return total
}
fn main() ? {
    lx := Lexer("abcdef")
    println($count(lx, 30000000))
}
