# C9a + P2: memory a destructor's task builds into the closing scope is never given back (its part is never folded)
type Node struct(v I64) {
    v
}
type Res struct(k I64) {
    k
} destruct {
    nodes mut List<Node&>& = List<Node&>()
    join {
        spawn fn() {
            for j in range 1000 { nodes.Push(Node(j)) }
        }
    }
}
fn once(i I64) {
    r Res& = Res(i)
}
fn main() ? {
    for i in range 12000 { once(i) }
    println("ok")
}
