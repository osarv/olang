# C9a: a destructor storing what it builds into a global, into a longer-lived list through a reference field, into a
# function value kept in a global
type Node struct(v I64) {
    v
    next mut Node& = null
}
G mut Node& = null
Keep mut List<Node&>& = List<Node&>()
type Res struct(k I64) {
    k
} destruct {
    G = Node(k * 10)
    Keep.Push(Node(k * 100))
    t := "txt" $k "-abcdefghijklmnopqrstuvwxyz"
    G.next = Node(t.Len())
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
        nn := Node(i)
        t = t + nn.v
    }
    return t
}
fn once(i I64) {
    r Res& = Res(i)
}
fn main() ? {
    for i in range 3 {
        once(i + 1)
        churn()
    }
    println($G.v " " $G.next.v " " $Keep.Len())
    for n in Keep { print($n.v " ") }
    println("")
}
