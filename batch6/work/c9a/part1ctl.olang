# control for part1: the same destructor building its Trackers on its own thread
Count mut I64 = 0
type Tracker struct(k I64) {
    k
} destruct {
    Count = Count + 1
}
type Node struct(v I64) {
    v
}
type Res struct(k I64) {
    k
} destruct {
    kk := k
    keep mut List<Tracker&>& = List<Tracker&>()
    nodes mut List<Node&>& = List<Node&>()
    for j in range 50 {
        keep.Push(Tracker(kk * 100 + j))
        nodes.Push(Node(j))
    }
    t I64 = 0
    for n in nodes { t = t + n.v }
    if t != 1225 { fail }
}
fn once(i I64) {
    r Res& = Res(i)
}
fn main() ? {
    for i in range 4 {
        once(i)
        println($Count)
    }
}
