# C9a/D16d/O1b: a destructor storing a lambda capturing a node it built in the closing scope into a global
type Node struct(v I64) {
    v
}
GF mut fn() I64 = fn() I64 { return 0 }
type Res struct(k I64) {
    k
} destruct {
    n Node& = Node(k)
    GF = fn() I64 { return n.v }
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
        nn := Node(i)
        t = t + nn.v
    }
    return t
}
fn once(i I64) {
    r Res& = Res(i)
}
fn main() ? {
    once(41)
    churn()
    println($GF())
}
