# finding 1 through an element store: "rows[i][0] = x", rows a List of writable references to arrays of text
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
    }
    return t
}
fn main() ? {
    rows := List<mut Array<String&>&>()
    for i in range 3 { rows.Push(Array<String&>(2)) }
    for i in range 3 {
        x String& = "w" $i "-abcdefghijklmnopqrstuvwxyz"
        rows[i][0] = x
        churn()
    }
    churn()
    for r in rows { print($r[0] " ") }
    println("")
}
