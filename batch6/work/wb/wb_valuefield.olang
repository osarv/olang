# finding 1 with a value field holding a reference: "cells[i].w = wv", wv a loop body's value holding its text
type W struct(s String&) {
    s
}
type Cell struct() {
    w W = W("")
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
    }
    return t
}
fn main() ? {
    cells := List<mut Cell&>()
    for i in range 3 { cells.Push(Cell()) }
    for i in range 3 {
        x String& = "w" $i "-abcdefghijklmnopqrstuvwxyz"
        wv := W(x)
        cells[i].w = wv
        churn()
    }
    churn()
    for c in cells { print($c.w.s " ") }
    println("")
}
