# defaults holding references, built where the call's result lands, for targets of several shapes
error E {
    NEG
}
type Node struct(v I64, s String&) {
    v
    s
}
type Holder struct() {
    n mut Node& = null
    l mut List<Node&>& = List<Node&>()
}
fn mk(n I64) Node& ? E {
    if n < 0 { error E.NEG }
    return Node(n, "ok" $n)
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
    }
    return t
}
fn fill(h mut Holder&, out mut Array<Node&>&, k I64) {
    for i in range 4 {
        join {
            spawn out[i] = try mk(i - k) catch default Node(-i, "def" $i "abcdefghijklmnopqrstuvwxyz")
            spawn h.n = try mk(i - k - 10) catch default Node(-100 - i, "hdef" $i "abcdefghijklmnopqrstuvwxyz")
        }
        churn()
    }
}
fn main() ? {
    h := Holder()
    out := Array<Node&>(4)
    fill(h, out, 2)
    churn()
    for n in out { println($n.v " " $n.s) }
    println($h.n.v " " $h.n.s)
}
