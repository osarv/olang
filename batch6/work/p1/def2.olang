# a default that holds a lambda capturing a reference declared inside the join, stored into an outer target
error E {
    NEG
}
type Node struct(v I64) {
    v
}
type FBox struct(f fn(x I64) I64) {
    f
}
fn getF(n I64) FBox ? E {
    if n < 0 { error E.NEG }
    return FBox(fn(x I64) I64 { return x * 2 })
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
        nn := Node(i)
        t = t + nn.v
    }
    return t
}
fn main() ? {
    b FBox = FBox(fn(x I64) I64 { return x })
    join {
        k I64 = 41
        spawn b = try getF(-1) catch default FBox(fn(x I64) I64 { return x + k })
    }
    churn()
    println($b.f(1))
}
