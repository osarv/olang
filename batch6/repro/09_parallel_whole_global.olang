# PRE-EXISTING over-rejection beside tonight9's S4c fix: a parallel assignment of a whole value global holding references
# ("GV, k = VH(Node(i)), k") is O1b, while "GV = VH(Node(i))" compiles. tonight9 fixed only a global's reference field.
type Node struct(v I64) {
    v
}
type VH struct(n Node&) {
    n
}
GV mut VH = VH(Node(0))
fn set(i I64) {
    k I64 = 0
    GV, k = VH(Node(i)), k
}
fn main() ? {
    set(1)
    println($GV.n.v)
}
