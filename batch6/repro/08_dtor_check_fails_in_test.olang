# PRE-EXISTING (same on 04f4a4d): a check failing inside a destructor while a test's scope is closed abandons the rest of
# that scope's destructors - r1's never runs (Log is 32, not 321). Memory-safe under -s.
# unwind chain too
Log mut I64 = 0
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Res struct(n mut Node&, k I64) {
    n
    k
} destruct {
    n.next = Node(k)
    Log = Log * 10 + k
    assert k != 2, "dtor fails"
}
fn f() {
    a mut Node& = Node(0)
    r1 Res&a = Res(a, 1)
    r2 Res&a = Res(a, 2)
    r3 Res&a = Res(a, 3)
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
    }
    return t
}
test "a destructor fails" {
    f()
}
test "after" {
    churn()
    println($Log)
    f2 := 0
    assert churn() > 0
}
