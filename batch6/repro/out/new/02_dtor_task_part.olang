# CONFIRMED, NEW in tonight9's C9a (8f085c4): what a destructor's task builds into the scope being closed is never
# reclaimed and its destructors never run. C9a makes a destructor's top level the closing scope S. A spawned lambda that
# builds into what it captured asks __olang_capture_scope(S) on its own thread, which (decision 48) makes and links a
# PART of S - but __olang_scope_close folded S's parts once, before its destructor walk, and never looks again. So the
# part (its chunks and its destructor nodes) is left linked to a header that is closed and then forgotten.
# The control (02_control_dtor_no_task) does the same work on the destructor's own thread: 50, 100, 150, 200.
#   6af6a4e -b and -b -d -s: 0 0 0 0      (no Tracker is ever destructed; their memory is never given back)
#   04f4a4d (before C9a) and 771a922: 50 100 150 200
# it from another thread, which makes a PART of that scope - after the close has already folded its parts
Count mut I64 = 0
type Tracker struct(k I64) {
    k
} destruct {
    Count = Count + 1
}
type Node struct(v I64) {
    v
}
type Res struct(k I64) {
    k
} destruct {
    kk := k
    keep mut List<Tracker&>& = List<Tracker&>()
    nodes mut List<Node&>& = List<Node&>()
    join {
        spawn fn() {
            for j in range 50 {
                keep.Push(Tracker(kk * 100 + j))
                nodes.Push(Node(j))
            }
        }
    }
    t I64 = 0
    for n in nodes { t = t + n.v }
    if t != 1225 { fail }
}
fn once(i I64) {
    r Res& = Res(i)
}
fn main() ? {
    for i in range 4 {
        once(i)
        println($Count)
    }
}
