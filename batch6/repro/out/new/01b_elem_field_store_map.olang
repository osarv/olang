# CONFIRMED, NEW (771a922) - finding 1 through Map.Get: "(try m.Get(i)).s = x".
#   -b -d -s: use after scope closed; -b prints churn()'s text; -i prints w0.. w1.. w2..
# loop body, the element where the map lives
type Cell struct() {
    s String& = ""
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
    }
    return t
}
fn main() ? {
    m := Map<I64, mut Cell&>()
    for i in range 3 { m.Put(i, Cell()) }
    for i in range 3 {
        x String& = "w" $i "-abcdefghijklmnopqrstuvwxyz"
        (try m.Get(i)).s = x
        churn()
    }
    churn()
    for i in range 3 { print($(try m.Get(i)).s " ") }
    println("")
}
