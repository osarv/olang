# CONFIRMED, NEW (771a922) - finding 1 through List.First under try: "(try cells.First()).s = x".
#   -b -d -s: use after scope closed; -i: w2-abcdefghijklmnopqrstuvwxyz
type Cell struct() {
    s String& = ""
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
    }
    return t
}
fn main() ? {
    cells mut List<mut Cell&>& = List<mut Cell&>()
    for i in range 3 { cells.Push(Cell()) }
    for i in range 3 {
        x String& = "w" $i "-abcdefghijklmnopqrstuvwxyz"
        (try cells.First()).s = x
        churn()
    }
    churn()
    for c in cells { print($c.s " ") }
    println("")
}
