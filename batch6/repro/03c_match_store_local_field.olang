# CONFIRMED, PRE-EXISTING - finding 3 with a match value: "b.last = match i { case 1 => x case _ => "z" }".
#   -b -d -s: use after scope closed; -i: w1-abcdefghijklmnopqrstuvwxyz
type Bag struct() {
    last String& = ""
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        s := $i $i "-" $(i * 3) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t = t + s.Len()
    }
    return t
}
fn main() ? {
    b mut Bag& = Bag()
    for i in range 2 {
        x String& = "w" $i "-abcdefghijklmnopqrstuvwxyz"
        b.last = match i { case 1 => x case _ => "z" }
        churn()
    }
    churn()
    println(b.last)
}
