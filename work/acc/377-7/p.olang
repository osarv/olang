# allocates and gives back: whatever reuses a closed scope's storage writes -7 and text over it
fn churn() I64 {
    t I64 = 0
    for i in range 200 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t + I64(getpid() * 0)
}
# a chain's values, 40 nodes at most
fn chain(n Node&) I64 {
    t I64 = 0
    c := n
    for k in range 40 {
        if c == null { break }
        t = t * 31 + c.v
        c = c.next
