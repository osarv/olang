    a := Array<mut Node&>(4)
    a[0] = Node(1)
    a[0] = mkChain(5)
    setNode(a, 1, 9)
    if Run < 0 { } else {
        for i1_2 in range Run * 2 {
            {
                q1_1 mut Node& = via(14)
                a[0].next = match Run { case 1 => q1_1 case _ => pickNode(a[0]) }
            }
            a[2] = Node(20)
        }
        setNode(a, 0, 23)
        for i1_4 in range 3 {
            s1_3 := a[0:2]
            s1_3[1] = mkChain(28)
            a[3] = mkChain(34)
            churn()
        }
    }
    churn()
    return sumArr(a)
}
