    }
    churn()
    return sumList(bag.nodes) * 7 + sumBoxes(bag.boxes) * 5 + sumCells(bag.cells) * 3 + sumCells(bag.grid[0])
}
fn main() ? {
    say("0: " $s0())
    say("1: " $s1())
    say("2: " $s2())
    say("3: " $s3())
    say("4: " $s4())
    say("5: " $s5())
    say("6: " $s6())
    say("7: " $s7())
    say("8: " $s8())
    say("9: " $s9())
    say("10: " $s10())
    say("11: " $s11())
    say("dtors " $(Made - Dropped))
}
