# scenario 10
fn s10() I64 {
    t := Two()
    t.items[0] = Node(1)
    t.items[1] = Node(1)
    c10_1 := t
    c10_1.items[1].next = mkChain(2)
    {
        y10_3 := Node(3)
        r10_2 ResB& = ResB(y10_3, 3)
        churn()
    }
    {
        for i10_7 in range Run * 2 {
            s10_4 := t.items[0:2]
            s10_4[1].next = Node(7)
            s10_5 := t.items as Array<mut Node&, 2>&
            s10_5[0].next = Node(9)
            q10_6 := Node(14)
            churn()
            t.items[0].next = q10_6
        }
        c10_8 := t
        c10_8.items[1].next = mkLambda(15)
        if Run > 0 {
            churn()
            c10_9 := t
            c10_9.items[1].next = mkNode(17)
            grow(t.items[0], 22)
        }
    }
    churn()
    return chain(t.items[0]) * 7 + chain(t.items[1])
}
# scenario 11
fn s11() I64 {
    bag := Bag()
    bag.boxes.Push(Box())
    bag.cells.Push(Cell())
    bag.grid.Push(List<Cell>())
    bag.grid[0].Push(Cell())
    {
        q11_1 := mkLambda(4)
        bag.grid[0][0].S.Push(q11_1)
    }
    c11_2 := bag.boxes[0]
    c11_2.head.next = Node(9)
    match Run {
        case 1 {
