# E31b not applied in a global initializer (atWriteBackArgs returns when the context has no scope of its own), so r02's
# silent lost write remains there: GM[0].AddRet() and bump(GM[0]) run on a copy nobody writes back.
#   expected: Y 5 Z 12 GM[0].N 17 w 17 (each write reaching the element, as with an Array)
#   actual (-b, -b -s, -b -d -s, -i): Y 5 Z 7 GM[0].N 5 w 5
#   a2e2878: Y 5 Z 7 GM[0].N 0 w 5 (every write lost, r02) - pre-existing, but the batch's fix stops short of it.
type Acc struct() {
    N I64 = 0
}
fn (a mut Acc&) AddRet() I64 {
    a.N = a.N + 5
    return a.N
}
fn bump(a mut Acc&) I64 {
    a.N = a.N + 7
    return a.N
}
fn mk() List<Acc> {
    l := List<Acc>()
    l.Push(Acc())
    return l
}
GM mut List<Acc> = mk()
Y I64 = GM[0].AddRet()
Z I64 = bump(GM[0])
fn main() ? {
    w := GM[0].AddRet()
    println("Y " $Y " Z " $Z " GM[0].N " $GM[0].N " w " $w)
}
