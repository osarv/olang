# DIAGNOSTIC: the B11 text note names a compiler-made local: "pass a copy, which is made where '$handle2' lives"
fn churnIt() {
    for k in range 300 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}

fn main() ? {
    names := List<List<String&>>()
    names.Push(List<String&>())
    names[0].Push("x")
    for k in range 3 {
        t := $k "-loop-text-of-moderate-length"
        names[0][0] = t
    }
    churnIt()
    println(names[0][0])
}
