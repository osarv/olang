fn churnIt() {
    for k in range 300 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}
fn me(l mut List<String&>&) mut List<String&>&l { return l }
fn main() ? {
    users := List<List<String&>>()
    users.Push(List<String&>())
    keep := List<String&>()
    for k in range 3 {
        x := me(users[0])
        keep = x
    }
    churnIt()
    keep.Push("a")
    println($keep.Len())
}
