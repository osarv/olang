type Acc struct() {
    N I64 = 0
}
fn (a mut Acc&) Add() { a.N++ }
fn bump(a mut Acc&) { a.N++ }
G List<Acc> = mkG()
fn mkG() List<Acc> {
    l := List<Acc>()
    l.Push(Acc())
    return l
}
fn viaParam(l List<Acc>&) {
    l[0].Add()
}
fn viaValue(l List<Acc>) {
    l[0].N = 5
}
fn main() ? {
    G[0].Add()
    bump(G[0])
    G[0].N = 3
    viaValue(G)
    x := G
    x[0].N = 4
    println($G[0].N)
}
