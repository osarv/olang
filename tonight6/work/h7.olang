fn churnIt() {
    for k in range 300 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}
fn me(l mut List<I64>&) mut List<I64>&l { return l }
fn main() ? {
    users := List<List<I64>>()
    users.Push(List<I64>())
    r mut List<I64>& = null
    for k in range 3 {
        r = me(users[0])
    }
    churnIt()
    r.Push(5)
    println($r.Len() " " $users[0].Len())
}
