type Acc struct() {
    N I64 = 0
}
fn (a mut Acc&) AddRet() I64 {
    a.N = a.N + 5
    return a.N
}
fn main() ? {
    l := List<Acc>()
    l.Push(Acc())
    l.Push(Acc())
    for k in range 4 {
        x := l[0].AddRet() if k % 2 == 0 else l[1].AddRet()
        y := match k {
            case 0 => l[1].AddRet()
            case _ => 0
        }
        ok := k > 10 and l[0].AddRet() > 0
        println($k " " $x " " $y " " $ok)
    }
    println($l[0].N " " $l[1].N)
}
