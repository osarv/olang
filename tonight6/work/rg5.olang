# O17 per-function region facts: a split lend (E31b's element copy) to a generic method that builds into the
# receiver's region only through a helper declared after main
type Rec<T> struct(name String&, v T) {
    name
    v
}
fn (r mut Rec<<T>>&) Reset(k I64) { r.resetInner(k) }
fn churnIt() {
    for k in range 200 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}
fn main() ? {
    l := List<Rec<I64>>()
    l.Push(Rec("start", 1))
    for k in range 3 {
        l[0].Reset(k)
    }
    m := List<Rec<F64>>()
    m.Push(Rec("start", 1.0))
    for k in range 3 {
        x := m[0]
        x.Reset(k)
        m[0] = x
    }
    churnIt()
    println(l[0].name)
    println(m[0].name)
}
fn (r mut Rec<<T>>&) resetInner(k I64) { r.name = $k "-rebuilt-text-of-moderate-length-xxxxxxxx" }
