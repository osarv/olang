type Rec<T> struct(name String&, v T) {
    name
    v
}
fn (r mut Rec<<T>>&) Reset(k I64) {
    match T {
        case I64 { r.name = $k "-rebuilt-text-of-moderate-length-xxxxxxxx" }
        case F64 { r.v = r.v + 1.0 }
    }
}
fn churnIt() {
    for k in range 200 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}
fn main() ? {
    m := List<Rec<F64>>()
    m.Push(Rec("start", 1.0))
    for k in range 3 {
        m[0].Reset(k)
    }
    l := List<Rec<I64>>()
    l.Push(Rec("start", 1))
    for k in range 3 {
        l[0].Reset(k)
    }
    churnIt()
    println(l[0].name)
    println($m[0].v)
}
