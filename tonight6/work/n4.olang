fn churnIt() {
    for k in range 300 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}

fn main() ? {
    users := List<List<String&>>()
    users.Push(List<String&>())
    for k in range 3 {
        t := $k "-loop-text-of-moderate-length"
        users[0].Push($t)
    }
    users[0].Push("y")
    for k in range 3 {
        t := $k "-loop-text-of-moderate-length"
        users[0][3] = $t
    }
    churnIt()
    for s in users[0] { println(s) }
}
