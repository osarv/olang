fn churnIt() {
    for k in range 300 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}
fn k(ls List<List<List<I64>>>) { ls[0][0].Push(1) }
fn kr(ls List<List<List<I64>>>&) { ls[0][0].Push(1) }
fn outer(ls List<List<List<I64>>>&) {
    k(ls)
    kr(ls)
}
fn main() ? {
    users := List<List<List<I64>>>()
    users.Push(List<List<I64>>())
    users[0].Push(List<I64>())
    outer(users)
    println($users[0][0].Len())
}
