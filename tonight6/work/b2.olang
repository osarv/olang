type Acc struct() {
    N I64 = 0
}
fn bump2(a mut Acc&, n I64) { a.N = a.N + n }
fn change(l mut List<Acc>&) I64 {
    l[0].N = 100
    return 1
}
fn changeA(l mut Array<Acc>&) I64 {
    l[0].N = 100
    return 1
}
fn main() ? {
    l := List<Acc>()
    l.Push(Acc())
    bump2(l[0], change(l))
    a := Array<Acc>(1)
    bump2(a[0], changeA(a))
    println("list " $l[0].N " array " $a[0].N)
}
