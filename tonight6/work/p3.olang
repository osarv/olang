fn churnIt() {
    for k in range 300 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}
fn f(ls List<List<I64>>) { ls[0].Push(1) }
fn g(ls List<List<I64>>) { pushFn(ls[0]) }
fn h(ls List<List<I64>>) { ls[0][0] = 9 }
fn pushFn(l mut List<I64>&) { l.Push(2) }
fn outer(ls List<List<I64>>&) {


}
fn outer2(ls List<List<I64>>&) {
    h(ls)
}
fn main() ? {
    users := List<List<I64>>()
