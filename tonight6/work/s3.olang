fn churnIt() {
    for k in range 300 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}
fn idx(n List<List<String&>>&) I64 { return 0 }
fn main() ? {
    names := List<List<String&>>()
    names.Push(List<String&>())
    names[0].Push("x")
    names[0].Push("y")
    for k in range 3 {
        t := $k "-loop-text-of-moderate-length"
        names[idx(names)][idx(names)] = $t
    }
    churnIt()
    println(names[0][0])
    println(names[0][1])
}
