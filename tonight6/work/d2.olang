type Reading struct(Sensor String&, Value F64) {
    Sensor
    Value
}
fn churn() I64 {
    t I64 = 0
    for k in range 200 {
        junk := $k "-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t += junk.Len()
    }
    return t
}

fn main() ? {
    fs := List<fn()>()
    for k in range 3 {
        t := $k "-text-built-in-loop-of-moderate-length"
        r := Reading(t, 1.0)
        fs.Push(fn() { println(r.Sensor) })
    }
    c := churn()
    println($c)
    for f in fs { f() }
}
