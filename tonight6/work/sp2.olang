fn churnIt() {
    for k in range 300 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}
fn pushFn(l mut List<I64>&, v I64) { l.Push(v) }
fn fill(u mut List<List<I64>>&) { u[0].Push(3) }
fn main() ? {
    users := List<List<I64>>()
    users.Push(List<I64>())
    users.Push(List<I64>())
    join {
        spawn fill(users)
    }
    println($users[0].Len() " " $users[1].Len())
}
