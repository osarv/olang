type Reading struct(Sensor String&, Value F64) {
    Sensor
    Value
}
fn churn() I64 {
    t I64 = 0
    for k in range 200 {
        junk := $k "-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        t += junk.Len()
    }
    return t
}
fn mk(k I64) fn() {
    t := $k "-text-built-in-mk-of-moderate-length"
    r := Reading(t, 1.0)
    return fn() { println(r.Sensor) }
}
fn main() ? {
    f := mk(3)
    c := churn()
    println($c)
    f()
}
