fn churnIt() {
    for k in range 200 {
        junk := $k "-churn-churn-churn-churn-churn-churn-churn-churn-churn-churn"
        assert junk.Len() > 0
    }
}
fn viaAt() List<String&> {
    ll := List<List<String&>>()
    ll.Push(List<String&>())
    ll[0].Push("x" $ll.Len() "-text-in-the-dead-block-of-moderate-length")
    x := ll[0]
    return x
}
fn first(l List<List<String&>>&) List<String&> { return l[0] }
fn viaFn() List<String&> {
    ll := List<List<String&>>()
    ll.Push(List<String&>())
    ll[0].Push("y" $ll.Len() "-text-in-the-dead-block-of-moderate-length")
    x := first(ll)
    return x
}
fn direct() List<String&> {
    ll := List<List<String&>>()
    ll.Push(List<String&>())
    ll[0].Push("z" $ll.Len() "-text-in-the-dead-block-of-moderate-length")
    return ll[0]
}
fn main() ? {
    a := viaAt()
    churnIt()
    println(a[0])
    b := viaFn()
    churnIt()
    println(b[0])
    c := direct()
    churnIt()
    println(c[0])
}
