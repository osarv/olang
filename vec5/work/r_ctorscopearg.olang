# R evasion: a constructor given a scope argument naming a borrow - the instance's bare fields built in the region
type CB struct() {
    text own mut String& = $1 "-ttttttttttttttt"
}
type H struct(n I64) {
    y String& = $n "-new-text-in-the-region"
}
fn main() ? {
    c := CB()
    x := c.text
    h := H&x(5)
    c.text = $2 "-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println(h.y)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
