# S17: fail in an assert message's catch block - -i and the program agree on status?
fn h(k I64) String ? {
    if k > 3 { error }
    return "ok " $k
}
fn check(k I64) I64 {
    assert k < 2, (try h(k) catch { println("fail from message")
        fail })
    return k
}
fn main() ? {
    println($check(1))
    println($check(5))
}
