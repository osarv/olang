# R evasion: several results given a scope argument naming a borrow, destructured
type CB struct() {
    text own mut String& = $1 "-ttttttttttttttt"
}
fn two(n I64) (String&, I64) {
    return $n "-new-text-in-the-region", n
}
fn main() ? {
    c := CB()
    x := c.text
    d, k := two&x(5)
    c.text = $2 "-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println(d)
    println($k)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
