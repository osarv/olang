# S17: deferred code in a catch block of an assert message - -i and the program agree?
fn h(k I64) String ? {
    if k > 3 { error }
    return "ok " $k
}
fn check(k I64) I64 {
    assert k < 2, (try h(k) catch { defer { println("deferred in message") }
        println("in catch") } default "message " $k)
    return k
}
fn main() ? {
    println($check(1))
    println($check(5))
}
