# R evasion: a task's result built in an own region (a scope argument naming a borrow), its target a local typed there
type CB struct() {
    text own mut String& = $1 "-ttttttttttttttt"
}
fn mk(n I64) String& { return $n "-new-text-in-the-region" }
fn main() ? {
    c := CB()
    x := c.text
    d mut String&x = "none"
    join { spawn d = mk&x(5) }
    c.text = $2 "-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println(d)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
