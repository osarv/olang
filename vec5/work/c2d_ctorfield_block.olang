# C2d (no own): a constructor field built in a parameter's scope ("y String&x = new text"), the argument a local of an
# inner block - the instance assigned to an outer local outlives the block
type H struct(x String&, n I64) {
    y String&x = $n "-new-text-in-x's-scope"
}
fn main() ? {
    h := H("outer", 1)
    for i in range 2 {
        t := $i "-inner-block-text"
        h = H(t, 5 + i)
    }
    churn()
    println(h.y)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
