# S17: done in an assert message ends the process (0) - -i and the program agree?
fn h(k I64) String ? {
    if k > 3 { error }
    return "ok " $k
}
fn check(k I64) I64 {
    assert k < 2, (try h(k) catch { println("done from message")
        done })
    return k
}
fn main() ? {
    println($check(1))
    println($check(5))
    println("not reached")
}
