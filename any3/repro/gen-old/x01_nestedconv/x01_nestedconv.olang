import "std/io"
# T29a/T7a (not the any work): an array of arrays held by value has its inner arrays inline when their length is known
# where it is made; a conversion to a type declared over Array<Array<I64>> names that storage (T29a) but reads its
# elements as run-time-length arrays - a segfault, or (from a fill directly) invalid IR
type Grid extends Array<Array<I64>>
fn (g Grid&) Show() String { return "g " $g[0][0] "," $g[1][1] }
fn main() {
    a := Array<Array<I64>>(2, Array<I64>(2, 5))
    g := Grid(a)
    say(g.Show())
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
