import "std/io"
# M21 diagnostics: a receiver whose type argument names an unknown generic type (a misspelt Two) is taken to overlap every other instance's
# method, so one misspelling gives a second, spurious "declared twice" error at an unrelated method
type Two<A, B> struct(a A, b B) {
    a
    b
}
type Box<T> struct(v T) {
    v
}
fn (b Box<Tow<I64, I64>>&) Describe() String { return "nope" }
fn (b Box<I64>&) Describe() String { return "exact " $b.v }
fn main() {
    say(Box<I64>(1).Describe())
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
