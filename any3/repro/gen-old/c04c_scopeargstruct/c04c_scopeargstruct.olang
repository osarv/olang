import "std/io"
# for comparison with c04: a struct built by a constructor call or a call's built result given a scope argument
type Sh trait {
    Show() String
}
type P struct(n I64) { n }
fn (p P&) Show() String { return "p" $p.n }
fn mkp(i I64) P& { return P(i) }
fn main() {
    xs := List<any Sh&>()
    for i in range 2 {
        t := "inner" $i
        xs.Push(P&t(i))
        xs.Push(mkp&t(i))
    }
    assert churn() > 0
    for x in xs { say(x.Show()) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
