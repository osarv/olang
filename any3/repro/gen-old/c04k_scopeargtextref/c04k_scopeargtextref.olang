import "std/io"
# the E25 hole with text: a call giving a built String& placed by a scope argument in a loop body's scope, stored into
# an outer struct's field and pushed into an outer List<String&>
type H struct(s String&) { s }
fn mkt(i I64) String& { return "text" $i "-" $(i * 7) }
fn main() {
    h := H("start")
    l := List<String&>()
    for i in range 2 {
        t := "inner" $i
        h.s = mkt&t(i)
        l.Push(mkt&t(i + 10))
    }
    assert churn() > 0
    say(h.s)
    for x in l { say(x) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
