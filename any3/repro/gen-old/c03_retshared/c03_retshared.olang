import "std/io"
# a returned local moved into the result scope (O26a) is returned as it is (T7b) - but a borrow of it stored elsewhere
# in the callee is a second name: the result is not new storage, so a value taking it and an any's box alias the other
type W trait {
    mut Bump()
}
type Lab extends String
fn (l mut Lab&) Bump() { l[0] = 'Z' }
type H struct(s String&) { s }
fn f(k mut H&, i I64) String {
    s := "abc" $i
    k.s = s
    return s
}
fn main() {
    h := H("x")
    x := f(h, 1)
    x[0] = 'Q'
    say("value: h.s " $h.s " x " $x)
    h2 := H("y")
    b mut any W& = Lab(f(h2, 2))
    b.Bump()
    say("any: h2.s " $h2.s)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
