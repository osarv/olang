# E30: a chain's literal typed beside each comparison's other operand - each chain beside its written-out form, baked
# while compiling (the immutable globals) and computed at run time from mutable ones; operands evaluated once, in order
H F16 = 0.0999
B BF16 = 0.1
F F32 = 0.1
D F64 = 0.10000000000000002
S I8 = -5
U U64 = 18446744073709551615
V U8 = 200
Hm mut F16 = 0.0999
Bm mut BF16 = 0.1
Fm mut F32 = 0.1
Dm mut F64 = 0.10000000000000002
Sm mut I8 = -5
Um mut U64 = 18446744073709551615
Vm mut U8 = 200
calls mut I64 = 0
fn n(x I64) I64 {
    calls = calls * 10 + x
    return x
}
fn flags(h F16, b BF16, f F32, d F64, s I8, u U64, v U8) String {
    r := ""
    r = $r $(h < 0.1 < d) $(h < 0.1 and 0.1 < d)
    r = $r " " $(b <= 0.1 < f) $(b <= 0.1 and 0.1 < f)
    r = $r " " $(f >= 0.1 >= h) $(f >= 0.1 and 0.1 >= h)
    r = $r " " $(s < 200 < u) $(s < 200 and 200 < u)
    r = $r " " $(s < -1 < v) $(s < -1 and -1 < v)
    r = $r " " $(v > 199 > s) $(v > 199 and 199 > s)
    r = $r " " $(s < 1 << 40 < u) $(s < 1 << 40 and 1 << 40 < u)
    r = $r " " $(h < 65504.0 <= d) $(b < 3.0e38 < f)
    r = $r " " $(0.1 < d < 0.2) $(0.1 > h > 0.05) $(1 < 2 < 3)
    return r
}
G String = flags(H, B, F, D, S, U, V)
fn main() {
    say(G)
    say(flags(Hm, Bm, Fm, Dm, Sm, Um, Vm))
    calls = 0
    x := n(1) < 5 < n(7) < 9 < n(3)
    say($x " " $calls)
    calls = 0
    y := 5 < n(6) <= 6 < n(8)
    say($y " " $calls)
}
