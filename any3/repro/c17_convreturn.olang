# T7b: a returned array value is copied out unless it is new storage (lower.retCopies, copiesArray) - but a returned
# conversion of a by-value array parameter (D9b: the caller's own array) is taken for new: the caller's value and an
# any made of the call alias the caller's array
type W trait {
    mut Bump()
}
type Lab extends String
fn (l mut Lab&) Bump() { l[0] = 'Z' }
fn conv<T>(x T) Lab { return Lab(x) }
fn (l Lab) Copy() Lab { return Lab(l) }
fn main() {
    s := Lab("source")
    x := conv(s)
    x[0] = 'Q'
    t := Lab("second")
    y := t.Copy()
    y[0] = 'R'
    u := Lab("third")
    b mut any W& = conv(u)
    b.Bump()
    v := Lab("fourth")
    c mut any W& = v.Copy()
    c.Bump()
    say($String(s) " " $String(t) " " $String(u) " " $String(v))
}
