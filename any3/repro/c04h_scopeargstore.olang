# the E25 hole without an any or a call taking it: a built result given a scope argument naming a loop body's local,
# stored into an outer struct's field, an outer list (by Push and by a declared local), a returned list
type P struct(n I64) { n }
type H struct(p P?&) { p }
fn mkp(i I64) P& { return P(i) }
fn main() {
    h := H(null)
    xs := List<P&>()
    for i in range 2 {
        t := "inner" $i
        h.p = mkp&t(i * 11 + 1)
        xs.Push(mkp&t(i * 11 + 2))
    }
    assert churn() > 0
    say("field " $h.p!.n)
    for x in xs { say($x.n) }
}
