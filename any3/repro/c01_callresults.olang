# T32a: "a call's array result" is taken as new storage in the box (no copy). Each callee here returns an array value
# that is existing storage, and the any's mut method writes through the box: the source must stay unchanged
type W trait {
    mut Bump()
}
type Lab extends String
fn (l mut Lab&) Bump() { l[0] = 'Z' }
G String = "global"
GM mut String& = "mutglob"
fn idr(s String&) String { return s }
fn idg<T>(x T) T { return x }
fn glob() String { return G }
fn globm() String { return GM }
fn lit() String { return "literal" }
fn sl(s String&) String { return s[0:3] }
type H struct(s String&) { s }
fn (h H&) Get() String { return h.s }
fn main() {
    s2, s3, s4, s5 := "byref", "gener", "slice", "field"
    b2 mut any W& = Lab(idr(s2))
    b2.Bump()
    b3 mut any W& = Lab(idg(s3))
    b3.Bump()
    b4 mut any W& = Lab(glob())
    b4.Bump()
    b5 mut any W& = Lab(globm())
    b5.Bump()
    b6 mut any W& = Lab(sl(s4))
    b6.Bump()
    h := H(s5)
    b7 mut any W& = Lab(h.Get())
    b7.Bump()
    for i in range 2 {
        b8 mut any W& = Lab(lit())
        b8.Bump()
        say("lit " $lit())
    }
    say($s2 " " $s3 " " $s4 " " $s5 " " $G " " $GM)
}
