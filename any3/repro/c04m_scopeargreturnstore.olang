# finding 2 through "&return": a callee stores into its parameter's field a built result it put in its result scope;
# the caller's result lands in a loop body, the struct outside it
type P struct(n I64) { n }
type H struct(p P?&) { p }
fn mkp(i I64) P& { return P(i) }
fn put(h mut H&, i I64) String {
    h.p = mkp&return(i * 11 + 1)
    return "r" $i
}
fn main() {
    h := H(null)
    for i in range 2 {
        r := put(h, i)
        say(r)
    }
    assert churn() > 0
    say("field " $h.p!.n)
}
