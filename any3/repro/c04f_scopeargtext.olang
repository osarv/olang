# a scope argument (E25) on a call's String result pushed into a List<String&> - no any
fn mk(i I64) String { return "text" $i "-" $(i * 7) }
fn main() {
    ys := List<String&>()
    for i in range 2 {
        t := "inner" $i
        ys.Push(mk&t(i))
    }
    assert churn() > 0
    for y in ys { say(y) }
}
