# M21: an instance's own method and the one written with variables have different results - generic code over Box<T>,
# checked with T a variable, sees the generic one's String; its instance at I64 reaches the exact one's I64
type Box<T> struct(v T) {
    v
}
fn (b Box<I64>&) Describe() I64 { return b.v * 1000 }
fn (b Box<T>&) Describe() String { return "generic" }
fn viaGen<T>(b Box<T>&) String { return b.Describe() }
fn len<T>(b Box<T>&) I64 { return b.Describe().Len() }
fn main() {
    b := Box<I64>(4)
    say(viaGen(b))
    say($len(b))
    say($b.Describe())
}
