# T32a: written text held in the box as it is - joins of constants, renderings of constants, and anys held by globals
# (baked while compiling, K2, or set at startup) written through a mut any at run time
type W trait {
    mut Bump() I64
    Peek() I64
}
type Lab extends String
fn (l mut Lab&) Bump() I64 {
    r := I64(l[0])
    l[0] = 'Z'
    return r
}
fn (l Lab&) Peek() I64 { return I64(l[0]) }
GM mut any W& = Lab("ab" $"cd")
GN mut any W& = Lab($5 "x")
GR any W& = Lab("q" $1)
fn mk() mut any W& { return Lab("mk" $"x") }
fn main() {
    for i in range 3 {
        a mut any W& = Lab("ab" $"cd")
        b mut any W& = Lab($5)
        c mut any W& = Lab($'c' $"d")
        say($a.Bump() " " $b.Bump() " " $c.Bump() " " $GM.Bump() " " $GN.Bump() " " $GR.Peek() " " $mk().Bump())
    }
}
