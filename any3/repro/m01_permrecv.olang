# M21: a method declared for an instance whose type argument is a writable reference, called on the instance whose
# argument is read-only - the method writes through it (T25b: read-only never converts to writable)
type Node struct(v I64) { v }
type Box<T> struct(x T) { x }
fn (b Box<mut Node&>&) Poke() { b.x.v = 99 }
type Bag<T> struct(x T) { x }
fn (b Bag<mut <T>&>&) Poke() { b.x.v = 77 }
G Node& = Node(1)
fn main() {
    ro Node& = Node(5)
    b := Box<Node&>(ro)
    g := Bag<Node&>(G)
    g.Poke()
    say($ro.v " " $G.v)
}
