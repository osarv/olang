# a scope argument (E25) on a temporary passed to Push - no any: is it judged against where Push keeps it?
type P struct(n I64) { n }
fn main() {
    xs := List<P&>()
    for i in range 2 {
        t := "inner" $i
        xs.Push(P&t(i * 11))
    }
    assert churn() > 0
    for x in xs { say($x.n) }
}
