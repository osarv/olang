# T32/G9: an any's trait unified with a parameter's "mut any Iterator<T>&" - a read-only any given for it must be
# refused (T25c), as with a concrete T
type Ups struct(n I64) {
    n
    at I64 = 0
}
fn (u mut Ups&) Next() I64 ? Exhausted {
    if u.at >= u.n { error Exhausted.END }
    u.at += 1
    return u.at
}
fn drain<T>(it mut any Iterator<T>&) I64 { return it.Count(fn(x T) Bool { return true }) }
fn drainI(it mut any Iterator<I64>&) I64 { return it.Count(fn(x I64) Bool { return true }) }
fn ro(it any Iterator<I64>&) I64 { return drain(it) }
fn roI(it any Iterator<I64>&) I64 { return drainI(it) }
fn main() {
    a mut any Iterator<I64>& = Ups(3)
    say($ro(a))
}
