import "std/io"
# a scope argument (E25) on a call's String result pushed into a List<String&> - no any
fn mk(i I64) String { return "text" $i "-" $(i * 7) }
fn main() {
    ys := List<String&>()
    for i in range 2 {
        t := "inner" $i
        ys.Push(mk&t(i))
    }
    assert churn() > 0
    for y in ys { say(y) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
