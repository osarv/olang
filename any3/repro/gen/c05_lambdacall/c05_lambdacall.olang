import "std/io"
# a call through a function value (a lambda, a named function as a value, a lambda capturing a loop body's text) whose
# array result goes into an any's box as it is (T32a's "a call's array result")
type W trait {
    Show() String
}
type Lab extends String
fn (l Lab&) Show() String { return "lab " $String(l) }
fn mk(i I64) String { return "named" $i "-" $(i * 7) }
fn apply(f fn(i I64) String, i I64) String { return f(i) }
fn main() {
    l := List<any W&>()
    g := mk
    for i in range 2 {
        t := "cap" $i "-" $(i * 7)
        f := fn(k I64) String { return t }
        h := fn(k I64) String { return "lam" $k "-" $(k * 7) }
        l.Push(Lab(f(i)))
        l.Push(Lab(h(i)))
        l.Push(Lab(g(i)))
        l.Push(Lab(apply(f, i)))
        l.Push(Lab(apply(fn(k I64) String { return t }, i)))
    }
    assert churn() > 0
    for x in l { say(x.Show()) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
