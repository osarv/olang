import "std/io"
# T32: Take, Skip, Zip... through an any are refused at the call (AnyNoCopy: "keeps a copy of the value it is called on,
# and an any has none"). Generic code bound to the any's type (T32c) reaches the same defaults
type Ups struct(n I64) {
    n
    at I64 = 0
}
fn (u mut Ups&) Next() I64 ? Exhausted {
    if u.at >= u.n { error Exhausted.END }
    u.at += 1
    return u.at
}
fn firstTwo<I Iterator<I64>>(it mut I&) List<I64>& { return it.Take(2).ToList() }
fn skipOne<I Iterator<I64>>(it mut I&) I64 { return it.Skip(1).Count(fn(x I64) Bool { return true }) }
fn main() {
    u := Ups(5)
    a mut any Iterator<I64>& = Ups(5)
    say($firstTwo(u) " " $firstTwo(a))
    say($u.at " " $a.Count(fn(x I64) Bool { return true }))
    b mut any Iterator<I64>& = Ups(4)
    say($skipOne(b) " " $b.Count(fn(x I64) Bool { return true }))
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
