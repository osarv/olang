import "std/io"
# T32: a default keeping its receiver in a List (List<G>, G the any's type) gives a List<any Gen> - an any without its
# marker, which T32 says cannot be written. Is what its elements name held to where the list lives?
type Ups struct(n I64) {
    n
    at I64 = 0
}
fn (u mut Ups&) Step() I64 {
    u.at += 1
    return u.n * 100 + u.at
}
fn (u Ups&) Str() String { return "Ups(" $u.n ")" }
type Gen trait {
    mut Step() I64
}
fn (g mut G&) Twice<G Gen>() List<G>& {
    l := List<G>()
    l.Push(g)
    l.Push(g)
    return l
}
fn mk2<G Gen>(g mut G&) List<G>& { return g.Twice() }
fn main() {
    a0 mut any Gen& = Ups(1)
    l := mk2(a0)
    for i in range 2 {
        a mut any Gen& = Ups(7 + i)
        l = mk2(a)
    }
    assert churn() > 0
    say($l.Len() " " $l)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
