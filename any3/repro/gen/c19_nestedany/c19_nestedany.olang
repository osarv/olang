import "std/io"
# T32a: an array of arrays held by value, its inner arrays inline (their length known where it is made, T7a), copied
# into an any's box - the copy made at the element type Array<I64> (a run-time-length array) - and rendered
type Lenner trait {
    Len() I64
}
fn main() {
    a := Array<Array<I64>>(2, Array<I64>(3, 5))
    x any Lenner& = a
    say($x.Len())
    say($x)
    say($a)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
