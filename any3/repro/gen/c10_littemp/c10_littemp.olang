import "std/io"
# T32a: an array literal, a fill and a comprehension held in the box as they are (new storage) - is each built where
# the any lands, or as fixed storage in the frame (a literal's known length)? Returned from a function, pushed into
# an outer list, read after the stack and the arena are churned
type W trait {
    Show() String
}
type Lab extends String
fn (l Lab&) Show() String { return "lab " $String(l) }
type Ns extends Array<I64>
fn (n Ns&) Show() String { return "ns " $n[0] "," $n[n.Len() - 1] " #" $n.Len() }
fn lit(i I64) any W& { return Ns(I64[i, i + 1, i + 2]) }
fn fill(i I64) any W& { return Lab(Array<Char>(3, Char(97 + i))) }
fn chars(i I64) any W& { return Lab(Char['x', Char(97 + i), 'y']) }
fn comp(i I64) any W& { return Ns(I64[k * i for k in range 4]) }
fn deep(n I64) I64 {
    a := Array<I64>(64, n)
    if n == 0 { return a[3] }
    return deep(n - 1) + a[n % 64]
}
fn main() {
    l := List<any W&>()
    for i in range 2 {
        l.Push(lit(i))
        l.Push(fill(i))
        l.Push(chars(i))
        l.Push(comp(i))
        l.Push(Ns(I64[i * 10, i * 10 + 1]))
        l.Push(Lab(Char['p', Char(97 + i)]))
    }
    assert churn() > 0
    assert deep(200) > 0
    for x in l { say(x.Show()) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
