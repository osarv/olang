import "std/io"
# T32a: written text and an array literal are "new" - held as they are. If lowering made either the constant data
# itself, a mut any writing it would write constant data (or share it across iterations)
type W trait {
    mut Bump() I64
}
type Lab extends String
fn (l mut Lab&) Bump() I64 {
    r := I64(l[0])
    l[0] = 'Z'
    return r
}
type Ns extends Array<I64>
fn (n mut Ns&) Bump() I64 {
    r := n[0]
    n[0] = 99
    return r
}
fn main() {
    for i in range 3 {
        a mut any W& = Lab("abc")
        b mut any W& = Ns(I64[1, 2, 3])
        c mut any W& = Lab("ab" "cd")
        d mut any W& = Ns(Array<I64>(3, 7))
        e mut any W& = Lab(Char['x', 'y'])
        f mut any W& = Ns(I64[1, 2] if i > 5 else I64[3, 4])
        say($a.Bump() " " $b.Bump() " " $c.Bump() " " $d.Bump() " " $e.Bump() " " $f.Bump())
    }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
