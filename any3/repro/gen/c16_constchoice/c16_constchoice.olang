import "std/io"
# T32a: a conditional, a match or a catch default one of whose values is constant data (a text literal, an array of
# constants) - copied, never the constant itself: written through a mut any on every turn, read back
type W trait {
    mut Bump() I64
}
type Lab extends String
fn (l mut Lab&) Bump() I64 {
    r := I64(l[0])
    l[0] = 'Z'
    return r
}
type Ns extends Array<I64>
fn (n mut Ns&) Bump() I64 {
    r := n[0]
    n[0] = 99
    return r
}
error Oops {
    BAD
}
fn bad() String ? Oops { error Oops.BAD }
fn badn() Ns ? Oops { error Oops.BAD }
fn main() {
    for i in range 3 {
        a mut any W& = Lab("const" if i >= 0 else "x" $i)
        b mut any W& = Lab(match i { case 100 => "x" $i case _ => "mconst" })
        c mut any W& = Lab(try bad() catch default "dconst")
        d mut any W& = Ns(I64[1, 2] if i >= 0 else Array<I64>(2, i))
        e mut any W& = try badn() catch default Ns(I64[5, 6])
        say($a.Bump() " " $b.Bump() " " $c.Bump() " " $d.Bump() " " $e.Bump())
    }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
