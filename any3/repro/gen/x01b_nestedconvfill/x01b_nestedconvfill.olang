import "std/io"
# x01 from a fill converted directly: invalid IR (clang refuses the object)
type Grid extends Array<Array<I64>>
fn (g Grid&) Show() String { return "g " $g[0][0] "," $g[1][1] }
fn mkGrid(k I64) Grid { return Grid(Array<Array<I64>>(2, Array<I64>(2, k))) }
fn main() {
    g := Grid(Array<Array<I64>>(2, Array<I64>(2, 5)))
    say(g.Show())
    h := mkGrid(3)
    say(h.Show())
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
