# iterator adapters (Take, Skip, Enumerate, Zip, Chain) and Map to a reference result through an any: refused inside the prelude
type Ups struct(n I64) {
    n
    at I64 = 0
}
fn (u mut Ups&) Next() I64 ? Exhausted {
    if u.at >= u.n { error Exhausted.END }
    u.at += 1
    return u.at
}
fn mk(n I64) mut any Iterator<I64>& { return Ups(n) }
fn run(n I64) String {
    b := StringBuilder()
    b.Push($mk(n).Some(fn(x I64) Bool { return x == 2 }) " ")
    b.Push($mk(n).Every(fn(x I64) Bool { return x > 0 }) " ")
    b.Push($mk(n).Fold(10, fn(a I64, x I64) I64 { return a + x }) " ")
    b.Push($mk(n).Map(fn(x I64) String& { return "m" $x }) " ")
    b.Push($mk(n).Filter(fn(x I64) Bool { return x % 2 == 1 }) " ")
    b.Push($mk(n).ToList() " ")
    b.Push($mk(n).Sum() " ")
    b.Push($(try mk(n).Min() catch default -1) " " $(try mk(n).Max() catch default -1) " ")
    b.Push($(try mk(0).Max() catch default -1) " ")
    for x in mk(n).Take(2) { b.Push("t" $x) }
    for x in mk(n).Skip(2) { b.Push("s" $x) }
    for p in mk(n).Enumerate() { b.Push("e" $p) }
    for p in mk(n).Zip(mk(n + 1)) { b.Push("z" $p) }
    for x in mk(1).Chain(mk(2)) { b.Push("c" $x) }
    b.Push(" " $(try mk(n).MaxBy(fn(x I64) I64 { return -x }) catch default -1))
    b.Push(" " $I64[x * 2 for x in mk(n)])
    return b.ToString()
}
G String = run(3)
fn main() {
    say(G)
    say(run(3))
}
