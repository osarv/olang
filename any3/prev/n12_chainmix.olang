# E30: a chain is "a op1 b and b op2 c", but a literal b takes its LEFT neighbour's type for both comparisons - so the
# chain and its written-out form disagree, and a chain whose two neighbours do not meet is refused though each
# comparison alone is fine
fn both(f F32, g F64) String { return $(f < 0.1 < g) " " $(f < 0.1 and 0.1 < g) }
fn mixed(a I8, b U64) Bool { return a < 5 and 5 < b }
G String = both(F32(0.05), 0.1000000001)
LF mut F32 = 0.05
LG mut F64 = 0.1000000001
fn main() {
    say(G)
    say(both(LF, LG))
    say($mixed(1, 7))
}
