# a default reached through an any whose trait's argument is a type variable: in a generic function, and in a generic
# type's method over an any field
type Ups struct(n I64) {
    n
    at I64 = 0
}
fn (u mut Ups&) Next() I64 ? Exhausted {
    if u.at >= u.n { error Exhausted.END }
    u.at += 1
    return u.at
}
type Words struct(n I64) {
    n
    at I64 = 0
}
fn (w mut Words&) Next() String ? Exhausted {
    if w.at >= w.n { error Exhausted.END }
    w.at += 1
    return "w" $w.at
}
fn cnt<T>(it mut any Iterator<T>&) I64 { return it.Count(fn(x T) Bool { return true }) }
type Src<T> struct(it mut any Iterator<T>&) { it }
fn (s mut Src<T>&) Firsts() List<T>& { return s.it.ToList() }
fn run(n I64) String {
    a mut any Iterator<I64>& = Ups(n)
    b mut any Iterator<String>& = Words(n)
    s := Src<I64>(Ups(n + 1))
    t := Src<String>(Words(n + 1))
    return $cnt(a) " " $cnt(b) " " $s.Firsts() " " $t.Firsts()
}
G String = run(2)
fn main() {
    say(G)
    say(run(2))
}
