# T31's mut rule in generic.meets: a type whose method writes its receiver, used where a trait's method only reads it -
# through generic code (G19), not an any
type Shower trait {
    Show() String
}
type Ctr struct(n I64) { n }
fn (c mut Ctr&) Show() String {
    c.n += 1
    return "ctr " $c.n
}
fn showG<S Shower>(s mut S&) String { return s.Show() }
fn main() {
    c := Ctr(1)
    say(showG(c))
    say(c.Show())
}
