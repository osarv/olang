import "std/io"
# a default the instance's type does not fit, reached only from another module's... here: from a lambda and a generic
type Words struct(n I64) {
    n
    at I64 = 0
}
fn (w mut Words&) Next() String ? Exhausted {
    if w.at >= w.n { error Exhausted.END }
    w.at += 1
    return "w" $w.at
}
fn tot<I Iterator<String>>(it mut I&) String { return $it.Sum() }
fn main() {
    w := Words(3)
    it mut any Iterator<String>& = w
    f := fn() { say(tot(it)) }
    f()
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
