import "std/io"
# T31's mut rule in generic.meets: a type whose method writes its receiver, used where a trait's method only reads it -
# through generic code (G19), not an any
type Shower trait {
    Show() String
}
type Ctr struct(n I64) { n }
fn (c mut Ctr&) Show() String {
    c.n += 1
    return "ctr " $c.n
}
fn showG<S Shower>(s mut S&) String { return s.Show() }
fn main() {
    c := Ctr(1)
    say(showG(c))
    say(c.Show())
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
