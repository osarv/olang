import "std/io"
# a conditional, a match and a catch default of block-local struct instances (borrowed, not copied) into an outer any
type Named trait {
    Name() String
}
type Cat struct(n I64) { n }
fn (c Cat&) Name() String { return "cat " $c.n }
error Oops {
    BAD
}
fn bad(k I64) Cat ? Oops {
    if k < 10 { error Oops.BAD }
    return Cat(0)
}
fn main() {
    xs := List<any Named&>()
    for i in range 3 {
        a := Cat(i)
        b := Cat(i + 10)
        xs.Push(a if i > 0 else b)
        xs.Push(match i { case 0 => a case _ => b })
        xs.Push(try bad(i) catch default a)
    }
    churn()
    for x in xs { say(x.Name()) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
