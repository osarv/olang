import "std/io"
# a conditional of two arrays of text
type W trait {
    Show() String
}
type P struct(s String&) { s }
type Rows extends Array<String&>
fn (r Rows&) Show() String { return "rows " $r.Len() " " $r[0] }
type Grid extends Array<Array<String&>&>
fn (g Grid&) Show() String { return "grid " $g[0][0] }
type Ps extends Array<P>
fn (p Ps&) Show() String { return "ps " $p[0].s }
fn keepIt<T W>(xs mut List<any W&>&, x T) { xs.Push(x) }
fn main() {
    xs := List<any W&>()
    for i in range 3 {
        t := "t" $i "-" $(i * 7)
        a := String&[t]
        b := String&[t, t]
        xs.Push(Rows(a if i > 0 else b))
    }
    churn()
    for x in xs { say(x.Show()) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
