import "std/io"
# n05's catch-default shape without an any: block-local text as a catch default pushed into an outer List<String&> (refs)
error Oops {
    BAD
}
fn bad(k I64) String ? Oops {
    if k < 10 { error Oops.BAD }
    return "never"
}
fn main() {
    xs := List<String&>()
    for i in range 3 {
        s := "text" $i "-" $(i * 7)
        xs.Push(try bad(i) catch default s)
    }
    churn()
    for x in xs { say(x) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
