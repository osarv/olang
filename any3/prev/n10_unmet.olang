# a default the instance's type does not fit, reached only from another module's... here: from a lambda and a generic
type Words struct(n I64) {
    n
    at I64 = 0
}
fn (w mut Words&) Next() String ? Exhausted {
    if w.at >= w.n { error Exhausted.END }
    w.at += 1
    return "w" $w.at
}
fn tot<I Iterator<String>>(it mut I&) String { return $it.Sum() }
fn main() {
    w := Words(3)
    it mut any Iterator<String>& = w
    f := fn() { say(tot(it)) }
    f()
}
