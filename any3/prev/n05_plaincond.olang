# a plain String (no conversion) into an any, from a conditional, a match and a catch default of block-local text
type Up trait {
    ToUpper() String
}
error Oops {
    BAD
}
fn bad(k I64) String ? Oops {
    if k < 10 { error Oops.BAD }
    return "never"
}
fn main() {
    xs := List<any Up&>()
    for i in range 3 {
        s := "text" $i "-" $(i * 7)
        u := "other" $i "-" $(i * 7)
        xs.Push(s if s.Len() > 2 else u)
        xs.Push(match s.Len() { case 0 => u case _ => s })
        xs.Push(try bad(i) catch default s)
        xs.Push(s)
    }
    churn()
    for x in xs { say(x.ToUpper()) }
}
