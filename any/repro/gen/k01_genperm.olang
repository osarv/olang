import "std/io"
# generic code over a trait given a read-only any: a mut method called inside
type Counter trait {
    mut Bump() I64
}
type Tally struct(at I64) { at }
fn (t mut Tally&) Bump() I64 {
    t.at += 1
    return t.at
}
G Tally& = Tally(1)
fn bumpIt<C Counter>(c C) I64 { return c.Bump() }
fn bumpMut<C Counter>(c mut C) I64 { return c.Bump() }
fn main() {
    r any Counter& = G
    say($bumpIt(r))
    say($bumpMut(r))
    say($G.at)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
