import "std/io"
# a number made an any inside a loop body, pushed into a list that outlives the loop
type Hashy trait {
    Hash() I64
}
fn main() {
    xs := List<any Hashy&>()
    for i in range 5 {
        n I64 = i * 1000 + 7
        xs.Push(n)
    }
    churn()
    t I64 = 0
    for x in xs { say($x) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
