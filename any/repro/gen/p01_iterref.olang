import "std/io"
# an any Iterator over references: elements of a list of text kept past the list's block
fn drain(it mut any Iterator<String&>&, out mut List<String&>&) {
    for x in it { out.Push(x) }
}
fn main() {
    out := List<String&>()
    for k in range 3 {
        l := List<String&>()
        for i in range 3 { l.Push("s" $k "-" $i) }
        drain(l.Iter(), out)
    }
    churn()
    for s in out { say(s) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
