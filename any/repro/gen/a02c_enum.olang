import "std/io"
# an enum case holding loop-local text, made an any in an outer list
type Named trait {
    Name() String
}
type Tag enum {
    Txt(s String&)
    Nil
}
fn (t Tag) Name() String {
    match t {
        case Tag.Txt(s) { return "txt " $s }
        case Tag.Nil { return "nil" }
    }
}
fn main() {
    xs := List<any Named&>()
    for i in range 4 {
        s := "e" $i "-" $(i * 11)
        xs.Push(Tag.Txt(s))
    }
    churn()
    for x in xs { say(x.Name()) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
