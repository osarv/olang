import "std/io"
# an array copied into a mut any, written through the table: the copy changes, the original does not - evaluator and run time
type Bump trait {
    mut Bump()
}
type Nums extends Array<I64>
fn (n mut Nums&) Bump() { n[0] += 1 }
fn go(k I64) String {
    a := Nums(I64[1, 2, k])
    r mut any Bump& = a
    r.Bump()
    s mut any Bump& = r
    s.Bump()
    a.Bump()
    return $a " " $r " " $s " " $(s == r)
}
Baked String = go(3)
Live mut I64 = 3
fn main() {
    say(Baked)
    say(go(Live))
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
