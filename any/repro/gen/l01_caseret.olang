import "std/io"
# a type-case binding / an "as" returned: borrowed from the parameter (fine), built (must be refused or copied)
type W trait for Btn, Lab {
    Draw() String
}
type Btn struct(label String&) { label }
fn (b Btn&) Draw() String { return "[" $b.label "]" }
type Lab extends String
fn (l Lab&) Draw() String { return "L" $String(l) }
fn bor(w any W&) Btn&w {
    match w {
        case Btn b { return b }
        case Lab _ { return Btn("none") }
    }
}
fn built(w any W&) Btn& {
    match w {
        case Btn b { return b }
        case Lab _ { return Btn("none") }
    }
}
fn builtAs(w any W&) Lab& { return w as Lab }
fn mk(i I64) Btn& {
    w any W& = Btn("loc" $i)
    return built(w)
}
fn mk2(i I64) Lab& {
    w any W& = Lab("lab" $i)
    return builtAs(w)
}
fn main() {
    xs := List<Btn&>()
    ls := List<Lab&>()
    for i in range 3 {
        xs.Push(mk(i))
        ls.Push(mk2(i))
    }
    churn()
    for x in xs { say(x.label) }
    for l in ls { say(String(l)) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
