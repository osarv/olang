import "std/io"
# a conversion (T29a) of a loop-local text or array made an any kept outside the loop: copied (T32a), or aliasing the dead block?
type Show trait {
    Show() String
}
type Lab extends String
fn (l Lab&) Show() String { return String(l) }
type Nums extends Array<I64>
fn (n Nums&) Show() String { return $n[0] " " $n[1] }
fn main() {
    xs := List<any Show&>()
    for i in range 3 {
        s := "text" $i "-" $(i * 7)
        xs.Push(Lab(s))
        a := I64[i, i * 100]
        xs.Push(Nums(a))
        s = "changed"
        a[0] = -1
    }
    churn()
    for x in xs { say(x.Show()) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
