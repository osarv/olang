import "std/io"
# an any made of a copy of an array parameter holding text, returned as a built result; the caller's array dies first
type Sized trait {
    Len() I64
}
fn wrap(a Array<String&>&) any Sized& { return a }
fn main() {
    xs := List<any Sized&>()
    for i in range 3 {
        b := Array<String&>(1, "q")
        b[0] = "p" $i "-" $(i * 17)
        xs.Push(wrap(b))
    }
    churn()
    for x in xs { say($x) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
