import "std/io"
# anys handed to tasks; a mut any written by two tasks through a lambda
type Counter trait {
    mut Bump() I64
    Seen() I64
}
type Tally struct(at I64) { at }
fn (t mut Tally&) Bump() I64 {
    t.at += 1
    return t.at
}
fn (t Tally&) Seen() I64 { return t.at }
fn work(c mut any Counter&, n I64) {
    for i in range n { c.Bump() }
}
fn mk(i I64) Tally { return Tally(i) }
fn main() {
    xs := List<mut any Counter&>()
    for i in range 4 { xs.Push(Tally(i * 100)) }
    join {
        for k in range 4 {
            x := xs[k]
            spawn work(x, 1000)
        }
    }
    churn()
    for x in xs { say($x.Seen()) }
    join {
        for k in range 4 {
            x := xs[k]
            spawn fn() { x.Bump() }()
        }
    }
    for x in xs { say($x.Seen()) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
