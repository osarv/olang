import "std/io"
# the trait's parameter read-only, the method's writable
type Item struct(v I64) { v }
type Sink trait {
    Take(it Item&) I64
}
type S struct(k I64) { k }
fn (s S&) Take(it mut Item&) I64 {
    it.v = 77
    return it.v
}
G Item& = Item(1)
fn main() {
    s := S(0)
    w any Sink& = s
    say($w.Take(G))
    say($G.v)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
