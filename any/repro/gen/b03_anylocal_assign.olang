import "std/io"
# an outer any assigned an any of a loop-local temporary
type W trait {
    Draw() String
}
type Btn struct(label String&) { label }
fn (b Btn&) Draw() String { return "[" $b.label "]" }
fn main() {
    o any W& = Btn("first")
    for i in range 4 {
        w any W& = Btn("b" $i)
        o = w
    }
    churn()
    say(o.Draw())
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
