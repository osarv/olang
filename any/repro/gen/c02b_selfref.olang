import "std/io"
# the same as c02_selfrender with a plain reference: $ follows 8 deep then '...'
type Node struct(v I64) {
    v
    next Node?& = null
}
fn main() {
    n := Node(1)
    n.next = n
    say($n)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
