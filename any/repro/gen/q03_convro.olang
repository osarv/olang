import "std/io"
# an array named through a conversion (T29a) of read-only text made a mut any and written: a parameter, a global
type Bump trait {
    mut Bump()
}
type Lab extends String
fn (l mut Lab&) Bump() { l[0] = 'Z' }
G String = "global"
fn poke(t String&) {
    b mut any Bump& = Lab(t)
    b.Bump()
}
fn main() {
    s := "hello"
    poke(s)
    say(s)
    poke(G)
    say(G)
    poke("literal")
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
