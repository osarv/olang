import "std/io"
# an array of text built in a loop body, copied into an any stored in an outer list; its elements' text lives in the body
type Sized trait {
    Len() I64
}
fn main() {
    xs := List<any Sized&>()
    for i in range 4 {
        a := Array<String&>(2, "x")
        a[0] = "e" $i "-" $(i * 11)
        a[1] = "f" $i
        xs.Push(a)
    }
    churn()
    for x in xs { say($x) }
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
