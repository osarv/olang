import "std/io"
# an outer any assigned a copy of an inner block's array of text, and a field of an outer struct likewise
type Sized trait {
    Len() I64
}
type Holder struct() {
    s any Sized?& = null
}
fn main() {
    o any Sized& = I64[1]
    h := Holder()
    for i in range 3 {
        a := Array<String&>(1, "x")
        a[0] = "e" $i "-" $(i * 11)
        o = a
        h.s = a
    }
    churn()
    say($o)
    say($h.s)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
