import "std/io"
# the trait's result writable, the method's read-only (borrowed from a global, so built-vs-borrowed agrees?)
type Item struct(v I64) { v }
type Src trait {
    Get() mut Item&
}
G Item& = Item(1)
type S struct(k I64) { k }
fn (s S&) Get() Item& { return Item(4) }
fn main() {
    s := S(0)
    w any Src& = s
    r := w.Get()
    r.v = 9
    say($r.v)
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
