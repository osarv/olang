import "std/io"
# an immutable global holding writable anys: written at run time, read by an assert and a later global
type Counter trait {
    mut Bump() I64
    Seen() I64
}
type Tally struct(at I64) { at }
fn (t mut Tally&) Bump() I64 {
    t.at += 1
    return t.at
}
fn (t Tally&) Seen() I64 { return t.at }
fn mk() List<mut any Counter&> {
    l := List<mut any Counter&>()
    l.Push(Tally(1))
    return l
}
GL List<mut any Counter&> = mk()
GA mut any Counter& = Tally(10)
GB any Counter& = Tally(20)
GV I64 = GL[0].Seen()
fn main() {
    GL[0].Bump()
    GA.Bump()
    assert GL[0].Seen() == 2, "GL"
    assert GA.Seen() == 11, "GA"
    say($GL[0].Seen() " " $GA.Seen() " " $GV " " $GB.Seen())
}
fn say(s String&) { try io.Println(s) catch { } }

fn churn() I64 {
    t I64 = 0
    keep Array<I64>& = Array<I64>(1, 0)
    for k in range 200 {
        keep = Array<I64>(64, 777)
        t += keep[3]
    }
    for i in range 300 {
        l := List<I64>()
        for j in range 40 { l.Push(i + j) }
        t += l.Len()
        s := "junk " $i
        t += s.Len()
    }
    return t
}
