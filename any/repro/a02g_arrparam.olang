# an any made of a copy of an array parameter holding text, returned as a built result; the caller's array dies first
type Sized trait {
    Len() I64
}
fn wrap(a Array<String&>&) any Sized& { return a }
fn main() {
    xs := List<any Sized&>()
    for i in range 3 {
        b := Array<String&>(1, "q")
        b[0] = "p" $i "-" $(i * 17)
        xs.Push(wrap(b))
    }
    churn()
    for x in xs { say($x) }
}
