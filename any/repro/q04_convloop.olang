# a conversion (T29a) of a loop-local text or array made an any kept outside the loop: copied (T32a), or aliasing the dead block?
type Show trait {
    Show() String
}
type Lab extends String
fn (l Lab&) Show() String { return String(l) }
type Nums extends Array<I64>
fn (n Nums&) Show() String { return $n[0] " " $n[1] }
fn main() {
    xs := List<any Show&>()
    for i in range 3 {
        s := "text" $i "-" $(i * 7)
        xs.Push(Lab(s))
        a := I64[i, i * 100]
        xs.Push(Nums(a))
        s = "changed"
        a[0] = -1
    }
    churn()
    for x in xs { say(x.Show()) }
}
