# zero values of an any: an array of them, a field with none
type W trait {
    Draw() String
}
type Btn struct(label String&) { label }
fn (b Btn&) Draw() String { return "[" $b.label "]" }
type Holder struct() {
    w any W&
}
fn main() {
    a := Array<any W&>(3)
    say(a[0].Draw())
    h := Holder()
    say(h.w.Draw())
    x any W&
    say(x.Draw())
}
