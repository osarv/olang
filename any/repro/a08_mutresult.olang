# the trait's result writable, the method's read-only (borrowed from a global, so built-vs-borrowed agrees?)
type Item struct(v I64) { v }
type Src trait {
    Get() mut Item&
}
G Item& = Item(1)
type S struct(k I64) { k }
fn (s S&) Get() Item& { return Item(4) }
fn main() {
    s := S(0)
    w any Src& = s
    r := w.Get()
    r.v = 9
    say($r.v)
}
