# a method storing its receiver into an argument, called through an any made of a loop-local instance
type Reg trait {
    Into(l mut List<any Reg&>&)
    Name() String
}
type Sq struct(n String&) { n }
fn (s Sq&) Into(l mut List<any Reg&>&) { l.Push(s) }
fn (s Sq&) Name() String { return s.n }
fn main() {
    l := List<any Reg&>()
    for i in range 3 {
        q := Sq("q" $i)
        r any Reg& = q
        r.Into(l)
    }
    churn()
    for x in l { say(x.Name()) }
}
