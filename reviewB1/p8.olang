import "std/io"

type Inner struct(a I64, b I64, c I64, d I64, e I64, f I64) {
    a
    b
    c
    d
    e
    f
}

type Node struct(v I64, inner Inner) {
    v
    inner
    next mut Node?& = null
    prev weak mut Node?& = null
}

type L struct() {
    head mut Node?& = null
    tail weak mut Node?& = null
}

fn (l mut L&) PopFront() {
    h := l.head!
    l.head = h.next
}

fn churn(l mut L&) {
    for i in range 50 {
        l.head = Node(1000 + i, Inner(-i, -i, -i, -i, -i, -i))
        l.head = null
    }
}

fn show(t Inner, l mut L&) I64 {
    l.PopFront()
    churn(l)
    return t.a + t.f
}

fn main() ? {
    l := L()
    l.head = Node(7, Inner(42, 43, 44, 45, 46, 47))
    r := show(l.head!.inner, l)
    try io.Println("by value: " $r " want 89")
}
