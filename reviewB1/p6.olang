import "std/io"

type Inner struct(a I64, b I64) {
    a
    b
}

type Node struct(v I64, inner Inner) {
    v
    inner
    next mut Node?& = null
    prev weak mut Node?& = null
}

type L struct() {
    head mut Node?& = null
    tail weak mut Node?& = null
}

fn (l mut L&) PopFront() {
    h := l.head!
    l.head = h.next
}

fn churn(l mut L&) {
    for i in range 50 {
        l.head = Node(1000 + i, Inner(-i, -i))
        l.head = null
    }
}

fn show(t Inner&, l mut L&) ? {
    l.PopFront()
    w := l.tail
    try io.Println("after pop: gone=" $(w is null) " a=" $t.a)
    l.head = Node(555, Inner(-1, -2))
    w2 := l.tail
    try io.Println("after churn: gone=" $(w2 is null) " a=" $t.a)
}

fn main() ? {
    l := L()
    l.head = Node(7, Inner(42, 43))
    l.tail = l.head
    try show(l.head!.inner, l)
}
