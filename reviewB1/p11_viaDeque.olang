import "std/io"
import "std/deque"

type Node struct(v I64) {
    v
    next mut Node?& = null
    prev weak mut Node?& = null
}

type Opt enum {
    Some(n mut Node&)
    None
}

type L struct() {
    head mut Node?& = null
    tail weak mut Node?& = null
}

G mut Node?& = null

fn (l mut L&) PopFront() {
    h := l.head!
    l.head = h.next
}

fn churn(l mut L&) {
    for i in range 50 {
        l.head = Node(1000 + i)
        l.PopFront()
    }
}

fn viaDeque() I64 {
    l := L()
    d := deque.Deque<mut Node&>()
    l.head = Node(2)
    d.PushBack(l.head!)
    l.PopFront()
    churn(l)
    return (try d.PopFront() catch { return -1 }).v
}

fn main() ? {
    try io.Println("viaDeque " $viaDeque())
}
