import "std/io"

type Node struct(v I64) {
    v
    next mut Node?& = null
    prev weak mut Node?& = null
}

type Box struct(n mut Node?&) {
    n
}

type L struct() {
    head mut Node?& = null
    tail weak mut Node?& = null
}

fn churn(l mut L&) {
    for i in range 50 {
        l.head = Node(1000 + i)
        l.head = null
    }
}

fn use(b mut Box&, l mut L&, s mut L&) I64 {
    l.head = null
    churn(s)
    return b.n!.v
}

fn Box.mk(l mut L&) Box {
    return Box(l.head)
}

fn Box.mk2(n mut Node&) Box {
    x := Box(null)
    x.n = n
    return x
}

fn one() I64 {
    l := L()
    s := L()
    l.head = Node(7)
    l.tail = l.head
    return use(Box.mk(l), l, s)
}

fn two() I64 {
    l := L()
    s := L()
    l.head = Node(8)
    return use(Box.mk2(l.head!), l, s)
}

fn three() I64 {
    l := L()
    s := L()
    l.head = Node(9)
    bs := Array<Box>[Box(l.head)]
    return use(bs[0], l, s)
}

fn main() ? {
    try io.Println("call: " $one() " want 7")
    try io.Println("call2: " $two() " want 8")
    try io.Println("arr: " $three() " want 9")
}
