type Node struct(v I64) {
    V I64 = v
    Next mut Node?& = null
    Prev weak mut Node?& = null
}

type L struct() {
    Head mut Node?& = null
    Tail weak mut Node?& = null
}

fn (l mut L&) PopFront() {
    h := l.Head!
    l.Head = h.Next
}

fn (l mut L&) Churn() {
    for i in range 50 {
        nd := Node(1000 + i)
        nd.Next = l.Head
        l.Head = nd
        l.PopFront()
    }
}

