type Foo int32

error MyError {
    ERR_A,
    ERR_B
}

func add(a int32, b int32) ? int32 {
    return a + b
}

func safeDiv(a int32, b int32) MyError ? int32 {
    if b == 0 {
        error MyError.ERR_A
    }
    return a / b
}

func main() ? int32 {
    x mut int32 = 5
    y mut int32 = x + 1
    z mut int32 = x +
        y
    if x < y {
        z = add(x, y)
    }
    for i mut int32 = 0, i < 3, i++ {
        z = z + i
    }
    return z
}

test "add sums its two arguments" {
    assert(add(2, 3) == 5)
}

test "add handles negative numbers" {
    assert(add(-2, 5) == 3)
}

test "try/catch: success path skips the catch block" {
    caught mut bool = false
    try safeDiv(10, 2) catch MyError {
        caught = true
    }
    assert(!caught)
}

test "try/catch: catching the whole error type works inside a test" {
    caught mut bool = false
    try safeDiv(10, 0) catch MyError {
        caught = true
    }
    assert(caught)
}

test "try/catch: catching specific words works inside a test" {
    caught mut bool = false
    try safeDiv(10, 0) catch MyError.ERR_A || MyError.ERR_B {
        caught = true
    }
    assert(caught)
}
