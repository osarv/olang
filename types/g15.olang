# G15: a type match no case covers - reported at the instantiation, naming the type and the generic
import "std/io"
fn describe(v <T>) I32 {
  match <T> {
    case I32 { return 1 }
    case F64 { return 2 }
  }
  return 0
}
fn main() ? {
  a := describe(5)
  b := describe(true)
  try io.Print($a $b "\n")
}
