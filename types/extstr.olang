# T29e/G19: a type extending Array<I32> has the array methods - does it meet a trait needing one?
import "std/io"
type Counter trait {
  Count(keep fn(x I32) Bool) I64
}
fn n(c <C Counter>&) I64 { return c.Count(fn(x I32) Bool { return x > 1 }) }
type Ints extends Array<I32>
fn main() ? {
  a Ints = Ints(I32[1, 2, 3])
  try io.Print($a.Count(fn(x I32) Bool { return x > 1 }) " " $n(a) "\n")
}
