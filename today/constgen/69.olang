# G16b: an error in an instantiation reached through a recursive chain - the notes stop before the call that started it
fn Down(a Array<I64, <N>>&) I64 {
    if N == 0 { return a[0] } else { return Down(a[1:] as Array<I64, N - 1>&) }
}
fn main() ? {
    x Array<I64, 2> = I64[1, 2]
    println($Down(x))
}
