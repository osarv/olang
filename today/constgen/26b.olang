# a reference stored after construction escapes - the construction bound nothing for the store to rebind
type Holder struct(name mut String&) {
    name
}
fn make() Holder {
    a := "alpha" $3
    h := Holder("static")
    h.name = a
    return h
}
fn churn() I64 {
    s I64 = 0
    for i in range 1000 {
        t := "xxxxxxxxxxxxxxxxxxxxxxxx" $i
        s = s + t.Len()
    }
    return s
}
fn main() ? {
    h := make()
    println($churn())
    println($h.name)
}
