# the prelude's newer text methods, and its number reading and writing, tested - a module of its own, not part of the
# prelude, so these are compiled only when they are run

test "TrimStart and TrimEnd borrow the receiver's storage, as Trim does" {
    assert "  x y \t".TrimStart() == "x y \t" and "  x y \t".TrimEnd() == "  x y"
    assert "".TrimStart() == "" and "   ".TrimEnd() == "" and "ab".TrimStart() == "ab" and "ab".TrimEnd() == "ab"
    line String& = "\t key = value \r\n"
    assert line.TrimEnd().TrimStart() == line.Trim()
}

test "ToUpper and ToLower change ASCII letters and nothing else" {
    assert "Hello, World! 123".ToUpper() == "HELLO, WORLD! 123"
    assert "Hello, World! 123".ToLower() == "hello, world! 123"
    assert "".ToUpper() == "" and "@[`{".ToUpper() == "@[`{" and "@[`{".ToLower() == "@[`{"   # the bytes around the letters
    e := String(U8[0xC3, 0xA9, 'a', 0xC3, 0x89])                        # "éaÉ": UTF-8 left as it is
    u := e.ToUpper()
    assert u[0] == 0xC3 and u[1] == 0xA9 and u[2] == 'A' and u[3] == 0xC3 and u[4] == 0x89 and e.ToLower() == e
    s String& = "MiXeD"
    assert s.ToLower() == "mixed" and s == "MiXeD"                         # new text: the receiver is unchanged
}

test "FindLast finds the last occurrence, failing when there is none" {
    assert (try "abcabc".FindLast("bc") catch default -1) == 4
    assert (try "abcabc".FindLast("abc") catch default -1) == 3
    assert (try "abc".FindLast("x") catch default -1) == -1
    assert (try "abc".FindLast("abcd") catch default -1) == -1
    assert (try "abc".FindLast("") catch default -1) == 3 and (try "".FindLast("") catch default -1) == 0
    assert (try "aaa".FindLast("aa") catch default -1) == 1
}

test "text orders by its bytes with < and the comparisons derived from it" {
    a String& = "apple"
    assert a < "banana" and "banana" > a and a <= "apple" and a >= "apple" and not (a < "apple")
    assert "ab" < "abc" and "" < "a" and "B" < "a" and not ("b" < "B")             # bytewise: upper case first
    assert "a" < "b" < "c" and not ("a" < "c" < "b")                                # chained, as for numbers
    words := "pear fig apple kiwi banana".Split(" ")
    words.Sort(fn(x, y) { return x < y })
    assert words.Join(" ") == "apple banana fig kiwi pear"
}

# the lines of text, each in brackets
fn bracketed(text String&) String& {
    b := StringBuilder()
    for line in text.Lines() {
        b.PushChar('[')
        b.Push(line)
        b.PushChar(']')
    }
    return b.ToString()
}

# the lines of text kept in a List - borrows of the text, so the List lives where the text does
fn linesOf(t String&) List<String&>&t {
    out List<String&>&t = List<String&>()
    for line in t.Lines() { out.Push(line) }
    return out
}

test "Lines gives each line without its newline, as io.Lines reads a file's" {
    assert bracketed("") == "" and bracketed("a") == "[a]" and bracketed("a\n") == "[a]"
    assert bracketed("a\nb") == "[a][b]" and bracketed("a\n\n") == "[a][]" and bracketed("\n") == "[]"
    assert bracketed("a\r\nb\r\n") == "[a][b]" and bracketed("a\r") == "[a]" and bracketed("\r\n") == "[]"
    assert bracketed("a\r\r\nb") == "[a\r][b]"                       # only the one carriage return goes
    text String& = "first\nsecond\n\nfourth"
    kept := linesOf(text)
    assert kept.Len() == 4 and kept[0] == "first" and kept[2] == "" and kept[3] == "fourth"
    n I64 = 0
    it := text.Lines()
    for {
        line := try it.Next() catch Exhausted { break }
        n += line.Len()
    }
    assert n == 17 and (try it.Next() catch default "end") == "end"      # an iterator that has run out stays out
    assert text.Lines().Count(fn(l) { return l.Len() > 0 }) == 3
}

test "Join puts a separator between the texts of an array" {
    assert String&["a", "b", "c"].Join(", ") == "a, b, c"
    assert String&["only"].Join(", ") == "only" and Array<String&>(0).Join(", ") == ""
    assert String&["", "", ""].Join("-") == "--" and String&["x", "y"].Join("") == "xy"
    parts := "2026-10-09".Split("-")
    assert parts.Join("/") == "2026/10/09"
    assert $String&["a", "b"] == "String&[\"a\", \"b\"]"                   # $ renders the array as source
}

# ParseFloat's value of text, or a NaN when it fails
fn float(text String&) F64 {
    return try text.ParseFloat() catch { return 0.0 / 0.0 }
}

# the word ParseFloat fails with, or "ok"
fn floatProblem(text String&) String& {
    try text.ParseFloat() catch ParseError.EMPTY { return "EMPTY" } catch ParseError.INVALID { return "INVALID" }
        catch ParseError.OVERFLOW { return "OVERFLOW" }
    return "ok"
}

test "ParseFloat reads a decimal number to the nearest F64" {
    assert float("0") == 0.0 and float("-0").Bits() == U64(0x8000000000000000) and float("0").Bits() == 0
    assert float("1") == 1.0 and float("-1") == -1.0 and float("+1") == 1.0 and float("0.1") == 0.1
    assert float("0.30000000000000004") == 0.30000000000000004 and float("1e23") == 1e23
    assert float("8.98846567431158e307") == 8.98846567431158e307 and float("1.7976931348623157e308") == 1.7976931348623157e308
    assert float("2.2250738585072011e-308").Bits() == 0xFFFFFFFFFFFFF          # just below the smallest normal
    assert float("2.2250738585072014e-308").Bits() == 0x10000000000000
    assert float("4.9e-324").Bits() == 1 and float("2.4703282292062328e-324").Bits() == 1
    assert float("2.4703282292062327e-324") == 0.0                             # exactly half the smallest: to even
    assert float("1e-400") == 0.0 and float("-1e-400").Bits() == U64(0x8000000000000000)
    assert float("9007199254740993") == 9007199254740992.0                     # halfway: to even
    assert float("9007199254740993.00000000000000000001") == 9007199254740994.0 # past 19 digits, just above halfway
    assert float("0.1000000000000000055511151231257827021181583404541015625") == 0.1
    assert float("123456789012345678901234567890") == 1.2345678901234568e29
    assert float("1E2") == 100.0 and float("1e+2") == 100.0 and float("100e-2") == 1.0 and float("0e99") == 0.0
    assert float("-9223372036854775808") == -9223372036854775808.0
    assert float(".5") == 0.5 and float("5.") == 5.0 and float("-.25e1") == -2.5 and float("007.50") == 7.5
    long := StringBuilder()
    long.PushChar('1')
    long.Push("0".Repeat(400))
    long.Push("e-400")
    assert float("0.000000000000000000000000000001") == 1e-30 and float(long.ToString()) == 1.0
}

test "ParseFloat reads the infinities and NaN, so what $ writes reads back" {
    assert float("inf") == 1.0 / 0.0 and float("-inf") == -1.0 / 0.0 and float("+Infinity") == 1.0 / 0.0
    assert float("INF") == 1.0 / 0.0 and float("-InFiNiTy") == -1.0 / 0.0
    n := float("nan")
    assert n != n and float("NaN").Bits() == U64(0x7FF8000000000000) and float("-nan").Bits() == U64(0xFFF8000000000000)
    for x in F64[0.1, -2.5, 1e300, 5e-324, 1.0 / 3.0, -0.0, 123456789.125, 1.0 / 0.0, -1.0 / 0.0, 2.0 / 3.0] {
        assert float($x).Bits() == x.Bits()
    }
}

test "ParseFloat names what was wrong" {
    assert floatProblem("") == "EMPTY" and floatProblem("1.5") == "ok"
    for bad in String&["-", "+", ".", "-.", "e5", "1e", "1e+", "1.5x", " 1", "1 ", "1_000", "0x10", "--1", "1.2.3", "infin",
        "nana", "in", "1e5e5", "+-1"] {
        assert floatProblem(bad) == "INVALID"
    }
    assert floatProblem("1e309") == "OVERFLOW" and floatProblem("-1e400") == "OVERFLOW"
    assert floatProblem("1.7976931348623159e308") == "OVERFLOW"                 # rounds past the largest F64
    assert floatProblem("1.7976931348623158e308") == "ok"                       # rounds down to it
    assert floatProblem("1e-99999") == "ok" and floatProblem("1e99999") == "OVERFLOW"
    assert floatProblem(" 2.5 ".Trim()) == "ok"
}

test "ShortestDecimal gives the fewest digits that read back" {
    f, e := try (0.1).ShortestDecimal() catch { unreachable }
    assert f == 1 and e == -1
    f, e = try (100.0).ShortestDecimal() catch { unreachable }
    assert f == 1 and e == 2
    f, e = try (-123.456).ShortestDecimal() catch { unreachable }
    assert f == 123456 and e == -3
    f, e = try (5e-324).ShortestDecimal() catch { unreachable }
    assert f == 5 and e == -324
    f, e = try (1.7976931348623157e308).ShortestDecimal() catch { unreachable }
    assert f == 17976931348623157 and e == 292
    f, e = try (7.120236347223045e-307).ShortestDecimal() catch { unreachable }     # a power of two: 16 digits
    assert f == 7120236347223045 and e == -322
    f, e = try (-0.0).ShortestDecimal() catch { unreachable }
    assert f == 0 and e == 0
    nan F64 = 0.0 / 0.0
    failed := false
    f, e = try nan.ShortestDecimal() catch { failed = true } default 0, 0
    assert failed
    failed = false
    f, e = try (1.0 / 0.0).ShortestDecimal() catch { failed = true } default 0, 0
    assert failed
    for x in F64[0.1, 1.0 / 3.0, 2.0 / 3.0, 1e23, 9007199254740993.0, 2.2250738585072014e-308, 123.456, 3.141592653589793] {
        d, p := try x.ShortestDecimal() catch { unreachable }
        assert float($d "e" $p) == x
    }
}

# the same, while compiling (K2): ParseFloat's three ways - Clinger's, Eisel and Lemire's, and the digits shifted -
# and the shortest digits, exactly as at run time
fn floatsRead() U64 {
    h U64 = 0
    for t in String&["0.1", "1e23", "9007199254740993", "2.4703282292062328e-324", "123456789012345678901234567890",
        "0.1000000000000000055511151231257827021181583404541015625", "-1.5e-300", "inf"] {
        h = h * 1099511628211 + (try t.ParseFloat() catch default 0.0).Bits()
    }
    d, p := try (2.0 / 3.0).ShortestDecimal() catch default 0, 0
    return h + d + U64(p)
}
floatsReadBaked := floatsRead()
floatsMutable mut I64 = 1           # read at run time, so the comparison below is made there

test "ParseFloat and ShortestDecimal, evaluated while compiling as at run time" {
    assert floatsRead() == floatsReadBaked
    assert floatsMutable == 1 and float("1e23") == 1e23
}
