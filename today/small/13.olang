# E11a: $ on F16 and BF16 bit patterns - a hash of the renderings computed while compiling (baked) and at run time
fn h16(lo I64, hi I64) I64 {
    h I64 = 1469598103934665603
    for i in range lo, hi {
        u := U16(i)
        s := $u.F16FromBits() "|" $u.BF16FromBits()
        for c in s { h = (h ^ I64(c)) * 1099511628211 }
    }
    return h
}
B0 I64 = h16(0, 256)
B1 I64 = h16(256, 512)
B2 I64 = h16(1024, 1280)
B3 I64 = h16(15104, 15360)
B4 I64 = h16(15360, 15616)
B5 I64 = h16(31488, 31744)
B6 I64 = h16(31744, 32000)
B7 I64 = h16(32512, 32768)
B8 I64 = h16(32768, 33024)
B9 I64 = h16(48128, 48384)
B10 I64 = h16(64512, 64768)
B11 I64 = h16(65280, 65536)
fn main() ? {
    println("0: " $(B0 == h16(0, 256)))
    println("256: " $(B1 == h16(256, 512)))
    println("1024: " $(B2 == h16(1024, 1280)))
    println("15104: " $(B3 == h16(15104, 15360)))
    println("15360: " $(B4 == h16(15360, 15616)))
    println("31488: " $(B5 == h16(31488, 31744)))
    println("31744: " $(B6 == h16(31744, 32000)))
    println("32512: " $(B7 == h16(32512, 32768)))
    println("32768: " $(B8 == h16(32768, 33024)))
    println("48128: " $(B9 == h16(48128, 48384)))
    println("64512: " $(B10 == h16(64512, 64768)))
    println("65280: " $(B11 == h16(65280, 65536)))
}
