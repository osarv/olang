# D15/O25a: ':=' from an expression that is not a call or a literal still takes its value's scope exactly
type Node struct(v I64) { v }
G mut I64 = 1
fn pick() Node& {
    a := Node(1)
    b := Node(2)
    x := a if G > 0 else b
    return x
}
fn pick2(p Node&) Node&p {
    a := Node(1)
    x := a if G > 5 else p
    return x
}
fn main() ? {
    n := Node(9)
    println($pick().v " " $pick2(n).v)
}
