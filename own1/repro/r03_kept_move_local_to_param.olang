# O39 roots: an owner local's object moved (kept reach) into the parameter's tree, then released through the
# parameter - a release rooted at a parameter never meets a loan rooted at a local
type Node struct(n I64) {
    n
    name String& = "node" $n
}
type Holder struct() {
    cur own mut Node&
    sub own mut Holder&
}
fn f(p mut Holder&) {
    o own mut Holder& = take p.sub   # o's reach is p's scope
    o.cur = Node(9)
    c := o.cur                       # a loan rooted at the owner local o
    p.cur = take o.cur               # kept reach: a move, no release checked
    p.cur = null                     # released through p - rooted at a parameter
    println(c.name)
}
fn main() ? {
    h := Holder()
    h.sub = Holder()
    f(h)
}
