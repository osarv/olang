# kept-reach move changes an object's owning root, but a loan keeps its original root. A release through
# the NEW root does not see the loan rooted at the OLD owner local -> use-after-free, single-threaded.
type Node struct(n I64) {
    n
    name String& = "the node name is " $n
}
type Holder struct() {
    cur own mut Node&
}
fn churn() {
    j := List<String&>()
    for i in range 400 { j.Push("yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy" $i) }
}
fn main() ? {
    o1 own mut Holder& = Holder()
    o1.cur = Node(5)
    o2 own mut Holder& = Holder()
    c := o1.cur              # loan rooted at o1
    o2.cur = take o1.cur     # kept-reach move: the Node is now owned by o2, but c's loan still roots at o1
    o2.cur = null            # release through o2 - the borrow pass does not see the o1-rooted loan
    churn()                  # reuse the freed region's chunk
    println(c.name)          # reads freed, reused memory
}
