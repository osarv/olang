# base - the generator and the scanner alone: what refs and vals share, measured on its own
import "std/io"
import "common"

fn main() ? {
    text := common.Generate(common.SizeArg(200000))
    names := Map<String, I64>()
    toks := common.Scan(text, names)
    try io.PutLine("base: " $toks.Len() " tokens")
}
