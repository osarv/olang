# turncopy - found by the values study (2026-11-03): a value local declared in a loop body as a copy of an element
# of a Vec the same function holds, the element owning storage (a struct holding a Vec), keeps every turn's copy until
# the function's frame closes - 1M turns of a 100-element copy peak at ~500 MB, where the turn's block should reclaim
# each copy (O2). Where the Vec is a parameter instead (`walk(v Vec<Node>&, ...)`), or the read is a field of the element
# (`v[0].w`), nothing is copied (D9h) and the run stays at 2 MB. The copy is made (D9h cannot leave it out: the body
# writes the Vec) but seemingly built where the Vec lives - its parts placed as a reference-holding copy's are (O25h)?
# Run it: the peak should stay a few MB.
import "std/io"

type Node struct(w I64) {
    w
    kids Vec<I32> = Vec<I32>()
}

fn main() ? {
    v := Vec<Node>()
    v.Push(Node(1))
    for k in range 100: v.RefMut(0).kids.Push(I32(k))
    s := 0
    for _ in range 1000000 {
        n := v[0]
        s += n.w
    }
    try io.Println($s)
}
