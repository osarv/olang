# turncopy - found by the values study (2026-11-03): a value local declared in a loop body as a copy of an element
# that owns storage (a struct holding a Vec) keeps every turn's copy until main's frame closes - 1M turns of a
# 100-element copy peak at ~500 MB, where the turn's block should reclaim each copy (O2). The same read in a function
# of its own copies nothing at all (D9h sees that nothing could tell). Run: peak RSS should stay a few MB.
import "std/io"

type Node struct(w I64) {
    w
    kids Vec<I32> = Vec<I32>()
}

fn main() ? {
    v := Vec<Node>()
    v.Push(Node(1))
    for k in range 100: v.RefMut(0).kids.Push(I32(k))
    s := 0
    for _ in range 1000000 {
        n := v[0]
        s += n.w
    }
    try io.Println($s)
}
