# gui_natural - found by the values study (2026-11-03): docs/values-study/gui/vals.olang with its element reads written
# plainly, `u.nodes[i].f`, as values-style code would write them (writes stay `RefMut`: `u.nodes[p].kids.Push(c)` is
# E31b's refusal). Where a call shares the statement - `r.roll(u.nodes[at].kids.Len())`, `u.sum(u.nodes[i].kids[k])` -
# the read copies the whole element, its kids Vec included, and in a loop the copies are not reclaimed per turn
# (turncopy.olang). Same checksums as vals.olang; measured (values-study.md 2.4): `100000 1000000 0` 5.8 s and 1.3 GB
# against vals.olang's 0.23 s and 27 MB, `100000 1000000 2000` 32 s and 9.0 GB, `100000 1000000 20000` killed at 14 GB.
import "std/io"
import "std/os"

type Kind enum { Panel, Button, Label }

type Node struct(kind Kind, x I64, y I64, w I64, h I64, parent I32) {
    kind
    x
    y
    w
    h
    parent     # -1 for none
    kids Vec<I32> = Vec<I32>()
    ax I64 = 0
    ay I64 = 0
    clicks I64 = 0
}

type Ui struct() {
    nodes Vec<Node> = Vec<Node>()
    free Vec<I32> = Vec<I32>()
}

type Rand struct(state U64) { state }

fn (r mut Rand&) roll(n I64) I64 {
    r.state = r.state * 6364136223846793005 + 1442695040888963407
    return I64((r.state >> 33) % U64(n))
}

fn arg(k I64, n I64) I64 {
    args := os.Args()
    if args.Len() <= k: return n
    return try args[k].ParseInt() catch default n
}

# a slot for n: a freed one if there is one, else a new one
fn (u mut Ui&) add(n Node) I32 {
    i := try u.free.Pop() catch {
        u.nodes.Push(n)
        return I32(u.nodes.Len() - 1)
    }
    u.nodes[i] = n
    return i
}

fn (u mut Ui&) child(r mut Rand&, p I32) I32 {
    pw, ph := u.nodes[p].w, u.nodes[p].h
    w := 4 + r.roll(pw / 3 + 1)
    h := 4 + r.roll(ph / 3 + 1)
    k := Kind.Panel if r.roll(3) == 0 else (Kind.Button if r.roll(2) == 0 else Kind.Label)
    c := u.add(Node(k, r.roll(pw - w + 1), r.roll(ph - h + 1), w, h, p))
    u.nodes.RefMut(p).kids.Push(c)
    return c
}

fn (u mut Ui&) grow(r mut Rand&, p I32, n I64) {
    panels := Vec<I32>()
    panels.Push(p)
    k := 0
    for k < n and panels.Len() > 0 {
        i := r.roll(panels.Len())
        q := panels[i]
        if u.nodes[q].w < 12 or u.nodes[q].h < 12 {
            panels.SwapRemove(i)!
            continue
        }
        c := u.child(r, q)
        if u.nodes[c].kind == Kind.Panel: panels.Push(c)
        k++
    }
}

fn (u mut Ui&) layout(i I32, ax I64, ay I64) {
    w := u.nodes.RefMut(i)
    w.ax = ax + w.x
    w.ay = ay + w.y
    x, y := w.ax, w.ay
    for k in range u.nodes[i].kids.Len(): u.layout(u.nodes[i].kids[k], x, y)
}

fn inside(w Node&, px I64, py I64) Bool { return px >= w.ax and px < w.ax + w.w and py >= w.ay and py < w.ay + w.h }

fn (u Ui&) hit(px I64, py I64) I32 {
    at := I32(0)
    for {
        kids := u.nodes[at].kids.View()
        next := I32(-1)
        for i in range kids.Len() {
            k := kids[kids.Len() - 1 - i]
            if inside(u.nodes[k], px, py) {
                next = k
                break
            }
        }
        if next < 0: return at
        at = next
    }
}

fn (u mut Ui&) click(target I32) I64 {
    at := target
    depth := 0
    for at >= 0 {
        w := u.nodes.RefMut(at)
        if w.kind == Kind.Button {
            w.clicks++
            return depth
        }
        if w.kind == Kind.Panel: w.clicks++
        depth++
        at = w.parent
    }
    return depth
}

fn (u Ui&) pick(r mut Rand&) I32 {
    at := I32(0)
    for u.nodes[at].kids.Len() > 0 and r.roll(4) > 0: at = u.nodes[at].kids[r.roll(u.nodes[at].kids.Len())]
    return at
}

fn (u Ui&) panel(r mut Rand&) I32 {
    for _ in range 8 {
        p := u.pick(r)
        if u.nodes[p].kind == Kind.Panel and u.nodes[p].w >= 12 and u.nodes[p].h >= 12: return p
    }
    return 0
}

fn (u Ui&) count(i I32) I64 {
    n := 1
    for k in range u.nodes[i].kids.Len(): n += u.count(u.nodes[i].kids[k])
    return n
}

# take i's subtree out of the tree: every slot in it goes on the free list
fn (u mut Ui&) detach(i I32) {
    p := u.nodes[i].parent
    if p < 0: return
    k := try u.nodes[p].kids.IndexOf(i) catch { return }
    try u.nodes.RefMut(p).kids.RemoveAt(k) catch { return }
    u.release(i)
}

fn (u mut Ui&) release(i I32) {
    for k in range u.nodes[i].kids.Len(): u.release(u.nodes[i].kids[k])
    u.nodes.RefMut(i).kids.Clear()
    u.nodes.RefMut(i).parent = -1
    u.free.Push(i)
}

fn (u Ui&) sum(i I32) I64 {
    s := u.nodes[i].clicks + 1
    for k in range u.nodes[i].kids.Len(): s += u.sum(u.nodes[i].kids[k])
    return s
}

fn main() ? {
    n, clicks, rounds := arg(1, 100000), arg(2, 1000000), arg(3, 20000)
    r := Rand(7)
    u := Ui()
    u.add(Node(Kind.Panel, 0, 0, 4096, 4096, -1))
    u.grow(r, 0, n)
    u.layout(0, 0, 0)
    depth := 0
    for _ in range clicks: depth += u.click(u.hit(r.roll(4096), r.roll(4096)))
    for _ in range rounds {
        w := u.pick(r)
        if u.nodes[w].parent < 0: continue
        m := u.count(w)
        u.detach(w)
        u.grow(r, u.panel(r), m)
    }
    u.layout(0, 0, 0)
    for _ in range clicks: depth += u.click(u.hit(r.roll(4096), r.roll(4096)))
    try io.PutLine(("vals: depth " $depth ", sum " $u.sum(0) ", live " $(u.nodes.Len() - u.free.Len()) ", slots "
        $u.nodes.Len()))
}
