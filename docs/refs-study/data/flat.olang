# flat - n particles laid out flat, as C lays out an array of structs (today's `Array<P>`): what a references-by-default
# olang gives only where the particle type is immut, unique, or found never shared. Arguments: particles, steps.
import "std/io"
import "common"

fn step(ps mut Array<common.P>&) {
    for i in range ps.Len() {
        p mut common.P& = ps[i]
        p.Vy -= 9.8 * common.Dt
        p.X += p.Vx * common.Dt
        p.Y += p.Vy * common.Dt
        if p.Y < 0.0 {
            p.Y = -p.Y
            p.Vy = -p.Vy * 0.9
        }
    }
}

fn main() ? {
    n, steps := common.Arg(1, 4000000), common.Arg(2, 25)
    r := common.Rand(5)
    ps := common.P[r.Particle() for _ in range n]
    for _ in range steps: step(ps)
    sum := F64(0.0)
    for p in ps: sum += F64(p.X + p.Y)
    try io.PutLine("flat: " $sum)
}
