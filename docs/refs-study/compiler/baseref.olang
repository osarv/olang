# baseref - the generator and the scanner alone with every struct an object (scanref.olang): base.olang's counterpart
import "std/io"
import "scanref"

fn main() ? {
    text := scanref.Generate(scanref.SizeArg(200000))
    names := Map<String, I64>()
    toks := scanref.Scan(text, names)
    try io.PutLine("baseref: " $toks.Len() " tokens")
}
