# a binary search tree with parent links churning in main's scope: 1M inserts and deletes of pseudo-random keys, at
# most 1000 nodes live; each node carries a 64-byte payload
import "std/io"
import "std/time"
import "peak"

type Node struct(key I64, up mut Node?&) {
    key
    parent weak mut Node?& = up # points back (T2d): the tree holds each node through 'root', 'left' and 'right'
    pad Array<I64> = Array<I64>(8, 0)
    left mut Node?& = null
    right mut Node?& = null
}

type Tree struct() {
    root mut Node?& = null
    n I64 = 0
}

fn (t mut Tree&) Insert(k I64) {
    if t.root is null {
        t.root = Node(k, null)
        t.n++
        return
    }
    at := t.root!
    for {
        if k < at.key {
            l := at.left
            if l is null {
                at.left = Node(k, at)
                t.n++
                return
            }
            at = l
        } else {
            r := at.right
            if r is null {
                at.right = Node(k, at)
                t.n++
                return
            }
            at = r
        }
    }
}

# the node holding the smallest key under n
fn leftmost(n mut Node&) mut Node& {
    at := n
    for {
        l := at.left
        if l is null: return at
        at = l
    }
}

# n's place in its parent (or the root) given c
fn (t mut Tree&) replace(n mut Node&, c mut Node?&) {
    p := n.parent
    if c is not null: c.parent = p
    if p is null {
        t.root = c
    } else if p.left == n {
        p.left = c
    } else {
        p.right = c
    }
}

# the smallest key removed; the tree is not empty
fn (t mut Tree&) DeleteMin() I64 {
    m := leftmost(t.root!)
    k := m.key
    t.replace(m, m.right)
    t.n--
    return k
}

fn main() ? io.Error {
    t0 := time.Now()
    t := Tree()
    total := 0
    x := 12345
    for _ in range 1000000 {
        x = (x * 1103515245 + 12345) % 2147483648
        t.Insert(x)
        if t.n > 1000: total += t.DeleteMin() % 1000
    }
    ms := time.Since(t0) / 1000000
    try io.Println("tree: total " $total " peak " $peak.PeakKb() " KB, " $ms " ms")
}
