# Vec phase 2a, relaxation a (own5 F2's return rule): a result reaching an owner value local by reference is refused
# because the reference carries the owner's loans (ownValueReads) - which ownOwnSlotReads collects only 8 value-struct
# levels deep. With the Vec 8 levels down there are none: 'return o' through 'mut L8&', and a returned Hold(o), are
# accepted, O26a moves o's storage into the result scope, and o's owners are released at the return anyway. The caller
# reads a Vec whose buffer slot was let go of: a null read (T2b's trap). The compile-time evaluator, which gives a release
# no meaning, bakes Baked as 1 and decides nothing wrong. At depth 2 both are O38/O26a's error.
#   -b -d -s: segfault (139)    -b: segfault (139)    -i: "baked 1 / 1 7"
type L0 struct() {
    toks Vec<I64> = Vec<I64>()
}
type L1 struct() {
    x L0 = L0()
}
type L2 struct() {
    x L1 = L1()
}
type L3 struct() {
    x L2 = L2()
}
type L4 struct() {
    x L3 = L3()
}
type L5 struct() {
    x L4 = L4()
}
type L6 struct() {
    x L5 = L5()
}
type L7 struct() {
    x L6 = L6()
}
type L8 struct() {
    x L7 = L7()
}
fn mk() mut L8& {
    o := L8()
    for i in range 100 { o.x.x.x.x.x.x.x.x.toks.Push(i + 1) }
    return o                                # O26a: o's storage moves to the result scope; its owners are released here
}
type Hold struct(x L8&) {
    x
}
fn mkHold() Hold {
    o := L8()
    for i in range 100 { o.x.x.x.x.x.x.x.x.toks.Push(i + 7) }
    h := Hold(o)
    return h
}
fn first() I64 { return mk().x.x.x.x.x.x.x.x.toks[0] }
Baked I64 = first()
fn main() ? {
    println("baked " $Baked)
    r := mk()
    h := mkHold()
    println($r.x.x.x.x.x.x.x.x.toks[0] " " $h.x.x.x.x.x.x.x.x.x.toks[0])
}
