# Vec phase 2a (R1, see r1a): through a function - "fn steal(h mut H&) Vec<String&> { return take h.lx.toks }": its
# result is taken to refer to h's scope (the reach ownValuePlaceReach gives), so it lands in another owned object
# ("g.lx.toks = steal(h)"), an owner moved into an own place holds no loan, and "h.lx = null" frees the words.
#   -b -d -s: use after scope closed; -i: correct; -b: churn text
type Lex3 struct() {
    toks Vec<String&> = Vec<String&>()
}
type H struct() {
    lx own mut Lex3& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn steal(h mut H&) Vec<String&> { return take h.lx.toks }
fn main() ? {
    h := H()
    g := H()
    h.lx = Lex3()
    g.lx = Lex3()
    for i in range 3 { h.lx.toks.Push($i "-built-into-h-region") }
    g.lx.toks = steal(h)
    h.lx = null
    churn()
    println(g.lx.toks[0])
}
