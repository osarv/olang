# Vec phase 2a (R1, see r1a): the same through a struct held by value in an owned object - "g.m.l = take h.m.l".
#   -b -d -s: use after scope closed; -i: correct; -b: churn text
type Lex3 struct() {
    toks Vec<String&> = Vec<String&>()
}
type Mid struct() {
    l Lex3 = Lex3()
}
type H struct() {
    m own mut Mid& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    h := H()
    g := H()
    h.m = Mid()
    g.m = Mid()
    for i in range 3 { h.m.l.toks.Push($i "-built-into-h-region") }
    g.m.l = take h.m.l
    h.m = null
    churn()
    println(g.m.l.toks[0])
}
