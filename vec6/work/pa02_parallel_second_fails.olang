Made mut I64 = 0
Dropped mut I64 = 0
type X struct(k I64) {
    k
    Made++
} destruct { Dropped++ }
type Lexer struct(n I64) {
    n
    o own mut X& = X(n)
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn mkLexer(k I64) Lexer {
    l := Lexer(k)
    for i in range k { l.toks.Push(i) }
    return l
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn mkFail(k I64) Lexer ? {
    if k > 1 { error }
    return mkLexer(k)
}
fn work(k I64) ? {
    t := Two()
    t.a, t.b = mkLexer(k + 3), try mkFail(k)
}
fn main() ? {
    for k in range 4 { try work(k) catch { } }
    println("made " $Made " dropped " $Dropped)
}
