type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn mk() Lexer {
    t := Two()
    for i in range 3 { t.a.toks.Push(i + 1) }
    return t.a
}
fn main() ? {
    l := mk()
    z := Vec<I64>()
    for i in range 5 { z.Push(777) }
    churn()
    println($l.toks[0])
}
