type Bx<T> struct(x T) {
    x
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn keep(h mut Bx<Array<I64>&>&, d Array<I64>&) { h.x = d }
fn main() ? {
    v := Vec<I64>()
    for i in range 3 { v.Push(i + 1) }
    h := Bx<Array<I64>&>(null)
    d := v.View()
    keep(h, d)
    for i in range 100 { v.Push(i) }
    churn()
    println($h.x[0])
}
