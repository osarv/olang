type Tok struct(text String&, n I64) {
    text
    n
}
type Lex2 struct() {
    toks Vec<Tok> = Vec<Tok>()
}
type H struct() {
    lx own mut Lex2& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
GH mut H = H()
fn main() ? {
    GH.lx = Lex2()
    for i in range 4 { GH.lx.toks.Push(Tok($i "-own-text", i)) }
    e := GH.lx.toks[1]
    GH.lx = null
    churn()
    println(e.text)
}
