type Tok struct(text String&, n I64) {
    text
    n
}
type Lex2 struct() {
    toks Vec<Tok> = Vec<Tok>()
}
type H struct() {
    lx own mut Lex2& = null
}
fn add(v mut Vec<Tok>&, t String&) { v.Push(Tok(t, 2)) }
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    h := H()
    h.lx = Lex2()
    for i in range 3 { h.lx.toks.Push(Tok($i "-built-into-region", i)) }
    m := take h.lx.toks
    h.lx = null
    churn()
    println(m[0].text)
}
