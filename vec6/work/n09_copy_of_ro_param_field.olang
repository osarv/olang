type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn f(t Two&) I64 {
    c := t.a
    return c.toks[0]
}
fn main() ? {
    t := Two()
    for i in range 3 { t.a.toks.Push(i + 1) }
    println($f(t))
}
