type E enum {
    V(a Array<I64>&)
    N
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn keep(l mut List<E>&, d Array<I64>&) { l.Push(E.V(d)) }
fn main() ? {
    v := Vec<I64>()
    for i in range 3 { v.Push(i + 1) }
    l := List<E>()
    d := v.View()
    keep(l, d)
    for i in range 100 { v.Push(i) }
    churn()
    match l[0] {
        case E.V(a) { println($a[0]) }
        case E.N { }
    }
}
