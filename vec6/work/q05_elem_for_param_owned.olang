type Tok struct(text String&, n I64) {
    text
    n
}
type Lex2 struct() {
    toks Vec<Tok> = Vec<Tok>()
}
type H struct() {
    lx own mut Lex2& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn work(h mut H&) {
    keep := Tok("x", 0)
    for e in h.lx.toks { keep = e }
    h.lx = null
    churn()
    println(keep.text)
}
fn main() ? {
    h := H()
    h.lx = Lex2()
    for i in range 4 { h.lx.toks.Push(Tok($i "-own-text", i)) }
    work(h)
}
