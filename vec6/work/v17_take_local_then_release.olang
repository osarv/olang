type Lex3 struct() {
    toks Vec<String&> = Vec<String&>()
}
type H struct() {
    lx own mut Lex3& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    h := H()
    h.lx = Lex3()
    for i in range 3 { h.lx.toks.Push($i "-built-into-h-region") }
    m := take h.lx.toks
    n := take m
    h.lx = null
    churn()
    println(n[0])
}
