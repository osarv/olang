type X struct(k I64) {
    k
    text String& = "x" $k "-text-of-x-object"
}
type Lexer struct(n I64) {
    n
    o own mut X& = X(n)
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn main() ? {
    t := Two()
    for i in range 300000 {
        c := t
        c.a = Lexer(7)                 # a borrowed copy's field given an owner: who releases it?
        c.b = Lexer(8)
    }
    println(t.a.o.text)
}
