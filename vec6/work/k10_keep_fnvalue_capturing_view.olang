type H struct() {
    f fn() I64 = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn keep(h mut H&, d Array<I64>&) { h.f = fn() I64 { return d[0] } }
fn main() ? {
    v := Vec<I64>()
    for i in range 3 { v.Push(i + 1) }
    h := H()
    d := v.View()
    keep(h, d)
    for i in range 100 { v.Push(i) }
    churn()
    println($h.f())
}
