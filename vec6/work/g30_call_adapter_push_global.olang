G mut Vec<I64> = Vec<I64>()
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type P struct() {
}
fn (p P&) Call() { for i in range 100 { G.Push(i) } }
fn run(f fn()) { f() }
fn main() ? {
    G.Push(1)
    d := G.View()
    run(P())
    churn()
    println($d[0])
}
