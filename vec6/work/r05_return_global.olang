fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
GV mut Vec<I64> = Vec<I64>()
fn mk() Vec<I64> { return GV }
fn main() ? {
    for i in range 3 { GV.Push(i + 1) }
    l := mk()
    for i in range 100 { GV.Push(i) }
    churn()
    println($l[0])
}
