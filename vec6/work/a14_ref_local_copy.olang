type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    p mut Two& = Two()
    for i in range 3 { p.a.toks.Push(i + 1) }
    c := p.a
    q := p
    for i in range 100 { q.a.toks.Push(i) }
    churn()
    println($c.toks[0])
}
