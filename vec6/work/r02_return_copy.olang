type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn mk() Lexer {
    l := Lexer(1)
    for i in range 3 { l.toks.Push(i + 1) }
    c := l
    return c
}
fn main() ? {
    l := mk()
    churn()
    println($l.toks[0])
}
