G mut Vec<I64> = Vec<I64>()
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type Q struct(k I64) {
    k
}
fn (q Q&) Str() String {
    for i in range 100 { G.Push(i) }
    return "q"
}
fn main() ? {
    G.Push(1)
    q := Q(1)
    d := G.View()
    s := $q
    churn()
    println($d[0] " " $s)
}
