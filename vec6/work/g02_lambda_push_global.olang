G mut Vec<I64> = Vec<I64>()
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    G.Push(1)
    f := fn() { for i in range 100 { G.Push(i) } }
    d := G.View()
    f()
    churn()
    println($d[0])
}
