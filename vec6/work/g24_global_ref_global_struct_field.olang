type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
GT mut Two = Two()
fn main() ? {
    r mut Lexer& = GT.a
    for i in range 100 { r.toks.Push(i) }
    GT.a = Lexer(5)
    churn()
    println($GT.a.n " " $r.n)
}
