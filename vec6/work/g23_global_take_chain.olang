type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn mk() Vec<I64> {
    v := Vec<I64>()
    for i in range 5 { v.Push(i + 1) }
    return v
}
G1 mut Vec<I64> = mk()
G2 mut Vec<I64> = take G1
fn main() ? {
    for i in range 100 { G2.Push(i) }
    G1.Push(9)
    churn()
    println($G2[0] " " $G2[104] " " $G1.Len())
}
