GV mut Vec<I64> = Vec<I64>()
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn reader() I64 {
    s := 0
    for x in GV { s += x }
    return s
}
fn main() ? {
    for i in range 10 { GV.Push(i) }
    r := 0
    join {
        spawn r = reader()
        for i in range 1000 { GV.Push(i) }
    }
    println($r)
}
