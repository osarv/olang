type Q struct(n I64 = 3) {
    n
    t String& = "q" $n "-built-text"
}
type B struct() {
    data own mut Array<Q>& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn mk(bb mut B&) {
    bb.data = Array<Q>(3)
}
fn main() ? {
    bb := B()
    mk(bb)
    churn()
    println(bb.data[1].t)
}
