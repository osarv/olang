type Lex3 struct() {
    toks Vec<String&> = Vec<String&>()
}
type H struct() {
    lx own mut Lex3& = null
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn move2(h mut H&, g mut H&) { g.lx.toks = take h.lx.toks }
fn main() ? {
    h := H()
    g := H()
    h.lx = Lex3()
    g.lx = Lex3()
    for i in range 3 { h.lx.toks.Push($i "-built-into-h-region") }
    move2(h, g)
    h.lx = null
    churn()
    println(g.lx.toks[0])
}
