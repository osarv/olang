fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn keep(m mut Map<I64, Array<I64>&>&, d Array<I64>&) { m.Put(1, d) }
fn main() ? {
    v := Vec<I64>()
    for i in range 3 { v.Push(i + 1) }
    m := Map<I64, Array<I64>&>()
    d := v.View()
    keep(m, d)
    for i in range 100 { v.Push(i) }
    churn()
    println($(try m.Get(1))[0])
}
