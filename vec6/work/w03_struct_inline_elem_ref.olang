type Cell struct() {
    xs Array<I64, 4> = Array<I64, 4>()
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    v := Vec<Cell>()
    v.Push(Cell())
    r Cell& = v.View()[0]
    for i in range 100 { v.Push(Cell()) }
    churn()
    println($r.xs[0])
}
