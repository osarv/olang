type Two struct() {
    a Vec<I64> = Vec<I64>()
    b Vec<I64> = Vec<I64>()
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    t := Two()
    for i in range 3 { t.a.Push(i + 1)
        t.b.Push(i + 10) }
    d := t.a.View()
    m := take t.b
    for i in range 100 { m.Push(i) }
    churn()
    println($d[0] " " $m[0])
}
