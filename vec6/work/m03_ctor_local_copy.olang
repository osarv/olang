type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type Peek struct(t Two&) {
    n I64 = 0
    c := t.a
    n = c.toks[0]
}
fn main() ? {
    t := Two()
    for i in range 3 { t.a.toks.Push(i + 1) }
    p := Peek(t)
    for i in range 100 { t.a.toks.Push(i) }
    churn()
    println($p.n " " $t.a.toks[99])
}
