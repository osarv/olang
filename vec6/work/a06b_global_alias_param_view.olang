type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
GL mut Lexer = Lexer(1)
fn bump() { for i in range 100 { GL.toks.Push(i) } }
fn f(l Lexer&) {
    d := l.toks.View()
    bump()
    churn()
    println($d[0])
}
fn main() ? {
    for i in range 3 { GL.toks.Push(i + 1) }
    f(GL)
}
