type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn look(t Two&) I64 {
    c := t
    d := c.a
    return d.toks[0]
}
fn main() ? {
    t := Two()
    for i in range 3 { t.a.toks.Push(i + 1) }
    s := 0
    for k in range 100 { s += look(t) }
    for i in range 100 { t.a.toks.Push(i) }
    churn()
    println($s " " $t.a.toks[99])
}
