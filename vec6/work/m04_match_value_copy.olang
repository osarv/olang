type Lexer struct(n I64) {
    n
    toks Vec<I64> = Vec<I64>()
}
type Two struct() {
    a Lexer = Lexer(1)
    b Lexer = Lexer(2)
}
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    t := Two()
    for i in range 3 { t.a.toks.Push(i + 1) }
    for k in range 3 {
        c := t.a if k > 1 else t.b
        println($c.n)
    }
    for i in range 100 { t.a.toks.Push(i) }
    churn()
    println($t.a.toks[99])
}
