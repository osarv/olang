## a small, standalone module imported (unnamed - see the report) by worker.olang, and re-exported from
## there since worker's own alias for it ("Base", derived from this file's own name) is capitalized. Used
## from runner.olang, two hops away ("wk.Base.Whatever"), to exercise transitive re-export end to end -
## see the tests in runner.olang.

BaseCount mut int32 = 0

## constructor-bearing, to exercise a re-exported type constructed via an ordinary CALL (which supports an
## alias chain of any length the same way any other call target does).
type BaseThing struct(id int32) {
    id
}

## plain (no constructor) - to exercise a re-exported type constructed via a "{ }" LITERAL specifically,
## through a chain. This used to be a real, deliberate boundary: the parser's own type-name-awareness
## (nameIsKnownType/isKnownTypeForParsing), which disambiguates "Type{" from an ordinary expression while
## parsing, only ever recognized a single alias hop, so "wk.Base.BasePoint{1, 2}" fell through to a plain
## parse error rather than being treated as a literal at all. Closed by generalizing that same mechanism to
## walk a chain of any length (TypeNameLookup's own interface changed from one flat alias string to a
## struct list of them) - see the report.
type BasePoint struct {
    x int32,
    y int32
}

error BaseError {
    BROKEN
}

func BumpBase() ? int32 {
    BaseCount = BaseCount + 1
    return BaseCount
}

func AlwaysBaseBroken() BaseError {
    error BaseError.BROKEN
}
