import "std/io"

error E {
    BAD
}

fn halves(x F16, y BF16) (F16, BF16, U64) ? E {
    if x > F16(100.0) { error E.BAD }
    return x * F16(2.0), y + BF16(1.0), 5
}

fn apply(f fn(a F16, b BF16) (F16, BF16, U64) ? E, x F16) (F16, BF16, U64) ? E {
    return try f(x, BF16(3.0))
}

fn direct(x F16) (F16, BF16, U64) ? E {
    return try halves(x, BF16(3.0))
}

fn main() ? io.IoError + E {
    a, b, c := try apply(halves, F16(0.25))
    d, e, f := try direct(F16(0.25))
    try io.Print($a " " $b " " $c " | " $d " " $e " " $f "\n")
}
