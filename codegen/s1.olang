import "std/io"

type Node struct(v I64) {
    v
}

fn mkNode(v I64) Node& {
    return Node(v)
}

fn churn() I64 {
    t I64 = 0
    for i in range 10 {
        b := Array<I64>(16, 99)
        t = t + b[0]
    }
    return t
}

fn main() ? io.IoError {
    r Node& = null
    join {
        spawn r = mkNode(5)
    }
    k := churn()
    try io.Print($r.v " " $k "\n")
}
