import "std/io"

type Node struct(v I64) {
    v
}

GA mut Node& = null
GB mut Node& = null
BadA mut I64 = 0
BadB mut I64 = 0

fn workA(n I64) {
    for i in range n {
        GA = Node(i)
        x := GA.v
        if x != i { BadA = BadA + 1 }
    }
}

fn workB(n I64) {
    for i in range n {
        GB = Node(i * 3 + 1)
        y := GB.v
        if y != i * 3 + 1 { BadB = BadB + 1 }
    }
}

fn main() ? io.IoError {
    join {
        spawn workA(2000000)
        spawn workB(2000000)
    }
    try io.Print($BadA " " $BadB "\n")
}
