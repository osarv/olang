import "std/io"

# F1: a reference to a Vec's element (Ref, RefMut, a unique element's x[i], a walk's name over unique elements) kept
# across a removal that empties the position (Truncate, Clear, RemoveAt, SwapRemove, Pop) is read after early freeing
# released what the element owned - segfault in a plain build (OLDER: fcdb202 crashes too). A Map's Ref kept across
# Remove is kept correctly ('r' is used here, after 'm.Remove(1)' ...).
fn vecText(n I64) I64 {
    ls := Vec<String>()
    other := Vec<String>()
    s := 0
    for k in range n {
        ls.Push($k "abcdefghijkl")
        r String& = ls.Ref(0)
        ls.Truncate(0)
        other.Push("zzzzzzzzzzzzzzzzzzzzzzzzzz" $k)
        other.Truncate(0)
        s += r.Len()
    }
    return s
}

fn main() {
    io.Println($vecText(1000))!
}
