import "std/io"

type N struct(v I64) {
    v
    next N?& = null
}

type Linker trait {
    Link(a mut N&, b N&)
}

type L1 struct() {
    k I64 = 0
}

fn (l L1&) Link(a mut N&, b N&) { a.next = b }

fn churn() I64 {
    t := 0
    for k in range 300 {
        s := $k "-" $(k * 7)
        a := Array<I64>(64, -7)
        t += s.Len() + a[3]
    }
    return t
}

fn use(k any Linker&, x mut N&) { k.Link(x, N(5)) }

fn main() {
    a := N(0)
    l := L1()
    use(l, a)
    churn()
    io.Println($a.next!.v)!
}
