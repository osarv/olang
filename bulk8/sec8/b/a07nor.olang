import "std/io"

type Lamp unique struct(id I64) {
    id
    open := true
    data := Array<I64>(4096, id)
} destruct {
    open = false
}

fn churn() I64 {
    t := 0
    for k in range 30 {
        a := Array<I64>(64, -7 - k)
        t += a[3]
    }
    return t
}

# a reference to a Vec's element kept while the Vec ends that element (Truncate), then read
fn kept(n I64) I64 {
    ls := Vec<Lamp>()
    s := 0
    for k in range n {
        ls.Push(Lamp(k + 1))
        r Lamp& = ls[0]
        ls.Truncate(0)
        churn()
        s += 1
    }
    return s
}

fn main() {
    io.Println($kept(20000))!
}
