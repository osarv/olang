import "std/io"

# R3b: the module's first raise of X (source order) is a's, with an I32: X's field should be I32, and b's raise of an
# I64 an error (it is, with the call to b taken out - scratch/r4.olang). a's body calls b before its own raise, so b's
# raise is met first and settles X as (v I64): the program compiles. No cycle is needed (HISTORY says only a cycle).
fn a(n I32) I64 ? {
    if n > 5: return try b(I64(n) - 1)
    error X(v = n)
}

fn b(n I64) I64 ? {
    error X(v = n)
}

fn main() {
    r := try a(9) catch X e default e.v
    io.Println($r)!
}
