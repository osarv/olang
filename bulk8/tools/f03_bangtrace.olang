import "std/io"
type PE error { Bad(n I64) }
Live mut I64 = 0
fn raise(n I64) I64 ? PE {
    error PE.Bad(n)
}
fn twice(x I64) [x >= 0] I64 ? {
    return x * 2
}
fn main() {
    if Live == 0 {
        y := twice(Live - 1)!
        io.Println($y)!
    }
    x := raise(Live + 3)!
    io.Println($x)!
}
