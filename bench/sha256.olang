# sha256: the digest of n MB of generated bytes, taken r times - std/sha256's compression loop on U32 arithmetic
import "std/io"
import "std/os"
import "std/sha256"
import "std/hex"

fn main() ? {
    args := os.Args()
    mb I64 = 16
    rounds I64 = 4
    if args.Len() > 2 {
        mb = try args[1].ParseInt()
        rounds = try args[2].ParseInt()
    }
    data := Array<U8>(mb * 1048576)
    x U32 = 1
    for i in range data.Len() {
        x = x * 1664525 + 1013904223
        data[i] = U8(x >> 24)
    }
    d := sha256.Sum(data)
    for r in range 1, rounds { d = sha256.Sum(data) }
    try io.Println(hex.Encode(d))
}
