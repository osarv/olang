# dispatch: n pseudo-random shapes - squares, rectangles and triangles - summed over and over by area, three ways:
# through "any Shape&" (a call through each instance's table, T32b), through an enum matched case by case (the closed,
# static form), and as one concrete type called directly (only squares: the baseline). The C version is a struct with a
# function-pointer table, a tagged union with a switch, and a plain struct, the same three ways.
import "std/io"
import "std/os"

error Usage {
    ARGS
    MODE
}

type Shape trait {
    Area() I64
}

type Sq struct(s I64) { s }
fn (q Sq&) Area() I64 { return q.s * q.s }

type Rect struct(w I64, h I64) { w, h }
fn (r Rect&) Area() I64 { return r.w * r.h }

type Tri struct(b I64, h I64) { b, h }
fn (t Tri&) Area() I64 { return t.b * t.h / 2 }

type Fig enum {
    S(s I64)
    R(w I64, h I64)
    T(b I64, h I64)
}

fn area(f Fig&) I64 {
    return match f {
        case Fig.S(s) => s * s
        case Fig.R(w, h) => w * h
        case Fig.T(b, h) => b * h / 2
    }
}

fn main() ? {
    args := os.Args()
    if args.Len() < 4 { error Usage.ARGS }
    mode := args[1]
    n := try args[2].ParseInt()
    passes := try args[3].ParseInt()
    s I64 = 1
    total I64 = 0
    if mode == "any" {
        xs := List<any Shape&>()
        for i in range n {
            s = s * 6364136223846793005 + 1442695040888963407
            k := (s >> 33) % 3
            a := (s >> 40) % 100 + 1
            b := (s >> 50) % 100 + 1
            if k == 0 { xs.Push(Sq(a)) } else if k == 1 { xs.Push(Rect(a, b)) } else { xs.Push(Tri(a, b)) }
        }
        all := xs.ToArray()
        for p in range passes {
            for x in all { total += x.Area() ^ p }
        }
    } else if mode == "enum" {
        xs := List<Fig>()
        for i in range n {
            s = s * 6364136223846793005 + 1442695040888963407
            k := (s >> 33) % 3
            a := (s >> 40) % 100 + 1
            b := (s >> 50) % 100 + 1
            if k == 0 { xs.Push(Fig.S(a)) } else if k == 1 { xs.Push(Fig.R(a, b)) } else { xs.Push(Fig.T(a, b)) }
        }
        all := xs.ToArray()
        for p in range passes {
            for x in all { total += area(x) ^ p }
        }
    } else if mode == "direct" {
        xs := List<Sq>()
        for i in range n {
            s = s * 6364136223846793005 + 1442695040888963407
            xs.Push(Sq((s >> 40) % 100 + 1))
        }
        all := xs.ToArray()
        for p in range passes {
            for x in all { total += x.Area() ^ p }
        }
    } else {
        error Usage.MODE
    }
    try io.Print($total "\n")
}
