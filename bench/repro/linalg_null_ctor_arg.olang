# null passed for a constructor's reference parameter - here one the constructor never stores - makes a function that
# returns a new instance look as if its result referred to that function's own storage: "return copyOf(id.Data)",
# with id a local, is error[O26], though copyOf returns a Box it built itself. Passing a temporary array instead of
# null compiles, and so does a copyOf with no reference parameter. In std/linalg this hit every function returning a
# new matrix computed from a local's operands ("return x + x"); the workaround there is a reference local built in the
# result scope (out Matrix<T>&return = Matrix<T>(r, c, null), then return out).
type Box struct(n I64, data mut Array<I64>& = null) {
    Data mut Array<I64>& = Array<I64>(n)
    assert data == null
}

fn copyOf(b Array<I64>&) Box {
    return Box(5, null)
}

fn twice() Box {
    id := Box(2, null)
    return copyOf(id.Data)
}

fn main() ? {
    t := twice()
    assert t.Data.Len() == 5
}
