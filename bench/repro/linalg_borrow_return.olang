# a value built in the result scope (&return) cannot be passed to a mut receiver whose type has a mut reference
# field: error[O10d] at the call - the value's storage is the block, its references the result scope, and the receiver
# needs one scope for both (O25g asks exactness because Data could be reassigned through it). With a read-only
# receiver (fn (b Box&) fill) it compiles, and still writes the elements - shallow permission (T25b).
type Box struct(n I64) {
    Data mut Array<I64>& = Array<I64>(n)
}
fn (b mut Box&) fill(v I64) {
    for i in range b.Data.Len() { b.Data[i] = v }
}
fn make(n I64) Box {
    b := Box&return(n)
    b.fill(7)
    return b
}
fn main() ? {
    b := make(3)
    assert b.Data[2] == 7
}
