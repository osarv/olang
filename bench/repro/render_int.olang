# FIXED (E11a): "$n" on an integer formatted it twice - the generated helper (olang.rd.I64) was called once to measure
# (snprintf with a null buffer) and once to write, two snprintf calls (about 80ns each here) where C's code makes one:
# 5,000,000 renderings took 0.79s, C with one snprintf each 0.42s. The runtime now counts the digits from ctlz and
# writes them two at a time from a table (__olang_fmt_u64/__olang_fmt_i64), so measuring is a few compares and no
# snprintf is called: 0.09s.
# See it: build, then  grep -n "__olang_fmt_i64\|snprintf" build/render_int.main.ll
import "std/io"
import "std/os"

fn main() ? {
    args := os.Args()
    n := try args[1].ParseInt()
    total I64 = 0
    for i in range n {
        s := $(i * 7919 % 1000003)
        total += s.Len()
    }
    try io.Print($total "\n")
}
