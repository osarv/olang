# an immutable global whose value was computed while compiling (K2) is emitted as a mutable LLVM global
# ("@...Tile = global i64 12"), not a constant, so the per-module optimizer cannot read its value: std/linalg's GEMM
# micro-kernels, with their 4 x 12 tile bounded by named constants, were neither fully unrolled nor kept their 48
# accumulators in registers before the link - 10.8 against 17.5 GFLOPS with the literals written in (LTO's globalopt
# folds the value later, too late for the kernel's shape). The micro-kernels use literals. See the emitted IR:
# grep Tile build/linalg_global_constant.main.ll
Tile I64 = 12

fn main() ? {
    acc := Array<F32>(Tile)
    for i in range Tile { acc[i] = F32(i) }
    assert acc[Tile - 1] == 11.0
}
