
# ---- T22d: functions a constructor fixes in a field, followed with the instance (docs/fnvalues.md round 12) ----
#
# A field no body assigns after construction (fieldsAssigned), which its constructor gives one parameter's value, holds
# that value for the instance's life. An instance's record - by field, the records of a fixed field holding a function
# value, and the record of a fixed field holding an instance by value - is made by its constructor call, carried by a
# local declared once and never assigned whole, by a call's result (ResInst, as ResFn is) and, in a twin, by a followed
# parameter; a read of a fixed field of an instance whose record is known carries the field's records (addRecs), and an
# argument whose instance carries records some field's type does not cover is followed into its callee (twinFor)

# an instance's record: by field, a fixed function field's records (none known: not Full) and the record of the
# instance a fixed field holds by value (-1 none) - nodes of a tree
type instNode struct(Ty types.TypeId) {
    Ty
    Fields Vec<fnRecs>
    Kids Vec<I64>
}

type instTree struct() {
    Nodes Vec<instNode>
}

# a record followed into a twin with an instance: the field's path, the function (its body) in key order, the field's
# records where the value was made (their captures the caller's terms), and the field's type
type followItem struct(Path String, Key fnRec, Field fnRecs, Ty types.TypeId) {
    Path
    Key
    Field
    Ty
}

InstDepth I64 = 4   # instances followed through fixed fields at most this deep (15, decision 5)

# the struct an instance of type t is, through a reference; Unknown for none
fn (s mut Scoper&) instStruct(t types.TypeId) types.TypeId {
    x := s.P.T.Repr(s.P.T.Referent(t) if s.isRef(t) else t)
    return x if s.isStruct(x) else types.UnknownT
}

# whether field i of struct r is fixed: no body assigns it after construction, nor a whole instance through a reference
fn (s mut Scoper&) fixedField(r types.TypeId, i I64) Bool {
    ri := I64(s.P.T.Repr(r))
    return not s.fieldsAssigned.Has(pair.Pair(ri, i)) and not s.fieldsAssigned.Has(pair.Pair(ri, I64(-1)))
}

# whether an instance of type t may carry records: its struct has a fixed field holding a function value, or one holding
# such an instance by value
fn (s mut Scoper&) instType(t types.TypeId) Bool { return s.instTypeAt(s.instStruct(t), 0) }

fn (s mut Scoper&) instTypeAt(r types.TypeId, depth I64) Bool {
    if r == types.UnknownT or depth >= InstDepth: return false
    if s.instTypes.Has(r): return try s.instTypes.Get(r) catch default false
    s.instTypes.Put(r, false)
    fs := s.P.T.Items(s.P.T.Fields(r))
    out := false
    for i in range fs.Len() {
        if not s.fixedField(r, i): continue
        if s.isFunc(fs[i]) or not s.isRef(fs[i]) and s.instTypeAt(s.instStruct(fs[i]), depth + 1): out = true
    }
    s.instTypes.Put(r, out)
    return out
}

# the parameter of struct r's constructor whose value its field i is given whole, -1 for none (another value, or the
# field assigned again in the constructor)
fn (s mut Scoper&) ctorFieldParam(r types.TypeId, i I64) I64 {
    cb := try s.ctorOf.Get(r) catch default -1
    if cb < 0 or cb >= s.Bodies.Len(): return -1
    body := s.Bodies[cb]
    if i >= body.Fields.Len() or body.Root is null: return -1
    f := body.Fields[i]
    k := -1
    for st in body.Root!.Stmts {
        match st {
            case typed.Stmt.Let(_, id, x) { if id == f: k = s.paramRead(body, x) }
            case typed.Stmt.Assign(_, typed.Lvalue.Local(_, _, id), _) { if id == f: return -1 }
            case _ { }
        }
    }
    return k
}

fn (s mut Scoper&) paramRead(body typed.Body&, x typed.Expr&) I64 {
    match s.unAway(x) {
        case typed.Expr.Read(_, _, typed.Lvalue.Local(_, _, id), _), typed.Expr.Take(_, _, typed.Lvalue.Local(_, _, id)) { return paramPos(body, id) }
        case _ { return -1 }
    }
}

# a new node of tree tr for an instance of struct type r with n fields, each unknown
fn newNode(tr mut instTree&, r types.TypeId, n I64) I64 {
    nd := instNode(r)
    for _ in range n {
        nd.Fields.Push(fnRecs())
        nd.Kids.Push(-1)
    }
    tr.Nodes.Push(nd)
    return tr.Nodes.Len() - 1
}

# a constructor call's instance (of type ty): its fixed fields given its arguments' records - a generator's walk not
# among them (D18's rules judge it) - recorded by the call's site
fn (s mut Scoper&) ctorInst(c typed.Call&, ty types.TypeId) {
    r := s.instStruct(ty)
    if r == types.UnknownT or not s.instType(r): return
    fs := s.P.T.Items(s.P.T.Fields(r))
    n := newNode(s.itree, r, fs.Len())
    some := false
    for i in range fs.Len() {
        k := s.ctorFieldParam(r, i) if s.fixedField(r, i) else -1
        if k < 0 or k >= c.Args.Len(): continue
        if s.isFunc(fs[i]) {
            rs := s.recsOf(c.Args[k])
            if not rs.Full or rs.Recs.Len() == 0 or s.anyGen(rs): continue
            s.itree.Nodes[n].Fields[i] = rs
            some = true
        } else if not s.isRef(fs[i]) {
            kid := s.instOf(c.Args[k])
            s.itree.Nodes[n].Kids[i] = kid
            if kid >= 0: some = true
        }
    }
    if some: s.siteInst.Put(I64(c.Site), n)
}

# the record of the instance value x is, in this judging: a call's, a local's, a fixed field's; -1 where not known
fn (s mut Scoper&) instOf(x typed.Expr?&) I64 {
    if x is null: return -1
    y := s.unPromoted(s.unAway(x))
    c := typed.Call.Of(y)
    if c is not null: return try s.siteInst.Get(I64(c.Site)) catch default -1
    match y {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p), typed.Expr.Take(_, _, p) { return s.placeInst(p) }
        case _ { return -1 }
    }
}

fn (s mut Scoper&) placeInst(p typed.Lvalue&) I64 {
    match p {
        case typed.Lvalue.Local(_, _, id) {
            l := I64(id)
            if not s.localInst.Has(l) or s.assignedWhole(l): return -1
            return try s.localInst.Get(l) catch default -1
        }
        case typed.Lvalue.Deref(_, _, r) { return s.instOf(r) }
        case typed.Lvalue.Field(_, _, b, i) {
            if not s.fixedField(s.instStruct(b.Type()), i): return -1
            n := s.placeInst(b)
            return s.itree.Nodes[n].Kids[i] if n >= 0 and i < s.itree.Nodes[n].Kids.Len() else -1
        }
        case _ { return -1 }
    }
}

# the records a read of a fixed field carries (addRecs), into out - not Full where its instance's are not known
fn (s mut Scoper&) fieldRecs(out mut fnRecs&, p typed.Lvalue&) {
    match p {
        case typed.Lvalue.Field(_, _, b, i) {
            if s.fixedField(s.instStruct(b.Type()), i) {
                n := s.placeInst(b)
                if n >= 0 and i < s.itree.Nodes[n].Fields.Len() and s.itree.Nodes[n].Fields[i].Recs.Len() > 0 {
                    mergeRecs(out, s.itree.Nodes[n].Fields[i])
                    return
                }
            }
        }
        case _ { }
    }
    out.Full = false
}

# a local declared with value x: the record of the instance it holds or refers to, for its reads
fn (s mut Scoper&) noteInst(l I64, x typed.Expr?&) {
    if x is null or not s.instType(s.B!.Locals[l].Ty): return
    n := s.instOf(x)
    if n >= 0: s.localInst.Put(l, n)
}

# a return's instance merged into what the body's returns give (ResInst): one not known, none
fn (s mut Scoper&) retInst(x typed.Expr&) {
    n := s.instOf(x)
    if n < 0 {
        s.resInstOk = false
        return
    }
    if s.resInst.Nodes.Len() == 0 {
        copyNode(s.itree, n, s.resInst)
        return
    }
    t := instTree()
    copyNode(s.itree, n, t)
    out := instTree()
    mergeNode(s.resInst, 0, t, 0, out)
    s.resInst = out
}

# node n of from copied into into (its kids after it), its index there
fn copyNode(from instTree&, n I64, into mut instTree&) I64 {
    nd := from.Nodes[n]
    at := newNode(into, nd.Ty, nd.Fields.Len())
    for i in range nd.Fields.Len() {
        into.Nodes[at].Fields[i] = nd.Fields[i]
        if nd.Kids[i] >= 0 { into.Nodes[at].Kids[i] = copyNode(from, nd.Kids[i], into) }
    }
    return at
}

# nodes a of ta and b of tb merged into out: each field's records both's, a kid where both have one
fn mergeNode(ta instTree&, a I64, tb instTree&, b I64, out mut instTree&) I64 {
    na := ta.Nodes[a]
    nb := tb.Nodes[b]
    at := newNode(out, na.Ty, na.Fields.Len())
    for i in range na.Fields.Len() {
        if i >= nb.Fields.Len(): break
        f := na.Fields[i]
        mergeRecs(f, nb.Fields[i])
        out.Nodes[at].Fields[i] = f if na.Fields[i].Recs.Len() > 0 and nb.Fields[i].Recs.Len() > 0 else fnRecs()
        if na.Kids[i] >= 0 and nb.Kids[i] >= 0 { out.Nodes[at].Kids[i] = mergeNode(ta, na.Kids[i], tb, nb.Kids[i], out) }
    }
    return at
}

# a callee's ResInst through call c (beta its bindings): each record's captures the caller's terms - its node here
fn (s mut Scoper&) importInst(from instTree&, n I64, c typed.Call&, beta Array<Term>&) I64 {
    nd := from.Nodes[n]
    at := newNode(s.itree, nd.Ty, nd.Fields.Len())
    id := Array<I64>(beta.Len())
    for k in range id.Len() { id[k] = k }
    for i in range nd.Fields.Len() {
        if nd.Fields[i].Recs.Len() > 0 {
            out := fnRecs()
            out.Full = true
            s.transRecs(out, nd.Fields[i], c, id, false, beta)
            s.itree.Nodes[at].Fields[i] = out
        }
        if nd.Kids[i] >= 0 { s.itree.Nodes[at].Kids[i] = s.importInst(from, nd.Kids[i], c, beta) }
    }
    return at
}

# T22c with an instance: the records argument a's instance (node n) carries, depth first by field, each field's functions
# in key order - followed where every one is known and judged, and some do what their field's type does not say
fn (s mut Scoper&) followItems(n I64, path String&, depth I64, out mut Vec<followItem>&) {
    nd := s.itree.Nodes[n]
    for i in range nd.Fields.Len() {
        p := $path "." $i
        if nd.Fields[i].Full and nd.Fields[i].Recs.Len() > 0 {
            ft := s.P.T.Items(s.P.T.Fields(nd.Ty))[i]
            for r in sortedRecs(nd.Fields[i].Recs) { out.Push(followItem(p, r, nd.Fields[i], ft)) }
        }
        if nd.Kids[i] >= 0 and depth + 1 < InstDepth { s.followItems(nd.Kids[i], p, depth + 1, out) }
    }
}

fn (s mut Scoper&) instFollowable(items Vec<followItem>&) Bool {
    if items.Len() == 0: return false
    seen Map<I64, Bool>
    some := false
    for it in items {
        b := it.Key.Body
        if b < 0 or b >= s.sums.Len() or not s.sums[b].Done or s.sums[b].Judging or s.Bodies[b].Gen: return false
        if not some and s.uncovered(b, it.Key.Adapter, it.Ty, seen) >= 0: some = true
    }
    return some
}

# the twin's seed for parameter p: the instance's tree with each followed record's captures derived scopes of p, by
# its place in items (capCode)
fn (s mut Scoper&) seedInstOf(n I64, p I64, items Vec<followItem>&) instTree {
    tr := instTree()
    s.seedRi = 0
    s.seedNode(n, p, tr, 0)
    return tr
}

fn (s mut Scoper&) seedNode(n I64, p I64, tr mut instTree&, depth I64) I64 {
    nd := s.itree.Nodes[n]
    at := newNode(tr, nd.Ty, nd.Fields.Len())
    for i in range nd.Fields.Len() {
        if nd.Fields[i].Full and nd.Fields[i].Recs.Len() > 0 {
            out := fnRecs()
            out.Full = true
            for r in sortedRecs(nd.Fields[i].Recs) {
                b := s.Bodies[r.Body]
                caps Vec<Term>
                for k in range b.Vars.Len() { caps.Push(Term.Derived(p, capCode(s.seedRi, k)) if capVarOf(b, k, r.Adapter) else Term.None) }
                out.Recs.Push(fnRec(r.Body, caps, r.Adapter))
                s.seedRi++
            }
            tr.Nodes[at].Fields[i] = out
        }
        if nd.Kids[i] >= 0 and depth + 1 < InstDepth { tr.Nodes[at].Kids[i] = s.seedNode(nd.Kids[i], p, tr, depth + 1) }
    }
    return at
}

# whether any of a value's functions is a generator's walk (D18's rules judge those)
fn (s mut Scoper&) anyGen(rs fnRecs&) Bool {
    for r in rs.Recs {
        if s.Bodies[r.Body].Gen: return true
    }
    return false
}

# ---- T22d at boundaries ----

# T22a: an instance value x reaching a place code judged once for many values reads (a store, an argument not followed,
# an "any", a task, a return no caller follows ...): every function a fixed field of it may hold, read structurally
# (bndTree), judged by its field's type - else the error, at the value
fn (s mut Scoper&) bndInst(x typed.Expr&, place I64) {
    tr := instTree()
    s.bndSeen.Clear()
    n := s.bndTree(x, tr, 0)
    if n >= 0: s.bndJudge(x, tr, n, place, 0)
}

fn (s mut Scoper&) bndJudge(x typed.Expr&, tr instTree&, n I64, place I64, depth I64) Bool {
    nd := tr.Nodes[n]
    fs := s.P.T.Items(s.P.T.Fields(nd.Ty))
    seen Map<I64, Bool>
    for i in range nd.Fields.Len() {
        for r in nd.Fields[i].Recs {
            bad := s.uncovered(r.Body, r.Adapter, fs[i], seen)
            if bad < 0 { continue }
            s.bndError(x, bad, bad == r.Body and r.Adapter, place)
            return true
        }
        if nd.Kids[i] >= 0 and depth < InstDepth and s.bndJudge(x, tr, nd.Kids[i], place, depth + 1): return true
    }
    return false
}

# the instance value x may be, every way it may come (bndDefs: every value a local is given), into tr: its node, -1 for
# none known - functions without where their captures lived (bndRecs)
fn (s mut Scoper&) bndTree(x typed.Expr?&, tr mut instTree&, depth I64) I64 {
    if x is null or depth > 16: return -1
    match x {
        case typed.Expr.Away(_, _, y) { return s.bndTree(y, tr, depth + 1) }
        case typed.Expr.Promote(_, _, pr) { return s.bndTree(pr.X, tr, depth + 1) }
        case typed.Expr.Read(_, _, p, _), typed.Expr.Take(_, _, p), typed.Expr.Borrow(_, _, p) { return s.bndPlaceTree(p, tr, depth) }
        case typed.Expr.Cond(_, _, c) { return s.bndMerge(tr, s.bndTree(c.A, tr, depth + 1), s.bndTree(c.B, tr, depth + 1)) }
        case typed.Expr.Match(_, _, m) {
            n := -1
            for a in m.Arms { n = s.bndMerge(tr, n, s.bndTree(a.Value, tr, depth + 1)) }
            return n
        }
        case typed.Expr.Call(_, ty, c) { return s.bndCallTree(c, ty, tr, depth) }
        case _ { return -1 }
    }
}

fn (s mut Scoper&) bndCallTree(c typed.Call&, ty types.TypeId, tr mut instTree&, depth I64) I64 {
    b := s.bodyOf(c.Target)
    if b < 0 or b >= s.sums.Len(): return -1
    if s.Bodies[b].Of != typed.BodyOf.Ctor {
        tw := s.plan.Twin(c.Site)
        ri := s.Twins.Sums[tw].ResInst if tw >= 0 else s.sums[b].ResInst
        return copyNode(ri, 0, tr) if ri.Nodes.Len() > 0 else -1
    }
    r := s.instStruct(ty)
    if r == types.UnknownT or not s.instType(r): return -1
    fs := s.P.T.Items(s.P.T.Fields(r))
    n := newNode(tr, r, fs.Len())
    for i in range fs.Len() {
        k := s.ctorFieldParam(r, i) if s.fixedField(r, i) else -1
        if k < 0 or k >= c.Args.Len(): continue
        if s.isFunc(fs[i]) {
            rs Vec<fnRec>
            s.bndRecs(c.Args[k], rs)
            out := fnRecs()
            out.Full = true
            for x in rs { addRec(out, x) }
            tr.Nodes[n].Fields[i] = out
        } else if not s.isRef(fs[i]) {
            kid := s.bndTree(c.Args[k], tr, depth + 1)
            tr.Nodes[n].Kids[i] = kid
        }
    }
    return n
}

fn (s mut Scoper&) bndPlaceTree(p typed.Lvalue&, tr mut instTree&, depth I64) I64 {
    match p {
        case typed.Lvalue.Local(_, _, id) {
            l := I64(id)
            if s.Id == s.seedBody and s.seedInst.Has(l) {
                st := try s.seedInst.Get(l) catch default instTree()
                return copyNode(st, 0, tr) if st.Nodes.Len() > 0 else -1
            }
            if s.bndSeen.Has(l): return -1
            s.bndSeen.Put(l, true)
            n := -1
            ds := try s.bndDefs.Ref(l) catch default Vec<typed.Expr&>()
            for d in ds { n = s.bndMerge(tr, n, s.bndTree(d, tr, depth + 1)) }
            return n
        }
        case typed.Lvalue.Deref(_, _, r) { return s.bndTree(r, tr, depth + 1) }
        case typed.Lvalue.Field(_, _, b, i) {
            if not s.fixedField(s.instStruct(b.Type()), i): return -1
            n := s.bndPlaceTree(b, tr, depth + 1)
            return tr.Nodes[n].Kids[i] if n >= 0 and i < tr.Nodes[n].Kids.Len() else -1
        }
        case _ { return -1 }
    }
}

# nodes a and b of tr as one (both's records, a kid where both have one), -1 where either is none known
fn (s mut Scoper&) bndMerge(tr mut instTree&, a I64, b I64) I64 {
    if a < 0: return b
    if b < 0: return a
    t := tr
    return mergeNode(t, a, t, b, tr)
}

# bndRecs of a read of a fixed field: the functions its instance's field may hold
fn (s mut Scoper&) bndFieldRecs(p typed.Lvalue&, out mut Vec<fnRec>&) {
    match p {
        case typed.Lvalue.Field(_, _, b, i) {
            if not s.fixedField(s.instStruct(b.Type()), i): return
            tr := instTree()
            n := s.bndPlaceTree(b, tr, 0)
            if n < 0 or i >= tr.Nodes[n].Fields.Len(): return
            for r in tr.Nodes[n].Fields[i].Recs { out.Push(fnRec(r.Body, Vec<Term>(), r.Adapter)) }
        }
        case _ { }
    }
}

# the arguments of constructor call c that give a fixed field its value (bits by argument): followed where its instance
# is (the place it reaches BndNone)
fn (s mut Scoper&) ctorFixedArgs(c typed.Call&, ty types.TypeId) I64 {
    b := s.bodyOf(c.Target)
    if b < 0 or s.Bodies[b].Of != typed.BodyOf.Ctor: return 0
    r := s.instStruct(ty)
    if r == types.UnknownT or not s.instType(r): return 0
    fs := s.P.T.Items(s.P.T.Fields(r))
    mask I64 = 0
    for i in range fs.Len() {
        if not s.fixedField(r, i) or not (s.isFunc(fs[i]) or not s.isRef(fs[i]) and s.instType(fs[i])): continue
        k := s.ctorFieldParam(r, i)
        if k >= 0 and k < 62: mask = mask | (1 << k)
    }
    return mask
}

# a judging begun: no instance known yet but a twin's followed parameters'; whether its returns' instances are carried
# (one result an instance that may carry records, no cycle, no generator - D18's rules judge a walk)
fn (s mut Scoper&) instStart() {
    s.itree = instTree()
    s.siteInst.Clear()
    s.localInst.Clear()
    s.instFollow.Clear()
    s.resInst = instTree()
    ty := s.B!.Ty
    s.resInstOk = false
    if s.cyclic or s.B!.Gen or s.genBody(s.Id) or s.P.T.KindOf(ty) != types.Kind.Func: return
    if s.P.T.Results(ty).Len() == 1 and s.instType(s.P.T.Result(ty)): s.resInstOk = true
    if s.Id != s.seedBody: return
    for l in s.seedInst.Keys() {
        tr := try s.seedInst.Get(l) catch default instTree()
        if tr.Nodes.Len() > 0 { s.localInst.Put(l, copyNode(tr, 0, s.itree)) }
    }
}

# whether body b assigns its local l whole after its declaration
fn (s mut Scoper&) assignsWhole(b I64, l I64) Bool {
    if b + 1 >= s.assignedFrom.Len(): return true
    for k in range s.assignedFrom[b], s.assignedFrom[b + 1] {
        if s.assignedTo[k] == l: return true
    }
    return false
}
