type N struct(v I64) { v }

fn keepSome(xs Array<N&>&, kept mut Vec<N&>&) I64 {
    t I64 = 0
    for x in xs.Iter().TakeWhile(fn(x) {
        kept.Push(x)
        return x.v < 3
    }) { t += x.v }
    return t
}

fn main() {
    a := Array<N&>[N(1), N(2), N(3), N(4)]
    kept Vec<N&>
    assert keepSome(a, kept) == 3
    assert kept.Len() == 3
}
