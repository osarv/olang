type Node struct(v I64) {
    v
    next mut Node& = null
}
type Res struct(n mut Node&, k I64) {
    n
    k
} destruct {
    n.next = Node(k)
}
fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn churn() I64 {
    s I64 = 0
    for j in range 50 {
        t := Node(j)
        u := Node(j + 1)
        s = s + t.v + u.v
    }
    return s
}
fn main() ? {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    fa := fn(i I64) {
        r Res&a = Res(a, i)
    }
    fb := fn(i I64) {
        r Res&b = Res(b, i)
    }
    c mut Node& = Node(0)
    join {
        spawn work(fa, 3)
        spawn work(fb, 3)
        for i in range 3 { c.next = Node(i) }
    }
    x := churn()
    println($a.next.v " " $b.next.v " " $c.next.v " " $x)
}
