type Node struct(v I64) {
    v
    next mut Node& = null
    f fn(i I64) = null
}
fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn work2(n mut Node&, k I64) {
    for i in range k { n.f(i) }
}
fn main() ? {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    mk := fn(i I64) {
        a.f = fn(j I64) { a.next = a.next if j < 0 else Node(j + i) }
    }
    mkb := fn(i I64) {
        b.f = fn(j I64) { b.next = Node(j + i) }
    }
    c mut Node& = Node(0)
    join {
        spawn mk(1)
        spawn mkb(2)
    }
    join {
        spawn work2(a, 300000)
        spawn work2(b, 300000)
        for i in range 300000 { c.next = Node(i) }
    }
    println($a.next.v " " $b.next.v " " $c.next.v)
}
