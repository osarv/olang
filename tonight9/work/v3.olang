type Node struct(v I64) {
    v
    next mut Node& = null
}
fn mk(n mut Node&, k I64) Node {
    r := Node(k)
    r.next = n
    return r
}
fn keep(a mut Node&, n mut Node&a) { a.next = n }
fn churn() I64 {
    s I64 = 0
    for j in range 50 {
        t := Node(j)
        u := Node(j + 1)
        s = s + t.v + u.v
    }
    return s
}
fn main() ? {
    a mut Node& = Node(0)
    for i in range 3 {
        loc mut Node& = Node(100 + i)
        x := a.next if i < 0 else mk(loc, i)
        a.next = x
    }
    y := churn()
    for i in range 3 {
        loc mut Node& = Node(200 + i)
        keep(a, a.next if i < 0 else mk(loc, i))
    }
    z := churn()
    for i in range 3 {
        loc mut Node& = Node(300 + i)
        a.next = match i { case -1 => a.next nomatch => mk(loc, i) }
    }
    println($a.next.v " " $a.next.next.v " " $y " " $z)
}
