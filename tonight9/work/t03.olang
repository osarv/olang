type Node struct(v I64) {
    v
    next mut Node& = null
    s String& = ""
    arr Array<I64>& = null
    l List<I64> = List<I64>()
}

fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn main() ? {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    fa := fn(i I64) {
        a.arr = I64[x * i for x in range 3]
    }
    fb := fn(i I64) {
        b.arr = I64[x * i for x in range 3]
    }
    c mut Node& = Node(0)
    join {
        spawn work(fa, 200000)
        spawn work(fb, 200000)
        for i in range 200000 { c.next = Node(i) }
    }
    println($a.v " " $b.v " " $c.next.v " " $a.s " " $b.s " " $a.l.Len())
}
