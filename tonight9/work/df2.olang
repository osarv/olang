type Node struct(v I64) {
    v
    next mut Node& = null
}
fn pk(n mut Node&, m mut Node&n = Node(7)) mut Node&n { return m }
fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn main() ? {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    fa := fn(i I64) { a.next = pk(a) }
    fb := fn(i I64) { b.next = pk(b) }
    c mut Node& = Node(0)
    join {
        spawn work(fa, 300000)
        spawn work(fb, 300000)
        for i in range 300000 { c.next = Node(i) }
    }
    println($a.next.v " " $b.next.v " " $c.next.v)
}
