type Node struct(v I64) {
    v
    next mut Node& = null
}
type Setter struct(n mut Node&) {
    n
}
fn (s Setter&) Call(i I64) {
    s.n.next = s.n.next if i < 0 else Node(i)
}
fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn apply(f fn(i I64), i I64) {
    f(i)
}
fn main() ? {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    sa Setter& = Setter(a)
    sb Setter& = Setter(b)
    fa := fn(i I64) { apply(sa, i) }
    fb := fn(i I64) { apply(sb, i) }
    c mut Node& = Node(0)
    join {
        spawn work(fa, 300000)
        spawn work(fb, 300000)
        for i in range 300000 { c.next = Node(i) }
    }
    println($a.next.v " " $b.next.v " " $c.next.v)
}
