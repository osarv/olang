type Node struct(v I64) {
    v
    next mut Node& = null
}
type H struct(p mut Node&) {
    n mut Node&p = p
}
fn one(h mut H&, i I64) {
    h.n.next = Node(i)
}
fn two(h mut H&, i I64) {
    k I64 = 0
    h.n.next, k = Node(i), i
}
fn main() ? {
    a mut Node& = Node(0)
    h mut H& = H(a)
    one(h, 3)
    two(h, 4)
    println($a.next.v)
}
