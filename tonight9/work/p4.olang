type Node struct(v I64) {
    v
    next mut Node& = null
}
type Hold struct(n mut Node&) {
    n
}
fn churn() I64 {
    s I64 = 0
    for j in range 50 {
        t := Node(j)
        s = s + t.v
    }
    return s
}
fn fill(h Hold, i I64) {
    k I64 = 0
    h.n.next, k = Node(i), i
}
fn main() ? {
    head mut Node& = Node(0)
    cur := head
    for i in range 4 {
        cur, cur.next = cur, Node(i + 1)
        cur = cur.next
    }
    x := churn()
    h := Hold(Node(50))
    for i in range 3 {
        k I64 = 0
        h.n.next, k = Node(i + 60), i
        fill(h, 70 + i)
    }
    y := churn()
    s I64 = 0
    p := head
    for p != null {
        s = s + p.v
        p = p.next
    }
    println($s " " $h.n.next.v " " $x " " $y)
}
