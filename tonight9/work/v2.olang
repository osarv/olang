type Node struct(v I64) {
    v
    next mut Node& = null
}
fn mk(n mut Node&, k I64) Node {
    r := Node(k)
    r.next = n
    return r
}
fn setp(n mut Node&, m mut Node&n) {
    n.next = m
}
fn pick(n mut Node&, m mut Node&n, c Bool) mut Node&n {
    return n if c else m
}
fn churn() I64 {
    s I64 = 0
    for j in range 50 {
        t := Node(j)
        u := Node(j + 1)
        s = s + t.v + u.v
    }
    return s
}
fn main() ? {
    a mut Node& = Node(0)
    for i in range 3 {
        loc mut Node& = Node(100 + i)
        setp(a, a.next if i < 0 else mk(a, i))
        b := pick(a, a.next if i < 0 else mk(a, 7 + i), false)
        a.next = b
    }
    x := churn()
    println($a.next.v " " $a.next.next.v " " $x)
}
