type Node struct(v I64) {
    v
    next mut Node& = null
}
fn mk(n mut Node&, k I64) Node {
    r := Node(k)
    r.next = n
    return r
}
fn churn() I64 {
    s mut I64 = 0
    for j in range 50 {
        t := Node(j)
        u := Node(j + 1)
        s = s + t.v + u.v
    }
    return s
}
fn main() ? {
    a mut Node& = Node(0)
    for i in range 3 {
        loc mut Node& = Node(100 + i)
        a.next = a.next if i < 0 else mk(loc, i)
    }
    x := churn()
    println($a.next.v " " $a.next.next.v " " $x)
}
