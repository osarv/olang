type Node struct(v I64) {
    v
    next mut Node& = null
}
fn find(n mut Node&) mut Node&n ? {
    if n.v >= 0 { error }
    return n
}
fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn main() ? {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    fa := fn(i I64) {
        x := try find(a) catch default Node(i)
        if x.v == -5 { println("never") }
    }
    fb := fn(i I64) {
        x := try find(b) catch default Node(i)
        if x.v == -5 { println("never") }
    }
    c mut Node& = Node(0)
    join {
        spawn work(fa, 2000)
        spawn work(fb, 2000)
        for i in range 2000 { c.next = Node(i) }
    }
    println($a.v " " $b.v " " $c.next.v)
}
