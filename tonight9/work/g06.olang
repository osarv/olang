type Node struct(v I64) {
    v
    next mut Node& = null
}
fn putd(n mut <T>&, k I64) { n.next = try find(n) catch default Node(k) }
fn find(n mut <T>&) mut T&n ? {
    if n.v >= 0 { error }
    return n
}
fn work(f fn(i I64), n I64) {
    for i in range n { f(i) }
}
fn main() ? {
    a mut Node& = Node(0)
    b mut Node& = Node(0)
    fa := fn(i I64) { putd(a, i) }
    fb := fn(i I64) { putd(b, i) }
    c mut Node& = Node(0)
    join {
        spawn work(fa, 300000)
        spawn work(fb, 300000)
        for i in range 300000 { c.next = Node(i) }
    }
    println($a.next.v " " $b.next.v " " $c.next.v)
}
