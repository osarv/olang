type Node struct(v I64) {
    v mut
    next mut Node& = null
}
fn find(l List<mut Node&>&, i I64) mut Node&l ? {
    if i >= l.Len() { error }
    return l[i]
}
fn bump(l mut List<mut Node&>&, i I64) ? {
    n := try find(l, i) catch { error }
    n.v++
}
fn main() ? {
    l := List<mut Node&>()
    l.Push(Node(5))
    try bump(l, 0)
    assert l[0].v == 6
}
