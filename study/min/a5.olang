type Bag struct(n I64) {
    n
}
type Tree enum {
    Leaf(n I64)
    Node(b Bag&)
}
fn main() ? {
    l := List<Tree&>()
    l.Push(Tree.Leaf(1))
    s I64 = 0
    for k in l {
        match k {
            case Tree.Leaf(n) { s += n }
            nomatch { s += 100 }
        }
    }
    assert s == 1
}
