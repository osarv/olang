type G struct() {
    adj mut List<mut List<I32>&>& = List<mut List<I32>&>()
}
fn (g G&) walk(src I32) I64 {
    queue := List<I32>()
    queue.Push(src)
    v I32 = queue[0]
    out := g.adj[src]
    return out.Len()
}
fn main() ? {
    g := G()
    g.adj.Push(List<I32>())
    assert g.walk(0) == 0
}
