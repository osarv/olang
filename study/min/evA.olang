type G struct() {
    adj mut List<mut List<I32>&>& = List<mut List<I32>&>()
}
fn (g G&) walk(src I32) I64 {
    n I64 = 0
    head I64 = 0
    for head < 1 {
        head++
        out := g.adj[src]
        n += out.Len()
    }
    return n
}
fn main() ? {
    g := G()
    g.adj.Push(List<I32>())
    assert g.walk(0) == 0
}
