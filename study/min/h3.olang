type WC struct(word String&, count I64) {
    word
    count
}
fn swap(a mut Array<WC>&, i I64, j I64) {
    a[i], a[j] = a[j], a[i]
}
fn main() ? {
    a := Array<WC>(2)
    a[0] = WC("b", 2)
    a[1] = WC("a", 5)
    swap(a, 0, 1)
    assert a[0].word == "a"
    b := Array<WC>(2)
    b[0] = WC("b", 2)
    b[1] = WC("a", 5)
    t := b[0]
    b[0] = b[1]
    b[1] = t
    assert b[0].word == "a"
}
