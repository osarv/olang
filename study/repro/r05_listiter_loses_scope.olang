# for-in over a List of values holding references loses where the references live: returning one is rejected,
# where the indexed loop is accepted (same root as 04: the local in ListIter.Next)
type Item struct(n I64) {
    n
}
fn find(l List<Pair<String&, Item&>>&, key String&) Item&l ? {
    for f in l {
        if f.First == key { return f.Second }
    }
    error
}
fn main() ? {
    l := List<Pair<String&, Item&>>()
    k String& = "x"
    l.Push(Pair<String&, Item&>(k, Item(4)))
    assert (try find(l, "x")).n == 4
}
