# Fold with a reference accumulator fails inside the prelude; with "" as init, U binds to String by value (D9a error)
fn main() ? {
    words := List<String&>()
    words.Push("ab")
    words.Push("abcd")
    empty String& = ""
    longest := words.Iter().Fold(empty, fn(best, w) { return w if w.Len() > best.Len() else best })
    assert longest == "abcd"
}
