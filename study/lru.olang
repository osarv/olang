# A generic LRU cache: a Map from key to node, and a doubly linked list of nodes in recency order. Evicted
# nodes are recycled, since nothing is freed before the cache's own scope closes.
import "std/io"
import "std/map"

type lruNode<K, V> struct(key <K>, value <V>) {
    key mut
    value mut
    prev mut lruNode<<K>, <V>>& = null
    next mut lruNode<<K>, <V>>& = null
}

type LRU<K Hashable<<K>>, V> struct(cap I64) {
    cap
    index mut map.Map<<K>, mut lruNode<<K>, <V>>&>& = map.Map<<K>, mut lruNode<<K>, <V>>&>()
    head mut lruNode<<K>, <V>>& = null        # most recently used
    tail mut lruNode<<K>, <V>>& = null        # least recently used
    spare mut lruNode<<K>, <V>>& = null       # an evicted node, kept for reuse
    hits mut I64 = 0
    misses mut I64 = 0
    evictions mut I64 = 0
}

fn (c mut LRU<<K>, <V>>&) unlink(n mut lruNode<<K>, <V>>&c) {
    if n.prev == null { c.head = n.next } else { n.prev.next = n.next }
    if n.next == null { c.tail = n.prev } else { n.next.prev = n.prev }
    n.prev = null
    n.next = null
}

fn (c mut LRU<<K>, <V>>&) pushFront(n mut lruNode<<K>, <V>>&c) {
    n.next = c.head
    n.prev = null
    if c.head != null { c.head.prev = n }
    c.head = n
    if c.tail == null { c.tail = n }
}

# the value under key, which becomes the most recently used - failing when it is not cached
fn (c mut LRU<<K>, <V>>&) Get(key <K>) <V> ? {
    # (not "try ... catch { c.misses++ error }": a catch block here is rejected, see min/f15.olang)
    n := try c.index.Get(key) catch default null
    if n == null {
        c.misses++
        error
    }
    c.hits++
    c.unlink(n)
    c.pushFront(n)
    return n.value
}

fn (c mut LRU<<K>, <V>>&) Put(key <K>, value <V>) {
    if key in c.index {
        n := try c.index.Get(key) catch default null
        n.value = value
        c.unlink(n)
        c.pushFront(n)
        return
    }
    if c.index.Len() >= c.cap {
        old := c.tail
        c.unlink(old)
        c.index.Remove(old.key)
        c.evictions++
        c.spare = old
    }
    n lruNode<<K>, <V>>&c = null
    if c.spare != null {
        n = c.spare
        c.spare = null
        n.key = key
        n.value = value
    } else {
        n = lruNode<<K>, <V>>(key, value)
    }
    c.pushFront(n)
    c.index.Put(key, n)
}

fn (c LRU<<K>, <V>>&) Len() I64 { return c.index.Len() }

# the keys from most to least recently used
fn (c LRU<<K>, <V>>&) Keys() List<<K>>& {
    out List<<K>>&return = List<<K>>()
    for n lruNode<<K>, <V>>&c = c.head, n != null, n = n.next {
        out.Push(n.key)
    }
    return out
}

fn churn() I64 {
    t I64 = 0
    for i in range 4000 {
        a := Array<I64>(16, I64(i))
        s := $a[0] "x"
        t += a[3] + s.Len()
    }
    return t
}

fn main() ? io.IoError {
    c := LRU<I64, String&>(3)
    c.Put(1, "one")
    c.Put(2, "two")
    c.Put(3, "three")
    try io.Print("keys " $c.Keys().ToArray() "\n")
    v := try c.Get(1) catch default "?"
    try io.Print("get 1 = " $v ", keys " $c.Keys().ToArray() "\n")
    c.Put(4, "four")                                        # evicts 2
    try io.Print("after put 4: " $c.Keys().ToArray() ", has 2: " $(2 in c.index) "\n")
    churn()
    w := try c.Get(2) catch default "missing"
    try io.Print("get 2 = " $w "\n")
    c.Put(3, "THREE")
    try io.Print("get 3 = " $(try c.Get(3) catch default "?") "\n")

    # text keys built on the fly, many more than fit
    words := LRU<String&, I64>(100)
    for i in range 100000 {
        k String&words = "w" $(i % 250)
        n := try words.Get(k) catch default 0
        words.Put(k, n + 1)
    }
    churn()
    total I64 = 0
    for k in words.Keys() { total += try words.Get(k) catch default 0 }
    try io.Print("words: " $words.Len() " cached, hits " $words.hits " misses " $words.misses " evictions " $words.evictions " total " $total "\n")
}
