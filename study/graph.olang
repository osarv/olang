# A weighted directed graph read from text, with BFS (hop counts), Dijkstra (shortest weighted paths) over a
# generic binary heap, and path reconstruction.
import "std/io"
import "std/map"

type Edge struct(to I32, w I64) {
    to
    w
}

type Graph struct() {
    names mut List<String&>& = List<String&>()
    ids mut map.Map<String&, I32>& = map.Map<String&, I32>()
    adj mut List<mut List<Edge>&>& = List<mut List<Edge>&>()
}

error GraphError {
    BAD_LINE
    BAD_WEIGHT
    NO_SUCH_NODE
}

# the id of the node called name, adding it when it is new
fn (g mut Graph&) node(name String&) I32 {
    id := try g.ids.Get(name) catch default -1
    if id >= 0 { return id }
    id = I32(g.names.Len())
    g.names.Push(name)
    g.ids.Put(name, id)
    g.adj.Push(List<Edge>())
    return id
}

fn (g mut Graph&) addEdge(from String&, to String&, w I64) {
    a := g.node(from)
    b := g.node(to)
    out := g.adj[a]        # (not "g.adj[a].Push(...)": rejected, see min/e1.olang)
    out.Push(Edge(b, w))
}

fn (g Graph&) size() I32 { return I32(g.names.Len()) }

fn parseGraph(text String&) Graph& ? GraphError {
    g Graph&return = Graph()
    for line in text.Split("\n") {
        t := line.Trim()
        if t.Len() == 0 or t[0] == '#' { continue }
        parts := t.Split(" ")
        if parts.Len() != 3 { error GraphError.BAD_LINE }
        w := try parts[2].ParseInt() catch { error GraphError.BAD_WEIGHT }
        g.addEdge(parts[0], parts[1], w)
    }
    return g
}

# a binary min-heap of anything "<" orders
type Heap<T> struct() {
    items mut Array<<T>>& = Array<<T>>(8)
    n mut I64 = 0
}

fn (h mut Heap<<T>>&) Push(x <T>) {
    if h.n == h.items.Len() {
        bigger Array<<T>>&h = Array<<T>>(h.n * 2)
        for i in range h.n { bigger[i] = h.items[i] }
        h.items = bigger
    }
    h.items[h.n] = x
    i := h.n
    h.n++
    for i > 0 {
        parent I64 = (i - 1) / 2
        if not (h.items[i] < h.items[parent]) { break }
        h.items[i], h.items[parent] = h.items[parent], h.items[i]
        i = parent
    }
}

error Empty {
    HEAP
}

fn (h mut Heap<<T>>&) Pop() <T> ? Empty {
    if h.n == 0 { error Empty.HEAP }
    top := h.items[0]
    h.n--
    h.items[0] = h.items[h.n]
    i I64 = 0
    for {
        l I64 = 2 * i + 1
        r I64 = l + 1
        m I64 = i
        if l < h.n and h.items[l] < h.items[m] { m = l }
        if r < h.n and h.items[r] < h.items[m] { m = r }
        if m == i { break }
        h.items[i], h.items[m] = h.items[m], h.items[i]
        i = m
    }
    return top
}

fn (h Heap<<T>>&) Len() I64 { return h.n }

type QItem struct(dist I64, node I32) {
    dist
    node
}
fn (a QItem) Less(b QItem) Bool { return a.dist < b.dist or (a.dist == b.dist and a.node < b.node) }

Infinity I64 = 9223372036854775807

# shortest distances from src, and each node's predecessor on a shortest path (-1 for none)
fn (g Graph&) dijkstra(src I32) (Array<I64>, Array<I32>) {
    dist := Array<I64>(g.size(), Infinity)
    prev := Array<I32>(g.size(), -1)
    dist[src] = 0
    q := Heap<QItem>()
    q.Push(QItem(0, src))
    for q.Len() > 0 {
        cur := try q.Pop() catch { unreachable }
        if cur.dist > dist[cur.node] { continue }
        out := g.adj[cur.node]
        for e in out {
            nd I64 = cur.dist + e.w
            if nd < dist[e.to] {
                dist[e.to] = nd
                prev[e.to] = cur.node
                q.Push(QItem(nd, e.to))
            }
        }
    }
    return dist, prev
}

# hop counts from src by breadth-first search, -1 where unreachable
fn (g Graph&) bfs(src I32) Array<I32> {
    hops := Array<I32>(g.size(), -1)
    hops[src] = 0
    queue := List<I32>()
    queue.Push(src)
    head I64 = 0
    for head < queue.Len() {
        v := queue[head]
        head++
        out := g.adj[I32(v)]        # (plain "g.adj[v]" is rejected: v came from queue[head], see min/e12.olang)
        for e in out {
            if hops[e.to] < 0 {
                hops[e.to] = hops[v] + 1
                queue.Push(e.to)
            }
        }
    }
    return hops
}

fn (g Graph&) pathTo(prev Array<I32>&, target I32) String& {
    steps := List<String&>()
    for at I32 = target, at >= 0, at = prev[at] {
        steps.Push(g.names[at])
    }
    b := StringBuilder()
    for i in range steps.Len() {
        if i > 0 { b.Push(" -> ") }
        b.Push(steps[steps.Len() - 1 - i])
    }
    return b.ToString()
}

fn churn() I64 {
    t I64 = 0
    for i in range 5000 {
        a := Array<I64>(32, I64(i))
        t += a[7]
    }
    return t
}

fn main() ? GraphError + io.IoError {
    text := "# city roads\nams ber 6\nams par 5\npar ber 2\nber war 5\npar mad 10\nmad war 20\nwar mos 12\nber mos 25\nlis mad 6\n"
    g := try parseGraph(text)
    churn()
    src := try g.ids.Get("ams") catch { error GraphError.NO_SUCH_NODE }
    dist, prev := g.dijkstra(src)
    hops := g.bfs(src)
    for i in range g.size() {
        name := g.names[i]
        if dist[i] == Infinity {
            try io.Print($name ": unreachable (hops " $hops[i] ")\n")
        } else {
            try io.Print($name ": " $dist[i] " via " $g.pathTo(prev, I32(i)) " (hops " $hops[i] ")\n")
        }
    }
    # a bigger random graph, as a stress test of the heap
    big := Graph()
    seed I64 = 12345
    for i in range 2000 {
        seed = (seed * 6364136223846793005 + 1442695040888963407)
        a I64 = ((seed >> 33) & 2147483647) % 500
        seed = (seed * 6364136223846793005 + 1442695040888963407)
        b I64 = ((seed >> 33) & 2147483647) % 500
        big.addEdge("n" $a, "n" $b, ((seed >> 40) & 2147483647) % 100 + 1)
    }
    d2, p2 := big.dijkstra(0)
    reach := d2.Count(fn(d I64) Bool { return d != Infinity })
    total := d2.Fold(I64(0), fn(acc I64, d I64) I64 { return acc + d if d != Infinity else acc })
    try io.Print("big: " $big.size() " nodes, " $reach " reachable, total distance " $total "\n")
}
