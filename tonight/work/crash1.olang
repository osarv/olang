import "std/os"
fn deep(n I64) I64 {
    if n == 0 { return 0 }
    a := Array<I64, 64>()
    a[n % 64] = n
    return a[3] + deep(n - 1) + 1
}
fn main() ? {
    os.OnCrash("CRASHED\n")
    mode := os.Args()[1] if os.Args().Len() > 1 else ""
    if mode == "main" { println($deep(100000000)) }
    if mode == "task" {
        join { spawn fn() { println($deep(100000000)) } }
    }
    if mode == "stack" {
        os.RunOnStack(1 << 20, fn() { println($deep(100000000)) })
    }
    if mode == "assert" { assert mode.Len() == 0 }
}
