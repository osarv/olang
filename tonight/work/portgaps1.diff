+        "  br i1 %%none, label %%done, label %%make\n"
+        "make:\n"
+        "  %%mem = call ptr @malloc(i64 65536)\n"
+        "  %%got = icmp ne ptr %%mem, null\n"
+        "  br i1 %%got, label %%set, label %%done\n"
