+    for (size_t i = 0; i < sizeof(sigs) / sizeof(sigs[0]); i++) {
+        fprintf(out, "  %%s%zu = call i32 @sigaction(i32 %d, ptr %%sa, ptr null)\n", i, sigs[i]);
+    }
+    fputs("  ret void\n}\n\n", out);
+}
