+        "  %t16 = trunc i64 %raw to i16\n"
+        "  %e16 = sext i16 %t16 to i64\n"
+        "  ret i64 %e16\n"
+        "s32:\n"
+        "  %t32 = trunc i64 %raw to i32\n"
+        "  %e32 = sext i32 %t32 to i64\n"
+        "  ret i64 %e32\n"
