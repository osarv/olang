import "std/os"
type N struct(v I64) {
    v
    next mut N& = null
}
type Box struct(n mut N&) { n }
fn churn() I64 {
    s I64 = 0
    for i in range 3000 {
        a := Array<I64>(64, I64(i))
        s = s + a[3]
    }
    return s
}
fn main() ? {
    root mut N& = N(1)
    if os.Args().Len() > 0 {
        bx Box&root = Box(root)
        bx.n.next = N(9)
    }
    c := churn()
    println("expected 9, got " $root.next.v)
}
