# call cycle: two mutually recursive callees; one captures the split value's parameter in an escaping lambda
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { abort }
    }
}
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() {
    head mut Node& = Node(4)
}
fn idBox(seed mut Box&) Box { return seed }
fn even(b Box&, n I64, out mut List<fn() I64>&) {
    if n == 0 { out.Push(fn() I64 { return b.head.v }) }
    else { odd(b, n - 1, out) }
}
fn odd(b Box&, n I64, out mut List<fn() I64>&) { even(b, n - 1, out) }
fn main() ? {
    seed := Box()
    fs := List<fn() I64>()
    for i in range 3 {
        even(idBox(seed), 2, fs)
        churn()
    }
    churn()
    t := 0
    for f in fs { t = t + f() }
    assert t == 12, $t
}
