# U1 round-4 regression: a call's value result holding a mut reference, lent to a reference parameter the callee
# captures in a lambda it RETURNS (escaping). The split-value copy lives in the loop block, but its scope var is bound
# where its references live (seed, in main), so the escaping-lambda lifetime check passes. The lambda holds the
# block-local copy -> use after the loop block closes. -b segfaults, -s reports, -i keeps it alive and prints 21.
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { abort }
    }
}
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() {
    head mut Node& = Node(7)
    tag I64 = 0
}
fn idBox(seed mut Box&) Box { return seed }
fn leak(b Box&) fn() I64 { return fn() I64 { return b.head.v } }
fn main() ? {
    seed := Box()
    fs := List<fn() I64>()
    for i in range 3 {
        fs.Push(leak(idBox(seed)))
        churn()
    }
    churn()
    t := 0
    for f in fs { t = t + f() }
    assert t == 21, $t
}
