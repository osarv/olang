import "std/io"
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { abort }
    }
}
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() {
    head mut Node& = null
    tag I64 = 0
}
G mut Node& = Node(100)
# returns a Box VALUE whose head points at the GLOBAL node G. result scope lands wherever caller puts it.
fn gbox() Box {
    b := Box()
    b.head = G
    return b
}
# callee reads b.head (global) and builds a node hung off it - where does that node land?
fn grow(b Box&, v I64) { b.head.next = Node(v) }
fn main() ? {
    for i in range 3 {
        grow(gbox(), i + 1)
        churn()
    }
    churn()
    n := 0
    for x := G, x != null, x = x.next { n = n * 10 + x.v }
    try io.Println($n)
}
