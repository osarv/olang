fn churn() {
    for k in range 2000 {
        a := Array<I64>(256, k * 1000 + 7)
        if a[0] == 3 { abort }
    }
}
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() {
    head mut Node& = Node(0)
    tag I64 = 0
}
fn idBox(seed mut Box&) Box { return seed }
fn leak(b Box&) fn() I64 { return fn() I64 { return b.head.v } }
fn main() ? {
    seed := Box()
    seed.head.v = 9
    fs := List<fn() I64>()
    for i in range 50 {
        fs.Push(leak(idBox(seed)))
        churn()
    }
    churn()
    t := 0
    for f in fs { t = t + f() }
    assert t == 450, $t
}
