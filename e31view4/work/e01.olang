import "std/io"
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { abort }
    }
}
fn main() ? {
    kept := List<Array<I64>&>()
    for i in range 3 {
        a := Array<Array<I64, 2>>(1)
        a[0][0] = i + 1
        a[0][1] = i + 10
        kept.Push((try a[0] catch default Array<I64, 2>())[0:2])
        churn()
    }
    churn()
    t := 0
    for s in kept { t = t + s[0] + s[1] }
    try io.Println($t)
}
