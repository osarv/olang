# split lend: a conditional of a place and a fresh Box(); callee reads b.head and pushes it into an outer list
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { abort }
    }
}
type Node struct(v I64, next mut Node&) {
    v
    next
}
type Box struct(v I64) {
    head mut Node& = Node(v, null)
    tag I64 = 0
}
fn collect(b Box&, out mut List<Node&>&) { out.Push(b.head) }
fn main() ? {
    b1 := Box(9)
    keep := List<Node&>()
    for i in range 3 {
        collect(b1 if i > 5 else Box(i + 1), keep)
        churn()
    }
    churn()
    t := 0
    for n in keep { t = t * 10 + n.v }
    assert t == 123, $t
}
