import "std/io"
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { abort }
    }
}
type Node struct(v I64) {
    v
    next mut Node& = null
}
type Box struct() {
    head mut Node& = Node(0)
    tag I64 = 0
}
fn idBox(seed mut Box&) Box { return seed }
# callee captures the copy b in a lambda and returns it (lambda outlives the call)
fn leak(b Box&) fn() I64 { return fn() I64 { return b.head.v } }
fn main() ? {
    seed := Box()
    fs := List<fn() I64>()
    for i in range 3 {
        fs.Push(leak(idBox(seed)))
        churn()
    }
    churn()
    t := 0
    for f in fs { t = t + f() }
    try io.Println($t)
}
