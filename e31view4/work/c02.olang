# built-in array is LOOP-LOCAL; callee keeps b.s (inner ref) into an outer list. default lands in element's (loop) scope.
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { abort }
    }
}
type Node struct(v I64, next mut Node&) {
    v
    next
}
type BagState struct() {
    head mut Node& = null
}
type Bag struct() {
    s mut BagState& = BagState()
}
fn (b Bag&) Sneak(v I64) { b.s.head = Node(v, b.s.head) }
fn (b Bag&) Keep(l mut List<mut BagState&>&) { l.Push(b.s) }
fn main() ? {
    kept := List<mut BagState&>()
    for i in range 3 {
        a := Array<Bag>(1, Bag())
        (try a[0] catch default Bag()).Sneak(i + 1)
        (try a[0] catch default Bag()).Keep(kept)
        churn()
    }
    churn()
    t := 0
    for st in kept { if st.head != null { t = t * 10 + st.head.v } }
    assert kept.Len() == 3, $kept.Len()
    println($t)
}
