type In struct() {
    k I64 = 0
}
type Mid struct() {
    inner In = In()
}
type Bag struct(m mut Mid&) {
    m
}
fn f(p mut In&, q mut In&, n I64) {
    if n > 0 { f(q, p, n - 1) }
    p.k++
}
fn g(p mut In&, q mut In&, n I64) {
    if n > 0 { h(q, p, n - 1) }
}
fn h(p mut In&, q mut In&, n I64) {
    if n > 0 { g(q, p, n - 1) }
    q.k++
}
fn (b Bag&) Str() String {
    loc := In()
    f(loc, b.m.inner, 1)
    return "b" $b.m.inner.k
}
type Bag2 struct(m mut Mid&) {
    m
}
fn (b Bag2&) Str() String {
    loc := In()
    g(b.m.inner, loc, 2)
    return "b" $b.m.inner.k
}
fn main() ? {
    b := Bag(Mid())
    println($b)
    b2 := Bag2(Mid())
    println($b2)
}
