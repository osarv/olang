type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
fn touch(c mut Cell&) I64 {
    c.v++
    return c.v
}
type Cur struct(of Bag&) {
    n I64 = touch(of.c)
}
fn (b Bag&) Str() String {
    cur := Cur(b)
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    println($b)
    println($b)
}
