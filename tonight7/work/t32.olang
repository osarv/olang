type Node struct() {
    k I64 = 0
    next mut Node& = null
}
type Bag struct(n mut Node&) {
    n
}
fn h(p mut Node&) {
    if p.next != null { p = p.next }
    p.k++
}
fn (b Bag&) Str() String {
    x Node = b.n
    h(x)
    return "b" $b.n.next.k
}
fn main() ? {
    nn mut Node& = Node()
    nn.next = Node()
    b := Bag(nn)
    println($b)
    println($b)
}
