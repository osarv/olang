type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
type Cur struct(of Bag&) {
    c mut Cell&of = of.c
}
type W struct(cur mut Cur&) {
    cur
}
fn poke(w mut W&) { w.cur.c.v++ }
fn (b Bag&) Str() String {
    w := W(Cur(b))
    poke(w)
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    println($b)
    println($b)
}
