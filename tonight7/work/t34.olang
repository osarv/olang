type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
fn touch(c mut Cell&) I64 {
    c.v++
    return c.v
}
fn deflt(c mut Cell&, n I64 = 3) I64 { return n }
fn (b Bag&) Str() String {
    n := touch(b.c) if false else 0
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    println($b)
    println($b)
}
