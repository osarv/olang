type Reg struct(m Map<String&, I64>, l List<I64>, a mut Array<I64>&) {
    m
    l
    a
}
fn (r Reg&) Str() String {
    it := r.l.Iter()
    v := it.ToList()
    return "x"
}
fn main() ? {
    m := Map<String&, I64>()
    m.Put("b", 1)
    l := List<I64>()
    l.Push(3)
    r := Reg(m, l, I64[3, 1, 2])
    println($r)
}
