type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
fn touch(c mut Cell&) I64 {
    c.v++
    return c.v
}
fn fail1(c mut Cell&) I64 ? {
    c.v++
    if c.v > 0 { error }
    return 1
}
fn (b Bag&) Str() String {
    k := b.c.v
    assert k >= 0, $touch(b.c)
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    println($b)
    println($b)
}
