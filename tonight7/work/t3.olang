type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
fn pokeboth(p mut Cell&, q mut Cell&) {
    p, q = q, p
    p.v++
}
fn (b Bag&) Str() String {
    mine := Cell()
    pokeboth(mine, b.c)
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    println($b)
    println($b)
}
