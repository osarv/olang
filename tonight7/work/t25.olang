type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
type Cur struct(of Bag&) {
    c mut Cell&of = of.c
}
fn mk(b Bag&) Cur { return Cur(b) }
fn (b Bag&) Str() String {
    k := b.c.v
    cur := Cur(b) if k >= 0 else mk(b)
    cur.c.v++
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    println($b)
    println($b)
}
