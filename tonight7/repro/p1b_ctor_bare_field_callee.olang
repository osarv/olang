type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
type Cur2 struct(c mut Cell&) {
    c
}
fn poke2(p mut Cur2&) { p.c.v++ }
fn (b Bag&) Str() String {
    cur := Cur2(b.c)
    poke2(cur)
    return "b" $b.c.v
}
fn render() String {
    b := Bag(Cell())
    t := $b
    return $t " " $b " v=" $b.c.v
}
Baked := render()
fn main() ? {
    println(Baked)
    println(render())
}
