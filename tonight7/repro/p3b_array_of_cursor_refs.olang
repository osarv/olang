type Cell struct() {
    v I64 = 0
}
type Bag struct(c mut Cell&) {
    c
}
type Cur struct(of Bag&) {
    c mut Cell&of = of.c
}
fn pokeA(a mut Array<mut Cur&>&) { a[0].c.v++ }
fn (b Bag&) Str() String {
    arr := Array<mut Cur&>(1, Cur(b))
    pokeA(arr)
    return "b" $b.c.v
}
fn main() ? {
    b := Bag(Cell())
    println($b)
    println($b)
}
