import "std/io"

type H struct() {
    X Array<I64>& = null
}
fn K(x Array<I64>&) H {
    h := H()
    defer { h.X = x }
    return h
}

fn get() H {
    d := Array<I64>(4, 9)
    r := K(d)
    return r
}

fn getloop() H {
    r H
    for i in range 3 {
        d := Array<I64>(4, 5 + i)
        r = K(d)
    }
    return r
}

fn main() {
    v := get()
    churn()
    io.Println($v.X[1])!
    v = getloop()
    churn()
    io.Println($v.X[1])!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        m := Map<I64, List<I64>>()
        m.Put(i, b)
        assert a[3] == i
    }
}
