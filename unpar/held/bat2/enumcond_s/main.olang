import "std/io"

type E enum {
    A(x Array<I64>&)
    N
}
fn K(x Array<I64>&) E {
    return E.A(x if x.Len() > 0 else Array<I64>(4))
}

fn get() E {
    d := Array<I64>(4, 9)
    r := K(d)
    return r
}

fn getloop() E {
    r E
    for i in range 3 {
        d := Array<I64>(4, 5 + i)
        r = K(d)
    }
    return r
}

fn main() {
    v := get()
    churn()
    io.Println($v)!
    v = getloop()
    churn()
    io.Println($v)!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        m := Map<I64, List<I64>>()
        m.Put(i, b)
        assert a[3] == i
    }
}
