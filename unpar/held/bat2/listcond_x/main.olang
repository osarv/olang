import "std/io"
import "lib"

fn get() List<Array<I64>&> {
    d := Array<I64>(4, 9)
    r := lib.K(d)
    return r
}

fn getloop() List<Array<I64>&> {
    r List<Array<I64>&>
    for i in range 3 {
        d := Array<I64>(4, 5 + i)
        r = lib.K(d)
    }
    return r
}

fn main() {
    v := get()
    churn()
    io.Println($v[0][1])!
    v = getloop()
    churn()
    io.Println($v[0][1])!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        m := Map<I64, List<I64>>()
        m.Put(i, b)
        assert a[3] == i
    }
}
