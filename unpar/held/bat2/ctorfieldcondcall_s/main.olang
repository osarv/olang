import "std/io"

fn tr(a Array<I64>&) Array<I64>&a { return a[0:2] }
type H struct(x Array<I64>&) {
    X Array<I64>& = (tr(x) if x.Len() > 0 else Array<I64>(2))
}
fn K(x Array<I64>&) H {
    return H(x)
}

fn get() H {
    d := Array<I64>(4, 9)
    r := K(d)
    return r
}

fn getloop() H {
    r H
    for i in range 3 {
        d := Array<I64>(4, 5 + i)
        r = K(d)
    }
    return r
}

fn main() {
    v := get()
    churn()
    io.Println($v.X[1])!
    v = getloop()
    churn()
    io.Println($v.X[1])!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        m := Map<I64, List<I64>>()
        m.Put(i, b)
        assert a[3] == i
    }
}
