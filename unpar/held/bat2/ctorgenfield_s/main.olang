import "std/io"

type H<T> struct(x T, n I64) {
    X T = x
    Y Array<T>& = (Array<T>(1, x) if n > 0 else Array<T>(0))
}
fn K(x Array<I64>&) H<Array<I64>&> {
    return H<Array<I64>&>(x, 1)
}

fn get() H<Array<I64>&> {
    d := Array<I64>(4, 9)
    r := K(d)
    return r
}

fn getloop() H<Array<I64>&> {
    r H<Array<I64>&>
    for i in range 3 {
        d := Array<I64>(4, 5 + i)
        r = K(d)
    }
    return r
}

fn main() {
    v := get()
    churn()
    io.Println($v.Y[0][1])!
    v = getloop()
    churn()
    io.Println($v.Y[0][1])!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        m := Map<I64, List<I64>>()
        m.Put(i, b)
        assert a[3] == i
    }
}
