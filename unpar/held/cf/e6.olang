import "std/io"

G Array<I64>& = Array<I64>(4, 99)

type M struct(n I64, data Array<I64>&) {
    n
    Data Array<I64>& = null
    Data = (data if n > 1 else Array<I64>(3))
}

fn main() {
    ms := List<M>()
    o := Array<I64>(4, 50)
    for i in range 3 {
        d := Array<I64>(4, i + 1)
        ms.Push(M(2, d))
    }
    churn()
    io.Println($ms[0].Data[1] " " $ms[2].Data[1])!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        assert a[3] == i
    }
}
