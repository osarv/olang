import "std/io"

type M struct(n I64, data Array<I64>&) {
    n
    F := fn() I64 { return data[1] }
}

fn mkf(a Array<I64>&) fn() I64 { return fn() I64 { return a[1] } }

fn main() {
    ms := List<M>()
    for i in range 3 {
        d := Array<I64>(4, i + 1)
        ms.Push(M(2, d))
    }
    churn()
    io.Println($ms[0].F() " " $ms[2].F())!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        assert a[3] == i
    }
}
