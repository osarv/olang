import "std/io"

type G<T> struct(n I64, data T, other T) {
    n
    Data T = (data if n > 0 else other)
}
type M struct(n I64, data Array<I64>&) {
    n
    In G<Array<I64>&> = G<Array<I64>&>(n, data, Array<I64>(3))
}

fn pick(a Array<I64>&, b Array<I64>&, c Bool) Array<I64>&a { return a }

fn main() {
    ms := List<M>()
    for i in range 3 {
        d := Array<I64>(4, i + 1)
        ms.Push(M(2, d))
    }
    churn()
    io.Println($ms[0].In.Data[1] " " $ms[2].In.Data[1])!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        assert a[3] == i
    }
}
