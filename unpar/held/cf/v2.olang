import "std/io"

G Array<I64>& = Array<I64>(4, 99)

type H struct(x Array<I64>&) {
    X Array<I64>& = x
}
type M struct(n I64, a H) {
    n
    In H = (a if n > 1 else H(Array<I64>(3)))
}

fn main() {
    ms := List<M>()
    o := Array<I64>(4, 50)
    for i in range 3 {
        d := Array<I64>(4, i + 1)
        ms.Push(M(2, H(d)))
    }
    churn()
    io.Println($ms[0].In.X[1] " " $ms[2].In.X[1])!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        assert a[3] == i
    }
}
