import "std/io"

G Array<I64>& = Array<I64>(4, 99)

type W struct(d Array<I64>&) {
    D Array<I64>&d = d
}
type M struct(n I64, w W) {
    n
    Data Array<I64>& = (w.D if n > 1 else Array<I64>(3))
}

fn main() {
    ms := List<M>()
    o := Array<I64>(4, 50)
    for i in range 3 {
        d := Array<I64>(4, i + 1)
        ms.Push(M(2, W(d)))
    }
    churn()
    io.Println($ms[0].Data[1] " " $ms[2].Data[1])!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        assert a[3] == i
    }
}
