import "std/io"

type E enum {
    A(x Array<I64>&)
    B
}
type M struct(n I64, data Array<I64>&) {
    n
    V E = (E.A(data) if n > 0 else E.B)
}

fn pick(a Array<I64>&, b Array<I64>&, c Bool) Array<I64>&a { return a }

fn main() {
    ms := List<M>()
    for i in range 3 {
        d := Array<I64>(4, i + 1)
        ms.Push(M(2, d))
    }
    churn()
    io.Println($ms[0].V " " $ms[2].V)!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        assert a[3] == i
    }
}
