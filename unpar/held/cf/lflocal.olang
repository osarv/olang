import "std/io"

type M struct(n I64) {
    n
}

fn mkf(a Array<I64>&) fn() I64 { return fn() I64 { return a[1] } }

fn main() {
    ms := List<M>()
    for i in range 3 {
        d := Array<I64>(4, i + 1)
        ms.Push(M(2))
        fs := List<fn() I64>()
        fs.Push(fn() I64 { return d[1] })
    }
    churn()
    io.Println($ms[0].n)!
}

fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        assert a[3] == i
    }
}
