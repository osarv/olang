import "std/io"
import "lib2"

fn f3() lib2.H {
    d := Array<I64>(4, 63)
    w1 := lib2.W(d)
    return lib2.RewrapR(w1)
}

fn main() {
    c := f3()
    churn()
    io.Println($c.X[0])!
}
fn churn() {
    for i in range 300 {
        a := Array<I64>(64, i)
        b := List<I64>()
        b.Push(a[3])
        m := Map<I64, List<I64>>()
        m.Put(i, b)
        assert a[3] == i
    }
}
