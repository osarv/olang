fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
type View struct(x Outer&) {
    x
}
fn (a Outer&) Two() (View&a, I64) { return View(a), 1 }
fn (a Outer&) One() View&a { return View(a) }
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v                        # a borrowed copy
    a, n := b.Two()               # a.x is b's storage, whose 'o' is a copy of v.o's pointer
    v.o = null                    # accepted: a's holder carries none of b's loans
    churn()
    println($a.x.o.k " " $a.x.o.deep.text)
}
