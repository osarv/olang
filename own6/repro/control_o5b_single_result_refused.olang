fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
type View struct(x Outer&) {
    x
}
fn (a Outer&) One() View&a { return View(a) }
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    b := v
    a := b.One()
    v.o = null                    # the single-result form: refused
    println($a.x.o.k)
}
