fn churn() I64 {
    t := 0
    for i in range 2000 {
        s := $i "abcdefghijklmnopqrstuvwxyz"
        t += s.Len()
    }
    return t
}
type Leaf struct(n I64) {
    n
    text String& = "leaf" $n
}
type Inner struct(k I64) {
    k
    deep own mut Leaf&
}
type Outer struct() {
    o own mut Inner&
}
type View struct(x Outer&) {
    x
}
fn (a Outer&) Two() (View&a, I64) { return View(a), 1 }
fn main() ? {
    v := Outer()
    v.o = Inner(1)
    v.o.deep = Leaf(5)
    b := v                        # a borrowed copy: its own pointers are copies of v's
    l := List<View>()
    a, n := b.Two()               # a.x is b's storage
    l.Push(a)                     # kept in a List: O38 should refuse it
    v.o = null                    # releases the Inner b.o still points to
    churn()
    println($l[0].x.o.k " " $l[0].x.o.deep.text)
}
