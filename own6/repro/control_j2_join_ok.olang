Made mut I64 = 0
Dropped mut I64 = 0
type Res struct(n I64) {
    n
    Made.AtomicAdd(1)
} destruct {
    Dropped.AtomicAdd(1)
}
type Hold struct() {
    r own mut Res&
}
error Bad {
    NO
}
fn fails(k I64) ? Bad {
    if k > 0 { error Bad.NO }
}
fn local(k I64) ? Bad {
    try join {
        x own mut Res& = Res(1)
        spawn try fails(k)
    }
}
fn localValue(k I64) ? Bad {
    try join {
        h := Hold()
        h.r = Res(2)
        spawn try fails(k)
    }
}
fn passed(k I64) I64 ? Bad {
    try join {
        spawn try fails(k)
        return eat(Res(5))           # the owner is handed to eat, which releases it
    }
    return 0
}
fn eat(r own mut Res&) I64 { return r.n }
fn main() ? {
    for i in range 3 {
        try local(1) catch Bad { }
        try localValue(1) catch Bad { }
        try passed(1) catch Bad { }
    }
    println("made " $Made.AtomicLoad() " dropped " $Dropped.AtomicLoad())
}
