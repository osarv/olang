K mut U128 = 1
B := $which(U128(1)) $which((U128(1) << 64) + 1) $which(U128.Max) $which(U128(18446744073709551615)) $swhich(I128(-1)) $swhich(-(I128(1) << 64) - 1) $w65(U65(1) << 64) $w65(U65(0))
