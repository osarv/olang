import "std/io"
fn which(x U128) I64 {
    return match x {
        case 18446744073709551617 => 1
        case 1 => 2
        case 340282366920938463463374607431768211455 => 3
        case 18446744073709551615 => 4
        case _ => 0
    }
}
fn swhich(x I128) I64 {
    return match x {
