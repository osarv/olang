import "std/io"
G mut Array<I64> = Array<I64>(4, 1)
fn grow() I64 {
    G = Array<I64>(8, 7)
    return 1
}
fn churn() I64 {
    t I64 = 0
    for i in range 100 {
        x := Array<I64>(4, i)
        t += x[1]
    }
    return t
}
fn main() {
    G += grow()
    churn()
    io.Println($G)!
    H := Array<I64>(4, 2)
}
