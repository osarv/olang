# sha256 - the SHA-256 digest (FIPS 180-4): 32 bytes that change unpredictably with every bit of what they are taken
# of, for checking that data arrived whole, naming content by what it holds, keying a cache. Sum takes the digest of
# bytes held whole, Hex writes it as text; a Hasher takes one of bytes given a piece at a time. Ordinary olang - U32
# arithmetic wrapping as SHA-256's does (E6c) - so a digest of data known while compiling is computed there.
# Imported with `import "std/sha256"`. (SHA-256 is not a password hash: it is fast by design.)

import "hex"

# the first 32 bits of the fractional parts of the cube roots of the first 64 primes
k Array<U32> = U32[0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

fn rotr(x U32, n U32) U32 { return (x >> n) | (x << (32 - n)) }

# the digest of bytes given a piece at a time: "h := sha256.Hasher()", then "h.Push(piece)" for each piece, then
# "h.Sum()" - the same digest Sum gives of the pieces joined. A copy of a Hasher is a hasher of its own, as it stands
type Hasher struct() {
    state := U32[0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    buf := Array<U8>(64)
    used I64 = 0                                   # bytes in buf
    total I64 = 0                                  # bytes pushed in all
}

# one 64-byte block of data, from byte at, folded into the state
fn (h mut Hasher&) block(data Array<U8>&, at I64) {
    w := Array<U32>(64)
    for i in range 16 {
        j := at + 4 * i
        w[i] = (U32(data[j]) << 24) | (U32(data[j + 1]) << 16) | (U32(data[j + 2]) << 8) | U32(data[j + 3])
    }
    for i in range 16, 64 {
        s0 := rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
        s1 := rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
        w[i] = w[i - 16] + s0 + w[i - 7] + s1
    }
    a := h.state[0]
    b := h.state[1]
    c := h.state[2]
    d := h.state[3]
    e := h.state[4]
    f := h.state[5]
    g := h.state[6]
    hh := h.state[7]
    for i in range 64 {
        t1 := hh + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ (~e & g)) + k[i] + w[i]
        t2 := (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c))
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    }
    h.state[0] += a
    h.state[1] += b
    h.state[2] += c
    h.state[3] += d
    h.state[4] += e
    h.state[5] += f
    h.state[6] += g
    h.state[7] += hh
}

# data added to what the digest is taken of
fn (h mut Hasher&) Push(data Array<U8>&) {
    h.total += data.Len()
    i I64 = 0
    if h.used > 0 {
        for i < data.Len() and h.used < 64 {
            h.buf[h.used] = data[i]
            h.used++
            i++
        }
        if h.used < 64 { return }
        h.block(h.buf, 0)
        h.used = 0
    }
    for i + 64 <= data.Len() {
        h.block(data, i)
        i += 64
    }
    for i < data.Len() {
        h.buf[h.used] = data[i]
        h.used++
        i++
    }
}

# the digest of everything pushed so far, 32 bytes. The Hasher is left as it was, so more may be pushed and Sum taken again
fn (h Hasher&) Sum() Array<U8> {
    c Hasher = h                                   # a copy, so the Hasher itself goes on
    bits := U64(h.total) * 8
    pad := Array<U8>(1, 0x80)
    c.Push(pad)
    zero := Array<U8>(1)
    for c.used != 56 { c.Push(zero) }
    tail := Array<U8>(8)
    for i in range 8 { tail[i] = U8((bits >> U64(56 - 8 * i)) & 0xFF) }
    c.Push(tail)
    out := Array<U8>(32)
    for i in range 8 {
        v := c.state[i]
        out[4 * i] = U8(v >> 24)
        out[4 * i + 1] = U8((v >> 16) & 0xFF)
        out[4 * i + 2] = U8((v >> 8) & 0xFF)
        out[4 * i + 3] = U8(v & 0xFF)
    }
    return out
}

# the digest of data, 32 bytes
fn Sum(data Array<U8>&) Array<U8> {
    h := Hasher()
    h.Push(data)
    return h.Sum()
}

# the digest of data as 64 lowercase hex digits, as sha256sum writes it
fn Hex(data Array<U8>&) String { return hex.Encode(Sum(data)) }

if TestBuild {

Abc String = Hex("abc")

test "the FIPS 180-4 test vectors" {
    assert Hex("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    assert Abc == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    assert Hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") ==
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
}

test "a Hasher fed in pieces gives the digest of the whole" {
    big := Array<U8>(1000000, 'a')
    assert hex.Encode(Sum(big)) == "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"
    h := Hasher()
    for n in I64[1, 63, 64, 65, 7, 128, 200] {
        h.Push(big[:n])
    }
    whole := Sum(big[:1 + 63 + 64 + 65 + 7 + 128 + 200])
    assert h.Sum() == whole and h.Sum() == whole
}

}
