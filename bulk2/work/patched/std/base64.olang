# base64 - bytes as text in 64 characters, as RFC 4648 writes them: Encode/Decode with the standard alphabet
# ("A-Z a-z 0-9 + /") and '=' padding to a multiple of four, EncodeURL/DecodeURL with the URL- and file-name-safe one
# ("- _" for "+ /") and no padding, as JWTs and URLs carry it. Decoding is strict: a character outside the alphabet, a
# missing or misplaced '=', or bits left over that encoding would not have written, fail with Error.INVALID. Imported
# with `import "std/base64"`; text goes in as its bytes.

type Error error {
    INVALID
}

standard String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
urlSafe String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn encodeWith(data Array<U8>&, alphabet String&, pad Bool) String {
    full := data.Len() / 3
    rest := data.Len() % 3
    n := full * 4
    if rest > 0: n += 4 if pad else rest + 1
    out := String(Array<Char>(n))
    o I64 = 0
    for i in range full {
        v := (U32(data[3 * i]) << 16) | (U32(data[3 * i + 1]) << 8) | U32(data[3 * i + 2])
        out[o] = alphabet[v >> 18]
        out[o + 1] = alphabet[(v >> 12) & 63]
        out[o + 2] = alphabet[(v >> 6) & 63]
        out[o + 3] = alphabet[v & 63]
        o += 4
    }
    if rest > 0 {
        v := U32(data[3 * full]) << 16
        if rest == 2: v = v | (U32(data[3 * full + 1]) << 8)
        out[o] = alphabet[v >> 18]
        out[o + 1] = alphabet[(v >> 12) & 63]
        if rest == 2 {
            out[o + 2] = alphabet[(v >> 6) & 63]
        } else if pad {
            out[o + 2] = '='
        }
        if pad: out[o + 3] = '='
    }
    return out
}

# a character's value in the alphabet, or -1
fn valueOf(c Char, url Bool) I64 {
    if c >= 'A' and c <= 'Z' { return I64(c - 'A') }
    if c >= 'a' and c <= 'z' { return I64(c - 'a') + 26 }
    if c >= '0' and c <= '9' { return I64(c - '0') + 52 }
    if c == ('-' if url else '+') { return 62 }
    if c == ('_' if url else '/') { return 63 }
    return -1
}

fn decodeWith(t String&, url Bool) Array<U8> ? Error.INVALID {
    n := t.Len()
    if not url {
        if n % 4 != 0 { error Error.INVALID }
        if n > 0 and t[n - 1] == '=': n--
        if n > 0 and t[n - 1] == '=': n--
    }
    if n % 4 == 1 { error Error.INVALID }
    out := Array<U8>(n / 4 * 3 + (n % 4 - 1 if n % 4 > 0 else 0))
    o I64 = 0
    acc U32 = 0
    bits I64 = 0
    for i in range n {
        v := valueOf(t[i], url)
        if v < 0 { error Error.INVALID }
        acc = (acc << 6) | U32(v)
        bits += 6
        if bits >= 8 {
            bits -= 8
            out[o] = U8((acc >> U32(bits)) & 0xFF)
            o++
        }
    }
    if (acc & ((U32(1) << U32(bits)) - 1)) != 0 { error Error.INVALID }    # bits encoding leaves zero
    return out
}

# data in the standard alphabet, padded with '='
fn Encode(data Array<U8>&) String { return encodeWith(data, standard, true) }

# what Encode wrote, back as bytes - failing with INVALID for anything else
fn Decode(t String&) Array<U8> ? Error.INVALID { return try decodeWith(t, false) }

# data in the URL-safe alphabet, with no padding
fn EncodeURL(data Array<U8>&) String { return encodeWith(data, urlSafe, false) }

# what EncodeURL wrote, back as bytes - failing with INVALID for anything else ('=' included)
fn DecodeURL(t String&) Array<U8> ? Error.INVALID { return try decodeWith(t, true) }

if TestBuild {

Hello String = Encode("Hello, world!")

test "the RFC 4648 test vectors" {
    assert Encode("") == "" and Encode("f") == "Zg==" and Encode("fo") == "Zm8=" and Encode("foo") == "Zm9v"
    assert Encode("foob") == "Zm9vYg==" and Encode("fooba") == "Zm9vYmE=" and Encode("foobar") == "Zm9vYmFy"
    assert Hello == "SGVsbG8sIHdvcmxkIQ=="
    for t in String&["", "f", "fo", "foo", "foob", "fooba", "foobar"] {
        assert String(Decode(Encode(t))!) == t and String(DecodeURL(EncodeURL(t))!) == t
    }
}

test "every byte round-trips, in both alphabets" {
    all := Array<U8>(256)
    for i in range 256 { all[i] = U8(i) }
    assert Decode(Encode(all))! == all and DecodeURL(EncodeURL(all))! == all
    assert EncodeURL(U8[0xFB, 0xFF]) == "-_8" and Encode(U8[0xFB, 0xFF]) == "+/8="
}

test "decoding is strict" {
    for bad in String&["Zg", "Zg=", "Z===", "Zh==", "Zm9v!", "Zm=v", "Zg==Zg=="] {
        try Decode(bad) catch Error.INVALID { continue }
        unreachable
    }
    for bad in String&["Zg==", "Z", "+/8", "Zh"] {
        try DecodeURL(bad) catch Error.INVALID { continue }
        unreachable
    }
}

}
