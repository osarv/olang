# T4a, std/arith: the checked operations at the new widths take the eight's "nomatch" branches, written for the
# unsigned types and for 64 bits - Neg of a signed odd width fails, Shift uses a width of 64, and Div/Rem/Mul skip
# the least-value-by--1 case, so they run an undefined operation (E6a)
import "std/io"
import "std/arith"

K mut I64 = 1

fn show(k I64) String {
    a := try arith.Neg(I24(5) * I24(k)) catch default I24(77)          # want -5
    b := try arith.Neg(I128(5) * I128(k)) catch default I128(77)       # want -5
    c := try arith.ShiftLeft(I128(k), 100) catch default I128(77)      # want 2^100, which fits
    d := try arith.ShiftLeft(U7(k), 9) catch default U7(77)   # want INVALID (9 >= 7): 77
    e := try arith.Div(I24.Min, I24(0) - I24(k)) catch default I24(77)   # want OVERFLOW: 77
    f := try arith.Mul(I24.Min, I24(0) - I24(k)) catch default I24(77)   # want OVERFLOW: 77
    g := try arith.Rem(I24.Min, I24(0) - I24(k)) catch default I24(77)                         # want 0
    return $a " " $b " " $c " " $d " " $e " " $f " " $g
}

fn main() {
    io.Println(show(K))!
    io.Println("want: -5 -5 1267650600228229401496703205376 77 77 77 0")!
}
