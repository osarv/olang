import "std/io"
type N struct(v I32) {
    v
}
type Cur struct(of mut N&) {
    at mut N& = of
}
fn churn() {
    for i in range 50 {
        junk := Array<I64>(1000, i)
        assert junk[999] == i
    }
}
fn main() ? {
    outer mut N& = N(1)
    keep N& = outer
    for i in range 2 {
        inner mut N& = N(I32(7 + i))
        x mut N& = N(I32(42 + i))
        c := Cur(outer)
        d := Cur(inner)
        arr Array<mut Cur&> = Array<Cur&>[c, d]
        arr[i].at = x
        keep = arr[1 - i].at
    }
    churn()
    try io.Println($keep.v)
}
