import "std/io"
fn churn() I64 {
    t I64 = 0
    for i in range 2000 {
        x := "churn " $i " " $(i * 3)
        a := Array<I64>(16, i)
        t += x.Len() + a[2] - i
    }
    return t
}
type P struct(x I64, y I64) {
    x
    y
}
fn keep(p P, into mut Vec<P&>&, d I64) {
    if d > 0 {
        keep(P(p.x + 100, d), into, d - 1)
    }
    into.Push(p)
    p.y = p.y + 1
}
fn main() ? {
    v := Vec<P&>()
    f := keep
    for i in range 4 {
        q := P(i, 0)
        if i % 2 == 0 { f(q, v, 1) } else { keep(q, v, 2) }
        q.x = -1
    }
    churn()
    s := ""
    for p in v { s = $s $p.x ":" $p.y " " }
    try io.Println(s)
}
