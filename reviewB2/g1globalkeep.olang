import "std/io"
fn churn() I64 {
    t I64 = 0
    for i in range 2000 {
        x := "churn " $i " " $(i * 3)
        a := Array<I64>(16, i)
        t += x.Len() + a[2] - i
    }
    return t
}
type P struct(x I64, y I64) {
    x
    y
}
type Node struct(v I64) { v }
last mut Node?& = null
fn store(n Node&) { last = n }
fn apply(f fn&(n Node&), v I64) { f(Node(v)) }
fn main() ? {
    fs := Array<fn&(n Node&)>[store, store]
    for i in range 3 {
        n := Node(i)
        g := store if i > 0 else fs[0]
        g(n)
        apply(store, i + 100)
    }
    churn()
    try io.Println($last!.v)
}
