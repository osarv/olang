import "std/io"
fn churn() I64 {
    t I64 = 0
    for i in range 2000 {
        x := "churn " $i " " $(i * 3)
        a := Array<I64>(16, i)
        t += x.Len() + a[2] - i
    }
    return t
}
type P struct(x I64, y I64) {
    x
    y
}
type E enum {
    A(p P)
    Z
}
fn main() ? {
    v := Vec<P&>()
    for i in range 4 {
        e := E.A(P(i + 10, i))
        match e {
            case E.A(y) {
                v.Push(y)
                y.x = y.x + 1000
            }
            case _ { }
        }
        e = E.Z
    }
    churn()
    s := ""
    for p in v { s = $s $p.x ":" $p.y " " }
    try io.Println(s)
}
