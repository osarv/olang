# D16/O14: a lambda whose function type says its result is built returns a reference it captured; the result is
# kept where a built result may go
import "std/io"
import "churn"
type Node struct(v I64) { v }
fn apply(f fn() Node&) Node& { return f() }
fn main() ? io.IoError {
    keep Node& = Node(0)
    for i in range 3 {
        inner Node& = Node(i + 40)
        g := fn() Node& { return inner }
        keep = apply(g)
        keep2 := g()
        if i == 2 { keep = keep2 }
    }
    c := churn.Churn()
    try io.Println($c " " $keep.v)
}
