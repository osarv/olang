# T7a: r02 reduced - a struct with a text field held by value, returned from a function
import "std/io"
import "churn"
type Rec struct(n I64) {
    t := $n "-text-that-is-long-enough"
}
fn mk(n I64) Rec { return Rec(n) }
fn main() ? io.IoError {
    k := mk(4)
    c := churn.Churn()
    try io.Println($c " " $k.t)
}
