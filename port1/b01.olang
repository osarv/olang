# O23a records: a value field holding an instance with an &src field is assigned after construction;
# the record of the first instance must not be read for the second
import "std/io"
import "churn"
type Node struct(v I64) { v }
type Holder struct(src Node&) {
    r Node&src = src
}
type Outer struct(h Holder) { h }
fn main() ? io.IoError {
    x Node& = Node(1)
    keep Node& = x
    if x.v == 1 {
        y Node& = Node(77)
        o := Outer(Holder(x))
        o.h = Holder(y)
        keep = o.h.r
    }
    c := churn.Churn()
    try io.Println($c " " $keep.v)
}
