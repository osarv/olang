# E28/O12: a match and a conditional of borrowed call results from scopes of different lifetimes, kept outside
import "std/io"
import "churn"
type Node struct(v I64) {
    v
    next mut Node& = null
}
fn pick(n Node&) Node&n { return n }
fn main() ? io.IoError {
    a Node& = Node(1)
    keep Node& = a
    for i in range 3 {
        b Node& = Node(i + 10)
        x := match i {
            case 0 => pick(a)
            case _ => pick(b)
        }
        y := pick(a) if i == 0 else pick(b)
        if i == 2 { keep = x }
        if i == 1 { keep = y }
    }
    c := churn.Churn()
    try io.Println($c " " $keep.v)
}
