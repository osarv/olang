# T7a: r02 reduced - a struct with a text field held by value, assigned anew in a loop
import "std/io"
import "churn"
type Rec struct(n I64) {
    t := $n "-text-that-is-long-enough"
}
fn main() ? io.IoError {
    r := Rec(3)
    for i in range 3 { r = Rec(i + 5) }
    c := churn.Churn()
    try io.Println($c " " $r.t)
}
