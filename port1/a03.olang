# a spawn target that is a struct value holding a reference built by the task
import "std/io"
import "churn"
type Node struct(v I64) { v }
type Pair2 struct(a Node&, b I64) {
    a
    b
}
fn mk(i I64) Pair2 { return Pair2(Node(i * 3), i) }
fn main() ? io.IoError {
    p Pair2 = Pair2(Node(1), 1)
    join {
        spawn p = mk(14)
    }
    c := churn.Churn()
    try io.Println($c " " $p.a.v " " $p.b)
}
