# O13c: the record a recursive function's result carries, when its returns bind different parameters
import "std/io"
import "churn"
type Node struct(v I64) { v }
type Holder struct(src Node&) {
    r Node&src = src
}
fn mk(x Node&, y Node&, n I64) Holder {
    if n == 0 { return Holder(x) }
    return mk(y, x, n - 1)
}
fn main() ? io.IoError {
    x Node& = Node(1)
    keep Node& = x
    if x.v == 1 {
        y Node& = Node(77)
        h := mk(x, y, 1)
        keep = h.r
    }
    c := churn.Churn()
    try io.Println($c " " $keep.v)
}
