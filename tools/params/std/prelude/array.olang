# param_migrate's hand forms (round 3, docs/rework.md 16) for std/prelude/array.olang.

# a position in an array - what lets generic code written over Iterator<T> take an array too ("total(a.Iter())"),
# as it takes a Vec or a Map. "for x in a" does not go through it: an array is walked directly. It holds the array as
# its own (QCE), so nothing done to the array after Iter() changes the walk
type ArrayIter<T> struct(of Array<T>) {
    arr Array<T> = of
    i I64 = 0
}

# the elements it has still to give, as a view of the array
fn (it ArrayIter<T>) Rest() Array<T> { return it.arr[it.i:] }

# a fresh position at the array's start - each call its own, so loops never disturb each other
fn (a Array<T>) Iter() ArrayIter<T> { return ArrayIter<T>(a) }

# a position in an array walked from its last element to its first - what an array's Reversed gives, holding the
# array as its own (QCE): nothing done to the array after Reversed() changes the walk
type ReversedIter<T> struct(of Array<T>) {
    arr Array<T> = of
    i I64 = of.Len()
}

# the elements from the last to the first: "for x in a.Reversed() { ... }" - a walk, building nothing, as fast as the
# counted loop down the positions (a String's too: "for c in t.Reversed()" walks its bytes backward)
fn (a Array<T>) Reversed() ReversedIter<T> { return ReversedIter<T>(a) }

# every run of size consecutive elements, in order - Len() - size + 1 of them (none where the array is shorter than
# size), each a view of the array, nothing copied: "for w in a.Windows(3) { smooth.Push(w.Sum() / 3.0) }". The views
# are held in an array of their own, allocated once at its exact length - its elements the receiver's views, handed
# over uncopied where the caller only reads them (D9h, round 3b)
fn (a Array<T>) Windows(size ChunkSize) Array<Array<T>> {
    n := I64(size)
    count := a.Len() - n + 1 if a.Len() >= n else 0
    views := Array<Array<T>>(count)   # each view written below
    for k in range count { views[k] = a[k:k + n] }
    return views
}
