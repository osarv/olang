# param_migrate's hand forms (round 3, docs/rework.md 16) for std/prelude/text.olang: each replaces the declaration of
# its name in the migrated file. The readers handing back views of the text take it bare and give values (QCE).

# the pieces of the text between each occurrence of sep, in order, each a text of the array's own - so nothing done to
# the text after changes them. Adjacent separators, or one at either end, give empty pieces, so joining the pieces with
# sep gives the text back; text with no separator is one piece, and the empty text one empty piece. An empty sep splits
# the text into its single bytes. The pieces are counted first, so the array is allocated once at its exact length; for
# a one-byte sep the count is a plain loop over the bytes, which the optimizer turns into vector compares
fn (t String) Split(sep String) Array<String> {
    if sep.Len() == 0 {
        bytes := Array<String>(t.Len())     # every byte written before it is read
        for i in range t.Len() {
            bytes[i] = t[i:i + 1]
        }
        return bytes
    }
    if sep.Len() == 1 {
        c := sep[0]
        n I64 = 1
        for x in t {
            if x == c { n++ }
        }
        pieces := Array<String>(n)     # every piece written before it is read
        k I64 = 0
        start I64 = 0
        for i in range t.Len() {
            if t[i] == c {
                pieces[k] = t[start:i]
                k++
                start = i + 1
            }
        }
        pieces[k] = t[start:]
        return pieces
    }
    n I64 = 1
    from I64 = 0
    for {
        at := try t.findFrom(sep, from) catch { break }
        n++
        from = at + sep.Len()
    }
    pieces := Array<String>(n)
    from = 0
    for i in range n - 1 {
        at := try t.findFrom(sep, from) catch { unreachable }
        pieces[i] = t[from:at]
        from = at + sep.Len()
    }
    pieces[n - 1] = t[from:]
    return pieces
}

# the lines of the text, one at a time: "for line in t.Lines() { ... }". Lines as io.Lines reads them from a file: a line
# is what comes before a newline, without it, and one carriage return just before the newline goes with it, so
# "a\r\nb\n" is "a" and "b" as "a\nb\n" is. The last line needs no newline after it: "a\nb" is "a" and "b", "a\n" is just
# "a", and "a\n\n" is "a" and "" - the empty text has no lines at all
fn (t String) Lines() LineIter { return LineIter(t) }

# a position in a text's lines - handed out fresh by Lines(), so every loop gets its own, and holding the text as its
# own (QCE): nothing done to the text after Lines() changes what it walks
type LineIter struct(of String) {
    text String = of
    at I64 = 0                       # where the next line starts
}

fn (it LineIter&) Next() String ? Exhausted {
    if it.at >= it.text.Len() { error Exhausted.End }
    start := it.at
    end I64 = start
    for end < it.text.Len() and it.text[end] != '\n' { end++ }
    it.at = end + 1 if end < it.text.Len() else end
    if end > start and it.text[end - 1] == '\r' { end-- }
    return it.text[start:end]
}

# the texts one after another with sep between each two: String["a", "b", "c"].Join(", ") is "a, b, c" - the empty array
# joins to the empty text. Built at its exact length, once; "$" renders the array itself as source instead (E11a). An
# array of texts held by value, as Split gives them, or of references to texts
fn (parts Array<String>) Join(sep String) String {
    n I64 = 0
    for p in parts { n += p.Len() }
    if parts.Len() > 1 { n += sep.Len() * (parts.Len() - 1) }
    out := String(Array<Char>(n))
    w I64 = 0
    for i, p in parts {
        if i > 0 {
            for c in sep {
                out[w] = c
                w++
            }
        }
        for c in p {
            out[w] = c
            w++
        }
    }
    return out
}
