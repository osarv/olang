# param_migrate's hand forms (round 3, docs/rework.md 16) for std/list.olang.

# the texts one after another with sep between each two, as an array of texts joins (Array<String>.Join) - a List of
# texts held by value, as Split's pieces are
fn (l List<String>) Join(sep String) String {
    n I64 = 0
    for p in l { n += p.Len() }
    if l.Len() > 1 { n += sep.Len() * (l.Len() - 1) }
    out := String(Array<Char>(n))
    w I64 = 0
    for i, p in l {
        if i > 0 {
            for c in sep {
                out[w] = c
                w++
            }
        }
        for c in p {
            out[w] = c
            w++
        }
    }
    return out
}

fn (l List<String&>) Join(sep String) String {
    n I64 = 0
    for p in l { n += p.Len() }
    if l.Len() > 1 { n += sep.Len() * (l.Len() - 1) }
    out := String(Array<Char>(n))
    w I64 = 0
    for i, p in l {
        if i > 0 {
            for c in sep {
                out[w] = c
                w++
            }
        }
        for c in p {
            out[w] = c
            w++
        }
    }
    return out
}

# the last element - failing with Empty when there is none (read through the receiver's own fields, never through a
# call on them, so what it gives follows the list it is asked of: writable for a writable one - round 3b)
fn (l List<T>) Last() T ? Error.Empty {
    if l.s.count == 0 { error Error.Empty }
    if l.s.used > 0 { return l.s.tail[l.s.used - 1] }
    k := l.s.nChunks - 2   # the tail is empty: the chunk before it is full
    if k == 0 { return l.s.first[l.s.first.Len() - 1] }
    return l.s.chunks[k][l.s.chunks[k].Len() - 1]
}
