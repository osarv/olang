# param_migrate's hand forms (round 3b, docs/rework.md 17) for std/json.olang: the text read is taken bare - what Parse
# builds holds text of its own (each string decoded into new text), never the text it was given.

# the value the JSON text holds: one value, with nothing but whitespace around it (a byte order mark before it is
# ignored). Fails with the Error that says why the text is not JSON; "at", when given, is set to where reading
# stopped - the start of the problem, or the end of the text.
fn Parse(text String, at Position?& = null) Json& ? Error {
    r reader&return = reader(text)
    defer {
        if at is not null { r.place(at) }
    }
    try r.run()
    return r.vals[0]
}

# what Parse reads with: the text, where it has got to, and the values read and not yet gathered into their array or
# object - each open array's items and object's members on the stacks, an object's names on "names". It lives where
# Parse's result does, so everything it builds - each value pushed, each array gathered - is built there; the text is
# its own (QCE), read only
type reader struct(src String) {
    src
    pos I64 = 0
    vals Array<Json&>& = Array<Json&>(64, Json.Null)   # the slots past nv not read
    nv I64 = 0
    names Array<String&>& = Array<String&>(16, "")
    nn I64 = 0
    starts Array<I64>& = Array<I64>(16)     # for each open array, where its items start in vals; for an object,
    nameStarts Array<I64>& = Array<I64>(16) # also where its names start in names - -1 for an array
    depth I64 = 0
}

# a value of type T read from JSON text, by Encode's rules backwards: "p := try json.Decode<Point>(text)". A struct is
# built through its constructor (G37), so the constructor's checks run - one argument per parameter, read from the
# member of its name, a missing member taking the parameter's default and failing with Missing where it has none;
# members no parameter names are passed over. Text, numbers (an integer only where the number is whole and fits, else
# WrongKind), Bools, Chars (text of one character), arrays, Lists, Vecs, Maps with text keys and references (to what
# such a value is) are read as Encode writes them, an enum's case built from its name and its fields' members (G34), an
# error value from its word's text or null (WrongKind for a word not of its type). Members are found by their keys as
# Encode writes them - its Naming, a type's own, a member's "@json.Key" - and a parameter "@json.Skip" leaves out takes
# its default.
# Fails with what Parse fails with, with Error.Missing and Error.WrongKind where the text does not fit
# the type, and with what a constructor fails with
fn Decode<T>(text String, at Position?& = null, keys Naming = Naming.Exact) T ? {
    j := try Parse(text, at)
    return try From<T>(j, keys)
}
