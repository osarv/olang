# checked_migrate - the checked keyword and CheckError removed (E15a, 2026-10-25, the user's call: "one error system:
# try"). What can be rewritten from the text alone is:
#
#     checked a[i]           ->  try a.Get(i)                 (E16d: fails with ArrayError.OUT_OF_RANGE)
#     checked a[lo:hi]       ->  try a.SliceOf(lo, hi)        (E16c; an absent bound 0 or a.Len())
#     checked T(x)           ->  try x.Narrow<T>()            (E26b: NumberError.OVERFLOW and INVALID), T a number
#     checked f(x)           ->  try f(x)                     (D17: a contract is checked on entry, ArgumentError.INVALID)
#     (checked ...)!         ->  ...!                         the same, with "!" in place of the try
#
# and CheckError's words where they name what such a rewrite now fails with: OUT_OF_BOUNDS is ArrayError.OUT_OF_RANGE,
# OVERFLOW and INVALID of a narrowing NumberError's, WRONG_CASE CaseError's, CONTRACT ArgumentError.INVALID. Everything else - "checked (a + b)", a
# checked store or step, a checked call to a Checked form, CheckError left over - is listed for a person: arithmetic
# that must not overflow goes through std/arith (try arith.Checked(a) + b, try arith.Add(a, b)), and an "as" fails as
# written now (try e as C, (e as C)!), which the compiler says where it is not handled. Files are rewritten in place;
# --check writes nothing and the exit status says whether anything would change. Running it again changes nothing.
#
#     $OLANG build tools/checked_migrate.olang && build/tools_checked_migrate [--check] [-v] FILE|DIR...

import "std/os"
import "srcmask"

# the word, written in two pieces so that the tool run over itself changes nothing
Word String& = "check" "ed"
OldError String& = "Check" "Error"

Numbers Array<String&> = String&["I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F16", "BF16", "F32", "F64"]

type Result struct() {
    changes I64 = 0
    left List<String&>
}

fn isNumber(t String&) Bool {
    for n in Numbers {
        if n == t { return true }
    }
    return false
}

# the end of a name starting at i, i itself where none starts there
fn nameEnd(src String&, i I64) I64 {
    if i >= src.Len() or not srcmask.IsIdStart(src[i]) { return i }
    j := i + 1
    for j < src.Len() and srcmask.IsWord(src[j]) { j++ }
    return j
}

# a postfix chain from i - a name or a number, then ".name", "(...)" and "[...]" - as its parts' starts and the end;
# empty where none starts at i
fn chain(src String&, mask String&, i I64) List<I64> {
    parts List<I64>
    j := nameEnd(src, i)
    if j == i {
        for j < src.Len() and (src[j].IsDigit() or src[j] == '_' or src[j] == '.') { j++ }
        if j == i { return parts }
    }
    parts.Push(i)
    for j < src.Len() {
        c := src[j]
        if c == '.' and nameEnd(src, j + 1) > j + 1 {
            parts.Push(j)
            j = nameEnd(src, j + 1)
        } else if (c == '(' or c == '[') and mask[j] == 'c' {
            k := srcmask.CloseOf(src, mask, j)
            if k < 0 { break }
            parts.Push(j)
            j = k
        } else {
            break
        }
    }
    parts.Push(j)
    return parts
}

# where in src[a:b] a character c stands outside every bracket, -1 for nowhere
fn topLevel(src String&, mask String&, a I64, b I64, c Char) I64 {
    depth I64 = 0
    for k in range a, b {
        if mask[k] != 'c' { continue }
        x := src[k]
        if x == '(' or x == '[' or x == '{' {
            depth++
        } else if x == ')' or x == ']' or x == '}' {
            depth--
        } else if x == c and depth == 0 {
            return k
        }
    }
    return -1
}

# whether a chain is a simple operand to put before a method call: a name or a chain of parts, nothing to group
fn simple(src String&) Bool {
    for k in range src.Len() {
        c := src[k]
        if not (srcmask.IsWord(c) or c == '.' or c == '(' or c == ')' or c == '[' or c == ']' or c == ',' or c == ' ') { return false }
    }
    return true
}

# the operand rewritten - "try"'s, without the "try" - and what it now fails with ("ArrayError", "NumberError"); ""
# where it is not one this tool rewrites
fn rewrite(src String&, mask String&, parts List<I64>&) String, String {
    n := parts.Len()
    end := parts[n - 1]
    last := parts[n - 2]
    if src[last] == '[' {
        base := src[parts[0]:last]
        # T[...] after a type's name is an array literal or a comprehension, no index
        if n == 3 and base[0].IsUpper() { return "", "" }
        inner := srcmask.Strip(src[last + 1:end - 1])
        colon := topLevel(src, mask, last + 1, end - 1, ':')
        if colon >= 0 {
            lo := srcmask.Strip(src[last + 1:colon])
            hi := srcmask.Strip(src[colon + 1:end - 1])
            if lo.Len() == 0 { lo = "0" }
            if hi.Len() == 0 { hi = $base ".Len()" }
            return $base ".SliceOf(" $lo ", " $hi ")", "ArrayError"
        }
        if topLevel(src, mask, last + 1, end - 1, ',') >= 0 or inner.Len() == 0 { return "", "" }
        return $base ".Get(" $inner ")", "ArrayError"
    }
    if n == 3 and src[last] == '(' and isNumber(src[parts[0]:last]) {
        x := srcmask.Strip(src[last + 1:end - 1])
        if x.Len() == 0 or topLevel(src, mask, last + 1, end - 1, ',') >= 0 { return "", "" }
        t := src[parts[0]:last]
        if simple(x) and chainCovers(x) { return $x ".Narrow<" $t ">()", "NumberError" }
        return $"(" $x ").Narrow<" $t ">()", "NumberError"
    }
    # a checked call of a function with a contract (D17): its requirements are checked on entry now, failing with
    # ArgumentError.INVALID, so it is tried as any call that can fail is - Pow's checked form is std/arith's, by hand
    if src[last] == '(' and not src[parts[0]:last].EndsWith(".Pow") { return $src[parts[0]:end], "ArgumentError" }
    return "", ""
}

# whether text is one postfix chain alone - "a.b[i]", "f(x)" - so a method call after it applies to all of it
fn chainCovers(x String&) Bool {
    m := srcmask.Mask(x, true)
    ps := chain(x, m, 0)
    return ps.Len() > 0 and ps[ps.Len() - 1] == x.Len()
}

# CheckError's words in seg renamed for what a rewrite there fails with: kind "ArrayError" or "NumberError", "" for none
fn renameWords(seg String&, kind String&, c mut Result&) String {
    if kind.Len() == 0 { return $seg }
    s := $seg
    pairs := String&[$OldError ".OUT_OF_BOUNDS", "ArrayError.OUT_OF_RANGE", $OldError ".WRONG_CASE", "CaseError.WRONG_CASE"
                     $OldError ".OVERFLOW", "NumberError.OVERFLOW", $OldError ".INVALID", "NumberError.INVALID"]
    if kind == "ArgumentError" {
        contract := $OldError ".CONTRACT"
        for s.Contains(contract) {
            s = s.Replace(contract, "ArgumentError.INVALID")
            c.changes++
        }
    }
    for k in range 0, pairs.Len(), 2 {
        if pairs[k + 1].StartsWith("NumberError") and kind != "NumberError" { continue }
        for s.Contains(pairs[k]) {
            s = s.Replace(pairs[k], pairs[k + 1])
            c.changes++
        }
    }
    if kind.Len() > 0 {
        bare := $OldError " "
        if s.Contains("catch " $bare) {
            s = s.Replace("catch " $bare, "catch " $kind " ")
            c.changes++
        }
    }
    return s
}

# where the statement holding position i ends: the end of the line, or of a later one while the next begins "catch"
fn statementEnd(src String&, i I64) I64 {
    j := i
    for {
        e := try src[j:].FindByte('\n') catch default (src.Len() - j)
        j += e
        if j >= src.Len() { return src.Len() }
        rest := srcmask.StripStart(src[j + 1:])
        if not rest.StartsWith("catch") { return j }
        j++
    }
}

fn lineOf(src String&, i I64) I64 {
    n I64 = 1
    for k in range i {
        if src[k] == '\n' { n++ }
    }
    return n
}

# src migrated: each checked rewritten where the text says what it is, the rest listed in c.left as "LINE: text"
fn migrate(path String&, src String&, c mut Result&) String {
    mask := srcmask.Mask(src, true)
    out := StringBuilder()
    at I64 = 0
    i I64 = 0
    renameTo I64 = -1      # where a rewrite's statement ends, its CheckError words renamed up to there
    kind := ""
    for i < src.Len() {
        if renameTo >= 0 and i >= renameTo {
            out.Push(renameWords(src[at:renameTo], kind, c))
            at = renameTo
            renameTo = -1
        }
        if mask[i] != 'c' or not src[i:].StartsWith(Word) or (i > 0 and srcmask.IsWord(src[i - 1])) {
            i++
            continue
        }
        w := i + Word.Len()
        if w >= src.Len() or src[w] != ' ' {
            i++
            continue
        }
        parts := chain(src, mask, w + 1)
        if parts.Len() == 0 {
            if src[w + 1] == '(' { c.left.Push($path ":" $lineOf(src, i) ": " $srcmask.Strip(lineText(src, i))) }
            i++
            continue
        }
        endOp := parts[parts.Len() - 1]
        after := srcmask.StripStart(src[endOp:])
        store := (after.StartsWith("=") and not after.StartsWith("==")) or after.StartsWith("+=") or after.StartsWith("-=") or
            after.StartsWith("*=") or after.StartsWith("++") or after.StartsWith("--")
        op, k := rewrite(src, mask, parts)
        if store or op.Len() == 0 {
            c.left.Push($path ":" $lineOf(src, i) ": " $srcmask.Strip(lineText(src, i)))
            i = endOp
            continue
        }
        bang := i > 0 and src[i - 1] == '(' and src[endOp:].StartsWith(")!")
        segEnd := i - 1 if bang else i
        out.Push(renameWords(src[at:segEnd], kind if renameTo >= 0 else "", c))
        if bang {
            out.Push(op)
            out.Push("!")
            at = endOp + 2
        } else {
            out.Push("try ")
            out.Push(op)
            at = endOp
        }
        c.changes++
        kind = k
        renameTo = statementEnd(src, endOp)
        i = at
    }
    if renameTo >= 0 {
        out.Push(renameWords(src[at:renameTo], kind, c))
        at = renameTo
    }
    out.Push(src[at:])
    res := out.ToString()
    # CheckError's WRONG_CASE is CaseError's wherever it is written; whatever else of it is left is listed
    if res.Contains($OldError ".WRONG_CASE") {
        res = res.Replace($OldError ".WRONG_CASE", "CaseError.WRONG_CASE")
        c.changes++
    }
    rm := srcmask.Mask(res, true)
    j I64 = 0
    for j < res.Len() {
        k := try res[j:].Find(OldError) catch default -1
        if k < 0 { break }
        if rm[j + k] == 'c' { c.left.Push($path ":" $lineOf(res, j + k) ": " $srcmask.Strip(lineText(res, j + k))) }
        j += k + OldError.Len()
    }
    return res
}

fn lineText(src String&, i I64) String&src {
    a := i
    for a > 0 and src[a - 1] != '\n' { a-- }
    b := try src[i:].FindByte('\n') catch default (src.Len() - i)
    return src[a:i + b]
}

fn main() ? {
    check := false
    verbose := false
    paths List<String&>
    args := os.Args()
    for i in range 1, args.Len() {
        a := args[i]
        if a == "--check" {
            check = true
        } else if a == "-v" {
            verbose = true
        } else {
            paths.Push($a)
        }
    }
    if paths.Len() == 0 {
        srcmask.SayErr("usage: tools_checked_migrate [--check] [-v] FILE|DIR...")
        os.Exit(2)
    }
    files List<String&>
    for p in paths {
        if os.IsDir(p) { srcmask.Walk(p, files) } else { files.Push($p) }
    }
    total := Result()
    changed I64 = 0
    for path in files {
        src := try srcmask.ReadText(path) catch {
            srcmask.SayErr("checked_migrate: cannot read " $path)
            os.Exit(1)
            unreachable
        }
        before := total.changes
        out := migrate(path, src, total)
        if out == src or total.changes == before { continue }
        changed++
        if verbose { srcmask.Say(path) }
        if not check {
            try os.WriteFile(path, out) catch {
                srcmask.SayErr("checked_migrate: cannot write " $path)
                os.Exit(1)
            }
        }
    }
    verb := "would change " if check else "changed "
    srcmask.Say($verb $changed " files: " $total.changes " rewrites")
    for l in total.left { srcmask.Say("by hand: " $l) }
    if check and changed > 0 { os.Exit(1) }
}

test "an index, a slice and a narrowing rewritten, their errors renamed" {
    r := Result()
    src := "x := " $Word " a[i + 1] catch " $OldError ".OUT_OF_BOUNDS default 0\n"
    assert migrate("f", src, r) == "x := try a.Get(i + 1) catch ArrayError.OUT_OF_RANGE default 0\n"
    src2 := "s := " $Word " b.c[2:] catch default d\n"
    assert migrate("f", src2, r) == "s := try b.c.SliceOf(2, b.c.Len()) catch default d\n"
    src3 := "n := " $Word " U8(v + 1)\n    catch " $OldError ".OVERFLOW { }\n"
    assert migrate("f", src3, r) == "n := try (v + 1).Narrow<U8>()\n    catch NumberError.OVERFLOW { }\n"
    src4 := "y := (" $Word " a[0])! + 1\n"
    assert migrate("f", src4, r) == "y := a.Get(0)! + 1\n"
    lit := "w := " $Word " I32[x * 2 for x in l]\n"
    assert migrate("f", lit, r) == lit
    src6 := "w := " $Word " f(a, b) catch " $OldError ".CONTRACT default 0\n"
    assert migrate("f", src6, r) == "w := try f(a, b) catch ArgumentError.INVALID default 0\n"
    src5 := "z := " $Word " I32(q.n) catch " $OldError " { }\n"
    assert migrate("f", src5, r) == "z := try q.n.Narrow<I32>() catch NumberError { }\n"
}

test "what is not mechanical is listed and left as it was, and a second run changes nothing" {
    r := Result()
    src := "a := " $Word " (x + y)\n" $Word " g[1] = 5\n"
    assert migrate("f", src, r) == src
    assert r.left.Len() == 2 and r.left[0].StartsWith("f:1:") and r.left[1].StartsWith("f:2:")
    r2 := Result()
    done := migrate("f", "x := " $Word " a[i]\n", r2)
    r3 := Result()
    assert migrate("f", done, r3) == done and r3.changes == 0
    # a word that only ends in it, and the word as a name, are left alone
    keep := "un" $Word " x\n" $Word " := true\n"
    assert migrate("f", keep, r3) == keep
}
