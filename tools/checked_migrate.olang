# checked_migrate - the checked keyword and CheckError removed (E15a, 2026-10-25, the user's call: "one error system:
# try"). What can be rewritten from the text alone is:
#
#     checked a[i]           ->  try a.Get(i)                 (E16d: fails with ArrayError.OutOfRange)
#     checked a[lo:hi]       ->  try a.SliceOf(lo, hi)        (E16c; an absent bound 0 or a.Len())
#     checked T(x)           ->  try x.Narrow<T>()            (E26b: NumberError.Overflow and INVALID), T a number
#     checked f(x)           ->  try f(x)                     (D17: a contract is checked on entry, ArgumentError.Invalid)
#     (checked ...)!         ->  ...!                         the same, with "!" in place of the try
#
# The try is parenthesized - "(try a.Get(n))" - where an operator goes on after it: checked bound as tightly as old
# "try", and a try now reads to the end of its expression, so "2 * checked a[n] + 1" is "2 * (try a.Get(n)) + 1". And
# CheckError's words are renamed where they name what such a rewrite now fails with: OUT_OF_BOUNDS is
# ArrayError.OutOfRange, OVERFLOW and INVALID of a narrowing NumberError's, WRONG_CASE CaseError's, CONTRACT
# ArgumentError.Invalid. Everything else - "checked (a + b)", a checked store or step, a checked call to a Checked form,
# CheckError left over - is listed for a person: arithmetic that must not overflow goes through std/arith (try
# arith.Checked(a) + b, try arith.Add(a, b)), and an "as" fails as written now (try e as C, (e as C)!), which the
# compiler says where it is not handled. checked also checked every operation inside its operand, so one whose operand
# holds more than the operation rewritten - "checked a[i - K]", "checked I32(x * x)" - is rewritten for that one and
# listed for the rest. Files are rewritten in place; --check writes nothing and the exit status says whether anything
# would change. Running it again changes nothing.
#
#     $OLANG build tools/checked_migrate.olang && build/tools_checked_migrate [--check] [-v] FILE|DIR...

import "std/os"
import "srcmask"

# the word, written in two pieces so that the tool run over itself changes nothing
Word String& = "check" "ed"
OldError String& = "Check" "Error"

Numbers Array<String&> = String&["I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F16", "BF16", "F32", "F64"]

type Result struct() {
    changes I64 = 0
    left Vec<String&>
}

fn isNumber(t String&) Bool {
    for n in Numbers {
        if n == t { return true }
    }
    return false
}

# the end of a name starting at i, i itself where none starts there
fn nameEnd(src String&, i I64) I64 {
    if i >= src.Len() or not srcmask.IsIdStart(src[i]) { return i }
    j := i + 1
    for j < src.Len() and srcmask.IsWord(src[j]) { j++ }
    return j
}

# a postfix chain from i - a name or a number, then ".name", "(...)" and "[...]" - as its parts' starts and the end;
# empty where none starts at i
fn chain(src String&, mask String&, i I64) Vec<I64> {
    parts Vec<I64>
    j := nameEnd(src, i)
    if j == i {
        for j < src.Len() and (src[j].IsDigit() or src[j] == '_' or src[j] == '.') { j++ }
        if j == i { return parts }
    }
    parts.Push(i)
    for j < src.Len() {
        c := src[j]
        if c == '.' and nameEnd(src, j + 1) > j + 1 {
            parts.Push(j)
            j = nameEnd(src, j + 1)
        } else if (c == '(' or c == '[') and mask[j] == 'c' {
            k := srcmask.CloseOf(src, mask, j)
            if k < 0 { break }
            parts.Push(j)
            j = k
        } else {
            break
        }
    }
    parts.Push(j)
    return parts
}

# where in src[a:b] a character c stands outside every bracket, -1 for nowhere
fn topLevel(src String&, mask String&, a I64, b I64, c Char) I64 {
    depth I64 = 0
    for k in range a, b {
        if mask[k] != 'c' { continue }
        x := src[k]
        if x == '(' or x == '[' or x == '{' {
            depth++
        } else if x == ')' or x == ']' or x == '}' {
            depth--
        } else if x == c and depth == 0 {
            return k
        }
    }
    return -1
}

# whether a chain is a simple operand to put before a method call: a name or a chain of parts, nothing to group
fn simple(src String&) Bool {
    for k in range src.Len() {
        c := src[k]
        if not (srcmask.IsWord(c) or c == '.' or c == '(' or c == ')' or c == '[' or c == ']' or c == ',' or c == ' ') { return false }
    }
    return true
}

# the operand rewritten - "try"'s, without the "try" - and what it now fails with ("ArrayError", "NumberError"); ""
# where it is not one this tool rewrites
fn rewrite(src String&, mask String&, parts Vec<I64>&) String, String {
    n := parts.Len()
    end := parts[n - 1]
    last := parts[n - 2]
    if src[last] == '[' {
        base := src[parts[0]:last]
        # T[...] after a type's name is an array literal or a comprehension, no index
        if n == 3 and base[0].IsUpper() { return "", "" }
        inner := srcmask.Strip(src[last + 1:end - 1])
        colon := topLevel(src, mask, last + 1, end - 1, ':')
        if colon >= 0 {
            lo := srcmask.Strip(src[last + 1:colon])
            hi := srcmask.Strip(src[colon + 1:end - 1])
            if lo.Len() == 0 { lo = "0" }
            if hi.Len() == 0 { hi = $base ".Len()" }
            return $base ".SliceOf(" $lo ", " $hi ")", "ArrayError"
        }
        if topLevel(src, mask, last + 1, end - 1, ',') >= 0 or inner.Len() == 0 { return "", "" }
        return $base ".Get(" $inner ")", "ArrayError"
    }
    if n == 3 and src[last] == '(' and isNumber(src[parts[0]:last]) {
        x := srcmask.Strip(src[last + 1:end - 1])
        if x.Len() == 0 or topLevel(src, mask, last + 1, end - 1, ',') >= 0 { return "", "" }
        t := src[parts[0]:last]
        if simple(x) and chainCovers(x) { return $x ".Narrow<" $t ">()", "NumberError" }
        return $"(" $x ").Narrow<" $t ">()", "NumberError"
    }
    # a checked call of a function with a contract (D17): its requirements are checked on entry now, failing with
    # ArgumentError.Invalid, so it is tried as any call that can fail is - Pow's checked form is std/arith's, by hand
    if src[last] == '(' and not src[parts[0]:last].EndsWith(".Pow") { return $src[parts[0]:end], "ArgumentError" }
    return "", ""
}

# whether the operand src[a:b] of a checked holds an operation it checked besides its outermost one (parts' last):
# arithmetic, a shift, a negation, a conversion, an index or an "as" - checked once, and no longer by what replaces it
fn innerChecks(src String&, mask String&, a I64, b I64, parts Vec<I64>&) Bool {
    return checksIn(src, mask, a, b, parts[parts.Len() - 2], parts[0])
}

# whether src[a:b] holds an operation checked checked: as innerChecks, the index at last and a conversion at first not
# counted (-1 for none)
fn checksIn(src String&, mask String&, a I64, b I64, last I64, first I64) Bool {
    for k in range a, b {
        if mask[k] != 'c' { continue }
        ch := src[k]
        if ch == '[' and k != last { return true }
        if ch == '+' or ch == '*' or ch == '/' or ch == '%' { return true }
        if (ch == '<' or ch == '>') and k + 1 < b and src[k + 1] == ch { return true }
        if ch == '-' {
            # a minus before a literal written after an operator, or at the start, is the literal's sign
            q := k
            for q > a and src[q - 1] == ' ' { q-- }
            sign := q == a or not (srcmask.IsWord(src[q - 1]) or src[q - 1] == ')' or src[q - 1] == ']')
            if not (sign and k + 1 < b and src[k + 1].IsDigit()) { return true }
        }
        if srcmask.IsIdStart(ch) and (k == a or not srcmask.IsWord(src[k - 1])) {
            e := nameEnd(src, k)
            word := src[k:e]
            if word == "as" { return true }
            if isNumber(word) and e < b and src[e] == '(' and k != first { return true }
        }
    }
    return false
}

# "(CHAIN as T)" at o, with nothing in CHAIN checked checked: "CHAIN as T" and the index past ")"; "" where o holds none
fn asOperand(src String&, mask String&, o I64) String, I64 {
    if o >= src.Len() or src[o] != '(' { return "", -1 }
    close := srcmask.CloseOf(src, mask, o)
    if close < 0 { return "", -1 }
    ps := chain(src, mask, o + 1)
    if ps.Len() == 0 { return "", -1 }
    ce := ps[ps.Len() - 1]
    if not src[ce:].StartsWith(" as ") { return "", -1 }
    te := ce + 4
    for te < close - 1 and (srcmask.IsWord(src[te]) or src[te] == '.' or src[te] == '&' or src[te] == '?' or src[te] == '<' or
        src[te] == '>' or src[te] == ',' or src[te] == ' ') { te++ }
    if te != close - 1 or checksIn(src, mask, o + 1, ce, -1, -1) { return "", -1 }
    return $src[o + 1:close - 1], close
}

# whether text is one postfix chain alone - "a.b[i]", "f(x)" - so a method call after it applies to all of it
fn chainCovers(x String&) Bool {
    m := srcmask.Mask(x, true)
    ps := chain(x, m, 0)
    return ps.Len() > 0 and ps[ps.Len() - 1] == x.Len()
}

# CheckError's words in seg renamed for what a rewrite there fails with: kind "ArrayError" or "NumberError", "" for none
fn renameWords(seg String&, kind String&, c mut Result&) String {
    if kind.Len() == 0 { return $seg }
    s := $seg
    pairs := String&[$OldError ".OUT_OF_BOUNDS", "ArrayError.OutOfRange", $OldError ".WRONG_CASE", "CaseError.WrongCase"
                     $OldError ".OVERFLOW", "NumberError.Overflow", $OldError ".INVALID", "NumberError.Invalid"]
    if kind == "ArgumentError" {
        contract := $OldError ".CONTRACT"
        for s.Contains(contract) {
            s = s.Replace(contract, "ArgumentError.Invalid")
            c.changes++
        }
    }
    for k in range 0, pairs.Len(), 2 {
        if pairs[k + 1].StartsWith("NumberError") and kind != "NumberError" { continue }
        for s.Contains(pairs[k]) {
            s = s.Replace(pairs[k], pairs[k + 1])
            c.changes++
        }
    }
    if kind.Len() > 0 {
        bare := $OldError " "
        if s.Contains("catch " $bare) {
            s = s.Replace("catch " $bare, "catch " $kind " ")
            c.changes++
        }
    }
    return s
}

# where the statement holding position i ends: the end of the line, or of a later one while the next begins "catch"
fn statementEnd(src String&, i I64) I64 {
    j := i
    for {
        e := try src[j:].FindByte('\n') catch default (src.Len() - j)
        j += e
        if j >= src.Len() { return src.Len() }
        rest := srcmask.StripStart(src[j + 1:])
        if not rest.StartsWith("catch") { return j }
        j++
    }
}

fn lineOf(src String&, i I64) I64 {
    n I64 = 1
    for k in range i {
        if src[k] == '\n' { n++ }
    }
    return n
}

# src migrated: each checked rewritten where the text says what it is, the rest listed in c.left as "LINE: text"
fn migrate(path String&, src String&, c mut Result&) String {
    mask := srcmask.Mask(src, true)
    br := srcmask.Brackets(src, mask)
    out := StringBuilder()
    at I64 = 0
    i I64 = 0
    renameTo I64 = -1      # where a rewrite's statement ends, its CheckError words renamed up to there
    kind := ""
    for i < src.Len() {
        if renameTo >= 0 and i >= renameTo {
            out.Push(renameWords(src[at:renameTo], kind, c))
            at = renameTo
            renameTo = -1
        }
        if mask[i] != 'c' or not src[i:].StartsWith(Word) or (i > 0 and srcmask.IsWord(src[i - 1])) {
            i++
            continue
        }
        w := i + Word.Len()
        if w >= src.Len() or src[w] != ' ' {
            i++
            continue
        }
        parts := chain(src, mask, w + 1)
        if parts.Len() == 0 {
            # "checked (x as C)": the as failed into its clauses, as "try x as C" does now - where nothing else in it was
            # checked
            ax, close := asOperand(src, mask, w + 1)
            if ax.Len() > 0 {
                bang := i > 0 and src[i - 1] == '(' and src[close:].StartsWith(")!")
                out.Push(renameWords(src[at:i - 1 if bang else i], kind if renameTo >= 0 else "", c))
                if bang {
                    out.Push("(" $ax ")!")
                    at = close + 2
                } else {
                    n := srcmask.SkipGap(src, mask, br, close)
                    wrap := srcmask.OpAt(src[n:]).Len() > 0
                    out.Push("(try " $ax ")" if wrap else "try " $ax)
                    at = close
                }
                c.changes++
                kind = "CaseError"
                renameTo = statementEnd(src, close)
                i = at
                continue
            }
            if src[w + 1] == '(' { c.left.Push($path ":" $lineOf(src, i) ": " $srcmask.Strip(lineText(src, i))) }
            i++
            continue
        }
        endOp := parts[parts.Len() - 1]
        after := srcmask.StripStart(src[endOp:])
        store := (after.StartsWith("=") and not after.StartsWith("==")) or after.StartsWith("+=") or after.StartsWith("-=") or
            after.StartsWith("*=") or after.StartsWith("++") or after.StartsWith("--")
        op, k := rewrite(src, mask, parts)
        if store or op.Len() == 0 {
            c.left.Push($path ":" $lineOf(src, i) ": " $srcmask.Strip(lineText(src, i)))
            i = endOp
            continue
        }
        # E15a checked every operation of its operand; what is written now checks the outermost one alone
        if innerChecks(src, mask, w + 1, endOp, parts) {
            c.left.Push($path ":" $lineOf(src, i) ": " $Word " also checked the operations inside it - arithmetic, a conversion, an index, an 'as' - which " $op " does not; check those that must not fail with std/arith, Narrow and Get: " $srcmask.Strip(lineText(src, i)))
        }
        bang := i > 0 and src[i - 1] == '(' and src[endOp:].StartsWith(")!")
        segEnd := i - 1 if bang else i
        out.Push(renameWords(src[at:segEnd], kind if renameTo >= 0 else "", c))
        if bang {
            out.Push(op)
            out.Push("!")
            at = endOp + 2
        } else {
            # it bound as tightly as old "try", which a try now reads on past: where an operator goes on after it, the
            # try is parenthesized - "2 * " Word " a[n] + 1" multiplied what it gave
            n := srcmask.SkipGap(src, mask, br, endOp)
            wrap := srcmask.OpAt(src[n:]).Len() > 0
            if wrap { out.Push("(") }
            out.Push("try ")
            out.Push(op)
            if wrap { out.Push(")") }
            at = endOp
        }
        c.changes++
        kind = k
        renameTo = statementEnd(src, endOp)
        i = at
    }
    if renameTo >= 0 {
        out.Push(renameWords(src[at:renameTo], kind, c))
        at = renameTo
    }
    out.Push(src[at:])
    res := out.ToString()
    # CheckError's WRONG_CASE is CaseError's wherever it is written; whatever else of it is left is listed
    if res.Contains($OldError ".WRONG_CASE") {
        res = res.Replace($OldError ".WRONG_CASE", "CaseError.WrongCase")
        c.changes++
    }
    rm := srcmask.Mask(res, true)
    j I64 = 0
    for j < res.Len() {
        k := try res[j:].Find(OldError) catch default -1
        if k < 0 { break }
        if rm[j + k] == 'c' { c.left.Push($path ":" $lineOf(res, j + k) ": " $srcmask.Strip(lineText(res, j + k))) }
        j += k + OldError.Len()
    }
    return res
}

fn lineText(src String&, i I64) String&src {
    a := i
    for a > 0 and src[a - 1] != '\n' { a-- }
    b := try src[i:].FindByte('\n') catch default (src.Len() - i)
    return src[a:i + b]
}

fn main() ? {
    check := false
    verbose := false
    paths Vec<String&>
    args := os.Args()
    for i in range 1, args.Len() {
        a := args[i]
        if a == "--check" {
            check = true
        } else if a == "-v" {
            verbose = true
        } else {
            paths.Push($a)
        }
    }
    if paths.Len() == 0 {
        srcmask.SayErr("usage: tools_checked_migrate [--check] [-v] FILE|DIR...")
        os.Exit(2)
    }
    files Vec<String&>
    for p in paths {
        if os.IsDir(p) { srcmask.Walk(p, files) } else { files.Push($p) }
    }
    total := Result()
    changed I64 = 0
    for path in files {
        src := try srcmask.ReadText(path) catch {
            srcmask.SayErr("checked_migrate: cannot read " $path)
            os.Exit(1)
            unreachable
        }
        before := total.changes
        out := migrate(path, src, total)
        if out == src or total.changes == before { continue }
        changed++
        if verbose { srcmask.Say(path) }
        if not check {
            try os.WriteFile(path, out) catch {
                srcmask.SayErr("checked_migrate: cannot write " $path)
                os.Exit(1)
            }
        }
    }
    verb := "would change " if check else "changed "
    srcmask.Say($verb $changed " files: " $total.changes " rewrites")
    for l in total.left { srcmask.Say("by hand: " $l) }
    if check and changed > 0 { os.Exit(1) }
}

test "an index, a slice and a narrowing rewritten, their errors renamed" {
    r := Result()
    src := "x := " $Word " a[i + 1] catch " $OldError ".OUT_OF_BOUNDS default 0\n"
    assert migrate("f", src, r) == "x := try a.Get(i + 1) catch ArrayError.OutOfRange default 0\n"
    src2 := "s := " $Word " b.c[2:] catch default d\n"
    assert migrate("f", src2, r) == "s := try b.c.SliceOf(2, b.c.Len()) catch default d\n"
    src3 := "n := " $Word " U8(v + 1)\n    catch " $OldError ".OVERFLOW { }\n"
    assert migrate("f", src3, r) == "n := try (v + 1).Narrow<U8>()\n    catch NumberError.Overflow { }\n"
    src4 := "y := (" $Word " a[0])! + 1\n"
    assert migrate("f", src4, r) == "y := a.Get(0)! + 1\n"
    lit := "w := " $Word " I32[x * 2 for x in l]\n"
    assert migrate("f", lit, r) == lit
    src6 := "w := " $Word " f(a, b) catch " $OldError ".CONTRACT default 0\n"
    assert migrate("f", src6, r) == "w := try f(a, b) catch ArgumentError.Invalid default 0\n"
    src5 := "z := " $Word " I32(q.n) catch " $OldError " { }\n"
    assert migrate("f", src5, r) == "z := try q.n.Narrow<I32>() catch NumberError { }\n"
}

test "what is not mechanical is listed and left as it was, and a second run changes nothing" {
    r := Result()
    src := "a := " $Word " (x + y)\n" $Word " g[1] = 5\n"
    assert migrate("f", src, r) == src
    assert r.left.Len() == 2 and r.left[0].StartsWith("f:1:") and r.left[1].StartsWith("f:2:")
    r2 := Result()
    done := migrate("f", "x := " $Word " a[i]\n", r2)
    r3 := Result()
    assert migrate("f", done, r3) == done and r3.changes == 0
    # a word that only ends in it, and the word as a name, are left alone
    keep := "un" $Word " x\n" $Word " := true\n"
    assert migrate("f", keep, r3) == keep
}

test "a try written inside an operator expression is parenthesized, and the checks it no longer makes listed" {
    r := Result()
    assert migrate("f", "    x := 2 * " $Word " a[n] + 1\n", r) == "    x := 2 * (try a.Get(n)) + 1\n" and r.left.Len() == 0
    assert migrate("f", "    x := " $Word " a[n] catch default 0\n", r) == "    x := try a.Get(n) catch default 0\n"
    assert migrate("f", "    x := (" $Word " a[n]\n        + 1)\n", r) == "    x := ((try a.Get(n))\n        + 1)\n"
    assert migrate("f", "    v := " $Word " a[i - K] catch default -1\n", r) == "    v := try a.Get(i - K) catch default -1\n"
    assert r.left.Len() == 1
    assert migrate("f", "    v := " $Word " I32(x * x) catch default -1\n", r) == "    v := try (x * x).Narrow<I32>() catch default -1\n"
    assert r.left.Len() == 2
    assert migrate("f", "    v := " $Word " a[b[i]]\n", r) == "    v := try a.Get(b[i])\n" and r.left.Len() == 3
    # a sign, a plain name, a call's arguments that compute nothing: nothing more was checked
    assert migrate("f", "    v := " $Word " a[-1] + " $Word " g(x, y)\n", r) == "    v := (try a.Get(-1)) + try g(x, y)\n" and r.left.Len() == 3
}

test "a checked 'as' is the try of today, where nothing else in it was checked" {
    r := Result()
    assert migrate("f", "    r := " $Word " (s as Shape.Circle) catch default -1.0\n", r) == "    r := try s as Shape.Circle catch default -1.0\n"
    assert migrate("f", "    r := " $Word " (s as Shape.Circle) catch " $OldError ".WRONG_CASE default -1.0\n", r) == "    r := try s as Shape.Circle catch CaseError.WrongCase default -1.0\n"
    assert migrate("f", "    r := 2.0 * " $Word " (a.s as Shape.Circle) + 1.0\n", r) == "    r := 2.0 * (try a.s as Shape.Circle) + 1.0\n"
    assert migrate("f", "    r := (" $Word " (s as Shape.Circle))!\n", r) == "    r := (s as Shape.Circle)!\n"
    assert r.left.Len() == 0
    t := "    r := " $Word " (s[i + 1] as Shape.Circle) catch default -1.0\n"
    assert migrate("f", t, r) == t and r.left.Len() == 1
}
