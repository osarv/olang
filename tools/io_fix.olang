# Drives a file to compile after io_try: builds it, and from the compiler's own errors adds `?`/`+ io.Error` to a function
# whose try lets io.Error escape (R9), `try` to a call of a function that can now fail (E15), and `catch io.Error { }` to
# a tried call in a test block or where nothing can fail (R13). Prints what it could not fix.
#
#     $OLANG build tools/io_fix.olang && build/tools_io_fix OLANG FILE...
#
# OLANG is the compiler to build with, as a path (a relative one is made absolute: the builds run in a directory of their
# own). A file with tests is built with -t, one with a main with -b, any other with -c; the build directories are kept under
# $TMPDIR (else /tmp) in olang_io_fix/, one per file, so the prelude is compiled once. Only files that import std/io are
# touched.
#
# A port of the Python script of the same name (same arguments, same edits, same output, which ends with the counts as a
# Python dict would print them). The files it writes get Python's text-mode newlines ("\r\n" and "\r" become "\n").

import "std/os"
import "srcmask"

# how many of each fix were made
SigFixes mut I64 = 0
TryFixes mut I64 = 0
CatchFixes mut I64 = 0

# whether the line starts with the word - not just with its letters
fn startsWord(line String&, word String&) Bool {
    return line.StartsWith(word) and (line.Len() == word.Len() or not srcmask.IsWord(line[word.Len()]))
}

# whether some line of src starts with the word
fn anyLineStartsWord(src String&, word String&) Bool {
    for line in src.Split("\n") {
        if startsWord(line, word) { return true }
    }
    return false
}

# the output of building path: stdout, then stderr, in a directory of its own
fn build(olang String&, path String&, src String&) String {
    mode := "compile"
    if anyLineStartsWord(src, "test") {
        mode = "test"
    } else if anyLineStartsWord(src, "fn main") {
        mode = "build"
    }
    munged := StringBuilder()
    for c in path {
        munged.PushChar(c if srcmask.IsWord(c) else '_')
    }
    tmp := try os.Env("TMPDIR") catch default ""
    dir := $(tmp if tmp.Len() > 0 else "/tmp") "/olang_io_fix/" $munged.ToString()
    try os.MkDirAll(dir) catch {
        srcmask.SayErr("io_fix: cannot make " $dir)
        os.Exit(1)
    }
    args := String&[olang, mode, srcmask.AbsPath(path)]
    return try srcmask.Capture(args, dir, 600000) catch {
        srcmask.SayErr("io_fix: " $olang " " $mode " " $path " did not run to its end")
        os.Exit(1)
        unreachable
    }
}

# what parseDiag fails with: the row is no compiler error
type notDiag error {
    ROW
}

# a compiler error row "PATH:LINE:COL: error[RULE]: MESSAGE" as its parts, or notDiag.ROW for any other row
fn parseDiag(row String&) String, I64, I64, String, String ? {
    n := row.Len()
    for k in range 1, n {
        if srcmask.IsPySpace(row[k - 1]) { break }
        if row[k] != ':' { continue }
        a := k + 1
        b := a
        for b < n and row[b].IsDigit() { b++ }
        if b == a or b >= n or row[b] != ':' { continue }
        c := b + 1
        d := c
        for d < n and row[d].IsDigit() { d++ }
        if d == c or not row[d:].StartsWith(": error[") { continue }
        e := d + 8
        f := e
        for f < n and srcmask.IsWord(row[f]) { f++ }
        if f == e or not row[f:].StartsWith("]: ") { continue }
        return $row[:k], (try row[a:b].ParseInt()), (try row[c:d].ParseInt()), $row[e:f], $row[f + 3:]
    }
    error notDiag.ROW
}

# the index of the line that opens the top-level item containing line ln: one starting fn, test, type or extern
fn container(lines Array<String&>&, ln I64) I64 {
    k := ln
    for k >= 0 and not (startsWord(lines[k], "fn") or startsWord(lines[k], "test") or startsWord(lines[k], "type")
                        or startsWord(lines[k], "extern")) {
        k--
    }
    return k
}

# whether the line has "fn(" with something other than a word character before it
fn hasFnParen(line String&) Bool {
    for i in range line.Len() {
        if line[i:].StartsWith("fn(") and (i == 0 or not srcmask.IsWord(line[i - 1])) { return true }
    }
    return false
}

# the last index of c in t, or -1
fn lastIndex(t String&, c Char) I64 {
    i := t.Len() - 1
    for i >= 0 and t[i] != c { i-- }
    return i
}

# one round of fixes to path's lines: 1 when it changed one, 2 when it gave up on the file (having said why), else 0.
# Prints what it could not do
fn fixRound(path String&, alias String&, errs Array<String&>&, lines mut Array<String&>&) I32 {
    for row in errs {
        p, line, col, code, msg := try parseDiag(row) catch { continue }
        if srcmask.AbsPath(p) != srcmask.AbsPath(path) { continue }
        ln := line - 1
        at := col - 1
        if ln < 0 or ln >= lines.Len() or at < 0 or at > lines[ln].Len() { continue }
        if code == "E15" {
            lines[ln] = $lines[ln][:at] "try " $lines[ln][at:]
            TryFixes++
            return 1
        }
        if code != "R9" and code != "R13" { continue }
        k := container(lines, ln)
        if k < 0 {
            srcmask.Say("MANUAL " $path " " $(ln + 1) " " $srcmask.Prefix(msg, 60))
            continue
        }
        head := lines[k]
        inner := head.StartsWith("test") or head.StartsWith("type") or code == "R13"
        for j in range k + 1, ln + 1 {
            if hasFnParen(lines[j]) { inner = true }
        }
        if not inner and head.StartsWith("fn ") {
            # the signature: before the opening brace of the body
            j := k
            for j < lines.Len() and not ("{" in lines[j]) { j++ }
            if j >= lines.Len() { continue }
            b := lastIndex(lines[j], '{')
            pre := $srcmask.StripEnd(lines[j][:b])
            paren := lastIndex(pre, ')')
            tail := $(pre[paren + 1:] if paren >= 0 else pre[:])
            named := msg.StartsWith("Error ")
            if "?" in tail {
                if not named {
                    srcmask.Say("MANUAL " $path " " $(ln + 1) " " $srcmask.Prefix(msg, 60))
                    return 2
                }
                if srcmask.Strip(tail).EndsWith("?") {
                    pre = $pre " " $alias ".Error"
                } else if tail.Contains($alias ".Error") {
                    srcmask.Say("STUCK " $path " " $(ln + 1))
                    return 2
                } else {
                    pre = $pre " + " $alias ".Error"
                }
            } else {
                pre = $pre " ?" $(" " $alias ".Error" if named else "")
            }
            lines[j] = $pre " " $lines[j][b:]
            SigFixes++
            return 1
        }
        text := lines[ln]
        mask := srcmask.Mask(text, false)
        depth I64 = 0
        end I64 = -1
        i := at
        for i < text.Len() and text[i] != '(' { i++ }
        for i < text.Len() {
            if mask[i] == 'c' {
                if text[i] == '(' {
                    depth++
                } else if text[i] == ')' {
                    depth--
                    if depth == 0 {
                        end = i + 1
                        break
                    }
                }
            }
            i++
        }
        if end > 0 and not srcmask.StripStart(text[end:]).StartsWith("catch") {
            lines[ln] = $text[:end] " catch " $alias ".Error { }" $text[end:]
            CatchFixes++
            return 1
        }
        srcmask.Say("MANUAL " $path " " $(ln + 1) " " $srcmask.Prefix(msg, 60))
    }
    return 0
}

# builds path again and again, fixing what the compiler says, until nothing is left to fix
fn fixFile(olang String&, path String&, alias String&) {
    for _ in range 40 {
        src := try srcmask.ReadText(path) catch {
            srcmask.SayErr("io_fix: cannot read " $path)
            os.Exit(1)
            unreachable
        }
        errs := build(olang, path, src).Split("\n")
        lines := src.Split("\n")
        outcome := fixRound(path, alias, errs, lines)
        if outcome != 1 {
            if outcome == 0 {
                for row in errs {
                    p, line, _, code, msg := try parseDiag(row) catch { continue }
                    if srcmask.AbsPath(p) != srcmask.AbsPath(path) { continue }
                    if code != "R9" and code != "R13" and code != "E15" {
                        srcmask.Say("OTHER " $path " " $line " " $code " " $srcmask.Prefix(msg, 70))
                    }
                }
            }
            return
        }
        try os.WriteFile(path, lines.Join("\n")) catch {
            srcmask.SayErr("io_fix: cannot write " $path)
            os.Exit(1)
        }
    }
}

fn main() ? {
    args := os.Args()
    if args.Len() < 2 {
        srcmask.SayErr("usage: build/tools_io_fix OLANG FILE...")
        os.Exit(2)
    }
    olang := srcmask.AbsPath(args[1])
    for i in range 2, args.Len() {
        text := try srcmask.ReadText(args[i]) catch {
            srcmask.SayErr("io_fix: cannot read " $args[i])
            os.Exit(1)
            unreachable
        }
        alias := try srcmask.IoAlias(text, args[i]) catch { continue }
        fixFile(olang, args[i], alias)
    }
    srcmask.Say("{'sig': " $SigFixes ", 'try': " $TryFixes ", 'catch': " $CatchFixes "}")
}
