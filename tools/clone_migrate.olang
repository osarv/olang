# clone_migrate - "x.Clone()" becomes "x.Copy()": Clone left the language in the Copy batch (2026-11-03, SPEC.md E31d) -
# Copy() is the one method making a new value from an existing one, supplied for every type (field by field, deep
# through values, shared at references) and declared by a type that copies otherwise. An array's Clone() was its copy,
# which Copy() is.
#
# One meaning changes, and is listed for a person rather than rewritten silently: std/list's List is a handle, so its
# Copy() is a second name for the same list where its Clone() was a list of its own - write "list.From(l.Iter())" for
# that. A file importing std/list has each line it rewrote listed (status 1 then), since only a person can tell a List's
# Clone() from an array's. A type may still declare a method named Clone (oann's Tensor and Matrix do: a deep copy, where
# the supplied Copy() shares at references), and a call of it is no supplied Clone: a file declaring one, or importing
# a module of the files given that does, is left as it is, its ".Clone()" lines listed for a person (status 1) - only
# the compiler knows which receiver a call has. Code only: comments and literals are left alone. Re-runnable: a file
# with no ".Clone()" changes nothing.
#
#     olang build tools/clone_migrate.olang && build/tools_clone_migrate FILE...    rewrites the files, naming each one changed

import "std/os"
import "std/io"
import "srcmask"

fn main() ? io.Error {
    args := os.Args()
    texts Vec<String>
    for k in range 1, args.Len() {
        texts.Push(try os.ReadFile(args[k]) catch os.Error {
            try io.PutErrLine("clone_migrate: " + $args[k] + ": cannot be read")
            texts.Push("")
            continue
        })
    }
    # the modules among the files given that declare a Clone() of their own, by their names as an import names them
    owners Vec<String>
    for k in range 1, args.Len() {
        if declaresClone(texts[k - 1]): owners.Push(moduleName(args[k]))
    }
    listed := 0
    for k in range 1, args.Len() {
        path := args[k]
        text := texts[k - 1]
        if text.Len() == 0: continue
        if owners.Len() > 0 and (declaresClone(text) or importsAny(text, owners)) {
            for n in cloneLines(text) {
                if listed == 0: try io.PutErrLine("for a person: these call a Clone(), and a module here declares one of its own - Copy() is the supplied one, shared at references:")
                try io.PutErrLine("  " + $path + ":" + $n)
                listed++
            }
            continue
        }
        out := migrate(text)
        if out == text: continue
        try os.WriteFile(path, out) catch os.Error { try io.PutErrLine("clone_migrate: " + $path + ": cannot be written") }
        try io.PutLine(path)
        if not text.Contains("\"std/list\""): continue
        for n in changedLines(text, out) {
            if listed == 0: try io.PutErrLine("for a person: a list.List's Clone() was a list of its own, its Copy() names the same list - write list.From(l.Iter()) where a List is meant:")
            try io.PutErrLine("  " + $path + ":" + $n)
            listed++
        }
    }
    if listed > 0: os.Exit(1)
}

# the text with every ".Clone()" in code written ".Copy()"
fn migrate(text String&) String {
    mask := srcmask.Mask(text, false)
    b := StringBuilder()
    i I64 = 0
    for i < text.Len() {
        if mask[i] == 'c' and text[i:].StartsWith(".Clone()") and (i + 8 >= text.Len() or not srcmask.IsWord(text[i + 8])) {
            b.Push(".Copy()")
            i += 8
            continue
        }
        b.PushChar(text[i])
        i++
    }
    return b.ToString()
}

# whether text declares a method named Clone ("fn (t Tensor<T>&) Clone() Tensor<T>"), in code
fn declaresClone(text String&) Bool {
    for l in text.Lines() {
        t := srcmask.StripStart(l)
        if not t.StartsWith("fn ("): continue
        close := try t.Find(") Clone(") catch { continue }
        if not t[4:close].Contains(")"): return true
    }
    return false
}

# the name an import gives a file: its base name without ".olang"
fn moduleName(path String&) String {
    b := path[(try path.FindLast("/") catch default -1) + 1:]
    return $(b[:b.Len() - 6] if b.EndsWith(".olang") else b)
}

# whether text imports a module named one of names (the last part of its path)
fn importsAny(text String&, names Vec<String>&) Bool {
    for l in text.Lines() {
        if not l.StartsWith("import "): continue
        q := try l.Find("\"") catch { continue }
        e := try l[q + 1:].Find("\"") catch { continue }
        spec := l[q + 1:q + 1 + e]
        last := spec[(try spec.FindLast("/") catch default -1) + 1:]
        for n in names {
            if n == last: return true
        }
    }
    return false
}

# the line numbers (from 1) holding ".Clone()" in code
fn cloneLines(text String&) Vec<I64> {
    return changedLines(text, migrate(text))
}

# the line numbers (from 1) where two texts of as many lines differ
fn changedLines(a String&, b String&) Vec<I64> {
    xs := a.Split("\n")
    ys := b.Split("\n")
    out Vec<I64>
    for i in range xs.Len().Min(ys.Len()) {
        if xs[i] != ys[i]: out.Push(i + 1)
    }
    return out
}

test migrate "a Clone() in code becomes Copy(), comments and text left as they are" {
    assert migrate("b := a.Clone()\n") == "b := a.Copy()\n"
    assert migrate("# a.Clone() here\nx := \"y.Clone()\"\n") == "# a.Clone() here\nx := \"y.Clone()\"\n"
    assert migrate("c := f(a.Clone(), b.Clone())\n") == "c := f(a.Copy(), b.Copy())\n"
    assert migrate("x.CloneAll()\n") == "x.CloneAll()\n"
    assert migrate("x := 1\n") == "x := 1\n"
}

test changedLines "the lines a rewrite changed" {
    ns := changedLines("a\nb.Clone()\nc\n", "a\nb.Copy()\nc\n")
    assert ns.Len() == 1 and ns[0] == 2
}

test declaresClone "a type's own Clone is found; a call is no declaration" {
    assert declaresClone("type M struct() { }\nfn (m M&) Clone() M { return M() }\n")
    assert declaresClone("fn (t Tensor<T>&) Clone() Tensor<T> {\n")
    assert not declaresClone("fn f(a Array<I64>&) { b := a.Clone() }\n")
    assert not declaresClone("# fn (m M&) Clone() M\n")
}

test importsAny "an import is matched by its last part" {
    names := Vec<String>["tensor"]
    assert importsAny("import \"../tensor\"\nfn main() { }\n", names)
    assert importsAny("import t \"oann/tensor\"\n", names)
    assert not importsAny("import \"std/io\"\n", names) and moduleName("a/b/tensor.olang") == "tensor"
}
