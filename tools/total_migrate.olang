# total_migrate - a total is worked in T.Accumulator (G4a, G4b, G32, 2026-11-16): `Sum()`, `Product()` and `Cumsum()` left
# to the call are worked in the type a call is wanted as, else in the values' T.Accumulator - an Array<U8>'s sum is a U64,
# an Array<I32>'s an I64 - where they were worked, and wrapped, in the values' own type. Every such call whose type
# changed is given the type it had, from the compiler's own report (OLANG_TOTALS=1, check.totalSites):
#
#     b.Sum()                     ->  b.Sum<U8>()
#     xs.Iter().Product()         ->  xs.Iter().Product<I32>()
#     (a * a).Sum()               ->  (a * a).Sum<I16>()
#
# A call in a generic body whose instances were worked in different types is listed for a person. Each file is
# compiled (test when it has tests, compile otherwise) and the edits applied. Not in olang fix's table: run on code
# written since, it would undo what that code means - it is for code written before the change, once.
#
#     $OLANG build tools/total_migrate.olang && build/tools_total_migrate [--olang PATH] [-j N] FILE|DIR...
#
# For oann: build/tools_total_migrate --olang /home/user/olang/build/olang /home/user/oann

import "std/os"
import "srcmask"
import "diagedit"

# a line with the call whose name starts at column index at given the type argument ty; "" where it cannot be
fn rewriteAt(text String&, at I64, ty String&) String {
    if at < 0 or at >= text.Len() or not srcmask.IsWord(text[at]): return ""
    e := at
    for e < text.Len() and srcmask.IsWord(text[e]): e++
    if e >= text.Len() or text[e] != '(': return ""
    return $text[:e] + "<" + $ty + ">" + $text[e:]
}

# one report row, "totals: PATH:LINE:COL: TYPE", read; the type "" where the row is none
fn site(row String&) diagedit.Request {
    none := diagedit.Request("", 0, 0, "", "", "")
    if not row.StartsWith("totals: "): return none
    rest := row[8:]
    k := try rest.Find(": ") catch { return none }
    loc := rest[:k].Split(":")
    if loc.Len() < 3: return none
    line := try loc[loc.Len() - 2].ParseInt() catch default 0
    col := try loc[loc.Len() - 1].ParseInt() catch default 0
    path := loc[:loc.Len() - 2].Join(":")
    return diagedit.Request($path, line, col, "total", $rest[k + 2:], $row)
}

Taken mut I64 = 0

fn compileOne(olang String&, file String&, dir String&) String {
    src := try srcmask.ReadText(file) catch { return "" }
    mode := "test" if src.Contains("\ntest ") or src.StartsWith("test ") else "compile"
    return try srcmask.Capture(Array<String&>["env", "OLANG_TOTALS=1", olang, mode, file], dir, 900000) catch default ""
}

fn worker(olang String&, files Array<String&>&, dir String&, outputs mut Array<String&>&) {
    for {
        k := Taken.AtomicAdd(1)
        if k >= files.Len(): break
        outputs[k] = compileOne(olang, files[k], dir)
    }
}

fn main() ? {
    olang := srcmask.Compiler()
    jobs I64 = 3
    paths Vec<String&>
    args := os.Args()
    i I64 = 1
    for i < args.Len() {
        if (args[i] == "--olang" or args[i] == "-j") and i + 1 < args.Len() {
            if args[i] == "--olang" { olang = $args[i + 1] } else { jobs = try args[i + 1].ParseInt() catch default 3 }
            i += 2
            continue
        }
        paths.Push($args[i])
        i++
    }
    if paths.Len() == 0 {
        srcmask.SayErr("usage: build/tools_total_migrate [--olang PATH] [-j N] FILE|DIR...")
        os.Exit(2)
    }
    if jobs < 1: jobs = 1
    olang = $diagedit.RealPathOf(olang)
    files Vec<String&>
    diagedit.OlangFiles(paths, files)
    allowed Vec<String&>
    for p in paths: allowed.Push(diagedit.RealPathOf(p))
    tmp := try os.MkTemp("", "total_migrate") catch {
        srcmask.SayErr("total_migrate: cannot make a temporary directory")
        os.Exit(1)
        unreachable
    }
    defer: try os.RemoveAll(tmp) catch { }
    fileArray := files.ToArray()
    outputs mut Array<String&>& = Array<String&>(fileArray.Len())
    for k in range fileArray.Len(): outputs[k] = ""
    join {
        for w in range jobs {
            dir := $tmp + "/w" + $w
            try os.MkDirAll(dir) catch { }
            spawn worker(olang, fileArray, dir, outputs)
        }
    }
    requests Vec<diagedit.Request>
    for o in outputs {
        for row in o.Split("\n") {
            r := site(row)
            if r.Arg == "": continue
            full := diagedit.RealPathOf(r.Path)
            if diagedit.Allowed(full, allowed): requests.Push(diagedit.Request($full, r.Line, r.Col, r.Kind, r.Arg, r.Why))
        }
    }
    left Vec<String&>
    made := apply(requests, left)
    srcmask.Say("total: " + $made + " totals given the type they were worked in")
    for l in left: srcmask.Say("by hand: " + $l)
}

# the edits applied to their files, the rightmost on a line first; how many were made, what could not be in left
fn apply(requests Vec<diagedit.Request>&, left mut Vec<String&>&) I64 {
    paths Vec<String&>
    for r in requests {
        if not (r.Path in paths): paths.Push($r.Path)
    }
    made I64 = 0
    for path in paths {
        src := try srcmask.ReadText(path) catch { continue }
        lines := src.Split("\n")
        mine Vec<diagedit.Request>
        for r in requests {
            if r.Path == path: mine.Push(r)
        }
        mine.Sort(fn(a, b) {
            if a.Line != b.Line: return a.Line < b.Line
            return a.Col > b.Col
        })
        seen Vec<String&>
        changed := false
        for r in mine {
            key := $r.Line + ":" + $r.Col
            if key in seen or r.Line - 1 >= lines.Len(): continue
            seen.Push($key)
            out := rewriteAt(lines[r.Line - 1], r.Col - 1, r.Arg) if r.Arg != "?" else ""
            if out == "" {
                left.Push($path + ":" + $r.Line + ":" + $r.Col + ": " + $r.Arg)
                continue
            }
            lines[r.Line - 1] = $out
            changed = true
            made++
        }
        if changed: try os.WriteFile(path, lines.Join("\n")) catch { left.Push($path + ": not written") }
    }
    return made
}

test "a total's call given the type it was worked in" {
    assert rewriteAt("    t := b.Sum()", 11, "U8") == "    t := b.Sum<U8>()"
    assert rewriteAt("x := (a * a).Sum() + c.Iter().Product()", 30, "I32") == "x := (a * a).Sum() + c.Iter().Product<I32>()"
    assert rewriteAt("x := b.Sum<U8>()", 7, "U8") == ""
}

test "a report row read" {
    r := site("totals: /a/b.olang:12:9: U8")
    assert r.Path == "/a/b.olang" and r.Line == 12 and r.Col == 9 and r.Arg == "U8"
    assert site("a.olang:1:1: error[E39]: x").Arg == ""
}
