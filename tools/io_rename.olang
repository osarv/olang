# io_rename - std/io's printing functions renamed so that none shares a name with the prelude's Print and Println
# (M19d, M19f, 2026-11-13, the coordinator's call for the user's "no carveout" rule): io.Print becomes io.Put, io.Println
# io.PutLine, io.PrintErr io.PutErr, io.PrintErrln io.PutErrLine - every whole-word "io." followed by an old name, in code,
# comments and text alike, and the bare names inside std/io.olang itself. Same signatures, still failing with io.Error.
# Files are rewritten in place and a count printed; --check writes nothing and the exit status says whether anything
# would change. It reads .olang, .md, .txt and .want files. Idempotent.
#
#     $OLANG build tools/io_rename.olang && build/tools_io_rename [--check] [-v] FILE|DIR...

import "std/os"
import "srcmask"

type Count struct() { n I64 = 0 }

# every whole-word occurrence of from in src replaced by to; a word ends where no letter, digit or "_" follows, and
# with bare set none begins after a "." either
fn replaceWord(src String&, from String&, to String&, bare Bool, c mut Count&) String {
    out := StringBuilder()
    at I64 = 0
    i I64 = 0
    for i + from.Len() <= src.Len() {
        if src[i:i + from.Len()] == from {
            before := i == 0 or not (srcmask.IsWord(src[i - 1]) or (bare and src[i - 1] == '.'))
            after := i + from.Len() == src.Len() or not srcmask.IsWord(src[i + from.Len()])
            if before and after {
                out.Push(src[at:i])
                out.Push(to)
                i += from.Len()
                at = i
                c.n++
                continue
            }
        }
        i++
    }
    if at == 0 { return $src }
    out.Push(src[at:])
    return out.ToString()
}

# the old names, written in pieces so that the tool run over itself changes nothing
Olds Array<String&> = Array<String&>["Print" "ln", "Print" "Err" "ln", "Print" "Err", "Print"]
News Array<String&> = Array<String&>["PutLine", "PutErrLine", "PutErr", "Put"]

fn rename(src String&, path String&, c mut Count&) String {
    out := $src
    own := path.EndsWith("std/io.olang")
    for k in range Olds.Len() {
        out = replaceWord(out, "io." $Olds[k], "io." $News[k], false, c)
        if own { out = replaceWord(out, Olds[k], News[k], true, c) }
    }
    return out
}

# the files under a directory with one of the extensions read, build/ and .git/ left out
fn walk(dir String&, out mut Vec<String&>&) {
    names := try os.ReadDir(dir) catch default Array<String&>(0)
    for n in names {
        if n.StartsWith(".") or n == "build" { continue }
        p := srcmask.PathJoin(dir, n)
        if os.IsDir(p) {
            walk(p, out)
        } else if wanted(p) {
            out.Push($p)
        }
    }
}

fn wanted(path String&) Bool {
    return path.EndsWith(".olang") or path.EndsWith(".md") or path.EndsWith(".txt") or path.EndsWith(".want")
}

fn main() ? {
    check := false
    verbose := false
    paths Vec<String&>
    args := os.Args()
    for i in range 1, args.Len() {
        a := args[i]
        if a == "--check" {
            check = true
        } else if a == "-v" {
            verbose = true
        } else {
            paths.Push($a)
        }
    }
    if paths.Len() == 0 {
        srcmask.SayErr("usage: tools_io_rename [--check] [-v] FILE|DIR...")
        os.Exit(2)
    }
    files Vec<String&>
    for p in paths {
        if os.IsDir(p) { walk(p, files) } else { files.Push($p) }
    }
    total := Count()
    changed I64 = 0
    for path in files {
        if not wanted(path) { continue }
        src := try srcmask.ReadText(path) catch {
            srcmask.SayErr("io_rename: cannot read " $path)
            os.Exit(1)
            unreachable
        }
        out := rename(src, path, total)
        if out == src { continue }
        changed++
        if verbose { srcmask.Say(path) }
        if not check {
            try os.WriteFile(path, out) catch {
                srcmask.SayErr("io_rename: cannot write " $path)
                os.Exit(1)
            }
        }
    }
    verb := "would change " if check else "changed "
    srcmask.Say($verb $changed " files: " $total.n " names")
    if check and changed > 0 { os.Exit(1) }
}

test "io.Print and its kin become io.Put and its kin; a longer word and a bare name elsewhere are left" {
    n := Count()
    assert rename("    try io." "Println(\"a\")\n", "x.olang", n) == "    try io.PutLine(\"a\")\n"
    assert rename("io." "PrintErrln(t) io." "PrintErr(t) io." "Print(t)", "x.olang", n) == "io.PutErrLine(t) io.PutErr(t) io.Put(t)"
    src := "    Print" "ln(x)\n    myio." "Print(x)\n    io." "Printer := 1\n"
    assert rename(src, "x.olang", n) == src
    assert rename("fn Print" "ln(t String&) ? Error { try Print(t) }\nio." "Print(x)", "std/io.olang", n) == "fn PutLine(t String&) ? Error { try Put(t) }\nio.Put(x)"
    assert n.n == 7
}
