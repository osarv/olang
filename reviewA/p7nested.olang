import "std/io"

type Tally struct() {
    seen := Vec<I64>()
}

fn (t mut Tally&) Saw(id I64) { t.seen.Push(id) }

type Logged unique struct(id I64, log mut Tally&) {
    id, log
} destruct { log.Saw(id) }

fn churn() I64 {
    n := 0
    for i in range 300 {
        s := $i "-" $(i * 7)
        a := Array<I64>(64, -7)
        n += s.Len() + a[3]
    }
    return n
}

fn sum(t Tally&) I64 {
    s := 0
    for x in t.seen { s += x }
    return s
}
type Pair unique struct(a Logged, b Logged) {
    a, b
}

fn mkv(i I64, t mut Tally&) Vec<Logged> {
    v := Vec<Logged>()
    for k in range 5 { v.Push(Logged(i * 5 + k, t)) }
    return v
}

fn main() ? {
    t := Tally()
    {
        vv := Vec<Vec<Logged>>()
        for i in range 6 {
            vv.Push(mkv(i, t))
        }
        m := Map<I64, Pair>()
        for i in range 5 { m.Put(i, Pair(Logged(100 + i, t), Logged(200 + i, t))) }
        m.Remove(2)
        try vv.RemoveAt(1)
        vv.Truncate(2)
    }
    churn()
    assert t.seen.Len() == 40
    try io.Println($t.seen.Len() " " $sum(t))
}
