import "std/io"

type N struct(v I64) {
    v
    next N?& = null
}

fn link(a mut N&, b N&) { a.next = b }
fn noop(a mut N&, b N&) { }

fn churn(n I64) I64 {
    t := 0
    for i in range n {
        v := Vec<N>()
        for j in range 16 { v.Push(N(i * j)) }
        t += v[15].v
    }
    return t
}
fn apply(f fn&(a mut N&, b N&), a mut N&, v I64) { f(a, N(v)) }

fn main() ? {
    x mut N& = N(0)
    keep := Vec<N&>()
    k mut Vec<N&>& = keep
    {
        h := fn(a mut N&, b N&) {
            k.Push(b)
            a.next = b
        }
        for i in range 5 { apply(h, x, i) }
    }
    churn(200)
    assert x.next!.v == 4 and keep.Len() == 5 and keep[2].v == 2
    try io.Println($x.next!.v " " $keep[2].v)
}
