import "std/io"

N I64 = 2000000

fn mk(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 4 { w.Push(i + j) }
    return w
}

fn main() {
    rows := Array<Vec<I64>>(10)
    t := 0
    for i in range N {
        rows[i % 10] = mk(i)
        t += rows[i % 10][3]
    }
    io.PutLine($t + " " + $rows[3].Len())!
}
