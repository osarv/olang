import "std/io"

# O8f (docs/freeing.md gap 20): a view read out of a collection in an expression, `v[i][2][0]` of a
# Vec<Vec<Vec<I64>>>, copies nothing - each call's value read where it stands, the outer one's because the inner one is
# only read (0.7 KB a read before, copied into the collection's scope); its copy, where one is made, is the statement's
N I64 = 20000

fn inner(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 30 { w.Push(i + j) }
    return w
}

fn main() {
    v Vec<Vec<Vec<I64>>>
    for k in range 10 {
        o Vec<Vec<I64>>
        for j in range 5 { o.Push(inner(k + j)) }
        v.Push(o)
    }
    m Map<String, Vec<Vec<I64>>>
    m.Put("a", v[1])
    t := 0
    for i in range N {
        t += v[i % 10][2][0] + v[(i + 1) % 10][4][29] + m.Ref("a")![3][i % 30] + v[i % 10][1].Len()
    }
    io.PutLine($t + " " + $v[9][4].Len())!
}
