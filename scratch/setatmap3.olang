import "std/io"

N I64 = 2000

fn mkv(i I64) Map<String, Vec<I64>> {
    m Map<String, Vec<I64>>
    for j in range 5 {
        w Vec<I64>
        for k in range 20 { w.Push(i + k) }
        m.Put($i + "-" + $j + " padded", w)
    }
    return m
}

fn main() {
    v Vec<Map<String, Vec<I64>>>
    for _ in range 10: v.Push(Map<String, Vec<I64>>())
    t := 0
    for i in range N {
        v[i % 10] = mkv(i)
        v.RefMut(i % 10).Remove($i + "-2 padded")
        t += v[i % 10].Len()
    }
    io.PutLine($t)!
}
