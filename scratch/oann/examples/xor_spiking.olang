# XOR learned by a spiking system of dyn: Lif hidden and readout neurons whose activities are spike counts over a window,
# taught by the same equilibrium propagation as rate neurons (learn.Learner.Lesson: a free settle, nudged ones at +beta
# and -beta, the contrast of their spike counts) and nn/optim's AdamW. Each readout neuron is taught a rate of 0.2 spikes a
# step for its class and none otherwise. Arguments, all optional: the lessons (300), the hidden units (8), the window
# (256), the seed (1), the learning rate (0.02), beta (1).

import "std/io"
import "std/json"
import "std/os"
import "std/rand"
import "std/time"
import "../dyn/system"
import "../dyn/neuron"
import "../dyn/conn"
import "../dyn/settle"
import "../dyn/learn"
import "../nn/optim"

fn number(args Array<String&>&, i I64, fallback F64) F64 ? json.Error {
    if i >= args.Len(): return fallback
    return try json.Json.Parse(args[i]).AsNum()
}

fn main() ? io.Error, json.Error {
    args := os.Args()
    lessons := I64(try number(args, 1, 300))
    hidden := I64(try number(args, 2, 8))
    window := I64(try number(args, 3, 256))
    seed := U64(try number(args, 4, 1))
    rate := try number(args, 5, 0.02)
    beta := try number(args, 6, 1)
    lif := neuron.Neuron.Spiking(0.1, 1.0, 0.25, window)
    s := system.System<F32>(4)
    x := s.Population(s.Root(), "x", 2, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(s.Root(), "h", hidden, lif)
    y := s.Population(s.Root(), "y", 2, lif, neuron.Role.Readout(neuron.Cost.Squared))
    s.Connect(x, h, conn.Wiring.Dense)
    s.Connect(h, y, conn.Wiring.Symmetric)
    s.Plan(rand.Rand(seed))!
    for j in range hidden: s.Bias(h).Flat()![j] = 1.2
    for j in range 2: s.Bias(y).Flat()![j] = 1.0
    for b in range 4 {
        p := b / 2
        q := b % 2
        s.Pop(x).Drive[2 * b] = 1.0 if p == 1 else -1.0
        s.Pop(x).Drive[2 * b + 1] = 1.0 if q == 1 else -1.0
        class := p ^ q
        s.Pop(y).Target[2 * b + class] = 0.2
        s.Pop(y).Target[2 * b + 1 - class] = 0.0
    }
    l := learn.Learner<F32>(s)!
    opt := optim.AdamW(s.Params(), s.ParamGrads(), rate = rate)
    predicted := Array<I32>(4)
    steps I64 = 0
    refused I64 = 0
    t0 := time.Now()
    for k in range 1, lessons + 1 {
        ok := true
        lesson := try l.Lesson(s.Root(), beta) catch { ok = false } default learn.Taught()
        if ok {
            steps += lesson.Sweeps
            opt.Step()
        } else {
            refused++
        }
        if k % 25 == 0 or k == lessons {
            s.Settle(settle.Phase.Free, s.BudgetFor(s.LessonTolerance(beta)))
            s.Predict(settle.Phase.Free, y, predicted)
            right I64 = 0
            for b in range 4 {
                if I64(predicted[b]) == ((b / 2) ^ (b % 2)): right++
            }
            a := s.Activity(settle.Phase.Free, y)
            try io.Put(("lesson " + $k + ": loss " + $s.Loss(settle.Phase.Free).Fixed(5) + ", " + $right + "/4 right, readout rates " +
                $a.Get(0, 0).Fixed(3) + "/" + $a.Get(0, 1).Fixed(3) + " " + $a.Get(1, 0).Fixed(3) + "/" + $a.Get(1, 1).Fixed(3) + " " +
                $a.Get(2, 0).Fixed(3) + "/" + $a.Get(2, 1).Fixed(3) + " " + $a.Get(3, 0).Fixed(3) + "/" + $a.Get(3, 1).Fixed(3) +
                ", steps a lesson " + $(F64(steps) / F64((k - refused).Max(1))).Fixed(0) + ", refused " + $refused + "\n"))
        }
    }
    try io.Put($(F64(time.Since(t0)) * 1e-9).Fixed(2) + " s\n")
}
