# MNIST with a small convolutional network (models/cnn): two 3x3 convolutions (padding 1) of C1 and C2 channels, each
# followed by ReLU and 2x2 max pooling, then one dense layer from the 7 x 7 x C2 features to the 10 classes - softmax
# cross-entropy, batches of 128, AdamW at 1e-3, measured on the test set after every epoch, as examples/mnist_mlp.olang
# measures its perceptron. Each convolution is one product over its patches (kernels/conv), so a step allocates nothing:
# resident memory is printed after the first steps and after every epoch to show it stays flat. With "profile" as the
# last argument, the time of each kind of operation is printed after the first epoch. Arguments, all optional: the
# epochs (3), the seed (1), the threads (1), C1 (16), C2 (32).

import "std/io"
import "std/os"
import "std/rand"
import "std/time"
import "../ad/graph"
import "../data/idx"
import "../data/loader"
import "../data/mnist"
import "../kernels/conv"
import "../models/cnn"
import "../nn/optim"
import "../nn/train"
import "../tensor"

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len() or args[i] == "profile": return fallback
    return try args[i].ParseInt()
}

# the process's resident memory, kB
fn rss() I64 {
    t := try os.ReadFile("/proc/self/status") catch default ""
    i := try t.Find("VmRSS:") catch default 0
    rest := t[i + 6:]
    j := try rest.Find("kB") catch default 0
    return try rest[:j].Trim().ParseInt() catch default -1
}

# where the first epoch went, by operation kind
fn profileReport(g graph.Graph<F32>&) ? io.Error {
    for k in range graph.KindNames.Len() {
        f := g.Times[2 * k]
        bw := g.Times[2 * k + 1]
        if f + bw == 0: continue
        try io.Put(("  " + $graph.KindNames[k] + ": forward " + $(F64(f) * 1e-9).Fixed(2) + " s, backward " +
            $(F64(bw) * 1e-9).Fixed(2) + " s\n"))
    }
}

fn main() ? io.Error, os.Error, mnist.MnistError, idx.IdxError, ParseError, conv.GeometryError, tensor.ShapeError {
    args := os.Args()
    epochs := try number(args, 1, 3)
    seed := U64(try number(args, 2, 1))
    threads := try number(args, 3, 1)
    c1 := try number(args, 4, 16)
    c2 := try number(args, 5, 32)
    profile Bool = args.Len() > 1 and args[args.Len() - 1] == "profile"
    data := try mnist.Mnist.Load("data/mnist", mnist.Source)

    g := graph.Graph<F32>(128, threads)
    cfg := cnn.CnnConfig.Mnist(c1, c2)
    m := try cnn.Cnn.New(g, cfg)
    c := m.Task(g)
    try g.Plan(rand.Rand(seed))
    o := optim.AdamW(g.Params(), g.ParamGrads(), rate = 0.001, decay = 0.01, spans = optim.Spans(g))
    trainSet := loader.Loader(data.Train, g.Batch, seed)
    testSet := loader.Loader(data.Test, g.Batch, seed, false)
    try io.Put(("conv 3x3 1->" + $c1 + ", relu, pool 2; conv 3x3 " + $c1 + "->" + $c2 + ", relu, pool 2; dense " + $cfg.Features() +
        "->10: " + $g.ParamCount + " parameters, batches of " + $g.Batch + ", AdamW, " + $threads + " threads; the arena " +
        $(F64(g.ArenaBytes()) / 1048576.0).Fixed(1) + " MB\n"))
    g.Profiling = profile
    total I64 = 0
    xs := g.Data(c.X).Flat()!
    ys := g.Ints(c.Y).Flat()!
    for e in range 1, epochs + 1 {
        trainSet.Epoch()
        t0 := time.Now()
        sum F64 = 0.0
        seen I64 = 0
        for b in range trainSet.Batches() {
            n := trainSet.Fill(b, xs, ys)
            g.Forward(n)
            g.Backward(c.Loss)
            o.Step()
            sum += g.Scalar(c.Loss) * F64(n)
            seen += n
            if e == 1 and (b == 9 or b == 99): try io.Put("  after step " + $(b + 1) + ": resident " + $rss() + " kB\n")
        }
        spent := time.Since(t0)
        total += spent
        if profile and e == 1 {
            try profileReport(g)
            g.Profiling = false
        }
        testLoss, accuracy := train.Evaluate(g, c, testSet)
        try io.Put(("epoch " + $e + ": train loss " + $(sum / F64(seen)).Fixed(4) + ", test loss " + $testLoss.Fixed(4) +
            ", test accuracy " + $(100.0 * accuracy).Fixed(2) + "%, " + $(F64(spent) * 1e-9).Fixed(2) + " s, resident " +
            $rss() + " kB\n"))
    }
    try io.Put("mean epoch " + $(F64(total) * 1e-9 / F64(epochs)).Fixed(2) + " s\n")
}
