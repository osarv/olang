# kernels/attention (products by gemm.GemmBatch, softmax by kernels/elem) against ops.olang's Attention and
# AttentionBackward (linalg's GemmBatch), causal, interleaved, medians of the CPU time of one pass, ms. Arguments: B, T, D,
# heads, repetitions per round, rounds, causal (1 or 0), threads (16 64 128 4 10 9 1 1)

import "std/os"
import ctime "time.h"
import "std/rand"
import "../linalg"
import "../ops"
import "../kernels/mat"
import "../kernels/gemm"
import "../kernels/attention"

fn cpu() I64 {
    ts := ctime.timespec()
    ctime.clock_gettime(2, ts)
    return ts.tv_sec * 1000000000 + ts.tv_nsec
}

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len(): return fallback
    return try args[i].ParseInt()
}

fn median(xs Array<I64>&) I64 {
    s := xs.Copy()
    s.Sort(fn(a, b): return a < b)
    return s[s.Len() / 2]
}

fn ms(ns I64, reps I64) String {
    return $(F64(ns) * 1e-6 / F64(reps)).Fixed(3)
}

fn view(m linalg.Matrix<F32>&) mat.Mat<F32> {
    return mat.Mat<F32>(m.Data, 0, m.Rows, m.Cols, m.Cols)
}

fn main() ? ParseError {
    args := os.Args()
    B := try number(args, 1, 16)
    T := try number(args, 2, 64)
    D := try number(args, 3, 128)
    heads := try number(args, 4, 4)
    reps := try number(args, 5, 10)
    rounds := try number(args, 6, 9)
    causal Bool = try number(args, 7, 1) != 0
    threads := try number(args, 8, 1)
    r := rand.Rand(1)
    n := B * T
    q := linalg.Matrix<F32>(n, D)
    k := linalg.Matrix<F32>(n, D)
    v := linalg.Matrix<F32>(n, D)
    dy := linalg.Matrix<F32>(n, D)
    q.FillNormal(r, 0.0, 1.0)
    k.FillNormal(r, 0.0, 1.0)
    v.FillNormal(r, 0.0, 1.0)
    dy.FillNormal(r, 0.0, 1.0)
    y := linalg.Matrix<F32>(n, D)
    probs := linalg.Matrix<F32>(n * heads, T)
    dq := linalg.Matrix<F32>(n, D)
    dk := linalg.Matrix<F32>(n, D)
    dv := linalg.Matrix<F32>(n, D)
    scratch := Array<F32>(ops.AttentionScratch(n, heads, T))
    ws := linalg.GemmWorkspace<F32>()
    z F32 = 0.0
    y2 := linalg.Matrix<F32>(n, D)
    probs2 := linalg.Matrix<F32>(n * heads, T)
    dq2 := linalg.Matrix<F32>(n, D)
    dk2 := linalg.Matrix<F32>(n, D)
    dv2 := linalg.Matrix<F32>(n, D)
    scratch2 := Array<F32>(attention.AttentionScratch(n, heads, T))
    ws2 := gemm.Workspace<F32>(threads)
    at := attention.Heads(heads, T, causal)
    ops.Attention(y, q, k, v, heads, T, causal, probs, threads, ws, z)
    ops.AttentionBackward(dy, q, k, v, heads, T, causal, probs, dq, false, dk, false, dv, false, scratch, threads, ws, z)
    attention.Attention(ws2, view(y2), view(q), view(k), view(v), view(probs2), at)
    attention.AttentionGrad(ws2, view(dq2), view(dk2), view(dv2), view(dy), view(q), view(k), view(v), view(probs2), scratch2, at)
    times := Array<I64>(4 * rounds)
    for round in range rounds {
        t0 := cpu()
        for _ in range reps: ops.Attention(y, q, k, v, heads, T, causal, probs, threads, ws, z)
        t1 := cpu()
        for _ in range reps: attention.Attention(ws2, view(y2), view(q), view(k), view(v), view(probs2), at)
        t2 := cpu()
        for _ in range reps {
            ops.AttentionBackward(dy, q, k, v, heads, T, causal, probs, dq, false, dk, false, dv, false, scratch, threads, ws, z)
        }
        t3 := cpu()
        for _ in range reps {
            attention.AttentionGrad(ws2, view(dq2), view(dk2), view(dv2), view(dy), view(q), view(k), view(v), view(probs2), scratch2, at)
        }
        t4 := cpu()
        times[0 * rounds + round] = t1 - t0
        times[1 * rounds + round] = t2 - t1
        times[2 * rounds + round] = t3 - t2
        times[3 * rounds + round] = t4 - t3
    }
    worst := y.MaxAbsDifference(y2)!.Max(dq.MaxAbsDifference(dq2)!).Max(dk.MaxAbsDifference(dk2)!).Max(dv.MaxAbsDifference(dv2)!)
    Println(("B " + $B + ", T " + $T + ", D " + $D + ", " + $heads + " heads, " + $("causal" if causal else "not causal") + ", " + $threads + " threads, CPU ms a pass: forward ops " +
        $ms(median(times[0 * rounds:1 * rounds]), reps) + " kernels " + $ms(median(times[1 * rounds:2 * rounds]), reps) + "; backward ops " +
        $ms(median(times[2 * rounds:3 * rounds]), reps) + " kernels " + $ms(median(times[3 * rounds:4 * rounds]), reps) +
        "; largest difference " + $worst))
}
