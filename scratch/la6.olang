type Pop<T> struct(size I64) {
    Size I64 = size
    Bias mut Array<T>& = Array<T>(size)
}

type Engine<T> struct() {
    Pops mut Vec<mut Pop<T>&>& = Vec<mut Pop<T>&>()
}

type System<T> struct() {
    E mut Engine<T>& = Engine<T>()
    Planned Bool = true
}

fn (s System<T>&) Pop(i I64) mut Pop<T>& { return s.E.Pops[i] }

type LearnError error { Unsupported(what String) }

type Learner<T> struct(s mut System<T>&) ? LearnError {
    if not s.Planned: error LearnError.Unsupported("not planned")
    S mut System<T>& = s
    Lessons I64 = 0
}

type ShapeError error { Mismatch(what String) }

fn (l Learner<T>&) shaped<Y>(i I64, x Array<Y>&) ? ShapeError {
    size := l.S.Pop(i).Size
    if x.Len() != size {
        error ShapeError.Mismatch("population " + $i + " takes " + $size)
    }
}

fn use(sys mut System<F32>&) I64 {
    l := Learner<F32>(sys)!
    return l.Lessons
}

fn main() {
    s := System<F32>()
    s.E.Pops.Push(Pop<F32>(3))
    assert use(s) == 0
    l := Learner<F32>(s)!
    l.shaped(0, Array<I64>(3))!
}
