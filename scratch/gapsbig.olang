import "std/io"

# B18a: -memory -check fails on a let-go early freeing does not follow - an element given a Map (O8f's gap 17: what an
# element owning more than Vecs held is kept)
fn main() {
    rows := Array<Map<String, I64>>(10)
    for i in range 200000 { rows[i % 10] = Map<String, I64>[$i: i] }
    io.PutLine($rows[3].Len())!
}
