type Pop<T> struct(size I64) {
    Size I64 = size
    Bias mut Array<T>& = Array<T>(size)
}

type Engine<T> struct() {
    Pops mut Vec<mut Pop<T>&>& = Vec<mut Pop<T>&>()
}

type System<T> struct() {
    E mut Engine<T>& = Engine<T>()
}

fn (s System<T>&) Pop(i I64) mut Pop<T>& { return s.E.Pops[i] }

type Learner<T> struct(s mut System<T>&) {
    S mut System<T>& = s
    Lessons I64 = 0
}

type ShapeError error { Mismatch(what String) }

fn (l Learner<T>&) Shaped<Y>(i I64, x Array<Y>&) ? ShapeError {
    size := l.S.Pop(i).Size
    if x.Len() != size {
        error ShapeError.Mismatch("population " + $i + " takes " + $size)
    }
}

