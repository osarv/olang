type Blk struct() {
    S List<I64>
    t I64 = 0
}
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
type B2 struct() {
    names List<String&>
    t I64 = 0
}
fn add(bs mut List<B2>&, x I64) {
    bs[0].names.Push($x)
}
fn main() ? {
    bs := List<B2>()
    bs.Push(B2())
    add(bs, 7)
    churn()
    for s in bs[0].names { println("for " $s) }
}
