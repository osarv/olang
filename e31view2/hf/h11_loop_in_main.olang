type Blk struct() {
    S List<I64>
    t I64 = 0
}
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
fn main() ? {
    bs := List<Blk>()
    bs.Push(Blk())
    for i in range 3 { bs[0].S.Push(i + 7) }
    churn()
    for s in bs[0].S { println("for " $s) }
}
