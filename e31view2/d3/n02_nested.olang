type V struct(d mut Array<I64>&, n I64) {
    d
    n
    items List<I64> = List<I64>()
}
fn f(c mut V&) {
    if c.n > 0 {
        for i in range 3 {
            c.d[i % 2] = i
            if i == 2 { c.n++ }
        }
    }
}
fn main() ? {
    l := List<V>()
    l.Push(V(Array<I64>(2), 1))
    f(l[0])
}
