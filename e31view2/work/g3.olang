type Node struct() {
    v I64 = 0
}
type Inner struct() {
    k I64 = 0
    q mut Node& = Node()
}
type M struct(d mut Array<I64>&, off I64) {
    d
    off
    inner Inner = Inner()
    items List<I64> = List<I64>()
    r mut Node& = Node()
}
type Layer struct(w M, b M, n I64) {
    w
    b
    n
    d mut Array<I64>& = Array<I64>(3)
}
fn iView(i mut Inner&, k I64) { i.q.v = i.q.v + k + i.k }
fn iWrite(i mut Inner&, k I64) { i.k = i.k + k }
fn iRepoint(i mut Inner&, k I64) { i.q = Node() }
fn hView1(m mut M&, k I64) { m.d[(m.off + k) % 3] = m.d[(m.off + k) % 3] + k }
fn hView2(m mut M&, k I64) { m.r.v = m.r.v + k + m.inner.k }
fn hView3(m mut M&, k I64) { m.items.Push(k + m.off) }
fn hView4(m mut M&, k I64) { iView(m.inner, k) }
fn hWrite1(m mut M&, k I64) { m.off = m.off + k }
fn hWrite2(m mut M&, k I64) { m.inner.k = k }
fn hWrite3(m mut M&, k I64) { iWrite(m.inner, k) }
fn hWrite4(m mut M&, k I64) { m.r = Node() }
fn hWrite5(m mut M&, k I64) { iRepoint(m.inner, k) }
fn hRec(m mut M&, k I64) {
    if k > 0 { hRec(m, k - 1) } else { m.d[0] = m.d[0] + 1 }
}
fn hRecA(m mut M&, k I64) {
    if k > 0 { hRecB(m, k - 1) } else { m.d[1] = m.d[1] + 3 }
}
fn hRecB(m mut M&, k I64) {
    if k > 2 { hRecA(m, k - 1) }
    hView2(m, k)
}
fn hRecW(m mut M&, k I64) {
    if k > 0 { hRecW2(m, k - 1) }
}
fn hRecW2(m mut M&, k I64) {
    hRecW(m, k)
    if k == 1 { m.off++ }
}
fn hBoth(m mut M&, n mut M&, k I64) {
    n.d[2] = n.d[2] + k
    hView2(m, k)
}
fn hBothW(m mut M&, n mut M&, k I64) {
    hView1(m, k)
    n.inner.k = n.inner.k + 1
}
fn (m mut M&) MV(k I64) { hView3(m, k) }
fn (m mut M&) MW(k I64) { hWrite2(m, k) }
fn (m M&) MR(k I64) I64 { return m.off + m.inner.k + k }
fn mByVal(m M, k I64) I64 {
    m.off = m.off + k
    return m.off
}
fn gView(c mut Layer&, k I64) { hView1(c.w, k) }
fn gWrite(c mut Layer&, k I64) { hWrite1(c.b, k) }
fn gRec(c mut Layer&, k I64) {
    if k > 0 { gRec(c, k - 1) } else { hView4(c.b, 2) }
}
fn f(c mut Layer&) {
    iWrite(c.w.inner, 9)
    if c.n > 0 { hView2(c.w, 8) } else { hView1(c.w, 8) }
}
fn show(v Layer&) String& { return $v.n " | " $v.w.off " " $v.w.d " " $v.w.inner.k " " $v.w.inner.q.v " " $v.w.items " " $v.w.r.v " | " $v.b.off " " $v.b.d " " $v.b.inner.k " " $v.b.inner.q.v " " $v.b.items " " $v.b.r.v " | " $v.d }
fn mk() Layer { return Layer(M(Array<I64>(3), 0), M(Array<I64>(3), 1), 3) }
fn main() ? {
    l := List<Layer>()
    l.Push(mk())
    f(l[0])
    a := Layer[mk()]
    f(a[0])
    println(show(l[0]))
    println(show(a[0]))
}
