type Pt struct() {
    X I64 = 0
}
type Acc struct() {
    N I64 = 0
    P Pt = Pt()
}
fn bump(c mut Acc&) { c.N++ }
fn bumpPt(p mut Pt&) { p.X++ }
fn main() ? {
    a := Acc[Acc(), Acc()]
    bump((try a[1] catch default Acc()))
    l := List<Acc>()
    l.Push(Acc())
    bump((try l[0] catch default Acc()))
    println("array N " $a[1].N " list N " $l[0].N)
}
