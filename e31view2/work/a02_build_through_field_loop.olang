# r1: as a01, the build in a loop body inner block
type Node struct(v I64, next mut Node&) {
    v
    next
}
type M struct(r mut Node&, off I64) {
    r
    off
}
fn g(m mut M&, v I64) { m.r.next = Node(v, null) }
type Layer struct(w M, n I64) {
    w
    n
}
fn step(c mut Layer&, v I64) { g(c.w, v) }
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
fn main() ? {
    l := List<Layer>()
    l.Push(Layer(M(Node(1, null), 0), 0))
    for i in range 3 {
        if i >= 0 { step(l[0], i + 10) }
    }
    churn()
    println($l[0].w.r.next.v)
}
