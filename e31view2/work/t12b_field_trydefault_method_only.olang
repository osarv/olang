type Pt struct() {
    X I64 = 0
}
type Acc struct() {
    N I64 = 0
    P Pt = Pt()
}
fn bump(c mut Acc&) { c.N++ }
fn bumpPt(p mut Pt&) { p.X++ }
fn (p mut Pt&) Bump() { p.X++ }
fn (c mut Acc&) Bump() { c.N++ }
fn main() ? {
    a := Acc[Acc(), Acc()]
    (try a[1] catch default Acc()).P.Bump()
    println("array P " $a[1].P.X " N " $a[1].N)
}
