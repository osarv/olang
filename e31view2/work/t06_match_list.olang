type Pt struct() {
    X I64 = 0
}
type Acc struct() {
    N I64 = 0
    P Pt = Pt()
}
fn bump(c mut Acc&) { c.N++ }
fn bumpPt(p mut Pt&) { p.X++ }
fn main() ? {
    l := List<Acc>()
    l.Push(Acc())
    l.Push(Acc())
    k := l.Len()
    bump(match k { case 2 => l[0]  case _ => l[1] })
    println("list N " $l[0].N)
}
