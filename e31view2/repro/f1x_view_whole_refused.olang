# CONTROL for F1: the whole element lent to the same builder - O17's error (correct)
type Node struct(v I64, next mut Node&) {
    v
    next
}
type M struct(r mut Node&, off I64) {
    r
    off
}
fn g(m mut M&, v I64) { m.r.next = Node(v, null) }
fn add(l mut List<M>&, v I64) { g(l[0], v) }
fn churn() {
    for k in range 200 {
        a := Array<I64>(64, k * 1000 + 7)
        if a[0] == 3 { println("x") }
    }
}
fn main() ? {
    l := List<M>()
    l.Push(M(Node(1, null), 0))
    add(l, 12)
    churn()
    println($l[0].r.next.v)
}
