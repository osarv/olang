# T1 HOLE, beyond E31b: an ASSIGNMENT through a field of a try-default, (try a[1] catch default Acc()).P.X = 5 - baked 51,
# run 0 (-i: run 51). OperandIsLvalue looks only at the operand's own catch clauses
type Pt struct() {
    X I64 = 0
}
type Acc struct() {
    N I64 = 0
    P Pt = Pt()
}
fn bump(c mut Acc&) { c.N++ }
fn bumpPt(p mut Pt&) { p.X++ }
fn f() I64 {
    a := Acc[Acc(), Acc()]
    (try a[1] catch default Acc()).P.X = 5
    (try a[1] catch default Acc()).N++
    return a[1].P.X * 10 + a[1].N
}
Baked := f()
V mut I64 = 0
fn main() ? {
    V = f()
    println("baked " $Baked " run " $V)
}
