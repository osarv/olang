# T1 HOLE (OLDER): (try a[1] catch default Acc()).P lent to a writable parameter on a built-in array - accepted;
# the run time writes a temporary (P 0), -i writes the element (P 1)
type Pt struct() {
    X I64 = 0
}
type Acc struct() {
    N I64 = 0
    P Pt = Pt()
}
fn bump(c mut Acc&) { c.N++ }
fn bumpPt(p mut Pt&) { p.X++ }
fn main() ? {
    a := Acc[Acc(), Acc()]
    bumpPt((try a[1] catch default Acc()).P)
    println("array P " $a[1].P.X)
}
