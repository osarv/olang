# O8d owner locals (F13) + O26a's slice of a view (F10): a Vec local given another value, then a slice of its view returned
import "std/io"

fn mk(k I64) Vec<I64> {
    v Vec<I64>
    for i in range 50 { v.Push(k * 1000 + i) }
    return v
}

fn part(k I64) Array<I64>& {
    v := mk(0)
    for j in range k { v = mk(j) }
    return v.View()[1:3]
}

fn whole(k I64) Array<I64>& {
    v := mk(0)
    for j in range k { v = mk(j) }
    return v.View()
}

fn churn() I64 {
    junk := Vec<Vec<I64>>()
    for i in range 2000 { junk.Push(mk(i)) }
    return junk.Len()
}

fn main() {
    a := part(5)
    b := whole(6)
    n := churn()
    io.Println($a " " $b[1] " " $n)!
}
