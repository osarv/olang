# control for gen_capture_uaf: the same generator reading the reference directly
import "std/io"

type node struct(v I64) { v }

fn mk(k I64) node& { return node(k) }

fn gen(k I64) Iterator<I64> {
    r := mk(k)
    for i in range 3 { yield r.v + i }
}

fn churn() I64 {
    junk := Vec<String>()
    for i in range 2000 { junk.Push($i "abcdefghijklmnopqrstuvwxyz") }
    return junk.Len()
}

fn main() {
    t := 0
    for x in gen(5) {
        churn()
        t += x
    }
    io.Println($t " (18)")!
}
