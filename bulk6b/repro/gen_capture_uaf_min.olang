# gen_capture_uaf minimal: -debug -sanitize says "use after scope closed" at the second turn (the lambda is called
# outside the yield too)
import "std/io"
type node struct(v I64) { v }
fn mk(k I64) node& { return node(k) }
fn gen(k I64) Iterator<I64> {
    r := mk(k)
    f := fn() I64 { return r.v }
    for i in range 3 {
        x := f()
        yield x + i
    }
}
fn main() {
    t := 0
    for x in gen(5) {
        junk := Vec<String>()
        for i in range 2000 { junk.Push($i "abcdefghijklmnopqrstuvwxyz") }
        t += x + junk.Len() - 2000
    }
    io.Println($t)!
}
