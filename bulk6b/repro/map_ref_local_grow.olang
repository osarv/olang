# round 8's slot release at a Map's growth against a Ref of a local Map, held across Puts made through a second name
import "std/io"

type blk struct(n I64, m I64) { n, m }

fn churn() I64 {
    junk := Vec<Map<I64, blk>>()
    for i in range 300 {
        w := Map<I64, blk>()
        for j in range 20 { w.Put(j, blk(-i, -j)) }
        junk.Push(w)
    }
    return junk.Len()
}

fn fill(m mut Map<I64, blk>&) { for i in range 2, 5000 { m.Put(i, blk(i, i)) } }

type st struct() {
    m Map<I64, blk>
}

fn main() {
    s := st()
    s.m.Put(1, blk(1, 2))
    ss := Vec<st>()
    ss.Push(s)
    r := ss.RefMut(0).m.RefMut(1)!
    fill(ss.RefMut(0).m)
    n := churn()
    r.n = 77
    io.Println("r.n " $r.n " r.m " $r.m " " $n)!
}
