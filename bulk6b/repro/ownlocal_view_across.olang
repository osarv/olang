# O8d owner locals (F13): views of an owner local's value kept across its reassignment - in a struct, a local, a lambda
import "std/io"

type hold struct(a Array<I64>&) { a }
type box struct(v Vec<I64>) { v }

fn mk(k I64) Vec<I64> {
    v Vec<I64>
    for i in range 50 { v.Push(k * 1000 + i) }
    return v
}

fn viaStruct() I64 {
    v := mk(1)
    h := hold(v.View())
    v = mk(2)
    junk := Vec<Vec<I64>>()
    for i in range 200 { junk.Push(mk(i + 5)) }
    return h.a[3] + junk.Len()
}

fn viaLambda() I64 {
    v := mk(1)
    w := v.View()
    f := fn() I64 { return w[3] }
    v = mk(2)
    junk := Vec<Vec<I64>>()
    for i in range 200 { junk.Push(mk(i + 5)) }
    return f() + junk.Len()
}

fn viaField() I64 {
    b := box(mk(1))
    h := hold(b.v.View())
    b.v = mk(2)
    junk := Vec<Vec<I64>>()
    for i in range 200 { junk.Push(mk(i + 5)) }
    return h.a[3] + junk.Len()
}

fn viaLoop() I64 {
    v := mk(0)
    keep := Vec<hold>()
    for j in range 4 {
        keep.Push(hold(v.View()))
        v = mk(j + 1)
    }
    junk := Vec<Vec<I64>>()
    for i in range 200 { junk.Push(mk(i + 5)) }
    s := 0
    for h in keep { s += h.a[3] }
    return s + junk.Len()
}

fn main() {
    io.Println($viaStruct() " " $viaLambda() " " $viaField() " " $viaLoop())!
}
