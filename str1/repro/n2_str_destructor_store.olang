# NEW, CONFIRMED UAF. Str builds a destructor-bearing Res where its receiver lives (the temp scope '$' passes);
# Res's destructor stores a new Node through its exact field when the temp scope closes - after the region check.
# new -b prints -7 (want 9); -b -s: 'use after scope closed'; base refuses (E11c).
type Node struct(v I64, next mut Node&) {
    v
    next
}
type Res struct(a mut Node&) {
    a
} destruct { a.next = Node(9, null) }
type Bag struct(head mut Node&) {
    head
}
fn (b Bag&) Str() String {
    x Res&b = Res(b.head)
    return "b"
}
type Junk struct(a I64, b I64) {
    a
    b
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        j Junk& = Junk(-7, -7)
        a := Array<I64>(64, -7)
        t += a[3] + j.a
    }
    return t
}
fn main() ? {
    b := Bag(Node(1, null))
    s := $b
    keep := List<Junk&>()
    for i in range 2000 { keep.Push(Junk(-7, -7)) }
    churn()
    println(s)
    println($b.head.next.v)
}
