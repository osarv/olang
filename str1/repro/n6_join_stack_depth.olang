# NEW, CONFIRMED regression. A recursive function with a join whose later piece calls code now takes the one-pass
# path: 256-byte first room + 32-byte builder per frame. Depth 100000: new -b segfaults (limit ~25-30k); base prints 1
# (limit ~120k-200k).
Depth mut I64 = 100000
fn r(n I64, name String&) I64 {
    if n == 0 { return 0 }
    s := $name $r(n - 1, name)
    return s.Len() - name.Len()
}
fn main() ? {
    d := Depth
    println($r(d, "x"))
}
