# Completes the worker.olang <-> runner.olang import cycle, and is the -c mode entry point (has main).

import sh "shared"
import wk "worker"
import "geom/rect"
import "geom/measure"

error RunnerError {
    STARTUP_FAILED
}

fn DoubleIt(n I32) I32 {
    return n * 2
}

# originating a FOREIGN module's error type directly via "error alias.Type.word" - previously you could
# only declare a foreign error in your own signature and try/catch it, never raise one yourself; see the
# report. wk.WorkerError is declared over in worker.olang, not here.
fn alwaysWorkerBadInput() I32 ? wk.WorkerError {
    error wk.WorkerError.BAD_INPUT
}

# a chain of TWO alias hops ("wk" - runner's own alias for worker.olang, then "Base" - worker's own
# re-exported alias for wk.Base.olang, see worker.olang) reaching a THIRD module's own error type directly,
# originated fresh right here - not just declared/caught through a signature. Every cross-module
# mechanism (type ref, call, bare var read, catch, "error" statement) supports an alias chain of any
# length now, not just one hop - see the report.
fn alwaysBaseBrokenViaChain() ? wk.Base.BaseError {
    error wk.Base.BaseError.BROKEN
}

fn main() ? RunnerError {
    try sh.SafeDiv(10, 2) catch sh.MathError {
        error RunnerError.STARTUP_FAILED
    }
    done
}

test "calling back across the cycle from runner" {
    assert wk.AskRunner(5) == 10
}

test "runner sees the same shared error type worker does" {
    caught Bool = false
    try sh.SafeDiv(1, 0) catch sh.MathError {
        caught = true
    }
    assert caught
}

test "runner can call worker's cross-module wrapper directly" {
    ok Bool = true
    try wk.Classify(50) catch sh.RangeError + wk.WorkerError {
        ok = false
    }
    assert ok
}

test "originating a foreign module's error type directly with 'error alias.Type.word'" {
    caught Bool = false
    try alwaysWorkerBadInput() catch wk.WorkerError.BAD_INPUT {
        caught = true
    }
    assert caught
}

test "a bare cross-module variable read, no call" {
    before I32 = wk.AskCount
    assert wk.AskRunner(5) == 10
    assert wk.AskCount == before + 1
    wk.AskCount = wk.AskCount + 100
    assert wk.AskCount == before + 101
}

test "a two-hop alias chain reaches a re-exported module's own function" {
    before I32 = wk.Base.BumpBase()
    assert wk.Base.BumpBase() == before + 1
}

test "a two-hop alias chain reaches a re-exported module's own variable, read and write" {
    before I32 = wk.Base.BaseCount
    wk.Base.BaseCount = before + 42
    assert wk.Base.BaseCount == before + 42
}

test "a two-hop alias chain reaches a re-exported module's own type" {
    t wk.Base.BaseThing = wk.Base.BaseThing(9)
    assert t.Id == 9
}

# M6a: capitalization decides a MEMBER's visibility too, not just a top-level declaration's. "t.Id" reads
# fine from here; "t.secret" and "catch wk.Base.BaseError.quiet" are compile errors and so can only be
# named in a comment. Reaching the private member through the declaring module's own accessor works, which
# is the point - privacy is about this boundary, not about the member being special.
test "a lowercase member is private across the module boundary, reachable through its own module" {
    t wk.Base.BaseThing = wk.Base.BaseThing(9)
    assert wk.Base.BaseSecretOf(t) == 7
}

# G16: a generic instantiated across a module boundary. The instantiation is emitted into THIS module's
# object as linkonce_odr - worker's own object never contains it - so the body has to be available from
# worker's source at the moment this module is checked.
test "a generic from another module returns its own argument" {
    assert wk.GenericEcho(7) == 7
    assert wk.GenericEcho(U8(3)) == 3
}

# M12: an enum value is alias-qualified like any other cross-module name now. "wk.Base.BaseDir.south" is
# a compile error under M6a and so appears only here, in a comment.
test "a two-hop alias chain names a re-exported enum type's word, and matches on it" {
    d wk.Base.BaseDir = wk.Base.BaseDir.North
    assert d == wk.Base.BaseDir.North
    hit I32 = 0
    match d {
        case wk.Base.BaseDir.North { hit = 1 }
        nomatch { hit = 2 }
    }
    assert hit == 1
}

# a private enum case is still perfectly usable through the declaring module's own function - the value
# crosses the boundary even though its NAME cannot
test "a private enum case's value still crosses the boundary" {
    d wk.Base.BaseDir = wk.Base.BaseSouth()
    assert d != wk.Base.BaseDir.North
}

# a private WORD does not stop the whole type being caught - you can handle "some BaseError" without being
# able to name the ones the declaring module kept to itself
test "a private error word is still caught by its type from another module" {
    caught Bool = false
    try wk.Base.AlwaysBaseQuiet() catch wk.Base.BaseQuiet {
        caught = true
    }
    assert caught
}

test "a two-hop alias chain constructs a re-exported plain type via a struct literal" {
    p wk.Base.BasePoint = wk.Base.BasePoint(5, 6)
    assert p.X == 5
    assert p.Y == 6
}

test "a two-hop alias chain constructs a re-exported plain type via an array literal" {
    pts Array<wk.Base.BasePoint> = wk.Base.BasePoint[wk.Base.BasePoint(1, 2), wk.Base.BasePoint(3, 4)]
    assert pts[0].X == 1
    assert pts[1].Y == 4
}

test "a two-hop alias chain reaches a re-exported module's own error type via catch" {
    caught Bool = false
    try wk.Base.AlwaysBaseBroken() catch wk.Base.BaseError.BROKEN {
        caught = true
    }
    assert caught
}

test "originating a two-hop re-exported error type directly with 'error alias.alias.Type.word'" {
    caught Bool = false
    try alwaysBaseBrokenViaChain() catch wk.Base.BaseError {
        caught = true
    }
    assert caught
}

# T30/T31 across a module boundary: Metre is declared here and satisfies Base's interface purely by
# having a matching method - no import of the interface into the declaration, no declared intent, no
# mention of Metre anywhere in wk.Base.
type Metre struct(len I32) {
    n mut I32 = len
}
fn (m Metre&) Size() I32 { return m.n * 100 }

test "a local type satisfies an imported trait structurally" {
    m Metre& = Metre(3)
    assert m.Size() == 300
    assert wk.Base.BaseDoubledOf(m) == 600        # M19e: the trait's default, reached across the boundary
}

test "a sealed trait is satisfied only by its own module's types" {
    b wk.Base.BaseBox& = wk.Base.BaseBox(5)
    assert wk.Base.BaseTagOf(b) == 7
        # "wk.Base.BaseTagOf(someLocalType)" is a compile error here: baseTag is private to Base, so no type
        # declared in this module can supply it - which is the whole point of a sealed trait
}

# M19d: a built-in type's methods are the prelude's and visible everywhere, so nothing is imported for
# every String here - a literal, a slice, a "$x" rendering - to have them.
test "the prelude's methods on a built-in type are visible without an import" {
    greeting String& = "hello, " $3
    assert greeting.Eq("hello, 3")
    assert greeting.StartsWith("hello")
    assert "  x ".Trim().Eq("x")
}

test "M23: a file in a directory imports by its path, its alias the last element" {
    assert measure.Area(rect.Square(4)) == 16
    r rect.Rect = rect.Rect(3, 7)
    assert measure.Area(r) == 21
}

test "M19: a method on a type from an imported module is reached through its receiver" {
    n measure.Side = 6
    assert n.Squared() == 36
}

# B5a: imports initialize before importers - this initializer reads a global of shared.olang's that is
# itself computed at startup. The root used to be initialized first, reading 0.
runnerFourteen I32 = sh.InitSeven * 2

test "B5a: an importer's global initializer sees its import's globals already set" {
    assert runnerFourteen == 14
}

# B9: an import inside a top-level if exists only when its branch is taken - the pre-scan that loads imports
# evaluates the same condition. This one, and the test using it, exist only in a test build.
if TestBuild {
    import "std/time"

    test "B9: a conditional import is loaded when its branch is taken" {
        start := time.Now()
        assert time.Since(start) >= 0
    }
}

test "D15: an imported global's type is settled from its initializer before any body reads it" {
    assert sh.SharedUnits.Len() == 2
    assert sh.SharedUnits[1] == 'm'
    assert sh.SharedInferred == 42
}
