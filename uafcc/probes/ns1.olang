import "std/io"

Dtors mut I64 = 0
type R struct(s String&) {
    s
} destruct {
    Dtors += 1
}
type E struct(A Array<String&>&, B String&, C R&) {
    A
    B
    C
}
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}
fn mk(s String&) String { return $s "-made" }
fn f(t String&, n I64) E {
    e := E(String&[mk(t), $n] if n % 2 == 0 else (match n { case 1 => String&["one", "uno"]  nomatch => (String&[mk(mk(t))] if n > 4 else String&["k"]) }), match n % 3 { case 0 => ("" if n > 100 else mk(t))  case 1 => (match n { case 1 => mk(t)  nomatch => "x" })  nomatch => "" }, (R(mk(t)) if n % 2 == 1 else null) if n < 100 else (match n { case 200 => R("c")  nomatch => null }))
    return e
}

fn main() {
    l := List<E>()
    for i in range 8 {
        l.Push(f($i, i))
        churn()
    }
    churn()
    io.Println($l[0].A[0] " " $l[1].A[1] " " $l[5].A[0] " " $l[6].A[1] " " $l[1].B " " $l[3].B " " $l[7].C.s " " $Dtors)!
}
