import "std/io"

fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}
fn mk(s String&) String { return $s "-made" }
type Box<T> struct(v T) {
    v
}
fn mkBox<T>(v T) Box<T> {
    b := Box(v)
    return b
}

fn main() {
    l := List<Box<String&>>()
    bs := List<Box<String&>>()
    for i in range 5 {
        t := $i
        l.Push(Box(mk(t) if i >= 0 else ""))
        bs.Push(Box<String&>(match i { case 0 => ""  nomatch => mk(t) }))
        bs.Push(mkBox<String&>(mk(t) if i >= 0 else ""))
        churn()
    }
    churn()
    io.Println($l[3].v " " $bs[4].v " " $bs[5].v)!
}
