import "std/io"

fn mk(s String&) String { return $s "-made" }
fn w(s mut String&) { s[0] = 'Z' }
type E struct(A mut String&) {
    A
}

fn main() {
    for i in range 3 {
        w(mk($i) if i > 0 else "abc")
        e := E(mk($i) if i > 0 else "abc")
        e.A[0] = 'Q'
        io.Println(e.A)!
    }
    io.Println("abc")!
}
