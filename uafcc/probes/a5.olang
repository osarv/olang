import "std/io"

type H struct(r String&) {
    r
}
type O struct(h H&) {
    h
}

fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}

fn f(t String&, at I64) O { return O(H(t) if at >= 0 else null) }

fn main() {
    keep := O(null)
    for i in range 10 {
        s := $i "-x"
        keep = f(s, i)
    }
    churn()
    io.Println(keep.h.r)!
}
