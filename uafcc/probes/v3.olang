import "std/io"

type E struct(A Array<String&>&) {
    A
}
fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}

fn main() {
    keep := E(String&["a"])
    for i in range 10 {
        w := List<String&>()
        w.Push($i "-a")
        w.Push($i "-b")
        tt := $i "-t"
        keep = E(String&[tt, "q"] if i >= 0 else String&["x", "y"])
    }
    churn()
    io.Println($keep.A[1])!
}
