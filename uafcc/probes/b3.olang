import "std/io"

type P struct(n I64) {
    n
}
type K enum {
    A(p P)
    B
}
type W struct(q P&) {
    q
}
type O struct(w W&) {
    w
}

fn churn() {
    for k in range 50 {
        x := Array<I64>(100, k)
        assert x[3] == k
    }
}

fn main() {
    keep := O(null)
    for i in range 10 {
        p := P(i)
        keep = O(W(p) if i >= 0 else null)
    }
    churn()
    io.Println($keep.w.q.n)!
}
