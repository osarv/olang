# check: fail does not outlive the enclosing 'join' block
# P2: a lambda made inside the join block lives in the block it was made in - a task calling through it could
# outlive it
type Slot struct() { v mut I32 = 0 }
error E { X }
fn main() ? E {
    s Slot& = Slot()
    join {
        for i in range 4 {
            w := fn(t mut Slot&) { t.v = 1 }
            spawn w(s)
        }
    }
}
