# check: fail so it is written 'for x in try c'
# S9e: a loop whose Next can fail is written with try
error E {
    X
}
type It struct() {
    i mut I32 = 0
}
fn (t mut It&) Next() I32 ? E + Exhausted {
    if t.i > 2 { error Exhausted.END }
    t.i++
    return t.i
}
fn main() ? E {
    t It& = It()
    for x in t { }
}
