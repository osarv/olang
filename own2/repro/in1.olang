Dropped mut I64 = 0
type Sock struct(n I64) { n } destruct { Dropped++ }
type Conn struct(fd I64) {
    fd
    sock own mut Sock&
} destruct { Dropped++ }
type Server struct() { cur own mut Conn& }
fn churn() {
    j := List<String&>()
    for i in range 1 { j.Push("" $i) }
}
fn main() ? {
    s := Server()
    s.cur = Conn(1)
    s.cur.sock = Sock(7)
    d := s.cur.sock          # borrow the inner Sock
    s.cur.sock = Sock(9)     # release the OLD inner Sock while d borrows it - must conflict
    println($d.n)
}
