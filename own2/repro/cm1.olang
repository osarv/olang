Dropped mut I64 = 0
Run mut I64 = 1
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
} destruct { Dropped++ }
type Server struct() {
    cur own mut Conn&
    other own mut Conn&
}
fn churn() {
    j := List<String&>()
    for i in range 200 { j.Push("yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy" $i) }
}
fn main() ? {
    s := Server()
    s.cur = Conn(1)
    s.other = Conn(2)
    c := s.cur if Run > 0 else s.other   # a borrow chosen by a conditional
    s.other = null                        # releases the OTHER branch c may name
    churn()
    println($c.name)
}
