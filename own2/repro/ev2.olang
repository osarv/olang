Run mut I64 = 1
type Node struct(v I64) {
    v
    next own mut Node&
}
fn sumOf(l Node&) I64 {
    if l == null { return 0 }
    return l.v + sumOf(l.next)
}
fn build(n I64) I64 {
    head own mut Node& = null
    for i in range n {
        n2 own mut Node& = Node(i + 1)
        n2.next = take head
        head = take n2
    }
    return sumOf(head)
}
Baked I64 = build(10)
fn main() ? {
    assert build(4) == 10
    assert Baked == build(10 * Run) and Baked == 55
    println($Baked)
}
