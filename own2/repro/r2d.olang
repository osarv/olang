Dropped mut I64 = 0
type Node struct(v I64) {
    v
    name String& = "n" $v
} destruct { Dropped++ }
type Box struct() {
    arr Array<mut Node&, 3>
}
type Server struct() {
    cur own mut Box&
}
fn churn() {
    j := List<String&>()
    for i in range 200 { j.Push("yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy" $i) }
}
fn main() ? {
    s := Server()
    s.cur = Box()
    s.cur.arr[0] = Node(7)
    c := s.cur.arr[0]      # borrow of a Node inside cur's region (array element)
    s.cur = null           # releases cur's region incl the Node - must conflict
    churn()
    println($c.name)
}
