Dropped mut I64 = 0
type Sock struct(n I64) { n } destruct { Dropped++ }
type Conn struct(fd I64) {
    fd
    sock own mut Sock&
} destruct { Dropped++ }
type Server struct() { cur own mut Conn& }
fn churn() {
    j := List<String&>()
    for i in range 200 { j.Push("yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy" $i) }
}
fn main() ? {
    s := Server()
    s.cur = Conn(1)
    s.cur.sock = Sock(7)
    c := s.cur              # borrow of the Conn
    d := c.sock             # borrow of the Sock through c
    c.sock = null           # release the Sock through the borrow c - must conflict with d
    churn()
    println($d.n)
}
