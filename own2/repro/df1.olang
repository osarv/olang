Dropped mut I64 = 0
type Conn struct(fd I64) {
    fd
    name String& = "c" $fd
} destruct { Dropped++ }
type Server struct() {
    cur own mut Conn&
}
fn churn() {
    j := List<String&>()
    for i in range 200 { j.Push("yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy" $i) }
}
fn main() ? {
    s := Server()
    s.cur = Conn(1)
    c := s.cur
    defer println($c.name)    # runs at block exit, AFTER the release below - reads freed
    s.cur = null
    churn()
}
