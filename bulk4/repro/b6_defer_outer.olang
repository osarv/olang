import "std/io"

fn f(n I64) I64 {
    defer io.Println("defer " $n)!
    if n > 0 {
        become f(n - 1)
    }
    return 0
}

fn g(n I64) I64 {
    if n > 0 {
        defer io.Println("inner defer " $n)!
    }
    if n > 0 { become g(n - 1) }
    return 0
}

fn main() {
    io.Println($f(2))!
    io.Println($g(2))!
}
