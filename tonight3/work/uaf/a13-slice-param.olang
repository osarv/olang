type Node struct() {
    next mut Node& = null
    v I64 = 0
}
type E enum {
    A(n mut Node&)
    Z
}
type Box struct() {
    head mut Node& = Node()
    items Array<mut Node&, 2>
    e E = E.Z
    tag I64 = 0
}
type W struct(b Box) { b }
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn grow(b Box) {
    s := b.items[0:2]
    s[0].next = Node()
    s[0].next.v = 42
}
fn main() ? {
    w := W(Box())
    w.b.items[0] = Node()
    w.b.items[1] = Node()
    grow(w.b)
    churn()
    println($w.b.items[0].next.v)
}
