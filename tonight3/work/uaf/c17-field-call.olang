type Node struct() {
    next mut Node& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
    tag I64 = 0
}
type W struct(b Box) { b }
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type H struct(b Box) { b }
fn pickH(x mut H&) mut H&x { return x }
fn grow(r mut H&) {
    d Box = pickH(r).b
    d.head.next = Node()
    d.head.next.v = 42
}
fn main() ? {
    h := H(Box())
    grow(h)
    churn()
    println($h.b.head.next.v)
}
