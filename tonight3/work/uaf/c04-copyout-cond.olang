type Node struct() {
    next mut Node& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
    tag I64 = 0
}
type W struct(b Box) { b }
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn grow(r1 mut Box&, r2 mut Box&, c Bool) {
    d Box = r1 if c else r2
    d.head.next = Node()
    d.head.next.v = 42
}
fn main() ? {
    w := W(Box())
    {
        w2 := W(Box())
        grow(w.b, w2.b, true)
    }
    churn()
    println($w.b.head.next.v)
}
