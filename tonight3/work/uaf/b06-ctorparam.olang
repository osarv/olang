type Node struct() {
    next mut Node& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
    tag I64 = 0
}
type W struct(b Box) { b }
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type K struct(b Box) {
    b.head.next = Node()
    b.head.next.v = 42
    k := 1
}
fn main() ? {
    w := W(Box())
    q := K(w.b)
    churn()
    println($w.b.head.next.v " " $q.k)
}
