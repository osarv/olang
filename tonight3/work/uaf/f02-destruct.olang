type Node struct() {
    next mut Node& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
    tag I64 = 0
}
type W struct(b Box) { b }
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn two() (Box, I64) { return Box(), 1 }
fn grow(src mut W&) {
    b, k := two()
    src.b = b
    b.head.next = Node()
    b.head.next.v = 42
}
fn main() ? {
    w := W(Box())
    grow(w)
    churn()
    println($w.b.head.next.v)
}
