type Node struct() {
    next mut Node& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
    tag I64 = 0
}
type W struct(b Box) { b }
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
type E enum {
    A(b Box)
    Z
}
fn grow(e E&) {
    d := e as E.A
    d.head.next = Node()
    d.head.next.v = 42
}
fn main() ? {
    e := E.A(Box())
    grow(e)
    churn()
    println($(e as E.A).head.next.v)
}
