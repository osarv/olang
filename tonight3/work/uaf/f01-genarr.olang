type Node struct() {
    next mut Node& = null
    v I64 = 0
}
type Box struct() {
    head mut Node& = Node()
    tag I64 = 0
}
type W struct(b Box) { b }
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn grow(a <T>) {
    a[0].next = Node()
    a[0].next.v = 42
}
fn main() ? {
    arr := Array<mut Node&>(2, null)
    arr[0] = Node()
    grow(arr)
    churn()
    println($arr[0].next.v)
}
