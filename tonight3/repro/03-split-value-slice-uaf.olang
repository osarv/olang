# O17a (rvfix: "a value whose references live elsewhere than its storage is not held by reference"; pre-existing - db2af5d
# gives the same): a SLICE of a split value's inline array - or the E32b view "as Array<T, N>&" - is a reference to that
# storage, made without O17a's check (borrowLifetimeFits only sees a value converted to a reference type). Its elements
# are then read at the slice's scope - the value's storage block - though they are references into the source's nodes,
# so a Node built through one lands in that block and hangs off a node that outlives it. Same for a by-value parameter
# (O4b) - "fn grow(b Box) { s := b.items[0:2]; s[0].next = Node() }" - for a slice passed to a callee, for
# "for x in b.items[0:2]" and for "b.items[0:2][0].next = Node()" directly. "b.items[0].next = Node()" is correct.
# expected: an error at the slice/view (as for "r mut Box& = b"), or 42 42
# actual:   -b and -d print "-7 -7", -i prints "42 42"
type Node struct() {
    next mut Node& = null
    v I64 = 0
}
type Box struct() {
    items Array<mut Node&, 2>
}
type W struct(b Box) { b }
fn bySlice(src mut W&) {
    b := src.b
    s := b.items[0:2]
    s[0].next = Node()
    s[0].next.v = 42
}
fn byView(src mut W&) {
    b := src.b
    v := b.items as Array<mut Node&, 2>&
    v[1].next = Node()
    v[1].next.v = 42
}
fn churn() I64 {
    t I64 = 0
    for i in range 300 {
        a := Array<I64>(64, -7)
        t += a[3]
        s := $i $i $i "-" $(i * 7)
        t += s.Len()
    }
    return t
}
fn main() ? {
    w := W(Box())
    w.b.items[0] = Node()
    w.b.items[1] = Node()
    bySlice(w)
    byView(w)
    churn()
    println($w.b.items[0].next.v " " $w.b.items[1].next.v)
}
