type N struct() {
    next mut N?& = null
    v I64 = 0
}
type C struct(of mut N&) {
    cur mut N& = of
}
fn main() ? {
    g mut N& = N()
    {
        t mut N& = N()
        a := C(g)
        b := C(t)
        arr Array<mut C&> = Array<C&>[a, b]
        for k in range 2 { arr[k].cur.next = N() }
        assert g.next is not null and t.next is not null
        r N& = arr[1].cur
        assert r.next is not null
    }
    assert g.next is not null
}
