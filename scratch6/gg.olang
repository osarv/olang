import "std/io"

# B18a: -memory -check fails on a let-go early freeing does not follow - an element given a Vec of Vecs (O8f: the
# buffer is freed, the Vecs it holds kept)
fn main() {
    rows := Array<Vec<Vec<I64>>>(10)
    for i in range 1000 { rows[i % 10] = Vec<Vec<I64>>[Vec<I64>[i]] }
    io.PutLine($rows[3].Len())!
}
