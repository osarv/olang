import "std/io"

N I64 = 20000

fn inner(i I64) Vec<I64> {
    w Vec<I64>
    for j in range 30 { w.Push(i + j) }
    return w
}

fn outer(i I64) Vec<Vec<I64>> {
    o Vec<Vec<I64>>
    for j in range 5 { o.Push(inner(i + j)) }
    return o
}

fn words(i I64) Vec<Vec<String>> {
    o Vec<Vec<String>>
    for j in range 3 {
        w Vec<String>
        for k in range 4 { w.Push($i + "/" + $j + "/" + $k + " text") }
        o.Push(w)
    }
    return o
}

fn main() {
    rows := Array<Vec<Vec<I64>>>(10)
    v Vec<Vec<Vec<I64>>>
    for _ in range 10: v.Push(Vec<Vec<I64>>())
    ws := Array<Vec<Vec<String>>>(10)
    t := 0
    for i in range N {
        rows[i % 10] = outer(i)
        v[i % 10] = outer(i + 1)
        ws[i % 10] = words(i)
        v.RefMut(i % 10)[2] = inner(i * 2)
        t += rows[i % 10][4][29] + v[i % 10][2][0] + ws[i % 10][2][3].Len()
    }
    io.PutLine($t + " " + $ws[3][1][0])!
}
