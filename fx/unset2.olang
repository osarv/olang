import "std/io"

N I64 = 20000

fn mk(i I64) Vec<I64> {
    v Vec<I64>
    for j in range 100: v.Push(i + j)
    return v
}

type Doc struct(text String) { text }

fn main() {
    v Vec<I64>
    v = mk(0)
    for i in range N { v = mk(i) }
    d Doc
    d = Doc("")
    for _ in range N { d = Doc(d.text + "x") }
    u Vec<I64>
    for i in range N { u = mk(i) }
    io.PutLine($v[0] + " " + $d.text.Len() + " " + $u[0])!
}
