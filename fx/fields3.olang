import "std/io"

N I64 = 20000

type Model struct(w Vec<F64>) { w }


fn fill(n I64) Vec<F64> {
    out Vec<F64>
    for _ in range n: out.Push(0.0)
    return out
}

fn step(w Vec<F64>&) Vec<F64> {
    out Vec<F64>
    for x in w { out.Push(x + 1.0) }
    return out
}

fn main() {
    m := Model(fill(100))
    for _ in range N { m.w = step(m.w) }
    v := fill(100)
    m2 := Model(v)
    for _ in range N { m2.w = step(m2.w) }
    io.PutLine($m.w[0] + " " + $m2.w[0])!
}
