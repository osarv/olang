type Acc struct(f fn&(x I64) I64 pure) {
    n I64 = 0
    log Vec<I64> = Vec<I64>()
    scale fn&(x I64) I64 pure = f
}
fn (a mut Acc&) Add(x I64, f fn&(x I64) I64 pure) {
    a.n += f(x)
    a.log.Push(a.scale(x))
}
fn main() ? {
    accs := Vec<Acc>()
    for _ in range 3 { accs.Push(Acc(fn(x): return x * 3)) }
    g fn&(x I64) I64 pure = fn(x): return x + 1
    for i in range 30 { accs[i % 3].Add(i, fn(x): return x * 2) }
    for i in range 30 { accs[i % 3].Add(i, g) }
    assert accs[0].log.Len() == 20
    assert accs[1].n == 2 * (1 + 4 + 7 + 10 + 13 + 16 + 19 + 22 + 25 + 28) + (1 + 4 + 7 + 10 + 13 + 16 + 19 + 22 + 25 + 28) + 10
}
