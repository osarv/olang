fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn bytes(v Vec<Char>&) Array<U8>&v { return v.View() }
fn grow(w mut Vec<Char>&) {
    d := bytes(w)
    for i in range 1000 { w.Push('q') }
    churn()
    println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<Char>()
    v.Push('h')
    v.Push('i')
    grow(v)
}
