import "ownlib"
fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn main() ? {
    f := ownlib.Eat
    b own mut ownlib.Box& = ownlib.Box()
    k := 0
    for i in range 3 { k += f(b) }
    churn()
    println($b.Data[0] " " $k)
}
