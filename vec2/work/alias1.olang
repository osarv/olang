fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn grow(w mut Vec<I64>&, w2 mut Vec<I64>&) {
    d := w.View()
    for i in range 1000 { w2.Push(i + 100) }
    churn()
    println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    grow(v, v)
}
