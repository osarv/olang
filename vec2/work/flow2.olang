fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type CB struct() {
    text own mut String& = "hi"
}
fn raw(c CB&) Array<Char>&c { return c.text }
fn use(c mut CB&) {
    d := raw(c)
    c.text = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    churn()
    println($d[0] " " $d[1])
}
fn main() ? {
    c := CB()
    use(c)
}
