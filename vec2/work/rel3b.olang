fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type Pt struct(k I64) {
    a Array<I64, 3> = I64[k, k, k]
}
fn sl(a Array<Pt>&) Array<I64, 3>&a { return a[0].a }
fn grow(w mut Vec<Pt>&) {
    d := sl(w.View())
    for i in range 1000 { w.Push(Pt(i)) }
    churn()
    println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<Pt>()
    v.Push(Pt(7))
    grow(v)
}
