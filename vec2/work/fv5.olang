fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn view(v Vec<I64>&) Array<I64>&v { return v.View() }
type G<T> struct() { }
fn (g G<<T>>&) Call(v Vec<T>&) Array<T>&v { return v.View() }
fn apply(f fn(x Vec<I64>&) Array<I64>&x, v Vec<I64>&) Array<I64>&v { return f(v) }
fn grow(w mut Vec<I64>&) {
    d := apply(G<I64>(), w)
    for i in range 1000 { w.Push(i + 100) }
    churn()
    println($d[0] " " $d[1])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    grow(v)
}
