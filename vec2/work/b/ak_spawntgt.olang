fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn view(v Vec<I64>&) Array<I64>&v { return v.View() }
fn pushRet(w mut Vec<I64>&, x I64) I64 {
    for i in range 1000 { w.Push(i + x) }
    return x
}
fn first(a Array<I64>&) Array<I64>&a { return a[0:1] }
fn grow(w mut Vec<I64>&) {
    d := view(w)
    e mut Array<I64>& = d
    join {
        spawn e = first(d)
    }
    pushRet(w, 5)
    churn()
    println($e[0])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    grow(v)
}
