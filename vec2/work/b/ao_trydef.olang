fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn view(v Vec<I64>&) Array<I64>&v { return v.View() }
fn pushRet(w mut Vec<I64>&, x I64) I64 {
    for i in range 1000 { w.Push(i + x) }
    return x
}
fn tv(v Vec<I64>&) Array<I64>&v ? {
    if v.Len() == 0 { error }
    return v.View()
}
fn grow(w mut Vec<I64>&) {
    o := Vec<I64>()
    o.Push(3)
    d := try tv(w) catch default o.View()
    pushRet(w, 5)
    churn()
    println($d[0])
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    grow(v)
}
