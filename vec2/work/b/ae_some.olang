fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn view(v Vec<I64>&) Array<I64>&v { return v.View() }
fn pushRet(w mut Vec<I64>&, x I64) I64 {
    for i in range 1000 { w.Push(i + x) }
    return x
}
type E enum {
    A(a Array<I64>&)
    B
}
fn grow(w mut Vec<I64>&) {
    e := E.A(view(w))
    pushRet(w, 5)
    churn()
    match e {
        case E.A(a) { println($a[0]) }
        case E.B { }
    }
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    grow(v)
}
