fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
fn two(v Vec<I64>&) (Array<I64>&v, I64) { return v.View(), 1 }
fn grow(w mut Vec<I64>&) {
    d, k := two(w)
    for i in range 1000 { w.Push(i + 100) }
    churn()
    println($d[0] " " $d[1] " " $k)
}
fn main() ? {
    v := Vec<I64>()
    v.Push(10)
    v.Push(20)
    grow(v)
}
