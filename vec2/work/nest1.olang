fn churn() I64 {
    t := 0
    for i in range 3000 {
        s := $i "abcdefghijklmnopqrstuvwxyz0123456789"
        t += s.Len()
    }
    return t
}
type Inner struct() {
    sub own mut Array<I64>& = Array<I64>(2, 7)
    text own mut String& = "inner-text"
}
type Outer struct() {
    in own mut Inner& = Inner()
}
fn (o Outer&) First() Inner&o { return o.in }
fn (o Outer&) Txt() String&o { return o.in.text }
fn use1(o mut Outer&) {
    x := o.First()
    d := x.sub
    o.in.sub = Array<I64>(8, 9)
    churn()
    println($d[0])
}
fn main() ? {
    o := Outer()
    use1(o)
}
