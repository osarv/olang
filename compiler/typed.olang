# typed - the typed core language (compiler/DESIGN.md section 1.6.1): what check makes of each body, and all that the
# scope pass (scope, M6), lowering (lower, M7) and the evaluator (eval, M8) read of the program's code.
#
# The contract, in short:
# - A body is one function instance, constructor (a twin's own, G10d), destructor, lambda, test or global's
#   initializer, with every type concrete (an instance's own, G16): no type variable and no constant pattern is left in
#   it. An enum case's payload is a body too, with parameters and no code: where its marks live (T17c).
# - The surface grammar is gone. Operators on declared types are calls (E31), "==" on aggregates a helper (E10),
#   for-in and comprehensions loops (S9a-S9f, E27), matches decision tests over a value held once (S12, S13),
#   chains and joins explicit temporaries (E30, E11b), "and"/"or" conditionals (E7). What is left is 18 kinds of
#   expression, 8 of place and 15 of statement.
# - Places are told from values. A place names storage (a local, a global, a field, an element, a payload, what a
#   reference names); a value is computed. Read copies a place's value, Borrow makes a reference to the place itself
#   (E12c), Take moves an owner out of it (E34). Every other value is a temporary: new storage when it needs any.
# - Nothing is decided about scopes here. Each expression that may allocate, each call, each read of an own slot and
#   each temporary place has a site; each local a storage; and the scope pass fills a Plan saying where each is built
#   and what each call passes for its callee's scope variables. The plan holds placement only: nothing in it changes a
#   value, so a body evaluated with no plan (while checking) and with one (after) gives the same values.
# - Nodes are never written after check makes them. A decision made later about a node - an assert decided while
#   compiling (S18c), a global baked (K2), a literal's constructor run (T29d), a type's zero value (D13c) - is kept
#   beside the tree, under a key (DESIGN.md 1.8). A subtree holding a SiteId or a LocalId indexes one body's tables
#   and is never shared; any other subtree may be.
# - What a declaration says about where it lives is in its Mark, and a function's in its type: which parameters share
#   a scope variable, which results are built, borrowed or written as a type variable (types.ScopesOf). The scope
#   variables a call passes are types.ScopeVarsOf of the callee's type, in that order, for every pass alike.
# - Every node has the span of what it was made from, in its body's file; a subtree from another file (a default
#   argument written in a library, D8a, built again for each call with fresh ids) is wrapped in Away. Every expression
#   and place has its type.

import "source"
import "types"

# ---- ids ----

# a body, by its index in the program's table of bodies (check's)
type BodyId extends I32
# a body's local - a parameter, a variable, a held value, a hidden one, a binding, a capture, a field - by its index in
# Locals
type LocalId extends I32
# a body's block, by its index in Blocks: 0 is the body's outermost
type BlockId extends I32
# a body's site - an expression that may allocate, a call, a read of an own slot, a temporary place - by its index in
# Sites; -1 for none
type SiteId extends I32

# ---- declarations' scopes ----

# where a declaration says its reference lives (O3, O4, O25a): a parameter's, a local's, a field's (C2d) or a payload
# parameter's (T17c), as written; a result's, as its function type says (ResultMark)
type Mark enum {
    None              # no marker written: a value. A parameter so marked holding references has a scope variable of
                      # its own for them (O4b), a local's references are its block's (O18a)
    Bare              # "&": a parameter's own scope variable (O4b), a local's block (O25a), a field's instance (C2d), a
                      # result built in the result scope (O13)
    Of(local LocalId) # "&x": where x lives (O4a) - a parameter written before (one so marked shares x's scope variable
                      # and has none of its own), a local or parameter for a local or a result
    Global(module I64, name source.NameId)  # "&G": where a global lives, the program's scope (O1b) - a local's only
    Return            # "&return": the result scope (O26)
    Infer             # ":=", or a local written as a bare type variable: where its initializer lives (O25a, O25h)
    TypeVar           # a result written as a bare type variable: a result scope where it became a reference (O14b, T22a)
}

# what a body is
type BodyOf enum {
    Fn(instance I64)                        # a function or method instance (generic.Program.FnInstance)
    # the constructor of a declared type or instance (C2, G10b, T29d); twin binds the constructor's own type variables
    # (G10d), a twin of t with a constructor of its own - ListId(0) for a type with none
    Ctor(t types.TypeId, twin types.ListId)
    Case(t types.TypeId, tag I64)           # an enum case's payload: its parameters and their marks, no code (T17c)
    Dtor(t types.TypeId)                    # a destructor (C9): Params[0] the instance, "mut T&", in the closing scope
    Lambda(parent BodyId)                   # a lambda, checked where it is written (D16)
    Test(index I64)                         # a test block of the root module
    Global(module I64, name source.NameId)  # one global's initializer (K2): its order among its module's is B5a's,
                                            # computed once bodies are checked (DESIGN.md 1.6)
    # a condition the build decides that B9a could not evaluate (B9c, S8b), as a fn() Bool giving its value, checked in
    # its module's context for the evaluator: at the offset the condition starts at in the module's file
    Cond(module I64, at I32)
    # one item of a function's or constructor's contract as a function of its own (D17), body its body: a requirement
    # (Req) or a guarantee (Ensures) giving a Bool, or an entry value a guarantee reads (Entry) giving it; index its
    # place among the body's items of that kind
    Contract(body BodyId, kind ContractKind, index I64)
    # a table's slot (T32b): the function an "any"'s call reaches - its parameters the slot's, the instance first as a
    # reference to the type it is stored as - calling the instance's type's method, or the default it takes
    Thunk(table I64, slot I64)
    # a trait's method as an "any" calls it (T32b): its slot's signature and no code, the owner of the contract the
    # trait writes on the method (D17f)
    Slot(tr types.TypeId, slot I64)
}

type ContractKind enum {
    Req        # fn(the function's parameters) Bool ?, its errors those of the calls in it
}

# a body's contract (D17), its conditions made bodies of their own: each requirement's body, where it is written and
# its text; what diagnostics name the function and the file its contract is written in
type ContractInfo struct(Name String&, File I64) {
    Name
    File
    Reqs Vec<I64>
    ReqSps Vec<source.Span>
    ReqTexts Vec<String&>
}

# a scope relation a contract writes (D17d): Hi outlives Lo, each one of the body's scope variables, by its index in
# Vars; where it is written
type ScopeRel struct(Hi I64, Lo I64, Sp source.Span) {
    Hi
    Lo
    Sp
}

# one of a body's scope variables: what its hidden scope arguments, and its environment's scopes, stand for. The ones
# a call passes are types.ScopeVarsOf of the body's type, in that order (SetVars); a Capture, after them, is carried in
# the lambda's environment instead (D16c)
type ScopeVar enum {
    Param(local LocalId)    # where a reference parameter's referent lives, or a by-value one's references (O4b)
    Result                  # the result scope: where a built result is made (O14, O18a)
    Instance                # a constructor's: where its instance lands (C2d)
    Closing                 # a destructor's: the scope being closed (C9a)
    Capture(local LocalId)  # a lambda's: where a captured reference's referent lives (D16c)
}

type LocalKind enum {
    Param      # a parameter, the receiver first (M19)
    Var        # declared in the program's text
    # made by check, transparent: a value held for its one use, built where that use puts it (O18a) - D8d's call parts,
    # E29's operand, E30's chain values, S4c's values (each lands at its target before it is held), E31b's place and
    # indices, a match's subject, a destructured result (D8c)
    Held
    # made by check, storage of its own: a loop's counter, a for-in's iterator or borrowed collection (S9a), E31b's
    # handle copy (lent as its reference, O17b)
    Hidden
    Binding    # a match arm's (S13b)
    Capture    # a lambda's copy of what it captured (D16c)
    Field      # a constructor's field (C2a)
}

type Local struct(Name source.NameId, Sp source.Span, Ty types.TypeId, In BlockId, Kind LocalKind, Marked Mark) {
    Name       # 0 for a hidden one
    Sp
    Ty
    In         # the block it is declared in; a parameter's is 0
    Kind
    Marked     # where its declared type says it lives; a parameter's agrees with the body's type (ParamMark)
}

type BlockKind enum {
    Body       # a body's outermost: its frame scope - in a constructor (C2g) and a destructor (C9a) too, whose instance
               # and closing scope are scope variables (Var), not this block
    Plain      # a "{ }" (S1a), a branch, an arm, a clause of a try statement
    Loop       # a loop's body: a scope each turn (O2)
    Post       # a loop's post clause
    Clause     # a catch clause in value position
    Join       # a join block: on every way out it waits for its tasks (P1b) and fails with theirs (P4b)
    Defer      # deferred code, run on every way out of the block it is registered in (S19)
    ErrDefer   # an errdefer's: run only on the ways out of that block an error takes (S19e)
    Collect    # a comprehension's loop (E27)
}

type BlockInfo struct(Parent BlockId, Kind BlockKind, Sp source.Span) {
    Parent     # -1 for a body's outermost
    Kind
    Sp
}

type SiteKind enum {
    Call       # a call: the scopes it passes for its callee's variables - a built result's (Result) among them
    Make       # an array's storage: a literal, Array<T>(n) (D14), a tuple or case put in new storage
    # a temporary given storage for a reference to it (E12c, T17d); a new own object's region (O30); an owner or a
    # destructor-bearing value no slot receives, registered where it is built (O16, O30); an S4d copy of a place's old
    # value
    Promote
    Collect    # a comprehension's array (E27)
    Text       # a rendering or a join (E11a, E11b)
    Closure    # a lambda's environment (D16c, D16d), a Call adapter's (E31)
    Task       # a spawn's task environment, made in its join block (P1)
    Region     # a read of an own slot borrowing what it owns: the region it reads, which calls pass on (O32, O33)
    Temp       # a temporary place's storage: its block, or an arena over 64KB (E16a, T7c)
}

type SiteInfo struct(Kind SiteKind, Sp source.Span) {
    Kind
    Sp
}

# ---- places ----

# storage, named. A place's own subexpressions (a reference, an index) are evaluated left to right before it is used
type Place enum {
    Local(sp source.Span, ty types.TypeId, id LocalId)
    Global(sp source.Span, ty types.TypeId, module I64, name source.NameId)
    Deref(sp source.Span, ty types.TypeId, ref Expr&)              # what a reference value names (S4a)
    Field(sp source.Span, ty types.TypeId, base Place&, index I64) # a struct's, tuple's or payload's field, by position
    Elem(sp source.Span, ty types.TypeId, e Elem&)                 # an array's element
    Payload(sp source.Span, ty types.TypeId, p Payload&)           # an enum case's payload record (E32)
    Temp(sp source.Span, ty types.TypeId, value Expr&, site SiteId) # a value with no storage, given one (E16a, T7c)
    # in an Assign's value: the place of the nearest enclosing Assign, read where it is evaluated - a compound
    # assignment's old value (S4). A borrow of it is S4d's case as a borrow of the place written out is: check makes it
    # Promote(Read(Target)) where the value's type can hold it. Never in E31b's or R21's elaboration, which hold their
    # places in Held locals
    Target(sp source.Span, ty types.TypeId)
}

type Elem struct(Base Place&, Index Expr&, Checked Check) {
    Base
    Index
    Checked     # None for x[i] (E16), Try for x.Get(i) (E16d)
}

type Payload struct(Base Place&, Tag I64, Checked Check) {
    Base
    Tag
    Checked     # None after a test chose the case (S13b), Try for "as" (E32)
}

# what a failing operation does
type Check enum {
    None       # nothing is checked (E16, E6c)
    Abort      # a guaranteed check (S18a): a slice's bounds, an array's length, a copy into fixed storage
    Try        # it fails as written, to the innermost enclosing Try (E15a, R20): a.Get(i), a.SliceOf(lo, hi),
               # x.Narrow<T>(), e as C - each with its prelude word

}

# ---- expressions ----

type Expr enum {
    # a number, Bool, Char or null of type ty, as its bits: a float's IEEE pattern (E33), null all-zero bits (T2a). A
    # Lit of an aggregate is all-zero bits and nothing else: a zero value no constructor makes (D13c)
    Lit(sp source.Span, ty types.TypeId, bits I64)
    # read-only constant storage (T25d): a text literal, an array of constants - its elements constants too, text
    # among them; ty a read-only array reference. One instance per written position (file and span): two evaluations
    # of one literal, in any instance or call, are the same storage (E10c, K2b)
    Data(sp source.Span, ty types.TypeId, file I64, c Const&)
    # the value a place holds, copied - at the place's type, or one of its representation: a nominal conversion of a
    # place names its storage (T29a). A Read of an own slot at its type without "own" is a borrow of it (O32), its
    # site a Region one - the region read there, which a call passes on (O33); site -1 for any other Read
    Read(sp source.Span, ty types.TypeId, p Place&, site SiteId)
    Borrow(sp source.Span, ty types.TypeId, p Place&)       # a reference to the place itself (E12c); ty the reference
    Take(sp source.Span, ty types.TypeId, p Place&)         # the owner a place holds, moved out, null left (E34)
    Promote(sp source.Span, ty types.TypeId, pr Promote&)   # a temporary given storage, a reference to it (E12c)
    Call(sp source.Span, ty types.TypeId, c Call&)
    Make(sp source.Span, ty types.TypeId, m Make&)          # a tuple, an enum case, an array
    Collect(sp source.Span, ty types.TypeId, c Collect&)    # a comprehension's array, filled by its Yields (E27)
    Prim(sp source.Span, ty types.TypeId, op PrimOp, check Check, args Array<Expr&>&)
    Slice(sp source.Span, ty types.TypeId, s Slice&)        # part of an array's storage (E16a)
    Cond(sp source.Span, ty types.TypeId, c Cond&)          # "a if c else b" (E28), "and", "or" (E7)
    Seq(sp source.Span, ty types.TypeId, s Seq&)            # statements, then a value
    Match(sp source.Span, ty types.TypeId, m Match&)        # a match in value position (S12b); Eval'd as a statement
    Try(sp source.Span, ty types.TypeId, t Try&)
    Fn(sp source.Span, ty types.TypeId, f FnVal&)           # a function value (T21)
    Text(sp source.Span, ty types.TypeId, t Text&)          # renderings joined (E11a, E11b)
    Away(sp source.Span, file I64, x Expr&)                 # written in another file (D8a's defaults); x's type
}

# X given storage where its site's plan says, and a reference to it - or, X being an owner or a destructor-bearing
# value no slot receives, registered there (O16, O30). An S4d copy is Promote(Read(place)): the place's old value,
# taken before the store (check decides it by types)
type Promote struct(X Expr&, Site SiteId) {
    X
    Site
}

# a constant's value, as Data holds it: a number's bits (as Lit's), text, or an array's elements in order
type Const enum {
    Bits(v I64)
    Bytes(b Array<U8>&)
    Items(xs Array<Const&>&)
}

# what a call reaches
type Callee enum {
    # a function instance, a constructor (G10b, G10d), or a lambda called where it is written that captures nothing
    # (D16b): one that captures is made a value and called through it
    Body(id BodyId)
    Extern(f I64)                         # an extern fn (X1), by generic.Program's function index
    Value(x Expr&)                        # through a function value (E13b, T21)
    # through an "any"'s table (T32b): slot of the trait's slots (generic.Program.AnySlots), the call's Args[0] the
    # "any"; sig its signature, an "any" of the trait first
    Dispatch(tr types.TypeId, slot I64, sig types.TypeId)
    Helper(kind Helper, t types.TypeId)   # what lowering makes for a type (DESIGN.md 1.8)
}

# a helper is pure data: it compares or hashes parts by their own built-in operations and calls nothing. A comparison
# or hash consulting a declared Eq or Hash anywhere in its parts is elaborated by check into calls (E10a, E10b)
type Helper enum {
    Equal      # "==" part by part (E10)
    Hash       # the supplied Hash (E10b)
}

# a call: its arguments one per parameter in order, the receiver first, defaults filled in (D8a). A reference
# parameter's argument is a reference - a Borrow, a Promote, or a reference's value - and a by-value one's a value.
# A call to a fallible callee stands inside a Try, the innermost of which takes its errors - but a task's call, whose
# errors go to its Spawn's clauses and then its join (P4)
type Call struct(Target Callee&, Args Array<Expr&>&, Scoped Mark, Site SiteId, Zero Bool = false) {
    Target
    Args
    Scoped     # a written scope argument, "f&x(...)" (E25): Of(x), or Return; None for none
    Site
    # a type's zero value (D13c): its constructor on its parameters' defaults or zeros. Which it is - all zero bits, the
    # call, or none (an error at the declaration) - is decided once per type after check, by eval (DESIGN.md 1.8)
    Zero
}

type MakeKind enum {
    Tuple      # several results (D8c), Items its parts
    Case       # an enum case, Tag the case, Items its payload (T17)
    Array      # an array literal, Items its elements (E19)
    Fill       # Array<T>(n, fill) (D14, T8): Length the length, Items the one fill (or none: the zero value, D13c); its
               # type an Array<T, n> where n is a compile-time constant (QP1), else a run-time Array<T>
}

type Make struct(Kind MakeKind, Tag I64, Items Array<Expr&>&, Length Expr?&, Site SiteId, Checked Check) {
    Kind
    Tag
    Items
    Length     # null but for Fill
    Site       # -1 where nothing is allocated: a tuple, a case by value, a fixed array held in place (T7c)
    Checked    # Fill's length (D14b): Abort; None for every other kind and a length known in range
}

type Collect struct(Reserve Expr?&, Loop Block&, Site SiteId, Checked Check, Exact Bool = false) {
    Reserve    # how many it will hold at most, null where not known (E27)
    Loop
    Site
    Checked    # the reservation's length, as Fill's (D14b, E15a)
    Exact      # its loop yields exactly Reserve elements, one each turn (lane operators, E39): made once at that length,
               # each yield stored in place, never grown and never copied
}

# an operation over numbers, Bools and Chars - and the few the compiler supplies over other types (Len, Bits, the
# atomics). Operands are of the operation's type, widened before it (T6b); "==" here is on numbers and Bools only
# the operations whose result names the storage their first argument names (a conversion, T29a; a run-time trait value
# made of a reference, and its instance read back, T32): what is said of the argument's references is said of it
# whether a call is given a scope argument, "f&x(...)" or "f&return(...)" (E25): its result is built where that says,
# never where the call stands - so it is no temporary there, and is judged where it is put as existing storage is
fn ScopedCall(c Call&) Bool {
    return match c.Scoped {
        case Mark.Of(_), Mark.Return => true
        case _ => false
    }
}

# whether an expression is a call given a scope argument, converted or not: an array value whose storage is where the
# scope argument says (E25), never built where the expression stands
fn ScopedArray(x Expr&) Bool {
    return match x {
        case Expr.Call(_, _, c) => ScopedCall(c)
        case Expr.Prim(_, _, op, _, args) => PassesRefs(op) and args.Len() > 0 and ScopedArray(args[0])
        case Expr.Away(_, _, y) => ScopedArray(y)
        case Expr.Seq(_, _, q) => q.X is not null and ScopedArray(q.X!)
        case _ => false
    }
}

# T32a: whether the array an "any"'s box holds is provably new storage, built where the box is - then the box holds it
# as it is; anything else the box copies. One answer for every pass that makes a box - the scope pass, lowering with or
# without a plan, so the compile-time evaluator too. A conditional, a match or a try is new only if every value it can
# give is, a default included - a constant is not, since a writable any could write through it; a call only where its
# result is built where it lands: no scope argument puts it elsewhere, and an array value returned is the caller's own
# (T7b - a returned local a borrow kept elsewhere names is copied at its return, O26a)
fn AnyItemNew(t types.Table&, x Expr?&) Bool {
    if x is null { return false }
    match x {
        case Expr.Make(_, _, _), Expr.Promote(_, _, _), Expr.Collect(_, _, _), Expr.Text(_, _, _) { return true }
        case Expr.Call(_, ty, c) { return not ScopedCall(c) and arenaArray(t, ty) }
        case Expr.Cond(_, _, c) { return AnyItemNew(t, c.A) and AnyItemNew(t, c.B) }
        case Expr.Match(_, _, m) {
            if not m.IsValue { return false }
            for a in m.Arms {
                if a.Value is not null and not AnyItemNew(t, a.Value) { return false }
            }
            return m.NoMatch is null or m.NoMatch!.Value is null or AnyItemNew(t, m.NoMatch!.Value)
        }
        case Expr.Try(_, _, tr) {
            for c in tr.Clauses {
                for d in c.Defaults {
                    if not AnyItemNew(t, d) { return false }
                }
            }
            return AnyItemNew(t, tr.X)
        }
        case Expr.Seq(_, _, q) { return AnyItemNew(t, q.X) }
        case Expr.Away(_, _, y) { return AnyItemNew(t, y) }
        case Expr.Prim(_, _, op, _, args) { return PassesRefs(op) and args.Len() > 0 and AnyItemNew(t, args[0]) }
        case _ { return false }
    }
}

# whether a value of type ty is, or holds as a part, an array of a run-time length: storage of its own in an arena
fn arenaArray(t types.Table&, ty types.TypeId) Bool {
    r := t.Repr(ty)
    match t.KindOf(r) {
        case types.Kind.Array { return t.Length(r) == types.TypeId(0) }
        case types.Kind.Tuple, types.Kind.Record {
            for p in t.Items(t.Parts(r)) {
                if arenaArray(t, p) { return true }
            }
            return false
        }
        case _ { return false }
    }
}

fn PassesRefs(op PrimOp) Bool { return op == PrimOp.Convert or op == PrimOp.AnyMake or op == PrimOp.AnyInstance }

type PrimOp enum {
    Neg
    BitNot
    Not
    Add
    Sub
    Mul
    Div
    Rem
    Shl
    Shr
    BitAnd
    BitOr
    BitXor     # also a Bool's xor (E7)
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
    Same       # "a is b": two references, or two function values, naming one instance (E10c)
    # a value to ty: a number widened (T6b), narrowed, between integer and float (T4, E26); a temporary to a type of
    # its representation (T29); an array between a run-time and a fixed length (T7c, checked Abort to a fixed one)
    Convert
    Bitcast    # a value's bits as ty, of its width (E33)
    Len        # an array's length (E23)
    IsCase     # args [x, tag]: whether an enum value holds the case (E32, S13)
    AtomicLoad      # args[0] a Borrow of the integer place (P9)
    AtomicStore
    AtomicAdd
    AtomicSwap
    AtomicCompareSwap
    # "a.retire()" in the prelude (M19d): nothing, but under -sanitize the array's storage poisoned (B2f); the
    # evaluator marks it and stops on a later use of it, or of a view of it (K1, M19g), naming where the program grew
    # the collection
    Retire
    # "x.Destroy()" (C9b): args [a read of the local x] - the instance x names destructed now and its storage reclaimed,
    # where early freeing's analysis (compiler/free.olang) proves x the only way left to reach it; lowered as a Release
    Destroy
    # an integer's bits (E37): the three counts give an I64; the rotations take args [x, n], n converted to I64 and taken
    # modulo the width; ByteSwap gives x's type
    LeadingZeros
    TrailingZeros
    PopCount
    RotateLeft
    RotateRight
    ByteSwap
    # args [b]: b, once it holds - a contract's condition checked (D17e), failing with ArgumentError.INVALID
    Holds
    # E39: args [n, m], two lanes' lengths: n, once they are equal - checked Abort, once per lane operation
    LaneLen
    # E39: args [n], a length: nothing, once it is above zero - a total that needs an element (Min, Max), checked Try:
    # ArrayError.EMPTY
    NonEmpty
    # T32: args [r, t], r a reference to an instance - a borrow, a temporary's, a copy's box (T32a) - made an "any", ty:
    # the pair of r and table t (a Lit, its index in generic.Program's AnyTables). Where the "any" lives is where r's
    # referent does: a conversion, to section 8
    AnyMake
    # T34: args [x, w], an "any" and a Lit of a type: the reference to its instance, ty a reference to the type it is
    # stored as - checked (Abort, Try: WRONG_CASE) that its instance's type is w's, for "as"
    AnyInstance
    # T34: args [x, w]: whether the instance an "any" x holds is of the type w's type names - w a Lit of that type,
    # nothing but its type read
    AnyIs
}

type Slice struct(Base Place&, Lo Expr&, Hi Expr&, Checked Check) {
    Base
    Lo
    Hi         # both always present: an absent end is the base's length
    Checked    # Abort for x[lo:hi] (E16b), Try for x.SliceOf(lo, hi) (E16c)
}

# a choice of two values; only the one chosen is evaluated
type Cond struct(C Expr&, A Expr?&, B Expr&) {
    C
    A          # when C holds
    B
}

# statements run in the block the Seq stands in - their hidden locals are that block's - then X, the value: null, the
# Seq's type Void, for none (R21's "try x[i] += v" as a statement)
type Seq struct(Stmts Array<Stmt&>&, X Expr?&) {
    Stmts
    X
}

# a match: Held runs first (the subject held once in a hidden local, which the tests read; empty where the subject is
# a local, read again), then the arms in order. An arm's alternatives are tried in order; the first whose Test holds
# fills its bindings, then the guard is read, and if it does not hold the next arm is tried
type Match struct(Held Array<Stmt&>&, Arms Array<Arm&>&, NoMatch Arm?&, IsValue Bool) {
    Held
    Arms
    # what runs when no arm matches, never null: the written nomatch; an empty arm where nothing happens (a statement
    # match no arm covers); Exit(Unreachable) where S13a says nothing reaches it but a null reference does (S13a)
    NoMatch
    IsValue
}

type Arm struct(Sp source.Span, Alts Array<Alt&>&, Guard Expr?&, Code Block?&, Value Expr?&) {
    Sp
    Alts
    Guard      # null for none
    Code       # holds the arm's bindings; in a value match it runs before Value
    Value      # a value match's value, null where Code leaves
}

type Alt struct(Test Expr&, Binds Array<Bind&>&) {
    Test       # a Bool over the held subject (IsCase, "==", Bools of those)
    Binds
}

type Bind struct(To LocalId, From Expr&) {
    To         # one of the arm's Binding locals
    From       # what it takes: a payload field read through Payload with no check (S13b)
}

# a try: X is evaluated, and an error any call or checked operation in it fails with - none nested in an inner Try -
# goes to the first clause naming it; one no clause names leaves the body, re-encoded under its own errors (R17).
# Eval'd as a statement, a clause falls through to after it; in value position it leaves or gives its Defaults (R9b)
type Try struct(X Expr?&, Clauses Array<Clause&>&, Ends Bool = false, Passes Bool = false) {
    X
    Clauses
    Ends       # "x!" (E35): no clauses, and an error reaching it ends the program as a failed assert does
    Passes     # what its clauses do not take goes on to the try around it, where any other try's leaves the body (R13):
               # a loop's own call taking Exhausted (S9a) - to the loop's "in try" (S9e), a comprehension's try (E27) -
               # and a clause-less checked inside a try or a "!" (E15a, E35)
}

type Clause struct(Sp source.Span, Items Array<Item>&, All Bool, Code Block?&, Defaults Array<Expr&>&, Caught I64 = -1
                   CaughtSet types.ListId = types.ListId(0)) {
    Sp
    Items
    All        # an item-less clause: every error left
    Code       # null for none
    Defaults   # one per result, or none
    Caught     # R11b: the local holding the error the clause took, its code under CaughtSet (set where the clause is
    CaughtSet  # entered), -1 for none
}

# what a clause takes: one word of an error type, or every word (-1)
type Item struct(Err types.TypeId, Word I64) {
    Err
    Word
}

type FnVal enum {
    Named(body BodyId)                                         # a function as a value: no environment (T21)
    Lambda(body BodyId, captures Array<Capture&>&, site SiteId) # a lambda's body and what it copies in (D16c)
    Adapter(call BodyId, receiver Expr&, site SiteId)          # an instance whose type has Call, as a function (E31)
}

type Capture struct(Inner LocalId, Outer Expr&) {
    Inner      # the lambda body's Capture local
    Outer      # the value copied in, read where the lambda is made: a Read, or a Borrow of a value array (T7b)
}

type Text struct(Pieces Array<Piece&>&, Site SiteId) {
    Pieces     # every Render's operand is evaluated, left to right, before any piece is rendered (E11b)
    Site
}

type Piece enum {
    Lit(bytes Array<U8>&)   # text written in the program
    # "$x" (E11a): x evaluated with the others before any piece renders (E11b); an operand naming an array is a Borrow
    # of it, read when its piece renders (T7b) - "$a $bump(a)" renders a's elements as bump left them
    Render(x Expr&)
}

# ---- statements ----

type Block struct(Id BlockId, Stmts Array<Stmt&>&) {
    Id
    Stmts
}

type Stmt enum {
    Let(sp source.Span, local LocalId, init Expr&)  # a local declared, with its first value (always one, D13c)
    # a store: Target's subexpressions are evaluated, then Value, then it is stored (S4); a compound assignment's
    # value reads the old value through Place.Target. Storing into an own slot releases what it held (O30). Moving an
    # owner is always a Take written in Value (E34): "x := take p", a call's owned result handed on
    Assign(sp source.Span, target Place&, value Expr&)
    Eval(sp source.Span, x Expr&)                   # a value computed and dropped: a call, a try statement, a match
    If(sp source.Span, i If&)
    # a loop, its body run until a Jump leaves it; a continue runs Post, then the body again. "do ... for c" is a Post
    # of "if not c { break }"; S9e's one-shot loop a body ending in Jump(Break)
    Loop(sp source.Span, body Block&, post Block?&)
    Jump(sp source.Span, kind JumpKind, loop BlockId)    # break or continue, of the loop whose body block is named
    # null for none; several results a Make of a tuple; an owner local returned is a Take of it (O36, O42)
    Return(sp source.Span, value Expr?&)
    Raise(sp source.Span, err types.TypeId, word I64)   # "error E.WORD" (R3)
    Reraise(sp source.Span, code Expr&, from types.ListId)   # "error e" (R3a): a caught error's code under from, raised
    Exit(sp source.Span, kind ExitKind, msg Expr?&)  # msg: an unreachable's message (S16d), null for none
    Assert(sp source.Span, cond Expr&, msg Expr?&)   # msg null for none; read only when it fails (S17)
    Block(sp source.Span, b Block&)
    Defer(sp source.Span, b Block&)                 # registered here, run on every way out of the enclosing block
    Join(sp source.Span, j Join&)
    Spawn(sp source.Span, s Spawn&)
    Yield(sp source.Span, x Expr&)                  # appended to the innermost Collect
    # a generator's value (S20): x the result of the Next that asked (never null - typed as Return's, so the two are
    # walked as one), its body going on after this at the next
    Suspend(sp source.Span, x Expr?&)
}

type If struct(Test Expr&, Then Block&, Else Block?&) {
    Test
    Then
    Else       # null for none
}

type JumpKind enum {
    Break
    Continue
}

type ExitKind enum {
    Unreachable    # S16d
    NullReached    # T2c, E35: "x!" on a null reference
}

type Join struct(Code Block&, Tried Bool, Clauses Array<Clause&>&) {
    Code
    Tried      # "try join": it fails with the earliest-spawned task's error (P4b, P4c)
    Clauses
}

# a task: Task, a call, run on a thread of its own; its results stored into Targets on that thread (P1g); an error it fails
# with goes to the first of Clauses naming it, run on that thread (P4a), else to the join (P4b). At the spawn the
# targets' places are evaluated first, left to right, then the task's arguments (P1g, S4)
type Spawn struct(Targets Array<Place?&>&, Task Expr&, Clauses Array<TaskClause&>&, Site SiteId) {
    Targets
    Task       # a Call - of a lambda's function value for "spawn fn() { ... }" (D16e)
    Clauses
    Site       # the task's environment, made in the join block
}

type TaskClause struct(Sp source.Span, Items Array<Item>&, All Bool, Handler Expr?&) {
    Sp
    Items
    All
    # a lambda's function value, called on the task's thread; null for "catch E { }" (P4a). Its result is the targets'
    # value: the default for one target, a tuple of them for several; with no targets it has none
    Handler
}

# ---- bodies ----

# a body: its locals, blocks and sites, and once checked its outermost block. Params are the receiver first; Vars its
# scope variables, the passed ones in the order a call passes them (SetVars), then its captures
type Body struct(Id BodyId, Of BodyOf, Ty types.TypeId, File I64, Sp source.Span) {
    Id
    Of
    # its function type, the receiver first, with its scopes (types.ScopesOf): a constructor's and a payload's RoleCtor,
    # a destructor's RoleDtor; a test's and a global initializer's fn()
    Ty
    File
    Sp
    Params Vec<LocalId>
    Vars Vec<ScopeVar>
    Locals Vec<Local>
    Blocks Vec<BlockInfo>
    Sites Vec<SiteInfo>
    # a constructor's: what its instance is assembled from, in field order (C2a). Their Marked are the field marks
    # section 8 reads (C2d, O20, O23a): a bare field lives with the instance, "&p" where the argument p lived - for an
    # instance's and a twin's constructor, their own
    Fields Vec<LocalId>
    Root Block?& = null     # null until checked; a payload's (Case) stays null
    Written Vec<ScopeRel>   # the scope relations its contract writes (D17d), which section 8 holds every call to
    # S18d: what its error return trace says where a Raise starts - "pick: y > x" for a requirement false on entry
    # (D17) - by the Raise's span's start; "raised here" where none is given
    RaiseAt Vec<I32>
    RaiseWhat Vec<String&>
    Gen Bool = false    # a generator's Next (D18): a lambda its Suspends give values from, its end an Exhausted
    # D18e: the hidden iterators of for-ins over a generator made by a direct call right there - the call's walk made
    # and finished in the for-in's block, no one else holding the generator (check.walkIter)
    Walks Vec<LocalId>
}

fn (b mut Body&) AddLocal(l Local) LocalId {
    b.Locals.Push(l)
    return LocalId(I32(b.Locals.Len() - 1))
}

fn (b mut Body&) AddBlock(parent BlockId, kind BlockKind, sp source.Span) BlockId {
    b.Blocks.Push(BlockInfo(parent, kind, sp))
    return BlockId(I32(b.Blocks.Len() - 1))
}

fn (b mut Body&) AddSite(kind SiteKind, sp source.Span) SiteId {
    b.Sites.Push(SiteInfo(kind, sp))
    return SiteId(I32(b.Sites.Len() - 1))
}

fn (b Body&) Local(id LocalId) Local { return b.Locals[I64(id)] }

# the scope variables a call passes, from types.ScopeVarsOf of the body's type (one function for every pass, so a
# call, the body and a function value's adapter agree): a parameter's index its Param, ResultVar the result scope - a
# constructor's instance - and ClosingVar a destructor's closing scope. A lambda's captures follow, added by check
fn (b mut Body&) SetVars(vars Array<I64>&) {
    for v in vars {
        if v == types.ClosingVar {
            b.Vars.Push(ScopeVar.Closing)
        } else if v == types.ResultVar {
            ctor := match b.Of {
                case BodyOf.Ctor(_, _), BodyOf.Case(_, _) => true
                case _ => false
            }
            b.Vars.Push(ScopeVar.Instance if ctor else ScopeVar.Result)
        } else {
            b.Vars.Push(ScopeVar.Param(b.Params[v]))
        }
    }
}

# a parameter's mark, as its body's type says: "&x" where it shares parameter x's scope variable, Bare where it is a
# reference, None where it is a value
fn (b Body&) ParamMark(t types.Table&, i I64) Mark {
    j := t.ShareOf(b.Ty, i)
    if j >= 0 { return Mark.Of(b.Params[j]) }
    return Mark.Bare if t.IsRef(t.Items(t.Params(b.Ty))[i]) else Mark.None
}

# a result's mark, as its body's type says: built (Bare), borrowed from a parameter (Of), or written as a bare type
# variable (TypeVar)
fn (b Body&) ResultMark(t types.Table&, k I64) Mark {
    e := t.ResultFrom(b.Ty, k)
    if e == types.FromTypeVar { return Mark.TypeVar }
    if e >= 0 { return Mark.Of(b.Params[e]) }
    return Mark.Bare
}

# whether block a is block d or encloses it
fn (b Body&) Encloses(a BlockId, d BlockId) Bool {
    x := d
    for x >= BlockId(0) {
        if x == a { return true }
        x = b.Blocks[I64(x)].Parent
    }
    return false
}

# ---- the plan: what the scope pass decides ----

# where something is built, or what is passed for a scope variable
type Scope enum {
    Unset               # a site not decided: lowering's stand-in reads it as Program (M7 before M6), as does eval
    Block(b BlockId)    # a block's arena (O2); Block(0) is the frame scope - a constructor's and a destructor's too
    Var(i I64)          # one of the body's own scope variables, by its index in Vars
    Program             # the program's scope (O1b)
    # a region the early-free analysis has lowering make at site s (O8d, Plan's Region fields)
    Region(s SiteId)
    Frame               # the body's frame, no arena: a stack slot; an environment no callee keeps (D16c)
    # a live scope nothing is built in: passed where a callee only reads - a value O12 lends for reading, the receiver
    # of a Str "$" calls (E11c) - lowering opens one, and the MIR verifier refuses any build into it
    Inert
}

# the scope pass's decisions for one body: where each site builds (Built), where each local's storage is (Stored: a
# stack slot unless O26a or T7c put it in an arena), the scopes each call passes for its callee's variables (Passed) -
# at a Closure site the scopes of the lambda's captures, or of an adapter's instance (E31), in order - and which of
# the body's own variables it may build into (MayBuild: a closure's prologue asks for its part of a captured scope
# only where it may, P2). Placement only: nothing here changes a value. What lowering allocates by fixed rules of its
# own - a text builder's scratch, Str's per-call scope, hold slots, a task's stand-ins, a try default's slot - is
# listed in DESIGN.md 1.8; every other allocation into a body's scope variable is a site this plan placed
type Plan struct(Sites I64, Locals I64, Vars I64) {
    Built mut Array<Scope>& = Array<Scope>(Sites)
    Stored mut Array<Scope>& = Array<Scope>(Locals, Scope.Frame)
    MayBuild mut Array<Bool>& = Array<Bool>(Vars)
    # by local: a value array the function returns, living in the result scope (O26a), that nothing else can name - so it
    # is returned as it is; every other returned array is copied at its return, so the result is the caller's own (T7b)
    RetSole mut Array<Bool>& = Array<Bool>(Locals)
    # O8d, the early-free analysis's (compiler/free.olang): by site, a region made where the site's value is - 1 a region
    # of its own, a kid of RegionParent (or of RegionRoot's value's region, when that is one), 2 the region RegionRoot's
    # value is in, else RegionParent. The site's own Built, and its parts', then say Region(site)
    RegionKind mut Array<I64>& = Array<I64>(Sites)
    RegionParent mut Array<Scope>& = Array<Scope>(Sites)
    RegionRoot mut Array<Expr?&>& = Array<Expr?&>(Sites)
    passedAt mut Array<I64>& = Array<I64>(Sites)  # 1 + where a call's scopes start in passed; 0 for none recorded
    passedN mut Array<I64>& = Array<I64>(Sites)
    passed Vec<Scope>
}

fn NewPlan(b Body&) Plan { return Plan(b.Sites.Len(), b.Locals.Len(), b.Vars.Len()) }

# what a call at a site passes, one scope per callee variable that is not a Capture, in order
fn (pl mut Plan&) Pass(site SiteId, scopes Array<Scope>&) {
    pl.passedAt[I64(site)] = pl.passed.Len() + 1
    pl.passedN[I64(site)] = scopes.Len()
    for s in scopes { pl.passed.Push(s) }
}

# a call at a site passing another scope for its callee's i-th variable (compiler/free.olang's regions)
fn (pl mut Plan&) SetPassed(site SiteId, i I64, sc Scope) {
    at := pl.passedAt[I64(site)]
    if at == 0 or i >= pl.passedN[I64(site)] { return }
    pl.passed[at - 1 + i] = sc
}

# the scope a call passes for its callee's i-th passed variable: Unset where nothing is recorded
fn (pl Plan&) Passed(site SiteId, i I64) Scope {
    at := pl.passedAt[I64(site)]
    if at == 0 or i >= pl.passedN[I64(site)] { return Scope.Unset }
    return pl.passed[at - 1 + i]
}

# ---- reading a tree ----

fn (x Expr&) Span() source.Span {
    return match x {
        case Expr.Lit(sp, _, _), Expr.Data(sp, _, _, _), Expr.Read(sp, _, _, _), Expr.Borrow(sp, _, _) => sp
        case Expr.Take(sp, _, _), Expr.Promote(sp, _, _), Expr.Call(sp, _, _), Expr.Make(sp, _, _) => sp
        case Expr.Collect(sp, _, _), Expr.Prim(sp, _, _, _, _), Expr.Slice(sp, _, _), Expr.Cond(sp, _, _) => sp
        case Expr.Seq(sp, _, _), Expr.Match(sp, _, _), Expr.Try(sp, _, _), Expr.Fn(sp, _, _), Expr.Text(sp, _, _) => sp
        case Expr.Away(sp, _, _) => sp
    }
}

fn (x Expr&) Type() types.TypeId {
    return match x {
        case Expr.Lit(_, ty, _), Expr.Data(_, ty, _, _), Expr.Read(_, ty, _, _), Expr.Borrow(_, ty, _) => ty
        case Expr.Take(_, ty, _), Expr.Promote(_, ty, _), Expr.Call(_, ty, _), Expr.Make(_, ty, _) => ty
        case Expr.Collect(_, ty, _), Expr.Prim(_, ty, _, _, _), Expr.Slice(_, ty, _), Expr.Cond(_, ty, _) => ty
        case Expr.Seq(_, ty, _), Expr.Match(_, ty, _), Expr.Try(_, ty, _), Expr.Fn(_, ty, _), Expr.Text(_, ty, _) => ty
        case Expr.Away(_, _, y) => y.Type()
    }
}

fn (p Place&) Type() types.TypeId {
    return match p {
        case Place.Local(_, ty, _), Place.Global(_, ty, _, _), Place.Deref(_, ty, _), Place.Field(_, ty, _, _) => ty
        case Place.Elem(_, ty, _), Place.Payload(_, ty, _), Place.Temp(_, ty, _, _), Place.Target(_, ty) => ty
    }
}

fn (p Place&) Span() source.Span {
    return match p {
        case Place.Local(sp, _, _), Place.Global(sp, _, _, _), Place.Deref(sp, _, _), Place.Field(sp, _, _, _) => sp
        case Place.Elem(sp, _, _), Place.Payload(sp, _, _), Place.Temp(sp, _, _, _), Place.Target(sp, _) => sp
    }
}

fn (s Stmt&) Span() source.Span {
    return match s {
        case Stmt.Let(sp, _, _), Stmt.Assign(sp, _, _), Stmt.Eval(sp, _), Stmt.If(sp, _), Stmt.Loop(sp, _, _) => sp
        case Stmt.Jump(sp, _, _), Stmt.Return(sp, _), Stmt.Raise(sp, _, _), Stmt.Exit(sp, _, _), Stmt.Assert(sp, _, _) => sp
        case Stmt.Reraise(sp, _, _) => sp
        case Stmt.Block(sp, _), Stmt.Defer(sp, _), Stmt.Join(sp, _), Stmt.Spawn(sp, _), Stmt.Yield(sp, _) => sp
        case Stmt.Suspend(sp, _) => sp
    }
}

# ---- printing (DESIGN.md section 4, point 6: "dump typed" serves review and check's tests) ----

# a body as text: a statement a line, indented by its block, an expression as a parenthesized term naming its kind
fn (b Body&) Print(t mut types.Table&) String {
    w mut printer&t = printer(t)
    w.line(0, "body " $b.Locals.Len() " locals " $b.Blocks.Len() " blocks " $b.Sites.Len() " sites")
    if b.Root is not null { w.block(b.Root!, 1) }
    return w.out.ToString()
}

type printer struct(T mut types.Table&) {
    T
    out StringBuilder
}

fn (w mut printer&) line(depth I64, text String&) {
    for k in range depth { w.out.Push("  ") }
    w.out.Push(text)
    w.out.PushChar('\n')
}

fn (w mut printer&) block(bl Block&, depth I64) {
    w.line(depth - 1, "{" $bl.Id)
    for s in bl.Stmts { w.stmt(s, depth) }
}

fn (w mut printer&) stmt(s Stmt&, d I64) {
    match s {
        case Stmt.Let(_, l, x) { w.line(d, "let L" $l " = " $w.expr(x)) }
        case Stmt.Assign(_, p, x) { w.line(d, "assign " $w.place(p) " = " $w.expr(x)) }
        case Stmt.Eval(_, x) { w.line(d, "eval " $w.expr(x)) }
        case Stmt.If(_, i) {
            w.line(d, "if " $w.expr(i.Test))
            w.block(i.Then, d + 1)
            if i.Else is not null {
                w.line(d, "else")
                w.block(i.Else!, d + 1)
            }
        }
        case Stmt.Loop(_, body, post) {
            w.line(d, "loop")
            w.block(body, d + 1)
            if post is not null {
                w.line(d, "post")
                w.block(post, d + 1)
            }
        }
        case Stmt.Jump(_, k, l) { w.line(d, $("break" if k == JumpKind.Break else "continue") " {" $l) }
        case Stmt.Return(_, x) { w.line(d, "return" $(" " $w.expr(x) if x is not null else "")) }
        case Stmt.Raise(_, e, word) { w.line(d, "raise " $w.T.Canon(e) "." $word) }
        case Stmt.Reraise(_, x, _) { w.line(d, "reraise " $w.expr(x)) }
        case Stmt.Exit(_, k, _) { w.line(d, "exit " $short($k)) }
        case Stmt.Assert(_, c, _) { w.line(d, "assert " $w.expr(c)) }
        case Stmt.Block(_, bl) { w.block(bl, d + 1) }
        case Stmt.Defer(_, bl) {
            w.line(d, "defer")
            w.block(bl, d + 1)
        }
        case Stmt.Join(_, j) {
            w.line(d, "join" $(" try" if j.Tried else ""))
            w.block(j.Code, d + 1)
        }
        case Stmt.Spawn(_, sp) { w.line(d, "spawn " $w.expr(sp.Task) " site " $sp.Site) }
        case Stmt.Yield(_, x) { w.line(d, "yield " $w.expr(x)) }
        case Stmt.Suspend(_, x) { w.line(d, "suspend " $w.expr(x!)) }
    }
}

fn (w mut printer&) exprs(xs Array<Expr&>&) String {
    b := StringBuilder()
    for k in range xs.Len() {
        if k > 0 { b.PushChar(' ') }
        b.Push(w.expr(xs[k]))
    }
    return b.ToString()
}

fn (w mut printer&) expr(x Expr?&) String {
    if x is null { return "_" }
    ty := w.T.Canon(x.Type())
    return match x {
        case Expr.Lit(_, _, v) => "(lit " $ty " " $v ")"
        case Expr.Data(_, _, f, c) => "(data " $ty " " $f " " $constText(c) ")"
        case Expr.Read(_, _, p, site) => "(read " $w.place(p) $(" site " $site if site >= SiteId(0) else "") ")"
        case Expr.Borrow(_, _, p) => "(borrow " $ty " " $w.place(p) ")"
        case Expr.Take(_, _, p) => "(take " $w.place(p) ")"
        case Expr.Promote(_, _, pr) => "(promote " $ty " " $w.expr(pr.X) " site " $pr.Site ")"
        case Expr.Call(_, _, c) => "(call " $w.callee(c.Target) " " $w.exprs(c.Args) " site " $c.Site ")"
        case Expr.Make(_, _, m) => "(make " $short($m.Kind) " " $ty " " $w.exprs(m.Items) ")"
        case Expr.Collect(_, _, c) => "(collect " $ty " site " $c.Site ")"
        case Expr.Prim(_, _, op, ck, args) => "(" $short($op) $(" " $short($ck) if ck != Check.None else "") " " $ty " " $w.exprs(args) ")"
        case Expr.Slice(_, _, s) => "(slice " $w.place(s.Base) " " $w.expr(s.Lo) " " $w.expr(s.Hi) ")"
        case Expr.Cond(_, _, c) => "(cond " $w.expr(c.C) " " $w.expr(c.A) " " $w.expr(c.B) ")"
        case Expr.Seq(_, _, s) => "(seq " $s.Stmts.Len() " " $w.expr(s.X) ")"
        case Expr.Match(_, _, m) => "(match " $m.Arms.Len() " arms, nomatch " $m.NoMatch!.Code!.Stmts.Len() ")"
        case Expr.Try(_, _, t) => "(try " $w.expr(t.X) " " $t.Clauses.Len() " clauses)"
        case Expr.Fn(_, _, f) => "(fn " $ty ")"
        case Expr.Text(_, _, t) => "(text " $t.Pieces.Len() " site " $t.Site ")"
        case Expr.Away(_, file, y) => "(away " $file " " $w.expr(y) ")"
    }
}

# a constant as text: a number, "text N" for N bytes of text, "[...]" for an array's elements
fn constText(c Const&) String {
    return match c {
        case Const.Bits(v) => $v
        case Const.Bytes(b) => "text " $b.Len()
        case Const.Items(xs) => constItems(xs)
    }
}

fn constItems(xs Array<Const&>&) String {
    b := StringBuilder()
    b.PushChar('[')
    for i in range xs.Len() {
        if i > 0 { b.PushChar(' ') }
        b.Push(constText(xs[i]))
    }
    b.PushChar(']')
    return b.ToString()
}

# an enum case's name without its type's
fn short(t String&) String&t {
    at := try t.FindLast(".") catch { return t }
    return t[at + 1:]
}

fn (w mut printer&) callee(c Callee&) String {
    return match c {
        case Callee.Body(id) => "B" $id
        case Callee.Extern(f) => "extern " $f
        case Callee.Value(x) => $w.expr(x)
        case Callee.Helper(k, t) => $short($k) " " $w.T.Canon(t)
        case Callee.Dispatch(r, k, _) => "dispatch " $w.T.Canon(r) "#" $k
    }
}

fn (w mut printer&) place(p Place&) String {
    return match p {
        case Place.Local(_, _, id) => "L" $id
        case Place.Global(_, _, m, n) => "G" $m ":" $n
        case Place.Deref(_, _, r) => "*" $w.expr(r)
        case Place.Field(_, _, base, i) => $w.place(base) "." $i
        case Place.Elem(_, _, e) => $w.place(e.Base) "[" $w.expr(e.Index) "]"
        case Place.Payload(_, _, pl) => $w.place(pl.Base) " as " $pl.Tag
        case Place.Temp(_, _, v, site) => "tmp " $w.expr(v) " site " $site
        case Place.Target(_, _) => "target"
    }
}

# ---- tests ----

# "fn add(a I32, b I32) I32 { s := a + b; return s }", as check would make it
test "a body: locals, blocks and sites, read back and printed" {
    names := source.Names()
    t := types.NewTable(names)
    i32 := t.Prim("I32")
    sp := source.Span(0, 10)
    b := Body(BodyId(0), BodyOf.Fn(0), t.Func(t.List(types.TypeId[i32, i32]), i32, types.ListId(0)), 0, sp)
    root := b.AddBlock(BlockId(-1), BlockKind.Body, sp)
    a := b.AddLocal(Local(names.Intern("a"), sp, i32, root, LocalKind.Param, Mark.None))
    c := b.AddLocal(Local(names.Intern("b"), sp, i32, root, LocalKind.Param, Mark.None))
    s := b.AddLocal(Local(names.Intern("s"), sp, i32, root, LocalKind.Var, Mark.Infer))
    b.Params.Push(a)
    b.Params.Push(c)
    none := SiteId(-1)
    sum := Expr.Prim(sp, i32, PrimOp.Add, Check.None, Expr&[Expr.Read(sp, i32, Place.Local(sp, i32, a), none)
                                                              Expr.Read(sp, i32, Place.Local(sp, i32, c), none)])
    b.Root = Block(root, Stmt&[Stmt.Let(sp, s, sum), Stmt.Return(sp, Expr.Read(sp, i32, Place.Local(sp, i32, s), none))])
    assert sum.Type() == i32 and sum.Span() == sp
    assert b.Local(s).Marked == Mark.Infer and b.Encloses(root, root)
    got := b.Print(t)
    assert got == "body 3 locals 1 blocks 0 sites\n{0\n  let L2 = (Add I32 (read L0) (read L1))\n  return (read L2)\n", got
}

test "a plan: what each site builds into and each call passes, Unset where nothing is decided" {
    names := source.Names()
    t := types.NewTable(names)
    sp := source.Span(0, 1)
    b := Body(BodyId(0), BodyOf.Test(0), t.Func(types.ListId(0), types.VoidT, types.ListId(0)), 0, sp)
    root := b.AddBlock(BlockId(-1), BlockKind.Body, sp)
    loop := b.AddBlock(root, BlockKind.Loop, sp)
    call := b.AddSite(SiteKind.Call, sp)
    mk := b.AddSite(SiteKind.Make, sp)
    b.Vars.Push(ScopeVar.Result)
    assert b.Encloses(root, loop) and not b.Encloses(loop, root)
    pl := NewPlan(b)
    assert pl.Built[I64(mk)] == Scope.Unset and pl.Passed(call, 0) == Scope.Unset and pl.Stored.Len() == 0
    pl.Built[I64(mk)] = Scope.Block(loop)
    pl.Pass(call, Scope[Scope.Var(0), Scope.Program])
    assert pl.Built[I64(mk)] == Scope.Block(loop)
    assert pl.Passed(call, 0) == Scope.Var(0) and pl.Passed(call, 1) == Scope.Program and pl.Passed(call, 2) == Scope.Unset
}

# "fn link(a mut N&, b N&a) N&a { return b }" and its pieces: marks and scope variables read off the type alone
test "a body's marks and scope variables come from its type; constants, temporaries and matches as check makes them" {
    names := source.Names()
    t := types.NewTable(names)
    m := t.AddModule("t")
    n := t.Named(t.AddDecl(m, names.Intern("N"), types.DeclKind.Struct, 0), types.ListId(0))
    i64 := t.Prim("I64")
    t.SetStructBody(n, t.List1(i64), false)
    mutN, roN := t.Ref(n, types.Writable), t.Ref(n, types.ReadOnly)
    ty := t.Func(t.List(types.TypeId[mutN, roN]), roN, types.ListId(0)
                 t.Scopes(types.RoleFn, I64[types.OwnScope, 0], I64[0]))
    sp := source.Span(0, 4)
    b := Body(BodyId(1), BodyOf.Fn(0), ty, 0, sp)
    root := b.AddBlock(BlockId(-1), BlockKind.Body, sp)
    a := b.AddLocal(Local(names.Intern("a"), sp, mutN, root, LocalKind.Param, Mark.Bare))
    c := b.AddLocal(Local(names.Intern("b"), sp, roN, root, LocalKind.Param, Mark.Of(a)))
    b.Params.Push(a)
    b.Params.Push(c)
    b.SetVars(t.ScopeVarsOf(ty))
    assert b.Vars.Len() == 1 and b.Vars[0] == ScopeVar.Param(a)
    assert b.ParamMark(t, 0) == Mark.Bare and b.ParamMark(t, 1) == Mark.Of(a) and b.Local(c).Marked == b.ParamMark(t, 1)
    assert b.ResultMark(t, 0) == Mark.Of(a)
    # a constructor's result scope is its instance's
    k := Body(BodyId(2), BodyOf.Ctor(n, types.ListId(0))
              t.Func(t.List1(i64), n, types.ListId(0), t.Scopes(types.RoleCtor, I64[types.OwnScope], I64[types.OwnScope]))
              0, sp)
    k.Params.Push(k.AddLocal(Local(names.Intern("v"), sp, i64, BlockId(0), LocalKind.Param, Mark.None)))
    k.SetVars(t.ScopeVarsOf(k.Ty))
    assert k.Vars.Len() == 1 and k.Vars[0] == ScopeVar.Instance
    # a read of an own slot borrows it at a Region site; a temporary place has a site; text arrays are constants
    region := b.AddSite(SiteKind.Region, sp)
    tmp := b.AddSite(SiteKind.Temp, sp)
    owner := t.Ref(n, types.Owning | types.Writable)
    w mut printer&t = printer(t)
    borrow := Expr.Read(sp, roN, Place.Local(sp, owner, a), region)
    assert w.expr(borrow) == "(read L0 site 0)", w.expr(borrow)
    temp := Place.Temp(sp, i64, Expr.Lit(sp, i64, 7), tmp)
    assert w.place(temp) == "tmp (lit I64 7) site 1" and temp.Type() == i64
    chars := t.Ref(t.Array(t.Prim("U8"), types.TypeId(0)), types.ReadOnly)
    words := Expr.Data(sp, t.Ref(t.Array(chars, types.TypeId(0)), types.ReadOnly), 3
                       Const.Items(Const&[Const.Bytes(U8[104, 105]), Const.Bytes(U8[])]))
    assert w.expr(words) == "(data Array<Array<U8>&>& 3 [text 2 text 0])", w.expr(words)
    # a valueless Seq, and a match whose nomatch is an empty arm where nothing happens
    seq := Expr.Seq(sp, types.VoidT, Seq(Stmt&[Stmt.Eval(sp, Expr.Lit(sp, i64, 0))], null))
    assert w.expr(seq) == "(seq 1 _)"
    none := Arm(sp, Alt&[], null, Block(root, Stmt&[]), null)
    mt := Expr.Match(sp, types.VoidT, Match(Stmt&[], Arm&[], none, false))
    assert w.expr(mt) == "(match 0 arms, nomatch 0)"
}
