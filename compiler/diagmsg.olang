# diagmsg - what a diagnostic is: which one (msgs.Diag), the rule of the specification it applies, and its text. msgs
# makes every one, by a function of its own; diag records one against where it is about. Apart from msgs so that msgs's
# functions are no builders of a type of their own module (D19a): they make a diagmsg.Msg, as anything may.

import "msgs"

# a diagnostic: which one it is, the rule it applies (empty where no rule states it), and its text - the headline, what
# is wrong, in about 80 characters. The reason it is wrong is its Note and what to write instead its Help, each a row of
# its own after the headline (B11); either is empty where the headline says it all
type Msg struct(Kind msgs.Diag, Rule String&, Text String&, Note String& = "", Help String& = "") {
    Kind
    Rule
    Text
    Note
    Help
}
