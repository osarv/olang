test "errors: inferred sets across a cycle, checked, words, noreturn and ! (R1a, R1c, E15a, D8e, E35)" {
    dir := try os.MkTemp() catch os.OsError { unreachable }
    defer { try os.RemoveAll(dir) catch os.OsError { } }
    l := testLoad(dir, ("error E {\n    A\n    B\n}\nextern fn exit(code I32) noreturn\nfn die() noreturn { exit(1) }\n"
                       "fn even(n I64) Bool ? {\n    if n < 0 { error E.A }\n    return true if n == 0 else try odd(n - 1)\n}\n"
                       "fn odd(n I64) Bool ? { return false if n == 0 else try even(n - 1) }\n"
                       "fn half(a I32, b I32) I32 ? E.B { return checked (a / b) catch BuiltinError default 0 }\n"
                       "fn never() ? { }\n"
                       "fn pick(n I64) I64 {\n    if n > 0 { return n }\n    die()\n}\n"
                       "fn main() {\n    never()\n    x := try even(4) catch E.A default false\n"
                       "    y := odd(3)!\n    z := try half(1, 0) catch E.B default die()\n}\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := generic.Program(l, r)
    c := Checker(p, false)
    c.RootOnly = true
    c.CheckProgram()
    assert rootRules(l) == "", rootRules(l)
    assert c.Attempts == 2, $c.Attempts
}

