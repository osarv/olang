# check - the type checker (compiler/DESIGN.md 1.6, 1.6.1; M5b, M5c): every body of the program - each function instance,
# constructor, enum case's payload, destructor, lambda, test and global's initializer - checked against the rules of
# SPEC.md outside section 8 and K, and elaborated into the typed core language (typed), which is all that the scope pass,
# lowering and the evaluator read of the program's code.
#
# Checking is demand-driven and memoized per declaration (DESIGN.md 1.6): a body is made the first time it is asked for
# - a call asks for its callee's instance, a name for its global - and queued; each queued body is checked once, from
# start to end, with no pass over the program again. A body asked for while being checked (a global's type its own
# initializer needs) is a cycle, said where it is asked for. Types come from generic (written types, instances,
# inference, constraints, methods) and types (identity, layout).
#
# Elaboration lowers the surface grammar to what exists (PRINCIPLES.md): operators on declared types are calls of their
# methods (E31), "==" on aggregates an Eq call or a helper (E10, E10a), and/or conditionals (E7), conversions and
# borrows explicit (T6b, E12c), a compound assignment's old value read through Lvalue.Target (S4), loops one Loop with
# Jumps (S9).
#
# What the checker meets and does not check yet is recorded as a gap (Gaps), never said as a diagnostic: the acceptance
# (compiler/tools/checkdiff.olang) counts a program as checked clean only when it has neither errors nor gaps.

import "std/pair"
import "std/os"
import "source"
import "token"
import "scan"
import "ast"
import "diag"
import "msgs"
import "cond"
import "fetch"
import "load"
import "names"
import "types"
import "generic"
import "typed"
import "definit"

# ---- the checker ----

# a body being checked: its id, its module, the context its written types are read in (its variables bound to an
# instance's arguments), its result and errors, and what is in scope - one flat map of names, since D3 and D3a forbid
# shadowing, with an undo log for leaving a block
type frame struct(Body I64, Mi I64, File I64, Result types.TypeId, Errors types.ListId) {
    Body
    Mi
    File
    typeAt Map<I64, diag.Where>   # T2c: where a local's or a parameter's type is written, by local
    Ctx generic.Context = generic.Context(0, -1)
    Result     # Void for none; a tuple for several (D8c)
    Errors     # the declared error set, the default error DefaultErrT among them (R15)
    Block I64 = 0
    bound Map<source.NameId, I64>
    undo Vec<pair.Pair<source.NameId, I64>>
    loops Vec<I64>        # the loops around, innermost last: each one's body block, what continue moves on
    exits Vec<I64>        # beside each, the loop break leaves: a run-wise walk's outer loop for its inner (S9f)
    InTest Bool = false
    InCtor Bool = false
    CtorOf types.TypeId = types.UnknownT   # a constructor's: the type it makes, whose fields its field declarations are
    Tries I64 = 0          # how many tries and !s enclose: a fallible call needs one (R8, E35)
    Fallible I64 = 0       # how many fallible calls and operations were met under one (R8, E15a)
    LoopFails I64 = 0      # how many of a for-in's own calls can fail with more than Exhausted (S9e)
    Gapped Bool = false    # a construct not checked yet was met: what is derived from the whole body is not said
    Parent I64 = -1        # a lambda's: the frame of the body it is written in (D16c)
    Gen Bool = false       # a generator's body, its Next's (D18): a lambda whose yields give its values (S20)
    GenHome I64 = -1       # ... whose elements live where it does (D18c): the capture "&return" names there
    deferBlocks Vec<I64>  # the blocks around with deferred code registered so far, innermost last (S19, S20)
    InferResult Bool = false   # a lambda's result taken from its first return (D16b)
    InferErrors Bool = false   # a lambda's errors taken from its body (D16b), an inferred set's (R1a)
    Settles Bool = false       # a function's or constructor's body whose set is inferred (R1a)
    leaks Vec<types.TypeId>   # what its errors and uncaught tries let out, in order (D16b)
    passed Vec<types.TypeId>  # what a try nested in another's operand lets out: it leaves the body, never seen by the
                               # outer try's clauses (R13)
    captures Vec<typed.Capture&>
    Inst I64 = -1              # a destructor's: its instance parameter, whose fields it reads bare (C10)
    InTaskClause Bool = false  # a task's clause, run on the task: it may not leave it (P4a)
    TargetFails I64 = 0        # tasks binding targets that can fail into their join (P4d)
    DeferLoops I64 = -1        # in deferred code: the loops around it then - none of them a jump may leave (S19b)
    MsgLoops I64 = -1          # in an assert's or an unreachable's message: the same (S17, S16d)
    MsgOfUnreachable Bool = false  # the message is an unreachable's
    DeferJoins I64 = -1        # in deferred code: the joins around it then, none of which its spawns may join (S19b)
    joins Vec<I64>            # the join blocks around, innermost last: how many spawns each holds (P1a)
    joinMarks Vec<I64>        # where each one's errors start in joinErrs
    joinErrs Vec<types.TypeId>    # what the tasks of the joins around let out, in order (P4b)
    spawnSaid I64 = 0              # spawned calls said to need try (P4): their join is not said to need none
    DiagMark I64 = 0               # the diagnostics said before it began: what it says counts against its body (K1a)
    stored Map<source.NameId, Bool> # the names a body assigns as a whole after declaring them (T7d: such a local's
                                    # length is known only at run time)
    fixed Map<source.NameId, I64>   # a condition's body (ExprBodyIn): the fixed locals it reads, by name (S8c), of
    fixedIn I64 = -1                # the body it was asked in
    # S8d: the locals narrowed to one case, innermost last, their payload fields' copies in narrowFields; and the
    # statements of the block being checked with the next one's index, which the narrowing after a leaving if reaches
    narrows Vec<narrowed>
    narrowFields Vec<I64>
    nonNullSet Array<source.NameId>& = Array<source.NameId>(0) # S8e: the path the statement being checked assigned a never-null value
    nulls Vec<nullNarrow>   # S8e: the paths known not to be null, each held by a block, and dead once assigned
    rest Array<ast.Stmt&>& = Array<ast.Stmt&>(0)
    restAt I64 = 0
    # D17: a contract item's body - CtReq, CtEns or CtEntry; in a guarantee's, its results' names, and the entry values
    # it reads by where each is written (ctKey), each one of its parameters
    Contract I64 = 0
    ctResults Map<source.NameId, Bool>
    ctSubst Map<I64, I64>
    ctFrom I64 = 0          # where its statements start on the statement stack
    # R11b: the names the catch clauses around gave the errors they took, innermost last, whether each is used, and what
    # narrowing leaves of each here, innermost last
    errBinds Vec<errBind>
    errUsed Vec<Bool>
    errNarrows Vec<errNarrow>
    # T20: a match's subject held once, the AST its chain of tests names it by, and whether it is never null
    errPinSp source.Span = source.Span(-1, -1)
    errPinLocal I64 = -1
    errPinNonNull Bool = false
}

# R11b: a name a catch clause gave the error it took - its local (the error's code under Set) and the set the clause
# took, in the canonical order its codes count by; where it is written
type errBind struct(Name source.NameId, Local I64, Set types.ListId, Sp source.Span) {
    Name
    Local
    Set
    Sp
}

# R11b, T20: what of an error local's set a test leaves it in a block - its entries; dead once the local is assigned
type errNarrow struct(Name source.NameId, Now types.ListId, Block I64, Dead Bool = false) {
    Name
    Now
    Block
    Dead
}

CtReq I64 = 1
CtEns I64 = 2
CtEntry I64 = 3

fn ctKey(sp source.Span) I64 { return (I64(sp.Start) << 32) | I64(sp.End) }

# S8d: a local narrowed to one case of its enum - the case, the enum, where its payload fields' copies start in the
# frame's narrowFields, and the block it holds for
# S8e: a path - a local or parameter and the fields read after it - known not to be null in a block, until a statement
# assigns it or a path it starts with (Dead)
type nullNarrow struct(Path Array<source.NameId>&, Block I64, Dead Bool = false) {
    Path
    Block
    Dead
}

type narrowed struct(Local I64, Tag I64, Enum types.TypeId, From I64, Block I64, Dead Bool = false) {
    Local
    Tag
    Enum
    From
    Block
    Dead
}

fn (n narrowed) Killed() narrowed { return narrowed(n.Local, n.Tag, n.Enum, n.From, n.Block, true) }

# S8d: how many narrowings of each kind a frame holds, to drop what one operand's narrowing added once it is checked
type factsMark struct(Nulls I64, Cases I64, Errs I64) {
    Nulls
    Cases
    Errs
}

# a construct met and not checked yet: where, and what (the acceptance's "gap")
type Gap struct(File I64, Sp source.Span, What String&) {
    File
    Sp
    What
}

type Checker struct(P mut generic.Program&, Tests Bool) {
    hole typed.Expr& = typed.Expr.Lit(source.Span(0, 0), types.UnknownT, 0)   # an argument callBody checks itself
    P
    Tests                                  # a test build (the root module's test blocks are checked in every build, S15)
    RootOnly Bool = false                  # only the root module's declarations, and what they ask for (tests)
    spellItem Bool = false                 # spelling an item of a list: a function type holding a comma is grouped (L18c)
    spellQualified Bool = false            # spelling a type as code in this module writes it: another module's by its alias
    spellIn I64 = -1                       # explain's module, where Ty spells types qualified from (B11b)
    spellGroup Bool = false                # the next function type is grouped: a result before its signature's "?"
    s4d Vec<typed.Lvalue&>                 # S4d: the value places an assignment writes over, while its values are checked
    placeWrite Bool = false                # S8e: the place asked for next is a target written, of its declared type
    enumWanted Bool = false                # S8d: the expression checked next is a case test's, an "as"'s or a match's
                                           # subject - a local narrowed to a payload written whole is read as its enum
    nullDecl diag.Where = diag.Where.Nowhere  # T2c: where the type a value is fitted to is written, for the note naming "?&"
    Bodies Vec<mut typed.Body&>
    Gaps Vec<Gap>
    frames Vec<mut frame&>
    queue Vec<I64>
    queued I64 = 0
    state Vec<I64>                        # by body: 0 waiting, 1 being checked, 2 checked
    fnBodies Map<I64, I64>                 # a function instance's body
    capSaid Map<pair.Pair<I64, I64>, Bool> # D9c: the parameters already reported, by file and position - once each
    byValSaid Map<pair.Pair<I64, I64>, Bool>   # D9a: parameters reported as arrays by value - a pun of one adds no T7a
    ctorBodies Map<pair.Pair<I64, I64>, I64>   # a type's constructor's body, by type and twin (G10d)
    instsOf Map<I64, I64>                  # by generic function: how many instances were made (G17)
    ctorCalled types.TypeId = types.UnknownT  # the type whose constructor callBody is calling: its defaults (D8a)
    # E40: while the defaults of a call are built, the call's place, which Place.Here in one is - the outermost call's
    # (hereFile -1 outside any default)
    hereFile I64 = -1
    hereAt source.Span = source.Span(0, 0)
    placeT types.TypeId = types.TypeId(-1)
    globalBodies Map<pair.Pair<I64, I64>, I64>  # (module, name): a global's initializer's body
    globalTypes Map<pair.Pair<I64, I64>, types.TypeId>
    globalDecls Vec<pair.Pair<I64, I64>>  # (module, name): the globals in declaration order, the branches chosen (B5a)
    b5aSaid Map<I64, Bool>                 # the global bodies in a cycle said already (B5a)
    litLocals Map<pair.Pair<I64, I64>, Bool>  # (body, local): a number ":=" declared of its literal's own type (T6a)
    rangeEnds Map<pair.Pair<I64, I64>, source.Span>  # (body, local): a for-in's variable over literals, its range's end
    rangeExprs Map<pair.Pair<I64, I64>, Bool>        # ... whose end is a literal-only expression, not one literal
    rangeEnd source.Span = source.Span(-1, -1)       # the range being walked, while its variable is declared
    rangeEndLit Bool = false
    exprs Vec<typed.Expr&>                # nodes being gathered into lists, nested lists on top
    stmts Vec<typed.Stmt&>
    atRecs Vec<atRec>                     # each x[i] read through At as a place: what writing back through it needs
    laneNodes Vec<laneNode>               # E39: the lane operations not built yet, a placeholder naming each
    laneAccept Bool = false                # E39: the expression checked next may be left as lanes for its taker
    lastErrs types.ListId = types.ListId(0)   # the errors of the call checked last (P4: a task's)
    tryStmt Bool = false                      # the try being built is a statement: its clauses give no value (R11)
    decided Bool = false                      # the call being built is a declared number's constructor run on a literal (T29d)
    eqAt source.Span = source.Span(-1, -1)    # where the "==" being elaborated is written (M6b's error)
    strAt source.Span = source.Span(-1, -1)   # where the "$" whose renderings are being found is written (M6b's error)
    hashAt source.Span = source.Span(-1, -1)  # where the supplied Hash whose parts are being found is called (M6b's error)
    compoundAt source.Span = source.Span(-1, -1)  # a compound assignment's operator, while its target is read (E31)
    opIn source.Span = source.Span(-1, -1)    # where "in" is written, for the Has or Contains being built (E29)
    opCall String& = ""                       # the operator method a call being built stands for (E31): what it says
    textT types.TypeId = types.TypeId(-1)
    charT types.TypeId = types.TypeId(-1)
    raws Map<I64, rawTable&>               # by enum declaration: its raw values (T17e)
    # R1a: the bodies whose error set is inferred, each one's set once checked, what was read of one not final yet (a
    # cycle) - its body and the set's length then - and the bodies whose set rests on such a read
    inferring Map<I64, Bool>
    inferredErrs Map<I64, types.ListId>
    errReads Vec<pair.Pair<I64, I64>>
    unsettled Map<I64, Bool>
    # what each inferred set came to, by body (bodyKey) - kept from one attempt to the next, where checking starts
    errPresets Map<pair.Pair<I64, I64>, types.ListId>
    found Map<pair.Pair<I64, I64>, types.ListId>
    Attempts I64 = 0
    boundsMet Map<types.TypeId, Bool>         # a type instance's constraints, checked where it was first asked for (G19)
    # T25c: the locals that are read-only copies, by (body, local), each with the name of what it copies (0 for none);
    # a for-in's hidden borrow of a value, by (body, local): whether that value is reached read-only
    roCopies Map<pair.Pair<I64, I64>, source.NameId>
    roBorrows Map<pair.Pair<I64, I64>, Bool>
    # a reference local made from a place, by (body, local): the place, and whether the reference names its storage (a
    # borrow, a slice, a view) rather than having been read out of it - what read-only copies and parameters reach
    roFrom Map<pair.Pair<I64, I64>, roOrigin>
    # ...and a by-value parameter's need of a writable argument, read off its body: by (body, parameter) the ones
    # written through, lent writably or stored; what a parameter passed on as another's argument needs in turn; the
    # read-only copies passed as arguments and the bodies made function values, judged once every body is checked
    roNeeds Map<pair.Pair<I64, I64>, Bool>
    roDeps Vec<pair.Pair<pair.Pair<I64, I64>, pair.Pair<I64, I64>>>
    roArgs Vec<roArg>
    roFns Vec<roFn>
    # ...and through a generic instance's read-only reference parameters (roByArg): every value given a local of an
    # instance's body, by (body, local); the parameters a by-value result is copied out of, by (body, parameter)
    # (roToResult); the by-value results and the values kept writable in instance bodies, by body, settled at the
    # body's end and once every body is checked; the arguments whose parameters decide in turn; the read-only
    # references passed to such a parameter, an error where it needs a writable one
    roVals Map<pair.Pair<I64, I64>, Vec<typed.Expr&>>
    roToResult Map<pair.Pair<I64, I64>, Bool>
    roResults Vec<pair.Pair<I64, typed.Expr&>>
    roDeepNeeds Vec<pair.Pair<I64, typed.Expr&>>
    roDeepArgs Vec<roDeepArg>
    roRefArgs Vec<roArg>
    unknownTypes Map<pair.Pair<I64, I64>, Bool>    # (module, name): an unknown type said there once (B11)
    unknownSaid Map<pair.Pair<I64, I64>, Bool>     # (body, name): an unknown name said there (S13f's), not again
    paramTypes Bool = false                         # a declared function's parameters' types being checked (G29)
    declMade Bool = false                           # a declaration's type, its value given: what T7d's lengths come from
    syntaxMark I64 = -1                             # the diagnostics said before checking began: the syntax errors
    # B9c, S8b: the local ifs whose condition the build decides that evaluation decided, by (file, the condition's
    # start) - what the driver found in an earlier check of the program, given before this one; and the local ifs this
    # check met undecided, each with its condition's body (CondBody) for the evaluator
    Decided Map<pair.Pair<I64, I64>, Bool>
    Asks Vec<Ask>
    EmbedAsks Vec<EmbedAsk>
    # S18c: the asserts whose condition reads no local, each with its condition's body and its message's, for the
    # evaluator to decide while compiling
    AssertAsks Vec<AssertAsk>
    # S17a: the top-level asserts that checked, each with its condition's body and its message's, which the evaluator
    # must decide
    TopAsserts Vec<TopAssertAsk>
    tails Vec<tailAsk>          # S21: the become statements met, their error sets compared once every set is final
    # T29d, D13c: the literals entering a declared number through its constructor, and the zero values a constructor
    # makes, each with a body giving that value for the evaluator to decide while compiling
    ValueAsks Vec<ValueAsk>
    unsets Vec<unsetCand>       # D13d: the locals declared with no value, judged once the attempt has checked
    heldWalks Vec<heldCand>     # D18e: the locals walked by a for-in or a comprehension, judged once the attempt has checked
    idle Vec<idleCall>          # S3: the call statements whose value is dropped, judged once the attempt has checked
    # E27: a comprehension's walk - 1 while its block is yet to be opened (comprOpen: where its source's setup ends, so
    # its reservation is counted before the loop), 2 once open (comprId, comprOuter, comprMark, comprFrom), 3 filling the
    # fixed array comprOut of a count known while compiling (T7c) by its counter comprIdx; comprKnown that count, the walk's
    comprState I64 = 0
    comprId I64 = -1
    comprOuter I64 = -1
    comprMark I64 = -1
    comprFrom I64 = -1
    comprOut I64 = -1
    comprIdx I64 = -1
    comprKnown I64 = -1
    noClear Bool = false        # D14d: the Array<T>(n) being checked is filled by the loop after it - made with no clear
    # D17: each function's or constructor's body's contract, its items made bodies of their own, by body - made the
    # first time it is asked for (ctDone says it was, Contracts holds it where there is one); the calls whose
    # requirements the evaluator decides, each a body of its own; the conversions likewise (D17g)
    Contracts Map<I64, typed.ContractInfo>
    ctDone Map<I64, Bool>
    ContractAsks Vec<ContractAsk>
    # each contract ask's calling body, and the asks a try handles - its clauses taking ArgumentError (D17e: decided
    # at run time, as written)
    contractCallers Vec<I64>
    ContractHandled Map<I64, Bool>
    asking Bool = false         # a ValueAsk's body is being built: what it makes asks nothing again
    # G30: an assert's condition is being made a body of its own - a constant variable the instance it is checked for
    # binds is read as its value (a condition's is not: one parse of a local if serves every instance, S8b)
    constsRead Bool = false
    unknowns I64 = 0           # the stand-ins made for what did not check: a body holding one is never evaluated (K1a)
    CondReadUnknown Bool = false   # the last condition body refused for reading what did not check, said already
    Faulty Map<I64, Bool>       # the bodies checking met an error or a gap in (K1a: never evaluated while compiling)
    # S8c: by (body, local), a plain scalar local declared with its own value - its initializer and type; and every local
    # a body writes (stores, increments, targets, atomics). A condition or assert asked for reading such a local reads
    # its initializer, and is the running program's after all where the body writes the local (rewritten)
    fixedInits Map<pair.Pair<I64, I64>, fixedInit>
    writes Map<pair.Pair<I64, I64>, Bool>
    lastFixed Vec<I64>         # the locals the last ExprBodyIn read as fixed, of the body it was asked in
    # S8a: the bodies reading a build constant (B10), for the evaluator's usedBuild; and the local ifs whose condition
    # evaluation decided reading none (given before this check, as Decided) - the same on every build, an error
    ReadsBuild Map<I64, Bool>
    Dead Map<pair.Pair<I64, I64>, Bool>
    anyBad Map<I64, Bool>       # T32: the tables a method of which the trait's signature cannot reach (said once)
    caseBroken Bool = false     # T34: a type case of the match being checked names a type wrongly (said at it)
    reflTouched Bool = false    # G35: the condition being folded read a reflected member
    reflSaid Bool = false       # G35, S18c: the message reflText last rendered read a reflected member
    spreadBad Bool = false      # G37: an argument comprehension that could not spread, said (its call is unknown)
    testKeys StringBuilder      # B7a: the root's tests of a target, each target and description between zero bytes
    namedBad Bool = false       # E14b: arguments by name that do not give the parameters, said (the call is unknown)
    argOrder Vec<I64>           # E14b: for the next callBody, the written position of each parameter's argument, -1 for none
    typeCaseBinds Vec<pair.Pair<source.NameId, types.TypeId>>   # G36: what the type case matchOnType chose binds
    slotsCalled Map<I64, diag.Where>  # T32b: the slots (SlotKey) some call through an "any" reaches, by its first call
    lazyThunks Vec<I64>        # T32a: the default slots' thunks nothing has called yet, each an "unreachable" for now
}

# T17e: an enum's raw values - its raw type (UnknownT for none), whether that is text, and each case's value: an
# integer's bits (as Lit's) or text's bytes
type rawTable struct(Ty types.TypeId, Text Bool, Bits Array<I64>&, Bytes Array<Array<U8>&>&) {
    Ty
    Text
    Bits
    Bytes
}

# a local that may be fixed (S8c): its initializer, checked again where a condition reads it, and its type
type fixedInit struct(Init ast.Expr&, Ty types.TypeId) {
    Init
    Ty
}

# a top-level assert (S17a): where it is - its file, its span, what a decision is reported at - and its condition's body
# and its message's (-1 for none), each a function of no parameters the evaluator runs
type TopAssertAsk struct(File I64, Sp source.Span, At source.Span, Cond I64, Msg I64) {
    File, Sp, At, Cond, Msg
}

# an assert the evaluator may decide (S18c): the body it is in, where it is (its file and span), its condition's body
# (BodyOf.Cond) and its message's, -1 for none
type AssertAsk struct(Body I64, File I64, Sp source.Span, At source.Span, Cond I64, Msg I64, Fixed Array<I64>&
    Ctx diag.Where, CtxText String&, Said Bool = false, SaidText String& = "", Written String& = "") {
    Body
    File
    Sp
    At         # what a decision is reported at: the condition's operator, as stage 0 reports it
    Cond       # -1: decided false already, by reflection (G35)
    Msg
    Said       # its message rendered already, by reflection (G35): SaidText
    SaidText
    # its message as written, "" for none: what a false one's error carries where the message cannot be rendered while
    # compiling - it reads what only the running program knows
    Written
    Fixed      # the locals of Body it reads as fixed (S8c)
    # G30, G16b: the instance it was checked for, where its constant variables are read - where it was asked for and
    # the note naming it ("instantiated here, with a.Len() = 6"); "" for none
    Ctx
    CtxText
}

# a call's requirement the evaluator decides while compiling (D17e), or a conversion's (D17g): the body giving the
# condition's value (BodyOf.Cond), where the call is (its file and span), where the condition is written (its file and
# span; the argument's for a conversion), the function diagnostics name ("" for a conversion), the condition as written
# (the argument for a conversion), the instance it was asked in (G16b), and for a conversion the type
type ContractAsk struct(Body I64, File I64, At source.Span, CondFile I64, CondSp source.Span, Name String&, Text String&
    Ctx diag.Where, CtxText String&, Ty String& = "") {
    Body
    File
    At
    CondFile
    CondSp
    Name
    Text
    Ctx
    CtxText
    Ty
}

# a value the evaluator decides while compiling (T29d, D13c): what it is, where it is needed (its file and span), its
# type, and the body giving it (BodyOf.Cond)
type ValueAsk struct(Kind ValueKind, File I64, Sp source.Span, Ty types.TypeId, Body I64, Use diag.Where) {
    Kind
    File
    Sp
    Ty
    Body
    Use        # the program's use of the library's code it is in, where it is in the library (B11); else where it is
    Gone Bool = false                 # D13d: a zero value for a local every path assigns before reading - none asked
    Read diag.Where = diag.Where.Nowhere   # D13d: where that local is read on a path not assigning it, else Nowhere
}

# D13d: a local declared with no value, judged once its body is checked (settleUnset): its body and local, the group
# holding what making its zero value said (said only where it is read unassigned - none where it never is), whether the
# zero value had an error (a type with none), its zero value's ask (-1 for none), where it is declared and its type
type unsetCand struct(Body I64, Local I64, Group I64, NoZero Bool, ValueAt I64, Sp source.Span, Ty types.TypeId, Field Bool) {
    Body
    Local
    Group
    NoZero
    ValueAt
    Sp
    Ty
    Field
}

# S3: a call standing as a statement whose value is dropped, judged once every body is checked (settleIdle): its body,
# where it is and as it is written, the call checked
type idleCall struct(Body I64, File I64, Sp source.Span, Text String&, X typed.Expr&) {
    Body
    File
    Sp
    Text
    X
}

# D18e: a local a for-in or a comprehension walks, judged once its body is checked (settleHeldWalks): its body, the
# local and the walk's hidden iterator declared from a read of it
type heldCand struct(Body I64, G I64, It I64) {
    Body
    G
    It
}

type ValueKind enum {
    Literal      # a literal through its type's constructor (T29d)
    Zero         # a zero value its constructor makes (D13c)
    Fill         # the same, filling every element of an array: copied, so it must hold no reference
}

# a local if whose condition the build decides and B9a could not evaluate (S8b): the condition's body (BodyOf.Cond),
# where it is, and the if
# E38: an embed whose path is no literal, its path the body of a function giving it (ExprBody) - for the evaluator,
# by its file and where it starts
type EmbedAsk struct(Body I64, File I64, At I32) {
    Body
    File
    At
}

type Ask struct(Body I64, File I64, At I32, If ast.If&, In I64, Fixed Array<I64>&) {
    Body
    File
    At
    If
    In         # the body the if is in, and the locals of it the condition reads as fixed (S8c)
    Fixed
}

type roOrigin struct(P typed.Lvalue?&, View Bool) {
    P
    View
}

# a read-only copy passed to a by-value parameter (T25c): the callee's body and the parameter, where, its name, the
# copy's type and how one of its own is made
type roArg struct(Body I64, Param I64, At diag.Where, Callee String&, Ty String&, Fix String&) {
    Body
    Param
    At
    Callee
    Ty
    Fix
}

# an argument of a body (T25c) whose read-only-ness rests on the caller's own generic read-only reference parameters:
# the caller's body and the value, the callee's body and its parameter
type roDeepArg struct(Body I64, X typed.Expr&, Callee I64, Param I64) {
    Body
    X
    Callee
    Param
}

# a body made a function value (T25c): what it is called in a diagnostic, and its parameters from First on
type roFn struct(Body I64, First I64, At diag.Where, What String&) {
    Body
    First
    At
    What
}

# an element read through At where a place is wanted (E31, E31b): its body and site, the collection's place, and the
# type declaring At and SetAt
type atRec struct(Body I64, Site I64, Base typed.Lvalue&, Of types.TypeId) {
    Body
    Site
    Base
    Of
}

# ---- the program ----

# every body of the program checked: each function that is no generic one (a generic's are checked per instance, as its
# calls ask for them, G16), each global's initializer, each test block of the root module in a test build, and what
# they ask for in turn
fn (c mut Checker&) CheckProgram() {
    c.P.AllFns()
    if c.syntaxMark < 0 { c.syntaxMark = c.P.L.Diags.RecordCount() }
    for {
        c.Attempts++
        mark := c.P.L.Diags.Count()
        c.attempt()
        c.settleUnset()
        c.settleHeldWalks()
        c.settleIdle()
        c.settleUnread()
        # R1a's least fixed point: a set read before it was final that came out larger means checking again, every
        # inferred set starting at what this attempt found - the reads, and what rests on them, say otherwise this time
        grew := false
        for r in c.errReads {
            if c.P.T.Items(try c.inferredErrs.Get(r.First) catch default types.ListId(0)).Len() != r.Second { grew = true }
        }
        if not grew or c.Attempts >= 20 {
            c.settleFixed()
            c.orderGlobals()
            return
        }
        c.P.L.Diags.Forget(mark)
        c.errPresets = c.found
        c.reset()
    }
}

# B4: a program's root declares main - "fn main() { }" or "fn main() ? { }", no parameters, no result, never noreturn.
# A missing one is said only where no syntax error may have hidden it
fn (c mut Checker&) CheckMain() {
    root := c.P.L.Root
    file := c.P.L.Mods[root].File
    f := c.P.FnNamed(root, c.P.L.Names.Intern("main"))
    if f < 0 {
        if not c.P.L.Diags.ErrorBefore(c.syntaxMark) { c.P.L.Diags.Error(diag.Where.File(file), msgs.NoMain()) }
        return
    }
    fd := c.P.FnDecl(f)
    sig := c.P.Sig(f)
    if fd.Recv is not null or fd.S.Params.Len() > 0 or (fd.S.Results.Len() > 0) or fd.S.NoReturn or c.P.T.Result(sig) != types.VoidT {
        c.P.L.Diags.Error(diag.Where.File(file), msgs.MainSignature())
    }
}

# every collection a check of the program fills, empty again for another attempt (R1a)
fn (c mut Checker&) reset() {
    c.Bodies = Vec<mut typed.Body&>()
    c.Gaps = Vec<Gap>()
    c.anyBad = Map<I64, Bool>()
    c.slotsCalled = Map<I64, diag.Where>()
    c.lazyThunks = Vec<I64>()
    c.P.ResetAny()      # T32: tables name bodies of this attempt
    c.frames = Vec<mut frame&>()
    c.queue = Vec<I64>()
    c.queued = 0
    c.state = Vec<I64>()
    c.fnBodies = Map<I64, I64>()
    c.ctorBodies = Map<pair.Pair<I64, I64>, I64>()
    c.instsOf = Map<I64, I64>()
    c.ctorCalled = types.UnknownT
    c.globalBodies = Map<pair.Pair<I64, I64>, I64>()
    c.globalTypes = Map<pair.Pair<I64, I64>, types.TypeId>()
    c.globalDecls = Vec<pair.Pair<I64, I64>>()
    c.b5aSaid = Map<I64, Bool>()
    c.litLocals = Map<pair.Pair<I64, I64>, Bool>()
    c.rangeEnds = Map<pair.Pair<I64, I64>, source.Span>()
    c.rangeExprs = Map<pair.Pair<I64, I64>, Bool>()
    c.exprs = Vec<typed.Expr&>()
    c.stmts = Vec<typed.Stmt&>()
    c.atRecs = Vec<atRec>()
    c.laneNodes = Vec<laneNode>()
    c.lastErrs = types.ListId(0)
    c.inferring = Map<I64, Bool>()
    c.inferredErrs = Map<I64, types.ListId>()
    c.errReads = Vec<pair.Pair<I64, I64>>()
    c.unsettled = Map<I64, Bool>()
    c.found = Map<pair.Pair<I64, I64>, types.ListId>()
    c.boundsMet = Map<types.TypeId, Bool>()
    c.roCopies = Map<pair.Pair<I64, I64>, source.NameId>()
    c.roBorrows = Map<pair.Pair<I64, I64>, Bool>()
    c.roFrom = Map<pair.Pair<I64, I64>, roOrigin>()
    c.roNeeds = Map<pair.Pair<I64, I64>, Bool>()
    c.roDeps = Vec<pair.Pair<pair.Pair<I64, I64>, pair.Pair<I64, I64>>>()
    c.roArgs = Vec<roArg>()
    c.roFns = Vec<roFn>()
    c.roVals = Map<pair.Pair<I64, I64>, Vec<typed.Expr&>>()
    c.roToResult = Map<pair.Pair<I64, I64>, Bool>()
    c.roResults = Vec<pair.Pair<I64, typed.Expr&>>()
    c.roDeepNeeds = Vec<pair.Pair<I64, typed.Expr&>>()
    c.roDeepArgs = Vec<roDeepArg>()
    c.roRefArgs = Vec<roArg>()
    c.unknownTypes = Map<pair.Pair<I64, I64>, Bool>()
    c.unknownSaid = Map<pair.Pair<I64, I64>, Bool>()
    c.Asks = Vec<Ask>()
    c.EmbedAsks = Vec<EmbedAsk>()
    c.AssertAsks = Vec<AssertAsk>()
    c.TopAsserts = Vec<TopAssertAsk>()
    c.tails = Vec<tailAsk>()
    c.ValueAsks = Vec<ValueAsk>()
    c.unsets = Vec<unsetCand>()
    c.heldWalks = Vec<heldCand>()
    c.idle = Vec<idleCall>()
    c.Contracts = Map<I64, typed.ContractInfo>()
    c.ctDone = Map<I64, Bool>()
    c.ContractAsks = Vec<ContractAsk>()
    c.contractCallers = Vec<I64>()
    c.ContractHandled = Map<I64, Bool>()
    c.Faulty = Map<I64, Bool>()
    c.fixedInits = Map<pair.Pair<I64, I64>, fixedInit>()
    c.writes = Map<pair.Pair<I64, I64>, Bool>()
    c.lastFixed = Vec<I64>()
}

# D18e, once an attempt has checked every body: a local declared from a generator's call (one whose elements are built
# per turn) that one for-in or comprehension walks, made once where the local is declared and naming it nowhere else,
# is that walk's own - made and finished in the local's block, dropped as it closes, as a for-in's own call is
fn (c mut Checker&) settleHeldWalks() {
    for h in c.heldWalks {
        if h.Body < 0 or h.Body >= c.Bodies.Len() or c.Bodies[h.Body].Root is null { continue }
        b := c.Bodies[h.Body]
        callee := definit.HeldWalk(b, typed.LocalId(I32(h.G)), typed.LocalId(I32(h.It)))
        if callee < 0 or callee >= c.Bodies.Len() { continue }
        match c.Bodies[callee].Of {
            case typed.BodyOf.Fn(i) {
                f := c.P.InstanceFn(i)
                if c.P.IsGenerator(f) and c.P.GenElem(f) == generic.GenPerTurn { b.Walks.Push(typed.LocalId(I32(h.G))) }
            }
            case _ { }
        }
    }
}

# D13d, once an attempt has checked every body: each local declared with no value. Assigned on every path before any
# read, it needs no zero value - none is made, none said, none asked - and lowering writes nothing for it (Local.Unset;
# a value array and an owner keep theirs, whose stores read what they replace); else its zero value stands, and a type
# with none is an error at the first read on a path that has not assigned it, naming that path
fn (c mut Checker&) settleUnset() {
    if c.unsets.Len() == 0 { return }
    d := c.P.L.Diags
    for u in c.unsets {
        if u.Body < 0 or u.Body >= c.Bodies.Len() or c.Bodies[u.Body].Root is null {
            d.Choose(u.Group)
            continue
        }
        b := c.Bodies[u.Body]
        found, readAt, why, whyAt := definit.Judge(b, typed.LocalId(I32(u.Local)), u.Field)
        if not found {
            d.Drop(u.Group)
            if u.ValueAt >= 0 { c.ValueAsks[u.ValueAt].Gone = true }
            if c.unsetLowers(u.Ty) { b.Locals[u.Local].Unset = true }
            continue
        }
        if not u.NoZero {
            d.Choose(u.Group)
            if u.ValueAt >= 0 { c.ValueAsks[u.ValueAt].Read = diag.Where.Span(b.File, I64(readAt.Start), I64(readAt.End)) }
            continue
        }
        d.Drop(u.Group)
        name := c.text(b.Locals[u.Local].Name)
        fix := ""
        if c.isRef(u.Ty) and not c.P.T.IsNullable(u.Ty) and not c.P.T.ArrayRef(u.Ty) { fix = ", or write '" $c.ty(c.P.T.OrNull(u.Ty)) "'" }
        rec I64 = -1
        if u.Field {
            rec = d.Error(diag.Where.Span(b.File, I64(u.Sp.Start), I64(u.Sp.End)), msgs.FieldUnassigned(name, c.ty(u.Ty), fix))
        } else {
            rec = d.Error(diag.Where.Span(b.File, I64(readAt.Start), I64(readAt.End)), msgs.ReadUnassigned(name, c.ty(u.Ty), fix))
        }
        if why == definit.Cause.Decl and u.Field { continue }
        note := match why {
            case definit.Cause.Decl => msgs.NoteUnassignedDecl()
            case definit.Cause.NoElse => msgs.NoteUnassignedNoElse()
            case definit.Cause.Branch => msgs.NoteUnassignedBranch()
            case definit.Cause.Loop => msgs.NoteUnassignedLoop()
            case definit.Cause.Arm => msgs.NoteUnassignedArm()
            case definit.Cause.Clause => msgs.NoteUnassignedClause()
        }
        d.Note(rec, diag.Where.Span(b.File, I64(whyAt.Start), I64(whyAt.End)), note)
    }
}

# D13d: whether lowering may leave a local definitely assigned unwritten until then - not a run-time array value nor an
# owner, whose first store reads what it replaces (T11b's storage reuse, O8d's release)
fn (c mut Checker&) unsetLowers(t types.TypeId) Bool {
    r := c.P.T.Repr(t)
    if c.P.T.KindOf(r) == types.Kind.Array and c.P.T.Length(r) == types.TypeId(0) { return false }
    return not c.owning(t)
}

# S8c: whether a local an asked condition or assert read as fixed is written by its body after all - the condition is
# then the running program's
fn (c Checker&) rewritten(body I64, fixed Array<I64>&) Bool {
    for id in fixed {
        if c.writes.Has(pair.Pair(body, id)) { return true }
    }
    return false
}

# S8c, once every body is checked: an asked if or assert reading a local as fixed that its body writes after all is the
# running program's - the if's branches, checked as running, reported - and not asked
fn (c mut Checker&) settleFixed() {
    k I64 = 0
    for i in range c.Asks.Len() {
        a := c.Asks[i]
        if c.rewritten(a.In, a.Fixed) {
            c.Running(a.If)
        } else {
            c.Asks[k] = a
            k++
        }
    }
    c.Asks.Truncate(k)
    k = 0
    for i in range c.AssertAsks.Len() {
        a := c.AssertAsks[i]
        if not c.rewritten(a.Body, a.Fixed) {
            c.AssertAsks[k] = a
            k++
        }
    }
    c.AssertAsks.Truncate(k)
}

# an asked if the build turned out not to decide (its condition reads a written local, or does not evaluate): checked
# as a running one, both branches - what they hold reported
fn (c mut Checker&) Running(i ast.If&) {
    d := c.P.L.Diags
    if i.Then!.Group >= 0 and d.IsPending(i.Then!.Group) { d.Choose(i.Then!.Group) }
    if i.Else is null { return }
    match i.Else {
        case ast.Stmt.If(_, e) {
            if e.Cond is null and e.Then!.Group >= 0 and d.IsPending(e.Then!.Group) { d.Choose(e.Then!.Group) }
        }
        nomatch { }
    }
}

# a local written (S8c: it is not fixed)
fn (c mut Checker&) noteWrite(p typed.Lvalue&) {
    match p {
        case typed.Lvalue.Local(_, _, id) { c.writes.Put(pair.Pair(c.fr().Body, I64(id)), true) }
        nomatch { }
    }
}

# G29: x.Len() of an array a parameter holds by value - its instance's length, a constant; -1 where the call is no such
# Len(), or the length is not bound (the generic's own declaration)
fn (c mut Checker&) paramLen(f ast.Expr&, args Array<ast.Expr&>&) I64 {
    k := c.P.LenKey(f, args)
    if k == "" or c.frames.Len() == 0 { return -1 }
    v := try c.fr().Ctx.Vars.Get(c.P.L.Names.Intern(k)) catch default types.TypeId(-1)
    if v < types.TypeId(0) or c.P.T.KindOf(v) != types.Kind.Const { return -1 }
    return c.P.T.ConstValue(v)
}

# whether a type is a plain scalar (S8c): a number, Bool, or an enum without payloads
fn (c mut Checker&) plainScalar(t types.TypeId) Bool {
    if c.isNumber(t) or c.under(t) == types.BoolT { return true }
    return c.isEnum(t) and not c.P.T.HasPayload(c.P.T.Cases(t))
}

# whether an expression reads no local but fixed ones (S8c), each found put in out with its own initializer's, by name
fn (c mut Checker&) onlyFixed(x ast.Expr?&, out mut Map<source.NameId, I64>&) Bool {
    if x is null { return true }
    match x {
        case ast.Expr.Name(sp, n) {
            # a name the checker binds (a match binding, which the resolver leaves to it) is a local too, never fixed
            if not c.namesLocal(sp) { return c.localNamed(n) < 0 }
            if c.P.R.Use(c.fr().File, sp.Start).Kind == names.What.TypeVar { return c.constsRead and c.fr().Ctx.Vars.Has(n) }
            if c.P.R.Use(c.fr().File, sp.Start).Kind != names.What.Local { return false }
            if out.Has(n) { return true }
            id := c.localNamed(n)
            # written already (a write after it is settled once the body is checked)
            if id < 0 or c.writes.Has(pair.Pair(c.fr().Body, id)) { return false }
            fi := try c.fixedInits.Get(pair.Pair(c.fr().Body, id)) catch { return false }
            out.Put(n, id)
            c.lastFixed.Push(id)
            return c.onlyFixed(fi.Init, out)
        }
        nomatch { }
    }
    return match x {
        case ast.Expr.Lit(_, _), ast.Expr.Default(_) => true
        case ast.Expr.Paren(_, a), ast.Expr.Named(_, _, a), ast.Expr.Unary(_, _, a), ast.Expr.Postfix(_, _, a), ast.Expr.Member(_, a, _) => c.onlyFixed(a, out)
        case ast.Expr.IsType(_, a, _, _), ast.Expr.As(_, a, _), ast.Expr.Generic(_, a, _) => c.onlyFixed(a, out)
        case ast.Expr.Binary(_, _, a, b), ast.Expr.NotIn(_, a, b), ast.Expr.Is(_, a, b, _) => c.onlyFixed(a, out) and c.onlyFixed(b, out)
        case ast.Expr.Cond(_, a, k, b) => c.onlyFixed(a, out) and c.onlyFixed(k, out) and c.onlyFixed(b, out)
        case ast.Expr.Chain(_, ch) => c.allFixed(ch.Xs, out)
        case ast.Expr.Call(_, f, args) => c.paramLen(f, args) >= 0 or (c.onlyFixed(f, out) and c.allFixed(args, out))
        case ast.Expr.ScopeCall(_, f, _, args) => c.onlyFixed(f, out) and c.allFixed(args, out)
        case ast.Expr.Index(_, a, items) => c.onlyFixed(a, out) and c.allFixed(items, out)
        case ast.Expr.Slice(_, a, lo, hi) => c.onlyFixed(a, out) and c.onlyFixed(lo, out) and c.onlyFixed(hi, out)
        case ast.Expr.ArrayLit(_, _, items), ast.Expr.Row(_, items), ast.Expr.Join(_, items), ast.Expr.Range(_, items) => c.allFixed(items, out)
        case ast.Expr.Try(_, a, clauses) => c.onlyFixed(a, out) and (clauses.Len() == 0)
        nomatch => false
    }
}

fn (c mut Checker&) allFixed(xs Array<ast.Expr&>&, out mut Map<source.NameId, I64>&) Bool {
    if xs.Len() == 0 { return true }
    for x in xs {
        if not c.onlyFixed(x, out) { return false }
    }
    return true
}

fn (c mut Checker&) attempt() {
    for f in range c.P.FnCount() {
        if c.P.FnIsExtern(f) and not (c.RootOnly and c.P.FnModule(f) != c.P.L.Root) { c.externRules(f) }
        if not c.P.FnIsExtern(f) and c.P.FnDecl(f).Export and not (c.RootOnly and c.P.FnModule(f) != c.P.L.Root) { c.exportRules(f) }
        if c.P.FnIsExtern(f) or not c.P.FnDecl(f).Bodied { continue }
        if c.RootOnly and c.P.FnModule(f) != c.P.L.Root { continue }
        c.P.Sig(f)
        if c.P.FnDecl(f).Recv is null and c.P.FnDecl(f).S.Commutes {
            c.push(-1, c.P.FnModule(f), types.VoidT, types.ListId(0))
            c.err(c.nameSpan(c.P.FnDecl(f)), msgs.CommutesNotHere(c.tok(c.P.FnDecl(f).Name)))
            c.pop()
        }
        if c.P.FnDecl(f).Recv is not null {
            c.operatorMethod(f)
            c.inheritClash(f)
            c.overrideClash(f)
            c.methodOverlap(f)
        }
        c.fnTypeParams(f)
        if c.P.VarCount(generic.FnOwner(f)) > 0 { continue }
        c.fnBody(c.P.FnInstance(f, types.ListId(0)))
    }
    for mi in range c.P.L.Mods.Len() {
        if c.RootOnly and mi != c.P.L.Root { continue }
        ds := c.P.L.Mods[mi].Decls
        if ds.Len() > 0 { c.decls(mi, ds) }
        if ds.Len() > 0 { c.topSets(mi) }
    }
    c.drain()
    c.failForms()
    c.tailSets()
    c.roSettle()
}

# X2: what crosses the C boundary - a number or a Bool, an extern type's reference (X10), a plain-data struct by value or
# by reference (X11), and for a parameter an array of any of these; a runtime function's parameter (X6, "__olang_") may
# be fn() too
fn (c mut Checker&) externRules(f I64) {
    fd := c.P.FnDecl(f)
    mi := c.P.FnModule(f)
    sig := c.P.Sig(f)
    ps := c.P.T.Items(c.P.T.Params(sig))
    runtime := c.text(fd.Name).StartsWith("__olang_")
    file := c.P.L.Mods[mi].File
    for i in range fd.S.Params.Len() {
        if i >= ps.Len() { break }
        t := ps[i]
        if t == types.UnknownT or c.externParam(t) { continue }
        if not runtime and c.callbackType(t) { continue }   # X13: an export fn, by its C name
        if runtime and c.P.T.KindOf(t) == types.Kind.Func and c.P.T.Items(c.P.T.Params(t)).Len() == 0 and c.P.T.Result(t) == types.VoidT and c.P.T.Items(c.P.T.Errors(t)).Len() == 0 { continue }
        sp := fd.S.Params[i].Sp
        c.P.L.Diags.Error(diag.Where.Span(file, I64(sp.Start), I64(sp.Start) + c.text(fd.S.Params[i].Name).Len()), msgs.ExternType(c.ty(t)))
    }
    r := c.P.T.Result(sig)
    if r == types.UnknownT or r == types.VoidT or r == types.NoreturnT or fd.S.Results.Len() == 0 { return }
    if fd.S.Results.Len() > 1 or not c.externValue(r) {
        c.P.L.Diags.Error(diag.Where.Span(file, I64(fd.S.Results[0].Span().Start), I64(fd.S.Results[fd.S.Results.Len() - 1].Span().End)), msgs.ExternResult(c.ty(r)))
    }
}

# X13: a function type a C function is given an export fn of: its parameters and its result an export fn's (X12),
# none an array, and no errors
fn (c mut Checker&) callbackType(t types.TypeId) Bool {
    if c.P.T.KindOf(t) != types.Kind.Func or c.P.T.Items(c.P.T.Errors(t)).Len() > 0 { return false }
    for p in c.P.T.Items(c.P.T.Params(t)) {
        if not (c.externValue(p) or (c.isRef(p) and c.plainStruct(c.P.T.Referent(p), 0))) { return false }
    }
    r := c.P.T.Result(t)
    return r == types.VoidT or c.externValue(r)
}

# X12: an export fn - a function C calls by its name: no receiver, not generic, a name that is not the program's own,
# parameters and a result C has counterparts for (an array by reference, a result array copied out)
fn (c mut Checker&) exportRules(f I64) {
    fd := c.P.FnDecl(f)
    mi := c.P.FnModule(f)
    file := c.P.L.Mods[mi].File
    name := c.text(fd.Name)
    at := diag.Where.Span(file, I64(fd.Sp.Start), I64(fd.Sp.Start) + 6)
    if fd.Recv is not null {
        c.P.L.Diags.Error(at, msgs.ExportMethod())
        return
    }
    if fd.TypeParams.Len() > 0 or c.P.VarCount(generic.FnOwner(f)) > 0 {
        c.P.L.Diags.Error(at, msgs.ExportGeneric())
        return
    }
    if name == "main" or name.StartsWith("__olang_") {
        c.P.L.Diags.Error(at, msgs.ExportName(msgs.Tok(name)))
        return
    }
    sig := c.P.Sig(f)
    ps := c.P.T.Items(c.P.T.Params(sig))
    for i in range fd.S.Params.Len() {
        if i >= ps.Len() { break }
        t := ps[i]
        if t == types.UnknownT or c.exportParam(t) { continue }
        sp := fd.S.Params[i].Sp
        c.P.L.Diags.Error(diag.Where.Span(file, I64(sp.Start), I64(sp.Start) + c.text(fd.S.Params[i].Name).Len()), msgs.ExportType(c.ty(t)))
    }
    r := c.P.T.Result(sig)
    if r == types.UnknownT or r == types.VoidT or fd.S.Results.Len() == 0 { return }
    if fd.S.Results.Len() > 1 or not (c.externValue(r) or c.exportArray(r)) {
        c.P.L.Diags.Error(diag.Where.Span(file, I64(fd.S.Results[0].Span().Start), I64(fd.S.Results[fd.S.Results.Len() - 1].Span().End)), msgs.ExportResult(c.ty(r)))
    }
}

# X12: an export fn's parameter type: an extern's value (X2), a plain struct by reference, or an array by reference of
# an extern's values - C's pointer and length
fn (c mut Checker&) exportParam(t types.TypeId) Bool {
    if c.externValue(t) { return true }
    if not c.isRef(t) { return false }
    x := c.P.T.Referent(t)
    if c.plainStruct(x, 0) { return true }
    u := c.under(x)
    return c.P.T.KindOf(u) == types.Kind.Array and c.externValue(c.P.T.Elem(u))
}

# X12: an array an export fn may give: by value, its elements an extern's values - copied into the caller's buffer
fn (c mut Checker&) exportArray(t types.TypeId) Bool {
    if c.isRef(t) { return false }
    u := c.under(t)
    return c.P.T.KindOf(u) == types.Kind.Array and c.externValue(c.P.T.Elem(u))
}

# X13: what a C function is given for a parameter of a function type: an export fn, named - its C entry, which C may
# call on any thread (X12) - and nothing else, no lambda and no function value held, which C could not call
fn (c mut Checker&) callbackArg(x typed.Expr&, sp source.Span) {
    match x {
        case typed.Expr.Fn(_, _, fv) {
            match fv {
                case typed.FnVal.Named(body) {
                    match c.Bodies[I64(body)].Of {
                        case typed.BodyOf.Fn(inst) {
                            if c.P.FnDecl(c.P.InstanceFn(inst)).Export { return }
                        }
                        case _ { }
                    }
                }
                case _ { }
            }
        }
        case _ { }
    }
    if typeOf(x) == types.UnknownT { return }
    c.err(sp, msgs.CallbackNotExport())
}

# whether a call reaches a C function (X13's callbacks): an extern, not one of the runtime's own (X6)
fn (c mut Checker&) cCallback(target typed.Callee&, f I64) Bool {
    match target {
        case typed.Callee.Extern(_) { return f >= 0 and not c.text(c.P.FnDecl(f).Name).StartsWith("__olang_") }
        case _ { return false }
    }
}

# X2: an extern's parameter type: a value that crosses (externValue), a plain struct by reference (X11), or an array -
# by reference or not - of numbers, Bools, extern references or plain structs (X3)
fn (c mut Checker&) externParam(t types.TypeId) Bool {
    if c.externValue(t) { return true }
    x := t
    if c.isRef(x) {
        x = c.P.T.Referent(x)
        if c.plainStruct(x, 0) { return true }
    }
    if c.P.T.KindOf(x) != types.Kind.Array { return false }
    e := c.P.T.Elem(x)
    return c.externValue(e)
}

# X2: what crosses the C boundary as a value, a parameter or a result: a number, a Bool, a reference to an extern type
# (X10), a plain-data struct by value (X11)
fn (c mut Checker&) externValue(t types.TypeId) Bool {
    u := c.under(t)
    if c.cNumber(u) or u == types.BoolT { return true }
    if c.foreignRef(t) { return true }
    return c.plainStruct(t, 0)
}

# X10: whether a type is a reference to an extern type - "Db&", "Db?&"
fn (c mut Checker&) foreignRef(t types.TypeId) Bool {
    if not c.isRef(t) { return false }
    x := c.P.T.Referent(t)
    return c.isNamed(x) and c.declKind(x) == types.DeclKind.Foreign
}

# X11: whether a type is a plain-data struct: a struct with no destructor whose every field is a number, a Bool, an extern
# type's reference, an array of a length known while compiling of plain data, or a plain-data struct held by value
fn (c mut Checker&) plainStruct(t types.TypeId, depth I64) Bool {
    if depth > 16 or not c.isNamed(t) or c.declKind(t) != types.DeclKind.Struct or not c.P.Body(t) { return false }
    if c.P.T.Destructs(t) { return false }
    for fl in c.P.T.Items(c.P.T.Fields(t)) {
        if not c.plainField(fl, depth + 1) { return false }
    }
    return true
}

# X2: a number C has a type of its own for - one of the twelve primitives, not an integer of another width (T4a)
fn (c mut Checker&) cNumber(u types.TypeId) Bool { return c.P.T.IsNumber(u) and u <= types.TypeId(14) }

fn (c mut Checker&) plainField(t types.TypeId, depth I64) Bool {
    u := c.under(t)
    if c.cNumber(u) or u == types.BoolT or c.foreignRef(t) { return true }
    if c.P.T.KindOf(u) == types.Kind.Array {
        return c.P.T.KindOf(c.P.T.Length(u)) == types.Kind.Const and c.plainField(c.P.T.Elem(u), depth + 1)
    }
    return c.plainStruct(t, depth)
}

# the operator methods by name (E31, E31a, E10a, E11c): their operands besides the receiver, whether they give a result,
# and whether they may fail (all but Len, Eq and Str, QQ1)
type opShape struct(Name String&, Operands I64, Result Bool, MayFail Bool) {
    Name
    Operands
    Result
    MayFail
}

OpShapes Array<opShape> = opShape[opShape("Plus", 1, true, true), opShape("Minus", 1, true, true)
    opShape("Mul", 1, true, true), opShape("Div", 1, true, true), opShape("Rem", 1, true, true)
    opShape("MatMul", 1, true, true), opShape("Neg", 0, true, true), opShape("Less", 1, true, true)
    opShape("At", 1, true, true), opShape("SetAt", 2, false, true), opShape("Slice", 2, true, true)
    opShape("BitAnd", 1, true, true), opShape("BitOr", 1, true, true), opShape("BitXor", 1, true, true)
    opShape("ShiftLeft", 1, true, true), opShape("ShiftRight", 1, true, true), opShape("BitNot", 0, true, true)
    opShape("Inc", 0, true, true), opShape("Dec", 0, true, true), opShape("Len", 0, true, false)
    opShape("Eq", 1, true, false), opShape("Str", 0, true, false)]

# a function's type variables (G1, G4, G19): none named after a type, each constrained only by a trait; each written in
# a parameter's type, or in the constraint of one that is, so a call can infer it
fn (c mut Checker&) fnTypeParams(f I64) {
    fd := c.P.FnDecl(f)
    mi := c.P.FnModule(f)
    c.push(-1, mi, types.VoidT, types.ListId(0))
    if fd.TypeParams.Len() > 0 {
        for tp in fd.TypeParams {
            if c.namesType(mi, tp.Name) { c.err(source.Span(tp.Sp.Start, tp.Sp.Start + I32(c.text(tp.Name).Len())), msgs.TypeVarNamesType(c.tok(tp.Name))) }
            # G19: a constraint naming no type at all
            match tp.Ty {
                case ast.TypeRef.Named(usp, upath, _) {
                    if upath.Len() == 1 and c.P.R.Use(c.P.L.Mods[mi].File, usp.Start).Kind == names.What.None {
                        c.unknownType(usp, upath[0])
                        continue
                    }
                }
                nomatch { }
            }
            # G19: a variable written after a type that is no trait - a length is never a parameter (T7)
            if tp.Ty is not null and not c.traitRef(mi, tp.Ty!) { c.err(tp.Ty!.Span(), msgs.ConstraintNotTrait(c.src(tp.Ty!.Span()))) }
            for a in tp.Also {
                if not c.traitRef(mi, a) { c.err(a.Span(), msgs.ConstraintNotTrait(c.src(a.Span()))) }
            }
        }
    }
    # G4: a variable no parameter names is given by type arguments written at each call (G12) - said there
    c.pop()
}

# whether a written type names a trait
fn (c mut Checker&) traitRef(mi I64, t ast.TypeRef&) Bool {
    match t {
        case ast.TypeRef.Named(nsp, _, _) {
            ref := c.P.R.Use(c.P.L.Mods[mi].File, nsp.Start)
            if ref.Kind != names.What.Type or ref.Index < 0 { return ref.Kind != names.What.Builtin }
            return c.P.T.DeclKindOf(c.P.DeclFor(ref.Module, ref.Index)) == types.DeclKind.Trait
        }
        nomatch { return false }
    }
}

# the type variables of owner a type holds - a length an instance binds (G29) as an array's length
fn (c mut Checker&) varsIn(t types.TypeId, owner I64, seen mut Array<Bool>&, depth I64) {
    if depth > 32 or t == types.UnknownT { return }
    match c.P.T.KindOf(t) {
        case types.Kind.Var {
            if c.P.T.A(t) == owner and c.P.T.B(t) < seen.Len() { seen[c.P.T.B(t)] = true }
        }
        case types.Kind.Named { for x in c.P.T.Items(c.P.T.Args(t)) { c.varsIn(x, owner, seen, depth + 1) } }
        case types.Kind.Array {
            c.varsIn(c.P.T.Elem(t), owner, seen, depth + 1)
            if c.P.T.Length(t) != types.TypeId(0) { c.varsIn(c.P.T.Length(t), owner, seen, depth + 1) }
        }
        case types.Kind.Ref { c.varsIn(c.P.T.Referent(t), owner, seen, depth + 1) }
        case types.Kind.Func {
            for x in c.P.T.Items(c.P.T.Params(t)) { c.varsIn(x, owner, seen, depth + 1) }
            c.varsIn(c.P.T.Result(t), owner, seen, depth + 1)
        }
        case types.Kind.Tuple, types.Kind.Record { for x in c.P.T.Items(c.P.T.Parts(t)) { c.varsIn(x, owner, seen, depth + 1) } }
        case types.Kind.Any { c.varsIn(c.P.T.AnyTrait(t), owner, seen, depth + 1) }   # T32: "any Iterator<T>&" infers T
        nomatch { }
    }
}

# where a variable is first written in a signature, past its introduction: the parameters', then the results' types
fn (c mut Checker&) writtenAt(fd ast.Func&, n source.NameId) source.Span {
    for prm in fd.S.Params {
        if prm.Ty is not null {
            sp := c.wordIn(prm.Ty!.Span(), c.text(n))
            if sp.Start >= 0 { return sp }
        }
    }
    if fd.S.Results.Len() > 0 {
        for r in fd.S.Results {
            sp := c.wordIn(r.Span(), c.text(n))
            if sp.Start >= 0 { return sp }
        }
    }
    return c.nameSpan(fd)
}

# the first whole-word w within a span of the current module's source, Start -1 for none
fn (c mut Checker&) wordIn(sp source.Span, w String&) source.Span {
    t := c.P.L.Mods[c.fr().Mi].Src!.Text
    i := I64(sp.Start)
    for i + w.Len() <= I64(sp.End) {
        if t[i:i + w.Len()] == w {
            before := i == 0 or not (t[i - 1].IsLetter() or t[i - 1].IsDigit() or t[i - 1] == '_')
            j := i + w.Len()
            after := j >= t.Len() or not (t[j].IsLetter() or t[j].IsDigit() or t[j] == '_')
            if before and after { return source.Span(I32(i), I32(j)) }
        }
        i++
    }
    return source.Span(-1, -1)
}

# whether a name is a type's a module can name by itself: one it declares, the prelude's, a primitive, Bool, Array (G1)
fn (c mut Checker&) namesType(mi I64, n source.NameId) Bool {
    t := c.text(n)
    if c.P.T.Prim(t) != types.UnknownT or t == "Bool" or t == "Array" { return true }
    if c.P.TypeEntry(mi, n) >= 0 { return true }
    if not load.Public(t) { return false }
    for pm in range c.P.L.Mods.Len() {
        if c.P.L.Mods[pm].Prelude and c.P.TypeEntry(pm, n) >= 0 { return true }
    }
    return false
}

# T29e: a method of a type extending its base may not take a name an inherited one has - save the protocol methods the
# compiler consults (Eq, Hash, Str), which replace the base's
fn (c mut Checker&) inheritClash(f I64) {
    fd := c.P.FnDecl(f)
    name := c.text(fd.Name)
    ps := c.P.T.Items(c.P.T.Params(c.P.Sig(f)))
    if ps.Len() == 0 { return }
    rt := c.deref(ps[0])
    c.push(-1, c.P.FnModule(f), types.VoidT, types.ListId(0))
    # M19d: a built-in type's methods are the prelude's alone
    if not c.isNamed(rt) and rt != types.UnknownT and c.P.T.KindOf(rt) != types.Kind.Var and not c.P.L.Mods[c.P.FnModule(f)].Prelude {
        c.err(c.nameSpan(fd), msgs.MethodOnBuiltinType(c.ty(rt)))
        c.pop()
        return
    }
    c.bothSpellings(f, rt, name, ps.Len() - 1)
    for x in String&["Eq", "eq", "Hash", "hash", "Str", "str"] {
        if x == name {
            c.pop()
            return
        }
    }
    if not c.isNamed(rt) {
        c.pop()
        return
    }
    if c.P.Extends(rt) {
        b := c.P.T.Base(rt)
        if c.P.MethodOf(b, fd.Name) >= 0 or c.P.DefaultMethod(b, fd.Name) >= 0 {
            c.err(c.nameSpan(fd), msgs.MethodClashesInherited(c.ty(ps[0]), name))
            c.pop()
            return
        }
    }
    # E23, E33, E37, P9: nor a method the compiler supplies - every array's Len, a type extending a float's or an unsigned
    # integer's bit methods, a type extending an integer's atomics
    u := c.under(rt)
    given := false
    if c.P.T.KindOf(u) == types.Kind.Array and (name == "Len" or name == "len" or name == "Get" or name == "Set" or name == "SliceOf") { given = true }
    if name == "Narrow" and c.isNumber(rt) { given = true }
    if c.P.Extends(rt) {
        if name == "Bits" and c.P.T.IsFloat(u) { given = true }
        if name.EndsWith("FromBits") and c.P.T.IsUnsigned(u) { given = true }
        if (name.StartsWith("Atomic") or bitOp(name) != typed.PrimOp.Retire) and c.P.T.IsInt(u) { given = true }
    }
    if name == "Value" and c.isEnum(rt) and c.rawsOf(rt).Ty != types.UnknownT { given = true }   # T17e
    if name == "Destroy" and c.destructs(rt) {    # C9b
        c.err(c.nameSpan(fd), msgs.DestroyDeclared(c.ty(ps[0])))
        c.pop()
        return
    }
    if given { c.err(c.nameSpan(fd), msgs.MethodClashesSupplied(name, c.ty(ps[0]))) }
    c.pop()
}

# M6b: a method the compiler calls by itself is public or private, never both - said at the public one
fn (c mut Checker&) bothSpellings(f I64, rt types.TypeId, name String&, n I64) {
    if name.Len() == 0 or not name[0].IsUpper() { return }
    k := protocolArity(c.operatorRole(name))
    if k == -2 { return }
    low := lowerFirst(name)
    m := c.P.MethodOf(rt, c.P.L.Names.Intern(low))
    if m < 0 or (k >= 0 and c.P.T.Items(c.P.T.Params(c.P.Sig(m))).Len() - 1 != n) { return }
    c.err(c.nameSpan(c.P.FnDecl(f)), msgs.ProtocolBothSpellings(c.ty(c.P.T.Plain(rt)), name, name, low))
}

# M21: a method of one name per instance - two that some one instance meets alike are an error at the later, with a
# note at the other
fn (c mut Checker&) methodOverlap(f I64) {
    g := c.P.MethodOverlap(f)
    if g < 0 { return }
    fd := c.P.FnDecl(f)
    ps := c.P.T.Items(c.P.T.Params(c.P.Sig(f)))
    if ps.Len() == 0 { return }
    c.push(-1, c.P.FnModule(f), types.VoidT, types.ListId(0))
    rec := c.err(c.nameSpan(fd), msgs.MethodOverlap(c.text(fd.Name), c.ty(c.P.T.Plain(c.deref(ps[0])))))
    c.pop()
    gd := c.P.FnDecl(g)
    c.push(-1, c.P.FnModule(g), types.VoidT, types.ListId(0))
    c.P.L.Diags.Note(rec, c.at(c.nameSpan(gd)), msgs.NoteDeclaredHere("'" $c.text(gd.Name) "'"))
    c.pop()
}

# how many operands a method the compiler calls takes besides its receiver: -1 for any, -2 for no such method
# M19e: a method of a declared type named like a default its traits declare overrides it, so it has the default's
# signature - its parameters besides the receiver and its result
fn (c mut Checker&) overrideClash(f I64) {
    sig := c.P.Sig(f)
    ps := c.P.T.Items(c.P.T.Params(sig))
    if ps.Len() == 0 { return }
    rt := c.deref(ps[0])
    if not c.isNamed(rt) or not c.P.T.Closed(rt) { return }
    fd := c.P.FnDecl(f)
    d := c.P.DefaultMethod(rt, fd.Name)
    if d < 0 or d == f { return }
    ds := c.P.Sig(d)
    qs := c.P.T.Items(c.P.T.Params(ds))
    same := qs.Len() == ps.Len()
    for i in range 1, ps.Len() {
        if not same { break }
        if c.P.T.Closed(qs[i]) and not c.P.T.Same(qs[i], ps[i]) { same = false }
    }
    r := c.P.T.Result(ds)
    if same and c.P.T.Closed(r) and not c.P.T.Same(r, c.P.T.Result(sig)) { same = false }
    if same { return }
    c.push(-1, c.P.FnModule(f), types.VoidT, types.ListId(0))
    c.err(c.nameSpan(fd), msgs.OverrideSignature(c.text(fd.Name)))
    c.pop()
}

fn protocolArity(cap String&) I64 {
    k := opShapeOf(cap)
    if k >= 0 { return OpShapes[k].Operands }
    if cap == "Hash" or cap == "Next" or cap == "Iter" { return 0 }
    if cap == "Has" or cap == "Contains" or cap == "RunFrom" { return 1 }
    if cap == "Call" { return -1 }
    return -2
}

# a method named for an operator, of the operator's arity, claims it, so it has the rest of its shape (E31, E31a,
# E10a, E11c); its private spelling is held to the same (M6b)
# an operator method's shape error at its name - a private spelling's with a note saying why it is held to the shape,
# since its name does not (M6b)
fn (c mut Checker&) shapeErr(at source.Span, fd ast.Func&, cap String&, m msgs.Msg) {
    rec := c.err(at, m)
    name := c.text(fd.Name)
    if name != cap { c.P.L.Diags.Note(rec, c.at(at), msgs.NoteProtocolSpelling(name, cap, cap)) }
}

fn (c mut Checker&) operatorMethod(f I64) {
    fd := c.P.FnDecl(f)
    name := c.text(fd.Name)
    if name.Len() == 0 { return }
    cap := c.operatorRole(name)
    if fd.S.Commutes { c.commutesRule(f, fd, cap) }
    k := opShapeOf(cap)
    if k < 0 { return }
    sh := OpShapes[k]
    sig := c.P.Sig(f)
    ps := c.P.T.Items(c.P.T.Params(sig))
    got := ps.Len() - 1
    atLeast := cap == "At" or cap == "SetAt"
    if not (got >= sh.Operands if atLeast else got == sh.Operands) { return }
    mi := c.P.FnModule(f)
    c.push(-1, mi, types.VoidT, types.ListId(0))
    at := c.nameSpan(fd)
    res := c.P.T.Result(sig)
    if res == types.NoreturnT {
        c.shapeErr(at, fd, cap, msgs.NoreturnHere("an operator's method"))
    } else if sh.Result and (res == types.VoidT or c.P.T.KindOf(res) == types.Kind.Tuple) {
        c.shapeErr(at, fd, cap, msgs.OperatorResult(sh.Name))
    } else if not sh.Result and res != types.VoidT {
        c.shapeErr(at, fd, cap, msgs.SetatResult())
    } else if not sh.MayFail and c.P.T.Items(c.P.T.Errors(sig)).Len() > 0 and not c.infersErrs(sig) {
        # an inferred set is judged once it is known (failForms)
        c.shapeErr(at, fd, cap, msgs.MethodCannotFail(sh.Name))
    } else if sh.Name == "Less" and res != types.BoolT {
        c.shapeErr(at, fd, cap, msgs.LessNotBool())
    } else if sh.Name == "Len" and res != c.i64() {
        c.shapeErr(at, fd, cap, msgs.LenShape())
    } else if sh.Name == "Eq" or sh.Name == "Str" {
        writes := c.writable(ps[0])
        if sh.Name == "Eq" {
            writes = writes or c.writable(ps[1])
            if res != types.BoolT or not c.P.T.Same(c.P.T.Plain(c.deref(ps[0])), c.P.T.Plain(c.deref(ps[1]))) { c.shapeErr(at, fd, cap, msgs.EqShape()) }
        } else if not c.sameRepr(c.deref(res), c.textType()) {
            c.shapeErr(at, fd, cap, msgs.StrShape())
        }
        if writes { c.shapeErr(at, fd, cap, msgs.EqStrWrites(sh.Name)) }
    }
    c.pop()
}

# E31c: "commutes" only on Plus, Mul, BitAnd, BitOr, BitXor of the operator's shape, taking another type than its
# receiver's, and never where the other type's operator takes this one (the later of two commuting ones said)
fn (c mut Checker&) commutesRule(f I64, fd ast.Func&, cap String&) {
    mi := c.P.FnModule(f)
    c.push(-1, mi, types.VoidT, types.ListId(0))
    defer c.pop()
    at := c.nameSpan(fd)
    sig := c.P.Sig(f)
    ps := c.P.T.Items(c.P.T.Params(sig))
    okName := cap == "Plus" or cap == "Mul" or cap == "BitAnd" or cap == "BitOr" or cap == "BitXor"
    if not okName or fd.Recv is null or ps.Len() != 2 {
        c.err(at, msgs.CommutesNotHere(c.tok(fd.Name)))
        return
    }
    recv := c.P.T.Plain(c.deref(ps[0]))
    other := c.P.T.Plain(c.deref(ps[1]))
    if c.P.T.Same(recv, other) {
        c.err(at, msgs.CommutesSameType(c.tok(fd.Name), c.ty(other)))
        return
    }
    if not c.isNamed(other) { return }
    m2 := c.roleMethod(other, cap, 1)
    if m2 < 0 or m2 == f { return }
    ps2 := c.P.T.Items(c.P.T.Params(c.P.Sig(m2)))
    if not c.P.T.Same(c.P.T.Plain(c.deref(ps2[1])), recv) { return }
    if c.P.FnDecl(m2).S.Commutes and m2 > f { return }   # the later of two commuting ones is said
    opTok := "'+'" if cap == "Plus" else ("'*'" if cap == "Mul" else ("'&'" if cap == "BitAnd" else ("'|'" if cap == "BitOr" else "'^'")))
    c.err(at, msgs.CommutesClash(opTok, c.ty(recv), c.ty(other), $c.ty(other) "." $c.text(c.P.FnDecl(m2).Name)))
}

# the operator role a method's name claims (E31, M6b): its capitalized spelling
fn (c mut Checker&) operatorRole(name String&) String { return $name[0].ToUpper() $name[1:] }

fn opShapeOf(cap String&) I64 {
    for i in range OpShapes.Len() {
        if OpShapes[i].Name == cap { return i }
    }
    return -1
}

# what can fail of the methods claiming operators, once every set is known (R1a): Len, Eq and Str never (E31)
fn (c mut Checker&) failForms() {
    for f in range c.P.FnCount() {
        fd := c.P.FnDecl(f)
        if fd.Recv is null or c.P.FnIsExtern(f) or c.P.VarCount(generic.FnOwner(f)) > 0 { continue }
        if c.RootOnly and c.P.FnModule(f) != c.P.L.Root { continue }
        name := c.text(fd.Name)
        if name.Len() == 0 { continue }
        k := opShapeOf(c.operatorRole(name))
        if k < 0 or OpShapes[k].MayFail { continue }
        sig := c.P.Sig(f)
        if c.infersErrs(sig) and c.P.T.Items(c.fnErrors(f)).Len() > 0 {
            c.push(-1, c.P.FnModule(f), types.VoidT, types.ListId(0))
            c.err(c.nameSpan(fd), msgs.MethodCannotFail(c.operatorRole(name)))
            c.pop()
        }
    }
    c.drain()
}

# whether a parameter's type lets the body write what it is given: a writable reference
fn (c mut Checker&) writable(t types.TypeId) Bool { return c.isRef(t) and (c.P.T.PermOf(t) & types.Writable) != 0 }

fn (c mut Checker&) decls(mi I64, ds Array<ast.Decl&>&) {
    tests I64 = 0
    for d in ds {
        match d {
            case ast.Decl.Global(_, v) {
                for n in v.Names {
                    c.globalDecls.Push(pair.Pair(mi, I64(n)))
                    c.globalBody(mi, n)
                }
            }
            case ast.Decl.Test(sp, nsp, body, target) {
                if mi == c.P.L.Root {
                    c.testTarget(mi, nsp, target)
                    c.testBody(mi, sp, body, tests)
                }
                tests++
            }
            case ast.Decl.Type(tsp, td) {
                c.declAttrs(mi, d)
                c.typeRules(mi, tsp, td)
                c.declaredCtor(mi, td)
                c.traitSets(mi, td)
                c.traitHeader(mi, td)
                c.traitContracts(mi, td)
            }
            case ast.Decl.Fn(_) { c.declAttrs(mi, d) }
            case ast.Decl.Assert(sp, k, msg) {
                c.push(-1, mi, types.VoidT, types.ListId(0))
                c.topAssert(mi, sp, k, msg)
                c.pop()
            }
            case ast.Decl.If(_, ti) { c.declsIf(mi, ti, c.P.L.Chosen(mi, ti.Cond!.Span().Start), 0) }
            case ast.Decl.ExternBlock(_, _, xs) { c.decls(mi, xs) }
            case ast.Decl.Errors(esp, name, words, members) {
                c.push(-1, mi, types.VoidT, types.ListId(0))
                c.errorDeclRules(mi, esp, name, words, members)
                c.pop()
            }
            nomatch { }
        }
    }
}

# T19, T19a: an error type's words differ; a named set's members are error types, their words or sets, none reaching
# the set again, and its own words repeat no word of a member's
fn (c mut Checker&) errorDeclRules(mi I64, sp source.Span, name source.NameId, words Array<source.NameId>&
                                   members Array<ast.Path&>&) {
    file := c.P.L.Mods[mi].File
    text := c.P.L.Mods[mi].Src!.Text
    for i in range words.Len() {
        for j in range i {
            if words[j] == words[i] {
                at := wordAt(text, I64(sp.Start), c.text(words[i]), 2)
                c.P.L.Diags.Error(diag.Where.Span(file, at, at + c.text(words[i]).Len()), msgs.ErrorWordInUse(c.tok(words[i])))
            }
        }
    }
    if members.Len() == 0 { return }
    ctx := generic.Context(mi, -1)
    ok := true
    for m in members {
        if not c.P.ErrorItemKnown(ctx, m) { ok = false }
    }
    if not ok { return }
    ei := c.P.TypeEntry(mi, name)
    if ei < 0 { return }
    me := c.P.DeclFor(mi, ei)
    nsp := source.Span(sp.Start + 5, sp.Start + 5 + I32(c.text(name).Len()))
    # T19a: a set reaching itself through its members stands for nothing
    for m in members {
        if c.setReaches(c.P.ErrorSetItem(ctx, m), me, 0) {
            c.P.L.Diags.Error(diag.Where.Span(file, I64(nsp.Start), I64(nsp.End)), msgs.ErrorSetHoldsItself(c.tok(name), c.src(m.Sp)))
            return
        }
    }
    if words.Len() == 0 { return }
    es Vec<types.TypeId>
    for m in members { c.P.ErrorSetEntries(ctx, m, es) }
    for w in words {
        for e in es {
            if e == types.UnknownT { continue }
            ws := c.P.ErrorWords(c.P.T.DeclOf(c.P.T.ErrOf(e)))
            mask := c.P.T.ErrMask(e)
            for k in range ws.Len() {
                if ws[k] == w and (k >= 64 or (mask & (U64(1) << k)) != 0) {
                    at := wordAt(text, I64(sp.Start), c.text(w), 1)
                    c.P.L.Diags.Error(diag.Where.Span(file, at, at + c.text(w).Len()), msgs.ErrorWordOfMember(c.tok(w), c.ty(c.P.T.ErrOf(e))))
                }
            }
        }
    }
}

# whether error set entry t reaches declaration d through the members of the sets it is (T19a)
fn (c mut Checker&) setReaches(t types.TypeId, d types.DeclId, depth I64) Bool {
    if t == types.UnknownT or c.P.T.KindOf(t) != types.Kind.Named or depth > 64 { return false }
    td := c.P.T.DeclOf(t)
    if td == d { return true }
    ms := c.P.ErrorMembers(td)
    if ms.Len() == 0 { return false }
    mc := generic.Context(c.P.T.DeclModule(td), -1)
    for m in ms {
        if c.setReaches(c.P.ErrorSetItem(mc, m), d, depth + 1) { return true }
    }
    return false
}

# where word w is written in a declaration's braces, its k-th time there (1 the first): its offset, the declaration's
# start where it is not found
fn wordAt(text String&, from I64, w String&, k I64) I64 {
    i := from
    for i < text.Len() and text[i] != '{' { i++ }
    seen I64 = 0
    for i < text.Len() and text[i] != '}' {
        if text[i] == '#' {
            for i < text.Len() and text[i] != '\n' { i++ }
            continue
        }
        if text[i:].StartsWith(w) and not text[i - 1].IsLetter() and not text[i - 1].IsDigit() and text[i - 1] != '_' {
            e := i + w.Len()
            if e >= text.Len() or not (text[e].IsLetter() or text[e].IsDigit() or text[e] == '_') {
                seen++
                if seen == k { return i }
            }
        }
        i++
    }
    return from
}

# what a type declaration may be over (T29) and extend (T29f)
fn (c mut Checker&) typeRules(mi I64, sp source.Span, td ast.TypeDecl?&) {
    if td is null or td.Body is null { return }
    ei := c.P.TypeEntry(mi, td.Name)
    if ei < 0 { return }
    d := c.P.DeclFor(mi, ei)
    fr := c.push(-1, mi, types.VoidT, types.ListId(0))
    fr.Ctx = c.P.DeclContext(d)
    # G1: a type's parameters named after no type
    if td.Params.Len() > 0 {
        for tp in td.Params {
            if c.namesType(mi, tp.Name) { c.err(source.Span(tp.Sp.Start, tp.Sp.Start + I32(c.text(tp.Name).Len())), msgs.TypeVarNamesType(c.tok(tp.Name))) }
        }
    }
    # G6, G19: a parameter's constraint is a trait - a length is never a parameter (T7)
    if td.Params.Len() > 0 {
        for tp in td.Params {
            if tp.Ty is not null and not c.traitRef(mi, tp.Ty!) { c.err(tp.Ty!.Span(), msgs.ConstraintNotTrait(c.src(tp.Ty!.Span()))) }
            for a in tp.Also {
                if not c.traitRef(mi, a) { c.err(a.Span(), msgs.ConstraintNotTrait(c.src(a.Span()))) }
            }
        }
    }
    if td.Params.Len() > 0 {
        # G6: only a struct, an enum (G6b) or a trait takes type parameters
        match td.Body {
            case ast.TypeBody.Over(_, _) { c.err(td.Params[0].Sp, msgs.GenericNotStruct()) }
            nomatch { }
        }
    }
    match td.Body {
        case ast.TypeBody.Struct(sb) {
            c.ctorVarRules(td, sb)
        }
        case ast.TypeBody.Enum(cases, _) {
            # T4, T17: a payload's types are known ones, said where they are written
            for cd in cases {
                if cd.Payload.Len() == 0 { continue }
                for prm in cd.Payload { c.writtenMet(prm.Ty) }
            }
            c.raws.Put(I64(d), c.rawTable(d, true))   # T17e, said here
        }
        nomatch { }
    }
    text := c.src(sp)
    name := c.text(td.Name)
    nat := try text.Find(name) catch default 0
    nsp := source.Span(sp.Start + I32(nat), sp.Start + I32(nat + name.Len()))
    over := false
    match td.Body {
        case ast.TypeBody.Over(base, _) {
            over = true
            b := c.P.Resolve(fr.Ctx, base)
            if c.isNamed(b) {
                k := c.declKind(b)
                if k != types.DeclKind.Over or c.P.T.Args(b) != types.ListId(0) {
                    c.err(base.Span(), msgs.DeclaredOverAggregate(c.ty(b)))
                }
            } else if c.P.T.KindOf(b) == types.Kind.Array and c.holdsSelf(d, b) {
                c.err(nsp, msgs.ArrayTypeHoldsItself(name, name, c.ty(b)))
            } else if c.P.T.KindOf(b) == types.Kind.Array and c.runArrayValue(c.P.T.Elem(b)) {
                # T7a: a type over an array of arrays holds its rows by reference, or at a length its declaration gives -
                # a value of it is made elsewhere, so no row of it can be laid out in place (as a field's cannot)
                c.err(base.Span(), msgs.ArrayNestedByValue(c.ty(c.P.T.Elem(b))))
            }
        }
        nomatch { }
    }
    # T16: a struct or an enum holding itself by value - directly, or through a fixed array, a payload or another
    # value it holds - is infinitely large
    match td.Body {
        case ast.TypeBody.Struct(sb) {
            self := c.P.SelfType(d)
            # a generic's is said per instance, as its constructor is checked (holdsItself)
            if c.P.T.Items(c.P.T.Args(self)).Len() == 0 and c.P.Body(self) {
                fs := c.P.T.Items(c.P.T.Fields(self))
                sps := fieldSpans(sb)
                for i in range fs.Len() {
                    if i < sps.Len() and c.holdsBy(fs[i], d, 0) {
                        c.err(sps[i], msgs.TypeHoldsItself(c.ty(self)))
                        break
                    }
                }
            }
        }
        case ast.TypeBody.Enum(cases, _) {
            self := c.P.SelfType(d)
            # T7a, T7b: a payload holds an array by reference - its parameters have no declaration to give a length
            for cd in cases {
                if cd.Payload.Len() == 0 { continue }
                for prm in cd.Payload {
                    if prm.Ty is null { continue }
                    pt := c.P.Resolve(fr.Ctx, prm.Ty)
                    if not c.isRef(pt) and c.runArrayValue(pt) {
                        psp := source.Span(prm.Sp.Start, prm.Sp.Start + I32(c.text(prm.Name).Len()))
                        c.err(psp, msgs.ArrayParamByValue(c.tok(prm.Name), c.src(prm.Ty!.Span())))
                    }
                }
            }
            said := false
            for cd in cases {
                if said or cd.Payload.Len() == 0 { continue }
                for prm in cd.Payload {
                    if c.holdsBy(c.P.Resolve(fr.Ctx, prm.Ty), d, 0) {
                        c.err(source.Span(prm.Sp.Start, prm.Sp.Start + I32(c.text(prm.Name).Len())), msgs.TypeHoldsItself(c.ty(self)))
                        said = true
                        break
                    }
                }
            }
        }
        nomatch { }
    }
    if td.Extends and not over {
        at := try text.Find("extends") catch default nat
        c.err(source.Span(sp.Start + I32(at), sp.Start + I32(at + 7)), msgs.ExtendsNotBase())
    }
    c.pop()
}

# whether a value of type t holds a value of declaration d by value: itself, or through a struct's fields, an enum's
# payloads, a fixed array's elements or what a type is declared over - never through a reference or a run-time array
# T16 for a generic struct: each instance that holds itself by value, said at the field, named as the instance
fn (c mut Checker&) instHoldsItself(t types.TypeId, d types.DeclId, sb ast.StructBody&) {
    if not c.P.Body(t) { return }
    fs := c.P.T.Items(c.P.T.Fields(t))
    sps := fieldSpans(sb)
    for i in range fs.Len() {
        if i < sps.Len() and c.holdsInst(fs[i], t, 0) {
            c.err(sps[i], msgs.TypeHoldsItself(c.ty(t)))
            return
        }
    }
}

# whether a value of type x holds the instance t by value - x itself, or through a fixed array, a payload or another
# value it holds; an instance of the same generic with other arguments is another type (finite where it nests no deeper)
fn (c mut Checker&) holdsInst(x types.TypeId, t types.TypeId, depth I64) Bool {
    if depth > 16 or x == types.UnknownT { return false }
    if x == t { return true }
    match c.P.T.KindOf(x) {
        case types.Kind.Named {
            if not c.P.Body(x) { return false }
            k := c.declKind(x)
            if k == types.DeclKind.Struct { return c.listHoldsInst(c.P.T.Fields(x), t, depth) }
            if k == types.DeclKind.Enum { return c.listHoldsInst(c.P.T.Cases(x), t, depth) }
            if k == types.DeclKind.Over { return c.holdsInst(c.P.T.Base(x), t, depth + 1) }
            return false
        }
        case types.Kind.Array {
            if c.P.T.Length(x) == types.TypeId(0) { return false }
            return c.holdsInst(c.P.T.Elem(x), t, depth + 1)
        }
        case types.Kind.Tuple, types.Kind.Record { return c.listHoldsInst(c.P.T.Parts(x), t, depth) }
        nomatch { return false }
    }
}

fn (c mut Checker&) listHoldsInst(l types.ListId, t types.TypeId, depth I64) Bool {
    for x in c.P.T.Items(l) {
        if x != types.TypeId(0) and c.holdsInst(x, t, depth + 1) { return true }
    }
    return false
}

fn (c mut Checker&) holdsBy(t types.TypeId, d types.DeclId, depth I64) Bool {
    if depth > 16 or t == types.UnknownT { return false }
    match c.P.T.KindOf(t) {
        case types.Kind.Named {
            if c.P.T.DeclOf(t) == d { return true }
            if not c.P.Body(t) { return false }
            k := c.declKind(t)
            if k == types.DeclKind.Struct { return c.listHoldsBy(c.P.T.Fields(t), d, depth) }
            if k == types.DeclKind.Enum { return c.listHoldsBy(c.P.T.Cases(t), d, depth) }
            if k == types.DeclKind.Over { return c.holdsBy(c.P.T.Base(t), d, depth + 1) }
            return false
        }
        case types.Kind.Array {
            if c.P.T.Length(t) == types.TypeId(0) { return false }
            return c.holdsBy(c.P.T.Elem(t), d, depth + 1)
        }
        case types.Kind.Tuple, types.Kind.Record { return c.listHoldsBy(c.P.T.Parts(t), d, depth) }
        nomatch { return false }
    }
}

fn (c mut Checker&) listHoldsBy(l types.ListId, d types.DeclId, depth I64) Bool {
    for x in c.P.T.Items(l) {
        if x != types.TypeId(0) and c.holdsBy(x, d, depth + 1) { return true }
    }
    return false
}

# a struct's fields' names' spans, in their order (C2a)
fn fieldSpans(sb ast.StructBody&) Vec<source.Span> {
    out := Vec<source.Span>()
    if sb.Body.Len() == 0 { return out }
    for st in sb.Body {
        match st {
            case ast.Stmt.Var(_, v) {
                if v.Field {
                    for sp in v.NameSps { out.Push(sp) }
                }
            }
            nomatch { }
        }
    }
    return out
}

# G10d: a constructor's own type variables - only a type with no parameters has them, and no field's type names one
fn (c mut Checker&) ctorVarRules(td ast.TypeDecl&, sb ast.StructBody&) {
    if sb.TypeParams.Len() == 0 { return }
    if td.Params.Len() > 0 {
        tp := sb.TypeParams[0]
        c.err(source.Span(tp.Sp.Start, tp.Sp.Start + I32(c.text(tp.Name).Len())), msgs.CtorVarOfGeneric(c.text(tp.Name), c.text(td.Name), c.text(tp.Name)))
        return
    }
    v := c.text(sb.TypeParams[0].Name)
    if sb.Body.Len() == 0 { return }
    for st in sb.Body {
        match st {
            case ast.Stmt.Var(_, vd) {
                if not vd.Field { continue }
                for i in range vd.Names.Len() {
                    if vd.Ty is null and vd.Values.Len() > 0 {
                        c.err(vd.NameSps[i], msgs.CtorGenericInferredField(c.tok(vd.Names[i]), v))
                        return
                    }
                    ty := vd.Ty
                    if ty is null and vd.Values.Len() == 0 and sb.Params.Len() > 0 {
                        for prm in sb.Params {
                            if prm.Name == vd.Names[i] { ty = prm.Ty }
                        }
                    }
                    if ty is null { continue }
                    for tp in sb.TypeParams {
                        if c.wordIn(ty.Span(), c.text(tp.Name)).Start >= 0 {
                            c.err(vd.NameSps[i], msgs.CtorFieldNamesVar(c.tok(vd.Names[i]), c.text(tp.Name), c.text(td.Name), c.text(tp.Name)))
                            return
                        }
                    }
                }
            }
            nomatch { }
        }
    }
}

# whether a type over an array (b, d's base) holds itself through its elements - directly, or through another type over
# an array holding d in turn: said once, at the last declared of them (T29)
fn (c mut Checker&) holdsSelf(d types.DeclId, b types.TypeId) Bool {
    e := c.deref(c.P.T.Elem(b))
    seen := Vec<types.DeclId>()
    for _ in range 16 {
        if not c.isNamed(e) or c.declKind(e) != types.DeclKind.Over { return false }
        ed := c.P.T.DeclOf(e)
        if ed == d {
            for x in seen {
                if c.P.DeclModule(x) == c.P.DeclModule(d) and I64(x) > I64(d) { return false }
            }
            return true
        }
        seen.Push(ed)
        if not c.P.Body(e) { return false }
        nb := c.P.T.Base(e)
        if c.P.T.KindOf(nb) != types.Kind.Array { return false }
        e = c.deref(c.P.T.Elem(nb))
    }
    return false
}

# T30a, T31a: what a trait extends is traits, none reaching the trait itself again; what a closed trait lists is types,
# or closed traits whose types it takes in, each type having the trait's methods
fn (c mut Checker&) traitHeader(mi I64, td ast.TypeDecl?&) {
    if td is null or td.Body is null { return }
    match td.Body {
        case ast.TypeBody.Trait(_, exts, members) {
            if exts.Len() == 0 and members.Len() == 0 { return }
            ei := c.P.TypeEntry(mi, td.Name)
            if ei < 0 { return }
            d := c.P.DeclFor(mi, ei)
            fr := c.push(-1, mi, types.VoidT, types.ListId(0))
            fr.Ctx = c.P.DeclContext(d)
            self := c.P.SelfType(d)
            bad := false
            for e in exts {
                if not c.traitRef(mi, e) {
                    c.err(e.Span(), msgs.TraitExtendsNotTrait(c.src(e.Span())))
                    bad = true
                }
            }
            if not bad and exts.Len() > 0 and c.reachesTrait(d, self, 0) {
                c.err(exts[0].Span(), msgs.TraitExtendsItself(c.tok(td.Name)))
                bad = true
            }
            # each listed type has the methods - checked where the trait's own variables are known: not for a generic one
            check := not bad and td.Params.Len() == 0
            for m in members {
                isTrait := c.traitRef(mi, m)
                # a generic type listed with its arguments (G7): one instance of it is a member
                if not isTrait and not c.caseTypeWritten(m) { continue }
                t := c.P.Resolve(c.fr().Ctx, m) if isTrait else c.resolve(m)
                if t == types.UnknownT { continue }
                listed := types.TypeId[t]
                if isTrait {
                    if not c.P.IsClosedTrait(t) {
                        c.err(m.Span(), msgs.TraitMemberOpen(c.src(m.Span())))
                        continue
                    }
                    listed = c.P.Members(t)
                }
                if not check { continue }
                for x in listed {
                    u := c.P.Missing(x, self, false)
                    if u.Var >= 0 and u.Named { c.err(m.Span(), msgs.TraitMemberMissing(c.ty(x), c.tok(td.Name), c.tok(u.Method))) }
                }
            }
            c.pop()
        }
        nomatch { }
    }
}

# whether the traits tr extends reach the trait declared d (T30a)
fn (c mut Checker&) reachesTrait(d types.DeclId, tr types.TypeId, depth I64) Bool {
    if depth > 32 { return true }
    for e in c.P.Extended(tr) {
        if c.P.T.KindOf(e) != types.Kind.Named { continue }
        if c.P.T.DeclOf(e) == d { return true }
        if c.reachesTrait(d, e, depth + 1) { return true }
    }
    return false
}

# R1b: a trait's method writes its error set - no body says what it is
fn (c mut Checker&) traitSets(mi I64, td ast.TypeDecl?&) {
    if td is null or td.Body is null { return }
    match td.Body {
        case ast.TypeBody.Trait(ms, _, _) {
            c.push(-1, mi, types.VoidT, types.ListId(0))
            for m in ms {
                if m.S.HasErrors and m.S.Errors.Len() == 0 {
                    c.err(source.Span(m.Sp.Start, m.Sp.Start + I32(c.text(m.Name).Len())), msgs.TraitErrsUnwritten())
                }
            }
            c.pop()
        }
        nomatch { }
    }
}

# E10b: the supplied Hash hashes a part whose type declares Hash - or, in that type's own module, a private hash (M6b) -
# by it: each such method's body made, for lowering's helper to call
fn (c mut Checker&) partHashes(t types.TypeId, depth I64) {
    if depth > 8 { return }
    d := c.deref(t)
    r := d if c.isNamed(d) else c.P.T.Repr(d)
    if depth > 0 and c.isNamed(r) {
        for name in String&["Hash", "hash"] {
            m := c.P.MethodOf(r, c.P.L.Names.Intern(name))
            if m < 0 or c.P.VarCount(generic.FnOwner(m)) > 0 { continue }
            if name == "hash" and c.P.FnModule(m) != c.fr().Mi {
                # M6b: a private hash is its own module's - the supplied Hash elsewhere cannot use it
                if c.hashAt.Start >= 0 { c.privateRole(m, r, "Hash", c.hashAt, "'Hash'") }
                continue
            }
            c.fnBody(c.P.FnInstance(m, types.ListId(0)))
            return
        }
    }
    u := c.P.T.Repr(d)
    k := c.P.T.KindOf(u)
    if k == types.Kind.Array { c.partHashes(c.P.T.Elem(u), depth + 1) }
    if k == types.Kind.Tuple or k == types.Kind.Record {
        for x in c.P.T.Items(c.P.T.Parts(u)) { c.partHashes(x, depth + 1) }
    }
    if c.isStruct(r) and c.P.Body(r) {
        for x in c.P.T.Items(c.P.T.Fields(r)) { c.partHashes(x, depth + 1) }
    }
}

# a type's constructor checked whether or not a call asks for it (C2, T29d): a struct's, or a declared number's that
# declares one - neither a generic's (checked per instance, G16) nor one whose parameters introduce variables (G10d)
fn (c mut Checker&) declaredCtor(mi I64, td ast.TypeDecl?&) {
    if td is null or td.Body is null or (td.Params.Len() > 0) { return }
    match td.Body {
        case ast.TypeBody.Struct(s) {
            if s.TypeParams.Len() > 0 { return }
        }
        case ast.TypeBody.Over(_, ctor) {
            if ctor is null or (ctor.TypeParams.Len() > 0) { return }
        }
        nomatch { return }
    }
    ei := c.P.TypeEntry(mi, td.Name)
    if ei < 0 { return }
    c.ctorBody(c.P.T.Named(c.P.DeclFor(mi, ei), types.ListId(0)))
}

fn (c mut Checker&) declsIf(mi I64, ti ast.TopIf&, chosen I64, index I64) {
    if chosen == index and ti.Then is not null and ti.Then!.Decls.Len() > 0 { c.decls(mi, ti.Then!.Decls) }
    if ti.ElseIf is not null { c.declsIf(mi, ti.ElseIf!, chosen, index + 1) }
    if ti.Else is not null and chosen == index + 1 and ti.Else!.Decls.Len() > 0 { c.decls(mi, ti.Else!.Decls) }
}

# every queued body checked, in the order asked for - then a table's default slots some call has come to reach since
# (T32a), until no more do
fn (c mut Checker&) drain() {
    for {
        for c.queued < c.queue.Len() {
            id := c.queue[c.queued]
            c.queued++
            if c.state[id] == 0 { c.check(id) }
        }
        if not c.wakeThunks() { return }
    }
}

# T32a: a default slot's thunk made an "unreachable" while no call reached it, checked again as the call of the default
# now one does - whether any was
fn (c mut Checker&) wakeThunks() Bool {
    woke := false
    k := 0
    for k < c.lazyThunks.Len() {
        id := c.lazyThunks[k]
        match c.Bodies[id].Of {
            case typed.BodyOf.Thunk(ti, slot) {
                if c.slotsCalled.Has(c.P.SlotKey(c.P.AnyTables[ti].Trait, slot)) {
                    b := c.Bodies[id]
                    c.Bodies[id] = typed.Body(b.Id, b.Of, b.Ty, b.File, b.Sp)
                    c.state[id] = 0
                    c.queue.Push(id)
                    c.lazyThunks.RemoveAt(k)!
                    woke = true
                    continue
                }
            }
            nomatch { }
        }
        k++
    }
    return woke
}

# T32b: a call through an "any" of trait r at sp reaches slot k
fn (c mut Checker&) slotCall(r types.TypeId, k I64, sp source.Span) {
    if c.P.AnySlots(r).Len() == 0 { return }
    key := c.P.SlotKey(r, k)
    if not c.slotsCalled.Has(key) { c.slotsCalled.Put(key, c.at(sp)) }
}

fn (c mut Checker&) newBody(of typed.BodyOf, ty types.TypeId, mi I64, sp source.Span) I64 {
    id := c.Bodies.Len()
    c.Bodies.Push(typed.Body(typed.BodyId(I32(id)), of, ty, c.P.L.Mods[mi].File, sp))
    c.state.Push(0)
    c.queue.Push(id)
    return id
}

# a function instance's body, made and queued the first time it is asked for
fn (c mut Checker&) fnBody(inst I64) I64 {
    id := try c.fnBodies.Get(inst) catch default -1
    if id >= 0 { return id }
    f := c.P.InstanceFn(inst)
    sig := c.P.InstanceSig(inst)
    id = c.newBody(typed.BodyOf.Fn(inst), sig, c.P.FnModule(f), c.P.FnDecl(f).Sp)
    c.fnBodies.Put(inst, id)
    if c.infersErrs(sig) { c.inferring.Put(id, true) }
    return id
}

# ---- inferred error sets (R1a) ----

# whether a signature's error set is "?" alone: what its body can fail with, inferred
fn (c mut Checker&) infersErrs(sig types.TypeId) Bool {
    es := c.P.T.Items(c.P.T.Errors(sig))
    return es.Len() == 1 and es[0] == types.DefaultErrT
}

# a body's identity across attempts: what it is the body of
fn (c mut Checker&) bodyKey(id I64) pair.Pair<I64, I64> {
    return match c.Bodies[id].Of {
        case typed.BodyOf.Fn(inst) => pair.Pair(inst, -1)
        case typed.BodyOf.Ctor(t, twin) => pair.Pair(-2 - I64(t), I64(twin))
        case _ => pair.Pair(-1, -1)
    }
}

# what the body numbered id can fail with: its signature's set, or the one inferred from it - checked first where it
# has not been, a set not final yet (a cycle being checked) read as it stands and noted, as is reading one that rests
# on such a read
fn (c mut Checker&) bodyErrors(id I64) types.ListId {
    sig := c.Bodies[id].Ty
    if not (try c.inferring.Get(id) catch default false) { return c.P.T.Errors(sig) }
    if c.state[id] == 0 { c.checkNow(id) }
    if c.state[id] == 2 {
        es := try c.inferredErrs.Get(id) catch default types.ListId(0)
        if try c.unsettled.Get(id) catch default false {
            c.errReads.Push(pair.Pair(id, c.P.T.Items(es).Len()))
            c.unsettle()
        }
        return es
    }
    es := try c.errPresets.Get(c.bodyKey(id)) catch default types.ListId(0)
    c.errReads.Push(pair.Pair(id, c.P.T.Items(es).Len()))
    c.unsettle()
    return es
}

# the body being checked rests on a set not final yet: so does its own, where it is inferred
fn (c mut Checker&) unsettle() {
    for i in range c.frames.Len() {
        fr := c.frames[c.frames.Len() - 1 - i]
        if fr.Settles {
            c.unsettled.Put(fr.Body, true)
            return
        }
    }
}

# what a function can fail with (R1a): its signature's set, its body's inferred one where the set is "?" alone
fn (c mut Checker&) fnErrors(f I64) types.ListId {
    sig := c.P.Sig(f)
    if not c.infersErrs(sig) { return c.P.T.Errors(sig) }
    return c.bodyErrors(c.fnBody(c.P.FnInstance(f, types.ListId(0))))
}

# what a call of target can fail with: its body's set where it calls one, else its signature's
fn (c mut Checker&) calleeErrors(target typed.Callee&c, sig types.TypeId) types.ListId {
    return match target {
        case typed.Callee.Body(b) => c.bodyErrors(I64(b))
        case _ => c.P.T.Errors(sig)
    }
}

# a body checked where it is asked for, inside another's check: what the one being checked holds kept
fn (c mut Checker&) checkNow(id I64) {
    asking := c.P.Asking
    called := c.ctorCalled
    last := c.lastErrs
    c.check(id)
    c.P.Asking = asking
    c.ctorCalled = called
    c.lastErrs = last
}

# an inferred body's set, as its body found it: each error type once, in the canonical order - by the module declaring
# it, then its name (R1a)
fn (c mut Checker&) settle(fr frame&) {
    sorted := c.canonicalErrs(c.merged(c.letOut(fr)))
    c.inferredErrs.Put(fr.Body, sorted)
    c.found.Put(c.bodyKey(fr.Body), sorted)
    b := c.Bodies[fr.Body]
    b.Ty = c.P.T.Func(c.P.T.Params(b.Ty), c.P.T.Result(b.Ty), sorted, c.P.T.ScopesOf(b.Ty))
}

# what an error set holds, each type once (R1c): words of one type in one entry, every word of it the type itself
fn (c mut Checker&) merged(xs Vec<types.TypeId>&) Vec<types.TypeId> {
    es Vec<types.TypeId>
    for e in xs {
        if e == types.DefaultErrT or e == types.UnknownT { continue }
        et := c.P.T.ErrOf(e)
        k I64 = -1
        for j in range es.Len() {
            if c.P.T.ErrOf(es[j]) == et { k = j }
        }
        if k < 0 {
            es.Push(e)
            continue
        }
        if es[k] == et or e == et {
            es[k] = et
            continue
        }
        n := c.wordCount(et)
        full := U64(0) - 1 if n >= 64 else (U64(1) << n) - 1
        mask := (c.P.T.ErrMask(es[k]) | c.P.T.ErrMask(e)) & full
        es[k] = et if mask == full else c.P.T.ErrWords(et, mask)
    }
    return es
}

fn (c mut Checker&) canonicalErrs(es Vec<types.TypeId>&) types.ListId {
    xs := es.ToArray()
    xs.Sort(fn(a types.TypeId, b types.TypeId) Bool { return c.errBefore(a, b) })
    return c.P.T.List(xs)
}

fn (c mut Checker&) errBefore(a types.TypeId, b types.TypeId) Bool {
    da := c.P.T.DeclOf(c.P.T.ErrOf(a))
    db := c.P.T.DeclOf(c.P.T.ErrOf(b))
    ma := c.P.L.Mods[c.P.T.DeclModule(da)].Identity
    mb := c.P.L.Mods[c.P.T.DeclModule(db)].Identity
    if ma != mb { return ma < mb }
    return c.text(c.P.T.DeclName(da)) < c.text(c.P.T.DeclName(db))
}

# a struct's constructor's body (C2), made and queued the first time a call asks for it
fn (c mut Checker&) ctorBody(t types.TypeId) I64 { return c.twinBody(t, types.ListId(0)) }

# the constructor's body of one binding of its own variables (G10d's twin; none for an ordinary constructor)
fn (c mut Checker&) twinBody(t types.TypeId, args types.ListId) I64 {
    key := pair.Pair(I64(t), I64(args))
    id := try c.ctorBodies.Get(key) catch default -1
    if id >= 0 { return id }
    d := c.P.T.DeclOf(t)
    sig := c.P.CtorSigAt(t, args)
    id = c.newBody(typed.BodyOf.Ctor(t, args), sig, c.P.T.DeclModule(d), source.Span(0, 0))
    c.ctorBodies.Put(key, id)
    if c.infersErrs(sig) { c.inferring.Put(id, true) }
    return id
}

# a call of a constructor introducing type variables (G10d): its variables inferred from the arguments as a generic
# function's are (G9), the twin of that binding checked and called - every twin one type
fn (c mut Checker&) twinCall(sp source.Span, nsp source.Span, t types.TypeId, args Array<ast.Expr&>&) typed.Expr&c {
    sig := c.P.CtorSig(t)
    if sig == types.UnknownT { return c.unknown(sp) }
    d := c.P.T.DeclOf(t)
    args = c.ctorNamed(d, args)
    if c.namedBad {
        c.namedBad = false
        c.dropArgs(args)
        return c.unknown(sp)
    }
    ord := c.argOrder.ToArray()
    c.argOrder.Clear()
    owner := generic.CtorOwner(d)
    nv := c.P.CtorVars(d)
    ps := c.P.T.Items(c.P.T.Params(sig))
    b := generic.Binding(owner, nv)
    argVals Vec<typed.Expr&>
    for i in range args.Len() {
        e typed.Expr?&c = null
        v := c.fold(args[i])
        if v.Ok or c.litLike(args[i]) {
            fl := v.IsFloat if v.Ok else c.litFloat(args[i])
            if i < ps.Len() { c.unify(ps[i], c.P.T.Prim("F64") if fl else c.i64(), b, true, false) }
        } else {
            match args[i] {
                case ast.Expr.Lambda(_, _), ast.Expr.Default(_) { }
                nomatch { e = c.expr(args[i], types.UnknownT) }
            }
        }
        if e is not null and i < ps.Len() and typeOf(e) != types.UnknownT and typeOf(e) != types.NoreturnT { c.unify(ps[i], c.bindType(e), b, false, false) }
        if e is null { argVals.Push(c.hole) } else { argVals.Push(e) }
    }
    c.P.InferThroughBounds(b)
    for i in range nv {
        if b.Vals[i] == types.UnknownT {
            c.err(nsp, msgs.CtorVarsNotInferable(c.ty(t)))
            return c.unknown(sp)
        }
    }
    vals := c.P.T.List(b.Vals)
    isig := c.P.CtorSigAt(t, vals)
    if isig == types.UnknownT { return c.unknown(sp) }
    id := c.twinBody(t, vals)
    was := c.ctorCalled
    c.ctorCalled = t
    c.setOrder(ord)
    r := c.callBody(sp, nsp, isig, typed.Callee.Body(typed.BodyId(I32(id))), -1, null, args, argVals.ToArray())
    c.ctorCalled = was
    return r
}

# B7a: what a test names - a function, a type or Type.Method declared in its own file, the method's declaration the one
# in the file - checked, and a target and description given one test only
fn (c mut Checker&) testTarget(mi I64, nsp source.Span, target ast.Path?&) {
    if target is null { return }
    c.push(-1, mi, types.VoidT, types.ListId(0))
    defer { c.pop() }
    parts := target.Parts
    text := StringBuilder()
    for i, n in parts {
        if i > 0 { text.PushChar('.') }
        text.Push(c.text(n))
    }
    t := text.ToString()
    key := $"\x00" $t "\n" $c.src(nsp) "\x00"
    if c.testKeys.ToString().Contains(key) {
        c.err(target.Sp, msgs.TestTargetTwice(msgs.Tok(t)))
        return
    }
    c.testKeys.Push(key)
    tab := c.P.R.Tables[mi]
    if parts.Len() == 1 {
        for e in tab.Entries {
            if e.Name != parts[0] { continue }
            if e.Kind == names.What.Func or e.Kind == names.What.Type { return }
        }
        # a name some other module declares - the prelude's, an import's
        for m in range c.P.L.Mods.Len() {
            if m == mi { continue }
            for e in c.P.R.Tables[m].Entries {
                if e.Name == parts[0] and (e.Kind == names.What.Func or e.Kind == names.What.Type) {
                    c.err(target.Sp, msgs.TestTargetElsewhere(t))
                    return
                }
            }
        }
    } else if parts.Len() == 2 {
        c.P.AllFns()
        elsewhere := false
        for f in range c.P.FnCount() {
            decl := c.P.FnDecl(f)
            if decl.Recv is null or decl.Name != parts[1] { continue }
            ps := c.P.T.Items(c.P.T.Params(c.P.Sig(f)))
            if ps.Len() == 0 { continue }
            rt := c.deref(ps[0])
            # a named type's method, or one of an array's or a trait's default over a type variable (Array.Windows,
            # Iterator.TakeWhile), by the receiver its declaration writes
            named := c.isNamed(rt) and c.P.T.DeclName(c.P.T.DeclOf(rt)) == parts[0]
            if not named and (c.isNamed(rt) or ast.RecvTarget(decl, c.P.L.Names) != c.text(parts[0])) { continue }
            if c.P.FnModule(f) == mi { return }
            elsewhere = true
        }
        for e in tab.Entries {
            if e.Name == parts[0] and e.Kind == names.What.Import { elsewhere = true }
        }
        if elsewhere {
            c.err(target.Sp, msgs.TestTargetElsewhere(t))
            return
        }
    }
    # the nearest of the file's functions, types and methods
    near mut msgs.Nearest& = msgs.Nearest(t)
    for e in tab.Entries {
        if e.Kind == names.What.Func or e.Kind == names.What.Type { near.Offer(c.text(e.Name)) }
    }
    c.P.AllFns()
    for f in range c.P.FnCount() {
        decl := c.P.FnDecl(f)
        if decl.Recv is null or c.P.FnModule(f) != mi { continue }
        ps := c.P.T.Items(c.P.T.Params(c.P.Sig(f)))
        if ps.Len() == 0 { continue }
        if c.isNamed(c.deref(ps[0])) {
            near.Offer($c.text(c.P.T.DeclName(c.P.T.DeclOf(c.deref(ps[0])))) "." $c.text(decl.Name))
        } else if ast.RecvTarget(decl, c.P.L.Names) != "" {
            near.Offer($ast.RecvTarget(decl, c.P.L.Names) "." $c.text(decl.Name))
        }
    }
    if near.Best.Len() > 0 {
        c.err(target.Sp, msgs.TestTargetUnknownMeant(t, near.Best))
    } else {
        c.err(target.Sp, msgs.TestTargetUnknown(t))
    }
}

fn (c mut Checker&) testBody(mi I64, sp source.Span, body Array<ast.Stmt&>&, index I64) {
    id := c.newBody(typed.BodyOf.Test(index), c.P.T.Func(types.ListId(0), types.VoidT, types.ListId(0)), mi, sp)
    c.state[id] = 1
    fr := c.push(id, mi, types.VoidT, types.ListId(0))
    fr.Ctx = generic.Context(mi, -1)
    fr.InTest = true
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    root := c.rootStmts(body)
    c.cur().Root = root
    c.pop()
    c.state[id] = 2
}

# a global's initializer's body (K2), checked where it is first asked for - its type may be what asks
fn (c mut Checker&) globalBody(mi I64, n source.NameId) I64 {
    key := pair.Pair(mi, I64(n))
    id := try c.globalBodies.Get(key) catch default -1
    if id >= 0 { return id }
    v := c.P.GlobalDecl(mi, n)
    sp := source.Span(0, 0)
    if v is not null {
        for i in range v.Names.Len() {
            if v.Names[i] == n { sp = v.NameSps[i] }
        }
    }
    id = c.newBody(typed.BodyOf.Global(mi, n), c.P.T.Func(types.ListId(0), types.VoidT, types.ListId(0)), mi, sp)
    c.globalBodies.Put(key, id)
    c.check(id)
    return id
}

# a condition the build decides that B9a could not evaluate (B9c, S8b), checked in module mi's context as the body of
# a function giving its value (BodyOf.Cond), for the evaluator - a fixed local it reads (S8c) read as its initializer -
# -1 where it does not check there: it reads a local that is no fixed one (the running program's), or it is wrong,
# which is said where it is checked as part of its program
fn (c mut Checker&) CondBody(mi I64, x ast.Expr&) I64 { return c.ExprBody(mi, x, types.BoolT) }

# an expression that reads no local as the body of a function giving its value, of type ty, checked in module mi's
# context (BodyOf.Cond) - a condition (CondBody), an assert's message (S18c); -1 where it does not check there
fn (c mut Checker&) ExprBody(mi I64, x ast.Expr&, ty types.TypeId) I64 {
    return c.ExprBodyIn(mi, -1, Array<source.NameId>(0), Array<types.TypeId>(0), x, ty)
}

# the same in a context whose variables - ns, bound to vals - are bound: a constant argument of an instance of
# owner's (T7c)
fn (c mut Checker&) ExprBodyIn(mi I64, owner I64, ns Array<source.NameId>&, vals Array<types.TypeId>&, x ast.Expr&
                               ty types.TypeId) I64 {
    d := c.P.L.Diags
    # S8c: a fixed local is read as its initializer - the body it is asked in has the locals' bindings
    c.lastFixed.Clear()
    fixed := Map<source.NameId, I64>()
    fixedIn I64 = -1
    if c.frames.Len() > 0 {
        fixedIn = c.fr().Body
        if not c.onlyFixed(x, fixed) { return -1 }
    } else if c.declaresNames(x) {
        return -1
    }
    read := c.lastFixed.ToArray()
    mark := d.Count()
    gaps := c.Gaps.Len()
    unk := c.unknowns
    sp := x.Span()
    id := c.newBody(typed.BodyOf.Cond(mi, sp.Start), c.P.T.Func(types.ListId(0), ty, types.ListId(0)), mi, sp)
    c.state[id] = 1
    outerCtx := c.fr().Ctx if c.constsRead and c.frames.Len() > 0 else generic.Context(mi, owner)
    fr := c.push(id, mi, ty, types.ListId(0))
    fr.Ctx = generic.Context(mi, owner)
    if c.constsRead {
        fr.Ctx = generic.Context(mi, outerCtx.Owner)
        for e in outerCtx.Vars { fr.Ctx.Vars.Put(e.Key, e.Value) }
    }
    for i in range ns.Len() { fr.Ctx.Vars.Put(ns[i], vals[i]) }
    for e in fixed { fr.fixed.Put(e.Key, e.Value) }
    fr.fixedIn = fixedIn
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    from := c.stmts.Len()
    v := c.cond1(x) if ty == types.BoolT else c.fit(c.expr(x, ty), ty, sp)
    c.stmts.Push(typed.Stmt.Return(sp, v))
    c.cur().Root = typed.Block(typed.BlockId(0), gather(c.stmts, from))
    c.pop()
    c.state[id] = 2
    # the instances it asks for, made here, checked before it is evaluated (T7c: a length an instance computes) - only
    # there: a condition's (S18c) would check what its own body queued, its errors then forgotten with its own
    if ns.Len() > 0 { c.drain() }
    c.lastFixed.Clear()
    for l in read { c.lastFixed.Push(l) }
    # K1a: one reading what did not check - a global whose initializer had an error, a default that did not check - is
    # no value to decide by, its stand-in being no value of the program's (one error, not a second false assert)
    c.CondReadUnknown = d.Count() == mark and c.Gaps.Len() == gaps and c.unknowns > unk
    if d.Count() > mark or c.Gaps.Len() > gaps or c.unknowns > unk {
        d.Forget(mark)
        c.Gaps.Truncate(gaps)
        c.Bodies[id].Root = null
        return -1
    }
    return id
}

# explain (B11b): a body giving global n of module mi as "$" renders it, for the evaluator; -1 where it does not check
fn (c mut Checker&) RenderBody(mi I64, n source.NameId, sp source.Span) I64 {
    d := c.P.L.Diags
    mark := d.Count()
    ty := c.textType()
    id := c.newBody(typed.BodyOf.Cond(mi, sp.Start), c.P.T.Func(types.ListId(0), ty, types.ListId(0)), mi, sp)
    c.state[id] = 1
    fr := c.push(id, mi, ty, types.ListId(0))
    fr.Ctx = generic.Context(mi, -1)
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    from := c.stmts.Len()
    gt := c.globalType(mi, n)
    p mut typed.Lvalue&c = typed.Lvalue.Global(sp, gt, mi, n)
    seen := Map<types.TypeId, Bool>()
    c.wantStr(gt, seen, 0)
    ps mut Vec<typed.Piece&>&c = Vec<typed.Piece&>()
    if c.P.T.KindOf(gt) == types.Kind.Array and c.P.T.Length(gt) != types.TypeId(0) {
        ps.Push(typed.Piece.Render(typed.Expr.Borrow(sp, c.P.T.Ref(gt, types.ReadOnly), p)))
    } else {
        ps.Push(typed.Piece.Render(c.read(sp, p)))
    }
    c.stmts.Push(typed.Stmt.Return(sp, typed.Expr.Text(sp, ty, typed.Text(ps.ToArray(), c.site(typed.SiteKind.Text, sp)))))
    c.cur().Root = typed.Block(typed.BlockId(0), gather(c.stmts, from))
    c.pop()
    c.state[id] = 2
    c.drain()
    if d.Count() > mark {
        d.Forget(mark)
        c.Bodies[id].Root = null
        return -1
    }
    return id
}

# a top-level assert (S17a): its condition and its message checked in module mi's context, each as the body of a
# function of no parameters giving its value - as a global's initializer is, so what one may read the other may - and
# asked of the evaluator once the program has checked; what is wrong with either is said here, and then nothing is asked
fn (c mut Checker&) topAssert(mi I64, sp source.Span, k ast.Expr&, msg ast.Expr?&) {
    cb := c.topBody(mi, k, types.BoolT)
    mb I64 = -1
    if msg is not null { mb = c.topBody(mi, msg, c.P.T.Ref(c.textType(), types.ReadOnly)) }
    if cb < 0 or (msg is not null and mb < 0) { return }
    c.TopAsserts.Push(TopAssertAsk(c.P.L.Mods[mi].File, sp, c.operatorOf(k), cb, mb))
}

fn (c mut Checker&) topBody(mi I64, x ast.Expr&, ty types.TypeId) I64 {
    d := c.P.L.Diags
    mark := d.Count()
    gaps := c.Gaps.Len()
    unk := c.unknowns
    sp := x.Span()
    id := c.newBody(typed.BodyOf.Cond(mi, sp.Start), c.P.T.Func(types.ListId(0), ty, types.ListId(0)), mi, sp)
    c.state[id] = 1
    fr := c.push(id, mi, ty, types.ListId(0))
    fr.Ctx = generic.Context(mi, -1)
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    from := c.stmts.Len()
    v := c.cond1(x) if ty == types.BoolT else c.fit(c.expr(x, ty), ty, sp)
    c.stmts.Push(typed.Stmt.Return(sp, v))
    c.cur().Root = typed.Block(typed.BlockId(0), gather(c.stmts, from))
    c.pop()
    c.state[id] = 2
    c.drain()
    if d.Count() > mark or c.Gaps.Len() > gaps or c.unknowns > unk {
        c.Bodies[id].Root = null
        return -1
    }
    return id
}

# whether an expression declares names of its own (a lambda, a comprehension, a match, a catch clause), which a body of
# its own with no body around it (S8b, S18c, T7c) does not check. A name is never a local there - no body is being
# checked, so there are no frames to ask (c.fr() would index the empty list at -1, E16e) - and a type or constant
# variable it names is one the context binds (ExprBodyIn's ns), else checking it reports it
fn (c mut Checker&) declaresNames(x ast.Expr?&) Bool {
    if x is null { return false }
    return match x {
        case ast.Expr.Name(_, _), ast.Expr.Lit(_, _), ast.Expr.Default(_) => false
        case ast.Expr.Paren(_, a), ast.Expr.Named(_, _, a), ast.Expr.Unary(_, _, a), ast.Expr.Postfix(_, _, a), ast.Expr.Member(_, a, _) => c.declaresNames(a)
        case ast.Expr.IsType(_, a, _, _), ast.Expr.As(_, a, _), ast.Expr.Generic(_, a, _) => c.declaresNames(a)
        case ast.Expr.Binary(_, _, a, b), ast.Expr.NotIn(_, a, b), ast.Expr.Is(_, a, b, _) => c.declaresNames(a) or c.declaresNames(b)
        case ast.Expr.Cond(_, a, k, b) => c.declaresNames(a) or c.declaresNames(k) or c.declaresNames(b)
        case ast.Expr.Chain(_, ch) => c.anyDeclaresNames(ch.Xs)
        case ast.Expr.Call(_, f, args), ast.Expr.ScopeCall(_, f, _, args) => c.declaresNames(f) or c.anyDeclaresNames(args)
        case ast.Expr.Index(_, a, items) => c.declaresNames(a) or c.anyDeclaresNames(items)
        case ast.Expr.Slice(_, a, lo, hi) => c.declaresNames(a) or c.declaresNames(lo) or c.declaresNames(hi)
        case ast.Expr.ArrayLit(_, _, items), ast.Expr.Row(_, items), ast.Expr.Join(_, items), ast.Expr.Range(_, items) => c.anyDeclaresNames(items)
        case ast.Expr.Try(_, a, clauses) => c.declaresNames(a) or (clauses.Len() > 0)
        nomatch => true
    }
}

fn (c mut Checker&) anyDeclaresNames(xs Array<ast.Expr&>&) Bool {
    if xs.Len() == 0 { return false }
    for x in xs {
        if c.declaresNames(x) { return true }
    }
    return false
}

# where an expression's last operation is written: a binary operator's or a chain's last comparison's token, else the
# expression
fn (c mut Checker&) operatorOf(x ast.Expr&) source.Span {
    left := match x {
        case ast.Expr.Binary(_, _, a, _), ast.Expr.NotIn(_, a, _), ast.Expr.Is(_, a, _, _) => a
        case ast.Expr.Chain(_, ch) => ch.Xs[ch.Xs.Len() - 2]
        nomatch => null
    }
    if left is null { return x.Span() }
    t := c.P.L.Mods[c.fr().Mi].Src!.Text
    i := I64(left.Span().End)
    for i < t.Len() and (t[i] == ' ' or t[i] == ')') { i++ }
    j := i
    for j < t.Len() and t[j] != ' ' and t[j] != '(' and t[j] != '\n' { j++ }
    return source.Span(I32(i), I32(j))
}

# whether the name written at sp is a local, a type variable or a constant variable
fn (c mut Checker&) namesLocal(sp source.Span) Bool {
    k := c.P.R.Use(c.fr().File, sp.Start).Kind
    return k == names.What.Local or k == names.What.TypeVar
}

# ---- B5a: the order globals are set in ----

# what a walk from one global's initializer finds: the bodies it ran into, the functions named as values in what runs,
# the globals of its module read, the globals holding a function whose initializers were read for the names they hold,
# and whether what runs calls through a function value - which may reach any function named as one
type b5aWalk struct(Mod I64) {
    Mod
    walked Map<I64, Bool>
    named Vec<I64>
    found Vec<I64>
    holders Map<I64, Bool>
    strs Map<types.TypeId, Bool>
    namesOnly Bool = false
    through Bool = false
}

# every module's globals in the order they are set (P.InitOrder): a module after its imports - the prelude's first,
# then the root's, depth first - and within one each after the globals its initializer reads, directly or through what
# it calls, else in declaration order. A cycle is said once, from the first global left, along its reads; its members
# are then set in that order and the rest ordered on
fn (c mut Checker&) orderGlobals() {
    seen Map<I64, Bool>
    mods Vec<I64>
    for m in range c.P.L.Mods.Len() {
        if c.P.L.Mods[m].Prelude { c.b5aModules(m, seen, mods) }
    }
    c.b5aModules(c.P.L.Root, seen, mods)
    for m in range c.P.L.Mods.Len() { c.b5aModules(m, seen, mods) }
    c.P.InitOrder.Clear()
    for m in mods { c.orderModule(m, c.P.InitOrder) }
}

fn (c mut Checker&) b5aModules(m I64, seen mut Map<I64, Bool>&, out mut Vec<I64>&) {
    if seen.Has(m) { return }
    seen.Put(m, true)
    for im in c.P.L.Mods[m].Imports {
        if im.Target >= 0 { c.b5aModules(im.Target, seen, out) }
    }
    out.Push(m)
}

fn (c mut Checker&) orderModule(m I64, out mut Vec<I64>&) {
    gs Vec<I64>
    pos Map<I64, I64>
    for k in c.globalDecls {
        if k.First != m { continue }
        id := try c.globalBodies.Get(k) catch default -1
        if id < 0 or c.Bodies[id].Root is null or pos.Has(id) { continue }
        pos.Put(id, gs.Len())
        gs.Push(id)
    }
    for i in range c.Bodies.Len() {
        match c.Bodies[i].Of {
            case typed.BodyOf.Global(gm, _) {
                if gm == m and c.Bodies[i].Root is not null and not pos.Has(i) {
                    pos.Put(i, gs.Len())
                    gs.Push(i)
                }
            }
            case _ { }
        }
    }
    n := gs.Len()
    depAt Vec<I64>
    depTo Vec<I64>
    for g in gs {
        depAt.Push(depTo.Len())
        for d in c.globalDeps(m, g) { depTo.Push(try pos.Get(d) catch default -1) }
    }
    depAt.Push(depTo.Len())
    placed := Array<Bool>(n, false)
    done I64 = 0
    for done < n {
        pick I64 = -1
        for k in range n {
            if placed[k] { continue }
            ready := true
            for j in range depAt[k], depAt[k + 1] {
                if depTo[j] >= 0 and not placed[depTo[j]] { ready = false }
            }
            if ready {
                pick = k
                break
            }
        }
        if pick >= 0 {
            placed[pick] = true
            out.Push(gs[pick])
            done++
            continue
        }
        # a cycle: from the first global left, along the first unset global each reads, back to one on the path
        cur I64 = 0
        for placed[cur] { cur++ }
        path Vec<I64>
        for {
            at := try path.IndexOf(cur) catch default -1
            if at >= 0 {
                c.b5aCycle(gs, path, at)
                for p in range at, path.Len() {
                    placed[path[p]] = true
                    out.Push(gs[path[p]])
                    done++
                }
                break
            }
            path.Push(cur)
            next I64 = -1
            for j in range depAt[cur], depAt[cur + 1] {
                if next < 0 and depTo[j] >= 0 and not placed[depTo[j]] { next = depTo[j] }
            }
            if next < 0 {
                # no cycle after all (it cannot happen): the rest in declaration order
                for k in range n {
                    if not placed[k] {
                        placed[k] = true
                        out.Push(gs[k])
                        done++
                    }
                }
                break
            }
            cur = next
        }
    }
}

# a global read while its initializer is being checked: the globals being checked from it on, each reading the next,
# the last it again - said at it, once
fn (c mut Checker&) typeCycle(id I64) {
    chain Vec<I64>
    on := false
    for fr in c.frames {
        if fr.Body == id { on = true }
        if not on or fr.Body < 0 { continue }
        match c.Bodies[fr.Body].Of {
            case typed.BodyOf.Global(_, _) {
                if fr.Body not in chain { chain.Push(fr.Body) }
            }
            case _ { }
        }
    }
    if chain.Len() == 0 { return }
    path Vec<I64>
    for k in range chain.Len() { path.Push(k) }
    c.b5aCycle(chain, path, 0)
}

# the cycle path[at:] reported at its first global: one reading itself, or the chain back to it - not where one of its
# globals is in a cycle said already (typeCycle)
fn (c mut Checker&) b5aCycle(gs Vec<I64>&, path Vec<I64>&, at I64) {
    for p in range at, path.Len() {
        if c.b5aSaid.Has(gs[path[p]]) { return }
    }
    for p in range at, path.Len() { c.b5aSaid.Put(gs[path[p]], true) }
    first := c.Bodies[gs[path[at]]]
    w := diag.Where.Span(first.File, I64(first.Sp.Start), I64(first.Sp.End))
    if at == path.Len() - 1 {
        name := c.b5aName(gs[path[at]])
        c.P.L.Diags.Error(w, msgs.GlobalReadsItself(name, name))
        return
    }
    b := StringBuilder()
    for p in range at, path.Len() { b.Push($c.b5aName(gs[path[p]]) " -> ") }
    b.Push(c.b5aName(gs[path[at]]))
    c.P.L.Diags.Error(w, msgs.GlobalsCycle(b.ToString()))
}

fn (c mut Checker&) b5aName(b I64) String {
    return match c.Bodies[b].Of {
        case typed.BodyOf.Global(_, n) => $c.text(n)
        case _ => ""
    }
}

# the globals of module m that global body g's initializer reads, directly or through what it calls, at any depth
fn (c mut Checker&) globalDeps(m I64, g I64) Vec<I64> {
    w := b5aWalk(m)
    c.b5aInit(w, g)
    k I64 = 0
    for w.through and k < w.named.Len() {
        c.b5aFn(w, w.named[k])
        k++
    }
    return w.found
}

# a global's initializer, its store into the global itself left out (checkGlobal's last statement)
fn (c mut Checker&) b5aInit(w mut b5aWalk&, g I64) {
    b := c.Bodies[g]
    if b.Root is null { return }
    for st in b.Root!.Stmts {
        match st {
            case typed.Stmt.Assign(_, p, x) {
                match p {
                    case typed.Lvalue.Global(_, _, _, _) { c.b5aExpr(w, x) }
                    case _ { c.b5aStmt(w, st) }
                }
            }
            case _ { c.b5aStmt(w, st) }
        }
    }
}

# a function walked runs: what it reads counts, whatever the walk was reading for
fn (c mut Checker&) b5aFn(w mut b5aWalk&, b I64) {
    if b < 0 or b >= c.Bodies.Len() or w.walked.Has(b) { return }
    w.walked.Put(b, true)
    was := w.namesOnly
    w.namesOnly = false
    c.b5aBlock(w, c.Bodies[b].Root)
    w.namesOnly = was
}

fn (c mut Checker&) b5aGlobal(w mut b5aWalk&, mi I64, n source.NameId, ty types.TypeId) {
    if w.namesOnly { return }
    id := try c.globalBodies.Get(pair.Pair(mi, I64(n))) catch default -1
    if id < 0 { return }
    if mi == w.Mod and id not in w.found { w.found.Push(id) }
    # what it holds may be called: the functions its initializer names
    if not w.holders.Has(id) and c.b5aHoldsFn(ty, 0) {
        w.holders.Put(id, true)
        w.namesOnly = true
        c.b5aInit(w, id)
        w.namesOnly = false
    }
}

fn (c mut Checker&) b5aHoldsFn(t types.TypeId, depth I64) Bool {
    if depth > 8 or t == types.UnknownT { return false }
    return match c.P.T.KindOf(t) {
        case types.Kind.Func => true
        case types.Kind.Array => c.b5aHoldsFn(c.P.T.Elem(t), depth + 1)
        case types.Kind.Tuple, types.Kind.Record => c.b5aHoldsAny(c.P.T.Items(c.P.T.Parts(t)), depth)
        case types.Kind.Named => c.P.Body(t) and (c.b5aHoldsAny(c.P.T.Items(c.P.T.Fields(t)), depth) or c.b5aHoldsAny(c.P.T.Items(c.P.T.Cases(t)), depth))
        case _ => false
    }
}

fn (c mut Checker&) b5aHoldsAny(ts Array<types.TypeId>&, depth I64) Bool {
    for t in ts {
        if c.b5aHoldsFn(t, depth + 1) { return true }
    }
    return false
}

# E11c: the Str "$" calls rendering a value of type t, or its parts' - the bodies check made for them (wantStr)
fn (c mut Checker&) b5aStr(w mut b5aWalk&, t types.TypeId, depth I64) {
    if depth > 16 or t == types.UnknownT or t == types.TypeId(0) or w.strs.Has(t) { return }
    w.strs.Put(t, true)
    match c.P.T.KindOf(t) {
        case types.Kind.Ref { c.b5aStr(w, c.P.T.Referent(t), depth + 1) }
        case types.Kind.Named {
            for name in String&["Str", "str"] {
                m := c.P.MethodOf(t, c.P.T.Names.Intern(name))
                if m >= 0 {
                    c.b5aFn(w, c.b5aStrBody(m, t))
                    return
                }
            }
            if not c.P.Body(t) { return }
            for f in c.P.T.Items(c.P.T.Fields(t)) { c.b5aStr(w, f, depth + 1) }
            for f in c.P.T.Items(c.P.T.Cases(t)) { c.b5aStr(w, f, depth + 1) }
        }
        case types.Kind.Array { c.b5aStr(w, c.P.T.Elem(t), depth + 1) }
        case types.Kind.Tuple, types.Kind.Record {
            for f in c.P.T.Items(c.P.T.Parts(t)) { c.b5aStr(w, f, depth + 1) }
        }
        nomatch { }
    }
}

# the body of method m's instance for receiver type t, if check made one (strInstance's binding) - -1 for none
fn (c mut Checker&) b5aStrBody(m I64, t types.TypeId) I64 {
    if c.P.FnIsExtern(m) { return -1 }
    owner := generic.FnOwner(m)
    nv := c.P.VarCount(owner)
    if nv == 0 { return try c.fnBodies.Get(c.P.FnInstance(m, types.ListId(0))) catch default -1 }
    ps := c.P.T.Items(c.P.T.Params(c.P.Sig(m)))
    if ps.Len() == 0 { return -1 }
    b := generic.Binding(owner, nv)
    c.unify(ps[0], t, b, false, true)
    c.P.InferThroughBounds(b)
    for v in b.Vals {
        if v == types.UnknownT { return -1 }
    }
    return try c.fnBodies.Get(c.P.FnInstance(m, c.P.T.List(b.Vals))) catch default -1
}

fn (c mut Checker&) b5aBlock(w mut b5aWalk&, bl typed.Block?&) {
    if bl is null { return }
    for st in bl.Stmts { c.b5aStmt(w, st) }
}

fn (c mut Checker&) b5aStmt(w mut b5aWalk&, st typed.Stmt?&) {
    if st is null { return }
    match st {
        case typed.Stmt.Let(_, _, x) { c.b5aExpr(w, x) }
        case typed.Stmt.Assign(_, p, x) {
            c.b5aPlace(w, p)
            c.b5aExpr(w, x)
        }
        case typed.Stmt.Eval(_, x) { c.b5aExpr(w, x) }
        case typed.Stmt.If(_, i) {
            c.b5aExpr(w, i.Test)
            c.b5aBlock(w, i.Then)
            c.b5aBlock(w, i.Else)
        }
        case typed.Stmt.Loop(_, body, post) {
            c.b5aBlock(w, body)
            c.b5aBlock(w, post)
        }
        case typed.Stmt.Return(_, x), typed.Stmt.Suspend(_, x) { c.b5aExpr(w, x) }
        case typed.Stmt.Assert(_, cd, m) {
            c.b5aExpr(w, cd)
            c.b5aExpr(w, m)
        }
        case typed.Stmt.Exit(_, _, m) { c.b5aExpr(w, m) }
        case typed.Stmt.Block(_, b) { c.b5aBlock(w, b) }
        case typed.Stmt.Defer(_, b) { c.b5aBlock(w, b) }
        case typed.Stmt.Join(_, jn) {
            c.b5aBlock(w, jn.Code)
            for cl in jn.Clauses { c.b5aBlock(w, cl.Code) }
        }
        case typed.Stmt.Spawn(_, sp) {
            for p in sp.Targets { c.b5aPlace(w, p) }
            c.b5aExpr(w, sp.Task)
            for cl in sp.Clauses { c.b5aExpr(w, cl.Handler) }
        }
        case typed.Stmt.Yield(_, x) { c.b5aExpr(w, x) }
        case _ { }
    }
}

fn (c mut Checker&) b5aPlace(w mut b5aWalk&, p typed.Lvalue?&) {
    if p is null { return }
    match p {
        case typed.Lvalue.Global(_, ty, mi, n) { c.b5aGlobal(w, mi, n, ty) }
        case typed.Lvalue.Deref(_, _, r) { c.b5aExpr(w, r) }
        case typed.Lvalue.Field(_, _, b, _) { c.b5aPlace(w, b) }
        case typed.Lvalue.Elem(_, _, e) {
            c.b5aPlace(w, e.Base)
            c.b5aExpr(w, e.Index)
        }
        case typed.Lvalue.Payload(_, _, pl) { c.b5aPlace(w, pl.Base) }
        case typed.Lvalue.Temp(_, _, v, _) { c.b5aExpr(w, v) }
        case _ { }
    }
}

fn (c mut Checker&) b5aNamed(w mut b5aWalk&, b I64) {
    if b not in w.named { w.named.Push(b) }
}

fn (c mut Checker&) b5aExpr(w mut b5aWalk&, x typed.Expr?&) {
    if x is null { return }
    match x {
        case typed.Expr.Read(_, _, p, _) { c.b5aPlace(w, p) }
        case typed.Expr.Borrow(_, _, p) { c.b5aPlace(w, p) }
        case typed.Expr.Take(_, _, p) { c.b5aPlace(w, p) }
        case typed.Expr.Promote(_, _, pr) { c.b5aExpr(w, pr.X) }
        case typed.Expr.Call(_, _, cl) {
            match cl.Target {
                case typed.Callee.Body(id) {
                    if not w.namesOnly { c.b5aFn(w, I64(id)) }
                }
                case typed.Callee.Value(v) {
                    if not w.namesOnly { w.through = true }
                    c.b5aExpr(w, v)
                }
                case _ { }
            }
            for a in cl.Args { c.b5aExpr(w, a) }
        }
        case typed.Expr.Make(_, _, m) {
            for a in m.Items { c.b5aExpr(w, a) }
            c.b5aExpr(w, m.Length)
        }
        case typed.Expr.Collect(_, _, cl) {
            c.b5aExpr(w, cl.Reserve)
            c.b5aBlock(w, cl.Loop)
        }
        case typed.Expr.Prim(_, _, _, _, args) {
            for a in args { c.b5aExpr(w, a) }
        }
        case typed.Expr.Slice(_, _, sl) {
            c.b5aPlace(w, sl.Base)
            c.b5aExpr(w, sl.Lo)
            c.b5aExpr(w, sl.Hi)
        }
        case typed.Expr.Cond(_, _, cd) {
            c.b5aExpr(w, cd.C)
            c.b5aExpr(w, cd.A)
            c.b5aExpr(w, cd.B)
        }
        case typed.Expr.Seq(_, _, q) {
            for st in q.Stmts { c.b5aStmt(w, st) }
            c.b5aExpr(w, q.X)
        }
        case typed.Expr.Match(_, _, m) {
            for st in m.Held { c.b5aStmt(w, st) }
            for a in m.Arms { c.b5aArm(w, a) }
            c.b5aArm(w, m.NoMatch)
        }
        case typed.Expr.Try(_, _, t) {
            c.b5aExpr(w, t.X)
            for cl in t.Clauses {
                c.b5aBlock(w, cl.Code)
                for d in cl.Defaults { c.b5aExpr(w, d) }
            }
        }
        case typed.Expr.Fn(_, _, f) {
            match f {
                case typed.FnVal.Named(id) { c.b5aNamed(w, I64(id)) }
                case typed.FnVal.Lambda(id, caps, _) {
                    c.b5aNamed(w, I64(id))
                    for cp in caps { c.b5aExpr(w, cp.Outer) }
                }
                case typed.FnVal.Adapter(id, r, _) {
                    c.b5aNamed(w, I64(id))
                    c.b5aExpr(w, r)
                }
            }
        }
        case typed.Expr.Text(_, _, t) {
            for pc in t.Pieces {
                match pc {
                    case typed.Piece.Render(r) {
                        c.b5aExpr(w, r)
                        if not w.namesOnly { c.b5aStr(w, r.Type(), 0) }
                    }
                    case _ { }
                }
            }
        }
        case typed.Expr.Away(_, _, y) { c.b5aExpr(w, y) }
        case _ { }
    }
}

fn (c mut Checker&) b5aArm(w mut b5aWalk&, a typed.Arm?&) {
    if a is null { return }
    for alt in a.Alts {
        c.b5aExpr(w, alt.Test)
        for bd in alt.Binds { c.b5aExpr(w, bd.From) }
    }
    c.b5aExpr(w, a.Guard)
    c.b5aBlock(w, a.Code)
    c.b5aExpr(w, a.Value)
}

# a global's type: written, or its initializer's (D15) - checked first where it is not known yet
fn (c mut Checker&) globalType(mi I64, n source.NameId) types.TypeId {
    key := pair.Pair(mi, I64(n))
    t := try c.globalTypes.Get(key) catch default types.TypeId(-1)
    if t >= types.TypeId(0) { return t }
    v := c.P.GlobalDecl(mi, n)
    if v is null { return types.UnknownT }
    if v.Ty is not null {
        t = c.P.GlobalStorage(generic.Context(mi, -1), v, n)
        c.globalTypes.Put(key, t)
        return t
    }
    id := try c.globalBodies.Get(key) catch default -1
    # B5a's cycle among globals whose types are their initializers' (D15): said here, where it is met, as orderGlobals
    # says one among typed globals - its type the stand-in, which fits anything
    if id >= 0 and c.state[id] == 1 {
        c.typeCycle(id)
        return types.UnknownT
    }
    c.globalBody(mi, n)
    return try c.globalTypes.Get(key) catch default types.UnknownT
}

# ---- bodies ----

fn (c mut Checker&) check(id I64) {
    c.state[id] = 1
    match c.Bodies[id].Of {
        case typed.BodyOf.Fn(inst) { c.checkFn(id, inst) }
        case typed.BodyOf.Ctor(t, twin) { c.checkCtor(id, t, twin) }
        case typed.BodyOf.Global(mi, n) { c.checkGlobal(id, mi, n) }
        case typed.BodyOf.Dtor(t) { c.checkDtor(id, t) }
        case typed.BodyOf.Thunk(ti, k) { c.checkThunk(id, ti, k) }
        nomatch { }
    }
    c.state[id] = 2
    # D17: its contract checked with it, so what is wrong in it is said whether a call asks for it or not
    match c.Bodies[id].Of {
        case typed.BodyOf.Fn(_), typed.BodyOf.Ctor(_, _) { c.contractChecked(id) }
        nomatch { }
    }
    if c.instanceBody(id) { c.roSettleResults(id) }   # T25c: what its calls' results copy, before a caller asks
}

fn (c mut Checker&) checkFn(id I64, inst I64) {
    f := c.P.InstanceFn(inst)
    fd := c.P.FnDecl(f)
    mi := c.P.FnModule(f)
    sig := c.P.InstanceSig(inst)
    c.P.Asking = generic.Origin(c.P.L.Mods[mi].File, fd.Sp, inst)
    base := c.P.L.Diags.ContextBase(c.P.L.Diags.ContextDepth())
    pushed := c.instContexts(inst)
    fr := c.push(id, mi, c.P.T.Result(sig), c.P.T.Errors(sig))
    fr.Ctx = c.P.FnContext(f, c.P.InstanceArgs(inst))
    # G19: the type instances its signature writes, checked where they are written
    c.paramTypes = not c.P.FnIsExtern(f)
    if fd.Recv is not null { c.writtenMet(fd.Recv!.Ty) }
    for prm in fd.S.Params { c.writtenMet(prm.Ty) }
    c.paramTypes = false
    gen := c.P.IsGenerator(f)
    if fd.S.Results.Len() > 0 {
        for r in fd.S.Results {
            if gen { c.genResultMet(f, r) } else if not c.errorResult(r) { c.writtenMet(r) }
        }
    }
    # D18: a generator fails as its Next does, its errors written in its result
    if gen and fd.S.HasErrors {
        c.err(c.nameSpan(fd), msgs.GenErrors(c.ty(c.P.T.Items(c.P.T.Args(c.P.T.Result(sig)))[0])))
    }
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, fd.Sp)
    ps := c.P.T.Items(c.P.T.Params(sig))
    k I64 = 0
    big := false   # D9c broken: an instance's body is not checked, so a length growing by value asks for no larger one
    if fd.Recv is not null {
        if ps.Len() > 0 {
            c.param(fd.Recv!.Name, fd.Recv!.Sp, ps[0], 0, fd.Recv!.Ty)
            c.mutParam(fd.Recv!.Ty!, ps[0])
            if c.capParam(fd.Recv!, ps[0]) { big = true }
        }
        k = 1
    }
    for prm in fd.S.Params {
        if k < ps.Len() {
            c.param(prm.Name, prm.Sp, ps[k], k, prm.Ty)
            if c.paramWritten(prm, ps[k], true) { big = true }
            # D8a: a literal default fits its parameter where it is written, called without it or not (a null for a
            # reference never null, T2c); a parameter of a type variable's is fitted per call (G18)
            if prm.Dflt is not null and c.P.T.Closed(ps[k]) and c.P.T.Items(c.P.InstanceArgs(inst)).Len() == 0 {
                match prm.Dflt {
                    case ast.Expr.Lit(_, _) { c.exprTo(prm.Dflt!, ps[k]) }
                    nomatch { }
                }
            }
        }
        k++
    }
    c.cur().SetVars(c.P.ScopeVarsOf(sig))
    nr := c.P.T.Result(sig) == types.NoreturnT
    # D8e: a noreturn function declares no errors - an error is a way back to its caller
    if nr and fd.S.HasErrors { c.err(c.noreturnSpan(fd.Sp), msgs.NoreturnErrors()) }
    body := fd.Body
    dropped := big and c.P.T.Items(c.P.InstanceArgs(inst)).Len() > 0
    if dropped { body = Array<ast.Stmt&>(0) }
    if gen and not dropped {
        c.cur().Root = c.genRoot(fd, sig, c.P.GenElem(f))
        c.pop()
        for _ in range pushed { c.P.L.Diags.PopContext() }
        c.P.L.Diags.ContextBase(base)
        return
    }
    root := c.rootStmts(body)
    c.cur().Root = root
    if dropped and fd.Bodied {
    } else if nr {
        if not c.fr().Gapped and not leavesBlock(root) { c.err(c.nameSpan(fd), msgs.NoreturnFallsOff()) }
    } else if c.P.T.Result(sig) != types.VoidT and not c.fr().Gapped and not leavesBlock(root) and not c.P.L.Diags.ErrorWithin(c.fr().File, I64(fd.Sp.Start), I64(fd.Sp.End), c.syntaxMark) {
        c.err(c.nameSpan(fd), msgs.MissingReturn(c.ty(c.P.T.Result(sig))))
    }
    c.pop()
    for _ in range pushed { c.P.L.Diags.PopContext() }
    c.P.L.Diags.ContextBase(base)
}

# G16b: the contexts an instance's body is checked in - where it was asked for, and where each instance asking for it
# was in turn, the outermost first - each "instantiated here, with T = ...": how many were pushed
fn (c mut Checker&) instContexts(inst I64) I64 {
    chain Vec<pair.Pair<generic.Origin, I64>>
    cur := inst
    for _ in range 32 {
        if c.P.T.Items(c.P.InstanceArgs(cur)).Len() == 0 { break }
        o := c.P.InstanceOrigin(cur)
        if o.File < 0 { break }
        chain.Push(pair.Pair(o, cur))
        if o.Within < 0 { break }
        cur = o.Within
    }
    for kk in range chain.Len() {
        e := chain[chain.Len() - 1 - kk]
        c.P.L.Diags.PushContext(diag.Where.Span(e.First.File, I64(e.First.Sp.Start), I64(e.First.Sp.End)), c.instNote(e.Second))
    }
    return chain.Len()
}

# G16b: the contexts a type instance's constructor is checked in - where the instance was asked for, after where the
# instance asking for it was in turn - "instantiated here, with T = String": how many were pushed
fn (c mut Checker&) typeContexts(t types.TypeId, td ast.TypeDecl?&) I64 {
    o := c.P.TypeOrigin(t)
    args := c.P.T.Items(c.P.T.Args(t))
    if o.File < 0 or args.Len() == 0 or td is null or td.Params.Len() == 0 { return 0 }
    pushed := c.instContexts(o.Within) if o.Within >= 0 else 0
    b := StringBuilder()
    b.Push("instantiated here")
    for j in range args.Len() {
        if j >= td.Params.Len() { break }
        b.Push(", with " if j == 0 else ", ")
        b.Push(c.text(td.Params[j].Name))
        b.Push(" = ")
        b.Push(c.ty(args[j]))
    }
    c.P.L.Diags.PushContext(diag.Where.Span(o.File, I64(o.Sp.Start), I64(o.Sp.End)), b.ToString())
    return pushed + 1
}

# the note an instance's context gives, and a type as source writes it, for the passes after checking (G16b, B11)
fn (c mut Checker&) InstNote(inst I64) String { return c.instNote(inst) }

fn (c mut Checker&) Ty(t types.TypeId) String {
    if c.spellIn < 0 or c.frames.Len() > 0 { return c.ty(t) }
    # explain (B11b): as code in that module writes it - another module's type by its alias (os.Error)
    c.push(-1, c.spellIn, types.VoidT, types.ListId(0))
    was := c.spellQualified
    c.spellQualified = true
    r := c.ty(t)
    c.spellQualified = was
    c.pop()
    return r
}

# explain (B11b): the module Ty spells types from, -1 for none
fn (c mut Checker&) SpellFrom(mi I64) { c.spellIn = mi }

# for explain (B11b): a function instance's body (-1 for none); what a body can fail with, its set inferred where its
# signature's is "?" alone (R1a); a global's type; the type text is
fn (c mut Checker&) BodyOfInstance(inst I64) I64 { return try c.fnBodies.Get(inst) catch default -1 }
fn (c mut Checker&) ErrorsOf(body I64) types.ListId { return c.bodyErrors(body) }
fn (c mut Checker&) InfersErrors(sig types.TypeId) Bool { return c.infersErrs(sig) }
fn (c mut Checker&) GlobalType(mi I64, n source.NameId) types.TypeId { return c.globalType(mi, n) }
fn (c mut Checker&) TextType() types.TypeId { return c.textType() }

# the same for a type instance: "instantiated here, with T = I32, N = 6"
fn (c mut Checker&) typeInstNote(t types.TypeId) String {
    b := StringBuilder()
    b.Push("instantiated here")
    owner := generic.DeclOwner(c.P.T.DeclOf(t))
    args := c.P.T.Items(c.P.T.Args(t))
    for j in range args.Len() {
        b.Push(", with " if j == 0 else ", ")
        b.Push(c.text(c.P.VarAt(owner, j).Name))
        b.Push(" = ")
        b.Push(c.ty(args[j]))
    }
    return b.ToString()
}

# "instantiated here, with K = K, V = I32"
fn (c mut Checker&) instNote(inst I64) String {
    b := StringBuilder()
    b.Push("instantiated here")
    owner := generic.FnOwner(c.P.InstanceFn(inst))
    args := c.P.T.Items(c.P.InstanceArgs(inst))
    for j in range args.Len() {
        b.Push(", with " if j == 0 else ", ")
        b.Push(c.text(c.P.VarAt(owner, j).Name))
        b.Push(" = ")
        b.Push(c.ty(args[j]))
    }
    return b.ToString()
}

# where a signature writes "noreturn" (D8e): the word in a declaration's text, after its parameters
fn (c mut Checker&) noreturnSpan(sp source.Span) source.Span {
    t := c.src(sp)
    at := try t.Find(") noreturn") catch default -1
    if at < 0 { return sp }
    return source.Span(sp.Start + I32(at + 2), sp.Start + I32(at + 10))
}

# a parameter as written (D9, D9a, D9c): no "mut" before a value; an array by value only a declared function's, of a
# plain array (G29: an instance per length), and not over D9c's 128 bytes - a bare type variable aside, which any type
# may bind (QP4)
fn (c mut Checker&) paramWritten(prm ast.Param&, t types.TypeId, fnParam Bool = false) Bool {
    c.mutParam(prm.Ty!, t)
    if prm.Ty is not null and not c.namesTypeVar(prm.Ty) and not c.isRef(t) and fnParam and c.P.T.KindOf(t) == types.Kind.Array {
        return c.capParam(prm, t)
    }
    big := false
    if c.P.T.KindOf(t) != types.Kind.Array { big = c.capParam(prm, t) }
    if prm.Ty is not null and not c.namesTypeVar(prm.Ty) and not c.isRef(t) and c.P.T.KindOf(c.under(t)) == types.Kind.Array {
        nsp := source.Span(prm.Sp.Start, prm.Sp.Start + I32(c.text(prm.Name).Len()))
        c.byValSaid.Put(pair.Pair(c.fr().File, I64(prm.Sp.Start)), true)
        c.err(nsp, msgs.ArrayParamByValue(c.tok(prm.Name), c.src(prm.Ty!.Span()))) # as written: a variable bare (G8b)
    }
    return big
}

# D9c: a by-value parameter written as an aggregate - a struct, an enum, an array - holds at most 128 bytes, its size
# known where it is laid out (an instance's, an instantiation's); a bare type variable is not covered (QP4). Reported
# once for a parameter, by the first instance breaking it; whether this one breaks it
fn (c mut Checker&) capParam(prm ast.Param&, t types.TypeId) Bool {
    if prm.Ty is null or c.namesTypeVar(prm.Ty) or c.isRef(t) or not c.P.T.Closed(t) { return false }
    k := c.P.T.KindOf(t)
    if k != types.Kind.Array and not (c.isStruct(t) or c.isEnum(t)) { return false }
    if not c.P.Layout(t) { return false }
    n := c.P.T.Size(t)
    if n <= 128 { return false }
    key := pair.Pair(c.fr().File, I64(prm.Sp.Start))
    if try c.capSaid.Get(key) catch default false { return true }
    c.capSaid.Put(key, true)
    nsp := source.Span(prm.Sp.Start, prm.Sp.Start + I32(c.text(prm.Name).Len()))
    c.err(nsp, msgs.ParamTooLarge(c.tok(prm.Name), n, c.src(prm.Ty!.Span())))
    return true
}

# D9: a by-value parameter is the callee's own copy - "mut" is for a reference (only on the generic's own check: an
# instance binds T, which says nothing of what was written)
fn (c mut Checker&) mutParam(tr ast.TypeRef&, t types.TypeId) {
    msp := c.mutBefore(tr, t)
    if msp.Start >= 0 { c.err(msp, msgs.MutOnValueParam(c.ty(t))) }
}

fn (c mut Checker&) param(n source.NameId, sp source.Span, t types.TypeId, i I64, tr ast.TypeRef?& = null) {
    mark := c.cur().ParamMark(c.P.T, i)
    id := c.local(n, sp, t, typed.LocalKind.Param, mark)
    c.cur().Params.Push(typed.LocalId(I32(id)))
    if tr is not null { c.fr().typeAt.Put(id, c.typeWrittenAt(tr)) }
}

# a function's name's span: after "fn" and its receiver, the first place its name is written
# where function f's name is written, in its own module
fn (c mut Checker&) fnNameAt(f I64) diag.Where {
    fd := c.P.FnDecl(f)
    mi := c.P.FnModule(f)
    text := c.P.L.Mods[mi].Src!.Text
    name := c.text(fd.Name)
    from := I64(fd.Recv!.Sp.End) if fd.Recv is not null else I64(fd.Sp.Start) + 2
    at := try text[from:I64(fd.Sp.End)].Find(name) catch default -1
    s := I64(fd.Sp.Start) if at < 0 else from + at
    return diag.Where.Span(c.P.L.Mods[mi].File, s, s + name.Len())
}

fn (c mut Checker&) nameSpan(fd ast.Func&) source.Span {
    text := c.src(fd.Sp)
    name := c.text(fd.Name)
    from I64 = 2
    if fd.Recv is not null { from = I64(fd.Recv!.Sp.End - fd.Sp.Start) }
    if from < 0 or from > text.Len() { from = 0 }
    at := try text[from:].Find(name) catch default -1
    if at < 0 { return fd.Sp }
    s := fd.Sp.Start + I32(from + at)
    return source.Span(s, s + I32(name.Len()))
}

# a constructor's body (C2): its parameters, then its statements, every field declaration one of its Fields
fn (c mut Checker&) checkCtor(id I64, t types.TypeId, twin types.ListId) {
    # B11, G16b: an instance's constructor is checked where it was asked for - what it meets in the library reported at
    # the program's use
    o := c.P.TypeOrigin(t)
    pushed := o.File >= 0 and c.P.T.KindOf(t) == types.Kind.Named and c.P.T.Args(t) != types.ListId(0)
    if pushed { c.P.L.Diags.PushContext(diag.Where.Span(o.File, I64(o.Sp.Start), I64(o.Sp.End)), c.typeInstNote(t)) }
    c.ctorChecked(id, t, twin)
    if pushed { c.P.L.Diags.PopContext() }
}

fn (c mut Checker&) ctorChecked(id I64, t types.TypeId, twin types.ListId) {
    d := c.P.T.DeclOf(t)
    td := c.P.TypeDecl(d)
    mi := c.P.T.DeclModule(d)
    sig := c.Bodies[id].Ty
    fr := c.push(id, mi, types.VoidT, c.P.T.Errors(sig))
    fr.Ctx = c.P.CtorContext(t, twin)
    fr.InCtor = true
    fr.CtorOf = t
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, source.Span(0, 0))
    if td is not null and td.Body is not null {
        match td.Body {
            case ast.TypeBody.Struct(s) {
                ps := c.P.T.Items(c.P.T.Params(sig))
                if s.Params.Len() > 0 {
                    for i in range s.Params.Len() {
                        if i < ps.Len() {
                            c.param(s.Params[i].Name, s.Params[i].Sp, ps[i], i, s.Params[i].Ty)
                            c.paramWritten(s.Params[i], ps[i])
                        }
                    }
                }
                c.cur().SetVars(c.P.ScopeVarsOf(sig))
                if c.P.T.Items(c.P.T.Args(t)).Len() > 0 { c.instHoldsItself(t, d, s) }
                pushed := c.typeContexts(t, td)   # G16b: an instance's with where it was asked for
                root := c.rootStmts(s.Body)
                c.cur().Root = root
                c.fieldTypes(t)
                for _ in range pushed { c.P.L.Diags.PopContext() }
                if s.DtorSp.End > 0 {
                    c.pop()
                    c.dtorBody(t, mi)
                    return
                }
            }
            case ast.TypeBody.Over(bref, ctor) {
                # T29d: its one parameter the value, which the body may check or change; its final value the result -
                # the body's one field
                ps := c.P.T.Items(c.P.T.Params(sig))
                one := ctor is not null and ctor.S.Params.Len() > 0 and ctor.S.Params.Len() == 1 and ps.Len() == 1
                if ctor is not null and not one {
                    c.err(source.Span(ctor.Sp.Start, ctor.Sp.Start + 1), msgs.PrimCtorParam(c.ty(c.resolve(bref))))
                } else if one {
                    pr := ctor!.S.Params[0]
                    c.param(pr.Name, pr.Sp, ps[0], 0, pr.Ty)
                    c.cur().SetVars(c.P.ScopeVarsOf(sig))
                    root := c.rootStmts(ctor!.Body)
                    c.cur().Root = root
                    c.cur().Fields.Push(c.cur().Params[0])
                } else {
                    c.gap(source.Span(0, 0), "a declared number's constructor of this shape (T29d)")
                }
            }
            nomatch { c.gap(source.Span(0, 0), "a constructor of this kind") }
        }
    }
    c.pop()
}

# a ":=" field the declaration could not type without the checker (generic.Infer: a call, a member read) takes the type
# its initializer was checked to have (D15), so the type's layout and what it holds see it
fn (c mut Checker&) fieldTypes(t types.TypeId) {
    fs := c.P.T.Items(c.P.T.Fields(t))
    ls := c.cur().Fields
    if fs.Len() != ls.Len() { return }
    out := Array<types.TypeId>(fs.Len())
    filled := false
    for i in range fs.Len() {
        out[i] = fs[i]
        lt := c.cur().Locals[I64(ls[i])].Ty
        if fs[i] == types.UnknownT and lt != types.UnknownT {
            out[i] = lt
            filled = true
        }
    }
    if filled { c.P.T.SetStructBody(t, c.P.T.List(out), c.P.T.Destructs(t)) }
}

# a type's destructor's body (C9), made once its constructor is checked: a function of "mut T&" in the scope closing
fn (c mut Checker&) dtorBody(t types.TypeId, mi I64) I64 {
    for i in range c.Bodies.Len() {
        match c.Bodies[i].Of {
            case typed.BodyOf.Dtor(u) {
                if u == t { return i }
            }
            nomatch { }
        }
    }
    ty := c.P.T.Func(c.P.T.List1(c.P.T.Ref(t, types.Writable)), types.VoidT, types.ListId(0)
                     c.P.T.Scopes(types.RoleDtor, I64[types.OwnScope], Array<I64>(0)))
    return c.newBody(typed.BodyOf.Dtor(t), ty, mi, source.Span(0, 0))
}

fn (c mut Checker&) checkDtor(id I64, t types.TypeId) {
    d := c.P.T.DeclOf(t)
    td := c.P.TypeDecl(d)
    mi := c.P.T.DeclModule(d)
    fr := c.push(id, mi, types.VoidT, types.ListId(0))
    fr.Ctx = c.P.InstanceContext(t)
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, source.Span(0, 0))
    ps := c.P.T.Items(c.P.T.Params(c.cur().Ty))
    inst := c.local(source.NameId(0), source.Span(0, 0), ps[0], typed.LocalKind.Param, typed.Mark.Bare)
    c.cur().Params.Push(typed.LocalId(I32(inst)))
    c.fr().Inst = inst
    c.cur().SetVars(c.P.ScopeVarsOf(c.cur().Ty))
    root typed.Block?&c = null
    match td!.Body {
        case ast.TypeBody.Struct(s) {
            c.cur().Sp = s.DtorSp
            if s.Dtor.Len() == 0 {
                # C7a: a destructor releases something
                at := try c.src(s.DtorSp).Find("{") catch default 0
                c.err(source.Span(s.DtorSp.Start + I32(at), s.DtorSp.Start + I32(at + 1)), msgs.EmptyDestructor())
            }
            root = c.rootStmts(s.Dtor)
        }
        nomatch { root = typed.Block(typed.BlockId(0), Array<typed.Stmt&>(0)) }
    }
    c.cur().Root = root
    c.pop()
}

# a field of a destructor's instance named bare (C10); null where n is none of them
fn (c mut Checker&) instField(sp source.Span, n source.NameId) typed.Lvalue?&c {
    inst := c.fr().Inst
    if inst < 0 { return null }
    it := c.localType(inst)
    base := typed.Lvalue.Deref(sp, c.P.T.Referent(it), c.readLocal(sp, inst))
    return c.field(sp, sp, base, n)
}

fn (c mut Checker&) checkGlobal(id I64, mi I64, n source.NameId) {
    v := c.P.GlobalDecl(mi, n)
    key := pair.Pair(mi, I64(n))
    fr := c.push(id, mi, types.VoidT, types.ListId(0))
    fr.Ctx = generic.Context(mi, -1)
    sp := c.cur().Sp
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    if v is null {
        c.globalTypes.Put(key, types.UnknownT)
        c.cur().Root = typed.Block(typed.BlockId(0), Array<typed.Stmt&>(0))
        c.pop()
        return
    }
    k I64 = 0
    for i in range v.Names.Len() {
        if v.Names[i] == n { k = i }
    }
    want := types.UnknownT
    if v.Ty is not null {
        want = c.resolve(v.Ty)
        if want != types.UnknownT { want = c.P.GlobalStorage(generic.Context(mi, -1), v, n) }   # T7d
    }
    from := c.stmts.Len()
    x typed.Expr?&c = null
    if v.Hidden and k < v.Values.Len() {
        # G39: an attribute's value - a type written bare its constructor called with no arguments ("@json.Skip")
        ax := c.attrCall(v.Values[k])
        x = c.attrExpr(ax)
        want = c.inferred(ax, x, true)
        if want != types.UnknownT and not c.attrTypeOk(want) { c.err(ax.Span(), msgs.AttrType(c.ty(want))) }
    } else if k < v.Values.Len() {
        x = c.exprTo(v.Values[k], want)
        if v.Ty is null { want = c.inferred(v.Values[k], x, true) }
        # B10c: a build constant's default, which -D's value replaces - fitted to its type as a literal written there
        if c.buildDefaulted(mi, n, v) and want != types.UnknownT {
            d := c.defineValue(sp, n, want)
            if d is not null { x = d }
        }
        # T25c: a mutable global is stored where it can be written
        if writtenMut(v.Ty) and not c.isRef(want) { c.roStore(x, v.Values[k].Span(), RoGlobal) }
    } else if v.Values.Len() == 1 and v.Names.Len() > 1 {
        c.gap(sp, "several globals given one value (D8c)")
    } else {
        # D13e: a value given below, in a top-level if's branch this build takes - its initializer, no zero first
        set := c.topSetOf(mi, n, sp)
        if set is not null {
            x = c.exprTo(set, want)
            if writtenMut(v.Ty) and not c.isRef(want) { c.roStore(x, set.Span(), RoGlobal) }
        } else {
            # its zero value - none said where top-level ifs assign it, whose branches say what is missing (D13e)
            dg := c.P.L.Diags
            g := dg.Hold()
            zmark := dg.Count()
            x = c.zero(sp, want)
            dg.EndHold()
            if dg.Count() > zmark and c.topSetAnywhere(mi, n) { dg.Drop(g) } else { dg.Choose(g) }
            c.askValue(ValueKind.Zero, sp, want, null)
        }
    }
    c.globalTypes.Put(key, want)
    if x is not null {
        if want == c.textType() and c.isRef(x!.Type()) { x = c.read(sp, typed.Lvalue.Deref(sp, want, x!)) }
        c.stmts.Push(typed.Stmt.Assign(sp, typed.Lvalue.Global(sp, want, mi, n), x!))
    }
    c.cur().Root = typed.Block(typed.BlockId(0), gather(c.stmts, from))
    c.pop()
}

# ---- attributes (G39) ----

# an attribute's value as written: a type named bare is its constructor called with no arguments ("@json.Skip"), an
# enum's case written bare its value ("@Level.High")
fn (c mut Checker&) attrCall(x ast.Expr&c) ast.Expr&c {
    named := false
    match x {
        case ast.Expr.Name(_, _), ast.Expr.Member(_, _, _) { named = c.typeNamed(x) >= types.TypeId(0) }
        case ast.Expr.Generic(_, g, _) { named = c.genericNamed(g) >= types.DeclId(0) }
        nomatch { }
    }
    if not named { return x }
    return ast.Expr.Call(x.Span(), x, Array<ast.Expr&>(0))
}

# an attribute's value checked (G39): what it can fail with - a constructor's requirement (D17), say - ends its
# building as "!" would, an error where it is built while compiling
fn (c mut Checker&) attrExpr(y ast.Expr&) typed.Expr&c {
    fr := c.fr()
    mark := fr.leaks.Len()
    before := fr.Fallible
    fr.Tries++
    x := c.expr(y, types.UnknownT)
    fr.Tries--
    covered := fr.Fallible != before
    fr.Fallible = before
    if not covered { return x }
    fr.leaks.Truncate(mark)
    return typed.Expr.Try(y.Span(), typeOf(x), typed.Try(x, Array<typed.Clause&>(0), true))
}

# whether a type is one an attribute may be (G39): a struct, an enum or a declared number type a program declares - a
# built-in type, the prelude's included (String, Vec), says nothing of what the attribute means
fn (c mut Checker&) attrTypeOk(t types.TypeId) Bool {
    if not c.isNamed(t) { return false }
    d := c.P.T.DeclOf(t)
    if c.P.L.Mods[c.P.T.DeclModule(d)].Identity.StartsWith("std/prelude") { return false }
    k := c.P.T.DeclKindOf(d)
    if k == types.DeclKind.Struct or k == types.DeclKind.Enum { return true }
    return k == types.DeclKind.Over and c.isNumber(t)
}

# a declaration's attributes (G39): each checked as its global is, at most one of each type
fn (c mut Checker&) attrsChecked(mi I64, attrs Array<ast.Attr&>&) {
    if attrs.Len() == 0 { return }
    seen Vec<types.TypeId>
    for a in attrs {
        t := c.globalType(mi, a.Global)
        if t == types.UnknownT { continue }
        for s in seen {
            if c.P.T.Same(s, t) {
                c.push(-1, mi, types.VoidT, types.ListId(0))
                c.err(a.Sp, msgs.AttrTwice(c.ty(t)))
                c.pop()
            }
        }
        seen.Push(t)
    }
}

# every attribute a declaration's parts carry (G39): a type's, its constructor's parameters' and fields', its cases'
# and their fields'; a function's and its parameters'
fn (c mut Checker&) declAttrs(mi I64, d ast.Decl&) {
    match d {
        case ast.Decl.Type(_, td) {
            c.attrsChecked(mi, td.Attrs)
            if td.Body is null { return }
            match td.Body! {
                case ast.TypeBody.Struct(sb) {
                    for prm in sb.Params { c.attrsChecked(mi, prm.Attrs) }
                    for st in sb.Body {
                        match st {
                            case ast.Stmt.Var(_, v) { c.attrsChecked(mi, v.Attrs) }
                            nomatch { }
                        }
                    }
                }
                case ast.TypeBody.Enum(cases, _) {
                    for cd in cases {
                        c.attrsChecked(mi, cd.Attrs)
                        for prm in cd.Payload { c.attrsChecked(mi, prm.Attrs) }
                    }
                }
                case ast.TypeBody.Over(_, ctor) {
                    if ctor is not null {
                        for prm in ctor.S.Params { c.attrsChecked(mi, prm.Attrs) }
                    }
                }
                nomatch { }
            }
        }
        case ast.Decl.Fn(f) {
            c.attrsChecked(mi, f.Attrs)
            for prm in f.S.Params { c.attrsChecked(mi, prm.Attrs) }
        }
        nomatch { }
    }
}

# what "x.Attr<A>()" reads the attributes of (G40): the descriptor x is, or the type it names; -1 for neither, Unknown
# where that was said wrong
fn (c mut Checker&) attrHolder(x ast.Expr&) types.TypeId {
    dt := c.descTypeOf(x)
    if dt >= types.TypeId(0) { return dt }
    return c.reflType(x)
}

# the attribute of type a written on what holder names (G40): its module and its hidden global's name, -1 for none
fn (c mut Checker&) attrFound(holder types.TypeId, a types.TypeId) I64, source.NameId {
    mi, attrs := c.P.AttrsOf(holder)
    if mi < 0 { return -1, source.NameId(0) }
    for at in attrs {
        t := c.globalType(mi, at.Global)
        if c.P.T.Same(t, a) or c.P.T.Same(c.P.Held(a), t) { return mi, at.Global }
    }
    return -1, source.NameId(0)
}

# "x.Attr<A>()" and "x.HasAttr<A>()" (G40) - null where g reads no attribute: x is no type and no descriptor
fn (c mut Checker&) attrRead(sp source.Span, g ast.Expr&, targs Array<ast.TypeRef&>&, args Array<ast.Expr&>&) typed.Expr?&c {
    x, name, nsp := c.attrCallee(g)
    if name == "" { return null }
    holder := c.attrHolder(x)
    if holder < types.TypeId(0) { return null }
    if holder == types.UnknownT or targs.Len() != 1 or args.Len() != 0 {
        if holder != types.UnknownT { c.err(nsp, msgs.AttrRead(name)) }
        c.dropArgs(args)
        return c.unknown(sp)
    }
    a := c.resolve(targs[0])
    if a == types.UnknownT { return c.unknown(sp) }
    mi, gn := c.attrFound(holder, a)
    if name == "HasAttr" { return c.lit(sp, types.BoolT, 1 if mi >= 0 else 0) }
    if mi < 0 { return c.invoke(sp, nsp, c.P.PreludeFn("std/prelude/reflect", "attrMissing"), null, Array<ast.Expr&>(0), Array<typed.Expr&>(0), Array<types.TypeId>(1, a)) }
    v := c.read(sp, typed.Lvalue.Global(sp, c.globalType(mi, gn), mi, gn))
    return c.invoke(sp, nsp, c.P.PreludeFn("std/prelude/reflect", "attrGot"), null, Array<ast.Expr&>(0), typed.Expr&[v])
}

# the receiver and the name of "x.Attr" or "x.HasAttr" (G40), "" for another
fn (c mut Checker&) attrCallee(g ast.Expr&) ast.Expr&g, String, source.Span {
    match g {
        case ast.Expr.Member(msp, x, n) {
            name := c.text(n)
            if name == "Attr" or name == "HasAttr" { return x, $name, memberSpan(msp, name.Len()) }
            return g, "", msp
        }
        nomatch { return g, "", g.Span() }
    }
}

# ---- a global's value given below it (D13e) ----

# the value a top-level assignment in the branches this build takes gives global n of module mi, declared at sp - the
# first, where (wrongly, said by topSets) there are several; null for none
fn (c mut Checker&) topSetOf(mi I64, n source.NameId, sp source.Span) ast.Expr?&c {
    return c.topSetIn(mi, c.P.L.Mods[mi].Decls, n, sp, false)
}

fn (c mut Checker&) topSetIn(mi I64, ds Array<ast.Decl&>&, n source.NameId, sp source.Span, inIf Bool) ast.Expr?&c {
    if ds.Len() == 0 { return null }
    for d in ds {
        match d {
            case ast.Decl.Set(ssp, t, v) {
                if inIf and ssp.Start > sp.Start and setName(t) == n { return v }
            }
            case ast.Decl.If(_, ti) {
                x := c.topSetChain(mi, ti, n, sp, c.P.L.Chosen(mi, ti.Cond!.Span().Start), 0)
                if x is not null { return x }
            }
            nomatch { }
        }
    }
    return null
}

fn (c mut Checker&) topSetChain(mi I64, ti ast.TopIf&, n source.NameId, sp source.Span, chosen I64, index I64) ast.Expr?&c {
    if chosen == index and ti.Then is not null { return c.topSetIn(mi, ti.Then!.Decls, n, sp, true) }
    if ti.ElseIf is not null { return c.topSetChain(mi, ti.ElseIf!, n, sp, chosen, index + 1) }
    if ti.Else is not null and chosen == index + 1 { return c.topSetIn(mi, ti.Else!.Decls, n, sp, true) }
    return null
}

# whether any top-level if of module mi assigns global n in any branch, decided or not
fn (c mut Checker&) topSetAnywhere(mi I64, n source.NameId) Bool { return setsName(c.P.L.Mods[mi].Decls, n) }

fn setsName(ds Array<ast.Decl&>&, n source.NameId) Bool {
    if ds.Len() == 0 { return false }
    for d in ds {
        match d {
            case ast.Decl.Set(_, t, _) { if setName(t) == n: return true }
            case ast.Decl.If(_, ti) { if chainSets(ti, n): return true }
            nomatch { }
        }
    }
    return false
}

fn chainSets(ti ast.TopIf&, n source.NameId) Bool {
    if ti.Then is not null and setsName(ti.Then!.Decls, n) { return true }
    if ti.ElseIf is not null and chainSets(ti.ElseIf!, n) { return true }
    return ti.Else is not null and setsName(ti.Else!.Decls, n)
}

# whether every path through a branch's declarations assigns global n: an assignment of it, or an if every branch of
# which does (a missing else a branch that does not)
fn assignsAll(ds Array<ast.Decl&>&, n source.NameId) Bool {
    if ds.Len() == 0 { return false }
    for d in ds {
        match d {
            case ast.Decl.Set(_, t, _) { if setName(t) == n: return true }
            case ast.Decl.If(_, ti) { if chainAssignsAll(ti, n): return true }
            nomatch { }
        }
    }
    return false
}

fn chainAssignsAll(ti ast.TopIf&, n source.NameId) Bool {
    if ti.Then is null or not assignsAll(ti.Then!.Decls, n) { return false }
    if ti.ElseIf is not null { return chainAssignsAll(ti.ElseIf!, n) }
    return ti.Else is not null and assignsAll(ti.Else!.Decls, n)
}

# the global a top-level assignment names - 0 where its target is no name
fn setName(t ast.Expr&) source.NameId {
    return match t {
        case ast.Expr.Name(_, n) => n
        case _ => source.NameId(0)
    }
}

# D13e, for module mi once its globals are checked: every top-level assignment inside a top-level if, of a global of the
# module declared above it with no value; at most one in the branches this build takes; every branch of an if
# assigning a global with no zero value assigning it; and no condition reading the global its if assigns
fn (c mut Checker&) topSets(mi I64) {
    taken Map<source.NameId, Bool>
    c.topSetDecls(mi, c.P.L.Mods[mi].Decls, false, true, taken)
}

fn (c mut Checker&) topSetDecls(mi I64, ds Array<ast.Decl&>&, inIf Bool, live Bool, taken mut Map<source.NameId, Bool>&) {
    if ds.Len() == 0 { return }
    file := c.P.L.Mods[mi].File
    d := c.P.L.Diags
    for x in ds {
        match x {
            case ast.Decl.Set(sp, t, _) {
                at := diag.Where.Span(file, I64(sp.Start), I64(sp.End))
                if not inIf {
                    d.Error(at, msgs.TopSetPlace())
                    continue
                }
                n := setName(t)
                g := c.P.GlobalDecl(mi, n) if n != source.NameId(0) else null
                tsp := t.Span()
                if g is null {
                    d.Error(diag.Where.Span(file, I64(tsp.Start), I64(tsp.End)), msgs.TopSetTarget(c.src2(file, tsp)))
                    continue
                }
                k I64 = -1
                for i in range g.Names.Len() {
                    if g.Names[i] == n { k = i }
                }
                if k < 0 or g.NameSps[k].Start > sp.Start {
                    d.Error(diag.Where.Span(file, I64(tsp.Start), I64(tsp.End)), msgs.TopSetTarget(c.src2(file, tsp)))
                    continue
                }
                if k < g.Values.Len() {
                    d.Error(diag.Where.Span(file, I64(tsp.Start), I64(tsp.End)), msgs.TopSetHasValue(c.text(n)))
                    continue
                }
                if live {
                    if taken.Has(n) { d.Error(at, msgs.TopSetTwice(c.text(n))) }
                    taken.Put(n, true)
                }
            }
            case ast.Decl.If(_, ti) {
                c.topSetIf(mi, ti, ti, inIf, live, c.P.L.Chosen(mi, ti.Cond!.Span().Start), 0, taken)
            }
            nomatch { }
        }
    }
}

# an if's chain: each branch's assignments, those of the branch this build takes counted as taken; then, at the chain's
# head, each global it assigns read by none of its conditions and - its type having no zero value - assigned by every
# branch
fn (c mut Checker&) topSetIf(mi I64, head ast.TopIf&, ti ast.TopIf&, inIf Bool, live Bool, chosen I64, index I64
                             taken mut Map<source.NameId, Bool>&) {
    if ti.Then is not null { c.topSetDecls(mi, ti.Then!.Decls, true, live and chosen == index, taken) }
    if ti.ElseIf is not null {
        c.topSetIf(mi, head, ti.ElseIf!, inIf, live, chosen, index + 1, taken)
    } else if ti.Else is not null {
        c.topSetDecls(mi, ti.Else!.Decls, true, live and chosen == index + 1, taken)
    }
    if head != ti { return }
    set Vec<source.NameId>
    chainNames(head, set)
    if set.Len() == 0 { return }
    file := c.P.L.Mods[mi].File
    d := c.P.L.Diags
    for n in set {
        # a condition reading the value its own if gives (D13e)
        k := head
        for {
            if k.Cond is not null and c.condReads(file, k.Cond!.Span(), c.text(n)) {
                csp := k.Cond!.Span()
                d.Error(diag.Where.Span(file, I64(csp.Start), I64(csp.End)), msgs.TopSetCondReads(c.text(n)))
            }
            if k.ElseIf is null { break }
            k = k.ElseIf!
        }
        g := c.P.GlobalDecl(mi, n)
        if g is null { continue }
        t := try c.globalTypes.Get(pair.Pair(mi, I64(n))) catch default types.UnknownT
        if t == types.UnknownT or c.hasZero(mi, t) { continue }
        c.branchesAssign(file, head, n, t)
    }
}

# every global some branch of an if's chain assigns, directly or in an if inside it
fn chainNames(ti ast.TopIf&, out mut Vec<source.NameId>&) {
    if ti.Then is not null { declNames(ti.Then!.Decls, out) }
    if ti.ElseIf is not null { chainNames(ti.ElseIf!, out) }
    if ti.Else is not null { declNames(ti.Else!.Decls, out) }
}

fn declNames(ds Array<ast.Decl&>&, out mut Vec<source.NameId>&) {
    if ds.Len() == 0 { return }
    for d in ds {
        match d {
            case ast.Decl.Set(_, t, _) {
                n := setName(t)
                if n != source.NameId(0) and not hasName(out, n) { out.Push(n) }
            }
            case ast.Decl.If(_, ti) { chainNames(ti, out) }
            nomatch { }
        }
    }
}

# D13e: each branch of an if's chain not assigning n said - one holding an if that assigns it on some branch is that
# if's to say; a missing else said at the chain's last condition
fn (c mut Checker&) branchesAssign(file I64, ti ast.TopIf&, n source.NameId, t types.TypeId) {
    d := c.P.L.Diags
    if ti.Then is not null and not assignsAll(ti.Then!.Decls, n) and not nestedSets(ti.Then!.Decls, n) {
        sp := ti.Then!.Sp
        d.Error(diag.Where.Span(file, I64(sp.Start), I64(sp.Start) + 1), msgs.TopSetMissing(c.text(n), c.ty(t)))
    }
    if ti.Then is not null { c.nestedBranches(file, ti.Then!.Decls, n, t) }
    if ti.ElseIf is not null {
        c.branchesAssign(file, ti.ElseIf!, n, t)
        return
    }
    if ti.Else is null {
        csp := ti.Cond!.Span()
        d.Error(diag.Where.Span(file, I64(csp.Start), I64(csp.End)), msgs.TopSetNoElse(c.text(n), c.ty(t)))
        return
    }
    if not assignsAll(ti.Else!.Decls, n) and not nestedSets(ti.Else!.Decls, n) {
        sp := ti.Else!.Sp
        d.Error(diag.Where.Span(file, I64(sp.Start), I64(sp.Start) + 1), msgs.TopSetMissing(c.text(n), c.ty(t)))
    }
    c.nestedBranches(file, ti.Else!.Decls, n, t)
}

# the ifs inside a branch assigning n where no assignment of the branch's own covers every path: each judged as its own
fn (c mut Checker&) nestedBranches(file I64, ds Array<ast.Decl&>&, n source.NameId, t types.TypeId) {
    if ds.Len() == 0 or directSet(ds, n) { return }
    for d in ds {
        match d {
            case ast.Decl.If(_, ti) {
                if chainSets(ti, n) and not chainAssignsAll(ti, n) { c.branchesAssign(file, ti, n, t) }
            }
            nomatch { }
        }
    }
}

fn hasName(xs Vec<source.NameId>&, n source.NameId) Bool {
    for x in xs {
        if x == n { return true }
    }
    return false
}

fn directSet(ds Array<ast.Decl&>&, n source.NameId) Bool {
    for d in ds {
        match d {
            case ast.Decl.Set(_, t, _) { if setName(t) == n: return true }
            nomatch { }
        }
    }
    return false
}

# whether an if inside a branch assigns n on some branch - then what is missing is said there
fn nestedSets(ds Array<ast.Decl&>&, n source.NameId) Bool {
    if ds.Len() == 0 { return false }
    for d in ds {
        match d {
            case ast.Decl.If(_, ti) { if chainSets(ti, n): return true }
            nomatch { }
        }
    }
    return false
}

# whether a condition's text names a global - the name as a whole word, not a member after a dot nor in a literal
fn (c mut Checker&) condReads(file I64, sp source.Span, name String&) Bool {
    text := c.P.L.Diags.TextOf(file)
    t := text[I64(sp.Start):I64(sp.End)]
    i I64 = 0
    quoted := false
    for i < t.Len() {
        ch := t[i]
        if ch == '"' { quoted = not quoted }
        if not quoted and i + name.Len() <= t.Len() and t[i:i + name.Len()] == name {
            before := i == 0 or not (t[i - 1].IsLetter() or t[i - 1].IsDigit() or t[i - 1] == '_' or t[i - 1] == '.')
            j := i + name.Len()
            after := j >= t.Len() or not (t[j].IsLetter() or t[j].IsDigit() or t[j] == '_')
            if before and after { return true }
        }
        i++
    }
    return false
}

# whether a type has a zero value (D13c): its zero made with what it says held back and forgotten - a constructor with
# an effect (decided by evaluation, after) counting as one
fn (c mut Checker&) hasZero(mi I64, t types.TypeId) Bool {
    dg := c.P.L.Diags
    c.push(-1, mi, types.VoidT, types.ListId(0))
    g := dg.Hold()
    mark := dg.Count()
    gaps := c.Gaps.Len()
    was := c.asking
    c.asking = true
    c.zero(source.Span(0, 0), t)
    c.asking = was
    dg.EndHold()
    ok := dg.Count() == mark
    dg.Forget(mark)
    dg.Drop(g)
    c.Gaps.Truncate(gaps)
    c.pop()
    return ok
}

# a span of a file's text, as a message quotes it
fn (c mut Checker&) src2(file I64, sp source.Span) String { return $c.P.L.Diags.TextOf(file)[I64(sp.Start):I64(sp.End)] }

# a body's outermost block, its parameters already in it: its statements
fn (c mut Checker&) rootStmts(body Array<ast.Stmt&>&) typed.Block&c {
    from := c.stmts.Len()
    c.entryChecks()
    storedIn(body, c.fr().stored)
    if body.Len() > 0 {
        c.stmtsOf(body)
    }
    return typed.Block(typed.BlockId(0), gather(c.stmts, from))
}

# T7d: the names statements assign as a whole - a "=" or compound assignment, a target of several or of a spawn -
# anywhere in them, nested blocks and the statements of catch clauses and match values included, lambdas' own aside (a
# lambda's frame scans its own body). A local so named keeps its length beside its storage, known only at run time
fn storedIn(body Array<ast.Stmt&>&, out mut Map<source.NameId, Bool>&) {
    if body.Len() == 0 { return }
    for st in body { storedStmt(st, out) }
}

fn storedTarget(x ast.Expr&, out mut Map<source.NameId, Bool>&) {
    match x {
        case ast.Expr.Name(_, n) { out.Put(n, true) }
        case ast.Expr.Paren(_, y) { storedTarget(y, out) }
        nomatch { storedExpr(x, out) }
    }
}

fn storedStmt(st ast.Stmt?&, out mut Map<source.NameId, Bool>&) {
    if st is null { return }
    match st {
        case ast.Stmt.ExprS(_, x) { storedExpr(x, out) }
        case ast.Stmt.Var(_, v) { storedExprs(v.Values, out) }
        case ast.Stmt.Multi(_, m) {
            if not m.Define {
                for t in m.Targets { storedTarget(t, out) }
            }
            storedExprs(m.Values, out)
        }
        case ast.Stmt.Assign(_, _, t, v) {
            storedTarget(t, out)
            storedExpr(v, out)
        }
        case ast.Stmt.TryStore(_, inner, cs) {
            storedStmt(inner, out)
            storedCatches(cs, out)
        }
        case ast.Stmt.If(_, i) { storedIf(i, out) }
        case ast.Stmt.Forever(_, b), ast.Stmt.Block(_, b) { storedIn(b, out) }
        case ast.Stmt.While(_, k, b), ast.Stmt.DoFor(_, b, k) {
            storedExpr(k, out)
            storedIn(b, out)
        }
        case ast.Stmt.For3(_, f) {
            storedStmt(f.Init, out)
            storedExpr(f.Cond, out)
            storedStmt(f.Post, out)
            storedIn(f.Body, out)
        }
        case ast.Stmt.ForIn(_, f) {
            storedExpr(f.Source, out)
            storedIn(f.Body, out)
            storedCatches(f.Clauses, out)
        }
        case ast.Stmt.MatchS(_, m) { storedMatch(m, out) }
        case ast.Stmt.Return(_, xs) { storedExprs(xs, out) }
        case ast.Stmt.Become(_, x) { storedExpr(x, out) }
        case ast.Stmt.Assert(_, k, msg) {
            storedExpr(k, out)
            storedExpr(msg, out)
        }
        case ast.Stmt.Jump(_, _, msg) { storedExpr(msg, out) }
        case ast.Stmt.Spawn(_, ts, call) {
            if ts.Len() > 0 {
                for t in ts { storedTarget(t, out) }
            }
            storedExpr(call, out)
        }
        case ast.Stmt.Join(_, j) {
            storedIn(j.Body, out)
            storedCatches(j.Clauses, out)
        }
        case ast.Stmt.Defer(_, d, _) { storedStmt(d, out) }
        nomatch { }
    }
}

fn storedIf(i ast.If&, out mut Map<source.NameId, Bool>&) {
    storedExpr(i.Cond, out)
    if i.Then is not null { storedIn(i.Then!.Body, out) }
    storedStmt(i.Else, out)
}

fn storedMatch(m ast.Match&, out mut Map<source.NameId, Bool>&) {
    storedExpr(m.Subject, out)
    for cs in m.Cases { storedCase(cs, out) }
    if m.NoMatch is not null { storedCase(m.NoMatch!, out) }
}

fn storedCase(cs ast.Case&, out mut Map<source.NameId, Bool>&) {
    storedExpr(cs.Guard, out)
    storedIn(cs.Body, out)
    storedExpr(cs.Value, out)
}

fn storedCatches(cs Array<ast.Catch&>&, out mut Map<source.NameId, Bool>&) {
    if cs.Len() == 0 { return }
    for k in cs {
        storedIn(k.Body, out)
        storedExprs(k.Defaults, out)
    }
}

fn storedExprs(xs Array<ast.Expr&>&, out mut Map<source.NameId, Bool>&) {
    if xs.Len() == 0 { return }
    for x in xs { storedExpr(x, out) }
}

# an expression's statements: a try's clauses, a match value's cases - what may assign
fn storedExpr(x ast.Expr?&, out mut Map<source.NameId, Bool>&) {
    if x is null { return }
    match x {
        case ast.Expr.Paren(_, y), ast.Expr.Named(_, _, y), ast.Expr.Unary(_, _, y), ast.Expr.Postfix(_, _, y), ast.Expr.Member(_, y, _) { storedExpr(y, out) }
        case ast.Expr.IsType(_, y, _, _), ast.Expr.As(_, y, _), ast.Expr.Generic(_, y, _) { storedExpr(y, out) }
        case ast.Expr.Binary(_, _, a, b), ast.Expr.NotIn(_, a, b), ast.Expr.Is(_, a, b, _) {
            storedExpr(a, out)
            storedExpr(b, out)
        }
        case ast.Expr.Cond(_, a, k, b) {
            storedExpr(a, out)
            storedExpr(k, out)
            storedExpr(b, out)
        }
        case ast.Expr.Chain(_, ch) { storedExprs(ch.Xs, out) }
        case ast.Expr.Call(_, f, args), ast.Expr.ScopeCall(_, f, _, args), ast.Expr.Index(_, f, args) {
            storedExpr(f, out)
            storedExprs(args, out)
        }
        case ast.Expr.Slice(_, y, lo, hi) {
            storedExpr(y, out)
            storedExpr(lo, out)
            storedExpr(hi, out)
        }
        case ast.Expr.ArrayLit(_, _, items), ast.Expr.Row(_, items), ast.Expr.Join(_, items), ast.Expr.Range(_, items) { storedExprs(items, out) }
        case ast.Expr.Try(_, y, cs) {
            storedExpr(y, out)
            storedCatches(cs, out)
        }
        case ast.Expr.MatchE(_, m) { storedMatch(m, out) }
        case ast.Expr.Compr(_, k) {
            storedExpr(k.Value, out)
            storedExpr(k.Source, out)
            storedExpr(k.Filter, out)
        }
        nomatch { }
    }
}

# ---- contracts (D17) ----

# where body b's contract is written - its function's or constructor's declaration: the contract, the receiver and
# parameters it reads, the results' names, the module, the context its types are read in, the name diagnostics call
# it by
type ctSource struct(K ast.ContractBlock&, Recv ast.Param?&, Params Array<ast.Param&>&, Mi I64, Name String&) {
    K
    Recv
    Params
    Mi
    Name
}

# the context a contract is checked in: its function's instance's, its constructor's
fn (c mut Checker&) ctContext(b I64) generic.Context {
    match c.Bodies[b].Of {
        case typed.BodyOf.Fn(inst) { return c.P.FnContext(c.P.InstanceFn(inst), c.P.InstanceArgs(inst)) }
        case typed.BodyOf.Ctor(t, twin) { return c.P.CtorContext(t, twin) }
        case typed.BodyOf.Slot(tr, k) { return c.P.InstanceContext(c.P.AnySlots(tr)[k].Trait) }
        nomatch { return generic.Context(c.fr().Mi, -1) }
    }
}

fn (c mut Checker&) ctSourceOf(b I64) ctSource?&c {
    match c.Bodies[b].Of {
        case typed.BodyOf.Fn(inst) {
            f := c.P.InstanceFn(inst)
            fd := c.P.FnDecl(f)
            if fd.S.Contract is null { return null }
            return ctSource(fd.S.Contract!, fd.Recv, fd.S.Params, c.P.FnModule(f), $c.text(fd.Name))
        }
        case typed.BodyOf.Ctor(t, _) {
            d := c.P.T.DeclOf(t)
            td := c.P.TypeDecl(d)
            if td is null or td.Body is null { return null }
            mi := c.P.T.DeclModule(d)
            nm := $c.text(td.Name)
            match td.Body {
                case ast.TypeBody.Struct(sb) {
                    if sb.Errs is null or sb.Errs!.Contract is null { return null }
                    return ctSource(sb.Errs!.Contract!, null, sb.Params, mi, nm)
                }
                case ast.TypeBody.Over(_, ctor) {
                    if ctor is null or ctor.S.Contract is null { return null }
                    return ctSource(ctor.S.Contract!, null, ctor.S.Params, mi, nm)
                }
                nomatch { return null }
            }
        }
        case typed.BodyOf.Slot(tr, k) {
            # D17f: the contract a trait writes on its method, for a call through an "any" - its receiver unnamed
            m := c.traitMethod(c.P.AnySlots(tr)[k])
            if m is null or m.S.Contract is null { return null }
            d := c.P.T.DeclOf(c.P.AnySlots(tr)[k].Trait)
            recv := m.Recv
            if recv is null { recv = ast.Param(m.Sp, source.NameId(0), ast.TypeRef.Perm(m.Sp, null, false, false), null) }
            return ctSource(m.S.Contract!, recv, m.S.Params, c.P.T.DeclModule(d), $c.ty(tr) "." $c.text(m.Name))
        }
        nomatch { return null }
    }
}

# whether body b has a contract with conditions, its items checked and made bodies of their own the first time it is
# asked for (Contracts holds them, ctDone says it was asked) - its "outlives" chains recorded on it then too (D17d)
fn (c mut Checker&) hasContract(b I64) Bool {
    if b < 0 or b >= c.Bodies.Len() { return false }
    if c.ctDone.Has(b) { return c.Contracts.Has(b) }
    c.ctDone.Put(b, true)
    src := c.ctSourceOf(b)
    if src is null { return false }
    sr := src
    k := sr.K
    sig := c.Bodies[b].Ty
    slotOwner := match c.Bodies[b].Of {
        case typed.BodyOf.Slot(_, _) => true
        case _ => false
    }
    if slotOwner and k.Chains.Len() > 0 {
        # D17f: a call through an "any" discharges no obligation (T22a)
        c.ctErr(sr.Mi, k.Chains[0].Sp, msgs.TraitContractOutlives())
    } else {
        c.written(b, sig, sr, k)
    }
    if k.Items.Len() == 0 { return false }
    info mut typed.ContractInfo&c = typed.ContractInfo(sr.Name, c.P.L.Mods[sr.Mi].File)
    c.Contracts.Put(b, info)
    for i in range k.Items.Len() {
        it := k.Items[i]
        id := c.ctBody(b, i, sig, it.Span())
        c.ctItems(it)
        c.ctFinish(id)
        info.Reqs.Push(id)
        info.ReqSps.Push(it.Span())
        info.ReqTexts.Push($c.P.L.Mods[sr.Mi].Src!.Text[I64(it.Span().Start):I64(it.Span().End)])
    }
    return true
}

# D17: a function's or a constructor's requirements checked on entry, in the order written, in every build: each its
# body called on the parameters, "if not cond { error ArgumentError.INVALID }", the error's trace naming the function
# and the condition ("pick: y > x", S18d). What a call in a condition fails with leaves the function as itself, as
# through a try written there
fn (c mut Checker&) entryChecks() {
    b := c.fr().Body
    if b < 0 { return }
    match c.cur().Of {
        case typed.BodyOf.Fn(i) { if c.P.IsGenerator(c.P.InstanceFn(i)) { return } }    # its first Next's (D18)
        case typed.BodyOf.Ctor(_, _) { }
        nomatch { return }
    }
    params Vec<I64>
    for l in c.cur().Params { params.Push(I64(l)) }
    c.contractChecks(b, params, false)
}

# function b's conditions checked here, each called on locals args - b's own parameters, or (gen) a generator's Next
# beginning: its parameters' locals, its first Next failing where one is false (D18)
fn (c mut Checker&) contractChecks(b I64, args Vec<I64>&, gen Bool) {
    if not c.hasContract(b) { return }
    info := try c.Contracts.Get(b) catch { return }
    if info.Reqs.Len() == 0 { return }
    fr := c.fr()
    ae := c.P.PreludeType("std/prelude/argument", "ArgumentError")
    if ae == types.UnknownT { return }
    ws := c.P.ErrorWords(c.P.T.DeclOf(ae))
    word I64 = 0
    for i in range ws.Len() {
        if c.text(ws[i]) == "INVALID" { word = i }
    }
    raised := c.P.T.ErrWords(ae, U64(1) << word)
    src := c.ctSourceOf(b)
    # a written set names ArgumentError, which every call of a function with value conditions may fail with
    if not fr.InferErrors and not fr.InTest and c.uncovered(fr.Errors, raised) != types.UnknownT and src is not null {
        c.ctErr(src.Mi, src.K.Sp, msgs.GenContractNeedsArgumentError(info.Name) if gen else msgs.ContractNeedsArgumentError(info.Name))
    }
    for i in range info.Reqs.Len() {
        sp := info.ReqSps[i]
        from := c.exprs.Len()
        for l in args { c.exprs.Push(c.readLocal(sp, l)) }
        req := info.Reqs[i]
        # the call at the condition's end, the raise at its start: a trace tells passing an error of a call in the
        # condition on from the requirement failing (S18d)
        csp := source.Span(sp.End - 1, sp.End)
        x typed.Expr&c = c.callOf(csp, types.BoolT, typed.Callee.Body(typed.BodyId(I32(req))), gather(c.exprs, from))
        errs := c.bodyErrors(req)
        if c.P.T.Items(errs).Len() > 0 {
            mark := fr.leaks.Len()
            fr.Tries++
            c.leak(errs)
            fr.Fallible++
            fr.Tries--
            k := c.caught(mark, fr.leaks.Len(), Vec<typed.Clause&>())
            c.escapes(sp, mark, k)
            x = typed.Expr.Try(csp, types.BoolT, typed.Try(x, Array<typed.Clause&>(0), Left = k > 0))
        }
        bfrom := c.stmts.Len()
        id, outer, bmark := c.open(typed.BlockKind.Plain, sp)
        c.leaks1(raised)
        c.stmts.Push(typed.Stmt.Raise(sp, ae, word))
        blk := c.close(id, outer, bmark, bfrom)
        c.emit(typed.Stmt.If(sp, typed.If(c.negate(sp, x), blk, null)))
        c.cur().RaiseAt.Push(sp.Start)
        c.cur().RaiseWhat.Push($info.Name ": " $info.ReqTexts[i])
    }
}

# a function's own check asks for its contract (checkFn, ctorChecked) - one made first where its errors were forgotten
# (a probe asking for it held its diagnostics back) made again, so they are said
fn (c mut Checker&) contractChecked(b I64) {
    if not c.ctDone.Has(b) {
        c.hasContract(b)
        return
    }
    info := try c.Contracts.Get(b) catch { return }
    faulty := false
    for id in info.Reqs { faulty = faulty or c.Faulty.Has(id) }
    if not faulty { return }
    src := c.ctSourceOf(b)
    if src is null { return }
    sp := src.K.Sp
    if c.P.L.Diags.ErrorWithin(info.File, I64(sp.Start), I64(sp.End), 0) { return }
    c.ctDone.Remove(b)
    c.Contracts.Remove(b)
    c.Bodies[b].Written.Clear()
    c.hasContract(b)
}

# a requirement's body begun (D17): its function's parameters - read-only, a condition writing nothing - and the frame
# checking it pushed; what a call in it fails with is its own set, inferred, which the call it guards fails with too
fn (c mut Checker&) ctBody(b I64, index I64, sig types.TypeId, sp source.Span) I64 {
    sr := c.ctSourceOf(b)!
    ps := c.P.T.Items(c.P.T.Params(sig))
    tys Vec<types.TypeId>
    shares Vec<I64>
    for i in range ps.Len() {
        p := ps[i]
        if c.isRef(p) { p = c.P.T.Ref(c.P.T.Referent(p), c.P.T.PermOf(p) & ~types.Writable) }
        tys.Push(p)
        shares.Push(c.P.T.ShareOf(sig, i))
    }
    ty := c.P.T.Func(c.P.T.List(tys.ToArray()), types.BoolT, c.P.T.List1(types.DefaultErrT)
                     c.P.T.Scopes(types.RoleFn, shares.ToArray(), I64[types.OwnScope]))
    id := c.newBody(typed.BodyOf.Contract(typed.BodyId(I32(b)), typed.ContractKind.Req, index), ty, sr.Mi, sp)
    c.state[id] = 1
    c.inferring.Put(id, true)
    fr := c.push(id, sr.Mi, types.BoolT, c.P.T.Errors(ty))
    fr.Ctx = c.ctContext(b)
    fr.Contract = CtReq
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    k I64 = 0
    if sr.Recv is not null {
        if k < ps.Len() { c.param(sr.Recv!.Name, sr.Recv!.Sp, tys[0], 0, sr.Recv!.Ty) }
        k = 1
    }
    for prm in sr.Params {
        if k < ps.Len() { c.param(prm.Name, prm.Sp, tys[k], k, prm.Ty) }
        k++
    }
    c.cur().SetVars(c.P.ScopeVarsOf(ty))
    fr.ctFrom = c.stmts.Len()
    return id
}

# a requirement's statements (D17a): "if not c { return false }", and true at the end
fn (c mut Checker&) ctItems(it ast.Stmt&) {
    c.stmt(it)
    c.stmts.Push(typed.Stmt.Return(it.Span(), c.lit(it.Span(), types.BoolT, 1)))
}

# a requirement's body finished
fn (c mut Checker&) ctFinish(id I64) {
    c.cur().Root = typed.Block(typed.BlockId(0), gather(c.stmts, c.fr().ctFrom))
    c.pop()
    c.state[id] = 2
}

# a condition of a contract (D17a): "if not c { return false }"
fn (c mut Checker&) ctCond(sp source.Span, k ast.Expr&) {
    x := c.cond1(k)
    from := c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Plain, sp)
    c.stmts.Push(typed.Stmt.Return(sp, c.lit(sp, types.BoolT, 0)))
    blk := c.close(id, outer, mark, from)
    c.emit(typed.Stmt.If(sp, typed.If(c.negate(sp, x), blk, null)))
}

# whether a number fits a number type, as a Bool: its conversion checked, a failure false (D17g)
fn (c mut Checker&) fitsTest(sp source.Span, x typed.Expr&c, t types.TypeId) typed.Expr&c {
    xt := typeOf(x)
    if c.under(xt) == c.under(t) or c.convWords(xt, t).Len() == 0 { return c.lit(sp, types.BoolT, 1) }
    from := c.exprs.Len()
    c.exprs.Push(x)
    conv := typed.Expr.Prim(sp, t, typed.PrimOp.Convert, typed.Check.Try, gather(c.exprs, from))
    sfrom := c.stmts.Len()
    c.stmts.Push(typed.Stmt.Eval(sp, conv))
    seq := typed.Expr.Seq(sp, types.BoolT, typed.Seq(gather(c.stmts, sfrom), c.lit(sp, types.BoolT, 1)))
    dfrom := c.exprs.Len()
    c.exprs.Push(c.lit(sp, types.BoolT, 0))
    cl := typed.Clause(sp, Array<typed.Item>(0), true, null, gather(c.exprs, dfrom))
    return typed.Expr.Try(sp, types.BoolT, typed.Try(seq, typed.Clause&[cl], false, false))
}

# the scope relations body b's contract writes (D17d): each "a outlives b" of a chain, a and b its parameters' scope
# variables or "return" the result scope, recorded on the body for section 8 - which holds every call to them, so such
# a function is no value (T22a)
fn (c mut Checker&) written(b I64, sig types.TypeId, sr ctSource, k ast.ContractBlock&) {
    if k.Chains.Len() == 0 { return }
    vars := c.P.T.ScopeVarsOf(sig)
    for ch in k.Chains {
        prev I64 = -1
        for i in range ch.Names.Len() {
            v := c.scopeVarOf(sig, vars, sr, ch.Names[i], ch.Sps[i])
            if v >= 0 and prev >= 0 { c.Bodies[b].Written.Push(typed.ScopeRel(prev, v, ch.Sps[i])) }
            prev = v
        }
    }
}

# the index among vars of the scope variable a name of an "outlives" item stands for; -1 (reported) for none
fn (c mut Checker&) scopeVarOf(sig types.TypeId, vars Array<I64>&, sr ctSource, n source.NameId, sp source.Span) I64 {
    want I64 = -3
    if n == source.NameId(0) {
        want = types.ResultVar
    } else {
        k I64 = 0
        if sr.Recv is not null {
            if sr.Recv!.Name == n { want = 0 }
            k = 1
        }
        for prm in sr.Params {
            if prm.Name == n { want = k }
            k++
        }
        if want == -3 {
            c.ctErr(sr.Mi, sp, msgs.ContractOutlivesNotParam(c.tok(n)))
            return -1
        }
        # a parameter sharing an earlier one's scope ("&x", O4b) names that one's
        for _ in range 64 {
            sh := c.P.T.ShareOf(sig, want)
            if sh < 0 { break }
            want = sh
        }
    }
    for i in range vars.Len() {
        if vars[i] == want { return i }
    }
    c.ctErr(sr.Mi, sp, msgs.ContractOutlivesNoScope("'return'" if n == source.NameId(0) else c.tok(n)))
    return -1
}

# an error said in a contract, in the module it is written in whatever frame asked for the contract
fn (c mut Checker&) ctErr(mi I64, sp source.Span, m msgs.Msg) I64 {
    return c.P.L.Diags.Error(diag.Where.Span(c.P.L.Mods[mi].File, I64(sp.Start), I64(sp.End)), m)
}

# ---- contracts at calls (D17e, D17g) ----

# a call to a function with a contract: each requirement asked of the evaluator where every argument is one it can
# compute (a false one an error at the call); a call through an "any" checked against its trait's here (D17f), as a
# function checks its own on entry
fn (c mut Checker&) contractAt(sp source.Span, nsp source.Span, r types.TypeId, call typed.Expr&c, target typed.Callee&c
    args Array<typed.Expr&>&c, site typed.SiteId, cb I64) typed.Expr&c {
    info := try c.Contracts.Get(cb) catch { return call }
    # a body only the evaluator runs (an assert's condition, S18c) asks nothing: its call is asked where it is written
    if info.Reqs.Len() == 0 or c.fr().Body < 0 or c.evalOnly() { return call }
    # a generator's are its first Next's (D18), which this call does not run
    match c.Bodies[cb].Of {
        case typed.BodyOf.Fn(i) { if c.P.IsGenerator(c.P.InstanceFn(i)) { return call } }
        nomatch { }
    }
    out := call
    match target {
        case typed.Callee.Dispatch(_, _, _) { out = c.dispatchChecks(sp, r, target, args, site, info) }
        nomatch { }
    }
    for a in args {
        if not closedExpr(a) { return out }
    }
    fr := c.fr()
    mi, file := fr.Mi, fr.File
    old := fr.Body
    cw, ct := c.P.L.Diags.TopContext()
    for i in range info.Reqs.Len() {
        ask := c.askBody(mi, sp, old, info.Reqs[i], args)
        c.ContractAsks.Push(ContractAsk(ask, file, nsp, info.File, info.ReqSps[i], info.Name, info.ReqTexts[i], cw, $ct))
        c.contractCallers.Push(old)
    }
    return out
}

# D17f: a call through an "any" with its trait's requirements checked before it - its arguments held (a literal read
# again), each requirement's body called on them, a false one failing the call with ArgumentError.INVALID, the trace
# naming the trait's method and the condition (S18d)
fn (c mut Checker&) dispatchChecks(sp source.Span, r types.TypeId, target typed.Callee&c, args Array<typed.Expr&>&c
    site typed.SiteId, info typed.ContractInfo) typed.Expr&c {
    fr := c.fr()
    sfrom := c.stmts.Len()
    held Vec<I64>
    for a in args {
        match a {
            case typed.Expr.Lit(_, _, _) { held.Push(-1) }
            nomatch {
                h := c.local(source.NameId(0), a.Span(), typeOf(a), typed.LocalKind.Held, typed.Mark.None)
                c.emit(typed.Stmt.Let(a.Span(), typed.LocalId(I32(h)), a))
                held.Push(h)
            }
        }
    }
    ae := c.P.PreludeType("std/prelude/argument", "ArgumentError")
    for i in range info.Reqs.Len() {
        q := info.Reqs[i]
        v typed.Expr&c = c.bodyCall(sp, q, types.BoolT, args, held, Vec<I64>())
        errs := c.bodyErrors(q)
        if c.P.T.Items(errs).Len() > 0 {
            c.leak(errs)
            fr.Fallible++
            v = typed.Expr.Try(sp, types.BoolT, typed.Try(v, Array<typed.Clause&>(0)))
        }
        if ae != types.UnknownT { c.leaks1(ae) }
        fr.Fallible++
        from := c.exprs.Len()
        c.exprs.Push(v)
        c.emit(typed.Stmt.Eval(sp, typed.Expr.Prim(sp, types.BoolT, typed.PrimOp.Holds, typed.Check.Try, gather(c.exprs, from))))
        c.cur().RaiseAt.Push(sp.Start)
        c.cur().RaiseWhat.Push($info.Name ": " $info.ReqTexts[i])
    }
    efrom := c.exprs.Len()
    for i in range args.Len() { c.exprs.Push(c.heldArg(args, held, i)) }
    inner := typed.Expr.Call(sp, r, typed.Call(target, gather(c.exprs, efrom), typed.Mark.None, site))
    if r == types.VoidT or r == types.NoreturnT {
        c.emit(typed.Stmt.Eval(sp, inner))
        return typed.Expr.Seq(sp, r, typed.Seq(gather(c.stmts, sfrom), null))
    }
    return typed.Expr.Seq(sp, r, typed.Seq(gather(c.stmts, sfrom), inner))
}

# a body giving the value of condition body body called on args - copies of the arguments of a call in body old, which
# read nothing of it (closedExpr) - for the evaluator (BodyOf.Cond)
fn (c mut Checker&) askBody(mi I64, sp source.Span, old I64, body I64, args Array<typed.Expr&>&c) I64 {
    id := c.newBody(typed.BodyOf.Cond(mi, sp.Start), c.P.T.Func(types.ListId(0), types.BoolT, types.ListId(0)), mi, sp)
    c.state[id] = 1
    fr := c.push(id, mi, types.BoolT, types.ListId(0))
    fr.Ctx = generic.Context(mi, -1)
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    from := c.stmts.Len()
    efrom := c.exprs.Len()
    for a in args { c.exprs.Push(c.copyExpr(a, old)) }
    call mut typed.Expr&c = typed.Expr.Call(sp, types.BoolT, typed.Call(typed.Callee.Body(typed.BodyId(I32(body))), gather(c.exprs, efrom)
                                                                       typed.Mark.None, c.site(typed.SiteKind.Call, sp)))
    c.stmts.Push(typed.Stmt.Return(sp, call))
    c.cur().Root = typed.Block(typed.BlockId(0), gather(c.stmts, from))
    c.pop()
    c.state[id] = 2
    return id
}

# whether a typed expression reads nothing of the body it is in - no local, no hidden value - so a copy of it in another
# body computes the same (copyExpr)
fn closedExpr(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Lit(_, _, _), typed.Expr.Data(_, _, _, _) => true
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p) => closedPlace(p)
        case typed.Expr.Promote(_, _, pr) => closedExpr(pr.X)
        case typed.Expr.Call(_, _, cl) => closedCall(cl)
        case typed.Expr.Make(_, _, m) => closedAll(m.Items) and (m.Length is null or closedExpr(m.Length!))
        case typed.Expr.Prim(_, _, _, _, args) => closedAll(args)
        case typed.Expr.Slice(_, _, s) => closedPlace(s.Base) and closedExpr(s.Lo) and closedExpr(s.Hi)
        case typed.Expr.Cond(_, _, k) => closedExpr(k.C) and (k.A is null or closedExpr(k.A!)) and closedExpr(k.B)
        case typed.Expr.Away(_, _, y) => closedExpr(y)
        case typed.Expr.Fn(_, _, f) => closedFn(f)
        case _ => false
    }
}

fn closedFn(f typed.FnVal&) Bool {
    return match f {
        case typed.FnVal.Named(_) => true
        case _ => false
    }
}

fn closedAll(xs Array<typed.Expr&>&) Bool {
    for y in xs {
        if not closedExpr(y) { return false }
    }
    return true
}

fn closedCall(cl typed.Call&) Bool {
    if cl.Zero or cl.Scoped != typed.Mark.None { return false }
    match cl.Target {
        case typed.Callee.Body(_), typed.Callee.Helper(_, _) { return closedAll(cl.Args) }
        nomatch { return false }
    }
}

fn closedPlace(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Global(_, _, _, _) => true
        case typed.Lvalue.Deref(_, _, r) => closedExpr(r)
        case typed.Lvalue.Field(_, _, b, _) => closedPlace(b)
        case typed.Lvalue.Elem(_, _, e) => closedPlace(e.Base) and closedExpr(e.Index)
        case typed.Lvalue.Payload(_, _, py) => closedPlace(py.Base)
        case typed.Lvalue.Temp(_, _, v, _) => closedExpr(v)
        case _ => false
    }
}

# a copy of a closed expression (closedExpr) of body old, for the body being checked - its sites that body's
fn (c mut Checker&) copyExpr(x typed.Expr&, old I64) typed.Expr&c {
    match x {
        case typed.Expr.Lit(sp, ty, bits) { return typed.Expr.Lit(sp, ty, bits) }
        case typed.Expr.Data(sp, ty, file, k) { return typed.Expr.Data(sp, ty, file, k) }
        case typed.Expr.Read(sp, ty, p, site) { return typed.Expr.Read(sp, ty, c.copyPlace(p, old), c.reSite(site, old)) }
        case typed.Expr.Borrow(sp, ty, p) { return typed.Expr.Borrow(sp, ty, c.copyPlace(p, old)) }
        case typed.Expr.Promote(sp, ty, pr) { return typed.Expr.Promote(sp, ty, typed.Promote(c.copyExpr(pr.X, old), c.reSite(pr.Site, old))) }
        case typed.Expr.Call(sp, ty, cl) {
            return typed.Expr.Call(sp, ty, typed.Call(cl.Target, c.copyAll(cl.Args, old), cl.Scoped, c.reSite(cl.Site, old), cl.Zero))
        }
        case typed.Expr.Make(sp, ty, m) {
            items := c.copyAll(m.Items, old)
            n typed.Expr?&c = null
            if m.Length is not null { n = c.copyExpr(m.Length!, old) }
            return typed.Expr.Make(sp, ty, typed.Make(m.Kind, m.Tag, items, n, c.reSite(m.Site, old), m.Checked))
        }
        case typed.Expr.Prim(sp, ty, op, chk, args) { return typed.Expr.Prim(sp, ty, op, chk, c.copyAll(args, old)) }
        case typed.Expr.Slice(sp, ty, s) {
            return typed.Expr.Slice(sp, ty, typed.Slice(c.copyPlace(s.Base, old), c.copyExpr(s.Lo, old), c.copyExpr(s.Hi, old), s.Checked))
        }
        case typed.Expr.Cond(sp, ty, k) {
            a typed.Expr?&c = null
            if k.A is not null { a = c.copyExpr(k.A!, old) }
            return typed.Expr.Cond(sp, ty, typed.Cond(c.copyExpr(k.C, old), a, c.copyExpr(k.B, old)))
        }
        case typed.Expr.Away(sp, file, y) { return typed.Expr.Away(sp, file, c.copyExpr(y, old)) }
        case typed.Expr.Fn(sp, ty, f) {
            match f {
                case typed.FnVal.Named(b) { return typed.Expr.Fn(sp, ty, typed.FnVal.Named(b)) }
                nomatch { }
            }
        }
        nomatch { }
    }
    return c.unknown(x.Span())
}

fn (c mut Checker&) copyAll(xs Array<typed.Expr&>&, old I64) Array<typed.Expr&>&c {
    from := c.exprs.Len()
    for y in xs { c.exprs.Push(c.copyExpr(y, old)) }
    return gather(c.exprs, from)
}

fn (c mut Checker&) copyPlace(p typed.Lvalue&, old I64) typed.Lvalue&c {
    match p {
        case typed.Lvalue.Global(sp, ty, m, n) { return typed.Lvalue.Global(sp, ty, m, n) }
        case typed.Lvalue.Deref(sp, ty, r) { return typed.Lvalue.Deref(sp, ty, c.copyExpr(r, old)) }
        case typed.Lvalue.Field(sp, ty, b, i) { return typed.Lvalue.Field(sp, ty, c.copyPlace(b, old), i) }
        case typed.Lvalue.Elem(sp, ty, e) {
            return typed.Lvalue.Elem(sp, ty, typed.Elem(c.copyPlace(e.Base, old), c.copyExpr(e.Index, old), e.Checked))
        }
        case typed.Lvalue.Payload(sp, ty, py) { return typed.Lvalue.Payload(sp, ty, typed.Payload(c.copyPlace(py.Base, old), py.Tag, py.Checked)) }
        case typed.Lvalue.Temp(sp, ty, v, site) { return typed.Lvalue.Temp(sp, ty, c.copyExpr(v, old), c.reSite(site, old)) }
        case typed.Lvalue.Local(sp, ty, l) { return typed.Lvalue.Local(sp, ty, l) }
        case typed.Lvalue.Target(sp, ty) { return typed.Lvalue.Target(sp, ty) }
    }
}

# a site of body old made again in the body being checked, as what it was
fn (c mut Checker&) reSite(s typed.SiteId, old I64) typed.SiteId {
    if s < typed.SiteId(0) { return s }
    si := c.Bodies[old].Sites[I64(s)]
    return c.site(si.Kind, si.Sp)
}

# whether the body being checked is one only the evaluator runs - a condition's or an assert's (BodyOf.Cond)
fn (c mut Checker&) evalOnly() Bool {
    return match c.cur().Of {
        case typed.BodyOf.Cond(_, _) => true
        case _ => false
    }
}

# argument i of a call whose arguments are held: its literal, or a read of the local holding it
fn (c mut Checker&) heldArg(args Array<typed.Expr&>&c, held Vec<I64>&, i I64) typed.Expr&c {
    if held[i] < 0 { return args[i] }
    return c.readLocal(args[i].Span(), held[i])
}

fn (c mut Checker&) readLocal(sp source.Span, l I64) typed.Expr&c {
    t := c.localType(l)
    return typed.Expr.Read(sp, t, typed.Lvalue.Local(sp, t, typed.LocalId(I32(l))), typed.SiteId(-1))
}

fn (c mut Checker&) bodyCall(sp source.Span, body I64, ty types.TypeId, args Array<typed.Expr&>&c, held Vec<I64>&
    extra Vec<I64>&) typed.Expr&c {
    from := c.exprs.Len()
    for i in range args.Len() { c.exprs.Push(c.heldArg(args, held, i)) }
    for l in extra { c.exprs.Push(c.readLocal(sp, l)) }
    return typed.Expr.Call(sp, ty, typed.Call(typed.Callee.Body(typed.BodyId(I32(body))), gather(c.exprs, from), typed.Mark.None
                                              c.site(typed.SiteKind.Call, sp)))
}

# D17g: a conversion to a number type of a value the evaluator computes is asked of it, so a constant out of range is
# an error at the conversion
fn (c mut Checker&) conversionAt(sp source.Span, argSp source.Span, x typed.Expr&c, t types.TypeId) {
    fr := c.fr()
    if fr.Contract != 0 or fr.Body < 0 or c.evalOnly() or not closedExpr(x) { return }
    mi, file := fr.Mi, fr.File
    old := fr.Body
    text mut String&c = $c.src(argSp)
    id := c.newBody(typed.BodyOf.Cond(mi, sp.Start), c.P.T.Func(types.ListId(0), types.BoolT, types.ListId(0)), mi, sp)
    c.state[id] = 1
    nf := c.push(id, mi, types.BoolT, types.ListId(0))
    nf.Ctx = generic.Context(mi, -1)
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    from := c.stmts.Len()
    c.stmts.Push(typed.Stmt.Return(sp, c.fitsTest(sp, c.copyExpr(x, old), t)))
    c.cur().Root = typed.Block(typed.BlockId(0), gather(c.stmts, from))
    c.pop()
    c.state[id] = 2
    cw, ct := c.P.L.Diags.TopContext()
    c.ContractAsks.Push(ContractAsk(id, file, sp, file, argSp, "", text, cw, $ct, $c.ty(t)))
    c.contractCallers.Push(-1)
}

# ---- frames, blocks and locals ----

fn (c mut Checker&) push(id I64, mi I64, result types.TypeId, errors types.ListId) mut frame&c {
    c.frames.Push(frame(id, mi, c.P.L.Mods[mi].File, result, errors))
    fr := c.fr()
    fr.DiagMark = c.P.L.Diags.Count()
    # a function's or constructor's body whose set is inferred (R1a): what it lets out is its set, settled as it ends
    if id >= 0 and (try c.inferring.Get(id) catch default false) {
        fr.InferErrors = true
        fr.Settles = true
    }
    return fr
}

fn (c mut Checker&) pop() {
    fr := c.fr()
    if fr.Settles { c.settle(fr) }
    # K1a: a body checking met an error or a gap in is never evaluated while compiling
    if fr.Body >= 0 and (fr.Gapped or c.P.L.Diags.Count() > fr.DiagMark) { c.Faulty.Put(fr.Body, true) }
    try c.frames.Pop() catch { }
}

# the innermost frame, and the body it checks: asked only where there is one (an index out of range is unchecked,
# E16e, and read garbage that differed between the two compilers' builds of the port)
fn (c mut Checker&) fr() mut frame&c {
    assert c.frames.Len() > 0, "the checker asked for a frame with none open"
    return c.frames[c.frames.Len() - 1]
}

fn (c mut Checker&) cur() mut typed.Body&c {
    assert c.fr().Body >= 0, "the checker asked for the body of a frame that checks none"
    return c.Bodies[c.fr().Body]
}

# a block of statements checked in a block of its own (O2), its names gone after it
fn (c mut Checker&) blockOf(body Array<ast.Stmt&>&, kind typed.BlockKind, sp source.Span) typed.Block&c {
    from := c.stmts.Len()
    id, outer, mark := c.open(kind, sp)
    c.stmtsOf(body)
    return c.close(id, outer, mark, from)
}

# a block's statements checked in order, each knowing what follows it (S8d)
fn (c mut Checker&) stmtsOf(body Array<ast.Stmt&>&) {
    if body.Len() == 0 { return }
    fr := c.fr()
    wasRest := fr.rest
    wasAt := fr.restAt
    for i in range body.Len() {
        fr.rest = body
        fr.restAt = i + 1
        # S8e: a statement assigning a narrowed path ends its narrowing - after its value, where it is that assignment
        after Vec<I64>
        for k in range fr.nulls.Len() {
            nn := fr.nulls[k]
            if nn.Dead or not stmtAssigns(body[i], nn.Path) { continue }
            if assignsWhole(body[i], nn.Path) {
                after.Push(k)
            } else {
                fr.nulls[k] = nullNarrow(nn.Path, nn.Block, true)
            }
        }
        # S8d: a statement assigning a narrowed local ends its narrowing - after its value, where it is that assignment
        afterCase Vec<I64>
        for k in range fr.narrows.Len() {
            nr := fr.narrows[k]
            if nr.Dead { continue }
            ln := Array<source.NameId>(1, c.cur().Locals[nr.Local].Name)
            if not stmtAssigns(body[i], ln) { continue }
            if assignsWhole(body[i], ln) {
                afterCase.Push(k)
            } else {
                fr.narrows[k] = nr.Killed()
            }
        }
        # T20: a statement assigning a narrowed error local ends its narrowing
        for k in range fr.errNarrows.Len() {
            en := fr.errNarrows[k]
            if not en.Dead and stmtAssigns(body[i], Array<source.NameId>(1, en.Name)) {
                fr.errNarrows[k] = errNarrow(en.Name, en.Now, en.Block, true)
            }
        }
        fr.nonNullSet = Array<source.NameId>(0)
        c.stmt(body[i])
        for k in after {
            if k < fr.nulls.Len() { fr.nulls[k] = nullNarrow(fr.nulls[k].Path, fr.nulls[k].Block, true) }
        }
        for k in afterCase {
            if k < fr.narrows.Len() { fr.narrows[k] = fr.narrows[k].Killed() }
        }
        # S8e: a path just given a value never null is known not to be null from here
        if fr.nonNullSet.Len() > 0 and fr.nonNullSet.Len() == 1 {
            fr.nulls.Push(nullNarrow(source.NameId[n for n in fr.nonNullSet], fr.Block))
            fr.nonNullSet = Array<source.NameId>(0)
        }
    }
    fr.rest = wasRest
    fr.restAt = wasAt
}

# a new block entered: its id, the block it is in, and the undo mark to leave it by (close)
fn (c mut Checker&) open(kind typed.BlockKind, sp source.Span) I64, I64, I64 {
    fr := c.fr()
    outer := fr.Block
    id := I64(c.cur().AddBlock(typed.BlockId(I32(outer)), kind, sp))
    fr.Block = id
    return id, outer, fr.undo.Len()
}

fn (c mut Checker&) close(id I64, outer I64, mark I64, from I64) typed.Block&c {
    stmts := gather(c.stmts, from)
    c.unwind(mark)
    # S8d: a narrowing holds for the block it was made in
    fr := c.fr()
    for fr.narrows.Len() > 0 and (try fr.narrows.Last() catch { unreachable }).Block == id { fr.narrows.Pop()! }
    for fr.nulls.Len() > 0 and (try fr.nulls.Last() catch { unreachable }).Block == id { try fr.nulls.Pop() catch { } }
    for fr.errNarrows.Len() > 0 and (try fr.errNarrows.Last() catch { unreachable }).Block == id { fr.errNarrows.Pop()! }
    for fr.deferBlocks.Len() > 0 and (try fr.deferBlocks.Last() catch { unreachable }) == id { fr.deferBlocks.Pop()! }
    c.fr().Block = outer
    return typed.Block(typed.BlockId(I32(id)), stmts)
}

fn (c mut Checker&) unwind(mark I64) {
    fr := c.fr()
    for fr.undo.Len() > mark {
        p := try fr.undo.Pop() catch { return }
        if p.Second < 0 {
            fr.bound.Remove(p.First)
        } else {
            fr.bound.Put(p.First, p.Second)
        }
    }
}

# a store into p, or a writable borrow of it (store false): a local or parameter may be written, a global only when
# "mut" (S6), what a reference names only when it is writable (T25b), a lambda's copy of a value never (D16c), and a
# value a call gave back only where it is lent (E31)
fn (c mut Checker&) notCapture(p typed.Lvalue&, sp source.Span) { c.mustWrite(p, sp, true) }

fn (c mut Checker&) mustWrite(p typed.Lvalue&, sp source.Span, store Bool) {
    c.noteWrite(p)
    match p {
        case typed.Lvalue.Local(_, _, id) {
            if c.cur().Local(id).Kind == typed.LocalKind.Capture and not c.isRef(c.cur().Local(id).Ty) {
                c.err(sp, msgs.CaptureReadOnly())
            } else if not store and c.roLocal(I64(id)) {
                # T25c: a read-only copy is not lent writably
                rec := c.err(sp, msgs.ReadOnlyCopyLent(c.roFix(source.NameId(0), c.cur().Local(id).Ty)))
                c.noteRo(rec, p)
            } else if not store {
                c.roNeed(p)
            }
        }
        case typed.Lvalue.Global(_, _, mi, n) {
            v := c.P.GlobalDecl(mi, n)
            if v is not null and not writtenMut(v.Ty) { c.err(sp, msgs.Immutable(c.text(n))) }
        }
        case typed.Lvalue.Deref(_, _, ref) {
            rt := typeOf(ref)
            if c.isRef(rt) and (c.P.T.PermOf(rt) & types.Writable) == 0 {
                if c.capturedValue(ref) {
                    c.err(sp, msgs.CaptureReadOnly())
                } else {
                    c.noteWritable(c.err(sp, msgs.ReadOnlyRefWrite()), ref)
                }
            } else if c.isRef(rt) and c.roRoot(readPlace(unwrapped(ref))) >= 0 {
                # T25c: a read-only copy writes nothing through the writable references it shares
                rec := c.err(sp, msgs.ReadOnlyCopyWrite())
                c.noteRo(rec, readPlace(unwrapped(ref)))
            } else if c.isRef(rt) {
                c.roNeed(readPlace(unwrapped(ref)))
            }
        }
        case typed.Lvalue.Field(fsp, _, base, _) {
            match base {
                case typed.Lvalue.Temp(_, _, v, _) {
                    if not store and c.chosenAt(v).Start >= 0 and c.condChoosesPlace(v) {
                        # E28: a part of a conditional's value lent writably - a part of a copy, read-only besides (T25c)
                        nsp := c.lastName(fsp)
                        c.err(nsp, msgs.CondLentWritable())
                        c.err(nsp, msgs.ReadOnlyToWritable())
                        return
                    }
                }
                nomatch { }
            }
            c.mustWrite(base, sp, store)
        }
        case typed.Lvalue.Elem(_, _, e) { c.mustWrite(e.Base, sp, store) }
        case typed.Lvalue.Payload(_, _, pl) { c.mustWrite(pl.Base, sp, store) }
        case typed.Lvalue.Temp(_, _, x, _) {
            # a try's value is the element or what a clause gives - a copy either way (R9a)
            tried := match x {
                case typed.Expr.Try(_, _, _) => true
                case _ => false
            }
            if store and c.narrowCopy(x) {
                c.err(sp, msgs.NarrowedWrite())
            } else if store {
                c.err(sp, msgs.AssignIntoTried() if tried else msgs.WriteIntoCallValue())
            }
        }
        nomatch { }
    }
}

# whether a store into p is allowed (S6, T25b, D16c): mustWrite's question, asked without saying anything
fn (c mut Checker&) placeWritable(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Local(_, _, id) => not (c.cur().Local(id).Kind == typed.LocalKind.Capture and not c.isRef(c.cur().Local(id).Ty)) and not c.roLocal(I64(id))
        case typed.Lvalue.Global(_, _, mi, n) => c.P.GlobalDecl(mi, n) is null or writtenMut(c.P.GlobalDecl(mi, n)!.Ty)
        case typed.Lvalue.Deref(_, _, ref) => (c.P.T.PermOf(typeOf(ref)) & types.Writable) != 0
        case typed.Lvalue.Field(_, _, base, _) => c.placeWritable(base)
        case typed.Lvalue.Elem(_, _, e) => c.placeWritable(e.Base)
        case typed.Lvalue.Payload(_, _, pl) => c.placeWritable(pl.Base)
        case _ => false
    }
}

# whether a reference is a lambda's borrow of a captured array value (T7b, D16c) - read-only as every capture is
fn (c mut Checker&) capturedValue(ref typed.Expr&) Bool {
    p := readPlace(unwrapped(ref))
    if p is null { return false }
    match p {
        case typed.Lvalue.Local(_, _, id) {
            if c.cur().Local(id).Kind != typed.LocalKind.Capture { return false }
            for k in c.fr().captures {
                if k.Inner != id { continue }
                return match k.Outer {
                    case typed.Expr.Borrow(_, _, _) => true
                    case _ => false
                }
            }
        }
        nomatch { }
    }
    return false
}

fn writtenMut(t ast.TypeRef?&) Bool {
    if t is null { return false }
    return match t {
        case ast.TypeRef.Perm(_, _, w, _) => w
        case _ => false
    }
}

# a local declared in the current block, and bound to its name (none for a hidden one, or "_")
fn (c mut Checker&) local(n source.NameId, sp source.Span, ty types.TypeId, kind typed.LocalKind, mark typed.Mark) I64 {
    fr := c.fr()
    id := I64(c.cur().AddLocal(typed.Local(n, sp, ty, typed.BlockId(I32(fr.Block)), kind, mark)))
    if n != source.NameId(0) and c.text(n) != "_" {
        fr.undo.Push(pair.Pair(n, try fr.bound.Get(n) catch default -1))
        fr.bound.Put(n, id)
        # G38: a local holding a descriptor names its member's type, "p.Type"
        if c.P.T.KindOf(ty) == types.Kind.Named and c.P.DescOf(ty).K != generic.DescNone { fr.Ctx.Refl.Put(n, ty) }
    }
    return id
}

fn (c mut Checker&) hidden(sp source.Span, ty types.TypeId) I64 {
    return c.local(source.NameId(0), sp, ty, typed.LocalKind.Hidden, typed.Mark.None)
}

fn (c mut Checker&) localNamed(n source.NameId) I64 { return try c.fr().bound.Get(n) catch default -1 }

fn (c mut Checker&) localType(id I64) types.TypeId { return c.cur().Locals[id].Ty }

# a name's local, or in a lambda the capture of a variable of a body around it (D16c), made the first time it is used
fn (c mut Checker&) localOrCapture(n source.NameId, sp source.Span) I64 {
    id := c.localNamed(n)
    if id >= 0 {
        # S8d: a local narrowed to a case whose payload is one type written whole is that payload
        w := c.wholeNarrowed(id)
        return w if w >= 0 else id
    }
    return c.captureIn(c.frames.Len() - 1, n, sp)
}

# n in frame fi: its local, or a capture of the body around it - a value copied, read-only; a reference copied; a value
# array borrowed read-only (T7b); one holding references with a scope variable of the lambda's for them (D16c)
fn (c mut Checker&) captureIn(fi I64, n source.NameId, sp source.Span) I64 {
    fr := c.frames[fi]
    id := try fr.bound.Get(n) catch default -1
    if id >= 0 or fr.Parent < 0 { return id }
    outer := c.captureIn(fr.Parent, n, sp)
    if outer < 0 { return -1 }
    ot := c.Bodies[c.frames[fr.Parent].Body].Locals[outer].Ty
    op typed.Lvalue&c = typed.Lvalue.Local(sp, ot, typed.LocalId(I32(outer)))
    it := ot
    ox typed.Expr?&c = null
    # a generator's Next holds a copy of a value array it is given, made where the generator lives (D18b): it is walked
    # after the call that gave it has returned
    if not c.isRef(ot) and c.arrayOf(ot) != types.UnknownT and not fr.Gen {
        it = c.P.T.Ref(ot, types.ReadOnly)
        ox = typed.Expr.Borrow(sp, it, op)
    } else {
        ox = typed.Expr.Read(sp, ot, op, typed.SiteId(-1))
    }
    b := c.Bodies[fr.Body]
    inner := I64(b.AddLocal(typed.Local(n, sp, it, typed.BlockId(0), typed.LocalKind.Capture, typed.Mark.Infer)))
    fr.bound.Put(n, inner)
    fr.captures.Push(typed.Capture(typed.LocalId(I32(inner)), ox!))
    if c.isRef(it) or c.P.T.HoldsRefs(it) { b.Vars.Push(typed.ScopeVar.Capture(typed.LocalId(I32(inner)))) }
    return inner
}

fn gather<T>(stack mut Vec<T>&, from I64) Array<T>&stack {
    if stack.Len() == from { return Array<T>(0) }
    a mut Array<T>&stack = Array<T>(stack.Len() - from, stack[from])     # each written below
    for i in range a.Len() { a[i] = stack[from + i] }
    stack.Truncate(from)
    return a
}

fn (c mut Checker&) site(kind typed.SiteKind, sp source.Span) typed.SiteId { return c.cur().AddSite(kind, sp) }

# ---- diagnostics ----

fn (c mut Checker&) text(n source.NameId) String&c { return c.P.L.Names.Text(n) }

fn (c mut Checker&) tok(n source.NameId) String { return msgs.Tok(c.text(n)) }

fn (c mut Checker&) at(sp source.Span) diag.Where {
    return diag.Where.Span(c.fr().File, I64(sp.Start), I64(sp.End))
}

fn (c mut Checker&) err(sp source.Span, m msgs.Msg) I64 { return c.P.L.Diags.Error(c.at(sp), m) }

# T2c: the note at the type a null or a nullable value is fitted to, where it is written - what to make "?&"
fn (c mut Checker&) declNote(rec I64) {
    if c.nullDecl != diag.Where.Nowhere { c.P.L.Diags.Note(rec, c.nullDecl, msgs.NoteNullableDecl()) }
}

# where a type written in the current module's file is, for declNote
fn (c mut Checker&) typeWrittenAt(t ast.TypeRef&) diag.Where { return c.markAt(c.fr().Mi, t) }

# a construct not checked yet (the acceptance's gap): recorded, never said
fn (c mut Checker&) gap(sp source.Span, what String&) {
    f I64 = -1
    if c.frames.Len() > 0 {
        f = c.fr().File
        c.fr().Gapped = true
    }
    c.Gaps.Push(Gap(f, sp, $what))
}

# the source text a span covers, in the current body's module
fn (c mut Checker&) src(sp source.Span) String&c {
    t := c.P.L.Mods[c.fr().Mi].Src!.Text
    if sp.Start < 0 or sp.End > I32(t.Len()) or sp.Start > sp.End { return "" }
    return t[I64(sp.Start):I64(sp.End)]
}

# the span of the first token after a and before b, n characters long: an operator's
fn (c mut Checker&) between(a source.Span, b source.Span, n I64) source.Span {
    t := c.P.L.Mods[c.fr().Mi].Src!.Text
    at := I64(a.End)
    for at < I64(b.Start) and at < t.Len() and (t[at] == ' ' or t[at] == '\n' or t[at] == '\t' or t[at] == ')') {
        at++
    }
    return source.Span(I32(at), I32(at + n))
}

# a member's name's span: the end of the member expression
fn memberSpan(sp source.Span, n I64) source.Span { return source.Span(sp.End - I32(n), sp.End) }

# the first of these characters after a span, past spaces: an operator's position (an index's "[", an assignment's
# "=", a compound one's "+="), the span itself where none follows
fn (c mut Checker&) opAfter(sp source.Span, n I64) source.Span {
    t := c.P.L.Mods[c.fr().Mi].Src!.Text
    i := I64(sp.End)
    for i < t.Len() and (t[i] == ' ' or t[i] == ')') { i++ }
    if i >= t.Len() { return sp }
    return source.Span(I32(i), I32(i + n))
}

# where an index is written: its "[" (E16, E31)
fn (c mut Checker&) bracketOf(base ast.Expr&) source.Span { return c.opAfter(base.Span(), 1) }

# x[i] on a type with no At of i's shape (E31, E16): only SetAt, an At of another shape, or
# nothing - said at the index's "[" (sp the index's span; written the type of what is indexed, its reference included)
fn (c mut Checker&) noIndex(sp source.Span, t types.TypeId, written types.TypeId, n I64) {
    bsp := c.bracketIn(sp)
    if c.notOperator(t, "At", bsp, "'x[i]'", 1, true) { return }
    if c.roleMethod(t, "SetAt", n + 1) >= 0 {
        c.err(c.compoundAt if c.compoundAt.Start >= 0 else bsp, msgs.AtUndeclared(c.ty(written)))
        return
    }
    c.err(bsp, msgs.NotIndexable(c.ty(t)))
}

# an index's "[": the one matching the "]" its span ends with
fn (c mut Checker&) bracketIn(sp source.Span) source.Span {
    t := c.src(sp)
    if t.Len() == 0 or t[t.Len() - 1] != ']' { return sp }
    depth I64 = 0
    for kk in range t.Len() {
        k := t.Len() - 1 - kk
        if t[k] == ']' { depth++ }
        if t[k] == '[' {
            depth--
            if depth == 0 { return source.Span(sp.Start + I32(k), sp.Start + I32(k + 1)) }
        }
    }
    return sp
}

# a written "mut" before what is no reference (D9, D11a, C3): the keyword's span, or none (Start -1). A type variable's
# "mut" says it is writable when bound to a reference (T2); with no type known (":="), any "mut" is one
fn (c mut Checker&) mutBefore(tr ast.TypeRef&, t types.TypeId) source.Span {
    match tr {
        case ast.TypeRef.Perm(psp, of, writable, owned) {
            if not writable or owned { return source.Span(-1, -1) }
            if c.namesTypeVar(of) { return source.Span(-1, -1) }
            if t != types.UnknownT and (c.isRef(t) or c.P.T.KindOf(t) == types.Kind.Var) { return source.Span(-1, -1) }
            if t == types.UnknownT and tr.Span().End > psp.Start + 3 and c.writtenRefOrVar(tr) { return source.Span(-1, -1) }
            return source.Span(psp.Start, psp.Start + 3)
        }
        nomatch { return source.Span(-1, -1) }
    }
}

# whether a written type is a type variable (G8b): "mut T" is writable when T is bound to a reference (T2), whatever an
# instance binds it to
fn (c mut Checker&) namesTypeVar(t ast.TypeRef?&) Bool {
    if t is null { return false }
    match t {
        case ast.TypeRef.Named(sp, path, args) {
            if path.Len() != 1 or args.Len() > 0 { return false }
            return c.P.R.Use(c.fr().File, sp.Start).Kind == names.What.TypeVar
        }
        nomatch { return false }
    }
}

# whether a "mut T" written with no type resolved names a reference or a variable: its type after "mut"
fn (c mut Checker&) writtenRefOrVar(tr ast.TypeRef&) Bool {
    match tr {
        case ast.TypeRef.Perm(_, of, _, _) {
            if of is null { return false }
            t := c.resolve(of)
            return c.isRef(t) or c.P.T.KindOf(t) == types.Kind.Var or t == types.UnknownT
        }
        nomatch { return false }
    }
}

# where a write into a place is written (T25b, S6): a member's name, an index's "[", else the whole target
fn (c mut Checker&) writeAt(target ast.Expr&) source.Span {
    match target {
        case ast.Expr.Member(sp, _, n) { return memberSpan(sp, c.text(n).Len()) }
        case ast.Expr.Index(_, y, _) { return c.bracketOf(y) }
        case ast.Expr.Paren(_, y) { return c.writeAt(y) }
        nomatch { return target.Span() }
    }
}

# an operation needing the method cap on t where t declares one of that name of another shape - an ordinary method
# (E31, M6b): said at sp, the operation as what, and true; false where t declares none of that name
fn (c mut Checker&) notOperator(t types.TypeId, cap String&, sp source.Span, what String&, want I64, atLeast Bool) Bool {
    if t == types.UnknownT or not c.isNamed(t) { return false }
    m := c.P.MethodOf(t, c.P.L.Names.Intern(cap))
    if m < 0 { m = c.P.MethodOf(t, c.P.L.Names.Intern(lowerFirst(cap))) }
    if m < 0 { return false }
    got := c.P.T.Items(c.P.T.Params(c.P.Sig(m))).Len() - 1
    if (got >= want if atLeast else got == want) { return false }
    have := "no parameters" if got == 0 else ("one parameter" if got == 1 else $got " parameters")
    n := "one" if want == 1 else $want
    arity := "none" if want == 0 else ($"at least " $n if atLeast else n)
    rec := c.err(sp, msgs.NotTheOperator(c.ty(t), c.text(c.P.FnDecl(m).Name), have, what, arity))
    fd := c.P.FnDecl(m)
    file := c.P.L.Mods[c.P.FnModule(m)].File
    ns := fd.Sp
    c.P.L.Diags.Note(rec, diag.Where.Span(file, I64(ns.Start), I64(ns.End)), msgs.NoteDeclaredHere(c.tok(fd.Name)))
    return true
}

# a type as source writes it (B11): a declared type by its name, its arguments after it; an inner reference's
# permission before it, the outermost's said in words (T25c)
fn (c mut Checker&) ty(t types.TypeId) String {
    b := StringBuilder()
    c.spell(b, t, true)
    return b.ToString()
}

fn (c mut Checker&) spell(b mut StringBuilder&, t types.TypeId, top Bool) {
    if c.P.T.IsNumber(t) {
        b.Push(primName(t) if t <= types.TypeId(14) else c.P.T.Canon(t))
        return
    }
    match c.P.T.KindOf(t) {
        case types.Kind.Bool { b.Push("Bool") }
        case types.Kind.Unknown { b.PushChar('?') }
        case types.Kind.Void { b.Push("nothing") }
        case types.Kind.Null { b.Push("null") }
        case types.Kind.DefaultErr { b.Push("what its body can fail with") }
        case types.Kind.Noreturn { b.Push("noreturn") }
        case types.Kind.ErrWords {
            # R1c: "T.W, T.V", as a signature writes the words it names
            et := c.P.T.ErrOf(t)
            name := c.text(c.P.T.DeclName(c.P.T.DeclOf(et)))
            if c.spellQualified { name = $c.qualifierFor(c.P.T.DeclModule(c.P.T.DeclOf(et))) $name }
            ws := c.P.ErrorWords(c.P.T.DeclOf(et))
            mask := c.P.T.ErrMask(t)
            first := true
            for i in range ws.Len() {
                if i < 64 and (mask & (U64(1) << i)) != 0 {
                    if not first { b.Push(", ") }
                    b.Push($name "." $c.text(ws[i]))
                    first = false
                }
            }
        }
        case types.Kind.Named {
            if c.spellQualified { b.Push(c.qualifierFor(c.P.T.DeclModule(c.P.T.DeclOf(t)))) }
            b.Push(c.text(c.P.T.DeclName(c.P.T.DeclOf(t))))
            c.spellArgs(b, c.P.T.Args(t))
        }
        case types.Kind.ErrVal {
            # T20: an error value's type as written - its error type, or the named set it was written as; a set no name
            # was written for, its entries in braces
            es := c.P.T.Items(c.P.T.ErrValItems(t))
            nd := c.P.T.ErrValName(t)
            if nd >= types.DeclId(0) {
                if c.spellQualified { b.Push(c.qualifierFor(c.P.T.DeclModule(nd))) }
                b.Push(c.text(c.P.T.DeclName(nd)))
            } else if es.Len() == 1 {
                c.spell(b, es[0], false)
            } else {
                b.PushChar('{')
                for i in range es.Len() {
                    if i > 0 { b.Push(", ") }
                    c.spell(b, es[i], false)
                }
                b.PushChar('}')
            }
        }
        case types.Kind.Any {
            b.Push("any ")
            c.spell(b, c.P.T.AnyTrait(t), false)
        }
        case types.Kind.Array {
            b.Push("Array<")
            # T7c: a length is never part of a type as written - fixed storage is spelled as any array
            was := c.spellItem
            c.spellItem = true
            c.spell(b, c.P.T.Elem(t), false)
            c.spellItem = was
            b.PushChar('>')
        }
        case types.Kind.Ref {
            perm := c.P.T.PermOf(t)
            if (perm & types.Owning) != 0 { b.Push("own ") }
            if not top and (perm & types.Writable) != 0 { b.Push("mut ") }
            c.spell(b, c.P.T.Referent(t), false)
            b.Push("?&" if (perm & types.Nullable) != 0 else "&")
        }
        case types.Kind.Func {
            res := c.P.T.Result(t)
            es := c.P.T.Items(c.P.T.Errors(t))
            named := 0
            for e in es {
                if e != types.DefaultErrT { named++ }
            }
            several := (c.P.T.KindOf(res) == types.Kind.Tuple and c.P.T.Items(c.P.T.Parts(res)).Len() > 1) or named > 1
            # L18c: an item of a list holding a comma of its own, or a result before its signature's "?", whole
            wrap := c.spellGroup or (c.spellItem and several)
            c.spellGroup = false
            wasItem := c.spellItem
            c.spellItem = true
            b.Push("(fn(" if wrap else "fn(")
            ps := c.P.T.Items(c.P.T.Params(t))
            ns := c.P.T.NamesOf(t)
            for i in range ps.Len() {
                if i > 0 { b.Push(", ") }
                if ns.Len() == ps.Len() {
                    b.Push(c.text(source.NameId(I32(ns[i]))))
                    b.PushChar(' ')
                }
                c.spell(b, ps[i], false)
                # T22: a parameter living where an earlier one does, "b N&a"
                sh := c.P.T.ShareOf(t, i)
                if sh >= 0 and sh != i and sh < ns.Len() and ns.Len() == ps.Len() { b.Push(c.text(source.NameId(I32(ns[sh])))) }
            }
            b.PushChar(')')
            if c.P.T.KindOf(res) == types.Kind.Tuple {
                # several results, bare (D8c)
                parts := c.P.T.Items(c.P.T.Parts(res))
                for i in range parts.Len() {
                    b.Push(", " if i > 0 else " ")
                    c.spell(b, parts[i], false)
                }
            } else if res != types.VoidT {
                b.PushChar(' ')
                rf := c.P.T.ResultFrom(t, 0) if c.P.T.KindOf(res) == types.Kind.Ref else types.FromTypeVar
                if rf == types.OwnScope {
                    # a built result is new storage, writable (T25c)
                    c.spell(b, c.P.T.Ref(c.P.T.Referent(res), types.Writable), false)
                } else {
                    c.spellGroup = es.Len() > 0 and c.P.T.KindOf(res) == types.Kind.Func and
                                   c.P.T.Items(c.P.T.Errors(res)).Len() == 0
                    c.spell(b, res, false)
                    c.spellGroup = false
                    # a result borrowed from a parameter, "mut N&a" (T22)
                    if rf >= 0 and rf < ns.Len() and ns.Len() == ps.Len() { b.Push(c.text(source.NameId(I32(ns[rf])))) }
                }
            }
            c.spellItem = wasItem
            if es.Len() > 0 {
                b.Push(" ?")
                k := 0
                for e in es {
                    if e == types.DefaultErrT { continue }
                    b.Push(" " if k == 0 else ", ")
                    c.spell(b, e, false)
                    k++
                }
            }
            if wrap { b.PushChar(')') }
        }
        case types.Kind.Tuple { c.spellList(b, c.P.T.Parts(t), "(", ")") }
        case types.Kind.AnonEnum {
            # "enum { A(I32) B }", as an anonymous enum is written (T27)
            b.Push("enum {")
            # each payload's field named as the first declaration written gave them
            ns := c.P.T.ShapeNames(t)
            cs := c.P.T.Items(c.P.T.ShapeCases(t))
            fs := c.P.T.ShapeFields(t)
            at := 0
            for i in range ns.Len() {
                b.PushChar(' ')
                b.Push(c.text(ns[i]))
                if i >= cs.Len() or cs[i] == types.TypeId(0) { continue }
                parts := c.P.T.Items(c.P.T.Parts(cs[i]))
                if parts.Len() == 0 { continue }
                if fs.Len() < at + parts.Len() {
                    c.spellList(b, c.P.T.Parts(cs[i]), "(", ")")
                    continue
                }
                b.PushChar('(')
                for j in range parts.Len() {
                    if j > 0 { b.Push(", ") }
                    b.Push(c.text(fs[at + j]))
                    b.PushChar(' ')
                    c.spell(b, parts[j], false)
                }
                b.PushChar(')')
                at += parts.Len()
            }
            b.Push(" }")
        }
        case types.Kind.Const { b.Push($c.P.T.ConstValue(t)) }
        case types.Kind.Var { b.Push(c.text(c.P.VarAt(c.P.T.A(t), c.P.T.B(t)).Name)) }
        # QAH: an error set given for an error-set parameter, "Bad, io.Error" - "nothing" for the empty set
        case types.Kind.ErrSet {
            es := c.P.T.Items(c.P.T.ErrSetItems(t))
            if es.Len() == 0 { b.Push("nothing") }
            for i in range es.Len() {
                if i > 0 { b.Push(", ") }
                c.spell(b, es[i], false)
            }
        }
        nomatch { b.Push(c.P.T.Canon(t)) }
    }
}

# whether a type is written as a function type
fn isFuncTypeRef(t ast.TypeRef&) Bool {
    return match t {
        case ast.TypeRef.Func(_, _) => true
        case _ => false
    }
}

fn (c mut Checker&) spellList(b mut StringBuilder&, l types.ListId, open String&, end String&) {
    xs := c.P.T.Items(l)
    if xs.Len() == 0 and open == "<" { return }
    b.Push(open)
    was := c.spellItem
    c.spellItem = true
    for i in range xs.Len() {
        if i > 0 { b.Push(", ") }
        c.spell(b, xs[i], false)
    }
    c.spellItem = was
    b.Push(end)
}

# a declared type's arguments as source writes them: "<T, U>", the error-set argument closing it after "?" - "<I64 ?
# Bad>" - and left out where it is the empty set, as "Iterator<I64>" writes it (QAH)
fn (c mut Checker&) spellArgs(b mut StringBuilder&, l types.ListId) {
    xs := c.P.T.Items(l)
    n := xs.Len()
    if n > 0 and c.P.T.KindOf(xs[n - 1]) == types.Kind.ErrSet and c.P.T.ErrSetItems(xs[n - 1]) == types.ListId(0) { n-- }
    if n == 0 { return }
    b.Push("<")
    was := c.spellItem
    c.spellItem = true
    for i in range n {
        if c.P.T.KindOf(xs[i]) == types.Kind.ErrSet {
            b.Push(" ? " if i > 0 else "? ")
        } else if i > 0 {
            b.Push(", ")
        }
        c.spell(b, xs[i], false)
    }
    c.spellItem = was
    b.Push(">")
}

fn primName(t types.TypeId) String& {
    return match I64(t) {
        case 3 => "I8"
        case 4 => "I16"
        case 5 => "I32"
        case 6 => "I64"
        case 7 => "U8"
        case 8 => "U16"
        case 9 => "U32"
        case 10 => "U64"
        case 11 => "F16"
        case 12 => "BF16"
        case 13 => "F32"
        case 14 => "F64"
        case _ => "?"
    }
}

# ---- types ----

fn (c mut Checker&) i64() types.TypeId { return c.P.T.Prim("I64") }

fn (c mut Checker&) textType() types.TypeId {
    if c.textT < types.TypeId(0) { c.textT = c.P.PreludeType("std/prelude/text", "String") }
    return c.textT
}

# the prelude's Place (E40)
fn (c mut Checker&) placeType() types.TypeId {
    if c.placeT < types.TypeId(0) { c.placeT = c.P.PreludeType("std/prelude/place", "Place") }
    return c.placeT
}

fn (c mut Checker&) charType() types.TypeId {
    if c.charT < types.TypeId(0) { c.charT = c.P.PreludeType("std/prelude/text", "Char") }
    return c.charT
}

fn (c mut Checker&) isRef(t types.TypeId) Bool { return c.P.T.KindOf(t) == types.Kind.Ref }

# a reference's referent, or the type itself
fn (c mut Checker&) deref(t types.TypeId) types.TypeId { return c.P.T.Referent(t) if c.isRef(t) else t }

fn (c mut Checker&) declKind(t types.TypeId) types.DeclKind { return c.P.T.DeclKindOf(c.P.T.DeclOf(t)) }

fn (c mut Checker&) isNamed(t types.TypeId) Bool { return c.P.T.KindOf(t) == types.Kind.Named }
# T20: an error type named where a value's type is written is the error value's type
fn (c mut Checker&) errValueType(t types.TypeId) types.TypeId {
    if c.isNamed(t) and c.declKind(t) == types.DeclKind.Error { return c.P.ErrValOfType(t) }
    return t
}

# whether t is a type declared over another (T29), its body known
fn (c mut Checker&) isOver(t types.TypeId) Bool {
    return c.isNamed(t) and c.declKind(t) == types.DeclKind.Over and c.P.Body(t)
}

# what a type is past declared types over others (T29): itself where it is none
fn (c mut Checker&) under(t types.TypeId) types.TypeId {
    r := t
    for _ in range 32 {
        if not c.isOver(r) { return r }
        r = c.P.T.Base(r)
    }
    return r
}

fn (c mut Checker&) isNumber(t types.TypeId) Bool { return c.P.T.IsNumber(c.under(t)) }

fn (c mut Checker&) isInt(t types.TypeId) Bool { return c.P.T.IsInt(c.under(t)) }

# the array type a type is, past references and declared types over arrays (T29); Unknown where it is none
fn (c mut Checker&) arrayOf(t types.TypeId) types.TypeId {
    r := c.under(c.deref(t))
    return r if c.P.T.KindOf(r) == types.Kind.Array else types.UnknownT
}

fn (c mut Checker&) isStruct(t types.TypeId) Bool {
    return c.isNamed(t) and c.declKind(t) == types.DeclKind.Struct and c.P.Body(t)
}

# whether t - or what a reference t names - is a struct type declaring a destructor (C7, C9b)
fn (c mut Checker&) destructs(t types.TypeId) Bool {
    r := c.P.T.Repr(c.deref(t))
    return c.isStruct(r) and c.P.T.Destructs(r)
}

fn (c mut Checker&) isEnum(t types.TypeId) Bool {
    return c.isNamed(t) and c.declKind(t) == types.DeclKind.Enum and c.P.Body(t)
}

# a written type read in the current body's context
fn (c mut Checker&) resolve(t ast.TypeRef?&) types.TypeId {
    if t is null { return types.UnknownT }
    # G16b: a type instance written here is asked for at its first type argument
    asking := c.P.Asking
    at := t.Span()
    match t {
        case ast.TypeRef.Named(_, _, args) {
            if args.Len() > 0 { at = c.leadWord(args[0].Span()) }
        }
        nomatch { }
    }
    c.P.Asking = generic.Origin(c.fr().File, at, c.curInst())
    r := c.P.Resolve(c.fr().Ctx, t)
    c.P.Asking = asking
    if not c.writtenMet(t) { return types.UnknownT }   # what was said of it is the one error
    return r
}

# whether the body being checked has a result scope (O13): a result it builds
fn (c mut Checker&) hasResultScope() Bool {
    if c.fr().Body < 0 { return false }
    for v in c.P.T.ScopeVarsOf(c.cur().Ty) {
        if v == types.ResultVar { return true }
    }
    return false
}

# what a written type says about where its reference lives (O3, O25a)
fn (c mut Checker&) markOf(t ast.TypeRef?&) typed.Mark {
    if t is null { return typed.Mark.Infer }
    match t {
        case ast.TypeRef.Ref(sp, _, sc, _) {
            if sc == source.NameId(0) { return typed.Mark.Bare }
            if c.text(sc) == "return" {
                # O26: only where there is a result scope - a result built, not one borrowed or none; a generator's is
                # one Next call's, which its locals outlive (D18b)
                if c.fr().Gen {
                    # D18c: where its elements live there, storage its walk keeps - where the generator lives
                    if c.fr().GenHome >= 0 { return typed.Mark.Of(typed.LocalId(I32(c.fr().GenHome))) }
                    c.err(sp, msgs.GenReturnScope())
                } else if not c.hasResultScope() {
                    c.err(sp, msgs.ReturnScopeNone())
                }
                return typed.Mark.Return
            }
            # in a lambda, a variable of a body around it is its capture (D16c)
            id := c.localOrCapture(sc, sp)
            if id >= 0 { return typed.Mark.Of(typed.LocalId(I32(id))) }
            return typed.Mark.Global(c.fr().Mi, sc)
        }
        case ast.TypeRef.Perm(_, of, _, _) { return c.markOf(of) }
        case ast.TypeRef.Named(_, _, _) {
            # a local written as a bare type variable takes its initializer's scope (O25a)
            return typed.Mark.Infer if c.namesTypeVar(t) else typed.Mark.None
        }
        nomatch { return typed.Mark.None }
    }
}

# the type a written name or alias path names (a primitive, Bool, a declared type of no parameters); -1 for none
fn (c mut Checker&) typeNamed(x ast.Expr&) types.TypeId {
    match x {
        case ast.Expr.Name(sp, n) {
            ref := c.P.R.Use(c.fr().File, sp.Start)
            if ref.Kind == names.What.Builtin {
                t := c.builtinType(n)
                return t if t != types.UnknownT else types.TypeId(-1)
            }
            if ref.Kind == names.What.Type and ref.Index >= 0 { return c.declType(c.P.DeclFor(ref.Module, ref.Index)) }
            if ref.Kind == names.What.TypeVar or ref.Kind == names.What.None {
                # a type variable bound here stands where a type's name may (G8b): T[a, b], x is T - and so does a name a
                # type case binds (G36)
                t := try c.fr().Ctx.Vars.Get(n) catch default types.TypeId(-1)
                if t >= types.TypeId(0) and c.P.T.KindOf(t) != types.Kind.Const and c.P.T.KindOf(t) != types.Kind.ConstExpr { return t }
            }
        }
        case ast.Expr.Member(sp, _, _) {
            ref := c.P.R.Member(c.fr().File, sp.End)
            if ref.Kind == names.What.Type and ref.Index >= 0 { return c.declType(c.P.DeclFor(ref.Module, ref.Index)) }
        }
        case ast.Expr.Generic(sp, g, targs) {
            # G6b: a generic enum's instance written with its arguments, "Tree<I64>.Leaf(3)"
            d := c.genericNamed(g)
            if d < types.DeclId(0) or c.P.T.DeclKindOf(d) != types.DeclKind.Enum { return types.TypeId(-1) }
            path := typePathOf(g)
            if path.Len() == 0 { return types.TypeId(-1) }
            if path.Len() == 1 {
                t := c.resolve(ast.TypeRef.Named(sp, path, targs))
                return t if t != types.UnknownT else types.TypeId(-1)
            }
            # through an import ("lib.Opt<I64>.None"): the declaration is known, its arguments applied (G8)
            if not c.P.ArgsFit(d, targs) {
                c.err(targs[0].Span() if targs.Len() > 0 else sp, msgs.TypeArgCount(c.text(path[path.Len() - 1]), c.P.WrittenArity(d), generic.WrittenTypes(targs)))
                return types.TypeId(-1)
            }
            t := c.P.Apply(c.fr().Ctx, d, targs)
            if t == types.UnknownT or not c.instancesMet(t, sp) or not c.P.Body(t) { return types.TypeId(-1) }
            return t
        }
        nomatch { }
    }
    return types.TypeId(-1)
}

# G6b: the generic type declaration a name names - "Tree", "lib.Tree" - written without its arguments; -1 for none
fn (c mut Checker&) genericNamed(x ast.Expr&) types.DeclId {
    match x {
        case ast.Expr.Name(sp, _) {
            ref := c.P.R.Use(c.fr().File, sp.Start)
            if ref.Kind == names.What.Type and ref.Index >= 0 {
                d := c.P.DeclFor(ref.Module, ref.Index)
                if c.P.T.DeclParams(d) > 0 { return d }
            }
        }
        case ast.Expr.Member(sp, _, _) {
            ref := c.P.R.Member(c.fr().File, sp.End)
            if ref.Kind == names.What.Type and ref.Index >= 0 {
                d := c.P.DeclFor(ref.Module, ref.Index)
                if c.P.T.DeclParams(d) > 0 { return d }
            }
        }
        nomatch { }
    }
    return types.DeclId(-1)
}

# the names of a path written as an expression - "Tree", "lib.Tree" - in order; none where it is no path
fn typePathOf(x ast.Expr&) Array<source.NameId>&x {
    match x {
        case ast.Expr.Name(_, n) { return Array<source.NameId>(1, n) }
        case ast.Expr.Member(_, b, n) {
            pre := typePathOf(b)
            if pre.Len() == 0 { return pre }
            out := Array<source.NameId>(pre.Len() + 1)
            for i in range pre.Len() { out[i] = pre[i] }
            out[pre.Len()] = n
            return out
        }
        nomatch { return Array<source.NameId>(0) }
    }
}

# G6b: the enum a pattern's or a case test's path names, compared with et: et itself, or et's generic declaration
# named bare ("Tree.Leaf" against a Tree<I64>) - the case then et's own
fn (c mut Checker&) namesEnumOf(prefix ast.Expr&, et types.TypeId) Bool {
    t := c.typeNamed(prefix)
    if t >= types.TypeId(0) {
        if c.P.T.Same(t, et) { return true }
        if c.P.T.KindOf(t) != types.Kind.Named or c.P.T.KindOf(et) != types.Kind.Named or c.P.T.DeclOf(t) != c.P.T.DeclOf(et) { return false }
        # one declaration: the same type, unless it is generic and the instance written is another ("Opt<F64>.Some"
        # against an Opt<I64>)
        return c.P.T.DeclParams(c.P.T.DeclOf(t)) == 0 or c.P.T.Same(c.P.T.Plain(t), c.P.T.Plain(et))
    }
    d := c.genericNamed(prefix)
    return d >= types.DeclId(0) and c.P.T.KindOf(et) == types.Kind.Named and c.P.T.DeclOf(et) == d
}

fn (c mut Checker&) declType(d types.DeclId) types.TypeId {
    if c.P.T.DeclParams(d) > 0 { return types.TypeId(-1) }
    return c.P.T.Named(d, types.ListId(0))
}

fn (c mut Checker&) builtinType(n source.NameId) types.TypeId {
    t := c.text(n)
    if t == "Bool" { return types.BoolT }
    if t == "Array" { return types.UnknownT }
    return c.P.T.Prim(t)
}

# ---- reading the typed tree ----

fn typeOf(x typed.Expr?&) types.TypeId {
    if x is null { return types.VoidT }
    return x.Type()
}

# the place a value reads; null where it is no Read
fn readPlace(x typed.Expr&) typed.Lvalue?&x {
    match x {
        case typed.Expr.Read(_, _, p, _) { return p }
        nomatch { return null }
    }
}

fn isData(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Data(_, _, _, _) { return true }
        nomatch { return false }
    }
}

fn (c mut Checker&) unknown(sp source.Span) typed.Expr&c {
    c.unknowns++
    return typed.Expr.Lit(sp, types.UnknownT, 0)
}

# a slot's stand-in until what it holds is written into it: no expression of the program's, so not counted as one that
# did not check (K1a's counter - a top-level condition with a comparison chain of literals was refused with nothing said,
# and never decided)
fn (c mut Checker&) hole(sp source.Span) typed.Expr&c { return typed.Expr.Lit(sp, types.UnknownT, 0) }

fn (c mut Checker&) lit(sp source.Span, t types.TypeId, bits I64) typed.Expr&c { return typed.Expr.Lit(sp, t, bits) }

fn (c mut Checker&) read(sp source.Span, p typed.Lvalue&c) typed.Expr&c {
    return typed.Expr.Read(sp, p.Type(), p, typed.SiteId(-1))
}

# what a check that fails as written can fail with (E15a, R20): a word of a prelude error type, as an error set's entry
# (R1c) - an index or a slice out of range ArrayError.OUT_OF_RANGE, a narrowing NumberError.OVERFLOW or INVALID, an "as"
# naming another case CaseError.WRONG_CASE
fn (c mut Checker&) preludeWord(identity String&, name String&, word String&) types.TypeId {
    t := c.P.PreludeType(identity, name)
    if t == types.UnknownT { return t }
    ws := c.P.ErrorWords(c.P.T.DeclOf(t))
    for i in range ws.Len() {
        if c.text(ws[i]) == word { return c.P.T.ErrWords(t, U64(1) << i) }
    }
    return types.UnknownT
}

fn (c mut Checker&) outOfRange() types.TypeId { return c.preludeWord("std/prelude/array", "ArrayError", "OUT_OF_RANGE") }

fn (c mut Checker&) wrongCase() types.TypeId { return c.preludeWord("std/prelude/enums", "CaseError", "WRONG_CASE") }

# a check that fails as written (E15a): a.Get(i), a.SliceOf(lo, hi), x.Narrow<T>(), e as C - Try, failing with what
# the operation names, into the innermost try, "!" or catch; written with none of them it is said at at, as an
# unhandled call is (E15)
fn (c mut Checker&) failOp(fails Array<types.TypeId>&, at source.Span, isAs Bool = false) typed.Check {
    fr := c.fr()
    fr.Fallible++
    for e in fails {
        if e != types.UnknownT { c.leaks1(e) }
    }
    if fr.Tries == 0 { c.err(at, msgs.AsCanFail() if isAs else msgs.UnhandledFallibleCall()) }
    return typed.Check.Try
}

# what a narrowing between numbers can fail with (E26b): a float to an integer NaN or out of range (INVALID, OVERFLOW),
# a narrowing float infinite, an integer changing value (OVERFLOW) - nothing where every value fits
fn (c mut Checker&) convWords(from types.TypeId, to types.TypeId) Array<types.TypeId>& {
    f := c.under(from)
    t := c.under(to)
    over := c.preludeWord("std/prelude/number", "NumberError", "OVERFLOW")
    none := Array<types.TypeId>(0)
    if c.P.T.IsFloat(f) and not c.P.T.IsFloat(t) { return types.TypeId[c.preludeWord("std/prelude/number", "NumberError", "INVALID"), over] }
    if c.P.T.IsFloat(f) { return types.TypeId[over] if c.P.T.Bits(t) < c.P.T.Bits(f) or t != f else none }
    if c.P.T.IsFloat(t) { return types.TypeId[over] if c.P.T.Bits(t) <= 16 else none }
    if c.P.Meet(f, t) == t { return none }
    return types.TypeId[over]
}

fn (c mut Checker&) prim(sp source.Span, t types.TypeId, op typed.PrimOp, a typed.Expr&c, b typed.Expr?&c) typed.Expr&c {
    from := c.exprs.Len()
    c.exprs.Push(a)
    if b is not null { c.exprs.Push(b) }
    return typed.Expr.Prim(sp, t, op, typed.Check.None, gather(c.exprs, from))
}

fn (c mut Checker&) negate(sp source.Span, x typed.Expr&c) typed.Expr&c {
    return c.prim(sp, types.BoolT, typed.PrimOp.Not, x, null)
}

fn (c mut Checker&) convert(sp source.Span, x typed.Expr&c, want types.TypeId) typed.Expr&c {
    return c.prim(sp, want, typed.PrimOp.Convert, x, null)
}

# a call of a known target with checked arguments
fn (c mut Checker&) callOf(sp source.Span, t types.TypeId, target typed.Callee&c, args Array<typed.Expr&>&c) typed.Expr&c {
    return typed.Expr.Call(sp, t, typed.Call(target, args, typed.Mark.None, c.site(typed.SiteKind.Call, sp)))
}

# ---- literals (L10-L14, T6, T6a, E4a) ----

# a literal-only expression's value (E4a): an integer exactly, a float in F64; Ok false where it is no such expression
type litv struct(Ok Bool, IsFloat Bool, Big Bool, I I64, F F64) {
    Ok
    IsFloat
    Big        # an integer above I64's maximum: I holds a U64's bits (L10)
    I
    F
    Hex Bool = false   # a hex or binary pattern: I its bits, read unsigned where an unsigned type is wanted (L10a)
    # an integer past 64 bits - below I64's least or above U64's greatest, up to I128's least and U128's greatest
    # (E4a): Neg and W its sign and magnitude, Big set too, so a reader of the 64-bit view I takes it for no I64
    Wide Bool = false
    Neg Bool = false
    W U128 = 0
}

# an integer literal value past 64 bits, its sign and magnitude (E4a, T4a)
fn wideLit(neg Bool, m U128) litv {
    v := litv(true, false, true, I64(U64(m & U128(U64(0) - 1))), 0.0)
    v.Wide = true
    v.Neg = neg
    v.W = m
    return v
}

# E4a: whether x is a number written as a literal - a numeric literal, alone, negated or in parentheses, or arithmetic
# of such (E4a's literal-only expression), whatever it folds to
fn numberLitsOnly(x ast.Expr?&) Bool {
    if x is null { return false }
    return match x {
        case ast.Expr.Lit(_, kind) => kind == token.Tok.IntLit or kind == token.Tok.FloatLit
        case ast.Expr.Paren(_, y) => numberLitsOnly(y)
        case ast.Expr.Unary(_, op, y) => (op == token.Tok.Minus or op == token.Tok.Tilde) and numberLitsOnly(y)
        case ast.Expr.Binary(_, op, a, b) => (op == token.Tok.Plus or op == token.Tok.Minus or op == token.Tok.Star
            or op == token.Tok.Slash or op == token.Tok.Percent or op == token.Tok.Amp or op == token.Tok.Pipe
            or op == token.Tok.Caret or op == token.Tok.Shl or op == token.Tok.Shr) and numberLitsOnly(a) and numberLitsOnly(b)
        case _ => false
    }
}

fn noLit() litv { return litv(false, false, false, 0, 0.0) }

fn intLit(v I64) litv { return litv(true, false, false, v, 0.0) }

fn floatLit(f F64) litv { return litv(true, true, false, 0, f) }

fn (c mut Checker&) fold(x ast.Expr?&) litv {
    if x is null { return noLit() }
    match x {
        case ast.Expr.Lit(sp, kind) {
            text := c.src(sp)
            if kind == token.Tok.IntLit {
                if text.Len() > 2 and text[0] == '0' and (text[1] == 'x' or text[1] == 'X' or text[1] == 'b' or text[1] == 'B') {
                    # L10a: a pattern of at most 64 bits keeps both readings; a wider one is its unsigned value
                    u := try text.ParseUint(0) catch { return ofMag(false, try wideDigits(text) catch { return noLit() }) }
                    h := intLit(I64(u))
                    h.Hex = true
                    return h
                }
                v := try text.ParseInt(0) catch {
                    u := try text.ParseUint(0) catch { return ofMag(false, try wideDigits(text) catch { return noLit() }) }
                    return litv(true, false, true, I64(u), 0.0)
                }
                return intLit(v)
            }
            if kind == token.Tok.FloatLit {
                clean := text.Replace("_", "")
                f := try clean.ParseFloat() catch { return noLit() }
                return floatLit(f)
            }
            return noLit()
        }
        case ast.Expr.Paren(_, y) { return c.fold(y) }
        case ast.Expr.Unary(_, op, y) {
            v := c.fold(y)
            if not v.Ok { return noLit() }
            if op == token.Tok.Minus {
                if v.IsFloat { return floatLit(-v.F) }
                n, m := magOf(v)
                return ofMag(not n, m) if m != U128(0) else intLit(0)
            }
            if op == token.Tok.Tilde and not v.IsFloat and not v.Big {
                r := intLit(~v.I)
                r.Hex = v.Hex
                return r
            }
            return noLit()
        }
        case ast.Expr.Binary(_, op, a, b) {
            va := c.foldPart(a)
            vb := c.foldPart(b)
            if not va.Ok or not vb.Ok { return noLit() }
            if va.IsFloat or vb.IsFloat {
                if va.Big or vb.Big { return noLit() }
                fa := va.F if va.IsFloat else F64(va.I)
                fb := vb.F if vb.IsFloat else F64(vb.I)
                if op == token.Tok.Plus { return floatLit(fa + fb) }
                if op == token.Tok.Minus { return floatLit(fa - fb) }
                if op == token.Tok.Star { return floatLit(fa * fb) }
                if op == token.Tok.Slash { return floatLit(fa / fb) }
                return noLit()
            }
            na, ma := magOf(va)
            nb, mb := magOf(vb)
            if op == token.Tok.Plus { return addMag(na, ma, nb, mb) }
            if op == token.Tok.Minus { return addMag(na, ma, not nb, mb) }
            if op == token.Tok.Star {
                if ma != U128(0) and mb > ~U128(0) / ma { return noLit() }
                p := ma * mb
                return ofMag(na != nb and p != U128(0), p)
            }
            if op == token.Tok.Amp or op == token.Tok.Pipe or op == token.Tok.Caret {
                if va.Wide or vb.Wide { return wideBits(op, va, vb) }
                r := va.I & vb.I if op == token.Tok.Amp else va.I | vb.I if op == token.Tok.Pipe else va.I ^ vb.I
                out := intLit(r)
                if (va.Big or vb.Big) and r < 0 { out = litv(true, false, true, r, 0.0) }
                out.Hex = va.Hex or vb.Hex
                return out
            }
            # E4a: a shift by an amount within 128 bits, exactly - a 64-bit pattern shifted left is its bits (L10a)
            if (op == token.Tok.Shl or op == token.Tok.Shr) and not vb.Big and vb.I >= 0 and vb.I < 128 {
                y := U128(vb.I)
                if op == token.Tok.Shl {
                    if na and va.Hex and not va.Wide { na, ma = false, U128(U64(va.I)) }
                    if na { return noLit() }
                    m := ma << y
                    if (m >> y) != ma { return noLit() }
                    return ofMag(false, m)
                }
                if va.Wide or va.Big or vb.I >= 64 {
                    # the floor of x over 2^y: a negative one rounds away from zero
                    if not na { return ofMag(false, ma >> y) }
                    return ofMag(true, ((ma - 1) >> y) + 1)
                }
                return intLit(va.I >> vb.I)
            }
            if va.Wide or vb.Wide {
                # E4a: a quotient or remainder past 64 bits, truncated toward zero as an integer type's is
                if mb == U128(0) { return noLit() }
                if op == token.Tok.Slash { return ofMag(na != nb, ma / mb) }
                if op == token.Tok.Percent { return ofMag(na, ma % mb) }
                return noLit()
            }
            if va.Big or vb.Big { return noLit() }
            x1 := va.I
            y1 := vb.I
            if op == token.Tok.Slash and y1 != 0 and not (x1 == I64(-9223372036854775807) - 1 and y1 == -1) { return intLit(x1 / y1) }
            if op == token.Tok.Percent and y1 != 0 and y1 != -1 { return intLit(x1 % y1) }
            return noLit()
        }
        nomatch { return noLit() }
    }
}

# whether a literal-only expression's own type is U64 (T6a): a literal above I64's maximum in it, which the others meet
fn (c mut Checker&) litU64(x ast.Expr&) Bool {
    return match x {
        case ast.Expr.Paren(_, y), ast.Expr.Unary(_, _, y) => c.litU64(y)
        case ast.Expr.Binary(_, _, a, b) => c.litU64(a) or c.litU64(b)
        case _ => c.fold(x).Big
    }
}

# an operand of a literal-only operation folded: a character literal there is its code, an integer literal (T6a, as
# stage 0: 'a' + 1 is the I64 98)
fn (c mut Checker&) foldPart(x ast.Expr&) litv {
    match x {
        case ast.Expr.Lit(sp, kind) {
            if kind == token.Tok.CharLit { return intLit(c.charValue(sp)) }
        }
        case _ { }
    }
    return c.fold(x)
}

# an integer literal value's sign and magnitude: exact for every value E4a computes, from I128's least to U128's greatest
fn magOf(v litv) Bool, U128 {
    if v.Wide { return v.Neg, v.W }
    if v.Big { return false, U128(U64(v.I)) }
    if v.I < 0 { return true, U128(U64(0) - U64(v.I)) }
    return false, U128(U64(v.I))
}

# the literal value of a sign and magnitude: an I64, a U64 above I64's maximum (L10), a value past both up to I128's
# least and U128's greatest (E4a, T4a), or none beyond those
fn ofMag(neg Bool, m U128) litv {
    if m == U128(0) { return intLit(0) }
    lim := U128(1) << 63
    if not neg {
        if m < lim { return intLit(I64(m)) }
        if m < (U128(1) << 64) { return litv(true, false, true, I64(m), 0.0) }
        return wideLit(false, m)
    }
    if m <= lim { return intLit(I64(U64(0) - U64(m))) }
    if m <= (U128(1) << 127) { return wideLit(true, m) }
    return noLit()
}

fn addMag(na Bool, ma U128, nb Bool, mb U128) litv {
    if na == nb {
        s := ma + mb
        if s < ma { return noLit() }
        return ofMag(na, s)
    }
    if ma >= mb { return ofMag(na, ma - mb) }
    return ofMag(nb, mb - ma)
}

# E4a: & | ^ on values past 64 bits, in two's complement wide enough for both: a 64-bit pattern is its bits there (L10a)
fn wideBits(op token.Tok, va litv, vb litv) litv {
    ea, ba := twos(va)
    eb, bb := twos(vb)
    e := ea and eb if op == token.Tok.Amp else ea or eb if op == token.Tok.Pipe else ea != eb
    r := ba & bb if op == token.Tok.Amp else ba | bb if op == token.Tok.Pipe else ba ^ bb
    if not e { return ofMag(false, r) }
    if r == U128(0) { return noLit() }
    return ofMag(true, U128(0) - r)
}

# a value as its sign extension and its low 128 bits
fn twos(v litv) Bool, U128 {
    if v.Hex and not v.Wide { return false, U128(U64(v.I)) }
    n, m := magOf(v)
    if n { return true, U128(0) - m }
    return false, m
}

# the digits of an integer literal no 64 bits hold, as an unsigned 128-bit value (L10, L10a); separators were checked by
# the scanner (L10b)
fn wideDigits(text String&) U128 ? ParseError {
    t := text.Replace("_", "")
    if t.Len() > 2 and t[0] == '0' and (t[1] == 'x' or t[1] == 'X') { return try t[2:].ParseAs<U128>(16) }
    if t.Len() > 2 and t[0] == '0' and (t[1] == 'b' or t[1] == 'B') { return try t[2:].ParseAs<U128>(2) }
    return try t.ParseAs<U128>(10)
}

# a literal-only expression's value as a literal of the type wanted, or of its own (T6a: I64, F64; a U64 above I64's
# maximum); T6 where it does not fit
fn (c mut Checker&) litOf(x ast.Expr&, v litv, want types.TypeId) typed.Expr&c {
    sp := x.Span()
    target := c.under(want)
    if not c.P.T.IsNumber(target) and v.Wide {
        # T6a, E4a: a value past 64 bits has no type of its own - only a type it adapts to holds it
        c.err(c.opOf(x) if c.opOf(x) != sp else sp, msgs.LiteralNoOwnType(msgs.Tok(c.src(sp)) if c.opOf(x) == sp else "this literal expression's value"))
        return c.unknown(sp)
    }
    if not c.P.T.IsNumber(target) {
        # T6a, E4a: a U64 literal's expression is a U64 - but a negative value, I64's least (L10) among them, an I64
        want = c.P.T.Prim("F64") if v.IsFloat else c.P.T.Prim("U64") if v.Big or (c.litU64(x) and v.I >= 0) else c.i64()
        target = want
    }
    if v.IsFloat {
        if (v.F > 1.7976931348623157e308 or v.F < -1.7976931348623157e308) and c.overflowsF64(x) {
            # L12b, E4a: a float literal - or a literal expression of finite operands - beyond F64's range would be an
            # infinity (a division by zero gives one, as IEEE's does)
            if c.opOf(x) != sp {
                c.err(c.opOf(x), msgs.LiteralExprRange("F64"))
            } else {
                c.err(sp, msgs.FloatLiteralRange(msgs.Tok(c.src(sp))))
            }
            return c.unknown(sp)
        }
        if not c.P.T.IsFloat(target) {
            c.err(sp, msgs.TypeMismatch(c.ty(want), "F64"))
            return c.unknown(sp)
        }
        if floatOverflows(target, v.F) {
            c.err(sp, msgs.LiteralRange(msgs.Tok(c.src(sp)), c.ty(want)))
            return c.unknown(sp)
        }
        return c.lit(sp, want, floatBits(target, v.F))
    }
    if c.P.T.IsFloat(target) {
        # T6: an integer literal adapts to a float type it does not overflow
        if floatOverflows(target, litF64(v)) {
            c.err(sp, msgs.LiteralRange(msgs.Tok(c.src(sp)), c.ty(want)))
            return c.unknown(sp)
        }
        return c.lit(sp, want, intFloatBits(target, v))
    }
    if not intFits(c.P.T, v, target) {
        if c.opOf(x) != sp {
            c.err(c.opOf(x), msgs.LiteralExprRange(c.ty(want)))
        } else {
            c.err(sp, msgs.LiteralRange(msgs.Tok(c.src(sp)), c.ty(want)))
        }
        return c.unknown(sp)
    }
    if v.Wide {
        # E4a, T4a: a value past 64 bits is made of its two words, a constant holding 64 bits (MIR's Const): the high
        # word, sign-extended and shifted, beside the low one, zero-extended
        b := (U128(0) - v.W) if v.Neg else v.W
        hi := c.convert(sp, c.lit(sp, c.i64(), I64(b >> 64)), want)
        lo := c.convert(sp, c.lit(sp, c.P.T.Prim("U64"), I64(b)), want)
        return c.prim(sp, want, typed.PrimOp.BitOr, c.prim(sp, want, typed.PrimOp.Shl, hi, c.lit(sp, c.i64(), 64)), lo)
    }
    if v.Big and not c.P.T.IsUnsigned(target) {
        # T4a: a literal above I64's maximum in a signed type wider than 64 bits - a constant holds a wide signed type's
        # value sign-extended from 64 bits (MIR's Const), so it is the U64 literal widened
        return c.prim(sp, want, typed.PrimOp.Convert, c.lit(sp, c.P.T.Prim("U64"), v.I), null)
    }
    return c.lit(sp, want, v.I)
}

# an integer literal's value as an F64, rounded once (a test of a float type's range, T6)
fn litF64(v litv) F64 {
    if v.Wide { return -F64(v.W) if v.Neg else F64(v.W) }
    return F64(U64(v.I)) if v.Big else F64(v.I)
}

# whether a finite value rounds to an infinity in a narrower float type (T6, L12b)
fn floatOverflows(t types.TypeId, f F64) Bool {
    if f > 1.7976931348623157e308 or f < -1.7976931348623157e308 { return false }
    r := f
    if t == types.TypeId(13) { r = F64(F32(f)) }
    if t == types.TypeId(11) { r = F64(F16(f)) }
    if t == types.TypeId(12) { r = F64(BF16(f)) }
    return r > 1.7976931348623157e308 or r < -1.7976931348623157e308
}

fn (c mut Checker&) overflowsF64(x ast.Expr&) Bool {
    match x {
        case ast.Expr.Paren(_, y) { return c.overflowsF64(y) }
        case ast.Expr.Binary(_, op, a, b) {
            if op == token.Tok.Slash { return false }
            fa := c.fold(a)
            fb := c.fold(b)
            fin := fn(v litv) Bool { return not v.IsFloat or (v.F <= 1.7976931348623157e308 and v.F >= -1.7976931348623157e308) }
            return fin(fa) and fin(fb)
        }
        nomatch { return true }
    }
}

# an integer literal's value as a float type's bits, rounded once (T4: never through F64 first)
fn intFloatBits(t types.TypeId, v litv) I64 {
    if v.Wide {
        # rounded once from the magnitude, then the sign: rounding to nearest is symmetric
        m := v.W
        if t == types.TypeId(13) { return I64((-F32(m) if v.Neg else F32(m)).Bits()) }
        if t == types.TypeId(12) { return I64((-BF16(m) if v.Neg else BF16(m)).Bits()) }
        if t == types.TypeId(11) { return I64((-F16(m) if v.Neg else F16(m)).Bits()) }
        return I64((-F64(m) if v.Neg else F64(m)).Bits())
    }
    if v.Big {
        u := U64(v.I)
        if t == types.TypeId(13) { return I64(F32(u).Bits()) }
        if t == types.TypeId(12) { return I64(BF16(u).Bits()) }
        if t == types.TypeId(11) { return I64(F16(u).Bits()) }
        return I64(F64(u).Bits())
    }
    if t == types.TypeId(13) { return I64(F32(v.I).Bits()) }
    if t == types.TypeId(12) { return I64(BF16(v.I).Bits()) }
    if t == types.TypeId(11) { return I64(F16(v.I).Bits()) }
    return I64(F64(v.I).Bits())
}

fn floatBits(t types.TypeId, f F64) I64 {
    if t == types.TypeId(13) { return I64(F32(f).Bits()) }
    if t == types.TypeId(11) { return I64(F16(f).Bits()) }
    if t == types.TypeId(12) { return I64(BF16(f).Bits()) }
    return I64(f.Bits())
}

fn intFits(tt types.Table&, v litv, t types.TypeId) Bool {
    bits := tt.Bits(t)
    if v.Wide {
        # E4a, T4a: a value past 64 bits, in a type of up to 128
        if bits <= 64 { return false }
        if tt.IsUnsigned(t) { return not v.Neg and (bits == 128 or v.W < (U128(1) << U128(bits))) }
        lim := U128(1) << U128(bits - 1)
        return v.W <= lim if v.Neg else v.W < lim
    }
    if tt.IsUnsigned(t) {
        if v.Big { return bits >= 64 }
        if v.Hex { return bits >= 64 or (v.I >= 0 and (bits == 63 or v.I < (I64(1) << bits))) }
        if v.I < 0 { return false }
        return bits >= 63 or v.I < (I64(1) << bits)
    }
    if v.Big { return bits > 64 }
    if bits >= 64 { return true }
    lim := I64(1) << (bits - 1)
    return v.I >= -lim and v.I < lim
}

fn (c mut Checker&) litFits(v litv, t types.TypeId) Bool {
    u := c.under(t)
    if not c.P.T.IsNumber(u) { return false }
    if v.IsFloat { return c.P.T.IsFloat(u) and not floatOverflows(u, v.F) }
    if c.P.T.IsFloat(u) { return not floatOverflows(u, litF64(v)) }
    return intFits(c.P.T, v, u)
}

# a character literal's byte (L13, L15)
fn (c mut Checker&) charValue(sp source.Span) I64 {
    b := scan.LiteralBytes(c.src(sp))
    return I64(b[0]) if b.Len() > 0 else 0
}

# a text literal's bytes, its escapes decoded (L14, L15), raw text as it stands (L14a)
fn (c mut Checker&) strBytes(sp source.Span) Array<U8>&c { return scan.LiteralBytes(c.src(sp)) }

# E38: "embed PATH" - the bytes of the file PATH names, read while compiling: constant data as text written in the
# program is (T25d), a read-only Array<U8>& of the length the file has. A literal path is read here; any other is the
# body of a function giving it, evaluated once the program has checked (interp's decide) and read in the next check -
# until then the bytes are none. A path the evaluator cannot compute, or a file that cannot be read, is an error here
fn (c mut Checker&) embed(sp source.Span, y ast.Expr&) typed.Expr&c {
    fr := c.fr()
    bt := c.P.T.Ref(c.P.T.Array(types.TypeId(7), types.TypeId(0)), types.ReadOnly)
    # what an embed that is wrong gives: no bytes, of its type still - its body is faulty, so never evaluated (K1a)
    none := typed.Expr.Data(sp, bt, fr.File, typed.Const.Bytes(Array<U8>(0)))
    path := ""
    match y {
        case ast.Expr.Lit(lsp, token.Tok.StrLit) {
            bs := c.strBytes(lsp)
            b := StringBuilder()
            for x in bs { b.PushChar(Char(x)) }
            path = b.ToString()
        }
        nomatch {
            key := pair.Pair(fr.File, I64(sp.Start))
            if c.P.Embeds.Has(key) {
                path = try c.P.Embeds.Get(key) catch default "\0"
                if path == "\0" {
                    c.err(y.Span(), msgs.EmbedPathUndecided())
                    return none
                }
            } else {
                b := c.ExprBody(fr.Mi, y, c.textType())
                if b < 0 {
                    c.err(y.Span(), msgs.EmbedPathUnknown())
                    return none
                }
                c.EmbedAsks.Push(EmbedAsk(b, fr.File, sp.Start))
                return none
            }
        }
    }
    bytes, why := c.P.L.Embed(fr.Mi, path)
    if why != "" {
        c.err(y.Span(), msgs.EmbedNotRead(msgs.Tok(path), why))
        return none
    }
    return typed.Expr.Data(sp, bt, fr.File, typed.Const.Bytes(bytes))
}

# text written in the program: constant data, a read-only String reference (T25d, T29c)
fn (c mut Checker&) textLit(sp source.Span) typed.Expr&c {
    return typed.Expr.Data(sp, c.P.T.Ref(c.textType(), types.ReadOnly), c.fr().File, typed.Const.Bytes(c.strBytes(sp)))
}

# ---- fitting a value to a type (E12, T6b, T25c, T29a) ----

# a checked value made to fit a type: itself, widened (T6b), borrowed or promoted (E12c), copied out of a reference
# (E12), null adapted (T2a); E12's error where nothing makes it fit
fn (c mut Checker&) fit(x typed.Expr&c, want types.TypeId, sp source.Span) typed.Expr&c {
    have := typeOf(x)
    if want == types.UnknownT or have == types.UnknownT or want == types.VoidT { return x }
    # a reference to a type not known was said where the type is written (B11)
    if c.deref(want) == types.UnknownT or c.deref(have) == types.UnknownT { return x }
    # T22: one type but for where a function type's references live - fitting would establish nothing the function
    # requires, and pass other hidden scope arguments than it takes
    if have != want and c.P.T.Same(have, want) and not c.P.T.ScopesFit(have, want) {
        rec := c.err(sp, msgs.TypeMismatch(c.ty(want), c.ty(have)))
        c.P.L.Diags.Note(rec, c.at(sp), msgs.NoteFuncTypeScopes(c.ty(have)))
        return x
    }
    if have == want or c.P.T.Same(have, want) {
        if c.isRef(want) and (c.P.T.PermOf(want) & types.Writable) != 0 { c.roWritableRef(x, sp) }
        return x
    }
    # D8e: a noreturn call fits where any value is wanted - control never arrives where it would be used
    if have == types.NoreturnT { return x }
    hk := c.P.T.KindOf(have)
    wk := c.P.T.KindOf(want)
    # T20: null is the error value meaning no error; an error value fits a set holding everything it can be, recoded (R6)
    if wk == types.Kind.ErrVal and have == types.NullT { return c.lit(x.Span(), want, 0) }
    if wk == types.Kind.ErrVal and hk == types.Kind.ErrVal {
        if c.errHolds(want, have) { return c.errRecode(x, want) }
        left := c.setLess(c.setItems(c.P.T.ErrValItems(have)), c.setItems(c.P.T.ErrValItems(want)))
        c.err(sp, msgs.ErrValueNotHeld(c.ty(want), c.ty(have), c.setText(left)))
        return x
    }
    # T2c: a reference never null fits where one that may be is wanted; one that may be, nowhere it may not
    if hk == types.Kind.Ref and wk == types.Kind.Ref and c.P.T.IsNullable(have) != c.P.T.IsNullable(want) {
        if c.P.T.IsNullable(have) {
            xsp := x.Span()
            c.err(xsp, msgs.MayBeNull(c.src(xsp), c.ty(have), c.ty(want), bangOf(c.src(xsp))))
            return x
        }
        return c.convert(sp, c.fit(x, c.P.T.NonNull(want), sp), want)
    }
    # T32a: a value where an "any" is wanted - an "any" of the same trait is itself, its permission fitted below
    if c.P.T.IsAny(want) and have != types.NullT and not (c.P.T.IsAny(have) and c.P.T.Same(c.P.T.Referent(have), c.P.T.Referent(want))) {
        return c.toAny(x, want, sp)
    }
    # an array literal's elements fit the wanted element type each (T25b: a literal's elements take the target's
    # permission where all may be written)
    if hk == types.Kind.Array {
        wa := c.arrayOf(want)
        if wa != types.UnknownT and not c.P.T.Same(c.P.T.Elem(have), c.P.T.Elem(wa)) {
            match x {
                case typed.Expr.Make(msp, _, m) {
                    if m.Kind == typed.MakeKind.Array {
                        from := c.exprs.Len()
                        for it in m.Items { c.exprs.Push(c.fit(c.unadapted(it), c.P.T.Elem(wa), it.Span())) }
                        at := c.P.T.Array(c.P.T.Elem(wa), c.P.T.Length(have))
                        y := typed.Expr.Make(msp, at, typed.Make(typed.MakeKind.Array, 0, gather(c.exprs, from), null, m.Site, m.Checked))
                        return c.fit(y, want, sp)
                    }
                }
                nomatch { }
            }
        }
    }
    # text written in the program adapts to a type declared over text, or to a fixed array of its length (T29a, T7c)
    if isData(x) and hk == types.Kind.Ref {
        r := c.P.T.Referent(have)
        w := c.P.T.Referent(want) if wk == types.Kind.Ref else want
        if not c.P.T.Same(r, w) and c.sameRepr(r, c.under(w)) {
            return c.convert(sp, x, c.P.T.Ref(w, c.P.T.PermOf(have)) if wk == types.Kind.Ref else w)
        }
        u := c.under(w)
        if c.P.T.KindOf(u) == types.Kind.Array and c.P.T.Length(u) != types.TypeId(0) and c.sameRepr(c.P.T.Elem(c.under(r)), c.P.T.Elem(u)) {
            match x {
                case typed.Expr.Data(dsp, _, file, k) {
                    if c.dataLength(x) == c.P.T.ConstValue(c.P.T.Length(u)) {
                        d typed.Expr&c = typed.Expr.Data(dsp, c.P.T.Ref(w, types.ReadOnly), file, k)
                        return c.read(sp, typed.Lvalue.Deref(sp, w, d))
                    }
                }
                nomatch { }
            }
        }
    }
    # an array literal adapts to a type declared over an array of its elements (T29a)
    if hk == types.Kind.Array and isArrayMake(x) {
        w := c.deref(want)
        if c.isOver(w) and c.P.T.KindOf(c.under(w)) == types.Kind.Array and c.sameRepr(c.P.T.Elem(have), c.P.T.Elem(c.under(w))) {
            v := c.convert(sp, c.fit(x, c.under(w), sp), w)
            return c.fit(v, want, sp)
        }
    }
    # a function value where one of looser permissions is wanted (T22): a read-only parameter for a writable one, a
    # writable result for a read-only one
    if hk == types.Kind.Func and wk == types.Kind.Func and c.funcFits(have, want, namedFn(x)) { return c.convert(sp, x, want) }
    # an instance whose type declares Call, where a function value is wanted (E31): an adapter holding it
    if wk == types.Kind.Func and hk != types.Kind.Func and have != types.NullT {
        a := c.adapter(sp, x, want)
        if a is not null { return a }
    }
    if have == types.NullT {
        if (wk == types.Kind.Ref and c.P.T.IsNullable(want)) or wk == types.Kind.Func { return c.lit(sp, want, 0) }
        if c.P.T.ArrayRef(want) {
            # T2c: an array is never null - an empty one is written as one
            c.err(sp, msgs.NullToArray(c.ty(c.deref(want)), c.emptyArray(want)))
            return c.lit(sp, want, 0)
        }
        if wk == types.Kind.Ref {
            # T2c: a reference that may be null says so where its type is written
            rec := c.err(sp, msgs.NullToNonNull(c.ty(want), c.ty(c.P.T.OrNull(want))))
            c.declNote(rec)
            return x
        }
        c.err(sp, msgs.TypeMismatch(c.ty(want), "null"))
        return x
    }
    # numbers flow toward their base (T6b)
    if c.isNumber(have) and c.isNumber(want) and hk != types.Kind.Ref and wk != types.Kind.Ref {
        if c.P.Flows(have, want) { return c.convert(sp, x, want) }
        rec := c.err(sp, msgs.NumberDoesNotFlow(c.ty(have), c.ty(want), c.ty(want)))
        c.literalLocalNote(rec, c.literalLocalIn(x, have), want)
        return x
    }
    # a reference where a value is wanted: the value copied out (E12)
    if hk == types.Kind.Ref and wk != types.Kind.Ref {
        r := c.P.T.Referent(have)
        if c.P.T.Same(r, want) or c.flowsInto(r, want) {
            if c.P.T.IsNullable(have) { c.err(x.Span(), msgs.ReadMaybeNull(c.src(x.Span()), c.ty(have), bangOf(c.src(x.Span())))) }
            return c.fit(c.read(sp, typed.Lvalue.Deref(sp, r, x)), want, sp)
        }
    }
    # a value where a reference is wanted: borrowed where it has storage, else a temporary given some (E12c)
    if wk == types.Kind.Ref and hk != types.Kind.Ref {
        r := c.P.T.Referent(want)
        if c.P.T.Same(r, have) {
            # "try a.Get(i)" with no clause names the element as "a[i]" does (E31b, T1): the element borrowed under the
            # try, so the write lands
            match x {
                case typed.Expr.Try(tsp, _, t) {
                    if t.Clauses.Len() == 0 and readPlace(t.X!) is not null {
                        return typed.Expr.Try(tsp, want, typed.Try(c.fit(t.X!, want, sp), t.Clauses, t.Ends, t.Passes, t.Left))
                    }
                }
                nomatch { }
            }
            p := readPlace(x)
            if p is not null {
                if (c.P.T.PermOf(want) & types.Writable) != 0 {
                    c.mustWrite(p, sp, false)
                    c.roDeepNeed(x)
                }
                # S4d: a borrow of the place being written over, or of storage within it, takes its old value - a copy
                for q in c.s4d {
                    if c.within(p, q) { return typed.Expr.Promote(sp, want, typed.Promote(x, c.site(typed.SiteKind.Promote, sp))) }
                }
                # ... and so does a compound assignment's or an increment's old value, where its type can hold one
                match p {
                    case typed.Lvalue.Target(_, tt) {
                        if c.P.T.HoldsRefs(tt) { return typed.Expr.Promote(sp, want, typed.Promote(x, c.site(typed.SiteKind.Promote, sp))) }
                    }
                    nomatch { }
                }
                return typed.Expr.Borrow(sp, want, p)
            }
            if (c.P.T.PermOf(want) & types.Writable) != 0 {
                csp := c.chosenAt(x)
                if csp.Start >= 0 and c.condChoosesPlace(x) {
                    # E28: a conditional's value is a copy, which the callee would write and drop
                    c.err(csp, msgs.CondLentWritable())
                } else {
                    c.roLend(x, sp)
                }
            }
            return typed.Expr.Promote(sp, want, typed.Promote(x, c.site(typed.SiteKind.Promote, sp)))
        }
        if c.flowsInto(have, r) or (c.isNumber(have) and c.isNumber(r) and c.P.Flows(have, r)) {
            p := readPlace(x)
            # a fixed array where a reference to one of a run-time length is wanted: the place itself borrowed and the
            # reference widened, nothing copied (E12, T7c) - the callee writes the caller's elements
            if p is not null and hk == types.Kind.Array and c.P.T.Length(have) != types.TypeId(0) {
                if (c.P.T.PermOf(want) & types.Writable) != 0 {
                    c.mustWrite(p, sp, false)
                    c.roDeepNeed(x)
                }
                return c.convert(sp, typed.Expr.Borrow(sp, c.P.T.Ref(have, c.P.T.PermOf(want)), p), want)
            }
            # T25d: an array of constants reaching a read-only reference is the constant data itself
            d := c.staticArray(x, want)
            if d is not null { return d }
            v := c.fit(x, r, sp)
            if p is not null and c.isNamed(have) and c.isOver(have) {
                # a declared type's place lent as its base names its storage (T29a): written only where the place may
                # be (S6, T25b, T25c) - a String global as an Array<Char> as much as any
                if (c.P.T.PermOf(want) & types.Writable) != 0 {
                    c.mustWrite(p, sp, false)
                    c.roDeepNeed(x)
                }
                return typed.Expr.Borrow(sp, want, p)
            }
            return typed.Expr.Promote(sp, want, typed.Promote(v, c.site(typed.SiteKind.Promote, sp)))
        }
    }
    # a reference to a reference: the same referent, writable into read-only (T25c)
    if hk == types.Kind.Ref and wk == types.Kind.Ref {
        hr := c.P.T.Referent(have)
        wr := c.P.T.Referent(want)
        if c.P.T.Same(hr, wr) or c.flowsInto(hr, wr) {
            # X10: nothing is read or written through an extern type's reference, so its permission says nothing
            if c.foreignRef(have) and c.P.T.Same(hr, wr) and (c.P.T.PermOf(want) & types.Owning) == 0 {
                return c.convert(sp, x, want) if c.P.T.PermOf(have) != c.P.T.PermOf(want) else x
            }
            if (c.P.T.PermOf(want) & types.Owning) != (c.P.T.PermOf(have) & types.Owning) and not ((c.P.T.PermOf(want) & types.Writable) != 0 and (c.P.T.PermOf(have) & types.Writable) == 0) {
                return c.fit(c.convert(sp, x, c.P.T.Ref(hr, (c.P.T.PermOf(have) & types.Writable) | (c.P.T.PermOf(want) & types.Owning))), want, sp)
            }
            if (c.P.T.PermOf(want) & types.Writable) != 0 and (c.P.T.PermOf(have) & types.Writable) == 0 {
                if isData(x) {
                    v := c.fit(c.read(sp, typed.Lvalue.Deref(sp, hr, x)), wr, sp)
                    return typed.Expr.Promote(sp, want, typed.Promote(v, c.site(typed.SiteKind.Promote, sp)))
                }
                c.err(sp, msgs.ReadOnlyToWritable())
                return x
            }
            if (c.P.T.PermOf(want) & types.Writable) != 0 and not c.roWritableRef(x, sp) { return x }
            if c.P.T.Same(hr, wr) { return x }
            return c.convert(sp, x, want)
        }
    }
    # a declared type flows into the type it is declared over (T29a), an array of a fixed length into one of a run-time
    # one (T7c)
    if c.flowsInto(have, want) { return c.convert(sp, x, want) }
    # T7d: an array of a run-time length stored into fixed storage is copied through a slice of its length, written -
    # no store is checked for its length implicitly. One whose length is still being computed fits (T7c's undecided)
    if wk == types.Kind.Array and c.P.T.Length(want) != types.TypeId(0) {
        src := x
        st := have
        if hk == types.Kind.Ref {
            st = c.P.T.Referent(have)
            src = c.read(sp, typed.Lvalue.Deref(sp, st, x))
        }
        su := c.under(st)
        if c.P.T.KindOf(su) == types.Kind.Array and c.P.T.Length(su) == types.TypeId(0) and c.sameRepr(c.P.T.Elem(su), c.P.T.Elem(want)) {
            if c.P.T.KindOf(c.P.T.Length(want)) == types.Kind.Const {
                c.err(sp, msgs.ArrayRunTimeIntoFixed(c.P.T.ConstValue(c.P.T.Length(want))))
                return x
            }
            from := c.exprs.Len()
            c.exprs.Push(src)
            return typed.Expr.Prim(sp, want, typed.PrimOp.Convert, typed.Check.Abort, gather(c.exprs, from))
        }
    }
    # T7d: two fixed arrays of one element type and two lengths
    if hk == types.Kind.Array and wk == types.Kind.Array and c.P.T.Same(c.P.T.Elem(have), c.P.T.Elem(want)) and c.P.T.KindOf(c.P.T.Length(have)) == types.Kind.Const and c.P.T.KindOf(c.P.T.Length(want)) == types.Kind.Const {
        c.err(sp, msgs.ArraySizeMismatch(c.P.T.ConstValue(c.P.T.Length(have)), c.P.T.ConstValue(c.P.T.Length(want))))
        return x
    }
    ws := c.ty(want)
    hs := c.tyOf(x)
    if ws == hs and c.isNamed(c.deref(want)) and c.isNamed(c.deref(have)) {
        # two types of one name, declared by two modules - two C imports translating one header among them (X18)
        ws = $ws " of " $c.P.L.Mods[c.P.T.DeclModule(c.P.T.DeclOf(c.deref(want)))].Identity
        hs = $hs " of " $c.P.L.Mods[c.P.T.DeclModule(c.P.T.DeclOf(c.deref(have)))].Identity
    }
    c.err(sp, msgs.TypeMismatch(ws, hs))
    return x
}

# a value's type as a message spells it: written text as a String (E12, T29c)
fn (c mut Checker&) tyOf(x typed.Expr&) String {
    match x {
        case typed.Expr.Data(_, dt, _, k) {
            match k {
                case typed.Const.Bytes(_) {
                    if c.isRef(dt) and c.P.T.Referent(dt) == c.textType() { return "String" }
                }
                case _ { }
            }
        }
        case _ { }
    }
    return c.ty(typeOf(x))
}

# a fixed array's storage handed to an extern's array parameter (X3): the place borrowed and read as a run-time-length
# array - the pair naming the caller's own elements, which the foreign function may write - never a copy; null where
# the argument is no such place
fn (c mut Checker&) externArray(target typed.Callee&, x typed.Expr&c, want types.TypeId, sp source.Span) typed.Expr?&c {
    isExtern := match target {
        case typed.Callee.Extern(_) => true
        case _ => false
    }
    if not isExtern { return null }
    have := typeOf(x)
    wa := c.arrayOf(want)
    if wa == types.UnknownT or c.P.T.Length(wa) != types.TypeId(0) { return null }
    if c.P.T.KindOf(have) != types.Kind.Array or c.P.T.Length(have) == types.TypeId(0) { return null }
    p := readPlace(x)
    if p is null { return null }
    # a parameter held by reference ("Array<U8>&") takes the borrow itself, one by value the array it names
    if c.isRef(want) { return c.convert(sp, typed.Expr.Borrow(sp, c.P.T.Ref(have, types.Writable), p), c.P.T.Ref(c.P.T.Referent(want), types.Writable)) }
    b := c.convert(sp, typed.Expr.Borrow(sp, c.P.T.Ref(have, types.Writable), p), c.P.T.Ref(want, types.Writable))
    return c.read(sp, typed.Lvalue.Deref(sp, want, b))
}

# X22: what a C pointer parameter takes beside its own type - "CVoid?&" (C's "void *") an array of any elements or a
# reference to one, a plain struct (borrowed) or a reference to one, or an extern type's reference; an array parameter
# of bytes a C string ("CStr&"); a plain struct's reference an array of them (C's pointer to its first). A "mut" one
# takes only what may be written. The argument as it is, or null where the rule says nothing (fit then judges it)
fn (c mut Checker&) cPointerArg(target typed.Callee&, x typed.Expr&c, want types.TypeId, sp source.Span) typed.Expr?&c {
    isExtern := match target {
        case typed.Callee.Extern(_) => true
        case _ => false
    }
    if not isExtern { return null }
    have := typeOf(x)
    if have == types.UnknownT or have == types.NullT { return null }
    hv := c.deref(have)
    hu := c.under(hv)
    if c.cVoidRef(want) {
        if c.foreignRef(have) { return x }
        if c.P.T.KindOf(hu) == types.Kind.Array or c.plainStruct(hv, 0) { return c.cBorrow(x, want, sp) }
        return null
    }
    wu := c.under(c.deref(want))
    if c.P.T.KindOf(wu) == types.Kind.Array and c.isCStrRef(have) {
        e := c.P.T.Elem(wu)
        if e == c.P.T.Prim("U8") or e == c.P.T.Prim("I8") { return x }
        return null
    }
    if c.isRef(want) and c.cStruct(c.deref(want)) and c.P.T.KindOf(hu) == types.Kind.Array {
        e := c.P.T.Elem(hu)
        # an array of the struct - C's pointer to its first - or of numbers, C's cast of a buffer to it (a sockaddr's)
        if c.P.T.Same(e, c.deref(want)) or c.cNumber(c.under(e)) { return c.cBorrow(x, want, sp) }
    }
    # a pointer C gave, where C takes a pointer to a struct it laid out (freeaddrinfo's): C's to say what it points to
    if c.isRef(want) and c.cVoidRef(have) and (c.cStruct(c.deref(want)) or c.foreignRef(want)) { return x }
    return null
}

# whether t is a struct C may be handed a pointer to: a plain-data one (X11), or one of a C import's (X18) - its opaque
# words included
fn (c mut Checker&) cStruct(t types.TypeId) Bool {
    if c.plainStruct(t, 0) { return true }
    return c.isNamed(t) and c.declKind(t) == types.DeclKind.Struct and c.P.L.Mods[c.P.T.DeclModule(c.P.T.DeclOf(t))].C
}

# an argument C is handed a pointer to: a reference as it is - writable where the parameter is - a place borrowed, a
# value an array is (its storage)
fn (c mut Checker&) cBorrow(x typed.Expr&c, want types.TypeId, sp source.Span) typed.Expr&c {
    have := typeOf(x)
    if c.isRef(have) {
        if c.writable(want) and not c.writable(have) { c.err(sp, msgs.CPointerReadOnly(c.ty(have))) }
        return x
    }
    p := readPlace(x)
    if p is null {
        if c.P.T.KindOf(c.under(have)) == types.Kind.Array { return x }   # an array made here: its storage
        c.err(sp, msgs.CPointerTemporary(c.ty(have)))
        return x
    }
    if c.writable(want) { c.mustWrite(p, sp, false) }
    return typed.Expr.Borrow(sp, c.P.T.Ref(have, types.Writable if c.writable(want) else 0), p)
}

# whether t is a reference to the prelude's CVoid (X18)
fn (c mut Checker&) cVoidRef(t types.TypeId) Bool { return c.preludeForeign(t, "CVoid") }

# whether t is a reference to the prelude's CStr (X15)
fn (c mut Checker&) isCStrRef(t types.TypeId) Bool { return c.preludeForeign(t, "CStr") }

fn (c mut Checker&) preludeForeign(t types.TypeId, name String&) Bool {
    if not c.foreignRef(t) { return false }
    x := c.P.T.Referent(t)
    d := c.P.T.DeclOf(x)
    return c.text(c.P.T.DeclName(d)) == name and c.P.L.Mods[c.P.T.DeclModule(d)].Prelude
}

# a value made to fit a type, as fit does, with nothing said: the value, and whether it fits - for a caller saying
# what is wrong in its own words (S12b, S13, E28)
fn (c mut Checker&) fitQuiet(x typed.Expr&c, want types.TypeId, sp source.Span) typed.Expr&c, Bool {
    n := c.P.L.Diags.Count()
    g := c.P.L.Diags.Hold()
    y := c.fit(x, want, sp)
    c.P.L.Diags.EndHold()
    ok := c.P.L.Diags.Count() == n
    if ok { c.P.L.Diags.Choose(g) } else { c.P.L.Diags.Drop(g) }
    return y, ok
}

# whether values of two types can be compared or chosen between: one flows into the other, numbers meet, null beside a
# reference (E10, E28, S13)
fn (c mut Checker&) meets(a types.TypeId, b types.TypeId) Bool {
    if a == types.UnknownT or b == types.UnknownT or c.P.T.Same(a, b) { return true }
    if c.flowsInto(a, b) or c.flowsInto(b, a) { return true }
    if c.isNumber(a) and c.isNumber(b) { return c.P.Meet(a, b) >= types.TypeId(0) }
    if a == types.NullT { return c.isRef(b) or c.P.T.KindOf(b) == types.Kind.Func }
    if b == types.NullT { return c.isRef(a) or c.P.T.KindOf(a) == types.Kind.Func }
    if c.isRef(a) or c.isRef(b) { return c.meets(c.deref(a), c.deref(b)) and (c.isRef(a) == c.isRef(b) or c.flowsInto(c.deref(a), c.deref(b)) or c.flowsInto(c.deref(b), c.deref(a))) }
    return false
}

# whether a value of one type is a value of another by representation, nothing lost: a declared type into its base
# (T29a), an array of a fixed length into one of a run-time length (T7c), an array of a declared number into one of
# its base (T29h)
fn (c mut Checker&) flowsInto(a types.TypeId, b types.TypeId) Bool {
    if c.P.T.Same(a, b) { return true }
    if c.isOver(a) and c.flowsInto(c.P.T.Base(a), b) { return true }
    if c.P.T.KindOf(a) == types.Kind.Array and c.P.T.KindOf(b) == types.Kind.Array {
        if c.P.T.Length(b) != types.TypeId(0) and not c.lengthsMeet(a, b) { return false }
        return c.P.T.Same(c.P.T.Elem(a), c.P.T.Elem(b)) or c.flowsInto(c.P.T.Elem(a), c.P.T.Elem(b))
    }
    return false
}

# whether values of two types are held alike (T29a): one type, numbers of one representation, arrays of such elements
fn (c mut Checker&) sameRepr(a types.TypeId, b types.TypeId) Bool {
    if c.P.T.Same(a, b) { return true }
    ua := c.under(a)
    ub := c.under(b)
    if c.P.T.Same(ua, ub) { return true }
    if c.P.T.IsNumber(ua) and c.P.T.IsNumber(ub) { return ua == ub }
    if c.P.T.KindOf(ua) == types.Kind.Array and c.P.T.KindOf(ub) == types.Kind.Array {
        if c.P.T.Length(ub) != types.TypeId(0) and not c.lengthsMeet(ua, ub) { return false }
        return c.sameRepr(c.P.T.Elem(ua), c.P.T.Elem(ub))
    }
    return false
}

# whether two arrays' lengths agree: one length, or one a computed length not decided yet, which fits any (T7c)
fn (c mut Checker&) lengthsMeet(a types.TypeId, b types.TypeId) Bool {
    la := c.P.T.Length(a)
    lb := c.P.T.Length(b)
    if la == lb { return true }
    return c.P.T.KindOf(la) == types.Kind.ConstExpr or c.P.T.KindOf(lb) == types.Kind.ConstExpr
}

# an expression checked and made to fit a type: a literal adapting to it (T6), the rest by fit
fn (c mut Checker&) exprTo(x ast.Expr&, want types.TypeId) typed.Expr&c {
    lc := c.litCtor(x, want)
    if lc is not null { return lc }
    e := c.expr(x, want)
    if want == types.UnknownT { return e }
    return c.fit(e, want, c.argSpan(x))
}

# T29d: a literal entering a declared number with a constructor - an initializer, an assignment, an argument, a returned
# value - is that constructor called on it, run while compiling; null where x is no literal or want no such type
fn (c mut Checker&) litCtor(x ast.Expr?&, want types.TypeId) typed.Expr?&c {
    if x is null or want == types.UnknownT or not c.isNamed(want) or not c.litLike(x) { return null }
    if c.declKind(want) != types.DeclKind.Over or not c.P.Body(want) or c.P.CtorSig(want) == types.UnknownT { return null }
    return c.construct(x.Span(), x.Span(), want, Array<ast.Expr&>(1, x))
}

# what ":=" declares from its initializer (D15): text a String value (T29c), a literal its own type (T6a), an array of
# a known length fixed storage of it where keep says it may be (T7d) - a local nothing assigns as a whole afterwards, an
# immutable global - else an Array<T> holding its length at run time
fn (c mut Checker&) inferred(x ast.Expr&, e typed.Expr&, keep Bool = false) types.TypeId {
    t := typeOf(e)
    if t == types.NoreturnT {
        c.err(c.calleeSpan(x), msgs.DeclFromNoreturn())
        return types.UnknownT
    }
    if t == types.NullT {
        c.err(x.Span(), msgs.DeclFromNull())
        return types.UnknownT
    }
    if t == types.VoidT {
        c.err(x.Span(), msgs.TypeNotInferable())
        return types.UnknownT
    }
    if c.isRef(t) and c.P.T.Referent(t) == c.textType() {
        match e {
            case typed.Expr.Data(_, _, _, _) { return c.textType() }
            nomatch { }
        }
    }
    if not keep { return c.runLength(t) }
    return t
}

# an array of a known length - a value, or what a reference names - as one holding its length at run time (T7d)
fn (c mut Checker&) runLength(t types.TypeId) types.TypeId {
    if c.P.T.KindOf(t) == types.Kind.Array and c.P.T.Length(t) != types.TypeId(0) { return c.P.T.Array(c.P.T.Elem(t), types.TypeId(0)) }
    if c.isRef(t) {
        r := c.P.T.Referent(t)
        if c.P.T.KindOf(r) == types.Kind.Array and c.P.T.Length(r) != types.TypeId(0) {
            return c.P.T.Ref(c.P.T.Array(c.P.T.Elem(r), types.TypeId(0)), c.P.T.PermOf(t))
        }
    }
    return t
}

# T6a/B11: the local read in x that ":=" made of type ty from a literal (n := 0, an I64) - -1 for none
fn (c mut Checker&) literalLocalIn(x typed.Expr?&, ty types.TypeId) I64 {
    if x is null { return -1 }
    match x {
        case typed.Expr.Read(_, rt, p, _) {
            match p {
                case typed.Lvalue.Local(_, _, id) {
                    k := pair.Pair(c.fr().Body, I64(id))
                    if c.P.T.Same(rt, ty) and (c.litLocals.Has(k) or c.rangeExprs.Has(k)) { return I64(id) }
                }
                case _ { }
            }
        }
        case typed.Expr.Prim(_, _, _, _, args) {
            for a in args {
                r := c.literalLocalIn(a, ty)
                if r >= 0 { return r }
            }
        }
        case _ { }
    }
    return -1
}

# a note at local id's declaration: its type is its literal's own, and the type it should have is want
fn (c mut Checker&) literalLocalNote(rec I64, id I64, want types.TypeId) {
    if id < 0 { return }
    l := c.cur().Locals[id]
    k := pair.Pair(c.fr().Body, id)
    end := try c.rangeEnds.Get(k) catch default source.Span(-1, -1)
    if end.Start >= 0 {
        # a for-in's variable over a range of literals: the end to convert, which gives the range its type (S9b)
        if c.rangeExprs.Has(k) {
            c.P.L.Diags.Note(rec, c.at(end), msgs.NoteLiteralRangeExpr(c.text(l.Name), c.ty(l.Ty), c.ty(want), c.ty(want)))
        } else {
            c.P.L.Diags.Note(rec, c.at(end), msgs.NoteLiteralRange(c.text(l.Name), c.ty(l.Ty), c.ty(want), c.src(end), c.ty(want)))
        }
        return
    }
    c.P.L.Diags.Note(rec, c.at(l.Sp), msgs.NoteLiteralLocal(c.text(l.Name), c.ty(l.Ty), c.text(l.Name), c.ty(want)))
}

# a temporary's value before it was given storage
fn unpromoted(x typed.Expr&) typed.Expr&x {
    match x {
        case typed.Expr.Promote(_, _, pr) { return pr.X }
        nomatch { return x }
    }
}

# an element as it was before it was fitted to a literal's element type: unpromoted, and a place borrowed read back,
# so it can be borrowed again at the target's permission (T25b)
fn (c mut Checker&) unadapted(x typed.Expr&c) typed.Expr&c {
    match x {
        case typed.Expr.Promote(_, _, pr) { return pr.X }
        case typed.Expr.Borrow(sp, _, p) { return c.read(sp, p) }
        nomatch { return x }
    }
}

# an array literal, or a conditional or match all of whose values are (D15: ":=" from one declares Array<T>)
fn (c mut Checker&) litArray(x ast.Expr&) Bool {
    match x {
        case ast.Expr.ArrayLit(_, _, _) { return true }
        case ast.Expr.Index(_, y, _) { return c.typeNamed(y) >= types.TypeId(0) }
        case ast.Expr.Paren(_, y) { return c.litArray(y) }
        case ast.Expr.Cond(_, a, _, b) { return c.litArray(a) and c.litArray(b) }
        case ast.Expr.MatchE(_, m) {
            for cs in m.Cases {
                if cs.Value is null or not c.litArray(cs.Value!) { return false }
            }
            return m.Cases.Len() > 0
        }
        nomatch { return false }
    }
}

# the bytes text written in the program holds
fn (c mut Checker&) dataLength(x typed.Expr&) I64 {
    match x {
        case typed.Expr.Data(_, _, _, k) {
            match k {
                case typed.Const.Bytes(b) { return b.Len() }
                nomatch { return -1 }
            }
        }
        nomatch { return -1 }
    }
}

# whether a type's zero value is made by its constructor (D13c): a struct's, a declared number's with one (T29d)
fn (c mut Checker&) zeroCalls(t types.TypeId) Bool {
    if c.isStruct(t) { return true }
    if not c.isNamed(t) or c.declKind(t) != types.DeclKind.Over or not c.P.Body(t) { return false }
    sig := c.P.CtorSig(t)
    return sig != types.UnknownT and c.P.T.Items(c.P.T.Params(sig)).Len() == 1
}

# T29d, D13c: a value the evaluator decides once the program has checked - its body built here, in the context checking
# is in, from the literal x through t's constructor, or (x null) t's zero value
fn (c mut Checker&) askValue(kind ValueKind, sp source.Span, t types.TypeId, x ast.Expr?&) {
    if c.asking or c.frames.Len() == 0 or t == types.UnknownT { return }
    if kind != ValueKind.Literal and not c.zeroCalls(t) { return }
    d := c.P.L.Diags
    # G10d: a constructor introducing type variables runs only where a call binds them - no zero does
    if kind != ValueKind.Literal and c.isStruct(t) and c.P.CtorVars(c.P.T.DeclOf(t)) > 0 {
        c.err(sp, msgs.NoZeroValue(c.ty(t), "it introduces a type variable, which no zero binds"))
        return
    }
    mark := d.Count()
    gaps := c.Gaps.Len()
    c.asking = true
    outer := c.fr()
    mi := outer.Mi
    file := outer.File
    ctx := outer.Ctx
    id := c.newBody(typed.BodyOf.Cond(mi, sp.Start), c.P.T.Func(types.ListId(0), t, types.ListId(0)), mi, sp)
    c.state[id] = 1
    fr := c.push(id, mi, t, types.ListId(0))
    fr.Ctx = ctx
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    from := c.stmts.Len()
    v := c.litCtor(x, t) if x is not null else c.zero(sp, t)
    if v is null { v = c.unknown(sp) }
    c.stmts.Push(typed.Stmt.Return(sp, v))
    c.cur().Root = typed.Block(typed.BlockId(0), gather(c.stmts, from))
    c.pop()
    c.state[id] = 2
    c.asking = false
    if d.Count() > mark or c.Gaps.Len() > gaps {
        d.Forget(mark)
        c.Gaps.Truncate(gaps)
        c.Bodies[id].Root = null
        return
    }
    c.ValueAsks.Push(ValueAsk(kind, file, sp, t, id, d.UseOf(diag.Where.Span(file, I64(sp.Start), I64(sp.End)))))
}

# the zero value of a type (D13c): zero bits for a number, a Bool, a reference, a function value, an array; a struct's
# constructor on its defaults
fn (c mut Checker&) zero(sp source.Span, t types.TypeId) typed.Expr&c {
    # T2c: a reference never null has no zero value
    if c.isRef(t) and not c.P.T.IsNullable(t) and not c.P.T.ArrayRef(t) and c.deref(t) != types.UnknownT {
        rec := c.err(sp, msgs.NoZeroNonNull(c.ty(t), c.ty(c.P.T.OrNull(t))))
        c.declNote(rec)
        return c.unknown(sp)
    }
    if c.isStruct(t) {
        id := c.ctorBody(t)
        # each parameter its default, else its own type's zero value - none where the constructor has no parameter,
        # the Zero helper's call then
        sig := c.P.CtorSig(t)
        ps := c.P.T.Items(c.P.T.Params(sig)) if sig != types.UnknownT else Array<types.TypeId>(0)
        td := c.P.TypeDecl(c.P.T.DeclOf(t))
        written Array<ast.Param&>&td = Array<ast.Param&>(0)
        if td is not null and td.Body is not null {
            match td.Body {
                case ast.TypeBody.Struct(st) { written = st.Params }
                nomatch { }
            }
        }
        args := Array<typed.Expr&>(ps.Len(), c.hole(sp))     # each written below
        was := c.ctorCalled
        c.ctorCalled = t
        for k in range ps.Len() {
            hasDefault := written.Len() > 0 and k < written.Len() and written[k].Dflt is not null
            wasNull := c.nullDecl
            if written.Len() > 0 and k < written.Len() { c.nullDecl = c.markAt(c.P.DeclModule(c.P.T.DeclOf(t)), written[k].Ty) }
            args[k] = c.ctorDefault(sp, k, ps[k]) if hasDefault else c.zero(sp, ps[k])
            c.nullDecl = wasNull
        }
        c.ctorCalled = was
        return typed.Expr.Call(sp, t, typed.Call(typed.Callee.Body(typed.BodyId(I32(id))), args, typed.Mark.None
                                                 c.site(typed.SiteKind.Call, sp), true))
    }
    # T2c: an enum's zero value is its first case with its payload's zero bits - none where a part of it is a reference
    # never null
    if c.isEnum(t) and not c.isRef(t) {
        sig := c.P.CaseSig(t, 0)
        if sig != types.UnknownT {
            for pt in c.P.T.Items(c.P.T.Params(sig)) {
                if c.isRef(pt) and not c.P.T.IsNullable(pt) and not c.P.T.ArrayRef(pt) and c.deref(pt) != types.UnknownT {
                    rec := c.err(sp, msgs.NoZeroNonNull(c.ty(pt), c.ty(c.P.T.OrNull(pt))))
                    c.declNote(rec)
                    return c.unknown(sp)
                }
            }
        }
    }
    # a declared number with a constructor (T29d): its constructor on its base's zero
    if c.zeroCalls(t) {
        id := c.ctorBody(t)
        p0 := c.P.T.Items(c.P.T.Params(c.P.CtorSig(t)))[0]
        return typed.Expr.Call(sp, t, typed.Call(typed.Callee.Body(typed.BodyId(I32(id))), c.one(c.zero(sp, p0)), typed.Mark.None
                                                 c.site(typed.SiteKind.Call, sp), true))
    }
    return c.lit(sp, t, 0)
}

# T2c, E35: an expression as "!" is written after it - parenthesized where a space outside brackets says it is more
# than a postfix chain ("(s as E.C)!"), since "!" binds to the last operand
fn bangOf(t String&) String {
    depth I64 = 0
    for ch in t {
        if ch == '(' or ch == '[' { depth++ }
        if ch == ')' or ch == ']' { depth-- }
        if ch == ' ' and depth == 0 { return "(" $t ")" }
    }
    return $t
}

# ---- expressions ----

# an expression checked: its typed value. want is the type the value goes to, where one is known - what a literal
# adapts to (T6) and a lambda takes its types from (D16a) - never a requirement: exprTo makes it fit
fn (c mut Checker&) expr(x ast.Expr?&, want types.TypeId) typed.Expr&c {
    # E39: lanes an operator, a total or a lane method takes are left for it to build in one loop; anything else
    # takes their array, made here
    accept := c.laneAccept
    c.laneAccept = false
    r := c.expr1(x, want, accept)
    if accept { return r }
    return c.laneOut(r)
}

fn (c mut Checker&) expr1(x ast.Expr?&, want types.TypeId, accept Bool) typed.Expr&c {
    ew := c.enumWanted
    c.enumWanted = false
    if x is null { return c.unknown(source.Span(0, 0)) }
    if c.fr().Contract == CtEns and c.fr().ctSubst.Len() > 0 {
        # D17b: a part of a guarantee read at entry - the value kept of it when the call began
        l := try c.fr().ctSubst.Get(ctKey(x.Span())) catch default -1
        if l >= 0 { return c.readLocal(x.Span(), l) }
    }
    v := c.fold(x)
    if v.Ok { return c.litOf(x, v, want) }
    match x {
        case ast.Expr.Lit(sp, kind) { return c.literal(sp, kind, want) }
        case ast.Expr.Name(sp, n) { return c.name(sp, n, want, ew)! }
        case ast.Expr.Paren(_, y) {
            c.laneAccept = accept
            return c.expr(y, want)
        }
        case ast.Expr.Unary(sp, op, y) { return c.unary(sp, op, y, want)! }
        case ast.Expr.Binary(sp, op, a, b) {
            if op == token.Tok.In { return c.membership(sp, a, b) }
            return c.binary(sp, op, a, b, want)
        }
        case ast.Expr.Cond(sp, a, k, b) { return c.cond(sp, a, k, b, want) }
        case ast.Expr.Call(sp, f, args) {
            # G29: the length of an array a parameter holds by value is a constant in each instance
            pl := c.paramLen(f, args)
            if pl >= 0 { return c.lit(sp, c.i64(), pl) }
            return c.call(sp, f, args, want)
        }
        case ast.Expr.ScopeCall(sp, f, sc, args) { return c.scoped(sp, c.laneOut(c.call(sp, f, args, want)), sc) }
        case ast.Expr.Member(sp, y, n) { return c.member(sp, y, n, want) }
        case ast.Expr.Index(sp, y, items) { return c.index(sp, y, items) }
        case ast.Expr.ArrayLit(sp, elem, items) { return c.arrayLit(sp, c.resolve(elem), items) }
        case ast.Expr.Join(sp, parts) { return c.join(sp, parts) }
        case ast.Expr.Try(sp, y, clauses) { return c.tryExpr(sp, y, clauses, want) }
        case ast.Expr.Postfix(sp, op, y) if op == token.Tok.Bang { return c.bang(sp, y, want) }
        case ast.Expr.Postfix(sp, op, y) {
            # S3a: an increment stands alone
            c.err(c.opAfter(y.Span(), 2), msgs.IncdecInExpression("'" $op.Text() "'"))
            return c.unknown(sp)
        }
        case ast.Expr.Is(sp, a, b, negated) { return c.identity(sp, a, b, negated) }
        case ast.Expr.As(sp, a, tr) { return c.asCase(sp, a, tr) }
        case ast.Expr.IsType(sp, a, tr, negated) {
            # E10c: "is" asks for null and nothing else; a type is no question for it
            c.err(c.between(a.Span(), tr.Span(), 2), msgs.IsOnlyNull("!=" if negated else "=="))
            return c.lit(sp, types.BoolT, 0)
        }
        case ast.Expr.Slice(sp, y, lo, hi) { return c.slice(sp, y, lo, hi) }
        case ast.Expr.NotIn(sp, a, b) { return c.negate(sp, c.membership(sp, a, b)) }
        case ast.Expr.Chain(sp, ch) { return c.chain(sp, ch) }
        case ast.Expr.MatchE(sp, m) { return c.matchValue(sp, m, want) }
        case ast.Expr.Compr(sp, cm) {
            if cm.InCall {
                # G37: an argument a comprehension written as arguments gave; one no call spread is an error
                if cm.At >= 0 { return c.argItem(cm, want) }
                c.err(sp, msgs.ReflArgCompr())
                return c.unknown(sp)
            }
            return c.comprehension(sp, cm)
        }
        case ast.Expr.Lambda(sp, f) { return c.lambda(sp, f, want) }
        case ast.Expr.Generic(sp, g, targs) if c.genericFn(g) >= 0 {
            # G12: "big<I64>" names one instance, a function value
            ex := c.explicitArgs(c.genericFn(g), targs, sp)
            if ex.Len() == 0 { return c.unknown(sp) }
            return c.fnValue(sp, c.genericFn(g), ex)
        }
        case ast.Expr.Named(sp, _, y) {
            # E14b: a name given a value outside a call that names parameters - its value checked for its own errors
            c.err(sp, msgs.NamedArgNotHere())
            match y {
                case ast.Expr.Lambda(_, _) { }
                nomatch { c.expr(y, types.UnknownT) }
            }
            return c.unknown(sp)
        }
        nomatch {
            c.gap(x.Span(), exprKindName(x))
            return c.unknown(x.Span())
        }
    }
}

fn (c mut Checker&) literal(sp source.Span, kind token.Tok, want types.TypeId) typed.Expr&c {
    if kind == token.Tok.BoolLit { return c.lit(sp, types.BoolT, 1 if c.src(sp) == "true" else 0) }
    if kind == token.Tok.NullLit {
        k := c.P.T.KindOf(want)
        if (k == types.Kind.Ref and c.P.T.IsNullable(want)) or k == types.Kind.Func { return c.lit(sp, want, 0) }
        return c.lit(sp, types.NullT, 0)
    }
    if kind == token.Tok.CharLit { return c.lit(sp, c.charType(), c.charValue(sp)) }
    if kind == token.Tok.StrLit { return c.textLit(sp) }
    # L10: an integer literal beyond 64 bits - one fold could not read
    if kind == token.Tok.IntLit {
        # a separator out of place was the scanner's error (L10b) - the one said
        if not badSeparator(c.src(sp)) { c.err(sp, msgs.IntLiteralTooLarge(msgs.Tok(c.src(sp)))) }
        return c.unknown(sp)
    }
    if kind == token.Tok.FloatLit {
        c.err(sp, msgs.FloatLiteralRange(msgs.Tok(c.src(sp))))   # L12b: beyond F64, which no literal is
        return c.unknown(sp)
    }
    c.gap(sp, "a literal of this kind")
    return c.unknown(sp)
}

# a name read as a value: a local, a global, a build constant (B10)
# S8d: a local narrowed to a case whose payload is one type written whole reads as that payload, but as itself - the
# enum - where only the enum can go: where its own type is wanted (an argument, a target of that type), and as a case
# test's, an "as"'s or a match's subject (ew). Narrowing only adds what a name can do
fn (c mut Checker&) name(sp source.Span, n source.NameId, want types.TypeId = types.UnknownT, ew Bool = false) typed.Expr?&c {
    ref := c.P.R.Use(c.fr().File, sp.Start)
    if ref.Kind == names.What.Local { c.caughtUsed(n) }   # R11b
    if ref.Kind == names.What.Local and c.localNamed(n) < 0 {
        # G33: a name an unrolled loop binds
        rn := c.reflName(sp, n)
        if rn is not null { return rn }
    }
    if ref.Kind == names.What.Local {
        # S8c: in a condition's body, a fixed local of the body it was asked in is its initializer
        if c.fr().fixed.Has(n) {
            fid := try c.fr().fixed.Get(n) catch default -1
            fi := try c.fixedInits.Get(pair.Pair(c.fr().fixedIn, fid)) catch { return c.unknown(sp) }
            return c.exprTo(fi.Init, fi.Ty)
        }
        id := c.localOrCapture(n, sp)
        own := c.localNamed(n)
        if own >= 0 and id != own and (ew or (want != types.UnknownT and c.P.T.Same(c.deref(want), c.deref(c.localType(own))))) { id = own }
        if id < 0 and c.fr().Inst >= 0 {
            fp := c.instField(sp, n)
            if fp is not null { return c.read(sp, fp) }
        }
        if id < 0 {
            c.gap(sp, "a local the checker has not bound")
            return c.unknown(sp)
        }
        return c.errNarrowed(c.read(sp, c.localPlace(sp, id)), n)   # T20: as narrowing leaves it
    }
    if ref.Kind == names.What.Global {
        t := c.globalType(ref.Module, n)
        if t == types.UnknownT { c.unknowns++ }   # K1a: its initializer did not check
        return c.read(sp, typed.Lvalue.Global(sp, t, ref.Module, n))
    }
    if ref.Kind == names.What.Build { return c.buildConst(sp, n) }
    if ref.Kind == names.What.None {
        # B11: said once in a body - each misspelling one error - and not at all for a type said unknown already
        if not c.unknownSaid.Has(pair.Pair(c.fr().Body, I64(n))) and not c.unknownTypes.Has(pair.Pair(c.fr().Mi, I64(n))) and
           not c.P.R.ImportSaid(n) {
            # B11: with the name it most likely meant - a number's, said as an unknown type (T4)
            best := c.suggest(c.text(n), true)
            if best.Len() == 0 {
                c.err(sp, msgs.UnknownName(c.tok(n)))
            } else if c.P.T.Prim(best) != types.UnknownT {
                c.err(sp, msgs.UnknownNumberType(c.tok(n), best))
            } else {
                c.err(sp, msgs.UnknownNameMeant(c.tok(n), best))
            }
            c.unknownSaid.Put(pair.Pair(c.fr().Body, I64(n)), true)
        }
        return c.unknown(sp)
    }
    if ref.Kind == names.What.Builtin {
        # a built-in type is no value (it was read as an unknown one, a comparison of it taken for false)
        c.err(sp, msgs.TypeNotAValue(c.tok(n)))
        return c.unknown(sp)
    }
    if ref.Kind == names.What.Type {
        # an enum's name is where its cases are read; a generic's, refused at its declaration, says nothing more
        t := c.typeNamed(ast.Expr.Name(sp, n))
        if t >= types.TypeId(0) and not c.isEnum(t) { c.err(sp, msgs.TypeNotAValue(c.tok(n))) }
        return c.unknown(sp)
    }
    if ref.Kind == names.What.Func { return c.fnValue(sp, c.P.FnNamed(ref.Module, n)) }
    if ref.Kind == names.What.TypeVar {
        # G8b: a type variable is a type, never a value
        t := try c.fr().Ctx.Vars.Get(n) catch default types.UnknownT
        if t != types.UnknownT {
            c.err(sp, msgs.TypeVarAsValue(c.text(n)))
            return c.unknown(sp)
        }
    }
    c.gap(sp, "a name of this kind as a value")
    return c.unknown(sp)
}

# the generic function an expression names, as "big" or "lib.big" in "big<I64>" (G12): its index, -1 for none
fn (c mut Checker&) genericFn(g ast.Expr&) I64 {
    match g {
        case ast.Expr.Name(nsp, n) {
            ref := c.P.R.Use(c.fr().File, nsp.Start)
            if ref.Kind == names.What.Func { return c.P.FnNamed(ref.Module, n) }
        }
        case ast.Expr.Member(msp, _, n) {
            ref := c.P.R.Member(c.fr().File, msp.End)
            if ref.Kind == names.What.Func { return c.P.FnNamed(ref.Module, n) }
        }
        nomatch { }
    }
    return -1
}

# G12, G7: the types written after a generic function's name, one per variable its list introduces (G3), each checked
# against its constraint (G19); null where they are not, said
fn (c mut Checker&) explicitArgs(f I64, targs Array<ast.TypeRef&>&, sp source.Span) Array<types.TypeId>&c {
    if f < 0 { return Array<types.TypeId>(0) }
    d := c.P.FnDecl(f)
    tn := c.text(d.Name)
    # a method's own variables are those its list introduces that its receiver's type does not name (G12)
    at := c.P.OwnVarIndexes(f)
    np := at.Len()
    # G1a: its error set given after "?", the last argument - else inferred, as a call's error-set variable always is
    nt := generic.WrittenTypes(targs)
    ev := c.P.ErrVarIndex(f)
    if targs.Len() > nt and ev < 0 {
        c.err(targs[nt].Span(), msgs.ErrSetArgUnwanted(tn))
        return Array<types.TypeId>(0)
    }
    if np == 0 and nt > 0 {
        c.err(targs[0].Span(), msgs.TypeArgsOnNonGeneric(tn))
        return Array<types.TypeId>(0)
    }
    if np != nt {
        c.err(targs[0].Span(), msgs.TypeArgCount(tn, np, nt))
        return Array<types.TypeId>(0)
    }
    width I64 = ev + 1
    for k in at {
        if k + 1 > width { width = k + 1 }
    }
    # a slot no written argument names stays unknown, left to inference (invoke skips it)
    out mut Array<types.TypeId>&c = Array<types.TypeId>(width, types.UnknownT)
    for i in range np {
        r := c.resolve(targs[i])
        if r == types.UnknownT { return Array<types.TypeId>(0) }
        out[at[i]] = r
    }
    if targs.Len() > nt { out[ev] = c.P.ErrsArgOf(c.fr().Ctx, targs[nt]) }
    return out
}

# a function named as a value (T21): its instance's body, no environment; a generic one only as an instance its type
# arguments name, written (G12)
fn (c mut Checker&) fnValue(sp source.Span, f I64, explicit Array<types.TypeId>& = Array<types.TypeId>(0)) typed.Expr&c {
    args := types.ListId(0)
    if f >= 0 and not c.P.FnIsExtern(f) and c.P.VarCount(generic.FnOwner(f)) > 0 {
        owner := generic.FnOwner(f)
        d := c.P.FnDecl(f)
        written := d.TypeParams.Len() if d.TypeParams.Len() > 0 else 0
        # a variable no type argument names - a length an array taken by value gives (G29) - leaves it no value
        if c.P.VarCount(owner) > written {
            c.err(sp, msgs.LengthsNotAValue(c.text(d.Name)))
            return c.unknown(sp)
        }
        if explicit.Len() == 0 or c.P.VarCount(owner) != explicit.Len() {
            c.err(sp, msgs.GenericNotAValue(c.text(d.Name)))
            return c.unknown(sp)
        }
        # G1a: an error set not given is the empty set
        given := Array<types.TypeId>(explicit.Len())
        for i in range explicit.Len() { given[i] = explicit[i] }
        ev := c.P.ErrVarIndex(f)
        if ev >= 0 and given[ev] == types.UnknownT { given[ev] = c.P.ErrSetOf(types.ListId(0)) }
        args = c.P.T.List(given)
        if not c.bound(owner, args, sp) { return c.unknown(sp) }
        if c.P.FnTooDeep(f, args, c.fnNameAt(f)) { return c.unknown(sp) }   # G17
    }
    if f < 0 or c.P.FnIsExtern(f) {
        c.gap(sp, "an extern function as a value (T21)")
        return c.unknown(sp)
    }
    c.P.Sig(f)
    asking := c.P.Asking
    c.P.Asking = generic.Origin(c.fr().File, sp, c.curInst())   # G16b: where the instance is asked for
    inst := c.P.FnInstance(f, args)
    c.P.Asking = asking
    if args != types.ListId(0) and not c.instancesMet(c.P.InstanceSig(inst), sp) { return c.unknown(sp) }
    id := c.fnBody(inst)
    sig := c.P.InstanceSig(inst)
    # an inferred set is what the value fails with (R1a)
    if c.infersErrs(sig) { sig = c.P.T.Func(c.P.T.Params(sig), c.P.T.Result(sig), c.bodyErrors(id), c.P.T.ScopesOf(sig)) }
    c.roFns.Push(roFn(id, 0, c.at(sp), "'" $c.text(c.P.FnDecl(f).Name) "'"))   # T25c
    # its parameters' names, which "$" renders the value with (E11a)
    d := c.P.FnDecl(f)
    if d.Recv is null and d.S.Params.Len() == c.P.T.Items(c.P.T.Params(sig)).Len() { sig = c.P.T.WithNames(sig, c.P.SigNames(d.S)) }
    return typed.Expr.Fn(sp, sig, typed.FnVal.Named(typed.BodyId(I32(id))))
}

# an instance as a function value through its type's Call (E31): null where its Call is none, generic, or of another
# shape (T22: parameters and result as the function type's, errors in order)
fn (c mut Checker&) adapter(sp source.Span, x typed.Expr&c, want types.TypeId) typed.Expr?&c {
    dt := c.deref(typeOf(x))
    if not c.isNamed(dt) { return null }
    m := c.P.MethodOf(dt, c.P.L.Names.Intern("Call"))
    if m < 0 { m = c.P.MethodOf(dt, c.P.L.Names.Intern("call")) }
    if m < 0 or c.P.VarCount(generic.FnOwner(m)) > 0 { return null }
    c.privateRole(m, dt, "Call", sp, msgs.Tok(c.src(sp)))
    c.P.Sig(m)
    inst := c.P.FnInstance(m, types.ListId(0))
    sig := c.P.InstanceSig(inst)
    hp := c.P.T.Items(c.P.T.Params(sig))
    wp := c.P.T.Items(c.P.T.Params(want))
    if hp.Len() != wp.Len() + 1 { return null }
    for i in range wp.Len() {
        if not c.P.T.Same(c.deref(hp[i + 1]), c.deref(wp[i])) { return null }
        # T22: Call writing a parameter the function type passes read-only does not fit
        if c.writable(hp[i + 1]) and c.isRef(wp[i]) and not c.writable(wp[i]) { return null }
    }
    if not c.P.T.Same(c.deref(c.P.T.Result(sig)), c.deref(c.P.T.Result(want))) { return null }
    id := c.fnBody(inst)
    # T22: the errors in order, as the function type lists them - a call through the value reads its codes by position
    es := c.bodyErrors(id) if c.infersErrs(sig) else c.P.T.Errors(sig)
    if es != c.P.T.Errors(want) and c.P.T.Items(es) != c.P.T.Items(c.P.T.Errors(want)) {
        fix := "write the function type '" $c.ty(c.P.T.Func(c.P.T.Params(want), c.P.T.Result(want), es, c.P.T.ScopesOf(want))) "', or pass a lambda handling them" if c.P.T.Items(es).Len() > 0 else "pass a lambda calling it"
        c.err(sp, msgs.CallValueErrors(c.ty(dt), c.errsText(es), c.errsText(c.P.T.Errors(want)), fix))
    }
    c.roFns.Push(roFn(id, 1, c.at(sp), "'" $c.text(c.P.FnDecl(m).Name) "'"))   # T25c
    recv := c.fit(x, hp[0], sp)
    return typed.Expr.Fn(sp, want, typed.FnVal.Adapter(typed.BodyId(I32(id)), recv, c.site(typed.SiteKind.Closure, sp)))
}

# whether a global is a build constant's default that -D gives a value (B10c): immutable, at a module's top level outside
# std, its name defined
fn (c mut Checker&) buildDefaulted(mi I64, n source.NameId, v ast.VarDecl&) Bool {
    m := c.P.L.Mods[mi]
    if m.Prelude or m.Identity.StartsWith("std/") or writtenMut(v.Ty) { return false }
    return c.P.L.Consts.Defined(c.text(n))
}

# -D's value for n as a literal of type want (B10c); null where it is no literal of it (names reports that)
fn (c mut Checker&) defineValue(sp source.Span, n source.NameId, want types.TypeId) typed.Expr?&c {
    v, big := try c.P.L.Consts.ValueOf(c.text(n)) catch { return null }
    w := c.under(want)
    if v.Kind == cond.ValueKind.Bool and w == types.BoolT { return c.lit(sp, want, 1 if v.I != 0 else 0) }
    if v.Kind == cond.ValueKind.Int and c.P.T.IsInt(w) { return c.lit(sp, want, v.I) }
    if v.Kind == cond.ValueKind.Int and c.P.T.IsFloat(w) { return c.lit(sp, want, intFloatBits(w, litv(true, false, big, v.I, 0.0))) }
    if v.Kind == cond.ValueKind.Float and c.P.T.IsFloat(w) { return c.lit(sp, want, floatBits(w, v.F)) }
    if v.Kind == cond.ValueKind.Text and want == c.textType() { return c.buildConst(sp, n) }
    return null
}

fn (c mut Checker&) buildConst(sp source.Span, n source.NameId) typed.Expr&c {
    c.ReadsBuild.Put(c.fr().Body, true)
    v, big := try c.P.L.Consts.ValueOf(c.text(n)) catch {
        c.gap(sp, "a build constant without a value")
        return c.unknown(sp)
    }
    if v.Kind == cond.ValueKind.Bool { return c.lit(sp, types.BoolT, 1 if v.I != 0 else 0) }
    if v.Kind == cond.ValueKind.Int { return c.lit(sp, c.P.T.Prim("U64") if big else c.i64(), v.I) }
    if v.Kind == cond.ValueKind.Float { return c.lit(sp, c.P.T.Prim("F64"), I64(v.F.Bits())) }
    if v.Kind == cond.ValueKind.Text {
        t := c.P.L.Consts.Texts[v.S]
        return typed.Expr.Data(sp, c.P.T.Ref(c.textType(), types.ReadOnly), c.fr().File, typed.Const.Bytes(t))
    }
    c.gap(sp, "a build constant of this kind (B10)")
    return c.unknown(sp)
}

fn (c mut Checker&) unary(sp source.Span, op token.Tok, y ast.Expr&, want types.TypeId) typed.Expr?&c {
    if op == token.Tok.Embed { return c.embed(sp, y) }
    if op == token.Tok.Not {
        c.laneAccept = true
        x := c.expr(y, types.BoolT)
        if c.laneOf(x) >= 0 or c.laneArray(typeOf(x)) { return c.laneUnary(sp, op, x) }   # E39
        if typeOf(x) != types.BoolT and typeOf(x) != types.UnknownT {
            c.err(y.Span(), msgs.OperandNotBool("'not'", c.ty(typeOf(x))))
        }
        return c.negate(sp, x)
    }
    if op == token.Tok.Minus or op == token.Tok.Tilde {
        c.laneAccept = true
        x := c.value(c.expr(y, want), y.Span())
        if c.laneOf(x) >= 0 or c.laneArray(typeOf(x)) { return c.laneUnary(sp, op, x) }   # E39
        return c.unaryOn(sp, op, x)
    }
    if op == token.Tok.Dollar {
        ps Vec<typed.Piece&>
        ps.Push(c.renderPiece(sp, y))
        return typed.Expr.Text(sp, c.textType(), typed.Text(ps.ToArray(), c.site(typed.SiteKind.Text, sp)))
    }
    c.gap(sp, "this prefix operator")
    return c.unknown(sp)
}

# "-x" or "~x" on a checked value: a number's operation, or a declared type's Neg or BitNot (E31)
fn (c mut Checker&) unaryOn(sp source.Span, op token.Tok, x typed.Expr&c) typed.Expr&c {
    t := typeOf(x)
    if t == types.UnknownT { return x }
    if c.isNamed(c.deref(t)) and not (c.isNumber(t) and c.P.Extends(t)) {
        mname := "Neg" if op == token.Tok.Minus else "BitNot"
        m := c.roleUse(c.deref(t), mname, 0, sp, msgs.Tok(op.Text()))
        if m >= 0 {
            c.opCall = c.text(c.P.FnDecl(m).Name)
            return c.invoke(sp, sp, m, x, Array<ast.Expr&>(0), Array<typed.Expr&>(0))
        }
        # E31: a method of that name shaped otherwise is an ordinary one, and this operator has none
        if c.notOperator(c.deref(t), mname, sp, msgs.Tok(op.Text()), 0, false) { return c.unknown(sp) }
        if c.isNumber(t) {
            c.err(sp, msgs.NotExtendedOp(c.ty(t), msgs.Tok(op.Text()), "'" $mname "'"))
            return c.unknown(sp)
        }
    }
    if op == token.Tok.Minus {
        if not c.isNumber(t) {
            c.err(sp, msgs.OperandNotNumber("'-'", c.ty(t)))
            return c.unknown(sp)
        }
        from := c.exprs.Len()
        c.exprs.Push(x)
        return typed.Expr.Prim(sp, t, typed.PrimOp.Neg, typed.Check.None, gather(c.exprs, from))
    }
    if not c.isInt(t) {
        c.err(sp, msgs.OperandNotInt("'~'", c.ty(t)))
        return c.unknown(sp)
    }
    return c.prim(sp, t, typed.PrimOp.BitNot, x, null)
}

# a reference to a number or a Bool read as its value, where an operator needs a value
fn (c mut Checker&) value(x typed.Expr&c, sp source.Span) typed.Expr&c {
    t := typeOf(x)
    if c.isRef(t) {
        r := c.P.T.Referent(t)
        if c.isNumber(r) or r == types.BoolT { return c.read(sp, typed.Lvalue.Deref(sp, r, x)) }
    }
    return x
}

fn binaryOp(op token.Tok) typed.PrimOp {
    return match op {
        case token.Tok.Plus => typed.PrimOp.Add
        case token.Tok.Minus => typed.PrimOp.Sub
        case token.Tok.Star => typed.PrimOp.Mul
        case token.Tok.Slash => typed.PrimOp.Div
        case token.Tok.Percent => typed.PrimOp.Rem
        case token.Tok.Shl => typed.PrimOp.Shl
        case token.Tok.Shr => typed.PrimOp.Shr
        case token.Tok.Amp => typed.PrimOp.BitAnd
        case token.Tok.Pipe => typed.PrimOp.BitOr
        case token.Tok.Caret, token.Tok.Xor => typed.PrimOp.BitXor
        case token.Tok.EqEq => typed.PrimOp.Eq
        case token.Tok.NotEq => typed.PrimOp.Ne
        case token.Tok.Lt => typed.PrimOp.Lt
        case token.Tok.Le => typed.PrimOp.Le
        case token.Tok.Gt => typed.PrimOp.Gt
        case token.Tok.Ge => typed.PrimOp.Ge
        case _ => typed.PrimOp.Add
    }
}

fn compares(op token.Tok) Bool {
    return op == token.Tok.EqEq or op == token.Tok.NotEq or op == token.Tok.Lt or op == token.Tok.Le or
           op == token.Tok.Gt or op == token.Tok.Ge
}

fn intOnly(op token.Tok) Bool {
    return op == token.Tok.Amp or op == token.Tok.Pipe or op == token.Tok.Caret or op == token.Tok.Percent or
           op == token.Tok.Shl or op == token.Tok.Shr
}

# an operand of a binary operator: left as lanes for it to take where the operator works lane by lane (E39)
fn (c mut Checker&) opnd(op token.Tok, x ast.Expr&, want types.TypeId) typed.Expr&c {
    c.laneAccept = laneTok(op)
    return c.expr(x, want)
}

# a binary operator: "and"/"or" a conditional (E7); on numbers a Prim at the type its operands meet at (T6b, E6d) - a
# literal adapting to the other operand where it fits it; on Bools "==", "!=" and xor
fn (c mut Checker&) binary(sp source.Span, op token.Tok, a ast.Expr&, b ast.Expr&, want types.TypeId) typed.Expr&c {
    if op == token.Tok.EqEq or op == token.Tok.NotEq {
        # R11b, T20: an error value compared with a word, an error type or a set
        ec := c.errCompare(sp, op, a, b)
        if ec is not null { return ec }
        # E10c: null is tested with "is", never compared
        if isNullLit(a) or isNullLit(b) {
            o := a if isNullLit(b) else b
            c.err(c.between(a.Span(), b.Span(), op.Text().Len()), msgs.NullCompared(c.src(o.Span()), "is null" if op == token.Tok.EqEq else "is not null"))
            return c.lit(sp, types.BoolT, 0)
        }
        # E32: a case written is a test of the case the other operand holds
        if c.caseWritten(b) and not c.caseWritten(a) { return c.caseCompare(sp, op, a, b) }
        if c.caseWritten(a) and not c.caseWritten(b) { return c.caseCompare(sp, op, b, a) }
    }
    if op == token.Tok.And or op == token.Tok.Or {
        # E39: lanes of Bool combined lane by lane, both evaluated
        xa := c.value(c.opnd(op, a, types.BoolT), a.Span())
        if c.laneOf(xa) >= 0 or c.laneArray(typeOf(xa)) {
            yb := c.value(c.opnd(op, b, types.BoolT), b.Span())
            return c.laneBinary(sp, c.between(a.Span(), b.Span(), op.Text().Len()), op, xa, yb)
        }
        x := c.condOf(a, xa)
        # S8d: the right operand runs only where the left was true ("and") or false ("or") - what it says holds there,
        # a narrowed case's payload read where the right operand begins
        held := c.factsHeld()
        sfrom := c.stmts.Len()
        c.pushFacts(a, op == token.Tok.And, c.fr().Block)
        read := c.stmts.Len() > sfrom
        y := c.cond1(b)
        if read { y = typed.Expr.Seq(b.Span(), typeOf(y), typed.Seq(gather(c.stmts, sfrom), y)) }
        c.factsDrop(held)
        if op == token.Tok.And { return typed.Expr.Cond(sp, types.BoolT, typed.Cond(x, y, c.lit(sp, types.BoolT, 0))) }
        return typed.Expr.Cond(sp, types.BoolT, typed.Cond(x, c.lit(sp, types.BoolT, 1), y))
    }
    opSp := c.between(a.Span(), b.Span(), op.Text().Len())
    la := c.fold(a)
    lb := c.fold(b)
    # E4a, E6a: an integer division by a literal-only zero is an error wherever it is written
    if (op == token.Tok.Slash or op == token.Tok.Percent) and lb.Ok and not lb.IsFloat and not lb.Big and lb.I == 0 and not (la.Ok and la.IsFloat) {
        c.err(c.opOf(b), msgs.DivideByZero())
        return c.unknown(sp)
    }
    shift := op == token.Tok.Shl or op == token.Tok.Shr
    # E8a, E4a: a literal shifted by a literal past its own type's width, with nothing adapting it to compute it exactly
    if shift and want == types.UnknownT and numberLitsOnly(a) and lb.Ok and not lb.IsFloat and not lb.Big and (lb.I < 0 or (lb.I >= 64 and not (la.Ok and not la.IsFloat))) {
        c.err(b.Span(), msgs.ShiftUnadapted())
        return c.unknown(sp)
    }
    # E4a: integer literals whose exact sum, difference, product or shift no literal holds - beyond 64 bits (T4a: a type
    # wider than that is reached by converting one operand, U128(1) << 100)
    if (op == token.Tok.Plus or op == token.Tok.Minus or op == token.Tok.Star or shift) and la.Ok and lb.Ok and not la.IsFloat and not lb.IsFloat {
        if not c.fold(ast.Expr.Binary(sp, op, a, b)).Ok {
            c.err(opSp, msgs.LiteralExprNoValue())
            return c.unknown(sp)
        }
    }
    if not la.Ok and not lb.Ok and (c.litLike(a) != c.litLike(b)) {
        if c.litLike(b) {
            x0 := c.value(c.opnd(op, a, types.UnknownT), a.Span())
            tb0 := c.literalBeside(typeOf(x0)) if c.isNumber(typeOf(x0)) or c.laneArray(typeOf(x0)) else types.UnknownT
            fits0 := c.litLikeFits(b, tb0)
            y0 := c.opnd(op, b, tb0 if fits0 else types.UnknownT)
            if not fits0 and c.noMeet(opSp, typeOf(x0), typeOf(y0)) { return c.unknown(sp) }
            return c.opValues(sp, opSp, op, x0, y0, a.Span(), b.Span())
        }
        y1 := c.value(c.opnd(op, b, types.UnknownT), b.Span())
        ta1 := c.literalBeside(typeOf(y1)) if c.isNumber(typeOf(y1)) or c.laneArray(typeOf(y1)) else types.UnknownT
        fits1 := c.litLikeFits(a, ta1)
        x1 := c.opnd(op, a, ta1 if fits1 else types.UnknownT)
        if not fits1 and c.noMeet(opSp, typeOf(y1), typeOf(x1)) { return c.unknown(sp) }
        return c.opValues(sp, opSp, op, x1, y1, a.Span(), b.Span())
    }
    x typed.Expr?&c = null
    y typed.Expr?&c = null
    if la.Ok and not lb.Ok and shift {
        y = c.value(c.opnd(op, b, types.UnknownT), b.Span())
        tb := want if c.isInt(want) else c.i64()
        x = c.litOf(a, la, tb) if c.litFits(la, tb) else c.litOf(a, la, types.UnknownT)
    } else if la.Ok and not lb.Ok {
        y = c.value(c.opnd(op, b, types.UnknownT), b.Span())
        x = c.litBeside(a, la, y, op, opSp, false)
        if x is null { return c.unknown(sp) }
    } else if lb.Ok and not la.Ok {
        x = c.value(c.opnd(op, a, want if shift else types.UnknownT), a.Span())
        if shift {
            ta := c.literalBeside(typeOf(x))
            if not c.isNumber(ta) { ta = c.opParam(typeOf(x), op) }
            y = c.litOf(b, lb, ta) if c.litFits(lb, ta) else c.litOf(b, lb, types.UnknownT)
        } else {
            y = c.litBeside(b, lb, x, op, opSp, true)
            if y is null { return c.unknown(sp) }
        }
    } else if c.shiftLit(b) and not c.shiftLit(a) {
        x = c.value(c.opnd(op, a, types.UnknownT), a.Span())
        y = c.value(c.opnd(op, b, c.literalBeside(typeOf(x)) if c.isInt(typeOf(x)) else types.UnknownT), b.Span())
    } else if c.shiftLit(a) and not c.shiftLit(b) {
        y = c.value(c.opnd(op, b, types.UnknownT), b.Span())
        x = c.value(c.opnd(op, a, c.literalBeside(typeOf(y)) if c.isInt(typeOf(y)) else types.UnknownT), a.Span())
    } else if la.Ok and lb.Ok and not la.IsFloat and not lb.IsFloat and not shift and (c.litU64(a) or c.litU64(b)) {
        # T6a: two literal-only operands of one width meet unsigned above signed - a U64 literal's beside an I64's
        u := c.P.T.Prim("U64")
        x = c.litOf(a, la, u if c.litFits(la, u) else types.UnknownT)
        y = c.litOf(b, lb, u if c.litFits(lb, u) else types.UnknownT)
    } else {
        x = c.value(c.opnd(op, a, types.UnknownT), a.Span())
        y = c.value(c.opnd(op, b, types.UnknownT), b.Span())
    }
    return c.opValues(sp, opSp, op, x!, y!, a.Span(), b.Span())
}

# a literal operand (folded as v) beside the other operand of a binary operator: adapted to its type (T6), or where it
# does not fit, at its own (E6d) - null where the two then do not meet, said at the operator. On the right of a
# declared type's operator method it adapts to the method's operand (E31)
fn (c mut Checker&) litBeside(x ast.Expr&, v litv, other typed.Expr&c, op token.Tok, opSp source.Span, right Bool) typed.Expr?&c {
    ot := typeOf(other)
    t := c.literalBeside(ot)
    if right and not c.isNumber(t) { t = c.opParam(ot, op) }
    if not right and not c.isNumber(t) { t = c.commuteParam(ot, op) }   # E31c: "2.0 * v" adapts to v's Mul
    e := c.litOf(x, v, t) if c.litFits(v, t) else c.litOf(x, v, types.UnknownT)
    if not c.litFits(v, t) and c.noMeet(opSp, ot, typeOf(e)) { return null }
    return e
}

# E6d: a literal that does not fit the other operand's number type, which does not flow into the literal's own -
# said at the operator, and true
fn (c mut Checker&) noMeet(sp source.Span, other types.TypeId, lit types.TypeId) Bool {
    if not c.isNumber(other) or not c.isNumber(lit) or c.isNamed(other) { return false }
    if c.P.Meet(other, lit) >= types.TypeId(0) { return false }
    c.err(sp, msgs.LiteralDoesNotMeet(c.ty(other), c.ty(other), c.ty(lit)))
    return true
}

# where a literal-only expression's operation is written: its outermost operator, else itself (E4a, E6a)
fn (c mut Checker&) opOf(x ast.Expr&) source.Span {
    match x {
        case ast.Expr.Paren(_, y) { return c.opOf(y) }
        case ast.Expr.Binary(_, op, a, b) { return c.between(a.Span(), b.Span(), op.Text().Len()) }
        nomatch { return x.Span() }
    }
}

# the type a binary operator's method on t takes its operand as (E31), Unknown for none
fn (c mut Checker&) opParam(t types.TypeId, op token.Tok) types.TypeId {
    if c.laneArray(t) { return c.opParam(c.laneElemOf(t), op) }   # E39: beside lanes, an element's
    name := operatorName(op)
    dt := c.deref(t)
    if name == "" or not c.isNamed(dt) { return types.UnknownT }
    return c.operandParam(c.roleMethod(dt, name, 1), t)
}

# the type method m takes its operand as on a receiver of type t - a generic type's, its variables bound by t (G9b);
# Unknown for none
fn (c mut Checker&) operandParam(m I64, t types.TypeId) types.TypeId {
    if m < 0 { return types.UnknownT }
    sig := c.P.Sig(m)
    ps := c.P.T.Items(c.P.T.Params(sig))
    if c.P.VarCount(generic.FnOwner(m)) > 0 {
        sig = c.implSig(m, t)
        if sig == types.UnknownT { return types.UnknownT }
        ps = c.P.T.Items(c.P.T.Params(sig))
        if c.P.T.KindOf(ps[1]) == types.Kind.Var { return types.UnknownT }
    }
    return c.deref(ps[1])
}

# a binary operator applied to two checked values: on numbers a Prim at the type they meet at (T6b), on a declared
# type's values its operator method (E31), on Bools "==", "!=" and xor; "==" on anything else equality's
fn (c mut Checker&) opValues(sp source.Span, opSp source.Span, op token.Tok, x typed.Expr&c, y typed.Expr&c, aSp source.Span
                             bSp source.Span) typed.Expr&c {
    ta := typeOf(x)
    tb := typeOf(y)
    if ta == types.UnknownT or tb == types.UnknownT {
        return c.lit(sp, types.BoolT if compares(op) else types.UnknownT, 0)
    }
    # T20: error values are compared, and nothing else
    if c.P.T.IsErrVal(ta) or c.P.T.IsErrVal(tb) { return c.errValues(sp, opSp, op, x, y) }
    # E39: an array's operators work lane by lane - but a declared type's own operator taking an array is that operator
    if laneTok(op) and (c.laneOf(x) >= 0 or c.laneOf(y) >= 0 or c.laneArray(ta) or c.laneArray(tb)) {
        own := not c.laneArray(ta) and c.laneOf(x) < 0 and c.isNamed(c.deref(ta)) and c.roleMethod(c.deref(ta), operatorName(op), 1) >= 0
        if not own { return c.laneBinary(sp, opSp, op, x, y) }
        x = c.laneOut(x)
        y = c.laneOut(y)
        ta = typeOf(x)
        tb = typeOf(y)
    }
    if compares(op) and op != token.Tok.EqEq and op != token.Tok.NotEq and (c.laneArray(ta) or c.laneArray(tb)) {
        how := "a.LanesLess(b)" if op == token.Tok.Lt else ("b.LanesLess(a)" if op == token.Tok.Gt else ("not b.LanesLess(a)" if op == token.Tok.Le else "not a.LanesLess(b)"))
        c.err(opSp, msgs.LaneCompare(msgs.Tok(op.Text()), how))
        return c.lit(sp, types.BoolT, 0)
    }
    if ta == types.BoolT and tb == types.BoolT {
        if op == token.Tok.EqEq or op == token.Tok.NotEq or op == token.Tok.Xor {
            return c.prim(sp, types.BoolT, binaryOp(op), x, y)
        }
        c.err(opSp, msgs.OperandNotNumber(msgs.Tok(op.Text()), "Bool"))
        return c.unknown(sp)
    }
    if op == token.Tok.Xor {
        c.err(opSp, msgs.OperandNotBool("'xor'", c.ty(ta)))
        return c.unknown(sp)
    }
    if op != token.Tok.EqEq and op != token.Tok.NotEq {
        r := c.operatorCall(sp, opSp, op, x, y)
        if r is not null { return r }
        # E31c: "2.0 * v" through v's Mul when it commutes
        rc := c.commutedCall(sp, opSp, op, x, y)
        if rc is not null { return rc }
    }
    # E31: "@" has no built-in meaning, so only a type declaring MatMul has it
    if op == token.Tok.At {
        if not c.notOperator(c.deref(ta), "MatMul", opSp, "'@'", 1, false) { c.err(opSp, msgs.MatmulUndeclared(c.ty(ta))) }
        return c.unknown(sp)
    }
    # E10a: a declared type over a number that declares Eq is compared by it, as any type declaring one is
    eqDeclared := (op == token.Tok.EqEq or op == token.Tok.NotEq) and c.isNamed(ta) and c.P.T.Same(ta, tb) and c.eqMethod(ta) != -1
    if not c.isNumber(ta) or not c.isNumber(tb) or eqDeclared {
        if op == token.Tok.EqEq or op == token.Tok.NotEq {
            at := c.eqAt
            c.eqAt = opSp
            r := c.equality(sp, op, x, y)
            c.eqAt = at
            return r
        }
        if operatorName(op) != "" and c.notOperator(c.deref(ta), operatorName(op), opSp, msgs.Tok(op.Text()), 1, false) { return c.unknown(sp) }
        if c.isNumber(ta) or c.isNumber(tb) {
            c.err(opSp, msgs.OperandsDiffer(msgs.Tok(op.Text()), c.ty(ta), c.ty(tb)))
        } else {
            c.err(opSp, msgs.OperandNotNumber(msgs.Tok(op.Text()), c.ty(ta)))
        }
        return c.unknown(sp)
    }
    if op == token.Tok.Shl or op == token.Tok.Shr {
        if not c.isInt(ta) { c.err(opSp, msgs.OperandNotInt(msgs.Tok(op.Text()), c.ty(ta))) }
        if not c.isInt(tb) { c.err(opSp, msgs.OperandNotInt(msgs.Tok(op.Text()), c.ty(tb))) }
        if not compares(op) and c.isNamed(ta) and not c.P.Extends(ta) {
            c.err(opSp, msgs.NotExtendedOp(c.ty(ta), msgs.Tok(op.Text()), "'" $operatorName(op) "'"))
            return c.unknown(sp)
        }
        if not c.shiftInRange(ta, y, bSp) { return c.unknown(sp) }
        return c.checkedPrim(sp, ta, binaryOp(op), x, y)
    }
    m := ta
    if ta != tb {
        m = c.P.Meet(ta, tb)
        if m < types.TypeId(0) {
            c.err(opSp, msgs.NumbersDoNotMeet(c.ty(ta), c.ty(tb)))
            return c.unknown(sp)
        }
        if m != ta { x = c.convert(aSp, x, m) }
        if m != tb { y = c.convert(bSp, y, m) }
    }
    if intOnly(op) and not c.isInt(m) {
        c.err(opSp, msgs.OperandNotInt(msgs.Tok(op.Text()), c.ty(m)))
        return c.unknown(sp)
    }
    if not compares(op) and c.isNamed(m) and not c.P.Extends(m) {
        c.err(opSp, msgs.NotExtendedOp(c.ty(m), msgs.Tok(op.Text()), "'" $operatorName(op) "'"))
        return c.unknown(sp)
    }
    if compares(op) { return c.prim(sp, types.BoolT, binaryOp(op), x, y) }
    return c.checkedPrim(sp, m, binaryOp(op), x, y)
}

# a binary operation, checked under try where it can fail (E15a)
fn (c mut Checker&) checkedPrim(sp source.Span, t types.TypeId, op typed.PrimOp, a typed.Expr&c, b typed.Expr&c) typed.Expr&c {
    from := c.exprs.Len()
    c.exprs.Push(a)
    c.exprs.Push(b)
    return typed.Expr.Prim(sp, t, op, typed.Check.None, gather(c.exprs, from))
}

# the method an operator calls on a declared type's values (E31)
fn operatorName(op token.Tok) String& {
    return match op {
        case token.Tok.Plus => "Plus"
        case token.Tok.Minus => "Minus"
        case token.Tok.Star => "Mul"
        case token.Tok.Slash => "Div"
        case token.Tok.Percent => "Rem"
        case token.Tok.At => "MatMul"
        case token.Tok.Lt, token.Tok.Gt, token.Tok.Le, token.Tok.Ge => "Less"
        case token.Tok.Amp => "BitAnd"
        case token.Tok.Pipe => "BitOr"
        case token.Tok.Caret => "BitXor"
        case token.Tok.Shl => "ShiftLeft"
        case token.Tok.Shr => "ShiftRight"
        case _ => ""
    }
}

# x op y through the operator's method on x's type (E31): "a > b" is "b.Less(a)", "a <= b" "not b.Less(a)", "a >= b"
# "not a.Less(b)"; null where x's type has no such method
fn (c mut Checker&) operatorCall(sp source.Span, opSp source.Span, op token.Tok, x typed.Expr&c, y typed.Expr&c) typed.Expr?&c {
    name := operatorName(op)
    if name == "" { return null }
    ta := c.deref(typeOf(x))
    if not c.isNamed(ta) { return null }
    m := c.roleUse(ta, name, 1, opSp, msgs.Tok(op.Text()))
    if m < 0 { return null }
    c.opCall = c.text(c.P.FnDecl(m).Name)
    if op == token.Tok.Gt or op == token.Tok.Le {
        r := c.invoke(sp, opSp, m, y, Array<ast.Expr&>(0), c.one(x))
        return c.negate(sp, r) if op == token.Tok.Le else r
    }
    r := c.invoke(sp, opSp, m, x, Array<ast.Expr&>(0), c.one(y))
    return c.negate(sp, r) if op == token.Tok.Ge else r
}

# whether an operator may commute (E31c): + * & | ^
fn commutative(op token.Tok) Bool {
    return op == token.Tok.Plus or op == token.Tok.Star or op == token.Tok.Amp or op == token.Tok.Pipe or
        op == token.Tok.Caret
}

# the commuting operator method of t for op (E31c), -1 for none
fn (c mut Checker&) commuting(t types.TypeId, op token.Tok) I64 {
    if not commutative(op) or not c.isNamed(t) { return -1 }
    m := c.roleMethod(t, operatorName(op), 1)
    if m < 0 or not c.P.FnDecl(m).S.Commutes { return -1 }
    return m
}

# x op y through y's commuting operator method (E31c): y.Mul(x), x evaluated first as written - held in a hidden local
# where it is no literal; null where y's type has none
fn (c mut Checker&) commutedCall(sp source.Span, opSp source.Span, op token.Tok, x typed.Expr&c, y typed.Expr&c) typed.Expr?&c {
    tb := c.deref(typeOf(y))
    m := c.commuting(tb, op)
    if m < 0 { return null }
    c.privateRole(m, tb, operatorName(op), opSp, msgs.Tok(op.Text()))
    c.opCall = c.text(c.P.FnDecl(m).Name)
    match x {
        case typed.Expr.Lit(_, _, _) { return c.invoke(sp, opSp, m, y, Array<ast.Expr&>(0), c.one(x)) }
        nomatch { }
    }
    sfrom := c.stmts.Len()
    hx := c.heldOf(sp, x)
    r := c.invoke(sp, opSp, m, y, Array<ast.Expr&>(0), c.one(c.read(sp, hx)))
    if c.stmts.Len() > sfrom { return typed.Expr.Seq(sp, typeOf(r), typed.Seq(gather(c.stmts, sfrom), r)) }
    return r
}

# the type a commuting operator method of t takes its other operand as (E31c), Unknown for none
fn (c mut Checker&) commuteParam(t types.TypeId, op token.Tok) types.TypeId {
    return c.operandParam(c.commuting(c.deref(t), op), t)
}

# the method a type's operation calls by itself (E31, M6b): the capitalized spelling or the lowercase one, only in the
# role's shape - n parameters besides the receiver; another shape is an ordinary method; -1 for none
fn (c mut Checker&) roleMethod(t types.TypeId, name String&, n I64) I64 {
    m := c.P.MethodOf(t, c.P.L.Names.Intern(name))
    if m >= 0 and c.P.T.Items(c.P.T.Params(c.P.Sig(m))).Len() == n + 1 { return m }
    m = c.P.MethodOf(t, c.P.L.Names.Intern(lowerFirst(name)))
    if m >= 0 and c.P.T.Items(c.P.T.Params(c.P.Sig(m))).Len() == n + 1 { return m }
    return -1
}

# a protocol method an operation found, by role: one of its private spelling, declared in another module than the code
# using it, cannot be found there - said at the operation (M6b), the method kept so nothing else is said of it
fn (c mut Checker&) roleUse(t types.TypeId, name String&, n I64, at source.Span, tok String&) I64 {
    m := c.roleMethod(t, name, n)
    c.privateRole(m, t, name, at, tok)
    return m
}

fn (c mut Checker&) privateRole(m I64, t types.TypeId, cap String&, at source.Span, tok String&) Bool {
    if m < 0 or c.frames.Len() == 0 { return false }
    low := c.text(c.P.FnDecl(m).Name)
    if low == cap or c.P.FnModule(m) == c.fr().Mi { return false }
    c.P.L.Diags.ErrorOncePerLine(c.at(at), msgs.ProtocolPrivate(tok, c.ty(c.deref(t)), low, cap))
    return true
}

fn lowerFirst(t String&) String {
    b := StringBuilder()
    for i in range t.Len() { b.PushChar(t[i].ToLower() if i == 0 else t[i]) }
    return b.ToString()
}

# a shift of a literal by a value, or arithmetic of such and literals: it takes the type it lands in (E8b)
fn (c mut Checker&) shiftLit(x ast.Expr&) Bool {
    match x {
        case ast.Expr.Paren(_, y) { return c.shiftLit(y) }
        case ast.Expr.Binary(_, op, a, b) {
            if op == token.Tok.Shl or op == token.Tok.Shr { return c.fold(a).Ok and not c.fold(b).Ok }
            return (c.shiftLit(a) and (c.fold(b).Ok or c.shiftLit(b))) or (c.shiftLit(b) and c.fold(a).Ok)
        }
        nomatch { return false }
    }
}

# whether an expression counts as a literal where a type is chosen: one, or a conditional all of whose values are (E28)
fn (c mut Checker&) litLike(x ast.Expr&) Bool {
    if c.fold(x).Ok { return true }
    match x {
        case ast.Expr.Paren(_, y) { return c.litLike(y) }
        case ast.Expr.Cond(_, a, _, b) { return c.litLike(a) and c.litLike(b) }
        nomatch { return false }
    }
}

# whether a literal-like expression gives a float
fn (c mut Checker&) litFloat(x ast.Expr&) Bool {
    v := c.fold(x)
    if v.Ok { return v.IsFloat }
    match x {
        case ast.Expr.Paren(_, y) { return c.litFloat(y) }
        case ast.Expr.Cond(_, a, _, b) { return c.litFloat(a) or c.litFloat(b) }
        nomatch { return false }
    }
}

# whether every literal a literal-like expression gives fits t (E6d: else it meets the other operand at its own type)
fn (c mut Checker&) litLikeFits(x ast.Expr&, t types.TypeId) Bool {
    if t == types.UnknownT { return false }
    v := c.fold(x)
    if v.Ok { return c.litFits(v, t) }
    match x {
        case ast.Expr.Paren(_, y) { return c.litLikeFits(y, t) }
        case ast.Expr.Cond(_, a, _, b) { return c.litLikeFits(a, t) and c.litLikeFits(b, t) }
        nomatch { return false }
    }
}

# the type a literal beside a value of type t adapts to: t, or - a declared type that does not extend its base - the
# base it reads as (T29f)
fn (c mut Checker&) literalBeside(t types.TypeId) types.TypeId {
    if c.laneArray(t) { return c.literalBeside(c.laneElemOf(t)) }   # E39: beside lanes, an element
    if c.isNamed(t) and c.isNumber(t) and not c.P.Extends(t) { return c.under(t) }
    return t
}

# a condition checked already, x, held to be a Bool (E7)
fn (c mut Checker&) condOf(k ast.Expr&, x typed.Expr&c) typed.Expr&c {
    t := typeOf(x)
    if t != types.BoolT and t != types.UnknownT {
        c.err(k.Span(), msgs.CondNotBoolType(c.ty(t)))
        return c.unknown(k.Span())
    }
    return x
}

# a condition: a Bool (E7)
fn (c mut Checker&) cond1(k ast.Expr&) typed.Expr&c {
    x := c.value(c.expr(k, types.BoolT), k.Span())
    t := typeOf(x)
    if t != types.BoolT and t != types.UnknownT {
        c.err(k.Span(), msgs.CondNotBoolType(c.ty(t)))
        return c.unknown(k.Span())
    }
    return x
}

# "==" and "!=" on what is no number: by a declared Eq (E10a), part by part (E10), a null test (T2a), identity for
# references to structs and enums with no Eq (E10)
fn (c mut Checker&) equality(sp source.Span, op token.Tok, x typed.Expr&c, y typed.Expr&c) typed.Expr&c {
    ta := typeOf(x)
    tb := typeOf(y)
    if ta == types.NullT or tb == types.NullT {
        a := x if ta != types.NullT else y
        if c.isRef(typeOf(a)) or c.P.T.KindOf(typeOf(a)) == types.Kind.Func {
            z := c.lit(sp, typeOf(a), 0)
            return c.prim(sp, types.BoolT, typed.PrimOp.Same if op == token.Tok.EqEq else typed.PrimOp.Ne, a, z)
        }
        c.gap(sp, "'==' between null and a value")
        return c.lit(sp, types.BoolT, 0)
    }
    da := c.deref(ta)
    db := c.deref(tb)
    if not c.P.T.Same(da, db) {
        # one flowing into the other meets it at the other's type (T6b, T7c: an array of a fixed length beside one of a
        # run-time length)
        if c.flowsInto(da, db) {
            x = c.fit(x, c.P.T.Ref(db, types.ReadOnly) if c.isRef(ta) and c.isRef(tb) else db, sp)
            ta = typeOf(x)
            da = db
        } else if c.flowsInto(db, da) {
            y = c.fit(y, c.P.T.Ref(da, types.ReadOnly) if c.isRef(ta) and c.isRef(tb) else da, sp)
            tb = typeOf(y)
            db = da
        } else if c.P.T.KindOf(da) == types.Kind.Array and c.P.T.KindOf(db) == types.Kind.Array and
                  c.P.T.Same(c.P.T.Elem(da), c.P.T.Elem(db)) {
            # E10, T7c: arrays of two known lengths meet at the run-time length both flow into - unequal, as their
            # lengths differ
            rt := c.P.T.Array(c.P.T.Elem(da), types.TypeId(0))
            x = c.fit(x, c.P.T.Ref(rt, types.ReadOnly) if c.isRef(ta) and c.isRef(tb) else rt, sp)
            y = c.fit(y, c.P.T.Ref(rt, types.ReadOnly) if c.isRef(ta) and c.isRef(tb) else rt, sp)
            ta, tb = typeOf(x), typeOf(y)
            da, db = rt, rt
        } else {
            c.err(sp, msgs.TypeMismatch(c.ty(da), c.ty(db)))
            return c.lit(sp, types.BoolT, 0)
        }
    }
    eq := c.eqMethod(da)
    if eq == -2 {
        # M6b: a private eq is "==" in its own module only - here it cannot be found
        c.P.L.Diags.ErrorOncePerLine(c.at(c.eqAt if c.eqAt.Start >= 0 else sp), msgs.ProtocolPrivate("'=='", c.ty(da), "eq", "Eq"))
        return c.lit(sp, types.BoolT, 0)
    }
    if eq >= 0 and c.isRef(ta) and c.isRef(tb) and (c.P.T.IsNullable(ta) or c.P.T.IsNullable(tb)) {
        # E10a, T2c: a null equals only a null, and Eq never sees one - both held, each tested, Eq called on neither null
        from := c.stmts.Len()
        ia := c.local(source.NameId(0), sp, ta, typed.LocalKind.Var, typed.Mark.Infer)
        c.stmts.Push(typed.Stmt.Let(sp, typed.LocalId(I32(ia)), x))
        ib := c.local(source.NameId(0), sp, tb, typed.LocalKind.Var, typed.Mark.Infer)
        c.stmts.Push(typed.Stmt.Let(sp, typed.LocalId(I32(ib)), y))
        an := c.prim(sp, types.BoolT, typed.PrimOp.Same, c.readLocal(sp, ia), c.lit(sp, ta, 0))
        bn := c.prim(sp, types.BoolT, typed.PrimOp.Same, c.readLocal(sp, ib), c.lit(sp, tb, 0))
        bn2 := c.prim(sp, types.BoolT, typed.PrimOp.Same, c.readLocal(sp, ib), c.lit(sp, tb, 0))
        av := c.read(sp, typed.Lvalue.Local(sp, c.P.T.NonNull(ta), typed.LocalId(I32(ia))))
        bv := c.read(sp, typed.Lvalue.Local(sp, c.P.T.NonNull(tb), typed.LocalId(I32(ib))))
        call := c.invoke(sp, sp, eq, av, Array<ast.Expr&>(0), c.one(bv))
        inner := typed.Expr.Cond(sp, types.BoolT, typed.Cond(bn2, c.lit(sp, types.BoolT, 0), call))
        r := typed.Expr.Seq(sp, types.BoolT, typed.Seq(gather(c.stmts, from), typed.Expr.Cond(sp, types.BoolT, typed.Cond(an, bn, inner))))
        return c.negate(sp, r) if op == token.Tok.NotEq else r
    }
    if eq >= 0 {
        r := c.invoke(sp, sp, eq, x, Array<ast.Expr&>(0), c.one(y))
        return c.negate(sp, r) if op == token.Tok.NotEq else r
    }
    # T33: two "any" values are equal when they name one instance
    if c.isRef(ta) and c.isRef(tb) and (c.isStruct(da) or c.isEnum(da) or c.P.T.KindOf(da) == types.Kind.Any) {
        r := c.prim(sp, types.BoolT, typed.PrimOp.Same, x, y)
        return c.negate(sp, r) if op == token.Tok.NotEq else r
    }
    if c.partsHaveEq(da, 0) {
        r := c.partsEqual(sp, x, y, da)
        if r is null {
            c.gap(sp, "'==' on an array or enum whose parts declare Eq (E10a)")
            return c.lit(sp, types.BoolT, 0)
        }
        return c.negate(sp, r) if op == token.Tok.NotEq else r
    }
    # two references to arrays: equal where both are null, or neither is and what they name is (E10: a null equals only
    # a null) - the helper of the reference type, which tests for null first
    ht := c.P.T.Ref(da, types.ReadOnly) if c.isRef(ta) and c.isRef(tb) else da
    if c.isRef(ta) and c.isRef(tb) and (c.P.T.IsNullable(ta) or c.P.T.IsNullable(tb)) { ht = c.P.T.OrNull(ht) }
    va := c.fit(x, ht, sp)
    vb := c.fit(y, ht, sp)
    from := c.exprs.Len()
    c.exprs.Push(va)
    c.exprs.Push(vb)
    r := c.callOf(sp, types.BoolT, typed.Callee.Helper(typed.Helper.Equal, ht), gather(c.exprs, from))
    return c.negate(sp, r) if op == token.Tok.NotEq else r
}

# the Eq a type declares for "==" (E10a): its Eq, or its private eq where the code being checked is in that eq's module
# (M6b); -2 for a private eq of another module, which "==" here cannot call, -1 for none
fn (c mut Checker&) eqMethod(t types.TypeId) I64 {
    m := c.P.MethodOf(t, c.P.L.Names.Intern("Eq"))
    if m >= 0 { return m if c.eqShaped(t, m) else -1 }   # a mis-shaped Eq was said at its declaration (E10a)
    m = c.P.MethodOf(t, c.P.L.Names.Intern("eq"))
    if m < 0 or c.P.T.Items(c.P.T.Params(c.P.Sig(m))).Len() != 2 { return -1 }
    return m if c.P.FnModule(m) == c.fr().Mi else -2
}

fn (c mut Checker&) eqShaped(t types.TypeId, m I64) Bool {
    ps := c.P.T.Items(c.P.T.Params(c.P.Sig(m)))
    return ps.Len() == 2 and (c.P.T.KindOf(c.deref(ps[1])) == types.Kind.Var or c.P.T.Same(c.P.T.Plain(c.deref(ps[1])), c.P.T.Plain(t)) or c.P.T.DeclOf(c.deref(ps[1])) == c.P.T.DeclOf(t))
}

# arguments checked for their own errors where a call is not made - a lambda's left, since nothing gives it a type
fn (c mut Checker&) dropArgs(args Array<ast.Expr&>&) {
    if args.Len() == 0 { return }
    for a in args {
        match a {
            case ast.Expr.Lambda(_, _) { }
            case ast.Expr.Named(_, _, x) {
                match x {
                    case ast.Expr.Lambda(_, _) { }
                    nomatch { c.expr(x, types.UnknownT) }
                }
            }
            nomatch { c.expr(a, types.UnknownT) }
        }
    }
}

fn (c mut Checker&) one(x typed.Expr&c) Array<typed.Expr&>&c {
    from := c.exprs.Len()
    c.exprs.Push(x)
    return gather(c.exprs, from)
}

# whether a part of a value of t, at any depth by value, declares Eq
# "==" part by part where a part declares Eq (E10a): each held once, then its parts compared in order, each by its own
# "==", and-ed; a declared type over another by its base's. null for an array or an enum (not elaborated yet)
fn (c mut Checker&) partsEqual(sp source.Span, x typed.Expr&c, y typed.Expr&c, t types.TypeId) typed.Expr?&c {
    if c.isOver(t) {
        b := c.P.T.Base(t)
        return c.equality(sp, token.Tok.EqEq, c.convert(sp, c.fit(x, t, sp), b), c.convert(sp, c.fit(y, t, sp), b))
    }
    k := c.P.T.KindOf(t)
    fs := types.ListId(0)
    if k == types.Kind.Record or k == types.Kind.Tuple {
        fs = c.P.T.Parts(t)
    } else if k == types.Kind.Named and c.declKind(t) == types.DeclKind.Struct {
        fs = c.P.T.Fields(t)
    } else if k == types.Kind.Array {
        return c.arraysEqual(sp, x, y, t)
    } else if k == types.Kind.Named and c.declKind(t) == types.DeclKind.Enum {
        return c.enumsEqual(sp, x, y, t)
    } else {
        return null
    }
    sfrom := c.stmts.Len()
    px := c.heldOf(sp, c.fit(x, t, sp))
    py := c.heldOf(sp, c.fit(y, t, sp))
    ts := c.P.T.Items(fs)
    r typed.Expr&c = c.lit(sp, types.BoolT, 1)
    for i in range ts.Len() {
        e := c.equality(sp, token.Tok.EqEq, c.read(sp, typed.Lvalue.Field(sp, ts[i], px, i))
                        c.read(sp, typed.Lvalue.Field(sp, ts[i], py, i)))
        r = e if i == 0 else typed.Expr.Cond(sp, types.BoolT, typed.Cond(r, e, c.lit(sp, types.BoolT, 0)))
    }
    if c.stmts.Len() > sfrom { return typed.Expr.Seq(sp, types.BoolT, typed.Seq(gather(c.stmts, sfrom), r)) }
    return r
}

# '==' on arrays an element of which declares Eq somewhere in its parts (E10a): the lengths, then each pair of
# elements by its own '==', in a loop the comparison's Seq holds, stopping at the first that differs
fn (c mut Checker&) arraysEqual(sp source.Span, x typed.Expr&c, y typed.Expr&c, at types.TypeId) typed.Expr&c {
    sfrom := c.stmts.Len()
    rt := c.P.T.Ref(at, types.ReadOnly)
    a := c.hidden(sp, rt)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(a)), c.fit(x, rt, sp)))
    b := c.hidden(sp, rt)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(b)), c.fit(y, rt, sp)))
    n := c.hidden(sp, c.i64())
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(n)), c.prim(sp, c.i64(), typed.PrimOp.Len, c.readLocal(sp, a), null)))
    r := c.hidden(sp, types.BoolT)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(r)), c.prim(sp, types.BoolT, typed.PrimOp.Eq, c.readLocal(sp, n)
                                                          c.prim(sp, c.i64(), typed.PrimOp.Len, c.readLocal(sp, b), null))))
    k := c.hidden(sp, c.i64())
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(k)), c.lit(sp, c.i64(), 0)))
    from := c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Loop, sp)
    more := c.and2(sp, c.readLocal(sp, r), c.prim(sp, types.BoolT, typed.PrimOp.Lt, c.readLocal(sp, k), c.readLocal(sp, n)))
    c.emit(c.breakUnless(sp, more, id))
    et := c.P.T.Elem(at)
    ea := c.read(sp, typed.Lvalue.Elem(sp, et, typed.Elem(typed.Lvalue.Deref(sp, at, c.readLocal(sp, a)), c.readLocal(sp, k), typed.Check.None)))
    eb := c.read(sp, typed.Lvalue.Elem(sp, et, typed.Elem(typed.Lvalue.Deref(sp, at, c.readLocal(sp, b)), c.readLocal(sp, k), typed.Check.None)))
    c.emit(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, types.BoolT, typed.LocalId(I32(r))), c.equality(sp, token.Tok.EqEq, ea, eb)))
    body := c.close(id, outer, mark, from)
    pfrom := c.stmts.Len()
    pid, pouter, pmark := c.open(typed.BlockKind.Post, sp)
    c.emit(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, c.i64(), typed.LocalId(I32(k)))
                             c.prim(sp, c.i64(), typed.PrimOp.Add, c.readLocal(sp, k), c.lit(sp, c.i64(), 1))))
    post := c.close(pid, pouter, pmark, pfrom)
    c.emit(typed.Stmt.Loop(sp, body, post))
    return typed.Expr.Seq(sp, types.BoolT, typed.Seq(gather(c.stmts, sfrom), c.readLocal(sp, r)))
}

# '==' on enum values a payload of which declares Eq somewhere in its parts (E10a): the same case, then that case's
# payload fields each by its own '=='
fn (c mut Checker&) enumsEqual(sp source.Span, x typed.Expr&c, y typed.Expr&c, et types.TypeId) typed.Expr&c {
    sfrom := c.stmts.Len()
    px := c.heldOf(sp, c.fit(x, et, sp))
    py := c.heldOf(sp, c.fit(y, et, sp))
    cases := c.P.T.Items(c.P.T.Cases(et))
    r typed.Expr&c = c.lit(sp, types.BoolT, 0)
    for kk in range cases.Len() {
        k := cases.Len() - 1 - kk
        ps := c.P.T.Items(c.P.T.Params(c.P.CaseSig(et, k)))
        same := c.prim(sp, types.BoolT, typed.PrimOp.IsCase, c.read(sp, py), c.lit(sp, c.i64(), k))
        qx := typed.Lvalue.Payload(sp, cases[k], typed.Payload(px, k, typed.Check.None))
        qy := typed.Lvalue.Payload(sp, cases[k], typed.Payload(py, k, typed.Check.None))
        for i in range ps.Len() {
            e := c.equality(sp, token.Tok.EqEq, c.read(sp, typed.Lvalue.Field(sp, ps[i], qx, i))
                            c.read(sp, typed.Lvalue.Field(sp, ps[i], qy, i)))
            same = c.and2(sp, same, e)
        }
        here := c.prim(sp, types.BoolT, typed.PrimOp.IsCase, c.read(sp, px), c.lit(sp, c.i64(), k))
        r = typed.Expr.Cond(sp, types.BoolT, typed.Cond(here, same, r))
    }
    if c.stmts.Len() > sfrom { return typed.Expr.Seq(sp, types.BoolT, typed.Seq(gather(c.stmts, sfrom), r)) }
    return r
}

# a value's place: a local it reads, else a hidden one holding it
fn (c mut Checker&) heldOf(sp source.Span, v typed.Expr&c) typed.Lvalue&c {
    p := readPlace(v)
    if p is not null {
        match p {
            case typed.Lvalue.Local(_, _, _) { return p }
            nomatch { }
        }
    }
    h := c.local(source.NameId(0), sp, typeOf(v), typed.LocalKind.Held, typed.Mark.None)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(h)), v))
    return typed.Lvalue.Local(sp, typeOf(v), typed.LocalId(I32(h)))
}

fn (c mut Checker&) partsHaveEq(t types.TypeId, depth I64) Bool {
    if depth > 8 { return false }
    k := c.P.T.KindOf(t)
    if k == types.Kind.Array { return c.typeHasEq(c.P.T.Elem(t), depth) }
    if k == types.Kind.Named and c.P.Body(t) {
        if c.declKind(t) == types.DeclKind.Struct {
            for f in c.P.T.Items(c.P.T.Fields(t)) {
                if c.typeHasEq(f, depth) { return true }
            }
        } else if c.declKind(t) == types.DeclKind.Enum {
            for p in c.P.T.Items(c.P.T.Cases(t)) {
                if c.typeHasEq(p, depth) { return true }
            }
        } else if c.isOver(t) {
            return c.typeHasEq(c.P.T.Base(t), depth)
        }
    }
    if k == types.Kind.Record or k == types.Kind.Tuple {
        for f in c.P.T.Items(c.P.T.Parts(t)) {
            if c.typeHasEq(f, depth) { return true }
        }
    }
    return false
}

fn (c mut Checker&) typeHasEq(t types.TypeId, depth I64) Bool {
    d := c.deref(t)
    if c.isNamed(d) and c.eqMethod(d) != -1 { return true }
    if c.isRef(t) and not (c.P.T.KindOf(d) == types.Kind.Array) { return false }
    return c.partsHaveEq(d, depth + 1)
}

fn (c mut Checker&) tyOrNull(t types.TypeId) String { return "null" if t == types.NullT else c.ty(t) }

# "a is b": two references naming one instance (E10c)
fn (c mut Checker&) identity(sp source.Span, a ast.Expr&, b ast.Expr&, negated Bool) typed.Expr&c {
    if isNullLit(a) and not isNullLit(b) { return c.identity(sp, b, a, negated) }
    isp := c.between(a.Span(), b.Span(), 2)
    if not isNullLit(b) {
        # E10c: "is" asks for null and nothing else - a case and a value are compared with "==" (E32, E10)
        op := "!=" if negated else "=="
        if c.caseWritten(b) {
            c.err(isp, msgs.IsCaseWritten(op, c.src(a.Span()), c.src(b.Span())))
        } else {
            c.err(isp, msgs.IsOnlyNull(op))
        }
        return c.lit(sp, types.BoolT, 0)
    }
    if isNullLit(a) {
        c.err(isp, msgs.IsNullOfNull())
        return c.lit(sp, types.BoolT, 0)
    }
    x := c.expr(a, types.UnknownT)
    xt := typeOf(x)
    if xt == types.UnknownT { return c.unknown(sp) }
    if c.P.T.IsErrVal(xt) {
        # T20: an error value is null where it holds no error
        if c.errNonNull(a, x) {
            c.err(isp, msgs.ErrNeverNull("'" $c.src(a.Span()) "'"))
            return c.lit(sp, types.BoolT, 1 if negated else 0)
        }
        r := c.prim(sp, types.BoolT, typed.PrimOp.Eq, x, c.lit(sp, xt, 0))
        return c.negate(sp, r) if negated else r
    }
    if not c.isRef(xt) and c.P.T.KindOf(xt) != types.Kind.Func {
        c.err(isp, msgs.IsNullOfValue(c.ty(xt)))
        return c.lit(sp, types.BoolT, 0)
    }
    if c.P.T.ArrayRef(xt) {
        # T2c: an array is never null - its zero value is the empty array, what such a test meant
        c.err(isp, msgs.ArrayIsNull(c.src(a.Span()), ".Len() > 0" if negated else ".Len() == 0"))
        return c.lit(sp, types.BoolT, 1 if negated else 0)
    }
    if c.isRef(xt) and not c.P.T.IsNullable(xt) {
        # T2c: a reference never null - the test decides nothing; where it may be, its type says so
        rec := c.err(isp, msgs.NeverNull(c.src(a.Span()), c.ty(xt), "true" if negated else "false"))
        p := readPlace(x)
        at := c.placeAt(p) if p is not null else c.calledAt(x)
        if at != diag.Where.Nowhere { c.P.L.Diags.Note(rec, at, msgs.NoteNullableDecl()) }
        return c.lit(sp, types.BoolT, 1 if negated else 0)
    }
    y := c.fit(c.expr(b, xt), xt, b.Span())
    r := c.prim(sp, types.BoolT, typed.PrimOp.Same, x, y)
    return c.negate(sp, r) if negated else r
}

# T25d: an array literal of constants - numbers, Bool, text written in the program - as the read-only constant data of
# its written position, of type want (a read-only reference to an array of its elements); null where it is no such
fn (c mut Checker&) staticArray(x typed.Expr&c, want types.TypeId) typed.Expr?&c {
    if (c.P.T.PermOf(want) & types.Writable) != 0 or c.P.T.KindOf(c.P.T.Referent(want)) != types.Kind.Array { return null }
    el := c.P.T.Elem(c.P.T.Referent(want))
    match x {
        case typed.Expr.Make(msp, mt, m) {
            if m.Kind != typed.MakeKind.Array or not c.P.T.Same(c.P.T.Elem(mt), el) { return null }
            if not (c.isNumber(el) or el == types.BoolT or el == c.P.T.Ref(c.textType(), types.ReadOnly)) { return null }
            ks := Array<typed.Const&>(m.Items.Len(), typed.Const.Bits(0))
            for i in range m.Items.Len() {
                match m.Items[i] {
                    case typed.Expr.Lit(_, lt, bits) {
                        if lt == types.UnknownT { return null }
                        ks[i] = typed.Const.Bits(bits)
                    }
                    case typed.Expr.Data(_, _, _, k) { ks[i] = k }
                    nomatch { return null }
                }
            }
            return typed.Expr.Data(msp, want, c.fr().File, typed.Const.Items(ks))
        }
        nomatch { return null }
    }
}

fn isArrayMake(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Make(_, _, m) { return m.Kind == typed.MakeKind.Array }
        nomatch { return false }
    }
}

# whether a value is a function named as one (T21): what may fit a type whose errors are a superset of its own (R1b)
fn namedFn(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Fn(_, _, v) => match v {
            case typed.FnVal.Named(_) => true
            case _ => false
        }
        case _ => false
    }
}

fn (c mut Checker&) funcFits(h types.TypeId, w types.TypeId, named Bool) Bool {
    hp := c.P.T.Items(c.P.T.Params(h))
    wp := c.P.T.Items(c.P.T.Params(w))
    if hp.Len() != wp.Len() or not c.P.T.ScopesFit(h, w) { return false }
    for i in range hp.Len() {
        if c.P.T.Same(hp[i], wp[i]) { continue }
        if not (c.isRef(hp[i]) and c.isRef(wp[i]) and c.P.T.Same(c.deref(hp[i]), c.deref(wp[i]))) { return false }
        if (c.P.T.PermOf(hp[i]) & types.Writable) != 0 and (c.P.T.PermOf(wp[i]) & types.Writable) == 0 { return false }
    }
    hr := c.P.T.Result(h)
    wr := c.P.T.Result(w)
    # D8e: a noreturn function does all a type with no result and no errors promises, never returning
    if hr == types.NoreturnT and wr == types.VoidT and c.P.T.Items(c.P.T.Errors(w)).Len() == 0 { return true }
    if not c.P.T.Same(hr, wr) {
        if not (c.isRef(hr) and c.isRef(wr) and c.P.T.Same(c.deref(hr), c.deref(wr))) { return false }
        if (c.P.T.PermOf(wr) & types.Writable) != 0 and (c.P.T.PermOf(hr) & types.Writable) == 0 { return false }
    }
    if c.P.T.Errors(h) == c.P.T.Errors(w) { return true }
    # R1b, T22: a named function fits a type holding every error it can fail with, in any order
    return named and c.errsCover(c.P.T.Errors(w), c.P.T.Errors(h))
}

# an error set as a signature writes it after '?', or "nothing"
fn (c mut Checker&) errsText(es types.ListId) String {
    items := c.P.T.Items(es)
    if items.Len() == 0 { return "nothing" }
    sb := StringBuilder()
    for i in range items.Len() {
        if i > 0 { sb.Push(", ") }
        sb.Push(c.ty(items[i]))
    }
    return sb.ToString()
}

# whether a set holds every error of another (R1b, E31a)
fn (c mut Checker&) errsCover(big types.ListId, small types.ListId) Bool {
    for e in c.P.T.Items(small) {
        if c.uncovered(big, e) != types.UnknownT { return false }
    }
    return true
}

# what of error set entry e a set does not hold (R1c): Unknown for nothing, else e's type or the words left
fn (c mut Checker&) uncovered(big types.ListId, e types.TypeId) types.TypeId {
    et := c.P.T.ErrOf(e)
    mask := c.P.T.ErrMask(e)
    for b in c.P.T.Items(big) {
        if c.P.T.ErrOf(b) == et { mask = mask & ~c.P.T.ErrMask(b) }
    }
    n := c.wordCount(et)
    full := U64(0) - 1 if n >= 64 else (U64(1) << n) - 1
    mask = mask & full
    if mask == 0 { return types.UnknownT }
    return et if mask == full else c.P.T.ErrWords(et, mask)
}

# whether a catch clause gives null as its default (T2c, R11)
fn nullDefault(clauses Array<ast.Catch&>&) Bool {
    if clauses.Len() == 0 { return false }
    for cl in clauses {
        if cl.Defaults.Len() == 0 { continue }
        for d in cl.Defaults { if isNullLit(d) { return true } }
    }
    return false
}

# whether a match's clauses give null as a value (T2c, S12b)
fn nullValue(m ast.Match&) Bool {
    for cs in m.Cases {
        if cs.Value is not null and isNullLit(cs.Value!) { return true }
    }
    if m.NoMatch is not null and m.NoMatch!.Value is not null and isNullLit(m.NoMatch!.Value!) { return true }
    return false
}

fn isNullLit(x ast.Expr&) Bool {
    match x {
        case ast.Expr.Lit(_, kind) { return kind == token.Tok.NullLit }
        nomatch { return false }
    }
}

# x as E.Case (E32): the payload of the case x holds - its one field, or its fields as several results; aborts where x
# holds another case, fails with CheckError.INVALID under try
fn (c mut Checker&) asCase(sp source.Span, a ast.Expr&, tr ast.TypeRef&) typed.Expr&c {
    c.enumWanted = true
    x := c.expr(a, types.UnknownT)
    xt := typeOf(x)
    et := c.deref(xt)
    if c.P.T.KindOf(et) == types.Kind.Any { return c.anyAs(sp, x, a, tr) }
    k I64 = -1
    # a reference marker on a case reads the same payload (E32: the case is what is asked)
    named := tr
    match tr {
        case ast.TypeRef.Ref(rsp, of, sc, _) {
            if c.isEnum(et) and sc != source.NameId(0) {
                # E32: "&mask" after the case is a reference marker's scope name, never the operator
                nl := c.text(sc).Len()
                c.err(source.Span(rsp.End - I32(nl), rsp.End), msgs.IsAsMarker(c.text(sc), "as", c.text(sc)))
                return c.unknown(sp)
            }
            if c.isEnum(et) { named = of }
        }
        nomatch { }
    }
    match named {
        case ast.TypeRef.Named(_, path, targs) {
            if c.isEnum(et) and path.Len() >= 2 and targs.Len() == 0 {
                cn := c.P.T.CaseNames(et)
                if cn.Len() > 0 {
                    for i in range cn.Len() {
                        if cn[i] == path[path.Len() - 1] { k = i }
                    }
                }
            }
        }
        nomatch { }
    }
    if k < 0 {
        if xt == types.UnknownT { return c.unknown(sp) }
        # E32: "as" gives an enum case's payload - an array's part is a slice (E16a)
        if not c.isEnum(et) {
            c.err(c.between(a.Span(), tr.Span(), 2), msgs.IsAsNotEnum(c.ty(xt)))
        } else {
            c.err(tr.Span(), msgs.AsNeedsCase(c.ty(et), "'" $c.src(tr.Span()) "'"))
        }
        return c.unknown(sp)
    }
    base := readPlace(x)
    if c.isRef(xt) {
        base = typed.Lvalue.Deref(sp, et, x)
    } else if base is null {
        base = typed.Lvalue.Temp(sp, xt, x, c.site(typed.SiteKind.Temp, sp))
    }
    # E32: "as" fails as written, with CaseError.WRONG_CASE where the value holds another case
    chk := c.failOp(types.TypeId[c.wrongCase()], c.between(a.Span(), tr.Span(), 2), true)
    rec := c.P.T.Items(c.P.T.Cases(et))[k]
    ps := c.P.T.Items(c.P.T.Params(c.P.CaseSig(et, k)))
    if ps.Len() == 0 {
        cn := c.P.T.CaseNames(et)
        c.err(c.between(a.Span(), tr.Span(), 2), msgs.AsNothing(c.text(cn[k])))
        return c.unknown(sp)
    }
    pp := typed.Lvalue.Payload(sp, rec, typed.Payload(base!, k, chk))
    if ps.Len() == 1 { return c.read(sp, typed.Lvalue.Field(sp, ps[0], pp, 0)) }
    from := c.exprs.Len()
    for i in range ps.Len() { c.exprs.Push(c.read(sp, typed.Lvalue.Field(sp, ps[i], pp, i))) }
    xs := gather(c.exprs, from)
    tt := c.P.T.Tuple(c.P.T.List(ps))
    return typed.Expr.Make(sp, tt, typed.Make(typed.MakeKind.Tuple, 0, xs, null, typed.SiteId(-1), typed.Check.None))
}

# where two references meet (E28, S12b): writable where both are, nullable where either is (T2c)
fn meetPerm(a I64, b I64) I64 { return (a & b & (types.Writable | types.Owning)) | ((a | b) & types.Nullable) }

# a if c else b (E28): one type for both values, a literal adapting
fn (c mut Checker&) cond(sp source.Span, a ast.Expr&, k ast.Expr&, b ast.Expr&, want types.TypeId) typed.Expr&c {
    # G30: decided for this instance where the condition reads a length the instance binds - the chosen value alone
    # checked
    dk := c.constCond(k)
    if dk == 1 { return c.expr(a, want) }
    if dk == 0 { return c.expr(b, want) }
    t := c.cond1(k)
    # E28: a literal value adapts to the other value's type (a number's) where nothing else is wanted
    x typed.Expr?&c = null
    y typed.Expr?&c = null
    # S8d: each value is checked where the condition says what it does - the first where it holds, the second where not
    if want == types.UnknownT and c.litLike(a) and not c.litLike(b) {
        y = c.factsExpr(k, false, b, want)
        x = c.factsExpr(k, true, a, typeOf(y) if c.isNumber(typeOf(y)) else want)
    } else {
        x = c.factsExpr(k, true, a, want)
        y = c.factsExpr(k, false, b, typeOf(x) if want == types.UnknownT and c.litLike(b) and not c.litLike(a) and c.isNumber(typeOf(x)) else want)
    }
    ta := typeOf(x)
    tb := typeOf(y)
    # E28: nothing but a literal adapts between the two values - numbers of two types do not meet here
    if c.isNumber(ta) and c.isNumber(tb) and not c.P.T.Same(ta, tb) and not c.litLike(a) and not c.litLike(b) {
        c.err(c.between(a.Span(), k.Span(), 2), msgs.CondBranchTypes(c.ty(ta), c.ty(tb)))
        return c.unknown(sp)
    }
    rt := ta
    if want != types.UnknownT {
        rt = want
    } else if ta == types.UnknownT or ta == types.NoreturnT {
        rt = tb
    } else if tb == types.NoreturnT {
        rt = ta
    } else if ta != tb and tb != types.UnknownT {
        if c.P.T.Same(ta, tb) {
            rt = ta
        } else if c.isNumber(ta) and c.isNumber(tb) and c.P.Meet(ta, tb) >= types.TypeId(0) {
            rt = c.P.Meet(ta, tb)
        } else if tb == types.NullT and (c.isRef(ta) or c.P.T.KindOf(ta) == types.Kind.Func) {
            rt = c.P.T.OrNull(ta)   # T2c: null beside a reference makes one that may be null
        } else if ta == types.NullT and (c.isRef(tb) or c.P.T.KindOf(tb) == types.Kind.Func) {
            rt = c.P.T.OrNull(tb)
        } else if c.isRef(ta) and not c.isRef(tb) and c.flowsInto(tb, c.P.T.Referent(ta)) {
            rt = ta
        } else if c.isRef(tb) and not c.isRef(ta) and c.flowsInto(ta, c.P.T.Referent(tb)) {
            rt = tb
        } else if c.isRef(ta) and c.isRef(tb) and c.P.T.Same(c.deref(ta), c.deref(tb)) {
            rt = c.P.T.Ref(c.deref(ta), meetPerm(c.P.T.PermOf(ta), c.P.T.PermOf(tb)))
        } else if c.isRef(ta) and c.isRef(tb) and c.P.T.Same(c.deref(c.runLength(ta)), c.deref(c.runLength(tb))) {
            # G9a/E28: references to arrays of one element type and different lengths meet at the run-time length
            rt = c.P.T.Ref(c.deref(c.runLength(ta)), meetPerm(c.P.T.PermOf(ta), c.P.T.PermOf(tb)))
        } else if c.P.T.KindOf(ta) == types.Kind.Array and c.P.T.KindOf(tb) == types.Kind.Array and c.P.T.Same(c.P.T.Elem(ta), c.P.T.Elem(tb)) {
            rt = c.P.T.Array(c.P.T.Elem(ta), types.TypeId(0))
        } else {
            c.err(sp, msgs.CondBranchTypes(c.ty(ta), c.ty(tb)))
            return c.unknown(sp)
        }
    }
    return typed.Expr.Cond(sp, rt, typed.Cond(t, c.fit(x!, rt, a.Span()), c.fit(y!, rt, b.Span())))
}

# whether a value of type t has storage a scope can hold: it holds references, or is (or has as a part) an array of a
# run-time length (T7b)
fn (c mut Checker&) placeable(t types.TypeId) Bool {
    if t == types.VoidT { return false }
    if c.P.T.HoldsRefs(t) { return true }
    r := c.P.T.Repr(t)
    if c.P.T.KindOf(r) == types.Kind.Array { return c.P.T.Length(r) == types.TypeId(0) }
    if c.P.T.KindOf(r) == types.Kind.Tuple or c.P.T.KindOf(r) == types.Kind.Record {
        for x in c.P.T.Items(c.P.T.Parts(r)) {
            if c.placeable(x) { return true }
        }
    }
    return false
}

# whether a call's result is borrowed from a parameter (O13): it lives where that argument does, no scope of its own
fn (c mut Checker&) borrowedResult(k typed.Call&) Bool {
    fty := match k.Target {
        case typed.Callee.Body(id) => c.Bodies[I64(id)].Ty
        case typed.Callee.Value(f) => typeOf(f)
        case _ => types.UnknownT
    }
    if fty == types.UnknownT or c.P.T.KindOf(fty) != types.Kind.Func { return false }
    return c.P.T.ResultFrom(fty, 0) >= 0
}

# a call given a scope argument (E25): where its result is built - the scope a local or parameter lives in, a global's
# (the program's), or the result scope; recorded on the call for section 8
fn (c mut Checker&) scoped(sp source.Span, x typed.Expr&c, sc source.NameId) typed.Expr&c {
    m := typed.Mark.Return
    if c.text(sc) == "return" and c.fr().Gen {
        # D18b: a generator's result scope is one Next call's - but where its elements live where it does, "&return"
        # is there, storage its walk keeps (D18c)
        if c.fr().GenHome >= 0 {
            m = typed.Mark.Of(typed.LocalId(I32(c.fr().GenHome)))
        } else {
            c.err(sp, msgs.GenReturnScope())
        }
    }
    if c.text(sc) != "return" {
        id := c.localOrCapture(sc, sp)
        if id < 0 and c.P.GlobalDecl(c.fr().Mi, sc) is null {
            # E25: a local, a parameter or a global of the calling code - a parameter's default (D8a), checked where the
            # function is declared, names none of the caller's
            name := c.text(sc)
            at := try c.src(sp).Find($"&" $name) catch default -1
            c.err(source.Span(sp.Start + I32(at + 1), sp.Start + I32(at + 1 + name.Len())) if at >= 0 else sp, msgs.ScopeArgUnknown(c.tok(sc)))
            return x
        }
        m = typed.Mark.Of(typed.LocalId(I32(id))) if id >= 0 else typed.Mark.Global(c.fr().Mi, sc)
    }
    match x {
        case typed.Expr.Call(csp, t, k) {
            # E25: only a result built where it goes - one holding references, or an array whose storage is made there -
            # has a scope a scope argument could name: not nothing, a number or a struct of numbers, a borrowed result
            if t != types.UnknownT and not c.placeable(t) or c.borrowedResult(k) {
                nm := c.src(sp)
                amp := try nm.Find("&") catch default nm.Len()
                c.err(sp, msgs.ScopeArgNotAccepted(nm[:amp]))
                return x
            }
            return typed.Expr.Call(csp, t, typed.Call(k.Target, k.Args, m, k.Site, k.Zero))
        }
        case typed.Expr.Seq(ssp, t, q) { return typed.Expr.Seq(ssp, t, typed.Seq(q.Stmts, c.scoped(sp, q.X!, sc))) }
        nomatch {
            if typeOf(x) != types.UnknownT { c.gap(sp, "a scope argument on what is no call (E25)") }
            return x
        }
    }
}

fn exprKindName(x ast.Expr&) String& {
    return match x {
        case ast.Expr.Postfix(_, _, _) => "an increment as a value (S3a)"
        case ast.Expr.IsType(_, _, _, _) => "'is' with a type (E32)"
        case ast.Expr.As(_, _, _) => "'as' (E32)"
        case ast.Expr.ScopeCall(_, _, _, _) => "a scope argument (E25)"
        case ast.Expr.Generic(_, _, _) => "a generic name as a value"
        case ast.Expr.Row(_, _) => "a nested row (E21)"
        case ast.Expr.Compr(_, _) => "a comprehension (E27)"
        case ast.Expr.Lambda(_, _) => "a lambda (D16)"
        case ast.Expr.MatchE(_, _) => "a match value (S12b)"
        case ast.Expr.Range(_, _) => "a range outside a for (S9b)"
        case ast.Expr.Default(_) => "'default' outside a call (E14a)"
        case ast.Expr.Index(_, _, _) => "an index of this kind"
        case _ => "an expression of this kind"
    }
}

# x[lo:hi] (E16a): part of an array's storage, a reference of the array's own type, its bounds checked once (E16b)
fn (c mut Checker&) slice(sp source.Span, y ast.Expr&, lo ast.Expr?&, hi ast.Expr?&) typed.Expr&c {
    base := c.place(y)
    if base is null { return c.unknown(sp) }
    return c.sliceOf(sp, base, lo, hi, typed.Check.Abort)
}

# a slice of what a place holds (E16a): its bounds checked once - aborting for x[lo:hi] (E16b), failing as written with
# ArrayError.OUT_OF_RANGE for x.SliceOf(lo, hi) (E16c)
fn (c mut Checker&) sliceOf(sp source.Span, b typed.Lvalue&c, lo ast.Expr?&, hi ast.Expr?&, check typed.Check) typed.Expr&c {
    base typed.Lvalue&c = b
    t := base.Type()
    # E16a: a slice carries its base's permission - of a value array, the place's own (an immutable global's is
    # read-only, S6, T25c; so is one reached through a read-only reference), of a reference, the reference's
    perm := types.Writable if c.slicedWritable(b) else types.ReadOnly
    for _ in range 4 {
        if not c.isRef(t) { break }
        c.nullRead(base)
        perm = c.P.T.PermOf(t) & types.Writable
        base = typed.Lvalue.Deref(sp, c.P.T.Referent(t), c.read(sp, base))
        t = c.P.T.Referent(t)
    }
    at := c.arrayOf(t)
    if at == types.UnknownT {
        if t == types.UnknownT { return c.unknown(sp) }
        if not c.isNamed(t) {
            c.err(sp, msgs.NotIndexable(c.ty(t)))
            return c.unknown(sp)
        }
        # x[lo:hi] on a declared type (E31): its Slice; an absent end its Len()
        m := c.roleMethod(t, "Slice", 2)
        if m < 0 {
            if not c.notOperator(t, "Slice", sp, "'x[lo:hi]'", 2, false) { c.err(sp, msgs.NotIndexable(c.ty(t))) }
            return c.unknown(sp)
        }
        lm := c.roleMethod(t, "Len", 0)
        if hi is null and lm < 0 {
            c.gap(sp, "a slice with no end of a type with no Len (E31)")
            return c.unknown(sp)
        }
        l := c.lit(sp, c.i64(), 0) if lo is null else c.value(c.exprTo(lo, c.i64()), lo.Span())
        h typed.Expr?&c = null
        if hi is null {
            h = c.invoke(sp, sp, lm, c.read(sp, base), Array<ast.Expr&>(0), Array<typed.Expr&>(0))
        } else {
            h = c.value(c.exprTo(hi, c.i64()), hi.Span())
        }
        from := c.exprs.Len()
        c.exprs.Push(l)
        c.exprs.Push(h!)
        return c.invoke(sp, sp, m, c.read(sp, base), Array<ast.Expr&>(0), gather(c.exprs, from))
    }
    l typed.Expr?&c = null
    if lo is null { l = c.lit(sp, c.i64(), 0) } else { l = c.exprTo(lo, c.i64()) }
    h typed.Expr?&c = null
    if hi is null {
        h = c.prim(sp, c.i64(), typed.PrimOp.Len, typed.Expr.Borrow(sp, c.P.T.Ref(t, types.ReadOnly), base), null)
    } else {
        h = c.exprTo(hi, c.i64())
    }
    # T7c: a slice whose bounds give its length has it known - one that cannot fail (a checked one may, and gives a
    # clause's value instead, whose length is the running program's)
    rt := t if c.isNamed(t) else c.P.T.Array(c.P.T.Elem(at), c.sliceLength(at, lo, hi) if check == typed.Check.Abort else types.TypeId(0))
    return typed.Expr.Slice(sp, c.P.T.Ref(rt, perm), typed.Slice(base, l!, h!, check))
}

# whether the array a value place holds may be written through a slice of it (E16a): not an immutable global's, nor
# one reached through a read-only reference, nor a lambda's copy of a captured value (D16c) - what mustWrite refuses a
# store into. A read-only copy's (T25c) is judged where the slice is used, as a store into it is
fn (c mut Checker&) slicedWritable(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Local(_, _, id) => not (c.cur().Local(id).Kind == typed.LocalKind.Capture and not c.isRef(c.cur().Local(id).Ty))
        case typed.Lvalue.Global(_, _, mi, n) => c.P.GlobalDecl(mi, n) is null or writtenMut(c.P.GlobalDecl(mi, n)!.Ty)
        case typed.Lvalue.Deref(_, _, ref) => not c.isRef(typeOf(ref)) or (c.P.T.PermOf(typeOf(ref)) & types.Writable) != 0
        case typed.Lvalue.Field(_, _, base, _) => c.slicedWritable(base)
        case typed.Lvalue.Elem(_, _, e) => c.slicedWritable(e.Base)
        case typed.Lvalue.Payload(_, _, pl) => c.slicedWritable(pl.Base)
        case _ => true
    }
}

# T7c, E16a: a slice's length where it is known while compiling - both bounds constants (an absent lo 0, an absent hi
# the base's known length), or hi written lo + k with k a constant - else 0, a length known only at run time
fn (c mut Checker&) sliceLength(at types.TypeId, lo ast.Expr?&, hi ast.Expr?&) types.TypeId {
    lv I64 = 0
    lok := lo is null
    if lo is not null {
        lk := c.knownInt(lo)
        if lk >= types.TypeId(0) {
            lv = c.P.T.ConstValue(lk)
            lok = true
        }
    }
    if hi is null {
        n := c.P.T.Length(at)
        if not lok or c.P.T.KindOf(n) != types.Kind.Const { return types.TypeId(0) }
        k := c.P.T.ConstValue(n) - lv
        return c.P.T.Const(c.i64(), k) if k >= 0 else types.TypeId(0)
    }
    if lok {
        hk := c.knownInt(hi)
        if hk >= types.TypeId(0) {
            k := c.P.T.ConstValue(hk) - lv
            return c.P.T.Const(c.i64(), k) if k >= 0 else types.TypeId(0)
        }
    }
    # hi written lo + k, or k + lo: the same bound read twice, and a constant
    if lo is not null {
        match hi {
            case ast.Expr.Binary(_, op, a, b) {
                if op == token.Tok.Plus {
                    k := types.TypeId(-1)
                    if sameRead(a, lo) {
                        k = c.knownInt(b)
                    } else if sameRead(b, lo) {
                        k = c.knownInt(a)
                    }
                    if k >= types.TypeId(0) and c.P.T.ConstValue(k) >= 0 { return c.P.T.Const(c.i64(), c.P.T.ConstValue(k)) }
                }
            }
            nomatch { }
        }
    }
    return types.TypeId(0)
}

# an integer expression's value where it is known while compiling (a literal, a constant, a by-value array's length -
# QP1's fold), as a Const; -1 for none
fn (c mut Checker&) knownInt(x ast.Expr&) types.TypeId {
    pl := I64(-1)
    match x {
        case ast.Expr.Call(_, f, args) { pl = c.paramLen(f, args) }
        nomatch { }
    }
    if pl >= 0 { return c.P.T.Const(c.i64(), pl) }
    k := c.P.FoldKnown(c.fr().Ctx, x, c.i64())
    if c.P.T.KindOf(k) == types.Kind.Const { return k }
    return types.TypeId(-1)
}

# whether two expressions read the same name, or the same chain of fields, written twice (E16a's lo and lo + k)
fn sameRead(a ast.Expr&, b ast.Expr&) Bool {
    match a {
        case ast.Expr.Name(_, n) {
            match b {
                case ast.Expr.Name(_, m) { return n == m }
                nomatch { return false }
            }
        }
        case ast.Expr.Member(_, x, n) {
            match b {
                case ast.Expr.Member(_, y, m) { return n == m and sameRead(x, y) }
                nomatch { return false }
            }
        }
        case ast.Expr.Paren(_, x) { return sameRead(x, b) }
        nomatch { return false }
    }
}

# x in c (E29): c.Has(x), or c.Contains(x) where x is of c's own type
fn (c mut Checker&) membership(sp source.Span, a ast.Expr&, b ast.Expr&) typed.Expr&c {
    coll := c.expr(b, types.UnknownT)
    ct := c.deref(typeOf(coll))
    if ct == types.UnknownT {
        c.expr(a, types.UnknownT)
        return c.lit(sp, types.BoolT, 0)
    }
    et := c.arrayOf(ct)
    xw := c.P.T.Elem(et) if et != types.UnknownT else types.UnknownT
    if et == types.UnknownT {
        hm := c.roleUse(ct, "Has", 1, c.between(a.Span(), b.Span(), 2), "'in'")
        if hm >= 0 {
            hp := c.P.T.Items(c.P.T.Params(c.P.Sig(hm)))
            owner := generic.FnOwner(hm)
            nv := c.P.VarCount(owner)
            if nv == 0 {
                if c.P.T.KindOf(hp[1]) != types.Kind.Var { xw = c.deref(hp[1]) }
            } else if hp.Len() > 1 {
                # a generic collection's Has: its parameter as the collection's type arguments make it (Map<I32, V>)
                hb := generic.Binding(owner, nv)
                c.unify(hp[0], typeOf(coll), hb, false, true)
                xw = c.boundParam(hp, 1, hb)
            }
        }
    }
    x := c.expr(a, xw)
    name := "Contains" if c.P.T.Same(c.deref(typeOf(x)), ct) else "Has"
    m := c.roleUse(ct, name, 1, c.between(a.Span(), b.Span(), 2), "'in'")
    if m < 0 and c.notOperator(ct, name, c.between(a.Span(), b.Span(), 2), "'x in c'", 1, false) { return c.lit(sp, types.BoolT, 0) }
    if m < 0 {
        # E29: x of the collection's own type asks Contains - a sub-collection
        c.err(c.between(a.Span(), b.Span(), 2), msgs.MembershipNoMethod(name, c.ty(ct)))
        return c.lit(sp, types.BoolT, 0)
    }
    # E29: a Has or Contains that can fail is written under try - said at "in"
    c.opCall = c.text(c.P.FnDecl(m).Name)
    c.opIn = c.between(a.Span(), b.Span(), 2)
    # x evaluated first, held in a hidden local, then the collection (E29)
    h := c.hidden(sp, typeOf(x))
    from := c.stmts.Len()
    c.stmts.Push(typed.Stmt.Let(sp, typed.LocalId(I32(h)), x))
    r := c.invoke(sp, sp, m, coll, Array<ast.Expr&>(0), c.one(c.readLocal(sp, h)))
    return typed.Expr.Seq(sp, typeOf(r), typed.Seq(gather(c.stmts, from), r))
}

# a < b <= c (E30): each operand evaluated once, the next comparison only where the last held - "a < b and b < c" with
# b evaluated once. A literal (a literal-only expression, E4a) has no evaluation to share: it is typed in each comparison
# it takes part in, beside that comparison's other operand, as it would be written out (T6, E6d)
fn (c mut Checker&) chain(sp source.Span, ch ast.Chain&) typed.Expr&c {
    base := c.exprs.Len()
    n := ch.Xs.Len()
    pure := Array<Bool>(n, false)
    for i in range n { pure[i] = c.fold(ch.Xs[i]).Ok }
    # what is literal-like but runs (a conditional of literals) is evaluated once, adapting to the nearest operand that
    # is no literal - its left neighbour's first
    lit := Array<Bool>(n, false)
    for i in range n {
        lit[i] = c.litLike(ch.Xs[i])
        if lit[i] {
            c.exprs.Push(c.hole(sp))
        } else {
            c.exprs.Push(c.value(c.expr(ch.Xs[i], types.UnknownT), ch.Xs[i].Span()))
        }
    }
    for i in range n {
        if not lit[i] or pure[i] { continue }
        j := -1
        for d in range 1, n {
            if i - d >= 0 and not lit[i - d] {
                j = i - d
                break
            }
            if i + d < n and not lit[i + d] {
                j = i + d
                break
            }
        }
        x := ch.Xs[i]
        if j < 0 {
            c.exprs[base + i] = c.value(c.expr(x, types.UnknownT), x.Span())
            continue
        }
        other := typeOf(c.exprs[base + j])
        tb := c.literalBeside(other) if c.isNumber(other) else types.UnknownT
        fits := c.litLikeFits(x, tb)
        e := c.value(c.expr(x, tb if fits else types.UnknownT), x.Span())
        k := i if i < j else j
        if not fits { c.noMeet(c.between(ch.Xs[k].Span(), ch.Xs[k + 1].Span(), ch.Ops[k].Text().Len()), other, typeOf(e)) }
        c.exprs[base + i] = e
    }
    r := c.chainFrom(sp, ch, base, pure, 0, null if pure[0] else c.exprs[base])
    c.exprs.Truncate(base)
    return r
}

# comparison i of a chain and the rest: left its left operand, null where that is a literal, typed here
fn (c mut Checker&) chainFrom(sp source.Span, ch ast.Chain&, base I64, pure Array<Bool>&, i I64, left typed.Expr?&c) typed.Expr&c {
    n := ch.Xs.Len()
    if i + 2 >= n { return c.chainCmp(sp, ch, i, left, null if pure[i + 1] else c.exprs[base + i + 1]) }
    if pure[i + 1] { return typed.Expr.Cond(sp, types.BoolT, typed.Cond(c.chainCmp(sp, ch, i, left, null), c.chainFrom(sp, ch, base, pure, i + 1, null), c.lit(sp, types.BoolT, 0))) }
    rt := typeOf(c.exprs[base + i + 1])
    h := c.hidden(sp, rt)
    from := c.stmts.Len()
    c.stmts.Push(typed.Stmt.Let(sp, typed.LocalId(I32(h)), c.exprs[base + i + 1]))
    first := c.chainCmp(sp, ch, i, left, c.readLocal(sp, h))
    held := typed.Expr.Seq(sp, types.BoolT, typed.Seq(gather(c.stmts, from), first))
    rest := c.chainFrom(sp, ch, base, pure, i + 1, c.readLocal(sp, h))
    return typed.Expr.Cond(sp, types.BoolT, typed.Cond(held, rest, c.lit(sp, types.BoolT, 0)))
}

# comparison i of a chain, x and y its operands - null for a literal, made here as the comparison written alone makes it
fn (c mut Checker&) chainCmp(sp source.Span, ch ast.Chain&, i I64, x typed.Expr?&c, y typed.Expr?&c) typed.Expr&c {
    a := ch.Xs[i]
    b := ch.Xs[i + 1]
    op := ch.Ops[i]
    if x is null and y is null { return c.binary(sp, op, a, b, types.UnknownT) }
    opSp := c.between(a.Span(), b.Span(), op.Text().Len())
    if x is null {
        lx := c.litBeside(a, c.fold(a), y!, op, opSp, false)
        if lx is null { return c.unknown(sp) }
        return c.opValues(sp, opSp, op, lx, y!, a.Span(), b.Span())
    }
    if y is null {
        ly := c.litBeside(b, c.fold(b), x, op, opSp, true)
        if ly is null { return c.unknown(sp) }
        return c.opValues(sp, opSp, op, x, ly, a.Span(), b.Span())
    }
    return c.opValues(sp, opSp, op, x, y, a.Span(), b.Span())
}

# ---- text (E11a, E11b) ----

# "a" $b "c": text joined from its pieces (E11b)
fn (c mut Checker&) join(sp source.Span, parts Array<ast.Expr&>&) typed.Expr&c {
    ps mut Vec<typed.Piece&>&c = Vec<typed.Piece&>()
    for p in parts {
        ok := false
        match p {
            case ast.Expr.Lit(lsp, kind) {
                if kind == token.Tok.StrLit {
                    ps.Push(typed.Piece.Lit(c.strBytes(lsp)))
                    ok = true
                }
            }
            case ast.Expr.Unary(_, op, y) {
                if op == token.Tok.Dollar {
                    ps.Push(c.renderPiece(p.Span(), y))
                    ok = true
                }
            }
            nomatch { }
        }
        if not ok { c.gap(p.Span(), "a join piece of this kind (E11b)") }
    }
    return typed.Expr.Text(sp, c.textType(), typed.Text(ps.ToArray(), c.site(typed.SiteKind.Text, sp)))
}

# ---- read-only copies (T25c) ----

# whether a value of the type holds a writable reference - a "mut" reference among its fields, payloads and the
# elements of its fixed arrays, walked by value, never through a reference (O25g's walk) - and so shares it with every
# copy of it
fn (c mut Checker&) holdsWritable(t types.TypeId) Bool { return c.holdsWritableAt(t, 0) }

fn (c mut Checker&) holdsWritableAt(t types.TypeId, depth I64) Bool {
    if depth > 16 or t == types.UnknownT { return false }
    match c.P.T.KindOf(t) {
        case types.Kind.Ref { return (c.P.T.PermOf(t) & types.Writable) != 0 and depth > 0 }
        case types.Kind.Array {
            if c.P.T.Length(t) == types.TypeId(0) { return false }
            return c.holdsWritableAt(c.P.T.Elem(t), depth + 1)
        }
        case types.Kind.Tuple, types.Kind.Record { return c.listHoldsWritable(c.P.T.Parts(t), depth) }
        case types.Kind.AnonEnum { return c.listHoldsWritable(c.P.T.ShapeCases(t), depth) }
        case types.Kind.Named {
            if not c.P.Body(t) { return false }
            k := c.declKind(t)
            if k == types.DeclKind.Struct { return c.listHoldsWritable(c.P.T.Fields(t), depth) }
            if k == types.DeclKind.Enum { return c.listHoldsWritable(c.P.T.Cases(t), depth) }
            if k == types.DeclKind.Over { return c.holdsWritableAt(c.P.T.Base(t), depth + 1) }
            return false
        }
        nomatch { return false }
    }
}

# whether what a reference names holds writable references it shares with a copy: an array's elements, any other
# value as itself
fn (c mut Checker&) namedHolds(t types.TypeId) Bool {
    for _ in range 8 {
        if c.P.T.KindOf(t) != types.Kind.Array { break }
        t = c.P.T.Elem(t)
    }
    return c.holdsWritable(t)
}

fn (c mut Checker&) listHoldsWritable(l types.ListId, depth I64) Bool {
    for x in c.P.T.Items(l) {
        if x != types.TypeId(0) and c.holdsWritableAt(x, depth + 1) { return true }
    }
    return false
}

fn (c mut Checker&) roKey(id I64) pair.Pair<I64, I64> { return pair.Pair(c.fr().Body, id) }

# whether a place is reached read-only: an immutable global, what a read-only reference names, a captured value, a
# read-only copy - and what is held in any of these by value
fn (c mut Checker&) roPlace(p typed.Lvalue?&) Bool {
    if p is null { return false }
    return match p {
        case typed.Lvalue.Local(_, ty, id) => c.roLocal(I64(id)) or (c.cur().Local(id).Kind == typed.LocalKind.Capture and not c.isRef(ty))
        case typed.Lvalue.Global(_, _, mi, n) => c.immutableGlobal(mi, n)
        case typed.Lvalue.Deref(_, _, ref) => c.roRef(ref)
        case typed.Lvalue.Field(_, _, base, _) => c.roPlace(base)
        case typed.Lvalue.Elem(_, _, e) => c.roPlace(e.Base)
        case typed.Lvalue.Payload(_, _, pl) => c.roPlace(pl.Base)
        case typed.Lvalue.Temp(_, _, v, _) => c.roValue(v)
        case _ => false
    }
}

# a writable reference given where one is wanted (T25b): read out of a read-only copy it is read-only - an error, false;
# read out of a by-value parameter, that parameter needs a writable argument
fn (c mut Checker&) roWritableRef(x typed.Expr&, sp source.Span) Bool {
    if c.P.T.KindOf(c.P.T.Referent(typeOf(x))) == types.Kind.Func { return true }
    if c.roRef(x) {
        c.err(sp, msgs.ReadOnlyToWritable())
        return false
    }
    c.roNeed(readPlace(x))
    return true
}

# whether a place is part, by value, of a value with no storage that is a read-only copy (a call's result copied out
# of what a read-only argument reaches): a writable reference read out of it is read-only (T25b)
fn (c mut Checker&) roTempBase(p typed.Lvalue?&) Bool {
    if p is null { return false }
    return match p {
        case typed.Lvalue.Field(_, _, base, _) => c.roTempBase(base)
        case typed.Lvalue.Elem(_, _, e) => c.roTempBase(e.Base)
        case typed.Lvalue.Payload(_, _, pl) => c.roTempBase(pl.Base)
        case typed.Lvalue.Temp(_, _, v, _) => c.roValue(v)
        case _ => false
    }
}

fn (c mut Checker&) roLocal(id I64) Bool { return c.roCopies.Has(c.roKey(id)) }

fn (c mut Checker&) immutableGlobal(mi I64, n source.NameId) Bool {
    v := c.P.GlobalDecl(mi, n)
    return v is not null and not writtenMut(v.Ty)
}

# whether a reference is read-only where it is read: by its type - save a call's, which is fresh or borrowed from an
# argument, and a for-in's borrow of a value, as read-only as that value - or, writable by its type, read out of a
# read-only copy by value (T25b)
fn (c mut Checker&) roRef(x typed.Expr?&) Bool {
    if x is null { return false }
    if (c.P.T.PermOf(typeOf(x)) & types.Writable) != 0 { return c.roRoot(readPlace(x)) >= 0 or c.roTempBase(readPlace(x)) }
    return match x {
        case typed.Expr.Read(_, _, p, _) => c.roRead(p)
        case typed.Expr.Borrow(_, _, p) => c.roPlace(p)
        case typed.Expr.Slice(_, _, sl) => c.roPlace(sl.Base)
        case typed.Expr.Call(_, _, cl) => c.roCallRef(cl)
        # a fixed array borrowed as a run-time-length one (T7c) is as read-only as the borrow
        case typed.Expr.Prim(_, _, op, _, args) => c.roRef(args[0]) if typed.PassesRefs(op) and args.Len() > 0 else true
        case typed.Expr.Promote(_, _, _), typed.Expr.Data(_, _, _, _), typed.Expr.Lit(_, _, _) => false
        case _ => true
    }
}

fn (c mut Checker&) roRead(p typed.Lvalue&) Bool {
    match p {
        case typed.Lvalue.Local(_, _, id) {
            # a generic's read-only reference parameter is as read-only as the argument a call gives it, which its
            # instance's body cannot know (roByArg)
            if c.cur().Local(id).Kind == typed.LocalKind.Param and c.inGeneric() { return false }
            return try c.roBorrows.Get(c.roKey(I64(id))) catch default true
        }
        nomatch { return true }
    }
}

# the local a place is part of by value - never through a reference, save one naming another place's storage (a
# borrow, a slice), followed to that place, and a reference local read out of a place, followed to it: -1 for none
fn (c mut Checker&) rootLocal(p typed.Lvalue?&) I64 { return c.rootIn(p, 0) }

fn (c mut Checker&) rootIn(p typed.Lvalue?&, depth I64) I64 {
    if p is null or depth > 32 { return -1 }
    match p {
        case typed.Lvalue.Local(_, _, id) {
            o := try c.roFrom.Get(c.roKey(I64(id))) catch default roOrigin(null, false)
            if o.P is not null { return c.rootIn(o.P, depth + 1) }
            return I64(id)
        }
        case typed.Lvalue.Field(_, _, base, _) { return c.rootIn(base, depth + 1) }
        case typed.Lvalue.Elem(_, _, e) { return c.rootIn(e.Base, depth + 1) }
        case typed.Lvalue.Payload(_, _, pl) { return c.rootIn(pl.Base, depth + 1) }
        # "x!" on a place, held as a temporary to be read through: what it names is what x names (E35)
        case typed.Lvalue.Temp(_, _, v, _) {
            u := unwrapped(v)
            if u == v { return -1 }
            return c.rootIn(readPlace(u), depth + 1)
        }
        case typed.Lvalue.Deref(_, _, ref) {
            q := readPlace(unwrapped(ref))
            match q {
                case typed.Lvalue.Local(_, _, id) {
                    o := try c.roFrom.Get(c.roKey(I64(id))) catch default roOrigin(null, false)
                    if o.P is not null and o.View { return c.rootIn(o.P, depth + 1) }
                }
                nomatch { }
            }
            return -1
        }
        nomatch { return -1 }
    }
}

# the read-only copy a place is part of by value: its local, or -1
fn (c mut Checker&) roRoot(p typed.Lvalue?&) I64 {
    r := c.rootLocal(p)
    return r if r >= 0 and c.roLocal(r) else -1
}

# a reference local made from a place (T25c): recorded, so what is reached through it is reached from that place
fn (c mut Checker&) roTrack(id I64, x typed.Expr?&) {
    if x is null or not c.isRef(typeOf(x)) { return }
    match x {
        case typed.Expr.Read(_, _, p, _) { c.roFrom.Put(c.roKey(id), roOrigin(p, false)) }
        case typed.Expr.Borrow(_, _, p) { c.roFrom.Put(c.roKey(id), roOrigin(p, true)) }
        case typed.Expr.Slice(_, _, sl) { c.roFrom.Put(c.roKey(id), roOrigin(sl.Base, true)) }
        nomatch { }
    }
}

# whether a value is a read-only copy: one whose type holds writable references, copied out of a place reached
# read-only, or chosen among values one of which is
fn (c mut Checker&) roValue(x typed.Expr?&) Bool {
    if x is null or c.isRef(typeOf(x)) or not c.holdsWritable(typeOf(x)) { return false }
    return c.roCopied(x)
}

fn (c mut Checker&) roCopied(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Read(_, _, p, _) => c.roPlace(p)
        case typed.Expr.Cond(_, _, k) => c.roCopied(k.A!) or c.roCopied(k.B)
        case typed.Expr.Seq(_, _, q) => q.X is not null and c.roCopied(q.X!)
        case typed.Expr.Match(_, _, m) => c.roMatch(m)
        case typed.Expr.Try(_, _, t) => t.X is not null and c.roCopied(t.X!)
        case typed.Expr.Call(_, _, cl) => c.roCallCopy(cl)
        case _ => false
    }
}

fn (c mut Checker&) roMatch(m typed.Match&) Bool {
    for a in m.Arms {
        if a.Value is not null and c.roCopied(a.Value!) { return true }
    }
    return m.NoMatch is not null and m.NoMatch!.Value is not null and c.roCopied(m.NoMatch!.Value!)
}

# the name a read-only value copies, for a note: a named local's or a global's, else 0
fn (c mut Checker&) roName(x typed.Expr&) source.NameId {
    return match x {
        case typed.Expr.Read(_, _, p, _) => c.placeName(p)
        case _ => source.NameId(0)
    }
}

fn (c mut Checker&) placeName(p typed.Lvalue&) source.NameId {
    return match p {
        case typed.Lvalue.Local(_, _, id) => c.cur().Local(id).Name
        case typed.Lvalue.Global(_, _, _, n) => n
        case _ => source.NameId(0)
    }
}

# a local declared from a value: a read-only copy where the value is one (T25c)
fn (c mut Checker&) roLet(id I64, x typed.Expr&) {
    if c.roValue(x) { c.roCopies.Put(c.roKey(id), c.roName(x)) }
    c.roTrack(id, x)
}

# how a copy of its own is made, for a diagnostic: through the type's Clone where it has one
fn (c mut Checker&) roFix(n source.NameId, t types.TypeId) String {
    if c.P.MethodOf(c.deref(t), c.P.L.Names.Intern("Clone")) < 0 { return "from its parts" }
    if n != source.NameId(0) { return "with '" $c.text(n) ".Clone()'" }
    return "with 'Clone()'"
}

# the note at the read-only copy a place is part of
# B11: a write through a local or parameter whose written type is read-only - the note at it naming the type to write
fn (c mut Checker&) noteWritable(rec I64, ref typed.Expr&) {
    p := readPlace(unwrapped(ref))
    if p is null { return }
    match p {
        case typed.Lvalue.Local(_, _, id) {
            l := c.cur().Local(id)
            if l.Name == source.NameId(0) or l.Marked == typed.Mark.Infer { return }
            if l.Kind != typed.LocalKind.Var and l.Kind != typed.LocalKind.Param { return }
            c.P.L.Diags.Note(rec, c.at(l.Sp), msgs.NoteDeclareWritable(c.text(l.Name), c.text(l.Name), c.ty(l.Ty)))
        }
        case _ { }
    }
}

fn (c mut Checker&) noteRo(rec I64, p typed.Lvalue?&) {
    id := c.roRoot(p)
    if id < 0 { return }
    l := c.cur().Local(typed.LocalId(I32(id)))
    if l.Name == source.NameId(0) { return }
    src := try c.roCopies.Get(c.roKey(id)) catch default source.NameId(0)
    w := c.at(l.Sp)
    if src != source.NameId(0) and c.P.MethodOf(c.deref(l.Ty), c.P.L.Names.Intern("Clone")) >= 0 {
        c.P.L.Diags.Note(rec, w, msgs.NoteReadOnlyCopyOf(c.text(l.Name), c.text(src), c.text(l.Name), c.text(src)))
    } else {
        c.P.L.Diags.Note(rec, w, msgs.NoteReadOnlyCopy(c.text(l.Name)))
    }
}

# a value stored where it can be written (a declaration's written type, an assignment, a literal's element, a payload,
# a result): a read-only copy may not be, said with m's words
fn (c mut Checker&) roStore(x typed.Expr?&, sp source.Span, kind I64) Bool {
    if not c.roValue(x) {
        if x is not null and not c.isRef(typeOf(x)) { c.roNeed(readPlace(x)) }
        if kind == RoReturned { c.roResult(x) } else { c.roDeepNeed(x) }
        return false
    }
    t := typeOf(x)
    fix := c.roFix(c.roName(x!), t)
    m := msgs.ReadOnlyCopyStored(c.ty(t), fix)
    if kind == 1 { m = msgs.ReadOnlyCopyDecl(c.ty(t), fix) }
    if kind == 2 { m = msgs.ReadOnlyCopyReturned(c.ty(t), fix) }
    if kind == 3 { m = msgs.ReadOnlyCopyGlobal(c.ty(t), fix) }
    rec := c.err(sp, m)
    c.noteRo(rec, readPlace(x!))
    return true
}

# the by-value parameter of this body a place is part of by value, its type holding writable references: its index
# among the parameters, -1 for none
fn (c mut Checker&) paramOf(p typed.Lvalue?&) I64 {
    r := c.rootLocal(p)
    return c.paramIndex(r) if r >= 0 else -1
}

fn (c mut Checker&) paramIndex(id I64) I64 {
    l := c.cur().Local(typed.LocalId(I32(id)))
    if l.Kind != typed.LocalKind.Param or c.isRef(l.Ty) or not c.holdsWritable(l.Ty) { return -1 }
    ps := c.cur().Params
    for i in range ps.Len() {
        if I64(ps[i]) == id { return i }
    }
    return -1
}

# this body's by-value parameter a place is part of needs a writable argument
fn (c mut Checker&) roNeed(p typed.Lvalue?&) {
    if p is null: return
    k := c.paramOf(p)
    if k >= 0 { c.roNeeds.Put(pair.Pair(c.fr().Body, k), true) }
}

# an argument for a by-value parameter of a body: a read-only copy is judged once the body's need is known; a
# parameter of this body passed on needs what the other needs
fn (c mut Checker&) roArgFor(body I64, k I64, e typed.Expr?&, sp source.Span, callee String&) {
    if body < 0 or e is null { return }
    me := c.fr().Body
    if c.isRef(typeOf(e)) {
        # an instance's read-only reference parameter (roByArg): a read-only argument is judged once its need is known
        if not c.roByArg(body, k) { return }
        r := c.P.T.Referent(c.P.T.Items(c.P.T.Params(c.Bodies[body].Ty))[k])
        if not c.namedHolds(r) { return }
        if c.roRef(e) {
            c.roRefArgs.Push(roArg(body, k, c.at(sp), callee, c.ty(r), ""))
            return
        }
        match e {
            case typed.Expr.Borrow(_, _, p) {
                j := c.paramOf(p)
                if j >= 0 { c.roDeps.Push(pair.Pair(pair.Pair(me, j), pair.Pair(body, k))) }
            }
            nomatch { }
        }
        if c.instanceBody(me) { c.roDeepArgs.Push(roDeepArg(me, e, body, k)) }
        return
    }
    if not c.holdsWritable(typeOf(e)) { return }
    if c.roValue(e) {
        c.roArgs.Push(roArg(body, k, c.at(sp), callee, c.ty(typeOf(e)), c.roFix(c.roName(e), typeOf(e))))
        return
    }
    j := c.paramOf(readPlace(e))
    if j >= 0 { c.roDeps.Push(pair.Pair(pair.Pair(me, j), pair.Pair(body, k))) }
    if c.instanceBody(me) { c.roDeepArgs.Push(roDeepArg(me, e, body, k)) }
}

# what each by-value parameter needs settled over every call, then the read-only copies passed to one that needs a
# writable argument, and the function values with such a parameter, said
fn (c mut Checker&) roSettle() {
    c.roSettleDeep()
    for _ in range c.roDeps.Len() + 1 {
        changed := false
        for d in c.roDeps {
            if c.roNeeds.Has(d.Second) and not c.roNeeds.Has(d.First) {
                c.roNeeds.Put(d.First, true)
                changed = true
            }
        }
        if not changed { break }
    }
    for a in c.roArgs {
        if not c.roNeeds.Has(pair.Pair(a.Body, a.Param)) { continue }
        b := c.Bodies[a.Body]
        if a.Param >= b.Params.Len() { continue }
        l := b.Local(b.Params[a.Param])
        rec := c.P.L.Diags.Error(a.At, msgs.ReadOnlyCopyArg(a.Callee, c.text(l.Name), a.Ty, a.Fix))
        c.P.L.Diags.Note(rec, diag.Where.Span(b.File, I64(l.Sp.Start), I64(l.Sp.End)), msgs.NoteDeclaredHere(c.tok(l.Name)))
    }
    c.strReceivers()
    for a in c.roRefArgs {
        if not c.roNeeds.Has(pair.Pair(a.Body, a.Param)) { continue }
        b := c.Bodies[a.Body]
        if a.Param >= b.Params.Len() { continue }
        l := b.Local(b.Params[a.Param])
        rec := c.P.L.Diags.Error(a.At, msgs.ReadOnlyRefKept(a.Callee, c.text(l.Name), a.Ty))
        c.P.L.Diags.Note(rec, diag.Where.Span(b.File, I64(l.Sp.Start), I64(l.Sp.End)), msgs.NoteDeclaredHere(c.tok(l.Name)))
    }
    for f in c.roFns {
        b := c.Bodies[f.Body]
        for k in range f.First, b.Params.Len() {
            if not c.roNeeds.Has(pair.Pair(f.Body, k)) { continue }
            l := b.Local(b.Params[k])
            fix := c.roFix(source.NameId(0), l.Ty)
            c.P.L.Diags.Error(f.At, msgs.ReadOnlyFuncValue(f.What, c.text(l.Name), fix))
            break
        }
    }
}

# E11c: "$" renders read-only values too (an immutable global, a part of a read-only reference), so a Str whose by-value
# receiver needs a writable argument is refused, at its name - once per declaration
fn (c mut Checker&) strReceivers() {
    said := Map<I64, Bool>()
    for id in range c.Bodies.Len() {
        if c.state[id] != 2 or not c.roNeeds.Has(pair.Pair(id, 0)) { continue }
        match c.Bodies[id].Of {
            case typed.BodyOf.Fn(inst) {
                f := c.P.InstanceFn(inst)
                fd := c.P.FnDecl(f)
                n := c.text(fd.Name)
                if fd.Recv is null or (n != "Str" and n != "str") or said.Has(f) { continue }
                said.Put(f, true)
                mi := c.P.FnModule(f)
                text := c.P.L.Mods[mi].Src!.Text
                from := I64(fd.Recv!.Sp.End)
                at := try text[from:I64(fd.Sp.End)].Find(n) catch default -1
                st := I64(fd.Sp.Start) if at < 0 else from + at
                c.P.L.Diags.Error(diag.Where.Span(c.P.L.Mods[mi].File, st, st + n.Len()), msgs.StrReceiverWritable())
            }
            nomatch { }
        }
    }
}

# ---- read-only copies through a generic's read-only reference parameters (T25c: roByArg, roToResult) ----

# whether a body is a generic instance's: its read-only reference parameters are as read-only as each call's argument
fn (c mut Checker&) instanceBody(id I64) Bool {
    if id < 0 or id >= c.Bodies.Len() { return false }
    return match c.Bodies[id].Of {
        case typed.BodyOf.Fn(inst) => c.P.T.Items(c.P.InstanceArgs(inst)).Len() > 0
        case _ => false
    }
}

# whether parameter k of body id is such a parameter (roByArg): a read-only reference, no function value, in an instance
fn (c mut Checker&) roByArg(id I64, k I64) Bool {
    if not c.instanceBody(id) { return false }
    ps := c.P.T.Items(c.P.T.Params(c.Bodies[id].Ty))
    if k < 0 or k >= ps.Len() or not c.isRef(ps[k]) { return false }
    return (c.P.T.PermOf(ps[k]) & types.Writable) == 0 and c.P.T.KindOf(c.P.T.Referent(ps[k])) != types.Kind.Func
}

# whether a call of body id gives a by-value result as read-only as its argument k: one its body copies out of that
# parameter, or - its body not checked yet (a cycle) - any such parameter
fn (c mut Checker&) roFollows(id I64, k I64) Bool {
    if c.roToResult.Has(pair.Pair(id, k)) { return true }
    return c.roByArg(id, k) and c.state[id] != 2
}

# a read-only reference a call gives: borrowed from an instance's read-only reference parameter, as read-only as that
# argument; any other is fresh or as its own type says
fn (c mut Checker&) roCallRef(cl typed.Call&) Bool {
    k := c.roBorrowedFrom(cl)
    return k >= 0 and k < cl.Args.Len() and c.roRef(cl.Args[k])
}

# a call's by-value result copied out of what a read-only argument reaches (roToResult)
fn (c mut Checker&) roCallCopy(cl typed.Call&) Bool {
    id := c.bodyOfCallee(cl.Target)
    if id < 0 { return false }
    for k in range cl.Args.Len() {
        a := cl.Args[k]
        if c.isRef(typeOf(a)) and c.roFollows(id, k) and c.roRef(a) { return true }
    }
    return false
}

# the parameter of a call's body a reference result is borrowed from: an instance's read-only reference parameter
# whose scope the result's is, -1 for none
fn (c mut Checker&) roBorrowedFrom(cl typed.Call&) I64 {
    id := c.bodyOfCallee(cl.Target)
    if id < 0 or not c.instanceBody(id) { return -1 }
    sig := c.Bodies[id].Ty
    e := c.P.T.ResultFrom(sig, 0)
    if e < 0 { return -1 }
    for k in range cl.Args.Len() {
        j := c.P.T.ShareOf(sig, k)
        if (k == e or j == e) and c.roByArg(id, k) { return k }
    }
    return -1
}

# a value an instance's body copies is checked before a caller asks for it: a call of an instance with such a
# parameter, whose result can hold writable references
fn (c mut Checker&) roCheckCallee(target typed.Callee&, r types.TypeId) {
    id := c.bodyOfCallee(target)
    if id < 0 or c.state[id] != 0 or not c.instanceBody(id) { return }
    if not c.isRef(r) and not c.holdsWritable(r) { return }
    ps := c.P.T.Items(c.P.T.Params(c.Bodies[id].Ty))
    for k in range ps.Len() {
        if c.roByArg(id, k) {
            c.checkNow(id)
            return
        }
    }
}

# a value given a local of an instance's body - its initializer, an assignment - kept for the walk below
fn (c mut Checker&) roKeep(s typed.Stmt&) {
    b := c.fr().Body
    if not c.instanceBody(b) { return }
    match s {
        case typed.Stmt.Let(_, id, x) { c.roKeepVal(b, I64(id), x) }
        case typed.Stmt.Assign(_, t, x) {
            match t {
                case typed.Lvalue.Local(_, _, id) { c.roKeepVal(b, I64(id), x) }
                nomatch { }
            }
        }
        nomatch { }
    }
}

fn (c mut Checker&) roKeepVal(b I64, id I64, x typed.Expr?&) {
    if x is null { return }
    key := pair.Pair(b, id)
    if not c.roVals.Has(key) { c.roVals.Put(key, Vec<typed.Expr&>()) }
    l := try c.roVals.Get(key) catch { return }
    l.Push(x)
}

# the read-only reference parameters of body b (roByArg) a value is copied out of, through any number of references
# and of locals (by every value given them), and through calls handing back what such a parameter reaches - a by-value
# result copied out of it (roToResult), a reference borrowed from it: their indices added to out
fn (c mut Checker&) roDeep(b I64, x typed.Expr&, out mut Vec<I64>&) {
    seen := Map<I64, Bool>()
    c.roDeepIn(b, x, out, seen, 0)
}

fn (c mut Checker&) roDeepIn(b I64, x typed.Expr?&, out mut Vec<I64>&, seen mut Map<I64, Bool>&, depth I64) {
    if x is null or depth > 48 { return }
    match x {
        case typed.Expr.Read(_, _, p, _) { c.roDeepPlace(b, p, out, seen, depth + 1) }
        case typed.Expr.Borrow(_, _, p) { c.roDeepPlace(b, p, out, seen, depth + 1) }
        case typed.Expr.Slice(_, _, sl) { c.roDeepPlace(b, sl.Base, out, seen, depth + 1) }
        case typed.Expr.Promote(_, _, pr) { c.roDeepIn(b, pr.X, out, seen, depth + 1) }
        case typed.Expr.Cond(_, _, k) {
            c.roDeepIn(b, k.A, out, seen, depth + 1)
            c.roDeepIn(b, k.B, out, seen, depth + 1)
        }
        case typed.Expr.Seq(_, _, q) { c.roDeepIn(b, q.X, out, seen, depth + 1) }
        case typed.Expr.Try(_, _, t) { c.roDeepIn(b, t.X, out, seen, depth + 1) }
        case typed.Expr.Match(_, _, m) {
            for a in m.Arms { c.roDeepIn(b, a.Value, out, seen, depth + 1) }
            if m.NoMatch is not null { c.roDeepIn(b, m.NoMatch!.Value, out, seen, depth + 1) }
        }
        case typed.Expr.Prim(_, _, op, _, args) {
            if typed.PassesRefs(op) and args.Len() > 0 { c.roDeepIn(b, args[0], out, seen, depth + 1) }
        }
        case typed.Expr.Call(_, ty, cl) {
            id := c.bodyOfCallee(cl.Target)
            if id < 0 { return }
            if c.isRef(ty) {
                sig := c.Bodies[id].Ty
                e := c.P.T.ResultFrom(sig, 0)
                if e < 0 { return }
                for k in range cl.Args.Len() {
                    if (k == e or c.P.T.ShareOf(sig, k) == e) and c.isRef(typeOf(cl.Args[k])) { c.roDeepIn(b, cl.Args[k], out, seen, depth + 1) }
                }
                return
            }
            for k in range cl.Args.Len() {
                if c.roFollows(id, k) { c.roDeepIn(b, cl.Args[k], out, seen, depth + 1) }
            }
        }
        nomatch { }
    }
}

fn (c mut Checker&) roDeepPlace(b I64, p typed.Lvalue?&, out mut Vec<I64>&, seen mut Map<I64, Bool>&, depth I64) {
    if p is null or depth > 48 { return }
    match p {
        case typed.Lvalue.Local(_, _, id) {
            l := c.Bodies[b].Local(id)
            if l.Kind == typed.LocalKind.Param {
                ps := c.Bodies[b].Params
                for k in range ps.Len() {
                    if ps[k] == id and c.roByArg(b, k) and not out.Has(k) { out.Push(k) }
                }
                return
            }
            if l.Kind == typed.LocalKind.Capture or seen.Has(I64(id)) { return }
            seen.Put(I64(id), true)
            vs := try c.roVals.Get(pair.Pair(b, I64(id))) catch { return }
            for v in vs { c.roDeepIn(b, v, out, seen, depth + 1) }
        }
        case typed.Lvalue.Deref(_, _, ref) { c.roDeepIn(b, ref, out, seen, depth + 1) }
        case typed.Lvalue.Field(_, _, base, _) { c.roDeepPlace(b, base, out, seen, depth + 1) }
        case typed.Lvalue.Elem(_, _, e) { c.roDeepPlace(b, e.Base, out, seen, depth + 1) }
        case typed.Lvalue.Payload(_, _, pl) { c.roDeepPlace(b, pl.Base, out, seen, depth + 1) }
        case typed.Lvalue.Temp(_, _, v, _) { c.roDeepIn(b, v, out, seen, depth + 1) }
        nomatch { }
    }
}

# the name a span ends with: a member's
fn (c mut Checker&) lastName(sp source.Span) source.Span {
    t := c.src(sp)
    i := t.Len()
    for i > 0 and (t[i - 1].IsLetter() or t[i - 1].IsDigit() or t[i - 1] == '_') { i-- }
    if i == t.Len() { return sp }
    return source.Span(sp.Start + I32(i), sp.End)
}

# where a conditional or a match giving a value is written - its "if" or its "match" - for E28's error; Start -1 for
# what is neither
fn (c mut Checker&) chosenAt(x typed.Expr&) source.Span {
    match x {
        case typed.Expr.Cond(csp, _, k) {
            if k.A is not null and k.A!.Span().End <= csp.End and k.A!.Span().Start == csp.Start { return c.opAfter(k.A!.Span(), 2) }
        }
        case typed.Expr.Match(msp, _, _) { return source.Span(msp.Start, msp.Start + 5) }
        nomatch { }
    }
    return source.Span(-1, -1)
}

# whether a conditional or a match chooses a value with storage - a place, an element read through At, a tried one: a
# copy of it, which a callee lent it would write and drop (E28, S12b)
fn (c mut Checker&) condChoosesPlace(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Cond(_, _, k) { return c.armPlace(k.A) or c.armPlace(k.B) }
        case typed.Expr.Match(_, _, m) {
            for a in m.Arms {
                if c.armPlace(a.Value) { return true }
            }
            return m.NoMatch is not null and c.armPlace(m.NoMatch!.Value)
        }
        nomatch { return false }
    }
}

fn (c mut Checker&) armPlace(x typed.Expr?&) Bool {
    if x is null { return false }
    match x {
        case typed.Expr.Borrow(_, _, _) { return true }
        case typed.Expr.Read(_, ty, _, _) { return not c.isRef(ty) }
        case typed.Expr.Promote(_, _, pr) { return c.armPlace(pr.X) }
        case typed.Expr.Call(csp, _, cl) { return cl.Args.Len() > 0 and cl.Args[0].Span() == csp }
        case typed.Expr.Try(_, _, t) { return t.X is not null and c.armPlace(t.X) }
        case typed.Expr.Cond(_, _, _), typed.Expr.Match(_, _, _) { return c.condChoosesPlace(x) }
        nomatch { return false }
    }
}

# a value with no storage of its own lent writably (T25c): a read-only copy may not be - a call's result copied out of
# what a read-only argument reaches
fn (c mut Checker&) roLend(x typed.Expr&, sp source.Span) {
    if c.roValue(x) {
        c.err(c.roCallAt(x, sp), msgs.ReadOnlyCopyLent(c.roFix(c.roName(x), typeOf(x))))
        return
    }
    c.roDeepNeed(x)
}

# where a call's result is said: an index through At at its "[" (stage 0's token for it), any other where it is written
fn (c mut Checker&) roCallAt(x typed.Expr&, sp source.Span) source.Span {
    match x {
        case typed.Expr.Call(csp, _, cl) {
            if cl.Args.Len() > 0 and cl.Args[0].Span() == csp { return c.bracketIn(csp) }
        }
        nomatch { }
    }
    return sp
}

# a value of this body kept writable - stored where it can be written, lent writably: in an instance, the read-only
# reference parameters it is copied out of need writable arguments, judged once every body is checked
fn (c mut Checker&) roDeepNeed(x typed.Expr?&) {
    if x is null or not c.instanceBody(c.fr().Body) { return }
    t := typeOf(x)
    if c.isRef(t) { t = c.P.T.Referent(t) }
    if not c.namedHolds(t) { return }
    c.roDeepNeeds.Push(pair.Pair(c.fr().Body, x))
}

# a by-value result of an instance's body holding writable references: the parameters it is copied out of give a call's
# result their argument's permission, settled at the body's end
fn (c mut Checker&) roResult(x typed.Expr?&) {
    if x is null or not c.instanceBody(c.fr().Body) or not c.holdsWritable(typeOf(x)) { return }
    c.roResults.Push(pair.Pair(c.fr().Body, x))
}

fn (c mut Checker&) roSettleResults(id I64) {
    for r in c.roResults {
        if r.First != id { continue }
        ps := Vec<I64>()
        c.roDeep(id, r.Second, ps)
        for k in ps { c.roToResult.Put(pair.Pair(id, k), true) }
    }
}

# what instance bodies keep writable of their read-only reference parameters, now every value given a local is known;
# and the arguments that rest on them
fn (c mut Checker&) roSettleDeep() {
    for n in c.roDeepNeeds {
        ps := Vec<I64>()
        c.roDeep(n.First, n.Second, ps)
        for k in ps { c.roNeeds.Put(pair.Pair(n.First, k), true) }
    }
    for a in c.roDeepArgs {
        ps := Vec<I64>()
        c.roDeep(a.Body, a.X, ps)
        for k in ps { c.roDeps.Push(pair.Pair(pair.Pair(a.Body, k), pair.Pair(a.Callee, a.Param))) }
    }
}

RoStored I64 = 0
RoDecl I64 = 1
RoReturned I64 = 2
RoGlobal I64 = 3

# ---- constraints (G19) ----

# a binding of owner's variables checked against their constraints where they are bound, reported at sp: whether
# every one is met
fn (c mut Checker&) bound(owner I64, args types.ListId, sp source.Span) Bool {
    u := c.P.FirstUnmet(owner, args)
    if u.Var < 0 { return true }
    x := c.P.T.Items(args)[u.Var]
    tn := c.text(c.P.T.DeclName(c.P.T.DeclOf(u.Trait)))
    v := c.text(c.P.VarAt(owner, u.Var).Name)
    if u.Sealed {
        c.err(sp, msgs.ConstraintSealed(c.ty(x), tn, v, tn, c.text(u.Method)))
        return false
    }
    if u.Closed {
        if not c.membersWritten(u.Trait) { return false }
        listing := c.memberListing(u.Trait)
        c.err(sp, msgs.ConstraintClosed(c.ty(x), tn, v, tn, listing.ToString()))
        return false
    }
    if not u.Named {
        c.err(sp, msgs.ConstraintUnmet(c.ty(x), tn, v))
        return false
    }
    name := c.text(u.Method)
    # T30a: a method of a trait the written one extends - named by the written one, the method's own trait said
    top := c.P.VarAt(owner, u.Var).Bound
    shown := name
    if c.P.T.KindOf(top) == types.Kind.Named and c.P.T.DeclOf(top) != c.P.T.DeclOf(u.Trait) {
        shown = $name " (" $tn "'s)"
        tn = c.text(c.P.T.DeclName(c.P.T.DeclOf(top)))
    }
    rec := c.err(sp, msgs.ConstraintUnmetHash(c.ty(x), tn, v) if name == "Hash" else msgs.ConstraintUnmetMethod(c.ty(x), tn, v, shown))
    # M6b: a tn's method is met by its own name, so a private spelling of it meets nothing; one of its name with
    # another signature is said too
    priv := lowerFirst(name)
    pm := c.P.MethodOf(x, c.P.L.Names.Intern(priv)) if priv != name else -1
    if pm >= 0 {
        c.noteAt(rec, pm, msgs.NotePrivateSpelling(priv, name))
    } else {
        sm := c.P.MethodOf(x, u.Method)
        if sm >= 0 { c.noteAt(rec, sm, msgs.NoteOtherSignature(name)) }
    }
    return false
}

fn (c mut Checker&) noteAt(rec I64, f I64, m msgs.Msg) {
    fd := c.P.FnDecl(f)
    mi := c.P.FnModule(f)
    text := c.P.L.Mods[mi].Src!.Text
    name := c.text(fd.Name)
    from := I64(fd.Recv!.Sp.End) if fd.Recv is not null else I64(fd.Sp.Start)
    at := try text[from:I64(fd.Sp.End)].Find(name) catch default -1
    s := I64(fd.Sp.Start) if at < 0 else from + at
    c.P.L.Diags.Note(rec, diag.Where.Span(c.P.L.Mods[mi].File, s, s + name.Len()), m)
}

# every type instance a type holds checked against its declaration's constraints, once each - where it is first asked
# for, reported at sp: whether all are met
fn (c mut Checker&) instancesMet(t types.TypeId, sp source.Span) Bool { return c.instancesIn(t, sp, 0) }

fn (c mut Checker&) instancesIn(t types.TypeId, sp source.Span, depth I64) Bool {
    if depth > 32 or t == types.UnknownT { return true }
    match c.P.T.KindOf(t) {
        case types.Kind.Named {
            args := c.P.T.Args(t)
            if args == types.ListId(0) { return true }
            if c.boundsMet.Has(t) { return try c.boundsMet.Get(t) catch default true }
            ok := c.listMet(args, sp, depth)
            if ok and c.P.T.Closed(t) { ok = c.bound(generic.DeclOwner(c.P.T.DeclOf(t)), args, sp) }
            c.boundsMet.Put(t, ok)
            return ok
        }
        case types.Kind.Ref { return c.instancesIn(c.P.T.Referent(t), sp, depth + 1) }
        case types.Kind.Array { return c.instancesIn(c.P.T.Elem(t), sp, depth + 1) }
        case types.Kind.Func {
            if not c.listMet(c.P.T.Params(t), sp, depth) { return false }
            return c.instancesIn(c.P.T.Result(t), sp, depth + 1)
        }
        case types.Kind.Tuple, types.Kind.Record { return c.listMet(c.P.T.Parts(t), sp, depth) }
        nomatch { return true }
    }
}

fn (c mut Checker&) listMet(l types.ListId, sp source.Span, depth I64) Bool {
    for x in c.P.T.Items(l) {
        if not c.instancesIn(x, sp, depth + 1) { return false }
    }
    return true
}

# T4, B11: an unknown type, said once in a module, with the type it most likely meant
fn (c mut Checker&) unknownType(sp source.Span, n source.NameId) {
    key := pair.Pair(c.fr().Mi, I64(n))
    if c.unknownTypes.Has(key) { return }
    c.unknownTypes.Put(key, true)
    name := c.text(n)
    best := c.suggest(name, false)
    if best.Len() == 0 { best = c.importedTypeNamed(name) }
    if best.Len() == 0 {
        c.err(sp, msgs.UnknownType(c.tok(n)))
    } else if c.P.T.Prim(best) != types.UnknownT {
        c.err(sp, msgs.UnknownNumberType(c.tok(n), best))
    } else {
        c.err(sp, msgs.UnknownTypeMeant(c.tok(n), best))
    }
}

# B11: a public type of that very name in a module this one imports, written as reached through its alias ("json.Json")
fn (c mut Checker&) importedTypeNamed(name String&) String {
    if not load.Public(name) { return "" }
    for imp in c.P.L.Mods[c.fr().Mi].Imports {
        if imp.Target < 0 { continue }
        for e in c.P.R.Tables[imp.Target].Entries {
            if e.Kind != names.What.Type or c.text(e.Name) != name { continue }
            alias := imp.Alias
            if alias.Len() == 0 {
                k := try imp.Spec.FindLast("/") catch default -1
                alias = imp.Spec[k + 1:]
            }
            return $alias "." $name
        }
    }
    return ""
}

# the name a misspelt one most likely meant (T4, B11): a number's name shortened to its letter and width (Int32 ->
# I32, Float64 -> F64, Uint8 -> U8), else the nearest type - built in, declared or the prelude's - or, withVars, any name
# of the module, a local or parameter in scope, or an import's alias
fn (c mut Checker&) suggest(name String&, withVars Bool) String {
    k := name.Len()
    for k > 0 and name[k - 1].IsDigit() { k-- }
    if name.Len() >= 2 and k < name.Len() and name.Len() - k < 8 {
        cand := $(name[0].ToUpper()) $name[k:]
        if c.P.T.Prim(cand) != types.UnknownT { return cand }
    }
    if name == "Byte" { return "U8" }
    near mut msgs.Nearest& = msgs.Nearest(name)
    # a value's name, nearest first: a local or parameter in scope, an import's alias, the module's own names
    if withVars {
        for b in c.fr().bound { near.Offer(c.text(b.Key)) }
        for imp in c.P.L.Mods[c.fr().Mi].Imports {
            if imp.Target >= 0 { near.Offer(imp.Alias) }
        }
    }
    for x in String&["I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F16", "BF16", "F32", "F64", "Bool", "Array"] {
        near.Offer(x)
    }
    for mi in range c.P.L.Mods.Len() {
        if mi != c.fr().Mi and not c.P.L.Mods[mi].Prelude { continue }
        own := mi == c.fr().Mi
        for e in c.P.R.Tables[mi].Entries {
            # the prelude's types and constants - its functions are methods, reached through a receiver
            ok := e.Kind == names.What.Type or (withVars and (e.Kind == names.What.Global or (own and e.Kind == names.What.Func)))
            if not ok { continue }
            t := c.text(e.Name)
            if not own and not load.Public(t) { continue }
            near.Offer(t)
        }
    }
    return $near.Best
}

# whether a number's text has a '_' standing anywhere but between two digits (L10b)
fn badSeparator(t String&) Bool {
    for i in range t.Len() {
        if t[i] != '_' { continue }
        if i == 0 or i + 1 >= t.Len() { return true }
        if not t[i - 1].IsDigit() and not isHexDigit(t[i - 1]) { return true }
        if not t[i + 1].IsDigit() and not isHexDigit(t[i + 1]) { return true }
        if (i >= 2 and t[i - 1] == 'x' and t[i - 2] == '0') or (i >= 2 and t[i - 1] == 'b' and t[i - 2] == '0') { return true }
    }
    return false
}

fn isHexDigit(c Char) Bool { return (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F') }

# T17: an enum with no case of this name - the nearest one suggested
fn (c mut Checker&) noCase(t types.TypeId, n source.NameId) msgs.Msg {
    name := c.text(n)
    cn := c.P.T.CaseNames(t)
    near mut msgs.Nearest& = msgs.Nearest(name)
    if cn.Len() > 0 {
        for x in cn { near.Offer(c.text(x)) }
    }
    if near.Best.Len() > 0 { return msgs.NoSuchCaseMeant(c.ty(t), c.tok(n), near.Best) }
    return msgs.NoSuchCase(c.ty(t), c.tok(n))
}


# a written type's instances checked where it is written: each at its first argument (G19)
# what "$" renders (E11a): a value - a call returning none is said at the "$"
# "$x" as a piece: a function named directly renders as its signature, "name(params) results ? errors", known here
# (E11a); anything else is rendered where the text is built
fn (c mut Checker&) renderPiece(sp source.Span, y ast.Expr&) typed.Piece&c {
    x := c.rendered(sp, y)
    match x {
        case typed.Expr.Fn(_, _, f) {
            match f {
                case typed.FnVal.Named(body) {
                    match c.Bodies[I64(body)].Of {
                        case typed.BodyOf.Fn(inst) {
                            t := c.sigText(inst, I64(body))
                            bs := Array<U8>(t.Len())
                            for i in range t.Len() { bs[i] = U8(t[i]) }
                            return typed.Piece.Lit(bs)
                        }
                        nomatch { }
                    }
                }
                nomatch { }
            }
        }
        nomatch { }
    }
    # E11b, T7b: an operand naming a fixed array is a borrow of it, its elements read when its piece renders - as a
    # run-time array's pair already names its storage
    p := readPlace(x)
    xt := typeOf(x)
    if p is not null and c.P.T.KindOf(xt) == types.Kind.Array and c.P.T.Length(xt) != types.TypeId(0) {
        return typed.Piece.Render(typed.Expr.Borrow(x.Span(), c.P.T.Ref(xt, types.ReadOnly), p))
    }
    return typed.Piece.Render(x)
}

# a function instance's signature as "$" writes it (E11a): its name, its parameters named, its result (a borrowed one
# with the parameter it lives where, "P&p"), its error set's items with commas, an error type whose every word it
# names written whole
fn (c mut Checker&) sigText(inst I64, body I64) String {
    fd := c.P.FnDecl(c.P.InstanceFn(inst))
    sig := c.P.InstanceSig(inst)
    b := StringBuilder()
    b.Push(c.text(fd.Name))
    b.PushChar('(')
    ps := c.P.T.Items(c.P.T.Params(sig))
    k I64 = 0
    if fd.Recv is not null { k = 1 }
    for i in range fd.S.Params.Len() {
        if i > 0 { b.Push(", ") }
        b.Push(c.text(fd.S.Params[i].Name))
        if k + i < ps.Len() {
            b.PushChar(' ')
            c.spell(b, ps[k + i], false)
            # a parameter sharing an earlier one's scope says whose ("b T&a", O4b)
            e := c.P.T.ShareOf(sig, k + i)
            if c.isRef(ps[k + i]) and e >= k and e - k < i { b.Push(c.text(fd.S.Params[e - k].Name)) }
        }
    }
    b.PushChar(')')
    r := c.P.T.Result(sig)
    if r != types.VoidT {
        b.PushChar(' ')
        c.spell(b, r, false)
        e := c.P.T.ResultFrom(sig, 0)
        if c.isRef(r) and e >= k and e - k < fd.S.Params.Len() { b.Push(c.text(fd.S.Params[e - k].Name)) }
    }
    es := c.P.T.Items(c.bodyErrors(body))   # an inferred set as its body lets it out (R1a)
    first := true
    for x in es {
        if x == types.DefaultErrT { continue }
        b.Push(" ? " if first else ", ")
        first = false
        if c.P.T.KindOf(x) == types.Kind.ErrWords {
            et := c.P.T.ErrOf(x)
            name := c.text(c.P.T.DeclName(c.P.T.DeclOf(et)))
            if c.spellQualified { name = $c.qualifierFor(c.P.T.DeclModule(c.P.T.DeclOf(et))) $name }
            ws := c.P.ErrorWords(c.P.T.DeclOf(et))
            mask := c.P.T.ErrMask(x)
            all := true
            for i in range ws.Len() {
                if i < 64 and (mask & (U64(1) << i)) == 0 { all = false }
            }
            if all {
                b.Push(name)
                continue
            }
            one := true
            for i in range ws.Len() {
                if i < 64 and (mask & (U64(1) << i)) != 0 {
                    if not one { b.Push(", ") }
                    b.Push($name "." $c.text(ws[i]))
                    one = false
                }
            }
            continue
        }
        c.spell(b, x, false)
    }
    return b.ToString()
}

fn (c mut Checker&) rendered(sp source.Span, y ast.Expr&) typed.Expr&c {
    x := c.expr(y, types.UnknownT)
    if typeOf(x) == types.VoidT {
        c.err(source.Span(sp.Start, sp.Start + 1), msgs.StrOfNothing())
        return c.unknown(sp)
    }
    seen := Map<types.TypeId, Bool>()
    c.strAt = source.Span(sp.Start, sp.Start + 1)
    c.wantStr(typeOf(x), seen, 0)
    c.strAt = source.Span(-1, -1)
    return x
}

# E11c: "$" calls Str wherever a value of a type declaring one sits in what it renders - the instances it calls made
# here, where the types are known, since a generic type's Str is otherwise made only where a call names it
fn (c mut Checker&) wantStr(t types.TypeId, seen mut Map<types.TypeId, Bool>&, depth I64) {
    if depth > 16 or t == types.UnknownT or t == types.TypeId(0) or seen.Has(t) { return }
    seen.Put(t, true)
    match c.P.T.KindOf(t) {
        case types.Kind.Ref { c.wantStr(c.P.T.Referent(t), seen, depth + 1) }
        case types.Kind.Named {
            for name in String&["Str", "str"] {
                m := c.P.MethodOf(t, c.P.T.Names.Intern(name))
                if m >= 0 {
                    if c.strAt.Start >= 0 { c.privateRole(m, t, "Str", c.strAt, "'$'") }
                    c.strInstance(m, t)
                    return
                }
            }
            if not c.P.Body(t) { return }
            k := c.declKind(t)
            if k == types.DeclKind.Struct {
                for f in c.P.T.Items(c.P.T.Fields(t)) { c.wantStr(f, seen, depth + 1) }
            } else if k == types.DeclKind.Enum {
                for f in c.P.T.Items(c.P.T.Cases(t)) { c.wantStr(f, seen, depth + 1) }
            } else if k == types.DeclKind.Over {
                c.wantStr(c.P.T.Base(t), seen, depth + 1)
            }
        }
        case types.Kind.Array { c.wantStr(c.P.T.Elem(t), seen, depth + 1) }
        case types.Kind.Tuple, types.Kind.Record {
            for f in c.P.T.Items(c.P.T.Parts(t)) { c.wantStr(f, seen, depth + 1) }
        }
        nomatch { }
    }
}

fn (c mut Checker&) strInstance(m I64, t types.TypeId) {
    if c.P.FnIsExtern(m) { return }
    sig := c.P.Sig(m)
    owner := generic.FnOwner(m)
    nv := c.P.VarCount(owner)
    if nv == 0 {
        c.fnBody(c.P.FnInstance(m, types.ListId(0)))
        return
    }
    ps := c.P.T.Items(c.P.T.Params(sig))
    if ps.Len() == 0 { return }
    b := generic.Binding(owner, nv)
    c.unify(ps[0], t, b, false, true)
    c.P.InferThroughBounds(b)
    for v in b.Vals {
        if v == types.UnknownT { return }
    }
    c.fnBody(c.P.FnInstance(m, c.P.T.List(b.Vals)))
}

# whether a written type is a reference, as written
fn refWrittenTop(t ast.TypeRef&) Bool {
    return match t {
        case ast.TypeRef.Ref(_, _, _, _) => true
        case _ => false
    }
}

fn (c mut Checker&) refWritten(t ast.TypeRef&) Bool {
    if refWrittenTop(t) { return true }
    # a type variable may be bound to a reference (T2)
    match t {
        case ast.TypeRef.Named(nsp, path, _) { return path.Len() == 1 and c.P.R.Use(c.fr().File, nsp.Start).Kind == names.What.TypeVar }
        nomatch { return false }
    }
}

# T30: a trait written where a value's type goes - said at the trait's name, of the type as written (whole)
fn (c mut Checker&) traitWritten(tr ast.TypeRef&, whole ast.TypeRef&) Bool {
    match tr {
        case ast.TypeRef.Named(nsp, path, _) {
            # a type's path is recorded at its start, an alias-qualified one too (names.typePath)
            ref := c.P.R.Use(c.fr().File, nsp.Start)
            if path.Len() > 1 and ref.Kind == names.What.None { ref = c.P.R.Member(c.fr().File, nsp.End) }
            if ref.Kind != names.What.Type or ref.Index < 0 { return false }
            if c.P.T.DeclKindOf(c.P.DeclFor(ref.Module, ref.Index)) != types.DeclKind.Trait { return false }
            c.err(nsp, msgs.TraitNotAType(c.src(whole.Span())))
            return true
        }
        nomatch { return false }
    }
}

# T32: "any R&" - R a trait, its arguments as many as its parameters
fn (c mut Checker&) anyWritten(tr ast.TypeRef&) Bool {
    match tr {
        case ast.TypeRef.Named(nsp, path, args) {
            # a type's path is recorded at its start, an alias-qualified one too (names.typePath)
            ref := c.P.R.Use(c.fr().File, nsp.Start)
            if path.Len() > 1 and ref.Kind == names.What.None { ref = c.P.R.Member(c.fr().File, nsp.End) }
            if ref.Kind == names.What.None and path.Len() == 1 {
                c.unknownType(nsp, path[0])
                return false
            }
            if ref.Kind != names.What.Type or ref.Index < 0 or c.P.T.DeclKindOf(c.P.DeclFor(ref.Module, ref.Index)) != types.DeclKind.Trait {
                c.err(tr.Span(), msgs.AnyNotTrait(c.src(tr.Span())))
                return false
            }
            ad := c.P.DeclFor(ref.Module, ref.Index)
            if not c.P.ArgsFit(ad, args) {
                c.err(tr.Span(), msgs.TypeArgCount(c.text(path[path.Len() - 1]), c.P.WrittenArity(ad), generic.WrittenTypes(args)))
                return false
            }
            for a in args {
                if generic.IsErrsArgOf(a) { continue }
                # G11: a trait's type argument names no scope, as a type's does not
                match a {
                    case ast.TypeRef.Ref(_, _, sc, _) {
                        if sc != source.NameId(0) {
                            c.err(a.Span(), msgs.TypeArgNamedScope())
                            return false
                        }
                    }
                    nomatch { }
                }
                if not c.writtenMet(a) { return false }
            }
            return true
        }
        nomatch {
            c.err(tr.Span(), msgs.AnyNotTrait(c.src(tr.Span())))
            return false
        }
    }
}

# X10: whether a written type names an extern type, as written (a reference to one is the only way to hold one)
fn (c mut Checker&) foreignNamed(tr ast.TypeRef&) Bool {
    match tr {
        case ast.TypeRef.Named(nsp, path, args) {
            if args.Len() > 0 { return false }
            ref := c.P.R.Use(c.fr().File, nsp.Start)
            if path.Len() > 1 { ref = c.P.R.Member(c.fr().File, nsp.End) }
            if ref.Kind != names.What.Type or ref.Index < 0 { return false }
            return c.P.T.DeclKindOf(c.P.DeclFor(ref.Module, ref.Index)) == types.DeclKind.Foreign
        }
        nomatch { return false }
    }
}

# T20: an error type or a named set written as a function's result - an error is raised, never returned: said at its
# name, whether it is one
fn (c mut Checker&) errorResult(tr ast.TypeRef?&) Bool {
    if tr is null { return false }
    match tr {
        case ast.TypeRef.Named(nsp, path, _) {
            # a type's path is recorded at its start, an alias-qualified one too (names.typePath)
            ref := c.P.R.Use(c.fr().File, nsp.Start)
            if path.Len() > 1 and ref.Kind == names.What.None { ref = c.P.R.Member(c.fr().File, nsp.End) }
            if ref.Kind != names.What.Type or ref.Index < 0 { return false }
            if c.P.T.DeclKindOf(c.P.DeclFor(ref.Module, ref.Index)) != types.DeclKind.Error { return false }
            n := c.text(path[path.Len() - 1])
            c.err(source.Span(nsp.End - I32(n.Len()), nsp.End), msgs.ErrorAsResult(n))
            return true
        }
        case ast.TypeRef.Ref(_, of, _, _) { return c.errorResult(of) }
        case ast.TypeRef.Perm(_, of, _, _) { return c.errorResult(of) }
        nomatch { return false }
    }
}

# whether a type may be held by reference (T24): a struct, an enum, an array, a type over an array, a type variable
fn (c mut Checker&) referable(t types.TypeId) Bool {
    k := c.P.T.KindOf(t)
    if k == types.Kind.Named {
        if not c.P.Body(t) { return true }
        dk := c.declKind(t)
        if dk == types.DeclKind.Over { return c.referable(c.P.T.Base(t)) }
        return true
    }
    return not (c.P.T.IsNumber(t) or t == types.BoolT or c.P.T.IsErrVal(t))
}

# whether a function type holds variable v of owner as an array's element, in its parameters or its result
fn (c mut Checker&) holdsVarInArray(sig types.TypeId, owner I64, v I64) Bool {
    if c.varInArray(c.P.T.Result(sig), owner, v, false, 0) { return true }
    for p in c.P.T.Items(c.P.T.Params(sig)) {
        if c.P.T.KindOf(p) != types.Kind.Func and c.varInArray(p, owner, v, false, 0) { return true }
    }
    return false
}

fn (c mut Checker&) varInArray(t types.TypeId, owner I64, v I64, inArray Bool, depth I64) Bool {
    if depth > 16 { return false }
    match c.P.T.KindOf(t) {
        case types.Kind.Var { return inArray and c.P.T.A(t) == owner and c.P.T.B(t) == v }
        case types.Kind.Array { return c.varInArray(c.P.T.Elem(t), owner, v, true, depth + 1) }
        case types.Kind.Ref { return c.varInArray(c.P.T.Referent(t), owner, v, false, depth + 1) }
        case types.Kind.Named {
            for x in c.P.T.Items(c.P.T.Args(t)) {
                if c.varInArray(x, owner, v, true, depth + 1) { return true }
            }
            return false
        }
        nomatch { return false }
    }
}

# whether a type is an array of a run-time length held by value - which inside an array or a struct is held by
# reference instead (T7a) - a declared array type (String, a "type Nums Array<I64>") too, being what it is declared over
fn (c mut Checker&) runArrayValue(t types.TypeId) Bool {
    u := c.under(t)
    return not c.isRef(t) and c.P.T.KindOf(u) == types.Kind.Array and c.P.T.Length(u) == types.TypeId(0)
}

fn (c mut Checker&) writtenMet(tr ast.TypeRef?&) Bool {
    if tr is null { return true }
    match tr {
        case ast.TypeRef.Named(nsp, path, args) {
            if path.Len() == 1 and not c.fr().Ctx.Vars.Has(path[0]) and c.P.R.Use(c.fr().File, nsp.Start).Kind == names.What.None {
                c.unknownType(nsp, path[0])
                return false
            }
            # G1a: an error-set parameter is no type - it stands where an error set is written
            if path.Len() == 1 and c.fr().Ctx.Vars.Has(path[0]) {
                v := try c.fr().Ctx.Vars.Get(path[0]) catch default types.UnknownT
                if c.P.IsErrVar(v) or c.P.T.KindOf(v) == types.Kind.ErrSet {
                    c.err(nsp, msgs.ErrVarNotType(c.tok(path[0]), c.text(path[0])))
                    return false
                }
            }
            if c.traitWritten(tr, tr) { return false }
            if c.foreignNamed(tr) {
                # X10: an extern type is held by reference alone
                c.err(nsp, msgs.ForeignByValue(c.src(tr.Span())))
                return false
            }
            ref := c.P.R.Use(c.fr().File, nsp.Start)
            if ref.Kind == names.What.Type and ref.Index >= 0 and not c.fr().Ctx.Vars.Has(path[path.Len() - 1]) {
                # G7: a generic type's arguments, as many as its parameters; a type with none takes none
                dd := c.P.DeclFor(ref.Module, ref.Index)
                np := c.P.T.DeclParams(dd)
                tn := c.text(path[path.Len() - 1])
                # G1a: an error-set argument closes the list, given where the type's list ends in an error-set parameter
                na := args.Len()
                if na > 0 and generic.IsErrsArgOf(args[na - 1]) {
                    if not c.P.HasErrParam(dd) {
                        c.err(args[na - 1].Span(), msgs.ErrSetArgUnwanted(tn))
                        return false
                    }
                    na--
                }
                if c.P.HasErrParam(dd) { np-- }
                if np == 0 and na > 0 {
                    c.err(args[0].Span(), msgs.TypeArgsOnNonGeneric(tn))
                    return false
                }
                if np > 0 and na > 0 and np != na {
                    rec := c.err(args[0].Span(), msgs.TypeArgCount(tn, np, na))
                    # L18c: a function type of several results, unparenthesized, took the arguments after it as its own
                    if np < args.Len() {
                        for i in range args.Len() - 1 {
                            if isFuncTypeRef(args[i]) {
                                c.P.L.Diags.Note(rec, c.at(args[i].Span()), msgs.NoteGroupFunctionType())
                                break
                            }
                        }
                    }
                    return false
                }
            }
            if args.Len() == 0 { return true }
            # G8, T7: Array's one argument is its element type - a length is never written
            if path.Len() == 1 and args.Len() > 1 and c.text(path[0]) == "Array" and ref.Kind == names.What.Builtin {
                c.err(args[1].Span(), msgs.ArrayTooManyArgs(args.Len()))
                return false
            }
            for a in args {
                if generic.IsErrsArgOf(a) { continue }   # its items are read where it is resolved (ErrorItemKnown)
                # T25b: "mut" before a type argument is a reference's permission
                match a {
                    case ast.TypeRef.Perm(psp, of, w, _) {
                        if w and not c.refWritten(of!) {
                            c.err(source.Span(psp.Start, psp.Start + 3), msgs.MutOnValueType(c.ty(c.P.Resolve(c.fr().Ctx, of))))
                            return false
                        }
                    }
                    nomatch { }
                }
                # G11: a type argument's reference marker is bare - its references live in the container
                match a {
                    case ast.TypeRef.Ref(rsp, _, sc, _) {
                        if sc != source.NameId(0) {
                            if path.Len() == 1 and c.text(path[0]) == "Array" {
                                # T24: an element's reference lives where the array does
                                nl := c.text(sc).Len()
                                c.err(source.Span(rsp.End - I32(nl), rsp.End), msgs.NamedScopeOnElement())
                            } else {
                                c.err(a.Span(), msgs.TypeArgNamedScope())
                            }
                            return false
                        }
                    }
                    nomatch { }
                }
                if not c.writtenMet(a) { return false }
            }
            rt := c.P.Resolve(c.fr().Ctx, tr)
            # T7a: an array's element that is a run-time array is held by reference - but in a declared function's
            # parameter, whose by-value levels take their lengths from the argument (G29)
            if not c.paramTypes and not c.declMade and c.P.T.KindOf(rt) == types.Kind.Array and c.runArrayValue(c.P.T.Elem(rt)) {
                c.err(args[0].Span(), msgs.ArrayNestedByValue(c.ty(c.P.T.Elem(rt))))
                return false
            }
            return c.instancesMet(rt, args[0].Span())
        }
        case ast.TypeRef.Ref(_, of, _, _) {
            match of {
                case ast.TypeRef.Any(_, trt) { return c.anyWritten(trt) }
                nomatch { }
            }
            if c.traitWritten(of, tr) { return false }
            if c.foreignNamed(of) { return true }    # X10: "Db&", "Db?&"
            if not c.writtenMet(of) { return false }
            # T24: only a struct, an enum or an array is held by reference
            rt := c.P.Resolve(c.fr().Ctx, of)
            if not c.referable(rt) {
                c.err(source.Span(of.Span().End, of.Span().End + 1), msgs.InvalidReferenceTarget(c.ty(rt)))
                return false
            }
            return true
        }
        case ast.TypeRef.Perm(_, of, _, _) { return c.writtenMet(of) }
        case ast.TypeRef.Any(asp, trt) {
            # T32: an "any" is always a reference
            c.err(asp, msgs.AnyNeedsMarker(c.src(trt.Span())))
            return false
        }
        case ast.TypeRef.Shape(_, body) {
            match body {
                case ast.TypeBody.Enum(_, raw) {
                    if raw is not null {
                        c.err(raw.Span(), msgs.RawAnonymous())   # T17e
                        return false
                    }
                }
                nomatch { }
            }
            return true
        }
        case ast.TypeRef.Func(_, s) {
            for prm in s.Params {
                if not c.writtenMet(prm.Ty) { return false }
            }
            if s.Results.Len() > 0 {
                for r in s.Results {
                    if c.errorResult(r) or not c.writtenMet(r) { return false }
                }
            }
            return true
        }
        nomatch { return true }
    }
}

# ---- calls (E13, E14, D8a, G9, M19) ----

fn (c mut Checker&) call(sp source.Span, f ast.Expr&, args Array<ast.Expr&>&, want types.TypeId) typed.Expr&c {
    # G37: a comprehension written as arguments gives one argument per item of its list
    args = c.spreadArgs(args)
    if c.spreadBad {
        c.spreadBad = false
        return c.unknown(sp)
    }
    match f {
        case ast.Expr.Name(nsp, n) {
            ref := c.P.R.Use(c.fr().File, nsp.Start)
            if ref.Kind == names.What.Func { return c.invoke(sp, nsp, c.P.FnNamed(ref.Module, n), null, args, Array<typed.Expr&>(0)) }
            if ref.Kind == names.What.Builtin { return c.conversion(sp, c.builtinType(n), args) }
            if ref.Kind == names.What.Type {
                t := c.typeNamed(f)
                if t < types.TypeId(0) and ref.Index >= 0 { return c.inferredCtor(sp, nsp, c.P.DeclFor(ref.Module, ref.Index), args, want) }
                if t < types.TypeId(0) { return c.unknown(sp) }
                return c.construct(sp, nsp, t, args)
            }
            if ref.Kind == names.What.None {
                # B11: with the name it most likely meant - a number's, said as an unknown type (T4)
                best := c.suggest(c.text(n), true)
                if best.Len() == 0 {
                    c.err(nsp, msgs.UnknownFunction(c.tok(n)))
                } else if c.P.T.Prim(best) != types.UnknownT {
                    c.err(nsp, msgs.UnknownNumberType(c.tok(n), best))
                } else {
                    c.err(nsp, msgs.UnknownFunctionMeant(c.tok(n), best))
                }
                c.dropArgs(args)
                return c.unknown(sp)
            }
            if ref.Kind == names.What.Local {
                # G34: a case descriptor called builds its case, as the case's name would - a struct's one case its
                # constructor
                dt := c.descTypeOf(f)
                if dt == types.UnknownT {
                    c.dropArgs(args)
                    return c.unknown(sp)
                }
                if dt >= types.TypeId(0) and c.P.DescOf(dt).K == generic.DescFunc { return c.reflFnCall(sp, nsp, c.P.DescOf(dt), args) }
                if dt >= types.TypeId(0) and c.P.DescOf(dt).K == generic.DescCase {
                    ds := c.P.DescOf(dt)
                    r := c.P.ReflUnder(ds.Of)
                    if c.isStruct(r) { return c.construct(sp, nsp, ds.Of, args) }
                    # T20: an error value's word, a case of no fields - its value
                    if c.P.T.KindOf(r) == types.Kind.ErrVal {
                        codes := c.P.ErrValCodes(r)
                        if args.Len() > 0 or ds.Case >= codes.Len() {
                            c.err(sp, msgs.ArgCount(0, "s", args.Len()))
                            c.dropArgs(args)
                            return c.unknown(sp)
                        }
                        return c.lit(sp, r, codes[ds.Case])
                    }
                    return c.enumCase(sp, nsp, ds.Of, c.P.T.CaseNames(r)[ds.Case], args)
                }
            }
            if ref.Kind == names.What.Local or ref.Kind == names.What.Global {
                return c.callValue(sp, nsp, c.expr(f, types.UnknownT), args)
            }
            if ref.Kind == names.What.TypeVar {
                # G8b: U(x) in an instance is the call its bound type's name is - a conversion, or a constructor
                t := c.typeNamed(f)
                if t >= types.TypeId(0) and (c.P.T.IsFloat(t) or c.P.T.IsInt(t) or t == types.BoolT) { return c.conversion(sp, t, args) }
                if t >= types.TypeId(0) and c.isNamed(t) { return c.construct(sp, nsp, t, args) }
                if t >= types.TypeId(0) and c.P.T.KindOf(t) != types.Kind.Var {
                    c.err(nsp, msgs.NotCallable(c.ty(t)))
                    c.dropArgs(args)
                    return c.unknown(sp)
                }
            }
            c.gap(nsp, "a call of a name of this kind")
            return c.unknown(sp)
        }
        case ast.Expr.Member(msp, x, n) {
            ref := c.P.R.Member(c.fr().File, msp.End)
            nsp := memberSpan(msp, c.text(n).Len())
            if ref.Kind == names.What.Func { return c.invoke(sp, nsp, c.P.FnNamed(ref.Module, n), null, args, Array<typed.Expr&>(0)) }
            if ref.Kind == names.What.Type {
                t := c.typeNamed(f)
                if t < types.TypeId(0) and ref.Index >= 0 { return c.inferredCtor(sp, nsp, c.P.DeclFor(ref.Module, ref.Index), args, want) }
                if t < types.TypeId(0) { return c.unknown(sp) }
                return c.construct(sp, nsp, t, args)
            }
            if ref.Kind != names.What.None {
                c.gap(nsp, "a call of this kind")
                return c.unknown(sp)
            }
            # G38: a reflected type called is the call its type's name is - "T.Base(x)", "p.Type(v)" - unless the
            # name is a case of the enum named ("ast.Decl.Type(...)")
            et0 := c.typeNamed(x)
            caseNamed := et0 >= types.TypeId(0) and c.isEnum(et0) and c.hasCase(et0, n)
            gd0 := c.genericNamed(x)
            if gd0 >= types.DeclId(0) and c.P.T.DeclKindOf(gd0) == types.DeclKind.Enum { caseNamed = true }
            if generic.ProjectsType(c.text(n)) and not caseNamed {
                rt := c.reflType(f)
                if rt == types.UnknownT {
                    c.dropArgs(args)
                    return c.unknown(sp)
                }
                if rt >= types.TypeId(0) and (c.P.T.IsFloat(rt) or c.P.T.IsInt(rt) or rt == types.BoolT) { return c.conversion(sp, rt, args) }
                if rt >= types.TypeId(0) and c.isNamed(rt) { return c.construct(sp, nsp, rt, args) }
                if rt >= types.TypeId(0) {
                    c.err(nsp, msgs.NotCallable(c.ty(rt)))
                    c.dropArgs(args)
                    return c.unknown(sp)
                }
            }
            et := c.typeNamed(x)
            if et >= types.TypeId(0) and c.text(n) == "From" and c.isEnum(et) and not c.hasCase(et, n) { return c.enumFrom(sp, nsp, et, args) }
            if et >= types.TypeId(0) { return c.enumCase(sp, nsp, et, n, args) }
            gd := c.genericNamed(x)
            if gd >= types.DeclId(0) and c.P.T.DeclKindOf(gd) == types.DeclKind.Enum { return c.genericCase(sp, nsp, gd, n, args, want) }
            # G33, G34: a list's Len, a field's Of
            rl := c.listOf(x)
            if rl.Ok {
                if c.text(n) == "Len" and args.Len() == 0 {
                    if rl.Of == types.UnknownT { return c.unknown(sp) }
                    return c.lit(sp, c.i64(), c.listItems(x.Span(), rl).Len())
                }
                c.err(x.Span(), msgs.ReflListValue($c.src(x.Span())))
                c.dropArgs(args)
                return c.unknown(sp)
            }
            dt := c.descTypeOf(x)
            if dt >= types.TypeId(0) and c.text(n) == "Of" {
                if dt == types.UnknownT { return c.unknown(sp) }
                fp := c.reflOf(sp, nsp, dt, args)
                if fp is null { return c.unknown(sp) }
                return c.read(sp, fp)
            }
            if ref.Kind == names.What.None and c.importPath(x) {
                # a name the imported module does not declare (or does not export: the resolver said so already)
                at := match x {
                    case ast.Expr.Name(xsp, _) => c.P.R.Use(c.fr().File, xsp.Start).Module
                    case ast.Expr.Member(xsp, _, _) => c.P.R.Member(c.fr().File, xsp.End).Module
                    case _ => -1
                }
                if at >= 0 and not c.declaresName(at, n) { c.notInModule(at, n, nsp) }
                c.dropArgs(args)
                return c.unknown(sp)
            }
            return c.methodCall(sp, x, n, nsp, args)
        }
        case ast.Expr.Generic(gsp, g, targs) {
            # G40: x.Attr<A>(), x.HasAttr<A>() - a type's or a descriptor's attributes
            ar := c.attrRead(sp, g, targs, args)
            if ar is not null { return ar }
            return c.genericCall(sp, gsp, g, targs, args, want)!
        }
        nomatch { return c.callValue(sp, c.opAfter(f.Span(), 1), c.expr(f, types.UnknownT), args) }
    }
}

# Array<T>(n), Array<T>(n, fill) (D14, T8, QP1) - every array construction's type decided here: an Array<T, n> where n
# is a compile-time constant (T7c: a literal, a constant, an immutable global's value - a K1a-evaluable call too, once
# M8's evaluator decides it), else a run-time Array<T>; a written target type wins (want an Array<T> of a run-time
# length, or of another length, which fit then reports)
fn (c mut Checker&) arrayMake(sp source.Span, elem types.TypeId, args Array<ast.Expr&>&, want types.TypeId, filled typed.Expr?&c = null) typed.Expr&c {
    n0 := c.exprTo(args[0], c.i64())
    length := types.TypeId(0)
    w := c.deref(want) if want != types.UnknownT else types.UnknownT
    # QP1, T7c: fixed storage where n is known while compiling - except where a run-time array is wanted (a local some
    # store gives another length, an Array<T>& to keep), which takes it as it is
    runWanted := w != types.UnknownT and c.P.T.KindOf(c.under(w)) == types.Kind.Array and c.P.T.Length(c.under(w)) == types.TypeId(0)
    if not runWanted {
        k := c.P.FoldLength(c.fr().Ctx, args[0])
        if c.P.T.KindOf(k) == types.Kind.Const and c.P.T.ConstValue(k) < 0 {
            # D14b: a negative length known while compiling is said here
            c.err(args[0].Span(), msgs.ArrayLengthRange(c.P.T.ConstValue(k)))
        } else {
            length = k
        }
    }
    at := c.P.T.Array(elem, length)
    from := c.exprs.Len()
    if args.Len() == 2 {
        # T2c: the type written for the declaration is not the element's - no note pointing at it
        wasFill := c.nullDecl
        c.nullDecl = diag.Where.Nowhere
        x := filled if filled is not null else c.exprTo(args[1], elem)
        c.nullDecl = wasFill
        if not c.isRef(elem) { c.roStore(x, args[1].Span(), RoStored) }   # T25c: every element is writable
        c.exprs.Push(x)
    }
    # no fill: each element its type's zero value (D13c), a struct's made by its constructor
    if args.Len() == 1 {
        # an array of none needs no zero value (D13c, T2c) - known only where its length folds as written: a run-time
        # one is no length to evaluate
        nk := c.P.FoldKnown(c.fr().Ctx, args[0], c.i64())
        none := c.P.T.KindOf(nk) == types.Kind.Const and c.P.T.ConstValue(nk) == 0
        # T2c: the type written for the declaration is not the element's - no note pointing at it
        wasNull := c.nullDecl
        c.nullDecl = diag.Where.Nowhere
        if not none and c.zeroCalls(elem) {
            c.exprs.Push(c.zero(sp, elem))
            c.askValue(ValueKind.Fill, sp, elem, null)
        } else if not none {
            c.zero(sp, elem)   # T2c: a never-null reference element has no zero value to fill with
        }
        c.nullDecl = wasNull
    }
    items := gather(c.exprs, from)
    # its length checked once (D14b)
    lchk := typed.Check.Abort
    nc := c.noClear and args.Len() == 1 and not c.owning(elem) and c.P.T.KindOf(c.P.T.Repr(elem)) != types.Kind.Array
    c.noClear = false
    return typed.Expr.Make(sp, at, typed.Make(typed.MakeKind.Fill, 0, items, n0
                                              c.site(typed.SiteKind.Make, sp), lchk, nc))
}

# the name a span begins with - a written type's first word - else the span
fn (c mut Checker&) leadWord(sp source.Span) source.Span {
    t := c.src(sp)
    k := 0
    for k < t.Len() and (t[k].IsLetter() or t[k].IsDigit() or t[k] == '_') { k++ }
    return source.Span(sp.Start, sp.Start + I32(k)) if k > 0 else sp
}

# Name<args>(...) an instance's constructor
fn (c mut Checker&) genericCall(sp source.Span, gsp source.Span, g ast.Expr&, targs Array<ast.TypeRef&>&, args Array<ast.Expr&>&, want types.TypeId) typed.Expr?&c {
    match g {
        case ast.Expr.Name(nsp, n) {
            ref := c.P.R.Use(c.fr().File, nsp.Start)
            if ref.Kind == names.What.Builtin and c.text(n) == "Array" and targs.Len() == 1 {
                if args.Len() < 1 or args.Len() > 2 {
                    c.err(sp, msgs.ArgCountRange(1, 2, args.Len()))
                    return c.unknown(sp)
                }
                match targs[0] {
                    case ast.TypeRef.Perm(psp, of, w, _) {
                        if w and not c.refWritten(of!) {
                            # T25b: "mut" is a reference's permission
                            c.err(source.Span(psp.Start, psp.Start + 3), msgs.MutOnValueType(c.ty(c.P.Resolve(c.fr().Ctx, of))))
                            c.dropArgs(args)
                            return c.unknown(sp)
                        }
                    }
                    nomatch { }
                }
                el := c.resolve(targs[0])
                if el == types.UnknownT {
                    # what was said of the element type is the one error
                    c.dropArgs(args)
                    return c.unknown(sp)
                }
                # T7d: elements held by value take their length from the fill, where it has one known while compiling
                if c.runArrayValue(el) and args.Len() == 2 {
                    fx := c.expr(args[1], types.UnknownT)
                    ft := typeOf(fx)
                    if c.P.T.KindOf(ft) == types.Kind.Array and c.P.T.Length(ft) != types.TypeId(0) and c.P.T.Same(c.P.T.Elem(ft), c.P.T.Elem(c.under(el))) {
                        return c.arrayMake(sp, ft, args, want, fx)
                    }
                    if ft != types.UnknownT { c.err(c.leadWord(targs[0].Span()), msgs.ArrayNestedByValue(c.ty(el))) }
                    c.exprTo(args[0], c.i64())
                    return c.unknown(sp)
                }
                # T7a: an array's element that is a run-time array is held by reference
                if c.runArrayValue(el) {
                    c.err(c.leadWord(targs[0].Span()), msgs.ArrayNestedByValue(c.ty(el)))
                    c.dropArgs(args)
                    return c.unknown(sp)
                }
                return c.arrayMake(sp, el, args, want)
            }
            if ref.Kind == names.What.Builtin and c.text(n) == "Array" and targs.Len() > 1 {
                # G8, T7: Array's one argument is its element type - Array<T>(n) makes n elements
                c.err(targs[1].Span(), msgs.ArrayTooManyArgs(targs.Len()))
                c.dropArgs(args)
                return c.unknown(sp)
            }
            if ref.Kind == names.What.Type and ref.Index >= 0 {
                # written as a type is
                t := c.resolve(ast.TypeRef.Named(gsp, Array<source.NameId>(1, n), targs))
                if t == types.UnknownT { return c.unknown(sp) }
                return c.construct(sp, nsp, t, args)
            }
            if ref.Kind == names.What.Func {
                # G12: big<I64>(x) - the instance its type arguments name, called
                f := c.P.FnNamed(ref.Module, n)
                ex := c.explicitArgs(f, targs, gsp)
                if ex.Len() == 0 {
                    c.dropArgs(args)
                    return c.unknown(sp)
                }
                return c.invoke(sp, nsp, f, null, args, Array<typed.Expr&>(0), ex)
            }
        }
        case ast.Expr.Member(msp, _, n) if c.genericFn(g) >= 0 {
            f := c.genericFn(g)
            ex := c.explicitArgs(f, targs, gsp)
            if ex.Len() == 0 {
                c.dropArgs(args)
                return c.unknown(sp)
            }
            return c.invoke(sp, memberSpan(msp, c.text(n).Len()), f, null, args, Array<typed.Expr&>(0), ex)
        }
        case ast.Expr.Member(msp, x, n) {
            # alias.Name<args>(...): a type another module declares (M10)
            ref := c.P.R.Member(c.fr().File, msp.End)
            if ref.Kind == names.What.Type and ref.Index >= 0 {
                t := c.P.Apply(c.fr().Ctx, c.P.DeclFor(ref.Module, ref.Index), targs)
                if t == types.UnknownT { return c.unknown(sp) }
                if targs.Len() > 0 and not c.instancesMet(t, targs[0].Span()) { return c.unknown(sp) }
                return c.construct(sp, msp, t, args)
            }
            # x.Narrow<I32>(): a method given its own type arguments (G12)
            if ref.Kind == names.What.None and not c.importPath(x) and c.typeNamed(x) < types.TypeId(0) {
                return c.methodCall(sp, x, n, memberSpan(msp, c.text(n).Len()), args, targs, gsp)
            }
        }
        nomatch { }
    }
    c.gap(gsp, "a generic call of this kind")
    return c.unknown(sp)
}

# T(x) for a number type or Bool: a conversion (T4, E26)
fn (c mut Checker&) conversion(sp source.Span, t types.TypeId, args Array<ast.Expr&>&) typed.Expr&c {
    if t == types.UnknownT {
        c.gap(sp, "a conversion of this kind")
        return c.unknown(sp)
    }
    if args.Len() != 1 {
        c.err(sp, msgs.ArgCount(1, "", args.Len()))
        return c.unknown(sp)
    }
    lv := c.fold(args[0])
    # a literal adapts to the type (T6) where it fits, as a shift of one does (E8b); any other value keeps its own type
    w := types.UnknownT
    if (lv.Ok and c.litFits(lv, t)) or (not lv.Ok and (c.litLike(args[0]) or c.shiftLit(args[0]))) { w = t }
    x := c.value(c.expr(args[0], w), args[0].Span())
    xt := typeOf(x)
    if xt == t or xt == types.UnknownT { return x }
    if not (c.isNumber(xt) and c.isNumber(t)) {
        c.err(args[0].Span(), msgs.TypeMismatch(c.ty(t), c.ty(xt)))
        return c.unknown(sp)
    }
    # D17g: a value that does not fit is an error where the evaluator computes it
    if c.convWords(xt, t).Len() > 0 { c.conversionAt(sp, args[0].Span(), x, t) }
    return c.convert(sp, x, t)
}

# x.Narrow<T>() (E26b): x converted to the number type T, failing with NumberError.OVERFLOW where the value changes (an
# integer out of T's range, a finite float made infinite) and NumberError.INVALID for a NaN or an infinity made an
# integer - a conversion checked, written as a call; fallible by its signature, a widening included
fn (c mut Checker&) narrowCall(sp source.Span, nsp source.Span, rx typed.Expr&c, targs Array<ast.TypeRef&>&, args Array<ast.Expr&>&) typed.Expr&c {
    if targs.Len() != 1 or args.Len() != 0 {
        if targs.Len() != 1 { c.err(nsp, msgs.TypeArgCount("'Narrow'", 1, targs.Len())) } else { c.err(sp, msgs.TakesNoArgs("'Narrow'")) }
        c.dropArgs(args)
        return c.unknown(sp)
    }
    t := c.resolve(targs[0])
    x := c.value(rx, sp)
    xt := typeOf(x)
    if t == types.UnknownT or xt == types.UnknownT { return c.unknown(sp) }
    if not c.isNumber(t) {
        c.err(targs[0].Span(), msgs.NarrowNotNumber(c.ty(t)))
        return c.unknown(sp)
    }
    ws := c.convWords(xt, t)
    if ws.Len() == 0 { ws = types.TypeId[c.preludeWord("std/prelude/number", "NumberError", "OVERFLOW")] }
    k := c.failOp(ws, nsp)
    from := c.exprs.Len()
    c.exprs.Push(x)
    return typed.Expr.Prim(sp, t, typed.PrimOp.Convert, k, gather(c.exprs, from))
}

# T(args) for a declared type: its constructor (C2); a conversion to a type declared over another (T29a)
# a generic type's constructor called with its arguments left out (G10c): where a type of that declaration is expected,
# its arguments; else each variable inferred from the constructor's arguments as a generic call's are (G9), a
# reference bound read-only and an array value as a read-only reference to it
fn (c mut Checker&) inferredCtor(sp source.Span, nsp source.Span, d types.DeclId, args Array<ast.Expr&>&, want types.TypeId) typed.Expr&c {
    w := c.P.T.Plain(c.deref(want)) if want != types.UnknownT else types.UnknownT
    if w != types.UnknownT and c.P.T.KindOf(w) == types.Kind.Named and c.P.T.DeclOf(w) == d and c.P.T.Args(w) != types.ListId(0) {
        return c.construct(sp, nsp, w, args)
    }
    self := c.P.SelfType(d)
    if c.declKind(self) != types.DeclKind.Struct {
        c.gap(nsp, "a generic type's constructor with its arguments inferred (G10c)")
        return c.unknown(sp)
    }
    sig := c.P.CtorSig(self)
    if sig == types.UnknownT { return c.unknown(sp) }
    args = c.ctorNamed(d, args)
    if c.namedBad {
        c.namedBad = false
        c.dropArgs(args)
        return c.unknown(sp)
    }
    ord := c.argOrder.ToArray()
    c.argOrder.Clear()
    owner := generic.DeclOwner(d)
    nv := c.P.T.DeclParams(d)
    ps := c.P.T.Items(c.P.T.Params(sig))
    b := generic.Binding(owner, nv)
    argVals Vec<typed.Expr&>
    for i in range args.Len() {
        e typed.Expr?&c = null
        v := c.fold(args[i])
        if v.Ok or c.litLike(args[i]) {
            fl := v.IsFloat if v.Ok else c.litFloat(args[i])
            if i < ps.Len() { c.unify(ps[i], c.P.T.Prim("F64") if fl else c.i64(), b, true, false) }
        } else {
            match args[i] {
                case ast.Expr.Lambda(_, _), ast.Expr.Default(_) { }
                nomatch { e = c.expr(args[i], types.UnknownT) }
            }
        }
        if e is not null and i < ps.Len() and typeOf(e) != types.UnknownT and typeOf(e) != types.NoreturnT { c.unify(ps[i], c.bindType(e), b, false, false) }
        if e is null { argVals.Push(c.hole) } else { argVals.Push(e) }
    }
    c.P.InferThroughBounds(b)
    for i in range nv {
        v := b.Vals[i]
        # QAH: an error-set parameter nothing fallible bound is the empty set
        if v == types.UnknownT and c.P.ErrVarAt(owner, i) {
            b.Vals[i] = c.P.ErrSetOf(types.ListId(0))
            continue
        }
        if v == types.UnknownT {
            tn := c.text(c.P.T.DeclName(d))
            c.err(nsp, msgs.CtorTypeArgsNotInferable(tn, tn))
            return c.unknown(sp)
        }
        if c.isRef(v) {
            b.Vals[i] = c.P.T.Ref(c.P.T.Referent(v), types.ReadOnly)
        } else if c.P.T.KindOf(c.under(v)) == types.Kind.Array {
            b.Vals[i] = c.P.T.Ref(v, types.ReadOnly)
        }
    }
    t := c.P.Instance(d, c.P.T.List(b.Vals))
    if not c.instancesMet(t, nsp) or not c.P.Body(t) { return c.unknown(sp) }
    isig := c.P.CtorSig(t)
    if isig == types.UnknownT { return c.unknown(sp) }
    id := c.ctorBody(t)
    was := c.ctorCalled
    c.ctorCalled = t
    c.setOrder(ord)
    r := c.callBody(sp, nsp, isig, typed.Callee.Body(typed.BodyId(I32(id))), -1, null, args, argVals.ToArray())
    c.ctorCalled = was
    return r
}

fn (c mut Checker&) construct(sp source.Span, nsp source.Span, t types.TypeId, args Array<ast.Expr&>&) typed.Expr&c {
    if not c.instancesMet(t, nsp) or not c.P.Body(t) {
        c.dropArgs(args)
        return c.unknown(sp)
    }
    k := c.declKind(t)
    if k == types.DeclKind.Foreign {
        # X10: only C makes an extern type's instance
        c.err(nsp, msgs.ForeignBuilt(c.ty(t)))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    if k == types.DeclKind.Struct and c.P.CtorVars(c.P.T.DeclOf(t)) > 0 { return c.twinCall(sp, nsp, t, args) }
    if k == types.DeclKind.Struct {
        sig := c.P.CtorSig(t)
        if sig == types.UnknownT { return c.unknown(sp) }
        args = c.ctorNamed(c.P.T.DeclOf(t), args)
        if c.namedBad {
            c.namedBad = false
            c.dropArgs(args)
            return c.unknown(sp)
        }
        ord := c.argOrder.ToArray()
        c.argOrder.Clear()
        id := c.ctorBody(t)
        was := c.ctorCalled
        c.ctorCalled = t
        c.setOrder(ord)
        r := c.callBody(sp, nsp, sig, typed.Callee.Body(typed.BodyId(I32(id))), -1, null, args, Array<typed.Expr&>(0))
        c.ctorCalled = was
        return r
    }
    if k == types.DeclKind.Over and c.badOver(t) {
        # its declaration said why it is no type to build (T29)
        c.dropArgs(args)
        return c.unknown(sp)
    }
    if k == types.DeclKind.Over {
        sig := c.P.CtorSig(t)
        if sig != types.UnknownT {
            id := c.ctorBody(t)
            # T29d: on a literal the constructor runs while compiling, so a failure is a compile-time error, never one
            # the call can fail with
            lit := args.Len() == 1 and c.litLike(args[0])
            c.decided = lit
            r := c.callBody(sp, nsp, sig, typed.Callee.Body(typed.BodyId(I32(id))), -1, null, args, Array<typed.Expr&>(0))
            if lit { c.askValue(ValueKind.Literal, args[0].Span(), t, args[0]) }
            return r
        }
        if args.Len() != 1 {
            c.err(sp, msgs.ArgCount(1, "", args.Len()))
            return c.unknown(sp)
        }
        base := c.P.T.Base(t)
        # a literal adapts to the type (T6, T29a); any other value keeps its own, converted by representation
        x := c.value(c.expr(args[0], t if c.litLike(args[0]) else types.UnknownT), args[0].Span())
        xt := typeOf(x)
        if xt == t or xt == types.UnknownT { return x }
        if c.isNumber(xt) and c.isNumber(t) { return c.convert(sp, x, t) }
        if c.flowsInto(c.deref(xt), base) or c.sameRepr(c.deref(xt), base) {
            if c.isRef(xt) { return c.convert(sp, x, c.P.T.Ref(t, c.P.T.PermOf(xt))) }
            # T29a: an array named by a place converted names its storage - a place of the declared type, whose read is
            # a copy where one is made and whose borrow is that storage, written where it may be
            xp := readPlace(x)
            if xp is not null and c.P.T.KindOf(c.under(xt)) == types.Kind.Array and c.P.T.KindOf(c.under(base)) == types.Kind.Array {
                perm := types.Writable if c.placeWritable(xp) else types.ReadOnly
                r := c.convert(sp, typed.Expr.Borrow(sp, c.P.T.Ref(xt, perm), xp), c.P.T.Ref(t, perm))
                # fixed storage (T7d) is named as one of a run-time length, as a slice of it is (E16a): its read a copy
                return c.read(sp, typed.Lvalue.Deref(sp, t, r))
            }
            if not c.flowsInto(xt, base) { return c.convert(sp, x, t) }
            return c.convert(sp, c.fit(x, base, args[0].Span()), t)
        }
        c.err(args[0].Span(), msgs.TypeMismatch(c.ty(base), c.ty(xt)))
        return c.unknown(sp)
    }
    if k == types.DeclKind.Enum {
        # an enum is no function: its values are its cases
        c.err(nsp, msgs.TypeHasNoConstructor(msgs.Tok(c.src(nsp))))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    c.gap(nsp, "a type of this kind called")
    return c.unknown(sp)
}

# whether t is a type declared over a struct, an enum, a trait or a generic type's instance - T29's error, said at its
# declaration, its uses then said nothing more
fn (c mut Checker&) badOver(t types.TypeId) Bool {
    if not c.isNamed(t) or c.declKind(t) != types.DeclKind.Over { return false }
    b := c.P.T.Base(t)
    return c.isNamed(b) and (c.declKind(b) != types.DeclKind.Over or c.P.T.Args(b) != types.ListId(0))
}

# a call of a function or method f by name (recv its receiver, checked; pre its arguments checked, where args are not):
# its instance, inferred from the arguments where it is generic (G9)
fn (c mut Checker&) invoke(sp source.Span, nsp source.Span, f I64, recv typed.Expr?&c, args Array<ast.Expr&>&, pre Array<typed.Expr&>&c
                          explicit Array<types.TypeId>& = Array<types.TypeId>(0)) typed.Expr&c {
    if f < 0 {
        c.gap(nsp, "a function the checker cannot find")
        return c.unknown(sp)
    }
    # E14b: arguments by name put where their parameters are
    ord := Array<I64>(0)
    if hasNamed(args) {
        args = c.namedArgs(c.P.FnDecl(f).S.Params, args, c.text(c.P.FnDecl(f).Name))
        if c.namedBad {
            c.namedBad = false
            c.dropArgs(args)
            return c.unknown(sp)
        }
        ord = c.argOrder.ToArray()
        c.argOrder.Clear()
    }
    sig := c.P.Sig(f)
    if c.P.FnIsExtern(f) {
        c.setOrder(ord)
        return c.callBody(sp, nsp, sig, typed.Callee.Extern(f), f, recv, args, pre)
    }
    owner := generic.FnOwner(f)
    nv := c.P.VarCount(owner)
    if nv == 0 {
        inst := c.P.FnInstance(f, types.ListId(0))
        id := c.fnBody(inst)
        c.setOrder(ord)
        return c.callBody(sp, nsp, c.P.InstanceSig(inst), typed.Callee.Body(typed.BodyId(I32(id))), f, recv, args, pre)
    }
    # G9: each argument's type unified with its parameter's, its value checked first
    ps := c.P.T.Items(c.P.T.Params(sig))
    b := generic.Binding(owner, nv)
    # G12: the variables written type arguments name are theirs, whatever the arguments are
    if explicit.Len() > 0 {
        for i in range explicit.Len() {
            if explicit[i] != types.UnknownT { b.Vals[i] = explicit[i] }
        }
    }
    k I64 = 0
    if recv is not null {
        if ps.Len() > 0 { c.unify(ps[0], typeOf(recv), b, false, true) }
        k = 1
    }
    vals Vec<typed.Expr?&>
    lambdas Vec<I64>
    k0w := k
    if pre.Len() == 0 and args.Len() == 1 and ps.Len() - k > 1 and callLike(args[0]) { pre = c.spread(args[0]) }
    # pre gives the first arguments, args the rest (a checked index given, the value as written)
    n := pre.Len() if pre.Len() > 0 else 0
    if args.Len() > 0 and args.Len() > n { n = args.Len() }
    for i in range n {
        e typed.Expr?&c = null
        if pre.Len() > 0 and i < pre.Len() {
            e = pre[i]
        } else {
            v := c.fold(args[i])
            if v.Ok or c.litLike(args[i]) {
                fl := v.IsFloat if v.Ok else c.litFloat(args[i])
                if k < ps.Len() { c.unify(ps[k], c.P.T.Prim("F64") if fl else c.P.T.Prim("U64") if v.Ok and c.litU64(args[i]) else c.i64(), b, true, false) }
            } else {
                match args[i] {
                    case ast.Expr.Lambda(_, _) { lambdas.Push(i) }
                    case ast.Expr.Default(_) { }
                    nomatch { e = c.expr(args[i], c.boundParam(ps, k, b) if recv is not null else types.UnknownT) }
                }
            }
        }
        if e is not null and k < ps.Len() and typeOf(e) != types.UnknownT and typeOf(e) != types.NoreturnT {
            c.unify(ps[k], c.bindType(e), b, false, false)
        }
        vals.Push(e)
        k++
    }
    if explicit.Len() > 0 {
        for i in range explicit.Len() {
            if explicit[i] == types.UnknownT { continue }
            b.Vals[i] = explicit[i]
            b.LiteralOnly[i] = false
        }
    }
    if pre.Len() == 0 { c.literalBinding(owner, b, ps, k0w, args) }
    c.P.InferThroughBounds(b)
    # G9a: a lambda's written types bind what only literals reached, or nothing did - never what an argument, the
    # receiver or a constraint bound, which its parameter may be looser than (T22)
    if pre.Len() == 0 and lambdas.Len() > 0 {
        for i in lambdas {
            lf := lambdaOf(args[i])
            pk := i + k0w
            if pk >= ps.Len() or c.P.T.KindOf(ps[pk]) != types.Kind.Func { continue }
            lps := c.P.T.Items(c.P.T.Params(ps[pk]))
            for j in range lf!.S.Params.Len() {
                if j < lps.Len() and lf!.S.Params[j].Ty is not null { c.unifySoft(lps[j], c.resolve(lf!.S.Params[j].Ty), b) }
            }
            if lf!.S.Results.Len() > 0 and lf!.S.Results.Len() == 1 {
                lr := c.resolve(lf!.S.Results[0])
                pr := c.P.T.Result(ps[pk])
                # T7a: a run-time array bound to a variable the call holds in an array is held by reference
                if c.P.T.KindOf(pr) == types.Kind.Var and c.P.T.A(pr) == owner and c.runArrayValue(c.under(lr)) and not c.isRef(lr) and c.holdsVarInArray(sig, owner, c.P.T.B(pr)) {
                    c.err(lf!.S.Results[0].Span(), msgs.LambdaResultHeld(c.text(c.P.VarAt(owner, c.P.T.B(pr)).Name), c.ty(lr), c.ty(lr)))
                    return c.unknown(sp)
                }
                c.unifySoft(pr, lr, b)
            }
        }
        c.P.InferThroughBounds(b)
    }
    # D16a: a lambda checked against its parameter as far as the other arguments bound it; a variable reached only
    # through its result is then inferred from it. An error-set variable is left open for it (QAH): the lambda's body
    # says what it fails with, which the variable takes on beside what else binds it
    for i in lambdas {
        part := Array<types.TypeId>(nv)
        for j in range nv {
            part[j] = b.Vals[j] if b.Vals[j] != types.UnknownT and not c.P.ErrVarAt(owner, j) else c.P.T.Var(owner, j, types.ReadOnly)
        }
        pk := i + k0w
        if pk >= ps.Len() { continue }
        e := c.lambda(args[i].Span(), lambdaOf(args[i])!, c.P.Subst(ps[pk], owner, c.P.T.List(part)))
        if typeOf(e) != types.UnknownT {
            c.unifySoft(ps[pk], typeOf(e), b)
            if c.P.T.KindOf(ps[pk]) == types.Kind.Func and c.P.T.KindOf(typeOf(e)) == types.Kind.Func {
                c.P.UnifyErrors(c.P.T.Errors(ps[pk]), c.P.T.Errors(typeOf(e)), b)
            }
        }
        vals[i] = e
        c.P.InferThroughBounds(b)
    }
    # QAH: an error-set variable nothing fallible bound is the empty set - its instance cannot fail by it
    for i in range nv {
        if b.Vals[i] == types.UnknownT and c.P.ErrVarAt(owner, i) { b.Vals[i] = c.P.ErrSetOf(types.ListId(0)) }
    }
    for i in range nv {
        if b.Vals[i] == types.UnknownT {
            # D9a: a length an array taken by value gives (G29), reached by an array whose length is known only at run
            # time
            for kk in range vals.Len() {
                pk := kk + k0w
                if vals[kk] is null or pk >= ps.Len() { continue }
                pa := c.arrayOf(c.deref(ps[pk]))
                if pa == types.UnknownT { continue }
                pl := c.P.T.Length(pa)
                at := c.deref(typeOf(vals[kk]))
                aa := c.arrayOf(at)
                if pl != types.TypeId(0) and c.P.T.KindOf(pl) == types.Kind.Var and c.P.T.A(pl) == owner and c.P.T.B(pl) == i and aa != types.UnknownT and c.P.T.Length(aa) == types.TypeId(0) {
                    pn := c.text(c.P.VarAt(owner, i).Name)
                    lk := try pn.Find(".Len()") catch default -1
                    lk = try pn.Find("[0]") catch default lk
                    if lk >= 0 {
                        c.err(args[kk].Span() if pre.Len() == 0 else nsp, msgs.ArrayByValueRunTime(msgs.Tok(pn[0:lk]), c.ty(at)))
                        return c.unknown(sp)
                    }
                }
            }
            # G4: one no parameter names is written at the call, or nothing gives it
            seen := Array<Bool>(nv, false)
            for q in ps { c.varsIn(q, owner, seen, 0) }
            fname := c.text(c.P.FnDecl(f).Name)
            if not seen[i] {
                c.err(nsp, msgs.TypeVarNotInferable(c.text(c.P.VarAt(owner, i).Name), fname))
            } else {
                c.err(nsp, msgs.TypeArgsNotInferable(fname))
            }
            return c.unknown(sp)
        }
    }
    # G19: each binding against its constraint, and every type instance the instance's signature holds against its own,
    # where the call binds them - the instance's body is not checked where one is not met
    if not c.bound(owner, c.P.T.List(b.Vals), nsp) { return c.unknown(sp) }
    # G17: a chain of instances one function asks of itself (a length counting down, G29) is bounded
    made := try c.instsOf.Get(f) catch default 0
    if made > 1000 {
        c.P.L.Diags.ErrorOncePerLine(c.at(nsp), msgs.UnboundedInstantiation())
        return c.unknown(sp)
    }
    if c.P.FnTooDeep(f, c.P.T.List(b.Vals), c.fnNameAt(f)) { return c.unknown(sp) }   # G17
    asking := c.P.Asking
    c.P.Asking = generic.Origin(c.fr().File, nsp, c.curInst())   # G16b: where the instance is asked for
    inst := c.P.FnInstance(f, c.P.T.List(b.Vals))
    c.P.Asking = asking
    if not c.instancesMet(c.P.InstanceSig(inst), nsp) { return c.unknown(sp) }
    if not c.fnBodies.Has(inst) { c.instsOf.Put(f, made + 1) }
    id := c.fnBody(inst)
    # QAH: a lambda whose set bound an error-set variable fails, as a value, with the set its parameter is given
    ips := c.P.T.Items(c.P.T.Params(c.P.InstanceSig(inst)))
    for i in lambdas {
        pk := i + k0w
        if pk < ips.Len() and pk < ps.Len() and c.P.T.KindOf(ps[pk]) == types.Kind.Func and c.listMentions(c.P.T.Errors(ps[pk]), owner) {
            vals[i] = c.lambdaErrs(vals[i], c.P.T.Errors(ips[pk]))
        }
    }
    # the arguments typed for inference, a hole where an argument is checked against its bound parameter instead
    pv := Array<typed.Expr&>(vals.Len(), c.hole)
    for i in range vals.Len() {
        v := vals[i]
        if v is not null { pv[i] = v }
    }
    c.setOrder(ord)
    x := c.callBody(sp, nsp, c.P.InstanceSig(inst), typed.Callee.Body(typed.BodyId(I32(id))), f, recv, args, pv)
    # T29f: an inherited array method whose result is its receiver's own type gives the declared type
    if recv is not null {
        rt := c.P.T.Plain(c.deref(typeOf(recv)))
        if c.P.Extends(rt) and c.arrayOf(rt) != types.UnknownT and c.P.T.Same(typeOf(x), c.P.T.Base(rt)) {
            return c.convert(sp, x, rt)
        }
    }
    return x
}

# parameter k as far as a binding has bound it, where that leaves no variable open - what a receiver's type arguments
# make of a method's parameter (G10c: a generic constructor argued there takes its type arguments; a literal adapts)
fn (c mut Checker&) boundParam(ps Array<types.TypeId>&, k I64, b generic.Binding&) types.TypeId {
    if k >= ps.Len() { return types.UnknownT }
    part := Array<types.TypeId>(b.N)
    for j in range b.N { part[j] = b.Vals[j] if b.Vals[j] != types.UnknownT else c.P.T.Var(b.Owner, j, types.ReadOnly) }
    t := c.P.Subst(ps[k], b.Owner, c.P.T.List(part))
    if not c.P.T.Closed(t) { return types.UnknownT }
    # C11: a type declaring a destructor is never a value - a conditional of its instances is a reference to one (E28)
    if c.isRef(t) {
        r := c.P.T.Referent(t)
        if c.isNamed(r) and c.P.Body(r) and c.P.T.Destructs(r) { return t }
        # T32a: an "any" is wanted as itself - each value of a conditional made one
        if c.P.T.IsAny(t) { return t }
    }
    return c.deref(t)
}

# G9a: a variable only literals reach, whose constraint (G19) the widest of their types fails, takes the first type
# of literalOrder that meets it and that every one of those literals adapts to (T6) - root(4), with "fn root<T Float>(x T) T", is root at F64.
# None doing both, the binding stays and the constraint's error is said at the call
fn (c mut Checker&) literalBinding(owner I64, b mut generic.Binding&, ps Array<types.TypeId>&, k0 I64, args Array<ast.Expr&>&) {
    for i in range b.N {
        if not b.LiteralOnly[i] or b.Vals[i] == types.UnknownT { continue }
        if c.P.MeetsBound(owner, i, c.P.T.List(b.Vals), b.Vals[i]) { continue }
        for name in literalOrder {
            t := c.P.T.Prim(name)
            fits := true
            for j in range args.Len() {
                pk := j + k0
                if pk >= ps.Len() or not c.litLike(args[j]) { continue }
                pt := ps[pk]
                if c.P.T.KindOf(pt) != types.Kind.Var or c.P.T.A(pt) != owner or c.P.T.B(pt) != i { continue }
                if not c.litLikeFits(args[j], t) { fits = false }
            }
            if fits and c.P.MeetsBound(owner, i, c.P.T.List(b.Vals), t) {
                b.Vals[i] = t
                break
            }
        }
    }
}

# the types a literal-only variable may take where its own fails a constraint, widest first, a float before an
# integer of its width (G9a)
literalOrder := String&["F64", "I64", "U64", "F32", "I32", "U32", "F16", "BF16", "I16", "U16", "I8", "U8"]

# a pattern unified with a type into what b leaves unbound, or bound by literals only: never moving what an argument
# bound (a lambda's type may be looser than its parameter, T22)
fn (c mut Checker&) unifySoft(pat types.TypeId, actual types.TypeId, b mut generic.Binding&) {
    b2 := generic.Binding(b.Owner, b.N)
    c.P.UnifyArg(pat, actual, b2, false, false)
    for j in range b.N {
        if b2.Vals[j] != types.UnknownT and (b.Vals[j] == types.UnknownT or b.LiteralOnly[j]) {
            b.Vals[j] = b2.Vals[j]
            b.LiteralOnly[j] = false
        }
    }
}

# what an argument binds a type variable to (G9a): written text a String value, else its type
fn (c mut Checker&) bindType(e typed.Expr&) types.TypeId {
    match e {
        case typed.Expr.Data(_, ty, _, _) {
            if c.isRef(ty) and c.P.T.Referent(ty) == c.textType() { return c.textType() }
        }
        nomatch { }
    }
    return typeOf(e)
}

fn lambdaOf(x ast.Expr&) ast.Func?&x {
    return match x {
        case ast.Expr.Lambda(_, f) => f
        case _ => null
    }
}

# G9: an argument's type unified with its parameter's, a reference taken for its referent where only one is one (E12c)
fn (c mut Checker&) unify(pat types.TypeId, actual types.TypeId, b mut generic.Binding&, literal Bool, receiver Bool) {
    p := pat
    a := actual
    if c.isRef(p) and not c.isRef(a) { p = c.P.T.Referent(p) }
    # a reference reaching a bare variable binds the reference (G11); one reaching a value pattern its referent (E12)
    if c.isRef(a) and not c.isRef(p) and c.P.T.KindOf(p) != types.Kind.Var { a = c.P.T.Referent(a) }
    c.P.UnifyArg(p, a, b, literal, receiver)
}

# T2c: where the k-th parameter of a call's target is written (the receiver 0 when there is one), for declNote; Nowhere
# where it is not known
fn (c mut Checker&) paramAt(target typed.Callee&, f I64, k I64) diag.Where {
    if f >= 0 {
        fd := c.P.FnDecl(f)
        mi := c.P.FnModule(f)
        j := k
        if fd.Recv is not null {
            if k == 0 { return c.markAt(mi, fd.Recv!.Ty) }
            j = k - 1
        }
        if j >= 0 and fd.S.Params.Len() > 0 and j < fd.S.Params.Len() { return c.markAt(mi, fd.S.Params[j].Ty) }
        return diag.Where.Nowhere
    }
    match target {
        case typed.Callee.Body(id) {
            if I64(id) >= c.Bodies.Len() { return diag.Where.Nowhere }
            match c.Bodies[I64(id)].Of {
                case typed.BodyOf.Ctor(t, _) {
                    d := c.P.T.DeclOf(c.deref(t))
                    td := c.P.TypeDecl(d)
                    if td is null or td.Body is null { return diag.Where.Nowhere }
                    match td.Body {
                        case ast.TypeBody.Struct(st) {
                            if st.Params.Len() > 0 and k < st.Params.Len() { return c.markAt(c.P.DeclModule(d), st.Params[k].Ty) }
                        }
                        nomatch { }
                    }
                }
                case typed.BodyOf.Case(t, tag) {
                    d := c.P.T.DeclOf(c.deref(t))
                    cd := caseDecl(c.P.TypeDecl(d), tag)
                    if cd is not null and cd.Payload.Len() > 0 and k < cd.Payload.Len() {
                        return c.markAt(c.P.DeclModule(d), cd.Payload[k].Ty)
                    }
                }
                nomatch { }
            }
        }
        nomatch { }
    }
    return diag.Where.Nowhere
}

# where a type written in a file is - Nowhere for none written
# T2c: the "&" of a type written in module mi that a "?" would make nullable - its last one, where the type is a
# reference; else the type's whole span, Nowhere for none written
fn (c mut Checker&) markAt(mi I64, tr ast.TypeRef?&) diag.Where {
    if tr is null or mi < 0 { return diag.Where.Nowhere }
    sp := tr.Span()
    text := c.P.L.Mods[mi].Src!.Text[I64(sp.Start):I64(sp.End)]
    for i in range text.Len() {
        k := text.Len() - 1 - i
        if text[k] == '&' { return diag.Where.Span(c.P.L.Mods[mi].File, I64(sp.Start) + k, I64(sp.Start) + k + 1) }
    }
    return diag.Where.Span(c.P.L.Mods[mi].File, I64(sp.Start), I64(sp.End))
}

# a call of a body of type sig: its arguments checked against its parameters in order, the receiver first, defaults
# filled in (D8a, E14). f is the function whose defaults fill the rest, -1 for a constructor
fn (c mut Checker&) callBody(sp source.Span, nsp source.Span, sig types.TypeId, target typed.Callee&c, f I64, recv typed.Expr?&c, args Array<ast.Expr&>&, pre Array<typed.Expr&>&c) typed.Expr&c {
    op := c.opCall
    c.opCall = ""
    opIn := c.opIn
    c.opIn = source.Span(-1, -1)
    decided := c.decided
    c.decided = false
    order := c.argOrder.ToArray()
    c.argOrder.Clear()
    if sig == types.UnknownT { return c.unknown(sp) }
    # E14b: arguments by name reach here only where nothing named the parameters - a call through a function value, a
    # case, a dispatch the names were not put in place for
    through := false
    match target {
        case typed.Callee.Value(_) { through = true }
        nomatch { }
    }
    if c.namedNotHere(args, through) {
        c.dropArgs(args)
        return c.unknown(sp)
    }
    ps := c.P.T.Items(c.P.T.Params(sig))
    sfrom := c.stmts.Len()
    spreadAt := source.Span(-1, -1)
    if pre.Len() == 0 and args.Len() > 0 and args.Len() == 1 and ps.Len() - (1 if recv is not null else 0) > 1 and callLike(args[0]) {
        pre = c.spread(args[0])
        spreadAt = c.calleeSpan(args[0])
    }
    from := c.exprs.Len()
    k I64 = 0
    if recv is not null {
        rx := c.fit(recv, ps[0] if ps.Len() > 0 else types.UnknownT, recv.Span())
        c.roArgFor(c.bodyOfCallee(target), 0, rx, recv.Span(), c.calleeName(f))
        c.exprs.Push(rx)
        k = 1
    }
    n := pre.Len() if pre.Len() > 0 else 0
    if args.Len() > 0 and args.Len() > n { n = args.Len() }     # pre gives the first arguments, args the rest
    wanted := ps.Len() - k
    if spreadAt.Start >= 0 and n > 1 and n != wanted {
        # D8d: several results passed as the arguments are as many as the parameters
        c.err(spreadAt, msgs.SpreadCount())
        c.exprs.Truncate(from)
        return c.unknown(sp)
    }
    variadic := f >= 0 and c.P.FnIsExtern(f) and c.P.FnDecl(f).S.Variadic
    if n > wanted and not (variadic and pre.Len() == 0) {
        c.err(sp, msgs.ArgCount(wanted, "" if wanted == 1 else "s", n))
        c.exprs.Truncate(from)
        return c.unknown(sp)
    }
    for i in range n {
        if k >= ps.Len() {
            # X21: a variable argument, as C's default promotions make it
            c.exprs.Push(c.varArg(args[i]))
            k++
            continue
        }
        e typed.Expr?&c = null
        asp := sp
        if args.Len() > 0 and i < args.Len() { asp = args[i].Span() }
        if spreadAt.Start >= 0 { asp = spreadAt }
        if pre.Len() > 0 and i < pre.Len() and pre[i] != c.hole {
            wasPre := c.nullDecl
            c.nullDecl = c.paramAt(target, f, k)    # T2c: where the parameter's type is written
            e = c.fit(pre[i], ps[k], asp)
            c.nullDecl = wasPre
        } else if args.Len() > 0 and i < args.Len() {
            isDefault := false
            match args[i] {
                case ast.Expr.Default(_) { isDefault = true }
                nomatch { }
            }
            if isDefault {
                e = c.callDefault(nsp, sp, target, f, k, recv is not null, ps[k])
            } else {
                e = c.litCtor(args[i], ps[k])
                if e is null { e = c.expr(args[i], ps[k]) }
                if c.P.T.KindOf(typeOf(e)) == types.Kind.Tuple and c.P.T.KindOf(ps[k]) != types.Kind.Tuple {
                    # D8c: several results are one value nowhere but as all of a call's arguments (D8d)
                    c.err(c.calleeSpan(args[i]), msgs.TupleNotAValue())
                    e = c.unknown(asp)
                } else {
                    if c.writable(ps[k]) and c.condChoosesPlace(e!) { c.err(c.chosenAt(e!), msgs.CondLentWritable()) }
                    ex := c.cPointerArg(target, e!, ps[k], c.argSpan(args[i]))
                    if ex is null { ex = c.externArray(target, e!, ps[k], c.argSpan(args[i])) }
                    wasNull := c.nullDecl
                    c.nullDecl = c.paramAt(target, f, k)
                    e = ex if ex is not null else c.fit(e!, ps[k], c.argSpan(args[i]))
                    c.nullDecl = wasNull
                    if c.cCallback(target, f) and c.P.T.KindOf(ps[k]) == types.Kind.Func { c.callbackArg(e!, c.argSpan(args[i])) }
                }
            }
        } else {
            e = c.unknown(asp)
        }
        c.roArgFor(c.bodyOfCallee(target), k, e, asp, c.calleeName(f))
        c.exprs.Push(e!)
        k++
    }
    for k < ps.Len() {
        c.exprs.Push(c.callDefault(nsp, sp, target, f, k, recv is not null, ps[k]))
        k++
    }
    c.inWrittenOrder(order, from + (1 if recv is not null else 0))
    errs := types.ListId(0) if decided else c.calleeErrors(target, sig)
    if c.P.T.Items(errs).Len() > 0 and c.fr().Tries == 0 {
        if opIn.Start >= 0 {
            c.err(opIn, msgs.MembershipNeedsTry(op))
        } else if op.Len() > 0 {
            c.err(nsp, msgs.OperatorCallFails(op))
        } else {
            c.err(nsp, msgs.UnhandledFallibleCall())
        }
    }
    if c.P.T.Items(errs).Len() > 0 { c.fr().Fallible++ }
    c.leak(errs)
    c.lastErrs = errs
    r := c.P.T.Result(sig)
    # a built result is new storage only the caller holds: writable (T25c)
    if c.isRef(r) and c.P.T.ResultFrom(sig, 0) == types.OwnScope {
        r = c.P.T.Ref(c.P.T.Referent(r), c.P.T.PermOf(r) | types.Writable)
    } else if c.P.T.KindOf(r) == types.Kind.Tuple {
        ps0 := c.P.T.Items(c.P.T.Parts(r))
        nps := Vec<types.TypeId>()
        changed := false
        for i in range ps0.Len() {
            q := ps0[i]
            if c.isRef(q) and c.P.T.ResultFrom(sig, i) == types.OwnScope and (c.P.T.PermOf(q) & types.Writable) == 0 {
                q = c.P.T.Ref(c.P.T.Referent(q), c.P.T.PermOf(q) | types.Writable)
                changed = true
            }
            nps.Push(q)
        }
        if changed { r = c.P.T.Tuple(c.P.T.List(nps.ToArray())) }
    }
    c.roCheckCallee(target, r)
    targs := gather(c.exprs, from)
    site := c.site(typed.SiteKind.Call, sp)
    call := typed.Expr.Call(sp, r, typed.Call(target, targs, typed.Mark.None, site))
    # D17e: its callee's contract, decided by the evaluator where it can be, or checked under checked
    cb := c.bodyOfCallee(target)
    if cb < 0 { cb = c.slotContract(target) }
    if cb >= 0 and c.fr().Contract == 0 and c.hasContract(cb) { call = c.contractAt(sp, nsp, r, call, target, targs, site, cb) }
    if c.stmts.Len() > sfrom { return typed.Expr.Seq(sp, r, typed.Seq(gather(c.stmts, sfrom), call)) }
    return call
}

# X21: a variable argument of a variadic extern - a literal at C's type for it (an integer an I32 where it fits, else an
# I64 or a U64; a float an F64), any other value at its own type promoted as C promotes it: an integer narrower than
# I32 an I32 (I5, U20 among them, T4a), one between 32 and 64 bits an I64 or a U64, a float narrower than F64 an F64; a
# reference or an array crosses as its address, as for a parameter (X3)
fn (c mut Checker&) varArg(x ast.Expr&) typed.Expr&c {
    v := c.fold(x)
    if v.Ok {
        want := c.P.T.Prim("F64") if v.IsFloat else c.P.T.Prim("U64") if v.Big else c.P.T.Prim("I32") if v.I >= -2147483648 and v.I <= 2147483647 else c.i64()
        return c.expr(x, want)
    }
    e := c.expr(x, types.UnknownT)
    t := typeOf(e)
    if t == types.UnknownT { return e }
    r := c.P.T.Repr(t)
    k := c.P.T.KindOf(r)
    if c.P.T.IsInt(r) {
        w := c.P.T.Bits(r)
        if w < 32 { return c.convert(x.Span(), e, c.P.T.Prim("I32")) }
        # T4a: a width C has no type for, between 32 and 64 bits, as the next of C's that holds it; wider, none does
        if k == types.Kind.Int and w > 64 {
            c.err(c.argSpan(x), msgs.VarArgWide(c.ty(t)))
            return c.unknown(x.Span())
        }
        if k == types.Kind.Int and w != 32 and w != 64 {
            return c.convert(x.Span(), e, c.P.T.Prim("U64") if c.P.T.IsUnsigned(r) else c.i64())
        }
        return c.convert(x.Span(), e, r) if r != t else e
    }
    if c.P.T.IsFloat(r) {
        if k != types.Kind.F64 { return c.convert(x.Span(), e, c.P.T.Prim("F64")) }
        return c.convert(x.Span(), e, r) if r != t else e
    }
    x2 := c.P.T.Referent(r) if c.isRef(r) else r
    if c.isRef(r) or c.P.T.KindOf(c.P.T.Repr(x2)) == types.Kind.Array { return e }
    c.err(c.argSpan(x), msgs.VarArgType(c.ty(t)))
    return c.unknown(x.Span())
}

# where an argument that does not fit is said (stage 0's token for it): an "as" at its keyword, a conversion to a
# declared type over another at what it converts (T29a), else the argument
# where an operand is said (stage 0's token for it): a member at its name, else as an argument is
fn (c mut Checker&) operandAt(x ast.Expr&) source.Span {
    match x {
        case ast.Expr.Member(msp, _, n) { return memberSpan(msp, c.text(n).Len()) }
        case ast.Expr.Index(_, y, _) { return c.bracketOf(y) }
        nomatch { return c.argSpan(x) }
    }
}

fn (c mut Checker&) argSpan(x ast.Expr&) source.Span {
    match x {
        case ast.Expr.As(_, y, t) { return c.between(y.Span(), t.Span(), 2) }
        case ast.Expr.Paren(_, y) { return c.argSpan(y) }
        case ast.Expr.Binary(_, _, _, _) { return c.opOf(x) }
        case ast.Expr.Call(_, f, args) {
            match f {
                case ast.Expr.Member(msp, _, n) { return memberSpan(msp, c.text(n).Len()) }
                nomatch { }
            }
            if args.Len() == 1 {
                t := c.typeNamed(f)
                if t >= types.TypeId(0) and c.isNamed(t) and c.declKind(t) == types.DeclKind.Over { return c.argSpan(args[0]) }
            }
        }
        nomatch { }
    }
    return x.Span()
}

# the body a call reaches, -1 for none checked here
fn (c mut Checker&) bodyOfCallee(t typed.Callee&) I64 {
    return match t {
        case typed.Callee.Body(b) => I64(b)
        case _ => -1
    }
}

# a callee's name in a diagnostic: its function's, a constructor's type's
fn (c mut Checker&) calleeName(f I64) String {
    if f >= 0 { return c.text(c.P.FnDecl(f).Name) }
    if c.ctorCalled != types.UnknownT and c.isNamed(c.ctorCalled) { return c.text(c.P.T.DeclName(c.P.T.DeclOf(c.ctorCalled))) }
    return "this constructor"
}

# whether an argument list names a parameter (E14b)
fn hasNamed(args Array<ast.Expr&>&) Bool {
    for a in args {
        match a {
            case ast.Expr.Named(_, _, _) { return true }
            nomatch { }
        }
    }
    return false
}

# E14b: arguments naming defaulted parameters put where their parameters are - 'default' (E14a) for a defaulted
# parameter none gives - with each one's written position kept in argOrder for callBody, which evaluates them in the
# order written. params are the callee's, its receiver not among them; what names the callee in a message. A mistake
# is said and namedBad set, the arguments then as written
fn (c mut Checker&) namedArgs(params Array<ast.Param&>&, args Array<ast.Expr&>&, what String&) Array<ast.Expr&>&args {
    if not hasNamed(args) { return args }
    np := params.Len()
    pos := 0
    seen := false
    bad := false
    slots := Array<ast.Expr?&>(np)
    order := Array<I64>(np, -1)
    byName := Array<Bool>(np, false)
    for i in range args.Len() {
        a := args[i]
        match a {
            case ast.Expr.Named(nsp, n, x) {
                seen = true
                j := -1
                for k in range np {
                    if params[k].Name == n { j = k }
                }
                lsp := source.Span(nsp.Start, nsp.Start + I32(c.text(n).Len()))
                if j < 0 {
                    near mut msgs.Nearest& = msgs.Nearest(c.text(n))
                    for q in params {
                        if q.Dflt is not null { near.Offer(c.text(q.Name)) }
                    }
                    if near.Best.Len() > 0 {
                        c.err(lsp, msgs.NamedArgUnknownMeant(c.tok(n), msgs.Tok(what), near.Best))
                    } else {
                        c.err(lsp, msgs.NamedArgUnknown(c.tok(n), msgs.Tok(what)))
                    }
                    bad = true
                } else if params[j].Dflt is null {
                    c.err(lsp, msgs.NamedArgRequired(c.tok(n)))
                    bad = true
                } else if slots[j] is not null {
                    c.err(lsp, msgs.NamedArgTwice(c.tok(n)) if byName[j] else msgs.NamedArgAlsoPositional(c.tok(n)))
                    bad = true
                } else {
                    slots[j] = x
                    order[j] = i
                    byName[j] = true
                }
            }
            nomatch {
                if seen {
                    c.err(a.Span(), msgs.PositionalAfterNamed())
                    bad = true
                } else if pos < np {
                    slots[pos] = a
                    order[pos] = i
                }
                pos++
            }
        }
    }
    if pos > np {
        # more arguments by position than parameters: the count's own error says so
        c.err(args[np].Span(), msgs.ArgCount(np, "" if np == 1 else "s", pos))
        bad = true
    }
    if bad {
        c.namedBad = true
        return args
    }
    # the last argument given ends the list - the defaulted parameters after it are filled as for any shorter call
    last := -1
    for k in range np {
        if slots[k] is not null { last = k }
    }
    out := Vec<ast.Expr&>()
    c.argOrder.Clear()
    for k in range last + 1 {
        s := slots[k]
        if s is null {
            out.Push(ast.Expr.Default(args[0].Span()))
        } else {
            out.Push(s)
        }
        c.argOrder.Push(order[k])
    }
    return out.ToArray()
}

# E14b: arguments given by name out of their parameters' order evaluated in the order written - each one written, but
# a literal, held in a local in that order before the call, which then reads it. order is each parameter's argument's
# written position (-1 for none), at from in exprs on; nothing to do where they are in order already
fn (c mut Checker&) inWrittenOrder(order Array<I64>&, from I64) {
    last := -1
    sorted := true
    for w in order {
        if w < 0 { continue }
        if w < last { sorted = false }
        last = w
    }
    if sorted { return }
    for w in range last + 1 {
        for j in range order.Len() {
            if order[j] != w or from + j >= c.exprs.Len() { continue }
            x := c.exprs[from + j]
            match x {
                case typed.Expr.Lit(_, _, _) { continue }
                nomatch { }
            }
            sp := x.Span()
            h := c.hidden(sp, typeOf(x))
            c.stmts.Push(typed.Stmt.Let(sp, typed.LocalId(I32(h)), x))
            c.exprs[from + j] = c.readLocal(sp, h)
        }
    }
}

# E14b: a struct's constructor call with its arguments by name put in place (namedArgs)
fn (c mut Checker&) ctorNamed(d types.DeclId, args Array<ast.Expr&>&) Array<ast.Expr&>&args {
    if not hasNamed(args) { return args }
    td := c.P.TypeDecl(d)
    if td is not null and td.Body is not null {
        match td.Body {
            case ast.TypeBody.Struct(st) { return c.namedArgs(st.Params, args, c.text(c.P.T.DeclName(d))) }
            nomatch { }
        }
    }
    return args
}

# E14b: the written order of the arguments the next callBody is given
fn (c mut Checker&) setOrder(ord Array<I64>&) {
    c.argOrder.Clear()
    for w in ord { c.argOrder.Push(w) }
}

# arguments by name where nothing names parameters (E14b): said, and the call is unknown
fn (c mut Checker&) namedNotHere(args Array<ast.Expr&>&, through Bool) Bool {
    for a in args {
        match a {
            case ast.Expr.Named(nsp, _, _) {
                c.err(nsp, msgs.NamedArgThroughValue() if through else msgs.NamedArgNotHere())
                return true
            }
            nomatch { }
        }
    }
    return false
}

# a call, or a try of one: what may give several results (D8d)
fn callLike(x ast.Expr&) Bool {
    match x {
        case ast.Expr.Call(_, _, _), ast.Expr.ScopeCall(_, _, _, _) { return true }
        case ast.Expr.Paren(_, y) { return callLike(y) }
        case ast.Expr.Try(_, y, _) { return callLike(y) }
        nomatch { return false }
    }
}

# f(g()) where g gives several results and f takes as many (D8d): g's call held, each of its parts an argument; an
# argument giving one value is that argument
# where a call is named: its function's name - a member's name for a method - the span stage 0's diagnostics give
fn (c mut Checker&) calleeSpan(x ast.Expr&) source.Span {
    match x {
        case ast.Expr.Call(_, f, _) {
            match f {
                case ast.Expr.Member(msp, _, n) { return memberSpan(msp, c.text(n).Len()) }
                nomatch { return f.Span() }
            }
        }
        case ast.Expr.Paren(_, y) { return c.calleeSpan(y) }
        nomatch { return x.Span() }
    }
}

fn (c mut Checker&) spread(x ast.Expr&) Array<typed.Expr&>&c {
    e := c.expr(x, types.UnknownT)
    t := typeOf(e)
    from := c.exprs.Len()
    if c.P.T.KindOf(t) != types.Kind.Tuple {
        c.exprs.Push(e)
        return gather(c.exprs, from)
    }
    sp := x.Span()
    h := c.hidden(sp, t)
    c.stmts.Push(typed.Stmt.Let(sp, typed.LocalId(I32(h)), e))
    parts := c.P.T.Items(c.P.T.Parts(t))
    for i in range parts.Len() {
        c.exprs.Push(c.read(sp, typed.Lvalue.Field(sp, parts[i], typed.Lvalue.Local(sp, t, typed.LocalId(I32(h))), i)))
    }
    return gather(c.exprs, from)
}

# the default of parameter k of function f (D8a), checked in its declaration's module; written in another file, it is
# wrapped in Away
# the type arguments of the instance a call reaches: a default reading a variable of its declaration reads this
# instance's (D8a, G29)
fn (c mut Checker&) calleeArgs(t typed.Callee&) types.ListId {
    match t {
        case typed.Callee.Body(id) {
            match c.Bodies[I64(id)].Of {
                case typed.BodyOf.Fn(inst) { return c.P.InstanceArgs(inst) }
                nomatch { }
            }
        }
        nomatch { }
    }
    return types.ListId(0)
}

# a parameter's default an argument left off takes (D8a): through an "any"'s table, the trait's signature's - what the
# call sees (T32b), whatever the instance's own method says
fn (c mut Checker&) argDefault(sp source.Span, target typed.Callee&c, f I64, k I64, hasRecv Bool, want types.TypeId) typed.Expr&c {
    match target {
        case typed.Callee.Dispatch(r, slot, _) {
            slots := c.P.AnySlots(r)
            sl := slots[slot % slots.Len()]
            if sl.Method < 0 { return c.defaultArg(sp, sl.Default, k, true, want, types.ListId(0)) }
            m := c.traitMethod(sl)
            i := k - 1
            if m is null or i < 0 or i >= m.S.Params.Len() or m.S.Params[i].Dflt is null {
                np := m.S.Params.Len() if m is not null else 0
                c.err(sp, msgs.ArgCount(np, "" if np == 1 else "s", i))
                return c.unknown(sp)
            }
            d := c.P.T.DeclOf(sl.Trait)
            mi := c.P.T.DeclModule(d)
            here := c.fr().File
            fr := c.fr()
            inner := c.push(fr.Body, mi, types.VoidT, types.ListId(0))
            inner.Ctx = c.P.InstanceContext(sl.Trait)
            inner.Block = fr.Block
            x := c.exprTo(m.S.Params[i].Dflt!, want)
            c.defaultReads(x)
            file := c.fr().File
            c.pop()
            if file != here { return typed.Expr.Away(sp, file, x) }
            return x
        }
        nomatch { return c.defaultArg(sp, f, k, hasRecv, want, c.calleeArgs(target)) }
    }
}

fn (c mut Checker&) defaultArg(sp source.Span, f I64, k I64, hasRecv Bool, want types.TypeId, iargs types.ListId) typed.Expr&c {
    if f < 0 { return c.ctorDefault(sp, k, want) }
    fd := c.P.FnDecl(f)
    i := k - 1 if hasRecv or fd.Recv is not null else k
    if fd.S.Params.Len() == 0 or i < 0 or i >= fd.S.Params.Len() or fd.S.Params[i].Dflt is null {
        np := fd.S.Params.Len() if fd.S.Params.Len() > 0 else 0
        c.err(sp, msgs.ArgCount(np, "" if np == 1 else "s", i))
        return c.unknown(sp)
    }
    mi := c.P.FnModule(f)
    here := c.fr().File
    fr := c.fr()
    inner := c.push(fr.Body, mi, types.VoidT, types.ListId(0))
    inner.Ctx = c.P.FnContext(f, iargs)
    inner.Block = fr.Block
    x := c.exprTo(fd.S.Params[i].Dflt!, want)
    c.defaultReads(x)
    file := c.fr().File
    c.pop()
    if file != here { return typed.Expr.Away(sp, file, x) }
    return x
}

# D8a: a default is computed while compiling - a mutable global it reads has the running program's value (said once,
# at the global's name in the declaration)
fn (c mut Checker&) defaultReads(x typed.Expr?&) {
    if x is null { return }
    match x {
        case typed.Expr.Read(rsp, _, p, _) {
            match p {
                case typed.Lvalue.Global(_, _, mi, n) {
                    v := c.P.GlobalDecl(mi, n)
                    if v is not null and writtenMut(v.Ty) {
                        c.P.L.Diags.ErrorOncePerLine(c.at(rsp), msgs.DefaultNotComputable("it reads a mutable global, whose value is the running program's"))
                    }
                }
                nomatch { }
            }
        }
        case typed.Expr.Prim(_, _, _, _, args) {
            for a in args { c.defaultReads(a) }
        }
        case typed.Expr.Call(_, _, cl) {
            for a in cl.Args { c.defaultReads(a) }
        }
        nomatch { }
    }
}

# the default of a constructor's parameter k (D8a), checked in its type's context - an instance's arguments bound
fn (c mut Checker&) ctorDefault(sp source.Span, k I64, want types.TypeId) typed.Expr&c {
    t := c.ctorCalled
    td := c.P.TypeDecl(c.P.T.DeclOf(t)) if t != types.UnknownT else null
    ps Array<ast.Param&>&td = Array<ast.Param&>(0)
    if td is not null and td.Body is not null {
        match td.Body {
            case ast.TypeBody.Struct(s) { ps = s.Params }
            nomatch { }
        }
    }
    if ps.Len() == 0 or k >= ps.Len() or ps[k].Dflt is null {
        c.err(sp, msgs.ArgCount(k, "" if k == 1 else "s", k - 1))
        return c.unknown(sp)
    }
    mi := c.P.T.DeclModule(c.P.T.DeclOf(t))
    here := c.fr().File
    fr := c.fr()
    inner := c.push(fr.Body, mi, types.VoidT, types.ListId(0))
    inner.Ctx = c.P.InstanceContext(t)
    inner.Block = fr.Block
    x := c.exprTo(ps[k].Dflt!, want)
    file := c.fr().File
    c.pop()
    if file != here { return typed.Expr.Away(sp, file, x) }
    return x
}

# x.m(args): a method of x's type (M19); an array's Len supplied by the compiler (E23)
fn (c mut Checker&) methodCall(sp source.Span, x ast.Expr&, n source.NameId, nsp source.Span, args Array<ast.Expr&>&
                               targs Array<ast.TypeRef&>& = Array<ast.TypeRef&>(0), gsp source.Span = source.Span(0, 0)) typed.Expr&c {
    # E13c: a number written as a literal is a receiver like any other value, of its own type (T6a)
    lm := targs.Len() == 0 and laneMethodName(c.text(n), args.Len())
    c.laneAccept = lm   # E39: a total or a lane method takes lanes as they are
    rx := c.expr(x, types.UnknownT)
    rt := typeOf(rx)
    if rt == types.UnknownT {
        c.dropArgs(args)
        return c.unknown(sp)
    }
    if lm and (c.laneOf(rx) >= 0 or c.laneArray(rt)) {
        nm := c.text(n)
        if c.laneOf(rx) >= 0 or c.P.MethodOf(c.deref(rt), n) < 0 or nm == "Some" or nm == "Every" { return c.laneMethod(sp, nsp, nm, rx, args) }
    }
    if targs.Len() > 0 {
        # G12: type arguments name the method's own variables - only a declared method has any
        m0 := c.P.MethodOf(c.deref(rt), n)
        if m0 < 0 {
            ds := c.P.DefaultMethods(c.deref(rt), n)
            if ds.Len() == 1 { m0 = ds[0] }
        }
        if m0 < 0 and c.text(n) == "Narrow" and c.isNumber(c.deref(rt)) { return c.narrowCall(sp, nsp, rx, targs, args) }   # E26b
        if m0 < 0 or c.P.T.KindOf(c.deref(rt)) == types.Kind.Any {
            c.err(targs[0].Span(), msgs.TypeArgsOnNonGeneric(c.tok(n)))
            c.dropArgs(args)
            return c.unknown(sp)
        }
        ex := c.explicitArgs(m0, targs, gsp)
        if ex.Len() == 0 {
            c.dropArgs(args)
            return c.unknown(sp)
        }
        if not c.text(n)[0].IsUpper() and c.P.FnModule(m0) != c.fr().Mi { c.err(nsp, msgs.MethodIsPrivate(c.tok(n))) }
        return c.invoke(sp, nsp, m0, rx, args, Array<typed.Expr&>(0), ex)
    }
    name := c.text(n)
    # the prelude's vacate takes the place itself, whatever it holds - an any, or a reference that may be null - reading
    # nothing through it
    vacates := name == "vacate" and args.Len() == 0 and c.P.L.Mods[c.fr().Mi].Prelude
    # T32b: a call through an "any" goes through its table
    if c.P.T.KindOf(c.deref(rt)) == types.Kind.Any and not vacates { return c.anyCall(sp, x, rx, n, nsp, args) }
    m := c.P.MethodOf(c.deref(rt), n)
    if m < 0 {
        ds := c.P.DefaultMethods(c.deref(rt), n)
        if ds.Len() > 1 {
            # M19e: two traits' defaults of one name - the call cannot choose
            c.err(nsp, msgs.DefaultAmbiguous(c.ty(c.deref(rt)), c.tok(n)))
            c.dropArgs(args)
            return c.unknown(sp)
        }
        if ds.Len() == 1 { m = ds[0] }
    }
    # T2c: what the compiler supplies, and a function value in a field, are reached through the receiver - not through
    # one that may be null (a method fits its receiver as an argument, which says so there)
    if m < 0 and c.isRef(rt) and c.P.T.IsNullable(rt) and not vacates {
        c.err(x.Span(), msgs.ReadMaybeNull(c.src(x.Span()), c.ty(rt), bangOf(c.src(x.Span()))))
        rt = c.P.T.NonNull(rt)
    }
    if m < 0 and name == "Len" and args.Len() == 0 and c.arrayOf(rt) != types.UnknownT {
        return c.prim(sp, c.i64(), typed.PrimOp.Len, rx, null)
    }
    if m < 0 and (c.deref(rt) == types.UnknownT or c.badOver(c.deref(rt))) {
        # a receiver of a type not known, or of no type to build (T29), was said where the type is written (B11)
        c.dropArgs(args)
        return c.unknown(sp)
    }
    if m < 0 and name != "Len" and c.isNamed(c.deref(rt)) and c.isOver(c.deref(rt)) and not c.P.Extends(c.deref(rt)) and c.baseHas(c.deref(rt), n) {
        # T29f: a declared type that does not extend its base has none of its base's methods
        c.err(nsp, msgs.MethodNotInherited(c.ty(c.deref(rt)), c.tok(n)))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    if m < 0 {
        r := c.suppliedCall(sp, nsp, x, rx, name, args)
        if r is not null { return r }
        dt := c.deref(rt)
        if c.isStruct(dt) and c.fieldIndex(dt, n) >= 0 {
            p := readPlace(rx)
            if p is null { p = typed.Lvalue.Temp(x.Span(), rt, rx, c.site(typed.SiteKind.Temp, x.Span())) }
            fp := c.field(sp, nsp, p!, n)
            if fp is not null { return c.callValue(sp, nsp, c.read(sp, fp), args) }
        }
        if c.isNamed(dt) and c.declKind(dt) == types.DeclKind.Trait {
            # a trait as a value's type was said where it is written (T30)
            c.dropArgs(args)
            return c.unknown(sp)
        }
        if name == "Hash" or name == "Str" {
            c.gap(nsp, "a method the compiler supplies (E10b, E11c)")
        } else if dt == c.charType() and (name == "PadStart" or name == "PadEnd") {
            # T29f: a Char is no Integer, so it has neither - its character is padded as text
            c.err(nsp, msgs.CharNoPad(c.tok(n), name))
        } else {
            c.err(nsp, msgs.UnknownMethod(c.ty(rt), c.tok(n), c.memberHint(rt, n, true)))   # the receiver as written, a reference one too
        }
        c.dropArgs(args)
        return c.unknown(sp)
    }
    # M6: a method is public by its first letter - another module's private one is said, and called still
    if not name[0].IsUpper() and c.P.FnModule(m) != c.fr().Mi { c.err(nsp, msgs.MethodIsPrivate(c.tok(n))) }
    return c.invoke(sp, nsp, m, rx, args, Array<typed.Expr&>(0))
}

# f(args) through a value (E13b): a function value, or an instance whose type declares Call (E31)
fn (c mut Checker&) callValue(sp source.Span, fsp source.Span, fv typed.Expr&c, args Array<ast.Expr&>&) typed.Expr&c {
    t := typeOf(fv)
    if t == types.UnknownT {
        c.dropArgs(args)
        return c.unknown(sp)
    }
    if c.P.T.KindOf(t) == types.Kind.Func { return c.callBody(sp, fsp, t, typed.Callee.Value(fv), -1, null, args, Array<typed.Expr&>(0)) }
    m := c.P.MethodOf(c.deref(t), c.P.L.Names.Intern("Call"))
    if m < 0 { m = c.P.MethodOf(c.deref(t), c.P.L.Names.Intern("call")) }
    c.privateRole(m, t, "Call", fsp, msgs.Tok(c.src(fsp)))
    if m >= 0 { return c.invoke(sp, fsp, m, fv, args, Array<typed.Expr&>(0)) }
    # E11b: a "(" after a rendering in a join calls what it renders - the value inside is joined with '$(...)'
    tx := c.P.L.Mods[c.fr().Mi].Src!.Text
    pb := I64(fsp.Start) - 1
    for pb > 0 and tx[pb] == ' ' { pb-- }
    if fsp.Start > 0 and tx[I64(fsp.Start)] == '(' and tx[pb] == '"' {
        c.err(source.Span(fsp.Start, fsp.Start + 1), msgs.JoinPieceCalled())
        c.dropArgs(args)
        return c.unknown(sp)
    }
    if fsp.Start > 0 and ((tx[I64(fsp.Start) - 1] == '$' and c.deref(t) == c.textType()) or tx[I64(fsp.Start)] == '"') {
        c.err(c.opAfter(fsp, 1), msgs.JoinPieceCalled())
        c.dropArgs(args)
        return c.unknown(sp)
    }
    c.err(fsp, msgs.NotCallable(c.ty(t)))
    c.dropArgs(args)
    return c.unknown(sp)
}

# whether a path is an import's alias, or reaches through one (M4)
# whether module mi declares a name, exported or not
fn (c mut Checker&) declaresName(mi I64, n source.NameId) Bool {
    for e in c.P.R.Tables[mi].Entries {
        if e.Name == n { return true }
    }
    return false
}

# a name module at does not declare, said at nsp - a C import's what its translation could not give, with why (X19)
fn (c mut Checker&) notInModule(at I64, n source.NameId, nsp source.Span) {
    m := c.P.L.Mods[at]
    why := try m.CSkipped.Get(c.text(n)) catch default ""
    if why != "" {
        c.err(nsp, msgs.CNoForm(c.text(n), why))
        return
    }
    # B11: the nearest name it exports - all its names to itself
    near mut msgs.Nearest& = msgs.Nearest(c.text(n))
    for e in c.P.R.Tables[at].Entries {
        if e.Kind != names.What.Import and (at == c.fr().Mi or load.Public(c.text(e.Name)) or m.C) { near.Offer(c.text(e.Name)) }
    }
    c.err(nsp, msgs.NotInModule($"module " $m.Identity, c.tok(n), near.Hint()))
}

fn (c mut Checker&) importPath(x ast.Expr&) Bool {
    match x {
        case ast.Expr.Name(sp, _) { return c.P.R.Use(c.fr().File, sp.Start).Kind == names.What.Import }
        case ast.Expr.Member(sp, _, _) { return c.P.R.Member(c.fr().File, sp.End).Kind == names.What.Import }
        nomatch { return false }
    }
}

# a method the compiler supplies (E23, E33, P9, E10b): null where name is none of them for this receiver
fn (c mut Checker&) suppliedCall(sp source.Span, nsp source.Span, x ast.Expr&, rx typed.Expr&c, name String&, args Array<ast.Expr&>&) typed.Expr?&c {
    rt := c.deref(typeOf(rx))
    u := c.under(rt)
    if name == "Bits" and args.Len() > 0 and c.P.T.IsFloat(u) {
        c.err(nsp, msgs.TakesNoArgs("'Bits'"))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    if name == "Bits" and args.Len() == 0 and c.P.T.IsFloat(u) {
        bits := c.P.T.Bits(u)
        r := c.P.T.Prim("U64") if bits == 64 else c.P.T.Prim("U32") if bits == 32 else c.P.T.Prim("U16")
        return c.prim(sp, r, typed.PrimOp.Bitcast, c.value(rx, sp), null)
    }
    if name.EndsWith("FromBits") and args.Len() == 0 and c.P.T.IsUnsigned(u) {
        f := name[:name.Len() - 8]
        ft := c.P.T.Prim(f)
        if ft != types.UnknownT and c.P.T.IsFloat(ft) {
            if c.P.T.Bits(ft) != c.P.T.Bits(u) {
                c.err(nsp, msgs.FromBitsReceiver(msgs.Tok(name)))
                return c.unknown(sp)
            }
            return c.prim(sp, ft, typed.PrimOp.Bitcast, c.value(rx, sp), null)
        }
    }
    if name == "Value" and c.isEnum(rt) { return c.rawValue(sp, nsp, rt, rx, args) }   # T17e
    if name == "Set" and c.arrayOf(rt) != types.UnknownT {
        # E16d: an element stored, its index checked - failing with ArrayError.OUT_OF_RANGE, as Get's
        if args.Len() != 2 {
            c.err(sp, msgs.ArgCount(2, "s", args.Len()))
            c.dropArgs(args)
            return c.unknown(sp)
        }
        p := readPlace(rx)
        if p is null { p = typed.Lvalue.Temp(x.Span(), typeOf(rx), rx, c.site(typed.SiteKind.Temp, x.Span())) }
        chk := c.failOp(types.TypeId[c.outOfRange()], nsp)
        ep := c.elemPlace(sp, p!, args[:1], chk)
        if ep is null {
            c.expr(args[1], types.UnknownT)
            return c.unknown(sp)
        }
        from := c.stmts.Len()
        c.notCapture(ep, c.writeAt(x))
        c.storeInto(sp, ep, args[1], args[1].Span(), null)
        return typed.Expr.Seq(sp, types.VoidT, typed.Seq(gather(c.stmts, from), null))
    }
    if (name == "Get" or name == "SliceOf") and c.arrayOf(rt) != types.UnknownT {
        # E16d, E16c: an index or a slice checked, written as a call - failing with ArrayError.OUT_OF_RANGE
        want I64 = 1 if name == "Get" else 2
        if args.Len() != want {
            c.err(sp, msgs.ArgCount(want, "" if want == 1 else "s", args.Len()))
            c.dropArgs(args)
            return c.unknown(sp)
        }
        p := readPlace(rx)
        if p is null { p = typed.Lvalue.Temp(x.Span(), typeOf(rx), rx, c.site(typed.SiteKind.Temp, x.Span())) }
        chk := c.failOp(types.TypeId[c.outOfRange()], nsp)
        if name == "SliceOf" { return c.sliceOf(sp, p!, args[0], args[1], chk) }
        ep := c.elemPlace(sp, p!, args, chk)
        if ep is null { return c.unknown(sp) }
        return c.read(sp, ep)
    }
    if name == "Narrow" and c.isNumber(rt) {
        c.err(nsp, msgs.NarrowNeedsType())
        c.dropArgs(args)
        return c.unknown(sp)
    }
    bop := bitOp(name)
    if bop != typed.PrimOp.Retire {
        # E37: an integer's bit operations, supplied
        if not c.P.T.IsInt(u) {
            c.err(nsp, msgs.BitOpNotInteger(name, c.ty(rt)))
            c.dropArgs(args)
            return c.unknown(sp)
        }
        if bop == typed.PrimOp.ByteSwap and c.P.T.Bits(u) % 8 != 0 {
            c.err(nsp, msgs.ByteSwapWidth(c.ty(rt), c.P.T.Bits(u)))
            c.dropArgs(args)
            return c.unknown(sp)
        }
        rot := bop == typed.PrimOp.RotateLeft or bop == typed.PrimOp.RotateRight
        want I64 = 1 if rot else 0
        if args.Len() != want {
            c.err(sp, msgs.ArgCount(want, "" if want == 1 else "s", args.Len()))
            c.dropArgs(args)
            return c.unknown(sp)
        }
        x0 := c.value(rx, sp)
        if not rot { return c.prim(sp, rt if bop == typed.PrimOp.ByteSwap else c.i64(), bop, x0, null) }
        n := c.expr(args[0], c.i64())
        nt := typeOf(n)
        if nt == types.UnknownT { return c.unknown(sp) }
        if not c.isInt(nt) {
            c.err(args[0].Span(), msgs.BitOpCount(c.ty(nt)))
            return c.unknown(sp)
        }
        if c.under(nt) != c.i64() { n = c.prim(args[0].Span(), c.i64(), typed.PrimOp.Convert, n, null) }
        return c.prim(sp, rt, bop, x0, n)
    }
    if name == "retire" and args.Len() == 0 and c.arrayOf(rt) != types.UnknownT and c.P.L.Mods[c.fr().Mi].Prelude {
        # M19g: where a collection stops using an array - nothing at run time but under -sanitize (B2f), where its
        # storage is poisoned; a module that retires arrays gives its arrays chunks of their own there
        c.P.L.Mods[c.fr().Mi].Retires = true
        return c.prim(sp, types.VoidT, typed.PrimOp.Retire, c.value(rx, sp), null)
    }
    if name == "grown" and args.Len() == 1 and c.isRef(typeOf(rx)) and c.arrayOf(rt) != types.UnknownT and c.P.L.Mods[c.fr().Mi].Prelude {
        # M19d: a collection's buffer grown - a new array of n elements, the first a.Len() moved out of a (each as
        # vacate moves it) and the rest unwritten, as E39's exact collect leaves none: the prelude's claim that its
        # collection writes each before reading it (a Vec's room past its count), which the compiler cannot infer
        el := c.P.T.Elem(c.arrayOf(rt))
        at := c.P.T.Array(el, types.TypeId(0))
        from := c.stmts.Len()
        h := c.hidden(sp, typeOf(rx))
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(h)), c.value(rx, sp)))
        nh := c.hidden(sp, c.i64())
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(nh)), c.value(c.exprTo(args[0], c.i64()), args[0].Span())))
        cfrom := c.stmts.Len()
        cid, couter, cmark := c.open(typed.BlockKind.Collect, sp)
        i, id, outer, mark, lfrom := c.laneLoopOpen(sp, c.prim(sp, c.i64(), typed.PrimOp.Len, c.readLocal(sp, h), null))
        base typed.Lvalue&c = typed.Lvalue.Deref(sp, rt, c.readLocal(sp, h))
        ep := typed.Lvalue.Elem(sp, el, typed.Elem(base, c.readLocal(sp, i), typed.Check.None))
        c.noteWrite(ep)
        c.emit(typed.Stmt.Yield(sp, typed.Expr.Take(sp, el, ep)))
        c.laneLoopClose(sp, i, id, outer, mark, lfrom)
        b := c.close(cid, couter, cmark, cfrom)
        r := typed.Expr.Collect(sp, at, typed.Collect(c.readLocal(sp, nh), b, c.site(typed.SiteKind.Collect, sp), typed.Check.None, true))
        return typed.Expr.Seq(sp, at, typed.Seq(gather(c.stmts, from), r))
    }
    if name == "Destroy" and args.Len() == 0 and c.isStruct(c.P.T.Repr(rt)) {
        # C9b: the instance a local names destructed now and its storage reclaimed - compiled only where early
        # freeing's analysis (compiler/free.olang) proves the local the only way left to reach it, which says so where
        # it is not
        if not c.destructs(rt) {
            c.err(nsp, msgs.DestroyNoDestructor(c.ty(rt)))
            return c.unknown(sp)
        }
        p := readPlace(rx)
        local := false
        if p is not null {
            match p {
                case typed.Lvalue.Local(_, _, _) { local = true }
                case _ { }
            }
        }
        if not local {
            c.err(c.operandAt(x), msgs.DestroyNotLocal())
            return c.unknown(sp)
        }
        return c.prim(sp, types.VoidT, typed.PrimOp.Destroy, rx, null)
    }
    if name == "vacate" and args.Len() == 0 and c.P.L.Mods[c.fr().Mi].Prelude {
        # docs/memory.md 3.4, O8d: what a place holds given and the place left empty - as a statement, what it held let
        # go of. The prelude's alone: it says which of a collection's positions are live, which the compiler cannot
        # infer. A move out of the place (Take), which lowering makes a plain read where nothing is freed early
        p := readPlace(rx)
        if p is null or not c.placeWritable(p) {
            c.err(c.operandAt(x), msgs.VacateNotPlace())
            return c.unknown(sp)
        }
        c.noteWrite(p)
        return typed.Expr.Take(sp, p.Type(), p)
    }
    if name.StartsWith("Atomic") {
        op := typed.PrimOp.AtomicLoad
        want I64 = 0
        if name == "AtomicStore" {
            op = typed.PrimOp.AtomicStore
            want = 1
        } else if name == "AtomicAdd" {
            op = typed.PrimOp.AtomicAdd
            want = 1
        } else if name == "AtomicSwap" {
            op = typed.PrimOp.AtomicSwap
            want = 1
        } else if name == "AtomicCompareSwap" {
            op = typed.PrimOp.AtomicCompareSwap
            want = 2
        } else if name != "AtomicLoad" {
            return null
        }
        if not c.P.T.IsInt(u) {
            c.err(nsp, msgs.AtomicNotInteger(c.ty(rt)))
            return c.unknown(sp)
        }
        if u > types.TypeId(14) {
            c.err(nsp, msgs.AtomicWidth(c.ty(rt)))
            return c.unknown(sp)
        }
        p := readPlace(rx)
        if p is null {
            c.err(c.operandAt(x), msgs.AtomicNotPlace())
            return c.unknown(sp)
        }
        if op != typed.PrimOp.AtomicLoad { c.noteWrite(p) }
        if op != typed.PrimOp.AtomicLoad and not c.placeWritable(p) {
            c.err(c.operandAt(x), msgs.AtomicNotWritable())
            return c.unknown(sp)
        }
        if args.Len() != want {
            c.err(sp, msgs.ArgCount(want, "" if want == 1 else "s", args.Len()))
            return c.unknown(sp)
        }
        from := c.exprs.Len()
        c.exprs.Push(typed.Expr.Borrow(nsp, c.P.T.Ref(rt, types.Writable), p))
        for a in args { c.exprs.Push(c.exprTo(a, rt)) }
        r := types.VoidT if op == typed.PrimOp.AtomicStore else rt
        return typed.Expr.Prim(sp, r, op, typed.Check.None, gather(c.exprs, from))
    }
    if name == "Hash" and args.Len() == 0 {
        c.hashAt = nsp
        c.partHashes(rt, 0)
        c.hashAt = source.Span(-1, -1)
        return c.callOf(sp, c.i64(), typed.Callee.Helper(typed.Helper.Hash, rt), c.one(c.value(rx, sp)))
    }
    return null
}

# E37: the bit operation a supplied method's name names; Retire for none
fn bitOp(name String&) typed.PrimOp {
    return match name {
        case "LeadingZeros" => typed.PrimOp.LeadingZeros
        case "TrailingZeros" => typed.PrimOp.TrailingZeros
        case "PopCount" => typed.PrimOp.PopCount
        case "RotateLeft" => typed.PrimOp.RotateLeft
        case "RotateRight" => typed.PrimOp.RotateRight
        case "ByteSwap" => typed.PrimOp.ByteSwap
        case _ => typed.PrimOp.Retire
    }
}

# whether the type a declared type is over has a method of this name - one declared, or one the compiler supplies for
# it (E33's bits, P9's atomics)
fn (c mut Checker&) baseHas(t types.TypeId, n source.NameId) Bool {
    b := c.P.T.Base(t)
    if c.P.MethodOf(b, n) >= 0 or c.P.DefaultMethod(b, n) >= 0 { return true }
    name := c.text(n)
    u := c.under(b)
    if name == "Bits" { return c.P.T.IsFloat(u) }
    if name.EndsWith("FromBits") { return c.P.T.IsUnsigned(u) }
    if name.StartsWith("Atomic") or bitOp(name) != typed.PrimOp.Retire { return c.P.T.IsInt(u) }
    return false
}

# ---- members, indices, arrays ----

# x.f: a field of a struct (C2), through references; a case of an enum named by its type (T17); a global of an import
fn (c mut Checker&) member(sp source.Span, x ast.Expr&, n source.NameId, want types.TypeId = types.UnknownT) typed.Expr&c {
    ref := c.P.R.Member(c.fr().File, sp.End)
    nsp := memberSpan(sp, c.text(n).Len())
    if ref.Kind == names.What.Global { return c.read(sp, typed.Lvalue.Global(sp, c.globalType(ref.Module, n), ref.Module, n)) }
    # T21: a function named through an import alias, as a value - as one named bare
    if ref.Kind == names.What.Func { return c.fnValue(nsp, c.P.FnNamed(ref.Module, n)) }
    if ref.Kind == names.What.Build { return c.buildConst(sp, n) }
    if ref.Kind != names.What.None {
        c.gap(nsp, "a member reached through an import, of this kind")
        return c.unknown(sp)
    }
    if c.importPath(x) {
        # a name the imported module does not declare (or does not export: the resolver said so already)
        at := match x {
            case ast.Expr.Name(xsp, _) => c.P.R.Use(c.fr().File, xsp.Start).Module
            case ast.Expr.Member(xsp, _, _) => c.P.R.Member(c.fr().File, xsp.End).Module
            case _ => -1
        }
        if at >= 0 and not c.declaresName(at, n) { c.notInModule(at, n, nsp) }
        return c.unknown(sp)
    }
    # E40: Place.Here, the one member Place gives through its name - before reflection, which reads every type's
    if c.namesPlace(x) { return c.placeHere(sp, nsp, n) }
    # G32, G34: a type's reflected members, a descriptor's
    rv := c.reflMember(sp, nsp, x, n)
    if rv is not null { return rv }
    et := c.typeNamed(x)
    if et >= types.TypeId(0) and (c.isNumber(et) or (isLimitName(c.text(n)) and not c.isNamed(et))) { return c.limit(sp, nsp, et, n) }
    if et >= types.TypeId(0) { return c.enumCase(sp, nsp, et, n, Array<ast.Expr&>(0)) }
    gd := c.genericNamed(x)
    if gd >= types.DeclId(0) and c.P.T.DeclKindOf(gd) == types.DeclKind.Enum { return c.genericCase(sp, nsp, gd, n, Array<ast.Expr&>(0), want) }
    # S8d: a payload field of a local known to hold one case
    fl := c.narrowedName(x, n)
    if fl >= 0 { return c.readLocal(sp, fl) }
    p := c.place(x)
    if p is null { return c.unknown(sp) }
    fp := c.field(sp, nsp, p, n)
    if fp is null { return c.unknown(sp) }
    return c.read(sp, fp)
}

# a field of what a place holds, through references
fn (c mut Checker&) field(sp source.Span, nsp source.Span, p typed.Lvalue&c, n source.NameId) typed.Lvalue?&c {
    base := p
    t := p.Type()
    for _ in range 4 {
        if not c.isRef(t) { break }
        c.nullRead(base)
        base = typed.Lvalue.Deref(sp, c.P.T.Referent(t), c.read(sp, base))
        t = c.P.T.Referent(t)
    }
    if t == types.UnknownT { return null }
    if c.isEnum(t) {
        # S8d: a payload's field is read where a test narrows the local to its case
        c.err(nsp, msgs.FieldOfEnum(c.ty(t), c.text(n)))
        return null
    }
    if not c.isStruct(t) {
        # only a struct has fields: a number's, an array's, a function value's member is a misspelling
        c.err(nsp, msgs.NoSuchMember(c.ty(t), c.text(n), c.memberHint(t, n, false)))
        return null
    }
    i := c.fieldIndex(t, n)
    if i < 0 {
        c.err(nsp, msgs.NoSuchMember(c.ty(t), c.text(n), c.memberHint(t, n, true)))
        return null
    }
    fs := c.P.T.Items(c.P.T.Fields(t))
    if i < fs.Len() and fs[i] == types.UnknownT and not c.mentionsVar(t, -1) and c.P.CtorSig(t) != types.UnknownT {
        # a ":=" field whose type needs the checker (D15: a lambda, a conditional) is its constructor's to say - checked
        # now where it has not been (fieldTypes fills the field in)
        id := c.ctorBody(t)
        if c.state[id] == 0 {
            c.checkNow(id)
            fs = c.P.T.Items(c.P.T.Fields(t))
        }
    }
    if i >= fs.Len() {
        c.gap(nsp, "a field the checker cannot place")
        return null
    }
    # M6a: a member is public by its own first letter - another module's private one is said, its type carried on
    # (of a private type itself, M6 said where the type is named)
    dm := c.P.T.DeclModule(c.P.T.DeclOf(t))
    if not c.text(n)[0].IsUpper() and dm != c.fr().Mi and c.text(c.P.T.DeclName(c.P.T.DeclOf(t)))[0].IsUpper() and not c.P.L.Mods[dm].C {
        c.err(nsp, msgs.MemberIsPrivate(c.text(n), c.ty(t)))
    }
    return typed.Lvalue.Field(sp, fs[i], base, i)
}

# a field's position among a struct's: its constructor body's field declarations, in order (C2)
fn (c mut Checker&) fieldIndex(t types.TypeId, n source.NameId) I64 {
    td := c.P.TypeDecl(c.P.T.DeclOf(t))
    if td is null or td.Body is null { return -1 }
    match td.Body {
        case ast.TypeBody.Struct(s) {
            if s.Body.Len() == 0 { return -1 }
            k I64 = 0
            for st in s.Body {
                match st {
                    case ast.Stmt.Var(_, v) {
                        if v.Field {
                            for vn in v.Names {
                                if vn == n { return k }
                                k++
                            }
                        }
                    }
                    nomatch { }
                }
            }
            return -1
        }
        nomatch { return -1 }
    }
}

# B11: " - did you mean 'x'?" for a member t has no n of - the nearest of its methods (its type's, a trait default
# reaching it) and, with fields, a struct's fields, each where this module may name it; "" where none is near
fn (c mut Checker&) memberHint(t types.TypeId, n source.NameId, fields Bool) String {
    near mut msgs.Nearest& = msgs.Nearest(c.text(n))
    dt := c.deref(t)
    for m in c.P.MethodNames() {
        f := c.P.MethodOf(dt, m)
        if f < 0 {
            ds := c.P.DefaultMethods(dt, m)
            if ds.Len() != 1 { continue }
            f = ds[0]
        }
        if c.text(m)[0].IsUpper() or c.P.FnModule(f) == c.fr().Mi { near.Offer(c.text(m)) }
    }
    if fields and c.isStruct(dt) {
        td := c.P.TypeDecl(c.P.T.DeclOf(dt))
        mine := c.P.DeclModule(c.P.T.DeclOf(dt)) == c.fr().Mi
        if td is not null and td.Body is not null {
            match td.Body {
                case ast.TypeBody.Struct(sb) {
                    for st in sb.Body {
                        match st {
                            case ast.Stmt.Var(_, v) {
                                if v.Field {
                                    for vn in v.Names {
                                        if mine or c.text(vn)[0].IsUpper() { near.Offer(c.text(vn)) }
                                    }
                                }
                            }
                            nomatch { }
                        }
                    }
                }
                nomatch { }
            }
        }
    }
    return near.Hint()
}

# Place.Here (E40): where it is written - or, in a default a call leaves off (D8a), where that call is - as a Place
# built while compiling: the file as diagnostics write it, read-only constant text, and its line and column
fn (c mut Checker&) placeHere(sp source.Span, nsp source.Span, n source.NameId) typed.Expr&c {
    if c.text(n) != "Here" {
        c.err(nsp, msgs.PlaceMember(c.text(n)))
        return c.unknown(sp)
    }
    t := c.placeType()
    sig := c.P.CtorSig(t)
    if sig == types.UnknownT { return c.unknown(sp) }
    file := c.fr().File
    at := I64(sp.Start)
    if c.hereFile >= 0 {
        file = c.hereFile
        at = I64(c.hereAt.Start)
    }
    d := c.P.L.Diags
    path := d.PathOf(file)
    bytes := U8[U8(ch) for ch in path]
    pre := typed.Expr&[typed.Expr.Data(sp, c.P.T.Ref(c.textType(), types.ReadOnly), c.fr().File, typed.Const.Bytes(bytes))
                       c.lit(sp, c.i64(), d.LineAt(file, at)), c.lit(sp, c.i64(), d.ColumnAt(file, at))]
    id := c.ctorBody(t)
    was := c.ctorCalled
    c.ctorCalled = t
    r := c.callBody(sp, nsp, sig, typed.Callee.Body(typed.BodyId(I32(id))), -1, null, Array<ast.Expr&>(0), pre)
    c.ctorCalled = was
    return r
}

# whether an expression names the prelude's Place (E40)
fn (c mut Checker&) namesPlace(x ast.Expr&) Bool {
    match x {
        case ast.Expr.Name(_, _) { }
        nomatch { return false }
    }
    et := c.typeNamed(x)
    return et >= types.TypeId(0) and et == c.placeType()
}

# a default a call leaves off (D8a, E40), built with the call's place - the outermost call's, where a default's own call
# leaves one off too - for Place.Here in it
fn (c mut Checker&) callDefault(nsp source.Span, sp source.Span, target typed.Callee&c, f I64, k I64, hasRecv Bool
                                want types.TypeId) typed.Expr&c {
    outer := c.hereFile < 0
    if outer {
        c.hereFile = c.fr().File
        c.hereAt = nsp
    }
    x := c.argDefault(sp, target, f, k, hasRecv, want)
    if outer { c.hereFile = -1 }
    return x
}

# T.Max, T.Min and a float's Inf, NaN, Epsilon, SmallestNormal: a constant of the type (E36) - of a type variable's
# binding in an instance, of a declared type extending a number and declaring no constructor as its own
fn (c mut Checker&) limit(sp source.Span, nsp source.Span, t types.TypeId, n source.NameId) typed.Expr&c {
    name := c.text(n)
    u := c.under(t)
    if not c.P.T.IsNumber(u) {
        c.err(nsp, msgs.NoLimit(c.ty(t), name, " - it is not a numeric type"))
        return c.unknown(sp)
    }
    if c.isOver(t) and (not c.P.Extends(t) or c.P.CtorSig(t) != types.UnknownT) {
        c.err(nsp, msgs.NoLimit(c.ty(t), name, " - a declared type has its base's limits only where it extends it and declares no constructor"))
        return c.unknown(sp)
    }
    fl := c.P.T.IsFloat(u)
    k := limitIndex(name)
    if k < 0 or (k > 1 and not fl) {
        have := "Max, Min, Inf, NaN, Epsilon and SmallestNormal" if fl else "Max and Min"
        c.err(nsp, msgs.NoLimit(c.ty(t), name, " - its limits are " $have))
        return c.unknown(sp)
    }
    if not fl and c.P.T.Bits(u) > 64 {
        # T4a: a limit of a type wider than 64 bits is no 64-bit constant (MIR's Const extends 64 bits by sign): the
        # least signed one is 1 shifted to the top bit, the greatest its complement, an unsigned one's all ones
        if c.P.T.IsUnsigned(u) {
            if k == 1 { return c.lit(sp, t, 0) }
            return c.prim(sp, t, typed.PrimOp.BitNot, c.lit(sp, t, 0), null)
        }
        least := c.prim(sp, t, typed.PrimOp.Shl, c.lit(sp, t, 1), c.lit(sp, c.i64(), c.P.T.Bits(u) - 1))
        if k == 1 { return least }
        return c.prim(sp, t, typed.PrimOp.BitNot, least, null)
    }
    return c.lit(sp, t, limitBits(c.P.T, u, k))
}

# a limit's position in [Max, Min, Inf, NaN, Epsilon, SmallestNormal] (E36), -1 for a name that is none
fn limitIndex(name String&) I64 {
    ns := String&["Max", "Min", "Inf", "NaN", "Epsilon", "SmallestNormal"]
    for i in range ns.Len() {
        if ns[i] == name { return i }
    }
    return -1
}

fn isLimitName(name String&) Bool { return limitIndex(name) >= 0 }

# a limit's bits as a Lit holds them (E36): an integer's value, a float's IEEE pattern
fn limitBits(tt types.Table&, u types.TypeId, k I64) I64 {
    w := tt.Bits(u)
    if tt.IsInt(u) {
        uns := tt.IsUnsigned(u)
        if k == 0 { return (-1 if w == 64 else (I64(1) << w) - 1) if uns else (I64(1) << (w - 1)) - 1 }
        return 0 if uns else -(I64(1) << (w - 1))
    }
    if u == types.TypeId(13) { return I64[0x7F7FFFFF, 0xFF7FFFFF, 0x7F800000, 0x7FC00000, 0x34000000, 0x00800000][k] }
    if u == types.TypeId(11) { return I64[0x7BFF, 0xFBFF, 0x7C00, 0x7E00, 0x1400, 0x0400][k] }
    if u == types.TypeId(12) { return I64[0x7F7F, 0xFF7F, 0x7F80, 0x7FC0, 0x3C00, 0x0080][k] }
    return I64[0x7FEFFFFFFFFFFFFF, 0xFFEFFFFFFFFFFFFF, 0x7FF0000000000000, 0x7FF8000000000000, 0x3CB0000000000000, 0x0010000000000000][k]
}

# ---- compile-time reflection (G32-G38) ----

# a list a reflection names (G33): T.Fields, T.Cases, T.Params, T.Results, or a case's Fields - the type, which list,
# the case (-1 for none); Ok false where an expression names no list
type reflList struct(Ok Bool, Of types.TypeId, Which I64, Case I64) {
    Ok, Of, Which, Case
}

fn noList() reflList { return reflList(false, types.UnknownT, 0, -1) }

# a list's position among Fields, Cases, Params, Results; -1 for a name that is none
fn listIndex(name String&) I64 {
    return match name {
        case "Fields" => generic.ListFields
        case "Cases" => generic.ListCases
        case "Params" => generic.ListParams
        case "Results" => generic.ListResults
        case "Methods" => generic.ListMethods
        case _ => -1
    }
}

fn listName(k I64) String { return String&["Fields", "Cases", "Params", "Results", "Functions", "Methods"][k] }

# the module an import's alias - or an alias chain - names, -1 where x is none (G41)
fn (c mut Checker&) aliasModule(x ast.Expr&) I64 {
    if not c.importPath(x) { return -1 }
    return match x {
        case ast.Expr.Name(xsp, _) => c.P.R.Use(c.fr().File, xsp.Start).Module
        case ast.Expr.Member(xsp, _, _) => c.P.R.Member(c.fr().File, xsp.End).Module
        case _ => -1
    }
}

# whether a type is named through a type variable here - reflection's then, never one of an enum's cases (G32)
fn (c mut Checker&) viaTypeVar(x ast.Expr&) Bool {
    match x {
        case ast.Expr.Name(sp, _) { return c.P.R.Use(c.fr().File, sp.Start).Kind == names.What.TypeVar }
        nomatch { return false }
    }
}

# the type an expression names for reflection (G32, G38): a type's name or a type variable bound here, or a type a
# reflected member names ("T.Base", "f.Type", "T.Fields[0].Type"); Unknown where that was said wrong; -1 for none
fn (c mut Checker&) reflType(x ast.Expr&) types.TypeId {
    t := c.typeNamed(x)
    if t >= types.TypeId(0) { return t }
    match x {
        case ast.Expr.Member(sp, b, n) {
            name := c.text(n)
            if not generic.ProjectsType(name) { return types.TypeId(-1) }
            bt := types.TypeId(-1)
            if name == "Type" { bt = c.descTypeOf(b) }
            if bt < types.TypeId(0) { bt = c.reflType(b) }
            if bt < types.TypeId(0) { return bt }
            if bt == types.UnknownT { return bt }
            pt, why := c.P.Project(bt, name)
            if why != "" {
                c.err(memberSpan(sp, name.Len()), msgs.ReflNoType(name, c.ty(bt), why))
                return types.UnknownT
            }
            return pt
        }
        case ast.Expr.Paren(_, y) { return c.reflType(y) }
        case ast.Expr.Generic(sp, g, targs) {
            # an instance written with its arguments (G32): "Array<I64>.Kind", "Map<String&, I64>.Params"
            builtin := false
            match g {
                case ast.Expr.Name(gs, _) { builtin = c.P.R.Use(c.fr().File, gs.Start).Kind == names.What.Builtin }
                nomatch { }
            }
            path := typePathOf(g)
            if path.Len() == 0 or (not builtin and c.genericNamed(g) < types.DeclId(0)) { return types.TypeId(-1) }
            if path.Len() == 1 { return c.resolve(ast.TypeRef.Named(sp, path, targs)) }
            d := c.genericNamed(g)
            if not c.P.ArgsFit(d, targs) {
                c.err(targs[0].Span() if targs.Len() > 0 else sp, msgs.TypeArgCount(c.text(path[path.Len() - 1]), c.P.WrittenArity(d), generic.WrittenTypes(targs)))
                return types.UnknownT
            }
            it := c.P.Apply(c.fr().Ctx, d, targs)
            if it == types.UnknownT or not c.instancesMet(it, sp) or not c.P.Body(it) { return types.UnknownT }
            return it
        }
        nomatch { return types.TypeId(-1) }
    }
}

# the descriptor's type a value expression has, where it is one (G34): a name an unrolled loop binds, a local or
# parameter holding one, a constant index into a list; -1 for none. Nothing is evaluated
fn (c mut Checker&) descTypeOf(x ast.Expr&) types.TypeId {
    match x {
        case ast.Expr.Name(sp, n) {
            if c.P.R.Use(c.fr().File, sp.Start).Kind != names.What.Local { return types.TypeId(-1) }
            r := try c.fr().Ctx.Refl.Get(n) catch default types.TypeId(-1)
            if r >= types.TypeId(0) and c.P.T.KindOf(r) != types.Kind.Const { return r }
            id := c.localNamed(n)
            if id >= 0 and c.P.DescOf(c.localType(id)).K != generic.DescNone { return c.localType(id) }
            return types.TypeId(-1)
        }
        case ast.Expr.Index(sp, y, items) {
            l := c.listOf(y)
            if not l.Ok or items.Len() != 1 { return types.TypeId(-1) }
            k := c.reflInt(items[0])
            if not k.Ok { return types.TypeId(-1) }
            return c.listItem(sp, l, k.I)
        }
        case ast.Expr.Paren(_, y) { return c.descTypeOf(y) }
        nomatch { return types.TypeId(-1) }
    }
}

# the list an expression names (G33)
fn (c mut Checker&) listOf(x ast.Expr&) reflList {
    match x {
        case ast.Expr.Member(_, b, n) {
            # G41: an import's functions, "handlers.Functions" - a name the module declares stays its own
            if c.text(n) == "Functions" {
                m := c.aliasModule(b)
                if m >= 0 and not c.declaresName(m, n) { return reflList(true, types.VoidT, generic.ListFunctions, m) }
                return noList()
            }
            k := listIndex(c.text(n))
            if k < 0 { return noList() }
            ds := c.descTypeOf(b)
            if ds >= types.TypeId(0) {
                d := c.P.DescOf(ds)
                if d.K == generic.DescCase and k == generic.ListFields { return reflList(true, d.Of, k, d.Case) }
                # G41: a function's parameters and results
                if d.K == generic.DescFunc and k == generic.ListParams { return reflList(true, ds, k, -1) }
                if d.K == generic.DescFunc and k == generic.ListResults { return reflList(true, d.Of, k, -1) }
                return noList()
            }
            t := c.reflType(b)
            if t < types.TypeId(0) { return noList() }
            # an enum's own case of that name, written through the enum's name, is the case (G32)
            if c.isEnum(t) and not c.viaTypeVar(b) and c.hasCase(t, n) { return noList() }
            return reflList(true, t, k, -1)
        }
        case ast.Expr.Paren(_, y) { return c.listOf(y) }
        nomatch { return noList() }
    }
}

# a list's positions as this module sees them (M6a: another module's private fields left out); said where the type
# has no such list
fn (c mut Checker&) listItems(sp source.Span, l reflList) Array<I64> {
    if l.Of == types.UnknownT { return Array<I64>(0) }
    items, why := c.P.ReflItems(l.Of, l.Which, l.Case, c.fr().Mi)
    if why != "" {
        c.err(sp, msgs.ReflNotList(listName(l.Which), c.ty(l.Of), why))
        return Array<I64>(0)
    }
    return items
}

# the descriptor of a list's k-th item (G33): Unknown where k is outside it, said
fn (c mut Checker&) listItem(sp source.Span, l reflList, k I64) types.TypeId {
    items := c.listItems(sp, l)
    if l.Of == types.UnknownT { return types.UnknownT }
    if k < 0 or k >= items.Len() {
        c.err(sp, msgs.ReflIndexRange(k, items.Len()))
        return types.UnknownT
    }
    return c.descriptor(l, items[k])
}

fn (c mut Checker&) descriptor(l reflList, at I64) types.TypeId {
    if l.Which == generic.ListFunctions { return c.P.FuncDescriptor(at, types.UnknownT) }
    if l.Which == generic.ListMethods { return c.P.FuncDescriptor(at, l.Of) }
    kind := match l.Which {
        case generic.ListFields => generic.DescField
        case generic.ListCases => generic.DescCase
        case generic.ListParams => generic.DescParam
        case _ => generic.DescResult
    }
    if kind == generic.DescField { return c.P.Descriptor(kind, l.Of, 0 if l.Case < 0 else l.Case, at) }
    if kind == generic.DescCase { return c.P.Descriptor(kind, l.Of, at, 0) }
    return c.P.Descriptor(kind, l.Of, 0, at)
}

# a reflected value known while compiling (G35): an integer, a Bool, text, an enum's case (Ty the enum); Ok false where
# an expression is none. Touched says it read a reflected member - only such a condition is reflection's to decide
type reflVal struct(Ok Bool, K I64, I I64, S String&, Ty types.TypeId) {
    Ok, K, I, S, Ty
}

RvInt I64 = 0
RvBool I64 = 1
RvText I64 = 2
RvCase I64 = 3

fn noRefl() reflVal { return reflVal(false, 0, 0, "", types.UnknownT) }
fn rvInt(v I64) reflVal { return reflVal(true, RvInt, v, "", types.UnknownT) }
fn rvBool(v Bool) reflVal { return reflVal(true, RvBool, 1 if v else 0, "", types.UnknownT) }
fn rvText(s String&) reflVal { return reflVal(true, RvText, 0, s, types.UnknownT) }

fn (c mut Checker&) reflInt(x ast.Expr&) reflVal {
    v := c.reflFold(x)
    if v.Ok and v.K == RvInt { return v }
    return noRefl()
}

# a message reflection renders while compiling (G35, S18c): text, or a join of text and "$" renderings of what
# reflFold knows - a member's name, a type's size, a length ("field " $f.Name " has no order"); whether it does
fn (c mut Checker&) reflText(x ast.Expr&) String, Bool {
    was := c.reflTouched
    c.reflTouched = false
    out, ok := c.reflTextOf(x)
    c.reflSaid = c.reflTouched
    c.reflTouched = was
    return out, ok
}

fn (c mut Checker&) reflTextOf(x ast.Expr&) String, Bool {
    match x {
        case ast.Expr.Lit(sp, kind) {
            if kind == token.Tok.StrLit { return String(c.strBytes(sp)), true }
        }
        case ast.Expr.Paren(_, y) { return c.reflTextOf(y) }
        case ast.Expr.Join(_, parts) {
            out := ""
            for p in parts {
                t, ok := c.reflPiece(p)
                if not ok { return "", false }
                out = $out $t
            }
            return out, true
        }
        nomatch { }
    }
    return "", false
}

fn (c mut Checker&) reflPiece(p ast.Expr&) String, Bool {
    match p {
        case ast.Expr.Lit(sp, kind) {
            if kind == token.Tok.StrLit { return String(c.strBytes(sp)), true }
        }
        case ast.Expr.Unary(_, op, y) {
            if op == token.Tok.Dollar {
                v := c.reflFold(y)
                if not v.Ok { return "", false }
                if v.K == RvText { return v.S, true }
                if v.K == RvInt { return $v.I, true }
                if v.K == RvBool { return "true" if v.I == 1 else "false", true }
            }
        }
        nomatch { }
    }
    return "", false
}

# a condition reflection decides (G35): 1 true, 0 false, -1 where it reads no reflected member or is not decided
fn (c mut Checker&) reflDecide(x ast.Expr?&) I64 {
    if x is null { return -1 }
    was := c.reflTouched
    c.reflTouched = false
    v := c.reflFold(x)
    touched := c.reflTouched
    c.reflTouched = was
    if not touched or not v.Ok or v.K != RvBool { return -1 }
    return v.I
}

fn (c mut Checker&) reflFold(x ast.Expr&) reflVal {
    match x {
        case ast.Expr.Lit(sp, kind) {
            if kind == token.Tok.BoolLit { return rvBool(c.src(sp) == "true") }
            if kind == token.Tok.StrLit { return rvText(String(c.strBytes(sp))) }
            v := c.fold(x)
            if v.Ok and not v.IsFloat and not v.Big { return rvInt(v.I) }
            return noRefl()
        }
        case ast.Expr.Paren(_, y) { return c.reflFold(y) }
        case ast.Expr.Name(sp, n) {
            if c.P.R.Use(c.fr().File, sp.Start).Kind == names.What.Local and c.localNamed(n) < 0 {
                r := try c.fr().Ctx.Refl.Get(n) catch default types.TypeId(-1)
                if r >= types.TypeId(0) and c.P.T.KindOf(r) == types.Kind.Const {
                    c.reflTouched = true
                    return rvInt(c.P.T.ConstValue(r))
                }
            }
            return noRefl()
        }
        case ast.Expr.Unary(_, op, y) {
            v := c.reflFold(y)
            if not v.Ok { return v }
            if op == token.Tok.Not and v.K == RvBool { return rvBool(v.I == 0) }
            if op == token.Tok.Minus and v.K == RvInt { return rvInt(-v.I) }
            return noRefl()
        }
        case ast.Expr.Binary(_, op, a, b) {
            va := c.reflFold(a)
            if op == token.Tok.And and va.Ok and va.K == RvBool and va.I == 0 { return va }
            if op == token.Tok.Or and va.Ok and va.K == RvBool and va.I == 1 { return va }
            vb := c.reflFold(b)
            if not va.Ok or not vb.Ok or va.K != vb.K { return noRefl() }
            if op == token.Tok.And or op == token.Tok.Or { return vb if va.K == RvBool else noRefl() }
            if op == token.Tok.EqEq or op == token.Tok.NotEq {
                same := va.I == vb.I
                if va.K == RvText { same = va.S == vb.S }
                if va.K == RvCase { same = same and va.Ty == vb.Ty }
                return rvBool(same == (op == token.Tok.EqEq))
            }
            if va.K != RvInt { return noRefl() }
            return match op {
                case token.Tok.Lt => rvBool(va.I < vb.I)
                case token.Tok.Le => rvBool(va.I <= vb.I)
                case token.Tok.Gt => rvBool(va.I > vb.I)
                case token.Tok.Ge => rvBool(va.I >= vb.I)
                case token.Tok.Plus => rvInt(va.I + vb.I)
                case token.Tok.Minus => rvInt(va.I - vb.I)
                case token.Tok.Star => rvInt(va.I * vb.I)
                case _ => noRefl()
            }
        }
        case ast.Expr.Call(_, f, args) {
            match f {
                case ast.Expr.Generic(_, g, targs) {
                    # G40, G35: "x.HasAttr<A>()" is known while compiling
                    ax, name, _ := c.attrCallee(g)
                    if name == "HasAttr" and targs.Len() == 1 and args.Len() == 0 {
                        holder := c.attrHolder(ax)
                        if holder >= types.TypeId(0) {
                            c.reflTouched = true
                            if holder == types.UnknownT { return noRefl() }
                            a := c.resolve(targs[0])
                            if a == types.UnknownT { return noRefl() }
                            mi, _ := c.attrFound(holder, a)
                            return rvBool(mi >= 0)
                        }
                    }
                }
                case ast.Expr.Member(_, y, n) {
                    if c.text(n) == "Len" and args.Len() == 0 {
                        l := c.listOf(y)
                        if l.Ok {
                            c.reflTouched = true
                            if l.Of == types.UnknownT { return noRefl() }
                            items, why := c.P.ReflItems(l.Of, l.Which, l.Case, c.fr().Mi)
                            return rvInt(items.Len()) if why == "" else noRefl()
                        }
                    }
                }
                nomatch { }
            }
            return noRefl()
        }
        case ast.Expr.Member(_, y, n) {
            # an enum's case with no payload written by its name: TypeKind.Struct
            et := c.typeNamed(y)
            if et >= types.TypeId(0) and c.isEnum(et) and c.hasCase(et, n) and not c.viaTypeVar(y) {
                cn := c.P.T.CaseNames(et)
                for i in range cn.Len() {
                    if cn[i] == n { return reflVal(true, RvCase, i, "", et) }
                }
            }
            return c.reflConst(y, n)
        }
        nomatch { return noRefl() }
    }
}

# a reflected member known while compiling (G32, G34): a type's Name, Kind, Size, Align, Length; a descriptor's Name,
# Offset, HasDefault
fn (c mut Checker&) reflConst(y ast.Expr&, n source.NameId) reflVal {
    name := c.text(n)
    t := c.reflType(y)
    if t >= types.TypeId(0) and not (c.isEnum(t) and not c.viaTypeVar(y) and c.hasCase(t, n)) {
        if t == types.UnknownT { return noRefl() }
        if name == "Name" {
            c.reflTouched = true
            return rvText(c.P.ReflName(t))
        }
        if name == "Kind" {
            c.reflTouched = true
            k := c.P.ReflKind(t)
            if k < 0 { return noRefl() }
            return reflVal(true, RvCase, k, "", c.typeKindType())
        }
        if name == "Size" or name == "Align" {
            c.reflTouched = true
            if not c.P.Layout(t) { return noRefl() }
            return rvInt(c.P.T.Size(t) if name == "Size" else c.P.T.Align(t))
        }
        if (name == "Min" or name == "Max") and c.P.T.IsInt(t) {
            # an integer type's limits (E36), where they are I64 values: so "T.Min < 0" tells signed from unsigned
            c.reflTouched = true
            w := c.P.T.Bits(t)
            if c.P.T.IsUnsigned(t) {
                if name == "Min" { return rvInt(0) }
                return rvInt((I64(1) << w) - 1) if w < 64 else noRefl()
            }
            if w > 64 { return noRefl() }
            lo := I64(-9223372036854775807) - 1 if w == 64 else -(I64(1) << (w - 1))
            return rvInt(lo if name == "Min" else -(lo + 1))
        }
        if name == "Length" {
            c.reflTouched = true
            r := c.under(t)
            if c.P.T.KindOf(r) != types.Kind.Array or c.P.T.KindOf(c.P.T.Length(r)) != types.Kind.Const { return noRefl() }
            return rvInt(c.P.T.ConstValue(c.P.T.Length(r)))
        }
        return noRefl()
    }
    dt := c.descTypeOf(y)
    if dt < types.TypeId(0) { return noRefl() }
    if dt == types.UnknownT { return noRefl() }
    ds := c.P.DescOf(dt)
    c.reflTouched = true
    if name == "Name" { return rvText(c.descName(ds)) }
    if name == "HasDefault" and ds.K == generic.DescParam { return rvBool(c.paramDefault(ds) is not null) }
    if name == "Offset" and ds.K == generic.DescField {
        off := c.fieldOffset(ds)
        return rvInt(off) if off >= 0 else noRefl()
    }
    return noRefl()
}

fn (c mut Checker&) typeKindType() types.TypeId { return c.P.PreludeType("std/prelude/reflect", "TypeKind") }

# a described member's name (G34): a field's, a case's (a struct's one case its type's name), a constructor's
# parameter's ("" for a function type's parameter, whose name is no part of its type)
fn (c mut Checker&) descName(ds generic.Desc) String {
    r := c.P.ReflUnder(ds.Of)
    if ds.K == generic.DescField {
        ns := c.P.FieldNames(r) if c.isStruct(r) else c.P.CaseFieldNames(r, ds.Case)
        return $c.text(ns[ds.At]) if ds.At < ns.Len() else ""
    }
    if ds.K == generic.DescCase {
        if c.isStruct(r) { return $c.text(c.P.T.DeclName(c.P.T.DeclOf(r))) }
        # T20: an error value's word as "$" writes it, "io.Error.FULL"
        if c.P.T.KindOf(r) == types.Kind.ErrVal {
            codes := c.P.ErrValCodes(r)
            return c.P.ErrValWordText(r, codes[ds.Case]) if ds.Case < codes.Len() else ""
        }
        cn := c.P.T.CaseNames(r)
        return $c.text(cn[ds.Case]) if ds.Case < cn.Len() else ""
    }
    if ds.K == generic.DescFunc { return $c.text(c.P.FnDecl(ds.Case).Name) }
    if ds.K == generic.DescParam {
        # a function type's parameter names are no part of its type (T22, G16a), so an instance cannot say them
        if c.P.T.KindOf(ds.Of) == types.Kind.Func { return "" }
        fd := c.P.DescOf(ds.Of)
        if fd.K == generic.DescFunc {
            fps := c.P.FnDecl(fd.Case).S.Params
            return $c.text(fps[ds.At].Name) if ds.At < fps.Len() else ""
        }
        ps := c.P.CtorParams(ds.Of)
        return $c.text(ps[ds.At].Name) if ds.At < ps.Len() else ""
    }
    return ""
}

# a parameter's default as written (D8a), null for none - a function type's parameters have none
fn (c mut Checker&) paramDefault(ds generic.Desc) ast.Expr?&c {
    if c.P.T.KindOf(ds.Of) == types.Kind.Func { return null }
    fd := c.P.DescOf(ds.Of)
    if fd.K == generic.DescFunc {
        fps := c.P.FnDecl(fd.Case).S.Params
        return fps[ds.At].Dflt if ds.At < fps.Len() else null
    }
    ps := c.P.CtorParams(ds.Of)
    if ds.At >= ps.Len() { return null }
    return ps[ds.At].Dflt
}

# a field's offset as laid out (G32), -1 where the type is not laid out: a struct's field's, an enum case's past the tag
# word (T17)
fn (c mut Checker&) fieldOffset(ds generic.Desc) I64 {
    r := c.P.ReflUnder(ds.Of)
    if not c.P.Layout(r) { return -1 }
    if c.isStruct(r) {
        offs := c.P.T.Offsets(r)
        return offs[ds.At] if ds.At < offs.Len() else -1
    }
    cases := c.P.T.Items(c.P.T.Cases(r))
    if ds.Case >= cases.Len() or cases[ds.Case] == types.TypeId(0) { return -1 }
    rec := cases[ds.Case]
    if not c.P.Layout(rec) { return -1 }
    offs := c.P.T.Offsets(rec)
    return 8 + offs[ds.At] if ds.At < offs.Len() else -1
}

# a reflected value written into the program: a literal of its type
fn (c mut Checker&) reflExpr(sp source.Span, v reflVal) typed.Expr&c {
    if v.K == RvBool { return c.lit(sp, types.BoolT, v.I) }
    if v.K == RvInt { return c.lit(sp, c.i64(), v.I) }
    if v.K == RvText {
        # by its contents, no site's (T25d): one site gives each instance its own text
        return typed.Expr.Data(source.Span(0, 0), c.P.T.Ref(c.textType(), types.ReadOnly), c.fr().File, typed.Const.Bytes(v.S))
    }
    c.isEnum(v.Ty)
    cn := c.P.T.CaseNames(v.Ty)
    return c.enumCase(sp, sp, v.Ty, cn[v.I], Array<ast.Expr&>(0))
}

# x.n read as a reflected member (G32, G34): its value, or an error - null where x.n is no reflection (a field, an
# enum's case, a number's limit)
fn (c mut Checker&) reflMember(sp source.Span, nsp source.Span, x ast.Expr&, n source.NameId) typed.Expr?&c {
    name := c.text(n)
    l := c.listOf(ast.Expr.Member(sp, x, n))
    if l.Ok {
        c.err(sp, msgs.ReflListValue($c.src(sp)))
        return c.unknown(sp)
    }
    t := c.reflType(x)
    if t >= types.TypeId(0) {
        if t == types.UnknownT { return c.unknown(sp) }
        if c.isEnum(t) and not c.viaTypeVar(x) and c.hasCase(t, n) { return null }
        if generic.ProjectsType(name) {
            c.err(sp, msgs.ReflTypeNotValue($c.src(sp)))
            return c.unknown(sp)
        }
        if name == "Name" or name == "Kind" or name == "Size" or name == "Align" or name == "Length" {
            v := c.reflConst(x, n)
            if v.Ok { return c.reflExpr(sp, v) }
            if name == "Kind" { c.err(nsp, msgs.ReflNoKind(c.ty(t))) }
            if name == "Length" { c.err(nsp, msgs.ReflNoLength(c.ty(t))) }
            if name == "Size" or name == "Align" { c.err(nsp, msgs.ReflNoLayout(c.ty(t), name)) }
            return c.unknown(sp)
        }
        if c.isNumber(t) or isLimitName(name) { return null }
        if c.isEnum(t) { return null }
        # T20: an error type's word is said as one (enumCase)
        if c.isNamed(t) and c.declKind(t) == types.DeclKind.Error { return null }
        c.err(nsp, msgs.ReflNoMember(c.ty(t), name))
        return c.unknown(sp)
    }
    dt := c.descTypeOf(x)
    if dt < types.TypeId(0) { return null }
    if dt == types.UnknownT { return c.unknown(sp) }
    ds := c.P.DescOf(dt)
    if name == "Type" and ds.K != generic.DescCase {
        c.err(sp, msgs.ReflTypeNotValue($c.src(sp)))
        return c.unknown(sp)
    }
    if name == "Default" and ds.K == generic.DescParam { return c.reflDefault(sp, ds) }
    v := c.reflConst(x, n)
    if v.Ok { return c.reflExpr(sp, v) }
    have := match ds.K {
        case generic.DescField => "Name, Type, Offset, Of, Attr and HasAttr"
        case generic.DescCase => "Name, Fields, Attr and HasAttr"
        case generic.DescParam => "Name, Type, HasDefault, Default, Attr and HasAttr"
        case generic.DescFunc => "Name, Type, Params, Results, Errors, Attr and HasAttr - and it is called"
        case _ => "Type"
    }
    what := match ds.K {
        case generic.DescField => "field"
        case generic.DescCase => "case"
        case generic.DescParam => "parameter"
        case generic.DescFunc => "function"
        case _ => "result"
    }
    c.err(nsp, msgs.ReflDescNoMember(what, name, have))
    return c.unknown(sp)
}

# p.Default (G34): the parameter's default, built in its declaration's context as a call leaving it off builds it (D8a)
fn (c mut Checker&) reflDefault(sp source.Span, ds generic.Desc) typed.Expr&c {
    d := c.paramDefault(ds)
    if d is null {
        c.err(sp, msgs.ReflNoDefault(c.descName(ds), c.ty(ds.Of)))
        return c.unknown(sp)
    }
    pt, _ := c.P.DescType(ds)
    # G41: a function's parameter's default, as a call leaving it off builds it - a method's counted past its receiver
    fd := c.P.DescOf(ds.Of)
    if fd.K == generic.DescFunc {
        recv := c.P.FnDecl(fd.Case).Recv is not null
        return c.defaultArg(sp, fd.Case, ds.At + (1 if recv else 0), false, pt, types.ListId(0))
    }
    was := c.ctorCalled
    c.ctorCalled = ds.Of
    x := c.ctorDefault(sp, ds.At, pt)
    c.ctorCalled = was
    return x
}

# f.Of(v) (G34): the field f describes of v, a place - through references; a case's field only where v, a local or a
# parameter, is known to hold that case (S8d)
fn (c mut Checker&) reflOf(sp source.Span, nsp source.Span, dt types.TypeId, args Array<ast.Expr&>&) typed.Lvalue?&c {
    ds := c.P.DescOf(dt)
    if ds.K != generic.DescField {
        c.err(nsp, msgs.ReflDescNoMember("case" if ds.K == generic.DescCase else ("parameter" if ds.K == generic.DescParam else "result"), "Of", "its Name and Type"))
        c.dropArgs(args)
        return null
    }
    if args.Len() != 1 {
        c.err(sp, msgs.ReflOfArgs(args.Len()))
        c.dropArgs(args)
        return null
    }
    p := c.place(args[0])
    if p is null { return null }
    base := p
    t := base.Type()
    for _ in range 4 {
        if not c.isRef(t) { break }
        c.nullRead(base)
        base = typed.Lvalue.Deref(sp, c.P.T.Referent(t), c.read(sp, base))
        t = c.P.T.Referent(t)
    }
    if t == types.UnknownT { return null }
    if not c.P.T.Same(t, ds.Of) {
        c.err(args[0].Span(), msgs.ReflOfType(c.ty(ds.Of), c.ty(t)))
        return null
    }
    ft, _ := c.P.DescType(ds)
    if c.isStruct(t) { return typed.Lvalue.Field(sp, ft, base, ds.At) }
    # S8d: a case's field read where a test narrows the value to its case
    lid := c.narrowLocal(args[0])
    known := false
    for nr in c.fr().narrows {
        if nr.Local == lid and nr.Tag == ds.Case and not nr.Dead { known = true }
    }
    if not known {
        cn := c.P.T.CaseNames(t)
        c.err(args[0].Span(), msgs.FieldOfEnum(c.ty(t), $c.text(cn[ds.Case]) "'s " $c.descName(ds)))
        return null
    }
    rec := c.P.T.Items(c.P.T.Cases(t))[ds.Case]
    pp := typed.Lvalue.Payload(sp, rec, typed.Payload(base, ds.Case, typed.Check.None))
    return typed.Lvalue.Field(sp, ft, pp, ds.At)
}

# the local or parameter an expression names, -1 for none
fn (c mut Checker&) narrowLocal(x ast.Expr&) I64 {
    match x {
        case ast.Expr.Name(_, n) { return c.localNamed(n) }
        case ast.Expr.Paren(_, y) { return c.narrowLocal(y) }
        nomatch { return -1 }
    }
}

# f(args) with f a function's descriptor (G41): the call its name would be - a method's on its first argument
fn (c mut Checker&) reflFnCall(sp source.Span, nsp source.Span, ds generic.Desc, args Array<ast.Expr&>&) typed.Expr&c {
    fd := c.P.FnDecl(ds.Case)
    if fd.Recv is null { return c.invoke(sp, nsp, ds.Case, null, args, Array<typed.Expr&>(0)) }
    if args.Len() == 0 {
        c.err(sp, msgs.ReflFnCall(c.text(fd.Name), fd.S.Params.Len() + 1, 0))
        return c.unknown(sp)
    }
    return c.methodCall(sp, args[0], fd.Name, nsp, args[1:args.Len()])
}

# a name bound to a reflected member while a body is checked (G33), and what it stood for before
fn (c mut Checker&) reflBind(n source.NameId, t types.TypeId) types.TypeId {
    if n == source.NameId(0) or c.text(n) == "_" { return types.TypeId(-1) }
    was := try c.fr().Ctx.Refl.Get(n) catch default types.TypeId(-1)
    c.fr().Ctx.Refl.Put(n, t)
    return was
}

fn (c mut Checker&) reflUnbind(n source.NameId, was types.TypeId) {
    if n == source.NameId(0) or c.text(n) == "_" { return }
    if was >= types.TypeId(0) { c.fr().Ctx.Refl.Put(n, was) } else { c.fr().Ctx.Refl.Remove(n) }
}

# a name an unrolled loop binds, read as a value (G33): its position, or the descriptor - a value of no fields
fn (c mut Checker&) reflName(sp source.Span, n source.NameId) typed.Expr?&c {
    r := try c.fr().Ctx.Refl.Get(n) catch default types.TypeId(-1)
    if r < types.TypeId(0) { return null }
    if c.P.T.KindOf(r) == types.Kind.Const { return c.lit(sp, c.i64(), c.P.T.ConstValue(r)) }
    return c.zero(sp, r)
}

# for f in T.Fields { } (G33): unrolled - the body checked once per item, f bound to its descriptor, the key to its
# position. A loop of its own for break, each item a loop of its own for continue
fn (c mut Checker&) unrolled(sp source.Span, f ast.ForIn&, l reflList) {
    forSp := source.Span(sp.Start, sp.Start + 3)
    if f.Tried { c.err(forSp, msgs.ReflTryList()) }
    items := c.listItems(f.Source.Span(), l)
    from := c.stmts.Len()
    oid, oouter, omark := c.open(typed.BlockKind.Loop, sp)
    c.fr().exits.Push(oid)
    for k in range items.Len() {
        efrom := c.stmts.Len()
        eid, eouter, emark := c.open(typed.BlockKind.Loop, sp)
        c.fr().loops.Push(eid)
        wasName := c.reflBind(f.Name, c.descriptor(l, items[k]))
        wasKey := c.reflBind(f.Key, c.P.T.Const(c.i64(), k))
        if f.Body.Len() > 0 { c.stmtsOf(f.Body) }
        c.reflUnbind(f.Key, wasKey)
        c.reflUnbind(f.Name, wasName)
        c.emit(typed.Stmt.Jump(sp, typed.JumpKind.Break, typed.BlockId(I32(eid))))
        try c.fr().loops.Pop() catch { }
        eb := c.close(eid, eouter, emark, efrom)
        # continue: to the item's post clause, which leaves the item's loop
        pfrom := c.stmts.Len()
        pid, pouter, pmark := c.open(typed.BlockKind.Post, sp)
        c.emit(typed.Stmt.Jump(sp, typed.JumpKind.Break, typed.BlockId(I32(eid))))
        pb := c.close(pid, pouter, pmark, pfrom)
        c.emit(typed.Stmt.Loop(sp, eb, pb))
    }
    c.emit(typed.Stmt.Jump(sp, typed.JumpKind.Break, typed.BlockId(I32(oid))))
    try c.fr().exits.Pop() catch { }
    ob := c.close(oid, oouter, omark, from)
    c.emit(typed.Stmt.Loop(sp, ob, null))
}

# T[e for x in T.Fields if c] (G33): unrolled into an array literal of the items its filter keeps - the filter decided
# per item while compiling
fn (c mut Checker&) unrolledCompr(sp source.Span, cm ast.Compr&, l reflList) typed.Expr&c {
    et := c.resolve(cm.Elem)
    items := c.listItems(cm.Source.Span(), l)
    from := c.exprs.Len()
    n I64 = 0
    for k in range items.Len() {
        wasName := c.reflBind(cm.Name, c.descriptor(l, items[k]))
        wasKey := c.reflBind(cm.Key, c.P.T.Const(c.i64(), k))
        keep := true
        if cm.Filter is not null {
            d := c.reflDecide(cm.Filter)
            if d < 0 {
                c.err(cm.Filter!.Span(), msgs.ReflFilterUndecided())
                keep = false
            } else {
                keep = d == 1
            }
        }
        if keep {
            x := c.exprTo(cm.Value, et)
            if not c.isRef(et) { c.roStore(x, cm.Value.Span(), RoStored) }
            c.exprs.Push(x)
            n++
        }
        c.reflUnbind(cm.Key, wasKey)
        c.reflUnbind(cm.Name, wasName)
    }
    xs := gather(c.exprs, from)
    at := c.P.T.Array(et, c.P.T.Const(c.i64(), n))
    return typed.Expr.Make(sp, at, typed.Make(typed.MakeKind.Array, 0, xs, null, c.site(typed.SiteKind.Make, sp), typed.Check.None))
}

# T(e for p in T.Params) (G37): a comprehension standing as a call's arguments, one argument per item - each an
# expression of its own, checked where the call checks it with its name bound (argItem)
fn (c mut Checker&) spreadArgs(args Array<ast.Expr&>&) Array<ast.Expr&>&args {
    if args.Len() == 0 { return args }
    spread := false
    for a in args {
        match a {
            case ast.Expr.Compr(_, cm) { if cm.InCall and cm.At < 0 { spread = true } }
            nomatch { }
        }
    }
    if not spread { return args }
    out Vec<ast.Expr&>
    for a in args {
        match a {
            case ast.Expr.Compr(csp, cm) {
                if not cm.InCall or cm.At >= 0 {
                    out.Push(a)
                    continue
                }
                l := c.listOf(cm.Source)
                if not l.Ok {
                    c.err(cm.Source.Span(), msgs.ReflArgCompr())
                    c.spreadBad = true
                    continue
                }
                items := c.listItems(cm.Source.Span(), l)
                for k in range items.Len() {
                    keep := true
                    if cm.Filter is not null {
                        wasName := c.reflBind(cm.Name, c.descriptor(l, items[k]))
                        wasKey := c.reflBind(cm.Key, c.P.T.Const(c.i64(), k))
                        d := c.reflDecide(cm.Filter)
                        c.reflUnbind(cm.Key, wasKey)
                        c.reflUnbind(cm.Name, wasName)
                        if d < 0 {
                            c.err(cm.Filter!.Span(), msgs.ReflFilterUndecided())
                            c.spreadBad = true
                        }
                        keep = d == 1
                    }
                    if keep {
                        out.Push(ast.Expr.Compr(csp, ast.Compr(cm.Elem, cm.Value, cm.Key, cm.Name, cm.Source, null, true, k)))
                    }
                }
            }
            nomatch { out.Push(a) }
        }
    }
    return out.ToArray()
}

# one argument a spread comprehension gave (G37): its value with the comprehension's names bound to its item
fn (c mut Checker&) argItem(cm ast.Compr&, want types.TypeId) typed.Expr&c {
    l := c.listOf(cm.Source)
    items := c.listItems(cm.Source.Span(), l)
    if not l.Ok or cm.At >= items.Len() { return c.unknown(cm.Value.Span()) }
    wasName := c.reflBind(cm.Name, c.descriptor(l, items[cm.At]))
    wasKey := c.reflBind(cm.Key, c.P.T.Const(c.i64(), cm.At))
    x := c.expr(cm.Value, want)
    c.reflUnbind(cm.Key, wasKey)
    c.reflUnbind(cm.Name, wasName)
    return x
}

# G6b, G10c: a generic enum's case written with the enum bare - "Tree.Leaf(3)": of the instance the expected type is, or
# else of the one its arguments bind, inferred as a generic constructor's are (a reference read-only, an array value a
# reference to it); a variable nothing binds is an error saying to write the arguments
fn (c mut Checker&) genericCase(sp source.Span, nsp source.Span, d types.DeclId, n source.NameId, args Array<ast.Expr&>&
                                want types.TypeId) typed.Expr&c {
    w := c.P.T.Plain(c.deref(want)) if want != types.UnknownT else types.UnknownT
    if w != types.UnknownT and c.P.T.KindOf(w) == types.Kind.Named and c.P.T.DeclOf(w) == d and c.P.T.Args(w) != types.ListId(0) {
        return c.enumCase(sp, nsp, w, n, args)
    }
    self := c.P.SelfType(d)
    if not c.P.Body(self) {
        c.dropArgs(args)
        return c.unknown(sp)
    }
    tag I64 = -1
    cn := c.P.T.CaseNames(self)
    if cn.Len() > 0 {
        for i in range cn.Len() {
            if cn[i] == n { tag = i }
        }
    }
    if tag < 0 {
        c.err(nsp, c.noCase(self, n))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    sig := c.P.CaseSig(self, tag)
    if sig == types.UnknownT { return c.unknown(sp) }
    owner := generic.DeclOwner(d)
    nv := c.P.T.DeclParams(d)
    ps := c.P.T.Items(c.P.T.Params(sig))
    if args.Len() != ps.Len() {
        c.err(sp, msgs.ArgCount(ps.Len(), "" if ps.Len() == 1 else "s", args.Len()))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    b := generic.Binding(owner, nv)
    argVals Vec<typed.Expr&>
    for i in range args.Len() {
        e typed.Expr?&c = null
        v := c.fold(args[i])
        if v.Ok or c.litLike(args[i]) {
            fl := v.IsFloat if v.Ok else c.litFloat(args[i])
            c.unify(ps[i], c.P.T.Prim("F64") if fl else c.i64(), b, true, false)
        } else {
            match args[i] {
                case ast.Expr.Lambda(_, _), ast.Expr.Default(_) { }
                nomatch { e = c.expr(args[i], types.UnknownT) }
            }
        }
        if e is not null and typeOf(e) != types.UnknownT and typeOf(e) != types.NoreturnT { c.unify(ps[i], c.bindType(e), b, false, false) }
        if e is null { argVals.Push(c.hole) } else { argVals.Push(e) }
    }
    c.P.InferThroughBounds(b)
    for i in range nv {
        v := b.Vals[i]
        if v == types.UnknownT and c.P.ErrVarAt(owner, i) {
            b.Vals[i] = c.P.ErrSetOf(types.ListId(0))
            continue
        }
        if v == types.UnknownT {
            tn := c.text(c.P.T.DeclName(d))
            c.err(nsp, msgs.CaseTypeArgsNotInferable(tn, $tn "." $c.text(n)))
            return c.unknown(sp)
        }
        if c.isRef(v) {
            b.Vals[i] = c.P.T.Ref(c.P.T.Referent(v), types.ReadOnly)
        } else if c.P.T.KindOf(c.under(v)) == types.Kind.Array {
            b.Vals[i] = c.P.T.Ref(v, types.ReadOnly)
        }
    }
    t := c.P.Instance(d, c.P.T.List(b.Vals))
    if not c.instancesMet(t, nsp) or not c.P.Body(t) { return c.unknown(sp) }
    return c.enumCase(sp, nsp, t, n, args, argVals.ToArray())
}

# E.Case or E.Case(args): an enum value (T17) - pre, where given, the arguments already checked (genericCase's), c.hole
# for one still to check
fn (c mut Checker&) enumCase(sp source.Span, nsp source.Span, t types.TypeId, n source.NameId, args Array<ast.Expr&>&
                             pre Array<typed.Expr&>& = Array<typed.Expr&>(0)) typed.Expr&c {
    if not c.isEnum(t) {
        if c.isNamed(t) and c.declKind(t) == types.DeclKind.Error {
            # T20: an error word written is an error value of its type - never null
            k := c.wordIndex(c.P.T.DeclOf(t), n)
            if k < 0 or args.Len() > 0 or c.P.IsErrorSet(t) and c.P.ErrorWords(c.P.T.DeclOf(t)).Len() == 0 {
                near mut msgs.Nearest& = msgs.Nearest(c.text(n))
                for w in c.P.ErrorWords(c.P.T.DeclOf(t)) { near.Offer(c.text(w)) }
                c.err(nsp, msgs.NoSuchErrorWord(c.text(c.P.T.DeclName(c.P.T.DeclOf(t))), c.tok(n), near.Hint()))
                c.dropArgs(args)
                return c.unknown(sp)
            }
            vt := c.P.ErrValOf(types.TypeId[t])
            j := 0
            set := c.P.T.Items(c.P.T.ErrValItems(vt))
            for q in range set.Len() {
                if c.P.T.ErrOf(set[q]) == t { j = q }
            }
            return c.lit(sp, vt, ((j + 1) << 16) | k)
        }
        # G32: a type's namespace holds its reflected members, its limits and an enum's cases - nothing by this name
        c.err(nsp, msgs.ReflNoMember(c.ty(t), c.text(n)))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    tag I64 = -1
    cn := c.P.T.CaseNames(t)
    if cn.Len() > 0 {
        for i in range cn.Len() {
            if cn[i] == n { tag = i }
        }
    }
    if tag < 0 {
        c.err(nsp, c.noCase(t, n))
        return c.unknown(sp)
    }
    c.casePublic(t, n, nsp)
    sig := c.P.CaseSig(t, tag)
    ps := c.P.T.Items(c.P.T.Params(sig))
    given I64 = 0
    if args.Len() > 0 { given = args.Len() }
    if given != ps.Len() {
        c.err(sp, msgs.ArgCount(ps.Len(), "" if ps.Len() == 1 else "s", given))
        return c.unknown(sp)
    }
    from := c.exprs.Len()
    cd := caseDecl(c.P.TypeDecl(c.P.T.DeclOf(t)), tag)
    for i in range given {
        wasNull := c.nullDecl
        if cd is not null and cd.Payload.Len() > 0 and i < cd.Payload.Len() {
            c.nullDecl = c.markAt(c.P.DeclModule(c.P.T.DeclOf(t)), cd.Payload[i].Ty)
        }
        x := c.fit(pre[i], ps[i], c.argSpan(args[i])) if i < pre.Len() and pre[i] != c.hole else c.exprTo(args[i], ps[i])
        c.nullDecl = wasNull
        if not c.isRef(ps[i]) { c.roStore(x, args[i].Span(), RoStored) }   # T25c: a payload is writable storage
        c.exprs.Push(x)
    }
    items := gather(c.exprs, from)
    return typed.Expr.Make(sp, t, typed.Make(typed.MakeKind.Case, tag, items, null, typed.SiteId(-1), typed.Check.None))
}

# ---- raw values (T17e) ----

fn (c mut Checker&) hasCase(t types.TypeId, n source.NameId) Bool {
    for cn in c.P.T.CaseNames(t) {
        if cn == n { return true }
    }
    return false
}

# an enum's raw values, worked out once
fn (c mut Checker&) rawsOf(t types.TypeId) rawTable&c {
    d := c.P.T.DeclOf(t)
    if c.raws.Has(I64(d)) { return try c.raws.Get(I64(d)) catch { unreachable } }
    r := c.rawTable(d, false)
    c.raws.Put(I64(d), r)
    return r
}

# an enum declaration's raw values (T17e), its errors said where report is: a raw type that is text or an integer
# type; each case's value written as a literal of it, else text its name, an integer one more than the case before's
fn (c mut Checker&) rawTable(d types.DeclId, report Bool) rawTable&c {
    none := rawTable(types.UnknownT, false, Array<I64>(0), Array<Array<U8>&>(0))
    td := c.P.TypeDecl(d)
    if td is null or td.Body is null { return none }
    match td.Body {
        case ast.TypeBody.Enum(cases, raw) {
            if raw is null {
                if report {
                    for cd in cases {
                        if cd.Value is not null { c.err(cd.Value!.Span(), msgs.RawWithoutType()) }
                    }
                }
                return none
            }
            rt := c.P.Resolve(c.P.DeclContext(d), raw)
            if rt == types.UnknownT { return none }
            text := c.P.T.Same(rt, c.textType())
            if not text and not c.isInt(rt) {
                if report { c.err(raw.Span(), msgs.RawType(c.ty(rt))) }
                return none
            }
            n := cases.Len()
            bits := Array<I64>(n)
            bytes := Array<Array<U8>&>(n, Array<U8>(0))
            set := Array<Bool>(n)    # the values worked out: only those are compared
            prev := intLit(-1)
            for i in range n {
                cd := cases[i]
                if report and c.text(cd.Name) == "From" { c.err(c.caseNameSpan(cd), msgs.FromCaseName()) }
                at := c.caseNameSpan(cd) if cd.Value is null else cd.Value!.Span()
                if text {
                    if cd.Value is null {
                        bytes[i] = textBytes(c.text(cd.Name))
                    } else {
                        sp, ok := c.textValue(cd.Value!)
                        if not ok {
                            if report { c.err(at, msgs.RawNotLiteral(c.ty(rt))) }
                            continue
                        }
                        bytes[i] = c.strBytes(sp)
                    }
                    set[i] = true
                    for j in range i {
                        if set[j] and bytes[j] == bytes[i] {
                            if report { c.err(at, msgs.RawRepeated(c.text(cd.Name), "\"" $String(bytes[i]) "\"", c.text(cases[j].Name))) }
                            break
                        }
                    }
                    continue
                }
                v := noLit()
                if cd.Value is null {
                    na, ma := magOf(prev)
                    v = addMag(na, ma, false, U128(1)) if prev.Ok else noLit()
                } else if numberLitsOnly(cd.Value!) or isCharLit(cd.Value!) {
                    v = c.foldPart(cd.Value!)
                }
                if not v.Ok or v.IsFloat {
                    # a written value that is no integer literal, or one counted past U64's maximum
                    if report { c.err(at, msgs.RawNotLiteral(c.ty(rt)) if cd.Value is not null else msgs.RawNoFit("18446744073709551616", c.ty(rt))) }
                    prev = noLit()
                    continue
                }
                prev = v
                if not c.rawFits(v, rt) {
                    if report { c.err(at, msgs.RawNoFit(litText(v), c.ty(rt))) }
                    continue
                }
                bits[i] = v.I
                set[i] = true
                for j in range i {
                    if set[j] and bits[j] == bits[i] {
                        if report { c.err(at, msgs.RawRepeated(c.text(cd.Name), litText(v), c.text(cases[j].Name))) }
                        break
                    }
                }
            }
            return rawTable(rt, text, bits, bytes)
        }
        nomatch { return none }
    }
}

fn (c mut Checker&) caseNameSpan(cd ast.CaseDecl&) source.Span {
    return source.Span(cd.Sp.Start, cd.Sp.Start + I32(c.text(cd.Name).Len()))
}

# a raw value written as one text literal: its span
fn (c mut Checker&) textValue(x ast.Expr&) source.Span, Bool {
    match x {
        case ast.Expr.Lit(sp, kind) { return sp, kind == token.Tok.StrLit }
        case ast.Expr.Paren(_, y) { return c.textValue(y) }
        nomatch { return source.Span(0, 0), false }
    }
}

fn isCharLit(x ast.Expr&) Bool {
    return match x {
        case ast.Expr.Lit(_, kind) => kind == token.Tok.CharLit
        case _ => false
    }
}

fn textBytes(t String&) Array<U8> {
    b := Array<U8>(t.Len())
    for i, ch in t { b[i] = U8(ch) }
    return b
}

fn litText(v litv) String {
    if v.Wide { return "-" $v.W if v.Neg else $v.W }
    return $U64(v.I) if v.Big else $v.I
}

# whether an integer literal's value fits the integer type t (T17e)
fn (c mut Checker&) rawFits(v litv, t types.TypeId) Bool {
    u := c.under(t)
    w := c.P.T.Bits(u)
    if v.Wide or w > 64 { return not v.Wide and not (v.Big and not c.P.T.IsUnsigned(u)) and intFits(c.P.T, v, u) }
    if c.P.T.IsUnsigned(u) {
        if v.Big { return w == 64 }
        if v.I < 0 { return false }
        return w == 64 or v.I < (I64(1) << w)
    }
    if v.Big { return false }
    if w == 64 { return true }
    lim := I64(1) << (w - 1)
    return v.I >= -lim and v.I < lim
}

# a case's raw value, as Value gives it: a Lit, or text's constant data (T25d)
fn (c mut Checker&) rawOf(sp source.Span, tb rawTable&, k I64) typed.Expr&c {
    if tb.Text { return typed.Expr.Data(sp, c.P.T.Ref(c.textType(), types.ReadOnly), c.fr().File, typed.Const.Bytes(tb.Bytes[k])) }
    return c.lit(sp, tb.Ty, tb.Bits[k])
}

# x.Value() (T17e): the raw value of the case x holds - each case tested in turn, the case known where x is one
fn (c mut Checker&) rawValue(sp source.Span, nsp source.Span, et types.TypeId, rx typed.Expr&c, args Array<ast.Expr&>&) typed.Expr&c {
    tb := c.rawsOf(et)
    if tb.Ty == types.UnknownT {
        c.err(nsp, msgs.NoRawValues(c.ty(et), "Value"))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    if args.Len() > 0 {
        c.err(nsp, msgs.TakesNoArgs("'Value'"))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    x := c.value(rx, sp)
    match x {
        case typed.Expr.Make(_, _, m) {
            if m.Kind == typed.MakeKind.Case and m.Items.Len() == 0 { return c.rawOf(sp, tb, m.Tag) }
        }
        nomatch { }
    }
    rt := typeOf(c.rawOf(sp, tb, 0))
    sfrom := c.stmts.Len()
    px := c.heldOf(sp, x)
    n := c.P.T.Items(c.P.T.Cases(et)).Len()
    r := c.rawOf(sp, tb, n - 1)
    for kk in range n - 1 {
        k := n - 2 - kk
        here := c.prim(sp, types.BoolT, typed.PrimOp.IsCase, c.read(sp, px), c.lit(sp, c.i64(), k))
        r = typed.Expr.Cond(sp, rt, typed.Cond(here, c.rawOf(sp, tb, k), r))
    }
    if c.stmts.Len() > sfrom { return typed.Expr.Seq(sp, rt, typed.Seq(gather(c.stmts, sfrom), r)) }
    return r
}

# E.From(v) (T17e): the case whose raw value v is - its position found by the prelude's caseIndex, failing with
# CaseError.NO_CASE, then the case at it
fn (c mut Checker&) enumFrom(sp source.Span, nsp source.Span, et types.TypeId, args Array<ast.Expr&>&) typed.Expr&c {
    tb := c.rawsOf(et)
    if tb.Ty == types.UnknownT {
        c.err(nsp, msgs.NoRawValues(c.ty(et), "From"))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    cn := c.P.T.CaseNames(et)
    n := cn.Len()
    for k in range n {
        if c.P.T.Items(c.P.T.Params(c.P.CaseSig(et, k))).Len() > 0 {
            c.err(nsp, msgs.FromPayload(c.ty(et), c.text(cn[k])))
            c.dropArgs(args)
            return c.unknown(sp)
        }
    }
    if args.Len() != 1 {
        c.err(sp, msgs.ArgCount(1, "", args.Len()))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    vt := typeOf(c.rawOf(sp, tb, 0))
    v := c.exprTo(args[0], vt)
    if typeOf(v) == types.UnknownT { return c.unknown(sp) }
    from := c.exprs.Len()
    for k in range n { c.exprs.Push(c.rawOf(sp, tb, k)) }
    vals := typed.Expr.Make(sp, c.P.T.Array(vt, c.P.T.Const(c.i64(), n)), typed.Make(typed.MakeKind.Array, 0
                            gather(c.exprs, from), null, c.site(typed.SiteKind.Make, sp), typed.Check.None))
    f := c.P.PreludeFn("std/prelude/enums", "caseIndex")
    i := c.invoke(sp, nsp, f, null, Array<ast.Expr&>(0), typed.Expr&[v, vals])
    if typeOf(i) == types.UnknownT { return c.unknown(sp) }
    sfrom := c.stmts.Len()
    pi := c.heldOf(sp, i)
    r typed.Expr&c = typed.Expr.Make(sp, et, typed.Make(typed.MakeKind.Case, n - 1, Array<typed.Expr&>(0), null, typed.SiteId(-1), typed.Check.None))
    for kk in range n - 1 {
        k := n - 2 - kk
        here := c.prim(sp, types.BoolT, typed.PrimOp.Eq, c.read(sp, pi), c.lit(sp, c.i64(), k))
        cs := typed.Expr.Make(sp, et, typed.Make(typed.MakeKind.Case, k, Array<typed.Expr&>(0), null, typed.SiteId(-1), typed.Check.None))
        r = typed.Expr.Cond(sp, et, typed.Cond(here, cs, r))
    }
    if c.stmts.Len() > sfrom { return typed.Expr.Seq(sp, et, typed.Seq(gather(c.stmts, sfrom), r)) }
    return r
}

# x[i]: an array's element (E16); T[a, b] where x names a type: an array literal (E19)
fn (c mut Checker&) index(sp source.Span, x ast.Expr&, items Array<ast.Expr&>&) typed.Expr&c {
    et := c.typeNamed(x)
    if et >= types.TypeId(0) { return c.arrayLit(sp, et, items) }
    # G33: an item of a list known while compiling, by a constant index
    rl := c.listOf(x)
    if rl.Ok {
        if rl.Of == types.UnknownT { return c.unknown(sp) }
        k := c.reflInt(items[0]) if items.Len() == 1 else noRefl()
        if not k.Ok {
            c.err(items[0].Span() if items.Len() > 0 else sp, msgs.ReflIndexNotConst())
            return c.unknown(sp)
        }
        dt := c.listItem(sp, rl, k.I)
        if dt == types.UnknownT { return c.unknown(sp) }
        return c.zero(sp, dt)
    }
    base := c.place(x)
    if base is null {
        for it in items { c.expr(it, types.UnknownT) }
        return c.unknown(sp)
    }
    dt := c.deref(base.Type())
    if c.arrayOf(dt) == types.UnknownT and dt != types.UnknownT {
        m := c.roleUse(dt, "At", items.Len(), c.bracketIn(sp), "'['")
        if m >= 0 { return c.invoke(sp, sp, m, c.read(sp, base), items, Array<typed.Expr&>(0)) }
        c.noIndex(sp, dt, base.Type(), items.Len())
        return c.unknown(sp)
    }
    p := c.elemPlace(sp, base, items)
    if p is null { return c.unknown(sp) }
    return c.read(sp, p)
}

fn (c mut Checker&) indexPlace(sp source.Span, x ast.Expr&, items Array<ast.Expr&>&) typed.Lvalue?&c {
    base := c.place(x)
    if base is null { return null }
    return c.elemPlace(sp, base, items)
}

# an element of the array a place holds, through references (E16)
# - unchecked for x[i] (E16), failing as written with ArrayError.OUT_OF_RANGE for x.Get(i) (E16d): chk
fn (c mut Checker&) elemPlace(sp source.Span, b typed.Lvalue&c, items Array<ast.Expr&>&, chk typed.Check = typed.Check.None) typed.Lvalue?&c {
    base := b
    t := base.Type()
    for _ in range 4 {
        if not c.isRef(t) { break }
        c.nullRead(base)
        base = typed.Lvalue.Deref(sp, c.P.T.Referent(t), c.read(sp, base))
        t = c.P.T.Referent(t)
    }
    at := c.arrayOf(t)
    if at == types.UnknownT {
        if t == types.UnknownT { return null }
        # x[i] on a type with At (E31): the element read, a value with no storage - written through, it is written
        # back by SetAt (E31b, writeBack)
        m := c.roleUse(t, "At", items.Len(), c.bracketIn(sp), "'['")
        if m < 0 {
            c.noIndex(sp, t, b.Type(), items.Len())
            return null
        }
        call := c.invoke(sp, sp, m, c.read(sp, base), items, Array<typed.Expr&>(0))
        if typeOf(call) == types.UnknownT { return null }
        site := c.site(typed.SiteKind.Temp, sp)
        c.atRecs.Push(atRec(c.fr().Body, I64(site), base, t))
        return typed.Lvalue.Temp(sp, typeOf(call), call, site)
    }
    if items.Len() != 1 {
        c.err(items[1].Span(), msgs.ArrayOneIndex(c.ty(t)))
        return null
    }
    # E16: an index of any integer type - only a literal one is made an I64; a conditional or a match of U64s is a U64
    i := c.value(c.expr(items[0], c.i64() if c.litLike(items[0]) else types.UnknownT), items[0].Span())
    if not c.isInt(typeOf(i)) and typeOf(i) != types.UnknownT {
        c.err(items[0].Span(), msgs.IndexNotInt(c.ty(typeOf(i))))
    }
    # E16: a constant index outside a fixed array's length is an error where it is written - x.Get(i) fails instead
    lt := c.P.T.Length(at)
    if chk == typed.Check.None and lt != types.TypeId(0) and c.P.T.KindOf(lt) == types.Kind.Const {
        v := c.fold(items[0])
        n := c.P.T.ConstValue(lt)
        if v.Ok and not v.IsFloat and not v.Big and (v.I < 0 or v.I >= n) { c.err(items[0].Span(), msgs.IndexOutOfRange(v.I, n)) }
    }
    return typed.Lvalue.Elem(sp, c.P.T.Elem(at), typed.Elem(base, i, chk))
}

# T[a, b]: an array literal, its length its items' count (E19)
fn (c mut Checker&) arrayLit(sp source.Span, elem types.TypeId, items Array<ast.Expr&>&) typed.Expr&c {
    elem = c.errValueType(elem)
    # T7a, T7d: arrays held by value as elements are laid out at the one known length the items give them - each item
    # typed once, then fitted to that
    if c.runArrayValue(elem) and items.Len() > 0 {
        ys := Array<typed.Expr&>(items.Len(), c.hole(sp))
        first := types.UnknownT
        ok := true
        for i in range items.Len() {
            ys[i] = c.expr(items[i], types.UnknownT)
            t := c.deref(typeOf(ys[i]))
            if typeOf(ys[i]) == types.UnknownT { return c.unknown(sp) }
            # written text: its characters' count (T7c)
            dl := c.dataLength(ys[i])
            if dl >= 0 and c.flowsInto(t, elem) { t = c.P.T.Array(c.P.T.Elem(c.under(elem)), c.P.T.Const(c.i64(), dl)) }
            if c.P.T.KindOf(t) == types.Kind.Array and c.P.T.KindOf(c.P.T.Length(t)) == types.Kind.Const and c.P.LengthsOnly(t, elem) {
                if first == types.UnknownT { first = t } else if not c.P.T.Same(first, t) { ok = false }
            } else {
                ok = false
            }
        }
        if not ok {
            c.err(sp, msgs.ArrayNestedByValue(c.ty(elem)))
            return c.unknown(sp)
        }
        from := c.exprs.Len()
        for i in range items.Len() {
            x := c.fit(ys[i], first, items[i].Span())
            c.roStore(x, items[i].Span(), RoStored)   # T25c: an element is writable storage
            c.exprs.Push(x)
        }
        return typed.Expr.Make(sp, c.P.T.Array(first, c.P.T.Const(c.i64(), items.Len())), typed.Make(typed.MakeKind.Array, 0
                               gather(c.exprs, from), null, c.site(typed.SiteKind.Make, sp), typed.Check.None))
    }
    from := c.exprs.Len()
    for it in items {
        x := c.exprTo(it, elem)
        if not c.isRef(elem) { c.roStore(x, it.Span(), RoStored) }   # T25c: an element is writable storage
        c.exprs.Push(x)
    }
    n := items.Len()
    xs := gather(c.exprs, from)
    at := c.P.T.Array(elem, c.P.T.Const(c.i64(), n))
    return typed.Expr.Make(sp, at, typed.Make(typed.MakeKind.Array, 0, xs, null, c.site(typed.SiteKind.Make, sp)
                                              typed.Check.None))
}

# ---- places ----

# where an expression names storage: a local, a global, a field, an element; a temporary given storage otherwise
fn (c mut Checker&) place(x ast.Expr&) typed.Lvalue?&c {
    # S8e: a target written is of its declared type - what a test narrowed is read, not stored
    w := c.placeWrite
    c.placeWrite = false
    match x {
        case ast.Expr.Name(sp, n) {
            ref := c.P.R.Use(c.fr().File, sp.Start)
            if ref.Kind == names.What.Local and w and c.caughtNamed(n) >= 0 {
                # R11b: a clause's name is the error it took, never assigned
                c.caughtUsed(n)
                c.err(sp, msgs.CaughtAssigned(c.tok(n), c.text(n)))
                return null
            }
            if ref.Kind == names.What.Local {
                # S8d: a target written is the local itself, never the payload a narrowing reads it as
                id := c.localNamed(n) if w and c.localNamed(n) >= 0 else c.localOrCapture(n, sp)
                if id < 0 and c.fr().Inst >= 0 { return c.instField(sp, n) }
                if id < 0 { return null }
                # S8d: a local narrowed to a payload written whole is the payload's copy, read and never written
                if id != c.localNamed(n) { return typed.Lvalue.Temp(sp, c.localType(id), c.readLocal(sp, id), c.site(typed.SiteKind.Temp, sp)) }
                if w { return typed.Lvalue.Local(sp, c.localType(id), typed.LocalId(I32(id))) }
                return c.localPlace(sp, id)
            }
            if ref.Kind == names.What.Global { return typed.Lvalue.Global(sp, c.globalType(ref.Module, n), ref.Module, n) }
        }
        case ast.Expr.Paren(_, y) { return c.place(y) }
        case ast.Expr.Member(sp, y, n) {
            ref := c.P.R.Member(c.fr().File, sp.End)
            if ref.Kind == names.What.Global { return typed.Lvalue.Global(sp, c.globalType(ref.Module, n), ref.Module, n) }
            if ref.Kind == names.What.None and c.typeNamed(y) < types.TypeId(0) {
                # S8d: a narrowed local's payload field, read - never written, being the payload's copy
                fl := c.narrowedName(y, n)
                if fl >= 0 { return typed.Lvalue.Temp(sp, c.localType(fl), c.readLocal(sp, fl), c.site(typed.SiteKind.Temp, sp)) }
                p := c.place(y)
                if p is null { return null }
                return c.field(sp, memberSpan(sp, c.text(n).Len()), p, n)
            }
        }
        case ast.Expr.Index(sp, y, items) {
            if c.typeNamed(y) < types.TypeId(0) and not c.listOf(y).Ok { return c.indexPlace(sp, y, items) }
        }
        case ast.Expr.Call(sp, f, args) {
            # G34: f.Of(v) names v's field
            match f {
                case ast.Expr.Member(msp, y, n) {
                    if c.text(n) == "Of" {
                        dt := c.descTypeOf(y)
                        if dt >= types.TypeId(0) {
                            if dt == types.UnknownT { return null }
                            return c.reflOf(sp, memberSpan(msp, 2), dt, args)
                        }
                    }
                }
                nomatch { }
            }
        }
        nomatch { }
    }
    v := c.expr(x, types.UnknownT)
    t := typeOf(v)
    if t == types.UnknownT { return null }
    p := readPlace(v)
    if p is not null { return p }
    return typed.Lvalue.Temp(x.Span(), t, v, c.site(typed.SiteKind.Temp, x.Span()))
}

# ---- try (R8-R14) ----

# try e (R8): e's fallible calls and operators handled by the clauses, a nested try's operand aside
fn (c mut Checker&) tryExpr(sp source.Span, y ast.Expr&, clauses Array<ast.Catch&>&, want types.TypeId) typed.Expr&c {
    asValue := not c.tryStmt
    c.tryStmt = false
    fr := c.fr()
    mark := fr.leaks.Len()
    before := fr.Fallible
    # E24: parentheses directly around the whole operand group nothing - a try covers all of what follows it
    match y {
        case ast.Expr.Paren(psp, _) { c.err(psp, msgs.TryParens()) }
        nomatch { }
    }
    # R11b: a caught error is raised again, never tried
    if c.caughtName(y) >= 0 {
        c.err(y.Span(), msgs.TryOnCaught(c.src(y.Span())))
        return c.unknown(sp)
    }
    asks := c.ContractAsks.Len()
    fr.Tries++
    x := c.expr(y, want)
    fr.Tries--
    # R8: what this try covers is its own - an enclosing try covers something only where this one does not
    covered := fr.Fallible != before
    fr.Fallible = before
    if not covered and typeOf(x) != types.UnknownT and not c.copiesDiffer() {
        c.nothingFails(sp)
        # the operand stands as written, so what follows from it is still judged (E31b's copy, section 8)
        return x if clauses.Len() == 0 else c.unknown(sp)
    }
    end := fr.leaks.Len()
    c.produced(clauses, mark, end)
    # T2c: a "default null" beside a reference never null gives one that may be - the try's value, its operand as it is
    rt := typeOf(x)
    if asValue and c.isRef(rt) and not c.P.T.IsNullable(rt) and nullDefault(clauses) and (want == types.UnknownT or c.P.T.IsNullable(want)) {
        rt = c.P.T.OrNull(rt)
    }
    cls Vec<typed.Clause&>
    if clauses.Len() > 0 {
        got := c.leaksBetween(mark, end)
        for cl in clauses { cls.Push(c.clause(cl, rt, asValue, got, cls)) }
    }
    if c.clauseRules(clauses, cls, asValue, rt) and asValue { return c.unknown(sp) }
    c.handlesContracts(asks, cls)
    k := c.caught(mark, end, cls)
    c.escapes(source.Span(sp.Start, sp.Start + 3), mark, k)
    return typed.Expr.Try(sp, rt, typed.Try(x, cls.ToArray(), Left = k > 0))
}

# D17e: the calls whose contracts were asked of the evaluator since ask, in the body being checked, are left to the run
# time where a clause takes ArgumentError - a call whose failure is handled fails there as written (a test of it)
fn (c mut Checker&) handlesContracts(ask I64, cls Vec<typed.Clause&>&) {
    if cls.Len() == 0 { return }
    ae := c.P.PreludeType("std/prelude/argument", "ArgumentError")
    if ae == types.UnknownT or c.left(ae, cls) == ae { return }
    for i in range ask, c.ContractAsks.Len() {
        if c.contractCallers[i] == c.fr().Body and c.ContractAsks[i].Name != "" { c.ContractHandled.Put(i, true) }
    }
}

# a try covering nothing that can fail (R8); in a generic's body what can fail differs between instances, and nothing
# is said
fn (c mut Checker&) nothingFails(sp source.Span) { c.err(source.Span(sp.Start, sp.Start + 3), msgs.TryNothingFails("try")) }

# whether the body being checked is a generic's instance, or a lambda in one (R8)
# the function instance whose body is being checked, -1 for none (a constructor's, a global's, a test's)
fn (c mut Checker&) curInst() I64 {
    # a frame with no body (fnTypeParams': a signature's rules) is in no instance - c.cur() would index Bodies at -1
    if c.frames.Len() == 0 or c.fr().Body < 0 { return -1 }
    return match c.cur().Of {
        case typed.BodyOf.Fn(inst) => inst
        case _ => -1
    }
}

fn (c mut Checker&) inGeneric() Bool { return c.fr().Ctx.Vars.Len() > 0 }

# whether what can fail, or what a call does, differs between the copies of the code being checked (R8, R14, S3): a
# generic's body, or a walk unrolled over a list known while compiling (G33), checked once per element
fn (c mut Checker&) copiesDiffer() Bool { return c.inGeneric() or c.fr().Ctx.Refl.Len() > 0 }

# x! (E35): what can fail in x ends the program - x's calls and operators handled
fn (c mut Checker&) bang(sp source.Span, y ast.Expr&, want types.TypeId) typed.Expr&c {
    fr := c.fr()
    mark := fr.leaks.Len()
    before := fr.Fallible
    fr.Tries++
    x := c.expr(y, c.P.T.OrNull(want) if c.isRef(want) else want)
    fr.Tries--
    covered := fr.Fallible != before
    fr.Fallible = before
    # T2c: on a reference that may be null, "x!" is it known not to be - after what can fail, where something can
    nullable := c.P.T.IsNullable(typeOf(x))
    if not covered and typeOf(x) != types.UnknownT and not c.copiesDiffer() {
        if nullable { return c.unwrapNull(sp, x) }
        c.err(source.Span(sp.End - 1, sp.End), msgs.BangNothingFails())
        return c.unknown(sp)
    }
    fr.leaks.Truncate(mark)
    r := typed.Expr.Try(sp, typeOf(x), typed.Try(x, Array<typed.Clause&>(0), true))
    return c.unwrapNull(sp, r) if nullable else r
}

# what "x!" (E35) on a place reads: the read after its test - for following a reference to where it was read from
fn unwrapped(x typed.Expr&) typed.Expr&x {
    match x {
        case typed.Expr.Seq(_, _, q) {
            if q.X is not null and pureRead(q.X!) { return q.X! }
        }
        nomatch { }
    }
    return x
}

# whether reading place p twice reads the same thing and runs nothing: a local, a global, a field of one, or what a
# reference read from such a place names
fn purePlace(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Local(_, _, _), typed.Lvalue.Global(_, _, _, _) => true
        case typed.Lvalue.Field(_, _, base, _) => purePlace(base)
        case typed.Lvalue.Deref(_, _, r) => pureRead(r)
        case _ => false
    }
}

fn pureRead(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Read(_, _, p, _) => purePlace(p)
        case _ => false
    }
}

# T2c, E35: a reference that may be null, as one that is not - ending the program where it is null
fn (c mut Checker&) unwrapNull(sp source.Span, x typed.Expr&c) typed.Expr&c {
    t := typeOf(x)
    # a place read with nothing to evaluate twice - a local, a global, a field through them - is tested and read where
    # it is, so what is read keeps where it lives (O20, O25a)
    match x {
        case typed.Expr.Read(rsp, _, p, site) {
            if purePlace(p) {
                pf := c.stmts.Len()
                isNull := c.prim(sp, types.BoolT, typed.PrimOp.Same, x, c.lit(sp, t, 0))
                ef := c.stmts.Len()
                c.stmts.Push(typed.Stmt.Exit(sp, typed.ExitKind.NullReached, null))
                ends := typed.Block(typed.BlockId(I32(c.fr().Block)), gather(c.stmts, ef))
                c.stmts.Push(typed.Stmt.If(sp, typed.If(isNull, ends, null)))
                return typed.Expr.Seq(sp, c.P.T.NonNull(t), typed.Seq(gather(c.stmts, pf), typed.Expr.Read(rsp, c.P.T.NonNull(t), p, site)))
            }
        }
        nomatch { }
    }
    from := c.stmts.Len()
    id := c.local(source.NameId(0), sp, t, typed.LocalKind.Var, typed.Mark.Infer)
    c.roLet(id, x)   # T25c: what is reached through it is reached from where x was read
    c.stmts.Push(typed.Stmt.Let(sp, typed.LocalId(I32(id)), x))
    isNull := c.prim(sp, types.BoolT, typed.PrimOp.Same, c.readLocal(sp, id), c.lit(sp, t, 0))
    efrom := c.stmts.Len()
    c.stmts.Push(typed.Stmt.Exit(sp, typed.ExitKind.NullReached, null))
    ends := typed.Block(typed.BlockId(I32(c.fr().Block)), gather(c.stmts, efrom))
    c.stmts.Push(typed.Stmt.If(sp, typed.If(isNull, ends, null)))
    v := c.read(sp, typed.Lvalue.Local(sp, c.P.T.NonNull(t), typed.LocalId(I32(id))))
    return typed.Expr.Seq(sp, c.P.T.NonNull(t), typed.Seq(gather(c.stmts, from), v))
}

# try x[i] = v, try x++ (R21): the store's statements under try - its SetAt, At and operator methods that fail as
# written - run as a try statement's operand, a Seq with no value
fn (c mut Checker&) tryStore(sp source.Span, st ast.Stmt&, clauses Array<ast.Catch&>&) {
    fr := c.fr()
    mark := fr.leaks.Len()
    from := c.stmts.Len()
    before := fr.Fallible
    asks := c.ContractAsks.Len()
    fr.Tries++
    c.stmt(st)
    fr.Tries--
    covered := fr.Fallible != before
    fr.Fallible = before
    if not covered and not c.copiesDiffer() { c.nothingFails(sp) }
    x mut typed.Expr&c = typed.Expr.Seq(sp, types.VoidT, typed.Seq(gather(c.stmts, from), null))
    end := fr.leaks.Len()
    c.produced(clauses, mark, end)
    cls mut Vec<typed.Clause&>&c = Vec<typed.Clause&>()
    if clauses.Len() > 0 {
        got := c.leaksBetween(mark, end)
        for cl in clauses { cls.Push(c.clause(cl, types.VoidT, false, got, cls)) }
    }
    c.clauseRules(clauses, cls, false, types.VoidT)
    c.handlesContracts(asks, cls)
    k := c.caught(mark, end, cls)
    c.escapes(source.Span(sp.Start, sp.Start + 3), mark, k)
    c.emit(typed.Stmt.Eval(sp, typed.Expr.Try(sp, types.VoidT, typed.Try(x, cls.ToArray(), Left = k > 0))))
}

fn (c mut Checker&) clause(cl ast.Catch&, t types.TypeId, value Bool, got Array<types.TypeId>&
                           earlier Vec<typed.Clause&>&) typed.Clause&c {
    items Vec<typed.Item>
    lone := c.loneBinding(cl)
    if cl.Items.Len() > 0 and not lone {
        for p in cl.Items { c.catchItem(p, items) }
    }
    all := cl.Items.Len() == 0 or lone
    # R11b: the name the clause gives the error it took, bound for its block and its defaults
    fr := c.fr()
    bind I64 = -1
    bset := types.ListId(0)
    bi := fr.errBinds.Len()
    umark := fr.undo.Len()
    if cl.Bind != source.NameId(0) or lone {
        bname := cl.Items[0].Parts[0] if lone else cl.Bind
        bsp := cl.Items[0].Sp if lone else cl.BindSp
        bset = c.takenSet(got, items, all, earlier)
        # T20: a local holding the error value, of the set the clause took - for its block and its defaults
        bind = c.local(bname, bsp, c.P.ErrValOf(c.P.T.Items(bset)), typed.LocalKind.Var, typed.Mark.None)
        fr.errBinds.Push(errBind(bname, bind, bset, bsp))
        fr.errUsed.Push(false)
    }
    code typed.Block?&c = null
    if cl.Braced {
        body := cl.Body
        # R11: in value position a block's last value is not the clause's - its default is
        n := body.Len()
        if value and (cl.Defaults.Len() == 0) and n > 0 {
            match body[n - 1] {
                case ast.Stmt.ExprS(_, x) {
                    if not stmtLike(x) {
                        c.err(x.Span(), msgs.ClauseLastValue(c.src(x.Span())))
                        body = body[:n - 1]
                    }
                }
                nomatch { }
            }
        }
        code = c.blockOf(body, typed.BlockKind.Clause, cl.Sp)
    }
    from := c.exprs.Len()
    # several results take one default each (R11): a count that differs is said by clauseRules, the defaults unread
    countOff := value and cl.Defaults.Len() > 0 and c.P.T.KindOf(t) == types.Kind.Tuple and cl.Defaults.Len() != c.P.T.Items(c.P.T.Parts(t)).Len()
    if cl.Defaults.Len() > 0 and not countOff and not (value and t == types.VoidT) {
        for i in range cl.Defaults.Len() {
            pt := t
            if c.P.T.KindOf(t) == types.Kind.Tuple and cl.Defaults.Len() > 1 {
                ps := c.P.T.Items(c.P.T.Parts(t))
                if i < ps.Len() { pt = ps[i] }
            }
            # R11: a default for a value holding references builds all it holds - nothing existing in it
            if value and not c.isRef(pt) and c.P.T.HoldsRefs(pt) and not builtAst(cl.Defaults[i]) {
                c.err(cl.Defaults[i].Span(), msgs.DefaultHoldsReferences())
            }
            c.exprs.Push(c.exprTo(cl.Defaults[i], pt))
        }
    }
    defaults := gather(c.exprs, from)
    if bind >= 0 {
        b := fr.errBinds[bi]
        if not fr.errUsed[bi] { c.err(b.Sp, msgs.CatchNameUnused(c.tok(b.Name)) if not lone else msgs.CatchLoneUnused(c.tok(b.Name), c.P.ErrorTypeHint(c.fr().Mi, c.text(b.Name)))) }
        fr.errBinds.Truncate(bi)
        fr.errUsed.Truncate(bi)
        c.unwind(umark)
    }
    return typed.Clause(cl.Sp, items.ToArray(), all, code, defaults, bind, bset)
}

# a task's default (P4a): built where the call's result lands, so one holding references builds all it holds - a part
# naming existing storage that holds a reference is said where it is written
fn (c mut Checker&) taskDefault(x ast.Expr&, t types.TypeId) typed.Expr&c {
    e := c.expr(x, t)
    if c.isRef(t) or c.P.T.HoldsRefs(t) {
        at := c.existingIn(e)
        if at.Start >= 0 {
            c.err(at, msgs.TaskDefaultExisting())
            return c.unknown(x.Span())
        }
    }
    return c.fit(e, t, c.argSpan(x))
}

# the first part of a value that names existing storage holding a reference rather than building it (P4a); Start -1
# for none
fn (c mut Checker&) existingIn(x typed.Expr?&) source.Span {
    if x is null { return source.Span(-1, -1) }
    match x {
        case typed.Expr.Read(sp, ty, _, _) {
            if c.isRef(ty) or c.P.T.HoldsRefs(ty) { return sp }
        }
        case typed.Expr.Borrow(sp, _, _) { return sp }
        case typed.Expr.Promote(_, _, pr) { return c.existingIn(pr.X) }
        case typed.Expr.Call(_, _, cl) {
            for a in cl.Args {
                e := c.existingIn(a)
                if e.Start >= 0 { return e }
            }
        }
        case typed.Expr.Make(_, _, m) {
            for a in m.Items {
                e := c.existingIn(a)
                if e.Start >= 0 { return e }
            }
        }
        case typed.Expr.Prim(_, _, op, _, args) {
            if typed.PassesRefs(op) and args.Len() > 0 { return c.existingIn(args[0]) }
        }
        nomatch { }
    }
    return source.Span(-1, -1)
}

# whether an expression builds all it holds (R11): literals, written text, calls and array literals of such, a case
fn builtAst(x ast.Expr&) Bool {
    return match x {
        case ast.Expr.Lit(_, _), ast.Expr.Join(_, _), ast.Expr.Member(_, _, _) => true
        case ast.Expr.Paren(_, y) => builtAst(y)
        case ast.Expr.Unary(_, op, y) => op == token.Tok.Minus and builtAst(y)
        case ast.Expr.Call(_, _, args), ast.Expr.ScopeCall(_, _, _, args), ast.Expr.ArrayLit(_, _, args) => allBuilt(args)
        case _ => false
    }
}

fn allBuilt(xs Array<ast.Expr&>&) Bool {
    if xs.Len() == 0 { return true }
    for x in xs {
        if not builtAst(x) { return false }
    }
    return true
}

# whether an expression may stand as a statement (S3): a call, a try of one, an increment, a take - else a value
fn stmtLike(x ast.Expr&) Bool {
    return match x {
        case ast.Expr.Call(_, _, _), ast.Expr.ScopeCall(_, _, _, _), ast.Expr.Try(_, _, _), ast.Expr.Postfix(_, _, _) => true
        case ast.Expr.Paren(_, y) => stmtLike(y)
        case ast.Expr.Unary(_, op, _) => op == token.Tok.Inc or op == token.Tok.Dec
        case _ => false
    }
}

# R11, R11a: a try's clauses in order - none after one taking every error, none whose errors an earlier one takes; as
# a statement none with a default; as a value each leaving or giving one, not both, as many as the results
fn (c mut Checker&) clauseRules(clauses Array<ast.Catch&>&, cls Vec<typed.Clause&>&, value Bool, t types.TypeId) Bool {
    if clauses.Len() == 0 { return false }
    for i in range clauses.Len() {
        cl := clauses[i]
        k := cls[i]
        if i > 0 and cls[i - 1].All {
            c.err(c.catchSpan(cl), msgs.CatchAfterCatchAll())
            return true
        }
        if i > 0 and not k.All and k.Items.Len() > 0 {
            earlier Vec<typed.Clause&>
            for j in range i { earlier.Push(cls[j]) }
            gone := true
            for it in k.Items {
                e := it.Err if it.Word < 0 or it.Word >= 64 else c.P.T.ErrWords(it.Err, U64(1) << it.Word)
                if c.left(e, earlier) != types.UnknownT { gone = false }
            }
            if gone {
                c.err(c.catchSpan(cl), msgs.CatchUnreachable())
                return true
            }
        }
        hasDef := cl.Defaults.Len() > 0
        if not value {
            if hasDef {
                c.err(c.defaultSpan(cl), msgs.DefaultInStatement())
                return true
            }
            continue
        }
        if t == types.VoidT {
            if hasDef {
                c.err(c.catchSpan(cl), msgs.DefaultNoValue())
                return true
            }
            continue
        }
        goes := k.Code is not null and leavesValue(k.Code!)
        if goes and hasDef {
            c.err(c.defaultSpan(cl), msgs.DefaultDead())
            return true
        }
        if not goes and not hasDef {
            if cl.Body.Len() > 0 and lastIsValue(cl.Body) { continue }
            c.err(c.catchSpan(cl), msgs.CatchMustLeave())
            return true
        }
        if hasDef and c.P.T.KindOf(t) == types.Kind.Tuple {
            n := c.P.T.Items(c.P.T.Parts(t)).Len()
            if cl.Defaults.Len() != n {
                c.err(c.defaultSpan(cl), msgs.DefaultCount(n, cl.Defaults.Len()))
                return true
            }
        }
    }
    return false
}

# a clause whose block ends in a value: said once (ClauseLastValue)
fn lastIsValue(body Array<ast.Stmt&>&) Bool {
    return match body[body.Len() - 1] {
        case ast.Stmt.ExprS(_, x) => not stmtLike(x)
        case _ => false
    }
}

# R9a: a value clause's block leaves - the structural rule (D10a), break and continue too
fn leavesValue(b typed.Block&) Bool {
    if leavesBlock(b) { return true }
    for s in b.Stmts {
        match s {
            case typed.Stmt.Jump(_, _, _) { return true }
            nomatch { }
        }
    }
    return false
}

# where a clause is written: its "catch"; its "default"
fn (c mut Checker&) catchSpan(cl ast.Catch&) source.Span { return source.Span(cl.Sp.Start, cl.Sp.Start + 5) }

fn (c mut Checker&) defaultSpan(cl ast.Catch&) source.Span {
    at := try c.src(cl.Sp).FindLast("default") catch default -1
    if at < 0 { return c.catchSpan(cl) }
    return source.Span(cl.Sp.Start + I32(at), cl.Sp.Start + I32(at) + 7)
}

# what of error set entry e clauses leave (R11, R1c): nothing (Unknown) where an item-less clause or an item naming its
# type takes it, else the words no item names - the type itself where that is every word
fn (c mut Checker&) left(e types.TypeId, cls Vec<typed.Clause&>&) types.TypeId {
    et := c.P.T.ErrOf(e)
    n := c.wordCount(et)
    full := U64(0) - 1 if n >= 64 else (U64(1) << n) - 1
    mask := c.P.T.ErrMask(e) & full
    for cl in cls {
        if cl.All { return types.UnknownT }
        for it in cl.Items {
            if it.Err == et {
                if it.Word < 0 { return types.UnknownT }
                if it.Word < 64 { mask = mask & ~(U64(1) << it.Word) }
            }
        }
    }
    if mask == 0 { return types.UnknownT }
    return et if mask == full else c.P.T.ErrWords(et, mask)
}

# how many words an error type declares (T19)
fn (c mut Checker&) wordCount(e types.TypeId) I64 { return c.P.ErrorWords(c.P.T.DeclOf(c.P.T.ErrOf(e))).Len() }

# what a body lets out, in order: a call's errors, what a check fails with, an error statement's word - taken by the
# clauses of the try around (caught), the rest a lambda's errors (D16b) or an inferred set (R1a), or held to the set
# written (R9)
fn (c mut Checker&) leak(es types.ListId) {
    fr := c.fr()
    for e in c.P.T.Items(es) { fr.leaks.Push(e) }
}

fn (c mut Checker&) leaks1(e types.TypeId) { c.fr().leaks.Push(e) }

# what a try's operand lets out past its clauses, held where it goes (R9, R13, S16): nowhere in a test, which fails, nor
# in a set being inferred; else the function's written set must hold each - k entries from mark. Only the outermost
# try of a nest says so: an inner one's go on to it
fn (c mut Checker&) escapes(at source.Span, mark I64, k I64) {
    fr := c.fr()
    if k == 0 { return }
    c.escapeRules(at, mark, k)
    if fr.Tries == 0 { return }
    # a try in another's operand: what it lets out leaves the body there (R13) - the outer try's clauses never see it
    keep Vec<types.TypeId>
    for i in range mark + k, fr.leaks.Len() { keep.Push(fr.leaks[i]) }
    for i in range mark, mark + k { fr.passed.Push(fr.leaks[i]) }
    fr.leaks.Truncate(mark)
    for e in keep { fr.leaks.Push(e) }
}

# what a body lets out: its leftovers and what its nested tries passed out (R1a, D16b)
fn (c mut Checker&) letOut(fr frame&) Vec<types.TypeId> {
    all Vec<types.TypeId>
    for e in fr.leaks { all.Push(e) }
    for e in fr.passed { all.Push(e) }
    return all
}

fn (c mut Checker&) escapeRules(at source.Span, mark I64, k I64) {
    fr := c.fr()
    # nothing may leave deferred code, an assert's message or a task's clause (S19b, S17, P4a)
    if fr.DeferLoops >= 0 {
        c.err(at, msgs.DeferErrorEscapes())
        return
    }
    if fr.MsgLoops >= 0 {
        c.err(at, msgs.AssertMsgError(c.msgOwner(fr.MsgOfUnreachable)))
        return
    }
    if fr.InTaskClause {
        c.err(at, msgs.TaskClauseError())
        return
    }
    if fr.InTest or fr.InferErrors { return }
    for i in range mark, mark + k {
        e := fr.leaks[i]
        if fr.Body < 0 or c.isGlobalBody(fr.Body) {
            c.err(at, msgs.TryNowhereToGo())
            return
        }
        u := c.uncovered(fr.Errors, e)
        if u != types.UnknownT {
            # another module's error as code here names it, "net.Error.UNREACHABLE" (B11)
            was := c.spellQualified
            c.spellQualified = true
            spelled := c.ty(u)
            c.spellQualified = was
            c.err(at, msgs.GenErrorNotDeclared(spelled) if c.fr().Gen else msgs.TryErrorNotDeclared(spelled))
            return
        }
    }
}

fn (c mut Checker&) isGlobalBody(id I64) Bool {
    return match c.Bodies[id].Of {
        case typed.BodyOf.Global(_, _) => true
        case _ => false
    }
}

# R14: each clause item names what the operand can fail with - an error type it can, a word it can - not in a generic's
# body (R8), where instances differ
fn (c mut Checker&) produced(clauses Array<ast.Catch&>&, mark I64, end I64) {
    if clauses.Len() == 0 or c.copiesDiffer() { return }
    fr := c.fr()
    got Vec<types.TypeId>
    for i in range mark, end { got.Push(fr.leaks[i]) }
    have := c.merged(got)
    for cl in clauses {
        if cl.Items.Len() == 0 { continue }
        for p in cl.Items {
            et := c.P.ErrorType(fr.Ctx, p)
            w I64 = -1
            if et == types.UnknownT { w, et = c.errorWord(p) }
            if et == types.UnknownT { continue }
            # T19a: a named set names what the operand can fail with where one of its entries does
            if c.P.IsErrorSet(et) {
                es Vec<types.TypeId>
                c.P.EntriesOf(et, es)
                some := false
                for e in es {
                    for h in have {
                        if e != types.UnknownT and c.P.T.ErrOf(h) == c.P.T.ErrOf(e) and (c.P.T.ErrMask(h) & c.P.T.ErrMask(e)) != 0 { some = true }
                    }
                }
                if not some { c.err(c.pathPart(p, 0), msgs.CatchNotProduced(c.ty(et))) }
                continue
            }
            entry := types.UnknownT
            for h in have {
                if c.P.T.ErrOf(h) == et { entry = h }
            }
            if entry == types.UnknownT {
                c.err(c.pathPart(p, 1 if w >= 0 else 0), msgs.CatchNotProduced(c.ty(et)))
            } else if w >= 0 and w < 64 and (c.P.T.ErrMask(entry) & (U64(1) << w)) == 0 {
                c.err(c.pathPart(p, 0), msgs.CatchWordNotProduced(c.ty(c.P.T.ErrWords(et, U64(1) << w)), c.ty(entry)))
            }
        }
    }
}

# where a dotted path's part is written: the last (back 0), the one before it (back 1)
fn (c mut Checker&) pathPart(p ast.Path&, back I64) source.Span {
    t := c.src(p.Sp)
    end := t.Len()
    for k in range back + 1 {
        start := end
        for start > 0 and t[start - 1] != '.' { start-- }
        if k == back { return source.Span(p.Sp.Start + I32(start), p.Sp.Start + I32(end)) }
        end = start - 1
        if end < 0 { return p.Sp }
    }
    return p.Sp
}

# what a try's clauses take out of what its operand let out since mark: everything for an item-less one, a whole type
# for an item naming it
fn (c mut Checker&) caught(mark I64, end I64, cls Vec<typed.Clause&>&) I64 {
    fr := c.fr()
    left I64 = 0
    keep Vec<types.TypeId>
    for i in range mark, fr.leaks.Len() {
        e := fr.leaks[i]
        # what the clauses' own code lets out (after end) is no error of the operand's
        if i >= end {
            keep.Push(e)
        } else {
            r := c.left(e, cls)
            if r != types.UnknownT {
                keep.Push(r)
                left++
            }
        }
    }
    fr.leaks.Truncate(mark)
    # the operand's leftovers first, then what the clauses' own code lets out
    for e in keep { fr.leaks.Push(e) }
    return left
}

# a catch clause's item: an error type, or one of its words (R10); a named set every entry it stands for (T19a)
fn (c mut Checker&) catchItem(p ast.Path&, items mut Vec<typed.Item>&) {
    # QAH: an error-set parameter takes every entry of the set the instance binds it to - none, for the empty set
    if p.Parts.Len() == 1 and c.fr().Ctx.Vars.Has(p.Parts[0]) {
        v := c.P.ErrorSetItem(c.fr().Ctx, p)
        if c.P.T.KindOf(v) == types.Kind.ErrSet {
            for e in c.P.T.Items(c.P.T.ErrSetItems(v)) {
                if c.P.T.KindOf(e) == types.Kind.ErrWords {
                    m := c.P.T.ErrMask(e)
                    for w in range 64 {
                        if (m & (U64(1) << w)) != 0 { items.Push(typed.Item(c.P.T.ErrOf(e), w)) }
                    }
                } else if c.P.T.KindOf(e) == types.Kind.Named {
                    items.Push(typed.Item(e, -1))
                }
            }
            return
        }
        if c.P.IsErrVar(v) { return }
    }
    et := c.P.ErrorType(c.fr().Ctx, p)
    if et != types.UnknownT {
        if not c.P.IsErrorSet(et) {
            items.Push(typed.Item(et, -1))
            return
        }
        es Vec<types.TypeId>
        c.P.EntriesOf(et, es)
        for e in es {
            if e == types.UnknownT { continue }
            if c.P.T.KindOf(e) != types.Kind.ErrWords {
                items.Push(typed.Item(e, -1))
                continue
            }
            m := c.P.T.ErrMask(e)
            for w in range 64 {
                if (m & (U64(1) << w)) != 0 { items.Push(typed.Item(c.P.T.ErrOf(e), w)) }
            }
        }
        return
    }
    w, et2 := c.errorWord(p)
    if w < 0 {
        c.P.ErrorItemKnown(c.fr().Ctx, p)
        return
    }
    items.Push(typed.Item(et2, w))
}

# a path naming an error type and one of its words: the word's position and the type; -1 for none
fn (c mut Checker&) errorWord(p ast.Path&) I64, types.TypeId {
    n := p.Parts.Len()
    if n < 2 { return -1, types.UnknownT }
    head := ast.Path(p.Sp, p.Parts[:n - 1])
    et := c.P.ErrorType(c.fr().Ctx, head)
    if et == types.UnknownT { return -1, types.UnknownT }
    w := p.Parts[n - 1]
    k := c.wordIndex(c.P.T.DeclOf(et), w)
    # M6a: an error word is public by its own first letter
    if k >= 0 and not c.text(w)[0].IsUpper() and c.P.T.DeclModule(c.P.T.DeclOf(et)) != c.fr().Mi {
        c.P.L.Diags.ErrorOncePerLine(c.at(source.Span(p.Sp.End - I32(c.text(w).Len()), p.Sp.End)), msgs.ErrorWordIsPrivate(c.tok(w)))
    }
    return k, et
}

# a word's position among an error type's (T19); -1 for none
fn (c mut Checker&) wordIndex(d types.DeclId, w source.NameId) I64 {
    ws := c.P.ErrorWords(d)
    for i in range ws.Len() {
        if ws[i] == w { return i }
    }
    return -1
}

# ---- the error a clause took (R11b, R3a) ----

# what of a try's operand lets out, from mark to end
fn (c mut Checker&) leaksBetween(mark I64, end I64) Array<types.TypeId>& {
    xs mut Vec<types.TypeId>& = Vec<types.TypeId>()
    fr := c.fr()
    for i in range mark, end { xs.Push(fr.leaks[i]) }
    return xs.ToArray()
}

# R11b: whether a clause's one bare item is the name it gives the error it took, naming no error type (names.olang
# reads it so too)
fn (c mut Checker&) loneBinding(cl ast.Catch&) Bool {
    if cl.Bind != source.NameId(0) or cl.Items.Len() != 1 or cl.Items[0].Parts.Len() != 1 { return false }
    return names.LoneCatchName(cl, c.P.R.Use(c.fr().File, cl.Items[0].Sp.Start).Kind)
}

# R11b: the set a clause takes of what its operand lets out (got) - the words its items name, everything for one with
# none, less what the clauses before it take - merged, each type one entry, in the canonical order (R1a)
fn (c mut Checker&) takenSet(got Array<types.TypeId>&, items Vec<typed.Item>&, all Bool, earlier Vec<typed.Clause&>&) types.ListId {
    es Vec<types.TypeId>
    for e in got {
        if e == types.DefaultErrT or e == types.UnknownT { continue }
        r := c.left(e, earlier)
        if r == types.UnknownT { continue }
        if all {
            es.Push(r)
            continue
        }
        et := c.P.T.ErrOf(r)
        for it in items {
            if it.Err != et { continue }
            if it.Word < 0 {
                es.Push(r)
            } else if it.Word < 64 and (c.P.T.ErrMask(r) & (U64(1) << it.Word)) != 0 {
                es.Push(c.P.T.ErrWords(et, U64(1) << it.Word))
            }
        }
    }
    return c.canonicalErrs(c.normalSet(c.merged(es)))
}

# the bits of every word an error type declares
fn (c mut Checker&) allWords(et types.TypeId) U64 {
    n := c.wordCount(et)
    return U64(0) - 1 if n >= 64 else (U64(1) << n) - 1
}

# an entry of type et holding the words of mask: the type whole where that is every word; Unknown for none
fn (c mut Checker&) entryOf(et types.TypeId, mask U64) types.TypeId {
    m := mask & c.allWords(et)
    if m == 0 { return types.UnknownT }
    return et if m == c.allWords(et) else c.P.T.ErrWords(et, m)
}

fn (c mut Checker&) normalSet(es Vec<types.TypeId>&) Vec<types.TypeId> {
    out Vec<types.TypeId>
    for e in es {
        n := c.entryOf(c.P.T.ErrOf(e), c.P.T.ErrMask(e))
        if n != types.UnknownT { out.Push(n) }
    }
    return out
}

# what two sets both hold; what a holds and b does not; what either holds
fn (c mut Checker&) setMeet(a Vec<types.TypeId>&, b Vec<types.TypeId>&) Vec<types.TypeId> {
    out Vec<types.TypeId>
    for x in a {
        for y in b {
            if c.P.T.ErrOf(x) != c.P.T.ErrOf(y) { continue }
            n := c.entryOf(c.P.T.ErrOf(x), c.P.T.ErrMask(x) & c.P.T.ErrMask(y))
            if n != types.UnknownT { out.Push(n) }
        }
    }
    return c.normalSet(c.merged(out))
}

fn (c mut Checker&) setLess(a Vec<types.TypeId>&, b Vec<types.TypeId>&) Vec<types.TypeId> {
    out Vec<types.TypeId>
    for x in a {
        m := c.P.T.ErrMask(x)
        for y in b {
            if c.P.T.ErrOf(x) == c.P.T.ErrOf(y) { m = m & ~c.P.T.ErrMask(y) }
        }
        n := c.entryOf(c.P.T.ErrOf(x), m)
        if n != types.UnknownT { out.Push(n) }
    }
    return out
}

fn (c mut Checker&) setUnion(a Vec<types.TypeId>&, b Vec<types.TypeId>&) Vec<types.TypeId> {
    all Vec<types.TypeId>
    for x in a { all.Push(x) }
    for y in b { all.Push(y) }
    return c.normalSet(c.merged(all))
}

fn (c mut Checker&) setItems(l types.ListId) Vec<types.TypeId> {
    out Vec<types.TypeId>
    for x in c.P.T.Items(l) { out.Push(x) }
    return out
}

# the set as messages write it: its entries, by commas (R1, QY)
fn (c mut Checker&) setText(es Vec<types.TypeId>&) String {
    if es.Len() == 0 { return "nothing" }
    b := StringBuilder()
    for i in range es.Len() {
        if i > 0 { b.Push(", ") }
        b.Push(c.ty(es[i]))
    }
    return b.ToString()
}

# the clause name n is, innermost first: its index in the frame's names, -1 for none
fn (c mut Checker&) caughtNamed(n source.NameId) I64 {
    fr := c.fr()
    for k := fr.errBinds.Len() - 1, k >= 0, k-- {
        if fr.errBinds[k].Name == n { return k }
    }
    return -1
}

# R11b: a name a clause gave the error it took, read - in this body or, captured, in one around it - marked used
fn (c mut Checker&) caughtUsed(n source.NameId) {
    fi := c.frames.Len() - 1
    for fi >= 0 {
        fr := c.frames[fi]
        for j := fr.errBinds.Len() - 1, j >= 0, j-- {
            if fr.errBinds[j].Name == n {
                fr.errUsed[j] = true
                return
            }
        }
        fi = fr.Parent
    }
}

# R11b: the caught error an expression names - a name, parenthesized or not - its index, -1 for none
fn (c mut Checker&) caughtName(x ast.Expr&) I64 {
    if c.frames.Len() == 0 or c.fr().errBinds.Len() == 0 { return -1 }
    match x {
        case ast.Expr.Paren(_, y) { return c.caughtName(y) }
        case ast.Expr.Name(sp, n) {
            if c.P.R.Use(c.fr().File, sp.Start).Kind != names.What.Local { return -1 }
            return c.caughtNamed(n)
        }
        nomatch { return -1 }
    }
}

# T20: the local an expression names whose value is an error - a name, parenthesized or not - NameId(0) for none
fn (c mut Checker&) errLocalName(x ast.Expr&) source.NameId {
    if c.frames.Len() == 0 { return source.NameId(0) }
    match x {
        case ast.Expr.Paren(_, y) { return c.errLocalName(y) }
        case ast.Expr.Name(sp, n) {
            if c.P.R.Use(c.fr().File, sp.Start).Kind != names.What.Local { return source.NameId(0) }
            id := c.localNamed(n)
            if id < 0 or not c.P.T.IsErrVal(c.localType(id)) { return source.NameId(0) }
            return n
        }
        nomatch { return source.NameId(0) }
    }
}

# what narrowing leaves of error local n here (R11b, T20): what the tests around say, else its type's set
fn (c mut Checker&) errNow(n source.NameId, set types.ListId) Vec<types.TypeId> {
    fr := c.fr()
    for j := fr.errNarrows.Len() - 1, j >= 0, j-- {
        if fr.errNarrows[j].Name == n and not fr.errNarrows[j].Dead { return c.setItems(fr.errNarrows[j].Now) }
    }
    return c.setItems(set)
}

# T20: a read of error local n as narrowing leaves it - recoded to what the tests around leave (R6), so the read is of
# that set: raised, rendered, matched or stored as only what it can be here
fn (c mut Checker&) errNarrowed(x typed.Expr&c, n source.NameId) typed.Expr&c {
    t := typeOf(x)
    if not c.P.T.IsErrVal(t) or c.fr().errNarrows.Len() == 0 { return x }
    now := c.errNow(n, c.P.T.ErrValItems(t))
    nt := c.P.ErrValOf(now.ToArray())
    if nt == t { return x }
    return c.prim(x.Span(), nt, typed.PrimOp.Convert, x, null)
}

# T20: an error value of type want for what of an error value x's set it holds - x recoded (R6); x itself where the
# sets are one
fn (c mut Checker&) errRecode(x typed.Expr&c, want types.TypeId) typed.Expr&c {
    if typeOf(x) == want { return x }
    return c.prim(x.Span(), want, typed.PrimOp.Convert, x, null)
}

# T20: whether error value set have holds no word set want does not
fn (c mut Checker&) errHolds(want types.TypeId, have types.TypeId) Bool {
    return c.setLess(c.setItems(c.P.T.ErrValItems(have)), c.setItems(c.P.T.ErrValItems(want))).Len() == 0
}

# T20, E10c: whether an error value is never null here - a caught error, a word written, a local a test says is not
# null (S8e)
fn (c mut Checker&) errNonNull(ax ast.Expr&, x typed.Expr&) Bool {
    match x {
        case typed.Expr.Lit(_, _, bits) { return bits != 0 }
        nomatch { }
    }
    if c.caughtName(ax) >= 0 { return true }
    n := c.errLocalName(ax)
    return n != source.NameId(0) and c.nullKnown(Array<source.NameId>(1, n))
}

# a dotted name an expression is ("os.Error.DENIED"), null for another expression
fn exprPath(x ast.Expr&) ast.Path?&x {
    ps Vec<source.NameId>
    y := x
    for {
        match y {
            case ast.Expr.Name(_, n) {
                ps.Push(n)
                break
            }
            case ast.Expr.Member(_, z, n) {
                ps.Push(n)
                y = z
            }
            nomatch { return null }
        }
    }
    ps.Reverse()
    return ast.Path(x.Span(), ps.ToArray())
}

# what an item compared with an error value stands for (R11b, T20): a word, an error type, a set's entries; false where
# it names none of these
fn (c mut Checker&) caughtItems(x ast.Expr&) Vec<types.TypeId>, Bool {
    out Vec<types.TypeId>
    p := exprPath(x)
    if p is null { return out, false }
    ctx := c.fr().Ctx
    et := c.P.ErrorType(ctx, p)
    if et != types.UnknownT {
        c.P.EntriesOf(et, out)
        return c.normalSet(c.merged(out)), true
    }
    w, wt := c.errorWord(p)
    if w < 0 or w >= 64 { return out, false }
    out.Push(c.entryOf(wt, U64(1) << w))
    return out, true
}

# T20: whether an expression is an error type or a named set written (a type test's other side), or an error word
fn (c mut Checker&) errItemPath(x ast.Expr&) Bool {
    p := exprPath(x)
    if p is null { return false }
    kind := c.P.R.Use(c.fr().File, p.Sp.Start).Kind
    if kind != names.What.Type and kind != names.What.Import { return false }
    if c.P.ErrorType(c.fr().Ctx, p) != types.UnknownT { return true }
    if p.Parts.Len() < 2 { return false }
    et := c.P.ErrorType(c.fr().Ctx, ast.Path(p.Sp, p.Parts[:p.Parts.Len() - 1]))
    if et == types.UnknownT { return false }
    # a word of it - another name after an error type is a reflected member (G32: "os.Error.Kind") or no name at all,
    # said where it is read
    return c.wordIndex(c.P.T.DeclOf(et), p.Parts[p.Parts.Len() - 1]) >= 0
}

fn (c mut Checker&) errWordPath(x ast.Expr&) Bool {
    p := exprPath(x)
    return p is not null and c.P.ErrorType(c.fr().Ctx, p) == types.UnknownT and c.errItemPath(x)
}

# T20: an error value x held once for the tests read of it: x where it is a local's read or a word, else a read of a
# hidden local given it - the statement giving it pushed on the statement stack, for seqOf to gather
fn (c mut Checker&) errHeld(x typed.Expr&c) typed.Expr&c {
    match x {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Lvalue.Local(_, _, _) { return x }
                nomatch { }
            }
        }
        case typed.Expr.Lit(_, _, _) { return x }
        nomatch { }
    }
    sp := x.Span()
    h := c.hidden(sp, typeOf(x))
    c.stmts.Push(typed.Stmt.Let(sp, typed.LocalId(I32(h)), x))
    return c.readLocal(sp, h)
}

# x, after the statements pushed since from: x alone where there are none
fn (c mut Checker&) seqOf(sp source.Span, ty types.TypeId, from I64, x typed.Expr&c) typed.Expr&c {
    if c.stmts.Len() == from { return x }
    return typed.Expr.Seq(sp, ty, typed.Seq(gather(c.stmts, from), x))
}

# whether error value code - read once, its type's set its set - holds one of xs: its code's type ordinal tested where
# xs holds the type's every word it can be, its words compared one by one otherwise
fn (c mut Checker&) errTest(sp source.Span, code typed.Expr&c, xs Vec<types.TypeId>&) typed.Expr&c {
    set := c.P.T.Items(c.P.T.ErrValItems(typeOf(code)))
    i32 := c.P.T.Prim("I32")
    got typed.Expr?&c = null
    for x in xs {
        et := c.P.T.ErrOf(x)
        j I64 = -1
        for q in range set.Len() {
            if c.P.T.ErrOf(set[q]) == et { j = q }
        }
        if j < 0 { continue }
        have := c.P.T.ErrMask(set[j]) & c.allWords(et)
        one typed.Expr?&c = null
        if (c.P.T.ErrMask(x) & have) == have {
            hi := c.prim(sp, i32, typed.PrimOp.Shr, code, c.lit(sp, i32, 16))
            one = c.prim(sp, types.BoolT, typed.PrimOp.Eq, hi, c.lit(sp, i32, j + 1))
        } else {
            m := c.P.T.ErrMask(x) & have
            for w in range 64 {
                if (m & (U64(1) << w)) == 0 { continue }
                t1 := c.prim(sp, types.BoolT, typed.PrimOp.Eq, code, c.lit(sp, typeOf(code), ((j + 1) << 16) | w))
                one = t1 if one is null else c.prim(sp, types.BoolT, typed.PrimOp.BitOr, one, t1)
            }
        }
        if one is null { continue }
        got = one if got is null else c.prim(sp, types.BoolT, typed.PrimOp.BitOr, got, one)
    }
    if got is null { return c.lit(sp, types.BoolT, 0) }
    return got
}

# R11b, T20: an error value compared with an error type, a named set or a word - "e == os.Error", "e != X.WORD" - a test
# of what it holds; null where neither operand is such an item, or both are words (two values, compared as values)
fn (c mut Checker&) errCompare(sp source.Span, op token.Tok, a ast.Expr&, b ast.Expr&) typed.Expr?&c {
    ia, ib := c.errItemPath(a), c.errItemPath(b)
    if not ia and not ib { return null }
    if ia and ib {
        if c.errWordPath(a) and c.errWordPath(b) { return null }
        c.err(sp, msgs.CaughtComparedToCaught())
        return c.lit(sp, types.BoolT, 0)
    }
    if ia { return c.errCompareItem(sp, op, b, a) }
    return c.errCompareItem(sp, op, a, b)
}

# an error value o compared with item it
fn (c mut Checker&) errCompareItem(sp source.Span, op token.Tok, o ast.Expr&, it ast.Expr&) typed.Expr&c {
    x := c.errSubjectOf(o)
    t := typeOf(x)
    if t == types.UnknownT { return c.lit(sp, types.BoolT, 0) }
    if not c.P.T.IsErrVal(t) {
        c.err(o.Span(), msgs.ErrComparedNotError(c.src(o.Span()), c.ty(t), c.src(it.Span())))
        return c.lit(sp, types.BoolT, 0)
    }
    xs, ok := c.caughtItems(it)
    if not ok { return c.lit(sp, types.BoolT, 0) }
    now := c.setItems(c.P.T.ErrValItems(t))
    if c.setMeet(now, xs).Len() == 0 {
        c.err(it.Span(), msgs.CaughtNeverIs("'" $c.src(o.Span()) "'", c.setText(xs), c.setText(now)))
        return c.lit(sp, types.BoolT, 0)
    }
    from := c.stmts.Len()
    code := c.errHeld(x)
    r := c.errTest(sp, code, xs)
    r = c.negate(sp, r) if op == token.Tok.NotEq else r
    return c.seqOf(sp, types.BoolT, from, r)
}

# the error value an expression gives: a match's subject, held once (errPin), or the expression checked
fn (c mut Checker&) errSubjectOf(o ast.Expr&) typed.Expr&c {
    fr := c.fr()
    if fr.errPinLocal >= 0 and o.Span() == fr.errPinSp { return c.readLocal(o.Span(), fr.errPinLocal) }
    return c.expr(o, types.UnknownT)
}

# T20: two error values compared - recoded to the set holding both where theirs differ (R6)
fn (c mut Checker&) errValues(sp source.Span, opSp source.Span, op token.Tok, x typed.Expr&c, y typed.Expr&c) typed.Expr&c {
    ta, tb := typeOf(x), typeOf(y)
    if op != token.Tok.EqEq and op != token.Tok.NotEq {
        c.err(opSp, msgs.ErrValueNoOp(msgs.Tok(op.Text()), c.ty(ta if c.P.T.IsErrVal(ta) else tb)))
        return c.unknown(sp)
    }
    if not c.P.T.IsErrVal(ta) or not c.P.T.IsErrVal(tb) {
        ev := x if c.P.T.IsErrVal(ta) else y
        c.err(opSp, msgs.CaughtCompareWhat("'" $c.src(ev.Span()) "'"))
        return c.lit(sp, types.BoolT, 0)
    }
    if ta != tb {
        u := c.P.ErrValOf(c.setUnion(c.setItems(c.P.T.ErrValItems(ta)), c.setItems(c.P.T.ErrValItems(tb))).ToArray())
        x = c.errRecode(x, u)
        y = c.errRecode(y, u)
    }
    return c.prim(sp, types.BoolT, typed.PrimOp.Eq if op == token.Tok.EqEq else typed.PrimOp.Ne, x, y)
}

fn (c mut Checker&) textConst(sp source.Span, t String&, tt types.TypeId) typed.Expr&c {
    bs := Array<U8>(t.Len())
    for i in range t.Len() { bs[i] = U8(t[i]) }
    return typed.Expr.Data(sp, tt, c.fr().File, typed.Const.Bytes(bs))
}

# R11b, T20: what a condition says of an error local, held for a block - where it holds (holds) or does not
fn (c mut Checker&) pushErrNarrow(x ast.Expr&, holds Bool, block I64) {
    if c.frames.Len() == 0 { return }
    n := c.caughtIn(x)
    if n == source.NameId(0) { return }
    id := c.localNamed(n)
    if id < 0 { return }
    now := c.errNow(n, c.P.T.ErrValItems(c.localType(id)))
    m := c.caughtNarrow(x, holds, n, now)
    c.fr().errNarrows.Push(errNarrow(n, c.canonicalErrs(m), block))
}

# the error local a condition first compares with an item, NameId(0) for none
fn (c mut Checker&) caughtIn(x ast.Expr&) source.NameId {
    return match x {
        case ast.Expr.Paren(_, y) => c.caughtIn(y)
        case ast.Expr.Unary(_, op, y) => c.caughtIn(y) if op == token.Tok.Not else source.NameId(0)
        case ast.Expr.Binary(_, op, a, b) => c.caughtOf(op, a, b)
        case _ => source.NameId(0)
    }
}

fn (c mut Checker&) caughtOf(op token.Tok, a ast.Expr&, b ast.Expr&) source.NameId {
    if op == token.Tok.EqEq or op == token.Tok.NotEq {
        na := c.errLocalName(a)
        if na != source.NameId(0) and c.errItemPath(b) { return na }
        nb := c.errLocalName(b)
        if nb != source.NameId(0) and c.errItemPath(a) { return nb }
        return source.NameId(0)
    }
    if op != token.Tok.And and op != token.Tok.Or { return source.NameId(0) }
    ka := c.caughtIn(a)
    return ka if ka != source.NameId(0) else c.caughtIn(b)
}

# what of now error local n can be where condition x holds (holds) or not: a comparison of n meets or leaves out what
# it names, "and", "or" and "not" combine, and anything else says nothing
fn (c mut Checker&) caughtNarrow(x ast.Expr&, holds Bool, n source.NameId, now Vec<types.TypeId>&) Vec<types.TypeId> {
    match x {
        case ast.Expr.Paren(_, y) { return c.caughtNarrow(y, holds, n, now) }
        case ast.Expr.Unary(_, op, y) {
            if op == token.Tok.Not { return c.caughtNarrow(y, not holds, n, now) }
        }
        case ast.Expr.Binary(_, op, a, b) {
            if op == token.Tok.EqEq or op == token.Tok.NotEq {
                o := a
                if c.errLocalName(a) == n {
                    o = b
                } else if c.errLocalName(b) != n {
                    return now.Clone()
                }
                xs, ok := c.caughtItems(o)
                if not ok { return now.Clone() }
                return c.setMeet(now, xs) if (op == token.Tok.EqEq) == holds else c.setLess(now, xs)
            }
            if op == token.Tok.And {
                if holds {
                    na := c.caughtNarrow(a, true, n, now)
                    return c.caughtNarrow(b, true, n, na)
                }
                return c.setUnion(c.caughtNarrow(a, false, n, now), c.caughtNarrow(b, false, n, now))
            }
            if op == token.Tok.Or {
                if not holds {
                    na := c.caughtNarrow(a, false, n, now)
                    return c.caughtNarrow(b, false, n, na)
                }
                return c.setUnion(c.caughtNarrow(a, true, n, now), c.caughtNarrow(b, true, n, now))
            }
        }
        nomatch { }
    }
    return now.Clone()
}

# R3a, T20: "error e" - an error value raised: what it can be here (its type's set, as narrowing leaves a local's) held
# to the function's written set as "error T.WORD" is, or taken on by an inferred one; a null one stops the program
fn (c mut Checker&) reraise(sp source.Span, x typed.Expr&c) {
    fr := c.fr()
    now := c.setItems(c.P.T.ErrValItems(typeOf(x)))
    if not fr.InferErrors and not fr.InTest {
        for e in now {
            et := c.P.T.ErrOf(e)
            have := types.UnknownT
            for h in c.P.T.Items(fr.Errors) {
                if c.P.T.ErrOf(h) == et { have = h }
            }
            if have == types.UnknownT {
                c.err(source.Span(sp.Start, sp.Start + 5), msgs.ReraiseUndeclared(c.ty(e)))
                break
            } else if c.uncovered(fr.Errors, e) != types.UnknownT {
                c.err(source.Span(sp.Start, sp.Start + 5), msgs.ReraiseWordNotInSet(c.ty(c.uncovered(fr.Errors, e)), c.ty(have)))
                break
            }
        }
    }
    for e in now { c.leaks1(e) }
    c.emit(typed.Stmt.Reraise(sp, x, c.P.T.ErrValItems(typeOf(x))))
}

# R11b, T20: a match on an error value, read as the if-chain it is - each case a test of what its items name (with its
# guard), "case null" its null test, "case _" and "nomatch" the else, and the last case the else where the cases cover
# everything it can be
fn (c mut Checker&) caughtMatch(sp source.Span, m ast.Match&) {
    wasPin, wasLocal := c.fr().errPinSp, c.fr().errPinLocal
    if not c.errPinned(m) { return }
    ok, covered := c.caughtCases(sp, m)
    if not ok {
        c.unpin(wasPin, wasLocal)
        return
    }
    els ast.Stmt?&m = null
    if m.NoMatch is not null { els = ast.Stmt.If(m.NoMatch!.Sp, ast.If(null, ast.Branch(m.NoMatch!.Sp, m.NoMatch!.Body, -1), null)) }
    last := c.caughtLast(m, covered)
    for i := m.Cases.Len() - 1, i >= 0, i-- {
        cs := m.Cases[i]
        if cs.Value is not null { c.err(cs.Sp, msgs.ArrowInStatement()) }
        br ast.Branch&m = ast.Branch(cs.Sp, cs.Body, -1)
        if i == last {
            els = ast.Stmt.If(cs.Sp, ast.If(null, br, null))
            continue
        }
        els = ast.Stmt.If(cs.Sp, ast.If(c.caughtCaseTest(m, cs), br, els))
    }
    if els is not null { c.stmt(els) }
    c.unpin(wasPin, wasLocal)
}

# R11b, T20: "match e" giving a value, each case "=> v": the conditional it is
fn (c mut Checker&) caughtMatchValue(sp source.Span, m ast.Match&, want types.TypeId) typed.Expr&c {
    wasPin, wasLocal := c.fr().errPinSp, c.fr().errPinLocal
    from := c.stmts.Len()
    if not c.errPinned(m) { return c.unknown(sp) }
    ok, covered := c.caughtCases(sp, m)
    if not ok {
        c.unpin(wasPin, wasLocal)
        return c.unknown(sp)
    }
    v ast.Expr?&m = null
    if m.NoMatch is not null { v = m.NoMatch!.Value }
    last := c.caughtLast(m, covered)
    for i := m.Cases.Len() - 1, i >= 0, i-- {
        cs := m.Cases[i]
        if cs.Value is null {
            c.err(cs.Sp, msgs.CaughtMatchBlock())
            c.unpin(wasPin, wasLocal)
            return c.unknown(sp)
        }
        if i == last {
            v = cs.Value
            continue
        }
        v = ast.Expr.Cond(cs.Sp, cs.Value!, c.caughtCaseTest(m, cs), v!)
    }
    if v is null {
        c.unpin(wasPin, wasLocal)
        return c.unknown(sp)
    }
    r := c.expr(v, want)
    c.unpin(wasPin, wasLocal)
    return c.seqOf(sp, typeOf(r), from, r)
}

# T20: a match's subject that is no local's name, held once in a hidden local the chain's tests read (errPin) - the
# statement holding it; false where the subject is no error value (said)
fn (c mut Checker&) errPinned(m ast.Match&) Bool {
    if c.errLocalName(m.Subject) != source.NameId(0) { return true }
    x := c.expr(m.Subject, types.UnknownT)
    t := typeOf(x)
    if t == types.UnknownT { return false }
    if not c.P.T.IsErrVal(t) {
        c.err(m.Subject.Span(), msgs.ErrMatchNotError(c.src(m.Subject.Span()), c.ty(t)))
        return false
    }
    sp := m.Subject.Span()
    h := c.hidden(sp, t)
    c.fr().errPinSp = sp
    c.fr().errPinLocal = h
    c.fr().errPinNonNull = c.errNonNull(m.Subject, x)
    c.stmts.Push(typed.Stmt.Let(sp, typed.LocalId(I32(h)), x))
    return true
}

# T20: whether a match is on an error value - its subject an error local, or a case naming an error type, a set or a
# word
fn (c mut Checker&) errMatch(m ast.Match&) Bool {
    if c.errLocalName(m.Subject) != source.NameId(0) { return true }
    for cs in m.Cases {
        for p in cs.Alts {
            match p {
                case ast.Pattern.Path(_, y), ast.Pattern.Value(_, y) {
                    if c.errItemPath(y) { return true }
                }
                nomatch { }
            }
        }
    }
    return false
}

fn (c mut Checker&) unpin(p source.Span, local I64) {
    c.fr().errPinSp = p
    c.fr().errPinLocal = local
}

# a case's test: "e == A or e == B", "e is null", and its guard
fn (c mut Checker&) caughtCaseTest(m ast.Match&, cs ast.Case&) ast.Expr&m {
    t ast.Expr?&m = null
    for p in cs.Alts {
        x ast.Expr?&m = null
        match p {
            case ast.Pattern.Path(psp, y), ast.Pattern.Value(psp, y) {
                x = ast.Expr.Is(psp, m.Subject, y, false) if isNullLit(y) else ast.Expr.Binary(psp, token.Tok.EqEq, m.Subject, y)
            }
            nomatch { }
        }
        if x is null { continue }
        t = x if t is null else ast.Expr.Binary(cs.Sp, token.Tok.Or, t, x)
    }
    if t is null { t = ast.Expr.Lit(cs.Sp, token.Tok.BoolLit) }
    if cs.Guard is not null { t = ast.Expr.Binary(cs.Sp, token.Tok.And, t!, cs.Guard!) }
    return t!
}

# which case is the chain's else (R11b): a "case _", or, with no nomatch, the last where the cases cover every error -
# -1 for none
fn (c mut Checker&) caughtLast(m ast.Match&, covered Bool) I64 {
    for i in range m.Cases.Len() {
        for p in m.Cases[i].Alts {
            match p {
                case ast.Pattern.Wild(_) { return i }
                nomatch { }
            }
        }
    }
    if m.NoMatch is not null { return -1 }
    return m.Cases.Len() - 1 if covered else -1
}

# R11b, T20: a match's cases checked before it is read as a chain - each names words, error types or sets, null, or
# "_"; with no nomatch the cases without guards cover every error the subject can be, and null where it may be null; a
# case after they have, or naming nothing it can be, is never reached. Whether it may be read (false where it is said
# why not), and whether the cases cover everything
fn (c mut Checker&) caughtCases(sp source.Span, m ast.Match&) Bool, Bool {
    fr := c.fr()
    what := "'" $c.src(m.Subject.Span()) "'"
    now Vec<types.TypeId>
    nullable := true
    n := c.errLocalName(m.Subject)
    if n != source.NameId(0) {
        now = c.errNow(n, c.P.T.ErrValItems(c.localType(c.localNamed(n))))
        nullable = c.caughtNamed(n) < 0 and not c.nullKnown(Array<source.NameId>(1, n))
        if c.caughtNamed(n) >= 0 { c.caughtUsed(n) }
    } else {
        now = c.setItems(c.P.T.ErrValItems(c.localType(fr.errPinLocal)))
        nullable = not fr.errPinNonNull
    }
    covered Vec<types.TypeId>
    nullDone := not nullable
    ok := true
    wild := false
    for i in range m.Cases.Len() {
        cs := m.Cases[i]
        if wild or (c.setLess(now, covered).Len() == 0 and nullDone) {
            c.err(cs.Sp, msgs.CaughtCaseNever(what))
            ok = false
            continue
        }
        xs Vec<types.TypeId>
        nulls := false
        for p in cs.Alts {
            match p {
                case ast.Pattern.Wild(_) {
                    wild = true
                    nulls = true
                    xs = c.setUnion(xs, now)
                }
                case ast.Pattern.Path(_, y), ast.Pattern.Value(_, y) {
                    if isNullLit(y) {
                        if not nullable {
                            c.err(p.Span(), msgs.ErrNeverNull(what))
                            ok = false
                        }
                        nulls = true
                        continue
                    }
                    ys, good := c.caughtItems(y)
                    if not good {
                        c.err(p.Span(), msgs.CaughtCaseForm())
                        ok = false
                    } else if c.setMeet(now, ys).Len() == 0 {
                        c.err(p.Span(), msgs.CaughtNeverIs(what, c.setText(ys), c.setText(now)))
                        ok = false
                    } else {
                        xs = c.setUnion(xs, ys)
                    }
                }
                nomatch {
                    c.err(p.Span(), msgs.CaughtCaseForm())
                    ok = false
                }
            }
        }
        if cs.Guard is null {
            covered = c.setUnion(covered, c.setMeet(xs, now))
            if nulls { nullDone = true }
        }
    }
    all := wild or (c.setLess(now, covered).Len() == 0 and nullDone)
    if ok and not all and m.NoMatch is null {
        left := c.setLess(now, covered)
        txt := c.setText(left) if left.Len() > 0 else "null"
        if left.Len() > 0 and not nullDone { txt = $txt " and null" }
        c.err(source.Span(sp.Start, sp.Start + 5), msgs.CaughtMatchMissing(txt))
        ok = false
    }
    return ok, all
}

# ---- statements ----

fn (c mut Checker&) emit(s typed.Stmt&c) {
    c.roKeep(s)
    c.stmts.Push(s)
}

fn (c mut Checker&) stmt(s ast.Stmt?&) {
    if s is null { return }
    match s {
        case ast.Stmt.ExprS(sp, x) { c.exprStmt(sp, x) }
        case ast.Stmt.Var(sp, v) { c.varDecl(sp, v) }
        case ast.Stmt.Multi(sp, m) { c.multi(sp, m) }
        case ast.Stmt.Assign(sp, op, target, value) { c.assign(sp, op, target, value) }
        case ast.Stmt.TryStore(sp, st, clauses) { c.tryStore(sp, st, clauses) }
        case ast.Stmt.If(sp, i) { c.ifStmt(sp, i) }
        case ast.Stmt.Forever(sp, body) { c.loop(sp, null, body, null) }
        case ast.Stmt.While(sp, k, body) { c.loop(sp, k, body, null) }
        case ast.Stmt.For3(sp, f) { c.for3(sp, f) }
        case ast.Stmt.ForIn(sp, f) { c.forIn(sp, f) }
        case ast.Stmt.DoFor(sp, body, k) { c.doFor(sp, body, k) }
        case ast.Stmt.Return(sp, values) { c.returnStmt(sp, values) }
        case ast.Stmt.Become(sp, x) { c.becomeStmt(sp, x) }
        case ast.Stmt.Yield(sp, x) { c.yieldStmt(sp, x) }
        case ast.Stmt.MatchS(sp, m) { c.matchStmt(sp, m) }
        case ast.Stmt.Jump(sp, kind, msg) { c.jump(sp, kind, msg) }
        case ast.Stmt.Assert(sp, k, _) if c.fr().Contract != 0 { c.ctCond(sp, k) }
        case ast.Stmt.Assert(sp, k, msg) {
            # G35, S18c: one reading a reflected member is decided for this instance
            rd := c.reflDecide(k)
            if rd == 1 { return }
            # decided false (rd 0): an assert of a false condition, an error only where every run reaches it (S18c)
            x := c.cond1(k) if rd < 0 else typed.Expr.Lit(k.Span(), types.BoolT, 0)
            m := c.message(msg, false)
            c.emit(typed.Stmt.Assert(sp, x, m))
            c.pushFacts(k, true, c.fr().Block)   # S8d: past it, what it says holds
            # S18c: one that reads no local is the evaluator's to decide - in a test only in a test build (B3a)
            fr := c.fr()
            if c.Tests or not fr.InTest {
                cb I64 = -1
                fixed := Vec<I64>()
                if rd < 0 {
                    c.constsRead = true
                    cb = c.CondBody(fr.Mi, k)
                    c.constsRead = false
                    for id in c.lastFixed { fixed.Push(id) }
                }
                # its message: rendered by reflection (G35), else a body the evaluator renders, else its written text
                mb I64 = -1
                said, saidOk := "", false
                written := ""
                if (cb >= 0 or rd == 0) and msg is not null {
                    said, saidOk = c.reflText(msg)
                    if not saidOk {
                        c.constsRead = true
                        mb = c.ExprBody(fr.Mi, msg, c.P.T.Ref(c.textType(), types.ReadOnly))
                        c.constsRead = false
                        for id in c.lastFixed { fixed.Push(id) }
                        written = c.src(msg.Span())
                    }
                }
                if cb >= 0 or rd == 0 {
                    cw, ct := c.P.L.Diags.TopContext()
                    # G30/G16b: the instance it is about, where its condition or its message reads one
                    if not c.readsConst(k) and rd < 0 and not (saidOk and c.reflSaid) { ct = "" }
                    c.AssertAsks.Push(AssertAsk(fr.Body, fr.File, sp, c.operatorOf(k), cb, mb, fixed.ToArray(), cw, $ct
                                                saidOk, $said, $written))
                }
            }
        }
        case ast.Stmt.Raise(sp, word) { c.raise(sp, word) }
        case ast.Stmt.Defer(sp, inner, onError) {
            # S20: pending until its block is left - an errdefer's too (S19e: the same list, its code checked alike)
            c.fr().deferBlocks.Push(c.fr().Block)
            from := c.stmts.Len()
            id, outer, mark := c.open(typed.BlockKind.ErrDefer if onError else typed.BlockKind.Defer, sp)
            # S19b: deferred code runs while its block is left - nothing may leave it
            was := c.fr().DeferLoops
            wasJ := c.fr().DeferJoins
            c.fr().DeferLoops = c.fr().loops.Len()
            c.fr().DeferJoins = c.fr().joins.Len()
            c.stmt(inner)
            c.fr().DeferLoops = was
            c.fr().DeferJoins = wasJ
            b := c.close(id, outer, mark, from)
            c.emit(typed.Stmt.Defer(sp, b))
        }
        case ast.Stmt.Block(sp, body) { c.emit(typed.Stmt.Block(sp, c.blockOf(body, typed.BlockKind.Plain, sp))) }
        case ast.Stmt.Join(sp, j) { c.joinStmt(sp, j) }
        case ast.Stmt.Spawn(sp, targets, call) { c.spawnStmt(sp, targets, call) }
        nomatch { c.gap(s.Span(), "a statement of this kind") }
    }
}

# S3: an expression standing alone is a call, "++" or "--"
fn (c mut Checker&) exprStmt(sp source.Span, x ast.Expr&) {
    match x {
        case ast.Expr.Paren(_, y) {
            c.exprStmt(sp, y)
            return
        }
        case ast.Expr.Unary(_, op, y) {
            if op == token.Tok.Inc or op == token.Tok.Dec {
                c.step(sp, y, op == token.Tok.Inc)
                return
            }
        }
        case ast.Expr.Postfix(_, op, y) {
            if op == token.Tok.Bang {
                c.emit(typed.Stmt.Eval(sp, c.expr(x, types.UnknownT)))
                return
            }
            c.step(sp, y, op == token.Tok.Inc)
            return
        }
        case ast.Expr.Call(_, _, _) {
            e := c.expr(x, types.UnknownT)
            match e {
                case typed.Expr.Prim(_, _, op, _, _) {
                    # S3: AtomicLoad reads and changes nothing - a value discarded
                    if op == typed.PrimOp.AtomicLoad {
                        c.err(c.calleeSpan(x), msgs.NotAStatement())
                        return
                    }
                }
                nomatch { }
            }
            # S3: a call giving a value it drops is judged once every body is checked - one doing nothing else is an
            # error. Not in a generic's body, where what a call does differs between instances
            t := typeOf(e)
            if t != types.VoidT and t != types.NoreturnT and t != types.UnknownT and not c.copiesDiffer() {
                c.idle.Push(idleCall(c.fr().Body, c.fr().File, x.Span(), c.src(x.Span()), e))
            }
            c.emit(typed.Stmt.Eval(sp, e))
            return
        }
        case ast.Expr.Try(_, _, _) {
            # a try statement: its clauses give no value (R11)
            c.tryStmt = true
            c.emit(typed.Stmt.Eval(sp, c.expr(x, types.UnknownT)))
            c.tryStmt = false
            return
        }
        nomatch { }
    }
    e := c.expr(x, types.UnknownT)
    if typeOf(e) == types.UnknownT { return }
    # S3, E11b: text standing alone - most often a join meant to continue from the line before
    textAlone := match x {
        case ast.Expr.Lit(_, kind) => kind == token.Tok.StrLit
        case ast.Expr.Join(_, _) => true
        case _ => false
    }
    c.err(c.notStmtSpan(x), msgs.JoinNextLine() if textAlone else msgs.NotAStatement())
}

# where S3 points: a binary's operator, a member's name, else the expression
fn (c mut Checker&) notStmtSpan(x ast.Expr&) source.Span {
    match x {
        case ast.Expr.Binary(_, op, a, b) { return c.between(a.Span(), b.Span(), op.Text().Len()) }
        case ast.Expr.Member(sp, _, n) { return memberSpan(sp, c.text(n).Len()) }
        nomatch { return x.Span() }
    }
}

# ---- join and spawn (P1, P1g, P4) ----

# join { } / try join { } catch ... (P1, P4c): a block waiting for the tasks spawned directly in it; "try join" fails with
# what they let out, its clauses taking some of it as a try statement's do
fn (c mut Checker&) joinStmt(sp source.Span, j ast.JoinS&) {
    fr := c.fr()
    targetFails := fr.TargetFails
    said0 := fr.spawnSaid
    fr.joins.Push(0)
    fr.joinMarks.Push(fr.joinErrs.Len())
    from := c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Join, sp)
    if j.Body.Len() > 0 {
        for st in j.Body { c.stmt(st) }
    }
    b := c.close(id, outer, mark, from)
    fr = c.fr()
    spawns := fr.joins[fr.joins.Len() - 1]
    em := fr.joinMarks[fr.joinMarks.Len() - 1]
    try fr.joins.Pop() catch { }
    try fr.joinMarks.Pop() catch { }
    if spawns == 0 { c.err(sp, msgs.JoinWithoutSpawn()) }
    errs Vec<types.TypeId>
    for i in range em, fr.joinErrs.Len() {
        e := fr.joinErrs[i]
        dup := false
        for x in errs {
            if x == e { dup = true }
        }
        if not dup { errs.Push(e) }
    }
    fr.joinErrs.Truncate(em)
    cls mut Vec<typed.Clause&>&c = Vec<typed.Clause&>()
    if j.Clauses.Len() > 0 and not j.Tried {
        if errs.Len() == 0 { c.err(c.catchSpan(j.Clauses[0]), msgs.JoinCatchNeedsTry()) }
    }
    if j.Tried {
        if errs.Len() == 0 and fr.spawnSaid == said0 { c.err(sp, msgs.JoinCannotFail()) }
        lm := fr.leaks.Len()
        for e in errs { fr.leaks.Push(e) }
        jend := fr.leaks.Len()
        c.produced(j.Clauses, lm, jend)
        if j.Clauses.Len() > 0 {
            got := c.leaksBetween(lm, jend)
            for cl in j.Clauses { cls.Push(c.clause(cl, types.VoidT, false, got, cls)) }
            # P4d: code after the join reads targets a failed task left unwritten - a clause taking that failure leaves
            if fr.TargetFails > targetFails {
                for i in range cls.Len() {
                    if cls[i].Code is null or not leavesValue(cls[i].Code!) {
                        c.err(c.catchSpan(j.Clauses[i]), msgs.JoinClauseMustLeave())
                        break
                    }
                }
            }
        }
        k := c.caught(lm, jend, cls)
        jat := try c.src(sp).Find("join") catch default 0
        c.escapes(source.Span(sp.Start + I32(jat), sp.Start + I32(jat) + 4), lm, k)
    } else if errs.Len() > 0 {
        c.err(sp, msgs.JoinNotTried(c.ty(errs[0])))
    }
    fr.TargetFails = targetFails
    c.emit(typed.Stmt.Join(sp, typed.Join(b, j.Tried, cls.ToArray())))
}

# spawn f(a) / spawn x, y = try f(a) catch E ... / spawn fn() { } (P1, P1g, P4, D16e): a call run as a task of the
# innermost join; what its clauses do not take reaches the join (P4b)
fn (c mut Checker&) spawnStmt(sp source.Span, targets Array<ast.Expr&>&, call ast.Expr&) {
    fr := c.fr()
    if fr.DeferLoops >= 0 and fr.joins.Len() <= fr.DeferJoins {
        c.err(sp, msgs.SpawnInDefer())
        return
    }
    if fr.joins.Len() == 0 {
        c.err(sp, msgs.SpawnOutsideJoin())
        return
    }
    fr.joins[fr.joins.Len() - 1] = fr.joins[fr.joins.Len() - 1] + 1
    # the targets' places first, left to right (P1g)
    places mut Vec<typed.Lvalue?&>&c = Vec<typed.Lvalue?&>()
    for t in targets { places.Push(c.discardOr(t)) }
    tried := false
    inner := call
    clauses Array<ast.Catch&>&call = Array<ast.Catch&>(0)
    match call {
        case ast.Expr.Try(_, y, cl) {
            tried = true
            inner = y
            clauses = cl
        }
        nomatch { }
    }
    lm := fr.leaks.Len()
    c.lastErrs = types.ListId(0)
    fr.Tries++
    task typed.Expr?&c = null
    banged := false
    match inner {
        case ast.Expr.Lambda(lsp, lf) {
            if lf.S.Params.Len() > 0 { c.err(lsp, msgs.SpawnLambdaParams()) }
            lam := c.lambda(lsp, lf, types.UnknownT)
            if typeOf(lam) != types.UnknownT {
                task = c.callBody(lsp, lsp, typeOf(lam), typed.Callee.Value(lam), -1, null, Array<ast.Expr&>(0), Array<typed.Expr&>(0))
            }
        }
        # a call given a scope argument (E25) is a call: its result built where that says, judged where the task puts it
        case ast.Expr.Call(_, _, _), ast.Expr.ScopeCall(_, _, _, _) { task = c.expr(inner, types.UnknownT) }
        case ast.Expr.Postfix(_, op, y) if op == token.Tok.Bang and callLike(y) {
            # E35: "spawn f(x)!" - its errors end the program from the task's thread (P6), none reaches the join
            banged = true
            task = c.expr(inner, types.UnknownT)
        }
        nomatch {
            c.err(inner.Span(), msgs.SpawnNotCall())
            c.expr(inner, types.UnknownT)
        }
    }
    fr = c.fr()
    fr.Tries--
    # R14: a task's clauses name what its call can fail with, as any clause does
    if tried and task is not null { c.produced(clauses, lm, fr.leaks.Len()) }
    fr.leaks.Truncate(lm)
    if task is null { return }
    if dispatched(task) {
        if targets.Len() == 0 {
            c.err(inner.Span(), msgs.AnySpawned(c.src(inner.Span())))
        } else {
            # the lambda giving what the target is set to (P1g): "spawn r = fn() I64 { return a.Peek() }()"
            rt := typeOf(task)
            res := c.ty(rt)
            if c.P.T.KindOf(rt) == types.Kind.Tuple {
                b := StringBuilder()
                for x in c.P.T.Items(c.P.T.Parts(rt)) {
                    if b.Len() > 0 { b.Push(", ") }
                    b.Push(c.ty(x))
                }
                res = b.ToString()
            }
            c.err(inner.Span(), msgs.AnySpawnedResult(c.src(source.Span(targets[0].Span().Start, call.Span().Start)), res, c.src(inner.Span())))
        }
        return
    }
    errs := c.P.T.Items(c.lastErrs)
    if banged { errs = Array<types.TypeId>(0) }
    if errs.Len() > 0 and not tried {
        c.err(inner.Span(), msgs.SpawnFallible())
        fr.spawnSaid++   # said once: its "try join" is not then said to need no try
    }
    if errs.Len() == 0 and tried { c.err(call.Span(), msgs.SpawnTryInfallible()) }
    # the clauses: what each takes, and the code it runs on the task (P4a)
    tcs mut Vec<typed.TaskClause&>&c = Vec<typed.TaskClause&>()
    taken Vec<typed.Clause&>
    if clauses.Len() > 0 {
        # T2c: a task's default goes into its target, so a target that may be null takes a null default
        crt := typeOf(task)
        if places.Len() == 1 and places[0] is not null {
            pt := places[0]!.Type()
            if c.isRef(crt) and c.isRef(pt) and c.P.T.IsNullable(pt) and c.P.T.Referent(pt) == c.P.T.Referent(crt) { crt = c.P.T.OrNull(crt) }
        }
        for cl in clauses {
            items Vec<typed.Item>
            lone := c.loneBinding(cl)
            if cl.Items.Len() > 0 and not lone {
                for p in cl.Items { c.catchItem(p, items) }
            }
            # R11b: a task's clause runs on the task's thread, a lambda of its own, and names no error yet
            if cl.Bind != source.NameId(0) or lone {
                c.err(cl.Items[0].Sp if lone else cl.BindSp, msgs.CatchNameInTask(c.tok(cl.Items[0].Parts[0] if lone else cl.Bind)))
            }
            all := cl.Items.Len() == 0 or lone
            tcs.Push(typed.TaskClause(cl.Sp, items.ToArray(), all, c.clauseHandler(cl, crt, places.Len())))
            taken.Push(typed.Clause(cl.Sp, items.ToArray(), all, null, Array<typed.Expr&>(0)))
        }
    }
    # what no clause takes reaches the join
    em := fr.joinErrs.Len()
    if tried {
        for e in errs { fr.joinErrs.Push(e) }
    }
    c.dropTaken(fr.joinErrs, em, taken)
    # P4d: a task binding targets that can fail into its join leaves them unwritten
    if places.Len() > 0 and fr.joinErrs.Len() > em { fr.TargetFails++ }
    # the targets: exactly the call's result (P1g)
    rt := typeOf(task)
    if places.Len() > 0 {
        if rt == types.VoidT {
            c.err(call.Span(), msgs.SpawnResultVoid())
        } else {
            parts := Array<types.TypeId>(1)
            parts[0] = rt
            if places.Len() > 1 and c.P.T.KindOf(rt) == types.Kind.Tuple { parts = c.P.T.Items(c.P.T.Parts(rt)) }
            if parts.Len() != places.Len() {
                c.err(sp, msgs.DestructCount(places.Len(), parts.Len()))
            } else {
                for i in range places.Len() {
                    pt := places[i]!.Type() if places[i] is not null else types.UnknownT
                    same := c.P.T.Same(pt, parts[i]) or
                            (c.isRef(pt) and c.isRef(parts[i]) and c.P.T.Same(c.deref(pt), c.deref(parts[i])))
                    if places[i] is not null and not same {
                        if c.isRef(pt) and not c.isRef(parts[i]) and c.P.T.Same(c.deref(pt), parts[i]) {
                            # the fix is the function's result, built where its result lands (study 4's r16)
                            c.err(c.operandAt(targets[i]), msgs.SpawnResultAsRef(c.ty(parts[i]), c.ty(pt), c.src(c.calleeSpan(call)), c.ty(pt)))
                        } else {
                            rec := c.err(c.operandAt(targets[i]), msgs.SpawnResultType(c.ty(parts[i]), c.ty(places[i]!.Type())))
                            match places[i] {
                                case typed.Lvalue.Local(_, _, lid) {
                                    if c.litLocals.Has(pair.Pair(c.fr().Body, I64(lid))) { c.literalLocalNote(rec, I64(lid), parts[i]) }
                                }
                                case _ { }
                            }
                        }
                    }
                }
            }
        }
    }
    c.emit(typed.Stmt.Spawn(sp, typed.Spawn(places.ToArray(), task, tcs.ToArray(), c.site(typed.SiteKind.Task, sp))))
}

# a task's clause as a lambda run on the task's thread (P4a): its block, then its default - the targets' value, a tuple
# of them for several; null for "catch E { }". Its captures are a spawned lambda's (D16c, D16e)
fn (c mut Checker&) clauseHandler(cl ast.Catch&, rt types.TypeId, nt I64) typed.Expr?&c {
    hasBody := cl.Braced and cl.Body.Len() > 0
    hasDef := cl.Defaults.Len() > 0
    if not hasBody and not hasDef and nt == 0 { return null }
    if hasDef and nt == 0 {
        c.err(c.defaultSpan(cl), msgs.TaskDefaultInStatement())
        return null
    }
    result := rt if nt > 0 else types.VoidT
    ty := c.P.T.Func(types.ListId(0), result, types.ListId(0))
    parent := c.fr()
    pfi := c.frames.Len() - 1
    id := c.newBody(typed.BodyOf.Lambda(typed.BodyId(I32(parent.Body))), ty, parent.Mi, cl.Sp)
    c.state[id] = 1
    fr := c.push(id, parent.Mi, result, types.ListId(0))
    fr.Ctx = parent.Ctx
    fr.Parent = pfi
    fr.InTaskClause = true
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, cl.Sp)
    c.cur().SetVars(c.P.ScopeVarsOf(ty))
    from := c.stmts.Len()
    if hasBody {
        for st in cl.Body { c.stmt(st) }
    }
    if hasDef {
        if nt == 1 or cl.Defaults.Len() == 1 {
            c.emit(typed.Stmt.Return(cl.Sp, c.taskDefault(cl.Defaults[0], rt)))
        } else {
            parts := c.P.T.Items(c.P.T.Parts(rt)) if c.P.T.KindOf(rt) == types.Kind.Tuple else Array<types.TypeId>(0)
            if parts.Len() != cl.Defaults.Len() {
                c.err(cl.Sp, msgs.DestructCount(parts.Len(), cl.Defaults.Len()))
            } else {
                xf := c.exprs.Len()
                for i in range parts.Len() { c.exprs.Push(c.taskDefault(cl.Defaults[i], parts[i])) }
                xs := gather(c.exprs, xf)
                c.emit(typed.Stmt.Return(cl.Sp, typed.Expr.Make(cl.Sp, rt, typed.Make(typed.MakeKind.Tuple, 0, xs, null
                                                                                      typed.SiteId(-1), typed.Check.None))))
            }
        }
    }
    root := typed.Block(typed.BlockId(0), gather(c.stmts, from))
    c.cur().Root = root
    if nt > 0 and not hasDef and not c.fr().Gapped and not leavesBlock(root) { c.err(cl.Sp, msgs.TaskClauseNeedsDefault()) }
    caps := c.fr().captures.ToArray()
    c.pop()
    c.state[id] = 2
    return typed.Expr.Fn(cl.Sp, ty, typed.FnVal.Lambda(typed.BodyId(I32(id)), caps, c.site(typed.SiteKind.Closure, cl.Sp)))
}

# what the clauses take out of errs from mark on: everything for an item-less one, a whole type for an item naming it or
# items naming each of its words (R14)
fn (c mut Checker&) dropTaken(errs mut Vec<types.TypeId>&, mark I64, cls Vec<typed.Clause&>&) {
    keep Vec<types.TypeId>
    for i in range mark, errs.Len() {
        e := errs[i]
        r := c.left(e, cls)
        if r != types.UnknownT { keep.Push(r) }
    }
    errs.Truncate(mark)
    for e in keep { errs.Push(e) }
}

# x++ / x--: x = x + 1, the place evaluated once (S5)
fn (c mut Checker&) step(sp source.Span, y ast.Expr&, inc Bool) {
    p := c.place(y)
    if p is null { return }
    if c.writeBack(sp, token.Tok.PlusEq if inc else token.Tok.MinusEq, p, null, c.opAfter(y.Span(), 2)) { return }
    c.notCapture(p, y.Span())
    t := p.Type()
    if not c.isNumber(t) or (c.isNamed(t) and not c.P.Extends(t)) {
        if t != types.UnknownT and not c.stepMethod(sp, p, t, inc) { c.err(c.opAfter(y.Span(), 2), msgs.StepNotNumber(c.ty(t))) }
        return
    }
    old := c.read(sp, typed.Lvalue.Target(sp, t))
    one := c.lit(sp, t, floatBits(c.under(t), 1.0) if c.P.T.IsFloat(c.under(t)) else 1)
    op := typed.PrimOp.Add if inc else typed.PrimOp.Sub
    from := c.exprs.Len()
    c.exprs.Push(old)
    c.exprs.Push(one)
    c.emit(typed.Stmt.Assign(sp, p, typed.Expr.Prim(sp, t, op, typed.Check.None, gather(c.exprs, from))))
}

# x++ on a declared type (E31, S3a): its Inc (Dec), or where it declares none x = x + 1 through its Plus (Minus);
# false where it has neither
fn (c mut Checker&) stepMethod(sp source.Span, p typed.Lvalue&c, t types.TypeId, inc Bool) Bool {
    if not c.isNamed(t) { return false }
    # x = x.Inc() (E31)
    m := c.roleMethod(t, "Inc" if inc else "Dec", 0)
    if m >= 0 {
        v := c.invoke(sp, sp, m, c.read(sp, typed.Lvalue.Target(sp, t)), Array<ast.Expr&>(0), Array<typed.Expr&>(0))
        c.emit(typed.Stmt.Assign(sp, p, c.fit(v, t, sp)))
        return true
    }
    pm := c.roleMethod(t, "Plus" if inc else "Minus", 1)
    if pm < 0 {
        # E31: an Inc shaped otherwise is an ordinary method, and "++" has none
        return c.notOperator(t, "Inc" if inc else "Dec", sp, "'++'" if inc else "'--'", 0, false)
    }
    pt := c.deref(c.P.T.Items(c.P.T.Params(c.P.Sig(pm)))[1])
    if not c.isNumber(pt) { return false }
    one := c.lit(sp, pt, floatBits(c.under(pt), 1.0) if c.P.T.IsFloat(c.under(pt)) else 1)
    v := c.invoke(sp, sp, pm, c.read(sp, typed.Lvalue.Target(sp, t)), Array<ast.Expr&>(0), c.one(one))
    c.emit(typed.Stmt.Assign(sp, p, c.fit(v, t, sp)))
    return true
}

# x T = v, x := v, x T (D12, D13c, D15): one local per name
fn (c mut Checker&) varDecl(sp source.Span, v ast.VarDecl&) {
    if v.Field and v.Ty is null and v.Values.Len() == 0 and not v.Infer {
        # a pun (C4): the field takes its parameter
        for i in range v.Names.Len() {
            pid := c.localNamed(v.Names[i])
            if pid < 0 {
                c.gap(v.NameSps[i], "a pun naming no parameter (C4)")
                continue
            }
            nsp := v.NameSps[i]
            # T7a: a parameter a type variable bound to a run-time array (G18) - held by reference in an instance
            said := try c.byValSaid.Get(pair.Pair(c.fr().File, I64(c.cur().Locals[pid].Sp.Start))) catch default false
            if c.runArrayValue(c.localType(pid)) and not said { c.err(nsp, msgs.ArrayNestedByValue(c.ty(c.localType(pid)))) }
            id := c.local(source.NameId(0), nsp, c.localType(pid), typed.LocalKind.Field, c.cur().Locals[pid].Marked)
            c.roNeed(typed.Lvalue.Local(nsp, c.localType(pid), typed.LocalId(I32(pid))))   # T25c: the instance keeps it
            c.emit(typed.Stmt.Let(nsp, typed.LocalId(I32(id)), c.readLocal(nsp, pid)))
            c.cur().Fields.Push(typed.LocalId(I32(id)))
        }
        return
    }
    if v.Values.Len() != 0 and v.Values.Len() != v.Names.Len() {
        c.gap(sp, "a declaration of several names from one value (D8c)")
        return
    }
    declared := types.UnknownT
    mark := typed.Mark.Infer
    if v.Ty is not null {
        # T7d: an array of arrays held by value takes its elements' length from the value it is given (checked below)
        c.declMade = v.Values.Len() > 0 and not v.Infer and not refWrittenTop(v.Ty!)
        declared = c.resolve(v.Ty)
        c.declMade = false
        mark = c.markOf(v.Ty)
        # D11a, C3: "mut" says what a reference reaches - a local and a field are writable themselves
        if v.Infer and not v.Field {
            msp := c.mutBefore(v.Ty!, types.UnknownT)
            if msp.Start >= 0 { c.err(msp, msgs.MutOnInferredLocal()) }
        } else if not v.Infer {
            msp := c.mutBefore(v.Ty!, declared)
            if msp.Start >= 0 { c.err(msp, msgs.MutOnValueField(c.ty(declared)) if v.Field else msgs.MutOnLocal(c.ty(declared))) }
        }
    }
    kind := typed.LocalKind.Field if v.Field else typed.LocalKind.Var
    for i in range v.Names.Len() {
        nsp := v.NameSps[i]
        if v.Field {
            # C2a: a field named like a parameter is a pun, written bare
            pid := c.localNamed(v.Names[i])
            if pid >= 0 and c.cur().Locals[pid].Kind == typed.LocalKind.Param {
                rec := c.err(nsp, msgs.FieldHasParamName(c.tok(v.Names[i])))
                c.P.L.Diags.Note(rec, c.at(c.cur().Locals[pid].Sp), msgs.NoteDeclaredHere(c.tok(v.Names[i])))
            }
        }
        t := declared
        x typed.Expr?&c = null
        pend := unsetCand(-1, -1, -1, false, -1, nsp, types.UnknownT, false)
        # T7d: a field's storage is its type's (C2e: held in the instance where its declaration gives it a length); a
        # local's fixed where its initializer's length is known and nothing assigns it as a whole afterwards
        keep := not c.fr().stored.Has(v.Names[i])
        want := declared
        if v.Field {
            keep = true
            ft := c.fieldTypeAt(c.cur().Fields.Len())
            if c.P.T.KindOf(ft) == types.Kind.Array and c.P.T.Length(ft) != types.TypeId(0) {
                want = ft
                t = ft
            }
        } else if keep and v.Ty is not null and not v.Infer and i < v.Values.Len() {
            want = c.P.StorageOf(c.fr().Ctx, declared, v.Values[i])
            t = want
        }
        if keep and i < v.Values.Len() and not v.Field and v.Ty is not null and not v.Infer and c.P.T.KindOf(want) == types.Kind.Array and c.runArrayValue(c.P.T.Elem(want)) {
            # T7d: an array of arrays held by value takes its elements' length from its value - typed alone first
            x = c.expr(v.Values[i], types.UnknownT)
            if c.P.LengthsOnly(typeOf(x), want) and c.P.T.KindOf(typeOf(x)) == types.Kind.Array { t = typeOf(x) } else { x = c.fit(x!, want, v.Values[i].Span()) }
        } else if i < v.Values.Len() {
            wasNull := c.nullDecl
            if v.Ty is not null and not v.Infer { c.nullDecl = c.typeWrittenAt(v.Ty!) }
            # D14d: Array<T>(n) whose every element the counted loop after it writes before any read - no clear
            filled := not v.Field and v.Names.Len() == 1 and c.filledNext(v.Names[i], v.Values[i])
            c.noClear = filled
            x = c.exprTo(v.Values[i], want)
            c.noClear = false
            c.nullDecl = wasNull
            if v.Ty is null or v.Infer {
                t = c.inferred(v.Values[i], x!, keep)
                if v.Field and v.Ty is not null {
                    # C3: a ":=" field's "mut" says what its inferred reference permits
                    msp := c.mutBefore(v.Ty!, t)
                    if msp.Start >= 0 { c.err(msp, msgs.MutOnValueField(c.ty(t))) }
                }
                if c.P.T.KindOf(c.deref(t)) == types.Kind.Array and not c.P.T.Same(t, typeOf(x)) { x = c.fit(x!, t, v.Values[i].Span()) }
            }
        } else {
            # D13c, D13d: its zero value, held back - said only if a path reads it before assigning it (settleUnset)
            wasNull := c.nullDecl
            c.nullDecl = c.typeWrittenAt(v.Ty!)
            dg := c.P.L.Diags
            g := dg.Hold()
            zmark := dg.Count()
            x = c.zero(nsp, t)
            dg.EndHold()
            noZero := dg.Count() > zmark
            if noZero { x = c.lit(nsp, t, 0) }   # never lowered: an error is said unless every path assigns first
            c.nullDecl = wasNull
            ask := c.ValueAsks.Len()
            c.askValue(ValueKind.Zero, nsp, t, null)
            if c.ValueAsks.Len() == ask { ask = -1 }
            pend = unsetCand(c.fr().Body, -1, g, noZero, ask, nsp, t, v.Field)
        }
        if t == c.textType() and c.isRef(typeOf(x)) { x = c.read(nsp, typed.Lvalue.Deref(nsp, t, x!)) }
        # T7a: a field holding a run-time array by value - held by reference instead
        if v.Field and c.runArrayValue(t) { c.err(nsp, msgs.ArrayNestedByValue(c.ty(t))) }
        # T7a, T7d: an array of arrays held by value whose value gave its elements no one known length
        if v.Ty is not null and not v.Infer and i < v.Values.Len() and c.P.T.KindOf(t) == types.Kind.Array and c.runArrayValue(c.P.T.Elem(t)) {
            c.err(v.Ty!.Span(), msgs.ArrayNestedByValue(c.ty(c.P.T.Elem(t))))
        }
        # T25c: ":=" of a read-only copy is one, and a reference read out of one is read-only; a written type declares
        # a writable value
        inferred := i < v.Values.Len() and (v.Ty is null or v.Infer)
        if inferred and c.isRef(t) and (c.P.T.PermOf(t) & types.Writable) != 0 and c.P.T.KindOf(c.deref(t)) != types.Kind.Func and c.roRef(x) {
            t = c.P.T.Ref(c.P.T.Referent(t), c.P.T.PermOf(t) & types.Owning)
        }
        if i < v.Values.Len() and not inferred and not c.isRef(t) { c.roStore(x, v.Values[i].Span(), RoDecl) }
        id := c.local(v.Names[i], nsp, t, kind, mark)
        # D14d: a fixed array so filled is not written before the loop (its value is never seen)
        if i < v.Values.Len() and not v.Field and v.Names.Len() == 1 and c.P.T.KindOf(c.P.T.Repr(t)) == types.Kind.Array and
           c.P.T.Length(c.P.T.Repr(t)) != types.TypeId(0) and c.noClearMade(x) { c.cur().Locals[id].Unset = true }
        if pend.Group >= 0 { c.unsets.Push(unsetCand(pend.Body, id, pend.Group, pend.NoZero, pend.ValueAt, pend.Sp, pend.Ty, pend.Field)) }
        if v.Ty is not null and not v.Infer { c.fr().typeAt.Put(id, c.typeWrittenAt(v.Ty!)) }
        if inferred { c.roLet(id, x!) }
        # T6a: a number its literal's own type declares, for the note where it does not flow (B11)
        if inferred and not v.Field and c.isNumber(t) and c.litLike(v.Values[i]) { c.litLocals.Put(pair.Pair(c.fr().Body, id), true) }
        # S8c: a plain scalar with a value of its own may be fixed - if its body never writes it
        if not v.Field and i < v.Values.Len() and c.plainScalar(t) { c.fixedInits.Put(pair.Pair(c.fr().Body, id), fixedInit(v.Values[i], t)) }
        c.emit(typed.Stmt.Let(nsp, typed.LocalId(I32(id)), x!))
        if v.Field { c.cur().Fields.Push(typed.LocalId(I32(id))) }
    }
}

# x[i] = v on a declared type: x.SetAt(i, v) (E31); false where x is an array, or the target no index
fn (c mut Checker&) assignAt(sp source.Span, op token.Tok, target ast.Expr&, value ast.Expr&) Bool {
    match target {
        case ast.Expr.Index(isp, x, items) {
            if c.typeNamed(x) >= types.TypeId(0) { return false }
            base := c.place(x)
            if base is null { return false }
            dt := c.deref(base.Type())
            if dt == types.UnknownT or c.arrayOf(dt) != types.UnknownT { return false }
            # a compound one reads the element through At and writes it back (writeBack)
            if op != token.Tok.Assign { return false }
            m := c.roleMethod(dt, "SetAt", items.Len() + 1)
            if m < 0 {
                osp := c.opAfter(target.Span(), 1)
                if not c.notOperator(dt, "SetAt", osp, "'x[i] = v'", 2, true) { c.err(osp, msgs.SetatUndeclared(c.ty(base.Type()))) }
                return true
            }
            # x[i] read through At (E31b): this SetAt on the copy, then x[i] written back
            if c.valueTemp(base) >= 0 { return c.writeBack(sp, op, base, value, c.opAfter(target.Span(), 1), m, items) }
            all mut Vec<ast.Expr&>&c = Vec<ast.Expr&>()
            for it in items { all.Push(it) }
            all.Push(value)
            c.emit(typed.Stmt.Eval(sp, c.invoke(sp, isp, m, c.read(isp, base), all.ToArray(), Array<typed.Expr&>(0))))
            return true
        }
        nomatch { return false }
    }
}

# t1, t2 := v / t1, t2 = v (D8c): several results destructured, each target given its own; a, b = b, a (S4c): every
# value evaluated before any target is written
fn (c mut Checker&) multi(sp source.Span, m ast.Multi&) {
    n := m.Targets.Len()
    if m.Values.Len() == 1 and n > 1 {
        v := c.expr(m.Values[0], types.UnknownT)
        t := typeOf(v)
        if t == types.UnknownT {
            for x in m.Targets { c.declareUnknown(x, m.Define) }
            return
        }
        if c.P.T.KindOf(t) != types.Kind.Tuple {
            c.err(m.Values[0].Span(), msgs.DestructOneValue(c.ty(t)))
            for x in m.Targets { c.declareUnknown(x, m.Define) }
            return
        }
        parts := c.P.T.Items(c.P.T.Parts(t))
        if parts.Len() != n {
            c.err(sp, msgs.DestructCount(n, parts.Len()))
            for x in m.Targets { c.declareUnknown(x, m.Define) }
            return
        }
        h := c.local(source.NameId(0), sp, t, typed.LocalKind.Held, typed.Mark.None)
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(h)), v))
        for i in range n {
            tsp := m.Targets[i].Span()
            part := c.read(tsp, typed.Lvalue.Field(tsp, parts[i], typed.Lvalue.Local(tsp, t, typed.LocalId(I32(h))), i))
            c.putTarget(m.Targets[i], m.Define, part, parts[i])
        }
        return
    }
    if m.Values.Len() != n {
        c.err(c.opAfter(m.Targets[n - 1].Span(), 2 if m.Define else 1), msgs.AssignListCount(n, m.Values.Len()))
        for x in m.Values { c.expr(x, types.UnknownT) }
        return
    }
    if m.Define {
        for i in range n {
            v := c.expr(m.Values[i], types.UnknownT)
            t := c.inferred(m.Values[i], v, not c.storedName(m.Targets[i]))
            # T29c: text written in the program declares a String value, as "x := text" does
            vsp := m.Values[i].Span()
            if t == c.textType() and c.isRef(typeOf(v)) { v = c.read(vsp, typed.Lvalue.Deref(vsp, t, v)) }
            c.putTarget(m.Targets[i], true, v, t)
        }
        return
    }
    # S4c: the targets' places, then every value held, then the stores
    held Vec<I64>
    places mut Vec<typed.Lvalue?&>&c = Vec<typed.Lvalue?&>()
    for i in range n { places.Push(c.discardOr(m.Targets[i])) }
    # S4d: a borrow in any value of any target's storage takes its old value
    s4d := c.s4d.Len()
    for pl in places {
        if pl is not null and not c.isRef(pl.Type()) and c.P.T.HoldsRefs(pl.Type()) { c.s4d.Push(pl) }
    }
    for i in range n {
        want := places[i]!.Type() if places[i] is not null else types.UnknownT
        v := c.exprTo(m.Values[i], want)
        h := c.local(source.NameId(0), m.Values[i].Span(), typeOf(v), typed.LocalKind.Held, typed.Mark.None)
        c.emit(typed.Stmt.Let(m.Values[i].Span(), typed.LocalId(I32(h)), v))
        held.Push(h)
    }
    c.s4d.Truncate(s4d)
    for i in range n {
        if places[i] is not null { c.emit(typed.Stmt.Assign(sp, places[i]!, c.readLocal(sp, held[i]))) }
    }
}

# a target's place, null for "_"
fn (c mut Checker&) discardOr(x ast.Expr&) typed.Lvalue?&c {
    match x {
        case ast.Expr.Name(_, n) {
            if c.text(n) == "_" { return null }
        }
        nomatch { }
    }
    c.placeWrite = true
    p := c.place(x)
    if p is not null { c.notCapture(p, x.Span()) }
    return p
}

# a destructured part given to its target: a new local (":="), a place ("="), or nothing ("_")
fn (c mut Checker&) putTarget(x ast.Expr&, define Bool, v typed.Expr&c, t types.TypeId) {
    sp := x.Span()
    if define {
        match x {
            case ast.Expr.Name(nsp, n) {
                if c.text(n) == "_" { return }
                # T7d: a local assigned as a whole afterwards holds its length at run time
                if c.fr().stored.Has(n) and c.runLength(t) != t { t = c.runLength(t) }
                if c.P.T.KindOf(c.deref(t)) == types.Kind.Array and not c.P.T.Same(t, typeOf(v)) { v = c.fit(v, t, nsp) }
                id := c.local(n, nsp, t, typed.LocalKind.Var, typed.Mark.Infer)
                c.emit(typed.Stmt.Let(nsp, typed.LocalId(I32(id)), v))
            }
            nomatch { c.err(sp, msgs.DestructNotName()) }
        }
        return
    }
    p := c.discardOr(x)
    if p is null { return }
    c.emit(typed.Stmt.Assign(sp, p, c.fit(v, p.Type(), sp)))
}

# the type of field k of the type a constructor makes (UnknownT outside a constructor, or where it is not known yet)
fn (c mut Checker&) fieldTypeAt(k I64) types.TypeId {
    t := c.fr().CtorOf
    if t == types.UnknownT or not c.isStruct(t) { return types.UnknownT }
    fs := c.P.T.Items(c.P.T.Fields(t))
    return fs[k] if k < fs.Len() else types.UnknownT
}

# whether a target names a local its body assigns as a whole after declaring it (T7d)
fn (c mut Checker&) storedName(x ast.Expr&) Bool {
    match x {
        case ast.Expr.Name(_, n) { return c.fr().stored.Has(n) }
        nomatch { return true }
    }
}

# a target of a destructuring that failed, declared as of no known type so its uses say nothing more
fn (c mut Checker&) declareUnknown(x ast.Expr&, define Bool) {
    if not define { return }
    match x {
        case ast.Expr.Name(nsp, n) {
            if c.text(n) != "_" {
                id := c.local(n, nsp, types.UnknownT, typed.LocalKind.Var, typed.Mark.Infer)
                c.emit(typed.Stmt.Let(nsp, typed.LocalId(I32(id)), c.unknown(nsp)))
            }
        }
        nomatch { }
    }
}

fn compoundOp(op token.Tok) token.Tok {
    return match op {
        case token.Tok.PlusEq => token.Tok.Plus
        case token.Tok.MinusEq => token.Tok.Minus
        case token.Tok.StarEq => token.Tok.Star
        case token.Tok.SlashEq => token.Tok.Slash
        case token.Tok.PercentEq => token.Tok.Percent
        case token.Tok.ShlEq => token.Tok.Shl
        case token.Tok.ShrEq => token.Tok.Shr
        case token.Tok.AmpEq => token.Tok.Amp
        case token.Tok.PipeEq => token.Tok.Pipe
        case token.Tok.CaretEq => token.Tok.Caret
        case _ => token.Tok.Eof
    }
}

# S4d: whether place q is place p or storage within it - a field, payload or element (any element standing for any other)
# reached with no reference followed
fn (c mut Checker&) within(q typed.Lvalue&, p typed.Lvalue&) Bool {
    if c.samePlace(q, p) { return true }
    return match q {
        case typed.Lvalue.Field(_, _, b, _) => c.within(b, p)
        case typed.Lvalue.Elem(_, _, e) => c.within(e.Base, p)
        case typed.Lvalue.Payload(_, _, py) => c.within(py.Base, p)
        case _ => false
    }
}

fn (c mut Checker&) samePlace(a typed.Lvalue&, b typed.Lvalue&) Bool {
    match a {
        case typed.Lvalue.Local(_, _, x) {
            match b {
                case typed.Lvalue.Local(_, _, y) { return x == y }
                nomatch { return false }
            }
        }
        case typed.Lvalue.Global(_, _, m, n) {
            match b {
                case typed.Lvalue.Global(_, _, m2, n2) { return m == m2 and n == n2 }
                nomatch { return false }
            }
        }
        case typed.Lvalue.Field(_, _, ab, ai) {
            match b {
                case typed.Lvalue.Field(_, _, bb, bi) { return ai == bi and c.samePlace(ab, bb) }
                nomatch { return false }
            }
        }
        case typed.Lvalue.Elem(_, _, ae) {
            match b {
                case typed.Lvalue.Elem(_, _, be) { return c.samePlace(ae.Base, be.Base) }
                nomatch { return false }
            }
        }
        case typed.Lvalue.Payload(_, _, ap) {
            match b {
                case typed.Lvalue.Payload(_, _, bp) { return ap.Tag == bp.Tag and c.samePlace(ap.Base, bp.Base) }
                nomatch { return false }
            }
        }
        case typed.Lvalue.Deref(_, _, ar) {
            # what one reference names, read from the same place - the names written, never where references lead
            match b {
                case typed.Lvalue.Deref(_, _, br) {
                    pa := readPlace(ar)
                    pb := readPlace(br)
                    return pa is not null and pb is not null and c.samePlace(pa, pb)
                }
                nomatch { return false }
            }
        }
        nomatch { return false }
    }
}

# x = v, x op= v (S4): the target's place, then the value, then the store; a compound one reads the old value through
# Lvalue.Target
# a value stored into a place (S4): it fits the place's type, said at osp; target is what was written as the place, where
# one was (a narrowed reference's path is known not null after it)
fn (c mut Checker&) storeInto(sp source.Span, p typed.Lvalue&c, value ast.Expr&, osp source.Span, target ast.Expr?&) {
    t := p.Type()
    # E12: the value fits the target, said at the "=" as stage 0 says it - a borrow in it of the place itself, or of
    # storage within it, its old value where the value can hold a reference (S4d)
    s4d := c.s4d.Len()
    if not c.isRef(t) and c.P.T.HoldsRefs(t) { c.s4d.Push(p) }
    x := c.expr(value, t)
    vt := typeOf(x)
    if target is not null and c.P.T.IsNullable(t) and vt != types.UnknownT and vt != types.NullT and not c.P.T.IsNullable(vt) {
        c.fr().nonNullSet = pathOf(target)
    }
    wasNull := c.nullDecl
    c.nullDecl = c.placeAt(p)
    if t != types.UnknownT { x = c.fit(x, t, osp) }
    c.nullDecl = wasNull
    c.s4d.Truncate(s4d)
    if t == c.textType() and c.isRef(typeOf(x)) { x = c.read(sp, typed.Lvalue.Deref(sp, t, x)) }
    # T25c: a read-only copy is not stored where it can be written - save into a read-only copy itself
    if not c.isRef(t) and c.roRoot(p) < 0 { c.roStore(x, value.Span(), RoStored) }
    c.emit(typed.Stmt.Assign(sp, p, x))
}

fn (c mut Checker&) assign(sp source.Span, op token.Tok, target ast.Expr&, value ast.Expr&) {
    if c.assignAt(sp, op, target, value) { return }
    osp0 := c.opAfter(target.Span(), 1 if op == token.Tok.Assign else 2)
    ca := c.compoundAt
    if op != token.Tok.Assign { c.compoundAt = osp0 }
    c.placeWrite = op == token.Tok.Assign
    p := c.place(target)
    c.compoundAt = ca
    if p is null {
        c.expr(value, types.UnknownT)
        return
    }
    match p {
        case typed.Lvalue.Temp(_, _, tv, _) {
            match tv {
                case typed.Expr.Prim(_, _, pop, _, _) {
                    # S4: a conversion is no place - what it converts is
                    if pop == typed.PrimOp.Convert {
                        c.err(c.argSpan(target), msgs.NotAssignable())
                        c.expr(value, types.UnknownT)
                        return
                    }
                }
                nomatch { }
            }
        }
        case typed.Lvalue.Deref(_, _, rv) {
            # T29a: the storage a conversion names (the place of its argument) - no place an assignment may name
            isConv := false
            match target {
                case ast.Expr.Call(_, _, _) { isConv = true }
                nomatch { }
            }
            match rv {
                case typed.Expr.Prim(_, _, pop, _, _) {
                    if pop == typed.PrimOp.Convert and isConv {
                        c.err(c.argSpan(target), msgs.NotAssignable())
                        c.expr(value, types.UnknownT)
                        return
                    }
                }
                nomatch { }
            }
        }
        nomatch { }
    }
    osp := c.opAfter(target.Span(), 1 if op == token.Tok.Assign else 2)
    # a lane store into an array a reference read out of x[i] names writes where the reference points, not into the
    # element: nothing to write back (E31b), as for "x[i].r[j] += v"
    throughRef := op != token.Tok.Assign and c.isRef(p.Type()) and c.laneArray(p.Type()) and laneTok(compoundOp(op))
    if not throughRef and c.writeBack(sp, op, p, value, osp) { return }
    # (through a reference the store is T25c's, laneTarget's: a read-only one is refused there)
    if not throughRef { c.notCapture(p, c.writeAt(target)) }
    t := p.Type()
    if op == token.Tok.Assign {
        c.storeInto(sp, p, value, osp, target)
        return
    }
    bop := compoundOp(op)
    if c.laneArray(t) and laneTok(bop) {
        # E39: "a += b" on an array - in place, lane by lane, in one loop
        c.laneAssign(sp, osp, bop, p, value)
        return
    }
    if not c.isNumber(t) or (c.isNamed(t) and not c.P.Extends(t)) {
        if t == types.UnknownT { return }
        # x op= v on a declared type: x = x op v through its operator's method (E31)
        v := c.expr(value, types.UnknownT)
        if c.isNumber(t) and c.isNamed(t) and c.roleMethod(t, operatorName(bop), 1) < 0 {
            # T29f: a declared number that does not extend its base takes none of its operators: beside another of
            # it there is none, beside its base or a literal the result is its base's, which does not flow back
            vt := typeOf(v)
            if vt == types.UnknownT { return }
            if c.P.T.Same(vt, t) {
                c.err(osp, msgs.NotExtendedOp(c.ty(t), msgs.Tok(op.Text()), "'" $operatorName(bop) "'"))
            } else {
                m := c.under(t) if c.litLike(value) else c.P.Meet(c.under(t), c.under(vt))
                c.err(osp, msgs.NumberDoesNotFlow(c.ty(m), c.ty(t), c.ty(t)))
            }
            return
        }
        r := c.operatorCall(sp, sp, bop, c.read(sp, typed.Lvalue.Target(sp, t)), v)
        if r is null {
            c.gap(sp, "a compound assignment to what has no operator method (E31)")
            return
        }
        c.emit(typed.Stmt.Assign(sp, p, c.fit(r, t, sp)))
        return
    }
    old := c.read(sp, typed.Lvalue.Target(sp, t))
    v typed.Expr?&c = null
    lv := c.fold(value)
    if lv.Ok {
        v = c.litOf(value, lv, t)
    } else {
        v = c.value(c.expr(value, t), value.Span())
    }
    vt := typeOf(v)
    if (bop == token.Tok.Shl or bop == token.Tok.Shr) and not c.shiftInRange(t, v!, value.Span()) { return }
    if bop != token.Tok.Shl and bop != token.Tok.Shr and vt != t and vt != types.UnknownT {
        # T6b: a number flows toward its base - a declared one into its base and on (sc U64 += a Code over U16)
        if c.isNumber(vt) and c.P.Flows(vt, t) {
            v = c.convert(value.Span(), v!, t)
        } else {
            c.err(osp, msgs.NumberDoesNotFlow(c.ty(vt), c.ty(t), c.ty(t)))
        }
    }
    c.emit(typed.Stmt.Assign(sp, p, c.prim(sp, t, binaryOp(bop), old, v)))
}

# the element read through At that a store into p writes into, reached from p's top without passing a reference:
# its record's index, -1 for none (E31b)
fn (c mut Checker&) valueTemp(p typed.Lvalue&) I64 {
    match p {
        case typed.Lvalue.Field(_, _, base, _) { return c.valueTemp(base) }
        case typed.Lvalue.Elem(_, _, e) { return c.valueTemp(e.Base) }
        case typed.Lvalue.Payload(_, _, pl) { return c.valueTemp(pl.Base) }
        case typed.Lvalue.Temp(_, _, _, site) {
            body := c.fr().Body
            for i in range c.atRecs.Len() {
                if c.atRecs[i].Body == body and c.atRecs[i].Site == I64(site) { return i }
            }
            return -1
        }
        nomatch { return -1 }
    }
}

# p with the element read through At replaced by the local t holding it
fn (c mut Checker&) replaceTemp(p typed.Lvalue&c, t I64) typed.Lvalue&c {
    match p {
        case typed.Lvalue.Field(sp, ty, base, k) { return typed.Lvalue.Field(sp, ty, c.replaceTemp(base, t), k) }
        case typed.Lvalue.Elem(sp, ty, e) {
            return typed.Lvalue.Elem(sp, ty, typed.Elem(c.replaceTemp(e.Base, t), e.Index, e.Checked))
        }
        case typed.Lvalue.Payload(sp, ty, pl) { return typed.Lvalue.Payload(sp, ty, typed.Payload(c.replaceTemp(pl.Base, t), pl.Tag, pl.Checked)) }
        case typed.Lvalue.Temp(sp, ty, _, _) { return typed.Lvalue.Local(sp, ty, typed.LocalId(I32(t))) }
        nomatch { return p }
    }
}

# a store into x[i]... through At (E31b): x's place and the indices held, the value evaluated, then the element read
# into a local, the store made into it, and the element written back by SetAt - nothing the program wrote runs
# between the read and the write-back. With setM the store is that SetAt on p itself, its indices setItems held after
# the levels' (x[i][j] = v, x[i] an element read: x[i]'s own SetAt, then x[i] written back). Whether it is handled
fn (c mut Checker&) writeBack(sp source.Span, op token.Tok, p typed.Lvalue&c, value ast.Expr?&, osp source.Span, setM I64 = -1
                              setItems Array<ast.Expr&>& = Array<ast.Expr&>(0)) Bool {
    vsp := value.Span() if value is not null else sp
    ri := c.valueTemp(p)
    if ri < 0 { return false }
    # the levels, the store's own first: x[i][j].f has two, the element of x[i] read and written back last (E31b's
    # nested collections, one level at a time)
    recs Vec<I64>
    calls mut Vec<Array<typed.Expr&>&>&c = Vec<Array<typed.Expr&>&>()
    at := p
    for ri >= 0 {
        args := c.callArgs(c.tempValue(at))
        if args.Len() == 0 {
            c.gap(sp, "a store through an element read of this kind (E31b)")
            return true
        }
        recs.Push(ri)
        calls.Push(args)
        at = c.atRecs[ri].Base
        ri = c.valueTemp(at)
    }
    nl := recs.Len()
    sms Vec<I64>
    for l in range nl {
        of := c.atRecs[recs[l]].Of
        n := calls[l].Len() - 1
        sm := c.roleMethod(of, "SetAt", n + 1)
        if sm < 0 {
            if not c.notOperator(of, "SetAt", osp, "'x[i] = v'", 2, true) { c.err(osp, msgs.WriteThroughAtNoSetat(c.ty(of))) }
            if value is not null { c.expr(value, types.UnknownT) }
            return true
        }
        sms.Push(sm)
    }
    # the place: each level's indices held, the outermost's first, left to right
    held mut Vec<Array<I64>&>&c = Vec<Array<I64>&>()
    for _ in range nl { held.Push(Array<I64>(0)) }
    for kk in range nl {
        l := nl - 1 - kk
        args := calls[l]
        hs mut Array<I64>&held = Array<I64>(args.Len() - 1)
        for i in range args.Len() - 1 {
            a := args[i + 1]
            h := c.local(source.NameId(0), a.Span(), typeOf(a), typed.LocalKind.Held, typed.Mark.None)
            c.emit(typed.Stmt.Let(a.Span(), typed.LocalId(I32(h)), a))
            hs[i] = h
        }
        held[l] = hs
    }
    # the SetAt's own indices, then its value at its parameter's type
    pt := p.Type()
    setHeld Vec<I64>
    if setM >= 0 {
        pts := c.paramsOn(setM, pt)
        for i in range setItems.Len() {
            it := setItems[i]
            a := c.value(c.expr(it, pts[1 + i] if 1 + i < pts.Len() else types.UnknownT), it.Span())
            h := c.local(source.NameId(0), it.Span(), typeOf(a), typed.LocalKind.Held, typed.Mark.None)
            c.emit(typed.Stmt.Let(it.Span(), typed.LocalId(I32(h)), a))
            setHeld.Push(h)
        }
        pt = pts[pts.Len() - 1] if pts.Len() > 0 else types.UnknownT
        # a reference parameter takes the value as a reference - a place borrowed, not copied into the hold (E12c)
        rt := c.paramOn(setM, p.Type(), pts.Len() - 1)
        if rt != types.UnknownT and c.isRef(rt) { pt = rt }
    }
    # then the value
    x typed.Expr?&c = null
    laneK I64 = -1
    lanePre := laneVals()
    if op == token.Tok.Assign {
        x = c.exprTo(value!, pt)
        if pt == c.textType() and c.isRef(typeOf(x)) { x = c.read(sp, typed.Lvalue.Deref(sp, pt, x!)) }
    } else if value is not null and c.laneArray(pt) and laneTok(compoundOp(op)) {
        # E39 through x[i] (an inline array of the element): the operand's lanes evaluated and held, then the element
        # read, the loop storing into it, and it written back - none of the program's code between the read and the
        # write-back, so lanes calling an operator method are refused
        e := c.laneElemOf(pt)
        laneK = c.laneLeaf(c.laneArg(value, e))
        ve := c.laneNodes[laneK].Elem
        meth := ""
        if not c.builtinElem(e) or not c.builtinElem(ve) {
            meth = "'" $operatorName(compoundOp(op)) "'"
        } else {
            meth = c.laneMethodCalled(laneK)
        }
        if meth != "" {
            c.err(osp, msgs.WriteThroughAtOperator(c.ty(e if not c.builtinElem(e) else ve), meth))
            return true
        }
        c.laneHoldLeaves(laneK, lanePre)
    } else {
        if not c.isNumber(pt) or (c.isNamed(pt) and not c.P.Extends(pt)) {
            if pt != types.UnknownT { c.writeBackNoNumber(sp, op, pt, value, osp) }
            return true
        }
        if value is null {
            x = c.lit(sp, pt, floatBits(c.under(pt), 1.0) if c.P.T.IsFloat(c.under(pt)) else 1)
        } else {
            x = c.value(c.expr(value, pt), vsp)
            if typeOf(x) != pt and c.isNumber(typeOf(x)) and c.P.Flows(typeOf(x), pt) { x = c.convert(vsp, x!, pt) }
            bop := compoundOp(op)
            if (bop == token.Tok.Shl or bop == token.Tok.Shr) and not c.shiftInRange(pt, x!, vsp) { return true }
        }
    }
    # a local's own value is read where it is stored - nothing between can change it, and held in a local of its own
    # it would live in the statement's block where the local lives in its own (O25a)
    direct := laneK >= 0 or op == token.Tok.Assign and localRead(x!)
    hv I64 = -1
    if not direct {
        hv = c.local(source.NameId(0), vsp, typeOf(x), typed.LocalKind.Held, typed.Mark.None)
        c.emit(typed.Stmt.Let(vsp, typed.LocalId(I32(hv)), x!))
    }
    # each element read by At into a local, the outermost first, the next read out of it
    temps Array<I64> = Array<I64>(nl, -1)
    bases mut Vec<typed.Lvalue?&>&c = Vec<typed.Lvalue?&>()
    for _ in range nl { bases.Push(null) }
    for kk in range nl {
        l := nl - 1 - kk
        base := c.atRecs[recs[l]].Base
        if l + 1 < nl { base = c.replaceTemp(base, temps[l + 1]) }
        bases[l] = base
        hs := held[l]
        reads mut Array<typed.Expr&>&c = Array<typed.Expr&>(hs.Len(), c.hole(sp))
        for i in range hs.Len() { reads[i] = c.readLocal(sp, hs[i]) }
        am := c.roleMethod(c.atRecs[recs[l]].Of, "At", hs.Len())
        el := c.invoke(sp, sp, am, c.read(sp, base), Array<ast.Expr&>(0), reads)
        t := c.hidden(sp, typeOf(el))
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(t)), el))
        temps[l] = t
    }
    # the store into the innermost, then every level written back by SetAt, the innermost first
    p2 := c.replaceTemp(p, temps[0])
    c.notCapture(p2, sp)
    v := x if direct else c.readLocal(sp, hv)
    if setM >= 0 {
        sa mut Array<typed.Expr&>&c = Array<typed.Expr&>(setHeld.Len() + 1, c.hole(sp))
        for i in range setHeld.Len() { sa[i] = c.readLocal(sp, setHeld[i]) }
        sa[setHeld.Len()] = v!
        c.emit(typed.Stmt.Eval(sp, c.invoke(sp, sp, setM, c.read(sp, p2), Array<ast.Expr&>(0), sa)))
    } else if laneK >= 0 {
        c.laneStore(sp, osp, compoundOp(op), pt, c.laneTarget(sp, p2), laneK, lanePre)
    } else {
        if op != token.Tok.Assign { v = c.prim(sp, pt, binaryOp(compoundOp(op)), c.read(sp, typed.Lvalue.Target(sp, pt)), v) }
        c.emit(typed.Stmt.Assign(sp, p2, v!))
    }
    for l in range nl {
        hs := held[l]
        sargs mut Array<typed.Expr&>&c = Array<typed.Expr&>(hs.Len() + 1, c.hole(sp))
        for i in range hs.Len() { sargs[i] = c.readLocal(sp, hs[i]) }
        sargs[hs.Len()] = c.readLocal(sp, temps[l])
        c.emit(typed.Stmt.Eval(sp, c.invoke(sp, sp, sms[l], c.read(sp, bases[l]!), Array<ast.Expr&>(0), sargs)))
    }
    return true
}

# E8a: a shift of a value of type ta by an amount known while compiling - a literal, or a literal-only expression
# folded to one - is in [0, ta's width), else an error where it is written, at any width (T4a)
fn (c mut Checker&) shiftInRange(ta types.TypeId, amount typed.Expr&, sp source.Span) Bool {
    u := c.under(ta)
    if not c.P.T.IsInt(u) { return true }
    match amount {
        case typed.Expr.Lit(_, at, bits) {
            au := c.under(at)
            if not c.P.T.IsInt(au) { return true }
            ab := c.P.T.Bits(au)
            # the amount's value: its bits read as its own type reads them (a wider literal's, its value)
            v := bits
            if ab > 64 { ab = 64 }
            if ab < 64 {
                v = bits & ((I64(1) << ab) - 1)
                if not c.P.T.IsUnsigned(au) and ((v >> (ab - 1)) & 1) == 1 { v = v | ~((I64(1) << ab) - 1) }
            }
            w := c.P.T.Bits(u)
            big := c.P.T.IsUnsigned(au) and ab == 64 and v < 0
            if big or v < 0 or v >= w {
                c.err(sp, msgs.ShiftOutOfRange(c.ty(ta), v, w))
                return false
            }
        }
        nomatch { }
    }
    return true
}

# whether a lane's elements of type t are computed by the built-in operations alone: a Bool, a number that is no
# declared type, or one extending its base (T29f)
fn (c mut Checker&) builtinElem(t types.TypeId) Bool {
    return t == types.UnknownT or t == types.BoolT or (c.isNumber(t) and (not c.isNamed(t) or c.P.Extends(t)))
}

# a compound store (or a step, value null) through x[i] on what is no number: the operator method it would call runs
# between the read and the write-back (E31b), and a type with none has no such operator
fn (c mut Checker&) writeBackNoNumber(sp source.Span, op token.Tok, pt types.TypeId, value ast.Expr?&, osp source.Span) {
    inc := op == token.Tok.PlusEq
    name := ""
    if value is null {
        if c.isNamed(pt) {
            name = "Inc" if inc else "Dec"
            if c.roleMethod(pt, name, 0) < 0 {
                name = "Plus" if inc else "Minus"
                if c.roleMethod(pt, name, 1) < 0 { name = "" }
            }
        }
        if name == "" {
            c.err(osp, msgs.StepNotNumber(c.ty(pt)))
            return
        }
    } else {
        bop := compoundOp(op)
        if c.isNamed(pt) and c.roleMethod(pt, operatorName(bop), 1) >= 0 {
            name = operatorName(bop)
        } else {
            # no operator method: what the same assignment says elsewhere
            v := c.expr(value, types.UnknownT)
            if typeOf(v) != types.UnknownT and c.operatorCall(sp, sp, bop, c.read(sp, typed.Lvalue.Target(sp, pt)), v) is null {
                c.gap(sp, "a compound assignment to what has no operator method (E31)")
            }
            return
        }
    }
    c.err(osp, msgs.WriteThroughAtOperator(c.ty(pt), "'" $name "'"))
}

# whether x reads a local's own value (not through a reference it holds)
fn localRead(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Lvalue.Local(_, _, _) { return true }
                case _ { }
            }
        }
        case _ { }
    }
    return false
}

# a method's parameters, the receiver's first, as a receiver of type recv binds the method's variables (boundParam's);
# Unknown where one is left open
fn (c mut Checker&) paramsOn(f I64, recv types.TypeId) Array<types.TypeId> {
    ps := c.P.T.Items(c.P.T.Params(c.P.Sig(f)))
    out := Array<types.TypeId>(ps.Len())
    owner := generic.FnOwner(f)
    nv := c.P.VarCount(owner)
    b := generic.Binding(owner, nv)
    if nv > 0 and ps.Len() > 0 { c.unify(ps[0], recv, b, false, true) }
    for k in range ps.Len() { out[k] = c.deref(ps[k]) if nv == 0 else c.boundParam(ps, k, b) }
    return out
}

# a method's parameter k as a receiver of type recv binds the method's variables, a reference kept as one (paramsOn
# gives its referent); Unknown where one is left open
fn (c mut Checker&) paramOn(f I64, recv types.TypeId, k I64) types.TypeId {
    ps := c.P.T.Items(c.P.T.Params(c.P.Sig(f)))
    if k < 0 or k >= ps.Len() { return types.UnknownT }
    owner := generic.FnOwner(f)
    nv := c.P.VarCount(owner)
    if nv == 0 { return ps[k] }
    b := generic.Binding(owner, nv)
    c.unify(ps[0], recv, b, false, true)
    part := Array<types.TypeId>(b.N)
    for j in range b.N { part[j] = b.Vals[j] if b.Vals[j] != types.UnknownT else c.P.T.Var(b.Owner, j, types.ReadOnly) }
    t := c.P.Subst(ps[k], b.Owner, c.P.T.List(part))
    return t if c.P.T.Closed(t) else types.UnknownT
}

# the value of the Temp a store reaches (valueTemp's)
fn (c mut Checker&) tempValue(p typed.Lvalue&) typed.Expr?&p {
    return match p {
        case typed.Lvalue.Field(_, _, base, _) => c.tempValue(base)
        case typed.Lvalue.Elem(_, _, e) => c.tempValue(e.Base)
        case typed.Lvalue.Payload(_, _, pl) => c.tempValue(pl.Base)
        case typed.Lvalue.Temp(_, _, x, _) => x
        case _ => null
    }
}

# a call's arguments, the receiver first; null for what is no call
fn (c mut Checker&) callArgs(x typed.Expr?&) Array<typed.Expr&>&x {
    if x is null: return Array<typed.Expr&>(0)
    return match x {
        case typed.Expr.Call(_, _, cl) => cl.Args
        case _ => Array<typed.Expr&>(0)
    }
}

# a branch where its if's condition holds (positive) or fails, with what the condition then says in it (S8d)
fn (c mut Checker&) narrowedBranch(b ast.Branch&, guard ast.Expr&, positive Bool) typed.Block&c {
    if b.Group >= 0 { c.P.L.Diags.Reopen(b.Group) }
    from := c.stmts.Len()
    bid, outer, mark := c.open(typed.BlockKind.Plain, b.Sp)
    if b.Body.Len() > 0 { c.pushFacts(guard, positive, bid) }
    c.stmtsOf(b.Body)
    r := c.close(bid, outer, mark, from)
    if b.Group >= 0 { c.P.L.Diags.EndHold() }
    return r
}

# a branch's statements in a block of their own, what they report held where its parse held them (B9, S8b)
fn (c mut Checker&) branchBlock(b ast.Branch&) typed.Block&c {
    if b.Group >= 0 { c.P.L.Diags.Reopen(b.Group) }
    r := c.blockOf(b.Body, typed.BlockKind.Plain, b.Sp)
    if b.Group >= 0 { c.P.L.Diags.EndHold() }
    return r
}

# if c { } else { } (S7): a condition the build decides is configuration, its branch alone checked (S8b) - the resolver
# chose its group and dropped the other's
fn (c mut Checker&) ifStmt(sp source.Span, i ast.If&) {
    st := c.ifOf(sp, i)
    c.emit(st)
    # S8d: after "if p is null { ... }" (or "if e != Case", ...) whose block always leaves, what its condition says where
    # it fails holds for the rest of the block it is in, until a statement assigns the local
    if i.Cond is null or i.Else is not null { return }
    match st {
        case typed.Stmt.If(_, ti) {
            if skipsRest(ti.Then) { c.pushFacts(i.Cond!, false, c.fr().Block) }
        }
        nomatch { }
    }
}

fn (c mut Checker&) ifOf(sp source.Span, i ast.If&) typed.Stmt&c {
    if i.Cond is null { return typed.Stmt.Block(sp, c.branchBlock(i.Then!)) }
    # G35: a condition reading a reflected member is decided for this instance - the chosen branch alone checked
    rd := c.reflDecide(i.Cond)
    if rd == 1 { return typed.Stmt.Block(sp, c.branchBlock(i.Then!)) }
    if rd == 0 {
        if i.Else is null { return typed.Stmt.Block(sp, typed.Block(typed.BlockId(I32(c.fr().Block)), Array<typed.Stmt&>(0))) }
        match i.Else {
            case ast.Stmt.If(esp, e) {
                if e.Cond is null { return typed.Stmt.Block(esp, c.branchBlock(e.Then!)) }
                return c.ifOf(esp, e)
            }
            nomatch { return c.elseOf(sp, i.Else!) }
        }
    }
    d := c.P.L.Diags
    # B9c, S8b: decided by evaluation in an earlier check of the program - the branch chosen alone
    key := pair.Pair(c.fr().File, I64(i.Cond!.Span().Start))
    if c.Decided.Has(key) {
        if try c.Decided.Get(key) catch default false {
            if i.Then!.Group >= 0 { d.Choose(i.Then!.Group) }
            c.dropElse(i.Else)
            return typed.Stmt.Block(sp, c.branchBlock(i.Then!))
        }
        if i.Then!.Group >= 0 { d.Drop(i.Then!.Group) }
        if i.Else is null { return typed.Stmt.Block(sp, typed.Block(typed.BlockId(I32(c.fr().Block)), Array<typed.Stmt&>(0))) }
        match i.Else {
            case ast.Stmt.If(_, e) {
                if e.Cond is null and e.Then!.Group >= 0 { d.Choose(e.Then!.Group) }
            }
            nomatch { }
        }
        return c.elseOf(sp, i.Else!)
    }
    # S8a: a condition the same on every build - B9a's value reading no build constant, or evaluation's - is a running
    # if, its branches' errors reported, and an error once it checks
    dead := c.Dead.Has(key) or c.P.R.Same.Has(key)
    if dead { c.Running(i) }
    # a condition B9a left to evaluation: asked for, the if checked as a running one meanwhile
    asked := false
    if not dead and i.Then!.Group >= 0 and d.IsPending(i.Then!.Group) {
        b := c.CondBody(c.fr().Mi, i.Cond!)
        if b >= 0 {
            c.Asks.Push(Ask(b, c.fr().File, i.Cond!.Span().Start, i, c.fr().Body, c.lastFixed.ToArray()))
            asked = true
        } else if not c.readsConst(i.Cond) {
            # it reads a local no evaluation can stand for: the running program's, what its branches hold reported (S7)
            c.Running(i)
        }
    }
    if i.Then!.Group >= 0 and d.IsDropped(i.Then!.Group) {
        # the build took the else (S8b)
        if i.Else is null { return typed.Stmt.Block(sp, typed.Block(typed.BlockId(I32(c.fr().Block)), Array<typed.Stmt&>(0))) }
        return c.elseOf(sp, i.Else!)
    }
    if i.Then!.Group >= 0 and i.Else is not null and c.elseDropped(i.Else!) {
        # the build took the then (S8b)
        return typed.Stmt.Block(sp, c.branchBlock(i.Then!))
    }
    if i.Then!.Group >= 0 and d.IsPending(i.Then!.Group) and (d.Holds(i.Then!.Group) or c.elseHolds(i.Else)) {
        c.gap(sp, "an if the build decides, still undecided (S8b, B9c)")
        return typed.Stmt.Block(sp, typed.Block(typed.BlockId(I32(c.fr().Block)), Array<typed.Stmt&>(0)))
    }
    # G30: a condition reading a length the instance binds is decided for it, the chosen branch alone checked
    dk := c.constCond(i.Cond!)
    if dk == 1 { return typed.Stmt.Block(sp, c.branchBlock(i.Then!)) }
    if dk == 0 {
        if i.Else is null { return typed.Stmt.Block(sp, typed.Block(typed.BlockId(I32(c.fr().Block)), Array<typed.Stmt&>(0))) }
        match i.Else {
            case ast.Stmt.If(esp, e) {
                if e.Cond is null { return typed.Stmt.Block(esp, c.branchBlock(e.Then!)) }
                return c.ifOf(esp, e)
            }
            nomatch { return c.elseOf(sp, i.Else!) }
        }
    }
    # a running if: what both its branches hold is reported - one whose condition reads a local that is no fixed one
    # (S8c), or is wrong, included. One asked for stays held until evaluation decides it
    if not asked { c.Running(i) }
    k := c.cond1(i.Cond!)
    if dead and typeOf(k) == types.BoolT { c.err(c.operatorOf(i.Cond!), msgs.ConditionConstant()) }
    # S8d: what the condition says holds in its block, what it says where it fails in the else
    then := c.narrowedBranch(i.Then!, i.Cond!, true)
    els typed.Block?&c = null
    if i.Else is not null {
        match i.Else {
            case ast.Stmt.If(esp, e) {
                if e.Cond is null {
                    els = c.narrowedBranch(e.Then!, i.Cond!, false)
                } else {
                    from := c.stmts.Len()
                    id, outer, mark := c.open(typed.BlockKind.Plain, esp)
                    c.pushFacts(i.Cond!, false, id)
                    c.emit(c.ifOf(esp, e))
                    els = c.close(id, outer, mark, from)
                }
            }
            nomatch { c.gap(i.Else!.Span(), "an else of this kind") }
        }
    }
    return typed.Stmt.If(sp, typed.If(k, then, els))
}

# an else chain after a branch evaluation took (S8b): none of it compiled
fn (c mut Checker&) dropElse(s ast.Stmt?&) {
    if s is null { return }
    match s {
        case ast.Stmt.If(_, e) {
            if e.Then!.Group >= 0 { c.P.L.Diags.CutOff(e.Then!.Group) }
            c.dropElse(e.Else)
        }
        nomatch { }
    }
}

fn (c mut Checker&) elseHolds(s ast.Stmt?&) Bool {
    if s is null { return false }
    match s {
        case ast.Stmt.If(_, e) { return e.Then!.Group >= 0 and c.P.L.Diags.Holds(e.Then!.Group) or c.elseHolds(e.Else) }
        nomatch { return false }
    }
}

# whether the else chain was dropped because the build took the then: a plain else dropped, or an else-if cut off - an
# else-if dropped for its own condition, decided false after a running if, says nothing about the then
fn (c mut Checker&) elseDropped(s ast.Stmt&) Bool {
    match s {
        case ast.Stmt.If(_, e) {
            d := c.P.L.Diags
            return d.IsDropped(e.Then!.Group) if e.Cond is null else d.IsCut(e.Then!.Group)
        }
        nomatch { return false }
    }
}

# a condition reading a length this instance binds (G30: "a.Len()" of an array taken by value), decided for it: 1
# true, 0 false, -1 where it reads none, or is not decided by the lengths alone
fn (c mut Checker&) constCond(x ast.Expr&) I64 {
    # G35: one reading a reflected member, decided for this instance
    rd := c.reflDecide(x)
    if rd >= 0 { return rd }
    if not c.readsConst(x) { return -1 }
    k := c.P.FoldKnown(c.fr().Ctx, x, types.BoolT)
    if c.P.T.KindOf(k) != types.Kind.Const { return -1 }
    return 1 if c.P.T.ConstValue(k) != 0 else 0
}

# whether an expression reads a length this instance binds (G30)
fn (c mut Checker&) readsConst(x ast.Expr?&) Bool {
    if x is null { return false }
    match x {
        case ast.Expr.Paren(_, a), ast.Expr.Named(_, _, a), ast.Expr.Unary(_, _, a), ast.Expr.Member(_, a, _) { return c.readsConst(a) }
        case ast.Expr.Call(_, f, args) { return c.paramLen(f, args) >= 0 }
        case ast.Expr.Binary(_, _, a, b) { return c.readsConst(a) or c.readsConst(b) }
        case ast.Expr.Chain(_, ch) {
            for e in ch.Xs {
                if c.readsConst(e) { return true }
            }
            return false
        }
        nomatch { return false }
    }
}

fn (c mut Checker&) elseOf(sp source.Span, s ast.Stmt&) typed.Stmt&c {
    match s {
        case ast.Stmt.If(esp, e) { return c.ifOf(esp, e) }
        nomatch {
            c.gap(s.Span(), "an else of this kind")
            return typed.Stmt.Block(sp, typed.Block(typed.BlockId(I32(c.fr().Block)), Array<typed.Stmt&>(0)))
        }
    }
}

# a loop: "for { }", "for c { }" - its body a Loop block, "if not c { break }" first (S9)
fn (c mut Checker&) loop(sp source.Span, k ast.Expr?&, body Array<ast.Stmt&>&, post ast.Stmt?&) {
    from := c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Loop, sp)
    c.fr().loops.Push(id)
    c.fr().exits.Push(id)
    if k is not null { c.emit(c.breakUnless(sp, c.cond1(k), id)) }
    # S8d: what the condition says holds in the body, and in the post clause where the body assigns the local nowhere
    if k is not null { c.pushFacts(k, true, id) }
    if body.Len() > 0 {
        c.stmtsOf(body)
    }
    try c.fr().loops.Pop() catch { }
    try c.fr().exits.Pop() catch { }
    b := c.close(id, outer, mark, from)
    pb typed.Block?&c = null
    if post is not null {
        pfrom := c.stmts.Len()
        pid, pouter, pmark := c.open(typed.BlockKind.Post, sp)
        if k is not null {
            held := c.factsHeld()
            c.pushFacts(k, true, pid)
            c.killAssigned(held, body)
        }
        c.stmt(post)
        pb = c.close(pid, pouter, pmark, pfrom)
    }
    c.emit(typed.Stmt.Loop(sp, b, pb))
    # S8d: a loop left only by its condition failing - nothing in it says "break" - leaves what the condition says
    # where it fails holding after it ("for p is null { p = next() }")
    if k is not null and not c.src(sp).Contains("break") { c.pushFacts(k, false, c.fr().Block) }
}

fn (c mut Checker&) breakUnless(sp source.Span, x typed.Expr&c, loop I64) typed.Stmt&c {
    from := c.stmts.Len()
    c.stmts.Push(typed.Stmt.Jump(sp, typed.JumpKind.Break, typed.BlockId(I32(loop))))
    br := typed.Block(typed.BlockId(I32(c.fr().Block)), gather(c.stmts, from))
    return typed.Stmt.If(sp, typed.If(c.negate(sp, x), br, null))
}

# for init, cond, post { } (S9): a block holding init, then the loop
fn (c mut Checker&) for3(sp source.Span, f ast.For3&) {
    from := c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Plain, sp)
    c.stmt(f.Init)
    c.loop(sp, f.Cond, f.Body, f.Post)
    b := c.close(id, outer, mark, from)
    c.emit(typed.Stmt.Block(sp, b))
}

# do { } for c (S9): its condition tested after the body, in its post clause
fn (c mut Checker&) doFor(sp source.Span, body Array<ast.Stmt&>&, k ast.Expr&) {
    from := c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Loop, sp)
    c.fr().loops.Push(id)
    c.fr().exits.Push(id)
    if body.Len() > 0 {
        c.stmtsOf(body)
    }
    try c.fr().loops.Pop() catch { }
    try c.fr().exits.Pop() catch { }
    b := c.close(id, outer, mark, from)
    pfrom := c.stmts.Len()
    pid, pouter, pmark := c.open(typed.BlockKind.Post, sp)
    c.emit(c.breakUnless(sp, c.cond1(k), id))
    pb := c.close(pid, pouter, pmark, pfrom)
    c.emit(typed.Stmt.Loop(sp, b, pb))
}

# for x in range ... and for [i,] x in an array (S9a, S9b): a counted loop over a count worked out once
fn (c mut Checker&) forIn(sp source.Span, f ast.ForIn&) {
    # G33: a list known while compiling is unrolled, the body checked per item
    rl := c.listOf(f.Source)
    if rl.Ok {
        c.unrolled(sp, f, rl)
        return
    }
    fr := c.fr()
    lmark := fr.leaks.Len()
    from := c.stmts.Len()
    fails := fr.LoopFails
    fallible := fr.Fallible
    id, outer, mark := c.open(typed.BlockKind.Plain, sp)
    c.walk(sp, f, null, types.UnknownT)
    b := c.close(id, outer, mark, from)
    # S9e: a loop whose own calls can fail is written "for x in try c", and one whose calls cannot is not
    forSp := source.Span(sp.Start, sp.Start + 3)
    if not f.Tried and fr.LoopFails > fails { c.err(forSp, msgs.ForInNeedsTry()) }
    if f.Tried and fr.LoopFails == fails and fr.Fallible == fallible { c.err(forSp, msgs.ForInTryNothing()) }
    fr.LoopFails = fails
    if not f.Tried {
        c.emit(typed.Stmt.Block(sp, b))
        return
    }
    # for x in try c (S9e): the loop's own calls - its source, Iter, Next, At - fail into its clauses, an error ending
    # the loop: the loop a try statement's operand, its body's own calls tried where written
    c.stmts.Push(typed.Stmt.Block(sp, b))
    x mut typed.Expr&c = typed.Expr.Seq(sp, types.VoidT, typed.Seq(gather(c.stmts, from), null))
    cls mut Vec<typed.Clause&>&c = Vec<typed.Clause&>()
    lend := fr.leaks.Len()
    if f.Clauses.Len() > 0 {
        # its clauses run once the loop has ended: no loop of theirs to break or continue (S9e) - a stand-in loop says so
        fr.loops.Push(-2)
        fr.exits.Push(-2)
        got := c.leaksBetween(lmark, lend)
        for cl in f.Clauses { cls.Push(c.clause(cl, types.VoidT, false, got, cls)) }
        try fr.loops.Pop() catch { }
        try fr.exits.Pop() catch { }
    }
    lk := c.caught(lmark, lend, cls)
    c.emit(typed.Stmt.Eval(sp, typed.Expr.Try(sp, types.VoidT, typed.Try(x, cls.ToArray(), Left = lk > 0))))
}

# what for-in walks, decided by the source's type (S9a): a range (S9b), an array, a value stored in runs (S9f), an
# iterator, an iterable (S9c), an indexable value (S9d). Its statements go into the block open; each value runs the
# loop's body, or, for a comprehension cm, yields its element (E27). Gives the reserve a comprehension may make: an
# array's length, a range's count, null where not known
fn (c mut Checker&) walk(sp source.Span, f ast.ForIn&, cm ast.Compr?&, ce types.TypeId) typed.Expr?&c {
    match f.Source {
        case ast.Expr.Range(_, rargs) { return c.forRange(sp, f, rargs, cm, ce) }
        nomatch { }
    }
    if f.Tried { c.fr().Tries++ }
    src := c.expr(f.Source, types.UnknownT)
    if f.Tried { c.fr().Tries-- }
    st := typeOf(src)
    if st == types.UnknownT { return null }
    at := c.arrayOf(st)
    if at != types.UnknownT {
        # the collection, borrowed once (S9a)
        rt := st if c.isRef(st) else c.P.T.Ref(st, types.ReadOnly)
        coll := c.hidden(sp, rt)
        c.roBorrows.Put(c.roKey(coll), c.roRef(src) if c.isRef(st) else c.roPlace(readPlace(src)))   # T25c
        fx := c.fit(src, rt, f.Source.Span())
        c.roTrack(coll, fx)
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(coll)), fx))
        k := c.hidden(sp, c.i64())
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(k)), c.lit(sp, c.i64(), 0)))
        n := c.hidden(sp, c.i64())
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(n)), c.prim(sp, c.i64(), typed.PrimOp.Len, c.readLocal(sp, coll), null)))
        # T7c: a fixed array's length is the comprehension's count, known while compiling
        if cm is not null and c.P.T.Length(at) != types.TypeId(0) and c.P.T.KindOf(c.P.T.Length(at)) == types.Kind.Const {
            c.comprKnown = c.P.T.ConstValue(c.P.T.Length(at))
        }
        c.counted(sp, f, k, n, coll, at, -1, -1, cm, ce)
        return c.readLocal(sp, n)
    }
    if cm is not null { c.comprOpen(sp) }
    dt := c.deref(st)
    if c.P.T.KindOf(dt) == types.Kind.Any {
        # T32b: an "any" of an iterator trait walked through its table's Next
        slots := c.P.AnySlots(c.P.T.AnyTrait(dt))
        for k in range slots.Len() {
            if c.text(slots[k].Name) == "Next" and c.P.T.Items(c.P.T.Params(slots[k].Sig)).Len() == 1 {
                c.walkIter(sp, f, src, -2 - k, cm, ce)
                return null
            }
        }
        c.err(f.Source.Span(), msgs.NotIterable(c.ty(st)))
        return null
    }
    runs := c.roleUse(dt, "RunFrom", 1, sp, "'for'")
    next := c.roleUse(dt, "Next", 0, sp, "'for'")
    if next >= 0 and not c.iterShaped(next) { next = -1 }   # S9a: an iterator's Next is "mut Next() T ? Exhausted"
    if runs >= 0 and next < 0 {
        c.walkRuns(sp, f, src, runs, cm, ce)
        return null
    }
    if next >= 0 {
        c.walkIter(sp, f, src, next, cm, ce)
        return null
    }
    iter := c.roleUse(dt, "Iter", 0, sp, "'for'")
    if iter >= 0 {
        it := c.invoke(sp, f.Source.Span(), iter, src, Array<ast.Expr&>(0), Array<typed.Expr&>(0))
        nt := c.roleMethod(c.deref(typeOf(it)), "Next", 0)
        if nt < 0 {
            c.gap(f.Source.Span(), "an Iter() whose result is no iterator (S9c)")
            return null
        }
        c.walkIter(sp, f, it, nt, cm, ce)
        return null
    }
    atm := c.roleUse(dt, "At", 1, sp, "'for'")
    lm := c.roleMethod(dt, "Len", 0)
    if atm >= 0 and c.P.T.Items(c.P.T.Errors(c.P.Sig(atm))).Len() > 0 { c.fr().LoopFails++ }
    if atm >= 0 and lm >= 0 {
        c.walkIndexed(sp, f, src, atm, lm, cm, ce)
        return null
    }
    # E31: a Next shaped otherwise is an ordinary method, and "for" has nothing to walk with
    if c.notOperator(dt, "Next", sp, "'for ... in'", 0, false) { return null }
    c.err(f.Source.Span(), msgs.NotIterable(c.ty(st)))
    return null
}

# whether a Next makes an iterator (S9a): a writable receiver, one value, Exhausted among its errors
fn (c mut Checker&) iterShaped(m I64) Bool {
    sig := c.P.Sig(m)
    ps := c.P.T.Items(c.P.T.Params(sig))
    if ps.Len() != 1 or not c.writable(ps[0]) { return false }
    r := c.P.T.Result(sig)
    if r == types.VoidT or r == types.NoreturnT or c.P.T.KindOf(r) == types.Kind.Tuple { return false }
    for e in c.P.T.Items(c.P.T.Errors(sig)) {
        if c.P.T.KindOf(c.P.T.ErrOf(e)) != types.Kind.Named { continue }   # the inferred mark, an error-set variable (QAH)
        if c.text(c.P.T.DeclName(c.P.T.DeclOf(c.P.T.ErrOf(e)))) == "Exhausted" { return true }
    }
    return c.infersErrs(sig)
}

# ---- take (E34) ----

# whether a value of type t owns: an own reference, or a value holding one by value (O30, O31)
fn (c mut Checker&) owning(t types.TypeId) Bool { return c.owningIn(t, 0) }

fn (c mut Checker&) owningIn(t types.TypeId, depth I64) Bool {
    if depth > 16 or t == types.UnknownT { return false }
    k := c.P.T.KindOf(t)
    if k == types.Kind.Ref { return (c.P.T.PermOf(t) & types.Owning) != 0 }
    if k == types.Kind.Tuple or k == types.Kind.Record {
        for x in c.P.T.Items(c.P.T.Parts(t)) {
            if c.owningIn(x, depth + 1) { return true }
        }
        return false
    }
    if k == types.Kind.Array and c.P.T.Length(t) != types.TypeId(0) { return c.owningIn(c.P.T.Elem(t), depth + 1) }
    if k == types.Kind.Named and c.P.Body(t) and c.P.T.DeclKindOf(c.P.T.DeclOf(t)) == types.DeclKind.Struct {
        for x in c.P.T.Items(c.P.T.Fields(t)) {
            if c.owningIn(x, depth + 1) { return true }
        }
    }
    return false
}

# ---- lambdas (D16) ----

# whether t mentions a type variable of owner - one a generic call has not bound yet
fn (c mut Checker&) mentionsVar(t types.TypeId, owner I64) Bool {
    if t == types.TypeId(0) or t == types.UnknownT { return false }
    k := c.P.T.KindOf(t)
    match k {
        case types.Kind.Var { return owner < 0 or c.P.T.A(t) == owner }
        case types.Kind.Named { return c.listMentions(c.P.T.Args(t), owner) }
        case types.Kind.Array { return c.mentionsVar(c.P.T.Elem(t), owner) or c.mentionsVar(c.P.T.Length(t), owner) }
        case types.Kind.Ref { return c.mentionsVar(c.P.T.Referent(t), owner) }
        case types.Kind.Func {
            return c.listMentions(c.P.T.Params(t), owner) or c.mentionsVar(c.P.T.Result(t), owner) or
                   c.listMentions(c.P.T.Errors(t), owner)
        }
        case types.Kind.Tuple, types.Kind.Record { return c.listMentions(c.P.T.Parts(t), owner) }
        case types.Kind.Any { return c.mentionsVar(c.P.T.AnyTrait(t), owner) }
        nomatch { return false }
    }
}

fn (c mut Checker&) listMentions(l types.ListId, owner I64) Bool {
    if l == types.ListId(0) { return false }
    for x in c.P.T.Items(l) {
        if c.mentionsVar(x, owner) { return true }
    }
    return false
}

# fn(params) [result] [? errors] { ... } (D16): a body of its own checked where it is written, its captures read from
# the bodies around it (D16c). An expected function type supplies what it leaves out (D16a) - a part still naming a
# generic call's unbound variable supplies nothing; otherwise the result is its first return's and its errors what its
# body lets out (D16b)
fn (c mut Checker&) lambda(sp source.Span, f ast.Func&, want types.TypeId) typed.Expr&c {
    # D8e: a lambda's type is inferred - it cannot be written noreturn
    if f.S.NoReturn {
        c.err(c.noreturnSpan(sp), msgs.NoreturnHere("a lambda"))
        return c.unknown(sp)
    }
    w := want if want != types.UnknownT and c.P.T.KindOf(want) == types.Kind.Func else types.UnknownT
    ps := f.S.Params
    n := ps.Len()
    wps := c.P.T.Items(c.P.T.Params(w)) if w != types.UnknownT else Array<types.TypeId>(0)
    if w != types.UnknownT and wps.Len() != n {
        c.err(sp, msgs.LambdaArity(c.ty(w), wps.Len(), "" if wps.Len() == 1 else "s", n))
        return c.unknown(sp)
    }
    pts := Array<types.TypeId>(n)
    for i in range n {
        if ps[i].Ty is not null {
            pts[i] = c.resolve(ps[i].Ty)
            # D9a: a lambda is a function type's value, which carries no length - its array parameter written by value is
            # an error (one whose type is left out is the expected type's)
            if not c.isRef(pts[i]) and c.P.T.KindOf(c.under(pts[i])) == types.Kind.Array and not c.namesTypeVar(ps[i].Ty) {
                nsp := source.Span(ps[i].Sp.Start, ps[i].Sp.Start + I32(c.text(ps[i].Name).Len()))
                c.err(nsp, msgs.ArrayParamByValue(c.tok(ps[i].Name), c.src(ps[i].Ty!.Span())))
                return c.unknown(sp)
            }
            if w != types.UnknownT and not c.mentionsVar(wps[i], -1) and not c.P.T.Same(pts[i], wps[i]) {
                if c.isRef(pts[i]) != c.isRef(wps[i]) and c.P.T.Same(c.deref(pts[i]), c.deref(wps[i])) {
                    c.gap(ps[i].Sp, "a lambda parameter written as a reference where a value is expected (D16a)")
                    return c.unknown(sp)
                }
                # T22: a read-only parameter where a writable one is expected
                ro := c.isRef(pts[i]) and c.isRef(wps[i]) and c.P.T.Same(c.deref(pts[i]), c.deref(wps[i])) and
                      (c.P.T.PermOf(pts[i]) & types.Writable) == 0
                if not ro {
                    c.err(ps[i].Sp, msgs.LambdaSignature(c.ty(w)))
                    return c.unknown(sp)
                }
            }
        } else if w != types.UnknownT and not c.mentionsVar(wps[i], -1) {
            pts[i] = wps[i]
        } else {
            c.err(ps[i].Sp, msgs.LambdaParamUntyped(c.tok(ps[i].Name)))
            return c.unknown(sp)
        }
    }
    infer := false
    result := types.VoidT
    if f.S.Results.Len() > 0 {
        rs := Array<types.TypeId>(f.S.Results.Len())
        for i in range rs.Len() { rs[i] = c.resolve(f.S.Results[i]) }
        result = rs[0] if rs.Len() == 1 else c.P.T.Tuple(c.P.T.List(rs))
    } else if w != types.UnknownT and not c.mentionsVar(c.P.T.Result(w), -1) {
        result = c.P.T.Result(w)
    } else {
        infer = true
        result = types.UnknownT
    }
    errs := types.ListId(0)
    inferErrs := false
    if f.S.HasErrors and f.S.Errors.Len() == 0 and w == types.UnknownT {
        # R1a: "?" alone is what the body is found to fail with, as a function's is
        inferErrs = true
    } else if f.S.HasErrors {
        errs = c.P.ErrorList(c.fr().Ctx, true, f.S.Errors)
    } else if w != types.UnknownT and not c.listMentions(c.P.T.Errors(w), -1) {
        errs = c.P.T.Errors(w)
    } else {
        # QAH: an expected set naming a generic call's error-set variable supplies nothing - the body says, and binds it
        inferErrs = true
    }
    # with nothing expected every parameter has a scope of its own and a result is built: the plain scopes (O4b, O13)
    scopes := c.P.T.ScopesOf(w) if w != types.UnknownT else types.ScopesId(0)
    pl := c.P.T.List(pts)
    parent := c.fr()
    pfi := c.frames.Len() - 1
    id := c.newBody(typed.BodyOf.Lambda(typed.BodyId(I32(parent.Body))), c.P.T.Func(pl, result, errs, scopes), parent.Mi, sp)
    c.state[id] = 1
    fr := c.push(id, parent.Mi, result, errs)
    fr.Ctx = parent.Ctx
    fr.Parent = pfi
    fr.InferResult = infer
    fr.InferErrors = inferErrs
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    for i in range n {
        c.param(ps[i].Name, ps[i].Sp, pts[i], i, ps[i].Ty)
        if ps[i].Ty is not null { c.paramWritten(ps[i], pts[i]) }
    }
    c.cur().SetVars(c.P.ScopeVarsOf(c.cur().Ty))
    root := c.rootStmts(f.Body)
    c.cur().Root = root
    if fr.InferResult {
        fr.InferResult = false
        fr.Result = types.VoidT
    }
    result = fr.Result
    # in R1a's canonical order, as an inferred set (decision 52)
    if inferErrs { errs = c.canonicalErrs(c.merged(c.letOut(fr))) }
    ty := c.P.T.Func(pl, result, errs, scopes)
    c.cur().Ty = ty
    if result != types.VoidT and not c.fr().Gapped and not leavesBlock(root) {
        c.err(sp, msgs.MissingReturn(c.ty(result)))
    }
    caps := c.fr().captures.ToArray()
    c.pop()
    c.state[id] = 2
    c.roFns.Push(roFn(id, 0, c.at(sp), "this lambda"))   # T25c
    # with nothing expected the value renders with its own parameters' names (E11a); else it is the type expected
    vt := c.P.T.WithNames(ty, c.P.SigNames(f.S)) if w == types.UnknownT else c.P.T.WithNames(ty, c.P.T.NamesIdOf(w))
    return typed.Expr.Fn(sp, vt, typed.FnVal.Lambda(typed.BodyId(I32(id)), caps, c.site(typed.SiteKind.Closure, sp)))
}

# a lambda's value given a wider error set (QAH): what its parameter's error-set variable was bound to, its own among
# them - its body's codes are counted by it, as by an inferred set (R6)
fn (c mut Checker&) lambdaErrs(e typed.Expr?&c, errs types.ListId) typed.Expr?&c {
    if e is null { return e }
    match e {
        case typed.Expr.Fn(sp, vt, fv) {
            match fv {
                case typed.FnVal.Lambda(id, _, _) {
                    if c.P.T.Errors(vt) == errs { return e }
                    b := c.Bodies[I64(id)]
                    b.Ty = c.P.T.Func(c.P.T.Params(b.Ty), c.P.T.Result(b.Ty), errs, c.P.T.ScopesOf(b.Ty))
                    nt := c.P.T.Func(c.P.T.Params(vt), c.P.T.Result(vt), errs, c.P.T.ScopesOf(vt), c.P.T.NamesIdOf(vt))
                    return typed.Expr.Fn(sp, nt, fv)
                }
                nomatch { return e }
            }
        }
        nomatch { return e }
    }
}

# T[e for x in s if c] (E27): an Array<T> filled by the walk for-in makes over s, e yielded where c holds; its
# storage reserved from an array's length or a range's count where the walk knows it, else grown (Reserve null)
fn (c mut Checker&) comprehension(sp source.Span, cm ast.Compr&) typed.Expr&c {
    # G33: over a list known while compiling, unrolled into an array literal
    rl := c.listOf(cm.Source)
    if rl.Ok { return c.unrolledCompr(sp, cm, rl) }
    et := c.errValueType(c.resolve(cm.Elem))
    if et != types.UnknownT and (c.isRef(et) or c.P.T.HoldsRefs(et)) {
        # E27: not yet - where such elements live would be the array's
        c.err(c.opAfter(cm.Elem!.Span(), 1), msgs.ComprehensionReferences())
        return c.unknown(sp)
    }
    at := c.P.T.Array(et, types.TypeId(0))
    f := ast.ForIn(cm.Key, cm.Name, cm.Source, false, Array<ast.Stmt&>(0), Array<ast.Catch&>(0))
    from := c.stmts.Len()
    fails := c.fr().LoopFails
    # the walk opens the comprehension's block where its source's setup ends (comprOpen), or fills a fixed array
    wState, wId, wOuter, wMark, wFrom := c.comprState, c.comprId, c.comprOuter, c.comprMark, c.comprFrom
    wOut, wIdx, wKnown := c.comprOut, c.comprIdx, c.comprKnown
    c.comprState, c.comprOut, c.comprIdx, c.comprKnown = 1, -1, -1, -1
    reserve := c.walk(sp, f, cm, et)
    if c.comprState == 1 { c.comprOpen(sp) }
    state, id, outer, mark, cfrom, out := c.comprState, c.comprId, c.comprOuter, c.comprMark, c.comprFrom, c.comprOut
    c.comprState, c.comprId, c.comprOuter, c.comprMark, c.comprFrom = wState, wId, wOuter, wMark, wFrom
    c.comprOut, c.comprIdx, c.comprKnown = wOut, wIdx, wKnown
    # E27, S9e: a comprehension whose own calls can fail is written under try - said at its "for"
    if c.fr().LoopFails > fails and c.fr().Tries == 0 {
        fa := try c.src(sp).Find(" for ") catch default -1
        c.err(source.Span(sp.Start + I32(fa + 1), sp.Start + I32(fa + 4)) if fa >= 0 else sp, msgs.ComprNeedsTry())
    }
    c.fr().LoopFails = fails
    if state == 3 {
        # T7c: no if, a count known while compiling - a fixed array, each element written once in place
        r := c.readLocal(sp, out)
        return typed.Expr.Seq(sp, typeOf(r), typed.Seq(gather(c.stmts, from), r))
    }
    b := c.close(id, outer, mark, cfrom)
    # its storage reserved from the count its source knows before the loop, made once at it where every value is kept
    # (no if); none known, grown (E27)
    exact := reserve is not null and cm.Filter is null
    r := typed.Expr.Collect(sp, at, typed.Collect(reserve, b, c.site(typed.SiteKind.Collect, sp), typed.Check.None, exact))
    if cfrom == from { return r }
    return typed.Expr.Seq(sp, at, typed.Seq(gather(c.stmts, from), r))
}

# D14d: whether "name := Array<T>(n)" (or typed so) is followed, as the next statement of its block, by a counted loop
# "for i in range n" (or "range 0, n", the same n - a name or a literal) whose body writes name[i] as a whole at its top
# level, mentions name nowhere else, never assigns i and holds no break, continue or return - so every element is
# written before anything reads the array, and its clear is never seen. Read off the text where it is about mentions: a
# mention is always the name written, so anything more is a mention more, and the clear is kept. An element type that
# owns or is an array is excluded (a store into one reads what it replaces)
fn (c mut Checker&) filledNext(name source.NameId, value ast.Expr&) Bool {
    fr := c.fr()
    if fr.restAt >= fr.rest.Len() { return false }
    n := match value {
        case ast.Expr.Call(_, f, args) => args[0] if args.Len() == 1 and isArrayCtor(c, f) else null
        case _ => null
    }
    if n is null or not plainLen(n) { return false }
    match fr.rest[fr.restAt] {
        case ast.Stmt.ForIn(_, f) {
            if f.Key != source.NameId(0) or f.Tried or f.Clauses.Len() > 0 or f.Body.Len() == 0 { return false }
            match f.Source {
                case ast.Expr.Range(_, rargs) {
                    if rargs.Len() == 1 {
                        if not c.sameLen(rargs[0], n) { return false }
                    } else if rargs.Len() == 2 {
                        if not (c.isZeroLit(rargs[0]) and c.sameLen(rargs[1], n)) { return false }
                    } else {
                        return false
                    }
                }
                nomatch { return false }
            }
            writes := 0
            for st in f.Body {
                match st {
                    case ast.Stmt.Assign(_, op, target, _) {
                        if op == token.Tok.Assign and c.indexOf(target, name, f.Name) { writes++ }
                    }
                    nomatch { }
                }
            }
            # the counter written nowhere in the body: the store's index is then each element in turn
            if writes != 1 or assignsName(f.Body, Array<source.NameId>(1, f.Name)) { return false }
            from, to := f.Body[0].Span().Start, f.Body[f.Body.Len() - 1].Span().End
            text := c.src(source.Span(from, to))
            return wordCount(text, c.text(name)) == 1 and wordCount(text, "break") == 0 and
                   wordCount(text, "continue") == 0 and wordCount(text, "return") == 0
        }
        nomatch { return false }
    }
}

# whether an expression is "Array<T>" naming the built-in array (a call of it then makes one)
fn isArrayCtor(c mut Checker&, f ast.Expr&) Bool {
    match f {
        case ast.Expr.Generic(_, g, targs) {
            if targs.Len() != 1 { return false }
            match g {
                case ast.Expr.Name(_, gn) { return c.text(gn) == "Array" }
                nomatch { return false }
            }
        }
        nomatch { return false }
    }
}

# a length a later range can be told to be the same as: a name or an integer literal
fn plainLen(x ast.Expr&) Bool {
    return match x {
        case ast.Expr.Name(_, _) => true
        case ast.Expr.Lit(_, k) => k == token.Tok.IntLit
        case _ => false
    }
}

fn (c mut Checker&) sameLen(a ast.Expr&, b ast.Expr&) Bool {
    if not plainLen(a) or not plainLen(b) { return false }
    match a {
        case ast.Expr.Name(_, n) {
            match b {
                case ast.Expr.Name(_, m) { return n == m }
                nomatch { return false }
            }
        }
        nomatch { }
    }
    return c.src(a.Span()) == c.src(b.Span())
}

fn (c mut Checker&) isZeroLit(x ast.Expr&) Bool {
    return match x {
        case ast.Expr.Lit(sp, k) => k == token.Tok.IntLit and c.src(sp) == "0"
        case _ => false
    }
}

# whether a target is "name[i]"
fn (c mut Checker&) indexOf(target ast.Expr&, name source.NameId, i source.NameId) Bool {
    match target {
        case ast.Expr.Index(_, x, items) {
            if items.Len() != 1 { return false }
            xn := match x {
                case ast.Expr.Name(_, m) => m
                case _ => source.NameId(0)
            }
            ixn := match items[0] {
                case ast.Expr.Name(_, m) => m
                case _ => source.NameId(0)
            }
            return xn == name and ixn == i
        }
        nomatch { return false }
    }
}

# how often a word stands whole in a text - not part of a longer name
fn wordCount(t String&, w String&) I64 {
    n I64 = 0
    i I64 = 0
    for i + w.Len() <= t.Len() {
        if t[i:i + w.Len()] == w {
            before := i == 0 or not (t[i - 1].IsLetter() or t[i - 1].IsDigit() or t[i - 1] == '_')
            j := i + w.Len()
            after := j >= t.Len() or not (t[j].IsLetter() or t[j].IsDigit() or t[j] == '_')
            if before and after { n++ }
        }
        i++
    }
    return n
}

# whether a declaration's value is an Array<T>(n) made with no clear (D14d)
fn (c mut Checker&) noClearMade(x typed.Expr?&) Bool {
    if x is null { return false }
    return match x {
        case typed.Expr.Make(_, _, m) => m.NoClear
        case _ => false
    }
}

# E27: the comprehension being walked opens its block here, where its source's setup ends - the walk's own
# statements from now on its loop's
fn (c mut Checker&) comprOpen(sp source.Span) {
    if c.comprState != 1 { return }
    c.comprFrom = c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Collect, sp)
    c.comprId, c.comprOuter, c.comprMark = id, outer, mark
    c.comprState = 2
}

# ---- lanes (E39) ----

# A lane operation not built yet. An array's operators work element by element (E39), and a whole expression of them -
# with a total or a lane method taking it - is made one loop, no array between: each operation is a node, and what
# takes it gets a placeholder naming the node - an array-typed Lit of bits LaneMagic + its index (an array's own Lit
# is all-zero bits, D13c, so no other value is one). What takes a placeholder as lanes builds on its node; anything
# else takes the array, made where it stands (laneOut)
type laneNode struct(Kind I64, Op token.Tok, Sp source.Span, OpSp source.Span, A I64, B I64, C I64, X typed.Expr?&
                     Elem types.TypeId, Len I64, Decl types.TypeId) {
    Kind       # LaneArr, LaneScalar, LaneBin, LaneUn, LaneCmp, LaneSel
    Op         # the operator: of LaneBin and LaneUn; EqEq or Lt for LaneCmp
    Sp
    OpSp
    A          # the operands' nodes: LaneBin's two, LaneUn's one, LaneCmp's two, LaneSel's mask then its two choices
    B
    C
    X          # a leaf's value: an array (LaneArr) or what every lane shares (LaneScalar)
    Elem       # the type of its elements; Unknown where they are no operation, which building them says
    Len        # its length where it is known while compiling (T7c), else -1
    Decl       # the declared array type the operation keeps - every array operand of it of that type (T29e) - else
               # Unknown: the result is an Array<Elem>
}

LaneArr I64 = 0
LaneScalar I64 = 1
LaneBin I64 = 2
LaneUn I64 = 3
LaneCmp I64 = 4
LaneSel I64 = 5
LaneMagic I64 = 1 << 40

# the operators that work lane by lane on arrays (E39); "==" and "!=" compare whole arrays (E10), "<" and the other
# orderings none (LanesLess)
fn laneTok(op token.Tok) Bool {
    return op == token.Tok.Plus or op == token.Tok.Minus or op == token.Tok.Star or op == token.Tok.Slash or
           op == token.Tok.Percent or op == token.Tok.Amp or op == token.Tok.Pipe or op == token.Tok.Caret or
           op == token.Tok.Shl or op == token.Tok.Shr or op == token.Tok.Xor or op == token.Tok.And or op == token.Tok.Or
}

# the methods every array has that take lanes as they are (E39): the totals, the comparisons, the choice
fn laneMethodName(name String&, n I64) Bool {
    return match name {
        case "Sum", "Min", "Max", "Some", "Every" => n == 0
        case "LanesEqual", "LanesLess" => n == 1
        case "Select" => n == 2
        case _ => false
    }
}

# whether values of type t are arrays the lane operators take (E39): an Array<T>, of a fixed length or not, through
# references, or a declared type extending one (T29e; one over an array that does not extend it has none of its
# operators, T29f) - never text, whose "+" is no sum
fn (c mut Checker&) laneArray(t types.TypeId) Bool {
    d := c.deref(t)
    if d == types.UnknownT or d == c.textType() { return false }
    if c.isNamed(d) and not c.P.Extends(d) { return false }
    return c.arrayOf(d) != types.UnknownT
}

fn (c mut Checker&) laneElemOf(t types.TypeId) types.TypeId { return c.P.T.Elem(c.arrayOf(t)) }

# the node a placeholder names, -1 for any other expression
fn (c mut Checker&) laneOf(x typed.Expr&) I64 {
    match x {
        case typed.Expr.Lit(_, ty, bits) {
            if bits >= LaneMagic and bits < LaneMagic + c.laneNodes.Len() and c.arrayOf(ty) != types.UnknownT { return bits - LaneMagic }
            return -1
        }
        nomatch { return -1 }
    }
}

fn (c mut Checker&) laneAdd(n laneNode) I64 {
    c.laneNodes.Push(n)
    return c.laneNodes.Len() - 1
}

# the array a node gives: its declared type, else an Array of its elements - fixed where its length is known (T7c)
fn (c mut Checker&) laneType(k I64) types.TypeId {
    n := c.laneNodes[k]
    if n.Decl != types.UnknownT { return n.Decl }
    return c.P.T.Array(n.Elem, c.P.T.Const(c.i64(), n.Len) if n.Len >= 0 else types.TypeId(0))
}

fn (c mut Checker&) laneHold(sp source.Span, k I64) typed.Expr&c { return typed.Expr.Lit(sp, c.laneType(k), LaneMagic + k) }

# an operand of a lane operation as a node: a placeholder's own, or a leaf - an array, or a value every lane shares
fn (c mut Checker&) laneLeaf(x typed.Expr&c) I64 {
    k := c.laneOf(x)
    if k >= 0 { return k }
    t := typeOf(x)
    if c.laneArray(t) {
        at := c.arrayOf(t)
        lt := c.P.T.Length(at)
        n := c.P.T.ConstValue(lt) if lt != types.TypeId(0) and c.P.T.KindOf(lt) == types.Kind.Const else -1
        d := c.deref(t)
        decl := d if c.isNamed(d) else types.UnknownT
        return c.laneAdd(laneNode(LaneArr, token.Tok.Plus, x.Span(), x.Span(), -1, -1, -1, x, c.P.T.Elem(at), n, decl))
    }
    return c.laneAdd(laneNode(LaneScalar, token.Tok.Plus, x.Span(), x.Span(), -1, -1, -1, x, t, -1, types.UnknownT))
}

# the length operands agree on while compiling: one's where it is known; where two are and differ, said at sp
fn (c mut Checker&) laneLen(ks Array<I64>&, sp source.Span) I64 {
    n I64 = -1
    for k in ks {
        m := c.laneNodes[k].Len
        if m < 0 { continue }
        if n >= 0 and m != n {
            c.err(sp, msgs.LaneLengths(n, m))
            return n
        }
        n = m
    }
    return n
}

# the declared array type an operation on these operands keeps: the one every array operand is of, its elements of
# type e still (T29e) - else none
fn (c mut Checker&) laneDecl(ks Array<I64>&, e types.TypeId) types.TypeId {
    d := types.UnknownT
    for k in ks {
        n := c.laneNodes[k]
        if n.Kind == LaneScalar { continue }
        if n.Decl == types.UnknownT { return types.UnknownT }
        if d == types.UnknownT {
            d = n.Decl
        } else if not c.P.T.Same(d, n.Decl) {
            return types.UnknownT
        }
    }
    if d == types.UnknownT or not c.P.T.Same(c.laneElemOf(d), e) { return types.UnknownT }
    return d
}

# what an operator gives on two elements of these types, as opValues makes it - Unknown where it is no operation
fn (c mut Checker&) laneBinType(op token.Tok, ta types.TypeId, tb types.TypeId) types.TypeId {
    if ta == types.UnknownT or tb == types.UnknownT { return types.UnknownT }
    if op == token.Tok.And or op == token.Tok.Or or op == token.Tok.Xor {
        return types.BoolT if ta == types.BoolT and tb == types.BoolT else types.UnknownT
    }
    if c.isNamed(ta) and not (c.isNumber(ta) and c.P.Extends(ta)) {
        m := c.roleMethod(ta, operatorName(op), 1)
        if m >= 0 { return c.laneResult(m, ta) }
    }
    if c.isNamed(tb) and not c.isNumber(tb) {
        m := c.commuting(tb, op)
        if m >= 0 { return c.laneResult(m, tb) }
    }
    if not c.isNumber(ta) or not c.isNumber(tb) { return types.UnknownT }
    if op == token.Tok.Shl or op == token.Tok.Shr { return ta if c.isInt(ta) and c.isInt(tb) else types.UnknownT }
    m := ta
    if ta != tb { m = c.P.Meet(ta, tb) }
    if m < types.TypeId(0) { return types.UnknownT }
    if intOnly(op) and not c.isInt(m) { return types.UnknownT }
    if c.isNamed(m) and not c.P.Extends(m) { return types.UnknownT }
    return m
}

fn (c mut Checker&) laneUnType(op token.Tok, t types.TypeId) types.TypeId {
    if t == types.UnknownT { return t }
    if op == token.Tok.Not { return types.BoolT if t == types.BoolT else types.UnknownT }
    if c.isNamed(t) and not (c.isNumber(t) and c.P.Extends(t)) {
        m := c.roleMethod(t, "Neg" if op == token.Tok.Minus else "BitNot", 0)
        return c.laneResult(m, t) if m >= 0 else types.UnknownT
    }
    if op == token.Tok.Minus { return t if c.isNumber(t) else types.UnknownT }
    return t if c.isInt(t) else types.UnknownT
}

# the result an operator method m gives on a receiver of type t - a generic type's, its variables bound by t (G9b)
fn (c mut Checker&) laneResult(m I64, t types.TypeId) types.TypeId {
    sig := c.P.Sig(m)
    if c.P.VarCount(generic.FnOwner(m)) > 0 { sig = c.implSig(m, t) }
    if sig == types.UnknownT { return types.UnknownT }
    return c.deref(c.P.T.Result(sig))
}

# x op y lane by lane (E39): a placeholder for the operation, built where something takes it
fn (c mut Checker&) laneBinary(sp source.Span, opSp source.Span, op token.Tok, x typed.Expr&c, y typed.Expr&c) typed.Expr&c {
    a := c.laneLeaf(x)
    b := c.laneLeaf(y)
    e := c.laneBinType(op, c.laneNodes[a].Elem, c.laneNodes[b].Elem)
    ks := I64[a, b]
    return c.laneHold(sp, c.laneAdd(laneNode(LaneBin, op, sp, opSp, a, b, -1, null, e, c.laneLen(ks, opSp), c.laneDecl(ks, e))))
}

fn (c mut Checker&) laneUnary(sp source.Span, op token.Tok, x typed.Expr&c) typed.Expr&c {
    a := c.laneLeaf(x)
    e := c.laneUnType(op, c.laneNodes[a].Elem)
    ks := I64[a]
    return c.laneHold(sp, c.laneAdd(laneNode(LaneUn, op, sp, sp, a, -1, -1, null, e, c.laneNodes[a].Len, c.laneDecl(ks, e))))
}

# a lane method's argument: lanes as they are, a literal adapted to the element type of the lanes beside it (T6)
fn (c mut Checker&) laneArg(x ast.Expr&, beside types.TypeId) typed.Expr&c {
    c.laneAccept = true
    want := c.literalBeside(beside) if c.litLike(x) and beside != types.UnknownT else types.UnknownT
    return c.value(c.expr(x, want), x.Span())
}

# the totals and the lane methods every array has (E39), on rx - lanes or an array
fn (c mut Checker&) laneMethod(sp source.Span, nsp source.Span, name String&, rx typed.Expr&c, args Array<ast.Expr&>&) typed.Expr&c {
    k := c.laneLeaf(rx)
    if name == "LanesEqual" or name == "LanesLess" {
        y := c.laneArg(args[0], c.laneNodes[k].Elem)
        b := c.laneLeaf(y)
        ea, eb := c.laneNodes[k].Elem, c.laneNodes[b].Elem
        e := types.BoolT if ea != types.UnknownT and eb != types.UnknownT else types.UnknownT
        op := token.Tok.EqEq if name == "LanesEqual" else token.Tok.Lt
        ks := I64[k, b]
        return c.laneHold(sp, c.laneAdd(laneNode(LaneCmp, op, sp, nsp, k, b, -1, null, e, c.laneLen(ks, nsp), types.UnknownT)))
    }
    if name == "Select" {
        if c.laneNodes[k].Elem != types.BoolT and c.laneNodes[k].Elem != types.UnknownT {
            c.err(nsp, msgs.LaneMaskBool("'Select'", c.ty(c.laneNodes[k].Elem)))
        }
        # the choices in order, a literal one adapted to the other's elements
        ya typed.Expr?&c = null
        yb typed.Expr?&c = null
        if not c.litLike(args[0]) { ya = c.laneArg(args[0], types.UnknownT) }
        if not c.litLike(args[1]) { yb = c.laneArg(args[1], types.UnknownT) }
        if ya is null { ya = c.laneArg(args[0], c.laneElemType(yb)) }
        if yb is null { yb = c.laneArg(args[1], c.laneElemType(ya)) }
        a := c.laneLeaf(ya!)
        b := c.laneLeaf(yb!)
        ea, eb := c.laneNodes[a].Elem, c.laneNodes[b].Elem
        e := types.UnknownT
        if ea != types.UnknownT and eb != types.UnknownT {
            if c.P.T.Same(ea, eb) {
                e = ea
            } else if c.isNumber(ea) and c.isNumber(eb) and c.P.Meet(ea, eb) >= types.TypeId(0) {
                e = c.P.Meet(ea, eb)
            } else {
                c.err(nsp, msgs.OperandsDiffer("'Select'", c.ty(ea), c.ty(eb)))
            }
        }
        ks := I64[k, a, b]
        return c.laneHold(sp, c.laneAdd(laneNode(LaneSel, token.Tok.Plus, sp, nsp, k, a, b, null, e, c.laneLen(ks, nsp), c.laneDecl(I64[a, b], e))))
    }
    return c.laneTotal(sp, nsp, name, k)
}

# the element type of an expression lanes or an array, else its own type; Unknown for none
fn (c mut Checker&) laneElemType(x typed.Expr?&c) types.TypeId {
    if x is null { return types.UnknownT }
    k := c.laneOf(x)
    if k >= 0 { return c.laneNodes[k].Elem }
    t := typeOf(x)
    return c.laneElemOf(t) if c.laneArray(t) else t
}

# what a lane loop reads: each leaf's value held before it, and its length
type laneVals struct() {
    N I64 = -1            # the local holding the length, -1 where it is known while compiling
    held Map<I64, I64>    # by leaf node: the local holding its value - an array's borrowed once - absent for a literal
}

# each leaf of node k evaluated once, in the order written, before the loop - an array borrowed (E12c) - and the length
# every array has, each but the first checked against it once (LaneLen, a guaranteed check)
fn (c mut Checker&) laneSetup(sp source.Span, k I64) laneVals {
    lv := laneVals()
    c.laneHoldLeaves(k, lv)
    c.laneLength(sp, k, lv)
    return lv
}

# each leaf of node k not held in lv yet evaluated and held, in the order written: an array borrowed (E12c), a local
# read where it is, anything else in a hidden local of its own, a literal not at all
fn (c mut Checker&) laneHoldLeaves(k I64, lv mut laneVals&) {
    order Vec<I64>
    c.laneLeaves(k, order)
    for leaf in order {
        if lv.held.Has(leaf) { continue }
        ln := c.laneNodes[leaf]
        if ln.Kind == LaneArr {
            lv.held.Put(leaf, c.borrowedSource(ln.Sp, ln.X!))
            continue
        }
        match ln.X! {
            case typed.Expr.Lit(_, _, _), typed.Expr.Data(_, _, _, _) { }
            nomatch {
                lp := readPlace(ln.X!)
                at I64 = -1
                if lp is not null {
                    match lp {
                        case typed.Lvalue.Local(_, _, l) { at = I64(l) }
                        nomatch { }
                    }
                }
                if at < 0 {
                    at = c.hidden(ln.Sp, typeOf(ln.X!))
                    c.emit(typed.Stmt.Let(ln.Sp, typed.LocalId(I32(at)), ln.X!))
                }
                lv.held.Put(leaf, at)
            }
        }
    }
}

# the length node k's lanes have, from its leaves held in lv: known while compiling, or held in a hidden local (lv.N) -
# every array's but the first's checked against the first's (LaneLen)
fn (c mut Checker&) laneLength(sp source.Span, k I64, lv mut laneVals&) {
    order Vec<I64>
    c.laneLeaves(k, order)
    fixed := c.laneNodes[k].Len
    n typed.Expr?&c = c.lit(sp, c.i64(), fixed) if fixed >= 0 else null
    checks := false
    for leaf in order {
        ln := c.laneNodes[leaf]
        if ln.Kind != LaneArr or ln.Len >= 0 { continue }
        h := try lv.held.Get(leaf) catch default -1
        if h < 0 { continue }
        l := c.prim(sp, c.i64(), typed.PrimOp.Len, c.readLocal(sp, h), null)
        if n is null {
            n = l
        } else {
            from := c.exprs.Len()
            c.exprs.Push(n)
            c.exprs.Push(l)
            n = typed.Expr.Prim(sp, c.i64(), typed.PrimOp.LaneLen, typed.Check.Abort, gather(c.exprs, from))
            checks = true
        }
    }
    if n is not null and (fixed < 0 or checks) {
        lv.N = c.hidden(sp, c.i64())
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(lv.N)), n))
    }
}

# the leaves under node k, left to right as written
fn (c mut Checker&) laneLeaves(k I64, out mut Vec<I64>&) {
    n := c.laneNodes[k]
    if n.Kind == LaneArr or n.Kind == LaneScalar {
        out.Push(k)
        return
    }
    if n.A >= 0 { c.laneLeaves(n.A, out) }
    if n.B >= 0 { c.laneLeaves(n.B, out) }
    if n.C >= 0 { c.laneLeaves(n.C, out) }
}

# how many lanes the loop walks: the known length, or the local holding it
fn (c mut Checker&) laneCount(sp source.Span, k I64, lv laneVals&) typed.Expr&c {
    if c.laneNodes[k].Len >= 0 { return c.lit(sp, c.i64(), c.laneNodes[k].Len) }
    return c.readLocal(sp, lv.N)
}

# a loop over the lanes: a counter i from start (0, or 1 where lane 0 is built before it), the loop leaving where it reaches n - its counter, block, outer block, undo
# mark and statements' start, for laneLoopClose
fn (c mut Checker&) laneLoopOpen(sp source.Span, n typed.Expr&c, start I64 = 0) I64, I64, I64, I64, I64 {
    i := c.hidden(sp, c.i64())
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(i)), c.lit(sp, c.i64(), start)))
    from := c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Loop, sp)
    c.emit(c.breakUnless(sp, c.prim(sp, types.BoolT, typed.PrimOp.Lt, c.readLocal(sp, i), n), id))
    return i, id, outer, mark, from
}

fn (c mut Checker&) laneLoopClose(sp source.Span, i I64, id I64, outer I64, mark I64, from I64) {
    b := c.close(id, outer, mark, from)
    c.emit(typed.Stmt.Loop(sp, b, c.countPost(sp, i)))
}

# node k's element at lane i, in the loop
fn (c mut Checker&) laneElem(sp source.Span, k I64, lv laneVals&, i typed.Expr&c) typed.Expr&c {
    n := c.laneNodes[k]
    if n.Kind == LaneArr {
        h := try lv.held.Get(k) catch default -1
        if h < 0 { return c.unknown(sp) }
        ht := c.localType(h)
        base typed.Lvalue&c = typed.Lvalue.Deref(sp, c.deref(ht), c.readLocal(sp, h))
        return c.read(sp, typed.Lvalue.Elem(sp, n.Elem, typed.Elem(base, i, typed.Check.None)))
    }
    if n.Kind == LaneScalar {
        h := try lv.held.Get(k) catch default -1
        if h < 0 { return n.X! }
        return c.readLocal(n.Sp, h)
    }
    if n.Kind == LaneUn {
        ea := c.laneElem(sp, n.A, lv, i)
        if n.Op == token.Tok.Not {
            c.laneBool(ea, n.Sp, "'not'")
            return c.negate(n.Sp, ea)
        }
        return c.laneOut(c.unaryOn(n.Sp, n.Op, ea))
    }
    if n.Kind == LaneSel {
        em := c.laneElem(sp, n.A, lv, i)
        ea := c.laneElem(sp, n.B, lv, i)
        eb := c.laneElem(sp, n.C, lv, i)
        if n.Elem == types.UnknownT { return c.unknown(n.Sp) }
        return typed.Expr.Cond(n.Sp, n.Elem, typed.Cond(em, c.fit(ea, n.Elem, n.Sp), c.fit(eb, n.Elem, n.Sp)))
    }
    ea := c.laneElem(sp, n.A, lv, i)
    eb := c.laneElem(sp, n.B, lv, i)
    if n.Op == token.Tok.And or n.Op == token.Tok.Or {
        if not c.laneBool(ea, n.OpSp, msgs.Tok(n.Op.Text())) or not c.laneBool(eb, n.OpSp, msgs.Tok(n.Op.Text())) { return c.unknown(n.Sp) }
        if n.Op == token.Tok.And { return typed.Expr.Cond(n.Sp, types.BoolT, typed.Cond(ea, eb, c.lit(n.Sp, types.BoolT, 0))) }
        return typed.Expr.Cond(n.Sp, types.BoolT, typed.Cond(ea, c.lit(n.Sp, types.BoolT, 1), eb))
    }
    return c.laneOut(c.opValues(n.Sp, n.OpSp, n.Op, ea, eb, n.Sp, n.Sp))
}

# whether a lane's element is a Bool, said at sp where it is not
fn (c mut Checker&) laneBool(x typed.Expr&c, sp source.Span, what String&) Bool {
    t := typeOf(x)
    if t == types.BoolT or t == types.UnknownT { return true }
    c.err(sp, msgs.OperandNotBool(what, c.ty(t)))
    return false
}

# the lanes of node k built: errors said, and a value of no use - where its elements are no operation
fn (c mut Checker&) laneSay(sp source.Span, k I64) typed.Expr&c {
    from := c.stmts.Len()
    lv := c.laneSetup(sp, k)
    c.laneElem(sp, k, lv, c.lit(sp, c.i64(), 0))
    c.stmts.Truncate(from)
    return c.unknown(sp)
}

# what an expression is where nothing takes it as lanes: a placeholder made the array it names - the leaves evaluated,
# then one loop computing every operation of it lane by lane into the result, made once at its length (a fixed array
# where its length is known while compiling, T7c); any other expression as it is
fn (c mut Checker&) laneOut(x typed.Expr&c) typed.Expr&c {
    k := c.laneOf(x)
    if k < 0 { return x }
    sp := x.Span()
    n := c.laneNodes[k]
    if n.Elem == types.UnknownT { return c.laneSay(sp, k) }
    if c.isRef(n.Elem) or c.P.T.HoldsRefs(n.Elem) {
        c.err(sp, msgs.LaneReferences())
        return c.unknown(sp)
    }
    from := c.stmts.Len()
    lv := c.laneSetup(sp, k)
    r typed.Expr?&c = null
    if n.Len >= 0 {
        ft := c.P.T.Array(n.Elem, c.P.T.Const(c.i64(), n.Len))
        out := c.hidden(sp, ft)
        ifrom := c.exprs.Len()
        if c.zeroCalls(n.Elem) { c.exprs.Push(c.zero(sp, n.Elem)) }
        fill := typed.Expr.Make(sp, ft, typed.Make(typed.MakeKind.Fill, 0, gather(c.exprs, ifrom), c.lit(sp, c.i64(), n.Len)
                                                   typed.SiteId(-1), typed.Check.None))
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(out)), fill))
        i, id, outer, mark, lfrom := c.laneLoopOpen(sp, c.lit(sp, c.i64(), n.Len))
        e := c.laneElem(sp, k, lv, c.readLocal(sp, i))
        dst := typed.Lvalue.Elem(sp, n.Elem, typed.Elem(typed.Lvalue.Local(sp, ft, typed.LocalId(I32(out))), c.readLocal(sp, i), typed.Check.None))
        c.emit(typed.Stmt.Assign(sp, dst, c.fit(e, n.Elem, sp)))
        c.laneLoopClose(sp, i, id, outer, mark, lfrom)
        r = c.readLocal(sp, out)
    } else {
        at := c.P.T.Array(n.Elem, types.TypeId(0))
        cfrom := c.stmts.Len()
        cid, couter, cmark := c.open(typed.BlockKind.Collect, sp)
        i, id, outer, mark, lfrom := c.laneLoopOpen(sp, c.readLocal(sp, lv.N))
        e := c.laneElem(sp, k, lv, c.readLocal(sp, i))
        c.emit(typed.Stmt.Yield(sp, c.fit(e, n.Elem, sp)))
        c.laneLoopClose(sp, i, id, outer, mark, lfrom)
        b := c.close(cid, couter, cmark, cfrom)
        r = typed.Expr.Collect(sp, at, typed.Collect(c.readLocal(sp, lv.N), b, c.site(typed.SiteKind.Collect, sp), typed.Check.None, true))
    }
    if n.Decl != types.UnknownT { r = c.convert(sp, r!, n.Decl) }
    return typed.Expr.Seq(sp, typeOf(r!), typed.Seq(gather(c.stmts, from), r))
}

# a total of lanes (E39), in one loop over them: Sum adding each element to its type's zero value in order (an empty
# array's Sum the zero value); Min and Max the first element no later one is less than, or greater than, by "<" - a
# float's NaN the answer once met - failing with ArrayError.EMPTY where there is none; Some and Every whether any, or
# every, lane of Bools holds
fn (c mut Checker&) laneTotal(sp source.Span, nsp source.Span, name String&, k I64) typed.Expr&c {
    n := c.laneNodes[k]
    e := n.Elem
    if e == types.UnknownT { return c.laneSay(sp, k) }
    if (name == "Some" or name == "Every") and e != types.BoolT {
        c.err(nsp, msgs.LaneMaskBool("'" $name "()'", c.ty(e)))
        return c.unknown(sp)
    }
    from := c.stmts.Len()
    lv := c.laneSetup(sp, k)
    cnt := c.laneCount(sp, k, lv)
    if name == "Sum" {
        acc := c.hidden(sp, e)
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(acc)), c.zero(sp, e)))
        i, id, outer, mark, lfrom := c.laneLoopOpen(sp, cnt)
        s := c.opValues(sp, nsp, token.Tok.Plus, c.readLocal(sp, acc), c.laneElem(sp, k, lv, c.readLocal(sp, i)), sp, sp)
        c.emit(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, e, typed.LocalId(I32(acc))), c.fit(s, e, sp)))
        c.laneLoopClose(sp, i, id, outer, mark, lfrom)
        return typed.Expr.Seq(sp, e, typed.Seq(gather(c.stmts, from), c.readLocal(sp, acc)))
    }
    if name == "Some" or name == "Every" {
        some := name == "Some"
        r := c.hidden(sp, types.BoolT)
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(r)), c.lit(sp, types.BoolT, 0 if some else 1)))
        i, id, outer, mark, lfrom := c.laneLoopOpen(sp, cnt)
        x := c.laneElem(sp, k, lv, c.readLocal(sp, i))
        tfrom := c.stmts.Len()
        c.stmts.Push(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, types.BoolT, typed.LocalId(I32(r))), c.lit(sp, types.BoolT, 1 if some else 0)))
        c.stmts.Push(typed.Stmt.Jump(sp, typed.JumpKind.Break, typed.BlockId(I32(id))))
        then := typed.Block(typed.BlockId(I32(c.fr().Block)), gather(c.stmts, tfrom))
        c.emit(typed.Stmt.If(sp, typed.If(x if some else c.negate(sp, x), then, null)))
        c.laneLoopClose(sp, i, id, outer, mark, lfrom)
        return typed.Expr.Seq(sp, types.BoolT, typed.Seq(gather(c.stmts, from), c.readLocal(sp, r)))
    }
    # Min, Max
    chk := c.failOp(types.TypeId[c.preludeWord("std/prelude/array", "ArrayError", "EMPTY")], nsp)
    c.emit(typed.Stmt.Eval(sp, typed.Expr.Prim(sp, types.VoidT, typed.PrimOp.NonEmpty, chk, c.one(cnt))))
    # the first lane, built with nothing said - the loop's, built for the lanes after it, says what is wrong with it
    z := c.hidden(sp, c.i64())   # lane 0 through a local: a constant index into a fixed array of none is an error
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(z)), c.lit(sp, c.i64(), 0)))
    g := c.P.L.Diags.Hold()
    first := c.laneElem(sp, k, lv, c.readLocal(sp, z))
    c.P.L.Diags.EndHold()
    c.P.L.Diags.Drop(g)
    m := c.hidden(sp, e)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(m)), c.fit(first, e, sp)))
    # the rest of the lanes from 1: lane 0 is built once, as every other is (each lane the operation written, E39)
    i, id, outer, mark, lfrom := c.laneLoopOpen(sp, c.laneCount(sp, k, lv), 1)
    v := c.hidden(sp, e)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(v)), c.fit(c.laneElem(sp, k, lv, c.readLocal(sp, i)), e, sp)))
    less := c.opValues(sp, nsp, token.Tok.Lt, c.readLocal(sp, v), c.readLocal(sp, m), sp, sp) if name == "Min" else
        c.opValues(sp, nsp, token.Tok.Lt, c.readLocal(sp, m), c.readLocal(sp, v), sp, sp)
    if c.P.T.IsFloat(c.under(e)) {
        # a NaN is the answer once met, as a float's own Min and Max give it (IEEE 754-2019's minimum and maximum)
        nan := c.prim(sp, types.BoolT, typed.PrimOp.Ne, c.readLocal(sp, v), c.readLocal(sp, v))
        less = typed.Expr.Cond(sp, types.BoolT, typed.Cond(less, c.lit(sp, types.BoolT, 1), nan))
    }
    tfrom := c.stmts.Len()
    c.stmts.Push(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, e, typed.LocalId(I32(m))), c.readLocal(sp, v)))
    then := typed.Block(typed.BlockId(I32(c.fr().Block)), gather(c.stmts, tfrom))
    c.emit(typed.Stmt.If(sp, typed.If(less, then, null)))
    c.laneLoopClose(sp, i, id, outer, mark, lfrom)
    return typed.Expr.Seq(sp, e, typed.Seq(gather(c.stmts, from), c.readLocal(sp, m)))
}

# "x op= v" on an array (E39): in place, lane by lane - x's place evaluated once and borrowed writably (T25c: only a
# writable place or reference), v's lanes evaluated before the loop, every lane of x stored with its own value op v's
fn (c mut Checker&) laneAssign(sp source.Span, osp source.Span, op token.Tok, p typed.Lvalue&c, value ast.Expr&) {
    t := p.Type()
    h := c.laneTarget(sp, p)
    v := c.laneArg(value, c.laneElemOf(t))
    lv := laneVals()
    c.laneStore(sp, osp, op, t, h, c.laneLeaf(v), lv)
}

# the array x op= v stores into, borrowed writably into a hidden local - its place read once
fn (c mut Checker&) laneTarget(sp source.Span, p typed.Lvalue&c) I64 {
    rt := c.P.T.Ref(c.deref(p.Type()), types.Writable)
    h := c.hidden(sp, rt)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(h)), c.fit(c.read(sp, p), rt, sp)))
    return h
}

# the loop of x op= v (E39): x the array of type t borrowed in local h, v node vk, the leaves lv holds already kept as
# they are (a store through x[i], E31b, evaluates v's before reading the element). Each lane is computed and stored
# before the next is read (F10: an operand overlapping x reads the lanes already stored, as the loop written by hand
# does). An element type that is or holds a reference is refused, as laneOut refuses it
fn (c mut Checker&) laneStore(sp source.Span, osp source.Span, op token.Tok, t types.TypeId, h I64, vk I64, lv mut laneVals&) {
    rt := c.localType(h)
    tk := c.laneLeaf(c.readLocal(sp, h))
    e := c.laneElemOf(t)
    ks := I64[tk, vk]
    ok := c.laneAdd(laneNode(LaneBin, op, sp, osp, tk, vk, -1, null, c.laneBinType(op, e, c.laneNodes[vk].Elem), c.laneLen(ks, osp), types.UnknownT))
    if c.laneNodes[ok].Elem == types.UnknownT {
        c.laneSay(sp, ok)
        return
    }
    if c.isRef(e) or c.P.T.HoldsRefs(e) {
        c.err(osp, msgs.LaneReferences())
        return
    }
    c.laneHoldLeaves(ok, lv)
    c.laneLength(sp, ok, lv)
    i, id, outer, mark, lfrom := c.laneLoopOpen(sp, c.laneCount(sp, ok, lv))
    x := c.laneElem(sp, ok, lv, c.readLocal(sp, i))
    base typed.Lvalue&c = typed.Lvalue.Deref(sp, c.deref(rt), c.readLocal(sp, h))
    c.emit(typed.Stmt.Assign(sp, typed.Lvalue.Elem(sp, e, typed.Elem(base, c.readLocal(sp, i), typed.Check.None)), c.fit(x, e, osp)))
    c.laneLoopClose(sp, i, id, outer, mark, lfrom)
}

# the operator method node k's lanes call, by its element types - "" where every operation is a built-in one on numbers
# or Bools (E31b: none of the program's code runs between a read through x[i] and its write-back)
fn (c mut Checker&) laneMethodCalled(k I64) String {
    n := c.laneNodes[k]
    if n.Kind == LaneArr or n.Kind == LaneScalar { return "" }
    for sub in I64[n.A, n.B, n.C] {
        if sub < 0 { continue }
        m := c.laneMethodCalled(sub)
        if m != "" { return m }
        te := c.laneNodes[sub].Elem
        if te != types.BoolT and (not c.isNumber(te) or (c.isNamed(te) and not c.P.Extends(te))) {
            return "'" $operatorName(n.Op) "'" if n.Kind == LaneBin else "operator method"
        }
    }
    return ""
}

# the body run for each value: the loop's statements, or a comprehension's element yielded where its filter holds
fn (c mut Checker&) walkBody(f ast.ForIn&, cm ast.Compr?&, ce types.TypeId) {
    if cm is null {
        if f.Body.Len() > 0 {
            c.stmtsOf(f.Body)
        }
        return
    }
    sp := cm.Value.Span()
    out, idx := c.comprOut, c.comprIdx
    v := c.exprTo(cm.Value, ce)
    if cm.Filter is null and out >= 0 {
        # T7c: the fixed array's element at the counter
        ot := c.localType(out)
        dst typed.Lvalue&c = typed.Lvalue.Elem(sp, ce, typed.Elem(typed.Lvalue.Local(sp, ot, typed.LocalId(I32(out))), c.readLocal(sp, idx), typed.Check.None))
        c.emit(typed.Stmt.Assign(sp, dst, c.fit(v, ce, sp)))
        return
    }
    if cm.Filter is null {
        c.emit(typed.Stmt.Yield(sp, v))
        return
    }
    k := c.cond1(cm.Filter!)
    from := c.stmts.Len()
    c.stmts.Push(typed.Stmt.Yield(sp, v))
    y typed.Block&c = typed.Block(typed.BlockId(I32(c.fr().Block)), gather(c.stmts, from))
    c.emit(typed.Stmt.If(cm.Filter!.Span(), typed.If(k, y, null)))
}

# a call the loop makes that fails with Exhausted at the end (S9a, S9f): tried, that clause leaving the loop
fn (c mut Checker&) exhaustedOrBreak(sp source.Span, call typed.Expr&c, loop I64) typed.Expr&c {
    ex := c.P.PreludeType("std/prelude/iterator", "Exhausted")
    from := c.stmts.Len()
    c.stmts.Push(typed.Stmt.Jump(sp, typed.JumpKind.Break, typed.BlockId(I32(loop))))
    code := typed.Block(typed.BlockId(I32(c.fr().Block)), gather(c.stmts, from))
    items mut Array<typed.Item>&c = Array<typed.Item>(1)
    items[0] = typed.Item(ex, -1)
    cl := typed.Clause&[typed.Clause(sp, items, false, code, Array<typed.Expr&>(0))]
    return typed.Expr.Try(sp, typeOf(call), typed.Try(call, cl, false, true))
}

# a fallible call the loop makes with no try written: Exhausted aside, it may fail with nothing else (S9e)
fn (c mut Checker&) loopCall(sp source.Span, f I64, recv typed.Expr&c, args Array<typed.Expr&>&c) typed.Expr&c {
    fr := c.fr()
    ex := c.P.PreludeType("std/prelude/iterator", "Exhausted")
    mark := fr.leaks.Len()
    fr.Tries++
    c.lastErrs = types.ListId(0)
    x typed.Expr?&c = null
    if f < -1 {
        # an "any"'s Next (T32b): its slot -2 - f, called through the table
        r := c.P.T.AnyTrait(typeOf(recv))
        sl := c.P.AnySlots(r)[-2 - f]
        c.slotCall(r, -2 - f, sp)
        x = c.callBody(sp, sp, sl.Sig, typed.Callee.Dispatch(r, -2 - f, sl.Sig), -1, recv, Array<ast.Expr&>(0), args)
    } else {
        x = c.invoke(sp, sp, f, recv, Array<ast.Expr&>(0), args)
    }
    fr.Tries--
    for e in c.P.T.Items(c.lastErrs) {
        if c.P.T.ErrOf(e) != ex { fr.LoopFails++ }
    }
    # Exhausted ends the loop: no error of the body's
    keep Vec<types.TypeId>
    for i in range mark, fr.leaks.Len() {
        if c.P.T.ErrOf(fr.leaks[i]) != ex { keep.Push(fr.leaks[i]) }
    }
    fr.leaks.Truncate(mark)
    for e in keep { fr.leaks.Push(e) }
    return x!
}

# an iterator (S9a): the loop's own copy of it, Next() called each iteration, Exhausted ending the loop
fn (c mut Checker&) walkIter(sp source.Span, f ast.ForIn&, src typed.Expr&c, next I64, cm ast.Compr?&, ce types.TypeId) {
    it := c.hidden(sp, typeOf(src))
    if c.generatorCall(src) { c.cur().Walks.Push(typed.LocalId(I32(it))) }
    # D18e: a local walked here - its walk this loop's own where nothing else names it (settleHeldWalks)
    match src {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Lvalue.Local(_, _, g) {
                    if c.cur().Local(g).Kind == typed.LocalKind.Var { c.heldWalks.Push(heldCand(c.fr().Body, I64(g), it)) }
                }
                case _ { }
            }
        }
        case _ { }
    }
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(it)), src))
    k I64 = -1
    if f.Key != source.NameId(0) {
        k = c.hidden(sp, c.i64())
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(k)), c.lit(sp, c.i64(), 0)))
    }
    from := c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Loop, sp)
    c.fr().loops.Push(id)
    c.fr().exits.Push(id)
    call := c.loopCall(sp, next, c.readLocal(sp, it), Array<typed.Expr&>(0))
    v := c.exhaustedOrBreak(sp, call, id)
    c.elementLocals(sp, f, k, v)
    c.walkBody(f, cm, ce)
    try c.fr().loops.Pop() catch { }
    try c.fr().exits.Pop() catch { }
    b := c.close(id, outer, mark, from)
    c.emit(typed.Stmt.Loop(sp, b, c.countPost(sp, k)))
}

# D18e: whether x is a direct call of a generator function - its Generator made right where the walk is, which the
# hidden iterator alone then holds
fn (c mut Checker&) generatorCall(x typed.Expr&c) Bool {
    match x {
        case typed.Expr.Call(_, _, call) {
            match call.Target {
                case typed.Callee.Body(id) {
                    match c.Bodies[I64(id)].Of {
                        case typed.BodyOf.Fn(i) { return c.P.IsGenerator(c.P.InstanceFn(i)) }
                        nomatch { return false }
                    }
                }
                nomatch { return false }
            }
        }
        nomatch { return false }
    }
}

# the key and the value locals of an iteration
fn (c mut Checker&) elementLocals(sp source.Span, f ast.ForIn&, k I64, v typed.Expr&c) {
    if f.Key != source.NameId(0) and k >= 0 {
        key := c.local(f.Key, sp, c.i64(), typed.LocalKind.Var, typed.Mark.None)
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(key)), c.readLocal(sp, k)))
    }
    x := c.local(f.Name, sp, typeOf(v), typed.LocalKind.Var, typed.Mark.Infer)
    c.roLet(x, v)   # T25c: an element of a collection reached read-only is a read-only copy
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(x)), v))
}

# a loop's post clause counting k up by one; null where there is no k
fn (c mut Checker&) countPost(sp source.Span, k I64) typed.Block?&c {
    if k < 0 { return null }
    pfrom := c.stmts.Len()
    pid, pouter, pmark := c.open(typed.BlockKind.Post, sp)
    c.emit(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, c.i64(), typed.LocalId(I32(k)))
                             c.prim(sp, c.i64(), typed.PrimOp.Add, c.readLocal(sp, k), c.lit(sp, c.i64(), 1))))
    return c.close(pid, pouter, pmark, pfrom)
}

# the collection borrowed once, as a local reference (E12c)
fn (c mut Checker&) borrowedSource(sp source.Span, src typed.Expr&c) I64 {
    st := typeOf(src)
    rt := st if c.isRef(st) else c.P.T.Ref(st, types.ReadOnly)
    # T25c: a writable reference a read-only copy holds is walked read-only
    if c.isRef(st) and (c.P.T.PermOf(st) & types.Writable) != 0 and c.roRef(src) { rt = c.P.T.Ref(c.P.T.Referent(st), c.P.T.PermOf(st) & types.Owning) }
    coll := c.hidden(sp, rt)
    # T25c: a value borrowed is as read-only as the place it is (its elements read-only copies exactly then)
    c.roBorrows.Put(c.roKey(coll), c.roRef(src) if c.isRef(st) else c.roPlace(readPlace(src)))
    fx := c.fit(src, rt, sp)
    c.roTrack(coll, fx)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(coll)), fx))
    return coll
}

# a value stored in runs (S9f): RunFrom(at) asked where the last run ended, each run walked as an array; break leaves
# the whole walk
fn (c mut Checker&) walkRuns(sp source.Span, f ast.ForIn&, src typed.Expr&c, runs I64, cm ast.Compr?&, ce types.TypeId) {
    coll := c.borrowedSource(sp, src)
    at := c.hidden(sp, c.i64())
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(at)), c.lit(sp, c.i64(), 0)))
    k I64 = -1
    if f.Key != source.NameId(0) {
        k = c.hidden(sp, c.i64())
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(k)), c.lit(sp, c.i64(), 0)))
    }
    ofrom := c.stmts.Len()
    oid, oouter, omark := c.open(typed.BlockKind.Loop, sp)
    c.fr().loops.Push(oid)
    c.fr().exits.Push(oid)
    call := c.loopCall(sp, runs, c.readLocal(sp, coll), c.one(c.readLocal(sp, at)))
    rt := typeOf(call)
    run := c.hidden(sp, rt)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(run)), c.exhaustedOrBreak(sp, call, oid)))
    n := c.hidden(sp, c.i64())
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(n)), c.prim(sp, c.i64(), typed.PrimOp.Len, c.readLocal(sp, run), null)))
    j := c.hidden(sp, c.i64())
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(j)), c.lit(sp, c.i64(), 0)))
    # the run, walked as an array; break leaves the outer loop
    ifrom := c.stmts.Len()
    iid, iouter, imark := c.open(typed.BlockKind.Loop, sp)
    try c.fr().loops.Pop() catch { }
    c.fr().loops.Push(iid)
    c.emit(c.breakUnless(sp, c.prim(sp, types.BoolT, typed.PrimOp.Lt, c.readLocal(sp, j), c.readLocal(sp, n)), iid))
    ra := c.arrayOf(rt)
    base typed.Lvalue&c = typed.Lvalue.Deref(sp, c.deref(rt), c.readLocal(sp, run))
    e := c.read(sp, typed.Lvalue.Elem(sp, c.P.T.Elem(ra), typed.Elem(base, c.readLocal(sp, j), typed.Check.None)))
    c.elementLocals(sp, f, k, e)
    c.walkBody(f, cm, ce)
    try c.fr().loops.Pop() catch { }
    try c.fr().exits.Pop() catch { }
    ib := c.close(iid, iouter, imark, ifrom)
    pfrom := c.stmts.Len()
    pid, pouter, pmark := c.open(typed.BlockKind.Post, sp)
    c.emit(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, c.i64(), typed.LocalId(I32(j)))
                             c.prim(sp, c.i64(), typed.PrimOp.Add, c.readLocal(sp, j), c.lit(sp, c.i64(), 1))))
    if k >= 0 {
        c.emit(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, c.i64(), typed.LocalId(I32(k)))
                                 c.prim(sp, c.i64(), typed.PrimOp.Add, c.readLocal(sp, k), c.lit(sp, c.i64(), 1))))
    }
    pb := c.close(pid, pouter, pmark, pfrom)
    c.emit(typed.Stmt.Loop(sp, ib, pb))
    c.emit(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, c.i64(), typed.LocalId(I32(at)))
                             c.prim(sp, c.i64(), typed.PrimOp.Add, c.readLocal(sp, at), c.readLocal(sp, n))))
    ob := c.close(oid, oouter, omark, ofrom)
    c.emit(typed.Stmt.Loop(sp, ob, null))
}

# an indexable value (S9d): positions 0 to Len() - 1, Len() read every iteration, x each At(i)
fn (c mut Checker&) walkIndexed(sp source.Span, f ast.ForIn&, src typed.Expr&c, atm I64, lm I64, cm ast.Compr?&, ce types.TypeId) {
    coll := c.borrowedSource(sp, src)
    k := c.hidden(sp, c.i64())
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(k)), c.lit(sp, c.i64(), 0)))
    from := c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Loop, sp)
    c.fr().loops.Push(id)
    c.fr().exits.Push(id)
    # under try (S9e) the element is read by At, its errors the loop's (S9e)
    if f.Tried { c.fr().Tries++ }
    n := c.invoke(sp, sp, lm, c.readLocal(sp, coll), Array<ast.Expr&>(0), Array<typed.Expr&>(0))
    c.emit(c.breakUnless(sp, c.prim(sp, types.BoolT, typed.PrimOp.Lt, c.readLocal(sp, k), n), id))
    e := c.invoke(sp, sp, atm, c.readLocal(sp, coll), Array<ast.Expr&>(0), c.one(c.readLocal(sp, k)))
    if f.Tried { c.fr().Tries-- }
    c.elementLocals(sp, f, k, e)
    c.walkBody(f, cm, ce)
    try c.fr().loops.Pop() catch { }
    try c.fr().exits.Pop() catch { }
    b := c.close(id, outer, mark, from)
    pfrom := c.stmts.Len()
    pid, pouter, pmark := c.open(typed.BlockKind.Post, sp)
    c.emit(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, c.i64(), typed.LocalId(I32(k)))
                             c.prim(sp, c.i64(), typed.PrimOp.Add, c.readLocal(sp, k), c.lit(sp, c.i64(), 1))))
    pb := c.close(pid, pouter, pmark, pfrom)
    c.emit(typed.Stmt.Loop(sp, b, pb))
}

# for i in range [start,] end [, step] (S9b): upward, a count worked out once
fn (c mut Checker&) forRange(sp source.Span, f ast.ForIn&, rargs Array<ast.Expr&>&, cm ast.Compr?&, ce types.TypeId) typed.Expr?&c {
    # the first argument that is no literal gives the range its type; literals alone count in I64 (S9b)
    t types.TypeId = types.UnknownT
    vs Vec<typed.Expr?&>          # each argument's value, null for a literal - typed once t is known
    for a in rargs {
        fa := c.fold(a)
        if fa.Ok and fa.IsFloat {
            c.err(a.Span(), msgs.RangeNotInt("F64"))
            return null
        }
        if fa.Ok {
            vs.Push(null)
            continue
        }
        v := c.value(c.expr(a, types.UnknownT), a.Span())
        if typeOf(v) != types.UnknownT and not c.isInt(typeOf(v)) {
            c.err(a.Span(), msgs.RangeNotInt(c.ty(typeOf(v))))
            return null
        }
        if t == types.UnknownT and c.isInt(typeOf(v)) { t = typeOf(v) }
        vs.Push(v)
    }
    vals := vs.ToArray()
    if t == types.UnknownT {
        t = c.i64()
        # T6a/B11: the loop's variable an I64 by the range's literals - the note where it does not flow names its end
        e := rargs[0] if rargs.Len() == 1 else rargs[1]
        c.rangeEnd = e.Span()
        c.rangeEndLit = match e {
            case ast.Expr.Lit(_, _) => true
            case _ => false
        }
    }
    # S9b: a literal step is positive
    if rargs.Len() > 2 {
        fs := c.fold(rargs[2])
        if fs.Ok and not fs.IsFloat and not fs.Big and fs.I <= 0 {
            c.err(rargs[2].Span(), msgs.RangeStep())
            return null
        }
    }
    rfrom := c.exprs.Len()
    for i in range rargs.Len() {
        if vals[i] is null {
            c.exprs.Push(c.litOf(rargs[i], c.fold(rargs[i]), t))
        } else {
            c.exprs.Push(c.fit(vals[i]!, t, rargs[i].Span()))
        }
    }
    rv := gather(c.exprs, rfrom)
    start := c.lit(sp, t, 0)
    end typed.Expr?&c = null
    step := c.lit(sp, t, 1)
    if rargs.Len() == 1 {
        end = rv[0]
    } else {
        start = rv[0]
        end = rv[1]
        if rargs.Len() > 2 { step = rv[2] }
    }
    lo := c.hidden(sp, t)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(lo)), start))
    hi := c.hidden(sp, t)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(hi)), end!))
    st := c.hidden(sp, t)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(st)), step))
    # the count: (hi - lo + step - 1) / step where hi > lo and step > 0, else none
    diff := c.prim(sp, t, typed.PrimOp.Sub, c.readLocal(sp, hi), c.readLocal(sp, lo))
    num := c.prim(sp, t, typed.PrimOp.Sub, c.prim(sp, t, typed.PrimOp.Add, diff, c.readLocal(sp, st)), c.lit(sp, t, 1))
    more := c.prim(sp, types.BoolT, typed.PrimOp.Gt, c.readLocal(sp, hi), c.readLocal(sp, lo))
    up := c.prim(sp, types.BoolT, typed.PrimOp.Gt, c.readLocal(sp, st), c.lit(sp, t, 0))
    per typed.Expr&c = typed.Expr.Cond(sp, t, typed.Cond(up, c.prim(sp, t, typed.PrimOp.Div, num, c.readLocal(sp, st)), c.lit(sp, t, 0)))
    cnt typed.Expr&c = typed.Expr.Cond(sp, t, typed.Cond(more, per, c.lit(sp, t, 0)))
    n := c.hidden(sp, t)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(n)), cnt))
    k := c.hidden(sp, t)
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(k)), c.lit(sp, t, 0)))
    # T7c: a comprehension's count where every bound is known while compiling
    if cm is not null {
        known := Array<I64>(rargs.Len(), 0)
        all := true
        for i in range rargs.Len() {
            kv := c.knownInt(rargs[i])
            if kv < types.TypeId(0) { all = false } else { known[i] = c.P.T.ConstValue(kv) }
        }
        if all {
            lo0 := known[0] if rargs.Len() > 1 else 0
            hi0 := known[1] if rargs.Len() > 1 else known[0]
            st0 := known[2] if rargs.Len() > 2 else 1
            if st0 > 0 { c.comprKnown = (hi0 - lo0 + st0 - 1) / st0 if hi0 > lo0 else 0 }
        }
    }
    c.counted(sp, f, k, n, -1, types.UnknownT, lo, st, cm, ce)
    return c.readLocal(sp, n)
}

# the counted loop of a for-in: k from 0 below n, the element - coll's at k, or lo + k * st - and the position (the
# key) declared each turn
fn (c mut Checker&) counted(sp source.Span, f ast.ForIn&, k I64, n I64, coll I64, at types.TypeId, lo I64, st I64, cm ast.Compr?&, ce types.TypeId) {
    if cm is not null and c.comprState == 1 {
        if cm.Filter is null and c.comprKnown >= 0 and ce != types.UnknownT {
            # E27, T7c: a fixed array of the known count, declared with no value and written element by element
            ft := c.P.T.Array(ce, c.P.T.Const(c.i64(), c.comprKnown))
            out := c.hidden(sp, ft)
            c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(out)), c.lit(sp, ft, 0)))
            c.cur().Locals[out].Unset = true   # D13d: every element written before it is read
            c.comprOut, c.comprIdx, c.comprState = out, k, 3
        } else {
            c.comprOpen(sp)
        }
    }
    c.comprKnown = -1
    from := c.stmts.Len()
    id, outer, mark := c.open(typed.BlockKind.Loop, sp)
    c.fr().loops.Push(id)
    c.fr().exits.Push(id)
    c.emit(c.breakUnless(sp, c.prim(sp, types.BoolT, typed.PrimOp.Lt, c.readLocal(sp, k), c.readLocal(sp, n)), id))
    kt := c.localType(k)
    if f.Key != source.NameId(0) {
        key := c.local(f.Key, sp, kt, typed.LocalKind.Var, typed.Mark.None)
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(key)), c.readLocal(sp, k)))
    }
    e typed.Expr?&c = null
    if coll >= 0 {
        ct := c.localType(coll)
        base typed.Lvalue&c = typed.Lvalue.Deref(sp, c.P.T.Referent(ct), c.readLocal(sp, coll))
        e = c.read(sp, typed.Lvalue.Elem(sp, c.P.T.Elem(at), typed.Elem(base, c.readLocal(sp, k), typed.Check.None)))
    } else {
        e = c.prim(sp, kt, typed.PrimOp.Add, c.readLocal(sp, lo), c.prim(sp, kt, typed.PrimOp.Mul, c.readLocal(sp, k), c.readLocal(sp, st)))
    }
    x := c.local(f.Name, sp, typeOf(e), typed.LocalKind.Var, typed.Mark.Infer)
    if c.rangeEnd.Start >= 0 {
        c.rangeEnds.Put(pair.Pair(c.fr().Body, x), c.rangeEnd)
        if c.rangeEndLit { c.litLocals.Put(pair.Pair(c.fr().Body, x), true) } else { c.rangeExprs.Put(pair.Pair(c.fr().Body, x), true) }
        c.rangeEnd = source.Span(-1, -1)
    }
    c.roLet(x, e!) # T25c: an element of a collection reached read-only is a read-only copy
    c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(x)), e!))
    c.walkBody(f, cm, ce)
    try c.fr().loops.Pop() catch { }
    try c.fr().exits.Pop() catch { }
    b := c.close(id, outer, mark, from)
    pfrom := c.stmts.Len()
    pid, pouter, pmark := c.open(typed.BlockKind.Post, sp)
    next := c.prim(sp, kt, typed.PrimOp.Add, c.readLocal(sp, k), c.lit(sp, kt, 1))
    c.emit(typed.Stmt.Assign(sp, typed.Lvalue.Local(sp, kt, typed.LocalId(I32(k))), next))
    pb := c.close(pid, pouter, pmark, pfrom)
    c.emit(typed.Stmt.Loop(sp, b, pb))
}

# return v (S12): the value made to fit the result; several a tuple (D8c)
# S8e: whether a path is known not to be null where it is read
fn (c mut Checker&) nullKnown(path Array<source.NameId>&) Bool {
    if path.Len() == 0 { return false }
    for nn in c.fr().nulls {
        if not nn.Dead and samePath(nn.Path, path) { return true }
    }
    return false
}

# S8e: the paths a condition says are not null (positive) or are when it is false, held in block b - what a statement
# after them in that block assigns ends one
fn (c mut Checker&) pushNulls(guard ast.Expr&, positive Bool, b I64) {
    paths Vec<Array<source.NameId>&>
    nullTests(guard, positive, paths)
    for p in paths {
        # S8e, as S8d: a local or a parameter only - a field may change under a call
        if p.Len() == 1 { c.fr().nulls.Push(nullNarrow(source.NameId[n for n in p], b)) }
    }
}

# S8d: what a condition says where it holds (positive) or fails, held in block b - its null tests (S8e), its case
# tests, its error-value tests (R11b, T20): the one walk every narrowing place calls, so the three hold alike. A case
# narrowed has its payload's fields read here, emitted where the narrowing begins
fn (c mut Checker&) pushFacts(guard ast.Expr&, positive Bool, b I64) {
    c.pushNulls(guard, positive, b)
    c.pushErrNarrow(guard, positive, b)
    c.pushCases(guard, positive, b)
}

# S8d: the case tests a condition holds where it holds (positive) or fails - "e == C" where it holds, "e != C" where it
# fails, "and" where it holds, "or" where it fails, "not" turning it round
fn (c mut Checker&) pushCases(x ast.Expr&, positive Bool, b I64) {
    match x {
        case ast.Expr.Paren(_, y) { c.pushCases(y, positive, b) }
        case ast.Expr.Unary(_, op, y) {
            if op == token.Tok.Not { c.pushCases(y, not positive, b) }
        }
        case ast.Expr.Binary(sp, op, l, r) {
            if (op == token.Tok.And and positive) or (op == token.Tok.Or and not positive) {
                c.pushCases(l, positive, b)
                c.pushCases(r, positive, b)
                return
            }
            id, k := c.narrowOf(x, token.Tok.EqEq if positive else token.Tok.NotEq)
            if id >= 0 { c.narrow(sp, id, k, b) }
        }
        nomatch { }
    }
}

fn (c mut Checker&) factsHeld() factsMark {
    fr := c.fr()
    return factsMark(fr.nulls.Len(), fr.narrows.Len(), fr.errNarrows.Len())
}

# what narrowings were added since m dropped - an operand's, once it is checked
fn (c mut Checker&) factsDrop(m factsMark) {
    fr := c.fr()
    fr.nulls.Truncate(m.Nulls)
    fr.narrows.Truncate(m.Cases)
    fr.errNarrows.Truncate(m.Errs)
}

# the narrowings added since m ended where statements assign their locals (a loop's post clause after its body)
fn (c mut Checker&) killAssigned(m factsMark, body Array<ast.Stmt&>&) {
    fr := c.fr()
    for j in range m.Nulls, fr.nulls.Len() {
        nn := fr.nulls[j]
        if assignsName(body, nn.Path) { fr.nulls[j] = nullNarrow(nn.Path, nn.Block, true) }
    }
    for j in range m.Cases, fr.narrows.Len() {
        if assignsName(body, Array<source.NameId>(1, c.cur().Locals[fr.narrows[j].Local].Name)) { fr.narrows[j] = fr.narrows[j].Killed() }
    }
    for j in range m.Errs, fr.errNarrows.Len() {
        en := fr.errNarrows[j]
        if assignsName(body, Array<source.NameId>(1, en.Name)) { fr.errNarrows[j] = errNarrow(en.Name, en.Now, en.Block, true) }
    }
}

# x checked where condition k holds (positive) or fails (S8d): a case it narrows read where x begins, x and that read
# one value
fn (c mut Checker&) factsExpr(k ast.Expr&, positive Bool, x ast.Expr&, want types.TypeId) typed.Expr&c {
    held := c.factsHeld()
    sfrom := c.stmts.Len()
    c.pushFacts(k, positive, c.fr().Block)
    read := c.stmts.Len() > sfrom
    r := c.expr(x, want)
    if read { r = typed.Expr.Seq(x.Span(), typeOf(r), typed.Seq(gather(c.stmts, sfrom), r)) }
    c.factsDrop(held)
    return r
}

# a local's place: of the type it is known to have here - a reference narrowed not to be null (S8e)
fn (c mut Checker&) localPlace(sp source.Span, id I64) typed.Lvalue&c {
    t := c.localType(id)
    if c.P.T.IsNullable(t) and c.nullKnown(Array<source.NameId>(1, c.cur().Locals[id].Name)) { t = c.P.T.NonNull(t) }
    return typed.Lvalue.Local(sp, t, typed.LocalId(I32(id)))
}

# T2c: a read through a reference that may be null - only where a test says it is not (S8e), or through "x!"
fn (c mut Checker&) nullRead(p typed.Lvalue&) {
    t := p.Type()
    if not c.P.T.IsNullable(t) { return }
    sp := p.Span()
    c.err(sp, msgs.ReadMaybeNull(c.src(sp), c.ty(t), bangOf(c.src(sp))))
}

# T2c: where the type of a place assigned is written, for declNote - a local's or a parameter's, a struct's field's
fn (c mut Checker&) placeAt(p typed.Lvalue&) diag.Where {
    match p {
        case typed.Lvalue.Local(_, _, id) { return try c.fr().typeAt.Get(I64(id)) catch default diag.Where.Nowhere }
        case typed.Lvalue.Field(_, _, base, i) {
            match base {
                case typed.Lvalue.Payload(_, _, pl) {
                    # an enum case's payload field: its parameter in the case's declaration
                    d := c.P.T.DeclOf(c.deref(pl.Base.Type()))
                    cd := caseDecl(c.P.TypeDecl(d), pl.Tag)
                    if cd is null or cd.Payload.Len() == 0 or i >= cd.Payload.Len() { return diag.Where.Nowhere }
                    return c.markAt(c.P.DeclModule(d), cd.Payload[i].Ty)
                }
                nomatch { }
            }
            st := c.deref(base.Type())
            if not c.isStruct(st) { return diag.Where.Nowhere }
            return c.fieldDeclAt(st, i)
        }
        nomatch { return diag.Where.Nowhere }
    }
}

# T2c: how an empty array of t's referent is written: "" for text, Array<E>(0), a declared type's conversion of one
fn (c mut Checker&) emptyArray(t types.TypeId) String {
    r := c.deref(t)
    if r == c.textType() { return "\"\"" }
    was := c.spellQualified
    c.spellQualified = true
    e := "Array<" $c.ty(c.P.T.Elem(c.under(r))) ">(0)"
    out := $c.ty(r) "(" $e ")" if c.isNamed(r) else e
    c.spellQualified = was
    return out
}

# what code in this module writes before a name declared in module m: nothing for its own and the prelude's, else the
# alias it imports m by and a dot
fn (c mut Checker&) qualifierFor(m I64) String {
    if c.frames.Len() == 0 or m == c.fr().Mi { return "" }
    for imp in c.P.L.Mods[c.fr().Mi].Imports {
        if imp.Target != m { continue }
        alias := imp.Alias
        if alias.Len() == 0 {
            k := try imp.Spec.FindLast("/") catch default -1
            alias = imp.Spec[k + 1:]
        }
        return $alias "."
    }
    # a module this one does not import (reached through another): by its file's name, as an import of it would alias it
    if m >= 0 and m < c.P.L.Mods.Len() and not c.P.L.Mods[m].Prelude {
        id := c.P.L.Mods[m].Identity
        k := try id.FindLast("/") catch default -1
        return $id[k + 1:] "."
    }
    return ""
}

# T2c: where the result type of what x calls is written - a function's first result - for declNote
fn (c mut Checker&) calledAt(x typed.Expr&) diag.Where {
    match x {
        case typed.Expr.Call(_, _, cl) {
            match cl.Target {
                case typed.Callee.Body(id) {
                    if I64(id) >= c.Bodies.Len() { return diag.Where.Nowhere }
                    match c.Bodies[I64(id)].Of {
                        case typed.BodyOf.Fn(inst) {
                            f := c.P.InstanceFn(inst)
                            rs := c.P.FnDecl(f).S.Results
                            if rs.Len() == 0 { return diag.Where.Nowhere }
                            return c.markAt(c.P.FnModule(f), rs[0])
                        }
                        nomatch { }
                    }
                }
                nomatch { }
            }
        }
        nomatch { }
    }
    return diag.Where.Nowhere
}

# where the i-th field of a struct is declared with its type: its declaration in the constructor's body, or for a pun
# the parameter it takes
fn (c mut Checker&) fieldDeclAt(t types.TypeId, i I64) diag.Where {
    d := c.P.T.DeclOf(t)
    td := c.P.TypeDecl(d)
    if td is null or td.Body is null { return diag.Where.Nowhere }
    mi := c.P.DeclModule(d)
    match td.Body {
        case ast.TypeBody.Struct(st) {
            if st.Body.Len() == 0 { return diag.Where.Nowhere }
            k I64 = 0
            for stmt in st.Body {
                match stmt {
                    case ast.Stmt.Var(_, v) {
                        if not v.Field { continue }
                        for n in v.Names {
                            if k == i {
                                if v.Ty is not null { return c.markAt(mi, v.Ty) }
                                if st.Params.Len() > 0 and not v.Infer {
                                    for prm in st.Params { if prm.Name == n { return c.markAt(mi, prm.Ty) } }
                                }
                                return diag.Where.Nowhere
                            }
                            k++
                        }
                    }
                    nomatch { }
                }
            }
        }
        nomatch { }
    }
    return diag.Where.Nowhere
}

# T2c: where the current function's i-th result type is written, for declNote
fn (c mut Checker&) resultAt(i I64) diag.Where {
    id := c.fr().Body
    if id < 0 or id >= c.Bodies.Len() { return diag.Where.Nowhere }
    match c.Bodies[id].Of {
        case typed.BodyOf.Fn(inst) {
            f := c.P.InstanceFn(inst)
            rs := c.P.FnDecl(f).S.Results
            if rs.Len() == 0 or i >= rs.Len() { return diag.Where.Nowhere }
            return c.markAt(c.P.FnModule(f), rs[i])
        }
        nomatch { return diag.Where.Nowhere }
    }
}

fn (c mut Checker&) returnStmt(sp source.Span, values Array<ast.Expr&>&) {
    fr := c.fr()
    nv := values.Len() if values.Len() > 0 else 0
    # S15: a test passes by a bare return; a constructor gives no value (C2b)
    if fr.InTest {
        if nv > 0 {
            c.err(sp, msgs.ReturnInTest())
            return
        }
        c.emit(typed.Stmt.Return(sp, null))
        return
    }
    if fr.InCtor {
        c.err(sp, msgs.ReturnInCtor())
        return
    }
    if fr.Result == types.NoreturnT {
        c.err(source.Span(sp.Start, sp.Start + 6), msgs.ReturnInNoreturn())
        return
    }
    if fr.InTaskClause {
        c.err(sp, msgs.TaskClauseReturns())
        return
    }
    if fr.MsgLoops >= 0 {
        c.err(source.Span(sp.Start, sp.Start + 6), msgs.AssertMsgReturns(c.msgOwner(fr.MsgOfUnreachable)))
        c.emit(typed.Stmt.Return(sp, null))   # said: the path still leaves, for R11 and D10a
        return
    }
    if fr.DeferLoops >= 0 {
        c.err(source.Span(sp.Start, sp.Start + 6), msgs.DeferReturns())
        c.emit(typed.Stmt.Return(sp, null))   # said: the path still leaves, for R11 and D10a
        return
    }
    if fr.Gen {
        # D18a: a generator's return ends it - its Next fails with Exhausted from here on
        if nv > 0 { c.err(source.Span(sp.Start, sp.Start + 6), msgs.GenReturnValue()) }
        c.emit(c.genEnd(sp))
        return
    }
    if fr.InferResult {
        c.inferReturn(sp, values)
        return
    }
    rt := fr.Result
    if nv == 0 {
        if rt != types.VoidT and rt != types.UnknownT {
            c.err(sp, msgs.ReturnNeedsValue(c.ty(rt)))
            return
        }
        c.emit(typed.Stmt.Return(sp, null))
        return
    }
    if values.Len() == 1 {
        if rt == types.VoidT {
            c.err(sp, msgs.ReturnValueInVoid())
            return
        }
        wasNull := c.nullDecl
        c.nullDecl = c.resultAt(0)
        x := c.exprTo(values[0], rt)
        c.nullDecl = wasNull
        if rt == c.textType() and c.isRef(typeOf(x)) { x = c.read(sp, typed.Lvalue.Deref(sp, rt, x)) }
        if not c.isRef(rt) { c.roStore(x, values[0].Span(), RoReturned) } # T25c: the caller holds it writably
        c.emit(typed.Stmt.Return(sp, x))
        return
    }
    if c.P.T.KindOf(rt) != types.Kind.Tuple {
        c.gap(sp, "several values returned where one is the result")
        return
    }
    ps := c.P.T.Items(c.P.T.Parts(rt))
    if ps.Len() != values.Len() {
        c.gap(sp, "a count of returned values other than the result's")
        return
    }
    from := c.exprs.Len()
    for i in range values.Len() {
        wasNull := c.nullDecl
        c.nullDecl = c.resultAt(i)
        c.exprs.Push(c.exprTo(values[i], ps[i]))
        c.nullDecl = wasNull
    }
    xs := gather(c.exprs, from)
    c.emit(typed.Stmt.Return(sp, typed.Expr.Make(sp, rt, typed.Make(typed.MakeKind.Tuple, 0, xs, null, typed.SiteId(-1)
                                                                   typed.Check.None))))
}

# ---- tail calls (S21) ----

# a become statement: the body it is in, the callee's body, where it is
type tailAsk struct(Caller I64, Callee I64, Sp source.Span, Mi I64) {
    Caller, Callee, Sp, Mi
}

# "become f(x)" (S21): the function becomes the call - its scopes are closed, then the call made in its place, its result
# and its failure the function's own (so no try is written, nor allowed). Checked as "return f(x)" would be - its
# argument judged by section 8 as no storage of a scope it closes (scope.olang), its error set beside the callee's once
# every set is final (tailSets) - and held to what a guaranteed jump needs: a named function's or method's call, in
# one, of the same signature
fn (c mut Checker&) becomeStmt(sp source.Span, x ast.Expr&) {
    fr := c.fr()
    bsp := source.Span(sp.Start, sp.Start + 6)
    where := c.becomeWhere()
    if where != "" {
        c.err(bsp, msgs.BecomeOutside(where))
        c.emit(typed.Stmt.Return(sp, null))
        return
    }
    inner := ""
    if fr.DeferLoops >= 0 {
        inner = "deferred code, which runs while its block is left"
    } else if fr.MsgLoops >= 0 {
        inner = "an assert's or an unreachable's message"
    } else if fr.InTaskClause {
        inner = "a task's clause"
    } else if fr.joins.Len() > 0 {
        inner = "a join block, whose tasks it would leave behind"
    } else if fr.deferBlocks.Len() > 0 {
        inner = "a block with deferred code registered, which would run before the call"
    }
    if inner != "" {
        c.err(bsp, msgs.BecomeInside(inner))
        c.emit(typed.Stmt.Return(sp, null))
        return
    }
    shape := match x {
        case ast.Expr.Call(_, _, _) => ""
        case ast.Expr.Try(_, _, _) => "try"
        case ast.Expr.ScopeCall(_, _, _, _) => "a call given a scope argument (E25), whose result lives where that says"
        case _ => "no call"
    }
    if shape == "try" {
        c.err(x.Span(), msgs.BecomeTry())
        c.emit(typed.Stmt.Return(sp, null))
        return
    }
    if shape != "" {
        c.err(x.Span(), msgs.BecomeNotCall(shape))
        c.emit(typed.Stmt.Return(sp, null))
        return
    }
    rt := fr.Result
    c.fr().Tries++
    v := c.expr(x, rt)
    c.fr().Tries--
    callee I64 = -1
    sig := c.Bodies[fr.Body].Ty
    what := "no call of a function"
    match v {
        case typed.Expr.Call(_, _, cl) {
            match cl.Target {
                case typed.Callee.Body(id) {
                    match c.Bodies[I64(id)].Of {
                        case typed.BodyOf.Fn(inst) {
                            if not c.P.FnDecl(c.P.InstanceFn(inst)).Export { callee = I64(id) } else { what = "an export fn's call" }
                        }
                        case typed.BodyOf.Ctor(_, _), typed.BodyOf.Case(_, _) { what = "a constructor's call" }
                        nomatch { what = "a lambda's call" }
                    }
                }
                case typed.Callee.Extern(_) { what = "an extern fn's call" }
                case typed.Callee.Value(_) { what = "a call through a function value" }
                case typed.Callee.Dispatch(_, _, _) { what = "a call through an any" }
                case typed.Callee.Helper(_, _) { what = "a call of what the compiler supplies" }
            }
        }
        nomatch { }
    }
    if typeOf(v) == types.UnknownT { return }
    if callee < 0 {
        c.err(x.Span(), msgs.BecomeNotCall(what))
        c.emit(typed.Stmt.Return(sp, null))
        return
    }
    csig := c.Bodies[callee].Ty
    if not c.sameJump(sig, csig) {
        c.err(c.calleeSpan(x), msgs.BecomeSignature(c.jumpText(sig), c.jumpText(csig)))
        c.emit(typed.Stmt.Return(sp, null))
        return
    }
    if c.viaMemoryJump(sig) {
        c.err(c.calleeSpan(x), msgs.BecomeMemory())
        c.emit(typed.Stmt.Return(sp, null))
        return
    }
    c.tails.Push(tailAsk(fr.Body, callee, sp, fr.Mi))
    match v {
        case typed.Expr.Call(csp, ty, cl) {
            c.emit(typed.Stmt.Return(sp, typed.Expr.Call(csp, ty, typed.Call(cl.Target, cl.Args, cl.Scoped, cl.Site, cl.Zero, true))))
        }
        nomatch { }
    }
}

# where a become cannot stand, as its error names it: "" in a function or a method declared with fn
fn (c mut Checker&) becomeWhere() String {
    fr := c.fr()
    if fr.InTest { return "a test" }
    if fr.InCtor { return "a constructor" }
    if fr.Inst >= 0 { return "a destructor" }
    if fr.Parent >= 0 or fr.Gen { return "a lambda or a generator's body" }
    if fr.Body < 0 { return "here" }
    match c.Bodies[fr.Body].Of {
        case typed.BodyOf.Fn(inst) {
            f := c.P.InstanceFn(inst)
            fd := c.P.FnDecl(f)
            if fd.Export { return "an export fn, which C calls" }
            if fd.Recv is null and c.text(fd.Name) == "main" and c.P.FnModule(f) == c.P.L.Root { return "main" }
            return ""
        }
        nomatch { return "here" }
    }
}

# whether two functions' signatures are one jump's (S21): the same parameters in order - types, permissions and where
# their references live - and the same result, so that the call is made with what the function was given
fn (c mut Checker&) sameJump(a types.TypeId, b types.TypeId) Bool {
    t := c.P.T
    pa := t.Items(t.Params(a))
    pb := t.Items(t.Params(b))
    if pa.Len() != pb.Len() { return false }
    for i in range pa.Len() {
        if not t.Same(pa[i], pb[i]) or t.PermOf(pa[i]) != t.PermOf(pb[i]) { return false }
    }
    if not t.Same(t.Result(a), t.Result(b)) { return false }
    if not t.ScopesFit(a, b) or not t.ScopesFit(b, a) { return false }
    return c.P.T.ScopeVarsOf(a).Len() == c.P.T.ScopeVarsOf(b).Len()
}

# a signature as a become's error writes it, its error set left out (that is compared once it is final)
fn (c mut Checker&) jumpText(sig types.TypeId) String {
    return c.ty(c.P.T.Func(c.P.T.Params(sig), c.P.T.Result(sig), types.ListId(0)))
}

# whether a function passes a parameter, or gives its result, through memory (types.ViaMemory, over 128 bytes): the
# caller's frame would hold it, which a jump leaves
fn (c mut Checker&) viaMemoryJump(sig types.TypeId) Bool {
    for p in c.P.T.Items(c.P.T.Params(sig)) { c.P.Layout(p) }
    r := c.P.T.Result(sig)
    if r != types.VoidT and r != types.NoreturnT {
        c.P.Layout(r)
        if c.P.T.ViaMemory(r) { return true }
    }
    for ch in c.P.T.Passing(sig) {
        if ch == 'm' { return true }
    }
    return false
}

# S21, once every set is final: a become's function fails with what its callee does, in one order - the callee's failure
# is the function's own; and nothing the function holds runs a destructor when its scopes close (O16), which would run
# before the call
fn (c mut Checker&) tailSets() {
    for a in c.tails {
        ea := c.bodyErrors(a.Caller)
        eb := c.bodyErrors(a.Callee)
        c.push(-1, a.Mi, types.VoidT, types.ListId(0))
        c.fr().File = c.Bodies[a.Caller].File
        xs := c.P.T.Items(ea)
        ys := c.P.T.Items(eb)
        same := xs.Len() == ys.Len()
        if same {
            for i in range xs.Len() {
                if not c.P.T.Same(xs[i], ys[i]) { same = false }
            }
        }
        bsp := source.Span(a.Sp.Start, a.Sp.Start + 6)
        if not same { c.err(bsp, msgs.BecomeErrors(c.errsText(ea), c.errsText(eb))) }
        b := c.Bodies[a.Caller]
        seen Map<types.TypeId, Bool>
        for l in b.Locals {
            if l.Kind == typed.LocalKind.Param { continue }
            if c.holdsDtor(l.Ty, seen) {
                rec := c.err(bsp, msgs.BecomeDestructor($"it holds a value of " $c.ty(l.Ty) ", which may hold an instance"))
                c.P.L.Diags.Note(rec, c.at(l.Sp), msgs.NoteHere())
                break
            }
        }
        c.pop()
    }
}

# whether a value of a type may hold an instance whose destructor is to run (C11, O16) - or a value of a type not known
# here: an any's instance, a type variable's
fn (c mut Checker&) holdsDtor(ty types.TypeId, seen mut Map<types.TypeId, Bool>&) Bool {
    t := c.P.T
    r := t.Repr(ty)
    if seen.Has(r) { return try seen.Get(r) catch default false }
    seen.Put(r, false)
    k := t.KindOf(r)
    out := false
    if k == types.Kind.Ref {
        out = c.holdsDtor(t.Referent(r), seen)
    } else if k == types.Kind.Any or k == types.Kind.Var {
        out = true
    } else if k == types.Kind.Array {
        out = c.holdsDtor(t.Elem(r), seen)
    } else if k == types.Kind.Tuple or k == types.Kind.Record {
        for p in t.Items(t.Parts(r)) {
            if c.holdsDtor(p, seen) { out = true }
        }
    } else if k == types.Kind.Named {
        if not t.HasBody(r) {
            out = true
        } else if t.Destructs(r) {
            out = true
        } else {
            for f in t.Items(t.Fields(r)) {
                if c.holdsDtor(f, seen) { out = true }
            }
            for cs in t.Items(t.Cases(r)) {
                if cs != types.TypeId(0) and c.holdsDtor(cs, seen) { out = true }
            }
        }
    }
    seen.Put(r, out)
    return out
}

# ---- generators (D18, S20) ----

# "yield v" (S20): v given to the Next that asked, the generator's body going on from here at the next one - checked as
# the value its Next returns, so what it may be is what a return of it may (O13, O14, O26)
fn (c mut Checker&) yieldStmt(sp source.Span, x ast.Expr&) {
    fr := c.fr()
    ysp := source.Span(sp.Start, sp.Start + 5)
    if not fr.Gen {
        c.err(ysp, msgs.YieldInLambda() if fr.Parent >= 0 and fr.DeferLoops < 0 else msgs.YieldOutside())
        c.expr(x, types.UnknownT)
        return
    }
    if fr.DeferLoops >= 0 {
        c.err(ysp, msgs.YieldInDefer())
        return
    }
    if fr.joins.Len() > 0 {
        c.err(ysp, msgs.YieldInJoin())
        return
    }
    if fr.deferBlocks.Len() > 0 {
        c.err(ysp, msgs.YieldPastDefer())
        return
    }
    rt := fr.Result
    wasNull := c.nullDecl
    c.nullDecl = c.resultAt(0)
    v := c.exprTo(x, rt)
    c.nullDecl = wasNull
    if rt == c.textType() and c.isRef(typeOf(v)) { v = c.read(sp, typed.Lvalue.Deref(sp, rt, v)) }
    if not c.isRef(rt) { c.roStore(v, x.Span(), RoReturned) }   # T25c: the caller holds it writably
    c.emit(typed.Stmt.Suspend(sp, v))
}

# where a generator's body ends (D18a): its Next fails with Exhausted, now and whenever it is asked after
fn (c mut Checker&) genEnd(sp source.Span) typed.Stmt&c {
    return typed.Stmt.Raise(sp, c.P.PreludeType("std/prelude/iterator", "Exhausted"), 0)
}

# a generator's result, Iterator<T ? E> (D18): no type of its own to meet, its arguments each as any type written is -
# its element, where it names a scope, borrowed from a reference parameter or living where the generator does (D18c)
fn (c mut Checker&) genResultMet(f I64, r ast.TypeRef&) {
    match r {
        case ast.TypeRef.Named(_, _, args) {
            if args.Len() == 0 { return }
            for a in args {
                if not generic.IsErrsArgOf(a) { c.writtenMet(a) }
            }
            c.genElemMet(f, args[0])
        }
        nomatch { }
    }
}

# D18c: a generator's element naming a scope - "T&p", p a reference parameter, or "T&return" - read-only, never null
fn (c mut Checker&) genElemMet(f I64, a ast.TypeRef&) {
    el := c.P.GenElem(f)
    if el == generic.GenPerTurn { return }
    x := a
    writable := false
    match x {
        case ast.TypeRef.Perm(_, of, w, _) {
            writable = w
            if of is not null { x = of }
        }
        nomatch { }
    }
    match x {
        case ast.TypeRef.Ref(sp, _, sc, nullable) {
            if writable { c.err(a.Span(), msgs.GenElemWritable()) }
            if nullable { c.err(sp, msgs.GenElemNullable()) }
            name := c.text(sc)
            at := try c.src(sp).Find($"&" $name) catch default -1
            nsp := source.Span(sp.Start + I32(at + 1), sp.Start + I32(at + 1 + name.Len())) if at >= 0 else sp
            if el == generic.GenBadScope {
                c.err(nsp, msgs.GenElemScopeUnknown(c.tok(sc)))
            } else if el >= 0 {
                ps := c.P.T.Items(c.P.T.Params(c.P.Sig(f)))
                if el < ps.Len() and not c.isRef(ps[el]) {
                    c.err(nsp, msgs.GenElemByValue(c.tok(sc), $name " " $c.ty(ps[el]) "&"))
                }
            }
        }
        nomatch { }
    }
}

# a generator's own body (D18): "return Generator(next)", next a lambda - the Next its value calls - capturing the
# generator's parameters where it is made and holding the body written. Its requirements (D17) are checked on entry
fn (c mut Checker&) genRoot(fd ast.Func&, sig types.TypeId, el I64) typed.Block&c {
    sp := fd.Sp
    from := c.stmts.Len()
    gt := c.P.T.Result(sig)
    csig := c.P.CtorSig(gt)
    if csig == types.UnknownT or c.P.T.Items(c.P.T.Params(csig)).Len() != 1 {
        c.gap(sp, "a generator whose Generator has no constructor")
        return typed.Block(typed.BlockId(0), gather(c.stmts, from))
    }
    ft := c.P.T.Items(c.P.T.Params(csig))[0]
    # D18c: elements living where the generator does are kept in storage of its result scope - which its Next reaches
    # through a capture of a reference living there, null, made for it
    home I64 = -1
    if el == generic.GenFromReturn {
        ht := c.P.T.Ref(gt, types.ReadOnly | types.Nullable)
        home = c.local(source.NameId(0), sp, ht, typed.LocalKind.Hidden, typed.Mark.Return)
        c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(home)), c.lit(sp, ht, 0)))
    }
    next := c.genLambda(fd, ft, el, home)
    ctor := c.ctorBody(gt)
    was := c.ctorCalled
    c.ctorCalled = gt
    call := c.callBody(sp, sp, csig, typed.Callee.Body(typed.BodyId(I32(ctor))), -1, null, Array<ast.Expr&>(0), typed.Expr&[next])
    c.ctorCalled = was
    c.emit(typed.Stmt.Return(sp, call))
    return typed.Block(typed.BlockId(0), gather(c.stmts, from))
}

# a generator's Next (D18): a lambda of type ft, no parameters, its result the element and its errors E and Exhausted.
# The generator's parameters are its locals, each set once, from what was captured where the generator was made, as its
# body begins - so they are written as a function's are, and are its own from then on
fn (c mut Checker&) genLambda(fd ast.Func&, ft types.TypeId, el I64, home I64) typed.Expr&c {
    sp := fd.Sp
    parent := c.fr()
    pfi := c.frames.Len() - 1
    id := c.newBody(typed.BodyOf.Lambda(typed.BodyId(I32(parent.Body))), ft, parent.Mi, sp)
    c.state[id] = 1
    fr := c.push(id, parent.Mi, c.P.T.Result(ft), c.P.T.Errors(ft))
    fr.Ctx = parent.Ctx
    fr.Parent = pfi
    fr.Gen = true
    c.cur().Gen = true
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    c.cur().SetVars(c.P.ScopeVarsOf(c.cur().Ty))
    from := c.stmts.Len()
    pb := c.Bodies[parent.Body]
    if el == generic.GenBadScope { c.Bodies[id].GenBad = true }   # genElemMet's error: its yields judged no further
    if home >= 0 {
        # D18c: where the generator lives, captured - the scope "&return" names in its body, its elements' (GenHome)
        ht := pb.Locals[home].Ty
        b := c.Bodies[id]
        inner := I64(b.AddLocal(typed.Local(source.NameId(0), sp, ht, typed.BlockId(0), typed.LocalKind.Capture, typed.Mark.Infer)))
        fr.captures.Push(typed.Capture(typed.LocalId(I32(inner)), c.read(sp, typed.Lvalue.Local(sp, ht, typed.LocalId(I32(home))))))
        b.Vars.Push(typed.ScopeVar.Capture(typed.LocalId(I32(inner))))
        b.GenElem = typed.LocalId(I32(inner))
        b.GenHome = true
        fr.GenHome = inner
    }
    args Vec<I64>
    whole := true
    k I64 = -1
    for p in pb.Params {
        k++
        pl := pb.Locals[I64(p)]
        if pl.Name == source.NameId(0) or c.text(pl.Name) == "_" {
            whole = false
            continue
        }
        cap := c.captureIn(c.frames.Len() - 1, pl.Name, pl.Sp)
        if cap < 0 { continue }
        # D18c: the parameter its elements borrow from - where what it refers to lives (one by value is genElemMet's
        # error, and then its yields are judged no further)
        if k == el {
            if c.isRef(c.localType(cap)) { c.cur().GenElem = typed.LocalId(I32(cap)) } else { c.cur().GenBad = true }
        }
        ct := c.localType(cap)
        x := c.readLocal(pl.Sp, cap)
        # a value array is captured as a read-only borrow (T7b): the local is the array, copied
        if ct != pl.Ty and c.isRef(ct) and not c.isRef(pl.Ty) { x = c.read(pl.Sp, typed.Lvalue.Deref(pl.Sp, pl.Ty, x)) }
        mark := typed.Mark.Infer if c.isRef(pl.Ty) or c.P.T.HoldsRefs(pl.Ty) else typed.Mark.None
        l := c.local(pl.Name, pl.Sp, pl.Ty, typed.LocalKind.Var, mark)
        c.emit(typed.Stmt.Let(pl.Sp, typed.LocalId(I32(l)), x))
        args.Push(l)
    }
    # its contract (D17): checked as its first Next begins, a false condition that Next's ArgumentError (D18)
    if c.hasContract(parent.Body) {
        if whole { c.contractChecks(parent.Body, args, true) } else { c.gap(sp, "a generator with a contract and an unnamed parameter") }
    }
    storedIn(fd.Body, c.fr().stored)
    if fd.Body.Len() > 0 { c.stmtsOf(fd.Body) }
    root := typed.Block(typed.BlockId(0), gather(c.stmts, from))
    if not leavesBlock(root) {
        # D18a: falling off its end ends it
        for st in root.Stmts { c.stmts.Push(st) }
        c.emit(c.genEnd(source.Span(sp.End - 1, sp.End)))
        root = typed.Block(typed.BlockId(0), gather(c.stmts, from))
    }
    c.cur().Root = root
    caps := c.fr().captures.ToArray()
    c.pop()
    c.state[id] = 2
    return typed.Expr.Fn(sp, ft, typed.FnVal.Lambda(typed.BodyId(I32(id)), caps, c.site(typed.SiteKind.Closure, sp)))
}

# a lambda's first return (D16b): its values checked with nothing expected, the result their types - none for no
# value, text a String, a literal its own type
fn (c mut Checker&) inferReturn(sp source.Span, values Array<ast.Expr&>&) {
    fr := c.fr()
    fr.InferResult = false
    if values.Len() == 0 {
        fr.Result = types.VoidT
        c.emit(typed.Stmt.Return(sp, null))
        return
    }
    from := c.exprs.Len()
    ts := Array<types.TypeId>(values.Len())
    for i in range values.Len() {
        e := c.value(c.expr(values[i], types.UnknownT), values[i].Span())
        t := typeOf(e)
        if t == types.NullT or t == types.VoidT {
            c.err(values[i].Span(), msgs.LambdaResultUninferable())
            t = types.UnknownT
        } else if t != types.UnknownT {
            t = c.inferred(values[i], e)
        }
        ts[i] = t
        c.exprs.Push(c.fit(e, t, values[i].Span()))
    }
    xs := gather(c.exprs, from)
    if ts.Len() == 1 {
        fr.Result = ts[0]
        x := xs[0]
        if ts[0] == c.textType() and c.isRef(typeOf(x)) { x = c.read(sp, typed.Lvalue.Deref(sp, ts[0], x)) }
        c.emit(typed.Stmt.Return(sp, x))
        return
    }
    fr.Result = c.P.T.Tuple(c.P.T.List(ts))
    c.emit(typed.Stmt.Return(sp, typed.Expr.Make(sp, fr.Result, typed.Make(typed.MakeKind.Tuple, 0, xs, null
                                                                          typed.SiteId(-1), typed.Check.None))))
}

# an assert's or an unreachable's message (S17, S16d): text, evaluated only where the assert fails or the unreachable is
# reached - nothing may leave it; null for none
fn (c mut Checker&) message(msg ast.Expr?&, ofUnreachable Bool) typed.Expr?&c {
    if msg is null { return null }
    fr := c.fr()
    was, wasOf := fr.MsgLoops, fr.MsgOfUnreachable
    fr.MsgLoops = fr.loops.Len()
    fr.MsgOfUnreachable = ofUnreachable
    me := c.expr(msg, c.P.T.Ref(c.textType(), types.ReadOnly))
    c.fr().MsgLoops = was
    c.fr().MsgOfUnreachable = wasOf
    mt := c.deref(typeOf(me))
    if mt != types.UnknownT and not c.sameRepr(mt, c.textType()) {
        c.err(msg.Span(), msgs.AssertMessageNotText(c.ty(typeOf(me)), c.msgOwner(ofUnreachable)))
        return null
    }
    return c.fit(me, c.P.T.Ref(c.textType(), types.ReadOnly), msg.Span())
}

# whose message a diagnostic names: "an assert's" or "an unreachable's"
fn (c Checker&) msgOwner(ofUnreachable Bool) String& { return "an unreachable's" if ofUnreachable else "an assert's" }

fn (c mut Checker&) jump(sp source.Span, kind token.Tok, msg ast.Expr?& = null) {
    if kind == token.Tok.Break or kind == token.Tok.Continue {
        fr := c.fr()
        if fr.loops.Len() == 0 and fr.InTaskClause {
            c.err(sp, msgs.TaskClauseLoopJump(msgs.Tok(kind.Text())))
            return
        }
        if fr.MsgLoops >= 0 and fr.loops.Len() <= fr.MsgLoops {
            c.err(sp, msgs.AssertMsgLoopJump(msgs.Tok(kind.Text()), c.msgOwner(fr.MsgOfUnreachable)))
            return
        }
        if fr.DeferLoops >= 0 and fr.loops.Len() <= fr.DeferLoops {
            c.err(sp, msgs.DeferLoopJump(msgs.Tok(kind.Text())))
            return
        }
        if fr.loops.Len() == 0 {
            c.err(sp, msgs.BreakOutsideLoop(msgs.Tok(kind.Text())))
            return
        }
        l := fr.loops[fr.loops.Len() - 1]
        if l == -2 {
            c.err(sp, msgs.ForInClauseExit())
            return
        }
        if kind == token.Tok.Break { l = fr.exits[fr.exits.Len() - 1] }
        jk := typed.JumpKind.Break if kind == token.Tok.Break else typed.JumpKind.Continue
        c.emit(typed.Stmt.Jump(sp, jk, typed.BlockId(I32(l))))
        return
    }
    if kind == token.Tok.Unreachable { c.emit(typed.Stmt.Exit(sp, typed.ExitKind.Unreachable, c.message(msg, true))) }
}

# error E.WORD (R3)
fn (c mut Checker&) raise(sp source.Span, word ast.Path?&) {
    if c.fr().InTaskClause {
        c.err(sp, msgs.TaskClauseError())
        return
    }
    if c.fr().DeferLoops >= 0 {
        c.err(source.Span(sp.Start, sp.Start + 5), msgs.DeferErrorEscapes())
        return
    }
    if c.fr().MsgLoops >= 0 {
        c.err(source.Span(sp.Start, sp.Start + 5), msgs.AssertMsgError(c.msgOwner(c.fr().MsgOfUnreachable)))
        return
    }
    if word is null { return }
    # R3a, T20: "error e", an error value raised - a local's or a global's
    hk := c.P.R.Use(c.fr().File, word.Sp.Start).Kind
    if word.Parts.Len() == 1 and (hk == names.What.Local or hk == names.What.Global) {
        x := c.name(word.Sp, word.Parts[0])
        if x is null { return }
        t := typeOf(x)
        if t == types.UnknownT { return }
        if not c.P.T.IsErrVal(t) {
            c.err(word.Sp, msgs.RaiseNotCaught(c.tok(word.Parts[0])))
            return
        }
        c.reraise(sp, x)
        return
    }
    w, et := c.errorWord(word)
    if w < 0 {
        c.P.ErrorItemKnown(c.fr().Ctx, word)
        return
    }
    raised := c.P.T.ErrWords(et, U64(1) << w) if w < 64 else et
    fr := c.fr()
    # R3, R1c: a written set holds the type, and the word where it names words
    if not fr.InferErrors and not fr.InTest {
        have := types.UnknownT
        for h in c.P.T.Items(fr.Errors) {
            if c.P.T.ErrOf(h) == et { have = h }
        }
        # said, the path still leaves (D10a)
        if have == types.UnknownT {
            c.err(c.pathPart(word, 1), msgs.ErrorUndeclared(c.ty(et)))
        } else if c.uncovered(fr.Errors, raised) != types.UnknownT {
            c.err(c.pathPart(word, 0), msgs.ErrorWordNotInSet(c.ty(have)))
        }
    }
    c.leaks1(raised)
    c.emit(typed.Stmt.Raise(sp, et, w))
}

# ---- match (S12b, S13, G15) ----

# a match statement: its arms in order, the first whose pattern and guard hold run (S13); "match T" on a type variable
# is decided for this instance, its chosen arm alone checked (G15)
fn (c mut Checker&) matchStmt(sp source.Span, m ast.Match&) {
    if not m.OnType and c.errMatch(m) {
        c.caughtMatch(sp, m)
        return
    }
    if m.OnType {
        k := c.matchOnType(m)
        if k == -2 { return }
        cs := m.NoMatch if k < 0 else m.Cases[k]
        if cs is null { return }
        was := c.bindCase()
        if cs.Body.Len() > 0 { c.emit(typed.Stmt.Block(sp, c.blockOf(cs.Body, typed.BlockKind.Plain, cs.Sp))) }
        c.unbindCase(was)
        return
    }
    # G30, G35: a match on an instance's length, or on a reflected member, is decided for it - the chosen clause alone
    # checked
    k := c.reflMatch(m)
    if k == -2 { k = c.lenMatch(m) }
    if k != -2 {
        cs := m.NoMatch if k < 0 else m.Cases[k]
        if cs is not null and cs.Body.Len() > 0 { c.emit(typed.Stmt.Block(sp, c.blockOf(cs.Body, typed.BlockKind.Plain, cs.Sp))) }
        return
    }
    c.emit(typed.Stmt.Eval(sp, c.matchExpr(sp, m, false, types.VoidT)))
}

# the clause a match on a length this instance binds chooses (G30): its index, -1 for its nomatch or none, -2 where the
# match is no such one - its subject reads no such length or does not fold, or a clause has a guard or a pattern that
# is no value folding while compiling
fn (c mut Checker&) lenMatch(m ast.Match&) I64 {
    if not c.readsConst(m.Subject) { return -2 }
    v := c.P.FoldKnown(c.fr().Ctx, m.Subject, c.i64())
    if c.P.T.KindOf(v) != types.Kind.Const { return -2 }
    found I64 = -1
    for i in range m.Cases.Len() {
        cs := m.Cases[i]
        if cs.Guard is not null { return -2 }
        for p in cs.Alts {
            if isWild(p) {
                if found < 0 { found = i }
                continue
            }
            x ast.Expr?&m = null
            match p {
                case ast.Pattern.Value(_, e), ast.Pattern.Path(_, e) { x = e }
                nomatch { return -2 }
            }
            k := c.P.FoldKnown(c.fr().Ctx, x!, c.i64())
            if c.P.T.KindOf(k) != types.Kind.Const { return -2 }
            if found < 0 and c.P.T.ConstValue(k) == c.P.T.ConstValue(v) { found = i }
        }
    }
    return found
}

# the clause a match on a reflected member chooses (G35): its index, -1 for its nomatch or none, -2 where the match
# is no such one - its subject reads no reflected member, or a clause has a guard or a pattern that is no value known
# while compiling
fn (c mut Checker&) reflMatch(m ast.Match&) I64 {
    if m.OnType { return -2 }
    was := c.reflTouched
    c.reflTouched = false
    v := c.reflFold(m.Subject)
    touched := c.reflTouched
    c.reflTouched = was
    if not touched or not v.Ok { return -2 }
    found I64 = -1
    for i in range m.Cases.Len() {
        cs := m.Cases[i]
        if cs.Guard is not null { return -2 }
        for pat in cs.Alts {
            if isWild(pat) {
                if found < 0 { found = i }
                continue
            }
            x ast.Expr?&m = null
            match pat {
                case ast.Pattern.Value(_, e), ast.Pattern.Path(_, e) { x = e }
                nomatch { return -2 }
            }
            w := c.reflFold(x!)
            if not w.Ok or w.K != v.K { return -2 }
            same := w.I == v.I and w.Ty == v.Ty
            if v.K == RvText { same = w.S == v.S }
            if found < 0 and same { found = i }
        }
    }
    return found
}

# a match giving a value (S12b): "case P => v", or a block that leaves
fn (c mut Checker&) matchValue(sp source.Span, m ast.Match&, want types.TypeId) typed.Expr&c {
    if not m.OnType and c.errMatch(m) { return c.caughtMatchValue(sp, m, want) }
    if m.OnType {
        k := c.matchOnType(m)
        if k == -2 { return c.unknown(sp) }
        cs := m.NoMatch if k < 0 else m.Cases[k]
        if cs is null or cs.Value is null {
            c.gap(sp, "a match on a type giving its value by a block (G15)")
            return c.unknown(sp)
        }
        was := c.bindCase()
        v := c.expr(cs.Value, want)
        c.unbindCase(was)
        return v
    }
    # G30, G35: decided for this instance - a value match choosing nothing is an error here
    k := c.reflMatch(m)
    if k == -2 { k = c.lenMatch(m) }
    if k != -2 {
        cs := m.NoMatch if k < 0 else m.Cases[k]
        if cs is null {
            c.err(m.Subject.Span(), msgs.MatchValueNone())
            return c.unknown(sp)
        }
        if cs.Value is null {
            c.gap(sp, "a match on a length giving its value by a block (G30)")
            return c.unknown(sp)
        }
        return c.expr(cs.Value, want)
    }
    return c.matchExpr(sp, m, true, want)
}

# "case _" of a match on a type (S13f): any
fn isWildType(c mut Checker&, t ast.TypeRef&) Bool {
    match t {
        case ast.TypeRef.Named(_, path, args) { return path.Len() == 1 and args.Len() == 0 and c.text(path[0]) == "_" }
        nomatch { return false }
    }
}

# the case "match T" chooses for this instance: its index, -1 for nomatch, -2 where the subject is not known. The
# subject is a type variable or a type a reflected member names (G38); a case is a type, a trait the type meets, or a
# generic type or trait whose arguments name variables it binds (G36) - the first that holds is chosen, its variables
# left in typeCaseBinds for its arm; one an earlier case takes every type of is an error
fn (c mut Checker&) matchOnType(m ast.Match&) I64 {
    c.typeCaseBinds = Vec<pair.Pair<source.NameId, types.TypeId>>()
    st := c.reflType(m.Subject)
    if st == types.UnknownT { return -2 }
    if st < types.TypeId(0) {
        c.err(m.Subject.Span(), msgs.ReflMatchSubject())
        return -2
    }
    # S13e: a type match chooses its case while compiling - nothing is left for a guard to decide
    for cs in m.Cases {
        if cs.Guard is not null { c.err(c.wordBefore(cs.Guard!.Span().Start, "if"), msgs.TypeMatchGuard()) }
    }
    found I64 = -1
    seen Vec<typeCase>
    for i in range m.Cases.Len() {
        for tr in m.Cases[i].Types {
            if isWildType(c, tr) {
                for e in seen {
                    if e.Wild { c.P.L.Diags.ErrorOncePerLine(c.at(tr.Span()), msgs.ReflCaseUnreachable()) }
                }
                seen.Push(typeCase(true, false, types.UnknownT, 0))
                if found < 0 { found = i }
                continue
            }
            tc := c.typeCaseOf(tr)
            if tc.Pat == types.UnknownT { continue }
            for e in seen {
                if c.typeCaseCovers(e, tc) { c.P.L.Diags.ErrorOncePerLine(c.at(tr.Span()), msgs.ReflCaseUnreachable()) }
            }
            seen.Push(tc)
            if found >= 0 { continue }
            if c.typeCaseHolds(tc, st, tr) { found = i }
        }
    }
    if found >= 0 { return found }
    # G15: a type match is exhaustive for every instance - one no case covers needs a nomatch
    if m.NoMatch is null { c.err(m.Subject.Span(), msgs.TypeMatchUncovered(c.ty(st))) }
    return -1
}

# the variables the chosen type case binds, bound for its arm (G36): what they stood for before
fn (c mut Checker&) bindCase() Vec<pair.Pair<source.NameId, types.TypeId>> {
    was := Vec<pair.Pair<source.NameId, types.TypeId>>()
    for b in c.typeCaseBinds {
        was.Push(pair.Pair(b.First, try c.fr().Ctx.Vars.Get(b.First) catch default types.TypeId(-1)))
        c.fr().Ctx.Vars.Put(b.First, b.Second)
    }
    return was
}

fn (c mut Checker&) unbindCase(was Vec<pair.Pair<source.NameId, types.TypeId>>) {
    for b in was {
        if b.Second >= types.TypeId(0) { c.fr().Ctx.Vars.Put(b.First, b.Second) } else { c.fr().Ctx.Vars.Remove(b.First) }
    }
}

# a type case (G36): a wildcard, a trait, or a type - its pattern, holding N variables of its own (Owner's)
type typeCase struct(Wild Bool, Trait Bool, Pat types.TypeId, N I64) {
    Wild, Trait, Pat, N
    Owner I64 = 0
    Bare Bool = false   # a generic named bare: its variables bind nothing an arm can name
}

# a case's type read as a pattern: each argument written as a name no type has a variable of the case's own (G36)
fn (c mut Checker&) typeCaseOf(tr ast.TypeRef&) typeCase {
    ns Vec<source.NameId>
    c.patternNames(tr, ns, false)
    owner := -(I64(1) << 40) - I64(tr.Span().Start)
    fr := c.fr()
    ctx := generic.Context(fr.Ctx.Mi, fr.Ctx.Owner)
    for e in fr.Ctx.Vars { ctx.Vars.Put(e.Key, e.Value) }
    for e in fr.Ctx.Refl { ctx.Refl.Put(e.Key, e.Value) }
    for k in range ns.Len() { ctx.Vars.Put(ns[k], c.P.T.Var(owner, k, types.ReadOnly)) }
    pt := c.P.Resolve(ctx, tr)
    # a generic type or trait named bare takes every instance: its arguments variables of the case's own
    if pt == types.UnknownT {
        match tr {
            case ast.TypeRef.Named(nsp, _, args) {
                ref := c.P.R.Use(c.fr().File, nsp.Start)
                if args.Len() == 0 and ref.Kind == names.What.Type and ref.Index >= 0 {
                    d := c.P.DeclFor(ref.Module, ref.Index)
                    np := c.P.T.DeclParams(d)
                    if np > 0 {
                        vs := Array<types.TypeId>(np)
                        for k in range np { vs[k] = c.P.T.Var(owner, I64(ns.Len()) + k, types.ReadOnly) }
                        pt = c.P.Instance(d, c.P.T.List(vs))
                        tc := typeCase(false, c.isTrait(pt), pt, ns.Len() + I64(np))
                        tc.Owner = owner
                        tc.Bare = true
                        return tc
                    }
                }
            }
            nomatch { }
        }
    }
    if pt == types.UnknownT {
        c.resolve(tr)   # what is wrong with it, said
        return typeCase(false, false, types.UnknownT, 0)
    }
    tc := typeCase(false, c.isTrait(pt), pt, ns.Len())
    tc.Owner = owner
    return tc
}

fn (c mut Checker&) isTrait(t types.TypeId) Bool {
    return c.P.T.KindOf(t) == types.Kind.Named and c.P.T.DeclKindOf(c.P.T.DeclOf(t)) == types.DeclKind.Trait
}

# the names of a case's type that name no type, in its arguments (G36): its variables
fn (c mut Checker&) patternNames(tr ast.TypeRef?&, out mut Vec<source.NameId>&, inArgs Bool) {
    if tr is null { return }
    match tr {
        case ast.TypeRef.Named(nsp, path, args) {
            if inArgs and path.Len() == 1 and args.Len() == 0 and not c.fr().Ctx.Vars.Has(path[0]) and
               c.P.R.Use(c.fr().File, nsp.Start).Kind == names.What.None and c.text(path[0]) != "_" {
                if not out.Has(path[0]) { out.Push(path[0]) }
                return
            }
            if args.Len() > 0 {
                for a in args { c.patternNames(a, out, true) }
            }
        }
        case ast.TypeRef.Ref(_, of, _, _) { c.patternNames(of, out, inArgs) }
        case ast.TypeRef.Perm(_, of, _, _) { c.patternNames(of, out, inArgs) }
        nomatch { }
    }
}

# whether a type case holds of st (G36): its pattern matching st - a trait's, st meeting it - its variables bound
# into typeCaseBinds where it does
fn (c mut Checker&) typeCaseHolds(tc typeCase, st types.TypeId, tr ast.TypeRef&) Bool {
    b := generic.Binding(tc.Owner, tc.N)
    if tc.Trait {
        if tc.N > 0 {
            c.P.UnifyBound(st, tc.Pat, b)
            for k in range tc.N {
                # a bare generic trait's argument nothing binds is the matched type ("Hashable" is Hashable<T>)
                if b.Vals[k] == types.UnknownT and tc.Bare { b.Vals[k] = st }
                if b.Vals[k] == types.UnknownT { return false }
            }
        }
        tt := c.P.Subst(tc.Pat, tc.Owner, c.P.T.List(b.Vals)) if tc.N > 0 else tc.Pat
        if not c.P.Satisfies(st, tt) { return false }
    } else if tc.N == 0 {
        # a read-only reference case takes a writable reference too (T25b: writable converts to read-only at the top),
        # so "case Node&" holds for a "mut Node&" - "case mut Node&" before it tells them apart
        ro := st
        if c.isRef(st) { ro = c.P.T.Ref(c.P.T.Referent(st), c.P.T.PermOf(st) & ~types.Writable) }
        if not c.P.T.Same(tc.Pat, st) and not c.P.T.Same(tc.Pat, ro) { return false }
    } else {
        if not c.P.Unify(tc.Pat, st, b, false, false) { return false }
        for k in range tc.N {
            if b.Vals[k] == types.UnknownT { return false }
        }
        if not c.P.T.Same(c.P.Subst(tc.Pat, tc.Owner, c.P.T.List(b.Vals)), st) { return false }
    }
    ns Vec<source.NameId>
    c.patternNames(tr, ns, false)
    for k in range ns.Len() { c.typeCaseBinds.Push(pair.Pair(ns[k], b.Vals[k])) }
    return true
}

# whether an earlier type case takes every type a later one does (G36): a wildcard; the same type; a trait the later
# type meets; a generic pattern of distinct variables the later one is an instance of
fn (c mut Checker&) typeCaseCovers(e typeCase, l typeCase) Bool {
    if e.Wild { return true }
    if l.Wild { return false }
    if e.Trait {
        if l.Trait { return e.N == 0 and l.N == 0 and c.P.T.Same(e.Pat, l.Pat) }
        return e.N == 0 and l.N == 0 and c.P.Satisfies(l.Pat, e.Pat)
    }
    if l.Trait { return false }
    if e.N == 0 {
        if l.N != 0 { return false }
        if c.P.T.Same(e.Pat, l.Pat) { return true }
        # a read-only reference case takes the writable one too (typeCaseHolds)
        return c.isRef(l.Pat) and c.P.T.Same(e.Pat, c.P.T.Ref(c.P.T.Referent(l.Pat), c.P.T.PermOf(l.Pat) & ~types.Writable))
    }
    if c.P.T.KindOf(e.Pat) != types.Kind.Named or c.P.T.KindOf(l.Pat) != types.Kind.Named { return false }
    if c.P.T.DeclOf(e.Pat) != c.P.T.DeclOf(l.Pat) { return false }
    # every argument of the earlier one its own variable, each once
    xs := c.P.T.Items(c.P.T.Args(e.Pat))
    used Vec<I64>
    for x in xs {
        if c.P.T.KindOf(x) != types.Kind.Var or c.P.T.A(x) != e.Owner or used.Has(c.P.T.B(x)) { return false }
        used.Push(c.P.T.B(x))
    }
    return true
}

fn (c mut Checker&) matchExpr(sp source.Span, m ast.Match&, isValue Bool, want types.TypeId) typed.Expr&c {
    c.enumWanted = true
    subj := c.expr(m.Subject, types.UnknownT)
    st := typeOf(subj)
    ssp := m.Subject.Span()
    from := c.stmts.Len()
    place := readPlace(subj)
    local := false
    if place is not null {
        match place {
            case typed.Lvalue.Local(_, _, _) { local = true }
            nomatch { }
        }
    }
    if not local {
        h := c.local(source.NameId(0), ssp, st, typed.LocalKind.Held, typed.Mark.None)
        c.roLet(h, subj)   # T25c: what is matched, as read-only as the place it is read from
        c.stmts.Push(typed.Stmt.Let(ssp, typed.LocalId(I32(h)), subj))
        place = typed.Lvalue.Local(ssp, st, typed.LocalId(I32(h)))
    }
    held := gather(c.stmts, from)
    rt := want if isValue else types.VoidT
    said := types.UnknownT   # what a mismatch names the values as: a first literal value's own type, as written (S12b)
    arms mut Vec<typed.Arm&>&c = Vec<typed.Arm&>()
    covered mut Vec<Bool>&c = Vec<Bool>()
    et := c.deref(st)
    if c.isEnum(et) {
        for _ in range c.P.T.Items(c.P.T.Cases(et)).Len() { covered.Push(false) }
    } else if c.P.T.KindOf(et) == types.Kind.Any and c.P.IsClosedTrait(c.P.T.AnyTrait(et)) {
        # T34: a closed trait's "any" covered by a type case for each type the trait lists
        for _ in range c.P.Members(c.P.T.AnyTrait(et)).Len() { covered.Push(false) }
    }
    all := false
    allSaid := false
    broken := c.caseBroken
    c.caseBroken = false
    rows mut Vec<Array<ast.Pattern&>&>&m = Vec<Array<ast.Pattern&>&>()
    subjLocal := I64(-1)
    match place {
        case typed.Lvalue.Local(_, _, lid) { if local { subjLocal = I64(lid) } }
        nomatch { }
    }
    for cs in m.Cases {
        # S13f: nothing reaches a case after an unguarded "case _"
        if all and not allSaid {
            c.err(source.Span(cs.Sp.Start, cs.Sp.Start + 4), msgs.CaseAfterWildcard())
            allSaid = true
        }
        id, outer, mark := c.open(typed.BlockKind.Plain, cs.Sp)
        bfrom := c.stmts.Len()
        alts mut Vec<typed.Alt&>&c = Vec<typed.Alt&>()
        firstNames mut Vec<source.NameId>&c = Vec<source.NameId>()
        for ai in range cs.Alts.Len() {
            p := cs.Alts[ai]
            if isWild(p) and cs.Alts.Len() > 1 { c.err(p.Span(), msgs.WildcardNotAlone()) }
            if c.bindsType(p) and cs.Alts.Len() > 1 { c.err(p.Span(), msgs.AnyCaseAlone()) }
            binds mut Vec<typed.Bind&>&c = Vec<typed.Bind&>()
            tst typed.Expr?&c = null
            if c.caseName(p, subjLocal) {
                tst = c.lit(p.Span(), types.BoolT, 1)
            } else {
                tst = c.pattern(p, place!, st, binds, id)
            }
            c.altNames(binds, firstNames, ai, p)
            alts.Push(typed.Alt(tst!, binds.ToArray()))
            if cs.Guard is null { c.cover(p, et, covered, all) }
            if cs.Guard is null and isWild(p) { all = true }
            if cs.Guard is null { rows.Push(patRow(p)) }
        }
        guard typed.Expr?&c = null
        if cs.Guard is not null {
            # S13e: a guard is a Bool
            guard = c.value(c.expr(cs.Guard, types.BoolT), cs.Guard!.Span())
            gt := typeOf(guard)
            if gt != types.BoolT and gt != types.UnknownT {
                c.err(cs.Guard!.Span(), msgs.GuardNotBool(c.ty(gt)))
                guard = c.unknown(cs.Guard!.Span())
            }
        }
        if cs.Body.Len() > 0 {
            c.stmtsOf(cs.Body)
        }
        v typed.Expr?&c = null
        if cs.Value is not null {
            if not isValue {
                c.err(c.wordBefore(cs.Value!.Span().Start, "=>"), msgs.ArrowInStatement())
            } else {
                if said == types.UnknownT and rt != types.UnknownT and c.litLike(cs.Value!) { said = typeOf(c.expr(cs.Value, types.UnknownT)) }
                v = c.expr(cs.Value, rt)
                if said == types.UnknownT { said = rt }
                if rt == types.UnknownT and typeOf(v) != types.NullT {
                    rt = typeOf(v)
                    if c.isRef(rt) and nullValue(m) { rt = c.P.T.OrNull(rt) }   # T2c: a null value among them
                    if c.P.T.KindOf(rt) == types.Kind.Array and c.P.T.Length(rt) != types.TypeId(0) and c.litArray(cs.Value!) {
                        rt = c.P.T.Array(c.P.T.Elem(rt), types.TypeId(0))
                    }
                    # a reference to an array of a known length gives the run-time length, so another case's array of
                    # another length meets it (S12b, G9a)
                    if c.isRef(rt) { rt = c.runLength(rt) }
                }
                ok := false
                v, ok = c.fitQuiet(v!, rt, cs.Value!.Span())
                if not ok { c.matchValueMismatch(cs.Value!.Span(), said, rt, v!) }
            }
        }
        code := c.close(id, outer, mark, bfrom)
        # S12b: in a match used as a value, a case's block leaves
        if isValue and cs.Value is null and not leavesValue(code) { c.err(c.braceAfter(cs), msgs.CaseBlockStays()) }
        arms.Push(typed.Arm(cs.Sp, alts.ToArray(), guard, code, v))
    }
    if m.NoMatch is not null and all and not allSaid { c.err(source.Span(m.NoMatch!.Sp.Start, m.NoMatch!.Sp.Start + 7), msgs.CaseAfterWildcard()) }
    for k in range covered.Len() {
        if covered[k] { continue }
        all = all
    }
    exhaustive := all
    if not exhaustive and covered.Len() > 0 {
        exhaustive = true
        for b in covered {
            if not b { exhaustive = false }
        }
    }
    # S13a: unguarded clauses covering each case together - a payload's positions, Bools, enums inside payloads
    if not exhaustive { exhaustive = c.coversRows(rows, Array<types.TypeId>(1, et), 0) }
    if c.caseBroken { exhaustive = true }
    c.caseBroken = broken
    noMatch typed.Arm?&c = null
    if m.NoMatch is not null {
        nm := m.NoMatch
        id, outer, mark := c.open(typed.BlockKind.Plain, nm!.Sp)
        bfrom := c.stmts.Len()
        if nm!.Body.Len() > 0 {
            c.stmtsOf(nm!.Body)
        }
        v typed.Expr?&c = null
        if nm!.Value is not null and isValue {
            ok := false
            v = c.expr(nm!.Value, rt)
            if rt == types.UnknownT and typeOf(v) != types.NullT {
                # S12b: a match whose only value is its nomatch's has that value's type, as a case's first value gives it
                rt = typeOf(v)
                if c.isRef(rt) and nullValue(m) { rt = c.P.T.OrNull(rt) }
                if c.P.T.KindOf(rt) == types.Kind.Array and c.P.T.Length(rt) != types.TypeId(0) and c.litArray(nm!.Value!) {
                    rt = c.P.T.Array(c.P.T.Elem(rt), types.TypeId(0))
                }
                if c.isRef(rt) { rt = c.runLength(rt) }
                if said == types.UnknownT { said = rt }
            }
            v, ok = c.fitQuiet(v!, rt, nm!.Value!.Span())
            if not ok { c.matchValueMismatch(nm!.Value!.Span(), said, rt, v!) }
        }
        code := c.close(id, outer, mark, bfrom)
        noMatch = typed.Arm(nm!.Sp, Array<typed.Alt&>(0), null, code, v)
    } else {
        efrom := c.stmts.Len()
        if exhaustive or isValue { c.stmts.Push(typed.Stmt.Exit(m.Sp, typed.ExitKind.Unreachable, null)) }
        if not exhaustive and c.isEnum(et) {
            # S13a: an enum's cases covered by unguarded clauses, or a nomatch
            k := c.firstUncovered(rows, et)
            if k >= 0 {
                cn := c.P.T.CaseNames(et)
                c.err(ssp, msgs.MatchNotExhaustive(c.text(cn[k]) if cn.Len() > 0 and k < cn.Len() else "?", c.ty(et)))
            }
        } else if not exhaustive and covered.Len() > 0 and c.P.T.KindOf(et) == types.Kind.Any {
            # T34: a closed trait's members covered by unguarded type cases, or a nomatch
            ms := c.P.Members(c.P.T.AnyTrait(et))
            for k in range covered.Len() {
                if not covered[k] and k < ms.Len() {
                    c.err(ssp, msgs.MatchNotExhaustive(c.ty(ms[k]), c.ty(st)))
                    break
                }
            }
        } else if isValue and not exhaustive and st != types.UnknownT {
            c.err(source.Span(m.Sp.Start, m.Sp.Start + 5), msgs.MatchValueNeedsNomatch(c.ty(st)))
        }
        code := typed.Block(typed.BlockId(I32(c.fr().Block)), gather(c.stmts, efrom))
        noMatch = typed.Arm(m.Sp, Array<typed.Alt&>(0), null, code, null)
    }
    if not isValue { rt = types.VoidT }
    return typed.Expr.Match(sp, rt, typed.Match(held, arms.ToArray(), noMatch, isValue))
}

# ---- type cases (T34) ----

# whether an alternative is a type case binding a name: its clause's only alternative (T34)
fn (c mut Checker&) bindsType(p ast.Pattern&) Bool {
    match p {
        case ast.Pattern.Type(_, _, n, _) { return c.text(n) != "_" }
        nomatch { return false }
    }
}

# the "any" (of type t, at place) holding an instance of the type a type case names (T34): the type identity tested,
# the instance bound to the name - itself, or for a number its value
fn (c mut Checker&) typeCase(sp source.Span, tyr ast.TypeRef&, n source.NameId, nsp source.Span, place typed.Lvalue&c, t types.TypeId
                             binds mut Vec<typed.Bind&>&c) typed.Expr&c {
    if t == types.UnknownT { return c.lit(sp, types.BoolT, 0) }
    mt := c.anyCaseType(sp, t, tyr)
    if mt == types.UnknownT { return c.lit(sp, types.BoolT, 0) }
    x := c.read(sp, place)
    tst := c.prim(sp, types.BoolT, typed.PrimOp.AnyIs, x, c.lit(sp, mt, 0))
    if c.text(n) != "_" {
        bv := c.anyInstance(sp, c.read(sp, place), mt, typed.Check.None)
        id := c.local(n, nsp, typeOf(bv), typed.LocalKind.Binding, typed.Mark.Infer)
        c.roLet(id, bv)
        binds.Push(typed.Bind(typed.LocalId(I32(id)), bv))
    }
    return tst
}

# the type a type case or an "as" names for an "any" of type t: one its closed trait lists, else said and Unknown
fn (c mut Checker&) anyCaseType(sp source.Span, t types.TypeId, tyr ast.TypeRef&) types.TypeId {
    et := c.deref(t)
    if c.P.T.KindOf(et) != types.Kind.Any {
        c.err(sp, msgs.AnyCaseNotAny(c.ty(t)))
        return types.UnknownT
    }
    r := c.P.T.AnyTrait(et)
    if not c.P.IsClosedTrait(r) {
        c.err(sp, msgs.AnyOpenInspected(c.ty(t), c.ty(r)))
        return types.UnknownT
    }
    named := tyr
    match tyr {
        case ast.TypeRef.Ref(_, of, _, _) { named = of }
        nomatch { }
    }
    if not c.caseTypeWritten(named) { return types.UnknownT }
    mt := c.P.T.Plain(c.resolve(named))
    if mt == types.UnknownT { return types.UnknownT }
    if not c.P.Member(mt, r) {
        c.err(tyr.Span(), msgs.AnyNotMemberCase(c.ty(mt), c.ty(r)))
        return types.UnknownT
    }
    return mt
}

# a type case's or an "as"'s type (T34) names a type, a generic one with its arguments (G7) - what is wrong said at it
fn (c mut Checker&) caseTypeWritten(tr ast.TypeRef&, say Bool = true) Bool {
    match tr {
        case ast.TypeRef.Named(nsp, path, args) {
            ref := c.P.R.Use(c.fr().File, nsp.Start)
            if path.Len() > 1 and ref.Kind == names.What.None { ref = c.P.R.Member(c.fr().File, nsp.End) }
            if ref.Kind == names.What.None and path.Len() == 1 {
                if say { c.unknownType(nsp, path[0]) }
                return false
            }
            if ref.Kind == names.What.Type and ref.Index >= 0 {
                ad := c.P.DeclFor(ref.Module, ref.Index)
                if not c.P.ArgsFit(ad, args) {
                    if say { c.err(tr.Span(), msgs.TypeArgCount(c.text(path[path.Len() - 1]), c.P.WrittenArity(ad), generic.WrittenTypes(args))) }
                    return false
                }
            }
            return true
        }
        nomatch { return true }
    }
}

# the instance an "any" x holds, of the type mt it lists (T34): a reference to it with the any's permission - a
# number's value, which no reference names; an array's own storage. chk tests the type first (E32: "as")
fn (c mut Checker&) anyInstance(sp source.Span, x typed.Expr&c, mt types.TypeId, chk typed.Check) typed.Expr&c {
    perm := c.P.T.PermOf(typeOf(x)) & types.Writable
    stored := c.P.AnyStored(mt)
    from := c.exprs.Len()
    c.exprs.Push(x)
    c.exprs.Push(c.lit(sp, mt, 0))
    rt := c.P.T.Ref(stored, perm)
    ref typed.Expr&c = typed.Expr.Prim(sp, rt, typed.PrimOp.AnyInstance, chk, gather(c.exprs, from))
    if not c.anyCopies(mt) { return ref }
    if stored != mt {
        art := c.P.T.Ref(mt, perm)
        return typed.Expr.Borrow(sp, art, typed.Lvalue.Field(sp, mt, typed.Lvalue.Deref(sp, stored, ref), 0))
    }
    if c.P.T.KindOf(c.under(mt)) == types.Kind.Array { return ref }
    return c.read(sp, typed.Lvalue.Deref(sp, mt, ref))
}

# "x as T" on an "any" of a closed trait (T34): its instance, failing as written with CaseError.WRONG_CASE where it is
# no T (E32)
fn (c mut Checker&) anyAs(sp source.Span, x typed.Expr&c, a ast.Expr&, tr ast.TypeRef&) typed.Expr&c {
    mt := c.anyCaseType(c.between(a.Span(), tr.Span(), 2), typeOf(x), tr)
    if mt == types.UnknownT { return c.unknown(sp) }
    return c.anyInstance(sp, x, mt, c.failOp(types.TypeId[c.wrongCase()], c.between(a.Span(), tr.Span(), 2), true))
}

# the first of an enum's cases the unguarded rows do not cover (S13a), -1 for none
fn (c mut Checker&) firstUncovered(rows Vec<Array<ast.Pattern&>&>&, t types.TypeId) I64 {
    n := c.P.T.Items(c.P.T.Cases(t)).Len()
    for k in range n {
        sig := c.P.CaseSig(t, k)
        ps := c.P.T.Items(c.P.T.Params(sig)) if sig != types.UnknownT else Array<types.TypeId>(0)
        sub mut Vec<Array<ast.Pattern&>&>&rows = Vec<Array<ast.Pattern&>&>()
        for r in rows {
            p := r[0]
            if c.patWild(p) {
                sub.Push(patTail(r, Array<ast.Pattern&>(0), ps.Len()))
                continue
            }
            match p {
                case ast.Pattern.Path(_, x), ast.Pattern.Value(_, x) {
                    if c.caseTag(x, t) == k { sub.Push(patTail(r, Array<ast.Pattern&>(0), ps.Len())) }
                }
                case ast.Pattern.Case(_, path, subs) {
                    if c.caseTag(path, t) == k and subs.Len() == ps.Len() { sub.Push(patTail(r, subs, 0)) }
                }
                nomatch { }
            }
        }
        if not c.coversRows(sub, ps, 1) { return k }
    }
    return -1
}

# S13f: a lone name in a case that is no value - unknown, or the local being matched - meant "case _ if"; said, and
# the alternative taken as matching (true where it is said)
fn (c mut Checker&) caseName(p ast.Pattern&, subj I64) Bool {
    match p {
        case ast.Pattern.Path(_, x), ast.Pattern.Value(_, x) {
            match x {
                case ast.Expr.Name(nsp, n) {
                    ref := c.P.R.Use(c.fr().File, nsp.Start)
                    if ref.Kind == names.What.None {
                        c.err(nsp, msgs.CaseUnknownName(c.tok(n)))
                        c.unknownSaid.Put(pair.Pair(c.fr().Body, I64(n)), true)
                        return true
                    }
                    if ref.Kind == names.What.Local and subj >= 0 and c.localNamed(n) == subj {
                        c.err(nsp, msgs.CaseIsSubject(c.tok(n)))
                        return true
                    }
                }
                nomatch { }
            }
        }
        nomatch { }
    }
    return false
}

# S13c: the alternatives of a case bind the same names, each of one type - the first alternative's names kept in first
fn (c mut Checker&) altNames(binds Vec<typed.Bind&>&, first mut Vec<source.NameId>&, ai I64, p ast.Pattern&) {
    ns := Vec<source.NameId>()
    for b in binds { ns.Push(c.cur().Local(b.To).Name) }
    if ai == 0 {
        for n in ns { first.Push(n) }
        return
    }
    for b in binds {
        n := c.cur().Local(b.To).Name
        known := false
        for f in first {
            if f == n { known = true }
        }
        if not known {
            c.err(c.cur().Local(b.To).Sp, msgs.AltBindsOtherNames())
            return
        }
    }
    for f in first {
        has := false
        for n in ns {
            if n == f { has = true }
        }
        if not has {
            c.err(p.Span(), msgs.AltBindsOtherNames())
            return
        }
    }
}

# the span of a word written just before a position, past spaces: an "if" before a guard, a "=>" before a value
fn (c mut Checker&) wordBefore(at I32, w String&) source.Span {
    t := c.P.L.Mods[c.fr().Mi].Src!.Text
    i := I64(at) - 1
    for i > 0 and (t[i] == ' ' or t[i] == '\t' or t[i] == '\n') { i-- }
    st := i + 1 - w.Len()
    if st < 0 { return source.Span(at, at) }
    return source.Span(I32(st), I32(i + 1))
}

# a case's block's "{": the first after its patterns and guard
fn (c mut Checker&) braceAfter(cs ast.Case&) source.Span {
    from := cs.Guard!.Span().End if cs.Guard is not null else cs.Alts[cs.Alts.Len() - 1].Span().End if cs.Alts.Len() > 0 else cs.Sp.Start
    t := c.P.L.Mods[c.fr().Mi].Src!.Text
    i := I64(from)
    for i < t.Len() and t[i] != '{' { i++ }
    return source.Span(I32(i), I32(i + 1))
}

# whether rows of patterns, one per column of types ts, cover every value (Maranget's usefulness, over the patterns'
# syntax, S13a): a Bool's true and false, an enum's cases and each case's payload positions are its constructors;
# any other type only a wildcard or a binding covers
fn (c mut Checker&) coversRows(rows Vec<Array<ast.Pattern&>&>&, ts Array<types.TypeId>&, depth I64) Bool {
    if ts.Len() == 0 { return rows.Len() > 0 }
    if rows.Len() == 0 or depth > 16 { return false }
    t := c.deref(ts[0])
    rest := ts[1:]
    if t == types.BoolT {
        seen := I64[0, 0]
        for r in rows {
            bv := c.patBool(r[0])
            if bv >= 0 { seen[bv] = 1 }
        }
        if seen[0] == 0 or seen[1] == 0 {
            sub mut Vec<Array<ast.Pattern&>&>&rows = Vec<Array<ast.Pattern&>&>()
            for r in rows {
                if c.patWild(r[0]) { sub.Push(patTail(r, Array<ast.Pattern&>(0), 0)) }
            }
            return c.coversRows(sub, rest, depth + 1)
        }
        for bv in range 2 {
            sub mut Vec<Array<ast.Pattern&>&>&rows = Vec<Array<ast.Pattern&>&>()
            for r in rows {
                if c.patWild(r[0]) or c.patBool(r[0]) == bv { sub.Push(patTail(r, Array<ast.Pattern&>(0), 0)) }
            }
            if not c.coversRows(sub, rest, depth + 1) { return false }
        }
        return true
    }
    if c.isEnum(t) {
        n := c.P.T.Items(c.P.T.Cases(t)).Len()
        # the cases column 0 names: where some case is named nowhere only a wildcard covers it, so the rest of the rows
        # with a wildcard there decide (Maranget's default matrix) - each case checked only where all are named
        named := Array<Bool>(n, false)
        for r in rows {
            match r[0] {
                case ast.Pattern.Path(_, x), ast.Pattern.Value(_, x) {
                    k := c.caseTag(x, t)
                    if k >= 0 { named[k] = true }
                }
                case ast.Pattern.Case(_, path, _) {
                    k := c.caseTag(path, t)
                    if k >= 0 { named[k] = true }
                }
                nomatch { }
            }
        }
        complete := true
        for b in named {
            if not b { complete = false }
        }
        if not complete {
            sub mut Vec<Array<ast.Pattern&>&>&rows = Vec<Array<ast.Pattern&>&>()
            for r in rows {
                if c.patWild(r[0]) { sub.Push(patTail(r, Array<ast.Pattern&>(0), 0)) }
            }
            return c.coversRows(sub, rest, depth + 1)
        }
        for k in range n {
            sig := c.P.CaseSig(t, k)
            ps := c.P.T.Items(c.P.T.Params(sig)) if sig != types.UnknownT else Array<types.TypeId>(0)
            nts Vec<types.TypeId>
            for q in ps { nts.Push(q) }
            for q in rest { nts.Push(q) }
            sub mut Vec<Array<ast.Pattern&>&>&rows = Vec<Array<ast.Pattern&>&>()
            for r in rows {
                p := r[0]
                if c.patWild(p) {
                    sub.Push(patTail(r, Array<ast.Pattern&>(0), ps.Len()))
                    continue
                }
                match p {
                    case ast.Pattern.Path(_, x), ast.Pattern.Value(_, x) {
                        if c.caseTag(x, t) == k { sub.Push(patTail(r, Array<ast.Pattern&>(0), ps.Len())) }
                    }
                    case ast.Pattern.Case(_, path, subs) {
                        if c.caseTag(path, t) == k and subs.Len() == ps.Len() { sub.Push(patTail(r, subs, 0)) }
                    }
                    nomatch { }
                }
            }
            if not c.coversRows(sub, nts.ToArray(), depth + 1) { return false }
        }
        return true
    }
    sub mut Vec<Array<ast.Pattern&>&>&rows = Vec<Array<ast.Pattern&>&>()
    for r in rows {
        if c.patWild(r[0]) { sub.Push(patTail(r, Array<ast.Pattern&>(0), 0)) }
    }
    return c.coversRows(sub, rest, depth + 1)
}

# a row of one pattern
fn patRow(p ast.Pattern&) Array<ast.Pattern&>&p {
    row mut Vec<ast.Pattern&>&p = Vec<ast.Pattern&>()
    row.Push(p)
    return row.ToArray()
}

# a row's first column replaced by subs, or by n wildcards where subs is null, then the rest of the row
fn patTail(r Array<ast.Pattern&>&, subs Array<ast.Pattern&>&r, n I64) Array<ast.Pattern&>&r {
    row mut Vec<ast.Pattern&>&r = Vec<ast.Pattern&>()
    if subs.Len() > 0 {
        for q in subs { row.Push(q) }
    } else {
        for _ in range n { row.Push(ast.Pattern.Wild(r[0].Span())) }
    }
    for i in range 1, r.Len() { row.Push(r[i]) }
    return row.ToArray()
}

fn (c mut Checker&) patWild(p ast.Pattern&) Bool {
    match p {
        case ast.Pattern.Wild(_), ast.Pattern.Bind(_, _) { return true }
        nomatch { return false }
    }
}

# a Bool literal pattern's value: 1 true, 0 false, -1 for none
fn (c mut Checker&) patBool(p ast.Pattern&) I64 {
    match p {
        case ast.Pattern.Value(_, x), ast.Pattern.Path(_, x) {
            match x {
                case ast.Expr.Lit(sp, kind) {
                    if kind == token.Tok.BoolLit { return 1 if c.src(sp) == "true" else 0 }
                }
                nomatch { }
            }
        }
        nomatch { }
    }
    return -1
}

fn isWild(p ast.Pattern&) Bool {
    match p {
        case ast.Pattern.Wild(_) { return true }
        nomatch { return false }
    }
}

# which of an enum's cases an unguarded alternative covers whatever its payload holds (S13a)
fn (c mut Checker&) cover(p ast.Pattern&, et types.TypeId, covered mut Vec<Bool>&, all Bool) {
    if covered.Len() == 0 { return }
    match p {
        case ast.Pattern.Type(sp, tyr, _, _) {
            if c.P.T.KindOf(et) != types.Kind.Any { return }
            named := tyr
            match tyr {
                case ast.TypeRef.Ref(_, of, _, _) { named = of }
                nomatch { }
            }
            mt := c.P.T.Plain(c.resolve(named)) if c.caseTypeWritten(named, false) else types.UnknownT
            ms := c.P.Members(c.P.T.AnyTrait(et))
            if mt == types.UnknownT {
                # a case whose type is wrong (said at it): the match taken as complete, so it is the one error
                c.caseBroken = true
                return
            }
            for k in range ms.Len() {
                if k < covered.Len() and c.P.T.Same(ms[k], mt) {
                    # T34: a type an earlier clause matches whatever it holds is never matched again
                    if covered[k] or all { c.err(sp, msgs.AnyCaseTwice(c.ty(mt))) }
                    covered[k] = true
                }
            }
        }
        case ast.Pattern.Path(_, x), ast.Pattern.Value(_, x) {
            k := c.caseTag(x, et)
            if k >= 0 { covered[k] = true }
        }
        case ast.Pattern.Case(_, path, subs) {
            for sub in subs {
                match sub {
                    case ast.Pattern.Bind(_, _), ast.Pattern.Wild(_) { }
                    nomatch { return }
                }
            }
            k := c.caseTag(path, et)
            if k >= 0 { covered[k] = true }
        }
        nomatch { }
    }
}

# an enum case a pattern's path names: its tag in et, -1 where it names none of et's
fn (c mut Checker&) caseTag(x ast.Expr&, et types.TypeId) I64 {
    if not c.isEnum(et) { return -1 }
    # G34: a case's descriptor, of this enum
    cd := c.caseDesc(x)
    if cd.K == generic.DescCase { return cd.Case if c.P.T.Same(cd.Of, et) else -1 }
    match x {
        case ast.Expr.Member(_, prefix, n) {
            if not c.namesEnumOf(prefix, et) { return -1 }
            cn := c.P.T.CaseNames(et)
            if cn.Len() == 0 { return -1 }
            for i in range cn.Len() {
                if cn[i] == n {
                    xsp := x.Span()
                    c.casePublic(et, n, source.Span(xsp.End - I32(c.text(n).Len()), xsp.End))
                    return i
                }
            }
            return -1
        }
        nomatch { return -1 }
    }
}

# M6a: an enum's case is public by its own first letter - another module's private one is said where it is named
fn (c mut Checker&) casePublic(t types.TypeId, n source.NameId, sp source.Span) {
    if c.text(n)[0].IsUpper() or c.frames.Len() == 0 or c.P.T.DeclModule(c.P.T.DeclOf(t)) == c.fr().Mi { return }
    c.P.L.Diags.ErrorOncePerLine(c.at(sp), msgs.CaseIsPrivate(c.tok(n)))
}

fn (c mut Checker&) and2(sp source.Span, a typed.Expr&c, b typed.Expr&c) typed.Expr&c {
    if isTrue(a) { return b }
    if isTrue(b) { return a }
    return typed.Expr.Cond(sp, types.BoolT, typed.Cond(a, b, c.lit(sp, types.BoolT, 0)))
}

fn isTrue(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Lit(_, ty, bits) { return ty == types.BoolT and bits == 1 }
        nomatch { return false }
    }
}

# S12b: a value of a match that does not fit the others' type - a null where they are a reference never null said as
# T2c says it, with where that type is written (T2c's note)
fn (c mut Checker&) matchValueMismatch(sp source.Span, said types.TypeId, rt types.TypeId, v typed.Expr&) {
    if typeOf(v) == types.NullT and c.P.T.ArrayRef(rt) {
        c.err(sp, msgs.NullToArray(c.ty(c.deref(rt)), c.emptyArray(rt)))
        return
    }
    if typeOf(v) == types.NullT and c.isRef(rt) and not c.P.T.IsNullable(rt) {
        rec := c.err(sp, msgs.NullToNonNull(c.ty(rt), c.ty(c.P.T.OrNull(rt))))
        c.declNote(rec)
        return
    }
    c.err(sp, msgs.MatchValueTypes(c.ty(said if said != types.UnknownT else rt), c.tyOf(v)))
}

# a pattern's test over the value at place (of type t), its bindings appended to binds (S13, S13b): a binding local of
# the arm's block, the same one where an earlier alternative of the arm binds the name
fn (c mut Checker&) pattern(p ast.Pattern&, place typed.Lvalue&c, t types.TypeId, binds mut Vec<typed.Bind&>&c, arm I64) typed.Expr&c {
    match p {
        case ast.Pattern.Wild(sp) { return c.lit(sp, types.BoolT, 1) }
        case ast.Pattern.Type(sp, tyr, n, nsp) { return c.typeCase(sp, tyr, n, nsp, place, t, binds) }
        case ast.Pattern.Bind(sp, n) {
            id := c.localNamed(n)
            if id < 0 or I64(c.cur().Locals[id].In) != arm or c.cur().Locals[id].Kind != typed.LocalKind.Binding {
                id = c.local(n, sp, t, typed.LocalKind.Binding, typed.Mark.Infer)
                at := c.placeAt(place)     # T2c: where its type is written, for declNote
                if at != diag.Where.Nowhere { c.fr().typeAt.Put(id, at) }
            } else if not c.P.T.Same(c.cur().Locals[id].Ty, t) and t != types.UnknownT {
                lt := c.cur().Locals[id].Ty
                if c.isRef(lt) and c.isRef(t) and c.P.T.Same(c.P.T.Referent(lt), c.P.T.Referent(t)) {
                    # S13c: references of one type meet - writable only where every alternative's is
                    l := c.cur().Locals[id]
                    l.Ty = c.P.T.Ref(c.P.T.Referent(lt), meetPerm(c.P.T.PermOf(lt), c.P.T.PermOf(t)))
                    c.cur().Locals[id] = l
                } else {
                    # S13c: a name several alternatives bind has one type
                    c.err(sp, msgs.AltBindingType(c.tok(n), c.ty(lt)))
                }
            }
            c.roLet(id, c.read(sp, place))   # T25c: a binding of a place reached read-only is a read-only copy
            binds.Push(typed.Bind(typed.LocalId(I32(id)), c.read(sp, place)))
            return c.lit(sp, types.BoolT, 1)
        }
        case ast.Pattern.Path(sp, x) {
            et := c.deref(t)
            k := c.caseTag(x, et)
            if k >= 0 { return c.isCase(sp, place, k) }
            if c.typeNamed(x) < types.TypeId(0) {
                match x {
                    case ast.Expr.Member(_, prefix, n) {
                        pt := c.typeNamed(prefix)
                        if c.isEnum(et) and pt >= types.TypeId(0) and c.P.T.DeclOf(pt) == c.P.T.DeclOf(et) {
                            c.err(memberSpan(sp, c.text(n).Len()), c.noCase(et, n))
                            return c.lit(sp, types.BoolT, 0)
                        }
                        if pt >= types.TypeId(0) and c.isEnum(pt) and not (c.isEnum(et) and c.P.T.DeclOf(pt) == c.P.T.DeclOf(et)) {
                            # S13b: a case of another enum where the payload holds something else
                            c.err(prefix.Span(), msgs.PatternType(c.ty(et), msgs.Tok(c.src(prefix.Span()))))
                            return c.lit(sp, types.BoolT, 0)
                        }
                    }
                    nomatch { }
                }
            }
            return c.valueTest(sp, place, x, t)
        }
        case ast.Pattern.Case(sp, path, subs) {
            et := c.deref(t)
            k := c.caseTag(path, et)
            if k < 0 {
                match path {
                    case ast.Expr.Member(msp, prefix, n) {
                        pt := c.typeNamed(prefix)
                        if c.isEnum(et) and pt >= types.TypeId(0) and c.P.T.DeclOf(pt) == c.P.T.DeclOf(et) {
                            c.err(memberSpan(msp, c.text(n).Len()), c.noCase(et, n))
                            return c.lit(sp, types.BoolT, 0)
                        }
                    }
                    nomatch { }
                }
                # no case: a call, its value compared by "==" (S13d) - Point(1, 2), Label("x")
                xs Vec<ast.Expr&>
                for q in subs {
                    match q {
                        case ast.Pattern.Value(_, x), ast.Pattern.Path(_, x) { xs.Push(x) }
                        nomatch {
                            c.gap(q.Span(), "a binding in a call compared as a value (S13d)")
                            return c.lit(sp, types.BoolT, 0)
                        }
                    }
                }
                return c.valueTest(sp, place, ast.Expr.Call(sp, path, xs.ToArray()), t)
            }
            tst := c.isCase(sp, place, k)
            sig := c.P.CaseSig(et, k)
            ps := c.P.T.Items(c.P.T.Params(sig))
            if ps.Len() != subs.Len() {
                c.err(sp, msgs.ArgCount(ps.Len(), "" if ps.Len() == 1 else "s", subs.Len()))
                return c.lit(sp, types.BoolT, 0)
            }
            base := place
            if c.isRef(t) { base = typed.Lvalue.Deref(sp, et, c.read(sp, place)) }
            rec := c.P.T.Items(c.P.T.Cases(et))[k]
            pp := typed.Lvalue.Payload(sp, rec, typed.Payload(base, k, typed.Check.None))
            for i in range subs.Len() {
                fp := typed.Lvalue.Field(subs[i].Span(), ps[i], pp, i)
                tst = c.and2(sp, tst, c.pattern(subs[i], fp, ps[i], binds, arm))
            }
            return tst
        }
        case ast.Pattern.Value(_, x) { return c.exprPattern(x, place, t, binds, arm, true) }
    }
}

# an expression the parser left as a value (DESIGN.md point 13), read as the pattern it is where it names an enum case:
# a path a case with any payload, a call a case with its payload's patterns - in a payload position a name binding,
# "_" nothing (S13); anything else a value compared by "==" (S13d)
fn (c mut Checker&) exprPattern(x ast.Expr&, place typed.Lvalue&c, t types.TypeId, binds mut Vec<typed.Bind&>&c, arm I64, top Bool) typed.Expr&c {
    et := c.deref(t)
    sp := x.Span()
    match x {
        case ast.Expr.Name(nsp, n) {
            if not top {
                if c.text(n) == "_" { return c.lit(nsp, types.BoolT, 1) }
                return c.pattern(ast.Pattern.Bind(nsp, n), place, t, binds, arm)
            }
        }
        case ast.Expr.Member(_, _, _) {
            k := c.caseTag(x, et)
            if k >= 0 { return c.isCase(sp, place, k) }
        }
        case ast.Expr.Call(_, f, args) {
            k := c.caseTag(f, et)
            if k >= 0 {
                tst := c.isCase(sp, place, k)
                ps := c.P.T.Items(c.P.T.Params(c.P.CaseSig(et, k)))
                if ps.Len() != args.Len() {
                    c.err(sp, msgs.ArgCount(ps.Len(), "" if ps.Len() == 1 else "s", args.Len()))
                    return c.lit(sp, types.BoolT, 0)
                }
                base := place
                if c.isRef(t) { base = typed.Lvalue.Deref(sp, et, c.read(sp, place)) }
                rec := c.P.T.Items(c.P.T.Cases(et))[k]
                pp := typed.Lvalue.Payload(sp, rec, typed.Payload(base, k, typed.Check.None))
                for i in range args.Len() {
                    fp := typed.Lvalue.Field(args[i].Span(), ps[i], pp, i)
                    tst = c.and2(sp, tst, c.exprPattern(args[i], fp, ps[i], binds, arm, false))
                }
                return tst
            }
            # a case of another enum, or of another instance of this one (G6b), with its payload: said as the type
            # it is, its payload's parts not read as values
            if c.caseWritten(f) {
                wt := c.writtenEnum(f)
                if wt >= types.TypeId(0) {
                    c.err(x.Span(), msgs.CaseValueType(c.ty(c.deref(t)), c.ty(wt)))
                    return c.lit(sp, types.BoolT, 0)
                }
            }
        }
        nomatch { }
    }
    return c.valueTest(sp, place, x, t)
}

# the enum a case written names - "Shape.Rect", "Opt<F64>.Some", a generic one bare ("Opt.Some") as its declaration's
# own type; -1 for none
fn (c mut Checker&) writtenEnum(f ast.Expr&) types.TypeId {
    match f {
        case ast.Expr.Member(_, prefix, _) {
            t := c.typeNamed(prefix)
            if t >= types.TypeId(0) { return t }
            d := c.genericNamed(prefix)
            if d >= types.DeclId(0) { return c.P.SelfType(d) }
        }
        nomatch { }
    }
    return types.TypeId(-1)
}

fn (c mut Checker&) isCase(sp source.Span, place typed.Lvalue&c, tag I64) typed.Expr&c {
    return c.prim(sp, types.BoolT, typed.PrimOp.IsCase, c.read(sp, place), c.lit(sp, c.i64(), tag))
}

# a value alternative: the place's value "==" it (S13d), a literal adapting to the subject's type
fn (c mut Checker&) valueTest(sp source.Span, place typed.Lvalue&c, x ast.Expr&, t types.TypeId) typed.Expr&c {
    v := c.expr(x, c.literalBeside(t) if c.isNumber(t) else t)
    if not c.meets(c.deref(t), c.deref(typeOf(v))) {
        c.err(x.Span(), msgs.CaseValueType(c.ty(c.deref(t)), c.tyOf(v)))
        return c.lit(sp, types.BoolT, 0)
    }
    return c.opValues(sp, sp, token.Tok.EqEq, c.value(c.read(sp, place), sp), v, sp, x.Span())
}

# ---- case tests and narrowing (E32, S8d) ----

# whether an expression is a case written - "Shape.Circle", "Shape.Rect(_, 2.0)" - of an enum the name before it names
fn (c mut Checker&) caseWritten(x ast.Expr&) Bool {
    if c.caseDesc(x).K == generic.DescCase { return true }
    match x {
        case ast.Expr.Member(_, prefix, n) {
            t := c.typeNamed(prefix)
            if t < types.TypeId(0) {
                # G6b: a generic enum's case written with the enum bare
                d := c.genericNamed(prefix)
                if d < types.DeclId(0) or c.P.T.DeclKindOf(d) != types.DeclKind.Enum { return false }
                t = c.P.SelfType(d)
            }
            if not c.isEnum(t) { return false }
            cn := c.P.T.CaseNames(t)
            if cn.Len() == 0 { return false }
            for k in cn {
                if k == n { return true }
            }
            return false
        }
        case ast.Expr.Call(_, f, _) { return c.caseWritten(f) }
        nomatch { return false }
    }
}

# a case's descriptor an expression names (G34): DescNone where it names none
fn (c mut Checker&) caseDesc(x ast.Expr&) generic.Desc {
    dt := c.descTypeOf(x)
    if dt <= types.UnknownT { return generic.Desc(generic.DescNone, types.UnknownT, 0, 0) }
    return c.P.DescOf(dt)
}

# the case path of a case written, "Shape.Rect" of "Shape.Rect(_, 2.0)"
fn casePath(x ast.Expr&) ast.Expr&x {
    match x {
        case ast.Expr.Call(_, f, _) { return f }
        nomatch { return x }
    }
}

# E32: x == Case (or !=): which case x holds - a reference read through, a null holding none - and each payload part
# written compared, "_" matching anything, a case written there a nested test
fn (c mut Checker&) caseCompare(sp source.Span, op token.Tok, xa ast.Expr&, pat ast.Expr&) typed.Expr&c {
    c.enumWanted = true
    x := c.expr(xa, types.UnknownT)
    xt := typeOf(x)
    if xt == types.UnknownT { return c.unknown(sp) }
    et := c.deref(xt)
    cd := c.caseDesc(pat)
    if cd.K == generic.DescCase and not c.P.T.Same(cd.Of, et) and not c.P.T.Same(c.P.ReflUnder(cd.Of), et) {
        c.err(pat.Span(), msgs.ReflCaseOther(c.ty(cd.Of), c.ty(et)))
        return c.unknown(sp)
    }
    if cd.K == generic.DescCase and c.P.T.KindOf(et) == types.Kind.ErrVal {
        # T20: an error value's word - its code compared
        codes := c.P.ErrValCodes(et)
        if cd.Case >= codes.Len() { return c.unknown(sp) }
        return c.opValues(sp, sp, op, x, c.lit(pat.Span(), et, codes[cd.Case]), sp, pat.Span())
    }
    if cd.K == generic.DescCase and c.isStruct(et) {
        # G34: a struct's one case - every value holds it
        c.emit(typed.Stmt.Eval(sp, x))
        return c.lit(sp, types.BoolT, 1 if op == token.Tok.EqEq else 0)
    }
    if not c.isEnum(et) {
        c.err(pat.Span(), msgs.CaseTestNotEnum(c.src(casePath(pat).Span()), c.ty(et)))
        return c.unknown(sp)
    }
    if c.caseTag(casePath(pat), et) < 0 {
        c.err(pat.Span(), msgs.CaseTestOther(c.src(casePath(pat).Span()), c.ty(et)))
        return c.unknown(sp)
    }
    base := readPlace(x)
    if base is null { base = typed.Lvalue.Temp(sp, xt, x, c.site(typed.SiteKind.Temp, sp)) }
    r := c.caseTest(pat, base!, xt)
    return c.negate(sp, r) if op == token.Tok.NotEq else r
}

# a part of a case test at place, of type t: "_" anything, a case of t's enum a test of it and of its own parts, any other
# expression compared by "==" (S13d)
fn (c mut Checker&) caseTest(x ast.Expr&, place typed.Lvalue&c, t types.TypeId) typed.Expr&c {
    et := c.deref(t)
    sp := x.Span()
    cd := c.caseDesc(x)
    if cd.K == generic.DescCase { return c.isCase(sp, place, cd.Case) }
    match x {
        case ast.Expr.Name(nsp, n) {
            if c.text(n) == "_" { return c.lit(nsp, types.BoolT, 1) }
        }
        case ast.Expr.Member(_, _, _) {
            k := c.caseTag(x, et)
            if k >= 0 { return c.isCase(sp, place, k) }
        }
        case ast.Expr.Call(_, f, args) {
            k := c.caseTag(f, et)
            if k >= 0 {
                tst := c.isCase(sp, place, k)
                ps := c.P.T.Items(c.P.T.Params(c.P.CaseSig(et, k)))
                if ps.Len() != args.Len() {
                    c.err(sp, msgs.ArgCount(ps.Len(), "" if ps.Len() == 1 else "s", args.Len()))
                    return c.lit(sp, types.BoolT, 0)
                }
                base := place
                if c.isRef(t) { base = typed.Lvalue.Deref(sp, et, c.read(sp, place)) }
                rec := c.P.T.Items(c.P.T.Cases(et))[k]
                pp := typed.Lvalue.Payload(sp, rec, typed.Payload(base, k, typed.Check.None))
                for i in range args.Len() {
                    fp := typed.Lvalue.Field(args[i].Span(), ps[i], pp, i)
                    tst = c.and2(sp, tst, c.caseTest(args[i], fp, ps[i]))
                }
                return tst
            }
        }
        nomatch { }
    }
    return c.valueTest(sp, place, x, t)
}

# S8d: the local a condition narrows and the case it narrows it to - "e == Shape.Circle" for want ==, "e != ..." for
# want != - where e is a local or a parameter holding an enum or a reference to one; -1, -1 for none
fn (c mut Checker&) narrowOf(k0 ast.Expr&, want token.Tok) I64, I64 {
    match k0 {
        case ast.Expr.Binary(_, op, a, b) {
            if op != want { return -1, -1 }
            nx := a
            pat := b
            if c.caseWritten(a) and not c.caseWritten(b) {
                nx = b
                pat = a
            } else if not c.caseWritten(b) {
                return -1, -1
            }
            match nx {
                case ast.Expr.Name(_, n) {
                    id := c.localNamed(n)
                    if id < 0 { return -1, -1 }
                    l := c.cur().Locals[id]
                    if l.Kind != typed.LocalKind.Param and l.Kind != typed.LocalKind.Var and l.Kind != typed.LocalKind.Binding {
                        return -1, -1
                    }
                    et := c.deref(l.Ty)
                    if not c.isEnum(et) { return -1, -1 }
                    k := c.caseTag(casePath(pat), et)
                    return (id if k >= 0 else -1), k
                }
                nomatch { return -1, -1 }
            }
        }
        nomatch { return -1, -1 }
    }
}

# S8d: local id known to hold case k from here to the end of the current block: its payload's fields copied into
# locals of the block, read where e.f is written
fn (c mut Checker&) narrow(sp source.Span, id I64, k I64, b I64) {
    fr := c.fr()
    t := c.localType(id)
    et := c.deref(t)
    from := fr.narrowFields.Len()
    ps := c.P.T.Items(c.P.T.Params(c.P.CaseSig(et, k)))
    if ps.Len() > 0 {
        place typed.Lvalue&c = typed.Lvalue.Local(sp, t, typed.LocalId(I32(id)))
        base := place
        if c.isRef(t) { base = typed.Lvalue.Deref(sp, et, c.read(sp, place)) }
        rec := c.P.T.Items(c.P.T.Cases(et))[k]
        pp mut typed.Lvalue&c = typed.Lvalue.Payload(sp, rec, typed.Payload(base, k, typed.Check.None))
        for i in range ps.Len() {
            fl := c.local(source.NameId(0), sp, ps[i], typed.LocalKind.Binding, typed.Mark.Infer)
            v := c.read(sp, typed.Lvalue.Field(sp, ps[i], pp, i))
            c.roLet(fl, v)
            c.emit(typed.Stmt.Let(sp, typed.LocalId(I32(fl)), v))
            fr.narrowFields.Push(fl)
        }
    }
    fr.narrows.Push(narrowed(id, k, et, from, b))
}

# S8d: a local narrowed to a case whose payload is one type written whole ("Round Circle"): the payload's copy, which
# the local's name reads where it is narrowed; -1 for none
fn (c mut Checker&) wholeNarrowed(id I64) I64 {
    fr := c.fr()
    for j in range fr.narrows.Len() {
        nr := fr.narrows[fr.narrows.Len() - 1 - j]
        if nr.Local != id or nr.Dead { continue }
        cd := caseDecl(c.P.TypeDecl(c.P.T.DeclOf(nr.Enum)), nr.Tag)
        if cd is null or not cd.Whole { return -1 }
        return fr.narrowFields[nr.From]
    }
    return -1
}

fn caseDecl(td ast.TypeDecl?&, k I64) ast.CaseDecl?&td {
    if td is null or td.Body is null { return null }
    match td.Body {
        case ast.TypeBody.Enum(cases, _) { return cases[k] if k < cases.Len() else null }
        nomatch { return null }
    }
}

# S8d: whether a value reads a narrowed local's payload copy
fn (c mut Checker&) narrowCopy(x typed.Expr&) Bool {
    p := readPlace(x)
    if p is null { return false }
    match p {
        case typed.Lvalue.Local(_, _, id) {
            for k in c.fr().narrowFields { if k == I64(id) { return true } }
        }
        nomatch { }
    }
    return false
}

# S8d: x.n where x names a narrowed local and n a field of its case's payload: the field's copy, -1 for none
fn (c mut Checker&) narrowedName(x ast.Expr&, n source.NameId) I64 {
    match x {
        case ast.Expr.Name(_, en) {
            id := c.localNamed(en)
            if id >= 0 { return c.narrowedField(id, n) }
        }
        nomatch { }
    }
    return -1
}

# S8d: a payload field of a narrowed local, "e.r": its copy's local, -1 where e is not narrowed or has no such field
fn (c mut Checker&) narrowedField(id I64, n source.NameId) I64 {
    fr := c.fr()
    for j in range fr.narrows.Len() {
        nr := fr.narrows[fr.narrows.Len() - 1 - j]
        if nr.Local != id or nr.Dead { continue }
        cd := caseDecl(c.P.TypeDecl(c.P.T.DeclOf(nr.Enum)), nr.Tag)
        if cd is null or cd.Whole { return -1 }
        ps := cd.Payload
        if ps.Len() == 0 { return -1 }
        for i in range ps.Len() {
            if ps[i].Name == n { return fr.narrowFields[nr.From + i] }
        }
        return -1
    }
    return -1
}

fn casePayload(td ast.TypeDecl?&, k I64) Array<ast.Param&>&td {
    if td is null or td.Body is null { return Array<ast.Param&>(0) }
    match td.Body {
        case ast.TypeBody.Enum(cases, _) { return cases[k].Payload if k < cases.Len() else Array<ast.Param&>(0) }
        nomatch { return Array<ast.Param&>(0) }
    }
}

# S8d: whether statements assign name n anywhere - "n = ...", "n op= ...", "n++", a target list naming it - in their
# blocks, branches, loops, clauses and matches, and in the clauses and match values inside any expression of theirs (a
# lambda's capture is a copy, and cannot). One walk over every kind, written without a catch-all so a new kind must say
# what it holds; read by S8d's and S8e's narrowing and D14d's counted fill
fn assignsName(body Array<ast.Stmt&>&, n Array<source.NameId>&) Bool {
    if body.Len() == 0 { return false }
    for st in body {
        if stmtAssigns(st, n) { return true }
    }
    return false
}

fn stmtAssigns(st ast.Stmt?&, n Array<source.NameId>&) Bool {
    if st is null { return false }
    match st {
        case ast.Stmt.ExprS(_, x), ast.Stmt.Yield(_, x) { return exprAssigns(x, n) }
        case ast.Stmt.Var(_, v) { return exprsAssign(v.Values, n) }
        case ast.Stmt.Assign(_, _, t, v) { return hitsPath(t, n) or exprAssigns(t, n) or exprAssigns(v, n) }
        case ast.Stmt.Multi(_, m) {
            for t in m.Targets {
                if hitsPath(t, n) or exprAssigns(t, n) { return true }
            }
            return exprsAssign(m.Values, n)
        }
        case ast.Stmt.TryStore(_, inner, cl) { return stmtAssigns(inner, n) or clausesAssign(cl, n) }
        case ast.Stmt.If(_, i) { return ifAssigns(i, n) }
        case ast.Stmt.Forever(_, b), ast.Stmt.Block(_, b) { return assignsName(b, n) }
        case ast.Stmt.While(_, w, b), ast.Stmt.DoFor(_, b, w) { return exprAssigns(w, n) or assignsName(b, n) }
        case ast.Stmt.For3(_, f) {
            return stmtAssigns(f.Init, n) or exprAssigns(f.Cond, n) or stmtAssigns(f.Post, n) or assignsName(f.Body, n)
        }
        case ast.Stmt.ForIn(_, f) {
            return exprAssigns(f.Source, n) or assignsName(f.Body, n) or clausesAssign(f.Clauses, n)
        }
        case ast.Stmt.MatchS(_, m) { return matchAssigns(m, n) }
        case ast.Stmt.Return(_, xs) { return exprsAssign(xs, n) }
        case ast.Stmt.Become(_, x) { return exprAssigns(x, n) }
        case ast.Stmt.Jump(_, _, msg) { return exprAssigns(msg, n) }
        case ast.Stmt.Assert(_, c, msg) { return exprAssigns(c, n) or exprAssigns(msg, n) }
        case ast.Stmt.Raise(_, _) { return false }
        case ast.Stmt.Join(_, j) { return assignsName(j.Body, n) or clausesAssign(j.Clauses, n) }
        case ast.Stmt.Defer(_, inner, _) { return stmtAssigns(inner, n) }
        case ast.Stmt.Spawn(_, targets, call) {
            for t in targets {
                if hitsPath(t, n) or exprAssigns(t, n) { return true }
            }
            return exprAssigns(call, n)
        }
    }
}

fn ifAssigns(i ast.If&, n Array<source.NameId>&) Bool {
    if exprAssigns(i.Cond, n) { return true }
    if i.Then is not null and assignsName(i.Then!.Body, n) { return true }
    return stmtAssigns(i.Else, n)
}

fn matchAssigns(m ast.Match&, n Array<source.NameId>&) Bool {
    if exprAssigns(m.Subject, n) { return true }
    for cs in m.Cases {
        if caseAssigns(cs, n) { return true }
    }
    return m.NoMatch is not null and caseAssigns(m.NoMatch!, n)
}

fn caseAssigns(cs ast.Case&, n Array<source.NameId>&) Bool {
    return exprAssigns(cs.Guard, n) or assignsName(cs.Body, n) or exprAssigns(cs.Value, n)
}

fn clausesAssign(cl Array<ast.Catch&>&, n Array<source.NameId>&) Bool {
    if cl.Len() == 0 { return false }
    for k in cl {
        if assignsName(k.Body, n) or exprsAssign(k.Defaults, n) { return true }
    }
    return false
}

fn exprsAssign(xs Array<ast.Expr&>&, n Array<source.NameId>&) Bool {
    if xs.Len() == 0 { return false }
    for x in xs {
        if exprAssigns(x, n) { return true }
    }
    return false
}

# whether an expression's statements - a try's clauses, a match value's blocks, at any depth in it - assign n, or it
# increments n
fn exprAssigns(x ast.Expr?&, n Array<source.NameId>&) Bool {
    if x is null { return false }
    match x {
        case ast.Expr.Name(_, _), ast.Expr.Lit(_, _), ast.Expr.Default(_) { return false }
        case ast.Expr.Lambda(_, _) { return false }
        case ast.Expr.Unary(_, op, y), ast.Expr.Postfix(_, op, y) {
            if (op == token.Tok.Inc or op == token.Tok.Dec) and hitsPath(y, n) { return true }
            return exprAssigns(y, n)
        }
        case ast.Expr.Paren(_, y), ast.Expr.Named(_, _, y), ast.Expr.Member(_, y, _), ast.Expr.Generic(_, y, _) {
            return exprAssigns(y, n)
        }
        case ast.Expr.IsType(_, y, _, _), ast.Expr.As(_, y, _) { return exprAssigns(y, n) }
        case ast.Expr.Binary(_, _, a, b), ast.Expr.NotIn(_, a, b), ast.Expr.Is(_, a, b, _) {
            return exprAssigns(a, n) or exprAssigns(b, n)
        }
        case ast.Expr.Chain(_, ch) { return exprsAssign(ch.Xs, n) }
        case ast.Expr.Cond(_, a, c, b) { return exprAssigns(a, n) or exprAssigns(c, n) or exprAssigns(b, n) }
        case ast.Expr.Call(_, f, args), ast.Expr.ScopeCall(_, f, _, args), ast.Expr.Index(_, f, args) {
            return exprAssigns(f, n) or exprsAssign(args, n)
        }
        case ast.Expr.Slice(_, y, lo, hi) { return exprAssigns(y, n) or exprAssigns(lo, n) or exprAssigns(hi, n) }
        case ast.Expr.ArrayLit(_, _, items), ast.Expr.Row(_, items), ast.Expr.Join(_, items), ast.Expr.Range(_, items) {
            return exprsAssign(items, n)
        }
        case ast.Expr.Compr(_, cm) {
            return exprAssigns(cm.Value, n) or exprAssigns(cm.Source, n) or exprAssigns(cm.Filter, n)
        }
        case ast.Expr.Try(_, y, cl) { return exprAssigns(y, n) or clausesAssign(cl, n) }
        case ast.Expr.MatchE(_, m) { return matchAssigns(m, n) }
    }
}

# whether a statement is "p = v" assigning the path n or one it starts with, its value reading n before the store (S8e)
fn assignsWhole(st ast.Stmt&, n Array<source.NameId>&) Bool {
    match st {
        case ast.Stmt.Assign(_, op, t, v) { return op == token.Tok.Assign and hitsPath(t, n) and not exprAssigns(v, n) }
        nomatch { return false }
    }
}

# S8e: the paths a condition says are not null when it is positive (true) or not: "p is not null", "p is null" when
# false, "and" when true, "or" when false, "not" turning it round
fn nullTests(x ast.Expr?&, positive Bool, out mut Vec<Array<source.NameId>&>&) {
    if x is null { return }
    match x {
        case ast.Expr.Paren(_, y) { nullTests(y, positive, out) }
        case ast.Expr.Unary(_, op, y) {
            if op == token.Tok.Not { nullTests(y, not positive, out) }
        }
        case ast.Expr.Is(_, a, b, negated) {
            if isNullLit(b) and negated == positive {
                p := pathOf(a)
                if p.Len() > 0 { out.Push(p) }
            }
        }
        case ast.Expr.Binary(_, op, a, b) {
            if (op == token.Tok.And and positive) or (op == token.Tok.Or and not positive) {
                nullTests(a, positive, out)
                nullTests(b, positive, out)
            }
        }
        nomatch { }
    }
}

fn samePath(a Array<source.NameId>&, b Array<source.NameId>&) Bool {
    if a.Len() != b.Len() { return false }
    for i in range a.Len() {
        if a[i] != b[i] { return false }
    }
    return true
}

# whether an assignment's target t changes what the path n (a name and the fields after it) reads: t is n, or a
# shorter path n starts with - "n = x" and "n.next = x" both change "n.next", "n.next.v = 3" does not (S8d, S8e)
fn hitsPath(t ast.Expr&, n Array<source.NameId>&) Bool {
    tp := pathOf(t)
    if tp.Len() == 0 or tp.Len() > n.Len() { return false }
    for i in range tp.Len() {
        if tp[i] != n[i] { return false }
    }
    return true
}

# a name and the fields read after it ("n.next.next"), null for anything else
fn pathOf(x ast.Expr&) Array<source.NameId>&x {
    match x {
        case ast.Expr.Name(_, m) { return Array<source.NameId>(1, m) }
        case ast.Expr.Paren(_, y) { return pathOf(y) }
        case ast.Expr.Member(_, y, f) {
            p := pathOf(y)
            if p.Len() == 0 { return Array<source.NameId>(0) }
            out := Array<source.NameId>(p.Len() + 1, f)
            for i in range p.Len() { out[i] = p[i] }
            return out
        }
        case _ { return Array<source.NameId>(0) }
    }
}

# ---- locals never read (D3b) ----

# D3b, once an attempt has checked every body without an error: each local names found declared and never read is an
# error - one of a place only (a loop's, a binding's) always; a declared one unless its type has a destructor (its
# scope's close is what it is held for) in any instance of its body; one in no checked body (a branch evaluation left
# out, a generic never instantiated) is not judged
fn (c mut Checker&) settleUnread() {
    if c.P.R.Unreads.Len() == 0 { return }
    # said of a program with no other error: a read may be what a mistake left out, or sit in code another mistake
    # keeps from checking - one mistake, one error
    if c.P.L.Diags.Errors() > 0 { return }
    held Map<pair.Pair<I64, I64>, Bool>   # (file, where the name is written) -> it is to be said
    for b in c.Bodies {
        if b.Root is null { continue }
        for l in b.Locals {
            if l.Kind != typed.LocalKind.Var or l.Name == source.NameId(0) { continue }
            k := pair.Pair(b.File, (I64(l.Sp.Start) << 32) | I64(l.Sp.End))
            say := l.Ty != types.UnknownT and not c.destructs(l.Ty)
            if held.Has(k) and not (try held.Get(k) catch default true) { continue }
            held.Put(k, say)
        }
    }
    for u in c.P.R.Unreads {
        where := diag.Where.Span(u.File, I64(u.Sp.Start), I64(u.Sp.End))
        if u.Bare {
            c.P.L.Diags.Error(where, msgs.LocalUnusedBare(c.tok(u.Name)))
            continue
        }
        k := pair.Pair(u.File, (I64(u.Sp.Start) << 32) | I64(u.Sp.End))
        if not (try held.Get(k) catch default false) { continue }
        c.P.L.Diags.Error(where, msgs.LocalUnused(c.tok(u.Name)))
    }
}

# ---- calls that do nothing (S3) ----

# S3, once an attempt has checked every body: a call statement whose value is dropped and that does nothing else is an
# error. What a call does is read off the bodies it reaches - a least fixed point over them, a body unchecked doing
# something: a body does something where it stores into a global or through a reference, calls an extern (but C's math
# functions, X8), a function value, an "any"'s method or a body that does, makes storage (a text, an array, a
# temporary given a place - memory the program uses) or a value with a destructor, spawns or joins, asserts, or ends
# the program or would on a failed check
fn (c mut Checker&) settleIdle() {
    if c.idle.Len() == 0 { return }
    at Map<I64, I64>
    seen Vec<I64>
    does Vec<Bool>
    edges Vec<pair.Pair<I64, I64>>
    direct Vec<Bool>
    from Vec<I64>
    reach Vec<I64>
    for cand in c.idle {
        from.Push(reach.Len())
        calls Vec<I64>
        direct.Push(c.effX(cand.X, calls))
        for b in calls {
            reach.Push(b)
            if not at.Has(b) {
                at.Put(b, seen.Len())
                seen.Push(b)
                does.Push(false)
            }
        }
    }
    from.Push(reach.Len())
    for k := 0, k < seen.Len(), k++ {
        b := seen[k]
        if b < 0 or b >= c.Bodies.Len() or c.Bodies[b].Root is null {
            does[k] = true
            continue
        }
        calls Vec<I64>
        if c.effB(c.Bodies[b].Root, calls) {
            does[k] = true
            continue
        }
        for cb in calls {
            edges.Push(pair.Pair(k, cb))
            if not at.Has(cb) {
                at.Put(cb, seen.Len())
                seen.Push(cb)
                does.Push(false)
            }
        }
    }
    changed := true
    for changed {
        changed = false
        for e in edges {
            if does[e.First] { continue }
            if does[try at.Get(e.Second) catch default 0] {
                does[e.First] = true
                changed = true
            }
        }
    }
    for i, cand in c.idle {
        if direct[i] or cand.Body < 0 or cand.Body >= c.Bodies.Len() { continue }
        idle := true
        for j in range from[i], from[i + 1] {
            if does[try at.Get(reach[j]) catch default 0] { idle = false }
        }
        if not idle { continue }
        c.P.L.Diags.Error(diag.Where.Span(cand.File, I64(cand.Sp.Start), I64(cand.Sp.End)), msgs.CallDoesNothing(cand.Text))
    }
}

# S3: whether an expression may do something beyond giving its value, the bodies it calls added to calls
fn (c mut Checker&) effX(x typed.Expr?&, calls mut Vec<I64>&) Bool {
    if x is null { return false }
    match x {
        case typed.Expr.Lit(_, _, _), typed.Expr.Data(_, _, _, _), typed.Expr.Fn(_, _, _) { return false }
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p), typed.Expr.Take(_, _, p) { return c.effP(p, calls, false) }
        # storage made - a temporary given a place, a text, an array, a comprehension's - is memory the program uses
        case typed.Expr.Promote(_, _, _), typed.Expr.Text(_, _, _), typed.Expr.Collect(_, _, _) { return true }
        case typed.Expr.Call(_, t, cl) {
            if c.destructs(t) { return true }
            match cl.Target {
                case typed.Callee.Body(id) { calls.Push(I64(id)) }
                case typed.Callee.Extern(f) {
                    fd := c.P.FnDecl(f)
                    if not typed.MathExtern(c.text(fd.Name), fd.S.Params.Len()) { return true }
                }
                case typed.Callee.Value(_), typed.Callee.Dispatch(_, _, _) { return true }
                case typed.Callee.Helper(_, _) { }
            }
            for a in cl.Args {
                if c.effX(a, calls) { return true }
            }
            return false
        }
        case typed.Expr.Make(_, _, m) {
            if I64(m.Site) >= 0 or m.Checked == typed.Check.Abort or c.effX(m.Length, calls) { return true }
            for y in m.Items {
                if c.effX(y, calls) { return true }
            }
            return false
        }
        case typed.Expr.Prim(_, _, op, ck, args) {
            if ck == typed.Check.Abort or effectOp(op) { return true }
            for y in args {
                if c.effX(y, calls) { return true }
            }
            return false
        }
        case typed.Expr.Slice(_, _, sl) {
            return sl.Checked == typed.Check.Abort or c.effP(sl.Base, calls, false) or c.effX(sl.Lo, calls) or c.effX(sl.Hi, calls)
        }
        case typed.Expr.Cond(_, _, cd) { return c.effX(cd.C, calls) or c.effX(cd.A, calls) or c.effX(cd.B, calls) }
        case typed.Expr.Seq(_, _, q) { return c.effSs(q.Stmts, calls) or c.effX(q.X, calls) }
        case typed.Expr.Match(_, _, m) {
            if c.effSs(m.Held, calls) { return true }
            for a in m.Arms {
                if c.effArm(a, calls) { return true }
            }
            return m.NoMatch is not null and c.effArm(m.NoMatch!, calls)
        }
        case typed.Expr.Try(_, _, tr) {
            if tr.Ends or c.effX(tr.X, calls) { return true }
            for cl in tr.Clauses {
                if c.effB(cl.Code, calls) { return true }
                for d in cl.Defaults {
                    if c.effX(d, calls) { return true }
                }
            }
            return false
        }
        case typed.Expr.Away(_, _, y) { return c.effX(y, calls) }
    }
}

fn (c mut Checker&) effArm(a typed.Arm&, calls mut Vec<I64>&) Bool {
    for alt in a.Alts {
        if c.effX(alt.Test, calls) { return true }
        for bd in alt.Binds {
            if c.effX(bd.From, calls) { return true }
        }
    }
    return c.effX(a.Guard, calls) or c.effB(a.Code, calls) or c.effX(a.Value, calls)
}

# S3: whether reading (or, store, writing) a place may do something: a store into a global or through a reference
fn (c mut Checker&) effP(p typed.Lvalue&, calls mut Vec<I64>&, store Bool) Bool {
    match p {
        case typed.Lvalue.Local(_, _, _), typed.Lvalue.Target(_, _) { return false }
        case typed.Lvalue.Global(_, _, _, _) { return store }
        case typed.Lvalue.Deref(_, _, r) { return store or c.effX(r, calls) }
        case typed.Lvalue.Field(_, _, base, _) { return c.effP(base, calls, store) }
        case typed.Lvalue.Elem(_, _, e) {
            if e.Checked == typed.Check.Abort or (store and c.isRef(e.Base.Type())) { return true }
            return c.effP(e.Base, calls, store) or c.effX(e.Index, calls)
        }
        case typed.Lvalue.Payload(_, _, pl) { return pl.Checked == typed.Check.Abort or c.effP(pl.Base, calls, store) }
        case typed.Lvalue.Temp(_, _, v, _) { return c.effX(v, calls) }
    }
}

fn (c mut Checker&) effB(b typed.Block?&, calls mut Vec<I64>&) Bool {
    if b is null { return false }
    return c.effSs(b.Stmts, calls)
}

fn (c mut Checker&) effSs(ss Array<typed.Stmt&>&, calls mut Vec<I64>&) Bool {
    for st in ss {
        if c.effS(st, calls) { return true }
    }
    return false
}

fn (c mut Checker&) effS(st typed.Stmt&, calls mut Vec<I64>&) Bool {
    match st {
        case typed.Stmt.Let(_, _, x), typed.Stmt.Eval(_, x), typed.Stmt.Yield(_, x) { return c.effX(x, calls) }
        case typed.Stmt.Assign(_, t, v) { return c.effP(t, calls, true) or c.effX(v, calls) }
        case typed.Stmt.If(_, i) { return c.effX(i.Test, calls) or c.effB(i.Then, calls) or c.effB(i.Else, calls) }
        case typed.Stmt.Loop(_, body, post) { return c.effB(body, calls) or c.effB(post, calls) }
        case typed.Stmt.Return(_, v), typed.Stmt.Suspend(_, v) { return c.effX(v, calls) }
        case typed.Stmt.Reraise(_, code, _) { return c.effX(code, calls) }
        case typed.Stmt.Jump(_, _, _), typed.Stmt.Raise(_, _, _) { return false }
        case typed.Stmt.Block(_, b), typed.Stmt.Defer(_, b) { return c.effB(b, calls) }
        case typed.Stmt.Exit(_, _, _), typed.Stmt.Assert(_, _, _), typed.Stmt.Join(_, _), typed.Stmt.Spawn(_, _) { return true }
    }
}

# S3: the operations that change what they are given
fn effectOp(op typed.PrimOp) Bool {
    return match op {
        case typed.PrimOp.AtomicStore, typed.PrimOp.AtomicAdd, typed.PrimOp.AtomicSwap, typed.PrimOp.AtomicCompareSwap => true
        case typed.PrimOp.Retire, typed.PrimOp.Destroy => true
        case _ => false
    }
}

# ---- every path returns (D10a) ----

# whether a block's statements provably leave: a return, raise or exit; an if whose two branches leave; a block that
# does; "for { }" with no break of its own (S9)
# S8d, S8e: whether a block never reaches the statement after it - it leaves the function (D10a), or a break or continue
# takes it out of a loop around it
fn skipsRest(b typed.Block?&) Bool {
    if b is null { return false }
    for s in b.Stmts {
        if leaves(s) { return true }
        match s {
            case typed.Stmt.Jump(_, _, _) { return true }
            case typed.Stmt.Block(_, ib) { if skipsRest(ib): return true }
            case typed.Stmt.If(_, i) { if i.Else is not null and skipsRest(i.Then) and skipsRest(i.Else): return true }
            nomatch { }
        }
    }
    return false
}

fn leavesBlock(b typed.Block?&) Bool {
    if b is null { return false }
    for s in b.Stmts {
        if leaves(s) { return true }
    }
    return false
}

fn leaves(s typed.Stmt&) Bool {
    match s {
        case typed.Stmt.Return(_, _) { return true }
        case typed.Stmt.Raise(_, _, _), typed.Stmt.Reraise(_, _, _) { return true }
        case typed.Stmt.Exit(_, _, _) { return true }
        case typed.Stmt.If(_, i) { return i.Else is not null and leavesBlock(i.Then) and leavesBlock(i.Else) }
        case typed.Stmt.Block(_, b) { return leavesBlock(b) }
        case typed.Stmt.Join(_, j) {
            # a join leaves when its block does and every clause of its "try join" does (D10a)
            if not leavesBlock(j.Code) { return false }
            for cl in j.Clauses {
                if not leavesBlock(cl.Code) { return false }
            }
            return true
        }
        # a do-while's condition, and so its break, is in its post clause
        case typed.Stmt.Loop(_, body, post) { return not typed.BreaksOut(body, body.Id) and not typed.BreaksOut(post, body.Id) }
        case typed.Stmt.Eval(_, x) {
            # a call of a noreturn function (D8e)
            if typeOf(x) == types.NoreturnT { return true }
            match x {
                case typed.Expr.Match(_, _, m) {
                    for a in m.Arms {
                        if not leavesBlock(a.Code) { return false }
                    }
                    return leavesBlock(m.NoMatch!.Code)
                }
                nomatch { return false }
            }
        }
        nomatch { return false }
    }
}

# ---- run-time trait values (T32-T34) ----

# T32a: a value made an "any R&" where one is wanted - borrowed where it is a struct's or an enum's storage (a place,
# what a reference names), built where it lands where it is a temporary, copied where it is a number, a Bool, a Char or
# an array; the instance's type satisfying R, and its table made
fn (c mut Checker&) toAny(x typed.Expr&c, want types.TypeId, sp source.Span) typed.Expr&c {
    have := typeOf(x)
    r := c.P.T.AnyTrait(want)

    if c.P.T.IsAny(have) {
        c.err(sp, msgs.AnyNotConverted(c.ty(have), c.ty(want)))
        return c.unknown(sp)
    }
    inst := c.deref(have)
    if inst == types.UnknownT or r == types.UnknownT { return x }
    if c.P.T.KindOf(inst) == types.Kind.Any or c.P.T.KindOf(inst) == types.Kind.Func or inst == types.VoidT or inst == types.NoreturnT or c.P.T.KindOf(inst) == types.Kind.Tuple {
        c.err(sp, msgs.TypeMismatch(c.ty(want), c.tyOf(x)))
        return x
    }
    # what is wrong said once: the value given the stand-in, which fits anything
    if not c.anyMeets(inst, r, sp) { return c.unknown(sp) }
    ti := c.anyTable(inst, r, sp)
    if ti < 0 { return c.unknown(sp) }
    perm := c.P.T.PermOf(want) & (types.Writable | types.Nullable)
    if c.anyCopies(inst) {
        v := c.fit(x, inst, sp)
        stored := c.P.AnyStored(inst)
        if stored != inst {
            from := c.exprs.Len()
            c.exprs.Push(v)
            v = typed.Expr.Make(sp, stored, typed.Make(typed.MakeKind.Tuple, 0, gather(c.exprs, from), null, typed.SiteId(-1), typed.Check.None))
        }
        box := typed.Expr.Promote(sp, c.P.T.Ref(stored, perm & types.Writable), typed.Promote(v, c.site(typed.SiteKind.Promote, sp)))
        return c.prim(sp, want, typed.PrimOp.AnyMake, box, c.lit(sp, c.i64(), ti))
    }
    ref := c.fit(x, c.P.T.Ref(inst, perm), sp)
    return c.prim(sp, want, typed.PrimOp.AnyMake, ref, c.lit(sp, c.i64(), ti))
}

# whether an instance of the type is copied into an "any" (T32a): a number, a Bool, a Char, a type over one - no
# reference names them - and an array, whose elements are copied with it
fn (c mut Checker&) anyCopies(t types.TypeId) Bool {
    return not c.referable(t) or c.P.T.KindOf(c.under(t)) == types.Kind.Array
}

# whether every type a closed trait lists is one (T31a): a generic one listed without its arguments is said at the
# trait's declaration, and leaves nothing to say where the trait is met
fn (c mut Checker&) membersWritten(tr types.TypeId) Bool {
    for m in c.P.Members(tr) {
        if m == types.UnknownT { return false }
        if c.P.T.KindOf(m) == types.Kind.Named and c.P.T.DeclParams(c.P.T.DeclOf(m)) != c.P.T.Items(c.P.T.Args(m)).Len() { return false }
    }
    return true
}

# the types a closed trait lists, as a message names them: a run of integer widths one after another written as its
# first and last ("I1 to I128", T4a)
fn (c mut Checker&) memberListing(tr types.TypeId) StringBuilder {
    b := StringBuilder()
    ms := c.P.Members(tr)
    i I64 = 0
    for i < ms.Len() {
        if b.Len() > 0 { b.Push(", ") }
        b.Push(c.ty(ms[i]))
        j := i
        for j + 1 < ms.Len() and c.P.T.IsInt(ms[j]) and c.P.T.IsInt(ms[j + 1]) and
            c.P.T.IsUnsigned(ms[j]) == c.P.T.IsUnsigned(ms[j + 1]) and c.P.T.Bits(ms[j + 1]) == c.P.T.Bits(ms[j]) + 1 {
            j++
        }
        if j > i + 1 {
            b.Push(" to ")
            b.Push(c.ty(ms[j]))
            i = j
        }
        i++
    }
    return b
}

# whether a type satisfies a trait for an "any" (T32a), what it lacks said where it does not
fn (c mut Checker&) anyMeets(t types.TypeId, r types.TypeId, sp source.Span) Bool {
    u := c.P.Missing(t, r)
    if u.Var < 0 { return true }
    tn := c.ty(r)
    if u.Closed {
        if not c.membersWritten(u.Trait) { return false }
        listing := c.memberListing(u.Trait)
        c.err(sp, msgs.AnyNotMember(c.ty(t), tn, listing.ToString()))
    } else if u.Named {
        rec := c.err(sp, msgs.AnyUnmetMethod(c.ty(t), tn, c.tok(u.Method)))
        # one of its name with another signature - a "mut" one writing what the trait only reads among them - said too
        sm := c.P.MethodOf(t, u.Method)
        if sm >= 0 { c.noteAt(rec, sm, msgs.NoteOtherSignature(c.text(u.Method))) }
    } else {
        c.err(sp, msgs.AnyUnmet(c.ty(t), tn))
    }
    return false
}

# the table of a type and a trait (T32): made the first time it is asked for, a body for each slot calling the method
# the type meets it with - checked like any other - and $'s rendering of the type made where it calls a Str; -1 where a
# method's scopes say more than the trait's signature (said where the table is first asked for)
fn (c mut Checker&) anyTable(t types.TypeId, r types.TypeId, sp source.Span) I64 {
    ti, fresh := c.P.AnyTableFor(t, r, c.fr().File, sp)
    if not fresh { return -1 if c.anyBad.Has(ti) else ti }
    slots := c.P.AnySlots(r)
    stored := c.P.AnyStored(c.P.T.Plain(t))
    for k in range slots.Len() {
        sl := slots[k]
        m := c.P.MethodOf(t, sl.Name)
        impl := types.UnknownT
        if m >= 0 {
            impl = c.P.MethodSig(m, t)
            if c.P.VarCount(generic.FnOwner(m)) > 0 { impl = c.implSig(m, t) }
        } else if sl.Default >= 0 {
            impl = c.P.DefaultAt(sl.Default, t)
        }
        if impl != types.UnknownT and not c.anyScopesAgree(impl, sl.Sig) {
            rec := c.err(sp, msgs.AnyMethodScopes(c.ty(t), c.tok(sl.Name), c.ty(r)))
            if m >= 0 { c.noteAt(rec, m, msgs.NoteAnyMethod(c.tok(sl.Name))) }
            c.anyBad.Put(ti, true)
            return -1
        }
    }
    tab := c.P.AnyTables[ti]
    mi := c.fr().Mi
    for k in range slots.Len() {
        sl := slots[k]
        ps := c.P.T.Items(c.P.T.Params(sl.Sig))
        perm := c.P.T.PermOf(ps[0]) & types.Writable
        sig := c.recvReplaced(sl.Sig, c.P.T.Ref(stored, perm))
        tab.Slots.Push(c.newBody(typed.BodyOf.Thunk(ti, k), sig, mi, sp))
    }
    # $ through an "any" renders the instance as its type's own rendering does (T33): a Str it declares made here
    seen := Map<types.TypeId, Bool>()
    c.wantStr(t, seen, 0)
    return ti
}

# a generic method's signature for a receiver of type t: its variables bound by the receiver (G9b) - Unknown where
# that leaves one unbound
fn (c mut Checker&) implSig(m I64, t types.TypeId) types.TypeId {
    sig := c.P.Sig(m)
    owner := generic.FnOwner(m)
    nv := c.P.VarCount(owner)
    ps := c.P.T.Items(c.P.T.Params(sig))
    if ps.Len() == 0 { return types.UnknownT }
    b := generic.Binding(owner, nv)
    c.unify(ps[0], t, b, false, true)
    c.P.InferThroughBounds(b)
    for v in b.Vals {
        if v == types.UnknownT { return types.UnknownT }
    }
    return c.P.Subst(sig, owner, c.P.T.List(b.Vals))
}

# a signature with its receiver's type changed, its scopes kept
fn (c mut Checker&) recvReplaced(sig types.TypeId, recv types.TypeId) types.TypeId {
    ps := c.P.T.Items(c.P.T.Params(sig))
    all := Array<types.TypeId>(ps.Len())
    for i in range ps.Len() { all[i] = ps[i] }
    all[0] = recv
    return c.P.T.Func(c.P.T.List(all), c.P.T.Result(sig), c.P.T.Errors(sig), c.P.T.ScopesOf(sig))
}

# T32a: whether a method's signature says of where its references live what the trait's slot does - each parameter after
# the receiver sharing the same one (none sharing the receiver's), each result built or borrowed from the same one
fn (c mut Checker&) anyScopesAgree(impl types.TypeId, slot types.TypeId) Bool {
    t := c.P.T
    ips := t.Items(t.Params(impl))
    sps := t.Items(t.Params(slot))
    if ips.Len() != sps.Len() { return true }   # what does not meet the trait is said by T31
    for i in range 1, ips.Len() {
        if t.ShareOf(impl, i) != t.ShareOf(slot, i) { return false }
    }
    ir := t.Results(impl)
    for k in range ir.Len() {
        a, b := t.ResultFrom(impl, k), t.ResultFrom(slot, k)
        if a != b and not ((a == types.OwnScope or a == types.FromTypeVar) and (b == types.OwnScope or b == types.FromTypeVar)) {
            return false
        }
    }
    return true
}

# a table's slot (T32b): its parameters the slot's, the instance first as a reference to what it is stored as - a
# call of the method the instance's type meets the slot with, its own or the default it takes, as "x.M(...)" calls it
fn (c mut Checker&) checkThunk(id I64, ti I64, slot I64) {
    tab := c.P.AnyTables[ti]
    n := c.P.AnySlots(tab.Trait).Len()
    k := slot % n
    sl := c.P.AnySlots(tab.Trait)[k]
    sig := c.cur0(id).Ty
    mi := c.thunkModule(id)
    fr := c.push(id, mi, c.P.T.Result(sig), c.P.T.Errors(sig))
    fr.Ctx = generic.Context(mi, -1)
    sp := c.cur().Sp
    c.cur().AddBlock(typed.BlockId(-1), typed.BlockKind.Body, sp)
    ps := c.P.T.Items(c.P.T.Params(sig))
    for i in range ps.Len() { c.param(source.NameId(0), sp, ps[i], i) }
    c.cur().SetVars(c.P.ScopeVarsOf(sig))
    recv := c.readLocal(sp, 0)
    t := tab.Concrete
    place typed.Lvalue&c = typed.Lvalue.Deref(sp, tab.Stored, recv)
    if tab.Stored != t { place = typed.Lvalue.Field(sp, t, place, 0) }
    rx := c.read(sp, place)
    from := c.exprs.Len()
    for i in range 1, ps.Len() { c.exprs.Push(c.readLocal(sp, i)) }
    pre := gather(c.exprs, from)
    fr.Tries++
    x typed.Expr?&c = null
    m := c.P.MethodOf(t, sl.Name)
    name := c.text(sl.Name)
    if m < 0 and sl.Default >= 0 and not c.slotsCalled.Has(c.P.SlotKey(tab.Trait, k)) {
        # a default no call through an "any" of the trait reaches: instantiated for the instance's type only once one
        # does (T32a) - the constraints and body of one never called (Sum's "T Number") stand in no type's way
        fr.Tries--
        c.lazyThunks.Push(id)
        from0 := c.stmts.Len()
        c.stmts.Push(typed.Stmt.Exit(sp, typed.ExitKind.Unreachable, null))
        c.cur().Root = typed.Block(typed.BlockId(0), gather(c.stmts, from0))
        c.pop()
        return
    }
    if m >= 0 {
        x = c.invoke(sp, sp, m, rx, Array<ast.Expr&>(0), pre)
    } else if sl.Default >= 0 {
        # what is wrong with the default for this type said with where a call through an "any" first reached it
        at := try c.slotsCalled.Get(c.P.SlotKey(tab.Trait, k)) catch default diag.Where.Nowhere
        if at != diag.Where.Nowhere { c.P.L.Diags.PushContext(at, "'" $name "' is called through an 'any " $c.ty(tab.Trait) "&' here, so " $c.ty(t) " needs it") }
        x = c.invoke(sp, sp, sl.Default, rx, Array<ast.Expr&>(0), pre)
        if at != diag.Where.Nowhere { c.P.L.Diags.PopContext() }
    } else if name == "Hash" {
        x = c.callOf(sp, c.i64(), typed.Callee.Helper(typed.Helper.Hash, t), c.one(c.value(rx, sp)))
    } else if name == "Len" {
        x = c.prim(sp, c.i64(), typed.PrimOp.Len, rx, null)
    } else if name == "Bits" {
        x = c.prim(sp, c.P.T.Result(sig), typed.PrimOp.Bitcast, c.value(rx, sp), null)
    } else {
        c.gap(sp, "a table slot the instance's type meets no way")
        x = c.unknown(sp)
    }
    fr.Tries--
    v := x!
    if c.P.T.Items(c.P.T.Errors(sig)).Len() > 0 { v = typed.Expr.Try(sp, typeOf(v), typed.Try(v, Array<typed.Clause&>(0))) }
    from2 := c.stmts.Len()
    res := c.P.T.Result(sig)
    if res == types.VoidT {
        c.stmts.Push(typed.Stmt.Eval(sp, v))
    } else if res == types.NoreturnT {
        c.stmts.Push(typed.Stmt.Eval(sp, v))
        c.stmts.Push(typed.Stmt.Exit(sp, typed.ExitKind.Unreachable, null))
    } else {
        c.stmts.Push(typed.Stmt.Return(sp, c.fit(v, res, sp)))
    }
    c.cur().Root = typed.Block(typed.BlockId(0), gather(c.stmts, from2))
    c.pop()
}

fn (c mut Checker&) cur0(id I64) mut typed.Body&c { return c.Bodies[id] }

# the module a table's slot is checked in: the one whose code asked for the table
fn (c mut Checker&) thunkModule(id I64) I64 {
    f := c.Bodies[id].File
    for mi in range c.P.L.Mods.Len() {
        if c.P.L.Mods[mi].File == f { return mi }
    }
    return 0
}

# s.M(args) on an "any" (T32b): through its table, M's slot - or, for a default of the trait introducing type variables
# of its own, the default instantiated for the "any" (T32c)
# D17f: a non-generic trait's methods' contracts checked with the trait, whether a call asks for them or not
fn (c mut Checker&) traitContracts(mi I64, td ast.TypeDecl?&) {
    if td is null or td.Body is null or td.Params.Len() > 0 { return }
    match td.Body {
        case ast.TypeBody.Trait(ms, _, _) {
            has := false
            for m in ms { has = has or m.S.Contract is not null }
            if not has { return }
            ei := c.P.TypeEntry(mi, td.Name)
            if ei < 0 { return }
            self := c.P.SelfType(c.P.DeclFor(mi, ei))
            slots := c.P.AnySlots(self)
            for k in range slots.Len() {
                if slots[k].Method < 0 or c.P.T.DeclOf(slots[k].Trait) != c.P.T.DeclOf(self) { continue }
                b := c.slotContract(typed.Callee.Dispatch(self, k, slots[k].Sig))
                if b >= 0 { c.hasContract(b) }
            }
        }
        nomatch { }
    }
}

# whether a task's call is through an "any"'s table (T32b)
fn dispatched(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Call(_, _, cl) {
            match cl.Target {
                case typed.Callee.Dispatch(_, _, _) { return true }
                nomatch { return false }
            }
        }
        case typed.Expr.Seq(_, _, q) { return q.X is not null and dispatched(q.X!) }
        nomatch { return false }
    }
}

# the method a trait declares for a slot - null for a default (T32b)
fn (c mut Checker&) traitMethod(sl generic.AnySlot) ast.Func?&c {
    if sl.Method < 0 { return null }
    td := c.P.TypeDecl(c.P.T.DeclOf(sl.Trait))
    if td is null or td.Body is null { return null }
    match td.Body {
        case ast.TypeBody.Trait(ms, _, _) { return ms[sl.Method] if sl.Method < ms.Len() else null }
        nomatch { return null }
    }
}

# the owner of the contract a dispatch's trait method has (D17f), -1 for none - made once a trait and slot
fn (c mut Checker&) slotContract(target typed.Callee&) I64 {
    match target {
        case typed.Callee.Dispatch(r, slot, _) {
            k := slot % c.P.AnySlots(r).Len()
            key := c.P.SlotKey(r, k)
            have := try c.P.SlotContracts.Get(key) catch default -2
            if have != -2 { return have }
            id := -1
            m := c.traitMethod(c.P.AnySlots(r)[k])
            if m is not null and m.S.Contract is not null {
                d := c.P.T.DeclOf(c.P.AnySlots(r)[k].Trait)
                id = c.newBody(typed.BodyOf.Slot(r, k), c.P.AnySlots(r)[k].Sig, c.P.T.DeclModule(d), m.Sp)
                c.state[id] = 2
            }
            c.P.SlotContracts.Put(key, id)
            return id
        }
        nomatch { return -1 }
    }
}

fn (c mut Checker&) anyCall(sp source.Span, x ast.Expr&, rx typed.Expr&c, n source.NameId, nsp source.Span, args Array<ast.Expr&>&) typed.Expr&c {
    rt := typeOf(rx)
    if c.P.T.IsNullable(rt) {
        c.err(x.Span(), msgs.ReadMaybeNull(c.src(x.Span()), c.ty(rt), bangOf(c.src(x.Span()))))
        rx = c.convert(sp, rx, c.P.T.NonNull(rt))
        rt = typeOf(rx)
    }
    r := c.P.T.AnyTrait(rt)
    slots := c.P.AnySlots(r)
    for k in range slots.Len() {
        if slots[k].Name != n { continue }
        c.slotCall(r, k, nsp)
        # E14b: a trait method's defaulted parameters by name
        tm := c.traitMethod(slots[k])
        if tm is not null and hasNamed(args) {
            args = c.namedArgs(tm.S.Params, args, c.text(n))
            if c.namedBad {
                c.namedBad = false
                c.dropArgs(args)
                return c.unknown(sp)
            }
        }
        return c.callBody(sp, nsp, slots[k].Sig, typed.Callee.Dispatch(r, k, slots[k].Sig), -1, rx, args, Array<typed.Expr&>(0))
    }
    f := c.P.AnyDefault(r, n)
    if f >= 0 and c.defaultCopiesRecv(f) {
        # T32: a default keeping a copy of its receiver - an adapter (Take, Zip ...) - has none to keep of an any
        c.err(nsp, msgs.AnyNoCopy(c.tok(n), c.ty(rt)))
        c.dropArgs(args)
        return c.unknown(sp)
    }
    if f >= 0 { return c.invoke(sp, nsp, f, rx, args, Array<typed.Expr&>(0)) }
    near mut msgs.Nearest& = msgs.Nearest(c.text(n))
    for sl in slots { near.Offer(c.text(sl.Name)) }
    c.err(nsp, msgs.AnyNoMethod(c.ty(rt), c.tok(n), near.Hint()))
    c.dropArgs(args)
    return c.unknown(sp)
}

# whether a trait's default f's result holds its receiver by value: the variable its receiver "it mut I&" binds
fn (c mut Checker&) defaultCopiesRecv(f I64) Bool {
    sig := c.P.Sig(f)
    ps := c.P.T.Items(c.P.T.Params(sig))
    if ps.Len() == 0 { return false }
    rv := c.deref(ps[0])
    if c.P.T.KindOf(rv) != types.Kind.Var { return false }
    return c.P.HoldsVarByValue(c.P.T.Result(sig), c.P.T.A(rv), c.P.T.B(rv), 0)
}

# ---- tests ----

# a program of one file, main.olang, loaded over the repository's std with the host's build constants
fn testLoad(dir String&, text String&) load.Loader {
    try os.WriteFile($dir "/main.olang", text) catch os.Error { }
    consts := cond.Consts()
    consts.Builtins("linux", "x86_64", "x86-64", 128, 0, false, false, false)
    l := load.Loader("std", consts, fetch.Fetcher($dir "/olang.lock", $dir "/cache", "file:///nowhere/", false, true)
                     source.Names(), diag.Diagnostics(false))
    l.Load($dir "/main.olang")
    return l
}

# the rules of the errors said in the root module, in order
fn rootRules(l mut load.Loader&) String {
    b := StringBuilder()
    f := l.Mods[l.Root].File
    for s in l.Diags.AllSaid() {
        if s.File == f {
            b.Push($s.Rule)
            b.PushChar(' ')
        }
    }
    return b.ToString()
}

fn rootGaps(c Checker&, file I64) String {
    b := StringBuilder()
    for g in c.Gaps {
        if g.File == file {
            b.Push(g.What)
            b.Push("; ")
        }
    }
    return b.ToString()
}

test "a small program checks clean, and its main is checked" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("fn add(a I32, b I32) I32 { return a + b }\n"
                       "fn main() ? {\n    x I32 = 3\n    y := add(x, 4)\n    for i in range 10 { y += I32(i) }\n"
                       "    if y > 3 { y = y - 1 } else { y = 0 }\n    z I64 = y\n    assert z > 0\n}\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := generic.Program(l, r)
    c := Checker(p, false)
    c.RootOnly = true
    c.CheckProgram()
    assert rootRules(l) == "", rootRules(l)
    assert rootGaps(c, l.Mods[l.Root].File) == "", rootGaps(c, l.Mods[l.Root].File)
    assert c.Bodies.Len() == 2, $c.Bodies.Len()
}

test "type errors: E12, T6b, D10a, S3" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("fn f(x Bool) I32 {\n    if x { return 1 }\n}\n"
                       "fn main() ? {\n    a I32 = true\n    b I64 = 3\n    c I32 = b\n    a + c\n}\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := generic.Program(l, r)
    c := Checker(p, false)
    c.RootOnly = true
    c.CheckProgram()
    assert rootRules(l) == "D10a E12 T6b S3 ", rootRules(l)
}

test "for-in walks iterators, runs, iterables and indexables; comprehensions (S9a, S9c, S9d, S9f, E27)" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("type Ix struct() { }\nfn (x Ix&) At(i I64) I64 { return i * 2 }\nfn (x Ix&) Len() I64 { return 3 }\n"
                       "fn main() ? {\n    l := Vec<I64>()\n    l.Push(1)\n    t I64 = 0\n    for x in l { t += x }\n"
                       "    for k, x in l.Iter() { t += x + k }\n    for x in Ix() { t += x }\n"
                       "    a := I64[x * 2 for x in range 4 if x > 1]\n    b := I64[x for x in l]\n"
                       "    for x in a { if x > 3 { break }\n        t += x }\n    assert t + b.Len() > 0\n}\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := generic.Program(l, r)
    c := Checker(p, false)
    c.RootOnly = true
    c.CheckProgram()
    assert rootRules(l) == "", rootRules(l)
    assert rootGaps(c, l.Mods[l.Root].File) == "", rootGaps(c, l.Mods[l.Root].File)
}

test "lambdas: expected types, inference, captures, generic calls (D16, D16a-D16c, G9a, G9c)" {
