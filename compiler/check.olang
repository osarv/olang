                       "fn g() I32 ? E.A { error E.B }\nfn h() I32 { return try f() catch E.A default 1 }\n"
                       "fn k() ? E { try f() catch F { } }\nfn m() ? E {\n    try f() catch { } catch E { }\n}\n"
                       "fn n() I32 { return try (1 + 2) catch default 0 }\nfn q() I32 { return 3! }\n"
                       "fn s() noreturn { }\nfn main() { }\n"))
