    l := testLoad(dir, ("type E error {\n    A\n}\nfn f() ? E { error E.A }\nfn g() { }\n"
                       "fn main() ? {\n    spawn g()\n    join { g() }\n    join {\n        spawn f()\n    }\n    join {\n        spawn try f()\n    }\n}\n"))
