    r.Resolve()
    p := generic.Program(l, r)
    c := Checker(p, false)
    c.RootOnly = true
    c.CheckProgram()
    assert rootRules(l) == "", rootRules(l)
    assert rootGaps(c, l.Mods[l.Root].File) == "", rootGaps(c, l.Mods[l.Root].File)
}

test "a literal reaching a constrained variable takes the type the constraint names (G9a, G19, T35c)" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("fn sq<T Float>(x T) T { return x }\nfn half<T Float>(x T, y T) T { return x }\n"
                       "fn main() ? {\n    a F64 = sq(4)\n    b F64 = sq(2 + 2)\n    c F64 = half(1, 3)\n"
                       "    d F32 = sq(F32(1))\n    assert a + b + c + F64(d) > 0.0\n}\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := generic.Program(l, r)
    c := Checker(p, false)
    c.RootOnly = true
    c.CheckProgram()
    assert rootRules(l) == "", rootRules(l)
    assert rootGaps(c, l.Mods[l.Root].File) == "", rootGaps(c, l.Mods[l.Root].File)
    dir2 := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir2) catch os.Error { } }
    l2 := testLoad(dir2, ("fn sq<T Float>(x T) T { return x }\nfn whole<T Integer>(x T) T { return x }\n"
                         "fn main() ? {\n    n I64 = 4\n    a := sq(n)\n    b := whole(2.5)\n}\n"))
    r2 := names.Resolver(l2)
    r2.Resolve()
    p2 := generic.Program(l2, r2)
    c2 := Checker(p2, false)
    c2.RootOnly = true
    c2.CheckProgram()
    assert rootRules(l2) == "G19, T31a G19, T31a ", rootRules(l2)
}

