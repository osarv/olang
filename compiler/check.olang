}

# a top-level condition the build decides (B9c) is checked as a body of its own with no body around it - as the
# pipeline does once a check has left nothing on the frames - so no name in it may be asked of the frames: the empty
# list's index -1 (E16e) read whatever lay in front of its first chunk, a frame by luck in one build of the compiler
# and a null in another, where it crashed
test "a top-level condition is checked with no body around it (B9c)" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("fn f() I64 { return 1 }\nG I64 = 2\nif f() == 1 and G > 1 { fn g() I64 { return 1 } }\n"
                       "fn main() ? { }\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := generic.Program(l, r)
    c := Checker(p, false)
    c.RootOnly = true
    assert c.frames.Len() == 0
    x ast.Expr?& = null
    for d in l.Mods[l.Root].Decls {
        match d {
            case ast.Decl.If(_, ti) { x = ti.Cond }
            case _ { }
        }
    }
    assert x is not null
    assert c.CondBody(l.Root, x) >= 0
    assert rootRules(l) == "", rootRules(l)
}
