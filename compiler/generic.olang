# generic - the program's types (compiler/DESIGN.md section 1.6): every type declaration a DeclId, every written type a
# TypeId, declared types' bodies and layouts made on request, instances made by substitution, type variables bound by
# unification, constraints checked where a variable is bound, and functions' instances named.
#
# Requests are memoized: a body once made is kept on its type, a layout's progress on its type too (types.LayingOut is
# the in-progress mark - asked again, it is a cycle and T16's diagnostic). A generic's own body is made once, over its
# variables, and an instance's is the generic's substituted: an instance is its generic's DeclId with its arguments,
# interned (types.Named), so the TypeId is the instance's identity and its canonical text its name (G16a).

import "std/pair"
import "source"
import "token"
import "ast"
import "diag"
import "msgs"
import "load"
import "names"
import "types"
import "cond"
import "fetch"
import "std/os"

# ---- the program ----

# a variable of a declaration or a function (G1-G3, G19, G29): its owner (types.Var's), its name, the constant's type
# (Unknown for a type variable; I64 for a length an instance binds, G29) and its constraint (a trait type, Unknown for
# none)
type varRow struct(Owner I64, Name source.NameId, Const types.TypeId, Bound types.TypeId) {
    Owner
    Name
    Const
    Bound
}

# a constant still to be computed (T7c): its expression, written in a module, over an owner's variables
type pattern struct(Expr ast.Expr?&, Mi I64, Owner I64, Want types.TypeId) {
    Expr
    Mi
    Owner
    Want
}

# a function or method (D7, M19): where it is declared
type fnRow struct(Mi I64, F ast.Func&, Extern Bool) {
    Mi
    F
    Extern
}

# a function's instance: the function, its arguments, its signature, its name (G16a) and where it was first asked for
type instance struct(Fn I64, Args types.ListId, Sig types.TypeId, Name String&, From Origin) {
    Fn
    Args
    Sig
    Name
    From
}

# where an instance - of a function or of a type - was first asked for (G16b): the span in a file, and the function
# instance whose body was being checked there (-1 for a body no instance's); File -1 for none recorded. A diagnostic
# met in an instance's body follows these back to the program's own use
type Origin struct(File I64, Sp source.Span, Within I64) {
    File
    Sp
    Within
}

NoOrigin Origin = Origin(-1, source.Span(0, 0), -1)

# a type's variables bound so far while inferring (G9): by index, Unknown while unbound; whether only literals bound it
# (G9a), and whether a receiver did (G9b: it does not widen)
type Binding struct(Owner I64, N I64) {
    Owner
    N
    Vals mut Array<types.TypeId>& = Array<types.TypeId>(N)
    LiteralOnly mut Array<Bool>& = Array<Bool>(N)
    Fixed mut Array<Bool>& = Array<Bool>(N)
}

# a program loaded and its names resolved: its types. L and R are the loader and the resolver it was made from
type Program struct(L mut load.Loader&, R mut names.Resolver&) {
    L
    R
    T := types.NewTable(L.Names)
    declAt Map<I64, types.DeclId>      # by module and entry, (module << 32) | entry
    declMi List<I64>                   # by DeclId: its module and its entry in the module's name table
    declEi List<I64>
    varsAt Map<I64, I64>               # by owner: where its variables start in vars, and how many
    varsN Map<I64, I64>
    vars List<varRow>
    errVars Map<pair.Pair<I64, I64>, Bool>  # (owner, index): the error-set parameter of a list (G1a, QAH)
    genFns Map<I64, Bool>              # the generators (D18), by function: their result made a Generator<T ? E>
    typeIndex Map<pair.Pair<I64, I64>, I64> # (module, name): the entry declaring a type
    indexed Map<I64, Bool>             # the modules typeIndex holds
    identity Map<String&, I64>         # a module by its identity
    r1bSaid Map<pair.Pair<I64, I64>, Bool>  # (module, start): a function type said to write its error set (R1b)
    modules I64 = 0                    # how many modules T knows
    patterns Map<I64, pattern>         # by the pattern's index in T
    fns List<fnRow>
    fnsOf Map<I64, Bool>               # the modules fns holds
    fnsAll I64 = -1                    # how many modules there were when allFns last added every one's
    fnSig Map<I64, types.TypeId>       # by function: its signature, receiver first
    fnByName Map<pair.Pair<I64, I64>, I64>  # (module, name): a plain function
    methods Map<pair.Pair<I64, I64>, I64>   # (receiver key, name): the first method declared
    sameKey Map<I64, I64>              # by method: the next declared of its receiver key and name (M21: one per instance)
    defaultFns List<I64>               # the methods declared on a constrained type variable: traits' defaults (M19e)
    defaultTraits List<I64>            # beside each, its trait's DeclId
    instances List<instance>
    instanceOf Map<pair.Pair<I64, types.ListId>, I64>
    argReps Map<types.ListId, types.ListId>  # arguments told apart only by function types' parameter names: the first
    said Map<I64, Bool>                # the declarations whose T16 or G17 error is said
    expanding I64 = 0                  # how many instances' bodies are being made inside one another (G17)
    folding Map<I64, Bool>             # the globals being folded (a cycle folds to nothing)
    chain I64 = 0                      # how many instances' layouts are being made, each asked for by the one before
    Asking Origin = NoOrigin           # where the checker is asking from: recorded by the instances it makes (G16b)
    typeFrom Map<types.TypeId, Origin> # a type instance: where it was first asked for
    walkedBodies Map<types.TypeId, Bool> # the types bodiesOf has walked
    # T7c: a constant argument no fold reaches, evaluated while compiling - by its module's file and offset and the
    # variables bound where it is read (LengthKey), what an evaluation found (set before checking; interp's Analyze),
    # and the ones a check met undecided (ConstAsks)
    Lengths Map<String&, I64>
    ConstAsks List<ConstAsk>
    # E38: the paths of embeds written as no literal, evaluated while compiling - by file and offset (set before
    # checking; interp's Analyze): the path, or "\0" where its evaluation gave none
    Embeds Map<pair.Pair<I64, I64>, String&>
    # B5a: every module's global initializers' bodies in the order they run - a module's after its imports', each
    # after the globals its initializer reads (check's orderGlobals, once every body is checked)
    InitOrder List<I64>
    # T32: the tables of run-time trait values, one per (instance's type, trait) the checker made a value of - by
    # (Plain type, trait) in anyTableOf - and each trait's slots, once asked
    AnyTables List<AnyTable>
    anyTableOf Map<pair.Pair<I64, I64>, I64>
    anySlotsOf Map<types.TypeId, Array<AnySlot>&>
    # D17f: the body owning the contract a trait writes on a slot's method, by SlotKey - -1 for none
    SlotContracts Map<I64, I64>
}

# a table (T32): the instance's type and the trait, the type the instance is stored as (Stored: the type itself, or for
# an array of a run-time length a one-part tuple holding it, so the instance is one pointer), and by slot the body each
# calls (check's: -1 where none), Render the slot $ calls; where the conversion making it first was
type AnyTable struct(Concrete types.TypeId, Trait types.TypeId, Stored types.TypeId, File I64, Sp source.Span) {
    Concrete
    Trait
    Stored
    File
    Sp
    Slots List<I64>
}

# a trait's slot (T32b): a method of the trait or of one it extends (Trait the instance declaring it, Method its index
# among that body's methods), or a default (Default the function, M19e) - its name, whether it writes through its
# receiver, and its signature with the receiver first, an "any" of the trait's (Sig)
type AnySlot struct(Name source.NameId, Trait types.TypeId, Method I64, Default I64, Mut Bool, Sig types.TypeId) {
    Name
    Trait
    Method
    Default
    Mut
    Sig
}

# a constant argument a fold could not compute: its expression, the module whose context reads it, its type, the
# context's variables as they are bound there (an instance's own length, T7c), and its LengthKey
type ConstAsk struct(Mi I64, Expr ast.Expr&, Want types.TypeId, Owner I64, Names Array<source.NameId>&, Vals Array<types.TypeId>&, Key String&) {
    Mi
    Expr
    Want
    Owner
    Names
    Vals
    Key
}

# what Lengths holds for a length the evaluator could not compute (QP1): one known only at run time, no error
RunTimeLength I64 = -9223372036854775807 - 1

# the owners of variables: a type declaration's, a function's
fn DeclOwner(d types.DeclId) I64 { return I64(d) * 2 }
fn FnOwner(f I64) I64 { return f * 2 + 1 }
# the variables a parameterless struct's constructor introduces (G10d) - its own, apart from the type's
fn CtorOwner(d types.DeclId) I64 { return -(I64(d) * 2 + 2) }

fn (p mut Program&) ensureModules() {
    for mi in range p.modules, p.L.Mods.Len() {
        p.T.AddModule(p.L.Mods[mi].Identity)
        p.identity.Put(p.L.Mods[mi].Identity, mi)
    }
    p.modules = p.L.Mods.Len()
}

fn (p Program&) file(mi I64) I64 { return p.L.Mods[mi].File }

fn (p mut Program&) at(mi I64, sp source.Span) diag.Where { return diag.Where.Span(p.file(mi), I64(sp.Start), I64(sp.End)) }

fn (p mut Program&) text(n source.NameId) String&p { return p.L.Names.Text(n) }

# ---- declarations ----

# the type declared by a module's entry (names.Table's): registered the first time it is asked for
fn (p mut Program&) DeclFor(mi I64, ei I64) types.DeclId {
    key := (mi << 32) | ei
    d := try p.declAt.Get(key) catch default types.DeclId(-1)
    if d >= types.DeclId(0) { return d }
    p.ensureModules()
    e := p.R.Tables[mi].Entries[ei]
    kind := types.DeclKind.Error
    n I32 = 0
    td := e.Decl
    if td is not null {
        kind = types.DeclKind.Struct
        if td.Body is not null {
            match td.Body {
                case ast.TypeBody.Struct(_) { kind = types.DeclKind.Struct }
                case ast.TypeBody.Enum(_, _) { kind = types.DeclKind.Enum }
                case ast.TypeBody.Trait(_, _, _) { kind = types.DeclKind.Trait }
                case ast.TypeBody.Over(_, _) { kind = types.DeclKind.Over }
                case ast.TypeBody.Foreign { kind = types.DeclKind.Foreign }
            }
        }
        if td.Params.Len() > 0 { n = I32(td.Params.Len()) }
    }
    d = p.T.AddDecl(mi, e.Name, kind, n)
    p.declAt.Put(key, d)
    p.declMi.Push(mi)
    p.declEi.Push(ei)
    return d
}

fn (p Program&) typeDecl(d types.DeclId) ast.TypeDecl?&p { return p.R.Tables[p.declMi[I64(d)]].Entries[p.declEi[I64(d)]].Decl }

fn (p Program&) DeclModule(d types.DeclId) I64 { return p.declMi[I64(d)] }

# a type a module declares, by its name; -1 for none
fn (p mut Program&) TypeEntry(mi I64, name source.NameId) I64 {
    if not (try p.indexed.Get(mi) catch default false) {
        tab := p.R.Tables[mi]
        for ei in range tab.Entries.Len() {
            if tab.Entries[ei].Kind == names.What.Type { p.typeIndex.Put(pair.Pair(mi, I64(tab.Entries[ei].Name)), ei) }
        }
        p.indexed.Put(mi, true)
    }
    return try p.typeIndex.Get(pair.Pair(mi, I64(name))) catch default -1
}

# FindDecl's miss: no module of that identity, or no type of that name in it
type Undeclared error {
    TYPE
}

# a declared type by its canonical name, "IDENTITY:Name"
fn (p mut Program&) FindDecl(identity String&, name String&) types.DeclId ? {
    p.ensureModules()
    mi := try p.identity.Get(identity) catch { error Undeclared.TYPE }
    ei := p.TypeEntry(mi, p.L.Names.Intern(name))
    if ei < 0 { error Undeclared.TYPE }
    return p.DeclFor(mi, ei)
}

# ---- variables ----

fn (p mut Program&) addVars(owner I64, ns Array<source.NameId>&) {
    if (try p.varsAt.Get(owner) catch default -1) >= 0 { return }
    p.varsAt.Put(owner, p.vars.Len())
    p.varsN.Put(owner, ns.Len())
    for n in ns { p.vars.Push(varRow(owner, n, types.UnknownT, types.UnknownT)) }
}

# an owner's variables: how many, and the i-th's row
fn (p mut Program&) VarCount(owner I64) I64 {
    if owner >= 0 and owner % 2 == 0 { p.declVars(types.DeclId(I32(owner / 2))) }
    return try p.varsN.Get(owner) catch default 0
}

fn (p mut Program&) VarAt(owner I64, i I64) varRow { return p.vars[(try p.varsAt.Get(owner) catch default 0) + i] }

# a type declaration's variables (G6, G19): registered with their constraints, read in the declaration's own context,
# where every one of them is written bare (G8b)
fn (p mut Program&) declVars(d types.DeclId) {
    owner := DeclOwner(d)
    if (try p.varsAt.Get(owner) catch default -1) >= 0 { return }
    td := p.typeDecl(d)
    ns List<source.NameId>
    if td is not null and td.Params.Len() > 0 {
        for tp in td.Params { ns.Push(tp.Name) }
    }
    p.addVars(owner, ns.ToArray())
    if td is null or td.Params.Len() == 0 { return }
    for i in range td.Params.Len() {
        if td.Params[i].ErrSet { p.errVars.Put(pair.Pair(owner, i), true) }
    }
    c := p.declContext(d)
    base := try p.varsAt.Get(owner) catch default 0
    for i in range td.Params.Len() {
        tp := td.Params[i]
        if tp.Ty is null { continue }
        t := p.BoundOf(c, tp)
        row := p.vars[base + i]
        p.vars[base + i] = varRow(owner, row.Name, types.UnknownT, t)
    }
}

# where a declaration's text is read: its module, its variables by name
type Context struct(Mi I64, Owner I64) {
    Mi
    Owner
    Vars Map<source.NameId, types.TypeId>
}

fn (p mut Program&) declContext(d types.DeclId) Context {
    mi := p.declMi[I64(d)]
    owner := DeclOwner(d)
    c := Context(mi, owner)
    td := p.typeDecl(d)
    if td is not null and td.Params.Len() > 0 {
        for i in range td.Params.Len() { c.Vars.Put(td.Params[i].Name, p.T.Var(owner, i, types.ReadOnly)) }
    }
    return c
}

# a declared type over its own variables: Named(d, [its variables]) - a non-generic declaration's one type
fn (p mut Program&) SelfType(d types.DeclId) types.TypeId {
    p.declVars(d)
    owner := DeclOwner(d)
    n := p.T.DeclParams(d)
    vs := Array<types.TypeId>(n)
    for i in range n { vs[i] = p.VarArg(owner, i) }
    return p.T.Named(d, p.T.List(vs))
}

# ---- error-set parameters (G1a, QAH) ----

# whether a type is an error-set variable: a variable its list writes after "?"
fn (p mut Program&) IsErrVar(t types.TypeId) Bool {
    return p.T.KindOf(t) == types.Kind.Var and (try p.errVars.Get(pair.Pair(p.T.A(t), p.T.B(t))) catch default false)
}

# whether function f is a generator (D18): its result written Iterator<T ? E>, its body yielding - known once its
# signature is
fn (p mut Program&) IsGenerator(f I64) Bool {
    p.Sig(f)
    return try p.genFns.Get(f) catch default false
}

# D18: the Generator<T ? E> a generator's result written t, an Iterator<T ? E>, stands for; Unknown where t is no
# Iterator
fn (p mut Program&) generatorOf(t types.TypeId) types.TypeId {
    if p.T.KindOf(t) != types.Kind.Named { return types.UnknownT }
    it := try p.FindDecl("std/prelude/iterator", "Iterator") catch { return types.UnknownT }
    if p.T.DeclOf(t) != it { return types.UnknownT }
    g := try p.FindDecl("std/prelude/iterator", "Generator") catch { return types.UnknownT }
    return p.Instance(g, p.T.Args(t))
}

fn (p mut Program&) ErrVarAt(owner I64, i I64) Bool { return try p.errVars.Get(pair.Pair(owner, i)) catch default false }

# owner's i-th variable as an argument: itself, or for the error-set parameter the set holding it
fn (p mut Program&) VarArg(owner I64, i I64) types.TypeId {
    v := p.T.Var(owner, i, types.ReadOnly)
    return p.ErrSetOf(p.T.List1(v)) if p.ErrVarAt(owner, i) else v
}

# whether a declared type's list ends in an error-set parameter
fn (p mut Program&) HasErrParam(d types.DeclId) Bool {
    p.declVars(d)
    n := p.T.DeclParams(d)
    return n > 0 and p.ErrVarAt(DeclOwner(d), n - 1)
}

# an error set as an argument: its entries merged (R1c) and in the canonical order - error types by the module
# declaring them, then by name (R1a), variables after them - so one set is one type
fn (p mut Program&) ErrSetOf(entries types.ListId) types.TypeId {
    flat List<types.TypeId>
    for e in p.T.Items(entries) {
        if e != types.UnknownT and e != types.DefaultErrT { flat.Push(e) }
    }
    es List<types.TypeId>
    p.mergeEntries(flat, es)
    xs := es.ToArray()
    xs.Sort(fn(a types.TypeId, b types.TypeId) Bool { return p.errBefore(a, b) })
    return p.T.ErrSet(p.T.List(xs))
}

fn (p mut Program&) errBefore(a types.TypeId, b types.TypeId) Bool {
    av := p.T.KindOf(a) == types.Kind.Var
    bv := p.T.KindOf(b) == types.Kind.Var
    if av or bv {
        if av != bv { return bv }
        return p.T.A(a) < p.T.A(b) or (p.T.A(a) == p.T.A(b) and p.T.B(a) < p.T.B(b))
    }
    da := p.T.DeclOf(p.T.ErrOf(a))
    db := p.T.DeclOf(p.T.ErrOf(b))
    ma := p.L.Mods[p.T.DeclModule(da)].Identity
    mb := p.L.Mods[p.T.DeclModule(db)].Identity
    if ma != mb { return ma < mb }
    return p.text(p.T.DeclName(da)) < p.text(p.T.DeclName(db))
}

# the union of two error-set arguments (G9: what binds an error-set variable)
fn (p mut Program&) ErrSetUnion(a types.TypeId, b types.TypeId) types.TypeId {
    xs := List<types.TypeId>()
    for e in p.T.Items(p.T.ErrSetItems(a)) { xs.Push(e) }
    for e in p.T.Items(p.T.ErrSetItems(b)) { xs.Push(e) }
    return p.ErrSetOf(p.T.List(xs.ToArray()))
}

# an error list with an owner's error-set variables replaced by the sets args binds them to, spliced in where the
# variable stands and merged (R1c): "? E, Exhausted" with E bound to {io.Error} is "? io.Error, Exhausted"
fn (p mut Program&) substErrs(l types.ListId, owner I64, args types.ListId) types.ListId {
    if l == types.ListId(0) { return l }
    xs := p.T.Items(args)
    flat List<types.TypeId>
    changed := false
    for e in p.T.Items(l) {
        if p.T.KindOf(e) == types.Kind.Var and p.T.A(e) == owner and p.T.B(e) < xs.Len() {
            v := xs[p.T.B(e)]
            changed = true
            if p.T.KindOf(v) == types.Kind.ErrSet {
                for x in p.T.Items(p.T.ErrSetItems(v)) { flat.Push(x) }
            } else if p.T.KindOf(v) == types.Kind.Var {
                flat.Push(v)
            }
        } else {
            flat.Push(e)
        }
    }
    if not changed { return l }
    es List<types.TypeId>
    p.mergeEntries(flat, es)
    return p.T.List(es.ToArray())
}

# whether an error list names one of the binding's error-set variables
fn (p mut Program&) errsHaveVar(l types.ListId, b Binding&) Bool {
    for e in p.T.Items(l) {
        if p.isVar(e, b) { return true }
    }
    return false
}

# an error list matched against one a value has (G9, QAH): the pattern's error-set variable takes what the value can
# fail with beyond the pattern's other entries - unioned with what it holds, since every function value and iterator
# passed adds to it. A pattern with no variable of the binding's matches as before, entry by entry
fn (p mut Program&) unifyErrs(pat types.ListId, actual types.ListId, b mut Binding&) Bool {
    if not p.errsHaveVar(pat, b) { return p.unifyLists(pat, actual, b) }
    fixed List<types.TypeId>
    vi I64 = -1
    for e in p.T.Items(pat) {
        if p.isVar(e, b) { vi = p.T.B(e) } else { fixed.Push(e) }
    }
    rest List<types.TypeId>
    for e in p.T.Items(actual) {
        if e == types.DefaultErrT or e == types.UnknownT { continue }
        if not p.entryHeld(e, fixed) { rest.Push(e) }
    }
    return p.bind(b, vi, p.ErrSetOf(p.T.List(rest.ToArray())), false, false)
}

# the index of a function's error-set variable among its signature's (G1a), -1 for none
fn (p mut Program&) ErrVarIndex(f I64) I64 {
    owner := FnOwner(f)
    p.Sig(f)
    for i in range p.VarCount(owner) {
        if p.ErrVarAt(owner, i) { return i }
    }
    return -1
}

fn (p mut Program&) ErrsArgOf(c Context&, t ast.TypeRef&) types.TypeId { return p.errsArg(c, t) }

fn (p mut Program&) UnifyErrors(pat types.ListId, actual types.ListId, b mut Binding&) Bool { return p.unifyErrs(pat, actual, b) }

# whether an error set's entry is held by one of a list's (R1c: the same error type, its words among theirs)
fn (p mut Program&) entryHeld(e types.TypeId, l List<types.TypeId>&) Bool {
    for x in l {
        if p.T.ErrOf(x) == p.T.ErrOf(e) and (p.T.ErrMask(e) & ~p.T.ErrMask(x)) == U64(0) { return true }
    }
    return false
}

# whether every error of one set is held by another (T31: a method's set held by its trait's signature's)
fn (p mut Program&) ErrsHeld(have types.ListId, want types.ListId) Bool {
    if have == want { return true }
    ws List<types.TypeId>
    for x in p.T.Items(want) { ws.Push(x) }
    for e in p.T.Items(have) {
        if e == types.DefaultErrT or not p.entryHeld(e, ws) { return false }
    }
    return true
}

# ---- written types ----

# the TypeId a written type stands for, read in a context: a name through names' resolution, a variable by the
# context's, permissions and reference markers (T25b - a scope tag is section 8's, not the type's); Unknown where it
# names nothing
fn (p mut Program&) Resolve(c Context&, t ast.TypeRef?&) types.TypeId {
    if t is null { return types.UnknownT }
    return match t {
        case ast.TypeRef.Named(sp, path, args) => p.named(c, sp, path, args)
        case ast.TypeRef.Func(sp, s) => p.funcType(c, sp, s)
        case ast.TypeRef.Shape(_, body) => p.shape(c, body)
        case ast.TypeRef.Ref(sp, of, _, nullable) => p.refType(c, sp, p.Resolve(c, of), nullable)
        case ast.TypeRef.Perm(_, of, writable, owned) => p.perm(p.Resolve(c, of), writable, owned)
        # T32: what "any R&" refers to - the trait R names, the checker saying where it names none (writtenMet)
        case ast.TypeRef.Any(_, of) => p.T.Any(p.Resolve(c, of))
        case ast.TypeRef.Errs(_, _) => types.UnknownT     # only where Apply reads it, a list's last argument (G1a)
    }
}

# a reference to r, "?&" where it may be null (T2c) - but an array, which is never null: its zero value is the empty
# array, so "?&" on one is said once and read as "&"
fn (p mut Program&) refType(c Context&, sp source.Span, r types.TypeId, nullable Bool) types.TypeId {
    if nullable and p.T.KindOf(p.T.Repr(r)) == types.Kind.Array {
        key := pair.Pair(c.Mi, I64(sp.Start))
        if not (try p.r1bSaid.Get(key) catch default false) {
            p.r1bSaid.Put(key, true)
            text := p.L.Mods[c.Mi].Src!.Text
            q := I64(sp.End) - 1
            for q > I64(sp.Start) and not (text[q] == '?' and text[q + 1] == '&') { q-- }
            p.L.Diags.Error(p.at(c.Mi, source.Span(I32(q), I32(q + 1))), msgs.ArrayNullable())
        }
        return p.T.Ref(r, types.ReadOnly)
    }
    return p.T.Ref(r, types.Nullable if nullable else types.ReadOnly)
}

# "mut"/"own" before a type: a reference's permission (T25b, T25e), a variable's where it is bound to a reference (T2);
# before a value type it says nothing the type holds (the checker's D9/D11a)
fn (p mut Program&) perm(t types.TypeId, writable Bool, owned Bool) types.TypeId {
    bits := (types.Writable if writable else types.ReadOnly) | (types.Owning if owned else types.ReadOnly)
    return match p.T.KindOf(t) {
        case types.Kind.Ref => p.T.Ref(p.T.Referent(t), p.T.PermOf(t) | bits)
        case types.Kind.Var => p.T.Var(p.T.A(t), p.T.B(t), p.T.C(t) | bits)
        case _ => t
    }
}

fn (p mut Program&) named(c Context&, sp source.Span, path Array<source.NameId>&, args Array<ast.TypeRef&>&) types.TypeId {
    if path.Len() == 1 {
        v := try c.Vars.Get(path[0]) catch default types.TypeId(-1)
        # G1a: an error-set parameter stands only where an error set is written - said by the checker (writtenMet)
        if v >= types.TypeId(0) and (p.IsErrVar(v) or p.T.KindOf(v) == types.Kind.ErrSet) { return types.UnknownT }
        if v >= types.TypeId(0) { return v }
    }
    ref := p.R.Use(p.file(c.Mi), sp.Start)
    match ref.Kind {
        case names.What.Builtin {
            name := p.text(path[path.Len() - 1])
            if name == "Array" {
                # G8: one type argument - a length is never written (T7); another count is the checker's error
                if args.Len() != 1 { return types.UnknownT }
                return p.T.Array(p.Resolve(c, args[0]), types.TypeId(0))
            }
            if name == "Bool" { return types.BoolT }
            return p.T.Prim(name)
        }
        case names.What.Type {
            if ref.Index < 0 { return types.UnknownT }
            return p.Apply(c, p.DeclFor(ref.Module, ref.Index), args)
        }
        nomatch { return types.UnknownT }
    }
}

# a declared type with its written arguments read in a context: its instance (G7: Unknown for the wrong count, which
# the checker says)
fn (p mut Program&) Apply(c Context&, d types.DeclId, args Array<ast.TypeRef&>&) types.TypeId {
    p.declVars(d)
    n := p.T.DeclParams(d)
    # G1a: a list ending in an error-set parameter takes its set after "?", the empty set where none is written
    written := args.Len()
    given := written > 0 and isErrsArg(args[written - 1])
    if p.HasErrParam(d) {
        if (written if given else written + 1) != n { return types.UnknownT }
    } else if given or n != written {
        return types.UnknownT
    }
    vs := Array<types.TypeId>(n)
    for i in range n {
        if i == n - 1 and p.HasErrParam(d) {
            vs[i] = p.errsArg(c, args[i]) if given else p.ErrSetOf(types.ListId(0))
        } else {
            vs[i] = p.Resolve(c, args[i])
        }
    }
    return p.Instance(d, p.T.List(vs))
}

# how many types a declared type's argument list writes (G7): its parameters, less an error-set one (G1a)
fn (p mut Program&) WrittenArity(d types.DeclId) I64 { return p.T.DeclParams(d) - (1 if p.HasErrParam(d) else 0) }

# how many types a written argument list holds, its error-set argument left out
fn WrittenTypes(args Array<ast.TypeRef&>&) I64 {
    n := args.Len()
    return n - 1 if n > 0 and isErrsArg(args[n - 1]) else n
}

# whether a written argument list fits a declared type's parameters (G7, G1a): as many types, and an error-set
# argument only where the type has an error-set parameter
fn (p mut Program&) ArgsFit(d types.DeclId, args Array<ast.TypeRef&>&) Bool {
    n := args.Len()
    if n > 0 and isErrsArg(args[n - 1]) and not p.HasErrParam(d) { return false }
    return WrittenTypes(args) == p.WrittenArity(d)
}

# whether a written type argument is an error set's, "? A, B" (G1a)
fn IsErrsArgOf(t ast.TypeRef&) Bool { return isErrsArg(t) }

fn isErrsArg(t ast.TypeRef&) Bool {
    return match t {
        case ast.TypeRef.Errs(_, _) => true
        case _ => false
    }
}

# an error-set argument as written (G1a): its items' entries, merged, the set they make
fn (p mut Program&) errsArg(c Context&, t ast.TypeRef&) types.TypeId {
    match t {
        case ast.TypeRef.Errs(_, items) {
            flat List<types.TypeId>
            for e in items {
                p.ErrorItemKnown(c, e)
                p.errorSetEntries(c, e, flat)
            }
            return p.ErrSetOf(p.T.List(flat.ToArray()))
        }
        nomatch { return p.ErrSetOf(types.ListId(0)) }
    }
}

# a type's instance with these arguments (or the type itself, a non-generic one with none): G17 bounds how deep the
# arguments of an instance may nest
fn (p mut Program&) Instance(d types.DeclId, args types.ListId) types.TypeId {
    t := p.T.Named(d, args)
    if p.T.Depth(t) > MaxDepth + 1 {
        p.unbounded(d)
        return types.UnknownT
    }
    if args != types.ListId(0) and p.Asking.File >= 0 and not p.typeFrom.Has(t) { p.typeFrom.Put(t, p.Asking) }
    return t
}

# where a type instance was first asked for (G16b), NoOrigin for one the checker never asked for
fn (p Program&) TypeOrigin(t types.TypeId) Origin { return try p.typeFrom.Get(t) catch default NoOrigin }

# the instances a type names, through references, arrays, functions and other instances' arguments, given their
# bodies (G17); one nesting deeper than any program writes is a chain that never ends
fn (p mut Program&) expand(t types.TypeId, depth I64) {
    if depth > 4 * MaxDepth or t == types.UnknownT { return }
    match p.T.KindOf(t) {
        case types.Kind.Named {
            args := p.T.Args(t)
            if args == types.ListId(0) or p.T.HasBody(t) { return }
            if p.T.Depth(t) > MaxDepth + 1 or p.expanding > 200 {
                p.unbounded(p.T.DeclOf(t))
                return
            }
            p.expandList(args, depth + 1)
            p.expanding++
            if p.T.Closed(t) { p.Body(t) }
            p.expanding--
        }
        case types.Kind.Ref { p.expand(p.T.Referent(t), depth + 1) }
        case types.Kind.Array { p.expand(p.T.Elem(t), depth + 1) }
        case types.Kind.Tuple, types.Kind.Record { p.expandList(p.T.Parts(t), depth + 1) }
        nomatch { }
    }
}

fn (p mut Program&) expandList(l types.ListId, depth I64) {
    if l == types.ListId(0) { return }
    for x in p.T.Items(l) { p.expand(x, depth) }
}

# G17 for a function: an instance whose arguments nest deeper than any program writes, said once at the function's
# declaration - whether its arguments do
fn (p mut Program&) FnTooDeep(f I64, args types.ListId, at diag.Where) Bool {
    for x in p.T.Items(args) {
        if p.T.Depth(x) > MaxDepth {
            if not (try p.said.Get(-1 - f) catch default false) {
                p.said.Put(-1 - f, true)
                p.L.Diags.Error(at, msgs.UnboundedInstantiation())
            }
            return true
        }
    }
    return false
}

# G17, said once for a declaration
fn (p mut Program&) unbounded(d types.DeclId) {
    if try p.said.Get(I64(d)) catch default false { return }
    p.said.Put(I64(d), true)
    mi := p.declMi[I64(d)]
    e := p.R.Tables[mi].Entries[p.declEi[I64(d)]]
    p.L.Diags.Error(p.at(mi, e.Sp), msgs.UnboundedInstantiation())
}

# G17: how deep an instance's arguments may nest, and how long a chain of instances, each asked for by the one before,
# may be (a constant argument that keeps changing)
MaxDepth I64 = 48
MaxChain I64 = 1000

# a function type written: its parameters, its result (a tuple for several, D8c), its errors (R15: "?" alone is the
# default error) and its scopes - what its markers say (O4a): a parameter "&x" shares the scope variable of the earlier
# parameter x (the receiver included), a result "&x" is borrowed from parameter x, a result written as a bare type
# variable may hand back an argument where it becomes a reference (O14b); a marker naming nothing it may is the
# checker's to report, and says nothing here. recv, where it is no stand-in, is the parameter before the others (a
# method's receiver, M19), named recvName
# a function type written (T21): its set written out - "?" alone says nothing, since no body says what it is (R1b);
# said once, read as no errors
fn (p mut Program&) funcType(c Context&, sp source.Span, s ast.Sig&) types.TypeId {
    f := p.sigType(c, s, types.UnknownT, source.NameId(0))
    es := p.T.Items(p.T.Errors(f))
    if es.Len() == 1 and es[0] == types.DefaultErrT {
        key := pair.Pair(c.Mi, I64(sp.Start))
        if not (try p.r1bSaid.Get(key) catch default false) {
            p.r1bSaid.Put(key, true)
            p.L.Diags.Error(p.at(c.Mi, source.Span(sp.Start, sp.Start + 2)), msgs.FuncTypeErrsUnwritten())
        }
        f = p.T.Func(p.T.Params(f), p.T.Result(f), types.ListId(0), p.T.ScopesOf(f))
    }
    return p.T.WithNames(f, p.SigNames(s))
}

# a signature's parameters' names, interned for a function type to render with (E11a)
fn (p mut Program&) SigNames(s ast.Sig&) I64 {
    ns := Array<I64>(s.Params.Len())
    for i in range s.Params.Len() { ns[i] = I64(s.Params[i].Name) }
    return p.T.ParamNames(ns)
}

fn (p mut Program&) sigType(c Context&, s ast.Sig&, recv types.TypeId, recvName source.NameId) types.TypeId {
    ps List<types.TypeId>
    named List<source.NameId>
    shares List<I64>
    if recv != types.UnknownT {
        ps.Push(recv)
        named.Push(recvName)
        shares.Push(types.OwnScope)
    }
    for prm in s.Params {
        ps.Push(p.Resolve(c, prm.Ty))
        shares.Push(p.markedParam(c, prm.Ty!, named, shares))
        named.Push(prm.Name)
    }
    result := types.VoidT
    from := Array<I64>(s.Results.Len())
    rs := Array<types.TypeId>(s.Results.Len())
    for i in range s.Results.Len() {
        rs[i] = p.Resolve(c, s.Results[i])
        from[i] = p.markedParam(c, s.Results[i], named, shares)
        if from[i] == types.OwnScope and p.T.KindOf(rs[i]) == types.Kind.Var { from[i] = types.FromTypeVar }
    }
    if s.Results.Len() == 1 {
        result = rs[0]
    } else if s.Results.Len() > 1 {
        result = p.T.Tuple(p.T.List(rs))
    }
    if s.NoReturn { result = types.NoreturnT }
    scopes := p.T.Scopes(types.RoleFn, shares.ToArray(), from)
    return p.T.Func(p.T.List(ps.ToArray()), result, p.contractErrors(s, p.errorList(c, s.HasErrors, s.Errors)), scopes)
}

# D17: a declaration with value conditions and no "?" fails with ArgumentError - its set where it writes none; a
# written or inferred set is its own, which the checker holds to name it
fn (p mut Program&) contractErrors(s ast.Sig&, el types.ListId) types.ListId {
    if s.Contract is null or s.Contract!.Items.Len() == 0 or s.HasErrors { return el }
    t := p.preludeType("std/prelude/argument", "ArgumentError")
    if t == types.UnknownT { return el }
    return p.T.List1(t)
}

# the earlier parameter a written type's marker names (O4a), as the parameter whose own scope variable that one is:
# OwnScope for a bare marker, "&return", none, or a name that is no earlier parameter
fn (p mut Program&) markedParam(c Context&, t ast.TypeRef&, named List<source.NameId>&, shares List<I64>&) I64 {
    scope := p.markOf(t)
    if scope == source.NameId(0) { return types.OwnScope }
    for j in range named.Len() {
        if named[j] == scope { return shares[j] if shares[j] >= 0 else j }
    }
    # a name no earlier parameter has (O4a)
    text := p.L.Names.Text(scope)
    if text != "return" {
        sp := p.markSpan(t)
        nsp := source.Span(sp.End - I32(text.Len()), sp.End)
        p.L.Diags.ErrorOncePerLine(p.at(c.Mi, nsp), msgs.UnknownScopeName(msgs.Tok(text)))
    }
    return types.OwnScope
}

# the span of a written type's outermost reference marker, whose scope name ends it
fn (p mut Program&) markSpan(t ast.TypeRef&) source.Span {
    return match t {
        case ast.TypeRef.Ref(sp, _, _, _) => sp
        case ast.TypeRef.Perm(_, of, _, _) => p.markSpan(of) if of is not null else source.Span(0, 0)
        case _ => source.Span(0, 0)
    }
}

# the name a written type's outermost marker names, 0 for none ("mut", "own" stand before it)
fn (p mut Program&) markOf(t ast.TypeRef?&) source.NameId {
    if t is null { return source.NameId(0) }
    return match t {
        case ast.TypeRef.Ref(_, _, sc, _) => sc
        case ast.TypeRef.Perm(_, of, _, _) => p.markOf(of)
        case _ => source.NameId(0)
    }
}

# an error set's item: an error type, its own module's or one an alias chain reaches (names records the head); Unknown
# for a type of another kind
fn (p mut Program&) errorType(c Context&, e ast.Path&) types.TypeId {
    t := p.namedType(c, e)
    if t == types.UnknownT or p.T.DeclKindOf(p.T.DeclOf(t)) != types.DeclKind.Error { return types.UnknownT }
    return t
}

# a declared type a dotted path names, of any kind
fn (p mut Program&) namedType(c Context&, e ast.Path&) types.TypeId {
    ref := p.R.Use(p.file(c.Mi), e.Sp.Start)
    n := e.Parts.Len()
    if n == 1 {
        if ref.Kind != names.What.Type or ref.Index < 0 { return types.UnknownT }
        return p.T.Named(p.DeclFor(ref.Module, ref.Index), types.ListId(0))
    }
    if ref.Kind != names.What.Import { return types.UnknownT }
    mi := ref.Module
    for k in range 1, n - 1 {
        mi = p.aliasStep(mi, e.Parts[k])
        if mi < 0 { return types.UnknownT }
    }
    ei := p.TypeEntry(mi, e.Parts[n - 1])
    if ei < 0 { return types.UnknownT }
    return p.T.Named(p.DeclFor(mi, ei), types.ListId(0))
}

# an error set's item (R1, R1c): an error type, or one of its words - an entry holding that word alone, past the 64th
# none; Unknown for neither
fn (p mut Program&) errorSetItem(c Context&, e ast.Path&) types.TypeId {
    # G1a: an error-set parameter - its variable, or the set an instance binds it to
    if e.Parts.Len() == 1 {
        v := try c.Vars.Get(e.Parts[0]) catch default types.TypeId(-1)
        if v >= types.TypeId(0) and (p.IsErrVar(v) or p.T.KindOf(v) == types.Kind.ErrSet) { return v }
        if v >= types.TypeId(0) { return types.UnknownT }
    }
    t := p.errorType(c, e)
    n := e.Parts.Len()
    if t != types.UnknownT or n < 2 { return t }
    et := p.errorType(c, ast.Path(e.Sp, e.Parts[:n - 1]))
    if et == types.UnknownT { return et }
    ws := p.ErrorWords(p.T.DeclOf(et))
    for i in range ws.Len() {
        if ws[i] == e.Parts[n - 1] { return p.T.ErrWords(et, U64(1) << i) if i < 64 else types.UnknownT }
    }
    return types.UnknownT
}

# an error set as written (R1, R1c): its items in order, the words of one type one entry, a type named whole holding
# every word of it, a named set its members (T19a); "?" alone the inferred set's mark (R1a)
fn (p mut Program&) errorList(c Context&, has Bool, items Array<ast.Path&>&) types.ListId {
    es List<types.TypeId>
    if has and items.Len() == 0 { es.Push(types.DefaultErrT) }
    if has {
        flat List<types.TypeId>
        for e in items {
            p.ErrorItemKnown(c, e)
            p.errorSetEntries(c, e, flat)
        }
        p.mergeEntries(flat, es)
    }
    return p.T.List(es.ToArray())
}

fn (p mut Program&) ErrorList(c Context&, has Bool, items Array<ast.Path&>&) types.ListId { return p.errorList(c, has, items) }

# entries merged as one set holds them (R1c): the words of one type one entry, a type named whole holding every word
fn (p mut Program&) mergeEntries(flat List<types.TypeId>&, es mut List<types.TypeId>&) {
    for t in flat {
        k I64 = -1
        for j in range es.Len() {
            if t != types.UnknownT and p.T.ErrOf(es[j]) == p.T.ErrOf(t) { k = j }
        }
        if k < 0 {
            es.Push(t)
        } else if p.T.KindOf(es[k]) != types.Kind.ErrWords or p.T.KindOf(t) != types.Kind.ErrWords {
            es[k] = p.T.ErrOf(t)
        } else {
            es[k] = p.T.ErrWords(p.T.ErrOf(t), p.T.ErrMask(es[k]) | p.T.ErrMask(t))
        }
    }
}

# an error set's item as the entries it stands for (T19a): an error type, or one of its words, itself; a named set its
# members in order, each flattened, then its own words where it declares any - a set reached again on its way (a cycle,
# said at its declaration) and an unknown item stand for nothing (Unknown, an unknown one)
fn (p mut Program&) errorSetEntries(c Context&, e ast.Path&, out mut List<types.TypeId>&) {
    seen List<types.DeclId>
    p.entriesOf(p.errorSetItem(c, e), out, seen)
}

fn (p mut Program&) ErrorSetEntries(c Context&, e ast.Path&, out mut List<types.TypeId>&) { p.errorSetEntries(c, e, out) }

fn (p mut Program&) ErrorSetItem(c Context&, e ast.Path&) types.TypeId { return p.errorSetItem(c, e) }

# the entries an error type or a set stands for (T19a)
fn (p mut Program&) EntriesOf(t types.TypeId, out mut List<types.TypeId>&) {
    seen List<types.DeclId>
    p.entriesOf(t, out, seen)
}

fn (p mut Program&) entriesOf(t types.TypeId, out mut List<types.TypeId>&, seen mut List<types.DeclId>&) {
    if p.T.KindOf(t) == types.Kind.ErrSet {
        for x in p.T.Items(p.T.ErrSetItems(t)) { out.Push(x) }
        return
    }
    if t == types.UnknownT or p.T.KindOf(t) != types.Kind.Named {
        out.Push(t)
        return
    }
    d := p.T.DeclOf(t)
    ms := p.ErrorMembers(d)
    if ms.Len() == 0 {
        out.Push(t)
        return
    }
    for s in seen {
        if s == d { return }
    }
    seen.Push(d)
    mc := Context(p.T.DeclModule(d), -1)
    for m in ms { p.entriesOf(p.errorSetItem(mc, m), out, seen) }
    seen.Pop()!
    if p.ErrorWords(d).Len() > 0 { out.Push(t) }
}

# R1, T19a: an error set's item names an error type, one of its words or a named set - said once where it does not,
# false then
fn (p mut Program&) ErrorItemKnown(c Context&, e ast.Path&) Bool {
    if e.Parts.Len() == 0 or p.errorSetItem(c, e) != types.UnknownT { return true }
    at := p.at(c.Mi, e.Sp)
    if e.Parts.Len() == 1 and c.Vars.Has(e.Parts[0]) {
        p.L.Diags.ErrorOncePerLine(at, msgs.TypeVarNotErrorSet(msgs.Tok(p.text(e.Parts[0]))))
        return false
    }
    t := p.namedType(c, e)
    if t != types.UnknownT {
        p.L.Diags.ErrorOncePerLine(at, msgs.NotAnErrorType(msgs.Tok(p.text(p.T.DeclName(p.T.DeclOf(t))))))
        return false
    }
    n := e.Parts.Len()
    if n >= 2 {
        et := p.errorType(c, ast.Path(e.Sp, e.Parts[:n - 1]))
        if et != types.UnknownT {
            w := e.Parts[n - 1]
            ws := p.ErrorWords(p.T.DeclOf(et))
            far := false
            for i in range ws.Len() {
                if ws[i] == w { far = true }
            }
            nm := p.text(p.T.DeclName(p.T.DeclOf(et)))
            if far {
                p.L.Diags.ErrorOncePerLine(at, msgs.ErrorWordTooFar(nm))
            } else {
                p.L.Diags.ErrorOncePerLine(at, msgs.NoSuchErrorWord(nm, msgs.Tok(p.text(w))))
            }
            return false
        }
    }
    text := p.L.Mods[c.Mi].Src!.Text[I64(e.Sp.Start):I64(e.Sp.End)]
    p.L.Diags.ErrorOncePerLine(at, msgs.UnknownErrorType(msgs.Tok(text)))
    return false
}

# whether an error type is a named set (T19a): it declares members
fn (p mut Program&) IsErrorSet(t types.TypeId) Bool {
    return t != types.UnknownT and p.T.KindOf(t) == types.Kind.Named and p.ErrorMembers(p.T.DeclOf(t)).Len() > 0
}

# the words an error type declares (T19), in order - its declaration found among its module's, a top-level if's too
fn (p mut Program&) ErrorWords(d types.DeclId) Array<source.NameId>&p {
    e := p.errorDecl(d)
    if e is null { return Array<source.NameId>(0) }
    return match e {
        case ast.Decl.Errors(_, _, words, _) => words
        case _ => Array<source.NameId>(0)
    }
}

# the members a named error set declares (T19a), in order, as written in its module
fn (p mut Program&) ErrorMembers(d types.DeclId) Array<ast.Path&>&p {
    e := p.errorDecl(d)
    if e is null { return Array<ast.Path&>(0) }
    return match e {
        case ast.Decl.Errors(_, _, _, members) => members
        case _ => Array<ast.Path&>(0)
    }
}

# an error type's declaration (T19), among its module's and a top-level if's; null for none
fn (p mut Program&) errorDecl(d types.DeclId) ast.Decl?&p {
    return errorDeclIn(p.L.Mods[p.T.DeclModule(d)].Decls, p.T.DeclName(d))
}

fn errorDeclIn(ds Array<ast.Decl&>&, name source.NameId) ast.Decl?&ds {
    if ds.Len() == 0 { return null }
    for d in ds {
        match d {
            case ast.Decl.Errors(_, n, _, _) {
                if n == name { return d }
            }
            case ast.Decl.If(_, ti) {
                e := errorDeclInIf(ti, name)
                if e is not null { return e }
            }
            nomatch { }
        }
    }
    return null
}

fn errorDeclInIf(ti ast.TopIf&, name source.NameId) ast.Decl?&ti {
    if ti.Then is not null {
        e := errorDeclIn(ti.Then!.Decls, name)
        if e is not null { return e }
    }
    if ti.ElseIf is not null {
        e := errorDeclInIf(ti.ElseIf!, name)
        if e is not null { return e }
    }
    if ti.Else is not null { return errorDeclIn(ti.Else!.Decls, name) }
    return null
}

# the module an alias of a module reaches, -1 for none
fn (p mut Program&) aliasStep(mi I64, alias source.NameId) I64 {
    for imp in p.L.Mods[mi].Imports {
        if imp.Target >= 0 and p.L.Names.Intern(imp.Alias) == alias { return imp.Target }
    }
    return -1
}

# an anonymous type written in place: an enum's cases, or a struct's fields (T27)
fn (p mut Program&) shape(c Context&, body ast.TypeBody&) types.TypeId {
    return match body {
        case ast.TypeBody.Enum(cases, _) => p.anonEnum(c, cases)
        case ast.TypeBody.Struct(s) => p.T.Record(p.paramTypes(c, s.Params))
        case _ => types.UnknownT
    }
}

fn (p mut Program&) anonEnum(c Context&, cases Array<ast.CaseDecl&>&) types.TypeId {
    ns := Array<source.NameId>(cases.Len())
    ps := Array<types.TypeId>(cases.Len())
    fs List<source.NameId>
    for i in range cases.Len() {
        ns[i] = cases[i].Name
        ps[i] = p.payload(c, cases[i])
        if cases[i].Payload.Len() > 0 {
            for f in cases[i].Payload { fs.Push(f.Name) }
        }
    }
    return p.T.AnonEnum(ns, p.T.List(ps), fs.ToArray())
}

# an enum case's payload: a record of its fields, none (0) for a case carrying none
fn (p mut Program&) payload(c Context&, cd ast.CaseDecl&) types.TypeId {
    if cd.Payload.Len() == 0 { return types.TypeId(0) }
    return p.T.Record(p.paramTypes(c, cd.Payload))
}

fn (p mut Program&) paramTypes(c Context&, ps Array<ast.Param&>&) types.ListId {
    ts := Array<types.TypeId>(ps.Len())
    for i in range ps.Len() { ts[i] = p.Resolve(c, ps[i].Ty) }
    return p.T.List(ts)
}

# ---- constants: lengths (QP1, T7c) and what instances bind (G29) ----

# the constant no fold reaches: a pattern of its own, which never folds
fn (p mut Program&) UnknownConst() types.TypeId { return p.T.ConstExpr("?") }

# a constant's value where it folds as written (a literal, a constant variable, an immutable global's value), else the
# unknown constant - never asked of the evaluator, for a question the program does not need answered while compiling
fn (p mut Program&) FoldKnown(c Context&, e ast.Expr&, want types.TypeId) types.TypeId {
    f := p.eval(c, e)
    if f.St == Folded { return p.T.Const(want, p.wrap(f.V, want)) }
    return p.UnknownConst()
}

# QP1, T7c: the length Array<T>(n) gives where n is written - a Const where n folds (a literal, an immutable global's
# value, arithmetic on these), a pattern where it reads a type variable not bound yet, the unknown constant while the
# evaluator is asked for it (a call, a global a call computes), and 0 - a length known only at run time - where n reads
# a local or a parameter, or the evaluator could not compute it. Never an error: a length that cannot be known while
# compiling is a run-time one
fn (p mut Program&) FoldLength(c Context&, e ast.Expr?&) types.TypeId {
    if e is null or p.readsLocal(c, e) { return types.TypeId(0) }
    i64 := p.T.Prim("I64")
    f := p.eval(c, e)
    if f.St == Unfolded and (c.Owner < 0 or p.varsBound(c)) {
        key String&p = p.LengthKey(c, e)
        if p.Lengths.Has(key) {
            v := try p.Lengths.Get(key) catch default RunTimeLength
            return types.TypeId(0) if v == RunTimeLength else p.T.Const(i64, v)
        }
        seen := false
        for a in p.ConstAsks {
            if a.Key == key { seen = true }
        }
        if not seen {
            ns mut Array<source.NameId>&p = Array<source.NameId>(c.Vars.Len())
            vs mut Array<types.TypeId>&p = Array<types.TypeId>(c.Vars.Len())
            k I64 = 0
            for v in c.Vars {
                ns[k], vs[k] = v.Key, v.Value
                k++
            }
            p.ConstAsks.Push(ConstAsk(c.Mi, e, i64, c.Owner, ns, vs, key))
        }
        return p.UnknownConst()
    }
    # T7c's typed fold: a value of a narrower integer type flows in (T6b); one that does not is no length known here
    if f.St == Folded and p.T.IsInt(f.Ty) and f.Ty != i64 and not p.Flows(f.Ty, i64) and not litOnly(e) { return types.TypeId(0) }
    if f.St == Folded and f.Ty != types.UnknownT and not p.T.IsInt(f.Ty) { return types.TypeId(0) }
    return p.constOf(c, f, i64, e)
}

# whether an expression reads a local or a parameter of the item it is written in, or anything a fold cannot tell (a
# lambda): its value is then the running program's (QP1)
fn (p mut Program&) readsLocal(c Context&, e ast.Expr?&) Bool {
    if e is null { return false }
    match e {
        case ast.Expr.Name(sp, _) {
            k := p.R.Use(p.file(c.Mi), sp.Start).Kind
            return k == names.What.Local or k == names.What.None
        }
        nomatch { }
    }
    return match e {
        case ast.Expr.Lit(_, _), ast.Expr.Default(_) => false
        case ast.Expr.Paren(_, x), ast.Expr.Unary(_, _, x), ast.Expr.Member(_, x, _), ast.Expr.Generic(_, x, _) => p.readsLocal(c, x)
        case ast.Expr.Binary(_, _, a, b) => p.readsLocal(c, a) or p.readsLocal(c, b)
        case ast.Expr.Cond(_, a, k, b) => p.readsLocal(c, a) or p.readsLocal(c, k) or p.readsLocal(c, b)
        case ast.Expr.Call(_, f, args) => not p.instanceLen(c, f, args) and (p.readsLocal(c, f) or p.anyReadsLocal(c, args))
        case ast.Expr.Index(_, x, items) => p.readsLocal(c, x) or p.anyReadsLocal(c, items)
        case _ => true
    }
}

# whether a call is x.Len() of an array an instance takes by value - its length a variable the context binds (G29)
fn (p mut Program&) instanceLen(c Context&, f ast.Expr&, args Array<ast.Expr&>&) Bool {
    k := p.LenKey(f, args)
    return k != "" and c.Vars.Has(p.L.Names.Intern(k))
}

fn (p mut Program&) anyReadsLocal(c Context&, xs Array<ast.Expr&>&) Bool {
    if xs.Len() == 0 { return false }
    for x in xs {
        if p.readsLocal(c, x) { return true }
    }
    return false
}

# a typed global's type (T7d): its written type, an immutable one's taking a known length from its initializer
fn (p mut Program&) GlobalStorage(gc Context&, v ast.VarDecl&, n source.NameId) types.TypeId {
    t := p.Resolve(gc, v.Ty)
    if mutableGlobal(v) { return t }
    for k in range v.Names.Len() {
        if v.Names[k] == n and k < v.Values.Len() { return p.StorageOf(gc, t, v.Values[k]) }
    }
    return t
}

# T7d: the storage a value array declared with a written type takes from its initializer - the written type where the
# initializer's length is not known while compiling (as far as Infer tells, before the checker), or the written type
# is no plain Array<T> value
fn (p mut Program&) StorageOf(c Context&, written types.TypeId, init ast.Expr?&) types.TypeId {
    if init is null or p.T.KindOf(written) != types.Kind.Array or p.T.Length(written) != types.TypeId(0) { return written }
    none Map<source.NameId, types.TypeId>
    it := p.Infer(c, none, init)
    if p.T.KindOf(it) != types.Kind.Array or p.T.Length(it) == types.TypeId(0) { return written }
    if not p.LengthsOnly(p.T.Elem(it), p.T.Elem(written)) { return written }
    return it
}

# whether a is the written type b with lengths known where b's value arrays have none (T7d: an array of arrays held by
# value takes its elements' length from where it is made)
fn (p mut Program&) LengthsOnly(a types.TypeId, b types.TypeId) Bool {
    if p.T.Same(a, b) { return true }
    if p.T.KindOf(a) != types.Kind.Array or p.T.KindOf(b) != types.Kind.Array { return false }
    if p.T.Length(b) != types.TypeId(0) and not p.T.Same(p.T.Length(a), p.T.Length(b)) { return false }
    return p.LengthsOnly(p.T.Elem(a), p.T.Elem(b))
}

# a fold's outcome: Folded, its value (in Ty's width, Ty Unknown for a literal's exact value, which adapts - T6, E4a);
# Pending, it reads a variable not bound yet; Unfolded, it needs evaluating
Folded I64 = 0
Pending I64 = 1
Unfolded I64 = 2

type folded struct(St I64, V I64, Ty types.TypeId) {
    St
    V
    Ty
}

fn unfolded() folded { return folded(Unfolded, 0, types.UnknownT) }

fn (p mut Program&) fold(c Context&, e ast.Expr&, want types.TypeId) types.TypeId { return p.constOf(c, p.eval(c, e), want, e) }

# whether an expression is a literal, or a sign before one: its value adapts (E4a), whatever type its digits read as
fn litOnly(e ast.Expr&) Bool {
    return match e {
        case ast.Expr.Lit(_, _) => true
        case ast.Expr.Unary(_, _, x) => litOnly(x)
        case ast.Expr.Paren(_, x) => litOnly(x)
        case _ => false
    }
}

fn (p mut Program&) constOf(c Context&, f folded, want types.TypeId, e ast.Expr?&) types.TypeId {
    if f.St == Folded { return p.T.Const(want, p.wrap(f.V, want)) }
    # one needing evaluation in a context whose variables are not bound yet - a generic's own declaration - is a
    # pattern too: each instance evaluates it with its own arguments (T7c)
    if f.St == Unfolded and e is not null and c.Owner >= 0 and not p.varsBound(c) { f = folded(Pending, 0, types.UnknownT) }
    if f.St == Pending and e is not null {
        sp := e.Span()
        k := p.T.ConstExpr($c.Owner ":" $c.Mi ":" $sp.Start ":" $sp.End ":" $I64(want))
        p.patterns.Put(p.T.A(k), pattern(e, c.Mi, c.Owner, want))
        return k
    }
    # T7c: one needing evaluation, reading no variable (a call, a global a call computes) - what the evaluator found
    # where it has, else asked for once and the unknown constant meanwhile
    if f.St == Unfolded and e is not null {
        key String&p = p.LengthKey(c, e)
        if p.Lengths.Has(key) {
            v := try p.Lengths.Get(key) catch default RunTimeLength
            return types.TypeId(0) if v == RunTimeLength else p.T.Const(want, p.wrap(v, want))
        }
        seen := false
        for a in p.ConstAsks {
            if a.Key == key { seen = true }
        }
        if not seen {
            ns mut Array<source.NameId>&p = Array<source.NameId>(c.Vars.Len())
            vs mut Array<types.TypeId>&p = Array<types.TypeId>(c.Vars.Len())
            k I64 = 0
            for v in c.Vars {
                ns[k], vs[k] = v.Key, v.Value
                k++
            }
            p.ConstAsks.Push(ConstAsk(c.Mi, e, want, c.Owner, ns, vs, key))
        }
    }
    return p.UnknownConst()
}

# whether every variable of a context is bound to a type holding no variable
fn (p mut Program&) varsBound(c Context&) Bool {
    for v in c.Vars {
        if not p.T.Closed(v.Value) { return false }
    }
    return true
}

# what an evaluated constant argument is kept by: its module's file and offset, and each variable bound where it is
# read, as the type's canonical text - the same in every check of the program, where a TypeId need not be. Each
# instance of a generic computes its own (T7c)
fn (p mut Program&) LengthKey(c Context&, e ast.Expr&) String {
    b := StringBuilder()
    b.Push($p.L.Mods[c.Mi].File ":" $e.Span().Start)
    for v in c.Vars {
        b.Push(" ")
        b.Push(p.T.Canon(v.Value))
    }
    return b.ToString()
}

# a constant's value in a type's width: an unsigned one's bits, a signed one's sign-extended (E6c: integer arithmetic
# wraps, as the program's does)
fn (p mut Program&) wrap(v I64, t types.TypeId) I64 {
    r := p.numberOf(t)
    if not p.T.IsInt(r) { return v }
    bits := p.T.Bits(r)
    if bits >= 64 { return v }
    m := (I64(1) << bits) - 1
    x := v & m
    if not p.T.IsUnsigned(r) and ((x >> (bits - 1)) & 1) == 1 { x = x | ~m }
    return x
}

# the number type a type is, past a declared type over one (T29: Char's U8)
fn (p mut Program&) numberOf(t types.TypeId) types.TypeId {
    p.reprReady(t)
    return p.T.Repr(t)
}

# an integer expression's value where it folds exactly as the program computes it (QP1, T7c): literals exact (E4a),
# immutable globals in their types, an instance's lengths (G29), a conversion to a number type, operators in the type
# their operands meet at (T6b, E6d), wrapping where the program wraps (E6c)
fn (p mut Program&) eval(c Context&, e ast.Expr&) folded {
    return match e {
        case ast.Expr.Lit(sp, kind) => p.evalLit(c.Mi, sp, kind)
        case ast.Expr.Paren(_, x) => p.eval(c, x)
        case ast.Expr.Name(sp, n) => p.foldPath(c, sp, Array<source.NameId>(1, n))
        case ast.Expr.Unary(_, op, x) => p.evalUnary(c, op, x)
        case ast.Expr.Binary(_, op, a, b) => p.evalBinary(c, op, a, b)
        case ast.Expr.Cond(_, a, k, b) => p.evalCond(c, a, k, b)
        case ast.Expr.Call(_, f, args) => p.evalCall(c, f, args)
        case _ => unfolded()
    }
}

# a call in a constant: a conversion to a number, or x.Len() of an array a parameter holds by value - its instance's
# length (G29, G30)
fn (p mut Program&) evalCall(c Context&, f ast.Expr&, args Array<ast.Expr&>&) folded {
    k := p.LenKey(f, args)
    if k != "" {
        v := try c.Vars.Get(p.L.Names.Intern(k)) catch default types.TypeId(-1)
        if v >= types.TypeId(0) {
            if p.T.KindOf(v) == types.Kind.Const { return folded(Folded, p.T.ConstValue(v), p.T.ConstType(v)) }
            return folded(Pending, 0, types.UnknownT)
        }
    }
    return p.evalConversion(c, f, args)
}

# G29: the name of the variable x.Len() reads, where x is a parameter (or an element of one: "m[0].Len()") holding an
# array by value - "" where the call is no such Len()
fn (p mut Program&) LenKey(f ast.Expr&, args Array<ast.Expr&>&) String {
    if args.Len() > 0 { return "" }
    match f {
        case ast.Expr.Member(_, y, n) {
            if p.text(n) != "Len" { return "" }
            k := p.lenPath(y, 0)
            return "" if k == "" else $k ".Len()"
        }
        nomatch { return "" }
    }
}

fn (p mut Program&) lenPath(y ast.Expr&, depth I64) String {
    if depth > 8 { return "" }
    match y {
        case ast.Expr.Name(_, n) { return $p.text(n) }
        case ast.Expr.Paren(_, z) { return p.lenPath(z, depth + 1) }
        case ast.Expr.Index(_, z, items) {
            if items.Len() != 1 { return "" }
            k := p.lenPath(z, depth + 1)
            return "" if k == "" else $k "[0]"
        }
        nomatch { return "" }
    }
}

fn (p mut Program&) evalLit(mi I64, sp source.Span, kind token.Tok) folded {
    txt := p.L.Mods[mi].Src!.TextOf(sp)
    match kind {
        case token.Tok.IntLit {
            v := try txt.ParseInt(0) catch {
                u := try txt.ParseUint(0) catch { return unfolded() }
                return folded(Folded, I64(u), p.T.Prim("U64"))   # L10: a decimal literal above I64's maximum is a U64
            }
            return folded(Folded, v, types.UnknownT)
        }
        case token.Tok.BoolLit { return folded(Folded, 1 if txt == "true" else 0, types.BoolT) }
        nomatch { return unfolded() }
    }
}

# a name in a constant: a variable an instance binds, an immutable global's value in its type (its initializer folded
# in its module), through an alias chain or not
fn (p mut Program&) foldPath(c Context&, sp source.Span, path Array<source.NameId>&) folded {
    if path.Len() == 1 {
        v := try c.Vars.Get(path[0]) catch default types.TypeId(-1)
        if v >= types.TypeId(0) {
            if p.T.KindOf(v) == types.Kind.Const { return folded(Folded, p.T.ConstValue(v), p.T.ConstType(v)) }
            return folded(Pending, 0, types.UnknownT)
        }
    }
    mi := c.Mi
    if path.Len() > 1 {
        ref := p.R.Use(p.file(c.Mi), sp.Start)
        if ref.Kind != names.What.Import { return unfolded() }
        mi = ref.Module
        for k in range 1, path.Len() - 1 {
            mi = p.aliasStep(mi, path[k])
            if mi < 0 { return unfolded() }
        }
    }
    return p.foldGlobal(mi, path[path.Len() - 1])
}

fn (p mut Program&) foldGlobal(mi I64, n source.NameId) folded {
    v := p.globalDecl(mi, n)
    if v is null { return unfolded() }
    key := (mi << 32) | I64(n)
    if try p.folding.Get(key) catch default false { return unfolded() }   # B5a's cycle: the checker says it
    i := 0
    for k in range v.Names.Len() {
        if v.Names[k] == n { i = k }
    }
    if i >= v.Values.Len() { return unfolded() }
    p.folding.Put(key, true)
    gc := Context(mi, -1)
    f := p.eval(gc, v.Values[i])
    p.folding.Put(key, false)
    if f.St != Folded or v.Ty is null { return f }
    t := p.Resolve(gc, v.Ty)
    return folded(Folded, p.wrap(f.V, t), t)
}

# an immutable global's declaration in a module, outside every top-level if; null for none (a mutable global is no
# constant)
fn (p mut Program&) globalDecl(mi I64, n source.NameId) ast.VarDecl?&p {
    ds := p.L.Mods[mi].Decls
    if ds.Len() == 0 { return null }
    for d in ds {
        match d {
            case ast.Decl.Global(_, v) {
                for k in range v.Names.Len() {
                    if v.Names[k] == n and not mutableGlobal(v) { return v }
                }
            }
            nomatch { }
        }
    }
    return null
}

fn mutableGlobal(v ast.VarDecl&) Bool {
    if v.Ty is null { return false }
    return match v.Ty {
        case ast.TypeRef.Perm(_, _, writable, _) => writable
        case _ => false
    }
}

# a conversion to a number type, "I64(x)": x's value in that type's width (E26: unchecked)
fn (p mut Program&) evalConversion(c Context&, f ast.Expr&, args Array<ast.Expr&>&) folded {
    if args.Len() != 1 { return unfolded() }
    match f {
        case ast.Expr.Name(sp, n) {
            if p.R.Use(p.file(c.Mi), sp.Start).Kind != names.What.Builtin { return unfolded() }
            t := p.T.Prim(p.text(n))
            if not p.T.IsInt(t) { return unfolded() }
            x := p.eval(c, args[0])
            if x.St != Folded { return x }
            return folded(Folded, p.wrap(x.V, t), t)
        }
        nomatch { return unfolded() }
    }
}

fn (p mut Program&) evalUnary(c Context&, op token.Tok, x ast.Expr&) folded {
    f := p.eval(c, x)
    if f.St != Folded { return f }
    return match op {
        case token.Tok.Minus => folded(Folded, p.wrap(-f.V, f.Ty), f.Ty)
        case token.Tok.Tilde => folded(Folded, p.wrap(~f.V, f.Ty), f.Ty)
        case token.Tok.Not => folded(Folded, 1 - f.V, types.BoolT)
        case _ => unfolded()
    }
}

# the type two operands meet at (T6b, E6d): a literal adapts to the other operand where its value fits that type, else
# meets it at its own (I64); two typed ones meet where one flows into the other; Unknown (the literal's) for two
# literals; -1 where they do not meet
fn (p mut Program&) meet(a folded, b folded) types.TypeId {
    if a.Ty == types.UnknownT and b.Ty == types.UnknownT { return types.UnknownT }
    if a.Ty == types.UnknownT { return b.Ty if p.wrap(a.V, b.Ty) == a.V else p.meetTyped(p.T.Prim("I64"), b.Ty) }
    if b.Ty == types.UnknownT { return a.Ty if p.wrap(b.V, a.Ty) == b.V else p.meetTyped(a.Ty, p.T.Prim("I64")) }
    return p.meetTyped(a.Ty, b.Ty)
}

fn (p mut Program&) meetTyped(a types.TypeId, b types.TypeId) types.TypeId {
    if a == b { return a }
    if p.Flows(a, b) { return b }
    if p.Flows(b, a) { return a }
    return types.TypeId(-1)
}

# T6b: whether a number of type a flows into type b with nothing lost - wider within a signedness, an unsigned into a
# strictly wider signed, F16 and BF16 into F32 into F64; a declared type into its base and on
fn (p mut Program&) Flows(a types.TypeId, b types.TypeId) Bool {
    if a == b { return true }
    ra := p.numberOf(a)
    if ra != a { return p.Flows(ra, b) }
    if not p.T.IsNumber(a) or not p.T.IsNumber(b) { return false }
    ba, bb := p.T.Bits(a), p.T.Bits(b)
    if p.T.IsFloat(a) or p.T.IsFloat(b) {
        if not (p.T.IsFloat(a) and p.T.IsFloat(b)) { return false }
        return ba < bb and (bb >= 32)
    }
    if p.T.IsUnsigned(a) == p.T.IsUnsigned(b) { return ba < bb }
    return p.T.IsUnsigned(a) and not p.T.IsUnsigned(b) and ba < bb
}

fn (p mut Program&) evalBinary(c Context&, op token.Tok, a ast.Expr&, b ast.Expr&) folded {
    if op == token.Tok.And or op == token.Tok.Or {
        fa := p.eval(c, a)
        if fa.St != Folded { return fa }
        if (op == token.Tok.And and fa.V == 0) or (op == token.Tok.Or and fa.V != 0) { return fa }   # E7
        return p.eval(c, b)
    }
    fa := p.eval(c, a)
    fb := p.eval(c, b)
    if fa.St == Unfolded or fb.St == Unfolded { return unfolded() }
    if fa.St == Pending or fb.St == Pending { return folded(Pending, 0, types.UnknownT) }
    t := p.meet(fa, fb)
    if t == types.TypeId(-1) { return unfolded() }
    x, y := fa.V, fb.V
    unsigned := t != types.UnknownT and p.T.IsUnsigned(p.numberOf(t))
    if op == token.Tok.EqEq or op == token.Tok.NotEq or op == token.Tok.Lt or op == token.Tok.Le or op == token.Tok.Gt or
       op == token.Tok.Ge {
        less := (U64(x) < U64(y)) if unsigned else x < y
        r := match op {
            case token.Tok.EqEq => x == y
            case token.Tok.NotEq => x != y
            case token.Tok.Lt => less
            case token.Tok.Le => less or x == y
            case token.Tok.Gt => not less and x != y
            case _ => not less
        }
        return folded(Folded, 1 if r else 0, types.BoolT)
    }
    v I64 = 0
    match op {
        case token.Tok.Plus { v = x + y }
        case token.Tok.Minus { v = x - y }
        case token.Tok.Star { v = x * y }
        case token.Tok.Slash, token.Tok.Percent {
            if y == 0 { return unfolded() }   # E6a: undefined, the checker's
            if unsigned {
                v = I64(U64(x) / U64(y)) if op == token.Tok.Slash else I64(U64(x) % U64(y))
            } else {
                v = x / y if op == token.Tok.Slash else x % y
            }
        }
        case token.Tok.Amp { v = x & y }
        case token.Tok.Pipe { v = x | y }
        case token.Tok.Caret { v = x ^ y }
        case token.Tok.Shl, token.Tok.Shr {
            t = fa.Ty if fa.Ty != types.UnknownT else (fb.Ty if fb.Ty == types.UnknownT else types.UnknownT)   # E8b
            w := 64 if t == types.UnknownT else p.T.Bits(p.numberOf(t))
            if y < 0 or y >= w { return unfolded() }
            if op == token.Tok.Shl {
                v = x << y
            } else {
                v = I64(U64(x) >> U64(y)) if t != types.UnknownT and p.T.IsUnsigned(p.numberOf(t)) else x >> y
            }
        }
        case token.Tok.Xor { v = 1 if (x != 0) != (y != 0) else 0 }
        nomatch { return unfolded() }
    }
    if op == token.Tok.Xor { return folded(Folded, v, types.BoolT) }
    return folded(Folded, p.wrap(v, t) if t != types.UnknownT else v, t)
}

fn (p mut Program&) evalCond(c Context&, a ast.Expr&, k ast.Expr&, b ast.Expr&) folded {
    f := p.eval(c, k)
    if f.St != Folded { return f }
    return p.eval(c, a) if f.V != 0 else p.eval(c, b)
}

# ---- substitution ----

# a type with an owner's variables replaced by args (G8a, G10b): a variable "mut T" bound to a reference gives it
# "mut" (T2); a constant still to be computed is folded with the arguments bound
fn (p mut Program&) Subst(t types.TypeId, owner I64, args types.ListId) types.TypeId {
    xs := p.T.Items(args)
    k := p.T.KindOf(t)
    match k {
        case types.Kind.Var {
            if p.T.A(t) != owner or p.T.B(t) >= xs.Len() { return t }
            v := xs[p.T.B(t)]
            # G1a: an error-set variable bound to another one is that one (an argument holds it in a set)
            if p.T.KindOf(v) == types.Kind.ErrSet and p.IsErrVar(t) {
                vs := p.T.Items(p.T.ErrSetItems(v))
                if vs.Len() == 1 and p.T.KindOf(vs[0]) == types.Kind.Var { return vs[0] }
            }
            bits := p.T.C(t)
            if bits != types.ReadOnly and p.T.KindOf(v) == types.Kind.Ref {
                return p.T.Ref(p.T.Referent(v), p.T.PermOf(v) | bits)
            }
            return v
        }
        case types.Kind.ConstExpr {
            pat := try p.patterns.Get(p.T.A(t)) catch default pattern(null, -1, -2, types.UnknownT)
            if pat.Owner == -2 { return t }
            if pat.Owner != owner { return t }
            c := Context(pat.Mi, owner)
            n := p.VarCount(owner)
            for i in range n {
                if i < xs.Len() { c.Vars.Put(p.VarAt(owner, i).Name, xs[i]) }
            }
            return p.fold(c, pat.Expr!, pat.Want)
        }
        case types.Kind.Named {
            if p.T.Args(t) == types.ListId(0) { return t }
            return p.Instance(p.T.DeclOf(t), p.substList(p.T.Args(t), owner, args))
        }
        case types.Kind.Array { return p.T.Array(p.Subst(p.T.Elem(t), owner, args), p.Subst(p.T.Length(t), owner, args)) }
        case types.Kind.Ref { return p.T.Ref(p.Subst(p.T.Referent(t), owner, args), p.T.PermOf(t)) }
        case types.Kind.Func {
            return p.T.Func(p.substList(p.T.Params(t), owner, args), p.Subst(p.T.Result(t), owner, args)
                            p.substErrs(p.T.Errors(t), owner, args), p.T.ScopesOf(t), p.T.NamesIdOf(t))
        }
        case types.Kind.ErrSet { return p.ErrSetOf(p.substErrs(p.T.ErrSetItems(t), owner, args)) }
        case types.Kind.Tuple { return p.T.Tuple(p.substList(p.T.Parts(t), owner, args)) }
        case types.Kind.Record { return p.T.Record(p.substList(p.T.Parts(t), owner, args)) }
        case types.Kind.AnonEnum { return p.T.AnonEnum(p.T.ShapeNames(t), p.substList(p.T.ShapeCases(t), owner, args), p.T.ShapeFields(t)) }
        # T32: an any's trait written with the owner's variables ("any Iterator<T>&")
        case types.Kind.Any { return p.T.Any(p.Subst(p.T.AnyTrait(t), owner, args)) }
        nomatch { return t }
    }
}

# a type with each part that is one of args written as the owner's variable it is bound to (G16b): an instance's type
# as the generic writes it. UnknownT where two of args are one type, so that a part could stand for either
fn (p mut Program&) Unsubst(t types.TypeId, owner I64, args types.ListId) types.TypeId {
    xs := p.T.Items(args)
    for i in range xs.Len() {
        for j in range i {
            if xs[i] == xs[j] { return types.UnknownT }
        }
    }
    return p.unsubst(t, owner, xs)
}

fn (p mut Program&) unsubst(t types.TypeId, owner I64, xs Array<types.TypeId>&) types.TypeId {
    for i in range xs.Len() {
        if xs[i] == t { return p.T.Var(owner, i, types.ReadOnly) }
    }
    match p.T.KindOf(t) {
        case types.Kind.Named {
            if p.T.Args(t) == types.ListId(0) { return t }
            ys := p.T.Items(p.T.Args(t))
            out := Array<types.TypeId>(ys.Len())
            for i in range ys.Len() { out[i] = p.unsubst(ys[i], owner, xs) }
            return p.Instance(p.T.DeclOf(t), p.T.List(out))
        }
        case types.Kind.Array { return p.T.Array(p.unsubst(p.T.Elem(t), owner, xs), p.unsubst(p.T.Length(t), owner, xs)) }
        case types.Kind.Ref { return p.T.Ref(p.unsubst(p.T.Referent(t), owner, xs), p.T.PermOf(t)) }
        case types.Kind.Any { return p.T.Any(p.unsubst(p.T.AnyTrait(t), owner, xs)) }
        nomatch { return t }
    }
}

fn (p mut Program&) substList(l types.ListId, owner I64, args types.ListId) types.ListId {
    if l == types.ListId(0) { return l }
    xs := p.T.Items(l)
    out := Array<types.TypeId>(xs.Len())
    for i in range xs.Len() { out[i] = p.Subst(xs[i], owner, args) }   # an enum's 0, a case carrying none, stays
    return p.T.List(out)
}

# ---- bodies ----

# a declared type's body, made the first time it is asked for: a struct's fields from its constructor (C2), an enum's
# cases' payloads (T17), the type a declared type is over (T29); an instance's is its generic's substituted (G10b).
# Whether it has one: a declaration that did not parse past its name has none
fn (p mut Program&) Body(t types.TypeId) Bool {
    if p.T.KindOf(t) != types.Kind.Named { return true }
    if p.T.HasBody(t) { return true }
    d := p.T.DeclOf(t)
    self := p.SelfType(d)
    if t != self {
        if not p.Body(self) { return false }
        owner := DeclOwner(d)
        args := p.T.Args(t)
        match p.T.DeclKindOf(d) {
            case types.DeclKind.Struct { p.T.SetStructBody(t, p.substList(p.T.Fields(self), owner, args), p.T.Destructs(self)) }
            case types.DeclKind.Enum { p.T.SetEnumBody(t, p.T.CaseNames(self), p.substList(p.T.Cases(self), owner, args)) }
            case types.DeclKind.Over { p.T.SetOverBody(t, p.Subst(p.T.Base(self), owner, args)) }
            nomatch { p.T.SetEmptyBody(t) }
        }
        # G17: the instances its parts name are made too, as far as they nest - a field instantiating the type with a
        # larger argument is a chain that never ends
        if p.T.Closed(t) {
            match p.T.DeclKindOf(d) {
                case types.DeclKind.Struct { p.expandList(p.T.Fields(t), 0) }
                case types.DeclKind.Enum { p.expandList(p.T.Cases(t), 0) }
                nomatch { }
            }
        }
        return true
    }
    td := p.typeDecl(d)
    if td is null {
        p.T.SetEmptyBody(t)   # an error type (T19)
        return true
    }
    if td.Body is null { return false }
    c := p.declContext(d)
    match td.Body {
        case ast.TypeBody.Struct(s) {
            p.T.SetStructBody(t, p.fields(c, s), s.DtorSp.End > 0)
        }
        case ast.TypeBody.Enum(cases, _) {
            ns := Array<source.NameId>(cases.Len())
            ps := Array<types.TypeId>(cases.Len())
            for i in range cases.Len() {
                ns[i] = cases[i].Name
                ps[i] = p.payload(c, cases[i])
            }
            p.T.SetEnumBody(t, ns, p.T.List(ps))
        }
        case ast.TypeBody.Over(base, _) { p.T.SetOverBody(t, p.Resolve(c, base)) }
        case ast.TypeBody.Trait(_, _, _), ast.TypeBody.Foreign { p.T.SetEmptyBody(t) }
    }
    return true
}

# a struct's fields (C2, C4): the constructor body's field declarations, in order - written with a type, a pun taking
# its parameter's, ":=" taking its value's (D15)
fn (p mut Program&) fields(c Context&, s ast.StructBody&) types.ListId {
    known Map<source.NameId, types.TypeId>
    for prm in s.Params {
        if prm.Ty is not null { known.Put(prm.Name, p.Resolve(c, prm.Ty)) }
    }
    out List<types.TypeId>
    if s.Body.Len() == 0 { return types.ListId(0) }
    for st in s.Body {
        match st {
            case ast.Stmt.Var(_, v) {
                if not v.Field { continue }
                for i in range v.Names.Len() {
                    ft := types.UnknownT
                    if v.Infer {
                        x := v.Values[i] if i < v.Values.Len() else null
                        ft = p.Infer(c, known, x)
                    } else if v.Ty is not null {
                        # T7d, C2e: a value array field given a known length by its initializer is held in the instance
                        ft = p.StorageOf(c, p.Resolve(c, v.Ty), v.Values[i] if i < v.Values.Len() else null)
                    } else {
                        ft = try known.Get(v.Names[i]) catch default types.UnknownT
                    }
                    known.Put(v.Names[i], ft)
                    out.Push(ft)
                }
            }
            nomatch { }
        }
    }
    return p.T.List(out.ToArray())
}

# the type of a value a ":=" declaration takes (D15), where it is plain from the expression written: a literal, a name
# already typed, a constructor call, an array made or written, text; Unknown where it needs the checker (M5b)
fn (p mut Program&) Infer(c Context&, known Map<source.NameId, types.TypeId>&, x ast.Expr?&) types.TypeId {
    if x is null { return types.UnknownT }
    return match x {
        case ast.Expr.Lit(_, kind) => p.literalType(kind)
        case ast.Expr.Paren(_, y) => p.Infer(c, known, y)
        case ast.Expr.Unary(_, op, y) => p.unaryType(c, known, op, y)
        case ast.Expr.Join(_, _) => p.textType()
        case ast.Expr.Name(sp, n) => try known.Get(n) catch default p.nameType(c, sp, n)
        case ast.Expr.ArrayLit(_, elem, items) => p.T.Array(p.itemsElem(c, known, p.Resolve(c, elem), items), p.T.Const(p.T.Prim("I64"), items.Len()))
        case ast.Expr.Index(_, y, items) => p.literalOf(c, y, items)
        case ast.Expr.Call(_, f, cargs) => p.madeType(c, known, f, cargs)
        case ast.Expr.Try(_, y, _) => p.Infer(c, known, y)
        case ast.Expr.As(_, _, t) => p.Resolve(c, t)
        case ast.Expr.Binary(_, op, a, b) => p.binaryType(c, known, op, a, b)
        case _ => types.UnknownT
    }
}

# an array literal's element type: the written one, or where that is an array value of no known length, the items' one
# known length (T7d: the elements of an array of arrays held by value laid out at the length its literal gives them)
fn (p mut Program&) itemsElem(c Context&, known Map<source.NameId, types.TypeId>&, el types.TypeId, items Array<ast.Expr&>&) types.TypeId {
    if p.T.KindOf(el) != types.Kind.Array or p.T.Length(el) != types.TypeId(0) or items.Len() == 0 { return el }
    first := p.Infer(c, known, items[0])
    if p.T.KindOf(first) != types.Kind.Array or p.T.KindOf(p.T.Length(first)) != types.Kind.Const or not p.LengthsOnly(first, el) { return el }
    for x in items {
        if not p.T.Same(p.Infer(c, known, x), first) { return el }
    }
    return first
}

# T[a, b] where T names a type: an array literal, its length its items' count (T7c)
fn (p mut Program&) literalOf(c Context&, y ast.Expr&, items Array<ast.Expr&>&) types.TypeId {
    match y {
        case ast.Expr.Name(sp, n) {
            ref := p.R.Use(p.file(c.Mi), sp.Start)
            if ref.Kind != names.What.Type and ref.Kind != names.What.Builtin and ref.Kind != names.What.TypeVar { return types.UnknownT }
            el := p.Resolve(c, ast.TypeRef.Named(sp, Array<source.NameId>(1, n), Array<ast.TypeRef&>(0)))
            if el == types.UnknownT { return types.UnknownT }
            return p.T.Array(el, p.T.Const(p.T.Prim("I64"), items.Len()))
        }
        nomatch { return types.UnknownT }
    }
}

# a call's type (callType), and Array<T>(n)'s length where n is known while compiling (QP1, T7c)
fn (p mut Program&) madeType(c Context&, known Map<source.NameId, types.TypeId>&, f ast.Expr&, args Array<ast.Expr&>&) types.TypeId {
    t := p.callType(c, known, f)
    match f {
        case ast.Expr.Generic(_, g, targs) {
            match g {
                case ast.Expr.Name(sp, n) {
                    if p.R.Use(p.file(c.Mi), sp.Start).Kind == names.What.Builtin and p.text(n) == "Array" and targs.Len() == 1 and
                       args.Len() > 0 and args.Len() >= 1 and p.T.KindOf(t) == types.Kind.Array {
                        # T7d: elements held by value take their length from the fill, as the checker's arrayMake does
                        el := p.T.Elem(t)
                        if args.Len() == 2 and p.T.KindOf(el) == types.Kind.Array and p.T.Length(el) == types.TypeId(0) {
                            ft := p.Infer(c, known, args[1])
                            if p.T.KindOf(ft) == types.Kind.Array and p.T.Length(ft) != types.TypeId(0) and p.LengthsOnly(ft, el) { el = ft }
                        }
                        return p.T.Array(el, p.FoldLength(c, args[0]))
                    }
                }
                nomatch { }
            }
        }
        nomatch { }
    }
    return t
}

# a name's type outside the declaration's own: a global's - its written type, or its initializer's (D15)
fn (p mut Program&) nameType(c Context&, sp source.Span, n source.NameId) types.TypeId {
    ref := p.R.Use(p.file(c.Mi), sp.Start)
    if ref.Kind != names.What.Global or ref.Index < 0 { return types.UnknownT }
    v := p.anyGlobal(ref.Module, n)
    if v is null { return types.UnknownT }
    gc := Context(ref.Module, -1)
    if v.Ty is not null and not v.Infer { return p.GlobalStorage(gc, v, n) }
    key := (ref.Module << 32) | I64(n)
    if try p.folding.Get(key) catch default false { return types.UnknownT }
    i := 0
    for k in range v.Names.Len() {
        if v.Names[k] == n { i = k }
    }
    if i >= v.Values.Len() { return types.UnknownT }
    p.folding.Put(key, true)
    none Map<source.NameId, types.TypeId>
    t := p.Infer(gc, none, v.Values[i])
    p.folding.Put(key, false)
    return t
}

# a global's declaration in a module, in the branches of its top-level ifs that were taken too; null for none
fn (p mut Program&) anyGlobal(mi I64, n source.NameId) ast.VarDecl?&p { return p.globalIn(mi, p.L.Mods[mi].Decls, n) }

fn (p mut Program&) globalIn(mi I64, ds Array<ast.Decl&>&, n source.NameId) ast.VarDecl?&p {
    if ds.Len() == 0 { return null }
    for d in ds {
        match d {
            case ast.Decl.Global(_, v) {
                if v.Names.Has(n) { return v }
            }
            case ast.Decl.If(_, ti) {
                v := p.globalInIf(mi, ti, p.L.Chosen(mi, ti.Cond!.Span().Start), 0, n)
                if v is not null { return v }
            }
            nomatch { }
        }
    }
    return null
}

fn (p mut Program&) globalInIf(mi I64, ti ast.TopIf&, chosen I64, index I64, n source.NameId) ast.VarDecl?&p {
    if chosen == index and ti.Then!.Decls.Len() > 0 { return p.globalIn(mi, ti.Then!.Decls, n) }
    if ti.ElseIf is not null { return p.globalInIf(mi, ti.ElseIf!, chosen, index + 1, n) }
    if ti.Else is not null and chosen == index + 1 { return p.globalIn(mi, ti.Else!.Decls, n) }
    return null
}

fn (p mut Program&) unaryType(c Context&, known Map<source.NameId, types.TypeId>&, op token.Tok, y ast.Expr&) types.TypeId {
    if op == token.Tok.Minus or op == token.Tok.Tilde { return p.Infer(c, known, y) }
    if op == token.Tok.Dollar { return p.textType() }
    if op == token.Tok.Not { return types.BoolT }
    return types.UnknownT
}

fn (p mut Program&) literalType(kind token.Tok) types.TypeId {
    return match kind {
        case token.Tok.IntLit => p.T.Prim("I64")
        case token.Tok.FloatLit => p.T.Prim("F64")
        case token.Tok.BoolLit => types.BoolT
        case token.Tok.StrLit => p.textType()
        case token.Tok.CharLit => p.preludeType("std/prelude/text", "Char")
        case _ => types.UnknownT
    }
}

# T6a: arithmetic of literals declares what its value as one literal would; of anything else the checker's
fn (p mut Program&) binaryType(c Context&, known Map<source.NameId, types.TypeId>&, op token.Tok, a ast.Expr&, b ast.Expr&) types.TypeId {
    ta := p.Infer(c, known, a)
    tb := p.Infer(c, known, b)
    if ta != tb { return types.UnknownT }
    if op == token.Tok.EqEq or op == token.Tok.NotEq or op == token.Tok.Lt or op == token.Tok.Le or op == token.Tok.Gt or
       op == token.Tok.Ge or op == token.Tok.And or op == token.Tok.Or {
        return types.BoolT
    }
    return ta if p.T.IsNumber(ta) else types.UnknownT
}

fn (p mut Program&) textType() types.TypeId { return p.preludeType("std/prelude/text", "String") }

fn (p mut Program&) preludeType(identity String&, name String&) types.TypeId {
    d := try p.FindDecl(identity, name) catch { return types.UnknownT }
    return p.T.Named(d, types.ListId(0))
}

# a call's type where it is plain from the callee (D15): a constructor's (C2) - a destructor-declaring type's held by
# reference (C11) - Array<T>(n), a conversion to a number, a function's result where it is no generic
# one, a method's result for the receiver's type (M19; an array's Len, E23)
fn (p mut Program&) callType(c Context&, known Map<source.NameId, types.TypeId>&, f ast.Expr&) types.TypeId {
    match f {
        case ast.Expr.Generic(_, g, args) { return p.genericCall(c, g, args) }
        case ast.Expr.Name(sp, n) {
            ref := p.R.Use(p.file(c.Mi), sp.Start)
            if ref.Kind == names.What.Builtin { return types.BoolT if p.text(n) == "Bool" else p.T.Prim(p.text(n)) }
            return p.calleeType(ref, n)
        }
        case ast.Expr.Member(sp, x, n) {
            ref := p.R.Member(p.file(c.Mi), sp.End)
            if ref.Kind != names.What.None { return p.calleeType(ref, n) }
            recv := p.Infer(c, known, x)
            if recv == types.UnknownT { return types.UnknownT }
            if p.text(n) == "Len" and p.isArray(recv) { return p.T.Prim("I64") }
            m := p.MethodOf(recv, n)
            if m < 0 { return types.UnknownT }
            sig := p.MethodSig(m, recv)
            return types.UnknownT if sig == types.UnknownT else p.T.Result(sig)
        }
        nomatch { return types.UnknownT }
    }
}

fn (p mut Program&) isArray(t types.TypeId) Bool {
    x := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
    p.reprReady(x)
    return p.T.KindOf(p.T.Repr(x)) == types.Kind.Array
}

# what calling a name gives: a non-generic type's constructor, a non-generic function's result
fn (p mut Program&) calleeType(ref names.Ref, n source.NameId) types.TypeId {
    if ref.Kind == names.What.Type and ref.Index >= 0 {
        d := p.DeclFor(ref.Module, ref.Index)
        if p.T.DeclParams(d) == 0 { return p.held(p.T.Named(d, types.ListId(0))) }
        return types.UnknownT
    }
    if ref.Kind == names.What.Func {
        f := p.FnNamed(ref.Module, n)
        if f < 0 { return types.UnknownT }
        sig := p.Sig(f)
        if p.VarCount(FnOwner(f)) > 0 { return types.UnknownT }   # inferred from the arguments: the checker's
        return p.T.Result(sig)
    }
    return types.UnknownT
}

# Name<args>(...): an instance's constructor, or Array<T>(n)
fn (p mut Program&) genericCall(c Context&, g ast.Expr&, args Array<ast.TypeRef&>&) types.TypeId {
    ref := names.Ref(names.What.None, -1, -1)
    match g {
        case ast.Expr.Name(sp, n) {
            ref = p.R.Use(p.file(c.Mi), sp.Start)
            if ref.Kind == names.What.Builtin and p.text(n) == "Array" {
                if args.Len() != 1 { return types.UnknownT }
                return p.T.Array(p.Resolve(c, args[0]), types.TypeId(0))
            }
        }
        case ast.Expr.Member(sp, _, _) { ref = p.R.Member(p.file(c.Mi), sp.End) }
        nomatch { }
    }
    if ref.Kind != names.What.Type or ref.Index < 0 { return types.UnknownT }
    d := p.DeclFor(ref.Module, ref.Index)
    p.declVars(d)
    if args.Len() != p.T.DeclParams(d) { return types.UnknownT }
    vs := Array<types.TypeId>(args.Len())
    owner := DeclOwner(d)
    for i in range args.Len() { vs[i] = p.Resolve(c, args[i]) }
    return p.held(p.Instance(d, p.T.List(vs)))
}

# a constructor's value as ":=" holds it: a destructor-declaring type's by reference (C11)
fn (p mut Program&) held(t types.TypeId) types.TypeId {
    if p.T.KindOf(t) != types.Kind.Named or not p.Body(t) { return t }
    if p.T.DeclKindOf(p.T.DeclOf(t)) == types.DeclKind.Struct and p.T.Destructs(t) { return p.T.Ref(t, types.ReadOnly) }
    return t
}

# ---- layouts ----

# a type's layout, computed the first time it is asked for, its embedded parts first; whether it has one. A type
# asked for again while its own layout is being computed holds itself by value: T16's error, said once
fn (p mut Program&) Layout(t types.TypeId) Bool {
    st := p.T.LayoutState(t)
    if st == types.LaidOut { return true }
    if st == types.NoLayout { return false }
    if st == types.LayingOut {
        p.holdsItself(t)
        return false
    }
    isInstance := p.T.KindOf(t) == types.Kind.Named and p.T.Items(p.T.Args(t)).Len() > 0
    if isInstance and p.chain >= MaxChain {
        p.unbounded(p.T.DeclOf(t))
        p.T.SetLayoutState(t, types.NoLayout)
        return false
    }
    p.T.SetLayoutState(t, types.LayingOut)
    if isInstance { p.chain++ }
    ok := p.Body(t)
    if ok { p.reprReady(t) }
    if ok and p.T.KindOf(t) == types.Kind.Ref { p.reprReady(p.T.Referent(t)) }
    if ok {
        for e in p.T.Embedded(t) {
            if not p.Layout(e) { ok = false }
        }
    }
    if ok { ok = p.T.ComputeLayout(t) }
    if isInstance { p.chain-- }
    if p.T.LayoutState(t) == types.LayingOut { p.T.SetLayoutState(t, types.LaidOut if ok else types.NoLayout) }
    return ok
}

# the bodies a type's representation passes through (T29: a declared type over another) made, so that Repr reaches it
fn (p mut Program&) reprReady(t types.TypeId) {
    r := t
    for k in range 64 {
        if p.T.KindOf(r) != types.Kind.Named or not p.Body(r) { return }
        if p.T.DeclKindOf(p.T.DeclOf(r)) != types.DeclKind.Over { return }
        r = p.T.Base(r)
    }
}

fn (p mut Program&) holdsItself(t types.TypeId) {
    if p.T.KindOf(t) != types.Kind.Named { return }
    d := p.T.DeclOf(t)
    if try p.said.Get(I64(d)) catch default false { return }
    p.said.Put(I64(d), true)
    mi := p.declMi[I64(d)]
    e := p.R.Tables[mi].Entries[p.declEi[I64(d)]]
    p.L.Diags.Error(p.at(mi, e.Sp), msgs.TypeHoldsItself(msgs.Tok(p.T.Canon(t))))
}

# ---- functions ----

# a receiver's key, the methods of one type sharing it (M19, M21): a declared type's, every array's (T29e), a number's,
# a trait's defaults (M19e: a method over a constrained type variable)
fn keyDecl(d types.DeclId) I64 { return (I64(1) << 40) | I64(d) }
ArrayKey I64 = 2 << 40
fn keyPrim(t types.TypeId) I64 { return (I64(3) << 40) | I64(t) }
fn keyTrait(d types.DeclId) I64 { return (I64(4) << 40) | I64(d) }

# every function and method a module declares (D7, M19), its chosen top-level branches' included: registered the first
# time a module's are asked for
fn (p mut Program&) fnsIn(mi I64) {
    if try p.fnsOf.Get(mi) catch default false { return }
    p.fnsOf.Put(mi, true)
    ds := p.L.Mods[mi].Decls
    if ds.Len() > 0 { p.addFns(mi, ds) }
}

fn (p mut Program&) allFns() {
    # asked on every method lookup: once every module's are in, there is nothing to look at until another is loaded
    n := p.L.Mods.Len()
    if p.fnsAll == n { return }
    for mi in range n { p.fnsIn(mi) }
    p.fnsAll = n
}

fn (p mut Program&) addFns(mi I64, ds Array<ast.Decl&>&) {
    for d in ds {
        match d {
            case ast.Decl.Fn(f) { p.addFn(mi, f, false) }
            case ast.Decl.Extern(f) { p.addFn(mi, f, true) }
            case ast.Decl.If(_, ti) { p.addFnsIf(mi, ti, p.L.Chosen(mi, ti.Cond!.Span().Start), 0) }
            nomatch { }
        }
    }
}

fn (p mut Program&) addFnsIf(mi I64, ti ast.TopIf&, chosen I64, index I64) {
    if chosen == index and ti.Then!.Decls.Len() > 0 { p.addFns(mi, ti.Then!.Decls) }
    if ti.ElseIf is not null { p.addFnsIf(mi, ti.ElseIf!, chosen, index + 1) }
    if ti.Else is not null and chosen == index + 1 and ti.Else!.Decls.Len() > 0 { p.addFns(mi, ti.Else!.Decls) }
}

fn (p mut Program&) addFn(mi I64, f ast.Func&, isExtern Bool) {
    i := p.fns.Len()
    p.fns.Push(fnRow(mi, f, isExtern))
    if f.Recv is null {
        key := pair.Pair(mi, I64(f.Name))
        if (try p.fnByName.Get(key) catch default -1) < 0 { p.fnByName.Put(key, i) }
        return
    }
    k := p.recvKey(mi, f.Recv!.Ty, f.TypeParams)
    if k < 0 { return }
    mk := pair.Pair(k, I64(f.Name))
    head := try p.methods.Get(mk) catch default -1
    if head < 0 {
        p.methods.Put(mk, i)
    } else {
        for p.sameKey.Has(head) { head = try p.sameKey.Get(head) catch default -1 }
        p.sameKey.Put(head, i)
    }
    if (k >> 40) == 4 {
        p.defaultFns.Push(i)
        p.defaultTraits.Push(k & ((I64(1) << 40) - 1))
    }
}

# a trait's default method of a name that a type's own methods meet the trait of (M19e), by its methods' names; -1 for
# none. The call's inference checks the rest (G19)
fn (p mut Program&) DefaultMethod(t types.TypeId, name source.NameId) I64 {
    ds := p.DefaultMethods(t, name)
    return ds[0] if ds.Len() > 0 else -1
}

# every default of this name a type's traits declare (M19e): two make a call ambiguous
fn (p mut Program&) DefaultMethods(t types.TypeId, name source.NameId) List<I64> {
    out List<I64>
    p.allFns()
    x := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
    for i in range p.defaultFns.Len() {
        f := p.defaultFns[i]
        if p.fns[f].F.Name != name { continue }
        d := types.DeclId(I32(p.defaultTraits[i]))
        td := p.typeDecl(d)
        if td is null or td.Body is null { continue }
        ok := false
        match td.Body {
            case ast.TypeBody.Trait(methods, _, members) {
                # T31a: a closed trait's defaults reach the types it lists alone
                ok = members.Len() == 0 or p.Member(x, p.SelfType(d))
                for m in methods {
                    if p.MethodOf(x, m.Name) < 0 { ok = false }
                }
            }
            nomatch { }
        }
        if ok { out.Push(f) }
    }
    return out
}

# a written receiver's key: a type variable's by the trait its list item constrains it to (M19e)
fn (p mut Program&) recvKey(mi I64, t ast.TypeRef?&, tps Array<ast.TypeParam&>&) I64 {
    if t is null { return -1 }
    match t {
        case ast.TypeRef.Perm(_, of, _, _) { return p.recvKey(mi, of, tps) }
        case ast.TypeRef.Ref(_, of, _, _) { return p.recvKey(mi, of, tps) }
        case ast.TypeRef.Named(sp, path, _) {
            ref := p.R.Use(p.file(mi), sp.Start)
            if ref.Kind == names.What.TypeVar {
                k := listed(tps, path[0])
                if k is null { return -1 }
                match k {
                    case ast.TypeRef.Named(ksp, _, _) {
                        kref := p.R.Use(p.file(mi), ksp.Start)
                        if kref.Kind == names.What.Type and kref.Index >= 0 {
                            return keyTrait(p.DeclFor(kref.Module, kref.Index))
                        }
                    }
                    nomatch { }
                }
                return -1
            }
            if ref.Kind == names.What.Type and ref.Index >= 0 { return keyDecl(p.DeclFor(ref.Module, ref.Index)) }
            if ref.Kind == names.What.Builtin {
                name := p.text(path[path.Len() - 1])
                if name == "Array" { return ArrayKey }
                if name == "Bool" { return keyPrim(types.BoolT) }
                return keyPrim(p.T.Prim(name))
            }
            return -1
        }
        nomatch { return -1 }
    }
}

# a type's key as a receiver; -1 for none
fn (p mut Program&) typeKey(t types.TypeId) I64 {
    x := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
    return match p.T.KindOf(x) {
        case types.Kind.Named => keyDecl(p.T.DeclOf(x))
        case types.Kind.Array => ArrayKey
        case types.Kind.Bool, types.Kind.I8, types.Kind.I16, types.Kind.I32, types.Kind.I64, types.Kind.U8, types.Kind.U16
             types.Kind.U32, types.Kind.U64, types.Kind.F16, types.Kind.BF16, types.Kind.F32, types.Kind.F64 => keyPrim(x)
        case _ => -1
    }
}

# a type's method of that name (M19): its own, else - where it extends another (T29f) - its base's; -1 for none
fn (p mut Program&) MethodOf(t types.TypeId, name source.NameId) I64 {
    p.allFns()
    x := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
    for k in range 16 {
        key := p.typeKey(x)
        if key < 0 { return -1 }
        m := try p.methods.Get(pair.Pair(key, I64(name))) catch default -1
        if m >= 0 {
            # a method declared for one instance of a generic type (M21: "fn (b Box<String&>&) Describe()") is not
            # another's: of those declared that apply to x, one for x's instance exactly wins, else the one written
            # with variables (G8a's precedence) - two that apply alike are an error at the declaration (MethodOverlap)
            found := -1
            for m >= 0 {
                if p.recvApplies(m, x) {
                    if p.recvExact(m) { return m }
                    if found < 0 { found = m }
                }
                m = try p.sameKey.Get(m) catch default -1
            }
            return found
        }
        if p.T.KindOf(x) != types.Kind.Named or not p.Body(x) { return -1 }
        if p.T.DeclKindOf(p.T.DeclOf(x)) != types.DeclKind.Over or not p.extends(p.T.DeclOf(x)) { return -1 }
        x = p.T.Base(x)
    }
    return -1
}

# a method's receiver, its referent where it is a reference; Unknown for none
fn (p mut Program&) recvOf(f I64) types.TypeId {
    ps := p.T.Items(p.T.Params(p.Sig(f)))
    if ps.Len() == 0 { return types.UnknownT }
    return p.T.Referent(ps[0]) if p.T.KindOf(ps[0]) == types.Kind.Ref else ps[0]
}

# whether method f's receiver is one type, no variable in it (M21): it beats one written with variables
fn (p mut Program&) recvExact(f I64) Bool {
    r := p.recvOf(f)
    return r != types.UnknownT and p.T.Closed(r)
}

# the method declared before f with f's receiver key and name whose receiver some one type meets as f's does, alike
# in precedence (M21): f is then an error - -1 for none. A variable in either receiver matches anything there
fn (p mut Program&) MethodOverlap(f I64) I64 {
    row := p.fns[f]
    if row.F.Recv is null { return -1 }
    k := p.recvKey(row.Mi, row.F.Recv!.Ty, row.F.TypeParams)
    if k < 0 { return -1 }
    g := try p.methods.Get(pair.Pair(k, I64(row.F.Name))) catch default -1
    for g >= 0 and g != f {
        if p.recvExact(g) == p.recvExact(f) and p.typesOverlap(p.recvOf(g), p.recvOf(f), 0) { return g }
        g = try p.sameKey.Get(g) catch default -1
    }
    return -1
}

fn (p mut Program&) typesOverlap(a types.TypeId, b types.TypeId, depth I64) Bool {
    if depth > 32 { return true }
    ka := p.T.KindOf(a)
    kb := p.T.KindOf(b)
    # a type not known was said where it is written: a receiver naming one meets nothing, so it adds no second error
    if a == types.UnknownT or b == types.UnknownT { return false }
    if ka == types.Kind.Var or kb == types.Kind.Var { return true }
    if ka == types.Kind.Named and kb == types.Kind.Named {
        if p.T.DeclOf(a) != p.T.DeclOf(b) { return false }
        xs := p.T.Items(p.T.Args(a))
        ys := p.T.Items(p.T.Args(b))
        if xs.Len() != ys.Len() { return false }
        if xs.Len() == 0 { return p.T.Same(p.T.Plain(a), p.T.Plain(b)) }
        for i in range xs.Len() {
            if not p.typesOverlap(xs[i], ys[i], depth + 1) { return false }
        }
        return true
    }
    if p.T.Closed(a) and p.T.Closed(b) { return p.T.Same(p.T.Plain(a), p.T.Plain(b)) }
    # a compound type with a variable inside: taken to overlap (a declaration so written is refused, never mistaken)
    return true
}

# whether method f's receiver is written for x (M19, M21): its receiver's type arguments x's, or variables binding them
fn (p mut Program&) recvApplies(f I64, x types.TypeId) Bool {
    if p.T.KindOf(x) != types.Kind.Named or p.T.Items(p.T.Args(x)).Len() == 0 { return true }
    ps := p.T.Items(p.T.Params(p.Sig(f)))
    if ps.Len() == 0 { return true }
    r := p.T.Referent(ps[0]) if p.T.KindOf(ps[0]) == types.Kind.Ref else ps[0]
    if p.T.KindOf(r) != types.Kind.Named or p.T.DeclOf(r) != p.T.DeclOf(x) { return true }
    owner := FnOwner(f)
    n := p.VarCount(owner)
    if n == 0 { return p.T.Same(p.T.Plain(r), p.T.Plain(x)) }
    b := Binding(owner, n)
    return p.UnifyArg(r, x, b, false, true)
}

# whether a declared type extends its base (T29f): it takes the base's methods and operators
fn (p mut Program&) Extends(t types.TypeId) Bool {
    return p.T.KindOf(t) == types.Kind.Named and p.Body(t) and p.T.DeclKindOf(p.T.DeclOf(t)) == types.DeclKind.Over and
           p.extends(p.T.DeclOf(t))
}

fn (p mut Program&) extends(d types.DeclId) Bool {
    td := p.typeDecl(d)
    return td is not null and td.Extends
}

# a plain function a module declares, by its name; -1 for none
fn (p mut Program&) FnNamed(mi I64, name source.NameId) I64 {
    p.fnsIn(mi)
    return try p.fnByName.Get(pair.Pair(mi, I64(name))) catch default -1
}

# a function's signature (D7, D8c, R15; M19: a method's receiver its first parameter), over its variables: those its
# receiver's type arguments introduce, in order, then its list's (G3, QW)
fn (p mut Program&) Sig(f I64) types.TypeId {
    s := try p.fnSig.Get(f) catch default types.TypeId(-1)
    if s >= types.TypeId(0) { return s }
    row := p.fns[f]
    owner := FnOwner(f)
    c := Context(row.Mi, owner)
    ns List<source.NameId>
    if row.F.Recv is not null { p.introductions(row.Mi, row.F.Recv!.Ty, ns, false) }
    if row.F.TypeParams.Len() > 0 {
        for tp in row.F.TypeParams {
            if not ns.Has(tp.Name) { ns.Push(tp.Name) }
        }
    }
    written := ns.Len()
    for i in range written { c.Vars.Put(ns[i], p.T.Var(owner, i, types.ReadOnly)) }
    # G1a: the error-set variables - its list's "? E", and one its receiver's error-set argument introduces
    errNames List<source.NameId>
    if row.F.Recv is not null { errIntroductions(row.F.Recv!.Ty, errNames) }
    if row.F.TypeParams.Len() > 0 {
        for tp in row.F.TypeParams {
            if tp.ErrSet { errNames.Push(tp.Name) }
        }
    }
    for i in range written {
        if errNames.Has(ns[i]) { p.errVars.Put(pair.Pair(owner, i), true) }
    }
    # G29, D9a: each array level a parameter holds by value takes its length from the argument - a variable of the
    # function's own, no name the program can write ("a.Len()" in a note), one instance per set of lengths
    levels List<I64>
    # (an extern's array parameters are pointers to the caller's elements, X3: no instances)
    if not p.FnIsExtern(f) and row.F.Recv is not null { p.lengthLevels(p.Resolve(c, row.F.Recv!.Ty), true, row.F.Recv!.Name, 0, ns, levels) }
    for prm in row.F.S.Params {
        if prm.Ty is not null and not p.FnIsExtern(f) { p.lengthLevels(p.Resolve(c, prm.Ty), true, prm.Name, 0, ns, levels) }
    }
    p.addVars(owner, ns.ToArray())
    i64 := p.T.Prim("I64")
    base := try p.varsAt.Get(owner) catch default 0
    for i in range written, ns.Len() {
        p.vars[base + i] = varRow(owner, ns[i], i64, types.UnknownT)
        c.Vars.Put(ns[i], p.T.Var(owner, i, types.ReadOnly))
    }
    if row.F.TypeParams.Len() > 0 {
        for tp in row.F.TypeParams { p.constraint(c, tp) }
    }
    recv := types.UnknownT
    recvName := source.NameId(0)
    if row.F.Recv is not null {
        recv = p.Resolve(c, row.F.Recv!.Ty)
        recvName = row.F.Recv!.Name
    }
    sig := p.sigType(c, row.F.S, recv, recvName)
    # D18: a function whose result is written Iterator<T ? E> and whose body yields is a generator - its result the
    # prelude's Generator<T ? E>, its errors its Next's alone (written on the signature, they are the checker's to say)
    if ast.FirstYield(row.F.Body).Start >= I32(0) {
        g := p.generatorOf(p.T.Result(sig))
        if g != types.UnknownT {
            p.genFns.Put(f, true)
            sig = p.T.Func(p.T.Params(sig), g, types.ListId(0), p.T.ScopesOf(sig))
        }
    }
    if ns.Len() > written {
        ps := p.T.Items(p.T.Params(sig))
        out := Array<types.TypeId>(ps.Len())
        k := written
        for j in range ps.Len() {
            out[j] = p.withLengths(ps[j], true, owner, k)
            k += p.levelCount(ps[j], true)
        }
        sig = p.T.Func(p.T.List(out), p.T.Result(sig), p.T.Errors(sig), p.T.ScopesOf(sig))
    }
    p.fnSig.Put(f, sig)
    return sig
}

# G12: where each variable a function's list introduces that its receiver's type does not name stands among its
# signature's variables (the receiver's introductions first, then the list's, as Sig orders them): the variables
# written type arguments give, in the list's order - every one of a free function's
fn (p mut Program&) OwnVarIndexes(f I64) List<I64> {
    row := p.fns[f]
    ns List<source.NameId>
    if row.F.Recv is not null { p.introductions(row.Mi, row.F.Recv!.Ty, ns, false) }
    out List<I64>
    if row.F.TypeParams.Len() > 0 {
        for tp in row.F.TypeParams {
            if not ns.Has(tp.Name) { ns.Push(tp.Name) }
        }
        for tp in row.F.TypeParams {
            if row.F.Recv is not null and mentionsName(row.F.Recv!.Ty, tp.Name) { continue }
            if tp.ErrSet { continue }   # G1a: an error-set parameter is given after "?", or inferred
            for i, n in ns {
                if n == tp.Name { out.Push(i) }
            }
        }
    }
    return out
}

# whether a written type names n as one of its parts (a bare name, or in type arguments)
fn mentionsName(t ast.TypeRef?&, n source.NameId) Bool {
    if t is null { return false }
    match t {
        case ast.TypeRef.Named(_, path, args) {
            if path.Len() == 1 and path[0] == n { return true }
            for a in args {
                if mentionsName(a, n) { return true }
            }
            return false
        }
        case ast.TypeRef.Ref(_, of, _, _) { return mentionsName(of, n) }
        case ast.TypeRef.Perm(_, of, _, _) { return mentionsName(of, n) }
        case ast.TypeRef.Any(_, of) { return mentionsName(of, n) }
        case ast.TypeRef.Errs(_, items) {
            for e in items {
                if e.Parts.Len() == 1 and e.Parts[0] == n { return true }
            }
            return false
        }
        nomatch { return false }
    }
}

# G29: the array levels a parameter's type holds by value - itself, where it is an Array<T> value, and the elements of
# an array held in place (an Array<Array<T>>, under a reference too) - each a variable named for its parameter's
# length ("a.Len()") or its elements' ("a[0].Len()"), pushed to ns
fn (p mut Program&) lengthLevels(t types.TypeId, byValue Bool, n source.NameId, depth I64, ns mut List<source.NameId>&, out mut List<I64>&) {
    if depth > 8 { return }
    match p.T.KindOf(t) {
        case types.Kind.Ref { p.lengthLevels(p.T.Referent(t), false, n, depth, ns, out) }
        case types.Kind.Array {
            if byValue and p.T.Length(t) == types.TypeId(0) {
                b := StringBuilder()
                b.Push(p.text(n))
                for k in range depth { b.Push("[0]") }
                b.Push(".Len()")
                ns.Push(p.L.Names.Intern(b.ToString()))
                out.Push(depth)
            }
            p.lengthLevels(p.T.Elem(t), true, n, depth + 1, ns, out)
        }
        nomatch { }
    }
}

fn (p mut Program&) levelCount(t types.TypeId, byValue Bool) I64 {
    return match p.T.KindOf(t) {
        case types.Kind.Ref => p.levelCount(p.T.Referent(t), false)
        case types.Kind.Array => (1 if byValue and p.T.Length(t) == types.TypeId(0) else 0) + p.levelCount(p.T.Elem(t), true)
        case _ => 0
    }
}

# t with its by-value array levels' lengths the function's variables from k on, in lengthLevels' order
fn (p mut Program&) withLengths(t types.TypeId, byValue Bool, owner I64, k I64) types.TypeId {
    match p.T.KindOf(t) {
        case types.Kind.Ref { return p.T.Ref(p.withLengths(p.T.Referent(t), false, owner, k), p.T.PermOf(t)) }
        case types.Kind.Array {
            here := byValue and p.T.Length(t) == types.TypeId(0)
            el := p.withLengths(p.T.Elem(t), true, owner, k + (1 if here else 0))
            return p.T.Array(el, p.T.Var(owner, k, types.ReadOnly) if here else p.T.Length(t))
        }
        nomatch { return t }
    }
}

# the variables a receiver's type arguments introduce (QW: "fn (l List<T>&) Push(x T)"), in order, each once - the
# names there that resolve to a type variable
fn (p mut Program&) introductions(mi I64, t ast.TypeRef?&, ns mut List<source.NameId>&, inArgs Bool) {
    if t is null { return }
    match t {
        case ast.TypeRef.Named(sp, path, args) {
            if inArgs and path.Len() == 1 and args.Len() == 0 {
                if p.R.Use(p.file(mi), sp.Start).Kind == names.What.TypeVar and not ns.Has(path[0]) { ns.Push(path[0]) }
                return
            }
            for a in args { p.introductions(mi, a, ns, true) }
        }
        case ast.TypeRef.Ref(_, of, _, _) { p.introductions(mi, of, ns, inArgs) }
        case ast.TypeRef.Perm(_, of, _, _) { p.introductions(mi, of, ns, inArgs) }
        case ast.TypeRef.Any(_, of) { p.introductions(mi, of, ns, inArgs) }
        # QAH: "? E" among a receiver's arguments introduces its error-set variable
        case ast.TypeRef.Errs(_, items) {
            for e in items {
                if e.Parts.Len() == 1 and p.R.Use(p.file(mi), e.Sp.Start).Kind == names.What.TypeVar and not ns.Has(e.Parts[0]) {
                    ns.Push(e.Parts[0])
                }
            }
        }
        nomatch { }
    }
}

# the names an error-set argument introduces among a receiver's arguments (QAH), at any depth
fn errIntroductions(t ast.TypeRef?&, out mut List<source.NameId>&) {
    if t is null { return }
    match t {
        case ast.TypeRef.Named(_, _, args) {
            for a in args { errIntroductions(a, out) }
        }
        case ast.TypeRef.Ref(_, of, _, _) { errIntroductions(of, out) }
        case ast.TypeRef.Perm(_, of, _, _) { errIntroductions(of, out) }
        case ast.TypeRef.Errs(_, items) {
            for e in items {
                if e.Parts.Len() == 1 { out.Push(e.Parts[0]) }
            }
        }
        nomatch { }
    }
}

# a list item's type, read once every variable is known (a constraint may name a later one): its variable's
# constraint (G19) - one that names no trait is the checker's G6 error
fn (p mut Program&) constraint(c Context&, tp ast.TypeParam&) {
    if tp.Ty is null { return }
    v := try c.Vars.Get(tp.Name) catch default types.UnknownT
    if p.T.KindOf(v) != types.Kind.Var { return }
    i := (try p.varsAt.Get(c.Owner) catch default 0) + p.T.B(v)
    row := p.vars[i]
    if row.Const != types.UnknownT or row.Bound != types.UnknownT { return }
    p.vars[i] = varRow(c.Owner, tp.Name, types.UnknownT, p.BoundOf(c, tp))
}

# a type parameter's constraint (G19): its trait, or for several written side by side their intersection - held as a
# Tuple of the traits, each of which a binding must satisfy
fn (p mut Program&) BoundOf(c Context&, tp ast.TypeParam&) types.TypeId {
    if tp.Also.Len() == 0 { return p.Resolve(c, tp.Ty) }
    ts List<types.TypeId>
    ts.Push(p.Resolve(c, tp.Ty))
    for a in tp.Also { ts.Push(p.Resolve(c, a)) }
    return p.T.Tuple(p.T.List(ts.ToArray()))
}

# the traits a constraint names: its one trait, or each of an intersection's (G19)
fn (p mut Program&) BoundTraits(b types.TypeId) Array<types.TypeId> {
    if p.T.KindOf(b) == types.Kind.Tuple { return p.T.Items(p.T.Parts(b)) }
    return types.TypeId[b]
}

# the constraint a type-parameter list gives a name, or null
fn listed(tps Array<ast.TypeParam&>&, n source.NameId) ast.TypeRef?&tps {
    if tps.Len() == 0 { return null }
    for tp in tps {
        if tp.Name == n { return tp.Ty }
    }
    return null
}

# a method's signature for a receiver of type t: its receiver's variables bound by unifying the two (G9b), then
# substituted; the stand-in where t is no receiver it takes
fn (p mut Program&) MethodSig(f I64, t types.TypeId) types.TypeId {
    sig := p.Sig(f)
    owner := FnOwner(f)
    n := p.VarCount(owner)
    if n == 0 { return sig }
    b := Binding(owner, n)
    ps := p.T.Items(p.T.Params(sig))
    if ps.Len() == 0 or not p.UnifyArg(ps[0], t, b, false, true) { return types.UnknownT }
    return p.Subst(sig, owner, p.T.List(b.Vals))
}

# a function's instance (G16): its signature with its variables bound, and its name - its module, its receiver's type
# for a method (M21), its name and its arguments' canonical texts, made a symbol (G16a: injective, since every
# canonical text is)
# a function instance's arguments as its identity holds them (G16a): plain, but a function type with where its
# references live (T22) - keep(link) and keep(copy) are two instances, as their callers' calls pass two ABIs
fn (p mut Program&) instanceArgs(written types.ListId) types.ListId {
    xs := p.T.Items(written)
    out := Array<types.TypeId>(xs.Len())
    key := Array<types.TypeId>(xs.Len())
    changed := false
    named := false
    for i in range xs.Len() {
        out[i] = xs[i] if p.T.KindOf(xs[i]) == types.Kind.Func else p.T.Plain(xs[i])
        key[i] = p.T.Unnamed(out[i])
        if out[i] != xs[i] { changed = true }
        if key[i] != out[i] { named = true }
    }
    args := p.T.List(out) if changed else written
    if not named { return args }
    # a function type argument's parameter names tell no instance apart: the first instance asked for keeps its own,
    # which "$" renders (E11a, as stage 0)
    k := p.T.List(key)
    rep := try p.argReps.Get(k) catch default types.ListId(-1)
    if rep >= types.ListId(0) { return rep }
    p.argReps.Put(k, args)
    return args
}

fn (p mut Program&) FnInstance(f I64, written types.ListId) I64 {
    args := p.instanceArgs(written)
    key := pair.Pair(f, args)
    i := try p.instanceOf.Get(key) catch default -1
    if i >= 0 { return i }
    owner := FnOwner(f)
    sig := p.Subst(p.Sig(f), owner, args)
    row := p.fns[f]
    b := StringBuilder()
    b.Push(p.L.Mods[row.Mi].Identity)
    b.PushChar('.')
    if row.F.Recv is not null {
        r := p.T.Items(p.T.Params(sig))[0]
        b.Push(p.T.Canon(p.T.Referent(r) if p.T.KindOf(r) == types.Kind.Ref else r))
        b.PushChar('.')
    }
    b.Push(p.text(row.F.Name))
    xs := p.T.Items(args)
    if xs.Len() > 0 {
        b.PushChar('<')
        for k in range xs.Len() {
            if k > 0 { b.Push(", ") }
            b.Push(p.T.Canon(xs[k]))
        }
        b.PushChar('>')
    }
    i = p.instances.Len()
    p.instances.Push(instance(f, args, sig, types.Symbol(b.ToString()), p.Asking))
    p.instanceOf.Put(key, i)
    return i
}

fn (p Program&) InstanceSig(i I64) types.TypeId { return p.instances[i].Sig }
fn (p Program&) InstanceFn(i I64) I64 { return p.instances[i].Fn }
fn (p Program&) InstanceArgs(i I64) types.ListId { return p.instances[i].Args }
fn (p Program&) InstanceCount() I64 { return p.instances.Len() }

# ---- what the checker reads of declarations (M5b) ----

# every function and method of every module, registered (allFns): how many, and each one's module, declaration and
# whether it is an extern
fn (p mut Program&) AllFns() { p.allFns() }
fn (p Program&) FnCount() I64 { return p.fns.Len() }
fn (p Program&) FnModule(f I64) I64 { return p.fns[f].Mi }
fn (p Program&) FnDecl(f I64) ast.Func&p { return p.fns[f].F }
fn (p Program&) FnIsExtern(f I64) Bool { return p.fns[f].Extern }
# a declared type's declaration (null for an error type), and its context: its module and its variables by name
fn (p Program&) TypeDecl(d types.DeclId) ast.TypeDecl?&p { return p.typeDecl(d) }
fn (p mut Program&) DeclContext(d types.DeclId) Context { return p.declContext(d) }
# a function's context, its variables bound to args (an instance's) - or to themselves where args is the empty list
fn (p mut Program&) FnContext(f I64, args types.ListId) Context {
    owner := FnOwner(f)
    p.Sig(f)
    c := Context(p.fns[f].Mi, owner)
    xs := p.T.Items(args)
    for i in range p.VarCount(owner) {
        c.Vars.Put(p.VarAt(owner, i).Name, xs[i] if i < xs.Len() else p.T.Var(owner, i, types.ReadOnly))
    }
    return c
}
# a declared type's context with its variables bound to an instance's arguments
fn (p mut Program&) InstanceContext(t types.TypeId) Context {
    d := p.T.DeclOf(t)
    c := p.declContext(d)
    td := p.typeDecl(d)
    xs := p.T.Items(p.T.Args(t))
    if td is not null and td.Params.Len() > 0 {
        for i in range td.Params.Len() {
            if i < xs.Len() { c.Vars.Put(td.Params[i].Name, xs[i]) }
        }
    }
    return c
}
# a module's method key of a type, and a method by key: M19's table, for the checker's own lookups
fn (p mut Program&) TypeKey(t types.TypeId) I64 { return p.typeKey(t) }
fn (p mut Program&) MethodByKey(key I64, name source.NameId) I64 {
    p.allFns()
    return try p.methods.Get(pair.Pair(key, I64(name))) catch default -1
}
fn TraitKey(d types.DeclId) I64 { return keyTrait(d) }
# a declared type of a std module by its name, Unknown for none (String, Char, CheckError, Exhausted ...)
fn (p mut Program&) PreludeType(identity String&, name String&) types.TypeId { return p.preludeType(identity, name) }

# a function of the prelude module of this identity, by name; -1 for none (T17e's caseIndex)
fn (p mut Program&) PreludeFn(identity String&, name String&) I64 {
    p.ensureModules()
    mi := try p.identity.Get(identity) catch { return -1 }
    return p.FnNamed(mi, p.L.Names.Intern(name))
}
# a struct's constructor's signature (C2, G10b), or a declared number's (T29d): its parameters as written, its type the
# result - a destructor-declaring struct's by reference (C11) - and its errors, with RoleCtor's scopes (C2d); Unknown for
# a type with no constructor
fn (p mut Program&) CtorSig(t types.TypeId) types.TypeId { return p.CtorSigAt(t, types.ListId(0)) }

# the variables a struct's constructor lists after "struct" (G10d, QW: "struct<T>(g Graph<T>&)") - none for a generic
# type's, which may have no list - registered under CtorOwner with their constraints: how many
fn (p mut Program&) CtorVars(d types.DeclId) I64 {
    owner := CtorOwner(d)
    if (try p.varsAt.Get(owner) catch default -1) >= 0 { return p.VarCount(owner) }
    ns List<source.NameId>
    td := p.typeDecl(d)
    tps Array<ast.TypeParam&>&td = Array<ast.TypeParam&>(0)
    if td is not null and td.Body is not null and (td.Params.Len() == 0) {
        match td.Body {
            case ast.TypeBody.Struct(s) { tps = s.TypeParams }
            nomatch { }
        }
    }
    if tps.Len() > 0 {
        for tp in tps {
            if not ns.Has(tp.Name) { ns.Push(tp.Name) }
        }
    }
    p.addVars(owner, ns.ToArray())
    if tps.Len() > 0 {
        c := Context(p.declMi[I64(d)], owner)
        for i in range ns.Len() { c.Vars.Put(ns[i], p.T.Var(owner, i, types.ReadOnly)) }
        for tp in tps { p.constraint(c, tp) }
    }
    return ns.Len()
}

# a struct's context with its constructor's own variables bound (G10d): to args, a twin's binding, or where args is
# empty to themselves
fn (p mut Program&) CtorContext(t types.TypeId, args types.ListId) Context {
    c := p.InstanceContext(t)
    d := p.T.DeclOf(t)
    owner := CtorOwner(d)
    xs := p.T.Items(args)
    for i in range p.CtorVars(d) {
        c.Vars.Put(p.VarAt(owner, i).Name, xs[i] if i < xs.Len() else p.T.Var(owner, i, types.ReadOnly))
    }
    return c
}

# a constructor's signature with its own variables bound to args (G10d; CtorSig's for none)
fn (p mut Program&) CtorSigAt(t types.TypeId, args types.ListId) types.TypeId {
    if p.T.KindOf(t) != types.Kind.Named { return types.UnknownT }
    td := p.typeDecl(p.T.DeclOf(t))
    if td is null or td.Body is null { return types.UnknownT }
    c := p.CtorContext(t, args)
    match td.Body {
        case ast.TypeBody.Struct(s) { return p.paramsSig(c, s.Params, s.Errs, p.held(t)) }
        case ast.TypeBody.Over(_, ctor) {
            if ctor is null { return types.UnknownT }
            return p.paramsSig(c, ctor.S.Params, ctor.S, t)
        }
        nomatch { return types.UnknownT }
    }
}

# an enum case's payload as a constructor (T17c): its fields the parameters, the enum the result
fn (p mut Program&) CaseSig(t types.TypeId, tag I64) types.TypeId {
    if p.T.KindOf(t) != types.Kind.Named { return types.UnknownT }
    td := p.typeDecl(p.T.DeclOf(t))
    if td is null or td.Body is null { return types.UnknownT }
    match td.Body {
        case ast.TypeBody.Enum(cases, _) {
            if tag < 0 or tag >= cases.Len() { return types.UnknownT }
            ps := cases[tag].Payload
            if ps.Len() == 0 { return p.T.Func(types.ListId(0), t, types.ListId(0)) }
            return p.paramsSig(p.InstanceContext(t), ps, null, t)
        }
        nomatch { return types.UnknownT }
    }
}

fn (p mut Program&) paramsSig(c Context&, params Array<ast.Param&>&, errs ast.Sig?&, result types.TypeId) types.TypeId {
    ps List<types.TypeId>
    named List<source.NameId>
    shares List<I64>
    if params.Len() > 0 {
        for prm in params {
            ps.Push(p.Resolve(c, prm.Ty))
            shares.Push(p.markedParam(c, prm.Ty!, named, shares))
            named.Push(prm.Name)
        }
    }
    scopes := p.T.Scopes(types.RoleCtor, shares.ToArray(), I64[types.OwnScope])
    el := p.contractErrors(errs, p.errorList(c, errs.HasErrors, errs.Errors)) if errs is not null else types.ListId(0)
    return p.T.Func(p.T.List(ps.ToArray()), result, el, scopes)
}

# a written type's error set item, read in a context: an error type (R1), Unknown for none
fn (p mut Program&) ErrorType(c Context&, e ast.Path&) types.TypeId { return p.errorType(c, e) }
# a global's declaration in a module, outside every top-level if; null for none
fn (p mut Program&) GlobalDecl(mi I64, n source.NameId) ast.VarDecl?&p { return p.anyGlobal(mi, n) }
# whether one number type flows into another, and where two meet (T6b): Unknown where they do not
fn (p mut Program&) Meet(a types.TypeId, b types.TypeId) types.TypeId { return p.meetTyped(a, b) }
# a constructor's value as ":=" holds it (C11)
fn (p mut Program&) Held(t types.TypeId) types.TypeId { return p.held(t) }
# a function a module declares by name, through FnNamed, as the checker sees the prelude's (print, ...)
fn (p mut Program&) ModuleIndex(identity String&) I64 {
    p.ensureModules()
    return try p.identity.Get(identity) catch default -1
}
fn (p Program&) InstanceName(i I64) String&p { return p.instances[i].Name }
fn (p Program&) InstanceOrigin(i I64) Origin { return p.instances[i].From }

# the scope variables a call of a function of this type passes (types.ScopeVarsOf), the bodies of the declared types
# its parameters and results hold resolved first, since whether a value holds a reference is read off its fields (O4b)
fn (p mut Program&) ScopeVarsOf(f types.TypeId) Array<I64> {
    for x in p.T.Items(p.T.Params(f)) { p.bodiesOf(x) }
    for x in p.T.Results(f) { p.bodiesOf(x) }
    return p.T.ScopeVarsOf(f)
}

# resolves the bodies of the declared types a value of t holds in place, as far as a reference (which holds one
# whatever it names)
fn (p mut Program&) bodiesOf(t types.TypeId) {
    if p.walkedBodies.Has(t) { return }
    p.walkedBodies.Put(t, true)
    match p.T.KindOf(t) {
        case types.Kind.Named {
            if not p.Body(t) { return }
            for x in p.T.Items(p.T.Fields(t)) { p.bodiesOf(x) }
            for x in p.T.Items(p.T.Cases(t)) {
                if x != types.TypeId(0) { p.bodiesOf(x) }
            }
            if p.T.DeclKindOf(p.T.DeclOf(t)) == types.DeclKind.Over { p.bodiesOf(p.T.Base(t)) }
        }
        case types.Kind.Array { p.bodiesOf(p.T.Elem(t)) }
        case types.Kind.Tuple, types.Kind.Record {
            for x in p.T.Items(p.T.Parts(t)) { p.bodiesOf(x) }
        }
        case types.Kind.AnonEnum {
            for x in p.T.Items(p.T.ShapeCases(t)) {
                if x != types.TypeId(0) { p.bodiesOf(x) }
            }
        }
        nomatch { }
    }
}

# ---- inference ----

# an argument's type matched against a parameter's (G9): the reference shape may differ at the top (E12c: a value
# borrowed for a reference parameter, a reference's value copied out for a value one); literal says the argument is a
# literal (G9a), receiver that it is the receiver (G9b)
fn (p mut Program&) UnifyArg(pat types.TypeId, actual types.TypeId, b mut Binding&, literal Bool, receiver Bool) Bool {
    pr := p.T.KindOf(pat) == types.Kind.Ref
    ar := p.T.KindOf(actual) == types.Kind.Ref
    if pr and not ar and not p.isVar(pat, b) { return p.Unify(p.T.Referent(pat), actual, b, literal, receiver) }
    if ar and not pr and p.T.KindOf(pat) != types.Kind.Var { return p.Unify(pat, p.T.Referent(actual), b, literal, receiver) }
    return p.Unify(pat, actual, b, literal, receiver)
}

fn (p Program&) isVar(t types.TypeId, b Binding&) Bool { return p.T.KindOf(t) == types.Kind.Var and p.T.A(t) == b.Owner }

# binds b's variables in a pattern so that it matches a type, structurally: whether it does
fn (p mut Program&) Unify(pat types.TypeId, actual types.TypeId, b mut Binding&, literal Bool, receiver Bool) Bool {
    if pat == actual or actual == types.UnknownT { return true }
    pk := p.T.KindOf(pat)
    if pk == types.Kind.Var and p.T.A(pat) == b.Owner { return p.bind(b, p.T.B(pat), actual, literal, receiver) }
    if pk == types.Kind.ConstExpr { return true }   # computed once its variables are bound, never solved for (T7c)
    ak := p.T.KindOf(actual)
    # a declared type over an array or a number meets a pattern of its base (T29a: it flows into it), so a method of
    # every array binds its element through a String receiver (T29e)
    if ak == types.Kind.Named and (pk != ak or p.T.DeclOf(pat) != p.T.DeclOf(actual)) and p.Body(actual) and
       p.T.DeclKindOf(p.T.DeclOf(actual)) == types.DeclKind.Over {
        return p.Unify(pat, p.T.Base(actual), b, literal, receiver)
    }
    if pk != ak { return false }
    match pk {
        case types.Kind.Named {
            return p.T.DeclOf(pat) == p.T.DeclOf(actual) and p.unifyLists(p.T.Args(pat), p.T.Args(actual), b, receiver)
        }
        case types.Kind.Array {
            if not p.Unify(p.T.Elem(pat), p.T.Elem(actual), b, false, receiver) { return false }
            return p.Unify(p.T.Length(pat), p.T.Length(actual), b, false, receiver)
        }
        case types.Kind.Ref { return p.Unify(p.T.Referent(pat), p.T.Referent(actual), b, false, receiver) }
        case types.Kind.Func {
            if not p.unifyLists(p.T.Params(pat), p.T.Params(actual), b) { return false }
            if not p.Unify(p.T.Result(pat), p.T.Result(actual), b, false, false) { return false }
            return p.unifyErrs(p.T.Errors(pat), p.T.Errors(actual), b)
        }
        case types.Kind.ErrSet { return p.unifyErrs(p.T.ErrSetItems(pat), p.T.ErrSetItems(actual), b) }
        case types.Kind.Tuple, types.Kind.Record { return p.unifyLists(p.T.Parts(pat), p.T.Parts(actual), b) }
        case types.Kind.AnonEnum {
            return p.T.ShapeNames(pat) == p.T.ShapeNames(actual) and p.unifyLists(p.T.ShapeCases(pat), p.T.ShapeCases(actual), b)
        }
        # T32: an any's trait's arguments ("any Iterator<T>&" meeting "any Iterator<I64>&")
        case types.Kind.Any { return p.Unify(p.T.AnyTrait(pat), p.T.AnyTrait(actual), b, false, receiver) }
        nomatch { return false }
    }
}

fn (p mut Program&) unifyLists(a types.ListId, c types.ListId, b mut Binding&, receiver Bool = false) Bool {
    xs := p.T.Items(a)
    ys := p.T.Items(c)
    if xs.Len() != ys.Len() { return false }
    for i in range xs.Len() {
        if not p.Unify(xs[i], ys[i], b, false, receiver) { return false }
    }
    return true
}

# a variable meeting a type (G9a-G9d): unbound, it takes it - a destructor-declaring type's value as its reference
# (G9d: C11 leaves no other form); bound, a literal adapts and binds nothing while another argument can (G9a), a
# number widens to a wider one of its family unless a receiver bound it (G9b), two references differing only in
# permission meet at read-only (G9d)
fn (p mut Program&) bind(b mut Binding&, i I64, actual types.TypeId, literal Bool, receiver Bool) Bool {
    # G1a: an error-set variable takes the union of what binds it - a set never conflicts with another
    if p.T.KindOf(actual) == types.Kind.ErrSet {
        cur := b.Vals[i]
        b.Vals[i] = actual if cur == types.UnknownT or p.T.KindOf(cur) != types.Kind.ErrSet else p.ErrSetUnion(cur, actual)
        return true
    }
    # a function type argument keeps where its references live (G16a, T22): fn(a mut N&, b N&a) is another argument
    # than fn(mut N&, N&); what holds one by its parts' identity (a declared type's arguments) is held plain
    v := actual if p.T.KindOf(actual) == types.Kind.Func else p.T.Plain(actual)
    if p.T.KindOf(v) == types.Kind.Named and p.Body(v) and p.T.DeclKindOf(p.T.DeclOf(v)) == types.DeclKind.Struct and
       p.T.Destructs(v) {
        v = p.T.Ref(v, types.Writable)
    }
    cur := b.Vals[i]
    if cur == types.UnknownT or (b.LiteralOnly[i] and not literal) {
        b.Vals[i] = v
        b.LiteralOnly[i] = literal
        b.Fixed[i] = receiver
        return true
    }
    if cur == v or p.T.Same(cur, v) { return true }
    if literal {
        # G9a: a variable only literals reach takes the widest of their types
        if b.LiteralOnly[i] and (p.Flows(cur, v) or (p.T.IsInt(cur) and p.T.IsFloat(v))) { b.Vals[i] = v }
        return true
    }
    # a reference to what the variable holds by value: its value is read out (E12)
    if p.T.KindOf(v) == types.Kind.Ref and p.T.KindOf(cur) != types.Kind.Ref and p.T.Plain(p.T.Referent(v)) == cur { return true }
    # G9a: arrays of one element type meet at the array whose length is known only at run time where their lengths
    # differ, or one is not known while compiling (T6b's meeting, for lengths) - a reference's elements read out (E12)
    va := p.T.Plain(p.T.Referent(v)) if p.T.KindOf(v) == types.Kind.Ref else v
    if p.T.KindOf(cur) == types.Kind.Array and p.T.KindOf(va) == types.Kind.Array and p.T.Same(p.T.Elem(cur), p.T.Elem(va)) and not b.Fixed[i] {
        if p.T.Length(cur) != types.TypeId(0) and p.T.Length(va) != p.T.Length(cur) { b.Vals[i] = p.T.Array(p.T.Elem(cur), types.TypeId(0)) }
        return true
    }
    if p.T.IsNumber(p.numberOf(cur)) and p.T.IsNumber(p.numberOf(v)) {
        if p.Flows(v, cur) { return true }
        if p.Flows(cur, v) and not b.Fixed[i] {
            b.Vals[i] = v
            return true
        }
        return false
    }
    if p.T.KindOf(cur) == types.Kind.Ref and p.T.KindOf(v) == types.Kind.Ref and p.T.Referent(cur) == p.T.Referent(v) {
        # writable where both are, nullable where either is (T2c)
        pc, pv := p.T.PermOf(cur), p.T.PermOf(v)
        if not b.Fixed[i] { b.Vals[i] = p.T.Ref(p.T.Referent(v), (pc & pv & (types.Writable | types.Owning)) | ((pc | pv) & types.Nullable)) }
        return true
    }
    return false
}

# G9c: a variable named only in a constraint inferred through it - the bound type's methods matched against the
# trait's, so I bound to ListIter<I64> binds T in Iterator<T> through its Next. Repeated while it binds anything
fn (p mut Program&) InferThroughBounds(b mut Binding&) {
    for round in range b.N {
        any := false
        for i in range b.N {
            row := p.VarAt(b.Owner, i)
            if row.Bound == types.UnknownT or b.Vals[i] == types.UnknownT { continue }
            if p.unifyBound(b.Vals[i], row.Bound, b) { any = true }
        }
        if not any { break }
    }
}

fn (p mut Program&) unifyBound(t types.TypeId, tr types.TypeId, b mut Binding&, depth I64 = 0) Bool {
    if depth > 32 { return false }
    if p.T.KindOf(tr) == types.Kind.Tuple {
        any := false
        for x in p.T.Items(p.T.Parts(tr)) {
            if p.unifyBound(t, x, b, depth + 1) { any = true }
        }
        return any
    }
    if p.T.KindOf(tr) != types.Kind.Named { return false }
    d := p.T.DeclOf(tr)
    # T32c: an "any" binds what its trait's arguments give, where it answers to the constraint's trait
    ax := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
    if p.T.KindOf(ax) == types.Kind.Any {
        moved := false
        for e in p.AnyCovers(p.T.AnyTrait(ax)) {
            if p.T.DeclOf(e) != d { continue }
            was := Array<types.TypeId>(b.N)
            for i in range b.N { was[i] = b.Vals[i] }
            p.unifyLists(p.T.Args(tr), p.T.Args(e), b)
            for i in range b.N {
                if was[i] != b.Vals[i] { moved = true }
            }
        }
        return moved
    }
    td := p.typeDecl(d)
    if td is null or td.Body is null { return false }
    before := Array<types.TypeId>(b.N)
    for i in range b.N { before[i] = b.Vals[i] }
    match td.Body {
        case ast.TypeBody.Trait(methods, exts, _) {
            # T30a: what the traits it extends bind, too
            for e in exts {
                if p.unifyBound(t, p.Subst(p.Resolve(p.declContext(d), e), DeclOwner(d), p.T.Args(tr)), b, depth + 1) { }
            }
            for m in methods {
                f := p.MethodOf(t, m.Name)
                if f < 0 { continue }
                have := p.MethodSig(f, t)
                if have == types.UnknownT { continue }
                want := p.Subst(p.sigType(p.declContext(d), m.S, types.UnknownT, source.NameId(0)), DeclOwner(d), p.T.Args(tr))
                hs := p.T.Items(p.T.Params(have))
                ws := p.T.Items(p.T.Params(want))
                if hs.Len() != ws.Len() + 1 { continue }
                for k in range ws.Len() { p.UnifyArg(ws[k], hs[k + 1], b, false, false) }
                p.UnifyArg(p.T.Result(want), p.T.Result(have), b, false, false)
                # QAH: "Next() T ? E, Exhausted" binds E to what the type's Next fails with beyond Exhausted
                if p.errsHaveVar(p.T.Errors(want), b) { p.unifyErrs(p.T.Errors(want), p.T.Errors(have), b) }
            }
        }
        nomatch { }
    }
    for i in range b.N {
        if before[i] != b.Vals[i] { return true }
    }
    return false
}

# ---- constraints (G19) ----

# whether a type satisfies a trait instance: for each of the trait's methods, a method of the type's own (M19) of that
# name whose signature, its receiver bound to the type, matches the trait's with the trait's variables bound -
# parameter by parameter up to reference shape (a constrained call is a direct call, where E12 borrows), permission
# agreeing (T31), the result and the errors in order (T22); a method the compiler supplies counts as declared (E10b's
# Hash, E23's Len)
fn (p mut Program&) Satisfies(t types.TypeId, tr types.TypeId) Bool { return p.Missing(t, tr).Var < 0 }

# why a binding fails a constraint (G19): Var the variable's index (-1 for none failing), Trait the trait instance it
# fails, Method the first of its methods not met where Named, and Sealed where that method is private and so cannot be
# supplied by the bound type (T31)
type Unmet struct(Var I64, Trait types.TypeId, Method source.NameId, Named Bool, Sealed Bool, Closed Bool = false) {
    Var
    Trait
    Method
    Named
    Sealed
    Closed     # the trait is closed (T31a) and the type is none of those it lists
}

fn met() Unmet { return Unmet(-1, types.UnknownT, source.NameId(0), false, false) }

# the first of a trait's methods a type does not meet (Var 0), or Var -1 where it satisfies the trait
fn (p mut Program&) Missing(t types.TypeId, tr types.TypeId, membership Bool = true, depth I64 = 0) Unmet {
    if depth > 32 { return met() }    # a trait extending itself, said at its declaration (T30a)
    # G19: an intersection is met where each of its traits is
    if p.T.KindOf(tr) == types.Kind.Tuple {
        for x in p.T.Items(p.T.Parts(tr)) {
            u := p.Missing(t, x, membership, depth + 1)
            if u.Var >= 0 { return u }
        }
        return met()
    }
    if p.T.KindOf(tr) != types.Kind.Named { return Unmet(0, tr, source.NameId(0), false, false) }
    # T32c: an "any" satisfies its trait and what that extends, and nothing else
    ax := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
    if p.T.KindOf(ax) == types.Kind.Any {
        for e in p.AnyCovers(p.T.AnyTrait(ax)) {
            if p.T.Same(e, tr) { return met() }
        }
        return Unmet(0, tr, source.NameId(0), false, false)
    }
    d := p.T.DeclOf(tr)
    td := p.typeDecl(d)
    if td is null or td.Body is null { return Unmet(0, tr, source.NameId(0), false, false) }
    match td.Body {
        case ast.TypeBody.Trait(methods, exts, members) {
            # T31a: a closed trait is met by the types it lists, and by no other
            if membership and members.Len() > 0 and not p.Member(t, tr) { return Unmet(0, tr, source.NameId(0), false, false, true) }
            # T30a: what it extends is met too
            for e in exts {
                et := p.Subst(p.Resolve(p.declContext(d), e), DeclOwner(d), p.T.Args(tr))
                if p.T.KindOf(et) != types.Kind.Named or et == tr { continue }
                u := p.Missing(t, et, membership, depth + 1)
                if u.Var >= 0 { return u }
            }
            for m in methods {
                if p.meets(t, d, p.T.Args(tr), m) { continue }
                priv := not load.Public(p.text(m.Name))
                x := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
                foreign := p.T.KindOf(x) != types.Kind.Named or p.DeclModule(p.T.DeclOf(x)) != p.DeclModule(d)
                return Unmet(0, tr, m.Name, true, priv and foreign)
            }
            return met()
        }
        nomatch { return Unmet(0, tr, source.NameId(0), false, false) }
    }
}

# the types a closed trait lists (T31a), a closed trait among them taken in with its own - in order, each once; none for
# an open trait
fn (p mut Program&) Members(tr types.TypeId) Array<types.TypeId> {
    out List<types.TypeId>
    p.members(tr, out, 0)
    return out.ToArray()
}

fn (p mut Program&) members(tr types.TypeId, out mut List<types.TypeId>&, depth I64) {
    if depth > 32 or p.T.KindOf(tr) != types.Kind.Named { return }
    d := p.T.DeclOf(tr)
    td := p.typeDecl(d)
    if td is null or td.Body is null { return }
    match td.Body {
        case ast.TypeBody.Trait(_, _, ms) {
            c := p.declContext(d)
            for m in ms {
                t := p.Subst(p.Resolve(c, m), DeclOwner(d), p.T.Args(tr))
                if p.IsClosedTrait(t) {
                    p.members(t, out, depth + 1)
                } else if not out.Has(t) {
                    out.Push(t)
                }
            }
        }
        nomatch { }
    }
}

# the traits a trait extends (T30a), as written - its arguments substituted
fn (p mut Program&) Extended(tr types.TypeId) Array<types.TypeId> {
    out List<types.TypeId>
    if p.T.KindOf(tr) != types.Kind.Named { return out.ToArray() }
    d := p.T.DeclOf(tr)
    td := p.typeDecl(d)
    if td is null or td.Body is null { return out.ToArray() }
    match td.Body {
        case ast.TypeBody.Trait(_, exts, _) {
            c := p.declContext(d)
            for e in exts { out.Push(p.Subst(p.Resolve(c, e), DeclOwner(d), p.T.Args(tr))) }
        }
        nomatch { }
    }
    return out.ToArray()
}

# whether t is a trait listing the types that satisfy it (T31a)
fn (p mut Program&) IsClosedTrait(t types.TypeId) Bool {
    if p.T.KindOf(t) != types.Kind.Named { return false }
    td := p.typeDecl(p.T.DeclOf(t))
    if td is null or td.Body is null { return false }
    match td.Body {
        case ast.TypeBody.Trait(_, _, ms) { return ms.Len() > 0 }
        nomatch { return false }
    }
}

# whether t is one of the types a closed trait lists (T31a): the very type - a type declared over one, or extending
# it, is another type
fn (p mut Program&) Member(t types.TypeId, tr types.TypeId) Bool {
    for m in p.Members(tr) {
        if p.T.Same(t, m) { return true }
    }
    return false
}

fn (p mut Program&) meets(t types.TypeId, d types.DeclId, args types.ListId, m ast.Func&) Bool {
    f := p.MethodOf(t, m.Name)
    c := p.declContext(d)
    want := p.Subst(p.sigType(c, m.S, types.UnknownT, source.NameId(0)), DeclOwner(d), args)
    if f < 0 { return p.suppliedMeets(t, p.text(m.Name), want) }
    if not load.Public(p.text(m.Name)) and not p.sealedBy(t, d, f) { return false }
    # T29e: an inherited Hash beside an Eq the type declares itself cannot agree with it (E10b)
    if p.text(m.Name) == "Hash" and not p.ownMethod(t, m.Name) and p.declaresEq(t) { return false }
    have := p.MethodSig(f, t)
    if have == types.UnknownT { return false }
    hs := p.T.Items(p.T.Params(have))
    ws := p.T.Items(p.T.Params(want))
    if hs.Len() != ws.Len() + 1 { return false }
    if m.Recv is not null and not p.writableRecv(hs[0]) { return false }   # a "mut" method: a writable receiver (T31)
    # ... and only a "mut" one: a method writing its receiver meets no signature that only reads it (T31)
    if m.Recv is null and p.T.KindOf(hs[0]) == types.Kind.Ref and (p.T.PermOf(hs[0]) & types.Writable) != 0 { return false }
    for i in range ws.Len() {
        if not p.sameUpToShape(hs[i + 1], ws[i]) { return false }
    }
    # D8e: a noreturn method meets one with no result
    hr := p.T.Result(have)
    wr := p.T.Result(want)
    return (p.T.Same(hr, wr) or (hr == types.NoreturnT and wr == types.VoidT)) and p.ErrsHeld(p.T.Errors(have), p.T.Errors(want))
}

# a method the compiler supplies meeting a trait's (G19): Hash where E10b supplies one, an array's Len (E23)
fn (p mut Program&) suppliedMeets(t types.TypeId, name String&, want types.TypeId) Bool {
    i64 := p.T.Prim("I64")
    if p.T.Items(p.T.Params(want)).Len() != 0 or p.T.Errors(want) != types.ListId(0) { return false }
    if name == "Bits" {
        # E33: a float's bits, as the unsigned type of its width
        x := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
        for k in range 16 {
            if p.T.IsFloat(x) {
                b := p.T.Bits(x)
                return p.T.Result(want) == p.T.Prim("U64" if b == 64 else "U32" if b == 32 else "U16")
            }
            if not p.Extends(x) { return false }
            x = p.T.Base(x)
        }
        return false
    }
    if p.T.Result(want) != i64 { return false }
    if name == "Hash" { return p.HasHash(t) }
    if name == "Len" {
        x := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
        for k in range 16 {
            if p.T.KindOf(x) == types.Kind.Array { return true }
            if not p.Extends(x) { return false }
            x = p.T.Base(x)
        }
    }
    return false
}

# whether a type declares a method of this name itself, not through what it extends (T29f)
fn (p mut Program&) ownMethod(t types.TypeId, name source.NameId) Bool {
    p.allFns()
    x := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
    key := p.typeKey(x)
    if key < 0 { return false }
    # one declared for this instance (M21): a method of another instance of its generic type is not its own
    m := try p.methods.Get(pair.Pair(key, I64(name))) catch default -1
    for m >= 0 {
        if p.recvApplies(m, x) { return true }
        m = try p.sameKey.Get(m) catch default -1
    }
    return false
}

fn (p mut Program&) declaresEq(t types.TypeId) Bool {
    return p.ownMethod(t, p.L.Names.Intern("Eq")) or p.ownMethod(t, p.L.Names.Intern("eq"))
}

# whether a value of the type has a hash (E10b): a Hash it declares, of the shape "Hash() I64" (an inherited one not
# beside an Eq of its own); else, where it declares no Hash, hash, Eq or eq, one the compiler supplies for a struct, enum
# or array value every part of which has one; a reference has one where it names an array whose elements have one, or
# a type declaring Eq and Hash
fn (p mut Program&) HasHash(t types.TypeId) Bool { return p.hasHash(t, 0) }

fn (p mut Program&) hasHash(t types.TypeId, depth I64) Bool {
    if depth > 16 { return true }
    k := p.T.KindOf(t)
    if k == types.Kind.Unknown or k == types.Kind.Var or k == types.Kind.ConstExpr { return true }
    hn := p.L.Names.Intern("Hash")
    if k == types.Kind.Ref {
        r := p.T.Referent(t)
        if p.T.KindOf(r) == types.Kind.Array { return p.hasHash(p.T.Elem(r), depth + 1) }
        if p.T.KindOf(r) == types.Kind.Named and p.Body(r) and p.T.DeclKindOf(p.T.DeclOf(r)) == types.DeclKind.Over and
           p.T.KindOf(p.T.Base(r)) == types.Kind.Array and not p.declaresEq(r) and p.MethodOf(r, hn) < 0 {
            return p.hasHash(p.T.Elem(p.T.Base(r)), depth + 1)
        }
        return p.declaresEq(r) and p.MethodOf(r, hn) >= 0 and p.hashShaped(r, p.MethodOf(r, hn))
    }
    f := p.MethodOf(t, hn)
    if f >= 0 {
        if not p.hashShaped(t, f) { return false }
        return p.ownMethod(t, hn) or not p.declaresEq(t)
    }
    if p.declaresEq(t) or p.ownMethod(t, p.L.Names.Intern("hash")) { return false }
    match k {
        case types.Kind.Array { return p.hasHash(p.T.Elem(t), depth + 1) }
        case types.Kind.Tuple, types.Kind.Record { return p.hashesAll(p.T.Parts(t), depth) }
        case types.Kind.AnonEnum { return p.hashesAll(p.T.ShapeCases(t), depth) }
        case types.Kind.Named {
            if not p.Body(t) { return true }
            dk := p.T.DeclKindOf(p.T.DeclOf(t))
            if dk == types.DeclKind.Struct { return p.hashesAll(p.T.Fields(t), depth) }
            if dk == types.DeclKind.Enum { return p.hashesAll(p.T.Cases(t), depth) }
            if dk == types.DeclKind.Over and p.T.KindOf(p.T.Base(t)) == types.Kind.Array { return p.hasHash(p.T.Base(t), depth + 1) }
            return false
        }
        nomatch { return false }
    }
}

fn (p mut Program&) hashesAll(l types.ListId, depth I64) Bool {
    for x in p.T.Items(l) {
        if x != types.TypeId(0) and not p.hasHash(x, depth + 1) { return false }
    }
    return true
}

fn (p mut Program&) hashShaped(t types.TypeId, f I64) Bool {
    s := p.MethodSig(f, t)
    return s != types.UnknownT and p.T.Items(p.T.Params(s)).Len() == 1 and p.T.Result(s) == p.T.Prim("I64") and
           p.T.Errors(s) == types.ListId(0)
}

# a private method seals its trait (T31): it is met by a method the trait's own module declares, on a type that module
# declares or a built-in one - so a type declared elsewhere that extends one (T29f) inherits the method but not the trait
fn (p mut Program&) sealedBy(t types.TypeId, d types.DeclId, f I64) Bool {
    tm := p.DeclModule(d)
    if p.fns[f].Mi != tm { return false }
    x := p.T.Referent(t) if p.T.KindOf(t) == types.Kind.Ref else t
    return p.T.KindOf(x) != types.Kind.Named or p.DeclModule(p.T.DeclOf(x)) == tm
}

fn (p mut Program&) writableRecv(r types.TypeId) Bool {
    return p.T.KindOf(r) != types.Kind.Ref or (p.T.PermOf(r) & types.Writable) != 0
}

fn (p mut Program&) sameUpToShape(a types.TypeId, c types.TypeId) Bool {
    if p.T.Same(a, c) { return true }
    ar := p.T.KindOf(a) == types.Kind.Ref
    cr := p.T.KindOf(c) == types.Kind.Ref
    if ar and cr { return false }
    x := p.T.Referent(a) if ar else a
    y := p.T.Referent(c) if cr else c
    return p.T.Same(x, y)
}

# a variable's binding checked against its constraint, where it is bound (G19): whether it is met
fn (p mut Program&) BoundMet(owner I64, args types.ListId) Bool { return p.FirstUnmet(owner, args).Var < 0 }

# whether owner's variable i bound to t meets its constraint, the others as in args (G9a: what a literal may bind)
fn (p mut Program&) MeetsBound(owner I64, i I64, args types.ListId, t types.TypeId) Bool {
    row := p.VarAt(owner, i)
    if row.Bound == types.UnknownT { return true }
    xs := p.T.Items(args)
    ys := Array<types.TypeId>(xs.Len())
    for j in range xs.Len() { ys[j] = t if j == i else xs[j] }
    bound := p.Subst(row.Bound, owner, p.T.List(ys))
    if not p.T.Closed(bound) { return true }
    return p.Missing(t, bound).Var < 0
}

# the first variable of owner whose binding in args fails its constraint, with every variable in the constraint
# substituted (G19); a binding or a constraint still holding a variable is a pattern, checked where it is applied
fn (p mut Program&) FirstUnmet(owner I64, args types.ListId) Unmet {
    xs := p.T.Items(args)
    for i in range xs.Len() {
        if i >= p.VarCount(owner) { break }
        row := p.VarAt(owner, i)
        if row.Bound == types.UnknownT or not p.T.Closed(xs[i]) { continue }
        bound := p.Subst(row.Bound, owner, args)
        if not p.T.Closed(bound) { continue }
        u := p.Missing(xs[i], bound)
        if u.Var >= 0 { return Unmet(i, u.Trait, u.Method, u.Named, u.Sealed, u.Closed) }
    }
    return met()
}

# ---- run-time trait values (T32) ----

# the traits an "any" of r answers to (T32c): r, then what it extends, at any depth, each once
fn (p mut Program&) AnyCovers(r types.TypeId) Array<types.TypeId> {
    out List<types.TypeId>
    p.anyCovers(r, out, 0)
    return out.ToArray()
}

fn (p mut Program&) anyCovers(r types.TypeId, out mut List<types.TypeId>&, depth I64) {
    if depth > 32 or p.T.KindOf(r) != types.Kind.Named or out.Has(r) { return }
    out.Push(r)
    for e in p.Extended(r) { p.anyCovers(e, out, depth + 1) }
}

# the slots of a trait's tables, in order (T32b): its methods and those of the traits it extends, then the defaults
# of those traits a table can hold - one whose type variables the receiver binds, mentioned nowhere but there (T35)
fn (p mut Program&) AnySlots(r types.TypeId) Array<AnySlot>&p {
    have := try p.anySlotsOf.Get(r) catch default Array<AnySlot>(0)
    if have.Len() > 0 or p.anySlotsOf.Has(r) { return have }
    p.allFns()
    out List<AnySlot>
    seen List<source.NameId>
    covers := p.AnyCovers(r)
    for tr in covers {
        d := p.T.DeclOf(tr)
        td := p.typeDecl(d)
        if td is null or td.Body is null { continue }
        match td.Body {
            case ast.TypeBody.Trait(methods, _, _) {
                for k in range methods.Len() {
                    m := methods[k]
                    if seen.Has(m.Name) { continue }
                    seen.Push(m.Name)
                    want := p.Subst(p.sigType(p.declContext(d), m.S, types.UnknownT, source.NameId(0)), DeclOwner(d), p.T.Args(tr))
                    writes := m.Recv is not null
                    out.Push(AnySlot(m.Name, tr, k, -1, writes, p.WithReceiver(want, p.T.Ref(p.T.Any(r), types.Writable if writes else types.ReadOnly))))
                }
            }
            nomatch { }
        }
    }
    for i in range p.defaultFns.Len() {
        f := p.defaultFns[i]
        d := types.DeclId(I32(p.defaultTraits[i]))
        tr := types.UnknownT
        for c in covers {
            if p.T.DeclOf(c) == d { tr = c }
        }
        if tr == types.UnknownT or seen.Has(p.fns[f].F.Name) { continue }
        sig := p.DefaultAt(f, p.T.Any(r))
        if sig == types.UnknownT { continue }
        seen.Push(p.fns[f].F.Name)
        ps := p.T.Items(p.T.Params(sig))
        writes := ps.Len() > 0 and p.T.KindOf(ps[0]) == types.Kind.Ref and (p.T.PermOf(ps[0]) & types.Writable) != 0
        out.Push(AnySlot(p.fns[f].F.Name, tr, -1, f, writes, sig))
    }
    kept mut Array<AnySlot>&p = Array<AnySlot>(out.Len(), AnySlot(source.NameId(0), types.UnknownT, -1, -1, false, types.UnknownT))
    for i in range out.Len() { kept[i] = out[i] }
    p.anySlotsOf.Put(r, kept)
    return kept
}

# the tables and slot contracts an attempt of the checker made, gone with its bodies (R1a)
fn (p mut Program&) ResetAny() {
    p.AnyTables = List<AnyTable>()
    p.anyTableOf = Map<pair.Pair<I64, I64>, I64>()
    p.SlotContracts = Map<I64, I64>()
}

# the key of trait r's slot k (k under checked too) among SlotContracts
fn (p mut Program&) SlotKey(r types.TypeId, k I64) I64 { return I64(r) * 65536 + k % p.AnySlots(r).Len() }

# the body owning the contract trait r's slot k has, -1 for none or not made yet
fn (p mut Program&) SlotContract(r types.TypeId, k I64) I64 { return try p.SlotContracts.Get(p.SlotKey(r, k)) catch default -1 }

# a signature with a receiver put first: its parameters' and results' scope entries moved past it (DESIGN.md 1.6.1)
fn (p mut Program&) WithReceiver(sig types.TypeId, recv types.TypeId) types.TypeId {
    ps := p.T.Items(p.T.Params(sig))
    all := Array<types.TypeId>(ps.Len() + 1)
    all[0] = recv
    for i in range ps.Len() { all[i + 1] = ps[i] }
    shares := Array<I64>(ps.Len() + 1, types.OwnScope)
    for i in range ps.Len() {
        e := p.T.ShareOf(sig, i)
        shares[i + 1] = e + 1 if e >= 0 else e
    }
    rs := p.T.Results(sig)
    from := Array<I64>(rs.Len(), types.OwnScope)
    for k in range rs.Len() {
        e := p.T.ResultFrom(sig, k)
        from[k] = e + 1 if e >= 0 else e
    }
    return p.T.Func(p.T.List(all), p.T.Result(sig), p.T.Errors(sig), p.T.Scopes(p.T.Role(sig), shares, from))
}

# a default's signature with its receiver's variable bound to x - the instance's type, or an "any" (T32c: the variable a
# reference to it binds, as G11 says) - and what its constraint binds through it (G9c); Unknown where a variable stays
# unbound (a default generic in its own types, as Fold is) or the receiver's variable stands anywhere else in it (T35)
fn (p mut Program&) DefaultAt(f I64, x types.TypeId) types.TypeId {
    sig := p.Sig(f)
    owner := FnOwner(f)
    nv := p.VarCount(owner)
    ps := p.T.Items(p.T.Params(sig))
    if ps.Len() == 0 { return types.UnknownT }
    recv := ps[0]
    rv := recv
    if p.T.KindOf(rv) == types.Kind.Ref { rv = p.T.Referent(rv) }
    if p.T.KindOf(rv) != types.Kind.Var or p.T.A(rv) != owner { return types.UnknownT }
    vi := p.T.B(rv)
    b := Binding(owner, nv)
    by := x
    # a receiver by value binds the reference an "any" is (G11)
    if p.T.KindOf(recv) != types.Kind.Ref and p.T.KindOf(x) == types.Kind.Any { by = p.T.Ref(x, types.ReadOnly) }
    b.Vals[vi] = by
    p.InferThroughBounds(b)
    for v in b.Vals {
        if v == types.UnknownT { return types.UnknownT }
    }
    for i in range ps.Len() - 1 {
        if p.mentionsVar(ps[i + 1], owner, vi, 0) { return types.UnknownT }
    }
    if p.mentionsVar(p.T.Result(sig), owner, vi, 0) { return types.UnknownT }
    return p.Subst(sig, owner, p.T.List(b.Vals))
}

fn (p mut Program&) mentionsVar(t types.TypeId, owner I64, v I64, depth I64) Bool {
    if depth > 32 { return false }
    match p.T.KindOf(t) {
        case types.Kind.Var { return p.T.A(t) == owner and p.T.B(t) == v }
        case types.Kind.Ref { return p.mentionsVar(p.T.Referent(t), owner, v, depth + 1) }
        case types.Kind.Array { return p.mentionsVar(p.T.Elem(t), owner, v, depth + 1) }
        case types.Kind.Any { return p.mentionsVar(p.T.AnyTrait(t), owner, v, depth + 1) }
        case types.Kind.Named { return p.mentionsList(p.T.Args(t), owner, v, depth) }
        case types.Kind.Tuple, types.Kind.Record { return p.mentionsList(p.T.Parts(t), owner, v, depth) }
        case types.Kind.Func {
            return p.mentionsList(p.T.Params(t), owner, v, depth) or p.mentionsVar(p.T.Result(t), owner, v, depth + 1)
        }
        nomatch { return false }
    }
}

fn (p mut Program&) mentionsList(l types.ListId, owner I64, v I64, depth I64) Bool {
    for x in p.T.Items(l) {
        if p.mentionsVar(x, owner, v, depth + 1) { return true }
    }
    return false
}

# whether a value of t holds variable v of owner by value - itself, as a part, as an element, or as a field of a generic
# type's instance that holds its own variable there, behind references too (a List<G>'s elements live in its state); a
# reference to the variable itself holds it by reference (T32: an "any" bound to v has no copy to hold, but is one)
fn (p mut Program&) HoldsVarByValue(t types.TypeId, owner I64, v I64, depth I64) Bool {
    if depth > 16 { return false }
    match p.T.KindOf(t) {
        case types.Kind.Var { return p.T.A(t) == owner and p.T.B(t) == v }
        case types.Kind.Ref {
            r := p.T.Referent(t)
            if p.T.KindOf(r) == types.Kind.Var { return false }
            return p.HoldsVarByValue(r, owner, v, depth + 1)
        }
        # a function value may have captured it, by value (D16c): one mentioning it anywhere is taken to hold it
        case types.Kind.Func { return p.mentionsVar(t, owner, v, depth + 1) }
        case types.Kind.Array { return p.HoldsVarByValue(p.T.Elem(t), owner, v, depth + 1) }
        case types.Kind.Tuple, types.Kind.Record {
            for x in p.T.Items(p.T.Parts(t)) {
                if p.HoldsVarByValue(x, owner, v, depth + 1) { return true }
            }
            return false
        }
        case types.Kind.Named {
            xs := p.T.Items(p.T.Args(t))
            if xs.Len() == 0 { return false }
            d := p.T.DeclOf(t)
            self := p.SelfType(d)
            for i in range xs.Len() {
                if not p.HoldsVarByValue(xs[i], owner, v, depth + 1) { continue }
                if not p.Body(self) { return true }
                for f in p.T.Items(p.T.Fields(self)) {
                    if p.HoldsVarByValue(f, DeclOwner(d), i, depth + 1) { return true }
                }
                for f in p.T.Items(p.T.Cases(self)) {
                    if f != types.TypeId(0) and p.HoldsVarByValue(f, DeclOwner(d), i, depth + 1) { return true }
                }
            }
            return false
        }
        nomatch { return false }
    }
}

# the type an instance of t is stored as in an "any" (T32): itself, or for an array of a run-time length - its value a
# pair - a one-part tuple holding it, so the instance is one pointer
fn (p mut Program&) AnyStored(t types.TypeId) types.TypeId {
    r := p.T.Repr(t)
    if p.T.KindOf(r) == types.Kind.Array and p.T.Length(r) == types.TypeId(0) { return p.T.Tuple(p.T.List1(t)) }
    return t
}

# the table of an instance's type and a trait, made the first time it is asked for: its index; Fresh whether it was
# made now, its slots for the checker to fill
fn (p mut Program&) AnyTableFor(t types.TypeId, r types.TypeId, file I64, sp source.Span) I64, Bool {
    key := pair.Pair(I64(p.T.Plain(t)), I64(r))
    i := try p.anyTableOf.Get(key) catch default -1
    if i >= 0 { return i, false }
    p.AnyTables.Push(AnyTable(p.T.Plain(t), r, p.AnyStored(p.T.Plain(t)), file, sp))
    i = p.AnyTables.Len() - 1
    p.anyTableOf.Put(key, i)
    return i, true
}

# the table of a type and a trait, -1 for none made
fn (p mut Program&) AnyTableOf(t types.TypeId, r types.TypeId) I64 {
    return try p.anyTableOf.Get(pair.Pair(I64(p.T.Plain(t)), I64(r))) catch default -1
}

# a default of a trait an "any" of r answers to that no slot holds - one generic in its own types (T32c): by name, -1
# for none
fn (p mut Program&) AnyDefault(r types.TypeId, name source.NameId) I64 {
    p.allFns()
    covers := p.AnyCovers(r)
    for i in range p.defaultFns.Len() {
        f := p.defaultFns[i]
        if p.fns[f].F.Name != name { continue }
        d := types.DeclId(I32(p.defaultTraits[i]))
        for c in covers {
            if p.T.DeclOf(c) == d { return f }
        }
    }
    return -1
}


# ---- canonical texts ----

# what a canonical text that names no type fails with
type BadCanon error {
    TEXT
}

# the type a canonical text names (types.Canon's form): the inverse of Canon over a program's types
fn (p mut Program&) ParseCanon(text String&) types.TypeId ? {
    cur := cursor(text)
    t := try p.canonType(cur)
    if cur.At != text.Len() { error BadCanon.TEXT }
    return t
}

type cursor struct(Text String&) {
    Text
    At I64 = 0
}

fn (c mut cursor&) eat(s String&) Bool {
    if c.At + s.Len() > c.Text.Len() { return false }
    if c.Text[c.At:c.At + s.Len()] != s { return false }
    c.At += s.Len()
    return true
}

fn (c cursor&) peek() Char { return c.Text[c.At] if c.At < c.Text.Len() else Char(0) }

fn (p mut Program&) canonType(c mut cursor&) types.TypeId ? BadCanon, Undeclared {
    perm := types.ReadOnly
    if c.eat("own ") { perm = perm | types.Owning }
    if c.eat("mut ") { perm = perm | types.Writable }
    t := try p.canonInner(c)
    if c.eat("&") { return p.T.Ref(t, perm) }
    if perm != types.ReadOnly { error BadCanon.TEXT }
    return t
}

fn (p mut Program&) canonInner(c mut cursor&) types.TypeId ? BadCanon, Undeclared {
    if c.eat("fn(") { return try p.canonFunc(c) }
    if c.eat("struct(") { return p.T.Record(try p.canonList(c, ")")) }
    if c.eat("enum{") { return try p.canonEnum(c) }
    if c.eat("(") { return p.T.Tuple(try p.canonList(c, ")")) }
    if c.eat("Array<") {
        elem := try p.canonType(c)
        length := types.TypeId(0)
        if c.eat(", ") { length = p.T.Const(p.T.Prim("I64"), try canonNumber(c)) }
        if not c.eat(">") { error BadCanon.TEXT }
        return p.T.Array(elem, length)
    }
    start := c.At
    for c.At < c.Text.Len() and nameChar(c.peek()) { c.At++ }
    word := c.Text[start:c.At]
    if c.peek() != ':' {
        if word == "Bool" { return types.BoolT }
        if word == "default" { return types.DefaultErrT }
        if word == "noreturn" { return types.NoreturnT }
        t := p.T.Prim(word)
        if t == types.UnknownT { error BadCanon.TEXT }
        return t
    }
    c.At++
    nstart := c.At
    for c.At < c.Text.Len() and nameChar(c.peek()) and c.peek() != '/' and c.peek() != '.' { c.At++ }
    d := try p.FindDecl(word, c.Text[nstart:c.At])
    if not c.eat("<") { return p.Instance(d, types.ListId(0)) }
    p.declVars(d)
    args List<types.TypeId>
    for {
        i := args.Len()
        if i >= p.T.DeclParams(d) { error BadCanon.TEXT }
        args.Push(try p.canonType(c))
        if c.eat(">") { break }
        if not c.eat(", ") { error BadCanon.TEXT }
    }
    return p.Instance(d, p.T.List(args.ToArray()))
}

fn nameChar(ch Char) Bool { return ch.IsLetter() or ch.IsDigit() or ch == '_' or ch == '/' or ch == '.' or ch == '-' or ch == '@' }

fn canonNumber(c mut cursor&) I64 ? {
    start := c.At
    if c.peek() == '-' { c.At++ }
    for c.At < c.Text.Len() and c.peek().IsDigit() { c.At++ }
    txt := c.Text[start:c.At]
    v := try txt.ParseInt() catch {
        u := try txt.ParseUint() catch { error BadCanon.TEXT }
        return I64(u)
    }
    return v
}

fn (p mut Program&) canonList(c mut cursor&, close String&) types.ListId ? {
    xs List<types.TypeId>
    if c.eat(close) { return types.ListId(0) }
    for {
        xs.Push(try p.canonType(c))
        if c.eat(close) { break }
        if not c.eat(", ") { error BadCanon.TEXT }
    }
    return p.T.List(xs.ToArray())
}

fn (p mut Program&) canonFunc(c mut cursor&) types.TypeId ? {
    params := try p.canonList(c, ")")
    result := types.VoidT
    if c.eat(" (") {
        l := try p.canonList(c, ")")
        xs := p.T.Items(l)
        result = xs[0] if xs.Len() == 1 else p.T.Tuple(l)
    } else if c.At + 1 < c.Text.Len() and c.peek() == ' ' and c.Text[c.At + 1] != '?' and c.Text[c.At + 1] != '~' {
        c.At++
        result = try p.canonType(c)
    }
    es List<types.TypeId>
    if c.eat(" ?") {
        if c.eat(" ") {
            for {
                if c.eat("default") {
                    es.Push(types.DefaultErrT)
                } else {
                    es.Push(try p.canonInner(c))
                }
                if not c.eat(" + ") { break }
            }
        } else {
            es.Push(types.DefaultErrT)
        }
    }
    scopes := types.ScopesId(0)
    if c.eat(" ~[") {
        xs List<I64>
        for {
            xs.Push(try canonNumber(c))
            if c.eat("]") { break }
            if not c.eat(",") { error BadCanon.TEXT }
        }
        if xs.Len() < 2 or xs[1] < 0 or xs.Len() < 2 + xs[1] { error BadCanon.TEXT }
        n := xs[1]
        all := xs.ToArray()
        scopes = p.T.Scopes(all[0], all[2:2 + n], all[2 + n:])
    }
    return p.T.Func(params, result, p.T.List(es.ToArray()), scopes)
}

fn (p mut Program&) canonEnum(c mut cursor&) types.TypeId ? {
    ns List<source.NameId>
    ps List<types.TypeId>
    for not c.eat("}") {
        if ns.Len() > 0 and not c.eat(" ") { error BadCanon.TEXT }
        start := c.At
        for c.At < c.Text.Len() and (c.peek().IsLetter() or c.peek().IsDigit() or c.peek() == '_') { c.At++ }
        ns.Push(p.L.Names.Intern(c.Text[start:c.At]))
        if c.eat("(") {
            ps.Push(p.T.Record(try p.canonList(c, ")")))
        } else {
            ps.Push(types.TypeId(0))
        }
    }
    return p.T.AnonEnum(ns.ToArray(), p.T.List(ps.ToArray()))
}
# ---- tests ----

# a program of one file, main.olang, loaded over the repository's std with the host's build constants
fn testLoad(dir String&, text String&) load.Loader {
    try os.WriteFile($dir "/main.olang", text) catch os.Error { }
    consts := cond.Consts()
    consts.Builtins("linux", "x86_64", "x86-64", 128, 0, false, false, false)
    l := load.Loader("std", consts, fetch.Fetcher($dir "/olang.lock", $dir "/cache", "file:///nowhere/", false, true)
                     source.Names(), diag.Diagnostics(false))
    l.Load($dir "/main.olang")
    return l
}

fn saidRules(l mut load.Loader&) String {
    b := StringBuilder()
    for s in l.Diags.AllSaid() {
        b.Push($s.Rule)
        b.PushChar(' ')
    }
    return b.ToString()
}

# a canonical text read and written back
fn (p mut Program&) roundTrip(text String&) Bool {
    t := try p.ParseCanon(text) catch { return false }
    return p.T.Canon(t) == text
}

test "declared types and instances: laid out as C lays them out, their canonical texts read back" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("type P struct(a U8, b I64, c U16) {\n    a\n    b\n    c\n}\ntype Box<T> struct(v T, n I64) {\n    v\n    n\n}\n"
                       "type Shape enum {\n    Dot\n    Rect(w I32, h I64)\n}\ntype E error { BAD }\n"
                       "type Meters extends I32\ntype Buf struct() { a := Array<U8>(5) }\nfn main() ? { }\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := Program(l, r)
    m := l.Mods[l.Root].Identity
    pt := try p.ParseCanon($m ":P") catch { unreachable }
    assert p.Layout(pt) and p.T.Size(pt) == 24 and p.T.Align(pt) == 8, $p.T.Size(pt)
    offs := p.T.Offsets(pt)
    assert offs.Len() == 3 and offs[0] == 0 and offs[1] == 8 and offs[2] == 16
    # an instance is its generic's body substituted, laid out once per instance
    bx := try p.ParseCanon($m ":Box<U8>") catch { unreachable }
    bs := try p.ParseCanon($m ":Box<std/prelude/text:String&>") catch { unreachable }
    assert p.Layout(bx) and p.T.Size(bx) == 16 and p.Layout(bs) and p.T.Size(bs) == 24 and bx != bs
    assert p.T.Offsets(bs)[1] == 16
    # an enum: a tag word, then the largest payload in whole words
    sh := try p.ParseCanon($m ":Shape") catch { unreachable }
    assert p.Layout(sh) and p.T.Size(sh) == 24 and p.T.Llvm(sh) == "{ i64, [2 x i64] }"
    # a declared number is its base; an array made with a known length is laid out in place (T7c)
    mt := try p.ParseCanon($m ":Meters") catch { unreachable }
    assert p.Layout(mt) and p.T.Size(mt) == 4
    bf := try p.ParseCanon($m ":Buf") catch { unreachable }
    assert p.Layout(bf) and p.T.Size(bf) == 5 and p.T.Align(bf) == 1
    for text in String&["I32", "Array<U8>", "Array<I64, 4>", $m ":Box<mut " $m ":P&>", "fn(I32, std/prelude/text:String&) I64 ? " $m ":E"
                        "fn() (I32, Bool) ?", "(I32, Bool)", "struct(I64, F32)", "enum{A(I32) B}"
                        "own mut Array<std/prelude/text:String&>&", $m ":Box<" $m ":Box<Array<F64>>>"] {
        assert p.roundTrip(text), text
    }
    # no such type
    assert not p.roundTrip($m ":Nothing") and not p.roundTrip("Q32") and not p.roundTrip($m ":P<U8>")
    assert l.Diags.Errors() == 0, saidRules(l)
}

test "T16 and G17: a type holding itself, and instances nesting without end" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("type A struct() { b B }\ntype B struct() { a A }\ntype D<T> struct() { n D<Array<T>> }\n"
                       "type L struct() { next L& }\nfn main() ? { }\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := Program(l, r)
    m := l.Mods[l.Root].Identity
    a := try p.ParseCanon($m ":A") catch { unreachable }
    assert not p.Layout(a) and not p.Layout(a)
    assert saidRules(l) == "T16 ", saidRules(l)
    d := try p.ParseCanon($m ":D<I32>") catch { unreachable }
    assert not p.Layout(d)
    assert saidRules(l) == "T16 G17 ", saidRules(l)
    # a reference breaks the cycle (T16)
    lt := try p.ParseCanon($m ":L") catch { unreachable }
    assert p.Layout(lt) and p.T.Size(lt) == 8
}

test "a known length folds as the program computes it (T7c): typed, wrapping, from globals" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("B U8 = 255\nW I64 = 3\nK := W * 4 + 1\ntype S0 struct() { a := Array<U8>(B + 1) }\n"
                       "type S1 struct() { a := Array<U8>(K - W) }\ntype S2 struct() { a := Array<U8>((2 << 3) | 1) }\n"
                       "type S3 struct() { a := Array<U8>(I64(B) + 1) }\nfn main() ? { }\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := Program(l, r)
    m := l.Mods[l.Root].Identity
    want := I64[0, 10, 17, 256]
    for i in range 4 {
        t := try p.ParseCanon($m ":S" $i) catch { unreachable }
        assert p.Layout(t) and p.T.Size(t) == want[i], $i " " $p.T.Size(t)
    }
    assert l.Diags.Errors() == 0, saidRules(l)
}

test "inference (G9): literals adapt, numbers widen unless a receiver bound them, permissions meet" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, "type P struct() { }\nfn pick<T>(a T, b T) T { return a }\nfn main() ? { }\n")
    r := names.Resolver(l)
    r.Resolve()
    p := Program(l, r)
    m := l.Mods[l.Root].Identity
    f := p.FnNamed(l.Root, l.Names.Intern("pick"))
    ps := p.T.Items(p.T.Params(p.Sig(f)))
    owner := FnOwner(f)
    assert p.VarCount(owner) == 1
    i32 := p.T.Prim("I32")
    i64 := p.T.Prim("I64")
    # G9a: a literal binds nothing while another argument can
    b := Binding(owner, 1)
    assert p.UnifyArg(ps[0], i64, b, true, false) and p.UnifyArg(ps[1], p.T.Prim("U8"), b, false, false)
    assert b.Vals[0] == p.T.Prim("U8")
    # G9b: a number widens to a wider one of its family...
    b2 := Binding(owner, 1)
    assert p.UnifyArg(ps[0], i32, b2, false, false) and p.UnifyArg(ps[1], i64, b2, false, false) and b2.Vals[0] == i64
    # ... unless a receiver bound it, and never across families
    b3 := Binding(owner, 1)
    assert p.UnifyArg(ps[0], i32, b3, false, true) and not p.UnifyArg(ps[1], i64, b3, false, false)
    b4 := Binding(owner, 1)
    assert p.UnifyArg(ps[0], i32, b4, false, false) and not p.UnifyArg(ps[1], p.T.Prim("F64"), b4, false, false)
    # G9d: two references differing only in permission meet at read-only, whichever comes first
    pt := try p.ParseCanon($m ":P") catch { unreachable }
    b5 := Binding(owner, 1)
    assert p.UnifyArg(ps[0], p.T.Ref(pt, types.Writable), b5, false, false)
    assert p.UnifyArg(ps[1], p.T.Ref(pt, types.ReadOnly), b5, false, false) and b5.Vals[0] == p.T.Ref(pt, types.ReadOnly)
    # an instance is named by its module, name and arguments (G16a), and made once
    one := p.FnInstance(f, p.T.List(Array<types.TypeId>(1, i64)))
    two := p.FnInstance(f, p.T.List(Array<types.TypeId>(1, i32)))
    assert one != two and one == p.FnInstance(f, p.T.List(Array<types.TypeId>(1, i64)))
    assert p.InstanceName(one) == types.Symbol($m ".pick<I64>"), p.InstanceName(one)
    assert p.T.Canon(p.InstanceSig(two)) == "fn(I32, I32) I32 ~[0,2,-1,-1,-2]", p.T.Canon(p.InstanceSig(two))
}

test "constraints (G19): a type satisfies a trait by its methods, checked where a variable is bound" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("type K struct() { }\nfn (k K&) Hash() I64 { return 1 }\ntype N struct() { }\n"
                       "fn (n N&) Hash() I32 { return 1 }\ntype Box<T> struct() { }\nfn (b Box<T>&) Get(x T) T { return x }\n"
                       "fn h<T Hashable<T>>(x T) { }\nfn main() ? { }\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := Program(l, r)
    m := l.Mods[l.Root].Identity
    k := try p.ParseCanon($m ":K") catch { unreachable }
    n := try p.ParseCanon($m ":N") catch { unreachable }
    hk := try p.ParseCanon("std/prelude/hash:Hashable<" $m ":K>") catch { unreachable }
    hn := try p.ParseCanon("std/prelude/hash:Hashable<" $m ":N>") catch { unreachable }
    assert p.Satisfies(k, hk) and not p.Satisfies(n, hn)
    f := p.FnNamed(l.Root, l.Names.Intern("h"))
    p.Sig(f)
    assert p.BoundMet(FnOwner(f), p.T.List(Array<types.TypeId>(1, k)))
    assert not p.BoundMet(FnOwner(f), p.T.List(Array<types.TypeId>(1, n)))
    # a method over a generic type, its receiver's variable bound by the receiver (G9b)
    bx := try p.ParseCanon($m ":Box<I16>") catch { unreachable }
    g := p.MethodOf(bx, l.Names.Intern("Get"))
    assert g >= 0 and p.T.Canon(p.MethodSig(g, bx)) == "fn(" $m ":Box<I16>&, I16) I16 ~[0,2,-1,-1,-2]", p.T.Canon(p.MethodSig(g, bx))
}

test "a closed trait (T31a): the prelude's Float, Integer and Number are met by the built-in numbers alone" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("type D extends F64\ntype M I32\ntype Fake struct() { }\nfn (f Fake&) Area() F64 { return 0.0 }\n"
                       "fn main() ? { }\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := Program(l, r)
    m := l.Mods[l.Root].Identity
    fl := try p.ParseCanon("std/prelude/number:Float") catch { unreachable }
    it := try p.ParseCanon("std/prelude/number:Integer") catch { unreachable }
    nu := try p.ParseCanon("std/prelude/number:Number") catch { unreachable }
    for x in String&["F16", "BF16", "F32", "F64"] {
        t := try p.ParseCanon(x) catch { unreachable }
        assert p.Satisfies(t, fl) and p.Satisfies(t, nu) and not p.Satisfies(t, it), x
    }
    for x in String&["I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64"] {
        t := try p.ParseCanon(x) catch { unreachable }
        assert p.Satisfies(t, it) and p.Satisfies(t, nu) and not p.Satisfies(t, fl), x
    }
    bo := try p.ParseCanon("Bool") catch { unreachable }
    ch := try p.ParseCanon("std/prelude/text:Char") catch { unreachable }
    assert not p.Satisfies(bo, nu) and not p.Satisfies(ch, it) and not p.Satisfies(ch, nu)
    for x in String&[":D", ":M", ":Fake"] {
        t := try p.ParseCanon($m $x) catch { unreachable }
        assert not p.Satisfies(t, fl) and not p.Satisfies(t, nu), x
    }
}

test "function types carry what their markers say; a call's scope variables come from the type; instances remember where" {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    l := testLoad(dir, ("type N struct(v I64) {\n    v\n}\ntype Box<T> struct(v T) {\n    v\n}\n"
                       "fn link(a mut N&, b N&a) { }\nfn first(l N&) N&l { return l }\nfn make() N& { return N(1) }\n"
                       "fn (l mut N&) Put(x N&l) { }\nfn apply(f fn(a mut N&, b N&a), x mut N&, y N&) { }\n"
                       "fn id<T>(x T) T { return x }\nfn count(a I64, l N&) I64 { return a }\nfn main() ? { }\n"))
    r := names.Resolver(l)
    r.Resolve()
    p := Program(l, r)
    m := l.Mods[l.Root].Identity
    link := p.Sig(p.FnNamed(l.Root, l.Names.Intern("link")))
    assert p.T.ShareOf(link, 1) == 0 and p.ScopeVarsOf(link) == I64[0]
    text := "fn(mut " $m ":N&, " $m ":N&) ~[0,2,-1,0]"
    assert p.T.Canon(link) == text, p.T.Canon(link)
    assert p.roundTrip(text) and p.T.Same(link, p.T.Plain(link)) and link != p.T.Plain(link)
    first := p.Sig(p.FnNamed(l.Root, l.Names.Intern("first")))
    assert p.T.ResultFrom(first, 0) == 0 and p.ScopeVarsOf(first) == I64[0]
    make := p.Sig(p.FnNamed(l.Root, l.Names.Intern("make")))
    assert p.ScopeVarsOf(make) == I64[types.ResultVar]
    nt := try p.ParseCanon($m ":N") catch { unreachable }
    put := p.MethodSig(p.MethodOf(nt, l.Names.Intern("Put")), p.T.Ref(nt, types.Writable))
    assert p.T.ShareOf(put, 1) == 0 and p.ScopeVarsOf(put) == I64[0]
    apply := p.Sig(p.FnNamed(l.Root, l.Names.Intern("apply")))
    cb := p.T.Items(p.T.Params(apply))[0]
    assert p.T.ShareOf(cb, 1) == 0 and p.ScopeVarsOf(apply) == I64[0, 1, 2]
    count := p.Sig(p.FnNamed(l.Root, l.Names.Intern("count")))
    assert p.ScopeVarsOf(count) == I64[1]   # a number holds no reference, so passes no scope
    # a result written as a type variable: a result scope where it becomes a reference (O14b), none for a number
    f := p.FnNamed(l.Root, l.Names.Intern("id"))
    assert p.T.ResultFrom(p.Sig(f), 0) == types.FromTypeVar
    atI64 := p.FnInstance(f, p.T.List1(p.T.Prim("I64")))
    atRef := p.FnInstance(f, p.T.List1(p.T.Ref(nt, types.ReadOnly)))
    assert p.ScopeVarsOf(p.InstanceSig(atI64)) == I64[] and p.ScopeVarsOf(p.InstanceSig(atRef)) == I64[0, types.ResultVar]
    # a function type argument keeps where its references live (G16a, T22): two instances
    assert p.FnInstance(f, p.T.List1(link)) != p.FnInstance(f, p.T.List1(p.T.Plain(link)))
    # an instance remembers where it was first asked for (G16b)
    p.Asking = Origin(7, source.Span(3, 9), atI64)
    bx := try p.ParseCanon($m ":Box<I32>") catch { unreachable }
    i := p.FnInstance(f, p.T.List1(p.T.Prim("U8")))
    assert p.TypeOrigin(bx).File == 7 and p.TypeOrigin(bx).Within == atI64 and p.InstanceOrigin(i).Sp.Start == 3
    assert p.InstanceOrigin(atI64).File == -1
    assert l.Diags.Errors() == 0, saidRules(l)
}
