# paint - colour for the prompt (B22): olang text coloured by the compiler's own scanner (scan), never a second lexer, and
# the words of diagnostics, in olang's own palette (the Neovim plugin's too); nothing is coloured
# where the output is not a terminal or NO_COLOR is set (Wanted).

import "std/os"
import "scan"
import "token"

# The palette, the same as editors/nvim/syntax/olang.vim's (DEPENDENTS.md): colours readable on a dark background, none
# dark blue or black. Each is 24-bit RGB, its nearest of the 256 colours for a terminal without 24-bit colour, and how
# it is drawn ("1" bold, "3" italic, "" plain)
type Shade struct(Rgb String&, Cube String&, Style String& = "") {
    Rgb
    Cube
    Style
}

plain Shade = Shade("", "")                                 # the terminal's own colour
keywordColour Shade = Shade("199;146;234", "177")          # #c792ea purple: keywords, true, false, null
typeNameColour Shade = Shade("255;203;107", "221")         # #ffcb6b yellow: a capitalized name
functionColour Shade = Shade("127;219;202", "116")         # #7fdbca teal: a name called
numberColour Shade = Shade("247;140;108", "209")           # #f78c6c orange
textColour Shade = Shade("195;232;141", "150")             # #c3e88d green: text and character literals
commentColour Shade = Shade("166;172;205", "250", "3")     # #a6accd grey, italic
operatorColour Shade = Shade("137;221;255", "117")         # #89ddff light cyan
errorWord Shade = Shade("255;83;112", "203", "1")          # #ff5370 red, bold
warningWord Shade = Shade("255;203;107", "221", "1")       # yellow, bold
noteWord Shade = Shade("137;221;255", "117", "1")          # light cyan, bold
helpWord Shade = Shade("195;232;141", "150", "1")          # green, bold

# whether the terminal draws 24-bit colour: COLORTERM says so, or it is Windows Terminal (WT_SESSION)
fn Deep() Bool {
    c := try os.Env("COLORTERM") catch os.Error { return has("WT_SESSION") }
    return c == "truecolor" or c == "24bit" or has("WT_SESSION")
}

fn has(name String&) Bool {
    v := try os.Env(name) catch os.Error { return false }
    return v != ""
}

# a shade's SGR parameters, in 24-bit colour where deep, else from the 256
fn sgr(c Shade&, deep Bool) String {
    fg := $"38;2;" + $c.Rgb if deep else $"38;5;" + $c.Cube
    return fg if c.Style == "" else $c.Style + ";" + $fg
}

# whether what is written to fd is coloured: it is a terminal and NO_COLOR is unset or empty (no-color.org)
fn Wanted(fd I32) Bool {
    if not os.IsTerminal(fd): return false
    v := try os.Env("NO_COLOR") catch os.Error { return true }
    return v == ""
}

# t in colour code, the colour ended at each line end and taken up again after it, so each line stands alone
fn coloured(code String&, t String&) String {
    on := $"\x1b[" + $code + "m"
    return $on + $String(t.Replace("\n", $"\x1b[0m\n" + $on)) + "\x1b[0m"
}

# olang text coloured token by token, as the scanner reads it; what lies between tokens is coloured as a comment from
# its first '#'. The text written is the text given, with only escape codes added
fn Source(text String&) String { return source(text, Deep()) }

fn source(text String&, deep Bool) String {
    ts := scan.Tokens.Scan(text)
    b := StringBuilder()
    at I64 = 0
    for i, t in ts.Toks {
        s := I64(t.Start)
        e := I64(t.End)
        if e <= s or s < at: continue
        call := i + 1 < ts.Toks.Len() and ts.Toks[i + 1].Kind == token.Tok.LParen and I64(ts.Toks[i + 1].Start) == e
        b.Push(gap(text[at:s], deep))
        b.Push(piece(text[s:e], Shade.Of(t.Kind, text[s:e], call), deep))
        at = e
    }
    b.Push(gap(text[at:], deep))
    return b.ToString()
}

# what stands between two tokens: blanks, then a comment from its first '#'
fn gap(t String&, deep Bool) String {
    for i in range t.Len() {
        if t[i] == '#': return $t[:i] + $coloured(sgr(commentColour, deep), t[i:])
    }
    return $t
}

fn piece(t String&, c Shade, deep Bool) String {
    return $t if c.Rgb == "" else coloured(sgr(c, deep), t)
}

# a token's shade, plain where it stays the terminal's own colour; call says a '(' touches it
fn Shade.Of(k token.Tok, t String&, call Bool) Shade {
    if k == token.Tok.Iden and t[0] >= 'A' and t[0] <= 'Z': return typeNameColour
    if k == token.Tok.Iden: return functionColour if call else plain
    if k == token.Tok.IntLit or k == token.Tok.FloatLit: return numberColour
    if k == token.Tok.StrLit or k == token.Tok.CharLit: return textColour
    c := t[0]
    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z'): return keywordColour
    if k == token.Tok.Comma or k == token.Tok.Dot or k == token.Tok.Colon: return plain
    if k == token.Tok.LParen or k == token.Tok.RParen or k == token.Tok.LBrack or k == token.Tok.RBrack: return plain
    if k == token.Tok.LBrace or k == token.Tok.RBrace: return plain
    return operatorColour
}

# diagnostics with their words coloured: "error", "warning", "note" and "help" where a row names its kind - after the
# place ("cell3:1:1: error[D3b]: ...") or first on the row ("note: ...")
fn Diagnostics(text String&) String { return diagnostics(text, Deep()) }

fn diagnostics(text String&, deep Bool) String {
    b := StringBuilder()
    first := true
    for line in text.Split("\n") {
        if not first: b.PushChar('\n')
        first = false
        b.Push(row(line, deep))
    }
    return b.ToString()
}

fn row(line String&, deep Bool) String {
    words := Array<String&>["error", "warning", "note", "help"]
    codes := Array<String>[sgr(errorWord, deep), sgr(warningWord, deep), sgr(noteWord, deep), sgr(helpWord, deep)]
    for i in range words.Len() {
        at := kindAt(line, words[i])
        if at >= 0: return $line[:at] + $coloured(codes[i], words[i]) + $line[at + words[i].Len():]
    }
    return $line
}

# where word stands as a row's kind - first on the row (after blanks) or after ": " - followed by ':' or '['; else -1
fn kindAt(line String&, word String&) I64 {
    for i in range line.Len() - word.Len() {
        if not startsAt(line, word, i): continue
        after := line[i + word.Len()]
        if after != ':' and after != '[': continue
        if line[:i].Trim() == "" or (i >= 2 and line[i - 2] == ':' and line[i - 1] == ' '): return i
    }
    return -1
}

fn startsAt(t String&, w String&, i I64) Bool {
    if i + w.Len() > t.Len(): return false
    for j in range w.Len() {
        if t[i + j] != w[j]: return false
    }
    return true
}

test Source "colours each token by its kind, and only adds escape codes" {
    assert source("x := 1", false) == "x \x1b[38;5;117m:=\x1b[0m \x1b[38;5;209m1\x1b[0m"
    assert source("fn F() T # done", false) == "\x1b[38;5;177mfn\x1b[0m \x1b[38;5;221mF\x1b[0m() \x1b[38;5;221mT\x1b[0m " + $
        "\x1b[3;38;5;250m# done\x1b[0m"
    assert source("\"a\"", true) == "\x1b[38;2;195;232;141m\"a\"\x1b[0m"
    assert source("f(x) g (y)", false) == "\x1b[38;5;116mf\x1b[0m(x) g (y)"
    assert source("", true) == ""
}

test Source "ends a colour at a line end and takes it up again" {
    g := "\x1b[38;5;150m"
    assert source("\"\"\"\n    a\n    \"\"\"", false) == $g + "\"\"\"\x1b[0m\n" + $g + "    a\x1b[0m\n" + $g + "    \"\"\"\x1b[0m"
}

test Diagnostics "colours the kind of each row" {
    d := diagnostics("cell1:1:1: error[D3b]: no\n    1 | x\nnote: see\ncell2:1:1: warning: w", false)
    assert d == "cell1:1:1: \x1b[1;38;5;203merror\x1b[0m[D3b]: no\n    1 | x\n\x1b[1;38;5;117mnote\x1b[0m: see\n" + $
        "cell2:1:1: \x1b[1;38;5;221mwarning\x1b[0m: w"
    assert diagnostics("an error: here", true) == "an error: here"
}
