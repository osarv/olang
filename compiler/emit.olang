# emit - MIR made LLVM IR text (compiler/DESIGN.md section 1.9, M9): every function lowering makes (mir.Fn) written as
# an LLVM function, streamed through an io.Writer, with what the functions name - their types, the globals, the
# constant data, the runtime's and the externs' declarations - written after them.
#
# What emission relies on is MIR's contract (DESIGN.md 1.8.1, "What emit relies on"): every local is an alloca in the
# entry block (O2c); every scope a function opens is opened and closed in nesting order on every path, so a scope's
# header is an entry-block slot and closing it is one call; a call passes exactly PassedCount scopes, in order; the
# error-union ABI (R6); every check is already a branch. Emission decides nothing MIR says - order, placement, checks -
# and adds only how each statement is said in LLVM.
#
# The calling convention, one for every function this compiler makes (the runtime's and the externs' are C's):
# - a function's LLVM result is types.RetLlvm of its type: its result, the pair { i32 code, result } where it can fail
#   (a bare i32 code with no result), and for a result too large to return as one value (types.ViaMemory) nothing but
#   the code, the result written through a hidden first parameter;
# - its parameters, in order: the environment (a lambda's or an adapter's, whose captures it holds), the hidden result
#   pointer, the scopes a call passes (ptr each, mir.PassedCount of them), then each parameter as types.Passing says - a
#   value, a pointer to the caller's copy for one too large, a function value as its two words, code and environment;
# - a function value is the pair { code, environment }, and its code takes the environment first. A named function's
#   value is a thunk of its own taking an environment it ignores.
#
# The runtime (std/runtime/runtime.ll, filled in for the build) is linked beside: a module declares what it calls.

import "std/io"
import "std/os"
import "source"
import "ast"
import "diag"
import "types"
import "generic"
import "typed"
import "mir"
import "lower"
import "eval"
import olrt "runtime"

# the emission of a program: P the checked program, Lw its lowering, D for where things are (FILE:LINE)
type Emitter struct(P mut generic.Program&, Lw mut lower.Lowerer&, D mut diag.Diagnostics&, T mut types.Table&) {
    P
    Lw
    D
    T
    Tests Bool = false              # a test build: the harness runs the root's tests
    Debug Bool = false              # a -debug build: the error return trace kept (S18d), as in a test build
    Attrs String& = ""              # what every function carries for the target (B12: CPU, features, vector width)
    Gaps List<String&>              # what emission met and does not emit yet, a line each
    queue List<mir.FnKey>           # the functions to write, in the order first referred to
    queued Map<mir.FnKey, I64>      # each function's index in queue
    cur I64 = -1                    # the function being written
    named List<types.TypeId>        # the declared structs whose types are spelled by name, to define
    namedSeen Map<types.TypeId, Bool>
    # what is written, one item per symbol in the order made (a function, a global, constant data, a declaration):
    # its text, where it lives in a build of one object per module (a module's index, or Home*), and how another
    # object declares it
    itemSym List<String&>
    itemText List<String&>
    itemHome List<I64>
    itemDecl List<String&>
    itemAt Map<String&, I64>
    itemRefs List<Array<I64>&>      # each item's references (refsIn), found once when an object first needs them
    Triple String& = "x86_64-pc-linux-gnu"    # the target written into every module (B12)
    nconst I64 = 0
    badType Bool = false            # a type met with no layout, in the function being written
    ntask I64 = 0                   # tasks' trampolines made
    dataAt Map<String&, String&>      # a Data operand's storage by its position: one instance for each (T25d)
    thunks List<String&>            # function-value thunks to write: "SYM|key index"
    thunkFor Map<String&, Bool>
    thunkKeys List<mir.FnKey>
    thunkTys List<types.TypeId>
    adaptFrom List<types.TypeId>    # function values converted between ABIs (R6): an adapter per pair, its from and to
    adaptTo List<types.TypeId>
    adaptAt Map<String&, Bool>
    dtorKeys List<mir.FnKey>        # destructor thunks to write (the runtime's fn(ptr instance, ptr scope))
    dtorSeen Map<mir.FnKey, Bool>
    ctorOf Map<types.TypeId, I64>
    dtorOf Map<types.TypeId, I64>
    indexed Bool = false
    Module Bool = false             # one module compiled alone (compile): its own bodies, no entry
    emitted Bool = false
    tyDef List<String&>             # each type spelled by name, defined: "%\"NAME\" = type BODY"
    tyAt Map<String&, I64>          # a type's definition by its name (between the quotes)
    # K2: the immutable globals evaluated while compiling, by their initializer's body - each written as its value,
    # its initializer not run at startup (interp.Bake)
    Baked Map<I64, eval.Image>
    Arch String& = "x86_64"         # the target's architecture, for the runtime's text (B12)
    San Bool = false                # a -sanitize build: the runtime's text holds the scope sanitizer (B2f)
    rtTypes String& = ""            # the runtime's types, as its text defines them
    rtRead Bool = false
    # B2e, in a -debug build: metadata numbered from 1000 (below it the fixed alias tags), renumbered in each object;
    # the shared nodes - the compile unit, a file each, the subroutine type, a basic type each - as items "!N"
    dbgN I64 = 1000
    dbgCuN I64 = -1
    dbgSubN I64 = -1
    dbgPtrN I64 = -1
    dbgFiles Map<I64, I64>
    dbgBasics Map<I64, I64>
    dbgTypes Map<I64, I64>          # the debug types of aggregates, arrays, enums, references and function values
}

# whether the error return trace is kept (S18d): test and -debug builds
fn (e Emitter&) traced() Bool { return e.Tests or e.Debug }

fn (e mut Emitter&) gap(what String&) {
    if what not in e.Gaps { e.Gaps.Push($what) }
}

# ---- the program ----

# what an object holds: a module's code, the root's with main or with the test harness, or the program's instances
type ObjectKind enum {
    Module
    Main
    Tests
    Instances
}

# one object's IR: the module it is for (its identity), what it holds, its text
type Object struct(Identity String&, Kind ObjectKind, Ir String&) {
    Identity
    Kind
    Ir
}

# the whole program as one LLVM module: the root's main (or, in a test build, the harness running its tests), each
# module's initialization, and every function they reach
fn (e mut Emitter&) Program(w mut io.Writer&) {
    e.emitAll()
    w.Write(e.head())
    w.Write(e.rtTypes)
    for d in e.tyDef { w.Write(d) }
    for t in e.itemText { w.Write(t) }
    if e.dbgCuN >= 0 { w.Write(dbgTail(e.dbgCuN)) }
    w.Write(e.attributes())
}

# the program as one object per module (B3, B3d): each module's functions and globals in its own, every instance in
# the root's (in a -debug build the root's instances object), main or the test harness in the root's; each declares what it names of the others and
# carries a copy of the declarations, helpers and constant data it uses. An object's text depends only on what is in
# it: its items in the order of their symbols, its private symbols numbered in the order it names them. Compiling one
# module (Module) gives that one object, the instances it uses in it
fn (e mut Emitter&) Objects() List<Object> {
    e.emitAll()
    out List<Object>
    mods := e.P.L.Mods
    root := e.P.L.Root
    if e.Module {
        out.Push(Object($mods[root].Identity, ObjectKind.Module, e.assemble(root, true)))
        return out
    }
    used Map<I64, Bool>
    for h in e.itemHome { used.Put(h, true) }
    rootKind := ObjectKind.Tests if e.Tests else ObjectKind.Main
    for m in range mods.Len() {
        if m != root and used.Has(m) { out.Push(Object($mods[m].Identity, ObjectKind.Module, e.assemble(m, false))) }
    }
    # B3d: the instances in an object of their own where nothing is optimized (-debug: an edit to the root recompiles
    # only its own code), and in the root's otherwise - as stage 0's - so the root's code inlines the instances it
    # calls before the link: a loop over a Vec in the root, its At and Len in another object, measured 2x slower
    # (`for x in v`, bench/vec.olang walk), the link's optimization not recovering what the module's missed
    if e.Debug and used.Has(HomeInst) {
        out.Push(Object($mods[root].Identity, ObjectKind.Instances, e.assemble(HomeInst, false)))
    }
    out.Push(Object($mods[root].Identity, rootKind, e.assemble(root, not e.Debug)))
    return out
}

# a module's first lines
fn (e Emitter&) head() String {
    return $"; olang - emitted by the self-hosted compiler (compiler/emit.olang)\ntarget triple = \"" $e.Triple "\"\n\n"
}

# what every module ends with: the type tree its access tags name (T36), the runtime's header tags among them, and
# the attribute group every function carries
fn (e mut Emitter&) attributes() String {
    return $tbaaTree "attributes #0 = { null_pointer_is_valid " $e.Attrs " }\n"
}

# every function the program reaches written as an item, from main or the tests (or, compiling one module, from its
# own bodies), then the thunks, adapters and the entry, and the types they name
fn (e mut Emitter&) emitAll() {
    if e.emitted { return }
    e.emitted = true
    e.runtimeItems()
    e.index()
    p := e.P
    inits := e.initOrder()
    for m in inits {
        if not e.Module or m == p.L.Root { e.want(mir.FnKey.Init(m)) }
    }
    tests List<I64>
    mainBody I64 = -1
    for i in range e.Lw.Bodies.Len() {
        match e.Lw.Bodies[i].Of {
            case typed.BodyOf.Test(_) {
                if e.Tests and e.Lw.Bodies[i].Root != null { tests.Push(i) }
            }
            case typed.BodyOf.Fn(inst) {
                f := p.InstanceFn(inst)
                if p.FnModule(f) == p.L.Root and e.text(p.FnDecl(f).Name) == "main" { mainBody = i }
            }
            case _ { }
        }
    }
    if e.Module {
        for i in range e.Lw.Bodies.Len() {
            k := mir.FnKey.Body(typed.BodyId(I32(i)))
            match e.Lw.Bodies[i].Of {
                case typed.BodyOf.Fn(_), typed.BodyOf.Ctor(_, _), typed.BodyOf.Dtor(_), typed.BodyOf.Global(_, _) {
                    if e.Lw.Bodies[i].Root != null and e.homeOf(k) == p.L.Root { e.want(k) }
                }
                case _ { }
            }
        }
    } else if e.Tests {
        for t in tests { e.want(mir.FnKey.Body(typed.BodyId(I32(t)))) }
    } else if mainBody >= 0 {
        e.want(mir.FnKey.Body(typed.BodyId(I32(mainBody))))
    }
    k I64 = 0
    for k < e.queue.Len() {
        key := e.queue[k]
        e.cur = k
        k++
        e.function(key)
    }
    e.cur = -1
    for i in range e.thunkKeys.Len() { e.thunk(e.thunkKeys[i], e.thunkTys[i]) }
    for i in range e.adaptFrom.Len() { e.fvAdapter(e.adaptFrom[i], e.adaptTo[i]) }
    for d in e.dtorKeys { e.dtorThunk(d) }
    if e.Module {
        # one module compiled alone: no entry, the program's main is built from its root's object
    } else if e.Tests {
        e.harness(tests)
    } else if mainBody >= 0 {
        e.entry(inits, mainBody)
    }
    # the types spelled by name, defined; a declared struct's body may name others, laid out before it
    j I64 = 0
    for j < e.named.Len() {
        nt := e.named[j]
        j++
        body := e.T.StructBody(nt)
        for x in e.T.Embedded(nt) { e.need(x) }
        name := e.T.Llvm(nt)
        e.tyAt.Put($name[2:name.Len() - 1], e.tyDef.Len())
        e.tyDef.Push($name " = type " $body "\n")
    }
}

# ---- one object of several ----

# the references in IR text, as positions: kind (0 a symbol after "@", 1 a type's name in %"...", 2 a metadata node
# "!N", the "!" included), where its name starts and ends. Quoted text is skipped (a constant's bytes, an attribute's value); a quote inside is always escaped
fn refsIn(text String&) List<I64> {
    out List<I64>
    n := text.Len()
    i I64 = 0
    for i < n {
        c := text[i]
        if c == '"' {
            i++
            for i < n and text[i] != '"' { i++ }
            i++
        } else if c == ';' {
            for i < n and text[i] != '\n' { i++ }
        } else if c == '%' and i + 1 < n and text[i + 1] == '"' {
            s := i + 2
            i = s
            for i < n and text[i] != '"' { i++ }
            out.Push(1)
            out.Push(s)
            out.Push(i)
            i++
        } else if c == '@' {
            s := i + 1
            i = s
            for i < n and symbolChar(text[i]) { i++ }
            if i > s {
                out.Push(0)
                out.Push(s)
                out.Push(i)
            }
        } else if c == '!' and i + 1 < n and text[i + 1].IsDigit() {
            s := i
            i++
            for i < n and text[i].IsDigit() { i++ }
            out.Push(2)
            out.Push(s)
            out.Push(i)
        } else {
            i++
        }
    }
    return out
}

fn symbolChar(c Char) Bool { return c.IsLetter() or c.IsDigit() or c == '_' or c == '.' or c == '$' or c == '-' }

# one object's text: the items homed at home (with the instances' too, alsoInst), each shared or local item they name
# copied in (a local one renamed, numbered in the order named), a declaration for each item they name that lives in
# another object, and the types they name
fn (e mut Emitter&) assemble(home I64, alsoInst Bool) String {
    mine List<I64>
    for i in range e.itemSym.Len() {
        h := e.itemHome[i]
        if h == home or (alsoInst and h == HomeInst) { mine.Push(i) }
    }
    syms := e.itemSym
    sorted := mine.ToArray()
    sorted.Sort(fn(a I64, b I64) Bool { return syms[a] < syms[b] })
    order List<I64>
    have Map<I64, Bool>
    for i in sorted {
        order.Push(i)
        have.Put(i, true)
    }
    decls StringBuilder
    declared Map<I64, Bool>
    tys List<I64>
    tyHave Map<I64, Bool>
    rename Map<I64, String&>
    nloc I64 = 0
    k I64 = 0
    for k < order.Len() {
        it := order[k]
        k++
        text := e.itemText[it]
        rs := e.refs(it)
        for r in range 0, rs.Len(), 3 {
            name := text[rs[r + 1]:rs[r + 2]]
            if rs[r] == 1 {
                t := try e.tyAt.Get(name) catch default -1
                if t >= 0 and not tyHave.Has(t) { e.wantType(t, tys, tyHave) }
                continue
            }
            j := try e.itemAt.Get(name) catch default -1
            if j < 0 or have.Has(j) or declared.Has(j) { continue }
            h := e.itemHome[j]
            if h == HomeShared or h == HomeLocal {
                have.Put(j, true)
                order.Push(j)
                if h == HomeLocal {
                    rename.Put(j, $prefixOf(e.itemSym[j]) $nloc)
                    nloc++
                }
            } else if h == home or (alsoInst and h == HomeInst) {
                # homed here (always in order already)
            } else {
                declared.Put(j, true)
                decls.Push(e.itemDecl[j])
            }
        }
    }
    out := StringBuilder()
    out.Push(e.head())
    out.Push(e.rtTypes)
    for t in tys { out.Push(e.tyDef[t]) }
    # B2e: the debug metadata (numbered from 1000) renumbered in the order this object names it, from 1000
    meta Map<I64, I64>
    for it in order {
        text := e.itemText[it]
        if rename.Len() == 0 and not e.Debug {
            out.Push(text)
            continue
        }
        at I64 = 0
        rs := e.refs(it)
        for r in range 0, rs.Len(), 3 {
            if rs[r] == 2 {
                old := try text[rs[r + 1] + 1:rs[r + 2]].ParseInt() catch default 0
                if old < 1000 { continue }
                out.Push(text[at:rs[r + 1]])
                out.Push("!" $metaNumber(meta, old))
                at = rs[r + 2]
                continue
            }
            if rs[r] != 0 { continue }
            j := try e.itemAt.Get(text[rs[r + 1]:rs[r + 2]]) catch default -1
            if j < 0 or not rename.Has(j) { continue }
            out.Push(text[at:rs[r + 1]])
            out.Push(try rename.Get(j) catch default "")
            at = rs[r + 2]
        }
        out.Push(text[at:])
    }
    out.Push(decls.ToString())
    if e.dbgCuN >= 0 and meta.Has(e.dbgCuN) { out.Push(dbgTail(metaNumber(meta, e.dbgCuN))) }
    out.Push(e.attributes())
    return out.ToString()
}

# a debug node's number in the object being assembled: the next one where it is new there
fn metaNumber(meta mut Map<I64, I64>&, old I64) I64 {
    if not meta.Has(old) { meta.Put(old, 1000 + meta.Len()) }
    return try meta.Get(old) catch default 0
}

# what a module with debug information ends with: its compile unit named, and the versions it is written in
fn dbgTail(cu I64) String {
    return $"!llvm.dbg.cu = !{!" $cu "}\n!llvm.module.flags = !{!1, !2}\n!1 = !{i32 7, !\"Dwarf Version\", i32 4}\n" $
           "!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
}

# a type's definition wanted in the object, and the types its body names
fn (e mut Emitter&) wantType(t I64, tys mut List<I64>&, tyHave mut Map<I64, Bool>&) {
    tyHave.Put(t, true)
    tys.Push(t)
    def := e.tyDef[t]
    rs := refsIn(def)
    for r in range 0, rs.Len(), 3 {
        if rs[r] != 1 { continue }
        u := try e.tyAt.Get(def[rs[r + 1]:rs[r + 2]]) catch default -1
        if u >= 0 and not tyHave.Has(u) { e.wantType(u, tys, tyHave) }
    }
}

# a local item's new name in an object: its symbol up to its first digit (".c", "olang_lambda_", "olang_task"), then
# the object's own count
fn prefixOf(s String&) String {
    for i in range s.Len() {
        if s[i].IsDigit() { return $s[:i] }
    }
    return $s "."
}

# the modules whose initialization runs, imports first (B5a): the prelude's, then the root's imports depth first
fn (e mut Emitter&) initOrder() List<I64> {
    with := e.Lw.InitModules()
    done Map<I64, Bool>
    order List<I64>
    mods := e.P.L.Mods
    for m in range mods.Len() {
        if mods[m].Prelude { e.visit(m, done, order) }
    }
    e.visit(e.P.L.Root, done, order)
    out List<I64>
    for m in order {
        if m in with { out.Push(m) }
    }
    return out
}

fn (e mut Emitter&) visit(m I64, done mut Map<I64, Bool>&, order mut List<I64>&) {
    if done.Has(m) { return }
    done.Put(m, true)
    for im in e.P.L.Mods[m].Imports {
        if im.Target >= 0 { e.visit(im.Target, done, order) }
    }
    order.Push(m)
}

fn (e mut Emitter&) text(n source.NameId) String&e { return e.T.Names.Text(n) }

# the bodies by what they are: a type's constructor (twin 0) and destructor
fn (e mut Emitter&) index() {
    if e.indexed { return }
    e.indexed = true
    for i in range e.Lw.Bodies.Len() {
        match e.Lw.Bodies[i].Of {
            case typed.BodyOf.Dtor(t) { e.dtorOf.Put(t, i) }
            case _ { }
        }
    }
}

fn (e mut Emitter&) want(k mir.FnKey) {
    i := try e.queued.Get(k) catch default -1
    if i < 0 {
        i = e.queue.Len()
        e.queued.Put(k, i)
        e.queue.Push(k)
    }
}

# ---- B5a: a module's globals initialized after the globals each reads ----

# the global bodies of the modules in inits, in the order they run: a module's after its imports' (inits' order), and
# within a module in check's order (P.InitOrder) - each after the globals its initializer reads, else as declared
fn (e mut Emitter&) globalOrder(inits List<I64>) List<I64> {
    out List<I64>
    for m in inits {
        for i in e.P.InitOrder {
            match e.Lw.Bodies[i].Of {
                case typed.BodyOf.Global(gm, _) {
                    if gm == m { out.Push(i) }
                }
                case _ { }
            }
        }
    }
    return out
}

fn (e mut Emitter&) globalBody(m I64, n source.NameId) I64 {
    for i in range e.Lw.Bodies.Len() {
        match e.Lw.Bodies[i].Of {
            case typed.BodyOf.Global(gm, gn) {
                if gm == m and gn == n { return i }
            }
            case _ { }
        }
    }
    return -1
}

# ---- names ----

# a function's symbol: a typed body by what it is (an instance by its name, G16a), a helper, an adapter or a module's
# initialization by the key - letters, digits and "_" only (types.Symbol)
fn (e mut Emitter&) sym(k mir.FnKey) String {
    t := e.T
    return match k {
        case mir.FnKey.Body(id) => e.bodySym(I64(id))
        case mir.FnKey.Helper(kind, ty) => types.Symbol("olang." $kind "." $t.Canon(ty) $("" if t.Unnamed(ty) == ty else "." $I64(ty)))
        case mir.FnKey.Adapter(call) => $e.bodySym(I64(call)) "_adapter"
        case mir.FnKey.Init(m) => types.Symbol("olang.init." $e.P.L.Mods[m].Identity)
    }
}

fn (e mut Emitter&) bodySym(id I64) String {
    t := e.T
    b := e.Lw.Bodies[id]
    return match b.Of {
        case typed.BodyOf.Fn(inst) => $e.P.InstanceName(inst)
        case typed.BodyOf.Ctor(ty, twin) => types.Symbol($t.Canon(ty) ".ctor" $("" if twin == types.ListId(0) else "." $twin))
        case typed.BodyOf.Dtor(ty) => types.Symbol($t.Canon(ty) ".dtor")
        case typed.BodyOf.Lambda(_) => "olang_lambda_" $id
        case typed.BodyOf.Test(_) => "olang_test_" $id
        case typed.BodyOf.Global(m, n) => types.Symbol($e.P.L.Mods[m].Identity "." $e.text(n) ".init")
        case typed.BodyOf.Case(_, _) => "olang_case_" $id
        case typed.BodyOf.Cond(_, _) => "olang_cond_" $id
    }
}

fn (e mut Emitter&) globalSym(m I64, n source.NameId) String {
    return types.Symbol("G." $e.P.L.Mods[m].Identity "." $e.text(n))
}

fn (e mut Emitter&) isGlobalInit(k mir.FnKey) Bool {
    return match k {
        case mir.FnKey.Body(id) => match e.Lw.Bodies[I64(id)].Of {
            case typed.BodyOf.Global(_, _) => true
            case _ => false
        }
        case _ => false
    }
}

# whether a function takes an environment first: a lambda, an adapter
# how many scope variables a closure's code takes from its environment: one for each capture holding references (D16c)
fn (e mut Emitter&) capVars(k mir.FnKey) I64 {
    n I64 = 0
    match k {
        case mir.FnKey.Body(id) {
            for v in e.Lw.Bodies[I64(id)].Vars {
                match v {
                    case typed.ScopeVar.Capture(_) { n++ }
                    case _ { }
                }
            }
        }
        case mir.FnKey.Adapter(call) {
            ps := e.T.Items(e.T.Params(e.Lw.Bodies[I64(call)].Ty))
            if ps.Len() > 0 and e.T.HoldsRefs(ps[0]) { n = 1 }
        }
        case _ { }
    }
    return n
}

fn (e mut Emitter&) hasEnv(k mir.FnKey) Bool {
    return match k {
        case mir.FnKey.Adapter(_) => true
        case mir.FnKey.Body(id) => e.isLambda(I64(id))
        case _ => false
    }
}

fn (e mut Emitter&) isLambda(id I64) Bool {
    return match e.Lw.Bodies[id].Of {
        case typed.BodyOf.Lambda(_) => true
        case _ => false
    }
}

# where a span is, "FILE:LINE" (S18a)
fn (e mut Emitter&) where(file I64, sp source.Span) String {
    s := e.D.Locate(file, I64(sp.Start))
    k := try s.FindLast(":") catch default -1
    return $s[:k] if k > 0 else $s
}

# ---- debug information (B2e) ----

# a metadata node's number, new; a shared one made an item
fn (e mut Emitter&) dbgNew() I64 {
    n := e.dbgN
    e.dbgN++
    return n
}

fn (e mut Emitter&) dbgShared(n I64, text String&) { e.item("!" $n, HomeShared, $"!" $n " = " $text "\n") }

# the compile unit, made with the file of the program's root (each object copies it, and names it in !llvm.dbg.cu)
fn (e mut Emitter&) dbgCu() I64 {
    if e.dbgCuN >= 0 { return e.dbgCuN }
    e.dbgCuN = e.dbgNew()
    f := e.dbgFile(e.P.L.Mods[e.P.L.Root].File)
    e.dbgShared(e.dbgCuN, $"distinct !DICompileUnit(language: DW_LANG_C, file: !" $f ", producer: \"olang\", " $
                "isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug)")
    return e.dbgCuN
}

# a source file's DIFile, its path as the build names it and the working directory beside it
fn (e mut Emitter&) dbgFile(file I64) I64 {
    if e.dbgFiles.Has(file) { return try e.dbgFiles.Get(file) catch default -1 }
    n := e.dbgNew()
    e.dbgFiles.Put(file, n)
    path := e.D.PathOf(file)
    dir := try os.Cwd() catch os.OsError default "."
    e.dbgShared(n, $"!DIFile(filename: \"" $escape(path) "\", directory: \"" $escape(dir) "\")")
    return n
}

fn (e mut Emitter&) dbgSubTy() I64 {
    if e.dbgSubN < 0 {
        e.dbgSubN = e.dbgNew()
        e.dbgShared(e.dbgSubN, "!DISubroutineType(types: !{})")
    }
    return e.dbgSubN
}

# the debug type a variable of type ty is shown as (B2e): a number's and Bool's basic type, a reference a pointer to
# what it names, a struct, a tuple or a record its fields by name and offset, a fixed array its elements, a run-time
# array its length and a pointer to its elements (text so shown as characters), an enum its cases (the tag and the
# payload's words where one carries a payload), a function value its code and environment - -1 for what has no
# layout. Each is made once, before its parts, so a type that holds itself through a reference is described once
fn (e mut Emitter&) dbgType(ty types.TypeId) I64 {
    t := e.T
    r := t.Repr(ty)
    if r >= types.BoolT and r <= types.TypeId(14) {
        if e.dbgBasics.Has(I64(r)) { return try e.dbgBasics.Get(I64(r)) catch default -1 }
        n := e.dbgNew()
        e.dbgBasics.Put(I64(r), n)
        enc := "DW_ATE_boolean" if r == types.BoolT else "DW_ATE_float" if t.IsFloat(r) else "DW_ATE_unsigned" if t.IsUnsigned(r) else "DW_ATE_signed"
        # a byte as a character, as C's unsigned char, so that text's elements print as text
        if t.Bits(r) == 8 and t.IsUnsigned(r) { enc = "DW_ATE_unsigned_char" }
        bits := 8 if r == types.BoolT else t.Bits(r)
        e.dbgShared(n, $"!DIBasicType(name: \"" $t.Canon(r) "\", size: " $bits ", encoding: " $enc ")")
        return n
    }
    if e.dbgTypes.Has(I64(r)) { return try e.dbgTypes.Get(I64(r)) catch default -1 }
    k := t.KindOf(r)
    if k == types.Kind.Ref {
        rt := t.Referent(r)
        if e.ty(r) != "ptr" { return e.dbgPair(r, "len", t.Prim("I64"), "data", t.Elem(t.Repr(rt))) }
        n := e.dbgNew()
        e.dbgTypes.Put(I64(r), n)
        b := e.dbgType(rt)
        e.dbgShared(n, $"!DIDerivedType(tag: DW_TAG_pointer_type, baseType: " $("!" $b if b >= 0 else "null") ", size: 64)")
        return n
    }
    if k == types.Kind.Func { return e.dbgPair(r, "code", types.UnknownT, "env", types.UnknownT) }
    e.P.Layout(r)
    size := t.Size(r) * 8
    if k == types.Kind.Array {
        if t.Length(r) == types.TypeId(0) { return e.dbgPair(r, "len", t.Prim("I64"), "data", t.Elem(r)) }
        n := e.dbgNew()
        e.dbgTypes.Put(I64(r), n)
        el := e.dbgType(t.Elem(r))
        if el < 0 { el = e.dbgBytes() }
        sub := e.dbgNew()
        e.dbgShared(sub, $"!{!DISubrange(count: " $t.ConstValue(t.Length(r)) ")}")
        e.dbgShared(n, $"!DICompositeType(tag: DW_TAG_array_type, baseType: !" $el ", size: " $size ", elements: !" $sub ")")
        return n
    }
    isStruct := k == types.Kind.Tuple or k == types.Kind.Record or (k == types.Kind.Named and t.DeclKindOf(t.DeclOf(r)) == types.DeclKind.Struct)
    if isStruct {
        n := e.dbgNew()
        e.dbgTypes.Put(I64(r), n)
        fs := t.Items(t.Parts(r) if k != types.Kind.Named else t.Fields(r))
        names := e.fieldNames(r, fs.Len())
        offs := t.Offsets(r)
        ms StringBuilder
        for i in range fs.Len() {
            e.P.Layout(fs[i])
            mt := e.dbgType(fs[i])
            if mt < 0 { mt = e.dbgBytes() }
            m := e.dbgNew()
            e.dbgShared(m, $"!DIDerivedType(tag: DW_TAG_member, name: \"" $escape(names[i]) "\", baseType: !" $mt ", size: " $
                        (t.Size(fs[i]) * 8) ", offset: " $(offs[i] * 8) ")")
            if i > 0 { ms.Push(", ") }
            ms.Push($"!" $m)
        }
        el := e.dbgNew()
        e.dbgShared(el, $"!{" $ms.ToString() "}")
        e.dbgShared(n, $"!DICompositeType(tag: DW_TAG_structure_type, name: \"" $escape(e.dbgTypeName(r)) "\", size: " $size $
                    ", elements: !" $el ")")
        return n
    }
    isEnum := k == types.Kind.AnonEnum or (k == types.Kind.Named and t.DeclKindOf(t.DeclOf(r)) == types.DeclKind.Enum)
    if isEnum {
        n := e.dbgNew()
        e.dbgTypes.Put(I64(r), n)
        cn := t.CaseNames(r) if k == types.Kind.Named else null
        cs := t.Items(t.ShapeCases(r) if k == types.Kind.AnonEnum else t.Cases(r))
        es StringBuilder
        for i in range cs.Len() {
            m := e.dbgNew()
            name := e.text(cn[i]) if cn != null and i < cn.Len() else $i
            e.dbgShared(m, $"!DIEnumerator(name: \"" $escape(name) "\", value: " $i ")")
            if i > 0 { es.Push(", ") }
            es.Push($"!" $m)
        }
        el := e.dbgNew()
        e.dbgShared(el, $"!{" $es.ToString() "}")
        words := e.enumWords(r)
        tag := n if not words else e.dbgNew()
        tbase := e.dbgType(t.Prim("I64") if words else t.Prim("I32"))
        e.dbgShared(tag, $"!DICompositeType(tag: DW_TAG_enumeration_type, name: \"" $escape(e.dbgTypeName(r)) "\", size: " $
                    (64 if words else 32) ", baseType: !" $tbase ", elements: !" $el ")")
        if not words { return n }
        # the case, then the payload's words (its fields share them, by case)
        w := t.PayloadSize(r) / 8
        pw := e.dbgNew()
        sub := e.dbgNew()
        e.dbgShared(sub, $"!{!DISubrange(count: " $w ")}")
        e.dbgShared(pw, $"!DICompositeType(tag: DW_TAG_array_type, baseType: !" $e.dbgType(t.Prim("I64")) ", size: " $(w * 64) $
                    ", elements: !" $sub ")")
        m0, m1, ml := e.dbgNew(), e.dbgNew(), e.dbgNew()
        e.dbgShared(m0, $"!DIDerivedType(tag: DW_TAG_member, name: \"case\", baseType: !" $tag ", size: 64, offset: 0)")
        e.dbgShared(m1, $"!DIDerivedType(tag: DW_TAG_member, name: \"payload\", baseType: !" $pw ", size: " $(w * 64) ", offset: 64)")
        e.dbgShared(ml, $"!{!" $m0 ", !" $m1 "}")
        e.dbgShared(n, $"!DICompositeType(tag: DW_TAG_structure_type, name: \"" $escape(e.dbgTypeName(r)) "\", size: " $size $
                    ", elements: !" $ml ")")
        return n
    }
    return -1
}

# the pair a run-time array or a function value is: two words, the second a pointer to b's description (the first a
# number of type a, or both pointers to nothing where a is Unknown)
fn (e mut Emitter&) dbgPair(r types.TypeId, an String&, a types.TypeId, bn String&, b types.TypeId) I64 {
    n := e.dbgNew()
    e.dbgTypes.Put(I64(r), n)
    at := e.dbgVoidPtr()
    if a != types.UnknownT { at = e.dbgType(a) }
    bt := e.dbgVoidPtr()
    if b != types.UnknownT {
        bd := e.dbgType(b)
        bt = e.dbgNew()
        e.dbgShared(bt, $"!DIDerivedType(tag: DW_TAG_pointer_type, baseType: " $("!" $bd if bd >= 0 else "null") ", size: 64)")
    }
    m0, m1, ml := e.dbgNew(), e.dbgNew(), e.dbgNew()
    e.dbgShared(m0, $"!DIDerivedType(tag: DW_TAG_member, name: \"" $an "\", baseType: !" $at ", size: 64, offset: 0)")
    e.dbgShared(m1, $"!DIDerivedType(tag: DW_TAG_member, name: \"" $bn "\", baseType: !" $bt ", size: 64, offset: 64)")
    e.dbgShared(ml, $"!{!" $m0 ", !" $m1 "}")
    e.dbgShared(n, $"!DICompositeType(tag: DW_TAG_structure_type, name: \"" $escape(e.dbgTypeName(r)) "\", size: 128, elements: !" $
                ml ")")
    return n
}

fn (e mut Emitter&) dbgVoidPtr() I64 {
    if e.dbgPtrN < 0 {
        e.dbgPtrN = e.dbgNew()
        e.dbgShared(e.dbgPtrN, "!DIDerivedType(tag: DW_TAG_pointer_type, baseType: null, size: 64)")
    }
    return e.dbgPtrN
}

# a part with no description of its own shown as its bytes
fn (e mut Emitter&) dbgBytes() I64 { return e.dbgType(e.T.Prim("U8")) }

# a type's name as a debugger shows it: as the program writes it, its module left off
fn (e mut Emitter&) dbgTypeName(r types.TypeId) String {
    c := e.T.Canon(r)
    k := try c.Find(":") catch default -1
    return $c[k + 1:] if k >= 0 and not c.StartsWith("Array<") else $c
}

# a struct's field names in order, from its constructor's field declarations (C2); a tuple's or a record's by position
fn (e mut Emitter&) fieldNames(r types.TypeId, n I64) Array<String&> {
    out := Array<String&>(n, "")
    for i in range n { out[i] = $i }
    if e.T.KindOf(r) != types.Kind.Named { return out }
    td := e.P.TypeDecl(e.T.DeclOf(r))
    if td == null or td.Body == null { return out }
    match td.Body {
        case ast.TypeBody.Struct(sb) {
            if sb.Body == null { return out }
            k I64 = 0
            for st in sb.Body {
                match st {
                    case ast.Stmt.Var(_, v) {
                        if v.Field {
                            for vn in v.Names {
                                if k < n { out[k] = $e.text(vn) }
                                k++
                            }
                        }
                    }
                    nomatch { }
                }
            }
        }
        nomatch { }
    }
    return out
}

# the name a debugger knows a function by: a function's or a method's own (no linkage name - with a C compile unit
# gdb would take it for the name, and "break f" would find nothing), a type's constructor and destructor by the type
fn (e mut Emitter&) dbgName(k mir.FnKey) String {
    t := e.T
    match k {
        case mir.FnKey.Body(id) {
            return match e.Lw.Bodies[I64(id)].Of {
                case typed.BodyOf.Fn(inst) => $e.text(e.P.FnDecl(e.P.InstanceFn(inst)).Name)
                case typed.BodyOf.Ctor(ty, _) => $t.Canon(ty)
                case typed.BodyOf.Dtor(ty) => $t.Canon(ty) ".dtor"
                case typed.BodyOf.Lambda(_) => "lambda"
                case typed.BodyOf.Test(_) => "test"
                case typed.BodyOf.Global(_, n) => $e.text(n) ".init"
                case _ => e.sym(k)
            }
        }
        case _ { return e.sym(k) }
    }
}

# the function's subprogram, where it has source to point at
fn (fe mut fnEm&) subprogram() {
    f := fe.F
    if f.File < 0 or (f.Sp.Start == I32(0) and f.Sp.End == I32(0)) { return }
    e := fe.E
    file := e.dbgFile(f.File)
    line := e.D.LineAt(f.File, I64(f.Sp.Start))
    fe.dbgSp = e.dbgNew()
    fe.dbgMeta.Push($"!" $fe.dbgSp " = distinct !DISubprogram(name: \"" $escape(e.dbgName(f.Of)) "\", scope: !" $file $
                    ", file: !" $file ", line: " $line ", type: !" $e.dbgSubTy() ", scopeLine: " $line $
                    ", spFlags: DISPFlagDefinition, unit: !" $e.dbgCu() ")\n")
}

# the location of a line of this function, made once
fn (fe mut fnEm&) dbgLine(line I64) String {
    n := try fe.dbgLocs.Get(line) catch default -1
    if n < 0 {
        n = fe.E.dbgNew()
        fe.dbgLocs.Put(line, n)
        fe.dbgMeta.Push($"!" $n " = !DILocation(line: " $line ", column: 1, scope: !" $fe.dbgSp ")\n")
    }
    return ", !dbg !" $n
}

# what the entry's calls and the code before the first statement carry: the function's own line (the prologue's other
# instructions carry nothing, so the debugger stops after the parameters are stored, as clang's)
fn (fe mut fnEm&) dbgEntry() String {
    if fe.dbgSp < 0 { return "" }
    return fe.dbgLine(fe.E.D.LineAt(fe.F.File, I64(fe.F.Sp.Start)))
}

# the instructions written from now on at sp's line; a span lowering made up (none) keeps the line before, and so
# does the function's own (its frame's opening and closing), so that the debugger stops at the first statement
fn (fe mut fnEm&) locate(sp source.Span) {
    if sp.Start == I32(0) and sp.End == I32(0) { return }
    if sp.Start == fe.F.Sp.Start and sp.End == fe.F.Sp.End { return }
    fe.dbgLoc = fe.dbgLine(fe.E.D.LineAt(fe.F.File, I64(sp.Start)))
}

# each named parameter and local in a frame slot, described where the debugger can show it (info args, info locals)
fn (fe mut fnEm&) declareVars(b mut StringBuilder&) {
    e := fe.E
    f := fe.F
    file := e.dbgFile(f.File)
    arg I64 = 0
    for i in range f.Locals.Len() {
        l := f.Locals[i]
        if l.Kind == mir.LocalKind.Param { arg++ }
        if l.Kind != mir.LocalKind.Param and l.Kind != mir.LocalKind.Var { continue }
        if l.Name == source.NameId(0) or not fe.isFrame(l.Home) { continue }
        name := e.text(l.Name)
        if name == "" or name.StartsWith("$") { continue }
        if fe.size(l.Ty) > 65536 { continue }
        dt := e.dbgType(l.Ty)
        if dt < 0 { continue }
        n := e.dbgNew()
        line := e.D.LineAt(f.File, I64(l.Sp.Start)) if l.Sp.Start != I32(0) else e.D.LineAt(f.File, I64(f.Sp.Start))
        argText := ", arg: " $arg if l.Kind == mir.LocalKind.Param else ""
        fe.dbgMeta.Push($"!" $n " = !DILocalVariable(name: \"" $escape(name) "\"" $argText ", scope: !" $fe.dbgSp $
                        ", file: !" $file ", line: " $line ", type: !" $dt ")\n")
        e.declare("llvm.dbg.declare", "void @llvm.dbg.declare(metadata, metadata, metadata)")
        b.Push("  call void @llvm.dbg.declare(metadata ptr %l" $i ", metadata !" $n ", metadata !DIExpression())" $
               fe.dbgEntry() "\n")
    }
}

fn stmtSpan(s mir.Stmt) source.Span {
    return match s {
        case mir.Stmt.Assign(sp, _, _), mir.Stmt.Live(sp, _), mir.Stmt.Dead(sp, _), mir.Stmt.Open(sp, _) => sp
        case mir.Stmt.Close(sp, _), mir.Stmt.Give(sp, _), mir.Stmt.RegisterDtor(sp, _, _, _) => sp
        case mir.Stmt.RegisterOwner(sp, _, _), mir.Stmt.Release(sp, _), mir.Stmt.Write(sp, _, _, _) => sp
        case mir.Stmt.CopyElems(sp, _, _, _), mir.Stmt.Spawn(sp, _, _), mir.Stmt.Raised(sp) => sp
    }
}

fn termSpan(tm mir.Term) source.Span {
    return match tm {
        case mir.Term.Call(sp, _), mir.Term.Return(sp, _), mir.Term.Raise(sp, _) => sp
        case mir.Term.Wait(sp, _, _, _, _), mir.Term.Exit(sp, _, _) => sp
        case _ => source.Span(I32(0), I32(0))
    }
}

# ---- types ----

# a type's LLVM spelling, every declared struct it names recorded to be defined
fn (e mut Emitter&) ty(t types.TypeId) String {
    if t == types.NullT { return "ptr" }
    if t == types.UnknownT {
        e.gap("an unknown type")
        return "i8"
    }
    if not e.P.Layout(t) {
        e.badType = true
        e.gap("a type with no layout: " $e.T.Canon(t))
    }
    e.need(t)
    return $e.T.Llvm(t)
}

fn (e mut Emitter&) need(t types.TypeId) {
    tt := e.T
    r := tt.Repr(t)
    match tt.KindOf(r) {
        case types.Kind.Named {
            if tt.DeclKindOf(tt.DeclOf(r)) == types.DeclKind.Struct and not e.namedSeen.Has(r) {
                e.namedSeen.Put(r, true)
                e.named.Push(r)
                for x in tt.Embedded(r) { e.need(x) }
            }
        }
        case types.Kind.Array, types.Kind.Tuple, types.Kind.Record {
            for x in tt.Embedded(r) { e.need(x) }
        }
        case _ { }
    }
}

# ---- the tail: globals, constants, declarations ----

# where an item lives in a build of one object per module (DESIGN.md 1.9): a module's index (its functions and
# globals, defined there and declared where named elsewhere), or one of these
HomeShared I64 = -1     # copied, as written, into every object naming it: a declaration, a linkonce_odr helper or thunk
HomeLocal I64 = -2      # copied into every object naming it, internal and renamed there (constants, lambdas, tasks)
HomeInst I64 = -3       # the generics' instances (B3d): the root's own object of them

# an item: its symbol, text (whole lines), home and how another object declares it; the first one made of a symbol
# stands
fn (e mut Emitter&) item(symbol String&, home I64, text String&, decl String& = "") {
    if e.itemAt.Has(symbol) { return }
    e.itemAt.Put($symbol, e.itemSym.Len())
    e.itemSym.Push($symbol)
    e.itemText.Push($text)
    e.itemHome.Push(home)
    e.itemDecl.Push($decl)
    e.itemRefs.Push(null)
}

# item i's references, found once
fn (e mut Emitter&) refs(i I64) Array<I64>&e {
    if e.itemRefs[i] == null { e.itemRefs[i] = refsIn(e.itemText[i]).ToArray() }
    return e.itemRefs[i]
}

fn (e mut Emitter&) has(symbol String&) Bool { return e.itemAt.Has(symbol) }

fn (e mut Emitter&) define(symbol String&, text String&) { e.item(symbol, HomeShared, $text "\n") }

# text copied out of a builder (E11b): a short one - the commonest, a number or a word - by two overlapping moves of
# its own width rather than a call of memcpy, so that a join costs what stage 0's measured write does
fn (e mut Emitter&) textCopy() {
    if e.has("olang_textcopy") { return }
    e.declare("llvm.memcpy.p0.p0.i64", "void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
    b := StringBuilder()
    b.Push("define linkonce_odr hidden void @olang_textcopy(ptr %d, ptr %s, i64 %n) alwaysinline {\nentry:\n")
    b.Push("  %big = icmp ugt i64 %n, 16\n  br i1 %big, label %call, label %s8\n")
    b.Push("call:\n  call void @llvm.memcpy.p0.p0.i64(ptr %d, ptr %s, i64 %n, i1 false)\n  ret void\n")
    b.Push("s8:\n  %ge8 = icmp uge i64 %n, 8\n  br i1 %ge8, label %w8, label %s4\n")
    b.Push("w8:\n  %e8 = sub i64 %n, 8\n  %a8 = load i64, ptr %s, align 1\n  %sb8 = getelementptr i8, ptr %s, i64 %e8\n")
    b.Push("  %b8 = load i64, ptr %sb8, align 1\n  store i64 %a8, ptr %d, align 1\n  %db8 = getelementptr i8, ptr %d, i64 %e8\n")
    b.Push("  store i64 %b8, ptr %db8, align 1\n  ret void\n")
    b.Push("s4:\n  %ge4 = icmp uge i64 %n, 4\n  br i1 %ge4, label %w4, label %s1\n")
    b.Push("w4:\n  %e4 = sub i64 %n, 4\n  %a4 = load i32, ptr %s, align 1\n  %sb4 = getelementptr i8, ptr %s, i64 %e4\n")
    b.Push("  %b4 = load i32, ptr %sb4, align 1\n  store i32 %a4, ptr %d, align 1\n  %db4 = getelementptr i8, ptr %d, i64 %e4\n")
    b.Push("  store i32 %b4, ptr %db4, align 1\n  ret void\n")
    b.Push("s1:\n  %none = icmp eq i64 %n, 0\n  br i1 %none, label %done, label %w1\n")
    b.Push("w1:\n  %h = lshr i64 %n, 1\n  %e1 = sub i64 %n, 1\n  %a1 = load i8, ptr %s\n  %sh = getelementptr i8, ptr %s, i64 %h\n")
    b.Push("  %m1 = load i8, ptr %sh\n  %se = getelementptr i8, ptr %s, i64 %e1\n  %z1 = load i8, ptr %se\n  store i8 %a1, ptr %d\n")
    b.Push("  %dh = getelementptr i8, ptr %d, i64 %h\n  store i8 %m1, ptr %dh\n  %de = getelementptr i8, ptr %d, i64 %e1\n")
    b.Push("  store i8 %z1, ptr %de\n  br label %done\ndone:\n  ret void\n}\n")
    e.item("olang_textcopy", HomeShared, b.ToString())
}

# a runtime function or a C library function, declared once
fn (e mut Emitter&) declare(name String&, text String&) { e.define(name, "declare " $text) }

fn (e mut Emitter&) global(m I64, n source.NameId, t types.TypeId) String {
    s := e.globalSym(m, n)
    if e.has(s) { return "@" $s }
    b := e.globalBody(m, n)
    if b >= 0 and e.Baked.Has(b) {
        img := try e.Baked.Get(b) catch default eval.Image()
        text := e.bakedText(s, img)
        at := try text.Find(" = constant ") catch default -1
        end := try text.Find("}>") catch default -1
        decl := $"@" $s " = external constant " $text[at + 12:end + 2] if at >= 0 and end > at else $"@" $s " = external global i8"
        # K2: plain data an importer declares with its value, which its optimizer reads before the link
        if img.Blobs.Len() == 1 and img.Blobs[0].At.Len() == 0 and at >= 0 {
            decl = $"@" $s " = available_externally constant " $text[at + 12:text.Len() - 1]
        }
        e.item(s, m, text, $decl "\n")
    } else {
        ty := e.ty(t)
        e.item(s, m, $"@" $s " = global " $ty " zeroinitializer\n", $"@" $s " = external global " $ty "\n")
    }
    return "@" $s
}

# a baked global's definition (K2, K2b): its storage, then each blob it reaches as a private global beside it - the
# bytes as the evaluator laid them out, the target's layout, a reference among them the address it names
fn (e mut Emitter&) bakedText(s String&, img eval.Image&) String {
    out := StringBuilder()
    for j in range img.Blobs.Len() {
        b := img.Blobs[j]
        name := "@" $s if j == 0 else "@" $s ".k" $j
        # K2: an immutable global's own storage is never written once set - only immutable ones are baked - so it is a
        # constant, whose loads LLVM folds
        kind := "constant" if j == 0 else "internal constant" if b.Constant else "internal global"
        tyText, valText := StringBuilder(), StringBuilder()
        at I64 = 0
        for r in range b.At.Len() + 1 {
            end := b.At[r] if r < b.At.Len() else b.Bytes.Len()
            if end > at {
                if tyText.Len() > 0 {
                    tyText.Push(", ")
                    valText.Push(", ")
                }
                tyText.Push("[" $(end - at) " x i8]")
                valText.Push("[" $(end - at) " x i8] c\"")
                for i in range at, end { valText.Push(hexByte(b.Bytes[i])) }
                valText.Push("\"")
            }
            if r == b.At.Len() { break }
            if tyText.Len() > 0 {
                tyText.Push(", ")
                valText.Push(", ")
            }
            to := "@" $s if b.To[r] == 0 else "@" $s ".k" $b.To[r]
            tyText.Push("ptr")
            if b.Off[r] == 0 {
                valText.Push("ptr " $to)
            } else {
                valText.Push("ptr getelementptr (i8, ptr " $to ", i64 " $b.Off[r] ")")
            }
            at = b.At[r] + 8
        }
        out.Push($name " = " $kind " <{ " $tyText.ToString() " }> <{ " $valText.ToString() " }>, align " $b.Align "\n")
    }
    return out.ToString()
}

fn hexByte(c U8) String {
    digits := "0123456789ABCDEF"
    return "\\" $digits[I64(c >> 4)] $digits[I64(c & 15)]
}

# a C string constant, NUL-terminated: its symbol
fn (e mut Emitter&) cstr(text String&) String {
    key := "c:" $text
    if e.dataAt.Has(key) { return try e.dataAt.Get(key) catch default "" }
    s := "@.c" $e.nconst
    e.nconst++
    e.item(s[1:], HomeLocal, $s " = private unnamed_addr constant [" $(text.Len() + 1) " x i8] c\"" $escape(text) "\\00\"\n")
    e.dataAt.Put($key, $s)
    return s
}

fn escape(t String&) String {
    b := StringBuilder()
    for c in t {
        if c == '"' or c == '\\' or U8(c) < U8(32) or U8(c) > U8(126) {
            b.PushChar('\\')
            b.Push(U8(c).Format(16).PadStart(2, '0').ToUpper())
        } else {
            b.PushChar(c)
        }
    }
    return b.ToString()
}


# ---- alias tags (T36) ----

# the type tree the access tags name, stage 0's numbering: one root, a leaf per tagged type, all siblings - so two
# different tagged types are proven not to alias, and anything untagged aliases everything. Bool and each number (T4)
# have two leaves, a field's and an element's (the same type reached by indexing, "[]"); the run-time-length array's
# descriptor { i64, ptr } and a reference to a struct or an enum (one pointer, "ref") two each; a closure's environment
# one (written where the closure is made, read only by its code); the runtime's scope and chunk headers one each, the
# tags its inlined bodies carry (std/runtime/runtime.ll's !59, !60)
tbaaTree String& = ("\n!20 = !{!\"olang\"}\n"
                    "!49 = !{!\"scopehdr\", !20, i64 0}\n!50 = !{!\"chunkhdr\", !20, i64 0}\n"
                    "!59 = !{!49, !49, i64 0}\n!60 = !{!50, !50, i64 0}\n"
                    "!17 = !{!\"arraydesc\", !20, i64 0}\n!18 = !{!\"closure\", !20, i64 0}\n"
                    "!47 = !{!\"arraydesc[]\", !20, i64 0}\n!19 = !{!\"ref\", !20, i64 0}\n"
                    "!48 = !{!\"ref[]\", !20, i64 0}\n!29 = !{!19, !19, i64 0}\n!39 = !{!48, !48, i64 0}\n"
                    "!27 = !{!17, !17, i64 0}\n!28 = !{!18, !18, i64 0}\n!37 = !{!47, !47, i64 0}\n" $tbaaLeaves() "\n")

# by primitive id (types.primNames): the leaf's name, its field and element access tags (a field's type node at the
# tag less 10, an element's at the tag plus 10)
tbaaName := String&["", "", "bool", "i8", "i16", "int32", "int64", "byte", "u16", "u32", "u64", "f16", "bf16", "float32"
                    "float64"]
tbaaField := I64[0, 0, 21, 61, 62, 23, 24, 22, 63, 64, 65, 66, 67, 25, 26]
tbaaElem := I64[0, 0, 31, 81, 82, 33, 34, 32, 83, 84, 85, 86, 87, 35, 36]

fn tbaaLeaves() String {
    b := StringBuilder()
    for i in range 2, 15 {
        f, x := tbaaField[i], tbaaElem[i]
        b.Push("!" $(f - 10) " = !{!\"" $tbaaName[i] "\", !20, i64 0}\n!" $f " = !{!" $(f - 10) ", !" $(f - 10) ", i64 0}\n")
        b.Push("!" $(x + 10) " = !{!\"" $tbaaName[i] "[]\", !20, i64 0}\n!" $x " = !{!" $(x + 10) ", !" $(x + 10) ", i64 0}\n")
    }
    return b.ToString()
}

# the access tag of a value of type ty in storage reached as an element (elem) or a field: Bool's and each number's
# (a declared type's its base's), a run-time-length array's descriptor, a reference to a struct or an enum; empty -
# untagged, aliasing anything - for an aggregate, a fixed array, a function value
fn (e mut Emitter&) tbaa(ty types.TypeId, elem Bool) String {
    t := e.T
    r := t.Repr(ty)
    if r >= types.BoolT and r <= types.TypeId(14) { return ", !tbaa !" $(tbaaElem[I64(r)] if elem else tbaaField[I64(r)]) }
    if t.KindOf(r) == types.Kind.Array and t.Length(r) == types.TypeId(0) { return e.descTag(elem, false) }
    if t.IsRef(r) {
        x := t.Repr(t.Referent(r))
        k := t.KindOf(x)
        if k == types.Kind.Array and t.Length(x) == types.TypeId(0) { return e.descTag(elem, false) }
        if k == types.Kind.Named or k == types.Kind.AnonEnum { return ", !tbaa !39" if elem else ", !tbaa !29" }
    }
    return ""
}

# the descriptor's tag, untagged within a payload
fn (e mut Emitter&) descTag(elem Bool, payload Bool) String {
    if payload { return "" }
    return ", !tbaa !37" if elem else ", !tbaa !27"
}

# ---- a function ----

# one MIR function being written: its text in two parts, the entry block's allocas (head) and the blocks (code)
type fnEm struct(E mut Emitter&, F mir.Fn&, Key mir.FnKey) {
    E
    F
    Key
    head StringBuilder
    pro StringBuilder
    code StringBuilder
    n I64 = 0
    passed I64 = 0
    frameScope I64 = -1
    res types.TypeId = types.VoidT
    errs Bool = false
    via Bool = false
    env Bool = false
    big Bool = false
    tagAt String& = ""      # T36: the access tag of the place addr last found, for a scalar there (empty: untagged)
    # B2e, in a -debug build: this function's subprogram (-1 none), the location every instruction written now carries
    # (", !dbg !N"), a location per line, and the metadata written after the function
    dbgSp I64 = -1
    dbgLoc String& = ""
    dbgLocs Map<I64, I64>
    dbgMeta StringBuilder
    sites Map<I32, I64>     # S18d: where this function's calls (1) and joins (2) are, by the start of their span
    sited Bool = false
    # E11b: the builders whose text is measured and then written straight where it lands (direct), and the pieces of
    # the one being written
    direct Map<I64, Bool>
    pieceKinds List<mir.WriteKind>
    pieceOps List<mir.Operand>
}

# S18d: what a Raise at sp did, as the evaluator reads it (eval.traced): passed on the error of the call or join
# at the same place - "try passed it on", a join's failure restarting the trace with its own line - else it raised it
fn (fe mut fnEm&) trace(sp source.Span) {
    if not fe.E.traced() { return }
    if not fe.sited {
        fe.sited = true
        for b in fe.F.Blocks {
            match b.T {
                case mir.Term.Call(csp, _) { fe.sites.Put(csp.Start, 1) }
                case mir.Term.Wait(wsp, _, _, _, _) { fe.sites.Put(wsp.Start, 2) }
                case _ { }
            }
        }
    }
    k := try fe.sites.Get(sp.Start) catch default 0
    what := "try passed it on" if k == 1 else ("a task failed, and its join passed it on" if k == 2 else "raised here")
    rf := "__olang_ert_pass" if k == 1 else "__olang_ert_raise"
    fe.E.declare(rf, $"void @" $rf "(ptr)")
    fe.w($"call void @" $rf "(ptr " $fe.E.cstr($fe.E.where(fe.F.File, sp) ": " $what "\n") ")")
}

fn (fe mut fnEm&) tmp() String {
    fe.n++
    return "%t" $fe.n
}

fn (fe mut fnEm&) w(line String&) {
    fe.code.Push("  ")
    fe.code.Push(line)
    # B2e: before the first statement's line only a call is located (the verifier wants it), so the debugger stops at
    # the first statement, as clang's prologue_end does
    if fe.dbgLoc != "" {
        fe.code.Push(fe.dbgLoc)
    } else if fe.dbgSp >= 0 and line.Contains("call ") {
        fe.code.Push(fe.dbgEntry())
    }
    fe.code.PushChar('\n')
}

fn (fe mut fnEm&) label(name String&) {
    fe.code.Push(name)
    fe.code.Push(":\n")
}

fn (fe mut fnEm&) fresh(base String&) String {
    fe.n++
    return $base "." $fe.n
}

# an alloca in the entry block (O2c): its name
fn (fe mut fnEm&) alloca(ty String&, align I64 = 0) String {
    t := fe.tmp()
    fe.head.Push("  " $t " = alloca " $ty)
    if align > 0 { fe.head.Push(", align " $align) }
    fe.head.PushChar('\n')
    return t
}

fn (fe mut fnEm&) ty(t types.TypeId) String { return fe.E.ty(t) }

fn (fe mut fnEm&) size(t types.TypeId) I64 {
    fe.E.P.Layout(t)
    return fe.E.T.Size(t)
}

fn (fe mut fnEm&) align(t types.TypeId) I64 {
    fe.E.P.Layout(t)
    return fe.E.T.Align(t)
}

# a value computed into a temporary: "%tN = TEXT"
fn (fe mut fnEm&) let(text String&) String {
    t := fe.tmp()
    fe.w($t " = " $text)
    return t
}

fn (fe mut fnEm&) load(ty String&, at String&, tag String& = "") String { return fe.let("load " $ty ", ptr " $at $tag) }

fn (fe mut fnEm&) store(ty String&, v String&, at String&, tag String& = "") { fe.w("store " $ty " " $v ", ptr " $at $tag) }

fn blockName(b mir.BlockId) String { return "bb" $b }

fn (fe mut fnEm&) gap(what String&) { fe.E.gap(what) }

# the function's LLVM header: linkage, result, name and parameters
# a function's first line: "define LINK RET @SYM(PARAMS) #0 {" - or, with link "declare", how another object declares it
fn (e mut Emitter&) header(k mir.FnKey, ty types.TypeId, symbol String&, passed I64, env Bool, link String& = "internal") String {
    t := e.T
    b := StringBuilder()
    b.Push($("declare " if link == "declare" else $"define " $link " ") $t.RetLlvm(ty) " @" $symbol "(")
    first := true
    if env {
        b.Push("ptr %env")
        first = false
    }
    res := t.Result(ty)
    if res != types.VoidT and res != types.NoreturnT and t.ViaMemory(res) {
        if not first { b.Push(", ") }
        b.Push("ptr %out")
        first = false
    }
    for i in range passed {
        if not first { b.Push(", ") }
        b.Push("ptr %v" $i)
        first = false
    }
    ps := t.Items(t.Params(ty))
    pass := t.Passing(ty)
    for i in range ps.Len() {
        if not first { b.Push(", ") }
        first = false
        match pass[i] {
            case 'm' { b.Push("ptr %a" $i) }
            case 's' { b.Push("ptr %a" $i "c, ptr %a" $i "e") }
            case _ { b.Push($e.ty(ps[i]) " %a" $i) }
        }
    }
    b.Push(")\n" if link == "declare" else ") #0 {\n")
    return b.ToString()
}

# the linkage a function is defined with for its home
fn linkFor(home I64) String {
    return "internal" if home == HomeLocal else ("linkonce_odr" if home == HomeShared else "dso_local")
}

# where a function lives (HomeShared, HomeLocal, HomeInst or a module): a plain function, a non-generic type's
# constructor or destructor, a global's initializer and a module's initialization in their module; an instance (and a
# constructor's twin) with the instances; a test in the root; a helper is shared; a lambda, which a parameter's default
# makes in every module whose code calls it, local to each object
fn (e mut Emitter&) homeOf(k mir.FnKey) I64 {
    p := e.P
    match k {
        case mir.FnKey.Body(id) {
            match e.Lw.Bodies[I64(id)].Of {
                case typed.BodyOf.Fn(i) { return HomeInst if p.InstanceArgs(i) != types.ListId(0) else p.FnModule(p.InstanceFn(i)) }
                case typed.BodyOf.Ctor(ty, twin) { return HomeInst if twin != types.ListId(0) else e.typeHome(ty) }
                case typed.BodyOf.Dtor(ty) { return e.typeHome(ty) }
                case typed.BodyOf.Global(m, _) { return m }
                case typed.BodyOf.Test(_) { return p.L.Root }
                case _ { return HomeLocal }
            }
        }
        case mir.FnKey.Helper(_, _) { return HomeShared }
        case mir.FnKey.Adapter(call) { return e.homeOf(mir.FnKey.Body(call)) }
        case mir.FnKey.Init(m) { return m }
    }
}

fn (e mut Emitter&) typeHome(ty types.TypeId) I64 {
    t := e.T
    r := t.Repr(ty)
    if t.KindOf(r) != types.Kind.Named or t.Args(r) != types.ListId(0) { return HomeInst }
    return t.DeclModule(t.DeclOf(r))
}

# a function's item: its text, and its declaration for another object
fn (e mut Emitter&) fnItem(k mir.FnKey, ty types.TypeId, symbol String&, passed I64, env Bool, text String&) {
    home := e.homeOf(k)
    e.item(symbol, home, text, e.header(k, ty, symbol, passed, env, "declare"))
}

fn (e mut Emitter&) passedOf(k mir.FnKey, ty types.TypeId) I64 { return mir.PassedCount(e.T, mir.Callee.Fn(k, ty), ty) }

# one function lowered and written
fn (e mut Emitter&) function(k mir.FnKey) {
    f mir.Fn&e = e.Lw.LowerKey(k)
    symbol := e.sym(k)
    env := e.hasEnv(k)
    passed := e.passedOf(k, f.Ty)
    hdr := e.header(k, f.Ty, symbol, passed, env, linkFor(e.homeOf(k)))
    bad := "" if e.Lw.Gapped else f.Verify(e.T)
    if e.Lw.Gapped or bad != "" {
        e.gap($"not lowered: " $symbol $(" (" $bad.Trim() ")" if bad != "" else ""))
        if e.isGlobalInit(k) {
            # a global's initializer: the global left at its zero value, so that the rest of the program still runs
            e.fnItem(k, f.Ty, symbol, passed, env, $hdr "entry:\n  ret void\n}\n\n")
            return
        }
        e.runtime("__olang_check_failed")
        e.fnItem(k, f.Ty, symbol, passed, env, $hdr $e.stub("not lowered", symbol))
        return
    }
    fe mut fnEm&e = fnEm(e, f, k)
    fe.passed = passed
    fe.env = env
    e.badType = false
    if e.Debug { fe.subprogram() }
    fe.run()
    if e.badType {
        # a type the program's layouts do not settle (a length a call computes, G21, is the evaluator's, M8)
        e.runtime("__olang_check_failed")
        e.fnItem(k, f.Ty, symbol, passed, env, $hdr $e.stub("not emitted", symbol))
        return
    }
    b := StringBuilder()
    if fe.dbgSp >= 0 {
        # B2e: the define line names its subprogram
        b.Push(hdr[:hdr.Len() - 2])
        b.Push(" !dbg !" $fe.dbgSp " {\n")
    } else {
        b.Push(hdr)
    }
    b.Push("entry:\n")
    b.Push(fe.head.ToString())
    b.Push(fe.pro.ToString())
    if fe.dbgSp >= 0 { fe.declareVars(b) }
    b.Push("  br label %start\n")
    b.Push(fe.code.ToString())
    b.Push("}\n")
    b.Push(fe.dbgMeta.ToString())
    b.PushChar('\n')
    e.fnItem(k, f.Ty, symbol, passed, env, b.ToString())
}

# the body of a function the compiler could not make: it fails when called, saying so
fn (e mut Emitter&) stub(what String&, symbol String&) String {
    msg := e.cstr($what " by the self-hosted compiler: " $symbol "\n")
    return $"entry:\n  call void @__olang_check_failed(ptr " $msg ")\n  unreachable\n}\n\n"
}

fn (fe mut fnEm&) run() {
    f := fe.F
    t := fe.E.T
    fe.res = t.Result(f.Ty)
    fe.errs = t.Items(t.Errors(f.Ty)).Len() > 0
    fe.via = fe.res != types.VoidT and fe.res != types.NoreturnT and t.ViaMemory(fe.res)
    for i in range f.Scopes.Len() {
        if f.Scopes[i].Kind == mir.ScopeKind.Frame and fe.frameScope < 0 { fe.frameScope = i }
    }
    # the locals, the scope headers and the result's slot
    # T7c: storage over 64KB never on the stack - a local that large comes from an arena of the frame's own, opened
    # here and closed at the one return
    for i in range f.Locals.Len() {
        l := f.Locals[i]
        if l.Ty == types.VoidT or l.Ty == types.NoreturnT { continue }
        lt := fe.ty(l.Ty)
        if not fe.isFrame(l.Home) {
            # its storage in an arena, made by its Live (O26a): the local's slot holds where it is
            fe.head.Push("  %lp" $i " = alloca ptr\n")
            if l.Kind != mir.LocalKind.Var and l.Kind != mir.LocalKind.Temp { fe.gap("a parameter or capture in an arena") }
        } else if fe.size(l.Ty) > 65536 {
            fe.bigArena()
            a := fe.align(l.Ty)
            fe.pro.Push("  %l" $i " = call ptr @__olang_scope_alloc_a(ptr %big, i64 " $fe.size(l.Ty) ", i64 " $(a if a > 8 else 8) ")\n")
        } else {
            fe.head.Push("  %l" $i " = alloca " $lt "\n")
        }
    }
    fe.findDirect()
    for i in range f.Scopes.Len() {
        if fe.direct.Has(i) { continue }
        if f.Scopes[i].Kind == mir.ScopeKind.Builder {
            fe.head.Push("  %s" $i " = alloca %olang.builder\n  %s" $i "room = alloca [64 x i8], align 8\n")
        } else {
            fe.head.Push("  %s" $i " = alloca %olang.scope\n")
            if f.Scopes[i].Kind == mir.ScopeKind.Join { fe.head.Push("  %jh" $i " = alloca ptr\n") }
            if fe.E.Tests { fe.head.Push("  %u" $i " = alloca %olang.unwind\n") }
        }
    }
    rt := t.RetLlvm(f.Ty)
    if rt != "void" { fe.head.Push("  %rv = alloca " $rt "\n") }
    # the parameters into their locals, the captures out of the environment
    pass := t.Passing(f.Ty)
    for i in range f.Params.Len() {
        l := I64(f.Params[i])
        lt := f.Locals[l].Ty
        if not fe.isFrame(f.Locals[l].Home) { fe.gap("a parameter homed in an arena") }
        match pass[i] {
            case 'm' {
                # the caller's copy, made before the call: moved into the local's storage
                fe.E.declare("llvm.memmove.p0.p0.i64", "void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)")
                fe.pro.Push("  call void @llvm.memmove.p0.p0.i64(ptr %l" $l ", ptr %a" $i ", i64 " $fe.size(lt) ", i1 false)\n")
            }
            case 's' {
                fe.pro.Push("  %pf" $i " = insertvalue { ptr, ptr } undef, ptr %a" $i "c, 0\n")
                fe.pro.Push("  %pg" $i " = insertvalue { ptr, ptr } %pf" $i ", ptr %a" $i "e, 1\n")
                fe.pro.Push("  store { ptr, ptr } %pg" $i ", ptr %l" $l "\n")
            }
            case _ { fe.pro.Push("  store " $fe.ty(lt) " %a" $i ", ptr %l" $l "\n") }
        }
    }
    # D9b: a by-value array parameter the body writes is the callee's own copy, else the caller's array
    fe.label("start")
    for i in range f.Params.Len() {
        l := f.Params[i]
        lt := f.Locals[I64(l)].Ty
        if fe.runTime(lt) and fe.writesInto(l) {
            v := fe.load("{ i64, ptr }", "%l" $l)
            fe.store("{ i64, ptr }", fe.copyArray(mir.ScopeRef.Program, v, lt), "%l" $l)
        }
    }
    fe.w("br label %bb0")
    if f.Captures.Len() > 0 {
        et := fe.envType()
        for i in range f.Captures.Len() {
            l := I64(f.Captures[i])
            lt := fe.ty(f.Locals[l].Ty)
            if not fe.isFrame(f.Locals[l].Home) { fe.gap("a capture homed in an arena") }
            fe.pro.Push("  %cp" $i " = getelementptr " $et ", ptr %env, i32 0, i32 " $i "\n")
            if fe.viaMem(f.Locals[l].Ty) {
                fe.E.declare("llvm.memmove.p0.p0.i64", "void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)")
                fe.pro.Push("  call void @llvm.memmove.p0.p0.i64(ptr %l" $l ", ptr %cp" $i ", i64 " $fe.size(f.Locals[l].Ty) ", i1 false)\n")
            } else {
                fe.pro.Push("  %cv" $i " = load " $lt ", ptr %cp" $i ", !tbaa !28\n")
                fe.pro.Push("  store " $lt " %cv" $i ", ptr %l" $l "\n")
            }
        }
        # the captured scopes (D16c), each as this thread may build into it: its own part of a scope another thread
        # owns, the program's (null) as this thread reaches it (P2, decision 48)
        fe.E.runtime("__olang_capture_scope")
        for j in range fe.E.capVars(f.Of) {
            fe.pro.Push("  %vq" $j " = getelementptr " $et ", ptr %env, i32 0, i32 " $(f.Captures.Len() + j) "\n")
            fe.pro.Push("  %vr" $j " = load ptr, ptr %vq" $j ", !tbaa !28\n")
            fe.pro.Push("  %vc" $j " = call ptr @__olang_capture_scope(ptr %vr" $j ")" $fe.dbgEntry() "\n")
        }
    }
    taken Map<I64, Bool>
    if fe.E.traced() {
        for b in f.Taken { taken.Put(I64(b), true) }
    }
    for b in range f.Blocks.Len() {
        fe.label(blockName(mir.BlockId(I32(b))))
        bb := f.Blocks[b]
        # S18d: a clause takes the error - the trace it left is no one's now
        if taken.Has(b) {
            fe.E.runtime("__olang_ert_clear")
            fe.w("call void @__olang_ert_clear()")
        }
        for s in bb.Stmts { fe.stmt(s) }
        fe.term(bb.T)
    }
    fe.label("ret")
    if fe.big { fe.w("call void @__olang_scope_close(ptr %big)") }
    if rt != "void" {
        fe.w("%rr = load " $rt ", ptr %rv")
        fe.w("ret " $rt " %rr")
    } else {
        fe.w("ret void")
    }
}

# the frame's own arena for storage over 64KB (T7c), opened at entry and closed at the one return
fn (fe mut fnEm&) bigArena() {
    if fe.big { return }
    fe.big = true
    fe.head.Push("  %big = alloca %olang.scope\n")
    fe.pro.Push("  store %olang.scope zeroinitializer, ptr %big\n")
    fe.E.runtime("__olang_scope_alloc_a")
    fe.E.runtime("__olang_scope_close")
}

# a value too large to carry as one LLVM value (types.ViaMemory: a struct, a tuple, a record or a fixed array over
# 128 bytes) - moved through memory, as stage 0 moves it: copied by memmove, built part by part, a parameter as a
# pointer to the callee's own copy, a result through the hidden out pointer. LLVM expands an aggregate value element by
# element, and a link of a program moving one of 72KB as a value ran for over half an hour
fn (fe mut fnEm&) viaMem(ty types.TypeId) Bool {
    if ty == types.VoidT or ty == types.NoreturnT or ty == types.UnknownT { return false }
    fe.E.P.Layout(ty)
    return fe.E.T.ViaMemory(ty)
}

# a slot of type ty in the frame: an alloca in the entry block, over 64KB storage from the frame's arena (T7c)
fn (fe mut fnEm&) slot(ty types.TypeId) String {
    if fe.size(ty) <= 65536 { return fe.alloca(fe.ty(ty), fe.align(ty)) }
    fe.bigArena()
    a := fe.align(ty)
    s := "%" $fe.fresh("bs")
    fe.pro.Push("  " $s " = call ptr @__olang_scope_alloc_a(ptr %big, i64 " $fe.size(ty) ", i64 " $(a if a > 8 else 8) ")\n")
    return s
}

fn (fe mut fnEm&) memmove(dst String&, src String&, n I64) {
    fe.E.declare("llvm.memmove.p0.p0.i64", "void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)")
    fe.w("call void @llvm.memmove.p0.p0.i64(ptr " $dst ", ptr " $src ", i64 " $n ", i1 false)")
}

# where an operand of a type moved through memory already is: a place's address, constant data's global; "" for
# none (a constant: all zero bits)
fn (fe mut fnEm&) srcAddr(x mir.Operand) String {
    match x {
        case mir.Operand.Copy(q) {
            at, _ := fe.addr(q)
            return at
        }
        case mir.Operand.Data(ty, c, file, sp) { return fe.data(ty, c, file, sp, true) }
        case _ { return "" }
    }
}

# operand x, of type ty, written into memory at at: a value too large to carry moved by memmove (all zero bits by a
# memset), anything else stored
fn (fe mut fnEm&) put(at String&, ty types.TypeId, x mir.Operand, tag String& = "") {
    if fe.viaMem(ty) {
        src := fe.srcAddr(x)
        if src != "" {
            if src != at { fe.memmove(at, src, fe.size(ty)) }
            return
        }
        match x {
            case mir.Operand.Const(_, _), mir.Operand.None {
                fe.E.declare("llvm.memset.p0.i64", "void @llvm.memset.p0.i64(ptr, i8, i64, i1)")
                fe.w("call void @llvm.memset.p0.i64(ptr " $at ", i8 0, i64 " $fe.size(ty) ", i1 false)")
                return
            }
            case _ { }
        }
    }
    fe.store(fe.ty(ty), fe.val(x, ty), at, tag)
}

# an assignment of a value moved through memory: a copy by memmove, an aggregate built where it lands - straight into
# the place where nothing its parts read can be the place, else in a slot of its own first
fn (fe mut fnEm&) intoPlace(p mir.Place, pt types.TypeId, rv mir.Rvalue) Bool {
    t := fe.E.T
    match rv {
        case mir.Rvalue.Use(x) {
            at, _ := fe.addr(p)
            fe.put(at, pt, x)
            return true
        }
        case mir.Rvalue.Aggregate(ty, _, args) {
            r := t.Repr(ty)
            k := t.KindOf(r)
            if k == types.Kind.AnonEnum or (k == types.Kind.Named and t.DeclKindOf(t.DeclOf(r)) == types.DeclKind.Enum) {
                return false
            }
            if fe.apart(p, args) {
                at, _ := fe.addr(p)
                fe.buildInto(at, pt, args)
                return true
            }
            tmp := fe.slot(pt)
            fe.buildInto(tmp, pt, args)
            at, _ := fe.addr(p)
            fe.memmove(at, tmp, fe.size(pt))
            return true
        }
        case _ { return false }
    }
}

# whether place p is a local of the frame no part in args can read: each a constant, constant data, or a copy of
# another local reached without a reference
fn (fe mut fnEm&) apart(p mir.Place, args mir.Range) Bool {
    dst := mir.NoLocal
    match p.B {
        case mir.Base.Local(l) { dst = l }
        case _ { return false }
    }
    if fe.derefs(p) { return false }
    for i in range args.N {
        match fe.arg(args, i) {
            case mir.Operand.Copy(q) {
                if fe.derefs(q) or fe.baseIs(q, dst) { return false }
                match q.B {
                    case mir.Base.Local(_) { }
                    case _ { return false }
                }
            }
            case _ { }
        }
    }
    return true
}

fn (fe mut fnEm&) derefs(p mir.Place) Bool {
    for i in range p.Path.N {
        match fe.F.Projs[I64(p.Path.At) + i] {
            case mir.Proj.Deref { return true }
            case _ { }
        }
    }
    return false
}

# an aggregate of a type moved through memory, built in place at at: each part written where it lives
fn (fe mut fnEm&) buildInto(at String&, ty types.TypeId, args mir.Range) {
    t := fe.E.T
    r := t.Repr(ty)
    lt := fe.ty(r)
    a := fe.arrayOf(r)
    if a != types.UnknownT {
        el := t.Elem(a)
        for i in range fe.fixedLen(a) {
            fe.put(fe.let("getelementptr " $lt ", ptr " $at ", i64 0, i64 " $i), el, fe.arg(args, i), fe.E.tbaa(el, true))
        }
        return
    }
    fs := t.Items(fe.fieldList(r))
    for i in range fs.Len() {
        fe.put(fe.let("getelementptr " $lt ", ptr " $at ", i32 0, i32 " $i), fs[i], fe.arg(args, i), fe.E.tbaa(fs[i], false))
    }
}

# an assignment written straight into its place where a value would be too large to carry: a fixed array built of one
# repeated element as a loop, of more than 16 as a store each, and a copy of an aggregate over 128 bytes as a memcpy -
# LLVM expands an aggregate value element by element, which for a million elements is a million instructions
fn (fe mut fnEm&) fillInPlace(p mir.Place, pt types.TypeId, rv mir.Rvalue) Bool {
    t := fe.E.T
    match rv {
        case mir.Rvalue.Aggregate(ty, _, args) {
            a := fe.arrayOf(ty)
            if a == types.UnknownT or not fe.fixed(a) or fe.arrayOf(pt) == types.UnknownT { return false }
            n := fe.fixedLen(a)
            if n <= 16 { return false }
            el := t.Elem(a)
            et := fe.ty(el)
            lt := fe.ty(a)
            same := true
            for i in range n {
                if fe.arg(args, i) != fe.arg(args, 0) { same = false }
            }
            if same {
                v := fe.val(fe.arg(args, 0), el)
                at, _ := fe.addr(p)
                head := fe.fresh("fill")
                body := fe.fresh("fill")
                done := fe.fresh("fill")
                pre := fe.fresh("fill")
                fe.w("br label %" $pre)
                fe.label(pre)
                fe.w("br label %" $head)
                fe.label(head)
                i := fe.tmp()
                next := fe.tmp()
                fe.w($i " = phi i64 [ 0, %" $pre " ], [ " $next ", %" $body " ]")
                more := fe.let("icmp slt i64 " $i ", " $n)
                fe.w("br i1 " $more ", label %" $body ", label %" $done)
                fe.label(body)
                e := fe.let("getelementptr " $lt ", ptr " $at ", i64 0, i64 " $i)
                fe.store(et, v, e)
                fe.w($next " = add i64 " $i ", 1")
                fe.w("br label %" $head)
                fe.label(done)
                return true
            }
            vs List<String&>
            for i in range n { vs.Push(fe.val(fe.arg(args, i), el)) }
            at, _ := fe.addr(p)
            for i in range n {
                e := fe.let("getelementptr " $lt ", ptr " $at ", i64 0, i64 " $i)
                fe.store(et, vs[i], e)
            }
            return true
        }
        case mir.Rvalue.Use(x) {
            match x {
                case mir.Operand.Copy(q) {
                    k := t.KindOf(t.Repr(pt))
                    if k != types.Kind.Array and k != types.Kind.Named and k != types.Kind.AnonEnum { return false }
                    if t.KindOf(t.Repr(pt)) == types.Kind.Array and not fe.fixed(t.Repr(pt)) { return false }
                    if fe.size(pt) <= 128 or fe.placeType(q) != pt { return false }
                    src, _ := fe.addr(q)
                    dst, _ := fe.addr(p)
                    fe.E.declare("llvm.memmove.p0.p0.i64", "void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)")
                    fe.w("call void @llvm.memmove.p0.p0.i64(ptr " $dst ", ptr " $src ", i64 " $fe.size(pt) ", i1 false)")
                    return true
                }
                case _ { return false }
            }
        }
        case _ { return false }
    }
}

# whether the function writes into what local l holds: a store or a copy into a place reached from it, or a writable
# reference made to it
fn (fe mut fnEm&) writesInto(l mir.LocalId) Bool {
    f := fe.F
    for bb in f.Blocks {
        for st in bb.Stmts {
            match st {
                case mir.Stmt.Assign(_, p, rv) {
                    if p.Path.N > I32(0) and fe.baseIs(p, l) { return true }
                    match rv {
                        case mir.Rvalue.Ref(q, ty) {
                            if fe.baseIs(q, l) and (fe.E.T.PermOf(fe.E.T.Repr(ty)) & types.Writable) != 0 { return true }
                        }
                        case mir.Rvalue.Slice(q, _, _, ty) {
                            if fe.baseIs(q, l) and (fe.E.T.PermOf(fe.E.T.Repr(ty)) & types.Writable) != 0 { return true }
                        }
                        case _ { }
                    }
                }
                case mir.Stmt.CopyElems(_, d, _, _) {
                    if fe.baseIs(d, l) { return true }
                }
                case _ { }
            }
        }
    }
    return false
}

fn (fe mut fnEm&) baseIs(p mir.Place, l mir.LocalId) Bool {
    return match p.B {
        case mir.Base.Local(k) => k == l
        case _ => false
    }
}

# a lambda's environment: its captures in order
fn (fe mut fnEm&) envType() String {
    f := fe.F
    b := StringBuilder()
    b.Push("{ ")
    for i in range f.Captures.Len() {
        if i > 0 { b.Push(", ") }
        b.Push(fe.ty(f.Locals[I64(f.Captures[i])].Ty))
    }
    # then where each capture holding references lives (D16c): the closure's Capture scope variables, in order
    for k in range fe.E.capVars(f.Of) { b.Push(", ptr") }
    b.Push(" }")
    return b.ToString()
}

# ---- places and operands ----

fn (fe mut fnEm&) localType(l mir.LocalId) types.TypeId { return fe.F.Locals[I64(l)].Ty }

# where local l's storage is: its stack slot, or the arena storage its Live made (O26a)
fn (fe mut fnEm&) localAt(l mir.LocalId) String {
    if fe.isFrame(fe.F.Locals[I64(l)].Home) { return "%l" $l }
    return fe.load("ptr", "%lp" $l)
}

# an array type, past a declared type over one; Unknown for none
fn (fe mut fnEm&) arrayOf(ty types.TypeId) types.TypeId {
    t := fe.E.T
    r := t.Repr(ty)
    return r if t.KindOf(r) == types.Kind.Array else types.UnknownT
}

fn (fe mut fnEm&) fixed(a types.TypeId) Bool { return fe.E.T.Length(a) != types.TypeId(0) }

fn (fe mut fnEm&) fixedLen(a types.TypeId) I64 {
    t := fe.E.T
    n := t.Length(a)
    return t.ConstValue(n) if t.KindOf(n) == types.Kind.Const else 0
}

# a place's address and type: its base's, each projection followed - and (tagAt) the access tag a scalar there is
# loaded and stored with (T36): its type's, in the family of the path's last step, an element's for an index and a
# field's otherwise; untagged within an enum's payload, whose bytes two cases' fields share
fn (fe mut fnEm&) addr(p mir.Place) (String, types.TypeId) {
    t := fe.E.T
    at := ""
    ty := types.UnknownT
    elem := false
    payload := false
    match p.B {
        case mir.Base.Local(l) {
            at = fe.localAt(l)
            ty = fe.localType(l)
        }
        case mir.Base.Global(m, n, gt) {
            at = fe.E.global(m, n, gt)
            ty = gt
        }
        case mir.Base.None { fe.gap("a place with no base") }
    }
    for i in range p.Path.N {
        pr := fe.F.Projs[I64(p.Path.At) + i]
        r := t.Repr(ty)
        match pr {
            case mir.Proj.Field(k) {
                fs := t.Items(fe.fieldList(r))
                at = fe.let("getelementptr " $fe.ty(r) ", ptr " $at ", i32 0, i32 " $k)
                ty = fs[k]
                elem = false
            }
            case mir.Proj.Index(l) {
                lt := fe.localType(l)
                ix := fe.index(fe.load(fe.ty(lt), fe.localAt(l), fe.E.tbaa(lt, false)), lt)
                if fe.runTime(ty) { payload = false }
                at, ty = fe.elemAt(at, ty, ix, fe.E.descTag(elem, payload))
                elem = true
            }
            case mir.Proj.At(k) {
                if fe.runTime(ty) { payload = false }
                at, ty = fe.elemAt(at, ty, $k, fe.E.descTag(elem, payload))
                elem = true
            }
            case mir.Proj.Deref {
                rt := t.Referent(r)
                tag := "" if payload else fe.E.tbaa(r, elem)
                ty = rt
                # a reference to a run-time-length array is the pair the array's value is (T11): the same storage
                if not fe.runTime(rt) {
                    at = fe.load("ptr", at, tag)
                    payload = false
                    elem = false
                }
            }
            case mir.Proj.Payload(_) {
                at = fe.let("getelementptr " $fe.ty(r) ", ptr " $at ", i32 0, i32 1")
                ty = types.UnknownT
                cs := t.Items(fe.casesList(r))
                match pr {
                    case mir.Proj.Payload(tag) { ty = cs[tag] }
                    case _ { }
                }
                payload = true
            }
        }
    }
    fe.tagAt = "" if payload else fe.E.tbaa(ty, elem)
    return at, ty
}

fn (fe mut fnEm&) runTime(ty types.TypeId) Bool {
    a := fe.arrayOf(ty)
    return a != types.UnknownT and not fe.fixed(a)
}

# an index's value as an I64: sign- or zero-extended from its own width
fn (fe mut fnEm&) index(v String&, ty types.TypeId) String {
    t := fe.E.T
    r := t.Repr(ty)
    if t.Bits(r) == 64 { return $v }
    op := "zext" if t.IsUnsigned(r) else "sext"
    return fe.let($op " " $fe.ty(r) " " $v " to i64")
}

# an element's address in the array at at, of type ty
# (desc: the access tag of the array's descriptor where it is a run-time-length one)
fn (fe mut fnEm&) elemAt(at String&, ty types.TypeId, ix String&, desc String& = "") (String, types.TypeId) {
    t := fe.E.T
    a := fe.arrayOf(ty)
    if a == types.UnknownT {
        fe.gap("an index into no array")
        return $at, types.UnknownT
    }
    el := t.Elem(a)
    if fe.fixed(a) { return fe.let("getelementptr " $fe.ty(a) ", ptr " $at ", i64 0, i64 " $ix), el }
    data := fe.load("ptr", fe.let("getelementptr { i64, ptr }, ptr " $at ", i32 0, i32 1"), desc)
    return fe.let("getelementptr " $fe.ty(el) ", ptr " $data ", i64 " $ix), el
}

fn (fe mut fnEm&) fieldList(r types.TypeId) types.ListId {
    t := fe.E.T
    return match t.KindOf(r) {
        case types.Kind.Tuple, types.Kind.Record => t.Parts(r)
        case types.Kind.Named => t.Fields(r)
        case _ => types.ListId(0)
    }
}

fn (fe mut fnEm&) casesList(r types.TypeId) types.ListId {
    t := fe.E.T
    return t.ShapeCases(r) if t.KindOf(r) == types.Kind.AnonEnum else t.Cases(r)
}

# a place's type, its projections followed, nothing emitted
fn (fe mut fnEm&) placeType(p mir.Place) types.TypeId {
    t := fe.E.T
    ty := match p.B {
        case mir.Base.Local(l) => fe.localType(l)
        case mir.Base.Global(_, _, gt) => gt
        case mir.Base.None => types.UnknownT
    }
    for i in range p.Path.N {
        r := t.Repr(ty)
        match fe.F.Projs[I64(p.Path.At) + i] {
            case mir.Proj.Field(k) { ty = t.Items(fe.fieldList(r))[k] }
            case mir.Proj.Index(_), mir.Proj.At(_) { ty = t.Elem(fe.arrayOf(ty)) }
            case mir.Proj.Deref { ty = t.Referent(r) }
            case mir.Proj.Payload(tag) { ty = t.Items(fe.casesList(r))[tag] }
        }
    }
    return ty
}

fn (fe mut fnEm&) otype(x mir.Operand) types.TypeId {
    return match x {
        case mir.Operand.None => types.VoidT
        case mir.Operand.Copy(p) => fe.placeType(p)
        case mir.Operand.Const(ty, _), mir.Operand.Data(ty, _, _, _) => ty
    }
}

fn (fe mut fnEm&) arg(r mir.Range, i I64) mir.Operand { return fe.F.Ops[I64(r.At) + i] }

# an operand's value, as an LLVM value of want's type (want Unknown: its own) - a constant spelled, a place loaded
fn (fe mut fnEm&) val(x mir.Operand, want types.TypeId = types.UnknownT) String {
    match x {
        case mir.Operand.None { return "undef" }
        case mir.Operand.Copy(p) {
            at, ty := fe.addr(p)
            return fe.load(fe.ty(ty), at, fe.tagAt)
        }
        case mir.Operand.Const(ty, bits) {
            k := ty
            if (ty == types.NullT or ty == types.UnknownT) and want != types.UnknownT { k = want }
            return fe.E.constText(k, bits)
        }
        case mir.Operand.Data(ty, c, file, sp) { return fe.data(ty, c, file, sp) }
    }
}

# a constant's LLVM spelling: a number's bits as its type writes them, anything else all zero bits
fn (e mut Emitter&) constText(ty types.TypeId, bits I64) String {
    t := e.T
    r := t.Repr(ty)
    if r == types.BoolT { return "true" if bits != 0 else "false" }
    if t.IsInt(r) {
        w := t.Bits(r)
        if w == 64 { return $bits }
        v := bits & ((I64(1) << w) - 1)
        if v >= (I64(1) << (w - 1)) { v = v - (I64(1) << w) }
        return $v
    }
    if t.IsFloat(r) {
        k := t.Bits(r)
        if r == types.TypeId(11) { return "0xH" $U64(bits & 0xFFFF).Format(16).PadStart(4, '0') }
        if r == types.TypeId(12) { return "0xR" $U64(bits & 0xFFFF).Format(16).PadStart(4, '0') }
        if k == 32 { return "0x" $F64(U32(U64(bits) & U64(0xFFFFFFFF)).F32FromBits()).Bits().Format(16).PadStart(16, '0') }
        return "0x" $U64(bits).Format(16).PadStart(16, '0')
    }
    s := e.ty(ty)
    if s == "ptr" { return "null" if bits == 0 else "inttoptr (i64 " $bits " to ptr)" }
    if s.StartsWith("i") { return $bits }
    return "zeroinitializer"
}

# read-only constant storage (T25d): a private constant, one for each distinct content, and the operand's value - the
# pair { length, storage } for a run-time-length array or a reference to one, the storage for a reference to a fixed
# array, the array itself for a fixed array's value
fn (fe mut fnEm&) data(ty types.TypeId, c I32, file I64, sp source.Span, where Bool = false) String {
    t := fe.E.T
    r := t.Repr(ty)
    x := t.Referent(r) if t.IsRef(r) else r
    a := fe.arrayOf(x)
    if a == types.UnknownT {
        fe.gap("constant data of a " $t.Canon(ty))
        return "undef"
    }
    # T25d: one instance for each site written, two sites two - what lowering synthesizes (no span) by its contents
    site := "" if sp.Start == I32(0) and sp.End == I32(0) else $file ":" $sp.Start ":" $sp.End ":" $c ":" $t.Canon(ty)
    g, n := fe.constGlobal(t.Elem(a), c, site)
    if t.IsRef(r) and fe.fixed(a) { return "" if where else g }
    if fe.fixed(a) { return g if where else fe.load(fe.ty(a), g) }
    if where { return "" }
    return "{ i64 " $n ", ptr " $g " }"
}

# constant c of this function's tables, elements of type el, as a private global: its name and its length
fn (fe mut fnEm&) constGlobal(el types.TypeId, c I32, site String&) (String, I64) {
    lt, init, n := fe.constInit(el, c)
    key := "d:" $lt " " $init if site == "" else "s:" $site
    if fe.E.dataAt.Has(key) { return (try fe.E.dataAt.Get(key) catch default ""), n }
    s := "@.d" $fe.E.nconst
    fe.E.nconst++
    fe.E.item(s[1:], HomeLocal, $s " = private " $("unnamed_addr " if site == "" else "") "constant " $lt " " $init "\n")
    fe.E.dataAt.Put($key, $s)
    return s, n
}

# an array constant's LLVM type, initializer and length
fn (fe mut fnEm&) constInit(el types.TypeId, c I32) (String, String, I64) {
    t := fe.E.T
    match fe.F.Consts[I64(c)] {
        case mir.ConstNode.Bytes(r) {
            b := StringBuilder()
            for i in range r.N {
                v := fe.F.Bytes[I64(r.At) + i]
                if v == U8('"') or v == U8('\\') or v < U8(32) or v > U8(126) {
                    b.PushChar('\\')
                    b.Push(v.Format(16).PadStart(2, '0').ToUpper())
                } else {
                    b.PushChar(Char(v))
                }
            }
            return "[" $r.N " x i8]", "c\"" $b.ToString() "\"", I64(r.N)
        }
        case mir.ConstNode.Items(r) {
            elt := fe.ty(el)
            b := StringBuilder()
            b.PushChar('[')
            for i in range r.N {
                if i > 0 { b.Push(", ") }
                b.Push($elt " ")
                b.Push(fe.constItem(el, fe.F.ConstItems[I64(r.At) + i]))
            }
            b.PushChar(']')
            return "[" $r.N " x " $elt "]", b.ToString(), I64(r.N)
        }
        case mir.ConstNode.Bits(v) { return $fe.ty(el), fe.E.constText(el, v), 1 }
    }
}

# one element of an array constant, of type el
fn (fe mut fnEm&) constItem(el types.TypeId, c I32) String {
    t := fe.E.T
    match fe.F.Consts[I64(c)] {
        case mir.ConstNode.Bits(v) { return fe.E.constText(el, v) }
        case _ {
            r := t.Repr(el)
            x := t.Referent(r) if t.IsRef(r) else r
            a := fe.arrayOf(x)
            if a == types.UnknownT {
                fe.gap("a constant element of a " $t.Canon(el))
                return "zeroinitializer"
            }
            if fe.fixed(a) and not t.IsRef(r) {
                _, init, _ := fe.constInit(t.Elem(a), c)
                return init
            }
            g, n := fe.constGlobal(t.Elem(a), c, "")
            if t.IsRef(r) and fe.fixed(a) { return g }
            return "{ i64 " $n ", ptr " $g " }"
        }
    }
}

# ---- scopes ----

# a scope reference's header (a builder's for a text builder): where what is built there is allocated
fn (fe mut fnEm&) scope(r mir.ScopeRef) String {
    match r {
        case mir.ScopeRef.Scope(s) { return "%s" $s }
        case mir.ScopeRef.Var(i) {
            if i < fe.passed { return "%v" $i }
            if fe.F.Captures.Len() > 0 and i - fe.passed < fe.E.capVars(fe.F.Of) { return "%vc" $(i - fe.passed) }
            return fe.program()
        }
        case mir.ScopeRef.Program { return fe.program() }
        case mir.ScopeRef.Frame {
            if fe.frameScope >= 0 { return "%s" $fe.frameScope }
            return fe.program()
        }
        case mir.ScopeRef.RegionOf(_) {
            fe.gap("a region's scope")
            return fe.program()
        }
    }
}

fn (fe mut fnEm&) program() String {
    fe.E.define("__olang_prog_scope", "@__olang_prog_scope = external thread_local(initialexec) global ptr")
    return fe.load("ptr", "@__olang_prog_scope")
}

fn (fe mut fnEm&) isFrame(r mir.ScopeRef) Bool {
    return match r {
        case mir.ScopeRef.Frame => true
        case _ => false
    }
}

# P1d (S18b): in a test build each scope this function opens is on the runtime's chain of open scopes while it is open
# - its header and, for a join, its task list - so a failed check unwinds it (joining its tasks, running its
# destructors) before its longjmp ends the test
fn (fe mut fnEm&) unwindPush(sc mir.ScopeId, joins Bool) {
    fe.E.define("__olang_unwind_top", "@__olang_unwind_top = external thread_local(initialexec) global ptr")
    top := fe.load("ptr", "@__olang_unwind_top")
    fe.store("ptr", top, fe.let("getelementptr %olang.unwind, ptr %u" $sc ", i32 0, i32 0"))
    fe.store("ptr", "%s" $sc, fe.let("getelementptr %olang.unwind, ptr %u" $sc ", i32 0, i32 1"))
    fe.store("ptr", ("%jh" $sc) if joins else "null", fe.let("getelementptr %olang.unwind, ptr %u" $sc ", i32 0, i32 2"))
    fe.store("ptr", "%u" $sc, "@__olang_unwind_top")
}

fn (fe mut fnEm&) unwindPop(sc mir.ScopeId) {
    prev := fe.load("ptr", fe.let("getelementptr %olang.unwind, ptr %u" $sc ", i32 0, i32 0"))
    fe.store("ptr", prev, "@__olang_unwind_top")
}

# size bytes of storage aligned to align, in scope r: on the stack for the frame (size a constant), else in its arena
fn (fe mut fnEm&) alloc(r mir.ScopeRef, size String&, align I64, stack String& = "") String {
    if fe.isFrame(r) and stack != "" { return fe.alloca(stack, align) }
    fe.E.runtime("__olang_scope_alloc_a")
    return fe.let("call ptr @__olang_scope_alloc_a(ptr " $fe.scope(r) ", i64 " $size ", i64 " $(align if align > 8 else 8) ")")
}

# ---- statements ----

fn (fe mut fnEm&) stmt(s mir.Stmt) {
    t := fe.E.T
    if fe.dbgSp >= 0 { fe.locate(stmtSpan(s)) }
    match s {
        case mir.Stmt.Assign(_, p, rv) {
            pt := fe.placeType(p)
            if fe.fillInPlace(p, pt, rv) { return }
            if fe.viaMem(pt) and fe.intoPlace(p, pt, rv) { return }
            v := fe.rvalue(rv, pt)
            if pt == types.VoidT or pt == types.NoreturnT { return }
            at, _ := fe.addr(p)
            fe.store(fe.ty(pt), v, at, fe.tagAt)
        }
        case mir.Stmt.Live(_, l) {
            home := fe.F.Locals[I64(l)].Home
            if not fe.isFrame(home) {
                lt := fe.localType(l)
                at := fe.alloc(home, $fe.size(lt), fe.align(lt))
                fe.store("ptr", at, "%lp" $l)
            }
        }
        case mir.Stmt.Dead(_, _) { }
        case mir.Stmt.Open(_, sc) {
            if fe.direct.Has(I64(sc)) {
                fe.pieceKinds.Clear()
                fe.pieceOps.Clear()
                return
            }
            if fe.F.Scopes[I64(sc)].Kind == mir.ScopeKind.Builder {
                fe.w("store %olang.builder { ptr null, i64 0, i64 64, ptr null, ptr null }, ptr %s" $sc)
                fe.w("store ptr %s" $sc "room, ptr %s" $sc)
            } else {
                if fe.F.Scopes[I64(sc)].Kind == mir.ScopeKind.Region { fe.gap("a region") }
                fe.w("store %olang.scope zeroinitializer, ptr %s" $sc)
                joins := fe.F.Scopes[I64(sc)].Kind == mir.ScopeKind.Join
                if joins { fe.w("store ptr null, ptr %jh" $sc) }
                if fe.E.Tests { fe.unwindPush(sc, joins) }
            }
        }
        case mir.Stmt.Close(_, sc) {
            if fe.direct.Has(I64(sc)) { return }
            if fe.F.Scopes[I64(sc)].Kind == mir.ScopeKind.Builder {
                # a builder that never outgrew its room made no scope of its own: nothing to close (the rest is the
                # runtime's __olang_sb_done)
                fe.E.runtime("__olang_sb_done")
                h := fe.load("ptr", fe.let("getelementptr %olang.builder, ptr %s" $sc ", i32 0, i32 3"))
                grew := fe.let("icmp ne ptr " $h ", null")
                yes, no := fe.fresh("sbgrew"), fe.fresh("sbdone")
                fe.w("br i1 " $grew ", label %" $yes ", label %" $no)
                fe.label(yes)
                fe.w("call void @__olang_sb_done(ptr %s" $sc ")")
                fe.w("br label %" $no)
                fe.label(no)
            } else {
                fe.E.runtime("__olang_scope_close")
                fe.w("call void @__olang_scope_close(ptr %s" $sc ")")
                if fe.E.Tests { fe.unwindPop(sc) }
            }
        }
        case mir.Stmt.Give(_, _) { fe.gap("Give") }
        case mir.Stmt.Raised(sp) { fe.trace(sp) }
        case mir.Stmt.RegisterDtor(_, sr, ty, x) {
            id := try fe.E.dtorOf.Get(ty) catch default -1
            if id < 0 {
                fe.gap("a destructor not found: " $t.Canon(ty))
                return
            }
            k := mir.FnKey.Body(typed.BodyId(I32(id)))
            fe.E.want(k)
            if not fe.E.dtorSeen.Has(k) {
                fe.E.dtorSeen.Put(k, true)
                fe.E.dtorKeys.Push(k)
            }
            fe.E.runtime("__olang_scope_register_dtor")
            fe.w("call void @__olang_scope_register_dtor(ptr " $fe.scope(sr) ", ptr " $fe.val(x) ", ptr @" $fe.E.sym(k) "_rt)")
        }
        case mir.Stmt.RegisterOwner(_, _, _) { fe.gap("RegisterOwner") }
        case mir.Stmt.Release(_, _) { fe.gap("Release") }
        case mir.Stmt.Write(_, b, how, x) {
            if fe.directRef(b) {
                fe.pieceKinds.Push(how)
                fe.pieceOps.Push(x)
                return
            }
            fe.write(fe.scope(b), how, x)
        }
        case mir.Stmt.CopyElems(_, dst, src, n) {
            d := fe.dataPtr(dst)
            sv := fe.dataPtr(src)
            el := t.Elem(fe.arrayOf(fe.placeType(dst)))
            bytes := fe.let("mul i64 " $fe.index(fe.val(n), fe.otype(n)) ", " $fe.size(el))
            fe.E.declare("llvm.memmove.p0.p0.i64", "void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)")
            fe.w("call void @llvm.memmove.p0.p0.i64(ptr " $d ", ptr " $sv ", i64 " $bytes ", i1 false)")
        }
        case mir.Stmt.Spawn(_, j, task) { fe.spawn(j, fe.F.Tasks[I64(task)]) }
    }
}

# E11b: the builders whose pieces are only text, characters, integers and Bools, written one after another and made
# text at once - Open, Writes, the Text, Close in one block, as lowering writes a join with no rendering helper. Such a
# text is measured, then written straight into storage of its length where it lands: no builder, no room in the
# frame (a recursion through a join holds nothing but its operands, as stage 0's measured writes), no copy
fn (fe mut fnEm&) findDirect() {
    for bb in fe.F.Blocks {
        n := bb.Stmts.Len()
        for i in range n {
            sc := I64(-1)
            match bb.Stmts[i] {
                case mir.Stmt.Open(_, s0) {
                    if fe.F.Scopes[I64(s0)].Kind == mir.ScopeKind.Builder { sc = I64(s0) }
                }
                case _ { }
            }
            if sc < 0 { continue }
            j := i + 1
            for j < n and fe.plainWrite(bb.Stmts[j], sc) { j++ }
            if j + 1 >= n { continue }
            textOk := match bb.Stmts[j] {
                case mir.Stmt.Assign(_, _, rv) => match rv {
                    case mir.Rvalue.Text(b, _, _) => fe.refIs(b, sc)
                    case _ => false
                }
                case _ => false
            }
            closeOk := match bb.Stmts[j + 1] {
                case mir.Stmt.Close(_, s1) => I64(s1) == sc
                case _ => false
            }
            if textOk and closeOk { fe.direct.Put(sc, true) }
        }
    }
}

fn (fe mut fnEm&) plainWrite(st mir.Stmt, sc I64) Bool {
    return match st {
        case mir.Stmt.Write(_, b, how, _) => fe.refIs(b, sc) and match how {
            case mir.WriteKind.Bytes, mir.WriteKind.Char, mir.WriteKind.Int, mir.WriteKind.Uint, mir.WriteKind.Bool => true
            case _ => false
        }
        case _ => false
    }
}

fn (fe mut fnEm&) refIs(r mir.ScopeRef, sc I64) Bool {
    return match r {
        case mir.ScopeRef.Scope(s0) => I64(s0) == sc
        case _ => false
    }
}

fn (fe mut fnEm&) directRef(r mir.ScopeRef) Bool {
    return match r {
        case mir.ScopeRef.Scope(s0) => fe.direct.Has(I64(s0))
        case _ => false
    }
}

# a direct builder's text (findDirect): each piece's length, their sum allocated in into, each piece written there
fn (fe mut fnEm&) directText(into mir.ScopeRef) String {
    k := fe.pieceOps.Len()
    vs := Array<String&>(k, "")
    ns := Array<String&>(k, "")
    total := "0"
    for i in range k {
        x := fe.pieceOps[i]
        xt := fe.otype(x)
        v := fe.val(x, xt)
        match fe.pieceKinds[i] {
            case mir.WriteKind.Bytes {
                data, n := fe.arrayParts(v, xt)
                vs[i] = $data
                ns[i] = $n
            }
            case mir.WriteKind.Char {
                vs[i] = $v
                ns[i] = $"1"
            }
            case mir.WriteKind.Bool {
                vs[i] = $fe.let("select i1 " $v ", ptr " $fe.E.cstr("true") ", ptr " $fe.E.cstr("false"))
                ns[i] = $fe.let("select i1 " $v ", i64 4, i64 5")
            }
            case mir.WriteKind.Uint {
                vs[i] = $fe.zext64(v, xt)
                fe.E.runtime("__olang_fmt_u64")
                ns[i] = $fe.let("call i64 @__olang_fmt_u64(ptr null, i64 " $vs[i] ")")
            }
            case _ {
                vs[i] = $fe.index(v, xt)
                fe.E.runtime("__olang_fmt_i64")
                ns[i] = $fe.let("call i64 @__olang_fmt_i64(ptr null, i64 " $vs[i] ")")
            }
        }
        total = $ns[i] if i == 0 else fe.let("add i64 " $total ", " $ns[i])
    }
    fe.E.runtime("__olang_scope_alloc")
    out := fe.let("call ptr @__olang_scope_alloc(ptr " $fe.scope(into) ", i64 " $total ")")
    at := out
    for i in range k {
        match fe.pieceKinds[i] {
            case mir.WriteKind.Char { fe.store("i8", vs[i], at) }
            case mir.WriteKind.Uint { fe.let("call i64 @__olang_fmt_u64(ptr " $at ", i64 " $vs[i] ")") }
            case mir.WriteKind.Int { fe.let("call i64 @__olang_fmt_i64(ptr " $at ", i64 " $vs[i] ")") }
            case _ {
                fe.E.textCopy()
                fe.w("call void @olang_textcopy(ptr " $at ", ptr " $vs[i] ", i64 " $ns[i] ")")
            }
        }
        if i + 1 < k { at = fe.let("getelementptr i8, ptr " $at ", i64 " $ns[i]) }
    }
    return fe.pair(total, out)
}

# where an array place's elements are
fn (fe mut fnEm&) dataPtr(p mir.Place) String {
    at, ty := fe.addr(p)
    a := fe.arrayOf(ty)
    if a != types.UnknownT and fe.fixed(a) { return at }
    return fe.load("ptr", fe.let("getelementptr { i64, ptr }, ptr " $at ", i32 0, i32 1"), fe.tagAt)
}

# an array value's (or a reference to one's) data pointer and length
fn (fe mut fnEm&) arrayParts(v String&, ty types.TypeId) (String, String) {
    t := fe.E.T
    r := t.Repr(ty)
    x := t.Referent(r) if t.IsRef(r) else r
    a := fe.arrayOf(x)
    if a != types.UnknownT and fe.fixed(a) {
        if t.IsRef(r) { return $v, $fe.fixedLen(a) }
        p := fe.alloca(fe.ty(a))
        fe.store(fe.ty(a), v, p)
        return p, $fe.fixedLen(a)
    }
    return fe.let("extractvalue { i64, ptr } " $v ", 1"), fe.let("extractvalue { i64, ptr } " $v ", 0")
}

# x appended to the builder at b, as E11a writes it
fn (fe mut fnEm&) write(b String&, how mir.WriteKind, x mir.Operand) {
    t := fe.E.T
    xt := fe.otype(x)
    v := fe.val(x, xt)
    match how {
        case mir.WriteKind.Bytes {
            data, n := fe.arrayParts(v, xt)
            fe.E.runtime("__olang_sb_put")
            fe.w("call void @__olang_sb_put(ptr " $b ", ptr " $data ", i64 " $n ")")
        }
        case mir.WriteKind.Quoted {
            data, n := fe.arrayParts(v, xt)
            fe.quoted(b, data, n, 34)
        }
        case mir.WriteKind.Char {
            fe.E.runtime("__olang_sb_room")
            fe.E.runtime("__olang_sb_add")
            p := fe.let("call ptr @__olang_sb_room(ptr " $b ", i64 1)")
            fe.store("i8", v, p)
            fe.w("call void @__olang_sb_add(ptr " $b ", i64 1)")
        }
        case mir.WriteKind.QuotedChar {
            one := fe.alloca("i8")
            fe.store("i8", v, one)
            fe.quoted(b, one, "1", 39)
        }
        case mir.WriteKind.Int, mir.WriteKind.Uint {
            fe.E.runtime("__olang_sb_room")
            fe.E.runtime("__olang_sb_add")
            un := how == mir.WriteKind.Uint
            wide := fe.index(v, xt) if not un else fe.zext64(v, xt)
            fn64 := "__olang_fmt_u64" if un else "__olang_fmt_i64"
            fe.E.runtime(fn64)
            p := fe.let("call ptr @__olang_sb_room(ptr " $b ", i64 24)")
            k := fe.let("call i64 @" $fn64 "(ptr " $p ", i64 " $wide ")")
            fe.w("call void @__olang_sb_add(ptr " $b ", i64 " $k ")")
        }
        case mir.WriteKind.Float {
            fe.E.runtime("__olang_sb_room")
            fe.E.runtime("__olang_sb_add")
            fe.E.runtime("__olang_fmt_float")
            r := t.Repr(xt)
            kind := 0
            d := $v
            if r == types.TypeId(13) { kind = 1 }
            if r == types.TypeId(11) { kind = 2 }
            if r == types.TypeId(12) { kind = 3 }
            if kind != 0 { d = fe.let("fpext " $fe.ty(r) " " $v " to double") }
            p := fe.let("call ptr @__olang_sb_room(ptr " $b ", i64 48)")
            k := fe.let("call i64 @__olang_fmt_float(ptr " $p ", i64 48, double " $d ", i32 " $kind ")")
            fe.w("call void @__olang_sb_add(ptr " $b ", i64 " $k ")")
        }
        case mir.WriteKind.Bool {
            fe.E.runtime("__olang_sb_put")
            yes := fe.E.cstr("true")
            no := fe.E.cstr("false")
            s := fe.let("select i1 " $v ", ptr " $yes ", ptr " $no)
            n := fe.let("select i1 " $v ", i64 4, i64 5")
            fe.w("call void @__olang_sb_put(ptr " $b ", ptr " $s ", i64 " $n ")")
        }
    }
}

fn (fe mut fnEm&) zext64(v String&, ty types.TypeId) String {
    t := fe.E.T
    r := t.Repr(ty)
    if t.Bits(r) == 64 { return $v }
    return fe.let("zext " $fe.ty(r) " " $v " to i64")
}

# text between quotes q, escaped as a literal writes it: measured, then written where the builder has room
fn (fe mut fnEm&) quoted(b String&, data String&, n String&, q I64) {
    fe.E.runtime("__olang_rd_quote")
    fe.E.runtime("__olang_sb_room")
    fe.E.runtime("__olang_sb_add")
    k := fe.let("call i64 @__olang_rd_quote(ptr null, i64 0, ptr " $data ", i64 " $n ", i8 " $q ")")
    p := fe.let("call ptr @__olang_sb_room(ptr " $b ", i64 " $k ")")
    fe.let("call i64 @__olang_rd_quote(ptr " $p ", i64 0, ptr " $data ", i64 " $n ", i8 " $q ")")
    fe.w("call void @__olang_sb_add(ptr " $b ", i64 " $k ")")
}

# ---- values computed ----

# an rvalue's value, of the type of the place it is stored in (to)
fn (fe mut fnEm&) rvalue(rv mir.Rvalue, to types.TypeId) String {
    t := fe.E.T
    match rv {
        case mir.Rvalue.Use(x) { return fe.val(x, to) }
        case mir.Rvalue.Ref(p, ty) { return fe.ref(p, ty) }
        case mir.Rvalue.Take(p) {
            # an owner moved out, its zero left (own is being removed: nothing is released)
            at, pty := fe.addr(p)
            v := fe.load(fe.ty(pty), at)
            fe.store(fe.ty(pty), fe.E.constText(pty, 0), at)
            return v
        }
        case mir.Rvalue.Prim(op, ty, args) { return fe.prim(op, ty, args) }
        case mir.Rvalue.Overflows(op, ty, args) { return fe.overflows(op, ty, args) }
        case mir.Rvalue.Tag(p) {
            at, pty := fe.addr(p)
            if fe.E.enumWords(pty) { return fe.load("i64", at) }
            return fe.let("sext i32 " $fe.load("i32", at) " to i64")
        }
        case mir.Rvalue.Aggregate(ty, tag, args) { return fe.aggregate(ty, tag, args) }
        case mir.Rvalue.New(s, x, ty) {
            rt := t.Referent(t.Repr(ty))
            if fe.viaMem(rt) {
                p := fe.alloc(s, $fe.size(rt), fe.align(rt), fe.ty(rt))
                fe.put(p, rt, x)
                return p
            }
            v := fe.val(x, rt)
            if fe.runTime(rt) { return fe.copyArray(s, v, rt) }
            p := fe.alloc(s, $fe.size(rt), fe.align(rt), fe.ty(rt))
            fe.store(fe.ty(rt), v, p)
            return p
        }
        case mir.Rvalue.NewArray(s, ty, n, fill) { return fe.newArray(s, ty, n, fill) }
        case mir.Rvalue.Slice(p, lo, hi, ty) { return fe.slice(p, lo, hi, ty) }
        case mir.Rvalue.Closure(code, ty, s, args, caps) { return fe.closure(code, ty, s, args, caps) }
        case mir.Rvalue.Recode(code, from, tl) { return fe.recode(fe.val(code, mir.I32T), from, tl) }
        case mir.Rvalue.Text(b, into, ty) {
            if fe.directRef(b) { return fe.directText(into) }
            bp := fe.scope(b)
            data := fe.load("ptr", bp)
            n := fe.load("i64", fe.let("getelementptr %olang.builder, ptr " $bp ", i32 0, i32 1"))
            fe.E.runtime("__olang_scope_alloc")
            out := fe.let("call ptr @__olang_scope_alloc(ptr " $fe.scope(into) ", i64 " $n ")")
            fe.E.textCopy()
            fe.w("call void @olang_textcopy(ptr " $out ", ptr " $data ", i64 " $n ")")
            return fe.pair(n, out)
        }
    }
}

# a run-time-length array value given storage of its own in scope s: its elements copied there
fn (fe mut fnEm&) copyArray(s mir.ScopeRef, v String&, ty types.TypeId) String {
    t := fe.E.T
    el := t.Elem(fe.arrayOf(ty))
    n := fe.let("extractvalue { i64, ptr } " $v ", 0")
    data := fe.let("extractvalue { i64, ptr } " $v ", 1")
    bytes := fe.let("mul i64 " $n ", " $fe.size(el))
    fe.E.runtime("__olang_scope_alloc")
    p := fe.let("call ptr @__olang_scope_alloc(ptr " $fe.scope(s) ", i64 " $bytes ")")
    fe.E.declare("llvm.memcpy.p0.p0.i64", "void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
    fe.w("call void @llvm.memcpy.p0.p0.i64(ptr " $p ", ptr " $data ", i64 " $bytes ", i1 false)")
    return fe.pair(n, p)
}

fn (fe mut fnEm&) pair(n String&, p String&) String {
    a := fe.let("insertvalue { i64, ptr } undef, i64 " $n ", 0")
    return fe.let("insertvalue { i64, ptr } " $a ", ptr " $p ", 1")
}

# whether an enum's value is a tag word and its payload's words (T17), not a bare I32 ordinal
fn (e mut Emitter&) enumWords(ty types.TypeId) Bool {
    e.P.Layout(ty)
    return e.T.PayloadSize(e.T.Repr(ty)) >= 0
}

# a reference to a place (E12c): its address, or for a run-time-length array the pair its value is; a fixed array's
# address widened to the pair where the reference is to a run-time-length one
fn (fe mut fnEm&) ref(p mir.Place, ty types.TypeId) String {
    t := fe.E.T
    at, pty := fe.addr(p)
    rt := t.Referent(t.Repr(ty))
    if fe.runTime(rt) {
        a := fe.arrayOf(pty)
        if a != types.UnknownT and fe.fixed(a) { return fe.pair($fe.fixedLen(a), at) }
        return fe.load("{ i64, ptr }", at, fe.tagAt)
    }
    return at
}

fn (fe mut fnEm&) newArray(s mir.ScopeRef, ty types.TypeId, n mir.Operand, fill mir.Operand) String {
    t := fe.E.T
    r := t.Repr(ty)
    x := t.Referent(r) if t.IsRef(r) else r
    el := t.Elem(fe.arrayOf(x))
    cnt := fe.index(fe.val(n), fe.otype(n))
    bytes := fe.let("mul i64 " $cnt ", " $fe.size(el))
    zero := match fill {
        case mir.Operand.Const(_, b) => b == 0
        case _ => false
    }
    sc := fe.scope(s)
    p := ""
    if fe.E.San and fe.E.retires(fe.F.File) {
        # B2f: an array made in a module that retires arrays (M19d) has a chunk of its own, zero-filled, so that
        # retiring it can make it unreadable
        fe.E.runtime("__olang_san_alloc_own")
        p = fe.let("call ptr @__olang_san_alloc_own(ptr " $sc ", i64 " $bytes ")")
        if zero { return fe.pair(cnt, p) }
    } else if zero {
        fe.E.runtime("__olang_scope_alloc_zeroed")
        p = fe.let("call ptr @__olang_scope_alloc_zeroed(ptr " $sc ", i64 " $bytes ")")
    }
    if not zero {
        if p == "" {
            fe.E.runtime("__olang_scope_alloc")
            p = fe.let("call ptr @__olang_scope_alloc(ptr " $sc ", i64 " $bytes ")")
        }
        big := fe.viaMem(el)
        v := "" if big else fe.val(fill, el)
        elt := fe.ty(el)
        i := fe.alloca("i64")
        fe.store("i64", "0", i)
        head, body, done := fe.fresh("fill"), fe.fresh("fillb"), fe.fresh("filld")
        fe.w("br label %" $head)
        fe.label(head)
        k := fe.load("i64", i)
        more := fe.let("icmp slt i64 " $k ", " $cnt)
        fe.w("br i1 " $more ", label %" $body ", label %" $done)
        fe.label(body)
        at := fe.let("getelementptr " $elt ", ptr " $p ", i64 " $k)
        if big {
            fe.put(at, el, fill)
        } else {
            fe.store(elt, v, at)
        }
        fe.store("i64", fe.let("add i64 " $k ", 1"), i)
        fe.w("br label %" $head)
        fe.label(done)
    }
    return fe.pair(cnt, p)
}

fn (fe mut fnEm&) slice(p mir.Place, lo mir.Operand, hi mir.Operand, ty types.TypeId) String {
    t := fe.E.T
    pty := fe.placeType(p)
    a := fe.arrayOf(pty)
    el := t.Elem(a)
    data := fe.dataPtr(p)
    l := fe.index(fe.val(lo), fe.otype(lo))
    h := fe.index(fe.val(hi), fe.otype(hi))
    start := fe.let("getelementptr " $fe.ty(el) ", ptr " $data ", i64 " $l)
    rt := t.Referent(t.Repr(ty))
    if not fe.runTime(rt) { return start }
    return fe.pair(fe.let("sub i64 " $h ", " $l), start)
}

# a value made of parts: a struct, tuple or record, a fixed array - and an enum's case, a tag and its payload written
# where the value is held
fn (fe mut fnEm&) aggregate(ty types.TypeId, tag I64, args mir.Range) String {
    t := fe.E.T
    r := t.Repr(ty)
    k := t.KindOf(r)
    isEnum := k == types.Kind.AnonEnum or (k == types.Kind.Named and t.DeclKindOf(t.DeclOf(r)) == types.DeclKind.Enum)
    if isEnum {
        if not fe.E.enumWords(r) { return $tag }
        lt := fe.ty(r)
        slot := fe.alloca(lt, 8)
        fe.store(lt, "zeroinitializer", slot)
        fe.store("i64", $tag, fe.let("getelementptr " $lt ", ptr " $slot ", i32 0, i32 0"))
        rec := t.Items(fe.casesList(r))[tag]
        if rec != types.TypeId(0) {
            v := fe.parts(rec, t.Items(t.Parts(rec)), args)
            fe.store(fe.ty(rec), v, fe.let("getelementptr " $lt ", ptr " $slot ", i32 0, i32 1"))
        }
        return fe.load(lt, slot)
    }
    a := fe.arrayOf(r)
    if a != types.UnknownT {
        n := fe.fixedLen(a)
        xs := Array<types.TypeId>(n, t.Elem(a))
        return fe.parts(a, xs, args)
    }
    return fe.parts(r, t.Items(fe.fieldList(r)), args)
}

fn (fe mut fnEm&) parts(ty types.TypeId, ps Array<types.TypeId>&, args mir.Range) String {
    lt := fe.ty(ty)
    cur := "undef"
    for i in range ps.Len() {
        v := fe.val(fe.arg(args, i), ps[i])
        cur = fe.let("insertvalue " $lt " " $cur ", " $fe.ty(ps[i]) " " $v ", " $i)
    }
    if ps.Len() == 0 { return "zeroinitializer" }
    return cur
}

# an error code under list from as the same error under list to (R6): the type's position mapped, the word kept
fn (fe mut fnEm&) recode(code String&, from types.ListId, to types.ListId) String {
    t := fe.E.T
    xs := t.Items(from)
    hi := fe.let("lshr i32 " $code ", 16")
    word := fe.let("and i32 " $code ", 65535")
    pos := "0"
    for k in range xs.Len() {
        at := fe.E.position(to, xs[k])
        hit := fe.let("icmp eq i32 " $hi ", " $(k + 1))
        pos = fe.let("select i1 " $hit ", i32 " $at ", i32 " $pos)
    }
    z := fe.let("icmp eq i32 " $code ", 0")
    v := fe.let("or i32 " $fe.let("shl i32 " $pos ", 16") ", " $word)
    return fe.let("select i1 " $z ", i32 0, i32 " $v)
}

# an error type's position from 1 in an error list, 0 where it names none
fn (e mut Emitter&) position(l types.ListId, err types.TypeId) I64 {
    t := e.T
    xs := t.Items(l)
    for k in range xs.Len() {
        if t.Same(t.ErrOf(xs[k]), t.ErrOf(err)) { return k + 1 }
    }
    for k in range xs.Len() {
        if xs[k] == types.DefaultErrT { return k + 1 }
    }
    return 0
}

# ---- operations ----

fn (fe mut fnEm&) prim(op typed.PrimOp, ty types.TypeId, args mir.Range) String {
    t := fe.E.T
    a0 := fe.arg(args, 0)
    t0 := fe.otype(a0)
    if args.N > I32(1) and (t0 == types.NullT or t0 == types.UnknownT) { t0 = fe.otype(fe.arg(args, 1)) }
    r := t.Repr(t0)
    lt := fe.ty(r)
    fl := t.IsFloat(r)
    un := t.IsUnsigned(r)
    x := fe.val(a0, t0)
    match op {
        case typed.PrimOp.Neg {
            # a BF16's sign flipped in its bits (T4)
            if lt == "bfloat" { return fe.let("bitcast i16 " $fe.let("xor i16 " $fe.let("bitcast bfloat " $x " to i16") ", -32768") " to bfloat") }
            return fe.let("fneg " $lt " " $x) if fl else fe.let("sub " $lt " 0, " $x)
        }
        case typed.PrimOp.BitNot { return fe.let("xor " $lt " " $x ", " $("true" if r == types.BoolT else "-1")) }
        case typed.PrimOp.Not { return fe.let("xor i1 " $x ", true") }
        case typed.PrimOp.Convert { return fe.convert(x, t0, ty) }
        case typed.PrimOp.Bitcast { return fe.let("bitcast " $lt " " $x " to " $fe.ty(ty)) }
        case typed.PrimOp.Retire {
            # M19d: an array a collection no longer uses - under -sanitize its storage poisoned and, where it has a
            # chunk of its own, made unreadable until its scope closes (B2f); nothing otherwise
            rr := t.Referent(r) if t.IsRef(r) else r
            a := fe.arrayOf(rr)
            if fe.E.San and a != types.UnknownT and not fe.fixed(a) {
                n := fe.let("extractvalue { i64, ptr } " $x ", 0")
                p := fe.let("extractvalue { i64, ptr } " $x ", 1")
                bytes := fe.let("mul i64 " $n ", " $fe.size(t.Elem(a)))
                fe.E.runtime("__olang_san_retire")
                fe.w("call void @__olang_san_retire(ptr " $p ", i64 " $bytes ")")
            }
            return "undef"
        }
        case typed.PrimOp.Len {
            rr := t.Referent(r) if t.IsRef(r) else r
            a := fe.arrayOf(rr)
            if a != types.UnknownT and fe.fixed(a) { return $fe.fixedLen(a) }
            return fe.let("extractvalue { i64, ptr } " $x ", 0")
        }
        case typed.PrimOp.AtomicLoad {
            it := t.Referent(r)
            return fe.let("load atomic " $fe.ty(it) ", ptr " $x " seq_cst, align " $fe.size(it))
        }
        case _ { }
    }
    y := fe.val(fe.arg(args, 1), t0)
    if lt == "bfloat" {
        # BF16 arithmetic and comparisons through F32, the result narrowed in integers: exact for a comparison, one
        # rounding for + - * / % (F32's 24 bits hold any of them before BF16's 8 do) - LLVM's own calls the runtime
        # library (T4)
        a, b := fe.widenBF16(x, "float"), fe.widenBF16(y, "float")
        w := match op {
            case typed.PrimOp.Add => "fadd"
            case typed.PrimOp.Sub => "fsub"
            case typed.PrimOp.Mul => "fmul"
            case typed.PrimOp.Div => "fdiv"
            case typed.PrimOp.Rem => "frem"
            case _ => ""
        }
        if w != "" { return fe.narrowBF16(fe.let($w " float " $a ", " $b)) }
        match op {
            case typed.PrimOp.Eq, typed.PrimOp.Ne, typed.PrimOp.Lt, typed.PrimOp.Le, typed.PrimOp.Gt, typed.PrimOp.Ge {
                return fe.compare(op, types.TypeId(13), a, b)   # F32
            }
            case _ { }
        }
    }
    match op {
        case typed.PrimOp.Add { return fe.let($("fadd " if fl else "add ") $lt " " $x ", " $y) }
        case typed.PrimOp.Sub { return fe.let($("fsub " if fl else "sub ") $lt " " $x ", " $y) }
        case typed.PrimOp.Mul { return fe.let($("fmul " if fl else "mul ") $lt " " $x ", " $y) }
        case typed.PrimOp.Div { return fe.let($("fdiv " if fl else ("udiv " if un else "sdiv ")) $lt " " $x ", " $y) }
        case typed.PrimOp.Rem { return fe.let($("frem " if fl else ("urem " if un else "srem ")) $lt " " $x ", " $y) }
        case typed.PrimOp.Shl, typed.PrimOp.Shr {
            t1 := fe.otype(fe.arg(args, 1))
            amt := fe.width(fe.val(fe.arg(args, 1), t1), t1, r)
            name := "shl " if op == typed.PrimOp.Shl else ("lshr " if un else "ashr ")
            return fe.let($name $lt " " $x ", " $amt)
        }
        case typed.PrimOp.BitAnd { return fe.let("and " $lt " " $x ", " $y) }
        case typed.PrimOp.BitOr { return fe.let("or " $lt " " $x ", " $y) }
        case typed.PrimOp.BitXor { return fe.let("xor " $lt " " $x ", " $y) }
        case typed.PrimOp.Eq, typed.PrimOp.Ne, typed.PrimOp.Lt, typed.PrimOp.Le, typed.PrimOp.Gt, typed.PrimOp.Ge {
            return fe.compare(op, r, x, y)
        }
        case typed.PrimOp.Same {
            if lt == "{ i64, ptr }" or lt == "{ ptr, ptr }" {
                w0 := "i64 " if lt == "{ i64, ptr }" else "ptr "
                a := fe.let("icmp eq " $w0 $fe.let("extractvalue " $lt " " $x ", 0") ", " $fe.let("extractvalue " $lt " " $y ", 0"))
                b := fe.let("icmp eq ptr " $fe.let("extractvalue " $lt " " $x ", 1") ", " $fe.let("extractvalue " $lt " " $y ", 1"))
                return fe.let("and i1 " $a ", " $b)
            }
            return fe.let("icmp eq " $lt " " $x ", " $y)
        }
        case typed.PrimOp.IsCase {
            if fe.E.enumWords(r) { return fe.let("icmp eq i64 " $fe.let("extractvalue " $lt " " $x ", 0") ", " $y) }
            return fe.let("icmp eq i32 " $x ", " $fe.let("trunc i64 " $y " to i32"))
        }
        case typed.PrimOp.AtomicStore {
            it := t.Referent(r)
            fe.w("store atomic " $fe.ty(it) " " $fe.val(fe.arg(args, 1), it) ", ptr " $x " seq_cst, align " $fe.size(it))
            return "undef"
        }
        case typed.PrimOp.AtomicAdd, typed.PrimOp.AtomicSwap {
            it := t.Referent(r)
            how := "add" if op == typed.PrimOp.AtomicAdd else "xchg"
            return fe.let("atomicrmw " $how " ptr " $x ", " $fe.ty(it) " " $fe.val(fe.arg(args, 1), it) " seq_cst")
        }
        case typed.PrimOp.AtomicCompareSwap {
            it := t.Referent(r)
            itl := fe.ty(it)
            c := fe.let(("cmpxchg ptr " $x ", " $itl " " $fe.val(fe.arg(args, 1), it) ", " $itl " " $fe.val(fe.arg(args, 2), it)
                         " seq_cst seq_cst"))
            return fe.let("extractvalue { " $itl ", i1 } " $c ", 0")
        }
        case _ {
            fe.gap("the operation " $op)
            return "undef"
        }
    }
}

# an integer value of type from at the width of type to
fn (fe mut fnEm&) width(v String&, from types.TypeId, to types.TypeId) String {
    t := fe.E.T
    a, b := t.Bits(t.Repr(from)), t.Bits(t.Repr(to))
    if a == b { return $v }
    if a > b { return fe.let("trunc " $fe.ty(t.Repr(from)) " " $v " to " $fe.ty(t.Repr(to))) }
    return fe.let("zext " $fe.ty(t.Repr(from)) " " $v " to " $fe.ty(t.Repr(to)))
}

fn (fe mut fnEm&) compare(op typed.PrimOp, r types.TypeId, x String&, y String&) String {
    t := fe.E.T
    lt := fe.ty(r)
    if t.IsFloat(r) {
        c := match op {
            case typed.PrimOp.Eq => "oeq"
            case typed.PrimOp.Ne => "une"
            case typed.PrimOp.Lt => "olt"
            case typed.PrimOp.Le => "ole"
            case typed.PrimOp.Gt => "ogt"
            case _ => "oge"
        }
        return fe.let("fcmp " $c " " $lt " " $x ", " $y)
    }
    un := t.IsUnsigned(r) or r == types.BoolT
    c := match op {
        case typed.PrimOp.Eq => "eq"
        case typed.PrimOp.Ne => "ne"
        case typed.PrimOp.Lt => "ult" if un else "slt"
        case typed.PrimOp.Le => "ule" if un else "sle"
        case typed.PrimOp.Gt => "ugt" if un else "sgt"
        case _ => "uge" if un else "sge"
    }
    # a pair (an array reference, a function value) is equal to another, null among them, when both its words are
    if lt == "{ i64, ptr }" or lt == "{ ptr, ptr }" {
        w0 := "i64 " if lt == "{ i64, ptr }" else "ptr "
        a := fe.let("icmp eq " $w0 $fe.let("extractvalue " $lt " " $x ", 0") ", " $fe.let("extractvalue " $lt " " $y ", 0"))
        b := fe.let("icmp eq ptr " $fe.let("extractvalue " $lt " " $x ", 1") ", " $fe.let("extractvalue " $lt " " $y ", 1"))
        both := fe.let("and i1 " $a ", " $b)
        # a returned local as one value of a conditional is placed in the if's block by the scope pass, not the result
        # scope (O26a) - a use after free under -sanitize; written as two returns until the pass is fixed
        if op == typed.PrimOp.Eq { return both }
        return fe.let("xor i1 " $both ", true")
    }
    return fe.let("icmp " $c " " $lt " " $x ", " $y)
}

# a value of type from as a to (T4, T6b, E26, T7c): widened, narrowed, between integers and floats, or the same bits
fn (fe mut fnEm&) convert(v String&, from types.TypeId, to types.TypeId) String {
    t := fe.E.T
    f, g := t.Repr(from), t.Repr(to)
    fl, gl := fe.ty(f), fe.ty(g)
    if t.KindOf(f) == types.Kind.Func and t.KindOf(g) == types.Kind.Func and fe.E.abiDiffers(f, g) { return fe.adapt(v, f, g) }
    if fl == gl { return $v }
    fi, gi := t.IsInt(f) or f == types.BoolT, t.IsInt(g) or g == types.BoolT
    if fi and gi {
        a, b := t.Bits(f) if f != types.BoolT else 1, t.Bits(g) if g != types.BoolT else 1
        if a > b { return fe.let("trunc " $fl " " $v " to " $gl) }
        return fe.let($("zext " if t.IsUnsigned(f) or f == types.BoolT else "sext ") $fl " " $v " to " $gl)
    }
    if fi and gl == "bfloat" {
        # T4: an integer rounded once to a BF16, by the runtime's own conversion - LLVM 18 rounds twice at -O0
        x := $v
        if t.Bits(f) < 64 { x = fe.let($("zext " if t.IsUnsigned(f) else "sext ") $fl " " $v " to i64") }
        neg := "false"
        mag := x
        if not t.IsUnsigned(f) {
            neg = fe.let("icmp slt i64 " $x ", 0")
            nx := fe.let("sub i64 0, " $x)
            mag = fe.let("select i1 " $neg ", i64 " $nx ", i64 " $x)
        }
        fe.E.runtime("__olang_int_bf16")
        return fe.let("call bfloat @__olang_int_bf16(i64 " $mag ", i1 " $neg ")")
    }
    if fi and gl == "half" {
        # T4/E26: through a double, which holds every integer short of F16's overflow exactly, so this rounds once; the
        # fence keeps LLVM 18 from folding "fpext (sitofp x to half)" past F16's overflow
        d := fe.let($("uitofp " if t.IsUnsigned(f) else "sitofp ") $fl " " $v " to double")
        fe.E.declare("llvm.arithmetic.fence.f64", "double @llvm.arithmetic.fence.f64(double)")
        fenced := fe.let("call double @llvm.arithmetic.fence.f64(double " $d ")")
        return fe.let("fptrunc double " $fenced " to half")
    }
    if fi and t.IsFloat(g) { return fe.let($("uitofp " if t.IsUnsigned(f) else "sitofp ") $fl " " $v " to " $gl) }
    if t.IsFloat(f) and gi { return fe.let($("fptoui " if t.IsUnsigned(g) else "fptosi ") $fl " " $v " to " $gl) }
    if t.IsFloat(f) and t.IsFloat(g) {
        # a BF16 widened by its bits, exactly, and an F32 narrowed to one in integers (T4: LLVM 18's own conversions
        # call the runtime library, or at -O0 round twice); F16 and BF16 meet through an F32
        if fl == "bfloat" and gl == "half" { return fe.let("fptrunc float " $fe.widenBF16($v, "float") " to half") }
        if fl == "bfloat" { return fe.widenBF16($v, gl) }
        if gl == "bfloat" {
            if fl == "float" { return fe.narrowBF16($v) }
            if fl == "half" { return fe.narrowBF16(fe.let("fpext half " $v " to float")) }
            return fe.let("fptrunc " $fl " " $v " to bfloat")
        }
        return fe.let($("fpext " if t.Bits(g) > t.Bits(f) else "fptrunc ") $fl " " $v " to " $gl)
    }
    # an array between a run-time and a fixed length (T7c): its storage taken, or read whole
    fa, ga := fe.arrayOf(t.Referent(f) if t.IsRef(f) else f), fe.arrayOf(t.Referent(g) if t.IsRef(g) else g)
    if fa != types.UnknownT and ga != types.UnknownT {
        if fe.fixed(fa) and not t.IsRef(f) and not fe.fixed(ga) {
            # a fixed array's value as a run-time-length one: storage of its own, which MIR does not place - the
            # program's under the stand-in placement
            el := t.Elem(fa)
            n := fe.fixedLen(fa)
            fe.E.runtime("__olang_scope_alloc")
            p := fe.let("call ptr @__olang_scope_alloc(ptr " $fe.program() ", i64 " $(n * fe.size(el)) ")")
            fe.store(fe.ty(fa), v, p)
            return fe.pair($n, p)
        }
        data, n := fe.arrayParts(v, f)
        if fe.fixed(ga) {
            if t.IsRef(g) { return data }
            return fe.load(fe.ty(ga), data)
        }
        return fe.pair(n, data)
    }
    fe.gap("a conversion from " $t.Canon(from) " to " $t.Canon(to))
    return "undef"
}

# a BF16 widened to wide ("float", "double"): its bits are an F32's top half, exactly
fn (fe mut fnEm&) widenBF16(v String&, wide String&) String {
    bits := fe.let("bitcast bfloat " $v " to i16")
    z := fe.let("zext i16 " $bits " to i32")
    sh := fe.let("shl i32 " $z ", 16")
    f := fe.let("bitcast i32 " $sh " to float")
    if wide == "float" { return f }
    return fe.let("fpext float " $f " to " $wide)
}

# an F32 narrowed to a BF16: to nearest, ties to even, a NaN kept with the top of its payload and made quiet - the
# bits "fptrunc float to bfloat" gives, in integers
fn (fe mut fnEm&) narrowBF16(f String&) String {
    u := fe.let("bitcast float " $f " to i32")
    hi := fe.let("lshr i32 " $u ", 16")
    lsb := fe.let("and i32 " $hi ", 1")
    bias := fe.let("add i32 " $lsb ", 32767")
    sum := fe.let("add i32 " $u ", " $bias)
    rnd := fe.let("lshr i32 " $sum ", 16")
    quiet := fe.let("or i32 " $hi ", 64")
    mag := fe.let("and i32 " $u ", 2147483647")
    nan := fe.let("icmp ugt i32 " $mag ", 2139095040")
    w := fe.let("select i1 " $nan ", i32 " $quiet ", i32 " $rnd)
    tr := fe.let("trunc i32 " $w " to i16")
    return fe.let("bitcast i16 " $tr " to bfloat")
}

# whether op over args, typed ty, has a true result ty cannot hold (E15a's OVERFLOW)
fn (fe mut fnEm&) overflows(op typed.PrimOp, ty types.TypeId, args mir.Range) String {
    t := fe.E.T
    a0 := fe.arg(args, 0)
    t0 := fe.otype(a0)
    r := t.Repr(t0)
    g := t.Repr(ty)
    lt := fe.ty(r)
    x := fe.val(a0, t0)
    un := t.IsUnsigned(r)
    bits := t.Bits(r)
    match op {
        case typed.PrimOp.Add, typed.PrimOp.Sub, typed.PrimOp.Mul {
            y := fe.val(fe.arg(args, 1), t0)
            name := match op {
                case typed.PrimOp.Add => "add"
                case typed.PrimOp.Sub => "sub"
                case _ => "mul"
            }
            intr := "llvm." $("u" if un else "s") $name ".with.overflow.i" $bits
            fe.E.declare(intr, "{ " $lt ", i1 } @" $intr "(" $lt ", " $lt ")")
            v := fe.let("call { " $lt ", i1 } @" $intr "(" $lt " " $x ", " $lt " " $y ")")
            return fe.let("extractvalue { " $lt ", i1 } " $v ", 1")
        }
        case typed.PrimOp.Div {
            if un { return "false" }
            y := fe.val(fe.arg(args, 1), t0)
            min := $(I64(1) << (bits - 1)) if bits < 64 else "-9223372036854775808"
            m := fe.let("icmp eq " $lt " " $x ", " $("-" if bits < 64 else "") $min)
            n := fe.let("icmp eq " $lt " " $y ", -1")
            return fe.let("and i1 " $m ", " $n)
        }
        case typed.PrimOp.Neg {
            if un { return fe.let("icmp ne " $lt " " $x ", 0") }
            min := $(I64(1) << (bits - 1)) if bits < 64 else "9223372036854775808"
            return fe.let("icmp eq " $lt " " $x ", -" $min)
        }
        case typed.PrimOp.Convert {
            if t.IsFloat(r) {
                d := $x
                if t.Bits(r) != 64 { d = fe.let("fpext " $lt " " $x " to double") }
                gb := t.Bits(g)
                lo := ""
                hi := ""
                if t.IsUnsigned(g) {
                    lo = fe.let("fcmp ogt double " $d ", -1.0")
                    hi = fe.let("fcmp olt double " $d ", " $fe.E.pow2(gb))
                } else {
                    if gb == 64 {
                        # -2^63: 2^63's bits with the sign bit set (a hex constant takes no "-")
                        lo = fe.let("fcmp oge double " $d ", " $fe.E.constText(types.TypeId(14), (I64(F64(1.0).Bits()) + (I64(63) << 52)) | (I64(1) << 63)))
                    } else {
                        lo = fe.let("fcmp ogt double " $d ", " $fe.E.constText(types.TypeId(14), I64((F64(0) - F64(I64(1) << (gb - 1)) - 1.0).Bits())))
                    }
                    hi = fe.let("fcmp olt double " $d ", " $fe.E.pow2(gb - 1))
                }
                return fe.let("xor i1 " $fe.let("and i1 " $lo ", " $hi) ", true")
            }
            # an integer narrowed or changing sign: converted there and back, a different value
            there := fe.convert(x, t0, ty)
            back := fe.convert(there, ty, t0)
            diff := fe.let("icmp ne " $lt " " $back ", " $x)
            if un == t.IsUnsigned(g) { return diff }
            # a sign change: a negative made unsigned, or an unsigned top bit made negative
            neg := ""
            if un {
                neg = fe.let("icmp slt " $fe.ty(g) " " $there ", 0")
            } else {
                neg = fe.let("icmp slt " $lt " " $x ", 0")
            }
            return fe.let("or i1 " $diff ", " $neg)
        }
        case _ {
            fe.gap("an overflow test of " $op)
            return "false"
        }
    }
}

fn (e mut Emitter&) pow2(k I64) String { return e.constText(types.TypeId(14), I64(F64(1.0).Bits()) + (k << 52)) }

# ---- function values ----

# a function value (T21): the pair { code, environment } - the environment, where there are captures, built in s
fn (fe mut fnEm&) closure(code mir.FnKey, ty types.TypeId, s mir.ScopeRef, args mir.Range, caps mir.Range) String {
    fe.E.want(code)
    sym := fe.E.codeFor(code, ty)
    env := "null"
    if args.N > I32(0) {
        nc := fe.E.capVars(code)
        b := StringBuilder()
        b.Push("{ ")
        for i in range args.N {
            if i > 0 { b.Push(", ") }
            b.Push(fe.ty(fe.otype(fe.arg(args, i))))
        }
        for k in range nc { b.Push(", ptr") }
        b.Push(" }")
        et := b.ToString()
        size := fe.let("ptrtoint ptr " $fe.let("getelementptr " $et ", ptr null, i32 1") " to i64")
        env = fe.alloc(s, size, 8, et)
        for i in range args.N {
            x := fe.arg(args, i)
            xt := fe.otype(x)
            at := fe.let("getelementptr " $et ", ptr " $env ", i32 0, i32 " $i)
            if fe.viaMem(xt) {
                fe.put(at, xt, x)
            } else {
                fe.store(fe.ty(xt), fe.val(x, xt), at, ", !tbaa !28")
            }
        }
        # where the captures holding references live (D16c): null for the program's, and for each the plan did not say
        for j in range nc {
            sc := "null"
            if j < I64(caps.N) {
                r := fe.F.Refs[I64(caps.At) + j]
                isProg := match r {
                    case mir.ScopeRef.Program => true
                    case _ => false
                }
                if not isProg { sc = fe.scope(r) }
            }
            # the scope may now reach another thread with the closure, whose code asks for it as its thread may build
            # there: claimed for this one first (P2, decision 48 - a scope's owner is set before it leaves its thread)
            if sc != "null" {
                fe.E.runtime("__olang_scope_escape")
                fe.w("call void @__olang_scope_escape(ptr " $sc ")")
            }
            fe.store("ptr", sc, fe.let("getelementptr " $et ", ptr " $env ", i32 0, i32 " $(I64(args.N) + j)), ", !tbaa !28")
        }
    }
    a := fe.let("insertvalue { ptr, ptr } undef, ptr @" $sym ", 0")
    return fe.let("insertvalue { ptr, ptr } " $a ", ptr " $env ", 1")
}

# the code a function value of type ty calls for code: the function itself where it takes an environment and passes
# the value's scopes, else a thunk of its own taking one
fn (e mut Emitter&) codeFor(code mir.FnKey, ty types.TypeId) String {
    s := e.sym(code)
    mine := e.codeType(code)
    if e.hasEnv(code) and e.passedOf(code, mine) == mir.PassedCount(e.T, mir.Callee.Value(mir.Operand.None), ty) {
        return s
    }
    key := e.thunkSym(s, ty)
    if not e.thunkFor.Has(key) {
        e.thunkFor.Put($key, true)
        e.thunkKeys.Push(code)
        e.thunkTys.Push(ty)
    }
    return key
}

# a function's own type, as lowering gives it
fn (e mut Emitter&) codeType(k mir.FnKey) types.TypeId {
    return match k {
        case mir.FnKey.Body(id) => e.Lw.Bodies[I64(id)].Ty
        case mir.FnKey.Helper(kind, t) => mir.HelperType(e.T, kind, t)
        case _ => e.Lw.LowerKey(k).Ty
    }
}

# a thunk: the code of a function value of type ty that calls code - its environment passed on where code takes one,
# the value's scopes passed on (the program's for any more code takes, under the stand-in placement), its parameters
# passed on as they came
fn (e mut Emitter&) thunk(code mir.FnKey, ty types.TypeId) {
    t := e.T
    s := e.sym(code)
    mine := e.codeType(code)
    vp := mir.PassedCount(t, mir.Callee.Value(mir.Operand.None), ty)
    cp := e.passedOf(code, mine)
    home := HomeLocal if e.homeOf(code) == HomeLocal else HomeShared
    tsym := e.thunkSym(s, ty)
    hdr := e.header(code, ty, tsym, vp, true, linkFor(home))
    b := StringBuilder()
    b.Push(hdr)
    b.Push("entry:\n")
    args := StringBuilder()
    first := true
    if e.hasEnv(code) {
        args.Push("ptr %env")
        first = false
    }
    res := t.Result(ty)
    if res != types.VoidT and res != types.NoreturnT and t.ViaMemory(res) {
        if not first { args.Push(", ") }
        args.Push("ptr %out")
        first = false
    }
    for i in range cp {
        if not first { args.Push(", ") }
        first = false
        if i < vp {
            args.Push("ptr %v" $i)
        } else {
            e.define("__olang_prog_scope", "@__olang_prog_scope = external thread_local(initialexec) global ptr")
            b.Push("  %g" $i " = load ptr, ptr @__olang_prog_scope\n")
            args.Push("ptr %g" $i)
        }
    }
    ps := t.Items(t.Params(ty))
    pass := t.Passing(ty)
    for i in range ps.Len() {
        if not first { args.Push(", ") }
        first = false
        match pass[i] {
            case 'm' { args.Push("ptr %a" $i) }
            case 's' { args.Push("ptr %a" $i "c, ptr %a" $i "e") }
            case _ { args.Push($e.ty(ps[i]) " %a" $i) }
        }
    }
    rt := t.RetLlvm(mine)
    vt := t.RetLlvm(ty)
    if rt == "void" {
        b.Push("  call void @" $s "(" $args.ToString() ")\n")
        # a function that cannot fail as a value that can (R6): it never fails
        b.Push("  ret void\n}\n\n" if vt == "void" else "  ret i32 0\n}\n\n")
        e.item(tsym, home, b.ToString())
        return
    }
    b.Push("  %r = call " $rt " @" $s "(" $args.ToString() ")\n")
    if vt == rt and t.Errors(mine) == t.Errors(ty) {
        b.Push("  ret " $rt " %r\n}\n\n")
        e.item(tsym, home, b.ToString())
        return
    }
    # the value's error list differs from its function's (R6, R17): its result, and its code re-encoded under the
    # value's list - a code its list does not name being the value's default error
    fe mut fnEm&e = fnEm(e, mir.Fn(code, ty, 0, source.Span(0, 0)), code)
    from := t.Errors(mine)
    to := t.Errors(ty)
    res2 := t.Result(mine)
    hasRes := res2 != types.VoidT and res2 != types.NoreturnT and not t.ViaMemory(res2)
    code0 := "0"
    if t.Items(from).Len() > 0 { code0 = "%r" if not hasRes else fe.let("extractvalue " $rt " %r, 0") }
    c := fe.recode(code0, from, to) if t.Items(from).Len() > 0 else "0"
    if vt == "i32" {
        fe.w("ret i32 " $c)
    } else if t.Items(to).Len() == 0 {
        fe.w("ret " $vt " " $(fe.let("extractvalue " $rt " %r, 1") if t.Items(from).Len() > 0 else "%r"))
    } else {
        v := fe.let("extractvalue " $rt " %r, 1") if t.Items(from).Len() > 0 else "%r"
        a := fe.let("insertvalue " $vt " zeroinitializer, i32 " $c ", 0")
        fe.w("ret " $vt " " $fe.let("insertvalue " $vt " " $a ", " $e.ty(t.Result(ty)) " " $v ", 1"))
    }
    b.Push(fe.code.ToString())
    b.Push("}\n\n")
    e.item(tsym, home, b.ToString())
}

# a thunk's symbol: its function's, and the value's type spelled (stable whatever else the program holds)
fn (e mut Emitter&) thunkSym(s String&, ty types.TypeId) String { return $s "_fv_" $types.Symbol(e.T.Canon(ty)) }

# an adapter's key between two function types
fn (e mut Emitter&) adaptKey(f types.TypeId, g types.TypeId) String { return types.Symbol($e.T.Canon(f) "|" $e.T.Canon(g)) }

# whether a call through a function value of type f and one of type g differ in what is returned (R6: a function that
# cannot fail as a value that can, or another error list)
fn (e mut Emitter&) abiDiffers(f types.TypeId, g types.TypeId) Bool {
    t := e.T
    return t.RetLlvm(f) != t.RetLlvm(g) or t.Errors(f) != t.Errors(g)
}

# a function value of type f as one of type g whose ABI differs: an environment holding the value, in the program's
# scope (it may be kept anywhere), called through an adapter that re-encodes what it returns
fn (fe mut fnEm&) adapt(v String&, f types.TypeId, g types.TypeId) String {
    e := fe.E
    key := e.adaptKey(f, g)
    if not e.adaptAt.Has(key) {
        e.adaptAt.Put($key, true)
        e.adaptFrom.Push(f)
        e.adaptTo.Push(g)
    }
    e.runtime("__olang_scope_alloc")
    env := fe.let("call ptr @__olang_scope_alloc(ptr " $fe.program() ", i64 16)")
    fe.store("{ ptr, ptr }", v, env)
    a := fe.let("insertvalue { ptr, ptr } undef, ptr @olang_fvadapt_" $key ", 0")
    return fe.let("insertvalue { ptr, ptr } " $a ", ptr " $env ", 1")
}

# the adapter of fvAdapt: the inner value's code called with its environment, the outer's scopes (the program's for
# any more the inner takes) and arguments, its error code re-encoded under g's list (R6, R17)
fn (e mut Emitter&) fvAdapter(f types.TypeId, g types.TypeId) {
    t := e.T
    vp := mir.PassedCount(t, mir.Callee.Value(mir.Operand.None), g)
    ip := mir.PassedCount(t, mir.Callee.Value(mir.Operand.None), f)
    key := e.adaptKey(f, g)
    hdr := e.header(mir.FnKey.Init(0), g, "olang_fvadapt_" $key, vp, true, "linkonce_odr")
    fe mut fnEm&e = fnEm(e, mir.Fn(mir.FnKey.Init(0), g, 0, source.Span(0, 0)), mir.FnKey.Init(0))
    code := fe.load("ptr", "%env")
    inner := fe.load("ptr", fe.let("getelementptr { ptr, ptr }, ptr %env, i32 0, i32 1"))
    args := StringBuilder()
    args.Push("ptr " $inner)
    res := t.Result(f)
    if res != types.VoidT and res != types.NoreturnT and t.ViaMemory(res) { args.Push(", ptr %out") }
    for i in range ip {
        if i < vp {
            args.Push(", ptr %v" $i)
        } else {
            args.Push(", ptr " $fe.program())
        }
    }
    ps := t.Items(t.Params(g))
    pass := t.Passing(g)
    for i in range ps.Len() {
        match pass[i] {
            case 'm' { args.Push(", ptr %a" $i) }
            case 's' { args.Push(", ptr %a" $i "c, ptr %a" $i "e") }
            case _ { args.Push(", " $e.ty(ps[i]) " %a" $i) }
        }
    }
    rt := t.RetLlvm(f)
    vt := t.RetLlvm(g)
    from := t.Errors(f)
    to := t.Errors(g)
    if rt == "void" {
        fe.w("call void " $code "(" $args.ToString() ")")
        fe.w("ret void" if vt == "void" else "ret i32 0")
    } else {
        r := fe.let("call " $rt " " $code "(" $args.ToString() ")")
        hasRes := res != types.VoidT and res != types.NoreturnT and not t.ViaMemory(res)
        errs := t.Items(from).Len() > 0
        c := "0"
        if errs { c = fe.recode(r if not hasRes else fe.let("extractvalue " $rt " " $r ", 0"), from, to) }
        val := (fe.let("extractvalue " $rt " " $r ", 1") if errs else r) if hasRes else ""
        if vt == "i32" {
            fe.w("ret i32 " $c)
        } else if t.Items(to).Len() == 0 {
            fe.w("ret " $vt " " $val)
        } else {
            a := fe.let("insertvalue " $vt " zeroinitializer, i32 " $c ", 0")
            fe.w("ret " $vt " " $fe.let("insertvalue " $vt " " $a ", " $e.ty(t.Result(g)) " " $val ", 1"))
        }
    }
    e.item("olang_fvadapt_" $key, HomeShared, $hdr "entry:\n" $fe.code.ToString() "}\n\n")
}

# a destructor as the runtime calls it, fn(ptr instance, ptr scope): the scope being closed passed for every scope
fn (e mut Emitter&) dtorThunk(k mir.FnKey) {
    t := e.T
    s := e.sym(k)
    ty := e.codeType(k)
    b := StringBuilder()
    b.Push("define linkonce_odr void @" $s "_rt(ptr %inst, ptr %scope) #0 {\nentry:\n  call " $t.RetLlvm(ty) " @" $s "(")
    n := e.passedOf(k, ty)
    for i in range n {
        if i > 0 { b.Push(", ") }
        b.Push("ptr %scope")
    }
    if n > 0 { b.Push(", ") }
    b.Push("ptr %inst)\n  ret void\n}\n\n")
    e.item($s "_rt", HomeShared, b.ToString())
}

# ---- terminators ----

fn (fe mut fnEm&) term(tm mir.Term) {
    t := fe.E.T
    if fe.dbgSp >= 0 { fe.locate(termSpan(tm)) }
    match tm {
        case mir.Term.None { fe.w("unreachable") }
        case mir.Term.Goto(b) { fe.w("br label %" $blockName(b)) }
        case mir.Term.Branch(c, yes, no) {
            fe.w("br i1 " $fe.val(c, types.BoolT) ", label %" $blockName(yes) ", label %" $blockName(no))
        }
        case mir.Term.Switch(x, cases, other) {
            xt := fe.otype(x)
            lt := fe.ty(xt)
            v := fe.val(x, xt)
            b := StringBuilder()
            b.Push("switch " $lt " " $v ", label %" $blockName(other) " [")
            for i in range cases.N {
                c := fe.F.Cases[I64(cases.At) + i]
                b.Push(" " $lt " " $fe.E.constText(xt, c.Value) ", label %" $blockName(c.To))
            }
            b.Push(" ]")
            fe.w(b.ToString())
        }
        case mir.Term.Call(_, c) { fe.call(fe.F.Calls[I64(c)]) }
        case mir.Term.Return(_, x) {
            rt := t.RetLlvm(fe.F.Ty)
            if fe.via {
                fe.put("%out", fe.res, x)
                if fe.errs { fe.store("i32", "0", "%rv") }
            } else if fe.errs {
                if fe.res == types.VoidT {
                    fe.store("i32", "0", "%rv")
                } else {
                    a := fe.let("insertvalue " $rt " zeroinitializer, " $fe.ty(fe.res) " " $fe.val(x, fe.res) ", 1")
                    fe.store(rt, a, "%rv")
                }
            } else if rt != "void" {
                fe.store(rt, fe.val(x, fe.res), "%rv")
            }
            fe.w("br label %ret")
        }
        case mir.Term.Raise(sp, code) {
            fe.trace(sp)
            rt := t.RetLlvm(fe.F.Ty)
            c := fe.val(code, mir.I32T)
            if rt == "i32" {
                fe.store("i32", c, "%rv")
            } else {
                fe.store(rt, fe.let("insertvalue " $rt " zeroinitializer, i32 " $c ", 0"), "%rv")
            }
            fe.w("br label %ret")
        }
        case mir.Term.Wait(_, j, ok, code, failed) {
            fe.E.declare("__olang_join_tasks", "i64 @__olang_join_tasks(ptr)")
            e := fe.let("call i64 @__olang_join_tasks(ptr %jh" $j ")")
            if failed == mir.NoBlock {
                fe.w("br label %" $blockName(ok))
            } else {
                c := fe.let("trunc i64 " $e " to i32")
                if code != mir.NoLocal { fe.store("i32", c, fe.localAt(code)) }
                bad := fe.let("icmp ne i32 " $c ", 0")
                fe.w("br i1 " $bad ", label %" $blockName(failed) ", label %" $blockName(ok))
            }
        }
        case mir.Term.Exit(sp, kind, msg) { fe.exit(sp, kind, msg) }
    }
}

# the test or the process ends (S16-S18a): a failed check prints "FILE:LINE: " and what failed, an assert's message
# after it
fn (fe mut fnEm&) exit(sp source.Span, kind mir.ExitKind, msg mir.Operand) {
    where := fe.E.where(fe.F.File, sp)
    what := mir.ExitText(kind)
    if kind == mir.ExitKind.Done or kind == mir.ExitKind.Fail {
        fe.gap("an Exit " $kind)
        what = "ended"
    }
    if kind == mir.ExitKind.Escaped {
        # S16, S18d: "left the test" in the trace, the error named on the test's FAIL line
        text := ""
        match msg {
            case mir.Operand.Data(_, c, _, _) { text = fe.constText(c) }
            case _ { }
        }
        fe.E.declare("__olang_ert_pass", "void @__olang_ert_pass(ptr)")
        fe.E.declare("__olang_test_error", "void @__olang_test_error(ptr)")
        fe.w("call void @__olang_ert_pass(ptr " $fe.E.cstr($where ": left the test\n") ")")
        fe.w("call void @__olang_test_error(ptr " $fe.E.cstr(text) ")")
        fe.w("unreachable")
        return
    }
    if kind == mir.ExitKind.Error {
        # E35: "FILE:LINE: Type.WORD", where the error came from not kept outside a test or a debug build (S18d)
        text := ""
        match msg {
            case mir.Operand.Data(_, c, _, _) { text = fe.constText(c) }
            case _ { }
        }
        hint := "" if fe.E.traced() else "(build with -debug to see where it came from)\n"
        fe.E.declare("__olang_bang_failed", "void @__olang_bang_failed(ptr)")
        fe.w("call void @__olang_bang_failed(ptr " $fe.E.cstr($where ": " $text "\n" $hint) ")")
        fe.w("unreachable")
        return
    }
    match msg {
        case mir.Operand.None {
            fe.E.runtime("__olang_check_failed")
            fe.w("call void @__olang_check_failed(ptr " $fe.E.cstr($where ": " $what "\n") ")")
        }
        case _ {
            fe.E.runtime("__olang_check_failed_text")
            mt := fe.otype(msg)
            v := fe.val(msg, mt)
            data, n := fe.arrayParts(v, mt)
            p := fe.pair(n, data)
            fe.w("call void @__olang_check_failed_text(ptr " $fe.E.cstr($where ": " $what ": ") ", { i64, ptr } " $p ")")
        }
    }
    fe.w("unreachable")
}

# a call (MIR's Call terminator): its arguments as its callee takes them, its result stored on its ok edge, its error
# code on its error edge
fn (fe mut fnEm&) call(c mir.Call) {
    t := fe.E.T
    ty := types.UnknownT
    target := ""
    env := ""
    isExtern := false
    match c.Target {
        case mir.Callee.Fn(k, fty) {
            fe.E.want(k)
            ty = fty
            target = "@" $fe.E.sym(k)
            if fe.E.hasEnv(k) { env = "null" }
        }
        case mir.Callee.Extern(f, fty) {
            ty = fty
            target = "@" $fe.E.extern(f, fty)
            isExtern = true
        }
        case mir.Callee.Value(x) {
            ty = fe.otype(x)
            v := fe.val(x, ty)
            target = fe.let("extractvalue { ptr, ptr } " $v ", 0")
            env = fe.let("extractvalue { ptr, ptr } " $v ", 1")
        }
    }
    res := t.Result(ty)
    errs := t.Items(t.Errors(ty)).Len() > 0
    via := res != types.VoidT and res != types.NoreturnT and t.ViaMemory(res)
    args := StringBuilder()
    first := true
    if env != "" {
        args.Push("ptr " $env)
        first = false
    }
    out := ""
    if via {
        out = fe.slot(res)
        if not first { args.Push(", ") }
        args.Push("ptr " $out)
        first = false
    }
    for i in range c.Scopes.N {
        if not first { args.Push(", ") }
        first = false
        args.Push("ptr " $fe.scope(fe.F.Refs[I64(c.Scopes.At) + i]))
    }
    ps := t.Items(t.Params(ty))
    pass := t.Passing(ty)
    for i in range ps.Len() {
        if not first { args.Push(", ") }
        first = false
        x := fe.arg(c.Args, i)
        if not isExtern and pass[i] == 'm' {
            # the callee's own copy, made before the arguments after it run
            p := fe.slot(ps[i])
            fe.put(p, ps[i], x)
            args.Push("ptr " $p)
            continue
        }
        v := fe.val(x, ps[i])
        if isExtern {
            args.Push(fe.externArg(v, ps[i]))
            continue
        }
        match pass[i] {
            case 's' {
                args.Push("ptr " $fe.let("extractvalue { ptr, ptr } " $v ", 0") ", ptr " $fe.let("extractvalue { ptr, ptr } " $v ", 1"))
            }
            case _ { args.Push($fe.ty(ps[i]) " " $v) }
        }
    }
    rt := fe.E.externRet(ty) if isExtern else t.RetLlvm(ty)
    r := ""
    if rt == "void" {
        fe.w("call void " $target "(" $args.ToString() ")")
    } else {
        r = fe.let("call " $rt " " $target "(" $args.ToString() ")")
    }
    if res == types.NoreturnT {
        fe.w("unreachable")
        return
    }
    value := ""
    if via {
        value = out
    } else if res != types.VoidT {
        value = fe.let("extractvalue " $rt " " $r ", 1") if errs else r
    }
    if errs {
        code := r if (via or res == types.VoidT) else fe.let("extractvalue " $rt " " $r ", 0")
        if c.Code != mir.NoLocal { fe.store("i32", code, fe.localAt(c.Code)) }
        bad := fe.let("icmp ne i32 " $code ", 0")
        ok := fe.fresh("ok")
        fe.w("br i1 " $bad ", label %" $blockName(c.Err) ", label %" $ok)
        fe.label(ok)
    }
    if c.HasDest and value != "" {
        at, dt := fe.addr(c.Dest)
        if via {
            fe.memmove(at, out, fe.size(res))
        } else {
            fe.store(fe.ty(dt), value, at)
        }
    }
    fe.w("br label %" $blockName(c.Ok))
}

# a constant of this function's tables that is text, as text
fn (fe mut fnEm&) constText(c I32) String {
    b := StringBuilder()
    match fe.F.Consts[I64(c)] {
        case mir.ConstNode.Bytes(r) {
            for i in range r.N { b.PushChar(Char(fe.F.Bytes[I64(r.At) + i])) }
        }
        case _ { }
    }
    return b.ToString()
}

# an extern's argument (X3): a number as itself, an array as a pointer to its first element, a function value (the
# runtime's own, X2) as its two words
fn (fe mut fnEm&) externArg(v String&, ty types.TypeId) String {
    t := fe.E.T
    r := t.Repr(ty)
    if t.KindOf(r) == types.Kind.Func {
        return "ptr " $fe.let("extractvalue { ptr, ptr } " $v ", 0") ", ptr " $fe.let("extractvalue { ptr, ptr } " $v ", 1")
    }
    x := t.Referent(r) if t.IsRef(r) else r
    if fe.arrayOf(x) != types.UnknownT {
        data, _ := fe.arrayParts(v, ty)
        return "ptr " $data
    }
    return $fe.ty(r) " " $v
}

# an extern's name, declared with C's types (X1-X3)
fn (e mut Emitter&) extern(f I64, ty types.TypeId) String {
    t := e.T
    name := $e.text(e.P.FnDecl(f).Name)
    # X8: an exact C math function of its exact prototype is LLVM's intrinsic, an instruction where the target has one
    intr := e.mathIntrinsic(name, ty)
    if intr != "" {
        if not e.has(intr) { e.declare(intr, $e.externRet(ty) " @" $intr "(" $e.mathParams(ty) ")") }
        return intr
    }
    if e.has(name) { return name }
    b := StringBuilder()
    b.Push($e.externRet(ty) " @" $name "(")
    ps := t.Items(t.Params(ty))
    for i in range ps.Len() {
        if i > 0 { b.Push(", ") }
        r := t.Repr(ps[i])
        x := t.Referent(r) if t.IsRef(r) else r
        if t.KindOf(r) == types.Kind.Func {
            b.Push("ptr, ptr")
        } else if t.KindOf(t.Repr(x)) == types.Kind.Array {
            b.Push("ptr")
        } else {
            b.Push(e.ty(r))
        }
    }
    b.Push(")")
    # X8: any other C math function as C's default -fmath-errno declares it (it may write errno), and nobuiltin, so LLVM
    # never rewrites a call of it - the program calls exactly the function the evaluator called
    if mathInexact.Has(name) and e.mathParams(ty) != "" { b.Push(" nobuiltin memory(write)") }
    e.declare(name, b.ToString())
    return name
}

# X8's exact functions, by their C name (F64's; F32's ends in "f"), the intrinsic named the same: how many operands
mathExact Map<String&, I64> = mathExactTable()

fn mathExactTable() Map<String&, I64> {
    out Map<String&, I64>
    for x in String&["sqrt", "floor", "ceil", "trunc", "round", "roundeven", "fabs"] { out.Put(x, 1) }
    out.Put("copysign", 2)
    out.Put("fma", 3)
    return out
}

mathInexact Map<String&, Bool> = mathInexactTable()

fn mathInexactTable() Map<String&, Bool> {
    out Map<String&, Bool>
    for x in String&["cbrt", "exp", "exp2", "expm1", "log", "log2", "log10", "log1p", "pow", "hypot", "sin", "cos", "tan"
                     "asin", "acos", "atan", "atan2", "sinh", "cosh", "tanh", "erf", "erfc"] {
        out.Put(x, true)
        out.Put($x "f", true)
    }
    return out
}

# the intrinsic an exact C math function of its exact prototype is ("llvm.fma.f32" for fmaf), "" for any other
fn (e mut Emitter&) mathIntrinsic(name String&, ty types.TypeId) String {
    t := e.T
    base := name[:]
    f32 := false
    if not mathExact.Has(base) and name.EndsWith("f") {
        base = name[:name.Len() - 1]
        f32 = true
    }
    n := try mathExact.Get(base) catch { return "" }
    ps := t.Items(t.Params(ty))
    want := types.Kind.F32 if f32 else types.Kind.F64
    if ps.Len() != n or t.KindOf(t.Result(ty)) != want { return "" }
    for p in ps {
        if t.KindOf(p) != want { return "" }
    }
    return "llvm." $base ".f" $("32" if f32 else "64")
}

# a math function's parameters spelled for its declaration: every one F32 or F64 - "" where one is not
fn (e mut Emitter&) mathParams(ty types.TypeId) String {
    t := e.T
    b := StringBuilder()
    for i, p in t.Items(t.Params(ty)) {
        if t.KindOf(p) != types.Kind.F32 and t.KindOf(p) != types.Kind.F64 { return "" }
        if i > 0 { b.Push(", ") }
        b.Push(e.ty(p))
    }
    return b.ToString()
}

fn (e mut Emitter&) externRet(ty types.TypeId) String {
    r := e.T.Result(ty)
    if r == types.VoidT or r == types.NoreturnT { return "void" }
    return e.ty(r)
}

# ---- the runtime ----

# what a module carries of the runtime (std/runtime/runtime.ll, filled in for the build as the runtime's own object
# is): its types, and an item for each symbol it defines - a function's declaration, a global's external declaration,
# and the body of what it marks for inlining as available_externally, so a module's own optimization sees through a
# scope's close and the arena's fast path (runtime.Decls, stage 0's emitRuntimeDecls). Each item is copied into an
# object only where named, so an object declares exactly what it calls
fn (e mut Emitter&) runtimeItems() {
    if e.rtRead { return }
    e.rtRead = true
    text := try olrt.Text(e.Arch, e.San, false) catch olrt.Bad {
        e.gap("the runtime's text (std/runtime/runtime.ll could not be filled in)")
        return
    }
    tys := StringBuilder()
    body := StringBuilder()
    bodySym := ""
    for line in olrt.Decls(text).Lines() {
        if bodySym != "" {
            body.Push(line)
            body.PushChar('\n')
            if line == "}" {
                e.item(bodySym, HomeShared, body.ToString())
                body = StringBuilder()
                bodySym = ""
            }
            continue
        }
        if line.StartsWith("%") {
            tys.Push(line)
            tys.PushChar('\n')
            continue
        }
        sym := declaredSymbol(line)
        if sym == "" { continue }
        if line.StartsWith("define ") {
            bodySym = sym
            body.Push(line)
            body.PushChar('\n')
        } else {
            e.item(sym, HomeShared, $line "\n")
        }
    }
    # a text builder's layout, which the runtime reaches by offsets and so does not name: emission's own (E11b)
    tys.Push("%olang.builder = type { ptr, i64, i64, ptr, ptr }\n")
    e.rtTypes = tys.ToString()
}

# the symbol a line of the runtime's declarations declares or defines: after its first "@", to "(" or " = "
fn declaredSymbol(line String&) String {
    at := try line.Find("@") catch { return "" }
    i := at + 1
    for i < line.Len() and symbolChar(line[i]) { i++ }
    return $line[at + 1:i]
}

# a runtime function: the runtime declares it (runtimeItems), which this only checks
fn (e mut Emitter&) runtime(name String&) {
    e.runtimeItems()
    if not e.has(name) { e.gap("an undeclared runtime function " $name) }
}

# ---- the program's entry ----

# main: the command line kept (B4a), the thread made known, each module initialized (B5a), the root's main called - an
# error escaping it printed, the status 1 (B4)
# whether the module of this file calls retire() (M19d)
fn (e mut Emitter&) retires(file I64) Bool {
    for m in e.P.L.Mods {
        if m.File == file { return m.Retires }
    }
    return false
}

# B2f: the scope sanitizer's handler, in place before anything can close a scope
fn (e mut Emitter&) sanInit(b mut StringBuilder&) {
    if not e.San { return }
    e.runtime("__olang_san_init")
    b.Push("  call void @__olang_san_init()\n")
}

fn (e mut Emitter&) entry(inits List<I64>, mainBody I64) {
    t := e.T
    e.define("__olang_argc", "@__olang_argc = external global i32")
    e.define("__olang_argv", "@__olang_argv = external global ptr")
    e.runtime("__olang_thread_init")
    b := StringBuilder()
    b.Push("define i32 @main(i32 %argc, ptr %argv) #0 {\nentry:\n")
    b.Push("  store i32 %argc, ptr @__olang_argc\n  store ptr %argv, ptr @__olang_argv\n")
    b.Push("  call void @__olang_thread_init()\n")
    e.sanInit(b)
    for i in e.globalOrder(inits) {
        if not e.Baked.Has(i) { b.Push("  call void @" $e.sym(mir.FnKey.Body(typed.BodyId(I32(i)))) "()\n") }
    }
    k := mir.FnKey.Body(typed.BodyId(I32(mainBody)))
    ty := e.Lw.Bodies[mainBody].Ty
    errs := t.Items(t.Errors(ty))
    if errs.Len() == 0 {
        b.Push("  call void @" $e.sym(k) "()\n  ret i32 0\n}\n\n")
        e.item("main", e.P.L.Root, b.ToString())
        return
    }
    b.Push("  %c = call i32 @" $e.sym(k) "()\n  %bad = icmp ne i32 %c, 0\n  br i1 %bad, label %err, label %ok\nok:\n  ret i32 0\n")
    b.Push("err:\n")
    e.declare("fputs", "i32 @fputs(ptr, ptr)")
    e.define("stderr", "@stderr = external global ptr")
    b.Push("  %s = load ptr, ptr @stderr\n")
    msg := "%m0"
    b.Push("  %m0 = getelementptr i8, ptr " $e.cstr("unhandled error\n") ", i64 0\n")
    n I64 = 0
    for i in range errs.Len() {
        et := t.ErrOf(errs[i])
        ws := e.P.ErrorWords(t.DeclOf(et))
        for j in range ws.Len() {
            n++
            code := ((i + 1) << 16) | j
            text := "unhandled error: " $e.errName(et) "." $e.text(ws[j]) "\n"
            b.Push("  %q" $n " = icmp eq i32 %c, " $code "\n")
            b.Push("  %m" $n " = select i1 %q" $n ", ptr " $e.cstr(text) ", ptr " $msg "\n")
            msg = "%m" $n
        }
    }
    b.Push("  call i32 @fputs(ptr " $msg ", ptr %s)\n")
    if e.traced() {
        # S18d: where it came from, in a build that keeps the trace
        e.declare("__olang_ert_print", "void @__olang_ert_print(ptr)")
        b.Push("  call void @__olang_ert_print(ptr %s)\n  ret i32 1\n}\n\n")
    } else {
        b.Push("  call i32 @fputs(ptr " $e.cstr("(build with -debug to see where it came from)\n") ", ptr %s)\n  ret i32 1\n}\n\n")
    }
    e.item("main", e.P.L.Root, b.ToString())
}

# an error type's name as B5 says it escaping main: its own name alone ("IoError"), as stage 0 writes it
fn (e mut Emitter&) errName(et types.TypeId) String { return $e.text(e.T.DeclName(e.T.DeclOf(et))) }

# the test harness (S15/S16): each test run behind a recovery point, a failed check (or an error leaving it) ending
# that test alone - "ok - NAME" or "FAIL - NAME", then the counts; the status 1 when any failed
fn (e mut Emitter&) harness(tests List<I64>) {
    inits := e.initOrder()
    e.define("__olang_argc", "@__olang_argc = external global i32")
    e.define("__olang_argv", "@__olang_argv = external global ptr")
    e.define("__olang_jmp_target", "@__olang_jmp_target = external thread_local(initialexec) global ptr")
    e.define("__olang_unwind_top", "@__olang_unwind_top = external thread_local(initialexec) global ptr")
    e.define("__olang_unwind_mark", "@__olang_unwind_mark = external thread_local(initialexec) global ptr")
    e.declare("setjmp", "i32 @setjmp(ptr) returns_twice")
    e.declare("printf", "i32 @printf(ptr, ...)")
    e.declare("fflush", "i32 @fflush(ptr)")
    e.runtime("__olang_thread_init")
    e.runtime("__olang_test_failed")
    b := StringBuilder()
    b.Push("define i32 @main(i32 %argc, ptr %argv) #0 {\nentry:\n")
    b.Push("  %pass = alloca i32\n  %fail = alloca i32\n  %jb = alloca [200 x i8], align 16\n")
    b.Push("  store i32 0, ptr %pass\n  store i32 0, ptr %fail\n")
    b.Push("  store i32 %argc, ptr @__olang_argc\n  store ptr %argv, ptr @__olang_argv\n")
    b.Push("  call void @__olang_thread_init()\n")
    e.sanInit(b)
    # each global's initializer behind a recovery point of its own: one that fails a check leaves its global at its
    # zero value and the rest still run (a stage 0 build computes them while compiling, K2, or stops there)
    g I64 = 0
    for i in e.globalOrder(inits) {
        if e.Baked.Has(i) { continue }
        key := mir.FnKey.Body(typed.BodyId(I32(i)))
        b.Push("  store ptr %jb, ptr @__olang_jmp_target\n  %gj" $g " = call i32 @setjmp(ptr %jb)\n")
        b.Push("  %gz" $g " = icmp eq i32 %gj" $g ", 0\n  br i1 %gz" $g ", label %grun" $g ", label %gnext" $g "\n")
        b.Push("grun" $g ":\n  call void @" $e.sym(key) "()\n  br label %gnext" $g "\ngnext" $g ":\n")
        g++
    }
    okFmt := e.cstr("ok - %s\n")
    for i in range tests.Len() {
        id := tests[i]
        name := e.cstr(e.testName(id))
        b.Push("  %top" $i " = load ptr, ptr @__olang_unwind_top\n  store ptr %top" $i ", ptr @__olang_unwind_mark\n")
        b.Push("  store ptr %jb, ptr @__olang_jmp_target\n  %j" $i " = call i32 @setjmp(ptr %jb)\n")
        b.Push("  %z" $i " = icmp eq i32 %j" $i ", 0\n  br i1 %z" $i ", label %run" $i ", label %bad" $i "\n")
        b.Push("run" $i ":\n  call void @" $e.sym(mir.FnKey.Body(typed.BodyId(I32(id)))) "()\n")
        b.Push("  %p" $i " = load i32, ptr %pass\n  %pp" $i " = add i32 %p" $i ", 1\n  store i32 %pp" $i ", ptr %pass\n")
        b.Push("  call i32 (ptr, ...) @printf(ptr " $okFmt ", ptr " $name ")\n  call i32 @fflush(ptr null)\n")
        b.Push("  br label %next" $i "\n")
        b.Push("bad" $i ":\n  %f" $i " = load i32, ptr %fail\n  %ff" $i " = add i32 %f" $i ", 1\n  store i32 %ff" $i ", ptr %fail\n")
        b.Push("  call void @__olang_test_failed(ptr " $name ")\n  call i32 @fflush(ptr null)\n  br label %next" $i "\n")
        b.Push("next" $i ":\n")
    }
    b.Push("  store ptr null, ptr @__olang_jmp_target\n")
    b.Push("  %np = load i32, ptr %pass\n  %nf = load i32, ptr %fail\n")
    b.Push("  call i32 (ptr, ...) @printf(ptr " $e.cstr("%d passed, %d failed\n") ", i32 %np, i32 %nf)\n")
    b.Push("  %any = icmp sgt i32 %nf, 0\n  %st = zext i1 %any to i32\n  ret i32 %st\n}\n\n")
    e.item("main", e.P.L.Root, b.ToString())
}

# a test's name, as its declaration writes it (between the quotes)
fn (e mut Emitter&) testName(id I64) String {
    m := e.P.L.Mods[e.P.L.Root]
    sp := e.Lw.Bodies[id].Sp
    name := e.findTest(m.Decls, sp)
    if name.End == I32(0) { return "test" }
    s := m.Src.TextOf(name)
    if s.Len() >= 2 and s[0] == '"' { return $s[1:s.Len() - 1] }
    return $s
}

fn (e mut Emitter&) findTest(ds Array<ast.Decl&>&, sp source.Span) source.Span {
    if ds == null { return source.Span(0, 0) }
    for d in ds {
        match d {
            case ast.Decl.Test(dsp, name, _) {
                if dsp == sp { return name }
            }
            case ast.Decl.If(_, ti) {
                found := e.findTestIf(ti, sp)
                if found.End > I32(0) { return found }
            }
            case _ { }
        }
    }
    return source.Span(0, 0)
}

fn (e mut Emitter&) findTestIf(ti ast.TopIf&, sp source.Span) source.Span {
    if ti == null { return source.Span(0, 0) }
    if ti.Then != null {
        f := e.findTest(ti.Then.Decls, sp)
        if f.End > I32(0) { return f }
    }
    if ti.Else != null {
        f := e.findTest(ti.Else.Decls, sp)
        if f.End > I32(0) { return f }
    }
    return e.findTestIf(ti.ElseIf, sp)
}

# ---- tasks (P1, P2, P4) ----

# a task started in join j: its environment - the function value it calls through, its arguments, the scopes it is
# handed (each a stand-in of the task's own, folded into it at the join, P2 - none, null, for the program's, which the
# task reaches as its worker does), the places its results go - in the join's arena, its node on the join's list, a
# worker handed a trampoline of its own that unpacks the environment, makes the call, stores the results, and returns
# an error no clause took under the join's list (P4b)
fn (fe mut fnEm&) spawn(j mir.ScopeId, k mir.Task) {
    t := fe.E.T
    e := fe.E
    js := "%s" $j
    ty := types.UnknownT
    callee := ""
    isValue := false
    fv := ""
    match k.Target {
        case mir.Callee.Fn(key, fty) {
            e.want(key)
            ty = fty
            callee = "@" $e.sym(key)
        }
        case mir.Callee.Extern(f, fty) {
            ty = fty
            callee = "@" $e.extern(f, fty)
            fe.gap("a task calling an extern")
        }
        case mir.Callee.Value(x) {
            ty = fe.otype(x)
            isValue = true
            fv = fe.val(x, ty)
        }
    }
    ps := t.Items(t.Params(ty))
    # the environment's fields and their values
    fields List<String&>
    vals List<String&>
    if isValue {
        fields.Push("{ ptr, ptr }")
        vals.Push(fv)
    }
    # an argument moved through memory is copied into the environment where it lands, below: "" here
    for i in range ps.Len() {
        fields.Push(fe.ty(ps[i]))
        vals.Push("" if fe.viaMem(ps[i]) else fe.val(fe.arg(k.Args, i), ps[i]))
    }
    subs List<String&>
    for i in range k.Scopes.N {
        r := fe.F.Refs[I64(k.Scopes.At) + i]
        fields.Push("ptr")
        match r {
            case mir.ScopeRef.Program { vals.Push("null") }
            case _ {
                e.declare("__olang_standin", "ptr @__olang_standin(ptr)")
                sub := fe.let("call ptr @__olang_standin(ptr " $fe.scope(r) ")")
                subs.Push($sub)
                vals.Push($sub)
            }
        }
    }
    for i in range k.Targets.N {
        fields.Push("ptr")
        dst, _ := fe.addr(fe.F.Places[I64(k.Targets.At) + i])
        vals.Push($dst)
    }
    # P4a: each clause's handler, called on the task's thread
    for i in range k.Clauses.N {
        h := fe.F.Clauses[I64(k.Clauses.At) + i].Handler
        if h != mir.Operand.None {
            fields.Push("{ ptr, ptr }")
            vals.Push(fe.val(h, fe.otype(h)))
        }
    }
    et := StringBuilder()
    et.Push("{ ")
    for i in range fields.Len() {
        if i > 0 { et.Push(", ") }
        et.Push(fields[i])
    }
    if fields.Len() == 0 { et.Push("i8") }
    et.Push(" }")
    envT := et.ToString()
    e.runtime("__olang_scope_alloc_a")
    size := fe.let("ptrtoint ptr " $fe.let("getelementptr " $envT ", ptr null, i32 1") " to i64")
    env := fe.let("call ptr @__olang_scope_alloc_a(ptr " $js ", i64 " $size ", i64 8)")
    first := 1 if isValue else 0
    for i in range fields.Len() {
        at := fe.let("getelementptr " $envT ", ptr " $env ", i32 0, i32 " $i)
        if vals[i] == "" {
            fe.put(at, ps[i - first], fe.arg(k.Args, i - first))
        } else {
            fe.store(fields[i], vals[i], at)
        }
    }
    # the task's node (%olang.task: next, done, merges, error) and its stand-ins' merge records
    node := fe.let("call ptr @__olang_scope_alloc_a(ptr " $js ", i64 32, i64 8)")
    head := "null"
    for sub in subs {
        mn := fe.let("call ptr @__olang_scope_alloc_a(ptr " $js ", i64 16, i64 8)")
        fe.store("ptr", head, mn)
        fe.store("ptr", sub, fe.let("getelementptr { ptr, ptr }, ptr " $mn ", i32 0, i32 1"))
        head = mn
    }
    fe.store("ptr", head, fe.let("getelementptr { ptr, i64, ptr, i64 }, ptr " $node ", i32 0, i32 2"))
    fe.store("i64", "0", fe.let("getelementptr { ptr, i64, ptr, i64 }, ptr " $node ", i32 0, i32 1"))
    fe.store("i64", "0", fe.let("getelementptr { ptr, i64, ptr, i64 }, ptr " $node ", i32 0, i32 3"))
    name := fe.trampoline(envT, fields, isValue, callee, ty, I64(k.Scopes.N), k, fe.F.Scopes[I64(j)].Errors)
    e.declare("__olang_worker_get", "ptr @__olang_worker_get()")
    e.declare("__olang_worker_start", "void @__olang_worker_start(ptr, ptr, ptr, ptr)")
    w := fe.let("call ptr @__olang_worker_get()")
    fe.w("call void @__olang_worker_start(ptr " $w ", ptr @" $name ", ptr " $env ", ptr " $node ")")
    fe.store("ptr", fe.load("ptr", "%jh" $j), node)
    fe.store("ptr", node, "%jh" $j)
}

# a task's trampoline, fn(ptr env) ptr: the call made from what the environment holds, its results stored, and the
# error it fails with re-encoded under the join's list (as a pointer's bits, the runtime's contract), null for none
fn (fe mut fnEm&) trampoline(envT String&, fields List<String&>, isValue Bool, callee String&, ty types.TypeId
                             nscopes I64, k mir.Task, joinErrs types.ListId) String {
    e := fe.E
    t := e.T
    ntargets := I64(k.Targets.N)
    name := "olang_task" $e.ntask
    e.ntask++
    b := StringBuilder()
    b.Push("define internal ptr @" $name "(ptr %env) #0 {\nentry:\n")
    for i in range fields.Len() {
        b.Push("  %f" $i " = getelementptr " $envT ", ptr %env, i32 0, i32 " $i "\n")
    }
    at I64 = 0
    target := callee
    args := StringBuilder()
    first := true
    if isValue {
        b.Push("  %fv = load { ptr, ptr }, ptr %f0\n  %code = extractvalue { ptr, ptr } %fv, 0\n  %fenv = extractvalue { ptr, ptr } %fv, 1\n")
        target = "%code"
        args.Push("ptr %fenv")
        first = false
        at = 1
    }
    ps := t.Items(t.Params(ty))
    pass := t.Passing(ty)
    res := t.Result(ty)
    via := res != types.VoidT and res != types.NoreturnT and t.ViaMemory(res)
    if via {
        b.Push("  %out = alloca " $e.ty(res) "\n")
        if not first { args.Push(", ") }
        args.Push("ptr %out")
        first = false
    }
    for i in range nscopes {
        f := at + ps.Len() + i
        b.Push("  %sc" $i " = load ptr, ptr %f" $f "\n  %sn" $i " = icmp eq ptr %sc" $i ", null\n")
        e.define("__olang_prog_scope", "@__olang_prog_scope = external thread_local(initialexec) global ptr")
        b.Push("  %sg" $i " = load ptr, ptr @__olang_prog_scope\n  %ss" $i " = select i1 %sn" $i ", ptr %sg" $i ", ptr %sc" $i "\n")
        if not first { args.Push(", ") }
        args.Push("ptr %ss" $i)
        first = false
    }
    for i in range ps.Len() {
        f := at + i
        lt := e.ty(ps[i])
        if not first { args.Push(", ") }
        first = false
        match pass[i] {
            case 'm' { args.Push("ptr %f" $f) }
            case 's' {
                b.Push("  %a" $i " = load { ptr, ptr }, ptr %f" $f "\n  %ac" $i " = extractvalue { ptr, ptr } %a" $i ", 0\n")
                b.Push("  %ae" $i " = extractvalue { ptr, ptr } %a" $i ", 1\n")
                args.Push("ptr %ac" $i ", ptr %ae" $i)
            }
            case _ {
                b.Push("  %a" $i " = load " $lt ", ptr %f" $f "\n")
                args.Push($lt " %a" $i)
            }
        }
    }
    rt := t.RetLlvm(ty)
    errs := t.Items(t.Errors(ty)).Len() > 0
    if rt == "void" {
        b.Push("  call void " $target "(" $args.ToString() ")\n")
    } else {
        b.Push("  %r = call " $rt " " $target "(" $args.ToString() ")\n")
    }
    value := ""
    if via {
        value = "%out"
    } else if res != types.VoidT and res != types.NoreturnT {
        if errs {
            b.Push("  %v = extractvalue " $rt " %r, 1\n")
            value = "%v"
        } else {
            value = "%r"
        }
    }
    if errs {
        code := "%r" if (via or res == types.VoidT) else "%c"
        if code == "%c" { b.Push("  %c = extractvalue " $rt " %r, 0\n") }
        b.Push("  %bad = icmp ne i32 " $code ", 0\n  br i1 %bad, label %fail, label %ok\nfail:\n")
        fe.clauses(b, code, k, ty, at + ps.Len() + nscopes + ntargets, at + ps.Len() + nscopes)
        if k.Ends.N > I32(0) {
            fe.taskEnds(b, code, k)
            b.Push("ok:\n")
        } else {
            rc := e.recodeText(b, code, t.Errors(ty), joinErrs)
            b.Push("  %rc64 = zext i32 " $rc " to i64\n  %rp = inttoptr i64 %rc64 to ptr\n  ret ptr %rp\nok:\n")
        }
    }
    if ntargets > 0 and value != "" {
        t0 := at + ps.Len() + nscopes
        if via {
            # a result moved through memory, moved into its targets
            e.declare("llvm.memmove.p0.p0.i64", "void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)")
            e.P.Layout(res)
            if ntargets == 1 {
                b.Push("  %d0 = load ptr, ptr %f" $t0 "\n  call void @llvm.memmove.p0.p0.i64(ptr %d0, ptr %out, i64 " $t.Size(res) ", i1 false)\n")
            } else {
                parts := t.Items(t.Parts(t.Repr(res)))
                for i in range ntargets {
                    e.P.Layout(parts[i])
                    b.Push("  %d" $i " = load ptr, ptr %f" $(t0 + i) "\n")
                    b.Push("  %o" $i " = getelementptr " $e.ty(res) ", ptr %out, i32 0, i32 " $i "\n")
                    b.Push("  call void @llvm.memmove.p0.p0.i64(ptr %d" $i ", ptr %o" $i ", i64 " $t.Size(parts[i]) ", i1 false)\n")
                }
            }
        } else if ntargets == 1 {
            b.Push("  %d0 = load ptr, ptr %f" $t0 "\n  store " $e.ty(res) " " $value ", ptr %d0\n")
        } else {
            parts := t.Items(t.Parts(t.Repr(res)))
            for i in range ntargets {
                b.Push("  %d" $i " = load ptr, ptr %f" $(t0 + i) "\n")
                b.Push("  %x" $i " = extractvalue " $e.ty(res) " " $value ", " $i "\n")
                b.Push("  store " $e.ty(parts[i]) " %x" $i ", ptr %d" $i "\n")
            }
        }
    }
    b.Push("  ret ptr null\n}\n\n")
    e.item(name, HomeLocal, b.ToString())
    return name
}

# a task's clauses (P4a), in order, over the error code its call failed with: the first one taking it runs its handler
# on the task's thread, the handler's result the targets' value, and the task ends with no error; one with no handler
# ("catch E { }") just takes it. What none takes falls through to what follows
fn (fe mut fnEm&) clauses(b mut StringBuilder&, code String&, k mir.Task, ty types.TypeId, hfield I64, tfield I64) {
    e := fe.E
    t := e.T
    errs := t.Errors(ty)
    h := hfield
    for ci in range k.Clauses.N {
        cl := fe.F.Clauses[I64(k.Clauses.At) + ci]
        cond := "true"
        if not cl.All {
            cond = "false"
            for ii in range cl.Items.N {
                it := fe.F.Items[I64(cl.Items.At) + ii]
                pos := e.position(errs, it.Err)
                n := "%k" $ci "_" $ii
                if it.Word < 0 {
                    b.Push("  " $n "h = lshr i32 " $code ", 16\n  " $n " = icmp eq i32 " $n "h, " $pos "\n")
                } else {
                    b.Push("  " $n " = icmp eq i32 " $code ", " $((pos << 16) | it.Word) "\n")
                }
                b.Push("  " $n "o = or i1 " $cond ", " $n "\n")
                cond = $n "o"
            }
        }
        b.Push("  br i1 " $cond ", label %take" $ci ", label %pass" $ci "\ntake" $ci ":\n")
        if cl.Handler != mir.Operand.None {
            ht := fe.otype(cl.Handler)
            b.Push("  %hv" $ci " = load { ptr, ptr }, ptr %f" $h "\n")
            b.Push("  %hc" $ci " = extractvalue { ptr, ptr } %hv" $ci ", 0\n  %he" $ci " = extractvalue { ptr, ptr } %hv" $ci ", 1\n")
            args := StringBuilder()
            args.Push("ptr %he" $ci)
            res := t.Result(ht)
            via := res != types.VoidT and res != types.NoreturnT and t.ViaMemory(res)
            if via {
                b.Push("  %ho" $ci " = alloca " $e.ty(res) "\n")
                args.Push(", ptr %ho" $ci)
            }
            for si in range mir.PassedCount(t, mir.Callee.Value(mir.Operand.None), ht) {
                e.define("__olang_prog_scope", "@__olang_prog_scope = external thread_local(initialexec) global ptr")
                b.Push("  %hs" $ci "_" $si " = load ptr, ptr @__olang_prog_scope\n")
                args.Push(", ptr %hs" $ci "_" $si)
            }
            rt := t.RetLlvm(ht)
            value := ""
            if rt == "void" {
                b.Push("  call void %hc" $ci "(" $args.ToString() ")\n")
            } else {
                b.Push("  %hr" $ci " = call " $rt " %hc" $ci "(" $args.ToString() ")\n")
                value = "%hr" $ci
            }
            if via {
                b.Push("  %hl" $ci " = load " $e.ty(res) ", ptr %ho" $ci "\n")
                value = "%hl" $ci
            }
            if value != "" and k.Targets.N > I32(0) {
                if k.Targets.N == I32(1) {
                    b.Push("  %hd" $ci " = load ptr, ptr %f" $tfield "\n  store " $e.ty(res) " " $value ", ptr %hd" $ci "\n")
                } else {
                    parts := t.Items(t.Parts(t.Repr(res)))
                    for i in range k.Targets.N {
                        b.Push("  %hd" $ci "_" $i " = load ptr, ptr %f" $(tfield + i) "\n")
                        b.Push("  %hx" $ci "_" $i " = extractvalue " $e.ty(res) " " $value ", " $i "\n")
                        b.Push("  store " $e.ty(parts[i]) " %hx" $ci "_" $i ", ptr %hd" $ci "_" $i "\n")
                    }
                }
            }
            h++
        }
        b.Push("  ret ptr null\npass" $ci ":\n")
    }
}

# "spawn f(x)!" (E35, P6): the error code the task's call failed with ends the program from the task's thread, named
# as a "!" names it, where the "!" is
fn (fe mut fnEm&) taskEnds(b mut StringBuilder&, code String&, k mir.Task) {
    e := fe.E
    where := e.where(fe.F.File, k.EndsSp)
    hint := "" if e.traced() else "(build with -debug to see where it came from)\n"
    e.declare("__olang_bang_failed", "void @__olang_bang_failed(ptr)")
    for i in range 0, I64(k.Ends.N), 2 {
        v I64 = 0
        match fe.F.Ops[I64(k.Ends.At) + i] {
            case mir.Operand.Const(_, x) { v = x }
            case _ { }
        }
        text := ""
        match fe.F.Ops[I64(k.Ends.At) + i + 1] {
            case mir.Operand.Data(_, c, _, _) { text = fe.constText(c) }
            case _ { }
        }
        b.Push("  %bq" $i " = icmp eq i32 " $code ", " $v "\n  br i1 %bq" $i ", label %bang" $i ", label %bnext" $i "\nbang" $i ":\n")
        b.Push("  call void @__olang_bang_failed(ptr " $e.cstr($where ": " $text "\n" $hint) ")\n  unreachable\nbnext" $i ":\n")
    }
    b.Push("  call void @__olang_bang_failed(ptr " $e.cstr($where ": unhandled error\n" $hint) ")\n  unreachable\n")
}

# a code under list from as the same error under list to, written into b: the name of its value
fn (e mut Emitter&) recodeText(b mut StringBuilder&, code String&, from types.ListId, to types.ListId) String {
    t := e.T
    xs := t.Items(from)
    b.Push("  %rhi = lshr i32 " $code ", 16\n  %rw = and i32 " $code ", 65535\n")
    pos := "0"
    for k in range xs.Len() {
        b.Push("  %rh" $k " = icmp eq i32 %rhi, " $(k + 1) "\n")
        b.Push("  %rp" $k " = select i1 %rh" $k ", i32 " $e.position(to, xs[k]) ", i32 " $pos "\n")
        pos = "%rp" $k
    }
    b.Push("  %rs = shl i32 " $pos ", 16\n  %rv2 = or i32 %rs, %rw\n")
    return "%rv2"
}
