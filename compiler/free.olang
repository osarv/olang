# early freeing (docs/memory.md section 2, SPEC O8d): which places are the only holders of what they hold, so that what
# a place lets go of - when it is given another value, when an entry is removed - is freed at once, not when its scope
# closes. Run once the scope pass has placed every body (M6), it decides, for the whole program at its root, which
# candidate places are sole, and writes into the scope pass's plans where each value made for a sole place is built: in
# a region of its own (typed.Plan's Region fields), which lowering makes and the place's let-go releases
# (std/runtime/runtime.ll's __olang_region_*).
#
# A place is decided per declaration: a reference field of a struct type, a struct field holding a handle (a struct of
# one reference, as std/list's List is), or the elements of an array type of references - a collection's elements
# are its chunks' or buckets' (2.1, 2.6). It is sole when every value stored into it was made for it (built where the
# store is, null, constant data, or moved out of the same place), no reference read from it is stored anywhere else,
# none is in use across a let-go of it, no task can reach it, and what it holds has no destructor (O8d's conditions).
# A value owning storage held in place - a Vec or a Map field by value (QCE) - is an owner place (ownerCand): all of its
# storage built in one region, released through its anchors (types.Anchors); and an array a struct holds by value - a
# Vec's buffer, a Map's slots - is an array place (arrayCand), what a collection's growth replaces released as it grows.
# Owners win: an array an owner held in a sole place holds keeps, its owner's one region reclaiming it.
# Every fact the analysis does not have means keep: a call through a function value, an extern, a body the scope pass
# did not judge. The decisions are the whole program's, but no module's code depends on them (B3i): every candidate
# place's sites are written in every module, each guarded by its place's decision, a link-time constant the root's
# decisions object defines (mir.Rvalue.Sole; docs/memory.md 3.5, docs/wholeprog.md 2.1) - LTO folds it.
#
# The analysis is conservative, and each step past it is a relaxation for a soundness review (5.5's gate). Origins are
# flow-insensitive within a body; views are judged structurally, by statement order and loops; summaries are fixed
# points over every body. Failing is always safe: a place that is not sole behaves exactly as without this pass.

import "std/pair"
import "std/io"
import "std/time"
import "source"
import "types"
import "generic"
import "typed"
import "scope"

# ---- origins: what a value may refer into, one number each - its kind above bit 40 ----

OPar I64 = 1    # what parameter v (an index in Params) names, or holds
OPl I64 = 2     # a value of place v, read from it: a view of it
OMov I64 = 3    # a value moved out of place v (vacate)
ONew I64 = 4    # what is built at site v of the body
OUnk I64 = 5    # not known
OParC I64 = 6   # what parameter v holds by reference only: a copy of its value, which owns its owned parts anew (Part C)

fn orig(k I64, v I64) I64 { return (k << 40) | v }
fn okind(o I64) I64 { return o >> 40 }
fn oval(o I64) I64 { return o & ((I64(1) << 40) - 1) }

# x put in s where it is not there yet: how many were added, 0 or 1 (a count, never a flag - R23a)
fn addTo(s mut Vec<I64>&, x I64) I64 {
    for y in s {
        if y == x: return 0
    }
    s.Push(x)
    return 1
}

# every element of t put in s where it is not there yet: how many were added
fn addAllTo(s mut Vec<I64>&, t Vec<I64>&) I64 {
    n I64 = 0
    for x in t { n += addTo(s, x) }
    return n
}

fn has(s Vec<I64>&, x I64) Bool {
    for y in s {
        if y == x: return true
    }
    return false
}

# a must-value: what every value of an expression is - a value of one place (its index), or nothing known (None); Top
# where no value constrains it yet (null, no return)
MustTop I64 = -2
MustNone I64 = -1
MovBase I64 = 1 << 30   # place k's moved value: MovBase + k

fn meet(a I64, b I64) I64 {
    if a == MustTop: return b
    if b == MustTop: return a
    return a if a == b else MustNone
}

# ---- what the analysis reports and why a place keeps ----

# why a place keeps: the first reason found, for the report (B18)
type reason struct(Kind I64, File I64, Sp source.Span, Text String&) {
    Kind
    File
    Sp
    Text     # the note's text, all but its position
}

RNone I64 = 0
RStore I64 = 1    # a reference into it stored elsewhere (condition 2)
RMade I64 = 2     # a value not made for it (condition 1)
RView I64 = 3     # a view in use across a let-go of it (condition 6)
RTask I64 = 4     # the program has tasks (condition 3)
RDtor I64 = 5     # a destructor (condition 4)
RInPlace I64 = 6  # an owner's value changed in place (ownerCand)
RCopied I64 = 7   # a value holding an owner's copied where no store is made for it (heldPlaces)

# a store into a candidate place: the value's classification, and where it is built if made for the place
type store struct(PlaceId I64, Body I64, File I64, Sp source.Span, Kind I64, Of I64, Site I64, X typed.Expr?&, Root typed.Expr?&) {
    PlaceId
    Body
    File
    Sp
    Kind     # SOk (null, constant data), SFresh (built at Site), SMove (moved out of place Of), SFail
    Of
    Site
    X        # the value, for its parts built with it
    Root     # where the container's reference comes from, when it is a value of a sole place (RegionOr)
}

SOk I64 = 0
SFresh I64 = 1
SMove I64 = 2
SFail I64 = 3

# a let-go of a place: a place given another value (direct), a vacate statement, a moved value dropped, or a call that
# may do one of those
type letGo struct(PlaceId I64, Body I64, File I64, At source.Span, Sp source.Span, Kind I64, RecvSp source.Span
                  Callee I64, Again Bool) {
    PlaceId    # AnyPlace for a call that may let go of any
    Body
    File
    At       # the statement
    Sp       # the let-go itself, as written: the place (LAssign, LVacate), the call (LDrop, LCall)
    Kind     # LAssign, LVacate, LDrop, LCall
    RecvSp   # a call's receiver as written: the collection a removal is called on (empty for none)
    Callee
    Again    # in code that runs again: a loop, or a function other than main
}

AnyPlace I64 = -1      # a let-go's place: any (a call whose callee may let go of anything)

# whether a let-go is one of place k's
fn (g letGo) Of(k I64) Bool { return g.PlaceId == k or g.PlaceId == AnyPlace }

LAssign I64 = 1
LLeaf I64 = 5      # a struct held in place given another value: its candidate leaves let go
LVacate I64 = 2
LDrop I64 = 3
LCall I64 = 4
LYield I64 = 7     # a generator's yield: its consumer may let go of any place before the next Next (F1)
LHeld I64 = 8      # a by-value holder's value ended where its block is left (O15): its leaves let go there (Part C)

# a call given a value of a sole place as the root of an argument: what the callee builds there is built in that
# value's region (RegionOr)
type orCall struct(Body I64, Site I64, Callee I64, Param I64, PlaceId I64, Root typed.Expr&, Arg typed.Expr&) {
    Body
    Site
    Callee
    Param
    PlaceId
    Root
    Arg
}

# a store through a value of a sole place (f.x = V, f a view): V's parts built where that value is
type orStore struct(Body I64, PlaceId I64, X typed.Expr&, Root typed.Expr&) {
    Body
    PlaceId
    X
    Root
}

# a leaf of a value held in place: a candidate place inside it, by the fields that reach it
# a retire() of a local's array (M19d) in a body, at sp, with what the local may refer into
type retire struct(Body I64, Sp source.Span, Orig Vec<I64>) {
    Body
    Sp
    Orig
}

type leaf struct(Path Array<I64>, PlaceId I64) {
    Path
    PlaceId
}

# a feeder (O28, D9i): a value local copied whole at its last mention into an owner place - a field or a global - by an
# assignment standing in the very block that declares it. Its value is built for that place from its declaration on: in
# a region of its own, a kid of where the copy would have gone, everything its calls build where it lives built there,
# so that the store moves it (no copy is made) and the place's next let-go releases all of it, its growth included
type feed struct(Body I64, Local I64, PlaceId I64, Copy I64, At typed.Scope, Dest typed.Scope) {
    Body
    Local
    PlaceId
    Copy        # the copy's site, which lowering leaves out (the move)
    At          # where the scope pass builds what the local's declaration and its calls build: the local's scope
    Dest        # where the copy would have been built: the region's parent
    Site I64 = -1   # the site its declaration's value is built at in a region of its own (made, final walk), -1 for none
}

# a call given a feeder (a reference to it or to a part of it) as argument Param
type feedCall struct(Body I64, Site I64, Callee I64, Param I64, Feed I64, Writes Bool) {
    Body
    Site
    Callee
    Param
    Feed
    Writes      # a writable reference: what the callee builds where the feeder lives must be built in its region
}

# ---- the analysis ----

type Free struct(P mut generic.Program&, Bodies Vec<mut typed.Body&>, Sc mut scope.Scoper&) {
    P
    Bodies
    Sc
    Plans Vec<typed.Plan>     # the scope pass's, with the regions written in (Decide)
    passes I64 = 0
    holdsOf Vec<I64>          # by type: 0 not asked, 1 holds no reference, 2 holds one (HoldsRefs, asked once)
    wk mut walker?&             # the one walker, made again for each walk (newWalker) - its lists reused, not grown
    Root I64 = -1              # the root module; -1 where nothing is decided (the evaluator's own lowering)
    Alone Bool = false         # a module compiled on its own (B3): judged as a program, its decisions emitted nowhere
    # the candidate places: keys (a plain type, a field's position or -1 for an array's elements), whether each holds
    # a handle (its one field the reference), its value's type
    keyTy Vec<types.TypeId>
    keyField Vec<I64>
    handle Vec<Bool>
    owner Vec<Bool>           # by place: an owner held in place (types.Anchors) - a Vec, a Map held by value
    arr Vec<Bool>             # by place: an array of a run-time length a struct holds by value - a Map's slots
    retires Vec<retire>       # the prelude's retire() of a view of an array place's old value (arrayCand)
    valTy Vec<types.TypeId>
    placeOf Map<pair.Pair<I64, I64>, I64>
    typeAsked Map<pair.Pair<I64, I64>, I64>    # a key asked: 1 no candidate, 2 a candidate (place in placeOf)
    safeAsked Map<types.TypeId, I64>             # contents asked: 1 being asked, 2 no, 3 yes
    leafAsked Map<types.TypeId, Vec<leaf>>
    ownersAsked Map<types.TypeId, Vec<I64>>    # heldPlaces, by type
    # by body: its module, whether its code is emitted in the root's object - lowered by every build, so the decisions are
    # written into it as they are, where every other body's code reads them as link-time constants - whether it is the
    # program's own (not std)
    module Vec<I64>
    decided Vec<Bool>
    programCode Vec<Bool>
    prelude Vec<Bool>         # whether its code is the prelude's (std/prelude), whose fills are trusted (makeStores)
    # summaries, by body: the origins its result may carry (no New); the places each parameter's value is stored into
    # directly, (param << 32) | place; the parameters whose values it may keep elsewhere; the places it may let go of,
    # or all; what every result is (must); whether every result is new
    resFrom Vec<mut Vec<I64>&>
    parStored Vec<mut Vec<I64>&>
    parEsc Vec<mut Vec<I64>&>
    parEscC Vec<mut Vec<I64>&>  # by body: the parameters a copy of which it keeps - their references, not their owned parts
    parMulti Vec<mut Vec<I64>&>   # the parameters a body stores more than once on a path (a loop, two stores)
    # by body: the parameters whose unique value it moves whole into a struct held in place, or into its own instance's
    # field (T13b's hand-on, never a copy) - each call's argument is then the value those leaves are given there (wholeArg)
    parWhole Vec<mut Vec<I64>&>
    lets Vec<mut Vec<I64>&>
    letsAll Vec<Bool>
    mustRes Vec<I64>
    resFresh Vec<Bool>
    # by body: whether it may register a destructor in one of its scope variables - its result, its instance, a
    # parameter's scope - so in a region a call of it builds into (F4): a destructor still to run when the region's
    # place would let go of it (O16, condition 4)
    regOut Vec<Bool>
    exports Vec<I64>          # the export fns' bodies C may call (X12-X14): from any extern call but the C library's own (F6)
    changed Bool = false
    # the program: whether it has tasks (or an extern given a function value), whether a destructor, Str, Eq or Hash
    # lets go of something (they run where no call is written)
    tasks Bool = false
    taskAt Vec<Bool>          # by body: it starts a task, or gives C a function value (reachedTasks)
    named Vec<Bool>           # by body: named as a function value somewhere
    hidden Bool = false
    hiddenAt Vec<I64>         # the places a destructor, Str, Eq or Hash may let go of (where hidden is not set)
    # the final pass's events
    stores Vec<store>
    goes Vec<letGo>
    whyKind Vec<I64>          # by place: the first reason it keeps, RNone while it may be sole
    libTaken Vec<Bool>        # by place: a value moved out of it by the library's code - what a collection holds
    why Vec<reason>
    ors Vec<orCall>
    orStores Vec<orStore>
    Sole Vec<Bool>            # by place, after Decide
    noteAt I64 = -1            # where a reason's note is, when it is not the store (a callee's declaration)
    noteFile I64 = -1
    noteSp source.Span = source.Span(0, 0)
    mustLocals Vec<mut Vec<I64>&> # by body, by local: what every value it holds is (must)
    withinLocals Vec<mut Vec<I64>&> # by body, by local: the parameter every value it holds is reached from (must)
    freshLocals Vec<mut Vec<Bool>&> # by body, by local: whether every value it holds is an object the body made (must)
    callers Vec<mut Vec<I64>&>    # by body: the bodies calling it, found by the walks
    # by body: its locals' origins where its last walk left them - flattened, local l's from savedAt[b][l] to
    # savedAt[b][l + 1] - so its next walk starts from them (summaries only grow: so does each local's least fixed point)
    saved Vec<Array<I64>&>
    savedAt Vec<Array<I64>&>
    viewGo Map<I64, I64>       # a place kept for a view: the let-go (in goes) its report row is at
    # owner locals (keyField -3): a local holding an owner by value (ownerCand) - a Vec, a Map - given another value
    # somewhere in its body, a place of its own: by (body, local), and by body whether it has one
    ownLocalOf Map<pair.Pair<I64, I64>, I64>
    olBody Vec<I64>           # by place: an owner local's body and local, -1 for any other place
    olLocal Vec<I64>
    olIn Vec<Bool>
    # global places (keyField -4): a mutable global holding an owner by value or a reference refCand or handleCand
    # admits, given another value in some body other than its initializer - its every value, its initializer's
    # included, built in a region of its own where it is sole (O8d: a global is a place like any other). By (module,
    # name), and by place its module and name (-1 for any other place)
    globalOf Map<pair.Pair<I64, I64>, I64>
    glModule Vec<I64>
    glName Vec<I64>
    # D9h: the constructor calls whose instance views only storage made for it (typed.FreshViews), by (body, site), as
    # this analysis judged them before its regions were written into the plans - lowering leaves out their copy here
    freshAt Map<pair.Pair<I64, I64>, Bool>
    # the copies made for an owner leaf whose value owns storage beside it (splitLeaf), by (body, site): the leaf's path -
    # lowering builds that part in the site's region and every other owned part where the region's parent is
    splitAt Map<pair.Pair<I64, I64>, Array<I64>>
    # feeders (findFeeds): value locals built in the region of the owner place they are stored into, from their
    # declarations - by (body, local), the index in feeds; and the calls given one, judged and redirected into it
    feeds Vec<feed>
    feedOf Map<pair.Pair<I64, I64>, I64>
    feedCalls Vec<feedCall>
    dtorVal Vec<Bool>         # by place: what it holds has a destructor - never Sole (O15)
    curBody I64 = -1           # the body the pre-pass is in
    Done Bool = false          # whether Decide ran with a root (else every decision is "keep")
    Debug Bool = false
    # Part C: a test build (its guards run destructors where a failed check unwinds - where no call is written); by
    # type (representation), its destructor's body; the types whose values may be registered with a scope (O16) - their
    # destructors run as it closes, where no call is written
    Tests Bool = false
    dtorOf Map<I64, I64>
    registered Map<I64, Bool>
}

fn (f mut Free&) T() mut types.Table& { return f.P.T }

# ---- candidates ----

# whether a field or element type is a reference a place's let-go can free what it names: a reference to a struct, an
# enum or an array, whose contents hold nothing freeing cannot meet (a destructor, a function value, an any, a type
# variable) - never an extern type's
fn (f mut Free&) refCand(ty types.TypeId) Bool {
    t := f.T()
    if not t.IsRef(ty) or t.ForeignRef(ty) or t.IsAny(ty) { return false }
    r := t.Repr(t.Referent(ty))
    k := t.KindOf(r)
    if k == types.Kind.Array { return f.safe(r) }
    if k != types.Kind.Named or not t.HasBody(r) { return false }
    dk := t.DeclKindOf(t.DeclOf(r))
    if dk != types.DeclKind.Struct and dk != types.DeclKind.Enum { return false }
    return f.safe(r)
}

# whether a field's type is a handle: a struct of one field, a reference refCand admits - Map, List, Vec
fn (f mut Free&) handleCand(ty types.TypeId) Bool {
    t := f.T()
    r := t.Repr(ty)
    if t.KindOf(r) != types.Kind.Named or not t.HasBody(r) or t.DeclKindOf(t.DeclOf(r)) != types.DeclKind.Struct { return false }
    if t.Destructs(r) { return false }
    fs := t.Items(t.Fields(r))
    return fs.Len() == 1 and f.refCand(fs[0])
}

# whether a field's type is an owner held in place (types.Anchors): a value of its own - a Vec, a Map - whose storage,
# all reached through its anchors, is built in a region of its own where the place is sole, and released through them
# when the place lets go of it. Its value changed in place (a store into it, a writable reference to it handed on)
# makes the place keep: what such a change builds would be built where the container lives (inOwner)
fn (f mut Free&) ownerCand(ty types.TypeId) Bool {
    t := f.T()
    if t.IsRef(ty) { return false }
    return t.Anchors(ty).Len() > 0 and f.safe(ty)
}

# whether a field's type is an array of a run-time length held by value, its elements holding nothing an early free
# cannot meet: its own storage - a Vec's buffer, a Map's slots - built in a region of its own where the place is sole,
# so the array a collection's growth replaces is released as it grows (its retire() is then left out: rmRetire)
fn (f mut Free&) arrayCand(ty types.TypeId) Bool { return f.T().OwnedPart(ty) and f.safe(ty) }

# the owner places a value of type ty holds by value - a struct's own owner fields and what its by-value fields, an
# array's elements and an enum's payloads hold in turn. A copy of such a value makes values of those places with no
# store into them, built where the copy is - outside any region of their own - so a place a copy reaches keeps
# (RCopied), but where the copy is itself the value a store makes for the place (copyInto's view constructor)
fn (f mut Free&) heldPlaces(ty types.TypeId) Vec<I64> {
    t := f.T()
    r := t.Plain(t.Repr(ty))
    if f.ownersAsked.Has(r) { return try f.ownersAsked.Get(r) catch default Vec<I64>() }
    out Vec<I64>
    f.ownersAsked.Put(r, out)        # (none while asked: a type holds itself by value only through an array)
    k := t.KindOf(r)
    if k == types.Kind.Array {
        out = f.heldPlaces(t.Elem(r))
    } else if k == types.Kind.Named and t.HasBody(r) {
        dk := t.DeclKindOf(t.DeclOf(r))
        if dk == types.DeclKind.Struct {
            fs := t.Items(t.Fields(r))
            for i in range fs.Len() {
                q := f.placeKey(r, i)
                if q >= 0 and (f.owner[q] or f.arr[q]) { addTo(out, q) }
                if not t.IsRef(fs[i]) { addAllTo(out, f.heldPlaces(fs[i])) }
            }
        } else if dk == types.DeclKind.Enum {
            for c in t.Items(t.Cases(r)) {
                if not t.IsRef(c) { addAllTo(out, f.heldPlaces(c)) }
            }
        }
    } else if k == types.Kind.Record or k == types.Kind.Tuple {
        for c in t.Items(t.Parts(r)) {
            if not t.IsRef(c) { addAllTo(out, f.heldPlaces(c)) }
        }
    }
    f.ownersAsked.Put(r, out)
    return out
}

# D9h: the parameters body b's result may be a view of (check's load.ViewResults or CtorViews) - a caller keeping it
# copies it (lowering), where it lands
# D9h: a constructor's call whose instance views only storage made for the call - not copied where it is kept (the
# lowering's freshCtor)
fn (f mut Free&) freshCtor(c typed.Call&, b I64, within I64) Bool {
    if f.Bodies[b].Of != typed.BodyOf.Ctor or within < 0 or within >= f.Plans.Len(): return false
    fr := f
    return typed.FreshViews(f.Plans[within], c, f.viewsOf(b), fn(id typed.BodyId) I64 { return fr.viewsOf(I64(id)) }
                            fn(id typed.BodyId) Array<I64> { return fr.P.T.ScopeVarsOf(fr.Bodies[I64(id)].Ty) })
}

fn (f Free&) viewsOf(b I64) I64 {
    if b < 0 or b >= f.Bodies.Len() { return 0 }
    return match f.Bodies[b].Of {
        case typed.BodyOf.Fn(inst): try f.P.L.ViewResults.Get(inst) catch default I64(0)
        case typed.BodyOf.Ctor(t, twin): (try f.P.L.CtorViews.Get(I64(t)) catch default I64(0)) if twin == types.ListId(0) else 0
        case _: 0
    }
}

# whether what a value of type ty holds, through fields, elements, payloads and references, has nothing an early free
# cannot meet: no destructor (O15, condition 4), no function value, no any, no type variable
fn (f mut Free&) safe(ty types.TypeId) Bool {
    t := f.T()
    r := t.Repr(ty)
    k := t.KindOf(r)
    if k == types.Kind.Func or k == types.Kind.Var or k == types.Kind.Any or k == types.Kind.Unknown { return false }
    if k == types.Kind.Ref {
        if t.ForeignRef(r) { return true }
        return f.safe(t.Referent(r))
    }
    if k == types.Kind.Array { return f.safe(t.Elem(r)) }
    if k == types.Kind.Tuple or k == types.Kind.Record {
        for p in t.Items(t.Parts(r)) {
            if not f.safe(p): return false
        }
        return true
    }
    if k == types.Kind.AnonEnum {
        for p in t.Items(t.ShapeCases(r)) {
            if not f.safe(p): return false
        }
        return true
    }
    if k != types.Kind.Named { return true }
    if not t.HasBody(r) { return false }
    st := try f.safeAsked.Get(r) catch default 0
    if st == 1 or st == 3 { return true }    # being asked: a cycle through references holds nothing new
    if st == 2 { return false }
    f.safeAsked.Put(r, 1)
    ok := true
    dk := t.DeclKindOf(t.DeclOf(r))
    if dk == types.DeclKind.Struct {
        if t.Destructs(r) { ok = false }
        for p in t.Items(t.Fields(r)) {
            if ok and not f.safe(p): ok = false
        }
    } else if dk == types.DeclKind.Enum {
        for p in t.Items(t.Cases(r)) {
            if ok and not f.safe(p): ok = false
        }
    } else if dk != types.DeclKind.Over {
        ok = false
    }
    f.safeAsked.Put(r, 3 if ok else 2)
    return ok
}

# the candidate place of a struct type's field (i >= 0) or an array type's elements (i == -1): its index, -1 for none
fn (f mut Free&) placeKey(ty types.TypeId, i I64) I64 {
    t := f.T()
    r := t.Plain(t.Repr(ty))
    k := pair.Pair(I64(r), i)
    asked := try f.typeAsked.Get(k) catch default 0
    if asked == 1: return -1
    if asked == 2: return try f.placeOf.Get(k) catch default -1
    cand := false
    vt := types.UnknownT
    hd := false
    ow := false
    ar := false
    dt := false
    if i < 0 {
        if t.KindOf(r) == types.Kind.Array {
            vt = t.Elem(r)
            cand = f.refCand(vt)
            if not cand and f.dtorCand(vt) {
                cand = true
                dt = true
            }
        }
    } else if t.KindOf(r) == types.Kind.Named and t.HasBody(r) and t.DeclKindOf(t.DeclOf(r)) == types.DeclKind.Struct {
        fs := t.Items(t.Fields(r))
        if i < fs.Len() {
            vt = fs[i]
            cand = f.refCand(vt)
            if not cand and f.handleCand(vt) {
                cand = true
                hd = true
            }
            if not cand and f.ownerCand(vt) {
                cand = true
                ow = true
            }
            if not cand and f.arrayCand(vt) {
                cand = true
                ar = true
            }
            if not cand and f.dtorCand(vt) {
                cand = true
                dt = true
            }
        }
    }
    if not cand {
        f.typeAsked.Put(k, 1)
        return -1
    }
    n := f.newPlace(r, i, hd, vt, dt)
    f.owner[n] = ow
    f.arr[n] = ar
    f.placeOf.Put(k, n)
    f.typeAsked.Put(k, 2)
    return n
}

# a candidate place's lists given its entry: its key, whether it holds a handle, its value's type, whether its values
# have destructors
fn (f mut Free&) newPlace(ty types.TypeId, field I64, hd Bool, vt types.TypeId, dt Bool) I64 {
    n := f.keyTy.Len()
    f.keyTy.Push(ty)
    f.keyField.Push(field)
    f.handle.Push(hd)
    f.owner.Push(false)
    f.arr.Push(false)
    f.valTy.Push(vt)
    f.whyKind.Push(RNone)
    f.libTaken.Push(false)
    f.why.Push(reason(RNone, -1, source.Span(0, 0), ""))
    f.dtorVal.Push(dt)
    f.olBody.Push(-1)
    f.olLocal.Push(-1)
    f.glModule.Push(-1)
    f.glName.Push(-1)
    return n
}

# whether a candidate place is an owner local
fn (f Free&) isOwnLocal(k I64) Bool { return k >= 0 and k < f.keyField.Len() and f.keyField[k] == -3 }

# whether a candidate place is a global
fn (f Free&) isGlobal(k I64) Bool { return k >= 0 and k < f.keyField.Len() and f.keyField[k] == -4 }

# whether a candidate place is a value of its own, named by the program - an owner local or a global - rather than a
# field or an array's elements, keyed by a type
fn (f Free&) isNamed(k I64) Bool { return f.isOwnLocal(k) or f.isGlobal(k) }

# whether a field or element type is a reference to a struct whose own destructor is all freeing cannot meet: a dtor
# place's values, never freed by a let-go (O15)
fn (f mut Free&) dtorCand(ty types.TypeId) Bool {
    t := f.T()
    if not t.IsRef(ty) or t.ForeignRef(ty) or t.IsAny(ty) { return false }
    r := t.Repr(t.Referent(ty))
    if t.KindOf(r) != types.Kind.Named or not t.HasBody(r) or t.DeclKindOf(t.DeclOf(r)) != types.DeclKind.Struct { return false }
    if not t.Destructs(r) { return false }
    for p in t.Items(t.Fields(r)) {
        if not f.safe(p): return false
    }
    return true
}

# the candidate place a typed place is, -1 for none: a field of a struct (through a reference or held in place), an
# element of an array
fn (f mut Free&) placeOfPlace(p typed.Lvalue&) I64 {
    return match p {
        case typed.Lvalue.Field(_, _, base, i): f.placeKey(base.Type(), i)
        case typed.Lvalue.Elem(_, _, e): f.placeKey(f.arrayOf(e.Base.Type()), -1)
        case typed.Lvalue.Global(_, _, m, n): try f.globalOf.Get(pair.Pair(m, I64(n))) catch default -1
        case _: -1
    }
}

# the array type behind ty: ty's representation, or what a reference to one names
fn (f mut Free&) arrayOf(ty types.TypeId) types.TypeId {
    t := f.T()
    r := t.Repr(ty)
    if t.IsRef(r) { r = t.Repr(t.Referent(r)) }
    return r
}

# the candidate places inside a value of type ty held in place, through its by-value struct fields - a struct copied
# whole copies them
fn (f mut Free&) leaves(ty types.TypeId) Vec<leaf> {
    t := f.T()
    r := t.Plain(t.Repr(ty))
    out Vec<leaf>
    if t.KindOf(r) != types.Kind.Named or not t.HasBody(r) or t.DeclKindOf(t.DeclOf(r)) != types.DeclKind.Struct {
        return out
    }
    known := try f.leafAsked.Get(r) catch default Vec<leaf>()
    if f.leafAsked.Has(r) { return known }
    f.leafAsked.Put(r, out)          # (none while asked: a struct holds itself in place only through a reference - no cycle)
    fs := t.Items(t.Fields(r))
    for i in range fs.Len() {
        k := f.placeKey(r, i)
        if k >= 0 {
            out.Push(leaf(Array<I64>[i], k))
            continue
        }
        fr := t.Repr(fs[i])
        if t.KindOf(fr) == types.Kind.Named and t.HasBody(fr) and t.DeclKindOf(t.DeclOf(fr)) == types.DeclKind.Struct {
            for l in f.leaves(fr) {
                path := Array<I64>(l.Path.Len() + 1)
                path[0] = i
                for j in range l.Path.Len() { path[j + 1] = l.Path[j] }
                out.Push(leaf(path, l.PlaceId))
            }
        }
    }
    f.leafAsked.Put(r, out)
    return out
}

# ---- bodies: where their code is emitted, and whose it is ----

fn (f mut Free&) bodyModule(b I64) I64 {
    p := f.P
    return match f.Bodies[b].Of {
        case typed.BodyOf.Fn(i): -3 if p.InstanceArgs(i) != types.ListId(0) else p.FnModule(p.InstanceFn(i))
        case typed.BodyOf.Ctor(ty, twin): -3 if twin != types.ListId(0) else f.typeModule(ty)
        case typed.BodyOf.Dtor(ty): f.typeModule(ty)
        case typed.BodyOf.Global(m, _): m
        case typed.BodyOf.Test(_): p.L.Root
        case typed.BodyOf.Thunk(_, _): -3
        case typed.BodyOf.Lambda(parent): f.bodyModule(I64(parent))
        case typed.BodyOf.Contract(body, _, _): f.bodyModule(I64(body))
        case _: -4
    }
}

# a type's module, -3 for an instance's (emitted with the root's)
fn (f mut Free&) typeModule(ty types.TypeId) I64 {
    t := f.T()
    r := t.Repr(ty)
    if t.KindOf(r) != types.Kind.Named or t.Args(r) != types.ListId(0) { return -3 }
    return t.DeclModule(t.DeclOf(r))
}

# the module whose source a body's code is: an instance's generic's
fn (f mut Free&) sourceModule(b I64) I64 {
    m := f.bodyModule(b)
    if m == -3 {
        match f.Bodies[b].Of {
            case typed.BodyOf.Fn(i) { m = f.P.FnModule(f.P.InstanceFn(i)) }
            case typed.BodyOf.Ctor(ty, _) { m = f.T().DeclModule(f.T().DeclOf(f.T().Repr(ty))) }
            case _ { }
        }
    }
    return m
}

fn (f mut Free&) preludeCode(b I64) Bool {
    m := f.sourceModule(b)
    if m < 0 or m >= f.P.L.Mods.Len() { return false }
    return f.P.L.Mods[m].Identity.StartsWith("std/prelude")
}

# whether a body is the program's own code - not std's - for where the report says what keeps (B18)
fn (f mut Free&) ownCode(b I64) Bool {
    m := f.bodyModule(b)
    if m == -3 {
        # an instance: the program's own when its generic is declared outside std
        match f.Bodies[b].Of {
            case typed.BodyOf.Fn(i) { m = f.P.FnModule(f.P.InstanceFn(i)) }
            case typed.BodyOf.Ctor(ty, _) { m = f.T().DeclModule(f.T().DeclOf(f.T().Repr(ty))) }
            case _ { return false }
        }
    }
    if m < 0 or m >= f.P.L.Mods.Len() { return false }
    return not f.P.L.Mods[m].Identity.StartsWith("std/")
}

# ---- the run ----

# the whole analysis, at a program's root: candidates, summaries to a fixed point, the final pass's events, the
# decisions, and the regions written into the plans. With no root (a module compiled on its own) nothing is decided
fn (f mut Free&) Decide(plans Vec<typed.Plan>, root I64) {
    f.Plans = plans
    f.Root = root
    n := f.Bodies.Len()
    for b in range n {
        m := f.bodyModule(b)
        f.module.Push(m)
        f.decided.Push(not f.Alone and (m == -3 or m == root))
        f.programCode.Push(f.ownCode(b))
        f.prelude.Push(f.preludeCode(b))
        f.resFrom.Push(Vec<I64>())
        f.parStored.Push(Vec<I64>())
        f.parEsc.Push(Vec<I64>())
        f.parEscC.Push(Vec<I64>())
        f.parMulti.Push(Vec<I64>())
        f.parWhole.Push(Vec<I64>())
        f.lets.Push(Vec<I64>())
        f.letsAll.Push(false)
        f.mustRes.Push(MustTop)
        f.resFresh.Push(true)
        f.regOut.Push(false)
        match f.Bodies[b].Of {
            case typed.BodyOf.Fn(i) { if f.P.FnDecl(f.P.InstanceFn(i)).Export and f.handedToC(i) { f.exports.Push(b) } }
            case _ { }
        }
        f.mustLocals.Push(Vec<I64>())
        f.withinLocals.Push(Vec<I64>())
        f.freshLocals.Push(Vec<Bool>())
        f.callers.Push(Vec<I64>())
        f.taskAt.Push(false)
        f.named.Push(false)
        f.saved.Push(Array<I64>(0))
        f.savedAt.Push(Array<I64>(0))
        f.olIn.Push(false)
        f.noteDtor(b)
    }
    # with no root nothing is freed early
    if root < 0 { return }
    # the candidates: places a body assigns or vacates (a let-go of one needs one of those somewhere)
    for b in range n {
        f.curBody = b
        if f.Bodies[b].Root is not null { f.findCands(f.Bodies[b].Root!) }
    }
    if f.keyTy.Len() == 0 { return }
    for b in range n {
        if f.Bodies[b].Root is not null { f.findFeeds(b) }
    }
    t0 := time.Now()
    # the must-summaries, greatest fixed point - what the may-summaries' stores read (withinOf): every body once,
    # callees first, then again each body a callee of which changed
    order := f.Sc.CalleesFirst()
    if order.Len() != n {
        order = Array<I64>(n)
        for b in range n { order[b] = b }
    }
    mustCallers Vec<Vec<I64>>
    for _ in range n { mustCallers.Push(Vec<I64>()) }
    for b in range n {
        for c in f.Sc.CalleesOf(b) {
            if c >= 0 and c < n: mustCallers.RefMut(c).Push(b)
        }
    }
    rm I64 = 0
    mq Vec<I64>
    inMq := Array<Bool>(n, true)
    for b in order { mq.Push(b) }
    for at := 0, at < mq.Len(), at++ {
        b := mq[at]
        inMq[b] = false
        f.changed = false
        rm++
        f.mustOf(b)
        if not f.changed: continue
        for c in mustCallers[b] {
            if not inMq[c] {
                inMq[c] = true
                mq.Push(c)
            }
        }
    }
    t1 := time.Now()
    # the may-summaries, least fixed point: every body walked once - which finds who calls whom - then again each body
    # a callee of which changed its summary
    rw I64 = 0
    queue Vec<I64>
    queued := Array<Bool>(n, true)
    for b in order { queue.Push(b) }
    for at := 0, at < queue.Len(), at++ {
        b := queue[at]
        queued[b] = false
        f.changed = false
        rw++
        f.walk(b, false)
        if not f.changed: continue
        for c in f.callers[b] {
            if not queued[c] {
                queued[c] = true
                queue.Push(c)
            }
        }
    }
    t2 := time.Now()
    if f.Debug { try io.PrintErr($"free: " $n " bodies, " $f.keyTy.Len() " places; must " $rm " bodies " $((t1 - t0) / 1000000) " ms; may " $rw " walks " $f.passes " passes " $((t2 - t1) / 1000000) " ms\n") catch io.Error { } }
    # destructors, Str, Eq and Hash run where no call is written: one that lets go of a place keeps everything
    for b in range n {
        if f.lets[b].Len() > 0 or f.letsAll[b] {
            # what it may let go of keeps: it runs where no call is written, so no view can be judged across it - every
            # place, where it may let go of any
            # (Part C: a destructor running only where a value's holder lets go of it is a call there - dtorCalls)
            if f.implicit(b) and not f.modelled(b) {
                if f.letsAll[b] { f.hidden = true } else { addAllTo(f.hiddenAt, f.lets[b]) }
                if f.Debug { try io.PrintErr($"free: hidden let-go in " $f.fnName(b) " at " $f.P.L.Diags.Locate(f.Bodies[b].File, I64(f.Bodies[b].Sp.Start)) "\n") catch io.Error { } }
            }
        }
    }
    t3 := time.Now()
    for b in range n { f.walk(b, true) }
    t4 := time.Now()
    f.tasks = f.reachedTasks()
    f.decide()
    f.Done = true
    f.writePlans()
    t5 := time.Now()
    if f.Debug { try io.PrintErr($"free: final " $((t4 - t3) / 1000000) " ms, " $f.goes.Len() " let-goes, " $f.stores.Len() " stores; decide " $((t5 - t4) / 1000000) " ms\n") catch io.Error { } }
}

# whether the program may start a task (condition 3): a body that starts one, or gives C a function value, reached from
# where the program's code may begin - every body but a plain function's (main, a test, an initializer, a lambda, a
# method a table may call, a constructor, a destructor), a function named as a value or exported - through the calls
# the scope pass and the walks found. A function nothing reaches starts nothing (std/os's RunOnStack, never called)
fn (f mut Free&) reachedTasks() Bool {
    n := f.Bodies.Len()
    seen := Array<Bool>(n)
    work Vec<I64>
    for b in range n {
        if not f.entry(b): continue
        seen[b] = true
        work.Push(b)
    }
    callees Vec<Vec<I64>>
    for _ in range n { callees.Push(Vec<I64>()) }
    for b in range n {
        for c in f.callers[b] {
            if c >= 0 and c < n: callees.RefMut(c).Push(b)
        }
    }
    for at := 0, at < work.Len(), at++ {
        b := work[at]
        if f.taskAt[b]: return true
        for c in f.Sc.CalleesOf(b) {
            if c < 0 or c >= n or seen[c]: continue
            seen[c] = true
            work.Push(c)
        }
        for c in callees[b] {
            if seen[c]: continue
            seen[c] = true
            work.Push(c)
        }
    }
    return false
}

# whether a body is where the program's code may begin (reachedTasks): anything but a plain function no one names
fn (f mut Free&) entry(b I64) Bool {
    i := match f.Bodies[b].Of {
        case typed.BodyOf.Fn(inst): inst
        case _: -1
    }
    if i < 0 or f.named[b]: return true
    d := f.P.FnDecl(f.P.InstanceFn(i))
    return d.Recv is not null or d.Export or f.P.L.Names.Text(d.Name) == "main"
}

# ---- Part C: destructors where their holders let go ----

# body b as a destructor's (by its type), or as a constructor registering its instance (C11's reference-only
# instance, registered where it lands - O16)
fn (f mut Free&) noteDtor(b I64) {
    t := f.T()
    match f.Bodies[b].Of {
        case typed.BodyOf.Dtor(ty) { f.dtorOf.Put(I64(t.Repr(ty)), b) }
        case typed.BodyOf.Ctor(_, _) {
            rs := t.Results(f.Bodies[b].Ty)
            if rs.Len() == 1 and t.IsRef(rs[0]) and t.NeedsDrop(t.Referent(rs[0])) { f.register(t.Referent(rs[0])) }
        }
        case _ { }
    }
}

# a value of type ty registered with a scope (O16): the destructors it runs - its own and its parts' - run as that
# scope closes, where no call is written
fn (f mut Free&) register(ty types.TypeId) {
    if f.Debug and not f.registered.Has(I64(f.T().Repr(ty))) { try io.PrintErr($"free: registered " $f.T().Canon(ty) "\n") catch io.Error { } }
    for p in f.T().ValueParts(ty) { f.registered.Put(I64(p), true) }
}

# whether destructor body b runs only where a holder lets go of a value written in the program (a Drop,
# walked as a call of it - dtorCalls): no value of its type is ever registered with a scope, and no test build's guard
# runs it where a failed check unwinds
fn (f mut Free&) modelled(b I64) Bool {
    if f.Tests: return false
    return match f.Bodies[b].Of {
        case typed.BodyOf.Dtor(ty): not f.registered.Has(I64(f.T().Repr(ty)))
        case _: false
    }
}

fn (f Free&) isDtor(b I64) Bool {
    if b < 0 or b >= f.Bodies.Len(): return false
    return match f.Bodies[b].Of {
        case typed.BodyOf.Dtor(_): true
        case _: false
    }
}

# a Drop of a value of the type a gives (or refers to): a call of each destructor it runs - its own and its
# parts', deep - with every let-go those bodies may do (Part C: so a destructor's let-goes are judged where it runs)
fn (w mut walker&) dtorCalls(sp source.Span, a typed.Expr&) {
    t := w.T()
    ty := a.Type()
    w.dtorCallsOf(sp, t.Referent(ty) if t.IsRef(ty) else ty)
}

fn (w mut walker&) dtorCallsOf(sp source.Span, ty types.TypeId) {
    f := w.F
    t := w.T()
    for p in t.ValueParts(ty) {
        b2 := try f.dtorOf.Get(I64(p)) catch default -1
        if b2 < 0: continue
        if not w.Final { addTo(f.callers[b2], w.Id) }
        if f.letsAll[b2] {
            if not w.Final and not f.letsAll[w.Id] {
                f.letsAll[w.Id] = true
                f.changed = true
            }
            if w.Final: w.go(AnyPlace, LCall, sp, source.Span(0, 0), b2)
            continue
        }
        for k in f.lets[b2] { w.go(k, LCall, sp, source.Span(0, 0), b2) }
    }
}

# Part C: block bl's scope closing - a statement of its own after everything in it - running the destructors of the
# values registered with it (O16), each walked as a call there
fn (w mut walker&) closeAt(bl typed.Block&) {
    ts := try w.closes.Get(I64(bl.Id)) catch { return }
    w.closes.Remove(I64(bl.Id))
    n := w.no
    w.no++
    w.ends.Push(n)
    was := w.cur
    w.cur = n
    sp := w.body().Blocks[I64(bl.Id)].Sp
    for ty in ts { w.dtorCallsOf(sp, ty) }
    w.ends[n] = n
    w.cur = was
}

# a value with destructors to run given storage at site (a Promote, O16): registered with the scope the site builds
# in - a block of this body, whose close runs them (closeAt); any other scope's close is no place of this body
fn (w mut walker&) registeredAt(site typed.SiteId, ty types.TypeId) {
    f := w.F
    sc := typed.Scope.Unset
    if w.Id < f.Plans.Len() and site >= typed.SiteId(0) and I64(site) < f.Plans[w.Id].Built.Len() { sc = f.Plans[w.Id].Built[I64(site)] }
    if sc != typed.Scope.Block {
        f.register(ty)
        return
    }
    k := I64(sc.b)
    ts := try w.closes.Get(k) catch default Vec<types.TypeId>()
    if not ts.Has(ty): ts.Push(ty)
    w.closes.Put(k, ts)
}

# the by-value local a Drop in deferred code ends - a holder letting go where its block is left (check.dropOnExit) - -1
# for any other operation
fn (w mut walker&) heldDrop(op typed.PrimOp, args Array<typed.Expr&>&) I64 {
    if op != typed.PrimOp.Drop or args.Len() != 1 or w.deferStack.Len() == 0: return -1
    a := args[0]
    if a != typed.Expr.Borrow: return -1
    p := a.p
    if p != typed.Lvalue.Local: return -1
    return I64(p.id)
}

# Part C: a holder whose storage the scope pass homed outside its block registers its value where that storage lives
# instead of ending it (lowering's escapedHome)
fn (w mut walker&) escapedHolder(d typed.Block&) {
    b := w.body()
    l := typed.DropHolder(b, d)
    if l < 0 or b.Locals[l].Kind == typed.LocalKind.Field or w.Id >= w.F.Plans.Len(): return
    st := w.F.Plans[w.Id].Stored
    if l >= st.Len(): return
    s := st[l]
    own := s == typed.Scope.Frame or s == typed.Scope.Unset or (s == typed.Scope.Block and s.b == b.Locals[l].In)
    if not own and w.F.Debug { try io.PrintErr($"free: escaped holder " $l " in " $w.F.fnName(w.Id) " " $s " in " $b.Locals[l].In "\n") catch io.Error { } }
    if not own { w.F.register(b.Locals[l].Ty) }
}

# whether C may call instance i, an export fn (X12-X14): the program is built as a library, a C function is given it
# (X13 - check records each it meets), or the program links C of its own, which may name it
fn (f Free&) handedToC(i I64) Bool {
    return f.P.L.SharedLib or f.P.L.HandedToC.Has(f.P.InstanceFn(i)) or f.P.L.LinksOwnC()
}

# whether a body runs where no call is written: a destructor, or a method lowering calls by its name (E11c, E10a)
fn (f mut Free&) implicit(b I64) Bool {
    match f.Bodies[b].Of {
        case typed.BodyOf.Dtor(_) { return true }
        case typed.BodyOf.Fn(i) {
            d := f.P.FnDecl(f.P.InstanceFn(i))
            nm := f.P.L.Names.Text(d.Name)
            return nm == "Str" or nm == "Eq" or nm == "Hash" or nm == "str" or nm == "eq" or nm == "hash"
        }
        case _ { return false }
    }
}

# ---- the pre-pass: places assigned or vacated ----

fn (f mut Free&) findCands(bl typed.Block&) {
    for st in bl.Stmts { f.findStmt(st) }
}

fn (f mut Free&) findStmt(st typed.Stmt&) {
    match st {
        case typed.Stmt.Assign(_, p, x) {
            f.candTarget(p)
            f.ownLocalCand(p)
            f.globalCand(p)
            f.findExpr(x)
        }
        case typed.Stmt.Let(_, _, x) { f.findExpr(x) }
        case typed.Stmt.Eval(_, x) {
            f.findExpr(x)
        }
        case typed.Stmt.If(_, i) {
            f.findExpr(i.Test)
            f.findCands(i.Then)
            if i.Else is not null { f.findCands(i.Else!) }
        }
        case typed.Stmt.Loop(_, body, post) {
            f.findCands(body)
            if post is not null { f.findCands(post) }
        }
        case typed.Stmt.Return(_, x), typed.Stmt.Suspend(_, x) { if x is not null: f.findExpr(x) }
        case typed.Stmt.Block(_, b) { f.findCands(b) }
        case typed.Stmt.Defer(_, b) { f.findCands(b) }
        case typed.Stmt.Join(_, j) { f.findCands(j.Code) }
        case _ { }
    }
}

# ---- feeders: locals built where they are kept (O28 item 17, D9i, O8d) ----

# the feeders of body b: a value local declared by a statement of a block and copied whole at its last mention
# (typed.LastCopies) into an owner place by a later assignment of the same block - so the place its value goes to is
# known at its declaration - named no other way (assigned whole, escaping, a second name), its declaration's value
# built where the local lives, and the copy going where the local lives or to the program's scope
fn (f mut Free&) findFeeds(b I64) {
    body := f.Bodies[b]
    if body.Gen: return
    last := typed.LastCopies(body, true)
    if last.Len() == 0: return
    u := typed.LocalUses.Uses(f.T(), body)
    f.feedBlock(b, body.Root!, last, u)
}

fn (f mut Free&) feedBlock(b I64, bl typed.Block&, last Map<I64, I64>&, u typed.LocalUses&) {
    lets Map<I64, typed.Expr&>
    for st in bl.Stmts {
        match st {
            case typed.Stmt.Let(_, l, x) { lets.Put(I64(l), x) }
            case typed.Stmt.Assign(_, p, x) {
                cs := wholeCopySite(x)
                l := try last.Get(cs) catch default -1
                if l >= 0 and lets.Has(l): f.feedStore(b, l, lets.Get(l)!, cs, p, u)
            }
            case typed.Stmt.If(_, i) {
                f.feedBlock(b, i.Then, last, u)
                if i.Else is not null { f.feedBlock(b, i.Else!, last, u) }
            }
            case typed.Stmt.Loop(_, body, post) {
                f.feedBlock(b, body, last, u)
                if post is not null { f.feedBlock(b, post, last, u) }
            }
            case typed.Stmt.Block(_, inner) { f.feedBlock(b, inner, last, u) }
            case _ { }
        }
    }
}

fn (f mut Free&) feedStore(b I64, l I64, init typed.Expr&, cs I64, p typed.Lvalue&, u typed.LocalUses&) {
    body := f.Bodies[b]
    loc := body.Locals[l]
    t := f.T()
    if loc.Kind != typed.LocalKind.Var or loc.Unset or t.IsRef(loc.Ty) or u.Whole[l] or u.EscHard[l]: return
    for a in u.AliasOf {
        if a == l: return
    }
    k := -1
    match p {
        case typed.Lvalue.Field(_, _, _, _) { k = f.placeOfPlace(p) }
        case typed.Lvalue.Global(_, _, m, nm) { k = try f.globalOf.Get(pair.Pair(m, I64(nm))) catch default -1 }
        case _ { }
    }
    if k < 0 or not f.owner[k] or f.topSite(init) < 0: return
    pl := f.Plans.Ref(b)
    at := f.siteScope(b, init)
    dest := pl.Built[cs]
    if not runs(at) or not runs(dest) or pl.Stored[l] != at and not (pl.Stored[l] == typed.Scope.Frame and isBlock(at)): return
    if dest != at and dest != typed.Scope.Program: return
    f.feedOf.Put(pair.Pair(b, l), f.feeds.Len())
    f.feeds.Push(feed(b, l, k, cs, at, dest))
}

fn isBlock(sc typed.Scope) Bool {
    return match sc {
        case typed.Scope.Block(_): true
        case _: false
    }
}

# the site of the copy of a whole local an expression is, -1 for any other (typed.LastCopies's sites)
fn wholeCopySite(x typed.Expr&) I64 {
    return match x {
        case typed.Expr.Make(_, _, m): I64(m.Site) if m.Kind == typed.MakeKind.Copy and m.Items.Len() == 1 and readLocalOf(m.Items[0]) >= 0 else -1
        case typed.Expr.Away(_, _, y): wholeCopySite(y)
        case _: -1
    }
}

# the feeder local l of the walked body is, -1 for none
fn (w mut walker&) feeder(l I64) I64 {
    if l < 0 or w.F.feeds.Len() == 0 { return -1 }
    return try w.F.feedOf.Get(pair.Pair(w.Id, l)) catch default -1
}

# the feeder an argument is a reference to, or to a part of (through fields held by value), -1 for none
fn (w mut walker&) feederArg(x typed.Expr&) I64 {
    return match x {
        case typed.Expr.Borrow(_, _, p): w.feeder(fieldRootLocal(p))
        case typed.Expr.Away(_, _, y): w.feederArg(y)
        case _: -1
    }
}

fn fieldRootLocal(p typed.Lvalue&) I64 {
    return match p {
        case typed.Lvalue.Local(_, _, l): I64(l)
        case typed.Lvalue.Field(_, _, base, _): fieldRootLocal(base)
        case _: -1
    }
}

# a writable call given a feeder: what it builds where the feeder lives can be built in the feeder's region - its
# variable passed the feeder's scope, and the variables built with it fitting the callee's obligations (orVars) - else
# the feeder's place keeps, as for a value changed in place
fn (f mut Free&) feedFits(fc feedCall) Bool {
    fd := f.feeds[fc.Feed]
    u := f.paramVar(fc.Callee, fc.Param)
    if u < 0: return true
    at := f.Plans.Ref(fc.Body).Passed(typed.SiteId(I32(fc.Site)), u)
    if at != fd.At: return not fc.Writes
    call := f.callAt(fc.Body, fc.Site)
    if call is null: return not fc.Writes
    return f.orVars(fc.Body, call, fc.Callee, at, u) >= 0 or not fc.Writes
}

# the feeders' calls: a variable passed the feeder's scope passed its region instead, and the arguments built with it
# there too (as a call given a value of a sole place is, below)
fn (f mut Free&) writeFeedCalls() {
    for fc in f.feedCalls {
        fd := f.feeds[fc.Feed]
        if fd.Site < 0 or f.decided[fc.Body] and not f.Sole[fd.PlaceId]: continue
        pl := f.Plans.RefMut(fc.Body)
        if pl.RegionKind[fd.Site] != 1: continue
        u := f.paramVar(fc.Callee, fc.Param)
        if u < 0: continue
        site := typed.SiteId(I32(fc.Site))
        at := pl.Passed(site, u)
        if at != fd.At: continue
        call := f.callAt(fc.Body, fc.Site)
        if call is null: continue
        set := f.orVars(fc.Body, call, fc.Callee, at, u)
        if set < 0: continue
        region := typed.Scope.Region(typed.SiteId(I32(fd.Site)))
        for v in range 63 {
            if (set & (I64(1) << v)) != 0 { pl.SetPassed(site, v, region) }
        }
        for j in range call.Args.Len() {
            v := f.paramVar(fc.Callee, j)
            if v < 0 or v >= 63 or (set & (I64(1) << v)) == 0 or v == u: continue
            a := call.Args[j]
            t2 := f.topSite(a)
            if t2 >= 0 and pl.RegionKind[t2] == 1 {
                if pl.RegionParent[t2] == at { pl.RegionParent[t2] = region }
            } else {
                f.redirect(fc.Body, a, fd.Site, at, false)
            }
        }
    }
}

# an assignment's target that is a plain local holding an owner by value: an owner local of the body (keyField -3),
# whose every value - its declaration's and each assignment's - is built in a region of its own where it is sole, the
# one it held released as it is given another (O8d: a Vec local given a new value each turn of a loop)
fn (f mut Free&) ownLocalCand(p typed.Lvalue&) {
    match p {
        case typed.Lvalue.Local(_, ty, l) {
            key := pair.Pair(f.curBody, I64(l))
            # (one declared with no value, D13d, holds nothing written before its first assignment - no old value)
            loc := f.Bodies[f.curBody].Locals[I64(l)]
            if f.ownLocalOf.Has(key) or loc.Kind != typed.LocalKind.Var or loc.Unset: return
            if not f.ownerCand(ty): return
            k := f.newPlace(ty, -3, false, ty, false)
            f.owner[k] = true
            f.olBody[k] = f.curBody
            f.olLocal[k] = I64(l)
            f.ownLocalOf.Put(key, k)
            f.olIn[f.curBody] = true
        }
        case _ { }
    }
}

# an assignment's target that is a mutable global holding an owner by value or a reference freeing can meet, assigned
# in a body other than its own initializer: a global place (keyField -4), every value it is given - its initializer's
# too, a store and a let-go of the zeroed storage it starts as - built in a region of its own where it is sole, the one
# it held released as it is given another (O8d: a global is a place like any other)
fn (f mut Free&) globalCand(p typed.Lvalue&) {
    match p {
        case typed.Lvalue.Global(_, ty, m, n) {
            key := pair.Pair(m, I64(n))
            if f.globalOf.Has(key): return
            match f.Bodies[f.curBody].Of {
                case typed.BodyOf.Global(_, _) { return }
                case _ { }
            }
            ow := f.ownerCand(ty)
            hd := not ow and f.handleCand(ty)
            if not ow and not hd and not f.refCand(ty): return
            k := f.newPlace(ty, -4, hd, ty, false)
            f.owner[k] = ow
            f.glModule[k] = m
            f.glName[k] = I64(n)
            f.globalOf.Put(key, k)
        }
        case _ { }
    }
}

# an assignment's target: a field place let go of, or the candidate leaves of a struct held in place
fn (f mut Free&) candTarget(p typed.Lvalue&) {
    match p {
        case typed.Lvalue.Field(_, ty, _, _) {
            if f.placeOfPlace(p) < 0 { f.leaves(ty) }
        }
        case _ { }
    }
}

fn (f mut Free&) findExpr(x typed.Expr&) {
    match x {
        case typed.Expr.Take(_, ty, p) {
            if f.placeOfPlace(p) < 0 { f.leaves(ty) }
        }
        case typed.Expr.Call(_, _, c) {
            for a in c.Args { f.findExpr(a) }
        }
        case typed.Expr.Try(_, _, t) {
            if t.X is not null { f.findExpr(t.X!) }
            for c in t.Clauses {
                if c.Code is not null { f.findCands(c.Code!) }
            }
        }
        case typed.Expr.Seq(_, _, q) {
            for st in q.Stmts { f.findStmt(st) }
            if q.X is not null { f.findExpr(q.X!) }
        }
        case typed.Expr.Match(_, _, m) {
            for st in m.Held { f.findStmt(st) }
            for a in m.Arms {
                if a.Code is not null { f.findCands(a.Code!) }
                if a.Value is not null { f.findExpr(a.Value!) }
            }
            if m.NoMatch is not null {
                if m.NoMatch!.Code is not null { f.findCands(m.NoMatch!.Code!) }
            }
        }
        case typed.Expr.Collect(_, _, c) { f.findCands(c.Loop) }
        case _ { }
    }
}

# ---- walking a body ----

# one walk of a body: the origins of its locals (flow-insensitive, to a fixed point within the walk's rounds), its
# summary's contributions, and - in the final walk - the events the decisions are made from
type walker struct(F mut Free&, Id I64, Final Bool) {
    F
    Id
    Final
    origins Vec<mut Vec<I64>&>   # by local: what it may refer into
    seen Vec<Bool>            # by local: its origins read in this pass
    grew Bool = false
    params Map<I64, I64>       # a parameter's local: its index in Params
    fields Map<I64, I64>       # a constructor's field local: its field's position
    ctorTy types.TypeId = types.UnknownT
    targets Vec<typed.Lvalue&>
    yieldTo Vec<I64>          # the element place of each Collect being walked, -1 for none
    # statements numbered in walk order, for views and for stores on one path
    no I64 = 0
    cur I64 = 0
    ends Vec<I64>             # by statement number: the last number inside it
    loopAt Vec<I64>           # each loop's first and last statement numbers
    loopEnd Vec<I64>
    thenFrom Vec<I64>         # each if's branches: the then's first and last, the else's first and last
    thenTo Vec<I64>
    elseFrom Vec<I64>
    elseTo Vec<I64>
    declAt Vec<I64>           # by local: the statement declaring it
    declSp Vec<source.Span>   # by local: its initializer, as written - what a hidden one (a walk's) is said by
    lastAt Vec<I64>           # the statements a return follows
    loops I64 = 0              # the loops the statement being walked is in
    useLocal Vec<I64>         # local uses: the local, the statement, where
    useAt Vec<I64>
    useSp Vec<source.Span>
    deferred Vec<I64>         # locals read in deferred code
    inDefer I64 = 0
    quiet I64 = 0              # events not counted: a value walked again for what it refers into
    storeWithin I64 = -1       # the parameter the container being stored into is reached from (withinOf), -1 none
    storeInside I64 = -1       # ... the place a value of which it is reached through (insidePlace), -1 none
    exemptSite I64 = -1        # the call a store's value is, whose copy (D9h) is made for the place it is stored into
    # Part C: QCE's copy of a value handed on (check.ownCopy) as the value of a store into a struct or an element held in
    # place - made right there for the one owner or array leaf it holds (copyInto). check.storeOver holds it in a Held
    # local first (by local, the copy); the copy whose site is exempt from untracked, the held local read as the store's
    heldCopy Map<I64, typed.Expr&>
    copyExempt I64 = -1
    copyRead I64 = -1
    # Part C: by let-go, the Defer statement whose block's end it stands at (a holder's drop), -1 for its own statement;
    # by block, the types of the values registered with its scope (O16) - their destructors walked as calls at its close
    goEnd Vec<I64>
    closes Map<I64, Vec<types.TypeId>>
    handing I64 = 0             # a unique value being handed on (Seq.Gone): moved, so no view of it is in use here
    # by hidden local: the parameter whose unique value it holds, moved there to be stored (check.storeOver's held value)
    heldPar Map<I64, I64>
    yieldOrig Vec<mut Vec<I64>&>  # what each Collect being walked yields may refer into
    stmtSp source.Span = source.Span(0, 0)     # the statement being walked
    readPlace Vec<I64>        # view reads: the place, the statement
    readAt Vec<I64>
    goPlace Vec<I64>          # let-goes: the place, the statement, the kind, where, the text
    goAt Vec<I64>
    goKind Vec<I64>
    goSp Vec<source.Span>
    goRecv Vec<source.Span>   # a call's receiver (empty for none)
    goCallee Vec<I64>         # a call's callee body (LCall), -1 for none
    goIdx Vec<I64>            # its index in Free.goes, -1 where it is not recorded there
    parSite Vec<I64>          # stores of a parameter's value into a place: the parameter, the place, the statement
    parSitePlace Vec<I64>
    parSiteAt Vec<I64>
    deferStack Vec<I64>        # the Defer statements being walked
    deferEnd Map<I64, I64>     # by Defer statement, the last statement of the block it is in
}

fn walker.newWalker(f mut Free&, b I64, final Bool) mut walker& {
    if f.wk is null { f.wk = walker(f, b, final) }
    w := f.wk!
    w.Id = b
    w.Final = final
    w.grew = false
    w.params.Clear()
    w.fields.Clear()
    w.ctorTy = types.UnknownT
    w.targets.Clear()
    w.yieldTo.Clear()
    w.yieldOrig.Clear()
    w.loops = 0
    w.inDefer = 0
    w.quiet = 0
    w.storeWithin = -1
    w.storeInside = -1
    w.heldCopy.Clear()
    w.heldPar.Clear()
    w.copyExempt = -1
    w.copyRead = -1
    w.reset()
    body := f.Bodies[b]
    n := body.Locals.Len()
    w.origins.Truncate(n)
    w.declAt.Clear()
    w.declSp.Clear()
    w.seen.Clear()
    for i in range n {
        w.seen.Push(false)
        if i < w.origins.Len() { w.origins[i].Clear() } else { w.origins.Push(Vec<I64>()) }
        w.declAt.Push(0)
        w.declSp.Push(source.Span(0, 0))
    }
    for j in range body.Params.Len() {
        l := I64(body.Params[j])
        w.params.Put(l, j)
        addTo(w.origins[l], orig(OPar, j))
    }
    at := f.savedAt[b]
    if at.Len() == n + 1 {
        sv := f.saved[b]
        for l in range n {
            for i in range at[l], at[l + 1] { addTo(w.origins[l], sv[i]) }
        }
    }
    match body.Of {
        case typed.BodyOf.Ctor(ty, _) {
            w.ctorTy = ty
            for k in range body.Fields.Len() { w.fields.Put(I64(body.Fields[k]), k) }
        }
        case _ { }
    }
    return w
}

# the walker's origins kept for body b's next walk
fn (f mut Free&) save(w walker&, b I64) {
    n := w.origins.Len()
    total := 0
    for o in w.origins { total += o.Len() }
    at mut Array<I64>& = Array<I64>(n + 1)
    sv mut Array<I64>& = Array<I64>(total)
    k := 0
    for l in range n {
        at[l] = k
        for y in w.origins[l] {
            sv[k] = y
            k++
        }
    }
    at[n] = k
    f.saved[b] = sv
    f.savedAt[b] = at
}

fn (f mut Free&) walk(b I64, final Bool) {
    body := f.Bodies[b]
    if body.Root is null { return }
    # a constructor of a type with a destructor registers its instance in its instance scope (O16)
    t := f.T()
    if t.Role(body.Ty) == types.RoleCtor and t.Results(body.Ty).Len() == 1 {
        r := t.Repr(t.Results(body.Ty)[0])
        if t.IsRef(r) { r = t.Repr(t.Referent(r)) }
        if t.KindOf(r) == types.Kind.Named and t.HasBody(r) and t.Destructs(r) { f.setRegOut(b) }
    }
    w := walker.newWalker(f, b, false)
    # the locals' origins to a fixed point: a loop's later statements reach its earlier ones. Origins only grow and are
    # finitely many, so it converges; it is never cut short (F3) - an under-approximation would free what is in use
    for {
        w.grew = false
        w.reset()
        f.passes++
        w.block(body.Root!)
        if not w.grew: break
    }
    w.paramPaths()
    f.save(w, b)
    # then the events, once
    if final {
        w.Final = true
        w.reset()
        w.block(body.Root!)
        w.views()
    }
}

# the per-walk events cleared before a round
fn (w mut walker&) reset() {
    for l in range w.seen.Len() { w.seen[l] = false }
    w.no = 0
    w.cur = 0
    w.ends.Clear()
    w.loopAt.Clear()
    w.lastAt.Clear()
    w.loopEnd.Clear()
    w.thenFrom.Clear()
    w.thenTo.Clear()
    w.elseFrom.Clear()
    w.elseTo.Clear()
    w.useLocal.Clear()
    w.useAt.Clear()
    w.useSp.Clear()
    w.deferred.Clear()
    w.readPlace.Clear()
    w.readAt.Clear()
    w.goPlace.Clear()
    w.goAt.Clear()
    w.goKind.Clear()
    w.goSp.Clear()
    w.goRecv.Clear()
    w.goCallee.Clear()
    w.goIdx.Clear()
    w.goEnd.Clear()
    w.closes.Clear()
    w.parSite.Clear()
    w.parSitePlace.Clear()
    w.parSiteAt.Clear()
    w.deferStack.Clear()
    w.deferEnd.Clear()
}

fn (w mut walker&) body() typed.Body& { return w.F.Bodies[w.Id] }

fn (w mut walker&) T() mut types.Table& { return w.F.P.T }

fn (w mut walker&) block(bl typed.Block&) {
    nums Vec<I64>
    for i in range bl.Stmts.Len() {
        # a statement right before a return: what it stores is the last store on its path
        if i + 1 < bl.Stmts.Len() and leaves(bl.Stmts[i + 1]) { w.lastAt.Push(w.no) }
        if w.Final: nums.Push(w.no)
        w.stmt(bl.Stmts[i])
    }
    w.closeAt(bl)
    if not w.Final { return }
    # Part C: where a holder's drop - deferred code - runs: its block's end
    for i in range bl.Stmts.Len() {
        match bl.Stmts[i] {
            case typed.Stmt.Defer(_, _) { w.deferEnd.Put(nums[i], w.no - 1) }
            case _ { }
        }
    }
}

fn leaves(st typed.Stmt&) Bool {
    return match st {
        case typed.Stmt.Return(_, _), typed.Stmt.Raise(_, _, _): true
        case _: false
    }
}

fn (w mut walker&) holds(ty types.TypeId) Bool {
    f := w.F
    i := I64(ty)
    if i < 0 { return w.T().HoldsRefs(ty) }
    for f.holdsOf.Len() <= i { f.holdsOf.Push(0) }
    if f.holdsOf[i] == 0 { f.holdsOf[i] = 2 if w.T().HoldsRefs(ty) else 1 }
    return f.holdsOf[i] == 2
}

# an owner's value changed in place: the owner places whose values o may be part of keep - but place `but`, the store's
# own target. What a change of an owner held in place builds is built where the container lives, outside the value's
# region, which a let-go would never release (and an anchor in another region would release that region)
fn (w mut walker&) inOwner(o Vec<I64>&, but I64, sp source.Span, how String&) {
    if not w.Final or w.quiet > 0 { return }
    for y in o {
        k := oval(y)
        if (okind(y) == OPl or okind(y) == OMov) and k != but and w.F.IsOwner(k) {
            w.F.keep(k, RInPlace, w.body().File, sp, $"its value is changed in place, by " $how ": '" $w.text(sp) "'")
        }
    }
}

# a value holding owners made with no store into their places (a copy, a call's value copied, D9h): those places keep
fn (w mut walker&) untracked(ty types.TypeId, sp source.Span, how String&) {
    if not w.Final or w.quiet > 0 { return }
    for k in w.F.heldPlaces(ty) {
        if w.F.Debug { try io.PrintErr($"untracked " $k " at " $w.F.P.L.Diags.Locate(w.body().File, I64(sp.Start)) "\n") catch io.Error { } }
        w.F.keep(k, RCopied, w.body().File, sp, $"a value holding it is made with no store into it, by " $how ": '" $w.text(sp) "'")
    }
}

# whether a value of type ty is a writable reference
fn (w mut walker&) writable(ty types.TypeId) Bool {
    t := w.T()
    r := t.Repr(ty)
    return t.KindOf(r) == types.Kind.Ref and (t.PermOf(r) & types.Writable) != 0
}

# a local given more origins
fn (w mut walker&) give(l I64, o Vec<I64>&) {
    # another pass is needed only where a local grows after this pass read it
    if addAllTo(w.origins[l], o) > 0 and w.seen[l] { w.grew = true }
}

fn (w mut walker&) stmt(st typed.Stmt&) {
    n := w.no
    w.no++
    w.ends.Push(n)
    was := w.cur
    wasSp := w.stmtSp
    w.cur = n
    w.stmtSp = st.Span()
    match st {
        case typed.Stmt.Let(sp, l, x) {
            w.declAt[I64(l)] = n
            w.declSp[I64(l)] = x.Span()
            # (Part C: storeOver's held copy, judged where it is stored - copyInto - or, read anywhere else, untracked)
            lk := w.body().Locals[I64(l)].Kind
            site := ownCopySite(x) if lk == typed.LocalKind.Held or lk == typed.LocalKind.Hidden else -1
            if site >= 0: w.heldCopy.Put(I64(l), x)
            # (a unique value moved out of a parameter into a held local, to be stored: still that parameter's value)
            mp := w.movedPar(x) if lk == typed.LocalKind.Held or lk == typed.LocalKind.Hidden else -1
            if mp >= 0: w.heldPar.Put(I64(l), mp)
            # (and a constructor's field given a copy of a value handed on - QCE's ownCopy of a parameter - its leaves'
            # value, made right there: copyLeaves)
            fk := try w.fields.Get(I64(l)) catch default -1
            # (never in a constructor whose instance views what it is given - D9h leaves that copy out, its caller copying)
            fieldCopy := fk >= 0 and ownCopySite(x) >= 0 and w.F.placeKey(w.ctorTy, fk) < 0 and w.F.leaves(x.Type()).Len() > 0 and
                         w.F.viewsOf(w.Id) == 0
            exemptWas := w.copyExempt
            if site >= 0 or fieldCopy: w.copyExempt = ownCopySite(x)
            o := w.expr(x)
            w.copyExempt = exemptWas
            if fieldCopy {
                o = w.F.unowned(o)
                w.copyLeaves(w.F.leaves(x.Type()), x, sp)
            }
            w.give(I64(l), o)
            k := try w.fields.Get(I64(l)) catch default -1
            if k >= 0 { w.storeField(k, x, o, sp) }
            if k >= 0 { w.wholeField(k, x) }
            ol := w.ownLocal(I64(l))
            if ol >= 0 { w.store(ol, x, o, sp, w.localName(I64(l))) }
            fd := w.feeder(I64(l))
            if fd >= 0 and w.Final and w.quiet == 0 {
                w.made(w.F.feeds[fd].PlaceId, x, sp, false)
                fst := w.F.stores[w.F.stores.Len() - 1]
                if fst.Kind == SFresh: w.F.feeds.RefMut(fd).Site = w.F.topSite(x)
            }
        }
        case typed.Stmt.Assign(sp, p, x) { w.assign(sp, p, x) }
        case typed.Stmt.Eval(sp, x) { w.eval(sp, x) }
        case typed.Stmt.If(_, i) {
            w.expr(i.Test)
            a := w.no
            w.block(i.Then)
            b := w.no - 1
            c := w.no
            if i.Else is not null { w.block(i.Else!) }
            w.thenFrom.Push(a)
            w.thenTo.Push(b)
            w.elseFrom.Push(c)
            w.elseTo.Push(w.no - 1)
        }
        case typed.Stmt.Loop(_, body, post) {
            w.loops++
            w.block(body)
            if post is not null { w.block(post) }
            w.loops--
            w.loopAt.Push(n)
            w.loopEnd.Push(w.no - 1)
        }
        # D18: a generator's yield (Suspend) gives its value as a return does - to the call of its Next - and the body goes
        # on after it, so it ends no path
        case typed.Stmt.Return(_, x), typed.Stmt.Suspend(_, x) {
            if x is not null {
                o := w.expr(x)
                if not w.Final { w.result(o) }
                if w.Final and w.F.olIn[w.Id] { w.returnedOwnLocals(o, st.Span()) }
            }
            # between a yield and the next Next the consumer runs what it likes: a let-go of any place, for every view
            # the body holds across it
            match st {
                case typed.Stmt.Suspend(ysp, _) { w.go(AnyPlace, LYield, ysp, source.Span(0, 0), -1) }
                case _ { }
            }
        }
        case typed.Stmt.Assert(_, c, m) {
            w.expr(c)
            if m is not null: w.expr(m)
        }
        case typed.Stmt.Exit(_, _, m) { if m is not null: w.expr(m) }
        case typed.Stmt.Block(_, b) { w.block(b) }
        case typed.Stmt.Defer(_, b) {
            if not w.Final: w.escapedHolder(b)
            w.inDefer++
            w.deferStack.Push(n)
            w.block(b)
            try w.deferStack.Pop() catch { }
            w.inDefer--
        }
        case typed.Stmt.Join(_, j) {
            w.F.taskAt[w.Id] = true
            w.block(j.Code)
            for c in j.Clauses {
                if c.Code is not null: w.block(c.Code!)
            }
        }
        case typed.Stmt.Spawn(_, s) {
            w.F.taskAt[w.Id] = true
            w.expr(s.Task)
            for c in s.Clauses {
                if c.Handler is not null: w.expr(c.Handler!)
            }
        }
        case typed.Stmt.Yield(sp, x) {
            o := w.expr(x)
            if w.yieldOrig.Len() > 0 { addAllTo(w.yieldOrig[w.yieldOrig.Len() - 1], o) }
            if w.yieldTo.Len() > 0 {
                e := w.yieldTo[w.yieldTo.Len() - 1]
                # (stored into the array being collected, a new one: no escape of what it refers into there - the
                # collected array carries those origins (yieldOrig), judged where it is stored, as a Vec's grown buffer
                # stored back into the Vec is)
                if e >= 0 { w.store(e, x, o, sp, "", true) }
            }
        }
        case _ { }
    }
    w.ends[n] = w.no - 1
    w.cur = was
    w.stmtSp = wasSp
}

# what a return gives: the result's origins (its views, its moves, its parameters'), and whether it is new
fn (w mut walker&) result(o Vec<I64>&) {
    f := w.F
    for x in o {
        if okind(x) == ONew: continue
        if addTo(f.resFrom[w.Id], x) > 0 { f.changed = true }
    }
}

fn (w mut walker&) assign(sp source.Span, p typed.Lvalue&, x typed.Expr&) {
    w.targets.Push(p)
    c0 := typed.Call.Of(x)
    outer := w.exemptSite
    w.exemptSite = I64(c0.Site) if c0 is not null and p != typed.Lvalue.Local else -1
    # Part C: a copy of a value handed on stored into a part held in place - made for its leaves (copyInto)
    cm := w.copyStored(p, x)
    wasE, wasR := w.copyExempt, w.copyRead
    if cm is not null {
        w.copyExempt = ownCopySite(cm)
        w.copyRead = readLocalOf(x)
    }
    o := w.expr(x)
    # (the copy, read out of its held local, is the value made for those leaves - no view of them)
    if cm is not null: o = w.F.unowned(o)
    w.copyExempt, w.copyRead = wasE, wasR
    w.exemptSite = outer
    try w.targets.Pop() catch { }
    # (a value array stored whole from existing storage is copied there, T7b)
    if p != typed.Lvalue.Local and w.T().KindOf(w.T().Repr(p.Type())) == types.Kind.Array and copiedStore(x) {
        w.untracked(p.Type(), sp, "a whole array of them stored")
    }
    match p {
        case typed.Lvalue.Local(_, _, l) {
            w.give(I64(l), o)
            k := try w.fields.Get(I64(l)) catch default -1
            if k >= 0 { w.storeField(k, x, o, sp) }
            if k >= 0 { w.wholeField(k, x) }
            ol := w.ownLocal(I64(l))
            if ol >= 0 {
                w.store(ol, x, o, sp, w.localName(I64(l)))
                w.go(ol, LAssign, p.Span(), source.Span(0, 0), -1)
            }
            return
        }
        case _ { }
    }
    k := w.F.placeOfPlace(p)
    w.inOwner(w.reach(p), k, sp, "a store into it")
    if w.Final { w.orStoreOf(p, x) }
    w.storeWithin = w.withinOf(p)
    # a value of the container's place stays where it was only where it is the container's own value: reached through
    # the very reference the container is (F2) - a place's key names every value of it, each in a region of its own
    w.storeInside = w.insidePlace(p) if w.sameValue(x, p) else -1
    # into an object this body made, held by a local: it now reaches what was stored
    fr := w.freshRoot(p)
    if fr >= 0 { w.give(fr, o) }
    match p {
        case typed.Lvalue.Field(_, _, _, _) {
            if k >= 0 {
                w.store(k, x, o, sp, w.text(p.Span()), fr >= 0)
                w.storeWithin = -1
                w.storeInside = -1
                w.go(k, LAssign, p.Span(), source.Span(0, 0), -1)
                return
            }
            # a struct held in place given another value: its candidate leaves let go of theirs, and are given the
            # value's - which a constructor's own stores account for, and a copy stores elsewhere
            lvs := w.F.leaves(p.Type())
            for lf in lvs { w.go(lf.PlaceId, LLeaf, p.Span(), source.Span(0, 0), -1) }
            if lvs.Len() > 0 and not w.storedWhole(x, cm) { o = w.copyInto(lvs, p.Type(), x, o, sp, cm) }
        }
        case typed.Lvalue.Global(_, _, _, _) {
            if k >= 0 {
                w.store(k, x, o, sp, w.text(p.Span()))
                w.storeWithin = -1
                w.storeInside = -1
                w.go(k, LAssign, p.Span(), source.Span(0, 0), -1)
                return
            }
        }
        case typed.Lvalue.Elem(_, _, _) {
            # an element given a value: never a let-go - the program's own copies between elements are not known
            # positions (2.6 item 7) - but a store into the element place
            if k >= 0 {
                w.store(k, x, o, sp, w.text(p.Span()), fr >= 0)
                w.storeWithin = -1
                w.storeInside = -1
                return
            }
            lvs := w.F.leaves(p.Type())
            if lvs.Len() > 0 and not w.storedWhole(x, cm) { o = w.copyInto(lvs, p.Type(), x, o, sp, cm) }
        }
        case _ { }
    }
    if fr < 0 { w.escape(o, sp, w.text(p.Span()), true, w.withinOf(p), w.storeInside) }
    w.storeWithin = -1
    w.storeInside = -1
}

# a unique value moved out of a parameter (movedPar, no copy cm) stored whole into a struct held in place: the
# parameter's argument is what the place's leaves are given, judged at each call (parWhole, wholeArg)
fn (w mut walker&) storedWhole(x typed.Expr&, cm typed.Expr?&) Bool {
    if cm is not null: return false
    j := w.movedPar(x)
    if j < 0: return false
    if not w.Final and addTo(w.F.parWhole[w.Id], j) > 0 { w.F.changed = true }
    return true
}

# a struct value given to a struct held in place: what it holds beyond its candidate leaves, which the place's own
# leaves now hold. A constructor of the type stores into them itself (its parameters' stores, as for any instance);
# any other value - a copy, a call's result - gives each leaf a value not made for it (condition 1)
fn (w mut walker&) copyInto(lvs Vec<leaf>&, ty types.TypeId, x typed.Expr&, o mut Vec<I64>&, sp source.Span
                            cm typed.Expr?& = null) Vec<I64> {
    f := w.F
    t := w.T()
    if cm is not null {
        w.copyLeaves(lvs, cm, sp)
        return o
    }
    c := typed.Call.Of(x)
    b2 := typed.CalleeBody(c) if c is not null else -1
    if b2 >= 0 and f.Bodies[b2].Root is not null and t.Role(f.Bodies[b2].Ty) == types.RoleCtor and
       t.Results(f.Bodies[b2].Ty).Len() == 1 and t.Same(t.Repr(t.Results(f.Bodies[b2].Ty)[0]), t.Repr(ty)) {
        # (an instance viewing only unique values moved out of parameters holds them whole, no copy: what their leaves
        # are given is judged at the call, by the constructor's parWhole)
        if f.viewsOf(b2) != 0 and not typed.ViewsMoved(c!, f.viewsOf(b2)) { w.viewCtor(lvs, c!, x, sp) }
        out Vec<I64>
        w.quiet++
        args Vec<Vec<I64>>
        for a in c!.Args { args.Push(w.expr(a)) }
        for y in f.resFrom[b2] { f.through(y, args, out) }
        w.quiet--
        return out
    }
    match x {
        case typed.Expr.Lit(_, _, _), typed.Expr.Data(_, _, _, _) { return o }
        case _ { }
    }
    if w.Final and w.quiet == 0 {
        for lf in lvs {
            f.stores.Push(store(lf.PlaceId, w.Id, w.body().File, sp, SFail, -1, -1, x, null))
            f.keep(lf.PlaceId, RMade, w.body().File, sp, $"its new value is existing storage: '" $w.text(x.Span()) "'; give it new storage - a constructor call, '$...', 'Copy()'")
        }
    }
    return o
}

# origins o less the views of (and values moved out of) owner and array places: what a copy leaves behind, owning
# its own copies of those
fn (f mut Free&) unowned(o Vec<I64>&) Vec<I64> {
    out Vec<I64>
    for y in o {
        k := okind(y)
        if (k == OPl or k == OMov) and (f.IsOwner(oval(y)) or f.arr[oval(y)]): continue
        addTo(out, orig(OParC, oval(y)) if k == OPar else y)
    }
    return out
}

# a callee's origin y given its call's arguments' origins: a parameter's what its argument refers into (a copy of one,
# what the argument refers into but its owned parts), anything else itself
fn (f mut Free&) through(y I64, args Vec<Vec<I64>>&, out mut Vec<I64>&) {
    k := okind(y)
    j := oval(y)
    if k != OPar and k != OParC {
        addTo(out, y)
        return
    }
    if j >= args.Len(): return
    addAllTo(out, args[j] if k == OPar else f.unowned(args[j]))
}

# Part C: the copy of a value handed on (QCE's ownCopy, check.storeOver's held copy) a store into a part held in place
# is given, -1 / null for any other value: only where that part's type has candidate leaves and no place of its own
fn (w mut walker&) copyStored(p typed.Lvalue&, x typed.Expr&) typed.Expr?& {
    match p {
        case typed.Lvalue.Field(_, _, _, _), typed.Lvalue.Elem(_, _, _) { }
        case _ { return null }
    }
    if w.F.placeOfPlace(p) >= 0 or w.F.leaves(p.Type()).Len() == 0: return null
    if ownCopySite(x) >= 0: return x
    l := readLocalOf(x)
    if l < 0 or not w.heldCopy.Has(l): return null
    return w.heldCopy.Get(l)!
}

# the site of a copy check.ownCopy makes (a Make of kind Copy, built where its site says), -1 for anything else
fn ownCopySite(x typed.Expr&) I64 {
    return match x {
        case typed.Expr.Make(_, _, m): I64(m.Site) if m.Kind == typed.MakeKind.Copy else -1
        case _: -1
    }
}

# a copy made right at a store into a struct or an element held in place (copyStored): it builds what the value owns
# anew where its site says - made for the one owner or array leaf there is, in a region of its own; with several, one
# region would hold them all, so none is made for any. A leaf of another kind (a reference the copy shares) is given
# existing storage
fn (w mut walker&) copyLeaves(lvs Vec<leaf>&, cm typed.Expr&, sp source.Span) {
    f := w.F
    if not w.Final or w.quiet > 0 { return }
    owners Vec<I64>
    for lf in lvs {
        if f.IsOwner(lf.PlaceId) or f.arr[lf.PlaceId]: owners.Push(lf.PlaceId)
    }
    site := ownCopySite(cm)
    one := owners.Len() == 1 and site >= 0 and f.splitLeaf(w.Id, site, cm.Type(), lvs, owners[0])
    for lf in lvs {
        k := lf.PlaceId
        if owners.Has(k) {
            f.stores.Push(store(k, w.Id, w.body().File, sp, SFresh if one else SFail, -1, site if one else -1, cm, null))
            if not one: f.keep(k, RMade, w.body().File, sp, $"its new value is a copy holding other owners too: '" $w.text(cm.Span()) "'")
            continue
        }
        f.stores.Push(store(k, w.Id, w.body().File, sp, SFail, -1, -1, cm, null))
        f.keep(k, RMade, w.body().File, sp, $"its new value is existing storage a copy shares: '" $w.text(cm.Span()) "'")
    }
}

# whether owner leaf k (one of lvs) is all the storage a value of struct type ty owns: no other part it holds by value
# owns any - a copy of the value builds every owned part where the leaf's region is, so a part owning storage beside
# it (a Map entry's key text beside its Vec value) would be released with the leaf's old value
fn (f mut Free&) onlyLeaf(ty types.TypeId, lvs Vec<leaf>&, k I64) Bool {
    for lf in lvs {
        if lf.PlaceId == k: return f.onlyPath(ty, lf.Path, 0)
    }
    return false
}

# whether a copy of a value of struct type ty made at site of body b can be the new value of owner leaf k (one of lvs):
# where the leaf is all the storage the value owns (onlyLeaf), the copy is built in the leaf's region whole; else, where
# the structs on the leaf's path declare no Copy, the copy is split (SplitPath) - the leaf's part built in the region,
# every other part owning storage where the region's parent is, so a Map entry's key text is never released with the
# value beside it, and the value is
fn (f mut Free&) splitLeaf(b I64, site I64, ty types.TypeId, lvs Vec<leaf>&, k I64) Bool {
    if f.onlyLeaf(ty, lvs, k): return true
    for lf in lvs {
        if lf.PlaceId != k: continue
        if not f.splitPath(ty, lf.Path, 0): return false
        f.splitAt.Put(pair.Pair(b, site), lf.Path)
        return true
    }
    return false
}

fn (f mut Free&) splitPath(ty types.TypeId, path Array<I64>&, depth I64) Bool {
    t := f.T()
    r := t.Plain(t.Repr(ty))
    if depth >= path.Len() or t.KindOf(r) != types.Kind.Named or not t.HasBody(r) or t.DeclKindOf(t.DeclOf(r)) != types.DeclKind.Struct: return false
    if t.DeclaresCopy(r): return false
    fs := t.Items(t.Fields(r))
    if path[depth] >= fs.Len(): return false
    return depth + 1 >= path.Len() or f.splitPath(fs[path[depth]], path, depth + 1)
}

fn (f mut Free&) onlyPath(ty types.TypeId, path Array<I64>&, depth I64) Bool {
    t := f.T()
    r := t.Plain(t.Repr(ty))
    if depth >= path.Len() or t.KindOf(r) != types.Kind.Named or not t.HasBody(r) or t.DeclKindOf(t.DeclOf(r)) != types.DeclKind.Struct: return false
    fs := t.Items(t.Fields(r))
    for i in range fs.Len() {
        if i == path[depth] {
            if depth + 1 < path.Len() and not f.onlyPath(fs[i], path, depth + 1): return false
            continue
        }
        if t.IsRef(fs[i]): continue
        if t.OwnedPart(fs[i]) or t.OwnsParts(fs[i]): return false
    }
    return true
}

# a constructor handing back views of what it is given, its instance stored into a struct held in place: the copy its
# caller makes (D9h) is the owner leaves' new value, built where the call's value lands - made for the one owner leaf
# there is, in a region of its own; with several, one region would hold them all, so none is made for any. Its array
# leaves are given that copy's arrays too: recorded as values not made for them, so such a place keeps (it had no store
# said for them at all - a sole place's let-go would have released storage outside any region; round sec8r2, from the
# drop-order round's notes: "when in doubt, keep")
fn (w mut walker&) viewCtor(lvs Vec<leaf>&, c typed.Call&, x typed.Expr&, sp source.Span) {
    f := w.F
    if not w.Final or w.quiet > 0 { return }
    owners Vec<I64>
    for lf in lvs {
        if f.IsOwner(lf.PlaceId): owners.Push(lf.PlaceId)
        if f.arr[lf.PlaceId] and not f.IsOwner(lf.PlaceId) {
            f.stores.Push(store(lf.PlaceId, w.Id, w.body().File, sp, SFail, -1, -1, x, null))
            f.keep(lf.PlaceId, RMade, w.body().File, sp, $"its new value is a copy of what a constructor is given: '" $w.text(x.Span()) "'")
        }
    }
    if owners.Len() == 0 { return }
    one := owners.Len() == 1 and c.Site >= typed.SiteId(0) and f.splitLeaf(w.Id, I64(c.Site), x.Type(), lvs, owners[0])
    for k in owners {
        f.stores.Push(store(k, w.Id, w.body().File, sp, SFresh if one else SFail, -1, I64(c.Site) if one else -1, x, null))
        if not one: f.keep(k, RMade, w.body().File, sp, $"its new value is a copy of what a constructor is given, which holds other owners too: '" $w.text(x.Span()) "'")
    }
}

# the local holding the object a place is part of, where every value it holds is an object this body made - -1 for
# none
fn (w mut walker&) freshRoot(p typed.Lvalue&) I64 {
    l := -1
    match p {
        case typed.Lvalue.Local(_, _, id) { l = I64(id) }
        case typed.Lvalue.Field(_, _, b, _) { return w.freshRoot(b) }
        case typed.Lvalue.Elem(_, _, e) { return w.freshRoot(e.Base) }
        case typed.Lvalue.Payload(_, _, pl) { return w.freshRoot(pl.Base) }
        case typed.Lvalue.Deref(_, _, typed.Expr.Read(_, _, typed.Lvalue.Local(_, _, id), _)) { l = I64(id) }
        case typed.Lvalue.Deref(_, _, _) { return -1 }
        case _ { return -1 }
    }
    if w.params.Has(l) or w.fields.Has(l) { return -1 }
    fl := w.F.freshLocals[w.Id]
    return l if l < fl.Len() and fl[l] else -1
}

# the parameter every storage a place's container is reached through is reached from, -1 for none (a must-fact)
fn (w mut walker&) withinOf(p typed.Lvalue&) I64 {
    b := baseOf(p)
    if b is null { return -1 }
    v := w.F.withinPlace(w.Id, b)
    return v if v >= 0 and v < MovBase else -1
}

# the place every value a place's container is reached through is a value of, -1 for none (a must-fact)
fn (w mut walker&) insidePlace(p typed.Lvalue&) I64 {
    r := derefRoot(p)
    if r is null { return -1 }
    return w.rootPlace(r)
}

# whether a value stored into place p is reached through the reference p's container is reached through - the same
# value, read in one statement with nothing evaluated on the way that could change either (pure paths)
fn (w mut walker&) sameValue(x typed.Expr&, p typed.Lvalue&) Bool {
    r := derefRoot(p)
    if r is null { return false }
    return reachedThrough(x, r)
}

# whether a value is the reference r, or reached through it, by a pure path
fn reachedThrough(x typed.Expr&, r typed.Expr&) Bool {
    if samePure(x, r) { return true }
    return match x {
        case typed.Expr.Read(_, _, p, _): placeThrough(p, r)
        case typed.Expr.Borrow(_, _, p): placeThrough(p, r)
        case typed.Expr.Away(_, _, y): reachedThrough(y, r)
        case typed.Expr.Prim(_, _, op, _, args): isConversion(op, args) and reachedThrough(args[0], r)
        case _: false
    }
}

fn placeThrough(p typed.Lvalue&, r typed.Expr&) Bool {
    return match p {
        case typed.Lvalue.Deref(_, _, e): reachedThrough(e, r)
        case typed.Lvalue.Field(_, _, b, _): placeThrough(b, r)
        case typed.Lvalue.Elem(_, _, e): pureIndex(e.Index) and placeThrough(e.Base, r)
        case typed.Lvalue.Payload(_, _, pl): placeThrough(pl.Base, r)
        case _: false
    }
}

# whether two expressions are one pure read: the same local, the same fields of it, through the same references
fn samePure(a typed.Expr&, b typed.Expr&) Bool {
    return match a {
        case typed.Expr.Read(_, _, p, _): match b {
            case typed.Expr.Read(_, _, q, _): samePurePlace(p, q)
            case _: false
        }
        case _: false
    }
}

fn samePurePlace(p typed.Lvalue&, q typed.Lvalue&) Bool {
    match p {
        case typed.Lvalue.Local(_, _, l) {
            match q {
                case typed.Lvalue.Local(_, _, m) { return l == m }
                case _ { return false }
            }
        }
        case typed.Lvalue.Field(_, _, b, i) {
            match q {
                case typed.Lvalue.Field(_, _, c, j) { return i == j and samePurePlace(b, c) }
                case _ { return false }
            }
        }
        case typed.Lvalue.Deref(_, _, r) {
            match q {
                case typed.Lvalue.Deref(_, _, s) { return samePure(r, s) }
                case _ { return false }
            }
        }
        case _ { return false }
    }
}

# an index that evaluates nothing: a literal or a local read
fn pureIndex(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Lit(_, _, _): true
        case typed.Expr.Read(_, _, p, _): match p {
            case typed.Lvalue.Local(_, _, _): true
            case _: false
        }
        case typed.Expr.Away(_, _, y): pureIndex(y)
        case _: false
    }
}

# the place holding a field or an element: its container
fn baseOf(p typed.Lvalue&) typed.Lvalue?& {
    return match p {
        case typed.Lvalue.Field(_, _, b, _): b
        case typed.Lvalue.Elem(_, _, e): e.Base
        case typed.Lvalue.Payload(_, _, pl): pl.Base
        case _: null
    }
}

# a statement's value dropped: a vacate statement lets go of the place, a moved value dropped is let go of here
fn (w mut walker&) eval(sp source.Span, x typed.Expr&) {
    o := w.expr(x)
    match x {
        case typed.Expr.Prim(_, _, _, _, _) {
            return
        }
        case typed.Expr.Take(_, ty, p) {
            k := w.F.placeOfPlace(p)
            if k >= 0 {
                w.go(k, LVacate, p.Span(), source.Span(0, 0), -1)
            } else {
                for lf in w.F.leaves(ty) { w.go(lf.PlaceId, LVacate, p.Span(), source.Span(0, 0), -1) }
            }
            return
        }
        case _ { }
    }
    c := typed.Call.Of(x)
    if c is not null {
        for y in o {
            if okind(y) == OMov { w.go(oval(y), LDrop, x.Span(), receiverSpan(c), typed.CalleeBody(c)) }
        }
    }
}

# the call an expression is, under a try, null for none
# an array place's elements hold no reference and own nothing (arrayCand): none can reach into an array's own region
fn (f mut Free&) plainElems(k I64) Bool {
    t := f.T()
    el := t.Elem(t.Repr(f.valTy[k]))
    return not t.HoldsRefs(el) and not t.OwnsParts(el)
}

# whether a value made for an array place is a comprehension each of whose elements is one already there - moved or
# read out of other storage (grown()'s), never one built with it in its region: so no element of an array place's
# value reaches into that value's region, which is why an element read out of one is no view of it (elemRead)
fn movesOnly(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Collect(_, _, c): yieldsMoved(c.Loop)
        case typed.Expr.Seq(_, _, q): q.X is not null and movesOnly(q.X!)
        case typed.Expr.Away(_, _, y): movesOnly(y)
        case _: false
    }
}

fn yieldsMoved(b typed.Block&) Bool {
    for st in b.Stmts {
        if not stmtMoves(st): return false
    }
    return true
}

fn stmtMoves(st typed.Stmt&) Bool {
    return match st {
        case typed.Stmt.Yield(_, x): match x {
            case typed.Expr.Take(_, _, _), typed.Expr.Read(_, _, _, _): true
            case _: false
        }
        case typed.Stmt.Loop(_, body, post): yieldsMoved(body) and (post is null or yieldsMoved(post))
        case typed.Stmt.Block(_, b): yieldsMoved(b)
        case typed.Stmt.If(_, i): yieldsMoved(i.Then) and (i.Else is null or yieldsMoved(i.Else!))
        case _: true
    }
}

# whether a place is part of an element of an array, read by value: through fields and payloads of an element
fn inElement(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Elem(_, _, _): true
        case typed.Lvalue.Field(_, _, b, _): inElement(b)
        case typed.Lvalue.Payload(_, _, pl): inElement(pl.Base)
        case _: false
    }
}

# what an element read out of an array place's value by value may refer into: not that value's region, which holds
# none of what its elements reach (movesOnly) - so its place is dropped from the origins
fn (w mut walker&) elemRead(p typed.Lvalue&, o mut Vec<I64>&) {
    if not inElement(p) { return }
    f := w.F
    n := 0
    for i in range o.Len() {
        if okind(o[i]) == OPl and f.arr[oval(o[i])]: continue
        o[n] = o[i]
        n++
    }
    o.Truncate(n)
}

# whether a value stored whole is existing storage, which a store of a value array copies (T7b)
fn copiedStore(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Read(_, _, _, _), typed.Expr.Slice(_, _, _): true
        case typed.Expr.Cond(_, _, k): (k.A is not null and copiedStore(k.A!)) or copiedStore(k.B)
        case typed.Expr.Away(_, _, y): copiedStore(y)
        case _: false
    }
}

# a let-go event: place k let go of by the statement being walked - by an assignment or a vacate of it, a moved value
# dropped, or a call
fn (w mut walker&) go(k I64, kind I64, sp source.Span, recv source.Span, callee I64) {
    f := w.F
    if not w.Final {
        # a body that may let go of any place lists none
        if k >= 0 and not f.letsAll[w.Id] and addTo(f.lets[w.Id], k) > 0 { f.changed = true }
        return
    }
    if w.quiet > 0 { return }
    w.goPlace.Push(k)
    w.goAt.Push(w.cur)
    w.goEnd.Push(w.deferStack[w.deferStack.Len() - 1] if kind == LHeld and w.deferStack.Len() > 0 else -1)
    w.goKind.Push(kind)
    w.goSp.Push(sp)
    w.goRecv.Push(recv)
    w.goCallee.Push(callee)
    # a call's let-go in the library's code is only this body's views' business: the report and condition 5 read
    # the rest - and so is a yield's, which is no let-go of the generator's own
    if kind == LYield or (kind == LCall and not f.programCode[w.Id]) {
        w.goIdx.Push(-1)
        return
    }
    w.goIdx.Push(f.goes.Len())
    f.goes.Push(letGo(k, w.Id, w.body().File, w.stmtSp, sp, kind, recv, callee, w.loops > 0 or w.runsAgain()))
}

# whether the body can run more than once: any function but main - not a global's initializer, a test, a contract's
# condition run with its function
fn (w mut walker&) runsAgain() Bool {
    return match w.body().Of {
        case typed.BodyOf.Global(_, _), typed.BodyOf.Test(_): false
        case typed.BodyOf.Fn(i): not w.F.P.IsEntry(w.F.P.InstanceFn(i))
        case _: true
    }
}

# a constructor's field given a value: a store into the field's place, or the instance holding what it is given
fn (w mut walker&) storeField(k I64, x typed.Expr&, o Vec<I64>&, sp source.Span) {
    pk := w.F.placeKey(w.ctorTy, k)
    if pk >= 0 {
        w.store(pk, x, o, sp, "")
        return
    }
    # held by the instance, which is what the constructor gives: its result's origins, but for what is new
    if not w.Final {
        for y in o {
            if okind(y) != ONew and addTo(w.F.resFrom[w.Id], y) > 0 { w.F.changed = true }
        }
    }
}

# a value stored somewhere a view of a place must not go: each place it may refer into keeps (condition 2); a
# parameter's value stored so is kept by the body (parEsc). What is stored into storage reached through the parameter
# itself, or through a value of the place itself, stays where it was (inside, j and q - -1 for none, must-facts)
fn (w mut walker&) escape(o Vec<I64>&, sp source.Span, where String&, heap Bool, inside I64 = -1, q I64 = -1) {
    f := w.F
    for y in o {
        k := okind(y)
        if k == OParC and not w.Final and oval(y) != inside and addTo(f.parEscC[w.Id], oval(y)) > 0 { f.changed = true }
        if k == OPar and not w.Final and oval(y) != inside {
            if addTo(f.parEsc[w.Id], oval(y)) > 0 {
                f.changed = true
                if f.Debug { try io.PrintErr($"esc " $f.fnName(w.Id) " par " $oval(y) " at " $f.P.L.Diags.Locate(w.body().File, I64(sp.Start)) " inside " $inside "\n") catch io.Error { } }
            }
        }
        if k == OPl and w.Final and oval(y) != q {
            f.keep(oval(y), RStore, w.body().File, sp, $"a reference into it is stored here, in '" $where "'; store a copy, '$(...)'" if where != "" else "a reference into it is kept here")
        }
    }
}

# a value stored into candidate place k, its origins o
fn (w mut walker&) store(k I64, x typed.Expr&, o Vec<I64>&, sp source.Span, where String&, contained Bool = false) {
    w.storeAs(k, x, o, sp, where, false, contained)
}

# the parameter a value is, read whole, -1 for none
fn (w mut walker&) paramOf(x typed.Expr&) I64 {
    return match x {
        case typed.Expr.Read(_, _, p, _): match p {
            case typed.Lvalue.Local(_, _, l): try w.params.Get(I64(l)) catch default w.movedPar(x)
            case _: -1
        }
        case typed.Expr.Away(_, _, y): w.paramOf(y)
        case _: w.movedPar(x)
    }
}

# T13b, O8d: the parameter whose unique value x is, handed on - moved (check.handOn's Gone Seq around the parameter's
# read), or held by a hidden local it was moved into (heldPar) - -1 for anything else. Its owned parts are where the
# caller built them (section 8's obligation on the parameter), and nothing reads the parameter after
fn (w mut walker&) movedPar(x typed.Expr&) I64 {
    match x {
        case typed.Expr.Seq(_, _, q) {
            if not q.Gone or q.X is null: return -1
            y := q.X!
            j := try w.params.Get(readLocalOf(y)) catch default -1
            if j < 0 or w.T().IsRef(y.Type()) or not w.T().Unique(y.Type()): return -1
            return j
        }
        case typed.Expr.Read(_, _, p, _) {
            if p != typed.Lvalue.Local: return -1
            return try w.heldPar.Get(I64(p.id)) catch default -1
        }
        case typed.Expr.Away(_, _, y) { return w.movedPar(y) }
        case _ { return -1 }
    }
}

# a constructor's field k given parameter j's unique value moved whole (movedPar), a struct holding candidate leaves
# and no place of its own: the instance holds what the argument's leaves hold - judged at each call (wholeArg)
fn (w mut walker&) wholeField(k I64, x typed.Expr&) {
    j := w.movedPar(x)
    if j < 0 or w.Final or w.F.placeKey(w.ctorTy, k) >= 0 or w.F.leaves(x.Type()).Len() == 0: return
    if addTo(w.F.parWhole[w.Id], j) > 0 { w.F.changed = true }
}

# argument a of a call whose callee moves its unique value whole into leaves (parWhole), its origins o: the caller's
# own moved parameter passes the requirement on; anything else is judged as the value of a struct held in place is
# (copyInto) - a constructor of its type stores into its leaves itself, any other value gives them one not made for them
fn (w mut walker&) wholeArg(a typed.Expr&, o Vec<I64>&, sp source.Span) {
    f := w.F
    j := w.movedPar(a)
    if j >= 0 {
        if not w.Final and addTo(f.parWhole[w.Id], j) > 0 { f.changed = true }
        return
    }
    lvs := f.leaves(a.Type())
    if lvs.Len() == 0 { return }
    cm := a if ownCopySite(a) >= 0 else null
    oo Vec<I64> = o
    w.copyInto(lvs, a.Type(), a, oo, sp, cm)
}

# ---- what a value may refer into ----

# a local read: what it may refer into, and - for a constructor's field - the field's own place
fn (w mut walker&) use(l I64, sp source.Span) {
    if w.quiet > 0 { return }
    w.useLocal.Push(l)
    w.useAt.Push(w.cur)
    w.useSp.Push(sp)
    if w.inDefer > 0 { w.deferred.Push(l) }
}

# a view read: a value of place k (or moved out of it) read in the statement being walked
fn (w mut walker&) viewRead(o Vec<I64>&) {
    if not w.Final or w.quiet > 0 or w.handing > 0 { return }
    for y in o {
        k := okind(y)
        if k == OPl or k == OMov {
            w.readPlace.Push(oval(y))
            w.readAt.Push(w.cur)
        }
    }
}

# what the storage of a place is part of: the origins of the value or reference it is reached through, and - where a
# candidate place is passed through on the way - that place's own value (a field of what it holds is a view of it)
fn (w mut walker&) reach(p typed.Lvalue&) Vec<I64> {
    f := w.F
    match p {
        case typed.Lvalue.Local(lsp, _, l) {
            w.use(I64(l), lsp)
            o Vec<I64>
            addAllTo(o, w.origins[I64(l)])
            w.seen[I64(l)] = true
            k := try w.fields.Get(I64(l)) catch default -1
            if k >= 0 {
                pk := f.placeKey(w.ctorTy, k)
                if pk >= 0: addTo(o, orig(OPl, pk))
            }
            # (an owner local's value is its place's - and a feeder's the place's it is built for)
            ol := w.ownLocal(I64(l))
            if ol >= 0: addTo(o, orig(OPl, ol))
            fd := w.feeder(I64(l))
            if fd >= 0: addTo(o, orig(OPl, w.F.feeds[fd].PlaceId))
            return o
        }
        case typed.Lvalue.Deref(_, _, r) { return w.expr(r) }
        case typed.Lvalue.Field(_, _, base, i) {
            o := w.reach(base)
            k := f.placeKey(base.Type(), i)
            if k >= 0: addTo(o, orig(OPl, k))
            return o
        }
        case typed.Lvalue.Elem(_, _, e) {
            o := w.reach(e.Base)
            w.expr(e.Index)
            k := f.placeKey(f.arrayOf(e.Base.Type()), -1)
            if k >= 0: addTo(o, orig(OPl, k))
            return o
        }
        case typed.Lvalue.Payload(_, _, pl) { return w.reach(pl.Base) }
        case typed.Lvalue.Temp(_, _, v, _) { return w.expr(v) }
        case typed.Lvalue.Target(_, _) {
            o Vec<I64>
            if w.targets.Len() > 0 {
                w.quiet++
                o = w.reach(w.targets[w.targets.Len() - 1])
                w.quiet--
            }
            return o
        }
        case _ { return Vec<I64>() }
    }
}

# what the storage holding a place is part of - its container's reach, without the place itself: what is moved out of
# a place is no longer a value of it
fn (w mut walker&) reachTo(p typed.Lvalue&) Vec<I64> {
    match p {
        case typed.Lvalue.Field(_, _, base, _) { return w.reach(base) }
        case typed.Lvalue.Elem(_, _, e) {
            o := w.reach(e.Base)
            w.expr(e.Index)
            return o
        }
        case _ { return w.reach(p) }
    }
}

# a place's value read: what its storage is part of, its own value a view of the place, and the candidate places a
# struct held in place copies with it
fn (w mut walker&) readOf(p typed.Lvalue&, ty types.TypeId) Vec<I64> {
    f := w.F
    if p == typed.Lvalue.Local and I64(p.id) != w.copyRead and w.heldCopy.Has(I64(p.id)) { w.untracked(ty, p.Span(), "a copy of a value holding it") }
    o := w.reach(p)
    w.elemRead(p, o)
    k := f.placeOfPlace(p)
    if k >= 0 {
        addTo(o, orig(OPl, k))
    } else if not w.movedRead(p, ty) {
        for lf in f.leaves(ty) { addTo(o, orig(OPl, lf.PlaceId)) }
    }
    if w.holds(ty) { w.viewRead(o) }
    return o
}

# whether reading p reads a unique value moved whole out of a parameter (T13b's hand-on, movedPar) - the value itself,
# moved on, no view of the leaves it holds
fn (w mut walker&) movedRead(p typed.Lvalue&, ty types.TypeId) Bool {
    if p != typed.Lvalue.Local or w.T().IsRef(ty) or not w.T().Unique(ty): return false
    l := I64(p.id)
    return w.heldPar.Has(l) or (w.handing > 0 and w.params.Has(l))
}

# a place's storage borrowed: what it is part of - the places passed through on the way, read - but not the places a
# struct held there holds: a reference to the container reaches their current values, never an old one
fn (w mut walker&) borrowOf(p typed.Lvalue&) Vec<I64> {
    f := w.F
    k := f.placeOfPlace(p)
    if k >= 0 { return w.readOf(p, p.Type()) }
    o := w.reach(p)
    w.viewRead(o)
    return o
}

# a place vacated: its value moved out - no longer a view of the place, a value moved out of it
fn (w mut walker&) takeOf(p typed.Lvalue&, ty types.TypeId) Vec<I64> {
    f := w.F
    o := w.reachTo(p)
    w.elemRead(p, o)
    k := f.placeOfPlace(p)
    lib := not f.programCode[w.Id]
    if k >= 0 {
        addTo(o, orig(OMov, k))
        if lib: f.libTaken[k] = true
    } else {
        for lf in f.leaves(ty) {
            addTo(o, orig(OMov, lf.PlaceId))
            if lib: f.libTaken[lf.PlaceId] = true
        }
    }
    return o
}

# lambda lb made here: this body walked again when its summary changes, and registering where it does
fn (w mut walker&) lambdaMade(lb typed.BodyId) {
    addTo(w.F.callers[I64(lb)], w.Id)
    if w.F.regOut[I64(lb)] { w.F.setRegOut(w.Id) }
}

# what a lambda made at sp captures (x): escaping into it
fn (w mut walker&) captured(sp source.Span, x typed.Expr&) Vec<I64> {
    o := w.expr(x)
    w.escape(o, sp, "", false)
    return o
}

fn (w mut walker&) expr(x typed.Expr&) Vec<I64> {
    out Vec<I64>
    match x {
        case typed.Expr.Read(_, ty, p, _) { out = w.readOf(p, ty) }
        case typed.Expr.Borrow(_, _, p) { out = w.borrowOf(p) }
        case typed.Expr.Take(_, ty, p) { out = w.takeOf(p, ty) }
        case typed.Expr.Promote(_, pty, pr) {
            # (Part C: a value with destructors to run given storage here is registered there, O16)
            dtor := w.T().IsRef(pty) and w.T().NeedsDrop(w.T().Referent(pty))
            if dtor: w.registeredAt(pr.Site, w.T().Referent(pty))
            out = w.expr(pr.X)
            # (a value moved out of a place held so is ended where the scope closes, which releases nothing of it: the
            # place keeps, its values never built in regions no release would reach)
            if dtor and w.Final {
                for y in out {
                    if okind(y) == OMov: w.F.keep(oval(y), RMade, w.body().File, pr.X.Span(), $"a value moved out of it is held where its call lands (O16), where nothing releases it: '" $w.text(pr.X.Span()) "'")
                }
            }
            addTo(out, orig(ONew, I64(pr.Site)))
            if not w.Final and w.F.destructs(pty) and isVar(w.F.Plans[w.Id].Built[I64(pr.Site)]) { w.F.setRegOut(w.Id) }
        }
        case typed.Expr.Call(sp, ty, c) { out = w.call(c, ty, sp) }
        case typed.Expr.Make(sp, ty, m) {
            # a prelude fill's value is in positions the collection never reads (makeStores): no part of the array
            dead := m.Kind == typed.MakeKind.Fill and w.F.prelude[w.Id]
            for it in m.Items {
                o := w.expr(it)
                if not dead: addAllTo(out, o)
            }
            if m.Length is not null { w.expr(m.Length!) }
            if m.Site >= typed.SiteId(0) { addTo(out, orig(ONew, I64(m.Site))) }
            # (a copy makes what it owns anew, deep through values: no view of the source's owner or array leaves)
            if m.Kind == typed.MakeKind.Copy { out = w.F.unowned(out) }
            exempt := m.Kind == typed.MakeKind.Copy and w.copyExempt >= 0 and I64(m.Site) == w.copyExempt
            if (m.Kind == typed.MakeKind.Copy or m.Kind == typed.MakeKind.Fill) and not exempt { w.untracked(ty, sp, "a copy of a value holding it") }
            w.makeStores(m, ty, sp)
        }
        case typed.Expr.Collect(_, ty, c) {
            if c.Reserve is not null { w.expr(c.Reserve!) }
            w.yieldTo.Push(w.F.placeKey(w.F.arrayOf(ty), -1))
            w.yieldOrig.Push(Vec<I64>())
            w.block(c.Loop)
            try w.yieldTo.Pop() catch { }
            ys := try w.yieldOrig.Pop() catch default Vec<I64>()
            addAllTo(out, ys)
            addTo(out, orig(ONew, I64(c.Site)))
        }
        case typed.Expr.Prim(psp, _, op, _, args) {
            # the prelude's retire() of the array a collection replaced: no use of it - where its place is sole the
            # array is released as it is replaced and the retire() left out (rmRetire)
            l := readLocalOf(args[0]) if op == typed.PrimOp.Retire and args.Len() == 1 else -1
            hd := w.heldDrop(op, args)
            if hd >= 0 {
                # Part C: a holder's drop where its block is left (O15) - no use of it, its destructors walked as calls,
                # and its leaves let go there (lowering releases what they hold once the destructors ran)
                w.dtorCalls(psp, args[0])
                for lf in w.F.leaves(w.body().Locals[hd].Ty) { w.go(lf.PlaceId, LHeld, psp, source.Span(0, 0), -1) }
                return out
            }
            if l >= 0 {
                if w.Final {
                    o Vec<I64> = w.origins[l]
                    w.F.retires.Push(retire(w.Id, psp, o))
                }
            } else {
                for a in args { addAllTo(out, w.expr(a)) }
            }
            if op == typed.PrimOp.Drop and args.Len() == 1 { w.dtorCalls(psp, args[0]) }
        }
        case typed.Expr.Slice(_, _, s) {
            out = w.readOf(s.Base, s.Base.Type())
            w.expr(s.Lo)
            w.expr(s.Hi)
        }
        case typed.Expr.Cond(_, _, c) {
            w.expr(c.C)
            if c.A is not null { addAllTo(out, w.expr(c.A!)) }
            addAllTo(out, w.expr(c.B))
        }
        case typed.Expr.Seq(_, _, q) {
            for st in q.Stmts { w.stmt(st) }
            # (Part C: a unique value handed on - T13b, O15 - is the callee's from here, moved: the caller holds no view of
            # it in use during the call)
            if q.Gone: w.handing++
            if q.X is not null { out = w.expr(q.X!) }
            if q.Gone: w.handing--
        }
        case typed.Expr.Match(_, _, m) {
            for st in m.Held { w.stmt(st) }
            for a in m.Arms { addAllTo(out, w.arm(a)) }
            if m.NoMatch is not null { addAllTo(out, w.arm(m.NoMatch!)) }
        }
        case typed.Expr.Try(_, _, t) {
            if t.X is not null { out = w.expr(t.X!) }
            for c in t.Clauses {
                if c.Code is not null { w.block(c.Code!) }
                for d in c.Defaults { addAllTo(out, w.expr(d)) }
            }
        }
        case typed.Expr.Fn(sp, _, fv) {
            match fv {
                case typed.FnVal.Lambda(lb, caps, site) {
                    # a lambda that may register in what it captured: its maker may, where it is called is not known
                    if not w.Final { w.lambdaMade(lb) }
                    for c in caps { addAllTo(out, w.captured(sp, c.Outer)) }
                    addTo(out, orig(ONew, I64(site)))
                }
                case typed.FnVal.Named(b) { w.F.named[I64(b)] = true }
                case typed.FnVal.Adapter(_, r, site) {
                    if not w.Final { w.F.setRegOut(w.Id) }
                    o := w.expr(r)
                    w.escape(o, sp, "", false)
                    addAllTo(out, o)
                    addTo(out, orig(ONew, I64(site)))
                }
                case _ { }
            }
        }
        case typed.Expr.Text(_, _, tx) {
            for pc in tx.Pieces {
                match pc {
                    case typed.Piece.Render(r) { w.expr(r) }
                    case _ { }
                }
            }
            addTo(out, orig(ONew, I64(tx.Site)))
        }
        case typed.Expr.Away(_, _, y) { out = w.expr(y) }
        case _ { }
    }
    if not w.holds(x.Type()) { return Vec<I64>() }
    return out
}

fn (w mut walker&) arm(a typed.Arm&) Vec<I64> {
    out Vec<I64>
    for alt in a.Alts {
        w.expr(alt.Test)
        for bd in alt.Binds {
            w.give(I64(bd.To), w.expr(bd.From))
        }
    }
    if a.Guard is not null { w.expr(a.Guard!) }
    if a.Code is not null { w.block(a.Code!) }
    if a.Value is not null { out = w.expr(a.Value!) }
    return out
}

# an array literal's items or a fill's value stored into the array's element place - none for the prelude's fills,
# whose positions past what a collection holds are never read (3.4: the prelude says what it lets go of)
fn (w mut walker&) makeStores(m typed.Make&, ty types.TypeId, sp source.Span) {
    f := w.F
    if m.Kind != typed.MakeKind.Array and m.Kind != typed.MakeKind.Fill { return }
    e := f.placeKey(f.arrayOf(ty), -1)
    if e < 0 { return }
    if m.Kind == typed.MakeKind.Fill {
        if f.prelude[w.Id] { return }
        for it in m.Items { w.storeOne(e, it, sp, true) }
        return
    }
    for it in m.Items { w.storeOne(e, it, sp, false) }
}

# a value stored into place k with what it refers into found again (quietly: its events were counted)
fn (w mut walker&) storeOne(k I64, x typed.Expr&, sp source.Span, multi Bool) {
    w.quiet++
    o := w.expr(x)
    w.quiet--
    w.storeAs(k, x, o, sp, "", multi)
}

# a call: its arguments' origins, what the callee stores, keeps and lets go of, and what its result may refer into
fn (w mut walker&) call(c typed.Call&, ty types.TypeId, sp source.Span) Vec<I64> {
    f := w.F
    out Vec<I64>
    b2 := -1
    unknown := true
    helper := false
    foreign := false
    calls := false      # (a C function that may call an export fn back)
    match c.Target {
        case typed.Callee.Body(id) {
            b2 = I64(id)
            unknown = f.Bodies[b2].Root is null and not f.isCase(b2)
            if not w.Final { addTo(f.callers[b2], w.Id) }
            # what the callee registers in its scope variables lands where this call passes them: one of this body's
            if not w.Final and (unknown or f.regOut[b2]) and f.passesVar(w.Id, c, b2) { f.setRegOut(w.Id) }
        }
        case typed.Callee.Value(v) {
            w.expr(v)
            if not w.Final { f.setRegOut(w.Id) }
        }
        case typed.Callee.Dispatch(_, _, _) { if not w.Final { f.setRegOut(w.Id) } }
        case typed.Callee.Helper(_, _) { helper = true }
        case typed.Callee.Extern(fi) {
            foreign = true
            # (the runtime's own and the C library's input and output, text, memory and time functions call nothing back)
            nm := f.P.L.Names.Text(f.P.FnDecl(fi).Name)
            calls = not nm.StartsWith("__olang_") and not typed.NoCallbackExtern(nm)
        }
        case _ { }
    }
    args Vec<Vec<I64>>
    for j in range c.Args.Len() {
        a := c.Args[j]
        o := w.expr(a)
        # (a feeder handed to a call the body of which is known: what it builds there is built in its region - feedFits)
        fd := w.feederArg(a) if b2 >= 0 and not unknown and c.Site >= typed.SiteId(0) else -1
        wr := w.writable(a.Type())
        if fd >= 0 and w.Final and w.quiet == 0 { w.F.feedCalls.Push(feedCall(w.Id, I64(c.Site), b2, j, fd, wr)) }
        if wr { w.inOwner(o, w.F.feeds[fd].PlaceId if fd >= 0 else -1, sp, "a writable reference to it handed to a call") }
        args.Push(o)
    }
    if w.holds(ty) and c.Site >= typed.SiteId(0) { addTo(out, orig(ONew, I64(c.Site))) }
    # (a callee handing back a view its caller copies where it keeps it (D9h) - but the value of a store, whose copy is
    # made where the place's value is; a callee not known may hand back any copy)
    fresh := b2 >= 0 and not unknown and f.viewsOf(b2) != 0 and f.freshCtor(c, b2, w.Id)
    if fresh and w.Final: f.freshAt.Put(pair.Pair(w.Id, I64(c.Site)), true)
    if (b2 < 0 or unknown or (f.viewsOf(b2) != 0 and not fresh)) and I64(c.Site) != w.exemptSite { w.untracked(ty, sp, "a call's value copied") }
    if b2 >= 0 and not unknown {
        if f.isCase(b2) {
            for a in args { addAllTo(out, a) }
            return out
        }
        for y in f.resFrom[b2] { f.through(y, args, out) }
        # a constructor's stores are into the instance it makes: its candidate leaves hold them - places of their own,
        # wherever the instance goes - so they are no escape of the parameter
        ctor := w.T().Role(f.Bodies[b2].Ty) == types.RoleCtor
        for e in f.parStored[b2] {
            j := e >> 32
            k := e & ((I64(1) << 32) - 1)
            if j < args.Len() {
                multi := f.storedMore(b2, j)
                w.storeAs(k, c.Args[j], args[j], sp, "", multi, ctor)
            }
        }
        for j in f.parWhole[b2] {
            if j < args.Len(): w.wholeArg(c.Args[j], args[j], sp)
        }
        for j in f.parEsc[b2] {
            if j < args.Len(): w.escape(args[j], sp, "", false)
        }
        for j in f.parEscC[b2] {
            if j < args.Len(): w.escape(f.unowned(args[j]), sp, "", false)
        }
        # a callee that may let go of anything is one event for any place
        if f.letsAll[b2] {
            w.goAll(sp, c, b2)
        } else {
            for k in f.lets[b2] { w.go(k, LCall, sp, receiverSpan(c), b2) }
        }
        if w.Final and w.quiet == 0 { w.orCallOf(c, b2) }
        # a view in the result counts as read here
        rv Vec<I64>
        for y in out {
            if okind(y) == OPl: rv.Push(y)
        }
        w.viewRead(rv)
        return out
    }
    # a callee whose body is not known: it may keep what it is given, and - through a function value - let go of
    # anything; a helper only reads (Equal, Hash, Render) or builds (Zero)
    for a in args {
        addAllTo(out, a)
        if not helper: w.escape(a, sp, "", false)
    }
    addTo(out, orig(OUnk, 0))
    if foreign {
        for a in c.Args {
            if w.T().KindOf(w.T().Repr(a.Type())) == types.Kind.Func: f.taskAt[w.Id] = true
        }
        # C may call any export fn (X12) before it returns: where one may let go, the extern call may let go of
        # anything (F6) - walked again when an export fn's summary changes
        lets := false
        for e in f.exports {
            if not calls: break
            if not w.Final { addTo(f.callers[e], w.Id) }
            if f.lets[e].Len() > 0 or f.letsAll[e]: lets = true
        }
        if lets { w.goAll(sp, c, -1) }
    } else if not helper {
        w.goAll(sp, c, -1)
    }
    return out
}

# ---- F4: destructors registered where a value is built ----

fn (f mut Free&) setRegOut(b I64) {
    if f.regOut[b] { return }
    f.regOut[b] = true
    f.changed = true
}

fn isVar(sc typed.Scope) Bool {
    return match sc {
        case typed.Scope.Var(_): true
        case _: false
    }
}

# whether a type is, or is a reference to, one whose values have destructors to run - a struct declaring one, or a value
# holding one by value (O15)
fn (f mut Free&) destructs(ty types.TypeId) Bool {
    t := f.T()
    r := t.Repr(ty)
    if t.IsRef(r) { r = t.Repr(t.Referent(r)) }
    return t.NeedsDrop(r)
}

# whether a call passes one of body b's scope variables for one of its callee's
fn (f mut Free&) passesVar(b I64, c typed.Call&, b2 I64) Bool {
    if c.Site < typed.SiteId(0) { return false }
    pl := f.Plans.Ref(b)
    for i in range f.Bodies[b2].Vars.Len() {
        if isVar(pl.Passed(c.Site, i)) { return true }
    }
    return false
}

# whether building a value - its site and its parts, which a region made for it holds - may register a destructor
# there (F4). What is not known may
fn (f mut Free&) mayRegister(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Lit(_, _, _), typed.Expr.Data(_, _, _, _), typed.Expr.Read(_, _, _, _), typed.Expr.Borrow(_, _, _) {
            return false
        }
        case typed.Expr.Take(_, _, _) { return false }
        case typed.Expr.Promote(_, ty, pr) { return f.destructs(ty) or f.mayRegister(pr.X) }
        case typed.Expr.Make(_, _, m) {
            for it in m.Items {
                if f.mayRegister(it): return true
            }
            return m.Length is not null and f.mayRegister(m.Length!)
        }
        case typed.Expr.Text(_, _, tx) {
            for pc in tx.Pieces {
                match pc {
                    case typed.Piece.Render(r) { if f.mayRegister(r): return true }
                    case _ { }
                }
            }
            return false
        }
        case typed.Expr.Call(_, _, c) {
            match c.Target {
                case typed.Callee.Body(id) {
                    b2 := I64(id)
                    if not f.isCase(b2) and (f.Bodies[b2].Root is null or f.regOut[b2]) { return true }
                }
                case typed.Callee.Helper(_, _), typed.Callee.Extern(_) { }
                case _ { return true }
            }
            for a in c.Args {
                if f.mayRegister(a): return true
            }
            return false
        }
        case typed.Expr.Prim(_, _, _, _, args) {
            for a in args {
                if f.mayRegister(a): return true
            }
            return false
        }
        case typed.Expr.Away(_, _, y) { return f.mayRegister(y) }
        case typed.Expr.Cond(_, _, c) {
            return f.mayRegister(c.C) or (c.A is not null and f.mayRegister(c.A!)) or f.mayRegister(c.B)
        }
        case typed.Expr.Try(_, _, t) {
            if t.X is not null and f.mayRegister(t.X!) { return true }
            for cl in t.Clauses {
                if cl.Code is not null: return true
                for d in cl.Defaults {
                    if f.mayRegister(d): return true
                }
            }
            return false
        }
        case typed.Expr.Fn(_, _, fv) {
            return match fv {
                case typed.FnVal.Named(_): false
                case typed.FnVal.Lambda(lb, _, _): f.regOut[I64(lb)]
                case _: true
            }
        }
        # a sequence and a comprehension's loop (a lane operation's result, E39; E27): their statements walked, any of a
        # kind not walked here taken to register (F6 of the second bulk review)
        case typed.Expr.Seq(_, _, sq) {
            if f.stmtsMayRegister(sq.Stmts) { return true }
            return sq.X is not null and f.mayRegister(sq.X!)
        }
        case typed.Expr.Collect(_, _, cl) {
            if cl.Reserve is not null and f.mayRegister(cl.Reserve!) { return true }
            return f.stmtsMayRegister(cl.Loop.Stmts)
        }
        # statements inside a match: not walked here
        case _ { return true }
    }
}

# whether running these statements, inside a value being built, may register a destructor (mayRegister's): a local
# declared, a store, a test, a loop, a jump and a yield walked; any other statement may
fn (f mut Free&) stmtsMayRegister(sts Array<typed.Stmt&>&) Bool {
    for st in sts {
        match st {
            case typed.Stmt.Let(_, _, x), typed.Stmt.Eval(_, x), typed.Stmt.Yield(_, x) {
                if f.mayRegister(x): return true
            }
            case typed.Stmt.Assign(_, p, x) {
                if f.placeMayRegister(p) or f.mayRegister(x): return true
            }
            case typed.Stmt.If(_, i) {
                if f.mayRegister(i.Test) or f.stmtsMayRegister(i.Then.Stmts): return true
                if i.Else is not null and f.stmtsMayRegister(i.Else!.Stmts): return true
            }
            case typed.Stmt.Loop(_, b, post) {
                if f.stmtsMayRegister(b.Stmts): return true
                if post is not null and f.stmtsMayRegister(post.Stmts): return true
            }
            case typed.Stmt.Block(_, b) {
                if f.stmtsMayRegister(b.Stmts): return true
            }
            case typed.Stmt.Jump(_, _, _) { }
            case _ { return true }
        }
    }
    return false
}

# whether evaluating a store's place may register a destructor: a local's and a global's not, the expressions in it
# walked, a value given storage (Temp) walked as the value
fn (f mut Free&) placeMayRegister(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Local(_, _, _), typed.Lvalue.Global(_, _, _, _), typed.Lvalue.Target(_, _): false
        case typed.Lvalue.Deref(_, _, x): f.mayRegister(x)
        case typed.Lvalue.Field(_, _, b, _): f.placeMayRegister(b)
        case typed.Lvalue.Elem(_, _, e): f.placeMayRegister(e.Base) or f.mayRegister(e.Index)
        case typed.Lvalue.Payload(_, _, pl): f.placeMayRegister(pl.Base)
        case typed.Lvalue.Temp(_, _, x, _): f.mayRegister(x)
    }
}

# a call that may let go of any place
fn (w mut walker&) goAll(sp source.Span, c typed.Call&, callee I64) {
    f := w.F
    if not w.Final {
        if not f.letsAll[w.Id] {
            f.letsAll[w.Id] = true
            f.changed = true
        }
        return
    }
    w.go(AnyPlace, LCall, sp, receiverSpan(c), callee)
}

# whether a callee stores its parameter j's value in more than one place, or keeps it beside the place it stores it in
fn (f mut Free&) storedMore(b I64, j I64) Bool {
    n := 0
    for e in f.parStored[b] {
        if e >> 32 == j: n++
    }
    if n > 1 or has(f.parEsc[b], j) or has(f.resFrom[b], orig(OPar, j)) or has(f.resFrom[b], orig(OParC, j)) { return true }
    return has(f.parMulti[b], j)
}

# a payload's constructor: no code, its parameters held by the value
fn (f mut Free&) isCase(b I64) Bool {
    return match f.Bodies[b].Of {
        case typed.BodyOf.Case(_, _): true
        case _: false
    }
}

# a value stored into candidate place k (store, or through a callee's parameter): views in it kept elsewhere, a
# parameter's value a summary's store, and - in the final walk - whether it was made for the place
fn (w mut walker&) storeAs(k I64, x typed.Expr&, o Vec<I64>&, sp source.Span, where String&, multi Bool, contained Bool = false) {
    f := w.F
    # a view of the place itself stored back into it is said as condition 1 says it, below: the new value lives in the
    # old one's storage
    for y in o {
        if okind(y) == OPl and w.Final and oval(y) != w.storeInside and oval(y) != k {
            f.keep(oval(y), RStore, w.body().File, sp, $"a reference into it is stored here, in '" $where "'; store a copy, '$(...)'" if where != "" else "a reference into it is stored here; store a copy, '$(...)'")
        }
    }
    if w.Final and has(o, orig(OPl, k)) and k != w.storeInside and w.paramOf(x) < 0 {
        w.made(k, x, sp, multi)
        f.keep(k, RStore, w.body().File, sp, $"a reference into it is stored here, in '" $where "'; store a copy, '$(...)'" if where != "" else "a reference into it is stored here; store a copy, '$(...)'")
        return
    }
    j := w.paramOf(x)
    if j >= 0 {
        if not w.Final {
            if addTo(f.parStored[w.Id], (j << 32) | k) > 0 { f.changed = true }
            if multi and addTo(f.parMulti[w.Id], j) > 0 { f.changed = true }
        }
        w.parSite.Push(j)
        w.parSitePlace.Push(k)
        w.parSiteAt.Push(w.cur)
        return
    }
    if not w.Final {
        if contained { return }
        for y in o {
            if okind(y) == OParC and oval(y) != w.storeWithin and addTo(f.parEscC[w.Id], oval(y)) > 0 { f.changed = true }
            if okind(y) == OPar and oval(y) != w.storeWithin and addTo(f.parEsc[w.Id], oval(y)) > 0 {
                f.changed = true
                if f.Debug { try io.PrintErr($"esc-store " $f.fnName(w.Id) " par " $oval(y) " at " $f.P.L.Diags.Locate(w.body().File, I64(sp.Start)) " within " $w.storeWithin "\n") catch io.Error { } }
            }
        }
        return
    }
    w.made(k, x, sp, multi)
}

# ---- a parameter stored on one path more than once ----

# from the walk's stores of parameters' values: a parameter stored at two statements not in two branches of one if,
# or at a statement in a loop, is stored more than once on a path - its argument cannot be made for one place
fn (w mut walker&) paramPaths() {
    f := w.F
    for a in range w.parSite.Len() {
        j := w.parSite[a]
        s := w.parSiteAt[a]
        many := false
        lastS := has(w.lastAt, s)
        for i in range w.loopAt.Len() {
            if w.loopAt[i] < s and s <= w.loopEnd[i] and not lastS: many = true
        }
        for b in range w.parSite.Len() {
            if b == a or w.parSite[b] != j: continue
            t := w.parSiteAt[b]
            if w.exclusive(s, t): continue
            # a store a return follows is the last on its path: one written after it, outside a loop around both, never
            # runs after it, and it never runs after itself
            if not w.loopAround(s, t) and ((lastS and t > s) or (has(w.lastAt, t) and s > t)): continue
            many = true
        }
        if many and addTo(f.parMulti[w.Id], j) > 0 { f.changed = true }
    }
}

# whether a loop holds both statements a and b
fn (w mut walker&) loopAround(a I64, b I64) Bool {
    for i in range w.loopAt.Len() {
        if w.loopAt[i] < a and a <= w.loopEnd[i] and w.loopAt[i] < b and b <= w.loopEnd[i]: return true
    }
    return false
}

# whether statements a and b are in the two branches of one if
fn (w mut walker&) exclusive(a I64, b I64) Bool {
    if a == b { return false }
    for i in range w.thenFrom.Len() {
        inThenA := w.thenFrom[i] <= a and a <= w.thenTo[i]
        inElseA := w.elseFrom[i] <= a and a <= w.elseTo[i]
        inThenB := w.thenFrom[i] <= b and b <= w.thenTo[i]
        inElseB := w.elseFrom[i] <= b and b <= w.elseTo[i]
        if (inThenA and inElseB) or (inElseA and inThenB) { return true }
    }
    return false
}

# ---- source text, for the report ----

fn (w mut walker&) text(sp source.Span) String { return w.F.textOf(w.body().File, sp) }

fn (f mut Free&) textOf(file I64, sp source.Span) String {
    if file < 0 { return "" }
    t := f.P.L.Diags.TextOf(file)
    a := I64(sp.Start)
    b := I64(sp.End)
    if a < 0 or b > t.Len() or a >= b { return "" }
    return $t[a:b]
}

# a call's receiver as written - its first argument - "" for none
fn receiverSpan(c typed.Call&) source.Span {
    if c.Args.Len() == 0 { return source.Span(0, 0) }
    return c.Args[0].Span()
}

# ---- condition 1: made for the place ----

# the final walk's classification of a value stored into place k: null and constant data need nothing; a value built
# where the store is - a temporary, a constructor, a call whose result is new and all its own (O13) - is built in a
# region of its own; a value moved out of the same place moves its region; anything else is not made for the place
fn (w mut walker&) made(k I64, x typed.Expr&, sp source.Span, multi Bool) {
    f := w.F
    file := w.body().File
    kind := SFail
    of := -1
    site := -1
    why := ""
    match x {
        case typed.Expr.Lit(_, _, _) { kind = SOk }
        case typed.Expr.Data(_, _, _, _) { kind = SOk }
        case typed.Expr.Take(_, _, p) {
            q := f.placeOfPlace(p)
            if q == k {
                kind = SMove
                of = q
            } else {
                why = "its new value is moved out of another place"
            }
        }
        case typed.Expr.Away(_, _, y) {
            w.made(k, y, sp, multi)
            return
        }
        # (statements before the value - grown()'s hidden locals - build nothing of it)
        case typed.Expr.Seq(_, _, q) {
            if q.X is not null {
                w.made(k, q.X!, sp, multi)
                return
            }
        }
        case typed.Expr.Try(_, _, t) {
            plain := t.X is not null
            for c in t.Clauses {
                if c.Defaults.Len() > 0: plain = false
            }
            if plain {
                w.made(k, t.X!, sp, multi)
                return
            }
            why = "its new value has a default"
        }
        case _ {
            site, why = w.freshSite(x)
            if site >= 0 {
                kind = SFresh
            } else if why == "" {
                # a call handing out a value moved out of the place
                c := typed.Call.Of(x)
                b2 := typed.CalleeBody(c) if c is not null else -1
                if b2 >= 0 and f.Bodies[b2].Root is not null and f.mustRes[b2] == MovBase + k {
                    kind = SMove
                    of = k
                }
                if kind == SFail: why = $"its new value is existing storage: '" $w.text(x.Span()) "'; give it new storage - a constructor call, '$...', 'Copy()'"
            }
        }
    }
    if kind == SFresh and f.arr[k] and not f.plainElems(k) and not movesOnly(x) {
        kind = SFail
        why = $"its elements may hold storage built with it: '" $w.text(x.Span()) "'"
    }
    if kind == SFresh and multi {
        kind = SFail
        why = "its new value is kept in another place too"
    }
    f.stores.Push(store(k, w.Id, file, sp, kind, of, site, x, null))
    if kind == SFail {
        rf, rsp := file, sp
        if f.noteAt >= 0 {
            rf, rsp = f.noteFile, f.noteSp
            f.noteAt = -1
        }
        f.keep(k, RMade, rf, rsp, why)
    }
}

# the site a value made for a place is built at, and - where it is not new - why: a temporary given storage, an
# array, a text, a comprehension, a constructor, a call whose result is built (O13) and new
fn (w mut walker&) freshSite(x typed.Expr&) I64, String {
    f := w.F
    t := w.T()
    match x {
        case typed.Expr.Promote(_, _, pr) { return I64(pr.Site), "" }
        case typed.Expr.Make(_, _, m) { return I64(m.Site), "" }
        case typed.Expr.Text(_, _, tx) { return I64(tx.Site), "" }
        case typed.Expr.Collect(_, _, c) { return I64(c.Site), "" }
        case typed.Expr.Call(_, _, c) {
            b2 := typed.CalleeBody(c)
            if b2 < 0 or c.Site < typed.SiteId(0) { return -1, "" }
            body := f.Bodies[b2]
            if body.Root is null { return -1, "" }
            if t.Role(body.Ty) == types.RoleCtor { return I64(c.Site), "" }
            if t.Results(body.Ty).Len() != 1 { return -1, "" }
            e := t.ResultFrom(body.Ty, 0)
            if e >= 0 or e == types.FromTypeVar {
                # a borrowed result: its new value lives where the old one does (the tree's sharing version, 2.7)
                if e >= 0 and e < body.Params.Len() {
                    pn := f.P.L.Names.Text(body.Locals[I64(body.Params[e])].Name)
                    f.noteAt = b2
                    f.noteFile = body.File
                    f.noteSp = source.Span(body.Sp.Start, body.Sp.Start)
                    return -1, $"its new value is built where the old one lives: '" $f.fnName(b2) "' borrows its result from '" $pn "'; a built result ('" $f.builtSpell(t.Results(body.Ty)[0]) "') frees the old " $f.what(t.Results(body.Ty)[0])
                }
                return -1, ""
            }
            if not f.resFresh[b2] {
                return -1, $"its new value is not all new: '" $f.fnName(b2) "' returns storage it was given"
            }
            return I64(c.Site), ""
        }
        case _ { return -1, "" }
    }
}

fn (f mut Free&) fnName(b I64) String {
    return match f.Bodies[b].Of {
        case typed.BodyOf.Fn(i): $f.P.L.Names.Text(f.P.FnDecl(f.P.InstanceFn(i)).Name)
        case _: "the function"
    }
}

# a reference result type as a built result writes it: the referent and a bare "&"
fn (f mut Free&) builtSpell(ty types.TypeId) String {
    t := f.T()
    if not t.IsRef(ty) or f.Sc.Spell is null { return "T&" }
    return $f.Sc.Spell!(t.Referent(ty)) "&"
}

# what a value of a reference type is called in a note: a tree where it is an enum holding its own kind
fn (f mut Free&) what(ty types.TypeId) String {
    t := f.T()
    if not t.IsRef(ty) { return "value" }
    r := t.Plain(t.Repr(t.Referent(ty)))
    if t.KindOf(r) != types.Kind.Named or not t.HasBody(r) or t.DeclKindOf(t.DeclOf(r)) != types.DeclKind.Enum {
        return "value"
    }
    for c in t.Items(t.Cases(r)) {
        for p in t.Items(t.Parts(c)) {
            if t.IsRef(p) and t.Plain(t.Repr(t.Referent(p))) == r: return "tree"
        }
    }
    return "value"
}

# a place keeps: the first reason found is the report's
fn (f mut Free&) keep(k I64, kind I64, file I64, sp source.Span, text String&) {
    if k < 0 or k >= f.whyKind.Len() or f.whyKind[k] != RNone { return }
    f.whyKind[k] = kind
    f.why[k] = reason(kind, file, sp, $text)
}

# ---- condition 6: views in use when a place lets go ----

# the final walk's let-goes against the body's views: a local holding a view of place k used after a statement that
# lets go of k - after it, in a loop around both, or in deferred code - or a view read in the statement itself (other
# than the value an assignment stores) keeps k. The first one found is the report's note
fn (w mut walker&) views() {
    f := w.F
    body := w.body()
    # what each local holds a view of (or a value moved out of), and each local's uses - indexed once
    viewed Vec<mut Vec<I64>&>
    usesOf Vec<mut Vec<I64>&>
    for l in range w.origins.Len() {
        viewed.Push(Vec<I64>())
        usesOf.Push(Vec<I64>())
        for y in w.origins[l] {
            if okind(y) == OPl or okind(y) == OMov: viewed[l].Push(oval(y))
        }
    }
    for u in range w.useLocal.Len() { usesOf[w.useLocal[u]].Push(u) }
    viewers Vec<I64>
    for l in range w.origins.Len() {
        if viewed[l].Len() > 0 and not w.params.Has(l): viewers.Push(l)
    }
    # the reads by statement: statement s's from readFrom[s] to readFrom[s + 1] in reads
    readFrom := Array<I64>(w.no + 2, 0)
    for r in range w.readPlace.Len() { readFrom[w.readAt[r] + 1]++ }
    for i in range 1, readFrom.Len() { readFrom[i] += readFrom[i - 1] }
    reads := Array<I64>(w.readPlace.Len(), 0)
    fill := Array<I64>(w.no + 1, 0)
    for r in range w.readPlace.Len() {
        a := w.readAt[r]
        reads[readFrom[a] + fill[a]] = w.readPlace[r]
        fill[a]++
    }
    for g in range w.goPlace.Len() {
        k := w.goPlace[g]
        s := w.goAt[g]
        kind := w.goKind[g]
        # (a holder's drop runs where its block is left: judged from there)
        if w.goEnd[g] >= 0 { s = try w.deferEnd.Get(w.goEnd[g]) catch default s }
        if k >= 0 and (k >= f.whyKind.Len() or f.whyKind[k] != RNone): continue
        at := w.goIdx[g]
        # in the statement itself
        # (a destructor walked as a call where its holder lets go - dtorCalls - reads the value it ends: its own body's
        # views are judged in its walk)
        if kind != LAssign and kind != LLeaf and kind != LYield and kind != LHeld and not f.isDtor(w.goCallee[g]) {
            for i in range readFrom[s], readFrom[s + 1] {
                q := reads[i]
                if (k >= 0 and q != k) or f.whyKind[q] != RNone: continue
                f.keepView(q, body.File, w.goSp[g], $"a value of it read in this statement is in use when '" $f.textOf(body.File, w.goSp[g]) "' lets go of it; read what you need first", at)
            }
        }
        # in a local used after it
        for l in viewers {
            found := false
            for q in viewed[l] {
                if (k < 0 or q == k) and f.whyKind[q] == RNone: found = true
            }
            if not found: continue
            u := w.usedAfter(l, s, usesOf[l])
            if u < 0: continue
            name := f.P.L.Names.Text(body.Locals[l].Name)
            line := f.P.L.Diags.LineAt(body.File, I64(body.Locals[l].Sp.Start))
            gl := f.P.L.Diags.LineAt(body.File, I64(w.goSp[g].Start))
            # a local of the program's own is said by its name; a hidden one - what a for-in walks - by what it holds
            who := $"'" $name "' (line " $line ")"
            from := $" from '" $name "'"
            if name == "" {
                walked := f.textOf(body.File, w.declSp[l])
                who = $"what the loop on line " $line " walks" $(", '" $walked "'," if walked != "" and not walked.Contains("\n") else "")
                from = ""
            }
            after := ""
            if kind == LYield {
                after = $"after '" $f.textOf(body.File, w.goSp[g]) "' (line " $gl "), where the generator's caller may let go of it; read what you need" $from " before the yield"
            } else if kind == LCall {
                after = $"after '" $f.textOf(body.File, w.goSp[g]) "' (line " $gl "), which " $w.removes(k) "; read what you need" $from " before the call"
            } else {
                after = $"after it lets go of it (line " $gl "); read what you need" $from " before"
            }
            for q in viewed[l] {
                if (k < 0 or q == k) and f.whyKind[q] == RNone {
                    f.keepView(q, body.File, w.useSp[u], $who " is used here, " $after, at)
                }
            }
            if k >= 0: break
        }
    }
}

# ---- local reads ----

# the local a value is a read of, -1 for none
fn readLocalOf(x typed.Expr&) I64 {
    return match x {
        case typed.Expr.Read(_, _, p, _): match p {
            case typed.Lvalue.Local(_, _, l): I64(l)
            case _: -1
        }
        case _: -1
    }
}

# the owner local place local l of this body is, -1 for none
fn (w mut walker&) ownLocal(l I64) I64 {
    if l < 0 or not w.F.olIn[w.Id] { return -1 }
    return try w.F.ownLocalOf.Get(pair.Pair(w.Id, l)) catch default -1
}

# an owner local's value handed back (a return, a yield): it lives on where the result goes, which no let-go of the
# place may release - the place keeps
fn (w mut walker&) returnedOwnLocals(o Vec<I64>&, sp source.Span) {
    for y in o {
        if okind(y) == OPl and w.F.isOwnLocal(oval(y)): w.F.keep(oval(y), RStore, w.body().File, sp, "its value is handed back here")
    }
}

fn (w mut walker&) localName(l I64) String { return $w.F.P.L.Names.Text(w.body().Locals[l].Name) }

# what a call that lets go of place k does to it, as the note says: "removes frames" - the name of the collection a
# removal in this body is called on - or "lets go of it"
fn (w mut walker&) removes(k I64) String {
    if k < 0 { return "may let go of anything" }
    for g in range w.goPlace.Len() {
        # the collection a removal of the library's is called on - not the receiver of the program's own call
        c := w.goCallee[g]
        if w.goPlace[g] != k or w.goRecv[g].Start >= w.goRecv[g].End or c < 0 or w.F.programCode[c]: continue
        r := w.F.textOf(w.body().File, w.goRecv[g])
        at := r.Len() - 1
        for at >= 0 and (r[at].IsLetter() or r[at].IsDigit() or r[at] == '_') { at-- }
        nm := r[at + 1:]
        if nm.Len() > 0: return $"removes " $nm
    }
    return "lets go of it"
}

# whether local l holds a view of place k (or a value moved out of it)
fn (w mut walker&) viewOf(l I64, k I64) Bool { return has(w.origins[l], orig(OPl, k)) or has(w.origins[l], orig(OMov, k)) }

# the first use of local l after statement s may read it - later, in a loop around s declared outside it, or in
# deferred code - as an index into the uses, -1 for none
fn (w mut walker&) usedAfter(l I64, s I64, uses Vec<I64>&) I64 {
    # declared after the let-go began: what it holds was read after it, or - in a loop - is made again each turn
    if w.declAt[l] > s { return -1 }
    for u in uses {
        if w.useAt[u] > w.ends[s]: return u
    }
    for i in range w.loopAt.Len() {
        a := w.loopAt[i]
        if not (a < s and s <= w.loopEnd[i]) or w.declAt[l] > a: continue
        for u in uses {
            if a < w.useAt[u] and w.useAt[u] <= w.loopEnd[i]: return u
        }
    }
    if has(w.deferred, l) and uses.Len() > 0 { return uses[0] }
    return -1
}

# place k keeps for a view: the note's position and text, and the let-go the row is at (an index into goes)
fn (f mut Free&) keepView(k I64, file I64, sp source.Span, text String&, g I64) {
    if f.whyKind[k] != RNone { return }
    f.keep(k, RView, file, sp, text)
    if g >= 0 { f.viewGo.Put(k, g) }
}

# ---- what every value is: the must-summaries ----

# a body's returns and its locals' values: what each local's every value is (a value of one place, or moved out of
# one), what every result is, and whether every result is new
fn (f mut Free&) mustOf(b I64) {
    body := f.Bodies[b]
    if body.Root is null { return }
    m mut mustW& = mustW(f, b)
    for _ in range body.Locals.Len() {
        m.must.Push(MustTop)
        m.within.Push(MustTop)
    }
    for j in range body.Params.Len() {
        m.must[I64(body.Params[j])] = MustNone
        m.within[I64(body.Params[j])] = j
    }
    m.block(body.Root!)
    # to the greatest fixed point, never cut short (F3): each local only moves down from Top to a place to none, so it
    # settles - stopped early, a must-fact would be too optimistic
    for {
        found := false
        for a in range m.assigned.Len() {
            l := m.assigned[a]
            if l < 0 or m.isParam(l): continue
            v := meet(m.must[l], m.exprMust(m.values[a]))
            if v != m.must[l] {
                m.must[l] = v
                found = true
            }
            u := meet(m.within[l], m.F.withinExpr(m.within, m.values[a]))
            if u != m.within[l] {
                m.within[l] = u
                found = true
            }
        }
        if not found: break
    }
    wl := f.withinLocals[b]
    wl.Clear()
    for x in m.within { wl.Push(x) }
    r := MustTop
    fresh := true
    for x in m.returned {
        r = meet(r, m.exprMust(x))
        if not m.fresh(x, 0): fresh = false
    }
    if r != f.mustRes[b] {
        f.mustRes[b] = r
        f.changed = true
    }
    if fresh != f.resFresh[b] and f.resFresh[b] {
        f.resFresh[b] = false
        f.changed = true
    }
    ml := f.mustLocals[b]
    ml.Clear()
    for x in m.must { ml.Push(x) }
    fl := f.freshLocals[b]
    fl.Clear()
    for l in range body.Locals.Len() { fl.Push(m.freshLocal(l)) }
}

# whether every value local l holds is an object the body made: given one, and each a new object
fn (m mut mustW&) freshLocal(l I64) Bool {
    if m.isParam(l) { return false }
    found := false
    for a in range m.assigned.Len() {
        if m.assigned[a] != l: continue
        if not m.fresh(m.values[a], 1): return false
        found = true
    }
    return found
}

type mustW struct(F mut Free&, Id I64) {
    F
    Id
    must Vec<I64>
    within Vec<I64>
    assigned Vec<I64>          # each assignment of a local: the local, its value
    values Vec<typed.Expr&>
    returned Vec<typed.Expr&>
}

fn (m mut mustW&) isParam(l I64) Bool {
    for p in m.F.Bodies[m.Id].Params {
        if I64(p) == l: return true
    }
    return false
}

fn (m mut mustW&) block(bl typed.Block&) {
    for st in bl.Stmts { m.stmt(st) }
}

fn (m mut mustW&) stmt(st typed.Stmt&) {
    match st {
        case typed.Stmt.Let(_, l, x) {
            m.assigned.Push(I64(l))
            m.values.Push(x)
            m.expr(x)
        }
        case typed.Stmt.Assign(_, p, x) {
            match p {
                case typed.Lvalue.Local(_, _, l) {
                    m.assigned.Push(I64(l))
                    m.values.Push(x)
                }
                case _ { }
            }
            m.expr(x)
        }
        case typed.Stmt.Eval(_, x) { m.expr(x) }
        case typed.Stmt.If(_, i) {
            m.expr(i.Test)
            m.block(i.Then)
            if i.Else is not null { m.block(i.Else!) }
        }
        case typed.Stmt.Loop(_, body, post) {
            m.block(body)
            if post is not null { m.block(post) }
        }
        case typed.Stmt.Return(_, x), typed.Stmt.Suspend(_, x) {
            if x is not null {
                m.returned.Push(x)
                m.expr(x)
            }
        }
        case typed.Stmt.Block(_, b) { m.block(b) }
        case typed.Stmt.Defer(_, b) { m.block(b) }
        case typed.Stmt.Join(_, j) { m.block(j.Code) }
        case _ { }
    }
}

# the statements inside an expression: a sequence's, a match's arms', a try's clauses'
# a match alternative's bindings, each an assignment
fn (m mut mustW&) binds(alt typed.Alt&) {
    for bd in alt.Binds {
        m.assigned.Push(I64(bd.To))
        m.values.Push(bd.From)
    }
}

fn (m mut mustW&) expr(x typed.Expr&) {
    match x {
        case typed.Expr.Seq(_, _, q) {
            for st in q.Stmts { m.stmt(st) }
            if q.X is not null { m.expr(q.X!) }
        }
        case typed.Expr.Match(_, _, mt) {
            for st in mt.Held { m.stmt(st) }
            for a in mt.Arms {
                for alt in a.Alts { m.binds(alt) }
                if a.Code is not null { m.block(a.Code!) }
                if a.Value is not null { m.expr(a.Value!) }
            }
            if mt.NoMatch is not null {
                if mt.NoMatch!.Code is not null { m.block(mt.NoMatch!.Code!) }
            }
        }
        case typed.Expr.Try(_, _, t) {
            if t.X is not null { m.expr(t.X!) }
            for c in t.Clauses {
                if c.Code is not null { m.block(c.Code!) }
            }
        }
        case typed.Expr.Call(_, _, c) {
            for a in c.Args { m.expr(a) }
        }
        case typed.Expr.Cond(_, _, c) {
            if c.A is not null { m.expr(c.A!) }
            m.expr(c.B)
        }
        case _ { }
    }
}

# what every value of an expression is
fn (m mut mustW&) exprMust(x typed.Expr&) I64 {
    f := m.F
    return match x {
        case typed.Expr.Lit(_, _, _): MustTop
        case typed.Expr.Read(_, _, p, _): m.placeMust(p)
        case typed.Expr.Take(_, _, p): MovBase + f.placeOfPlace(p) if f.placeOfPlace(p) >= 0 else MustNone
        case typed.Expr.Call(_, _, c): m.callMust(c)
        case typed.Expr.Try(_, _, t): m.tryMust(t)
        case typed.Expr.Away(_, _, y): m.exprMust(y)
        case typed.Expr.Prim(_, _, op, _, args): m.exprMust(args[0]) if isConversion(op, args) else MustNone
        case _: MustNone
    }
}

# a conversion of one value: a reference made nullable, a nominal type's - the value it converts, as it is
fn isConversion(op typed.PrimOp, args Array<typed.Expr&>&) Bool { return op == typed.PrimOp.Convert and args.Len() == 1 }

fn (m mut mustW&) placeMust(p typed.Lvalue&) I64 {
    match p {
        case typed.Lvalue.Local(_, _, l) { return m.must[I64(l)] }
        case _ { }
    }
    k := m.F.placeOfPlace(p)
    return k if k >= 0 else MustNone
}

fn (m mut mustW&) callMust(c typed.Call&) I64 {
    b2 := typed.CalleeBody(c)
    if b2 < 0 or m.F.Bodies[b2].Root is null { return MustNone }
    return m.F.mustRes[b2]
}

fn (m mut mustW&) tryMust(t typed.Try&) I64 {
    if t.X is null { return MustNone }
    v := m.exprMust(t.X!)
    for c in t.Clauses {
        for d in c.Defaults { v = meet(v, m.exprMust(d)) }
    }
    return v
}

# whether every value of an expression is new: built where it is (a temporary, a constructor, an array, a text), null,
# constant data, or a built result (O13) of a call whose results are all new
# whether every value local l is assigned is fresh (none: fresh)
fn (m mut mustW&) assignedFresh(l I64, depth I64) Bool {
    for a in range m.assigned.Len() {
        if m.assigned[a] == l and not m.fresh(m.values[a], depth + 1): return false
    }
    return true
}

fn (m mut mustW&) fresh(x typed.Expr&, depth I64) Bool {
    f := m.F
    t := f.T()
    if depth > 8 { return false }
    match x {
        case typed.Expr.Lit(_, _, _), typed.Expr.Data(_, _, _, _) { return true }
        case typed.Expr.Promote(_, _, _), typed.Expr.Make(_, _, _), typed.Expr.Text(_, _, _), typed.Expr.Collect(_, _, _) {
            return true
        }
        case typed.Expr.Call(_, _, c) {
            b2 := typed.CalleeBody(c)
            if b2 < 0 or f.Bodies[b2].Root is null { return false }
            body := f.Bodies[b2]
            if t.Role(body.Ty) == types.RoleCtor { return true }
            if t.Results(body.Ty).Len() != 1 { return false }
            e := t.ResultFrom(body.Ty, 0)
            if e >= 0 or e == types.FromTypeVar { return false }
            return f.resFresh[b2]
        }
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Lvalue.Local(_, _, l) { return not m.isParam(I64(l)) and m.assignedFresh(I64(l), depth) }
                case _ { return false }
            }
        }
        case typed.Expr.Try(_, _, tr) {
            if tr.X is null or not m.fresh(tr.X!, depth + 1) { return false }
            for c in tr.Clauses {
                for d in c.Defaults {
                    if not m.fresh(d, depth + 1): return false
                }
            }
            return true
        }
        case typed.Expr.Away(_, _, y) { return m.fresh(y, depth + 1) }
        case typed.Expr.Prim(_, _, op, _, args) { return isConversion(op, args) and m.fresh(args[0], depth + 1) }
        case _ { return false }
    }
}

# ---- what a call or a store builds through a value of a sole place (RegionOr) ----

# the reference whose referent holds an argument's storage: a reference read whole, or the reference a borrowed place
# is reached through - null for none (a local's own storage, a global's)
fn derefRoot(p typed.Lvalue&) typed.Expr?& {
    return match p {
        case typed.Lvalue.Deref(_, _, r): r
        case typed.Lvalue.Field(_, _, b, _): derefRoot(b)
        case typed.Lvalue.Elem(_, _, e): derefRoot(e.Base)
        case typed.Lvalue.Payload(_, _, pl): derefRoot(pl.Base)
        case _: null
    }
}

fn (w mut walker&) rootOf(x typed.Expr&) typed.Expr?& {
    t := w.T()
    match x {
        case typed.Expr.Read(_, ty, p, _) {
            match p {
                case typed.Lvalue.Local(_, _, _) { if t.IsRef(ty) and not t.ArrayRef(ty): return x }
                case _ { }
            }
            return null
        }
        case typed.Expr.Borrow(_, _, p) { return derefRoot(p) }
        case _ { return null }
    }
}

# the place every value of a root reference is a value of (a view or a value moved out), -1 for none: only a local or
# a place read, with nothing evaluated on the way that could change it
fn (w mut walker&) rootPlace(r typed.Expr&) I64 {
    f := w.F
    t := w.T()
    if not t.IsRef(r.Type()) or t.ArrayRef(r.Type()) { return -1 }
    v := MustNone
    match r {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Lvalue.Local(_, _, l) { v = f.mustLocals[w.Id][I64(l)] if I64(l) < f.mustLocals[w.Id].Len() else MustNone }
                case typed.Lvalue.Field(_, _, b, _) {
                    if not pureBase(b): return -1
                    v = f.placeOfPlace(p)
                }
                case _ { return -1 }
            }
        }
        case _ { return -1 }
    }
    if v < 0 { return -1 }
    return v - MovBase if v >= MovBase else v
}

# whether a place's base evaluates nothing that could change what it reads: locals and fields reached through
# reference locals
fn pureBase(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Local(_, _, _): true
        case typed.Lvalue.Field(_, _, b, _): pureBase(b)
        case typed.Lvalue.Deref(_, _, r): match r {
            case typed.Expr.Read(_, _, q, _): pureBase(q)
            case _: false
        }
        case _: false
    }
}

# a call one of whose arguments is reached through a value of a sole place: what the callee builds where that
# argument lives is built in that value's region, if the place is decided sole (writePlans)
fn (w mut walker&) orCallOf(c typed.Call&, b2 I64) {
    if c.Site < typed.SiteId(0) { return }
    for j in range c.Args.Len() {
        r := w.rootOf(c.Args[j])
        if r is null: continue
        q := w.rootPlace(r)
        if q < 0: continue
        w.F.ors.Push(orCall(w.Id, I64(c.Site), b2, j, q, r, c.Args[j]))
        return
    }
}

# a store into a field reached through a value of a sole place: the value's parts built where that value is
fn (w mut walker&) orStoreOf(p typed.Lvalue&, x typed.Expr&) {
    r := derefRoot(p)
    if r is null { return }
    q := w.rootPlace(r)
    if q < 0 { return }
    w.F.orStores.Push(orStore(w.Id, q, x, r))
}

# ---- the decisions ----

fn (f mut Free&) decide() {
    n := f.keyTy.Len()
    for _ in range n { f.Sole.Push(false) }
    # condition 5 (a place let go of again, where its code makes regions) and the program-wide conditions
    letsHere := Array<Bool>(n)
    # a struct overwritten in the prelude's collections overwrites a slot its removals vacated first (add's reuse of a
    # removed key's slot): no let-go that frees anything, so not one a region is made for
    for g in f.goes {
        if g.Kind != LCall and g.PlaceId >= 0 and not (g.Kind == LLeaf and f.prelude[g.Body]) { letsHere[g.PlaceId] = true }
    }
    for k in range n {
        if f.tasks { f.keep(k, RTask, -1, source.Span(0, 0), "a task can reach it: nothing is freed early where a program has tasks") }
        # C may call an export fn (X12) from a thread of its own - one it is given (X13), or any of a library's (X14) -
        # condition 3
        if f.exports.Len() > 0 { f.keep(k, RTask, -1, source.Span(0, 0), "C may call an export fn from a thread of its own: nothing is freed early where C is given one, links C of its own, or is a library") }
        if f.hidden or has(f.hiddenAt, k) { f.keep(k, RDtor, -1, source.Span(0, 0), "a destructor, Str, Eq or Hash lets go of it where no call is written") }
    }
    # condition 4 judged by what a region would hold, not only by the value's type (F4): a value made for a place whose
    # building may register a destructor in the region - a constructor's temporary held by nothing (O16), a callee's
    # built result - keeps, so that destructor runs when its scope closes, never at a let-go. A dtor place keeps anyway
    for st in f.stores {
        if st.Kind == SFresh and not f.dtorVal[st.PlaceId] and f.mayRegister(st.X!) {
            f.keep(st.PlaceId, RDtor, st.File, st.Sp, "its new value may hold an instance whose destructor is still to run (O16), which a let-go would run early: build that instance outside the value")
        }
    }
    for os in f.orStores {
        if not f.dtorVal[os.PlaceId] and f.mayRegister(os.X) {
            f.keep(os.PlaceId, RDtor, -1, source.Span(0, 0), "a value built into what it holds may hold an instance whose destructor is still to run (O16)")
        }
    }
    for oc in f.ors {
        if not f.dtorVal[oc.PlaceId] and (f.Bodies[oc.Callee].Root is null or f.regOut[oc.Callee]) {
            f.keep(oc.PlaceId, RDtor, -1, source.Span(0, 0), "a call building into what it holds may register an instance whose destructor is still to run (O16)")
        }
    }
    # a feeder changed by a call that cannot build in its region (feedFits)
    for fc in f.feedCalls {
        if not f.feedFits(fc) {
            fd := f.feeds[fc.Feed]
            f.keep(fd.PlaceId, RInPlace, f.Bodies[fc.Body].File, f.Bodies[fc.Body].Locals[fd.Local].Sp, $"what is built for it is changed by a call that cannot build where it is: '" $f.P.L.Names.Text(f.Bodies[fc.Body].Locals[fd.Local].Name) "'")
        }
    }
    # condition 1's stores that cannot be built where they are
    for st in f.stores {
        if st.Kind == SFresh and (not f.placeable(st) or f.topSite(st.X!) < 0) {
            f.keep(st.PlaceId, RMade, st.File, st.Sp, "its new value cannot be built in a region of its own here")
        }
    }
    # a site writePlans gives another place's region first (a module's every place's sites are written, each guarded by
    # its own decision): this place's value built there is in a region only where that place is sole
    claim Map<pair.Pair<I64, I64>, I64>
    for i in f.outerFirst() {
        st := f.stores[i]
        if st.Kind != SFresh or f.decided[st.Body] or not f.placeable(st): continue
        top := f.topSite(st.X!)
        if top < 0 or f.siteScope(st.Body, st.X!) == typed.Scope.Found or f.siteScope(st.Body, st.X!) == typed.Scope.Passed: continue
        key := pair.Pair(st.Body, top)
        had := try claim.Get(key) catch default -1
        if had < 0 {
            claim.Put(key, st.PlaceId)
        } else if had != st.PlaceId {
            f.keep(st.PlaceId, RMade, st.File, st.Sp, "its new value is built where another place's is")
        }
    }
    for k in range n {
        if f.dtorVal[k] {
            f.keep(k, RDtor, -1, source.Span(0, 0), "what it holds has a destructor still to run when it lets go (O15): its holder ends it")
        }
    }
    for k in range n { f.Sole[k] = letsHere[k] and f.whyKind[k] == RNone }
    # an owner held in a sole place has its storage in one region, released through its anchors (types.Anchors): the
    # arrays it holds keep - each in a region of its own would leave that one's anchors naming other regions
    for k in range n {
        if not f.Sole[k] or not f.owner[k]: continue
        for a in f.heldPlaces(f.valTy[k]) {
            if f.arr[a] and f.Sole[a] {
                f.Sole[a] = false
                f.keep(a, RCopied, -1, source.Span(0, 0), "what holds it is an owner held in a place of early freeing, whose storage is one region")
            }
        }
    }
    # a move from a place that is not sole moves nothing a region holds
    for {
        found := false
        for st in f.stores {
            if st.Kind == SMove and f.Sole[st.PlaceId] and not f.Sole[st.Of] {
                f.Sole[st.PlaceId] = false
                f.keep(st.PlaceId, RMade, st.File, st.Sp, "its new value is moved out of a place that keeps")
                found = true
            }
        }
        if not found: break
    }
}

# where a region made at site top of body b is a kid of: a feeder's declaration's, where its copy would have gone (the
# place it is built for lives there); any other, at
fn (f Free&) feedDest(b I64, top I64, at typed.Scope) typed.Scope {
    for fd in f.feeds {
        if fd.Body == b and fd.Site == top: return fd.Dest
    }
    return at
}

# the stores, by index, in the order writePlans gives their sites regions: a body's in the order of their values'
# starts, a value before the values inside it - so a value built as part of another's is judged once that one's region
# took it in, a region of its own inside that one
fn (f Free&) outerFirst() Vec<I64> {
    out Vec<I64>
    for i in range f.stores.Len() { out.Push(i) }
    out.Sort(fn(a I64, b I64) Bool {
        x, y := f.stores[a], f.stores[b]
        if x.Body != y.Body: return x.Body < y.Body
        if x.X is null or y.X is null: return a < b
        p, q := x.X!.Span(), y.X!.Span()
        if p.Start != q.Start: return p.Start < q.Start
        if p.End != q.End: return p.End > q.End
        return a < b
    })
    return out
}

# the scope a site is built in, as the plan says: a temporary's, an array's, a text's, a comprehension's (Built) - a
# call's built result or a constructor's instance (Passed, its result variable)
fn (f mut Free&) siteScope(b I64, x typed.Expr&) typed.Scope {
    pl := f.Plans.Ref(b)
    return match x {
        case typed.Expr.Promote(_, _, pr): pl.Built[I64(pr.Site)]
        case typed.Expr.Make(_, _, m): pl.Built[I64(m.Site)] if m.Site >= typed.SiteId(0) else typed.Scope.Unset
        case typed.Expr.Text(_, _, tx): pl.Built[I64(tx.Site)]
        case typed.Expr.Collect(_, _, c): pl.Built[I64(c.Site)]
        case typed.Expr.Call(_, _, c): pl.Passed(c.Site, f.resultVar(typed.CalleeBody(c))) if c.Site >= typed.SiteId(0) else typed.Scope.Unset
        case typed.Expr.Away(_, _, y): f.siteScope(b, y)
        case typed.Expr.Seq(_, _, sq): f.siteScope(b, sq.X!) if sq.X is not null else typed.Scope.Unset
        case _: typed.Scope.Unset
    }
}

# a body's result scope's index in its Vars - a constructor's instance - -1 for none
fn (f mut Free&) resultVar(b I64) I64 {
    if b < 0 { return -1 }
    vs := f.Bodies[b].Vars
    for i in range vs.Len() {
        match vs[i] {
            case typed.ScopeVar.Result, typed.ScopeVar.Instance { return i }
            case _ { }
        }
    }
    return -1
}

# a parameter's scope variable's index in a body's Vars, -1 for none
fn (f mut Free&) paramVar(b I64, j I64) I64 {
    body := f.Bodies[b]
    if j >= body.Params.Len() { return -1 }
    want := body.Params[j]
    for i in range body.Vars.Len() {
        match body.Vars[i] {
            case typed.ScopeVar.Param(l) { if l == want: return i }
            case _ { }
        }
    }
    return -1
}

# whether a scope exists at run time, for a region to be made in
fn runs(sc typed.Scope) Bool {
    return match sc {
        case typed.Scope.Block(_), typed.Scope.Var(_), typed.Scope.Program: true
        case _: false
    }
}

# whether a store's fresh value can be built in a region of its own: its scope exists at run time, and - for a call -
# the callee's obligations ask nothing that is built where its result is to outlive what is not (2.4 item 5)
fn (f mut Free&) placeable(st store) Bool {
    x := st.X!
    if not runs(f.siteScope(st.Body, x)) { return false }
    c := typed.Call.Of(x)
    match x {
        case typed.Expr.Promote(_, _, pr) { c = ctorCall(pr.X) }
        case typed.Expr.Away(_, _, y) { return f.placeable(store(st.PlaceId, st.Body, st.File, st.Sp, st.Kind, st.Of, st.Site, y, null)) }
        case typed.Expr.Call(_, _, _) { }
        case _ { return true }
    }
    if c is null { return true }
    b2 := typed.CalleeBody(c)
    if b2 < 0 { return true }
    return f.varsFit(st.Body, c, b2, f.siteScope(st.Body, x), f.resultVar(b2)) >= 0
}

# the constructor call a temporary is, null for none
fn ctorCall(x typed.Expr&) typed.Call?& {
    return match x {
        case typed.Expr.Call(_, _, c): c
        case _: null
    }
}

# the callee variables a region given for variable v of a call holds: v, and the variables of arguments built with it
# (their scope the region's parent at), as a bit set - -1 where the callee's obligations ask something in them to
# outlive something not in them, or an equality across
fn (f mut Free&) varsFit(b I64, c typed.Call&, b2 I64, at typed.Scope, v I64) I64 {
    if v < 0 or v >= 63 { return -1 }
    pl := f.Plans.Ref(b)
    set := I64(1) << v
    for j in range c.Args.Len() {
        u := f.paramVar(b2, j)
        if u < 0 or u >= 63: continue
        if pl.Passed(c.Site, u) == at and f.builtAt(b, c.Args[j]) == at { set = set | (I64(1) << u) }
    }
    rels := f.Sc.VarRels(b2)
    if f.relsFit(rels, set) { return set }
    set = I64(1) << v
    return set if f.relsFit(rels, set) else -1
}

# the scope a value is built in, as the plan says - where it has a region of its own (another place's value, a kid of
# whatever region takes it in), the scope that region is made in
fn (f mut Free&) builtAt(b I64, x typed.Expr&) typed.Scope {
    top := f.topSite(x)
    pl := f.Plans.Ref(b)
    if top >= 0 and pl.RegionKind[top] == 1 { return pl.RegionParent[top] }
    return f.siteScope(b, x)
}

fn (f mut Free&) relsFit(rels Array<I64>&, set I64) Bool {
    for i := 0, i + 2 < rels.Len(), i += 3 {
        hi, lo, ex := rels[i], rels[i + 1], rels[i + 2]
        hin := hi >= 0 and hi < 63 and (set & (I64(1) << hi)) != 0
        lin := lo >= 0 and lo < 63 and (set & (I64(1) << lo)) != 0
        if hin and not lin { return false }
        if ex == 1 and hin != lin { return false }
    }
    return true
}

# ---- the regions written into the plans ----

# A body whose code is emitted in the root's object - lowered again by every build, its record never reused - has the
# sole places' sites written, as they are. Every other body has every candidate place's sites written, each guarded by
# its place's decision (RegionGuard, RootGuard), so that a module's code is the same whatever the program decides, every
# decision a link-time constant (wholeprog 2.1)
fn (f mut Free&) writePlans() {
    # each value made for a place: a region of its own at its site where the place is sole, its parts built with it
    # (whether a store can be built in a region is judged before any is written: a value whose site an earlier store's
    # region took in has a region of its own inside that one - a place's value built as part of another's)
    ok Vec<Bool>
    for st in f.stores { ok.Push(st.Kind == SFresh and f.placeable(st)) }
    for i in f.outerFirst() {
        if not ok[i]: continue
        st := f.stores[i]
        k := st.PlaceId
        if f.decided[st.Body] and not f.Sole[k]: continue
        x := st.X!
        top := f.topSite(x)
        if top < 0: continue
        pl := f.Plans.Ref(st.Body)
        if pl.RegionKind[top] != 0: continue
        at := f.siteScope(st.Body, x)
        # O29: a value built where its place's storage is found at run time is built there, never in a region of its own
        if at == typed.Scope.Found or at == typed.Scope.Passed: continue
        pl.RegionKind[top] = 1
        pl.RegionParent[top] = f.feedDest(st.Body, top, at)
        pl.RegionGuard[top] = f.guard(st.Body, k)
        f.redirect(st.Body, x, top, at, true)
    }
    f.writeFeedCalls()
    # a store through a value of a sole place: a region made there has that value's region for its parent; parts not
    # made for a sole place are built in that region
    for os in f.orStores {
        if f.decided[os.Body] and not f.Sole[os.PlaceId]: continue
        top := f.topSite(os.X)
        if top < 0: continue
        pl := f.Plans.Ref(os.Body)
        at := f.siteScope(os.Body, os.X)
        if not runs(at) and pl.RegionKind[top] == 0: continue
        if pl.RegionKind[top] == 1 {
            if pl.RegionRoot[top] is null {
                pl.RegionRoot[top] = os.Root
                pl.RootGuard[top] = f.guard(os.Body, os.PlaceId)
            }
            continue
        }
        if pl.RegionKind[top] != 0: continue
        pl.RegionKind[top] = 2
        pl.RegionParent[top] = at
        pl.RegionRoot[top] = os.Root
        pl.RegionGuard[top] = f.guard(os.Body, os.PlaceId)
        pl.RootGuard[top] = f.guard(os.Body, os.PlaceId)
        f.redirect(os.Body, os.X, top, at, true)
    }
    # a call given a value of a sole place: what it builds where that value lives is built in its region
    for oc in f.ors {
        if f.decided[oc.Body] and not f.Sole[oc.PlaceId]: continue
        pl := f.Plans.RefMut(oc.Body)
        if pl.RegionKind[oc.Site] != 0: continue
        v := f.paramVar(oc.Callee, oc.Param)
        if v < 0: continue
        site := typed.SiteId(I32(oc.Site))
        at := pl.Passed(site, v)
        if not runs(at): continue
        call := f.callAt(oc.Body, oc.Site)
        if call is null: continue
        set := f.orVars(oc.Body, call, oc.Callee, at, v)
        if set < 0: continue
        pl.RegionKind[oc.Site] = 2
        pl.RegionParent[oc.Site] = at
        pl.RegionRoot[oc.Site] = oc.Root
        pl.RegionGuard[oc.Site] = f.guard(oc.Body, oc.PlaceId)
        pl.RootGuard[oc.Site] = f.guard(oc.Body, oc.PlaceId)
        for u in range 63 {
            if (set & (I64(1) << u)) != 0 { pl.SetPassed(site, u, typed.Scope.Region(site)) }
        }
        for j in range call.Args.Len() {
            u := f.paramVar(oc.Callee, j)
            if u < 0 or u >= 63 or (set & (I64(1) << u)) == 0 or j == oc.Param: continue
            a := call.Args[j]
            t2 := f.topSite(a)
            if t2 >= 0 and pl.RegionKind[t2] == 1 {
                pl.RegionParent[t2] = typed.Scope.Region(site)
            } else {
                f.redirect(oc.Body, a, oc.Site, at, false)
            }
        }
    }
}

# the variables of a call given a value of a sole place in argument v's variable: v, and those of the arguments that
# are temporaries built at the same scope - none of the call's result's, nor of any other argument's existing storage
# - -1 where the callee's obligations ask more
fn (f mut Free&) orVars(b I64, c typed.Call&, b2 I64, at typed.Scope, v I64) I64 {
    if v < 0 or v >= 63 { return -1 }
    pl := f.Plans.Ref(b)
    set := I64(1) << v
    for j in range c.Args.Len() {
        u := f.paramVar(b2, j)
        if u < 0 or u >= 63 or u == v: continue
        if pl.Passed(c.Site, u) == at and f.topSite(c.Args[j]) >= 0 and f.builtAt(b, c.Args[j]) == at {
            set = set | (I64(1) << u)
        }
    }
    rels := f.Sc.VarRels(b2)
    return set if f.relsFit(rels, set) else -1
}

# the call at a site of a body, found by walking it
fn (f mut Free&) callAt(b I64, site I64) typed.Call?& {
    body := f.Bodies[b]
    if body.Root is null { return null }
    return findCallBlock(body.Root!, site)
}

fn findCallBlock(bl typed.Block&, site I64) typed.Call?& {
    for st in bl.Stmts {
        c := findCallStmt(st, site)
        if c is not null: return c
    }
    return null
}

fn findCallStmt(st typed.Stmt&, site I64) typed.Call?& {
    return match st {
        case typed.Stmt.Let(_, _, x): findCall(x, site)
        case typed.Stmt.Assign(_, p, x): findCall(x, site) if findCall(x, site) is not null else findCallPlace(p, site)
        case typed.Stmt.Eval(_, x): findCall(x, site)
        case typed.Stmt.If(_, i): findIf(i, site)
        case typed.Stmt.Loop(_, body, post): findCallBlock(body, site) if findCallBlock(body, site) is not null else (findCallBlock(post, site) if post is not null else null)
        case typed.Stmt.Return(_, x), typed.Stmt.Suspend(_, x): findCall(x, site) if x is not null else null
        case typed.Stmt.Block(_, b): findCallBlock(b, site)
        case typed.Stmt.Defer(_, b): findCallBlock(b, site)
        case _: null
    }
}

fn findIf(i typed.If&, site I64) typed.Call?& {
    c := findCall(i.Test, site)
    if c is not null { return c }
    c = findCallBlock(i.Then, site)
    if c is not null { return c }
    if i.Else is not null { return findCallBlock(i.Else!, site) }
    return null
}

fn findCallPlace(p typed.Lvalue&, site I64) typed.Call?& {
    return match p {
        case typed.Lvalue.Deref(_, _, r): findCall(r, site)
        case typed.Lvalue.Field(_, _, b, _): findCallPlace(b, site)
        case typed.Lvalue.Elem(_, _, e): findCallPlace(e.Base, site) if findCallPlace(e.Base, site) is not null else findCall(e.Index, site)
        case _: null
    }
}

fn findCall(x typed.Expr&, site I64) typed.Call?& {
    match x {
        case typed.Expr.Call(_, _, c) {
            if I64(c.Site) == site { return c }
            for a in c.Args {
                d := findCall(a, site)
                if d is not null: return d
            }
            match c.Target {
                case typed.Callee.Value(v) { return findCall(v, site) }
                case _ { }
            }
            return null
        }
        case typed.Expr.Promote(_, _, pr) { return findCall(pr.X, site) }
        case typed.Expr.Read(_, _, p, _) { return findCallPlace(p, site) }
        case typed.Expr.Borrow(_, _, p) { return findCallPlace(p, site) }
        case typed.Expr.Make(_, _, m) {
            for a in m.Items {
                d := findCall(a, site)
                if d is not null: return d
            }
            return null
        }
        case typed.Expr.Prim(_, _, _, _, args) {
            for a in args {
                d := findCall(a, site)
                if d is not null: return d
            }
            return null
        }
        case typed.Expr.Try(_, _, t) {
            if t.X is not null { return findCall(t.X!, site) }
            return null
        }
        case typed.Expr.Seq(_, _, q) {
            for st in q.Stmts {
                d := findCallStmt(st, site)
                if d is not null: return d
            }
            if q.X is not null { return findCall(q.X!, site) }
            return null
        }
        case typed.Expr.Cond(_, _, c) {
            d := findCall(c.C, site)
            if d is not null { return d }
            if c.A is not null {
                d = findCall(c.A!, site)
                if d is not null { return d }
            }
            return findCall(c.B, site)
        }
        case typed.Expr.Away(_, _, y) { return findCall(y, site) }
        case _ { return null }
    }
}

# the site a value made for a place is built at, -1 for none
fn (f mut Free&) topSite(x typed.Expr&) I64 {
    return match x {
        case typed.Expr.Promote(_, _, pr): I64(pr.Site)
        case typed.Expr.Make(_, _, m): I64(m.Site)
        case typed.Expr.Text(_, _, tx): I64(tx.Site)
        case typed.Expr.Collect(_, _, c): I64(c.Site)
        case typed.Expr.Call(_, _, c): I64(c.Site)
        case typed.Expr.Away(_, _, y): f.topSite(y)
        # a sequence's value (a lane operation's result, E39): its statements run where it stands, its value built at
        # its own site
        case typed.Expr.Seq(_, _, sq): f.topSite(sq.X!) if sq.X is not null else -1
        case _: -1
    }
}

# a value built in the region of site top: its own site, and its parts the plan builds where it was built (at) -
# through a temporary's value, an array's items, a constructor's arguments - so the region holds them; never through
# a branch or a call that is not a constructor's
fn (f mut Free&) redirect(b I64, x typed.Expr&, top I64, at typed.Scope, self Bool, copied Bool = false) {
    pl := f.Plans.RefMut(b)
    region := typed.Scope.Region(typed.SiteId(I32(top)))
    # a part with a region of its own (another place's value, written first) is a kid of this one
    ps := f.topSite(x)
    if not self and ps >= 0 and ps != top and pl.RegionKind[ps] == 1 {
        if pl.RegionParent[ps] == at { pl.RegionParent[ps] = region }
        return
    }
    match x {
        case typed.Expr.Promote(_, _, pr) {
            if self or pl.Built[I64(pr.Site)] == at { pl.Built[I64(pr.Site)] = region }
            f.redirect(b, pr.X, top, at, false, true)
        }
        case typed.Expr.Make(_, _, m) {
            if m.Site >= typed.SiteId(0) and (self or pl.Built[I64(m.Site)] == at) { pl.Built[I64(m.Site)] = region }
            for it in m.Items { f.redirect(b, it, top, at, false) }
        }
        case typed.Expr.Text(_, _, tx) {
            if self or pl.Built[I64(tx.Site)] == at { pl.Built[I64(tx.Site)] = region }
        }
        case typed.Expr.Collect(_, _, c) {
            if self or pl.Built[I64(c.Site)] == at { pl.Built[I64(c.Site)] = region }
        }
        case typed.Expr.Call(_, _, c) {
            b2 := typed.CalleeBody(c)
            if b2 < 0 or c.Site < typed.SiteId(0) or f.Bodies[b2].Root is null { return }
            rv := f.resultVar(b2)
            # a constructor's instance is part of the value; a call's result copied by a promotion is garbage in it
            ctor := f.T().Role(f.Bodies[b2].Ty) == types.RoleCtor
            if not self and not ctor and not copied { return }
            if not self and pl.Passed(c.Site, rv) != at { return }
            set := f.varsFit(b, c, b2, at, rv)
            if set < 0 { return }
            for u in range 63 {
                if (set & (I64(1) << u)) != 0 { pl.SetPassed(c.Site, u, region) }
            }
            for j in range c.Args.Len() {
                u := f.paramVar(b2, j)
                if u >= 0 and u < 63 and (set & (I64(1) << u)) != 0 { f.redirect(b, c.Args[j], top, at, false) }
            }
        }
        case typed.Expr.Away(_, _, y) { f.redirect(b, y, top, at, self, copied) }
        # a sequence's value is built in the region, its statements where they stand
        case typed.Expr.Seq(_, _, sq) {
            if sq.X is not null { f.redirect(b, sq.X!, top, at, self, copied) }
        }
        case _ { }
    }
}

# ---- what lowering asks ----

NotSole I64 = -2

# whether place k is decided sole: what it lets go of is freed at once
fn (f Free&) IsSole(k I64) Bool { return f.Done and k >= 0 and k < f.Sole.Len() and f.Sole[k] }

# whether a body's code frees early where its places are decided sole: every body's, once the analysis ran - its sites
# read each decision as a link-time constant (mir.Rvalue.Sole), so a module's code is the same in every program
fn (f Free&) Frees(b I64) Bool { return f.Done and b >= 0 and b < f.Bodies.Len() }

# the guard of place k's sites in body b: -1 where the body's code has the decisions as they are, else k (Guard)
fn (f Free&) guard(b I64, k I64) I64 { return -1 if f.decided[b] else k }

# what body b's code reads of place k's decision: NotSole where it is decided not sole in code that has the decisions
# as they are, -1 where it is decided sole there, else k - read as a link-time constant (mir.Rvalue.Sole)
fn (f Free&) Guard(b I64, k I64) I64 {
    if k < 0 or b < 0 or b >= f.decided.Len() or not f.decided[b] { return k }
    return -1 if f.IsSole(k) else NotSole
}

# the candidate place a place is, -1 for none: what its let-go releases where it is decided sole
fn (f mut Free&) PlaceOf(p typed.Lvalue&) I64 {
    if not f.Done { return -1 }
    return f.placeOfPlace(p)
}

# the places decided sole, for the root's decisions object
fn (f Free&) SoleNow() Vec<I64> {
    out Vec<I64>
    if not f.Done { return out }
    for k in range f.Sole.Len() {
        if f.Sole[k]: out.Push(k)
    }
    return out
}

# a place's key, which names its constant: the struct type and field position (an array type's elements: -1)
fn (f Free&) PlaceKey(k I64) types.TypeId, I64 { return f.keyTy[k], f.keyField[k] }

# an owner local place's body and local, -1 and -1 for any other place
# a global place's module and name, -1, -1 for any other place
fn (f Free&) GlobalPlace(k I64) I64, I64 {
    if not f.isGlobal(k) { return -1, -1 }
    return f.glModule[k], f.glName[k]
}

fn (f Free&) LocalPlace(k I64) I64, I64 {
    if not f.isOwnLocal(k) { return -1, -1 }
    return f.olBody[k], f.olLocal[k]
}

# D9h: whether the constructor call at site of body b is one whose copy is left out (freshAt)
fn (f Free&) FreshCtorAt(b I64, site I64) Bool { return f.freshAt.Has(pair.Pair(b, site)) }

# a feeder of body b (findFeeds): the site of its copy, which lowering moves (D9i) where the site its declaration's
# value is built at has a region of its own in the plan - -1 for a local that is none
fn (f Free&) FeedCopy(b I64, l I64) I64 {
    if not f.Done: return -1
    i := try f.feedOf.Get(pair.Pair(b, l)) catch default -1
    return f.feeds[i].Copy if i >= 0 and f.feeds[i].Site >= 0 else -1
}

# ...and the site its declaration's value is built at, -1 for none
fn (f Free&) FeedSite(b I64, l I64) I64 {
    if not f.Done: return -1
    i := try f.feedOf.Get(pair.Pair(b, l)) catch default -1
    return f.feeds[i].Site if i >= 0 else -1
}

# the path of the owner leaf a copy made at site of body b is split for (splitLeaf): its part built in the site's
# region, the rest where the region's parent is - empty for none
fn (f Free&) SplitPath(b I64, site I64) Array<I64> {
    if not f.Done: return Array<I64>(0)
    return try f.splitAt.Get(pair.Pair(b, site)) catch default Array<I64>(0)
}

# the owner local place local l of body b is, -1 for none
fn (f mut Free&) LocalPlaceOf(b I64, l I64) I64 {
    if not f.Done or b < 0 or b >= f.olIn.Len() or not f.olIn[b] { return -1 }
    return try f.ownLocalOf.Get(pair.Pair(b, l)) catch default -1
}

# the candidate places inside a value of type ty held in place, by the fields that reach them - and for a handle the
# reference it holds, field 0
fn (f mut Free&) Leaves(ty types.TypeId) Vec<leaf> {
    out Vec<leaf>
    if not f.Done { return out }
    return f.leaves(ty)
}

fn (f Free&) IsHandle(k I64) Bool { return k >= 0 and k < f.handle.Len() and f.handle[k] }

# the array places a retire() (M19d) in body b at sp is left out for, where one of them is decided sole: its array is
# the old value of that place, released as it was replaced - no view of it is used after (condition 6)
fn (f mut Free&) RetirePlaces(b I64, sp source.Span) Vec<I64> {
    out Vec<I64>
    if not f.Done { return out }
    for r in f.retires {
        if r.Body != b or r.Sp != sp: continue
        for y in r.Orig {
            if okind(y) == OPl and f.arr[oval(y)]: addTo(out, oval(y))
        }
    }
    return out
}

# whether a candidate place holds an owner (types.Anchors): its let-go releases the region its anchors name
fn (f Free&) IsOwner(k I64) Bool { return k >= 0 and k < f.owner.Len() and f.owner[k] }

# the place a dropped call's result is a value moved out of - what lowering releases after the statement where it is
# decided sole - -1 for none
fn (f mut Free&) DroppedMove(c typed.Call&) I64 {
    if not f.Done { return -1 }
    b2 := typed.CalleeBody(c)
    if b2 < 0 or f.Bodies[b2].Root is null { return -1 }
    m := f.mustRes[b2]
    if m < MovBase { return -1 }
    return m - MovBase
}

# ---- the report (B18): the places that keep what they let go of, and why ----

# the removals of the prelude's collections a program writes: a let-go in the prelude reported where the program calls
# one (2.8) - an insertion that may replace (Put) is no removal
RemovalNames Array<String&> = Array<String&>["Pop", "TakeAt", "RemoveAt", "SwapRemove", "Remove", "Clear", "Truncate", "Take"
    "SwapTake"]

# whether a let-go is one the report shows: in the program's own code, an assignment, a vacate, a moved value dropped,
# or a call of one of the program's functions or of a prelude removal
fn (f mut Free&) shown(g letGo) Bool {
    if not f.programCode[g.Body] { return false }
    if g.Kind != LCall { return true }
    if g.Callee < 0 { return false }
    if f.programCode[g.Callee] { return true }
    nm := f.fnName(g.Callee)
    for r in RemovalNames {
        if r == nm: return true
    }
    return false
}

# the report: a row for each place that keeps, a note naming why, and a count
fn (f mut Free&) Report() String {
    d := f.P.L.Diags
    b := StringBuilder()
    places I64 = 0
    kept I64 = 0
    rows Vec<String&>
    for k in range f.keyTy.Len() {
        if not f.reported(k): continue
        # the row is at the place's own let-go - an assignment, a vacate, a value dropped - where there is one, else at
        # the first call that lets go of it
        first := -1
        # ...its own: a call that may let go of anything names no place (its row, a view's, is said below)
        for g in range f.goes.Len() {
            if f.goes[g].PlaceId != k or not f.shown(f.goes[g]) or not f.goes[g].Again: continue
            if first < 0 or f.rowBefore(f.goes[g], f.goes[first]): first = g
        }
        if first < 0: continue
        places++
        if f.IsSole(k): continue
        kept++
        row := first
        if f.whyKind[k] == RView { row = try f.viewGo.Get(k) catch default first }
        g := f.goes[row]
        at := f.lineStart(g.File, I64(g.At.Start))
        # a row at a call - one that may let go of anything too - says the place as its own let-go writes it
        if g.Kind == LCall and f.goes[first].Kind != LCall { g = f.goes[first] }
        what := ""
        if (f.keyField[k] < 0 and not f.isNamed(k)) or f.isContents(k) {
            what = $"removed elements of '" $f.collection(k, g.Body, g) "' are kept until " $f.scopeName(g, k) " closes"
        } else {
            what = $"'" $f.placeName(g) "' keeps what it lets go of until " $f.scopeName(g, k) " closes"
        }
        r := f.why[k]
        why := r.Text
        if f.whyKind[k] == RNone { why = "it is let go of only inside calls that may let go of any place" }
        where := $d.Locate(r.File, I64(r.Sp.Start)) if r.File >= 0 else $d.Locate(g.File, at)
        # one row a cause: places let go of together, kept for one reason, are one row
        text := $d.Locate(g.File, at) ": memory: " $what "\n" $where ": note: " $why "\n"
        if text not in rows {
            rows.Push($text)
            b.Push(text)
        }
    }
    if places == 0 {
        b.Push("memory: no place lets go of storage in code that runs again\n")
        return b.ToString()
    }
    frees := places - kept
    b.Push($"memory: " $places " place" $("" if places == 1 else "s") " let" $("s" if places == 1 else "") " go of storage in code that runs again - " $frees " free" $("s" if frees == 1 else "") " it at once, " $kept " keep" $("s" if kept == 1 else "") " it" $(" (above)" if kept > 0 else "") "\n")
    return b.ToString()
}

# whether place k is what a collection holds: vacated by the library's code
fn (f mut Free&) isContents(k I64) Bool {
    if f.libTaken[k] { return true }
    for g in f.goes {
        if g.PlaceId == k and g.Kind == LVacate and not f.programCode[g.Body]: return true
    }
    return false
}

# whether the report speaks of place k: storage made for it - it owns what it lets go of - and the program's: a field
# of a type the program declares, or what a collection holds, which the library's removals let go of
fn (f mut Free&) reported(k I64) Bool {
    owns := false
    for st in f.stores {
        if st.PlaceId == k and (st.Site >= 0 or st.Kind == SFresh or st.Kind == SMove): owns = true
    }
    if not owns { return false }
    if f.isContents(k) { return true }
    if f.isOwnLocal(k) { return true }
    if f.isGlobal(k) {
        m := f.glModule[k]
        return m >= 0 and m < f.P.L.Mods.Len() and not f.P.L.Mods[m].Identity.StartsWith("std/")
    }
    if f.keyField[k] < 0 { return false }
    t := f.T()
    r := t.Repr(f.keyTy[k])
    if t.KindOf(r) != types.Kind.Named { return false }
    m := t.DeclModule(t.DeclOf(r))
    return m >= 0 and m < f.P.L.Mods.Len() and not f.P.L.Mods[m].Identity.StartsWith("std/")
}

fn (f mut Free&) rowBefore(a letGo, b letGo) Bool {
    if (a.Kind == LCall) != (b.Kind == LCall) { return b.Kind == LCall }
    return f.before(a, b)
}

fn (f mut Free&) before(a letGo, b letGo) Bool {
    if a.File != b.File { return a.File < b.File }
    return a.At.Start < b.At.Start
}

# where the line holding offset at begins its text: its first character that is no space
fn (f mut Free&) lineStart(file I64, at I64) I64 {
    t := f.P.L.Diags.TextOf(file)
    a := at
    for a > 0 and t[a - 1] != '\n' { a-- }
    for a < t.Len() and (t[a] == ' ' or t[a] == '\t') { a++ }
    return a
}

# the place a row is about, as the program writes it: an assignment's or a vacate's place, else the call
fn (f mut Free&) placeName(g letGo) String { return f.textOf(g.File, g.Sp) }

# a call's receiver as written, "" for none
fn (f mut Free&) recvOf(g letGo) String { return f.textOf(g.File, g.RecvSp) }

# the collection whose elements a row is about: the receiver of a removal of the place in the same body, else of the
# row's own call
fn (f mut Free&) collection(k I64, b I64, row letGo) String {
    for g in f.goes {
        if g.PlaceId == k and g.Body == b and g.Kind != LAssign and g.Callee >= 0 and not f.programCode[g.Callee] {
            r := f.recvOf(g)
            if r != "": return r
        }
    }
    r := f.recvOf(row)
    return r if r != "" else "its elements"
}

# the scope a row's place keeps until: the scope of what its expression starts from - a parameter's referent's, as
# its type names it ("the Server's scope"), or a local's function's ("main's scope")
fn (f mut Free&) scopeName(g letGo, k I64) String {
    rv := f.recvOf(g)
    if f.isGlobal(k) { return "the program's scope" }
    text := rv if f.keyField[k] < 0 and rv != "" and not f.isNamed(k) else f.placeName(g)
    if f.keyField[k] < 0 and not f.isNamed(k) {
        for g2 in f.goes {
            if g2.PlaceId == k and g2.Body == g.Body {
                r2 := f.recvOf(g2)
                if r2 != "": text = r2
            }
        }
    }
    n := 0
    for n < text.Len() and (text[n].IsLetter() or text[n].IsDigit() or text[n] == '_') { n++ }
    root := text[:n]
    body := f.Bodies[g.Body]
    t := f.T()
    for l in range body.Locals.Len() {
        if f.P.L.Names.Text(body.Locals[l].Name) != root: continue
        isParam := false
        for p in body.Params {
            if I64(p) == l: isParam = true
        }
        if isParam {
            ty := t.Repr(body.Locals[l].Ty)
            if t.IsRef(ty) { ty = t.Repr(t.Referent(ty)) }
            if t.KindOf(ty) == types.Kind.Named { return $"the " $f.P.L.Names.Text(t.DeclName(t.DeclOf(ty))) "'s scope" }
        }
        return $f.fnName(g.Body) "'s scope"
    }
    return "its scope"
}

# every candidate place and its decision, for debugging the analysis (OLANG_FREEDUMP)
fn (f mut Free&) Dump() String {
    b := StringBuilder()
    t := f.T()
    for k in range f.keyTy.Len() {
        lets I64 = 0
        for g in f.goes {
            if g.PlaceId == k: lets++
        }
        sto I64 = 0
        for st in f.stores {
            if st.PlaceId == k: sto++
        }
        nm := f.Sc.Spell!(f.keyTy[k]) if f.Sc.Spell is not null else $t.Canon(f.keyTy[k])
        b.Push($"place " $k " " $nm "." $f.keyField[k] $(" handle" if f.handle[k] else "") " sole " $f.IsSole(k) " lets " $lets " stores " $sto " why " $f.whyKind[k] " " $f.why[k].Text "\n")
    }
    for st in f.stores {
        b.Push($"store place " $st.PlaceId " body " $st.Body " kind " $st.Kind " site " $st.Site " at " $f.P.L.Diags.Locate(st.File, I64(st.Sp.Start)) "\n")
    }
    for g in f.goes {
        b.Push($"letgo place " $g.PlaceId " body " $g.Body " kind " $g.Kind " at " $f.P.L.Diags.Locate(g.File, I64(g.Sp.Start)) " " $f.placeName(g) "\n")
    }
    for i in range f.Bodies.Len() {
        if f.parStored[i].Len() == 0 and f.parEsc[i].Len() == 0 and f.parMulti[i].Len() == 0 and f.parWhole[i].Len() == 0: continue
        b.Push($"body " $i " " $f.fnName(i) " stored " $f.parStored[i] " esc " $f.parEsc[i] " multi " $f.parMulti[i] " whole " $f.parWhole[i] " res " $f.resFrom[i] "\n")
    }
    b.Push($"tasks " $f.tasks " hidden " $f.hidden "\n")
    return b.ToString()
}

# the parameter every value of an expression is reached from - through fields, elements, references and borrowed
# results - given what each local's every value is reached from, a must-fact: MustNone where it is not one parameter's
fn (f mut Free&) withinExpr(locals Vec<I64>&, x typed.Expr&) I64 {
    t := f.T()
    match x {
        case typed.Expr.Lit(_, _, _) { return MustTop }
        case typed.Expr.Read(_, _, p, _) { return f.withinPl(locals, p) }
        case typed.Expr.Borrow(_, _, p) { return f.withinPl(locals, p) }
        case typed.Expr.Call(_, _, c) {
            b2 := typed.CalleeBody(c)
            if b2 < 0 or f.Bodies[b2].Root is null or t.Results(f.Bodies[b2].Ty).Len() != 1 { return MustNone }
            e := t.ResultFrom(f.Bodies[b2].Ty, 0)
            if e < 0 or e >= c.Args.Len() { return MustNone }
            return f.withinExpr(locals, c.Args[e])
        }
        case typed.Expr.Try(_, _, tr) {
            if tr.X is null { return MustNone }
            for cl in tr.Clauses {
                if cl.Defaults.Len() > 0: return MustNone
            }
            return f.withinExpr(locals, tr.X!)
        }
        case typed.Expr.Away(_, _, y) { return f.withinExpr(locals, y) }
        case typed.Expr.Prim(_, _, op, _, args) { return f.withinExpr(locals, args[0]) if isConversion(op, args) else MustNone }
        case _ { return MustNone }
    }
}

fn (f mut Free&) withinPl(locals Vec<I64>&, p typed.Lvalue&) I64 {
    return match p {
        case typed.Lvalue.Local(_, _, l): locals[I64(l)] if I64(l) < locals.Len() else MustNone
        case typed.Lvalue.Field(_, _, b, _): f.withinPl(locals, b)
        case typed.Lvalue.Elem(_, _, e): f.withinPl(locals, e.Base)
        case typed.Lvalue.Payload(_, _, pl): f.withinPl(locals, pl.Base)
        case typed.Lvalue.Deref(_, _, r): f.withinExpr(locals, r)
        case _: MustNone
    }
}

# the parameter every storage of a place of body b is reached from, after the must-summaries
fn (f mut Free&) withinPlace(b I64, p typed.Lvalue&) I64 { return f.withinPl(f.withinLocals[b], p) }
