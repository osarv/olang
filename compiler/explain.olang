# explain - one top-level item of a checked program as the compiler sees it (B11b): what `olang explain FILE NAME`
# prints. A function's whole signature - an inferred error set written out (R1a) - and its scope obligations (O10b),
# each instance of a generic one; a type's constructor, fields, methods and the traits it meets; an enum's cases, an
# error type's words, a trait's methods; a global's type and its value where it is baked (K2)

import "source"
import "ast"
import "types"
import "generic"
import "typed"
import "names"
import "scope"
import "interp"
import typecheck "check"

# a name the root module does not declare
type Missing error { Name }

# the item name names in module mi - "Type.Method" for a method - as text ending in a line break
fn Item(c mut typecheck.Checker&, sc scope.Scoper&, x mut interp.Exec&, mi I64, name String&) String ? Missing {
    c.SpellFrom(mi)
    nm := c.P.L.Names
    dot := try name.Find(".") catch default -1
    if dot > 0 {
        d := typeNamed(c, mi, name[:dot])
        if d < types.DeclId(0) { error Missing.Name }
        f := c.P.MethodOf(c.P.SelfType(d), nm.Intern(name[dot + 1:]))
        if f < 0 { error Missing.Name }
        return fnItem(c, sc, f)
    }
    id := nm.Intern(name)
    for e in c.P.R.Tables[mi].Entries {
        if e.Name != id { continue }
        if e.Kind == names.What.Func {
            f := c.P.FnNamed(mi, id)
            if f >= 0 { return fnItem(c, sc, f) }
        }
        if e.Kind == names.What.Global { return globalItem(c, x, mi, e) }
    }
    d := typeNamed(c, mi, name)
    if d >= types.DeclId(0) { return typeItem(c, d) }
    error Missing.Name
}

fn typeNamed(c mut typecheck.Checker&, mi I64, name String&) types.DeclId {
    ei := c.P.TypeEntry(mi, c.P.L.Names.Intern(name))
    return types.DeclId(-1) if ei < 0 else c.P.DeclFor(mi, ei)
}

# ---- functions ----

# a function or method as explain prints it, by its index in the program's functions (doc's methods of built-in types)
fn FnText(c mut typecheck.Checker&, sc scope.Scoper&, f I64) String { return fnItem(c, sc, f) }

fn fnItem(c mut typecheck.Checker&, sc scope.Scoper&, f I64) String {
    b := StringBuilder()
    attrLines(b, c, c.P.FnModule(f), c.P.FnDecl(f).Attrs, "")
    owner := generic.FnOwner(f)
    if c.P.VarCount(owner) == 0 {
        inst := c.P.FnInstance(f, types.ListId(0))
        body := c.BodyOfInstance(inst)
        b.Push($fnLine(c, f, c.P.InstanceSig(inst), body) "\n")
        contract(b, c, c.P.FnDecl(f).S, c.P.FnModule(f), "    ")
        obligations(b, c, sc, body, "    ")
        return b.ToString()
    }
    b.Push($fnLine(c, f, c.P.Sig(f), -1) "\n")
    contract(b, c, c.P.FnDecl(f).S, c.P.FnModule(f), "    ")
    decl := c.P.FnDecl(f)
    for i in range c.P.InstanceCount() {
        if c.P.InstanceFn(i) != f { continue }
        body := c.BodyOfInstance(i)
        if body < 0 { continue }
        sig := named(c, c.P.InstanceSig(i), decl.Recv, decl.S.Params)
        b.Push($"    instance " $c.P.L.Names.Text(decl.Name) $typeArgs(c, c.P.InstanceArgs(i)) ": " $sigOf(c, sig, body) "\n")
        obligations(b, c, sc, body, "        ")
    }
    return b.ToString()
}

# a function's signature as a declaration writes it: "fn (recv) Name<vars>(params) results ? errors", its errors those
# its body can fail with where they are inferred
fn fnLine(c mut typecheck.Checker&, f I64, sig types.TypeId, body I64) String {
    decl := c.P.FnDecl(f)
    name := $c.P.L.Names.Text(decl.Name) $typeVars(c, generic.FnOwner(f), receiverVars(c, f))
    text := sigOf(c, named(c, sig, decl.Recv, decl.S.Params), body)
    if c.P.IsGenerator(f) {
        # D18: its result as written, the Generator a call gives said beside it
        g := c.Ty(c.P.T.Result(sig))
        if text.EndsWith(g) and g.StartsWith("Generator") {
            text = $text[:text.Len() - g.Len()] "Iterator" $g[9:] "   # a generator: a call gives a " $g
        } else if text.EndsWith(g) and g.StartsWith("ViewGenerator<") {
            # D18c: its elements borrowed - "&p" or "&return" after the element's type, as it is written
            el := c.P.GenElem(f)
            sc := $"return"
            if el >= 0 {
                k := el
                if decl.Recv is not null {
                    if k == 0 { sc = $c.P.L.Names.Text(decl.Recv!.Name) }
                    k--
                }
                if k >= 0 and k < decl.S.Params.Len() { sc = $c.P.L.Names.Text(decl.S.Params[k].Name) }
            }
            args := g[13:]
            depth I64 = 0
            at := args.Len() - 1
            for i in range 1, args.Len() {
                ch := args[i]
                if ch == '<' or ch == '(' { depth++ }
                if (ch == '>' or ch == ')') and depth > 0 {
                    depth--
                    continue
                }
                if depth == 0 and (ch == '>' or ch == ',' or (ch == ' ' and i + 1 < args.Len() and args[i + 1] == '?')) {
                    at = i
                    break
                }
            }
            text = $text[:text.Len() - g.Len()] "Iterator" $args[:at] "&" $sc $args[at:] "   # a generator: a call gives a " $g
        }
    }
    lead := "extern fn " if c.P.FnIsExtern(f) else "fn "
    # D8a: each defaulted parameter with its default as the declaration writes it
    close := firstClose(text)
    inside := $withDefaults(c, text[3:close], decl.S.Params, c.P.FnModule(f), 1 if decl.Recv is not null else 0) $text[close:]
    if decl.Recv is null { return $lead $name "(" $inside }
    end := firstItemEnd(inside)
    recv := inside[:end]
    rest := inside[end + 2:] if inside[end] == ',' else inside[end:]
    return $lead "(" $recv ") " $name "(" $rest
}

# a function type carrying the names its declaration gives its parameters, the receiver's first
fn named(c mut typecheck.Checker&, sig types.TypeId, recv ast.Param?&, params Array<ast.Param&>&) types.TypeId {
    ids Vec<I64>
    if recv is not null { ids.Push(I64(recv.Name)) }
    if params.Len() > 0 {
        for p in params { ids.Push(I64(p.Name)) }
    }
    if ids.Len() != c.P.T.Items(c.P.T.Params(sig)).Len() { return sig }
    return c.P.T.WithNames(sig, c.P.T.ParamNames(ids.ToArray()))
}

# an instance's type arguments, "<I64, F64>"
fn typeArgs(c mut typecheck.Checker&, args types.ListId) String {
    b := StringBuilder()
    b.PushChar('<')
    k I64 = 0
    for a in c.P.T.Items(args) {
        # QAH: an error-set argument after "?", left out where it is the empty set
        if c.P.T.KindOf(a) == types.Kind.ErrSet {
            if c.P.T.ErrSetItems(a) != types.ListId(0) { b.Push($(" ? " if k > 0 else "? ") $c.Ty(a)) }
            continue
        }
        if k > 0 { b.Push(", ") }
        b.Push(c.Ty(a))
        k++
    }
    b.PushChar('>')
    return b.ToString()
}

# a function type as the checker spells it, its error set replaced by the inferred one where it is "?" alone
fn sigOf(c mut typecheck.Checker&, sig types.TypeId, body I64) String {
    if body < 0 or not c.InfersErrors(sig) { return c.Ty(sig) }
    errs := c.ErrorsOf(body)
    full := c.P.T.Func(c.P.T.Params(sig), c.P.T.Result(sig), errs, c.P.T.ScopesOf(sig), c.P.T.NamesIdOf(sig))
    return $c.Ty(full) "   # its error set inferred"
}

# a parameter list as the checker spells it (its parentheses left off), each defaulted parameter followed by " = " and
# its default as module mi's source writes it (D8a); skip items come first that are no declared parameter (a receiver)
fn withDefaults(c mut typecheck.Checker&, list String&, params Array<ast.Param&>&, mi I64, skip I64) String {
    if params.Len() == 0 or mi < 0 { return $list }
    src := c.P.L.Mods[mi].Src!.Text
    b := StringBuilder()
    rest := list
    k I64 = 0
    for rest.Len() > 0 {
        end := firstItemEnd(rest)
        b.Push(rest[:end])
        j := k - skip
        if j >= 0 and j < params.Len() and params[j].Dflt is not null {
            dsp := params[j].Dflt!.Span()
            b.Push($" = " $src[I64(dsp.Start):I64(dsp.End)])
        }
        k++
        if end >= rest.Len() { break }
        b.Push(rest[end:end + 1])
        rest = rest[end + 1:]
    }
    return b.ToString()
}

# where the first item of a list spelled from inside its "(" ends: at a comma or the ")" outside every bracket
fn firstItemEnd(s String&) I64 {
    depth I64 = 0
    for i in range s.Len() {
        ch := s[i]
        if ch == '(' or ch == '<' or ch == '[' { depth++ }
        if (ch == ')' or ch == '>' or ch == ']') and depth > 0 {
            depth--
            continue
        }
        if depth == 0 and (ch == ',' or ch == ')') { return i }
    }
    return s.Len()
}

# written types as the source writes them, joined by ", "
fn listed(src String&, ts Array<ast.TypeRef&>&) String {
    b := StringBuilder()
    for t in ts {
        if b.Len() > 0 { b.Push(", ") }
        b.Push(src[I64(t.Span().Start):I64(t.Span().End)])
    }
    return b.ToString()
}

# an owner's type variables as its declaration introduces them, "<T Shape, U>", nothing for none
fn typeVars(c mut typecheck.Checker&, owner I64, skip I64) String {
    n := c.P.VarCount(owner)
    if n <= skip { return "" }
    b := StringBuilder()
    b.PushChar('<')
    for i in range skip, n {
        v := c.P.VarAt(owner, i)
        # G1a: an error-set parameter closes the list after "?"
        if c.P.ErrVarAt(owner, i) {
            b.Push($(" ? " if i > skip else "? ") $c.P.L.Names.Text(v.Name))
            continue
        }
        if i > skip { b.Push(", ") }
        b.Push(c.P.L.Names.Text(v.Name))
        if v.Const != types.UnknownT { b.Push($" " $c.Ty(v.Const)) }
        if v.Bound != types.UnknownT {
            for t in c.P.BoundTraits(v.Bound) { b.Push($" " $c.Ty(t)) }    # an intersection side by side (G19)
        }
    }
    b.PushChar('>')
    return b.ToString()
}

# how many of a method's variables its receiver's type arguments introduce (QW: Go's rule), written by the receiver
fn receiverVars(c mut typecheck.Checker&, f I64) I64 {
    if c.P.FnDecl(f).Recv is null { return 0 }
    recv := c.P.T.Items(c.P.T.Params(c.P.Sig(f)))[0]
    if c.P.T.KindOf(recv) == types.Kind.Ref { recv = c.P.T.Referent(recv) }
    if c.P.T.KindOf(recv) != types.Kind.Named { return 0 }
    return c.P.T.Items(c.P.T.Args(recv)).Len()
}

# a contract's conditions (D17), each as written in its brackets - its "outlives" chains are among the obligations
fn contract(b mut StringBuilder&, c mut typecheck.Checker&, s ast.Sig&, mi I64, indent String&) {
    if s.Commutes { b.Push($indent "# commutes: the operator applies with its operands the other way round too (E31c)\n") }
    if s.Contract is null { return }
    src := c.P.L.Mods[mi].Src!.Text
    for it in s.Contract!.Items { b.Push($indent "[" $src[I64(it.Span().Start):I64(it.Span().End)] "]\n") }
}

fn obligations(b mut StringBuilder&, c mut typecheck.Checker&, sc scope.Scoper&, body I64, indent String&) {
    if body < 0 { return }
    for o in sc.Obligations(body, c.P.L.Names) { b.Push($indent "[" $o "]\n") }
}

# ---- types ----

fn typeItem(c mut typecheck.Checker&, d types.DeclId) String {
    b := StringBuilder()
    self := c.P.SelfType(d)
    c.P.Body(self)
    td0 := c.P.TypeDecl(d)
    if td0 is not null { attrLines(b, c, c.P.DeclModule(d), td0.Attrs, "") }
    nm := c.P.L.Names
    name := $nm.Text(c.P.T.DeclName(d)) $typeVars(c, generic.DeclOwner(d), 0)
    match c.P.T.DeclKindOf(d) {
        case types.DeclKind.Foreign { return $"extern type " $name "\n" }
        case types.DeclKind.Error {
            # T19, T19a: its members as written, then its own words
            if c.P.IsRaisedError(d) { return $"error " $name "   # declared where it is raised (R3b)\n" }
            src := c.P.L.Mods[c.P.DeclModule(d)].Src!.Text
            b.Push($"type " $name " error")
            ms := c.P.ErrorMembers(d)
            for i in range ms.Len() { b.Push($(", " if i > 0 else " ") $src[I64(ms[i].Sp.Start):I64(ms[i].Sp.End)]) }
            b.Push("\n")
            for w in c.P.ErrorWords(d) { b.Push($"    " $nm.Text(w) "\n") }
            return b.ToString()
        }
        case types.DeclKind.Trait {
            td := c.P.TypeDecl(d)
            mi := c.P.DeclModule(d)
            src := c.P.L.Mods[mi].Src!.Text
            b.Push($"type " $name " trait")
            match td!.Body {
                case ast.TypeBody.Trait(_, exts, members) {
                    # what it extends (T30a) and the types it lists (T31a), as written
                    if exts.Len() > 0 { b.Push($" extends " $listed(src, exts)) }
                    if members.Len() > 0 { b.Push($" for " $listed(src, members)) }
                }
                case _ { }
            }
            b.Push("\n")
            match td!.Body {
                case ast.TypeBody.Trait(ms, _, _) {
                    for m in ms { b.Push($"    " $src[I64(m.Sp.Start):I64(m.Sp.End)].Trim() "\n") }
                }
                case _ { }
            }
            return b.ToString()
        }
        case types.DeclKind.Enum {
            b.Push($"type " $name " enum\n")
            cases := c.P.T.Items(c.P.T.Cases(self))
            ns := c.P.T.CaseNames(self)
            for k in range ns.Len() {
                b.Push("    ")
                b.Push(attrsBefore(c, c.P.Descriptor(generic.DescCase, self, k, 0)))
                b.Push(nm.Text(ns[k]))
                if k < cases.Len() and cases[k] != types.TypeId(0) {
                    if caseWhole(c.P.TypeDecl(d)!, k) {
                        # T17a: a payload written whole is its one type
                        b.Push($" " $c.Ty(c.P.T.Items(c.P.T.Params(c.P.CaseSig(self, k)))[0]))
                    } else {
                        sig := c.Ty(named(c, c.P.CaseSig(self, k), null, casePayload(c.P.TypeDecl(d)!, k)))
                        b.Push(sig[2:firstClose(sig) + 1])
                    }
                }
                b.PushChar('\n')
            }
        }
        case types.DeclKind.Over {
            b.Push($"type " $name $(" extends " if c.P.Extends(self) else " ") $c.Ty(c.P.T.Base(self)))
            # T29d: its constructor's parameter and errors
            match c.P.TypeDecl(d)!.Body {
                case ast.TypeBody.Over(_, ctor) {
                    if ctor is not null {
                        sig := c.Ty(named(c, c.P.CtorSig(self), null, ctor.S.Params))
                        close := firstClose(sig)
                        b.Push($sig[2:close + 1] $errorsAfter(sig[close + 1:]))
                    }
                }
                case _ { }
            }
            b.PushChar('\n')
        }
        case types.DeclKind.Struct {
            sig := c.Ty(named(c, c.P.CtorSig(self), null, ctorParams(c.P.TypeDecl(d)!)))
            close := firstClose(sig)
            ps := withDefaults(c, sig[3:close], ctorParams(c.P.TypeDecl(d)!), c.P.DeclModule(d), 0)
            b.Push($"type " $name " struct(" $ps ")" $errorsAfter(sig[close + 1:]) "\n")
            match c.P.TypeDecl(d)!.Body {
                case ast.TypeBody.Struct(sb) {
                    if sb.Errs is not null { contract(b, c, sb.Errs!, c.P.DeclModule(d), "    ") }
                }
                case _ { }
            }
            fields(b, c, self)
        }
    }
    builders(b, c, d)
    methods(b, c, self)
    traitsMet(b, c, self)
    return b.ToString()
}

fn casePayload(td ast.TypeDecl&, k I64) Array<ast.Param&>&td {
    match td.Body {
        case ast.TypeBody.Enum(cases, _) { return cases[k].Payload }
        case _ { return Array<ast.Param&>(0) }
    }
}

fn caseWhole(td ast.TypeDecl&, k I64) Bool {
    match td.Body {
        case ast.TypeBody.Enum(cases, _) { return cases[k].Whole }
        case _ { return false }
    }
}

fn ctorParams(td ast.TypeDecl&) Array<ast.Param&>&td {
    match td.Body {
        case ast.TypeBody.Struct(sb) { return sb.Params }
        case _ { return Array<ast.Param&>(0) }
    }
}

# where the parameter list of a function type's spelling ends: its ")"
fn firstClose(sig String&) I64 { return 3 + firstItemEndAll(sig[3:]) }

fn firstItemEndAll(s String&) I64 {
    depth I64 = 0
    for i in range s.Len() {
        ch := s[i]
        if ch == '(' or ch == '<' or ch == '[' { depth++ }
        if ch == ')' or ch == '>' or ch == ']' {
            if depth == 0 { return i }
            depth--
        }
    }
    return s.Len()
}

# G39: a declaration's attributes as written, a line each
fn attrLines(b mut StringBuilder&, c mut typecheck.Checker&, mi I64, attrs Array<ast.Attr&>&, indent String&) {
    if attrs.Len() == 0 { return }
    src := c.P.L.Mods[mi].Src!.Text
    for a in attrs { b.Push($indent $src[I64(a.Sp.Start):I64(a.Sp.End)] "\n") }
}

# G39: the attributes of what a descriptor names as written, each followed by a space - a field's, a case's
fn attrsBefore(c mut typecheck.Checker&, desc types.TypeId) String {
    mi, attrs := c.P.AttrsOf(desc)
    if mi < 0 or attrs.Len() == 0 { return "" }
    src := c.P.L.Mods[mi].Src!.Text
    b := StringBuilder()
    for a in attrs { b.Push($src[I64(a.Sp.Start):I64(a.Sp.End)] " ") }
    return b.ToString()
}

# " ? E" of what follows a constructor's parameters, nothing where it cannot fail
fn errorsAfter(rest String&) String {
    # outside every bracket: a result's type arguments may hold an error set of their own (QAH)
    depth I64 = 0
    for i in range rest.Len() {
        ch := rest[i]
        if ch == '(' or ch == '<' or ch == '[' { depth++ }
        if (ch == ')' or ch == '>' or ch == ']') and depth > 0 { depth-- }
        if depth == 0 and ch == '?' and i > 0 and rest[i - 1] == ' ' { return rest[i - 1:] }
    }
    return ""
}

# a struct's fields, as its constructor assembles them (C2a)
fn fields(b mut StringBuilder&, c mut typecheck.Checker&, self types.TypeId) {
    for body in c.Bodies {
        match body.Of {
            case typed.BodyOf.Ctor(t, twin) {
                # a generic type's fields named as any instance's constructor names them, typed as the type declares
                if c.P.T.KindOf(t) != types.Kind.Named or c.P.T.DeclOf(t) != c.P.T.DeclOf(self) or twin != types.ListId(0) { continue }
                tys := c.P.T.Items(c.P.T.Fields(self))
                src := c.P.L.Mods[c.P.DeclModule(c.P.T.DeclOf(self))].Src!.Text
                for k in range body.Fields.Len() {
                    loc := body.Locals[I64(body.Fields[k])]
                    ty := tys[k] if k < tys.Len() else loc.Ty
                    # a bare field (C2a) is named where it is written
                    n := src[I64(loc.Sp.Start):I64(loc.Sp.End)] if loc.Name == source.NameId(0) else c.P.L.Names.Text(loc.Name)
                    b.Push($"    " $attrsBefore(c, c.P.Descriptor(generic.DescField, self, 0, k)) $n " " $c.Ty(ty) "\n")
                }
                return
            }
            case _ { }
        }
    }
}

fn methods(b mut StringBuilder&, c mut typecheck.Checker&, self types.TypeId) {
    c.P.AllFns()
    for f in range c.P.FnCount() {
        decl := c.P.FnDecl(f)
        if decl.Recv is null or c.P.MethodOf(self, decl.Name) != f { continue }
        # its own, not one it inherits (T29f)
        recv := c.P.T.Items(c.P.T.Params(c.P.Sig(f)))[0]
        if c.P.T.KindOf(recv) == types.Kind.Ref { recv = c.P.T.Referent(recv) }
        if c.P.T.KindOf(recv) != types.Kind.Named or c.P.T.DeclOf(recv) != c.P.T.DeclOf(self) { continue }
        if c.P.VarCount(generic.FnOwner(f)) == 0 {
            inst := c.P.FnInstance(f, types.ListId(0))
            b.Push($"    " $fnLine(c, f, c.P.InstanceSig(inst), c.BodyOfInstance(inst)) "\n")
        } else {
            b.Push($"    " $fnLine(c, f, c.P.Sig(f), -1) "\n")
        }
    }
}

# the functions of the type's module that build one: top-level, with one result that is the type, a reference to it or a
# generic instance of it (B11b, the user's call 2026-10-25 - a type has one constructor, other ways to make a value are
# ordinary functions ending in a call to it), in the order the file declares them - the exported ones, or every one where
# all is true
fn Builders(c mut typecheck.Checker&, d types.DeclId, all Bool) Vec<I64> {
    out Vec<I64>
    mi := c.P.DeclModule(d)
    tab := c.P.R.Tables[mi]
    order Vec<I64>
    for ei in range tab.Entries.Len() {
        if tab.Entries[ei].Kind == names.What.Func { order.Push(ei) }
    }
    order.Sort(fn(a I64, b I64) Bool { return tab.Entries[a].Sp.Start < tab.Entries[b].Sp.Start })
    for ei in order {
        name := tab.Entries[ei].Name
        f := c.P.FnNamed(mi, name)
        if f < 0 or c.P.FnDecl(f).Recv is not null or c.P.FnIsExtern(f) { continue }
        text := $c.P.L.Names.Text(name)
        if not all and not (text.Len() > 0 and text[0].IsUpper()) { continue }
        if BuilderOf(c, f) == d { out.Push(f) }
    }
    return out
}

# the declared type a function builds (Builders), -1 for none: its one result's type, less a reference, where it is a
# struct, an enum or a type declared over another, declared by the function's own module
fn BuilderOf(c mut typecheck.Checker&, f I64) types.DeclId {
    none := types.DeclId(-1)
    rs := c.P.T.Results(c.P.Sig(f))
    if rs.Len() != 1 { return none }
    r := rs[0]
    if c.P.T.KindOf(r) == types.Kind.Ref { r = c.P.T.Referent(r) }
    if c.P.T.KindOf(r) != types.Kind.Named { return none }
    d := c.P.T.DeclOf(r)
    k := c.P.T.DeclKindOf(d)
    if k != types.DeclKind.Struct and k != types.DeclKind.Enum and k != types.DeclKind.Over { return none }
    return d if c.P.DeclModule(d) == c.P.FnModule(f) else none
}

# one line per builder, as methods are listed
fn builders(b mut StringBuilder&, c mut typecheck.Checker&, d types.DeclId) {
    for f in Builders(c, d, false) { b.Push($"    " $FnLine(c, f) "\n") }
}

# a function's first line as explain prints it, its instances left out
fn FnLine(c mut typecheck.Checker&, f I64) String {
    if c.P.VarCount(generic.FnOwner(f)) == 0 {
        inst := c.P.FnInstance(f, types.ListId(0))
        return fnLine(c, f, c.P.InstanceSig(inst), c.BodyOfInstance(inst))
    }
    return fnLine(c, f, c.P.Sig(f), -1)
}

# the traits with no type parameters the type meets, from every module of the program
fn traitsMet(b mut StringBuilder&, c mut typecheck.Checker&, self types.TypeId) {
    met Vec<String&>
    for mi in range c.P.R.Tables.Len() {
        tab := c.P.R.Tables[mi]
        for ei in range tab.Entries.Len() {
            if tab.Entries[ei].Kind != names.What.Type or tab.Entries[ei].Decl is null { continue }
            d := c.P.DeclFor(mi, ei)
            if c.P.T.DeclKindOf(d) != types.DeclKind.Trait or c.P.VarCount(generic.DeclOwner(d)) > 0 { continue }
            tr := c.P.SelfType(d)
            if c.P.Satisfies(self, tr) { met.Push(c.Ty(tr)) }
        }
    }
    if met.Len() > 0 { b.Push($"    meets " $met.Join(", ") "\n") }
}

# ---- globals ----

fn globalItem(c mut typecheck.Checker&, x mut interp.Exec&, mi I64, e names.Entry) String {
    nm := c.P.L.Names
    t := c.GlobalType(mi, e.Name)
    head := $nm.Text(e.Name) $(" mut " if e.Mut else " ") $c.Ty(t)
    if e.Mut { return $head "   # set at startup\n" }
    body := c.RenderBody(mi, e.Name, e.Sp)
    text := try x.Text(body) catch { return $head "   # set at startup\n" }
    v := c.P.T.Referent(t) if c.P.T.KindOf(t) == types.Kind.Ref else t
    shown := $quoted(text) if v == c.TextType() else $text
    # a long value - an embedded file's bytes (E38), a large table - is cut, its length said
    if shown.Len() > LongValue { return $head " = " $shown[:LongValue] "...   # " $shown.Len() " characters\n" }
    return $head " = " $shown "\n"
}

# the most of a global's value explain writes out
LongValue I64 = 400

# text written as a literal writes it
fn quoted(s String&) String {
    b := StringBuilder()
    b.PushChar('"')
    for ch in s {
        if ch == '"' or ch == '\\' {
            b.PushChar('\\')
            b.PushChar(ch)
        } else if ch == '\n' {
            b.Push("\\n")
        } else if ch == '\t' {
            b.Push("\\t")
        } else {
            b.PushChar(ch)
        }
    }
    b.PushChar('"')
    return b.ToString()
}
