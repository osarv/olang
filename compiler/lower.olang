# lower - the typed core language lowered to MIR (compiler/DESIGN.md sections 1.8 and 1.8.1, M7): one MIR function for
# each typed body, made by rules of its own and by the plan's placement, which emit (M9) and eval (M8) execute and the
# MIR verifier (mir.Fn.Verify) holds to the contract.
#
# What lowering makes explicit, once:
# - the order of evaluation (S4, E11b, P1g): an expression's operands are values computed by the statements before it,
#   left to right, each in a temporary of its own; a place's indices and references are computed before the place is
#   used; an assignment's target before its value;
# - every scope opened and closed (O2): a typed block that is a block of its own (one whose id is not its enclosing
#   block's) opens a scope where it is entered, a loop's body one each turn, a join one waited for on every way out;
# - the exit sequence: every way out of a block - its end, break, continue, return, an error leaving - runs for each block
#   it leaves, innermost first, the block's deferred code (S19, last registered first, only what was reached), a join's
#   wait (P1b), then its close;
# - errors (R6-R21): a call's error edge gets its code under the callee's own list; dispatch is a test per clause item
#   over it, the unwinding to the try's depth, a jump to the clause; what no clause takes is re-encoded under the body's
#   own list and raised once every scope is closed;
# - checks (E15a, E16b, D14b, E32): a test and a branch - to an Exit for a guaranteed check, to the try's dispatch with
#   CheckError's code for a checked one.
#
# Placement is the plan's (typed.Plan, M6): the scope pass's (compiler/scope.olang) where Plans holds one per body, else
# the stand-in DESIGN.md 1.6.1 allows - every site built in the program's scope, every local in its frame, every scope
# variable passed the program's. A plan's block is the MIR scope its typed block opened; an Inert scope (O12, E11c) is
# the program's until lowering opens Inert scopes of its own.
#
# Memory is one model (docs/memory.md): scopes and destructor registration; a Take lowers to MIR's Take, and what a sole
# place lets go of is released where early freeing says (O8d: Release, Settle).
#
# What lowering meets and does not lower yet is recorded as a gap (Gaps), with where and what; a body with one is not
# verified (compiler/tools/lowerdump.olang counts them).

import "std/os"
import "std/pair"
import "source"
import "diag"
import "cond"
import "fetch"
import "load"
import "names"
import "types"
import "generic"
import "typed"
import "mir"
import "check"
import "free"

# a construct met and not lowered yet: where, and what
type Gap struct(File I64, Sp source.Span, What String&) {
    File
    Sp
    What
}

# the lowering of a program's bodies: P the checked program, Bodies check's table of typed bodies
type Lowerer struct(P mut generic.Program&, Bodies Vec<mut typed.Body&>&) {
    P
    Bodies
    Plans Vec<typed.Plan>      # the scope pass's, one per body; none for the stand-in placement
    Free mut free.Free?& = null # the early-free analysis's decisions (O8d), null for none: nothing freed early
    Gaps Vec<Gap>
    Gapped Bool = false     # whether the body lowered last met a gap
    # B3e: for interpret - each registration of deferred code made with a cleanup of its own (Stmt.Deferred), which
    # interpret runs for the blocks a stop leaves; never for a build (emit has no use for them)
    Cleanups Bool = false
    Tests Bool = false        # a test build: a by-value holder's guard registered with its block (F5)
    # S18c (mir.Key.Assert): the asserts decided true while compiling, by body and where the assert starts - no test
    AssertsTrue Map<pair.Pair<I64, I64>, Bool>
    # the functions lowering refers to that are no typed body - helpers, adapters, modules' initializations - in the
    # order first referred to, each once: what LowerKey makes next
    Wanted Vec<mir.FnKey>
    wanted Map<mir.FnKey, Bool>
    ctorOf Map<types.TypeId, I64>   # a type's constructor's body (twin 0), once looked up
    strOf Map<types.TypeId, I64>    # a type's Str's body, -1 for none, once looked up
    copyOf Map<types.TypeId, I64>   # a type's own Copy's body (E31d), -1 for none, once looked up
    dtorOf Map<types.TypeId, I64>   # a type's destructor's body (C9)
    indexed Bool = false
    failT Vec<types.TypeId>        # each check word's error type (failure)
    failCode Vec<I64>              # and its code under that type alone
    charT types.TypeId = types.TypeId(-1)
    textT types.TypeId = types.TypeId(-1)
    # D9h, counted for -memory: returns handing back a view as it is, calls whose view is read where it stands,
    # and calls copying a view into where their result goes
    ViewReturns I64 = 0
    ViewReads I64 = 0
    ViewCopies I64 = 0
    # copies left out - a body's handing back a local holding views of its arguments (ElidedReturns), a
    # local's holding views of storage nothing changes while it lives (ViewLocals)
    ElidedReturns I64 = 0
    ViewLocals I64 = 0
    ArgViews I64 = 0             # ... a by-value argument's copy, where the callee only reads its parameter (argView)
    Moves I64 = 0                # ... a value local's copy that is its last mention (D9i, movesAtLastUse)
    # ... per body: whether it keeps its parameter's referent's parts as they are (preserves: body * 64 + k), its reference
    # result storage made for it (freshResult: -1 - body), nothing of what its parameter names (freshParam: below -2^40)
    preserved Map<I64, Bool>
    keptRefs Map<I64, Bool>     # keepsNoRef's answers, by body * 64 + parameter
    CopyLog Vec<String&>         # each of those two, by place, for -memory
    ViewDump Bool = false        # OLANG_VIEWDUMP: each such call's decision, by place, in ViewLog
    ViewLog Vec<String&>
}

# what a check failing as written fails with (E15a, R20): a word of a prelude error type
OutOfBounds I64 = 0    # ArrayError.OutOfRange: an index or a slice outside its array
Overflow I64 = 1       # NumberError.Overflow: a narrowing that changes the value (E26b)
Invalid I64 = 2        # NumberError.Invalid: a NaN or an infinity narrowed to an integer
WrongCase I64 = 3      # CaseError.WrongCase: an "as" naming a case the value is not (E32)
Contract I64 = 4       # ArgumentError.Invalid: a call's requirement false on entry (D17)
Empty I64 = 5          # ArrayError.Empty: a total that needs an element of an array that has none (E39)

FailIds Array<String&> = Array<String&>["std/prelude/array", "std/prelude/number", "std/prelude/number", "std/prelude/enums"
                                 "std/prelude/argument", "std/prelude/array"]
FailTypes Array<String&> = Array<String&>["ArrayError", "NumberError", "NumberError", "CaseError", "ArgumentError", "ArrayError"]
FailWords Array<String&> = Array<String&>["OutOfRange", "Overflow", "Invalid", "WrongCase", "Invalid", "Empty"]

# a check's word: its error type and the code it fails with under that type alone
fn (lw mut Lowerer&) failure(word I64) types.TypeId, I64 {
    if lw.failT.Len() == 0 {
        for k in range FailIds.Len() {
            id, ty, w := FailIds[k], FailTypes[k], FailWords[k]
            t := lw.P.PreludeType(id, ty)
            code I64 = 1 << 16
            if t != types.UnknownT {
                ws := lw.P.ErrorWords(lw.P.T.DeclOf(t))
                for i in range ws.Len() {
                    if lw.P.T.Names.Text(ws[i]) == w { code = (1 << 16) | i }
                }
            }
            lw.failT.Push(t)
            lw.failCode.Push(code)
        }
    }
    return lw.failT[word], lw.failCode[word]
}

fn (lw mut Lowerer&) char() types.TypeId {
    if lw.charT < types.TypeId(0) { lw.charT = lw.P.PreludeType("std/prelude/text", "Char") }
    return lw.charT
}

fn (lw mut Lowerer&) text() types.TypeId {
    if lw.textT < types.TypeId(0) { lw.textT = lw.P.PreludeType("std/prelude/text", "String") }
    return lw.textT
}

# whether body id has code to lower: an enum case's payload has none, nor a body check left unfinished
fn (lw mut Lowerer&) HasCode(id I64) Bool {
    b := lw.Bodies[id]
    if b.Root is null { return false }
    return match b.Of {
        case typed.BodyOf.Case(_, _): false
        case _: true
    }
}

# body id lowered: its MIR function. Gapped says whether lowering met a construct it does not lower yet (a gap, in Gaps)
# or a type check left unknown (a body with errors) - either way the function is not one to verify
fn (lw mut Lowerer&) Lower(id I64) mir.Fn {
    b := lw.Bodies[id]
    f := mir.Fn(mir.FnKey.Body(typed.BodyId(I32(id))), b.Ty, b.File, b.Sp)
    for i in range b.RaiseAt.Len() {
        f.RaiseAt.Push(b.RaiseAt[i])
        f.RaiseWhat.Push(b.RaiseWhat[i])
    }
    if b.Gen {
        # D18: a generator's Next, a coroutine - its end the code Exhausted.End has under its own list
        f.Gen = true
        ex := lw.P.PreludeType("std/prelude/iterator", "Exhausted")
        if ex != types.UnknownT { f.GenEnd = mir.ErrorCode(lw.P.T, lw.P.T.Errors(b.Ty), ex, 0) }
    }
    ln := lowering(lw, b, lw.P.T, f)
    ln.file = b.File
    if id < lw.Plans.Len() {
        ln.planned = true
        ln.plan = lw.Plans[id]
    }
    ln.freeing = lw.Free is not null and lw.Free!.Frees(id)
    ln.run()
    lw.Gapped = ln.gapped
    return ln.F
}

# a function lowering refers to, to be made by LowerKey
fn (lw mut Lowerer&) Want(k mir.FnKey) {
    if lw.wanted.Has(k) { return }
    lw.wanted.Put(k, true)
    lw.Wanted.Push(k)
}

# the function a key names, lowered: a typed body, a helper, an adapter or a module's initialization. Gapped as Lower's
fn (lw mut Lowerer&) LowerKey(k mir.FnKey) mir.Fn {
    match k {
        case mir.FnKey.Body(id) { return lw.Lower(I64(id)) }
        case mir.FnKey.Helper(kind, t) { return lw.helper(kind, t) }
        case mir.FnKey.Adapter(call) { return lw.adapterFn(call) }
        case mir.FnKey.Copied(body) { return lw.copiedFn(body) }
        case mir.FnKey.Init(m) { return lw.initFn(m) }
        case mir.FnKey.AnyRender(ti, top) { return lw.anyRender(ti, top) }
    }
}

# $ of an "any"'s instance (T33): a Render helper over the type the instance is stored as, rendering the instance's
# value as $ renders its own type - at the top of a piece, or inside another value
fn (lw mut Lowerer&) anyRender(ti I64, top Bool) mir.Fn {
    tab := lw.P.AnyTables.Ref(ti)
    hty := mir.HelperType(lw.P.T, mir.HelperKind.Render, tab.Stored)
    b := standIn(hty)
    ln := lowering(lw, b, lw.P.T, lw.bare(mir.FnKey.AnyRender(ti, top), hty))
    sp := source.Span(0, 0)
    ln.prologue(Array<mir.VarKind>[mir.VarKind.Builder])
    ln.rdepth = mir.Operand.Copy(mir.Lvalue.L(mir.LocalId(1)))
    place := ln.at(mir.LocalId(0))
    if tab.Stored != tab.Concrete { place = ln.with(place, mir.Proj.Field(0)) }
    if top {
        ln.render(mir.ScopeRef.Var(0), mir.Operand.Copy(ln.mk(place)), tab.Concrete, sp)
    } else {
        ln.inner(place, tab.Concrete, mir.ScopeRef.Var(0), sp)
    }
    ln.epilogue(mir.Operand.None)
    lw.Gapped = ln.gapped
    return ln.F
}

# what LowerKey makes of k, held to the verifier, as Verified
fn (lw mut Lowerer&) VerifiedKey(k mir.FnKey, dump Bool) String, String ? GapMet {
    f mir.Fn& = lw.LowerKey(k)
    if lw.Gapped { error GapMet }
    problems := f.Verify(lw.P.T)
    text := f.Dump(lw.P.T) if dump else ""
    return problems, text
}

# the modules whose initialization runs a global's initializer, in order
fn (lw mut Lowerer&) InitModules() Vec<I64> {
    out Vec<I64>
    for i in range lw.Bodies.Len() {
        match lw.Bodies[i].Of {
            case typed.BodyOf.Global(m, _) {
                if m not in out { out.Push(m) }
            }
            case _ { }
        }
    }
    return out
}

# body id lowered and held to the verifier: the verifier's problems ("" for none) and the function's dump where dump
# is asked for - failing with GapMet where lowering met a gap (or a body with errors)
fn (lw mut Lowerer&) Verified(id I64, dump Bool) String, String ? GapMet {
    f mir.Fn& = lw.Lower(id)
    if lw.Gapped { error GapMet }
    problems := f.Verify(lw.P.T)
    text := f.Dump(lw.P.T) if dump else ""
    return problems, text
}

# ---- one body ----

# a scope the function has open, while lowering: its MIR scope, the typed block it stands for, its kind
type level struct(S mir.ScopeId, Block typed.BlockId, Kind mir.ScopeKind) {
    S
    Block
    Kind
}

# a loop being lowered: its body block, the level outside its turn's scope, the blocks a continue and a break go to
# (made when first wanted), the ends that jump there
type loopCtx struct(Body typed.BlockId, Depth I64) {
    Body
    Depth
    cont mir.BlockId = mir.NoBlock
    brk Vec<mir.BlockId>
    conts Vec<mir.BlockId>
}

# a try being lowered: the level it stands at, its clauses and each one's entry (made when an error first reaches it),
# whether "!" ends the program instead (E35)
type tryCtx struct(Depth I64, Clauses Array<typed.Clause&>&, Ends Bool, Passes Bool = false) {
    Depth
    Clauses
    Ends
    Passes     # what its clauses do not take goes on to the try around it (typed.Try.Passes)
    entries Vec<mir.BlockId>
}

# a comprehension being lowered (E27): its buffer (an array reference), how many it holds, its element type, and the
# scope its storage is made in - where a full buffer's bigger one is made too
type collectCtx struct(Buf mir.LocalId, N mir.LocalId, Elem types.TypeId, ArrT types.TypeId, At mir.ScopeRef, Exact Bool = false
                       ByRef Bool = true) {
    Buf
    N
    Elem
    ArrT
    At
    Exact      # E39: Buf is the result itself, made at its length - a yield stored at N, never grown
    ByRef      # Buf a reference to the array (dereferenced to reach it); false for an exact one held by value
}

# a place being built: its base and its projections
type pl struct(B mir.Base) {
    B
    Ps Vec<mir.Proj>
    Pk I64 = -1                 # T13c: where Ps's steps into a packed value begin (-1 for none): no place, read and
    PkTy types.TypeId           # written through the whole value at Ps[:Pk], of type PkTy
}

type lowering struct(L mut Lowerer&, B typed.Body&, T mut types.Table&, made mut mir.Fn&) {
    L
    B
    T
    F mir.Fn = made        # its own copy (D9c: a by-value parameter holds at most 128 bytes)
    file I64 = 0
    rdepth mir.Operand = mir.Operand.None   # in a Render helper, how many references were followed to reach it (E11a)
    cur mir.BlockId = mir.BlockId(0)
    dead Bool = false
    gapped Bool = false
    levels Vec<level>
    # deferred code registered (S19), each with the scope of the level it was registered at, in order
    defers Vec<typed.Block&>
    deferAt Vec<mir.ScopeId>
    loops Vec<loopCtx>
    tries Vec<tryCtx>
    collects Vec<collectCtx>
    targets Vec<pl>    # the places of the Assigns being lowered, innermost last (Lvalue.Target)
    joins Vec<tryCtx>  # the joins being lowered, innermost last: each one's clauses (P4c), beside its scope
    joinS Vec<mir.ScopeId>
    erroring Bool = false   # an error is leaving: a join's failure does not replace it (P4b)
    planned Bool = false    # whether plan is the scope pass's plan for B, not the stand-in
    viewing Bool = false    # the place lowered next is a slice's base or a borrow's (tempLocal)
    taskArgs Bool = false   # whether the arguments lowered next are a task's (bulk review 5, F7): copies in taskAt
    taskAt mir.ScopeRef = mir.ScopeRef.Program
    adoptSite typed.SiteId = typed.SiteId(-1)    # a fresh array promoted (promote): made at the reference's scope
    adoptAt mir.ScopeRef = mir.ScopeRef.Program
    plan typed.Plan = typed.Plan(0, 0, 0)
    freeing Bool = false            # whether this body frees early what sole places let go of (O8d, free.Frees)
    regions Map<I64, mir.LocalId>   # the regions made for sites being lowered (plan.RegionKind), by site
    tryRel I64 = -1                 # a try statement with clauses releasing its value on its success path (O8d): -1 not,
                                    # 0 the value, 1 the handle's state (free.IsHandle)
    walkSite typed.SiteId = typed.SiteId(-1)    # D18e: the generator call whose walk a for-in makes and finishes here
    # D9h: the call sites whose array value result is read where it stands - its consumer only reads it before
    # the statement ends - or handed back as it is by a return (a view of this body's arguments): a call of a function
    # handing back views copies its result at every other site
    reads Map<I64, Bool>
    # O15 (QCZ): which of a block's by-value holders hold which - typed.DropHolds of B, made where a level's drops are
    # first ordered or a holder's guard registered
    holding typed.DropHolding = typed.DropHolding()
    holdingMade Bool = false
    heldDrop Bool = false   # Part C: a by-value holder's drop being lowered where its block is left (runDefers)
    # the locals this body hands back holding views of its arguments, with the parameters
    # each views (typed.ViewWalk.Settle, as check recorded them); the copies left out for them and for the locals holding
    # views in place of their copies (viewLocals) - a MakeKind.Copy by its site, a value array local's T7b copy at its
    # declaration - and the view calls such a local reads where they stand
    rvl Map<I64, I64>
    vl Map<I64, Bool>
    noCopy Map<I64, Bool>
    qCover Map<I64, Bool>      # quietLife: the types whose storage the view held covers (its by-value parts)
    qRoot types.TypeId = types.TypeId(0)   # ... and the type of the object it is a view into
    qWrites Map<I64, Bool>     # ... and writesCover's answers for it, by type (false while a type is being walked)
    noLetCopy Map<I64, Bool>
    vlSites Map<I64, Bool>
    vlIn typed.BlockId = typed.BlockId(0)   # ... the block of the local being asked about (viewLocals)
    stmts Vec<typed.Stmt&>       # ... the statements being lowered, innermost last, and whether each writes nothing
    stmtSafe Vec<I64>            # it reaches but through its own last store (quietStmt): -1 not yet asked, 0 no, 1 yes
    # D9h by evaluation order: the view calls read where they stand whose window - what is evaluated while the value
    # is alive, its consumer's call or the place read out of it - writes nothing the view covers (windowQuiet), by
    # site; and the answer for the call stableViews is judging
    readWin Map<I64, Bool>
    winOk Bool = false
    moved Map<I64, I64>      # D9i: the copies of a value local left out as its last use, by site, with the local
}

fn (ln mut lowering&) gap(sp source.Span, what String&) {
    if not ln.gapped { ln.L.Gaps.Push(Gap(ln.file, sp, $what)) }
    ln.gapped = true
}

fn (ln mut lowering&) run() {
    b := ln.B
    t := ln.T
    away := ln.standInAway()
    # locals: the typed body's, in its numbering
    for i in range b.Locals.Len() {
        l := b.Locals[i]
        k := match l.Kind {
            case typed.LocalKind.Param: mir.LocalKind.Param
            case typed.LocalKind.Capture: mir.LocalKind.Capture
            case _: mir.LocalKind.Var
        }
        if l.Ty == types.UnknownT { ln.gapped = true }
        # where its storage is: the frame, or a scope variable where the scope pass moved it (O26a's returned locals)
        home := mir.ScopeRef.Frame
        if ln.planned and i < ln.plan.Stored.Len() {
            match ln.plan.Stored[i] {
                case typed.Scope.Var(v) { home = mir.ScopeRef.Var(v) }
                case typed.Scope.Program { home = mir.ScopeRef.Program }
                case _ { }
            }
        }
        if away[i]: home = mir.ScopeRef.Program
        ln.F.AddLocal(mir.Local(l.Name, l.Sp, l.Ty, k, home))
    }
    for p in b.Params { ln.F.Params.Push(mir.LocalId(I32(p))) }
    caps Vec<typed.LocalId>
    for i in range b.Locals.Len() {
        if b.Locals[i].Kind == typed.LocalKind.Capture {
            caps.Push(typed.LocalId(I32(i)))
            ln.F.Captures.Push(mir.LocalId(I32(i)))
        }
    }
    for v in b.Vars {
        k := match v {
            case typed.ScopeVar.Param(l): mir.VarKind.Param(indexOf(b.Params, l))
            case typed.ScopeVar.Result: mir.VarKind.Result
            case typed.ScopeVar.Instance: mir.VarKind.Instance
            case typed.ScopeVar.Closing: mir.VarKind.Closing
            case typed.ScopeVar.Capture(l): mir.VarKind.Capture(indexOf(caps, l))
        }
        ln.F.Vars.Push(k)
    }
    if ln.gapped {
        ln.L.Gaps.Push(Gap(ln.file, b.Sp, "an unknown type (a check error or gap): a local"))
        return
    }
    ln.F.NewBlock()
    root := b.Root
    frame := ln.F.AddScope(mir.ScopeKind.Frame, mir.NoScope, root!.Id, b.Sp)
    ln.emit(mir.Stmt.Open(b.Sp, frame))
    ln.levels.Push(level(frame, root!.Id, mir.ScopeKind.Frame))
    ln.settleViews()
    for s in root!.Stmts { ln.stmt(s) }
    if ln.dead { return }
    # falling off the end
    ctor := match b.Of {
        case typed.BodyOf.Ctor(_, _): true
        case _: false
    }
    res := t.Result(b.Ty)
    if ctor {
        ln.assemble(res)
    } else if res == types.VoidT {
        ln.leave(0)
        ln.end(mir.Term.Return(b.Sp, mir.Operand.None))
    } else {
        ln.end(mir.Term.Exit(b.Sp, mir.ExitKind.Unreachable, mir.Operand.None))
    }
}

fn indexOf(xs Vec<typed.LocalId>, l typed.LocalId) I64 {
    for i in range xs.Len() {
        if xs[i] == l { return i }
    }
    return -1
}

# a constructor's end: its instance assembled from its fields in order (C2a, C6) and returned; a declared number's
# (T29d) the value of its one field
fn (ln mut lowering&) assemble(res types.TypeId) {
    b := ln.B
    t := ln.T
    inst := t.Referent(res) if t.IsRef(res) else res
    r := t.Repr(inst)
    isStruct := t.KindOf(r) == types.Kind.Named and t.DeclKindOf(t.DeclOf(r)) == types.DeclKind.Struct
    if not isStruct {
        if b.Fields.Len() != 1 or inst != res {
            ln.gap(b.Sp, "a constructor of a type that is no struct")
            return
        }
        x := ln.copyLocal(mir.LocalId(I32(b.Fields[0])))
        ln.leave(0)
        ln.end(mir.Term.Return(b.Sp, x))
        return
    }
    ops := Array<mir.Operand>(b.Fields.Len())
    for i in range b.Fields.Len() { ops[i] = mir.Operand.Copy(mir.Lvalue.L(mir.LocalId(I32(b.Fields[i])))) }
    v := ln.into(inst, mir.Rvalue.Aggregate(inst, 0, ln.F.Args(ops)), b.Sp)
    if inst != res {
        # an instance of a reference-only type (C11): made where it lands, its instance scope, and a destructor-bearing
        # one registered there, once per constructor call (O16)
        s := ln.instance()
        v = ln.into(res, mir.Rvalue.New(s, v, res), b.Sp)
        if t.KindOf(r) == types.Kind.Named and t.HasBody(r) and t.Destructs(r) { ln.emit(mir.Stmt.RegisterDtor(b.Sp, s, inst, v)) }
    }
    ln.leave(0)
    ln.end(mir.Term.Return(b.Sp, v))
}

# a constructor's instance scope: its scope variable, the program's for the stand-in placement
fn (ln mut lowering&) instance() mir.ScopeRef {
    if not ln.planned { return mir.ScopeRef.Program }
    for k in range ln.B.Vars.Len() {
        if ln.B.Vars[k] == typed.ScopeVar.Instance { return mir.ScopeRef.Var(k) }
    }
    return mir.ScopeRef.Program
}

# ---- emitting ----

fn (ln mut lowering&) emit(s mir.Stmt&) {
    if not ln.dead { ln.F.Add(ln.cur, s) }
}

fn (ln mut lowering&) end(t mir.Term) {
    if ln.dead { return }
    ln.F.End(ln.cur, t)
    ln.dead = true
}

fn (ln mut lowering&) start(b mir.BlockId) {
    ln.cur = b
    ln.dead = false
}

fn (ln mut lowering&) goto(b mir.BlockId) { ln.end(mir.Term.Goto(b)) }

# a jump from here to a block made later: this block, its terminator set once the block is made (patch); none when
# nothing reaches here
fn (ln mut lowering&) leaveOpen(ends mut Vec<mir.BlockId>&) {
    if ln.dead { return }
    ends.Push(ln.cur)
    ln.dead = true
}

# a block every end in ends jumps to, made now and entered; dead where there are none
fn (ln mut lowering&) patch(ends Vec<mir.BlockId>) {
    if ends.Len() == 0 {
        ln.dead = true
        return
    }
    m := ln.F.NewBlock()
    for e in ends { ln.F.End(e, mir.Term.Goto(m)) }
    ln.start(m)
}

fn (ln mut lowering&) temp(ty types.TypeId, sp source.Span) mir.LocalId { return ln.F.AddTemp(ty, sp) }

# rv computed into a temporary of type ty: a copy of it
fn (ln mut lowering&) into(ty types.TypeId, rv mir.Rvalue, sp source.Span) mir.Operand {
    l := ln.temp(ty, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(l), rv))
    return mir.Operand.Copy(mir.Lvalue.L(l))
}

fn (ln mut lowering&) copyLocal(l mir.LocalId) mir.Operand { return mir.Operand.Copy(mir.Lvalue.L(l)) }

# an operand as a local: itself where it is a copy of a local, else held in a temporary
fn (ln mut lowering&) local(x mir.Operand, ty types.TypeId, sp source.Span) mir.LocalId {
    match x {
        case mir.Operand.Copy(p) {
            if p.Path.N == I32(0) {
                match p.B {
                    case mir.Base.Local(l) { return l }
                    case _ { }
                }
            }
        }
        case _ { }
    }
    l := ln.temp(ty, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(l), mir.Rvalue.Use(x)))
    return l
}

# a temporary given storage (Lvalue.Temp): a local of the frame, or - one a view of it kept longer has the scope pass
# build where its Built says (plan.TempKept, O27 as placement) - a local homed there, a new object each time it is made
fn (ln mut lowering&) tempLocal(v typed.Expr&, ty types.TypeId, sp source.Span, site typed.SiteId) mir.LocalId {
    i := I64(site)
    kept := ln.planned and i >= 0 and i < ln.plan.TempKept.Len() and ln.plan.TempKept[i]
    # (the stand-in placement, for the evaluator: one a view is taken of in the program's scope, where the view may be
    # kept - as everything the stand-in builds is - not the frame a return closes)
    away := not ln.planned and ln.viewing
    ln.viewing = false
    if not kept and not away: return ln.local(ln.val(v), ty, sp)
    x := ln.val(v)
    l := ln.temp(ty, sp)
    ln.F.Locals[I64(l)].Home = ln.scopeRef(ln.plan.Built[i]) if kept else mir.ScopeRef.Program
    ln.emit(mir.Stmt.Live(sp, l))
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(l), mir.Rvalue.Use(x)))
    return l
}

fn (ln mut lowering&) prim(op typed.PrimOp, ty types.TypeId, args Array<mir.Operand>&, sp source.Span) mir.Operand {
    return ln.into(ty, mir.Rvalue.Prim(op, ty, ln.F.Args(args)), sp)
}

fn (ln mut lowering&) i64() types.TypeId { return mir.I64T }

fn (ln mut lowering&) constI64(v I64) mir.Operand { return mir.Operand.Const(mir.I64T, v) }

# a value converted to I64 where it is not one
fn (ln mut lowering&) asI64(x mir.Operand, ty types.TypeId, sp source.Span) mir.Operand {
    if ln.T.Repr(ty) == mir.I64T { return x }
    return ln.prim(typed.PrimOp.Convert, mir.I64T, Array<mir.Operand>[x], sp)
}

# the scope a site builds in: the plan's, the program's for the stand-in placement
fn (ln mut lowering&) built(site typed.SiteId) mir.ScopeRef {
    if not ln.planned or site < typed.SiteId(0) or I64(site) >= ln.plan.Built.Len() { return mir.ScopeRef.Program }
    return ln.scopeRef(ln.plan.Built[I64(site)])
}

# where an array made at site is: where the reference it is promoted to goes, if it is the one promote adopts
fn (ln mut lowering&) madeAt(site typed.SiteId) mir.ScopeRef {
    if site == ln.adoptSite and site >= typed.SiteId(0) { return ln.adoptAt }
    return ln.built(site)
}

# the scopes a call at site passes for its callee's n variables: the plan's, the program's for the stand-in placement
fn (ln mut lowering&) passed(n I64, site typed.SiteId = typed.SiteId(-1)) mir.Range {
    xs := Array<mir.ScopeRef>(n)
    for i in range n {
        xs[i] = mir.ScopeRef.Program
        if ln.planned and site >= typed.SiteId(0) and I64(site) < ln.plan.Built.Len() {
            xs[i] = ln.scopeRef(ln.plan.Passed(site, i))
        }
    }
    return ln.F.ScopeRefs(xs)
}

# a plan's scope as MIR names it: a block the scope its typed block opened - the innermost open level standing for it,
# else the innermost enclosing it (a block check reuses its parent's id for) - a scope variable, the program's
fn (ln mut lowering&) scopeRef(sc typed.Scope) mir.ScopeRef {
    match sc {
        case typed.Scope.Block(b) {
            for i := ln.levels.Len() - 1, i >= 0, i-- {
                if ln.levels[i].Block == b { return mir.ScopeRef.Scope(ln.levels[i].S) }
            }
            for i := ln.levels.Len() - 1, i >= 0, i-- {
                lb := ln.levels[i].Block
                if lb >= typed.BlockId(0) and ln.B.Encloses(lb, b) { return mir.ScopeRef.Scope(ln.levels[i].S) }
            }
            return mir.ScopeRef.Program
        }
        case typed.Scope.Var(i) { return mir.ScopeRef.Var(i) }
        case typed.Scope.Frame { return mir.ScopeRef.Frame }
        case typed.Scope.Region(site) { return ln.regionOf(I64(site)) }
        case _ { return mir.ScopeRef.Program }
    }
}

# ---- regions (O8d): where a value made for a sole place is built ----

# the region made for a site's value, made now if it is not yet: a region of its own, a kid of its parent's scope -
# or of the region its root's value is in - or (kind 2) the region its root's value is in, else its parent's scope
fn (ln mut lowering&) regionOf(site I64) mir.ScopeRef {
    have := try ln.regions.Get(site) catch default mir.NoLocal
    if have != mir.NoLocal { return mir.ScopeRef.Held(have) }
    sp := ln.B.Sp
    kind := ln.plan.RegionKind[site] if site < ln.plan.RegionKind.Len() else 0
    parent := ln.scopeRef(ln.plan.RegionParent[site]) if kind != 0 else mir.ScopeRef.Program
    root := ln.plan.RegionRoot[site] if kind != 0 else null
    if root is not null {
        o := ln.val(root)
        h0 := ln.temp(mir.I64T, sp)
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(h0), mir.Rvalue.RegionOr(o, parent)))
        if kind == 2 {
            ln.regions.Put(site, h0)
            return mir.ScopeRef.Held(h0)
        }
        parent = mir.ScopeRef.Held(h0)
    }
    h := ln.temp(mir.I64T, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(h), mir.Rvalue.Region(parent)))
    ln.regions.Put(site, h)
    return mir.ScopeRef.Held(h)
}

# the site whose value an expression is, where a region is to be made for it, -1 for none
fn (ln mut lowering&) regionSite(x typed.Expr&) I64 {
    if not ln.planned { return -1 }
    s := match x {
        case typed.Expr.Promote(_, _, pr): I64(pr.Site)
        case typed.Expr.Make(_, _, m): I64(m.Site)
        case typed.Expr.Text(_, _, tx): I64(tx.Site)
        case typed.Expr.Collect(_, _, c): I64(c.Site)
        case typed.Expr.Call(_, _, c): I64(c.Site)
        case _: -1
    }
    if s < 0 or s >= ln.plan.RegionKind.Len() or ln.plan.RegionKind[s] == 0 { return -1 }
    return s
}

# the sole places a place's let-go releases: the place itself, or the leaves of a struct held in it - each by the
# fields that reach it from the place, and a handle's reference, field 0
fn (ln mut lowering&) releases(p typed.Lvalue&, assign Bool = false) Vec<Array<I64>> {
    out Vec<Array<I64>>
    if not ln.freeing { return out }
    # an element given a value lets go of nothing: the program's copies between elements are not known positions, and
    # the prelude's chunks are filled with the very value pushed (docs/memory.md 2.6 item 7) - only a vacate does
    if assign {
        match p {
            case typed.Lvalue.Elem(_, _, _) { return out }
            case _ { }
        }
    }
    fr := ln.L.Free!
    k := fr.SolePlace(p)
    # (an owner local given another value: its place's old value, held whole)
    if p == typed.Lvalue.Local and assign { k = fr.SoleLocal(I64(ln.B.Id), I64(p.id)) }
    if k >= 0 {
        out.Push(Array<I64>[0] if fr.IsHandle(k) else Array<I64>(0))
        return out
    }
    for lf in fr.SoleLeaves(p.Type()) {
        if fr.IsHandle(lf.PlaceId) {
            path := Array<I64>(lf.Path.Len() + 1)
            for i in range lf.Path.Len() { path[i] = lf.Path[i] }
            path[lf.Path.Len()] = 0
            out.Push(path)
        } else {
            out.Push(lf.Path)
        }
    }
    return out
}

# the release paths of a value of type ty's sole leaves: each by the fields that reach it, and a handle's reference,
# field 0
fn (ln mut lowering&) leafPaths(ty types.TypeId) Vec<Array<I64>> {
    out Vec<Array<I64>>
    fr := ln.L.Free!
    for lf in fr.SoleLeaves(ty) {
        if not fr.IsHandle(lf.PlaceId) {
            out.Push(lf.Path)
            continue
        }
        path := Array<I64>(lf.Path.Len() + 1)
        for i in range lf.Path.Len() { path[i] = lf.Path[i] }
        path[lf.Path.Len()] = 0
        out.Push(path)
    }
    return out
}

# what local l holds released, at each of the paths: a sole place's old value let go of
fn (ln mut lowering&) releaseAt(l mir.LocalId, paths Vec<Array<I64>>&, sp source.Span) {
    for path in paths {
        q := pl(mir.Base.Local(l))
        for i in path { q = ln.with(q, mir.Proj.Field(i)) }
        ln.emit(mir.Stmt.Release(sp, ln.mk(q)))
    }
}

# ---- scopes and the exit sequence ----

fn (ln lowering&) top() level& { return ln.levels.Ref(ln.levels.Len() - 1) }

# a typed block lowered: a scope of its own where its id is not the enclosing block's, its statements, and on falling
# off its end the exit sequence for it
fn (ln mut lowering&) block(bl typed.Block&) {
    if ln.dead { return }
    if ln.levels.Len() > 0 and ln.top().Block == bl.Id {
        for s in bl.Stmts { ln.stmt(s) }
        return
    }
    kind := match ln.B.Blocks[I64(bl.Id)].Kind {
        case typed.BlockKind.Loop: mir.ScopeKind.Loop
        case typed.BlockKind.Join: mir.ScopeKind.Join
        case _: mir.ScopeKind.Block
    }
    ln.openBlock(bl, kind)
    for s in bl.Stmts { ln.stmt(s) }
    ln.closeBlock()
}

fn (ln mut lowering&) openBlock(bl typed.Block&, kind mir.ScopeKind, errors types.ListId = types.ListId(0)) {
    s := ln.F.AddScope(kind, ln.top().S, bl.Id, ln.B.Blocks[I64(bl.Id)].Sp, errors)
    ln.emit(mir.Stmt.Open(ln.B.Blocks[I64(bl.Id)].Sp, s))
    ln.levels.Push(level(s, bl.Id, kind))
}

# the innermost level closed on falling off its end, and popped
fn (ln mut lowering&) closeBlock() {
    n := ln.levels.Len() - 1
    if not ln.dead { ln.exitLevel(n) }
    ln.popLevel()
}

fn (ln mut lowering&) popLevel() {
    s := ln.top().S
    for ln.deferAt.Len() > 0 and ln.deferAt[ln.deferAt.Len() - 1] == s {
        try ln.deferAt.Pop() catch { }
        try ln.defers.Pop() catch { }
    }
    try ln.levels.Pop() catch { }
}

# the exit sequence for every level from the innermost down to level to: each one's deferred code, its wait, its close.
# The levels stay as they are for the paths that do not leave
fn (ln mut lowering&) leave(to I64) {
    for i := ln.levels.Len() - 1, i >= to, i-- { ln.exitLevel(i) }
}

# whether deferred code k is an errdefer's (S19e): run only on a way out an error takes
fn (ln lowering&) onError(k I64) Bool { return ln.B.Blocks[I64(ln.defers[k].Id)].Kind == typed.BlockKind.ErrDefer }

# whether deferred code k is a by-value holder's drop (O15): in a join block, run after its wait - a task may still use
# what it holds until then (bulk review 7, F2)
fn (ln lowering&) isDrop(k I64) Bool { return ln.B.Blocks[I64(ln.defers[k].Id)].Kind == typed.BlockKind.Drop }

# which of a level's deferred code runs on a way out: before a join's wait (or a plain block's close), after a join's
# wait that failed, after one that did not
type deferPhase enum { Before, Failed, Waited }

# level i left - every level above it already left on this path: its deferred code (lowered as if the levels above
# were closed, which they are here) - an errdefer's only where an error is leaving (S19e) -, its wait if it is a join,
# its close
fn (ln mut lowering&) exitLevel(i I64) {
    if ln.dead { return }
    lv := ln.levels[i]
    ln.runDefers(i, deferPhase.Before)
    if ln.dead { return }
    sp := ln.B.Blocks[I64(lv.Block)].Sp if lv.Block >= typed.BlockId(0) else ln.B.Sp
    if lv.Kind == mir.ScopeKind.Join {
        errs := ln.F.Scopes[I64(lv.S)].Errors
        ok := ln.F.NewBlock()
        if ln.T.Items(errs).Len() == 0 {
            ln.end(mir.Term.Wait(sp, lv.S, ok, mir.NoLocal, mir.NoBlock))
        } else if ln.erroring {
            code := ln.temp(mir.I32T, sp)
            ln.end(mir.Term.Wait(sp, lv.S, ok, code, ok))
        } else {
            code := ln.temp(mir.I32T, sp)
            failed := ln.F.NewBlock()
            ln.end(mir.Term.Wait(sp, lv.S, ok, code, failed))
            ln.start(failed)
            # S19e: the join failed, which is known only once it has waited - its errdefers run now, after its defers
            # (and its holders' drops, O15)
            ln.runDefers(i, deferPhase.Failed)
            ln.emit(mir.Stmt.Close(sp, lv.S))
            ln.joinFailed(i, lv.S, mir.Operand.Copy(mir.Lvalue.L(code)), errs, sp)
        }
        ln.start(ok)
        ln.runDefers(i, deferPhase.Waited)
        if ln.dead { return }
    }
    ln.emit(mir.Stmt.Close(sp, lv.S))
}

# level i's deferred code, last registered first, lowered as the block's last statements with the levels above it set
# aside: what runs on this way out - every defer's, and an errdefer's where an error is leaving (S19e) - or, failed,
# only the errdefers' (a join failing after its wait)
fn (ln mut lowering&) runDefers(i I64, phase deferPhase) {
    lv := ln.levels[i]
    # the levels above i, set aside while i's deferred code is lowered
    saved Vec<level>
    for ln.levels.Len() > i + 1 { saved.Push(try ln.levels.Pop() catch { unreachable }) }
    mine Vec<I64>
    joined := lv.Kind == mir.ScopeKind.Join
    for k in range ln.defers.Len() {
        if ln.deferAt[k] == lv.S and ln.runsIn(k, phase, joined): mine.Push(k)
    }
    # what runs here is no longer pending while it runs: a path leaving from inside deferred code (one that cannot be
    # taken - S19 lets none leave - or is caught there) does not run it again, which would lower it without end
    for k in mine { ln.deferAt[k] = mir.ScopeId(-1) }
    for k in ln.runOrder(mine) {
        # no longer pending once it runs here (B3e): a stop inside it does not run it again - an errdefer has no cleanup
        if ln.L.Cleanups and not ln.onError(k) {
            ln.emit(mir.Stmt.Deferred(ln.B.Blocks[I64(ln.defers[k].Id)].Sp, lv.S, mir.NoBlock))
        }
        # deferred code runs as a block of its own, inside the block it is registered in
        was := ln.heldDrop
        ln.heldDrop = ln.isDrop(k)
        ln.block(ln.defers[k])
        ln.heldDrop = was
    }
    for k in mine { ln.deferAt[k] = lv.S }
    for saved.Len() > 0 { ln.levels.Push(try saved.Pop() catch { unreachable }) }
}

# a level's deferred code mine (by registration) in the order it runs: the last registered first, but a by-value holder's
# drop before the drops of the holders of its block it holds (O15, QCZ) - a held one's waits until every one holding it
# here has run, so no destructor reads what was ended (a cycle, check's error, runs as registered)
fn (ln mut lowering&) runOrder(mine Vec<I64>&) Vec<I64> {
    out Vec<I64>
    pending Vec<I64>
    for j := mine.Len() - 1, j >= 0, j-- {
        k := mine[j]
        if ln.waits(k, mine, out) {
            pending.Push(k)
            continue
        }
        out.Push(k)
        ln.release(pending, mine, out)
    }
    for k in pending { out.Push(k) }
    return out
}

# the drops pending whose holders have all run, run now, in their order - each one's run may let another go
fn (ln mut lowering&) release(pending mut Vec<I64>&, mine Vec<I64>&, out mut Vec<I64>&) {
    for {
        at := -1
        for i in range pending.Len() {
            if not ln.waits(pending[i], mine, out) {
                at = i
                break
            }
        }
        if at < 0: return
        out.Push(pending[at])
        pending.RemoveAt(at)!
    }
}

# whether deferred code k is a drop some other holder's drop among mine, not yet run (out), holds
fn (ln mut lowering&) waits(k I64, mine Vec<I64>&, out Vec<I64>&) Bool {
    v := ln.holderOf(k)
    if v < 0: return false
    for k2 in mine {
        if k2 == k or out.Has(k2): continue
        h := ln.holderOf(k2)
        if h >= 0 and ln.holds().Holds(h, v): return true
    }
    return false
}

# the local deferred code k ends, a by-value holder's drop; -1 for any other
fn (ln mut lowering&) holderOf(k I64) I64 { return typed.DropHolder(ln.B, ln.defers[k]) if ln.isDrop(k) else -1 }

fn (ln mut lowering&) holds() typed.DropHolding& {
    if not ln.holdingMade {
        ln.holding = typed.DropHolding.DropHolds(ln.T, ln.B)
        ln.holdingMade = true
    }
    return ln.holding
}

# whether deferred code k runs in this phase of its level's way out
fn (ln lowering&) runsIn(k I64, phase deferPhase, joined Bool) Bool {
    e, d := ln.onError(k), ln.isDrop(k)
    return match phase {
        case deferPhase.Before: not (joined and d) and (not e or ln.erroring)
        case deferPhase.Failed: e or d
        case deferPhase.Waited: d
    }
}

# B3e: deferred code k, just registered, lowered once more as its cleanup - blocks nothing but the registration reaches
# (Stmt.Deferred), ending in Resume - which interpret runs for each block a stop on what it does not run leaves, as the
# built program, going on, would leave them. Lowered where it is registered: inside its block, nothing above it open
fn (ln mut lowering&) cleanup(sp source.Span, k I64) {
    if ln.dead { return }
    s := ln.deferAt[k]
    entry := ln.F.NewBlock()
    ln.emit(mir.Stmt.Deferred(sp, s, entry))
    back := ln.cur
    ln.start(entry)
    ln.deferAt[k] = mir.ScopeId(-1)
    ln.block(ln.defers[k])
    ln.deferAt[k] = s
    ln.end(mir.Term.Resume(sp))
    ln.start(back)
}

# join s, at level i, failed with code under its list: its clauses, then the tries around it, take it - as an error
# reaching the join statement, with every level from i up closed on this path
fn (ln mut lowering&) joinFailed(i I64, s mir.ScopeId, code mir.Operand, errs types.ListId, sp source.Span) {
    saved Vec<level>
    for ln.levels.Len() > i { saved.Push(try ln.levels.Pop() catch { unreachable }) }
    savedT mut Vec<tryCtx>& = Vec<tryCtx>()
    for ln.tries.Len() > 0 and ln.tries[ln.tries.Len() - 1].Depth > i { savedT.Push(try ln.tries.Pop() catch { unreachable }) }
    pushed := -1
    for k in range ln.joinS.Len() {
        if ln.joinS[k] == s {
            ln.tries.Push(ln.joins[k])
            pushed = k
        }
    }
    ln.dispatch(code, errs, sp)
    # (the entries its clauses were given, back in the join's own record)
    if pushed >= 0 { ln.joins[pushed] = try ln.tries.Pop() catch { unreachable } }
    for savedT.Len() > 0 { ln.tries.Push(try savedT.Pop() catch { unreachable }) }
    for saved.Len() > 0 { ln.levels.Push(try saved.Pop() catch { unreachable }) }
}

# ---- statements ----

fn (ln mut lowering&) stmt(s typed.Stmt&) {
    if ln.dead { return }
    ln.stmts.Push(s)
    ln.stmtSafe.Push(-1)
    ln.stmtIn(s)
    ln.stmts.Pop()!
    ln.stmtSafe.Pop()!
}

fn (ln mut lowering&) stmtIn(s typed.Stmt&) {
    match s {
        case typed.Stmt.Let(sp, l, init) {
            ty := ln.B.Locals[I64(l)].Ty
            ln.homeKept(l)
            if ln.B.Locals[I64(l)].Unset {
                # D13d: assigned on every path before any read - nothing is written for its declaration; its storage
                # is marked set with no value (Use(None) writes nothing), so element stores may follow
                if ln.F.Locals[I64(l)].Home != mir.ScopeRef.Frame { ln.emit(mir.Stmt.Live(sp, mir.LocalId(I32(l)))) }
                ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(mir.LocalId(I32(l))), mir.Rvalue.Use(mir.Operand.None)))
                return
            }
            # D18e: a for-in's own generator, made by a direct call - the call marked as the walk this block finishes
            ln.walkSite = typed.SiteId(-1)
            if indexOf(ln.B.Walks, l) >= 0 {
                c := typed.Call.Of(init)
                if c is not null { ln.walkSite = c.Site }
            }
            # a fixed array widened is made where the local keeps it, the local's own (T7b, T7c)
            v := ln.fitAt(init, ty, sp, ln.storageOf(l))
            ln.walkSite = typed.SiteId(-1)
            if ln.copiesArray(init, ty) and not ln.fits(init, ty) and not ln.widens(init, ty) and not ln.dead and not ln.noLetCopy.Has(I64(l)) {
                n := ln.slotLen(l, init)
                v = ln.slotCopy(v, ty, n, sp) if n >= 0 else ln.arrayCopy(v, ty, sp, ln.storageOf(l))
            }
            if ln.F.Locals[I64(l)].Home != mir.ScopeRef.Frame { ln.emit(mir.Stmt.Live(sp, mir.LocalId(I32(l)))) }
            ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(mir.LocalId(I32(l))), mir.Rvalue.Use(v)))
        }
        case typed.Stmt.Assign(sp, target, value) {
            p := ln.place(target)
            ln.targets.Push(p)
            v := ln.fit(ln.val(value), value, target.Type(), sp)
            try ln.targets.Pop() catch { }
            if p.Pk >= 0 {
                if not ln.dead { ln.packedWrite(p, v, sp) }
                return
            }
            # (QCE: a part holding an array by value takes the copy check made, or the new storage
            # it is given, as it is - never written over in place, since the part may be room a Vec has not filled)
            if ln.valueArray(target.Type()) and not ln.dead and not typed.PartOf(target) {
                copies := ln.copiesArray(value, target.Type())
                ln.arrayStore(ln.mk(p), v, target.Type(), copies, sp, ln.placeStorage(target))
            } else {
                # O8d: a sole place given another value releases what it held, once it holds the new one
                rel := ln.releases(target, true)
                old := mir.NoLocal
                if rel.Len() > 0 and not ln.dead {
                    old = ln.temp(target.Type(), sp)
                    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(old), mir.Rvalue.Use(mir.Operand.Copy(ln.mk(p)))))
                }
                ln.emit(mir.Stmt.Assign(sp, ln.mk(p), mir.Rvalue.Use(v)))
                if old != mir.NoLocal { ln.releaseAt(old, rel, sp) }
            }
        }
        case typed.Stmt.Eval(sp, x) { ln.evalStmt(sp, x) }
        case typed.Stmt.Suspend(sp, x) { ln.suspend(sp, x!) }
        case typed.Stmt.If(sp, i) { ln.ifStmt(sp, i) }
        case typed.Stmt.Loop(sp, body, post) { ln.loop(sp, body, post) }
        case typed.Stmt.Jump(sp, kind, loop) { ln.jump(sp, kind, loop) }
        case typed.Stmt.Return(sp, value) { ln.ret(sp, value) }
        case typed.Stmt.Raise(sp, err, word) {
            code := mir.ErrorCode(ln.T, ln.T.Errors(ln.B.Ty), err, word)
            ln.raise(sp, mir.Operand.Const(mir.I32T, code))
        }
        case typed.Stmt.Reraise(sp, x, from) {
            # R3a, T20: an error value raised - its code recoded from its set to the body's; a null one (code 0) stops
            # the program as a failed check does
            v := ln.val(x)
            if not ln.dead {
                l := ln.local(v, x.Type(), sp)
                code := ln.into(mir.I32T, mir.Rvalue.Use(ln.errCodeOf(l, x.Type())), sp)
                nz := ln.prim(typed.PrimOp.Ne, types.BoolT, Array<mir.Operand>[code, mir.Operand.Const(mir.I32T, 0)], sp)
                some, none := ln.F.NewBlock(), ln.F.NewBlock()
                ln.end(mir.Term.Branch(nz, some, none))
                ln.start(none)
                ln.end(mir.Term.Exit(sp, mir.ExitKind.NullError, mir.Operand.None))
                ln.start(some)
                ln.pushHeld(l, x.Type(), code, sp)   # T19b: what it holds raised with it
                v = code
            }
            if not ln.dead and ln.T.Items(ln.T.Errors(ln.B.Ty)).Len() > 0 {
                ln.raise(sp, ln.into(mir.I32T, mir.Rvalue.Recode(v, from, ln.T.Errors(ln.B.Ty)), sp))
            } else if not ln.dead {
                ln.raise(sp, v)
            }
        }
        case typed.Stmt.Exit(sp, kind, msg) {
            # S16d: the message is computed only here, where the unreachable is reached
            m := mir.Operand.None
            if msg is not null { m = ln.val(msg) }
            k := mir.ExitKind.NullReached if kind == typed.ExitKind.NullReached else mir.ExitKind.Unreachable
            if not ln.dead { ln.end(mir.Term.Exit(sp, k, m)) }
        }
        case typed.Stmt.Assert(sp, c, msg) { ln.assert(sp, c, msg) }
        case typed.Stmt.Block(_, bl) { ln.block(bl) }
        case typed.Stmt.Defer(sp, bl) {
            ln.defers.Push(bl)
            ln.deferAt.Push(ln.top().S)
            # B3e: a stop interpret meets is no error leaving, so an errdefer has no cleanup (S19c, S19e)
            if ln.L.Cleanups and not ln.onError(ln.defers.Len() - 1) { ln.cleanup(sp, ln.defers.Len() - 1) }
            if ln.isDrop(ln.defers.Len() - 1) {
                ln.guardHolder(sp, bl)
                ln.guardAgain(sp)
            }
        }
        case typed.Stmt.Join(sp, j) { ln.join(sp, j) }
        case typed.Stmt.Spawn(sp, sw) { ln.spawn(sp, sw) }
        case typed.Stmt.Yield(sp, x) { ln.yield(sp, x) }
    }
}

# ---- array values (T7b, T11b) ----

# whether a type is an array of a run-time length held by value: its storage its own, made where it is declared (T7b)
fn (ln mut lowering&) valueArray(ty types.TypeId) Bool {
    t := ln.T
    r := t.Repr(ty)
    return t.KindOf(r) == types.Kind.Array and t.Length(r) == types.TypeId(0)
}

# whether storing x where a value array of type ty is wanted copies its elements: x is existing storage (a place read),
# not a temporary whose storage the target takes
fn (ln mut lowering&) copiesArray(x typed.Expr&, ty types.TypeId) Bool {
    if not ln.valueArray(ty) { return false }
    return ln.copiesValue(x)
}

# whether x, an array value, is existing storage rather than a temporary whose storage its target takes
fn (ln mut lowering&) copiesValue(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Read(_, _, _, _): true
        # a conversion names its argument's storage (T29a): a fixed array a reference names, an array of a run-time
        # length (a place) - one of fixed storage made a run-time value is copied out, new storage
        # - and one of fixed storage widened is a temporary of the innermost block, copied where it is kept
        case typed.Expr.Prim(_, pt, op, _, args): op == typed.PrimOp.Convert and args.Len() == 1 and (derefOf(args[0]) is not null or (ln.valueArray(args[0].Type()) and ln.copiesValue(args[0])) or ln.widening(op, args, pt))
        case typed.Expr.Away(_, _, y): ln.copiesValue(y)
        case typed.Expr.Seq(_, _, q): q.X is not null and ln.copiesValue(q.X!)
        # a choice copies where any value it may give is existing storage (as retCopies)
        case typed.Expr.Cond(_, _, c): c.A is not null and ln.copiesValue(c.A!) or ln.copiesValue(c.B)
        case typed.Expr.Match(_, _, m): ln.matchCopies(m)
        case typed.Expr.Try(_, _, t): ln.tryCopies(t)
        case _: false
    }
}

fn (ln mut lowering&) matchCopies(m typed.Match&) Bool {
    for a in m.Arms {
        if a.Value is not null and ln.copiesValue(a.Value!): return true
    }
    return m.NoMatch is not null and m.NoMatch!.Value is not null and ln.copiesValue(m.NoMatch!.Value!)
}

fn (ln mut lowering&) tryCopies(t typed.Try&) Bool {
    if t.X is not null and ln.copiesValue(t.X!): return true
    for c in t.Clauses {
        for df in c.Defaults {
            if ln.copiesValue(df): return true
        }
    }
    return false
}

# x with the conversions around it taken off (T29a: each names its argument's storage)
fn (ln mut lowering&) unconvert(x typed.Expr&) typed.Expr& {
    match x {
        case typed.Expr.Prim(_, _, op, _, args) {
            if op == typed.PrimOp.Convert and args.Len() == 1 and ln.valueArray(args[0].Type()) { return ln.unconvert(args[0]) }
        }
        case _ { }
    }
    return x
}

# the reference a read of what it names reads through, else null
fn derefOf(x typed.Expr&) typed.Expr?& {
    return match x {
        case typed.Expr.Read(_, _, p, _): match p {
            case typed.Lvalue.Deref(_, _, r): r
            case _: null
        }
        case _: null
    }
}

# an array value's elements copied into storage of its own (T7b), made in scope at
fn (ln mut lowering&) arrayCopy(v mir.Operand, ty types.TypeId, sp source.Span, at mir.ScopeRef, parts Bool = false) mir.Operand {
    # (QCE: elements owning storage of their own - arrays of a run-time length - copied too)
    if ln.T.OwnsParts(ty) { return ln.ownCopyOf(v, ty, at, sp, parts) }
    src := ln.local(v, ty, sp)
    n := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(src))], sp)
    buf := ln.temp(ty, sp)
    # no fill: every element is copied in at once
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(buf), mir.Rvalue.NewArray(at, ty, n, mir.Operand.None)))
    ln.emit(mir.Stmt.CopyElems(sp, mir.Lvalue.L(buf), mir.Lvalue.L(src), n))
    return mir.Operand.Copy(mir.Lvalue.L(buf))
}

# a value array local's copy of constant data (a text literal, T25d) in a stack slot of the frame rather than its
# block's arena: the length of that data where local l lives in the block declaring it (the scope pass moved it
# nowhere, so nothing reaches its storage past that block, which a slot reused each turn outlives) and the data is small
# enough for a frame, else -1. A slot nothing writes is the constant itself once LLVM sees it only ever copied from one
fn (ln mut lowering&) slotLen(l typed.LocalId, init typed.Expr&) I64 {
    if not ln.planned or ln.F.Locals[I64(l)].Home != mir.ScopeRef.Frame { return -1 }
    r := derefOf(ln.unconvert(init))
    if r is null { return -1 }
    match r {
        # (text read out as an array of characters: the reference to the constant converted, T29c)
        case typed.Expr.Prim(_, _, op, _, args) {
            if op == typed.PrimOp.Convert and args.Len() == 1 { r = args[0] }
        }
        case _ { }
    }
    match r {
        case typed.Expr.Data(_, _, _, c) {
            match c {
                case typed.Const.Bytes(b) { return b.Len() if b.Len() > 0 and b.Len() <= SlotMax else -1 }
                case _ { }
            }
        }
        case _ { }
    }
    return -1
}

# the most bytes slotLen puts in a frame
SlotMax I64 = 256

# v's n elements copied into a fixed array of the frame (a hidden local, its storage a stack slot), and that storage as
# a run-time-length array value of type ty - the pair naming it, as a fixed array a reference names is (T7c)
fn (ln mut lowering&) slotCopy(v mir.Operand, ty types.TypeId, n I64, sp source.Span) mir.Operand {
    t := ln.T
    src := ln.local(v, ty, sp)
    ft := t.Array(t.Elem(ln.arrayOf(ty)), t.Const(mir.I64T, n))
    slot := ln.temp(ft, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(slot), mir.Rvalue.Use(mir.Operand.None)))
    ln.emit(mir.Stmt.CopyElems(sp, mir.Lvalue.L(slot), mir.Lvalue.L(src), mir.Operand.Const(mir.I64T, n)))
    rt := t.Ref(ft, types.Writable)
    r := ln.into(rt, mir.Rvalue.Ref(mir.Lvalue.L(slot), rt), sp)
    return ln.prim(typed.PrimOp.Convert, ty, Array<mir.Operand>[r], sp)
}

# where local l's own storage is, so a copy of an array value it takes is made there: its home where the scope pass
# moved it, else the scope of the block declaring it; the program's for the stand-in placement
fn (ln mut lowering&) storageOf(l typed.LocalId) mir.ScopeRef {
    if not ln.planned { return mir.ScopeRef.Program }
    h := ln.F.Locals[I64(l)].Home
    if h != mir.ScopeRef.Frame { return h }
    # an array value whose elements the scope pass keeps in an outer block's arena (the inference's lift, 2.4)
    if I64(l) < ln.plan.Stored.Len() {
        match ln.plan.Stored[I64(l)] {
            case typed.Scope.Block(b) { return ln.scopeRef(typed.Scope.Block(b)) }
            case _ { }
        }
    }
    return ln.scopeRef(typed.Scope.Block(ln.B.Locals[I64(l)].In))
}

# where the storage of an array value place is: a local's, a global's in the program's scope (a value array is held
# by value only there, T7b)
fn (ln mut lowering&) placeStorage(p typed.Lvalue&) mir.ScopeRef {
    return match p {
        case typed.Lvalue.Local(_, _, id): ln.storageOf(id)
        case _: mir.ScopeRef.Program
    }
}

# the stand-in placement's locals (no plan: a body lowered while compiling, for the evaluator) whose own storage flows
# out of the body - handed back, held by what is handed back, kept by a callee, captured: given the program's scope,
# as everything the stand-in builds is, rather than the frame a return closes (the evaluator refused such a program as
# reading closed storage, where the run time - placed by the scope pass - reads it; bulk review 7, found with F4).
# EscHard, a reference-holding result's Ret, and a lend - read-only or writable - to a body that may keep a reference
# to it (item 17: the run time builds such a local where it is kept, a new value each turn, and the evaluator's frame
# slot, one storage every turn wrote, gave each kept reference the last turn's value)
fn (ln mut lowering&) standInAway() Array<Bool> {
    b := ln.B
    out := Array<Bool>(b.Locals.Len(), false)
    if ln.planned or b.Root is null: return out
    u := typed.LocalUses.Uses(ln.T, b)
    refs := ln.T.HoldsRefs(ln.T.Result(b.Ty))
    for i in range b.Locals.Len() {
        l := b.Locals[i]
        # (a holder of a value with destructors keeps its frame: one flowing out is refused while compiling all the
        # same, K2c, and a task's borrow of one in a join block - EscHard - must not move its drop)
        if l.Kind != typed.LocalKind.Var or ln.T.IsRef(l.Ty) or ln.T.NeedsDrop(l.Ty): continue
        out[i] = ln.escapes(u, i) or not ln.lendsKeep(u, i) or (u.Ret[i] and refs)
    }
    return out
}

# item 17: a value local the scope pass stores in an outer block - a reference to it kept there - is homed in that
# block's arena from its declaration on: its Live makes a new object there each time the declaration runs, a loop turn's
# kept apart from the next one's. An array of a run-time length keeps its frame slot - a reference to it is the pair
# naming its elements, which storageOf builds there already; a fixed one is laid out in its slot, which moves
fn (ln mut lowering&) homeKept(l typed.LocalId) {
    i := I64(l)
    if not ln.planned or i >= ln.plan.Stored.Len() or ln.F.Locals[i].Home != mir.ScopeRef.Frame: return
    st := ln.plan.Stored[i]
    if st != typed.Scope.Block or st.b == ln.B.Locals[i].In: return
    ty := ln.B.Locals[i].Ty
    if ln.T.IsRef(ty) or ln.arrayOf(ty) != types.UnknownT and ln.fixedLen(ln.arrayOf(ty)) < 0: return
    ln.F.Locals[i].Home = ln.scopeRef(st)
}

# where by-value local p's storage lives, where the scope pass moved it out of its own block (O26a: the result's, a
# parameter's, the program's; an outer block's): Frame for a local held where it is declared, or any other place
fn (ln mut lowering&) escapedHome(p typed.Lvalue&) mir.ScopeRef {
    if p != typed.Lvalue.Local: return mir.ScopeRef.Frame
    l := I64(p.id)
    # (a constructor's field lives with the instance; it is let go of here only where the constructor fails, and
    # then now - no instance holds it)
    if ln.B.Locals[l].Kind == typed.LocalKind.Field: return mir.ScopeRef.Frame
    if ln.F.Locals[l].Home != mir.ScopeRef.Frame: return ln.F.Locals[l].Home
    if not ln.planned: return mir.ScopeRef.Frame
    st := ln.plan.Stored[l] if l < ln.plan.Stored.Len() else typed.Scope.Unset
    if st != typed.Scope.Block or st.b == ln.B.Locals[l].In: return mir.ScopeRef.Frame
    return ln.scopeRef(st)
}

# where a function's result is built: its result scope, else the program's
fn (ln mut lowering&) resultScope() mir.ScopeRef {
    if not ln.planned { return mir.ScopeRef.Program }
    for k in range ln.B.Vars.Len() {
        if ln.B.Vars[k] == typed.ScopeVar.Result { return mir.ScopeRef.Var(k) }
    }
    return mir.ScopeRef.Program
}

# v stored into the value array at dst (T11b): written into the storage dst holds where the length is unchanged, else
# dst given v's storage - a copy of it where v is existing storage
fn (ln mut lowering&) arrayStore(dst mir.Lvalue, v mir.Operand, ty types.TypeId, copies Bool, sp source.Span
    at mir.ScopeRef) {
    src := ln.local(v, ty, sp)
    old := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(dst)], sp)
    n := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(src))], sp)
    same := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[old, n], sp)
    inPlace, fresh, after := ln.F.NewBlock(), ln.F.NewBlock(), ln.F.NewBlock()
    ln.end(mir.Term.Branch(same, inPlace, fresh))
    ln.start(inPlace)
    ln.emit(mir.Stmt.CopyElems(sp, dst, mir.Lvalue.L(src), n))
    ln.goto(after)
    ln.start(fresh)
    w := ln.arrayCopy(mir.Operand.Copy(mir.Lvalue.L(src)), ty, sp, at) if copies else mir.Operand.Copy(mir.Lvalue.L(src))
    ln.emit(mir.Stmt.Assign(sp, dst, mir.Rvalue.Use(w)))
    ln.goto(after)
    ln.start(after)
}

fn (ln mut lowering&) ifStmt(sp source.Span, i typed.If&) {
    c := ln.val(i.Test)
    if ln.dead { return }
    yes, no := ln.F.NewBlock(), ln.F.NewBlock()
    ln.end(mir.Term.Branch(c, yes, no))
    ends Vec<mir.BlockId>
    ln.start(yes)
    ln.block(i.Then)
    ln.leaveOpen(ends)
    ln.start(no)
    if i.Else is not null { ln.block(i.Else!) }
    ln.leaveOpen(ends)
    ln.patch(ends)
}

# a loop (S9): its body a scope of its own each turn, entered at its head; a continue runs the post clause, then the
# head again; a break leaves to after it
fn (ln mut lowering&) loop(sp source.Span, body typed.Block&, post typed.Block?&) {
    head := ln.F.NewBlock()
    ln.goto(head)
    ln.start(head)
    ln.loops.Push(loopCtx(body.Id, ln.levels.Len()))
    ln.block(body)
    lc := ln.loops.RefMut(ln.loops.Len() - 1)
    # falling off the body's end continues, as a continue does
    ln.leaveOpen(lc.conts)
    if lc.conts.Len() > 0 {
        ln.patch(lc.conts)
        if post is not null { ln.block(post) }
        ln.goto(head)
    }
    done := try ln.loops.Pop() catch { return }
    ln.patch(done.brk)
}

fn (ln mut lowering&) jump(sp source.Span, kind typed.JumpKind, loop typed.BlockId) {
    for k := ln.loops.Len() - 1, k >= 0, k-- {
        if ln.loops.Ref(k).Body == loop {
            ln.leave(ln.loops.Ref(k).Depth)
            # (the deferred code leave lowered may have grown ln.loops: the record taken after it - M19g)
            lc := ln.loops.RefMut(k)
            if kind == typed.JumpKind.Break { ln.leaveOpen(lc.brk) } else { ln.leaveOpen(lc.conts) }
            return
        }
    }
    ln.gap(sp, "a jump out of a loop not being lowered")
}

fn (ln mut lowering&) ret(sp source.Span, value typed.Expr?&) {
    if value is null {
        ln.leave(0)
        ln.end(mir.Term.Return(sp, mir.Operand.None))
        return
    }
    match value {
        case typed.Expr.Call(csp, ty, c) {
            if c.Tail {
                ln.tail(csp, c, ty)
                return
            }
        }
        case _ { }
    }
    res := ln.T.Result(ln.B.Ty)
    # (D9h: a view of what this body's arguments reach - its calls handing back views read as they are - is
    # handed back as it is; its callers copy it where they keep it)
    view := ln.retView(value)
    # a fixed array widened is made in the result scope, the result as it is (T7b, T7c)
    v := ln.fitAt(value, res, sp, ln.resultScope())
    if ln.dead { return }
    l := ln.local(v, res, sp)
    if not view and not ln.fits(value, res) and not ln.widens(value, res) { ln.retArrays(l, res, value, sp) }
    ln.leave(0)
    ln.end(mir.Term.Return(sp, mir.Operand.Copy(mir.Lvalue.L(l))))
}

# a become's call (S21): its arguments evaluated, each held in a temporary of the frame, then every scope closed (the
# deferred code a become may not have around it none), then the call made in the function's place (Term.Tail) - with
# the scopes the scope pass bound it to, which are the function's own scope variables and the program's
fn (ln mut lowering&) tail(sp source.Span, c typed.Call&, ty types.TypeId) {
    t := ln.T
    callee, fty := ln.callee(c.Target, sp)
    if ln.dead { return }
    raw := ln.args(c, callee, fty)
    if ln.dead { return }
    ps := t.Items(t.Params(fty))
    n := I64(raw.N)
    ops := Array<mir.Operand>(n)
    for i in range n {
        op := ln.F.Ops[I64(raw.At) + i]
        ops[i] = ln.into(ps[i], mir.Rvalue.Use(op), sp) if i < ps.Len() else op
    }
    args := ln.F.Args(ops)
    scopes := ln.passed(mir.PassedCount(t, callee, fty), c.Site)
    ln.leave(0)
    k := ln.F.AddCall(mir.Call(callee, args, scopes, mir.NoPlace, false, mir.NoBlock, mir.NoLocal, mir.NoBlock))
    ln.end(mir.Term.Tail(sp, k))
}

# a generator's value (S20): computed as a return's is, an array value among it copied into the result scope (T7b), then
# the function suspended with every scope it has open held, to go on at the block made here when it is next called
fn (ln mut lowering&) suspend(sp source.Span, value typed.Expr&) {
    res := ln.T.Result(ln.B.Ty)
    v := ln.fit(ln.val(value), value, res, sp)
    if ln.dead { return }
    l := ln.local(v, res, sp)
    ln.retArrays(l, res, value, sp)
    held := Array<mir.ScopeRef>(ln.levels.Len(), mir.ScopeRef.Frame)
    for i in range ln.levels.Len() { held[i] = mir.ScopeRef.Scope(ln.levels[ln.levels.Len() - 1 - i].S) }
    resume := ln.F.NewBlock()
    ln.end(mir.Term.Suspend(sp, mir.Operand.Copy(mir.Lvalue.L(l)), resume, ln.F.ScopeRefs(held)))
    ln.start(resume)
}

# T7b: an array value the function returns (alone or among several results) copied out of the scopes the return
# closes into its result scope (types.ScopeVarsOf gives such a result one) - where it is existing storage that is not
# there already: a temporary the scope pass built there, and a local it moved there (O26a) that nothing else names
# (Plan.RetSole), are returned as they are. One decision with a plan and without: while compiling nothing is placed,
# and every existing array is copied (into the program's scope) - the run time leaves uncopied only what nothing else
# can name, so the values are the same either way (S19's deferred code and a join's tasks included)
fn (ln mut lowering&) retArrays(l mir.LocalId, res types.TypeId, value typed.Expr&, sp source.Span) {
    t := ln.T
    if ln.valueArray(res) {
        if ln.retCopies(value, res) {
            cp := ln.arrayCopy(mir.Operand.Copy(mir.Lvalue.L(l)), res, sp, ln.resultScope())
            ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(l), mir.Rvalue.Use(cp)))
        }
        return
    }
    # (QCE: a struct or an enum owning parts - existing storage not handed back as a view its callers copy, D9h - is
    # copied as an array is; while compiling no body's result is such a view, so each is copied here)
    if ln.retOwns(res) {
        if ln.retCopies(value, res) {
            cp := ln.arrayCopy(mir.Operand.Copy(mir.Lvalue.L(l)), res, sp, ln.resultScope())
            ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(l), mir.Rvalue.Use(cp)))
        }
        return
    }
    r := t.Repr(res)
    if t.KindOf(r) != types.Kind.Tuple { return }
    parts := t.Items(t.Parts(r))
    items := tupleItems(value)
    for i in range parts.Len() {
        if not ln.valueArray(parts[i]) and not ln.retOwns(parts[i]) { continue }
        if items.Len() > 0 and i < items.Len() and not ln.retCopies(items[i], parts[i]) { continue }
        at := ln.mk(ln.with(pl(mir.Base.Local(l)), mir.Proj.Field(i)))
        cp := ln.arrayCopy(mir.Operand.Copy(at), parts[i], sp, ln.resultScope())
        ln.emit(mir.Stmt.Assign(sp, at, mir.Rvalue.Use(cp)))
    }
}

# whether a result of type ty, no array, is a value owning parts the function itself copies where it hands back
# existing storage (retArrays): not where the body's result is a view its callers copy (D9h)
fn (ln mut lowering&) retOwns(ty types.TypeId) Bool {
    return not ln.valueArray(ty) and not ln.T.IsRef(ty) and ln.T.OwnsParts(ty) and ln.L.ViewsOf(ln.B.Id) <= 0
}

# whether a returned array value is copied into the result scope: existing storage, but for a local living there - a
# conditional, a match or a try's default by any value it may give (as stage 0's cgBuiltInResult)
fn (ln mut lowering&) retCopies(x typed.Expr?&, ty types.TypeId) Bool {
    if x is null { return false }
    if ln.valueArray(ty) {
        match x {
            case typed.Expr.Cond(_, _, c) { return ln.retCopies(c.A, ty) or ln.retCopies(c.B, ty) }
            case typed.Expr.Match(_, _, m) {
                for a in m.Arms {
                    if ln.retCopies(a.Value, ty) { return true }
                }
                return m.NoMatch is not null and ln.retCopies(m.NoMatch!.Value, ty)
            }
            case typed.Expr.Try(_, _, t) {
                if ln.retCopies(t.X, ty) { return true }
                for c in t.Clauses {
                    for df in c.Defaults { if ln.retCopies(df, ty): return true }
                }
                return false
            }
            case typed.Expr.Seq(_, _, q) { return ln.retCopies(q.X, ty) }
            case _ { }
        }
    }
    if not ln.copiesArray(x, ty) and not (ln.retOwns(ty) and ln.copiesValue(x)) { return false }
    if typed.FreshTemp(x) { return false }   # (a temporary of a value made for it - a call's, a constructor's)
    # nothing placed (while compiling): every existing array is copied
    if not ln.planned { return true }
    # deferred code or a join's tasks still to run on the way out may write the local after the result is computed
    if ln.defers.Len() > 0 { return true }
    for lv in ln.levels {
        if lv.Kind == mir.ScopeKind.Join { return true }
    }
    # a conversion names its argument's storage (T29a): the local it reads, under it
    match ln.unconvert(x) {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                # a local living in the result scope is the result as it is only where nothing else can name it
                # (O26a: Plan.RetSole); every other one is copied
                # (a value owning parts is handed back from a whole local as it is, as before retOwns: its local is the
                # function's own storage - only an array's second names are proved, RetSole)
                case typed.Lvalue.Local(_, _, id) { return ln.F.Locals[I64(id)].Home != ln.resultScope() or (ln.valueArray(ty) and not ln.plan.RetSole[I64(id)]) }
                case _ { }
            }
        }
        case _ { }
    }
    return true
}

# the items of a tuple a return makes, else null
fn tupleItems(x typed.Expr&) Array<typed.Expr&>& {
    match x {
        case typed.Expr.Make(_, _, m) {
            if m.Kind == typed.MakeKind.Tuple { return m.Items }
        }
        case _ { }
    }
    return Array<typed.Expr&>(0)
}

# the body failing with code, under its own list, once every scope is closed
fn (ln mut lowering&) raise(sp source.Span, code mir.Operand) {
    if ln.T.Items(ln.T.Errors(ln.B.Ty)).Len() == 0 {
        ln.end(mir.Term.Exit(sp, mir.ExitKind.Unreachable, mir.Operand.None))
        return
    }
    l := ln.local(code, mir.I32T, sp)
    if ln.isMain() { ln.mainPayloads(mir.Operand.Copy(mir.Lvalue.L(l)), sp) }
    was := ln.erroring
    ln.erroring = true
    ln.leave(0)
    ln.erroring = was
    ln.end(mir.Term.Raise(sp, mir.Operand.Copy(mir.Lvalue.L(l))))
}

# whether the body being lowered is the program's main
fn (ln mut lowering&) isMain() Bool {
    p := ln.L.P
    match ln.B.Of {
        case typed.BodyOf.Fn(inst) {
            f := p.InstanceFn(inst)
            return p.FnModule(f) == p.L.Root and ln.T.Names.Text(p.FnDecl(f).Name) == "main"
        }
        case _ { return false }
    }
}

# B5, T19b: an error leaving main whose word carries a payload is said here, with its payload ("unhandled error:
# PErr.Bad(3, 7)"), the program ending with the status 1 - the words carrying none go on to main's caller, which names
# them by their codes
fn (ln mut lowering&) mainPayloads(code mir.Operand, sp source.Span) {
    mine := ln.T.Errors(ln.B.Ty)
    xs := ln.bangNames(mine, sp)
    for i in range 0, xs.Len(), 2 {
        k := match xs[i] {
            case mir.Operand.Const(_, bits): bits
            case _: 0
        }
        et := ln.T.ErrOf(ln.T.Items(mine)[(k >> 16) - 1])
        if ln.L.P.PayloadOf(et) == types.UnknownT or ln.L.P.WordFields(ln.T.DeclOf(et), k & 65535).Len() == 0: continue
        yes, no := ln.F.NewBlock(), ln.F.NewBlock()
        ln.end(mir.Term.Branch(ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[code, xs[i]], sp), yes, no))
        ln.start(yes)
        ln.emit(mir.Stmt.Raised(sp))   # (S18d: where it leaves main, as a Raise would say)
        ln.end(mir.Term.Exit(sp, mir.ExitKind.Unhandled, ln.withPayload(xs[i], xs[i + 1], mine, sp)))
        ln.start(no)
    }
}

# an assert (S17, S18): the test, its message computed only on the failing path
fn (ln mut lowering&) assert(sp source.Span, c typed.Expr&, msg typed.Expr?&) {
    if ln.L.AssertsTrue.Has(pair.Pair(I64(ln.B.Id), I64(sp.Start))) { return }     # decided true while compiling (S18c)
    x := ln.val(c)
    if ln.dead { return }
    ok, bad := ln.F.NewBlock(), ln.F.NewBlock()
    ln.end(mir.Term.Branch(x, ok, bad))
    ln.start(bad)
    m := mir.Operand.None
    if msg is not null { m = ln.val(msg) }
    ln.end(mir.Term.Exit(sp, mir.ExitKind.Assert, m))
    ln.start(ok)
}

# a join (P1, P1b, P4b, P4c): a scope its tasks are spawned into, waited for on every way out; where a task can let an
# error through, the wait's failed edge takes the earliest-spawned's error to the join's clauses ("try join"), then to
# the tries around it, else out of the body - unless an error is already leaving, which the join's failure does not
# replace
fn (ln mut lowering&) join(sp source.Span, j typed.Join&) {
    errs := ln.joinErrors(j.Code)
    tc mut tryCtx& = tryCtx(ln.levels.Len(), j.Clauses, false)
    for _ in j.Clauses { tc.entries.Push(mir.NoBlock) }
    ln.openBlock(j.Code, mir.ScopeKind.Join, errs)
    ln.joins.Push(tc)
    ln.joinS.Push(ln.top().S)
    for s in j.Code.Stmts { ln.stmt(s) }
    ln.closeBlock()
    done := try ln.joins.Pop() catch { return }
    try ln.joinS.Pop() catch { }
    ends Vec<mir.BlockId>
    ln.leaveOpen(ends)
    ln.clauses(done, j.Clauses, mir.NoLocal, types.VoidT, ends)
    ln.patch(ends)
}

# the errors a join's wait can fail with (P4b): what each task's call can fail with and its clauses do not take whole -
# its spawns, through the blocks in it but not through a join nested in it (P1a)
fn (ln mut lowering&) joinErrors(code typed.Block&) types.ListId {
    out Vec<types.TypeId>
    ln.spawnErrors(code, out)
    return ln.T.List(out.ToArray())
}

fn (ln mut lowering&) spawnErrors(bl typed.Block?&, out mut Vec<types.TypeId>&) {
    if bl is null { return }
    for s in bl.Stmts { ln.stmtSpawnErrors(s, out) }
}

# whether a spawned call's clauses take error type e: one taking every error, or one naming e whole
fn (ln mut lowering&) clausesTake(sw typed.Spawn&, e types.TypeId) Bool {
    t := ln.T
    for cl in sw.Clauses {
        if cl.All { return true }
        for it in cl.Items {
            if it.Word < 0 and t.Same(t.ErrOf(it.Err), t.ErrOf(e)) { return true }
        }
    }
    return false
}

fn (ln mut lowering&) stmtSpawnErrors(s typed.Stmt&, out mut Vec<types.TypeId>&) {
    t := ln.T
    match s {
        case typed.Stmt.Spawn(_, sw) {
            fty := ln.taskType(sw.Task)
            if fty == types.UnknownT { return }
            for e in t.Items(t.Errors(fty)) {
                if ln.clausesTake(sw, e) { continue }
                have := false
                for x in out { have = have or t.Same(t.ErrOf(x), t.ErrOf(e)) }
                if not have { out.Push(t.ErrOf(e)) }
            }
        }
        case typed.Stmt.Block(_, b) { ln.spawnErrors(b, out) }
        case typed.Stmt.If(_, i) {
            ln.spawnErrors(i.Then, out)
            ln.spawnErrors(i.Else, out)
        }
        case typed.Stmt.Loop(_, body, post) {
            ln.spawnErrors(body, out)
            ln.spawnErrors(post, out)
        }
        case _ { }
    }
}

# a task's function type: its call's callee's, found without evaluating it; Unknown for a task that is no call
fn (ln mut lowering&) taskType(task typed.Expr&) types.TypeId {
    match task {
        case typed.Expr.Call(_, _, c) {
            match c.Target {
                case typed.Callee.Body(id) { return ln.L.Bodies[I64(id)].Ty }
                case typed.Callee.Extern(f) { return ln.L.P.Sig(f) }
                case typed.Callee.Value(x) { return x.Type() }
                case typed.Callee.Helper(k, ht) {
                    _, ty := ln.helperCallee(k, ht)
                    return ty
                }
                case typed.Callee.Dispatch(_, _, sig) { return sig }
            }
        }
        case _ { }
    }
    return types.UnknownT
}

# a task (P1, P1g, P4a): its targets' places, then its call's callee and arguments, then the spawn into the innermost
# join, its clauses handlers run on its thread
# where each target of a task holding an array by value takes its copy of the result: where its storage is, the frame
# for one the assignment does not copy (P1g, T11b)
fn (ln mut lowering&) targetCopies(sw typed.Spawn&, task typed.Expr&) mir.Range {
    xs := Array<mir.ScopeRef>(sw.Targets.Len())
    for i in range sw.Targets.Len() {
        xs[i] = mir.ScopeRef.Frame
        tg := sw.Targets[i]
        if tg is not null and ln.valueArray(tg.Type()) and ln.copiesArray(task, tg.Type()) { xs[i] = ln.placeStorage(tg) }
    }
    return ln.F.ScopeRefs(xs)
}

fn (ln mut lowering&) spawn(sp source.Span, sw typed.Spawn&) {
    j := mir.NoScope
    for k := ln.levels.Len() - 1, k >= 0, k-- {
        if ln.levels[k].Kind == mir.ScopeKind.Join and j == mir.NoScope { j = ln.levels[k].S }
    }
    if j == mir.NoScope {
        ln.gap(sp, "a spawn outside a join")
        return
    }
    # E35: "spawn f(x)!" - the call itself is the task, and what it fails with ends the program from the task's thread
    task := sw.Task
    banged := false
    match task {
        case typed.Expr.Try(_, _, tr) if tr.Ends {
            task = tr.X!
            banged = true
        }
        case _ { }
    }
    fty := ln.taskType(task)
    if fty == types.UnknownT {
        ln.gap(sp, "a task that is no call")
        return
    }
    # the targets' places, a discarded one ("_") a temporary of its result's type, given its zero
    rs := ln.T.Results(fty)
    places := Array<mir.Lvalue>(sw.Targets.Len())
    for i in range sw.Targets.Len() {
        if sw.Targets[i] is null {
            dt := rs[i] if i < rs.Len() else types.UnknownT
            d := ln.temp(dt, sp)
            ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(d), mir.Rvalue.Use(mir.Operand.Const(dt, 0))))
            places[i] = mir.Lvalue.L(d)
        } else {
            places[i] = ln.mk(ln.place(sw.Targets[i]))
        }
    }
    match task {
        case typed.Expr.Call(csp, _, c) {
            callee, ty := ln.callee(c.Target, csp)
            if ln.dead { return }
            # (a task's arguments are read beside its spawner: no frame slot of the spawner's, no view in place of
            # their copies - bulk review 7, F12: the flag had never been set, so every turn's task shared one slot)
            ln.taskArgs = true
            args := ln.args(c, callee, ty)
            if ln.dead { return }
            match callee {
                case mir.Callee.Dispatch(_, k, dty) { callee = mir.Callee.Dispatch(ln.F.Ops[I64(args.At)], k, dty) }
                case _ { }
            }
            cls :=Array<mir.TaskClause>(sw.Clauses.Len())
            for i in range sw.Clauses.Len() {
                cl := sw.Clauses[i]
                h := mir.Operand.None
                if cl.Handler is not null { h = ln.val(cl.Handler) }
                cls[i] = mir.TaskClause(ln.F.AddItems(cl.Items), cl.All, h)
            }
            if ln.dead { return }
            ends := mir.Empty
            if banged { ends = ln.F.Args(ln.bangNames(ln.T.Errors(ty), sp)) }
            # a target holding an array by value is stored as the assignment it is judged as (P1g, T11b): a copy where
            # that assignment copies, made where the target's storage is
            cps := ln.targetCopies(sw, task) if ln.valueTargets(sw) else mir.Range(0, 0)
            k := ln.F.AddTask(callee, args, ln.passed(mir.PassedCount(ln.T, callee, ty), c.Site), places, cls, ends
                              sw.Task.Span(), cps)
            ln.emit(mir.Stmt.Spawn(sp, j, k))
        }
        case _ { }
    }
}

# whether some target of a spawn holds an array by value (P1g)
fn (ln mut lowering&) valueTargets(sw typed.Spawn&) Bool {
    for tg in sw.Targets {
        if tg is not null and ln.valueArray(tg.Type()) { return true }
    }
    return false
}

# ---- places ----

fn (ln mut lowering&) mk(p pl) mir.Lvalue {
    if p.Pk >= 0 {
        ln.gap(ln.B.Sp, "a field of a packed struct taken as a place")
        return ln.F.Place(p.B, p.Ps.View()[:p.Pk])
    }
    return ln.F.Place(p.B, p.Ps.ToArray())
}

fn (ln mut lowering&) with(p pl, x mir.Proj) pl {
    q := pl(p.B)
    for y in p.Ps { q.Ps.Push(y) }
    q.Ps.Push(x)
    q.Pk, q.PkTy = p.Pk, p.PkTy
    return q
}

# ---- packed fields (T13c) ----

# a reference to a place: a packed field's (T13c - a read-only reference the compiler takes, the program never lending
# one) to a temporary holding its value
fn (ln mut lowering&) borrow(p typed.Lvalue&, bt types.TypeId, sp source.Span) mir.Operand {
    ln.viewing = true
    q := ln.place(p)
    ln.viewing = false
    if q.Pk < 0 or ln.dead { return ln.into(bt, mir.Rvalue.Ref(ln.mk(q), bt), sp) }
    if (ln.T.PermOf(bt) & types.Writable) != 0 { ln.gap(sp, "a field of a packed struct lent writably") }
    l := ln.local(ln.packedRead(q, p.Type(), sp), p.Type(), sp)
    return ln.into(bt, mir.Rvalue.Ref(mir.Lvalue.L(l), bt), sp)
}

# p's field i, where p is a packed value: a step no place holds, read and written through the value
fn (ln mut lowering&) packedField(p pl, base types.TypeId, i I64) pl {
    q := ln.with(p, mir.Proj.Field(i))
    if q.Pk < 0 and ln.T.Packed(ln.T.Repr(base)) { q.Pk, q.PkTy = p.Ps.Len(), base }
    return q
}

# a place that is one: a packed field's value held in a temporary (T13c), any other place as it is
fn (ln mut lowering&) solid(p pl, ty types.TypeId, sp source.Span) pl {
    if p.Pk < 0 or ln.dead: return p
    return pl(mir.Base.Local(ln.local(ln.packedRead(p, ty, sp), ty, sp)))
}

# the types a packed place's steps pass through, the packed value's first
fn (ln mut lowering&) packedTypes(p pl) Array<types.TypeId> {
    n := p.Ps.Len() - p.Pk
    out := Array<types.TypeId>(n + 1)
    out[0] = p.PkTy
    for k in range n {
        r := ln.T.Repr(out[k])
        out[k + 1] = match p.Ps[p.Pk + k] {
            case mir.Proj.Field(i): ln.T.Items(ln.T.Fields(r))[i]
            case _: ln.T.Elem(r)
        }
    }
    return out
}

# the values a packed place's steps pass through: the packed value, each field read out of the one before (an element
# read from an array field held in a temporary); the last is the place's value
fn (ln mut lowering&) packedChain(p pl, sp source.Span) Array<mir.Operand> {
    tys := ln.packedTypes(p)
    vs := Array<mir.Operand>(tys.Len())
    vs[0] = mir.Operand.Copy(ln.F.Place(p.B, p.Ps.View()[:p.Pk]))
    for k in range tys.Len() - 1 {
        st := p.Ps[p.Pk + k]
        if st == mir.Proj.Field {
            vs[k + 1] = ln.prim(typed.PrimOp.Unpack, tys[k + 1], Array<mir.Operand>[vs[k], ln.constI64(st.i)], sp)
            continue
        }
        a := ln.local(vs[k], tys[k], sp)
        vs[k + 1] = ln.into(tys[k + 1], mir.Rvalue.Use(mir.Operand.Copy(ln.F.Place(mir.Base.Local(a), Array<mir.Proj>[st]))), sp)
    }
    return vs
}

fn (ln mut lowering&) packedRead(p pl, ty types.TypeId, sp source.Span) mir.Operand {
    vs := ln.packedChain(p, sp)
    return ln.into(ty, mir.Rvalue.Use(vs[vs.Len() - 1]), sp)
}

# v stored into a packed place: each value the steps pass through given its new part, from the last step back, and the
# packed value stored whole where it lies (the place before it evaluated once)
fn (ln mut lowering&) packedWrite(p pl, v mir.Operand, sp source.Span) {
    tys := ln.packedTypes(p)
    vs := ln.packedChain(p, sp)
    cur := v
    for k := tys.Len() - 2, k >= 0, k-- {
        st := p.Ps[p.Pk + k]
        if st == mir.Proj.Field {
            cur = ln.prim(typed.PrimOp.Repack, tys[k], Array<mir.Operand>[vs[k], ln.constI64(st.i), cur], sp)
            continue
        }
        a := ln.local(vs[k], tys[k], sp)
        ln.emit(mir.Stmt.Assign(sp, ln.F.Place(mir.Base.Local(a), Array<mir.Proj>[st]), mir.Rvalue.Use(cur)))
        cur = mir.Operand.Copy(mir.Lvalue.L(a))
    }
    ln.emit(mir.Stmt.Assign(sp, ln.F.Place(p.B, p.Ps.View()[:p.Pk]), mir.Rvalue.Use(cur)))
}

# a place's base and projections, its references and indices computed before
fn (ln mut lowering&) place(p typed.Lvalue?&) pl {
    if ln.dead { return pl(mir.Base.None) }
    if p is null {
        ln.gap(ln.B.Sp, "a place that is none")
        return pl(mir.Base.None)
    }
    return match p {
        case typed.Lvalue.Local(_, _, id): pl(mir.Base.Local(mir.LocalId(I32(id))))
        case typed.Lvalue.Global(_, ty, m, n): pl(mir.Base.Global(m, n, ty))
        case typed.Lvalue.Deref(sp, _, r): ln.deref(r, sp)
        case typed.Lvalue.Field(_, _, base, i): ln.packedField(ln.place(base), base.Type(), i)
        case typed.Lvalue.Elem(sp, _, e): ln.elem(e, sp)
        case typed.Lvalue.Payload(sp, _, py): ln.payload(py, sp)
        case typed.Lvalue.Temp(sp, ty, v, site): pl(mir.Base.Local(ln.tempLocal(v, ty, sp, site)))
        case typed.Lvalue.Target(sp, _): ln.target(sp)
    }
}

fn (ln mut lowering&) deref(r typed.Expr&, sp source.Span) pl {
    v := ln.val(r)
    if ln.dead { return pl(mir.Base.None) }
    l := ln.local(v, r.Type(), sp)
    return ln.with(pl(mir.Base.Local(l)), mir.Proj.Deref)
}

fn (ln mut lowering&) target(sp source.Span) pl {
    if ln.targets.Len() == 0 {
        ln.gap(sp, "a compound assignment's old value outside an assignment")
        return pl(mir.Base.None)
    }
    return ln.targets[ln.targets.Len() - 1]
}

fn (ln mut lowering&) elem(e typed.Elem&, sp source.Span) pl {
    base := ln.place(e.Base)
    x := ln.val(e.Index)
    if ln.dead { return base }
    ity := e.Index.Type()
    if e.Checked != typed.Check.None {
        n := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(ln.mk(base))], sp)
        i := ln.asI64(x, ity, sp)
        ln.bounds(i, n, false, e.Checked, mir.ExitKind.SliceBounds, sp)
    }
    if e.Checked == typed.Check.None {
        match x {
            case mir.Operand.Const(_, v) {
                if v >= 0 { return ln.with(base, mir.Proj.At(v)) }
            }
            case _ { }
        }
    }
    return ln.with(base, mir.Proj.Index(ln.local(x, ity, sp)))
}

fn (ln mut lowering&) payload(py typed.Payload&, sp source.Span) pl {
    base := ln.place(py.Base)
    if ln.dead { return base }
    if py.Checked != typed.Check.None {
        tag := ln.into(mir.I64T, mir.Rvalue.Tag(ln.mk(base)), sp)
        ok := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[tag, ln.constI64(py.Tag)], sp)
        ln.check(ok, py.Checked, mir.ExitKind.As, WrongCase, sp)
    }
    return ln.with(base, mir.Proj.Payload(py.Tag))
}

# 0 <= i < n (or <= n where incl): on to the code after, or to the check's failure
fn (ln mut lowering&) bounds(i mir.Operand, n mir.Operand, incl Bool, chk typed.Check, kind mir.ExitKind, sp source.Span) {
    lo := ln.prim(typed.PrimOp.Ge, types.BoolT, Array<mir.Operand>[i, ln.constI64(0)], sp)
    ln.check(lo, chk, kind, OutOfBounds, sp)
    hi := ln.prim(typed.PrimOp.Le if incl else typed.PrimOp.Lt, types.BoolT, Array<mir.Operand>[i, n], sp)
    ln.check(hi, chk, kind, OutOfBounds, sp)
}

# a check: on where ok holds; where it does not, an Exit for a guaranteed one (Abort), or CheckError's word to the
# innermost try for a checked one (Try)
fn (ln mut lowering&) check(ok mir.Operand, chk typed.Check, kind mir.ExitKind, word I64, sp source.Span) {
    if ln.dead or chk == typed.Check.None { return }
    good, bad := ln.F.NewBlock(), ln.F.NewBlock()
    ln.end(mir.Term.Branch(ok, good, bad))
    ln.start(bad)
    if chk == typed.Check.Abort {
        ln.end(mir.Term.Exit(sp, kind, mir.Operand.None))
    } else {
        et, code := ln.L.failure(word)
        ln.dispatch(mir.Operand.Const(mir.I32T, code), ln.T.List1(et), sp, true)
    }
    ln.start(good)
}

# a failure in the innermost check of the same kind as check but where a test failing means the check fails: not(ok)
fn (ln mut lowering&) fails(bad mir.Operand, chk typed.Check, kind mir.ExitKind, word I64, sp source.Span) {
    if ln.dead or chk == typed.Check.None { return }
    ok := ln.prim(typed.PrimOp.Not, types.BoolT, Array<mir.Operand>[bad], sp)
    ln.check(ok, chk, kind, word, sp)
}

# ---- errors ----

# E35: the error a "!" took ends the program, named as a program writes it - another module's error type by its
# module's base name, the prelude's and this module's bare ("io.Error.FULL") - a test and an exit for each word
fn (ln mut lowering&) bang(code mir.Operand, from types.ListId, sp source.Span, kind mir.ExitKind = mir.ExitKind.Error) {
    xs := ln.bangNames(from, sp)
    for i in range 0, xs.Len(), 2 {
        yes, no := ln.F.NewBlock(), ln.F.NewBlock()
        same := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[code, xs[i]], sp)
        ln.end(mir.Term.Branch(same, yes, no))
        ln.start(yes)
        ln.end(mir.Term.Exit(sp, kind, ln.withPayload(xs[i], xs[i + 1], from, sp)))
        ln.start(no)
    }
    ln.end(mir.Term.Exit(sp, kind, ln.textData("unhandled error", sp)))
}

# T19b: what "!", a test's FAIL line and an escaping error say of error code c (a constant of list from): its name as
# constant text, or, for a word carrying a payload, the name then the payload the top of the payload stack holds, as "$"
# renders an error value ("json.Error.Unexpected(3, 14)") - text made in the program's scope, the program ending
fn (ln mut lowering&) withPayload(c mir.Operand, name mir.Operand, from types.ListId, sp source.Span) mir.Operand {
    t := ln.T
    p := ln.L.P
    code := match c {
        case mir.Operand.Const(_, bits): bits
        case _: 0
    }
    xs := t.Items(from)
    j := (code >> 16) - 1
    w := code & 65535
    if j < 0 or j >= xs.Len(): return name
    et := t.ErrOf(xs[j])
    pt := p.PayloadOf(et)
    if pt == types.UnknownT or p.WordFields(t.DeclOf(et), w).Len() == 0: return name
    d := t.DeclOf(et)
    dm := t.DeclModule(d)
    b := ln.F.AddScope(mir.ScopeKind.Builder, ln.top().S, typed.BlockId(-1), sp)
    ln.emit(mir.Stmt.Open(sp, b))
    bref := mir.ScopeRef.Scope(b)
    ln.word(bref, $load.ErrQualifier(p.L.Mods[dm].Identity, dm == p.L.Root) $p.ErrorWordName(d, w), sp)
    rt := t.Ref(pt, types.ReadOnly)
    r := ln.local(ln.into(rt, mir.Rvalue.ErrTop(rt), sp), rt, sp)
    ln.renderPayload(ln.with(pl(mir.Base.Local(r)), mir.Proj.Deref), w, t.Items(t.Cases(pt))[w], bref, sp)
    txt := ln.into(ln.L.text(), mir.Rvalue.Text(bref, mir.ScopeRef.Program, ln.L.text()), sp)
    ln.emit(mir.Stmt.Close(sp, b))
    tr := t.Ref(ln.L.text(), types.ReadOnly)
    return ln.into(tr, mir.Rvalue.New(mir.ScopeRef.Program, txt, tr), sp)
}

# the errors of list from as "!" names them: for each word, its code (an I32 constant) and its name as text data
fn (ln mut lowering&) bangNames(from types.ListId, sp source.Span = source.Span(0, 0)) Array<mir.Operand>& {
    t := ln.T
    xs := t.Items(from)
    out mut Vec<mir.Operand>& = Vec<mir.Operand>()
    for j in range xs.Len() {
        et := t.ErrOf(xs[j])
        if t.KindOf(et) != types.Kind.Named { continue }
        d := t.DeclOf(et)
        dm := t.DeclModule(d)
        q := load.ErrQualifier(ln.L.P.L.Mods[dm].Identity, dm == ln.L.P.L.Root)
        ws := ln.L.P.ErrorWords(d)
        for w in range ws.Len() {
            out.Push(mir.Operand.Const(mir.I32T, ((j + 1) << 16) | w))
            out.Push(ln.textData($q $ln.L.P.ErrorWordName(d, w), sp))
        }
    }
    return out.ToArray()
}

# ---- payloads (T19b) ----

# the code an error value local x of type ty holds: the value itself, or its tuple's first part
fn (ln mut lowering&) errCodeOf(x mir.LocalId, ty types.TypeId) mir.Operand {
    if not ln.T.ErrCarries(ty): return mir.Operand.Copy(mir.Lvalue.L(x))
    return mir.Operand.Copy(ln.mk(ln.with(pl(mir.Base.Local(x)), mir.Proj.Field(0))))
}

# the positions, from 0, of the error types of list l whose words carry payloads - an error of one of them has a record
# on the payload stack from its raise until it is taken
fn (ln mut lowering&) carrying(l types.ListId) Vec<I64> {
    out Vec<I64>
    xs := ln.T.Items(l)
    for j in range xs.Len() {
        if ln.L.P.PayloadOf(ln.T.ErrOf(xs[j])) != types.UnknownT: out.Push(j)
    }
    return out
}

# whether error code (under its list) is of the type at position j of the list
fn (ln mut lowering&) typeIs(code mir.Operand, j I64, sp source.Span) mir.Operand {
    hi := ln.prim(typed.PrimOp.Shr, mir.I32T, Array<mir.Operand>[code, mir.Operand.Const(mir.I32T, 16)], sp)
    return ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[hi, mir.Operand.Const(mir.I32T, j + 1)], sp)
}

# whether error code of list l carries a payload; None where no type of l does
fn (ln mut lowering&) carries(code mir.Operand, l types.ListId, sp source.Span) mir.Operand {
    got := mir.Operand.None
    for j in ln.carrying(l) {
        one := ln.typeIs(code, j, sp)
        got = one if got == mir.Operand.None else ln.prim(typed.PrimOp.BitOr, types.BoolT, Array<mir.Operand>[got, one], sp)
    }
    return got
}

# the payload record of error code (of list l) popped where its type carries one
fn (ln mut lowering&) popIf(code mir.Operand, l types.ListId, sp source.Span) {
    c := ln.carries(code, l, sp)
    if c == mir.Operand.None: return
    yes, no := ln.F.NewBlock(), ln.F.NewBlock()
    ln.end(mir.Term.Branch(c, yes, no))
    ln.start(yes)
    ln.emit(mir.Stmt.ErrPop(sp))
    ln.goto(no)
    ln.start(no)
}

# T19b: the payload error value local l (of type ty, its code code) holds for its error's type, pushed - "error e"
fn (ln mut lowering&) pushHeld(l mir.LocalId, ty types.TypeId, code mir.Operand, sp source.Span) {
    t := ln.T
    if not t.ErrCarries(ty): return
    set := t.Items(t.ErrValItems(ty))
    for j in range set.Len() {
        pt := ln.L.P.PayloadOf(t.ErrOf(set[j]))
        if pt == types.UnknownT: continue
        yes, no := ln.F.NewBlock(), ln.F.NewBlock()
        ln.end(mir.Term.Branch(ln.typeIs(code, j, sp), yes, no))
        ln.start(yes)
        part := mir.Operand.Copy(ln.mk(ln.with(pl(mir.Base.Local(l)), mir.Proj.Field(ln.L.P.PayloadField(ty, j)))))
        ln.errPush(part, pt, sp)
        ln.goto(no)
        ln.start(no)
    }
}

# T19b: error value v of type from as one of type to (T20): its code recoded (R6) and, for a set carrying payloads, the
# payload of its code's type moved into the target's part for that type - every other part its zero
fn (ln mut lowering&) errConvert(v mir.Operand, from types.TypeId, to types.TypeId, sp source.Span) mir.Operand {
    t := ln.T
    x := ln.local(v, from, sp)
    code := ln.into(mir.I32T, mir.Rvalue.Recode(ln.errCodeOf(x, from), t.ErrValItems(from), t.ErrValItems(to)), sp)
    if not t.ErrCarries(to): return code
    res := ln.temp(to, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(res), mir.Rvalue.Use(mir.Operand.Const(to, 0))))
    rp := pl(mir.Base.Local(res))
    ln.emit(mir.Stmt.Assign(sp, ln.mk(ln.with(rp, mir.Proj.Field(0))), mir.Rvalue.Use(code)))
    if not t.ErrCarries(from): return mir.Operand.Copy(mir.Lvalue.L(res))
    fs := t.Items(t.ErrValItems(from))
    ts := t.Items(t.ErrValItems(to))
    for i in range fs.Len() {
        et := t.ErrOf(fs[i])
        if ln.L.P.PayloadOf(et) == types.UnknownT: continue
        for j in range ts.Len() {
            if t.ErrOf(ts[j]) != et: continue
            # (an error of type et, under from at i, is under to at j: its part moved across where its code says so)
            yes, no := ln.F.NewBlock(), ln.F.NewBlock()
            ln.end(mir.Term.Branch(ln.typeIs(code, j, sp), yes, no))
            ln.start(yes)
            src := mir.Operand.Copy(ln.mk(ln.with(pl(mir.Base.Local(x)), mir.Proj.Field(ln.L.P.PayloadField(from, i)))))
            ln.emit(mir.Stmt.Assign(sp, ln.mk(ln.with(rp, mir.Proj.Field(ln.L.P.PayloadField(to, j)))), mir.Rvalue.Use(src)))
            ln.goto(no)
            ln.start(no)
        }
    }
    return mir.Operand.Copy(mir.Lvalue.L(res))
}

# payload v (a payload enum's value, of type pt) pushed: a record on top of the payload stack, v's own copy built in its
# region, the record pointing at it
fn (ln mut lowering&) errPush(v mir.Operand, pt types.TypeId, sp source.Span) {
    h := ln.temp(mir.I64T, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(h), mir.Rvalue.ErrPush))
    at := mir.ScopeRef.Held(h)
    # (the copy's calls placed beside the raise, never at its span, which the trace reads as the raise's own - S18d)
    own := ln.ownCopyOf(v, pt, at, source.Span(sp.Start + 1, sp.End))
    rt := ln.T.Ref(pt, types.ReadOnly)
    r := ln.into(rt, mir.Rvalue.New(at, own, rt), sp)
    ln.emit(mir.Stmt.ErrSet(sp, r))
}

# a clause's error value v (of type ty, its code set) with the payload its error carries read off the top of the stack -
# shallow, the stack's own; every other payload part its zero
fn (ln mut lowering&) errCaught(v mir.Operand, ty types.TypeId, sp source.Span) mir.Operand {
    t := ln.T
    x := ln.local(v, ty, sp)
    res := ln.temp(ty, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(res), mir.Rvalue.Use(mir.Operand.Const(ty, 0))))
    code := ln.into(mir.I32T, mir.Rvalue.Use(ln.errCodeOf(x, ty)), sp)
    rp := pl(mir.Base.Local(res))
    ln.emit(mir.Stmt.Assign(sp, ln.mk(ln.with(rp, mir.Proj.Field(0))), mir.Rvalue.Use(code)))
    set := t.Items(t.ErrValItems(ty))
    for j in range set.Len() {
        pt := ln.L.P.PayloadOf(t.ErrOf(set[j]))
        if pt == types.UnknownT: continue
        f := ln.L.P.PayloadField(ty, j)
        yes, no := ln.F.NewBlock(), ln.F.NewBlock()
        ln.end(mir.Term.Branch(ln.typeIs(code, j, sp), yes, no))
        ln.start(yes)
        rt := t.Ref(pt, types.ReadOnly)
        r := ln.local(ln.into(rt, mir.Rvalue.ErrTop(rt), sp), rt, sp)
        top := ln.F.Place(mir.Base.Local(r), Array<mir.Proj>[mir.Proj.Deref])
        ln.emit(mir.Stmt.Assign(sp, ln.mk(ln.with(rp, mir.Proj.Field(f))), mir.Rvalue.Use(mir.Operand.Copy(top))))
        ln.goto(no)
        ln.start(no)
    }
    return mir.Operand.Copy(mir.Lvalue.L(res))
}

# text as constant data (T25d), a String&
fn (ln mut lowering&) textData(text String&, sp source.Span) mir.Operand {
    c := ln.F.AddConst(typed.Const.Bytes(text))
    return mir.Operand.Data(ln.T.Ref(ln.L.text(), types.ReadOnly), c, ln.file, sp)
}

# the module the body being lowered is in
fn (ln mut lowering&) module() I64 {
    for m in range ln.L.P.L.Mods.Len() {
        if ln.L.P.L.Mods[m].File == ln.file { return m }
    }
    return -1
}

# an error with code, under list from, reaching here: to the first clause of the innermost try taking it, the scopes
# opened since the try closed on the way; what its clauses do not take leaves the body under its own list (R13, R17),
# every scope closed - a try around it never sees it, but for a loop's own call (Passes), whose leftovers go on to it
# raised: the error is raised here, by a check, not passed on by a call - a "!" taking it starts its trace here (S18d)
fn (ln mut lowering&) dispatch(code mir.Operand, from types.ListId, sp source.Span, raised Bool = false) {
    t := ln.T
    xs := t.Items(from)
    # the error types of the list a clause tried before takes whole: a code of one of them reaches no later clause, so
    # a clause taking every type left takes the code with no test (a for-in's Exhausted, its iterator failing with
    # nothing else, D18e: no path out of the loop but its break)
    covered := Array<Bool>(xs.Len())
    left := xs.Len()
    for ti := ln.tries.Len() - 1, ti >= 0, ti-- {
        # (each read of the try's record taken anew: a clause reached runs the deferred code it leaves, which may lower
        # tries of its own and grow ln.tries - M19g)
        clauses := ln.tries[ti].Clauses
        for ci in range clauses.Len() {
            if ln.dead { return }
            cl := clauses[ci]
            test1 := mir.Operand.None
            always := cl.All
            for it in cl.Items {
                if always { break }
                k := -1
                for j in range xs.Len() {
                    if k < 0 and t.Same(t.ErrOf(xs[j]), t.ErrOf(it.Err)) { k = j }
                }
                if k < 0 { continue }
                if it.Word < 0 and not covered[k] {
                    covered[k] = true
                    left--
                }
                one := mir.Operand.None
                if it.Word < 0 {
                    hi := ln.prim(typed.PrimOp.Shr, mir.I32T, Array<mir.Operand>[code, mir.Operand.Const(mir.I32T, 16)], sp)
                    one = ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[hi, mir.Operand.Const(mir.I32T, k + 1)], sp)
                } else {
                    w := mir.Operand.Const(mir.I32T, ((k + 1) << 16) | it.Word)
                    one = ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[code, w], sp)
                }
                test1 = one if test1 == mir.Operand.None else ln.prim(typed.PrimOp.BitOr, types.BoolT, Array<mir.Operand>[test1, one], sp)
            }
            if not always and test1 == mir.Operand.None { continue }
            if always or left == 0 {
                ln.toClause(ti, ci, code, from)
                return
            }
            yes, no := ln.F.NewBlock(), ln.F.NewBlock()
            ln.end(mir.Term.Branch(test1, yes, no))
            ln.start(yes)
            ln.toClause(ti, ci, code, from)
            ln.start(no)
        }
        # what this try's clauses do not take leaves the body - past a "!", it ends the program
        if ln.tries.Ref(ti).Ends {
            if raised { ln.emit(mir.Stmt.Raised(sp)) }
            ln.bang(code, from, sp)
            return
        }
        if not ln.tries.Ref(ti).Passes { break }
    }
    # with no try at all, the call is a T29d literal's constructor - decided while compiling not to fail (Key.Literal),
    # its error edge never taken
    mineErrs := ln.T.Errors(ln.B.Ty)
    match ln.B.Of {
        case typed.BodyOf.Test(_) {
            # S16: an error a try lets out of a test body fails the test, named on its FAIL line
            if ln.tries.Len() > 0 {
                ln.bang(code, from, sp, mir.ExitKind.Escaped)
                return
            }
        }
        case _ { }
    }
    if t.Items(mineErrs).Len() == 0 or ln.tries.Len() == 0 {
        ln.end(mir.Term.Exit(sp, mir.ExitKind.Unreachable, mir.Operand.None))
        return
    }
    ln.raise(sp, ln.into(mir.I32T, mir.Rvalue.Recode(code, from, mineErrs), sp))
}

# from here to clause ci of try tc: the error, where the clause names it, recoded from its list to the clause's own set
# (R11b), then the scopes opened since the try closed, then a jump to the clause's entry
fn (ln mut lowering&) toClause(ti I64, ci I64, code mir.Operand, from types.ListId) {
    cl := ln.tries.Ref(ti).Clauses[ci]
    named := false
    if cl.Caught >= 0 {
        bl := mir.LocalId(I32(cl.Caught))
        bt := ln.F.Locals[I64(bl)].Ty
        if ln.T.ErrCarries(bt) {
            # T19b: its code here; the clause's block gives it its payload and pops the record (check's caughtPayload)
            named = true
            ln.emit(mir.Stmt.Assign(cl.Sp, mir.Lvalue.L(bl), mir.Rvalue.Use(mir.Operand.Const(bt, 0))))
            at := ln.mk(ln.with(pl(mir.Base.Local(bl)), mir.Proj.Field(0)))
            ln.emit(mir.Stmt.Assign(cl.Sp, at, mir.Rvalue.Recode(code, from, cl.CaughtSet)))
        } else {
            ln.emit(mir.Stmt.Assign(cl.Sp, mir.Lvalue.L(bl), mir.Rvalue.Recode(code, from, cl.CaughtSet)))
        }
    }
    # T19b: a clause taking an error whose type carries a payload, and naming none, pops its record
    if not named: ln.popIf(code, from, cl.Sp)
    was := ln.erroring
    ln.erroring = true
    ln.leave(ln.tries.Ref(ti).Depth)
    ln.erroring = was
    if ln.dead { return }
    # (the deferred code leave lowered may have grown ln.tries: the record taken after it - M19g)
    tc := ln.tries.RefMut(ti)
    if tc.entries[ci] == mir.NoBlock { tc.entries[ci] = ln.F.NewBlock() }
    ln.goto(tc.entries[ci])
}

# a try (R8-R11): X with its errors taken by the clauses, its value - or a clause's default - in one slot
fn (ln mut lowering&) try(x typed.Expr&, t typed.Try&, sp source.Span) mir.Operand {
    ty := x.Type()
    slot := mir.NoLocal
    if ty != types.VoidT and ty != types.NoreturnT { slot = ln.temp(ty, sp) }
    relK := ln.tryRel
    ln.tryRel = -1
    tc mut tryCtx& = tryCtx(ln.levels.Len(), t.Clauses, t.Ends, t.Passes)
    for _ in t.Clauses { tc.entries.Push(mir.NoBlock) }
    ln.tries.Push(tc)
    v := ln.val(t.X)
    # (the clauses' entries the errors reaching them made, as the try's record on the stack has them)
    done := try ln.tries.Pop() catch { return mir.Operand.None }
    ends Vec<mir.BlockId>
    if not ln.dead and slot != mir.NoLocal and v != mir.Operand.None {
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(slot), mir.Rvalue.Use(v)))
        if relK >= 0 {
            rel Vec<Array<I64>>
            rel.Push(Array<I64>[0] if relK == 1 else Array<I64>(0))
            ln.releaseAt(slot, rel, sp)
        }
    }
    ln.leaveOpen(ends)
    ln.clauses(done, t.Clauses, slot, ty, ends)
    ln.patch(ends)
    if slot == mir.NoLocal { return mir.Operand.None }
    return mir.Operand.Copy(mir.Lvalue.L(slot))
}

# the clauses errors reached, each from its entry: its code as a block of its own, then its defaults into the slot;
# each falls through to where ends lead
fn (ln mut lowering&) clauses(tc tryCtx, cls Array<typed.Clause&>&, slot mir.LocalId, ty types.TypeId
                              ends mut Vec<mir.BlockId>&) {
    for ci in range cls.Len() {
        if tc.entries[ci] == mir.NoBlock { continue }
        cl := cls[ci]
        ln.start(tc.entries[ci])
        ln.F.Taken.Push(tc.entries[ci])
        if cl.Code is not null { ln.block(cl.Code!) }
        if not ln.dead and slot != mir.NoLocal and cl.Defaults.Len() > 0 {
            if cl.Defaults.Len() == 1 {
                d := ln.val(cl.Defaults[0])
                ln.emit(mir.Stmt.Assign(cl.Sp, mir.Lvalue.L(slot), mir.Rvalue.Use(d)))
            } else {
                ops := Array<mir.Operand>(cl.Defaults.Len())
                for k in range cl.Defaults.Len() { ops[k] = ln.val(cl.Defaults[k]) }
                ln.emit(mir.Stmt.Assign(cl.Sp, mir.Lvalue.L(slot), mir.Rvalue.Aggregate(ty, 0, ln.F.Args(ops))))
            }
        }
        ln.leaveOpen(ends)
    }
}

# ---- expressions ----

# a value: computed by the statements emitted so far, held in a temporary (or a constant)
fn (ln mut lowering&) val(x typed.Expr?&) mir.Operand {
    if ln.dead or x is null { return mir.Operand.None }
    # O8d: a site whose value has a region of its own - the region made first, so everything it is built from lands
    # there - and forgotten after, so another lowering of the same expression (deferred code) makes its own
    rs := ln.regionSite(x)
    if rs < 0 { return ln.value(x) }
    held := ln.regionOf(rs)
    v := ln.value(x)
    ln.regions.Remove(rs)
    return ln.settled(rs, held, v, x.Type(), x.Span())
}

# an owner's value built in a region of its own (O8d, types.Anchors) - or an array place's, its one anchor itself: the
# region released at once where none of its anchors names it - it holds nothing - so a place given an empty value keeps
# no region for it
fn (ln mut lowering&) settled(rs I64, held mir.ScopeRef, v mir.Operand, ty types.TypeId, sp source.Span) mir.Operand {
    if ln.dead or v == mir.Operand.None or ln.plan.RegionKind[rs] != 1 { return v }
    if ln.T.Anchors(ty).Len() == 0 and not ln.T.OwnedPart(ty) { return v }
    h := match held {
        case mir.ScopeRef.Held(l): l
        case _: mir.NoLocal
    }
    if h == mir.NoLocal { return v }
    l := ln.local(v, ty, sp)
    ln.emit(mir.Stmt.Settle(sp, h, mir.Lvalue.L(l)))
    return mir.Operand.Copy(mir.Lvalue.L(l))
}

fn (ln mut lowering&) value(x typed.Expr&) mir.Operand {
    ty := x.Type()
    if ty == types.UnknownT {
        ln.gap(x.Span(), "an unknown type (a check error or gap): an expression")
        return mir.Operand.None
    }
    return match x {
        case typed.Expr.Lit(_, lt, bits): mir.Operand.Const(lt, bits)
        case typed.Expr.Data(sp, dt, _, c): mir.Operand.Data(dt, ln.F.AddConst(c), ln.file, sp)
        case typed.Expr.Read(sp, rt, p, _): ln.read(p, rt, sp)
        case typed.Expr.Borrow(sp, bt, p): ln.borrow(p, bt, sp)
        case typed.Expr.Take(sp, tt, p): ln.take(p, tt, sp)
        case typed.Expr.Promote(sp, pt, pr): ln.promote(pr, pt, sp)
        case typed.Expr.Call(sp, ct, c): ln.call(c, ct, sp)
        case typed.Expr.Make(sp, mt, m): ln.make(m, mt, sp)
        case typed.Expr.Collect(sp, ct, c): ln.collect(c, ct, sp)
        case typed.Expr.Prim(sp, pt, op, chk, args): ln.primExpr(op, chk, args, pt, sp)
        case typed.Expr.Slice(sp, st, s): ln.slice(s, st, sp)
        case typed.Expr.Cond(sp, ct, c): ln.cond(c, ct, sp)
        case typed.Expr.Seq(_, _, s): ln.seq(s)
        case typed.Expr.Match(sp, mt, m): ln.match(m, mt, sp)
        case typed.Expr.Try(sp, _, tr): ln.try(x, tr, sp)
        case typed.Expr.Fn(sp, ft, fv): ln.fnVal(fv, ft, sp)
        case typed.Expr.Text(sp, tt, tx): ln.text(tx, tt, sp)
        case typed.Expr.Away(_, file, y): ln.away(file, y)
    }
}

# a value fitted to where it goes: a fixed array where a run-time one of its element is wanted widened to it (T7c),
# which check leaves implicit where a ":=" global or a local's array is given a literal
fn (ln mut lowering&) fit(v mir.Operand, x typed.Expr?&, to types.TypeId, sp source.Span) mir.Operand {
    if ln.dead or x is null { return v }
    if ln.fits(x, to) { return ln.widen(v, x.Type(), to, sp, ln.innermost()) }
    return v
}

# x's value where a value of type ty is kept in scope at: a fixed array widened - by fit, or by a conversion written -
# made there; anything else as val and fit give it
fn (ln mut lowering&) fitAt(x typed.Expr&, ty types.TypeId, sp source.Span, at mir.ScopeRef) mir.Operand {
    if ln.widens(x, ty) {
        arg := convertArg(x)
        a := ln.val(arg)
        if ln.dead { return mir.Operand.None }
        return ln.widen(a, arg.Type(), ty, sp, at)
    }
    v := ln.val(x)
    if ln.dead or not ln.fits(x, ty) { return v }
    return ln.widen(v, x.Type(), ty, sp, at)
}

# whether x is a conversion written of a fixed array's value to a run-time-length array value
fn (ln mut lowering&) widens(x typed.Expr&, ty types.TypeId) Bool {
    return match x {
        case typed.Expr.Prim(_, pt, op, _, args): ln.widening(op, args, pt)
        case typed.Expr.Away(_, _, _): false
        case _: false
    }
}

fn convertArg(x typed.Expr&) typed.Expr& {
    return match x {
        case typed.Expr.Prim(_, _, _, _, args): args[0]
        case _: x
    }
}

# whether a primitive operation widens a fixed array's value to a run-time-length array value (T7c)
fn (ln mut lowering&) widening(op typed.PrimOp, args Array<typed.Expr&>&, ty types.TypeId) Bool {
    t := ln.T
    return op == typed.PrimOp.Convert and args.Len() == 1 and ln.valueArray(ty) and not t.IsRef(t.Repr(args[0].Type())) and
           ln.arrayOf(args[0].Type()) != types.UnknownT and ln.fixedLen(ln.arrayOf(args[0].Type())) >= 0
}

# whether fit widens x to type to: a fixed array where a run-time one of its element is wanted
fn (ln mut lowering&) fits(x typed.Expr?&, to types.TypeId) Bool {
    if x is null { return false }
    t := ln.T
    from := t.Repr(x.Type())
    want := t.Repr(to)
    return t.KindOf(from) == types.Kind.Array and t.KindOf(want) == types.Kind.Array and t.Length(from) != types.TypeId(0) and
           t.Length(want) == types.TypeId(0) and t.Same(t.Elem(from), t.Elem(want))
}

# a fixed array's value as a run-time-length one (T7c): storage of its own in the innermost block - a temporary the
# declaration, the store or the return copies from where it keeps it (T7b) - never the program's, where a loop's
# conversions grew it every turn
fn (ln mut lowering&) widen(v mir.Operand, from types.TypeId, to types.TypeId, sp source.Span, at mir.ScopeRef) mir.Operand {
    src := ln.local(v, from, sp)
    k := ln.fixedLen(ln.arrayOf(from))
    n := mir.Operand.Const(mir.I64T, k)
    buf := ln.temp(to, sp)
    fe := ln.T.Elem(ln.T.Repr(from))
    te := ln.T.Elem(ln.T.Repr(to))
    if ln.laidApart(fe, te) {
        # QCE: rows laid out in place made rows of a run-time length - each widened in turn, made where the array is
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(buf), mir.Rvalue.NewArray(at, to, n, mir.Operand.None)))
        for i in range k {
            e := ln.into(fe, mir.Rvalue.Use(mir.Operand.Copy(ln.F.Place(mir.Base.Local(src), Array<mir.Proj>[mir.Proj.At(i)]))), sp)
            w := ln.widen(e, fe, te, sp, at)
            ln.emit(mir.Stmt.Assign(sp, ln.F.Place(mir.Base.Local(buf), Array<mir.Proj>[mir.Proj.At(i)]), mir.Rvalue.Use(w)))
        }
        return mir.Operand.Copy(mir.Lvalue.L(buf))
    }
    # no fill: every element is copied in at once
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(buf), mir.Rvalue.NewArray(at, to, n, mir.Operand.None)))
    ln.emit(mir.Stmt.CopyElems(sp, mir.Lvalue.L(buf), mir.Lvalue.L(src), n))
    return mir.Operand.Copy(mir.Lvalue.L(buf))
}

# whether arrays of element types a and b lay their elements out apart: a's elements arrays laid out in place, b's of a
# run-time length (QCE: Array<Array<I64>> made with a fill, wanted as rows each its own) - a widening element by element
fn (ln mut lowering&) laidApart(a types.TypeId, b types.TypeId) Bool {
    t := ln.T
    ra := t.Repr(a)
    rb := t.Repr(b)
    return t.KindOf(ra) == types.Kind.Array and t.KindOf(rb) == types.Kind.Array and t.Length(ra) != types.TypeId(0) and
           t.Length(rb) == types.TypeId(0)
}

# whether a conversion of a value of type from to array type to lays its elements out apart (laidApart): a copy, never
# the pair naming from's storage
fn (ln mut lowering&) convertsApart(from types.TypeId, to types.TypeId) Bool {
    a := ln.arrayOf(from)
    b := ln.arrayOf(to)
    return a != types.UnknownT and b != types.UnknownT and ln.laidApart(ln.T.Elem(a), ln.T.Elem(b))
}

# the innermost scope open here that storage can be made in: a block's, a loop turn's, a join's or the frame's; the
# program's for the stand-in placement or outside every function
fn (ln mut lowering&) innermost() mir.ScopeRef {
    if not ln.planned { return mir.ScopeRef.Program }
    for i := ln.levels.Len() - 1, i >= 0, i-- {
        k := ln.levels[i].Kind
        if k == mir.ScopeKind.Block or k == mir.ScopeKind.Loop or k == mir.ScopeKind.Join or k == mir.ScopeKind.Frame {
            return mir.ScopeRef.Scope(ln.levels[i].S)
        }
    }
    return mir.ScopeRef.Program
}

fn (ln mut lowering&) away(file I64, y typed.Expr&) mir.Operand {
    was := ln.file
    ln.file = file
    v := ln.val(y)
    ln.file = was
    return v
}

fn (ln mut lowering&) read(p typed.Lvalue&, ty types.TypeId, sp source.Span) mir.Operand {
    ln.readOut(p, ty)
    q := ln.place(p)
    if ln.dead { return mir.Operand.None }
    if q.Pk >= 0 { return ln.packedRead(q, ty, sp) }
    return ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(q))), sp)
}

# the prelude's p.vacate() (docs/memory.md 3.4): what the place holds, read. The slot keeps its bits, which nothing
# reads again - the prelude vacates only positions it no longer uses - so a loop of vacates over numbers is deleted by
# the optimizer and costs nothing
fn (ln mut lowering&) take(p typed.Lvalue&, ty types.TypeId, sp source.Span) mir.Operand {
    # O8d: where what the place holds is a sole place's, it is moved out, the place left empty - so the next let-go of
    # it releases nothing twice
    # QCE: a value owning storage moved out leaves its place's bytes zero (an empty array where the parts were), so a
    # copy of the whole that holds the place - a Vec's buffer past its count - copies nothing it no longer holds
    if ln.releases(p).Len() > 0 or ln.ownsStorage(ty) {
        q := ln.place(p)
        if ln.dead { return mir.Operand.None }
        return ln.into(ty, mir.Rvalue.Take(ln.mk(q)), sp)
    }
    return ln.read(p, ty, sp)
}

# a statement's value dropped (S3): a vacate of a sole place releases what it held, and so does a call's result that is
# a value moved out of one (Pop, TakeAt, Take), once the statement has it (O8d)
fn (ln mut lowering&) evalStmt(sp source.Span, x typed.Expr&) {
    rel Vec<Array<I64>>
    match x {
        case typed.Expr.Take(_, _, p) { rel = ln.releases(p) }
        case _ {
            c := typed.Call.Of(x)
            if ln.freeing and c is not null {
                k := ln.L.Free!.DroppedMove(c)
                handle := k >= 0 and ln.L.Free!.IsHandle(k)
                # a try statement with clauses has its value only on its success path - where a clause takes the
                # error there is nothing to release - so the try releases it there, before the paths join
                if k >= 0 and clausedTry(x) {
                    ln.tryRel = 1 if handle else 0
                    ln.val(x)
                    return
                }
                if k >= 0 { rel.Push(Array<I64>[0] if handle else Array<I64>(0)) }
            }
        }
    }
    if rel.Len() == 0 { ln.readHere(x) }     # (a value nothing keeps)
    v := ln.val(x)
    if rel.Len() == 0 or ln.dead { return }
    l := ln.local(v, x.Type(), sp)
    ln.releaseAt(l, rel, sp)
}

# whether an expression is a try with clauses
fn clausedTry(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Try(_, _, t): t.Clauses.Len() > 0
        case _: false
    }
}

# the comprehension an expression is - a lane operation's result, the collect a sequence ends in - null for none
fn collectOf(x typed.Expr&) typed.Collect?& {
    return match x {
        case typed.Expr.Collect(_, _, c): c
        case typed.Expr.Seq(_, _, sq): collectOf(sq.X!) if sq.X is not null else null
        case _: null
    }
}

# a temporary given storage (E12c): New in the site's scope, a destructor-bearing instance registered there (O16)
fn (ln mut lowering&) promote(pr typed.Promote&, ty types.TypeId, sp source.Span) mir.Operand {
    t0 := ln.T
    a0 := ln.arrayOf(ty)
    if t0.IsRef(t0.Repr(ty)) and a0 != types.UnknownT and ln.fixedLen(a0) < 0 {
        return try ln.promotedInPlace(pr, ty, sp, a0) catch NotInPlace default ln.promoteNew(pr, ty, sp)
    }
    return ln.promoteNew(pr, ty, sp)
}

# a fresh run-time-length array made only to be promoted - "s.data = Array<T>(n)", a literal - made where the reference
# goes, the reference its pair, rather than made and copied there (T7); failing with NotInPlace for any other value
fn (ln mut lowering&) promotedInPlace(pr typed.Promote&, ty types.TypeId, sp source.Span, a0 types.TypeId) mir.Operand ? NotInPlace {
    t0 := ln.T
    # a comprehension or a lane operation's result (E27, E39) - a sequence's statements, then its collect - made where
    # the reference goes too (the second bulk review: each was made, then copied there)
    cl := collectOf(pr.X)
    x := pr.X
    if cl is not null and cl.Site >= typed.SiteId(0) {
        if x == typed.Expr.Seq {
            for st in x.s.Stmts { ln.stmt(st) }
            if ln.dead { return mir.Operand.None }
        }
        sv, sa := ln.adoptSite, ln.adoptAt
        ln.adoptSite = cl.Site
        ln.adoptAt = ln.built(pr.Site)
        r := ln.collect(cl, ty, sp)
        ln.adoptSite, ln.adoptAt = sv, sa
        return r
    }
    if x == typed.Expr.Make {
        m := x.m
        if (m.Kind != typed.MakeKind.Fill and m.Kind != typed.MakeKind.Array) or m.Site < typed.SiteId(0) { error NotInPlace }
        sv, sa := ln.adoptSite, ln.adoptAt
        ln.adoptSite = m.Site
        ln.adoptAt = ln.built(pr.Site)
        r := ln.fill(m, ty, sp) if m.Kind == typed.MakeKind.Fill else ln.arrayLit(m, ty, sp)
        ln.adoptSite, ln.adoptAt = sv, sa
        return r
    }
    if t0.Length(a0) == types.TypeId(0) and ln.copyInPlace(pr) { return ln.promotedCopy(pr, ty, sp) }
    return try ln.promotedFill(pr, ty, sp, a0)
}

# a value's own copy (MakeKind.Copy), or a conversion of one (T13a's `String(chars)`), promoted to a run-time-length
# array reference: made where the reference goes, the reference its pair, rather than made and copied there again (item
# 17, os.Args). A copy D9i moved is the local's own storage: taken where that is the copy's scope - which the local
# outlives (movable) - and the reference's too
fn (ln mut lowering&) promotedCopy(pr typed.Promote&, ty types.TypeId, sp source.Span) mir.Operand {
    x := pr.X
    m := copyMade(x)!
    sv, sa := ln.adoptSite, ln.adoptAt
    ln.adoptSite = m.Site
    ln.adoptAt = ln.built(pr.Site)
    v := ln.val(x)
    ln.adoptSite, ln.adoptAt = sv, sa
    if ln.dead { return mir.Operand.None }
    slot := ln.local(v, x.Type(), sp)
    return ln.into(ty, mir.Rvalue.Ref(mir.Lvalue.L(slot), ty), sp)
}

# whether a promoted value is a copy promotedCopy makes where the reference goes: no region's (O8d) on either side, and a
# moved one only where the copy's scope is the reference's
fn (ln mut lowering&) copyInPlace(pr typed.Promote&) Bool {
    m := copyMade(pr.X)
    if m is null or m.Site < typed.SiteId(0) or not ln.planned: return false
    if I64(m.Site) >= ln.plan.Built.Len() or I64(pr.Site) >= ln.plan.Built.Len(): return false
    if ln.built(pr.Site) == mir.ScopeRef.Held or ln.built(m.Site) == mir.ScopeRef.Held: return false
    return not ln.noCopy.Has(I64(m.Site)) or ln.plan.Built[I64(m.Site)] == ln.plan.Built[I64(pr.Site)]
}

# the value's own copy x is, or converts (T13a): null for any other
fn copyMade(x typed.Expr&) typed.Make?& {
    inner := x.args[0] if x == typed.Expr.Prim and x.op == typed.PrimOp.Convert and x.args.Len() == 1 else x
    if inner != typed.Expr.Make or inner.m.Kind != typed.MakeKind.Copy: return null
    return inner.m
}

# a literal or a fill of a known length (T7c, held in place: no site) converted to the run-time-length array promoted:
# made where the reference goes - the conversion's storage of its own had no place but the program's, so a call given
# one in a loop grew it every turn (the uafcc review's leak)
fn (ln mut lowering&) promotedFill(pr typed.Promote&, ty types.TypeId, sp source.Span, a0 types.TypeId) mir.Operand ? NotInPlace {
    t0 := ln.T
    x := pr.X
    if x != typed.Expr.Prim or x.op != typed.PrimOp.Convert or x.args.Len() != 1 or t0.Length(a0) != types.TypeId(0) { error NotInPlace }
    arg := x.args[0]
    if arg != typed.Expr.Make { error NotInPlace }
    m := arg.m
    fa := ln.arrayOf(arg.ty)
    if m.Kind != typed.MakeKind.Fill and m.Kind != typed.MakeKind.Array or t0.IsRef(t0.Repr(arg.ty)) or fa == types.UnknownT or ln.fixedLen(fa) < 0 { error NotInPlace }
    at := ln.built(pr.Site)
    return ln.fill(m, ty, sp, true, at) if m.Kind == typed.MakeKind.Fill else ln.arrayLit(m, ty, sp, true, at)
}

# a value promoted (E12c): made, then given storage of its own where the reference goes - a destructor registered there
# for an instance of a type with one
fn (ln mut lowering&) promoteNew(pr typed.Promote&, ty types.TypeId, sp source.Span) mir.Operand {
    v := ln.val(pr.X)
    if ln.dead { return mir.Operand.None }
    s := ln.built(pr.Site)
    r := ln.into(ty, mir.Rvalue.New(s, v, ty), sp)
    t := ln.T
    if t.IsRef(ty) and t.NeedsDrop(t.Referent(ty)) { ln.emit(mir.Stmt.RegisterDtor(sp, s, t.Referent(ty), r)) }
    return r
}

fn (ln mut lowering&) seq(s typed.Seq&) mir.Operand {
    for st in s.Stmts { ln.stmt(st) }
    if s.X is null { return mir.Operand.None }
    return ln.val(s.X)
}

# "a if c else b" (E28), and/or (E7): only the chosen value computed, into one slot
fn (ln mut lowering&) cond(c typed.Cond&, ty types.TypeId, sp source.Span) mir.Operand {
    x := ln.val(c.C)
    if ln.dead { return mir.Operand.None }
    slot := ln.temp(ty, sp)
    yes, no := ln.F.NewBlock(), ln.F.NewBlock()
    ln.end(mir.Term.Branch(x, yes, no))
    ends Vec<mir.BlockId>
    ln.start(yes)
    a := ln.val(c.A)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(slot), mir.Rvalue.Use(a)))
    ln.leaveOpen(ends)
    ln.start(no)
    b := ln.val(c.B)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(slot), mir.Rvalue.Use(b)))
    ln.leaveOpen(ends)
    ln.patch(ends)
    return mir.Operand.Copy(mir.Lvalue.L(slot))
}

# a match (S12, S13): the subject held, then each arm's alternatives tested in order; the first that holds binds, then
# the guard; a value match's arms each give the one slot
fn (ln mut lowering&) match(m typed.Match&, ty types.TypeId, sp source.Span) mir.Operand {
    for s in m.Held { ln.stmt(s) }
    if ln.dead { return mir.Operand.None }
    slot := mir.NoLocal
    if m.IsValue and ty != types.VoidT and ty != types.NoreturnT { slot = ln.temp(ty, sp) }
    ends Vec<mir.BlockId>
    for a in m.Arms {
        if ln.dead { break }
        next Vec<mir.BlockId>
        hit Vec<mir.BlockId>
        for k in range a.Alts.Len() {
            if ln.dead { break }
            alt := a.Alts[k]
            c := ln.val(alt.Test)
            if ln.dead { break }
            yes, no := ln.F.NewBlock(), ln.F.NewBlock()
            ln.end(mir.Term.Branch(c, yes, no))
            ln.start(yes)
            for bd in alt.Binds {
                v := ln.val(bd.From)
                ln.emit(mir.Stmt.Assign(a.Sp, mir.Lvalue.L(mir.LocalId(I32(bd.To))), mir.Rvalue.Use(v)))
            }
            ln.leaveOpen(hit)
            ln.start(no)
        }
        ln.leaveOpen(next)
        ln.patch(hit)
        if ln.dead {
            ln.patch(next)
            continue
        }
        if a.Guard is not null {
            g := ln.val(a.Guard)
            if not ln.dead {
                yes, no := ln.F.NewBlock(), ln.F.NewBlock()
                ln.end(mir.Term.Branch(g, yes, no))
                ln.start(no)
                ln.leaveOpen(next)
                ln.start(yes)
            }
        }
        ln.arm(a, slot)
        ln.leaveOpen(ends)
        ln.patch(next)
    }
    if not ln.dead {
        ln.arm(m.NoMatch!, slot)
        ln.leaveOpen(ends)
    }
    ln.patch(ends)
    if slot == mir.NoLocal { return mir.Operand.None }
    return mir.Operand.Copy(mir.Lvalue.L(slot))
}

# an arm's code, as a block of its own, then its value into the slot
fn (ln mut lowering&) arm(a typed.Arm&, slot mir.LocalId) {
    if a.Code is null {
        if a.Value is not null and slot != mir.NoLocal {
            v := ln.val(a.Value)
            ln.emit(mir.Stmt.Assign(a.Sp, mir.Lvalue.L(slot), mir.Rvalue.Use(v)))
        }
        return
    }
    if ln.levels.Len() > 0 and ln.top().Block == a.Code!.Id {
        for s in a.Code!.Stmts { ln.stmt(s) }
        if a.Value is not null and slot != mir.NoLocal {
            v := ln.val(a.Value)
            ln.emit(mir.Stmt.Assign(a.Sp, mir.Lvalue.L(slot), mir.Rvalue.Use(v)))
        }
        return
    }
    ln.openBlock(a.Code!, mir.ScopeKind.Block)
    for s in a.Code!.Stmts { ln.stmt(s) }
    if a.Value is not null and slot != mir.NoLocal {
        v := ln.val(a.Value)
        ln.emit(mir.Stmt.Assign(a.Sp, mir.Lvalue.L(slot), mir.Rvalue.Use(v)))
    }
    ln.closeBlock()
}

# ---- calls ----

# what a call reaches, and its function type
fn (ln mut lowering&) callee(c typed.Callee&, sp source.Span) mir.Callee, types.TypeId {
    match c {
        case typed.Callee.Body(id) { return ln.bodyCallee(id) }
        case typed.Callee.Extern(f) {
            ty := ln.L.P.Sig(f)
            return mir.Callee.Extern(f, ty), ty
        }
        case typed.Callee.Value(x) { return ln.valueCallee(x) }
        case typed.Callee.Helper(k, ht) { return ln.helperCallee(k, ht) }
        # T32b: through the table of the "any" the first argument is - which call() puts in, once it is computed
        case typed.Callee.Dispatch(_, k, sig) { return mir.Callee.Dispatch(mir.Operand.None, k, sig), sig }
    }
}

fn (ln mut lowering&) bodyCallee(id typed.BodyId) mir.Callee, types.TypeId {
    ty := ln.L.Bodies[I64(id)].Ty
    return mir.Callee.Fn(mir.FnKey.Body(id), ty), ty
}

fn (ln mut lowering&) valueCallee(x typed.Expr&) mir.Callee, types.TypeId {
    v := ln.val(x)
    return mir.Callee.Value(v), x.Type()
}

fn (ln mut lowering&) helperCallee(k typed.Helper, ht types.TypeId) mir.Callee, types.TypeId {
    kind := mir.HelperKind.Equal if k == typed.Helper.Equal else mir.HelperKind.Hash
    ht = ln.L.helperTy(kind, ht)
    ty := mir.HelperType(ln.T, kind, ht)
    ln.L.Want(mir.FnKey.Helper(kind, ht))
    return mir.Callee.Fn(mir.FnKey.Helper(kind, ht), ty), ty
}

# a call's arguments, left to right: a helper's taken as references to their values held (its ABI, DESIGN.md 1.8.1)
fn (ln mut lowering&) args(c typed.Call&, callee mir.Callee, ty types.TypeId) mir.Range {
    t := ln.T
    ps := t.Items(t.Params(ty))
    helper := match callee {
        case mir.Callee.Fn(mir.FnKey.Helper(_, _), _): true
        case _: false
    }
    ops := Array<mir.Operand>(c.Args.Len())
    task := ln.taskArgs
    ln.taskArgs = false
    # (D9h: an argument for a read-only parameter of a call whose result holds no reference is only read
    # before the call returns - not a task's, which is read beside its spawner)
    reads := not t.HoldsRefs(t.Result(ty)) and not task
    body := match c.Target {
        case typed.Callee.Body(id): I64(id)
        case _: I64(-1)
    }
    # (bulk review 7, F3) the hand-ons among the arguments: each holder lets go once the call is made, after every
    # argument - a later one leaving (an error passed on, a clause's return) leaves the value with its holder
    gone mut Vec<typed.Stmt&>& = Vec<typed.Stmt&>()
    for i in range c.Args.Len() {
        a := ln.handedOver(c.Args[i], gone)
        if reads and i < ps.Len() and not (t.IsRef(ps[i]) and (t.PermOf(ps[i]) & types.Writable) != 0) { ln.readHere(a, c) }
        if not task: ln.argView(a, body, i)
        ro := i < ps.Len() and t.IsRef(ps[i]) and (t.PermOf(ps[i]) & types.Writable) == 0
        v := ln.stackArg(a, body, i) if reads and ro else mir.Operand.None
        if v == mir.Operand.None { v = ln.val(a) }
        if i < ps.Len() { v = ln.fit(v, a, ps[i], a.Span()) }
        # (a helper of a reference type, E10's null-aware "==" of two array references, takes references to them)
        held := t.IsRef(a.Type()) and t.Same(t.Plain(t.Referent(a.Type())), t.Plain(t.Referent(ps[i]))) if i < ps.Len() and t.IsRef(ps[i]) else true
        if helper and i < ps.Len() and t.IsRef(ps[i]) and not held {
            l := ln.local(v, a.Type(), a.Span())
            v = ln.into(ps[i], mir.Rvalue.Ref(mir.Lvalue.L(l), ps[i]), a.Span())
        }
        ops[i] = v
    }
    for st in gone { ln.stmt(st) }
    return ln.F.Args(ops)
}

# an argument that hands a holder's value on (a Gone Seq, under conversions): the value read, its flag's clearing kept in
# gone for after every argument
fn (ln mut lowering&) handedOver(a typed.Expr&, gone mut Vec<typed.Stmt&>&) typed.Expr& {
    match a {
        case typed.Expr.Seq(_, _, q) {
            if not q.Gone or q.X is null: return a
            for st in q.Stmts { gone.Push(st) }
            return q.X!
        }
        case _ { return a }
    }
}

# a value given storage for a read-only reference parameter of a call that keeps nothing of it and hands back nothing
# holding a reference (`inside(v[k], x, y)`): the storage a stack slot of this frame, needed only while the call runs,
# rather than an arena's, which a loop turn would allocate and close every turn. A struct's or an enum's value, with no
# destructor (O16), in no region early freeing made (O8d); None where the argument is no such promote
fn (ln mut lowering&) stackArg(a typed.Expr&, body I64, i I64) mir.Operand {
    if not ln.planned or body < 0 or a != typed.Expr.Promote: return mir.Operand.None
    pr := a.pr
    t := ln.T
    rt := a.ty
    o := t.Referent(rt) if t.IsRef(rt) else types.UnknownT
    if o == types.UnknownT or t.KindOf(t.Repr(o)) != types.Kind.Named: return mir.Operand.None
    if t.KindOf(o) == types.Kind.Named and t.HasBody(o) and t.Destructs(o): return mir.Operand.None
    if pr.Site < typed.SiteId(0) or I64(pr.Site) >= ln.plan.Built.Len() or ln.plan.Built[I64(pr.Site)] == typed.Scope.Region: return mir.Operand.None
    if not ln.L.keepsNoRef(body, i): return mir.Operand.None
    v := ln.val(pr.X)
    if ln.dead { return mir.Operand.None }
    l := ln.local(v, o, a.Span())
    return ln.into(rt, mir.Rvalue.Ref(mir.Lvalue.L(l), rt), a.Span())
}

# a rendered operand's own copy (check's, of a value owning storage) left out where nothing in its statement could
# change what it copies before its piece renders (stableRef)
fn (ln mut lowering&) pieceView(x typed.Expr&) {
    match x {
        case typed.Expr.Make(_, _, m) {
            if m.Kind != typed.MakeKind.Copy or m.Items.Len() != 1 or m.Site < typed.SiteId(0): return
            if ln.stableRef(m.Items[0]): ln.noCopy.Put(I64(m.Site), true)
        }
        case _ { }
    }
}

# a by-value argument's own copy (check's valueArg, a MakeKind.Copy) left out where nothing could tell: the callee keeps
# its parameter's parts as they are (written by nothing, kept nowhere, handed back by no return - Lowerer.preserves)
# and what the argument copies is changed by nothing while the call runs (stableRef) - so the callee reads the
# caller's storage, as a read-only "&" would have (D9a, D9h)
fn (ln mut lowering&) argView(a typed.Expr&, body I64, i I64) {
    if body < 0: return
    match a {
        case typed.Expr.Make(_, _, m) {
            if m.Kind != typed.MakeKind.Copy or m.Items.Len() != 1 or m.Site < typed.SiteId(0): return
            if not ln.L.preserves(body, i) or not ln.stableRef(m.Items[0]): return
            ln.noCopy.Put(I64(m.Site), true)
            ln.L.ArgViews++
        }
        case _ { }
    }
}

fn (ln mut lowering&) call(c typed.Call&, ty types.TypeId, sp source.Span) mir.Operand {
    t := ln.T
    if c.Zero and c.Args.Len() == 0 { return ln.zero(ty, sp, c.Site) }
    callee, fty := ln.callee(c.Target, sp)
    if ln.dead { return mir.Operand.None }
    args := ln.args(c, callee, fty)
    if ln.dead { return mir.Operand.None }
    match callee {
        case mir.Callee.Dispatch(_, k, dty) { callee = mir.Callee.Dispatch(ln.F.Ops[I64(args.At)], k, dty) }
        case _ { }
    }
    res := t.Result(fty)
    scopes := ln.passed(mir.PassedCount(t, callee, fty), c.Site)
    ok := ln.F.NewBlock()
    dest := mir.NoLocal
    if res != types.VoidT and res != types.NoreturnT { dest = ln.temp(ty if ty != types.VoidT else res, sp) }
    errs := t.Errors(fty)
    code := mir.NoLocal
    eb := mir.NoBlock
    if t.Items(errs).Len() > 0 {
        code = ln.temp(mir.I32T, sp)
        eb = ln.F.NewBlock()
    }
    k := ln.F.AddCall(mir.Call(callee, args, scopes, mir.Lvalue.L(dest) if dest != mir.NoLocal else mir.NoPlace
                               dest != mir.NoLocal, ok, code, eb))
    if c.Site == ln.walkSite and c.Site >= typed.SiteId(0) { ln.markWalk(k, callee, fty, scopes) }
    ln.end(mir.Term.Call(sp, k))
    if eb != mir.NoBlock {
        ln.start(eb)
        ln.dispatch(mir.Operand.Copy(mir.Lvalue.L(code)), errs, sp)
    }
    ln.start(ok)
    if res == types.NoreturnT {
        ln.end(mir.Term.Exit(sp, mir.ExitKind.Unreachable, mir.Operand.None))
        return mir.Operand.None
    }
    if dest == mir.NoLocal { return mir.Operand.None }
    # D9h: a function handing back a view of what it is given - copied into where its result goes, as the
    # function would have, unless the value is only read here before anything can change what it views
    if ln.viewCall(c, ty) {
        if ln.L.ViewDump { ln.L.ViewLog.Push($ln.L.P.L.Diags.Locate(ln.file, I64(sp.Start)) ": " $("read" if ln.reads.Has(I64(c.Site)) else "kept") $(" stable" if ln.stableViews(c) else "")) }
        # (E31d: a value whose copy runs a declared Copy is copied whatever reads it)
        inPlace := not t.RunsCopy(ty) and (ln.vlSites.Has(I64(c.Site)) or (ln.reads.Has(I64(c.Site)) and ln.stableViews(c)))
        if inPlace or ln.freshCtor(c) {
            ln.L.ViewReads++
        } else {
            ln.L.ViewCopies++
            return ln.arrayCopy(mir.Operand.Copy(mir.Lvalue.L(dest)), ty, sp, ln.viewCopyAt(c.Site, ln.resultOf(fty, scopes)), true)
        }
    }
    return mir.Operand.Copy(mir.Lvalue.L(dest))
}

# where a view call's copy is made (D9h): where the scope pass put the value (its Built - a local's block, so a copy made
# in a loop turn goes with the turn, O2), else where the callee's result would live; a region early freeing made for
# the value (O8d) wins
fn (ln mut lowering&) viewCopyAt(site typed.SiteId, at mir.ScopeRef) mir.ScopeRef {
    if not ln.planned or site < typed.SiteId(0) or I64(site) >= ln.plan.Built.Len(): return at
    if ln.plan.Built[I64(site)] == typed.Scope.Unset: return at
    return match at {
        case mir.ScopeRef.Held(_): at
        case _: ln.built(site)
    }
}

# D9h: a constructor's call whose instance views only storage made for the call (typed.FreshViews) - its own, as
# early freeing reads it too (free.olang's call)
fn (ln mut lowering&) freshCtor(c typed.Call&) Bool {
    id := typed.CalleeBody(c)
    if not ln.planned or id < 0 or ln.L.Bodies[id].Of != typed.BodyOf.Ctor: return false
    lw := ln.L
    # (an instance viewing only locals moved into it at their last use owns what it views, D9i - where it lands inside
    # their blocks)
    if ln.movedViews(c, id): return true
    # (where early freeing decided, its judgement - made before it wrote its regions into the plans - is the one both
    # follow: a copy it took for left out must be left out, as a region released holds what was not copied)
    if lw.Free is not null and lw.Free!.Done: return lw.Free!.FreshCtorAt(I64(ln.B.Id), I64(c.Site))
    return typed.FreshViews(ln.plan, c, lw.ViewsOf(typed.BodyId(I32(id))), fn(b typed.BodyId) I64 { return lw.ViewsOf(b) }
                            fn(b typed.BodyId) Array<I64> { return lw.P.T.ScopeVarsOf(lw.Bodies[I64(b)].Ty) })
}

# ---- value results handed over uncopied (D9h) ----

# the parameters a body's result may be a view of (check's load.ViewResults), where the body is lowered with a plan -
# none otherwise: while compiling, and for any other body, a returned view is copied (T7b)
fn (lw Lowerer&) ViewsOf(id typed.BodyId) I64 {
    if I64(id) < 0 or I64(id) >= lw.Plans.Len() or I64(id) >= lw.Bodies.Len(): return 0
    return match lw.Bodies[I64(id)].Of {
        case typed.BodyOf.Fn(inst): try lw.P.L.ViewResults.Get(inst) catch default I64(0)
        # (a constructor whose fields hold views of what it is given - check.ctorViewKey's)
        case typed.BodyOf.Ctor(t, twin): (try lw.P.L.CtorViews.Get(I64(t)) catch default I64(0)) if twin == types.ListId(0) else 0
        case _: 0
    }
}

# the walk over this body (typed.ViewWalk), as check made it
fn (ln mut lowering&) viewWalk() typed.ViewWalk {
    m I64 = 0
    b := ln.B
    for k in range b.Params.Len().Min(typed.ViewBits) {
        key := pair.Pair(b.File, I64(b.Local(b.Params[k]).Sp.Start))
        if not ln.L.P.L.ParamWritten.Has(key): m |= I64(1) << k
    }
    lw := ln.L
    return typed.ViewWalk(ln.T, b, m, fn(id typed.BodyId) I64 { return lw.ViewsOf(id) }
                          fn(id typed.LocalId) I64 { return try ln.rvl.Get(I64(id)) catch default I64(-1) })
}

# whether a return hands back a view of what the arguments reach, as it is: its calls handing back views marked read
fn (ln mut lowering&) retView(x typed.Expr&) Bool {
    if ln.L.ViewsOf(ln.B.Id) <= 0 or not ln.viewValue(ln.T.Result(ln.B.Ty)): return false
    w := ln.viewWalk()
    if w.Roots(x) <= 0: return false
    ln.markViews(w, x)
    ln.L.ViewReturns++
    return true
}

# the calls of an expression a return hands back as they are (typed.ViewWalk.Roots): each read where it stands
fn (ln mut lowering&) markViews(w typed.ViewWalk&, x typed.Expr?&) {
    if x is null: return
    match x {
        case typed.Expr.Call(_, _, c) { if w.CallRoots(c) > 0: ln.reads.Put(I64(c.Site), true) }
        case typed.Expr.Cond(_, _, k) {
            ln.markViews(w, k.A)
            ln.markViews(w, k.B)
        }
        case typed.Expr.Match(_, _, m) {
            for a in m.Arms { ln.markViews(w, a.Value) }
            if m.NoMatch is not null { ln.markViews(w, m.NoMatch!.Value) }
        }
        case typed.Expr.Try(_, _, tr) {
            ln.markViews(w, tr.X)
            for c in tr.Clauses {
                for d in c.Defaults { ln.markViews(w, d) }
            }
        }
        case typed.Expr.Seq(_, _, q) { ln.markViews(w, q.X) }
        case typed.Expr.Away(_, _, y) { ln.markViews(w, y) }
        case typed.Expr.Prim(_, _, op, _, args) { if op == typed.PrimOp.Convert and args.Len() == 1: ln.markViews(w, args[0]) }
        case _ { }
    }
}

# whether a call is of a function handing back a view of what it is given, its result an array value
fn (ln mut lowering&) viewCall(c typed.Call&, ty types.TypeId) Bool {
    id := match c.Target {
        case typed.Callee.Body(i): i
        case _: typed.BodyId(-1)
    }
    return id >= typed.BodyId(0) and ln.L.ViewsOf(id) > 0 and ln.viewValue(ty)
}

# whether a value of type ty may be handed back as a view (D9h; any value holding storage of its own)
fn (ln mut lowering&) viewValue(ty types.TypeId) Bool { return not ln.T.IsRef(ty) and typed.HoldsOwned(ln.T, ty) }

# x, where it stands, is only read before its statement ends: the call of a function handing back views it is (through
# a conversion or a temporary's storage given to it) may give its view as it is (call). Its consumer, where known - k, a
# call given it read-only whose result holds no reference, or the place p read out of it into a value owning nothing -
# bounds what is evaluated while the view is alive (windowQuiet); else its whole statement does (quiet)
fn (ln mut lowering&) readHere(x typed.Expr&, k typed.Call?& = null, p typed.Lvalue?& = null) {
    match x {
        case typed.Expr.Call(_, _, c) {
            ln.reads.Put(I64(c.Site), true)
            ln.readWin.Put(I64(c.Site), (k is not null or p is not null) and ln.windowQuiet(c, k, p))
        }
        case typed.Expr.Promote(_, _, pr) { ln.readHere(pr.X, k, p) }
        case typed.Expr.Prim(_, _, op, _, args) { if op == typed.PrimOp.Convert and args.Len() == 1: ln.readHere(args[0], k, p) }
        case typed.Expr.Away(_, _, y) { ln.readHere(y, k, p) }
        case typed.Expr.Seq(_, _, q) { if q.X is not null and q.Stmts.Len() == 0: ln.readHere(q.X!, k, p) }
        case typed.Expr.Read(_, _, q, _), typed.Expr.Borrow(_, _, q) { ln.readPlace(q, k, p) }
        case _ { }
    }
}

# (a part of a temporary read or borrowed where it stands - `v[i].xs.Len()`: the temporary is only read too)
fn (ln mut lowering&) readPlace(q typed.Lvalue&, k typed.Call?& = null, p typed.Lvalue?& = null) {
    match q {
        case typed.Lvalue.Field(_, _, base, _) { ln.readPlace(base, k, p) }
        case typed.Lvalue.Payload(_, _, py) { ln.readPlace(py.Base, k, p) }
        case typed.Lvalue.Elem(_, _, e) { ln.readPlace(e.Base, k, p) }
        case typed.Lvalue.Temp(_, _, x, _) { ln.readHere(x, k, p) }
        case _ { }
    }
}

# a value owning nothing read out of a place made of a view call's temporary (`v[i].w`): the view is alive only while
# the place's indices are evaluated and the read is made (D9h by evaluation order)
fn (ln mut lowering&) readOut(p typed.Lvalue&, ty types.TypeId) {
    if not ln.planned or ln.viewValue(ty): return
    match p {
        case typed.Lvalue.Field(_, _, _, _), typed.Lvalue.Payload(_, _, _), typed.Lvalue.Elem(_, _, _) { ln.readPlace(p, null, p) }
        case _ { }
    }
}

# D9h by evaluation order: whether nothing evaluated while view call c's value is alive may write storage it views -
# its consumer k's arguments and k itself (a call given the view read-only, whose result holds no reference: the view
# is dead once k returns), or the indices of place p read out of it. Judged per argument c may view, as a local's block
# is (quietLife): by the types of that storage's by-value parts, a call writing only what reaches none of them, and no
# mutable global reaching them
fn (ln mut lowering&) windowQuiet(c typed.Call&, k typed.Call?&, p typed.Lvalue?&) Bool {
    v := ln.L.ViewsOf(typed.BodyId(I32(typed.CalleeBody(c))))
    if v <= 0 or (v & typed.ViewOther) != 0: return false
    for j in range c.Args.Len().Min(typed.ViewBits) {
        if (v & (I64(1) << j)) == 0: continue
        a := c.Args[j].Type()
        if not ln.windowFor(ln.T.Referent(a) if ln.T.IsRef(a) else a, k, p): return false
    }
    return true
}

fn (ln mut lowering&) windowFor(of types.TypeId, k typed.Call?&, p typed.Lvalue?&) Bool {
    ln.qCover.Clear()
    ln.qWrites.Clear()
    ln.coverAdd(of, 0)
    ln.qRoot = of
    ok := true
    for g in ln.L.P.L.MutGlobals {
        gt := types.TypeId(I32(g))
        if ln.objHits(gt) or ln.writesCover(gt, 0): ok = false
    }
    if ok and k is not null: ok = ln.quietCall(k)
    if ok and p is not null: ok = ln.quietPlace(p)
    ln.qCover.Clear()
    ln.qWrites.Clear()
    return ok
}

# whether every argument a call may hand back a view of is storage nothing in this function can change before the view
# is read: what a place of this function reaches where the statement is quiet, constant data, or a value made for the
# call (no other name holds it)
fn (ln mut lowering&) stableViews(c typed.Call&) Bool {
    id := match c.Target {
        case typed.Callee.Body(i): i
        case _: typed.BodyId(-1)
    }
    v := ln.L.ViewsOf(id)
    if (v & typed.ViewOther) != 0: return false
    ln.winOk = try ln.readWin.Get(I64(c.Site)) catch default false
    defer ln.winOk = false
    for k in range c.Args.Len().Min(typed.ViewBits) {
        if (v & (I64(1) << k)) != 0 and not ln.stableRef(c.Args[k]): return false
    }
    return true
}

fn (ln mut lowering&) stableRef(r typed.Expr&) Bool {
    # (what any place of this function reaches, where the statement the view is read in writes nothing until its end)
    # (or where nothing evaluated while the view is alive writes it - its consumer's window, windowQuiet)
    if (ln.winOk or ln.quiet()) and ln.placeRooted(r): return true
    return match r {
        case typed.Expr.Read(_, _, p, _): ln.stableHolder(p)
        case typed.Expr.Borrow(_, _, p): ln.stablePlace(p)
        case typed.Expr.Slice(_, _, sl): ln.stablePlace(sl.Base)
        case typed.Expr.Data(_, _, _, _): true
        case typed.Expr.Promote(_, _, pr): ln.stableMade(pr.X)
        case typed.Expr.Prim(_, _, op, _, args): typed.PassesRefs(op) and args.Len() > 0 and ln.stableRef(args[0])
        case typed.Expr.Away(_, _, y): ln.stableRef(y)
        case _: false
    }
}

# whether a reference is read out of, or borrows, a place of this function: a local's or a parameter's, or a part of
# one, or what one reaches
fn (ln mut lowering&) placeRooted(r typed.Expr&) Bool {
    return match r {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p): ln.localRooted(p)
        case typed.Expr.Slice(_, _, sl): ln.localRooted(sl.Base)
        case typed.Expr.Prim(_, _, op, _, args): typed.PassesRefs(op) and args.Len() > 0 and ln.placeRooted(args[0])
        case typed.Expr.Away(_, _, y): ln.placeRooted(y)
        case _: false
    }
}

fn (ln mut lowering&) localRooted(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Local(_, _, _): true
        case typed.Lvalue.Field(_, _, base, _): ln.localRooted(base)
        case typed.Lvalue.Elem(_, _, e): ln.localRooted(e.Base)
        case typed.Lvalue.Payload(_, _, py): ln.localRooted(py.Base)
        case typed.Lvalue.Deref(_, _, x): ln.placeRooted(x)
        case _: false
    }
}

# whether the statement being lowered writes nothing a view read in it could view before it ends: no call in what it
# evaluates gives a writable reference, calls through a function value or an "any", or runs statements of its own (a
# block of a match, a clause, a comprehension, a lambda made) - so between a call handing back a view of what a place of
# this function reaches and the view's last read in the statement nothing writes it (nothing but what reaches the same
# storage from a global through a call given read-only arguments, which a program none of whose globals can be written
# so has none of - check.mutStorage)
fn (ln mut lowering&) quiet() Bool {
    n := ln.stmtSafe.Len()
    if n == 0 or ln.L.P.L.MutStorage: return false
    if ln.stmtSafe[n - 1] < 0: ln.stmtSafe[n - 1] = 1 if ln.quietStmt(ln.stmts[n - 1]) else 0
    return ln.stmtSafe[n - 1] == 1
}

fn (ln mut lowering&) quietStmt(s typed.Stmt&) Bool {
    return match s {
        case typed.Stmt.Let(_, _, x), typed.Stmt.Eval(_, x): ln.quietX(x)
        case typed.Stmt.Assign(_, p, x): ln.quietPlace(p) and ln.quietX(x)
        case typed.Stmt.If(_, i): ln.quietX(i.Test)
        case typed.Stmt.Return(_, x): ln.quietX(x)
        case typed.Stmt.Assert(_, c, _): ln.quietX(c)
        case _: false
    }
}

fn (ln mut lowering&) quietX(x typed.Expr?&) Bool {
    if x is null: return true
    return match x {
        case typed.Expr.Lit(_, _, _), typed.Expr.Data(_, _, _, _): true
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p): ln.quietPlace(p)
        case typed.Expr.Promote(_, _, pr): ln.quietX(pr.X)
        case typed.Expr.Call(_, _, c): ln.quietCall(c)
        case typed.Expr.Make(_, _, m): ln.quietAll(m.Items) and ln.quietX(m.Length)
        case typed.Expr.Prim(_, _, _, _, args): ln.quietAll(args)
        case typed.Expr.Slice(_, _, sl): ln.quietPlace(sl.Base) and ln.quietX(sl.Lo) and ln.quietX(sl.Hi)
        case typed.Expr.Cond(_, _, k): ln.quietX(k.C) and ln.quietX(k.A) and ln.quietX(k.B)
        case typed.Expr.Seq(_, _, q): q.Stmts.Len() == 0 and ln.quietX(q.X)
        case typed.Expr.Try(_, _, tr): ln.quietX(tr.X) and ln.quietClauses(tr)
        case typed.Expr.Text(_, _, tx): ln.quietPieces(tx)
        case typed.Expr.Away(_, _, y): ln.quietX(y)
        case _: false
    }
}

fn (ln mut lowering&) quietAll(xs Array<typed.Expr&>&) Bool {
    for x in xs {
        if not ln.quietX(x): return false
    }
    return true
}

fn (ln mut lowering&) quietClauses(tr typed.Try&) Bool {
    for c in tr.Clauses {
        if c.Code is not null or not ln.quietAll(c.Defaults): return false
    }
    return true
}

fn (ln mut lowering&) quietPieces(tx typed.Text&) Bool {
    for pc in tx.Pieces {
        match pc {
            case typed.Piece.Render(x) { if not ln.quietX(x): return false }
            case _ { }
        }
    }
    return true
}

fn (ln mut lowering&) quietPlace(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Local(_, _, _), typed.Lvalue.Global(_, _, _, _), typed.Lvalue.Target(_, _): true
        case typed.Lvalue.Deref(_, _, r): ln.quietX(r)
        case typed.Lvalue.Field(_, _, base, _): ln.quietPlace(base)
        case typed.Lvalue.Elem(_, _, e): ln.quietPlace(e.Base) and ln.quietX(e.Index)
        case typed.Lvalue.Payload(_, _, py): ln.quietPlace(py.Base)
        case typed.Lvalue.Temp(_, _, v, _): ln.quietX(v)
    }
}

# a call writing nothing it is not given writably: a body's, an extern's or a helper's, every argument read-only or a value
# reaching no code that could write anything (types.ReachesCode: a closure holding a "mut" reference, an "any")
fn (ln mut lowering&) quietCall(c typed.Call&) Bool {
    t := ln.T
    ty := match c.Target {
        case typed.Callee.Body(id): ln.L.Bodies[I64(id)].Ty
        case typed.Callee.Extern(f): ln.L.P.Sig(f)
        case typed.Callee.Helper(_, _): types.UnknownT
        case _: types.TypeId(-1)
    }
    if ty == types.TypeId(-1): return false
    ps := t.Items(t.Params(ty)) if ty != types.UnknownT else Array<types.TypeId>(0)
    for k in range c.Args.Len() {
        a := c.Args[k].Type()
        writable := k < ps.Len() and t.IsRef(ps[k]) and (t.PermOf(ps[k]) & types.Writable) != 0
        # (quietLife: a callee given what reaches none of the view's storage writably leaves it as it is - a value or a
        # read-only reference holding a writable reference to such storage, at any depth, is a way to write it; in a
        # statement judged alone, with no view's storage known, any writable reference it holds is)
        if writable and (ln.qCover.Len() == 0 or ln.writesCover(a, 0)): return false
        if not writable and ln.qCover.Len() == 0 and t.ReachesWrite(a): return false
        if not writable and ln.qCover.Len() > 0 and ln.writesCover(t.Referent(a) if t.IsRef(a) else a, 0): return false
        if t.ReachesCode(a) or not ln.quietX(c.Args[k]): return false
    }
    return true
}

# a place holding the reference: a part of what a stable reference reaches. A parameter is none - what a read-only
# reference parameter names may change under a "mut" name for it while the call runs
fn (ln mut lowering&) stableHolder(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Field(_, _, base, _): ln.stableHolder(base)
        case typed.Lvalue.Elem(_, _, e): ln.stableHolder(e.Base)
        case typed.Lvalue.Payload(_, _, py): ln.stableHolder(py.Base)
        case typed.Lvalue.Deref(_, _, r): ln.stableRef(r)
        case _: false
    }
}

fn (ln mut lowering&) stablePlace(p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Deref(_, _, r): ln.stableRef(r)
        case typed.Lvalue.Field(_, _, base, _): ln.stablePlace(base)
        case typed.Lvalue.Elem(_, _, e): ln.stablePlace(e.Base)
        case typed.Lvalue.Payload(_, _, py): ln.stablePlace(py.Base)
        case _: false
    }
}

# a value given storage for the call (Promote): new - made there, or a call's result (copied, or a view read as it is,
# whose own arguments were found stable where it was lowered)
fn (ln mut lowering&) stableMade(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Make(_, _, _), typed.Expr.Collect(_, _, _), typed.Expr.Text(_, _, _), typed.Expr.Lit(_, _, _): true
        case typed.Expr.Call(_, _, _): true
        case typed.Expr.Read(_, _, p, _): ln.stablePlace(p)
        case typed.Expr.Prim(_, _, op, _, args): op == typed.PrimOp.Convert and args.Len() == 1 and ln.stableMade(args[0])
        case typed.Expr.Away(_, _, y): ln.stableMade(y)
        case _: false
    }
}

# where a call's result goes: the scope it passes for its callee's result scope, the program's where it passes none
fn (ln mut lowering&) resultOf(fty types.TypeId, scopes mir.Range) mir.ScopeRef {
    vs := ln.T.ScopeVarsOf(fty)
    for j in range vs.Len() {
        if vs[j] == types.ResultVar and j < I64(scopes.N): return ln.F.Refs[I64(scopes.At) + j]
    }
    return mir.ScopeRef.Program
}

# D18e: call k, a generator function's for a for-in's own iterator, marked as the walk its block finishes - where the
# generator it makes lives (its result scope) is a block, a loop turn or the frame this function opens, so the walk is
# dropped when that scope closes, on every way out of it. Anywhere else (a scope variable, the program's, a region) the
# call stays unmarked
fn (ln mut lowering&) markWalk(k I32, callee mir.Callee, fty types.TypeId, scopes mir.Range) {
    match callee {
        case mir.Callee.Fn(mir.FnKey.Body(_), _) { }
        case _ { return }
    }
    vs := ln.T.ScopeVarsOf(fty)
    for j in range vs.Len() {
        if vs[j] != types.ResultVar or j >= I64(scopes.N) { continue }
        match ln.F.Refs[I64(scopes.At) + j] {
            case mir.ScopeRef.Scope(s) {
                kind := ln.F.Scopes[I64(s)].Kind
                if kind == mir.ScopeKind.Block or kind == mir.ScopeKind.Loop or kind == mir.ScopeKind.Frame {
                    ln.F.WalkCalls.Push(k)
                    ln.F.WalkScopes.Push(s)
                }
            }
            case _ { }
        }
    }
}

# the type a helper is made for: one helper per type but for its function types' parameter names (types.Unnamed) - a
# Render helper per type with them, which its function values render with (E11a)
fn (lw mut Lowerer&) helperTy(kind mir.HelperKind, ty types.TypeId) types.TypeId {
    # (E31d: a type declaring its own Copy is copied by it - its helper is its own, never its layout's)
    if (kind == mir.HelperKind.Copy or kind == mir.HelperKind.Parts) and lw.P.T.DeclaresCopy(ty) { return ty }
    return ty if kind == mir.HelperKind.Render else lw.P.T.Unnamed(ty)
}

# a type's zero value (D13c), a call of its Zero helper: all zero bits, its constructor on its parameters' defaults or
# zeros, as eval decides once per type (Key.Zero) - the helper's to say which
fn (ln mut lowering&) zero(ty types.TypeId, sp source.Span, site typed.SiteId = typed.SiteId(-1)) mir.Operand {
    t := ln.T
    ty = ln.L.helperTy(mir.HelperKind.Zero, ty)
    hty := mir.HelperType(t, mir.HelperKind.Zero, ty)
    callee := mir.Callee.Fn(mir.FnKey.Helper(mir.HelperKind.Zero, ty), hty)
    ln.L.Want(mir.FnKey.Helper(mir.HelperKind.Zero, ty))
    ok := ln.F.NewBlock()
    dest := ln.temp(ty, sp)
    # its scopes the plan's for the call: where the value lands (D13c) - the program's only for a zero no call names
    k := ln.F.AddCall(mir.Call(callee, mir.Empty, ln.passed(mir.PassedCount(t, callee, hty), site), mir.Lvalue.L(dest), true, ok
                               mir.NoLocal, mir.NoBlock))
    ln.end(mir.Term.Call(sp, k))
    ln.start(ok)
    return mir.Operand.Copy(mir.Lvalue.L(dest))
}

# ---- views kept in place of copies (D9h, docs/rework.md 17) ----

# the copies this body leaves out, where the two could not be told apart: where it hands back a local holding views of
# its arguments, as check recorded (typed.ViewWalk.Settle - its callers copying where they keep the result), and where a
# local holds views of storage nothing changes while it lives (viewLocals). Only where the body is lowered with the scope
# pass's plan: while compiling, every copy is made, so what the evaluator computes is the copies' and agrees
fn (ln mut lowering&) settleViews() {
    if not ln.planned: return
    u := typed.LocalUses.Uses(ln.T, ln.B)
    views := ln.L.ViewsOf(ln.B.Id)
    if views > 0 { ln.resultViews(u, views) }
    ln.viewLocals(u)
    ln.viewTemps(u)
    ln.movesAtLastUse(u)
}

# the temporaries holding a view call's result lent whole to a body keeping its parts as they are (a walk made and
# handed to a helper, "a.Iter().Fold(...)"): the call read where it stands where what it views is stable
fn (ln mut lowering&) viewTemps(u typed.LocalUses&) {
    for k in range u.TempX.Len() {
        keeps := ln.L.preserves(u.TempBody[k], u.TempParam[k])
        c := viewCallIn(u.TempX[k])
        if c is null: continue
        ln.vlIn = u.TempIn[k]
        held := keeps and ln.heldViews(u, c)
        if held { ln.L.ViewLocals++ }
        if ln.L.ViewDump { ln.L.ViewLog.Push($ln.L.P.L.Diags.Locate(ln.file, I64(u.TempX[k].Span().Start)) ": a temporary " $("holds views" if held else "copies" if keeps else "copies (lent to a body that may change its parts)")) }
    }
}

# the locals handed back holding views (D9h for every value): those whose views check recorded, each one's copies of
# them left out - its declaration's and its part stores'
fn (ln mut lowering&) resultViews(u typed.LocalUses&, views I64) {
    ln.viewWalk().Settle(u, ln.rvl)
    # (only where check recorded the views of every one - a local may hold another's: all copies are kept otherwise)
    for i in range ln.B.Locals.Len() {
        bits := try ln.rvl.Get(i) catch { continue }
        if (views & bits) != bits {
            ln.rvl.Clear()
            return
        }
    }
    w := ln.viewWalk()
    for i in range ln.B.Locals.Len() {
        if not ln.rvl.Has(i): continue
        ln.elide(w, u.Init[i], i)
        for k in range u.StoreAt.Len() {
            if u.StoreAt[k] == i: ln.elide(w, u.StoreX[k], -1)
        }
    }
}

# a stored value's copy left out where it is a view of the arguments (ElidedCopy): a MakeKind.Copy by its site, a value
# array local's T7b copy at its declaration
fn (ln mut lowering&) elide(w typed.ViewWalk&, x typed.Expr?&, l I64) {
    if x is null or not w.ElidedCopy(x): return
    match x {
        case typed.Expr.Make(_, _, m) { ln.noCopy.Put(I64(m.Site), true) }
        case _ { if l >= 0: ln.noLetCopy.Put(l, true) }
    }
    ln.L.ElidedReturns++
}

# the locals holding views in place of the copies their declarations make - a view call's result (D9h), a value array
# read (T7b), a value's MakeKind.Copy of existing storage, a read-only reference local naming such storage (a walk's
# collection) - where nothing could tell the view from the copy: the local is never written but in a scalar field or
# lent whole to bodies keeping its parts as they are (preserves), never escapes, never handed back, and the storage it
# views is changed by nothing while it lives and outlives it (heldSrc). In declaration order, so one may view another
fn (ln mut lowering&) viewLocals(u typed.LocalUses&) {
    for i in range ln.B.Locals.Len() {
        if ln.rvl.Has(i): continue
        if not ln.viewCand(u, i) {
            if ln.L.ViewDump and u.Init[i] is not null and typed.HoldsOwned(ln.T, ln.B.Locals[i].Ty) { ln.L.ViewLog.Push($ln.L.P.L.Diags.Locate(ln.file, I64(ln.B.Locals[i].Sp.Start)) ": local L" $i " no candidate" $ln.whyNot(u, i)) }
            continue
        }
        x := u.Init[i]
        if x is null: continue
        ln.vlIn = ln.B.Locals[i].In
        held := ln.viewInit(u, x, i)
        if ln.L.ViewDump { ln.L.ViewLog.Push($ln.L.P.L.Diags.Locate(ln.file, I64(ln.B.Locals[i].Sp.Start)) ": local L" $i $(" holds views" if held else " copies")) }
        if held {
            ln.vl.Put(i, true)
            ln.L.ViewLocals++
        }
    }
}

fn (ln mut lowering&) viewCand(u typed.LocalUses&, i I64) Bool {
    l := ln.B.Locals[i]
    k := l.Kind
    if k != typed.LocalKind.Var and k != typed.LocalKind.Hidden and k != typed.LocalKind.Held: return false
    if l.Unset or ln.escapes(u, i) or u.Ret[i] or u.WrOther[i] or u.Whole[i] or not ln.lendsKeep(u, i): return false
    for k2 in range u.StoreAt.Len() {
        if u.StoreAt[k2] == i: return false
    }
    t := ln.T
    if t.IsRef(l.Ty): return (t.PermOf(l.Ty) & types.Writable) == 0 and typed.HoldsOwned(t, t.Referent(l.Ty))
    return typed.HoldsOwned(t, l.Ty)
}

# why local i holds no views (OLANG_VIEWDUMP)
fn (ln mut lowering&) whyNot(u typed.LocalUses&, i I64) String {
    return $(" escapes" $ln.escWhy(u, i) if ln.escapes(u, i) else "") $(" returned" if u.Ret[i] else "") $(" written" if u.WrOther[i] else "") $(" assigned" if u.Whole[i] else "") $(" lent" if not ln.lendsKeep(u, i) else "")
}

# whether every writable lend of local i whole goes to a body keeping its parts as they are (a walk's Next, which
# writes its position only)
fn (ln mut lowering&) lendsKeep(u typed.LocalUses&, i I64) Bool {
    for k in range u.LendAt.Len() {
        if u.LendAt[k] == i and not ln.L.preserves(u.LendBody[k], u.LendParam[k]): return false
    }
    return true
}

# what a local's declaration gives it, where it may hold views in place of a copy: the copy left out (or the view call
# read where it stands) where what it views is stable
fn (ln mut lowering&) viewInit(u typed.LocalUses&, x typed.Expr&, i I64) Bool {
    ty := ln.B.Locals[i].Ty
    if ln.T.IsRef(ty) {
        pc := promoted(x)
        if pc is not null {
            c := viewCallIn(pc)
            if c is not null: return ln.heldViews(u, c)
            return true   # (a value of its own given storage for the local: what it names is its own)
        }
        k := viewCallIn(x)
        if k is not null: ln.heldThroughTemps(u, k)
        return ln.heldSrc(u, x)
    }
    c := viewCallIn(x)
    if c is not null { return ln.heldViews(u, c) }
    y := typed.CopiedOf(ln.T, x)
    if y is null or not ln.heldSrc(u, y): return false
    match x {
        case typed.Expr.Make(_, _, m) { ln.noCopy.Put(I64(m.Site), true) }
        case _ { if ln.copiesArray(x, ty): ln.noLetCopy.Put(i, true) }
    }
    return true
}

# a reference local given what a call k hands back (`kids := v[i].xs.View()`): a view call whose temporary k is lent
# read-only (a part of it borrowed) is read where it stands where what it views is stable while the local lives - the
# local may name the temporary's storage, which is then the viewed storage itself (heldViews)
fn (ln mut lowering&) heldThroughTemps(u typed.LocalUses&, k typed.Call&) {
    t := ln.T
    ty := match k.Target {
        case typed.Callee.Body(id): ln.L.Bodies[I64(id)].Ty
        case _: types.TypeId(-1)
    }
    if ty == types.TypeId(-1): return
    ps := t.Items(t.Params(ty))
    for i in range k.Args.Len().Min(ps.Len()) {
        if t.IsRef(ps[i]) and (t.PermOf(ps[i]) & types.Writable) != 0: continue
        c := tempViewCall(k.Args[i])
        if c is not null: ln.heldViews(u, c)
    }
}

# the view call whose temporary a borrow or a read is a part of (`v[i].xs`), through what passes a value on as it is
fn tempViewCall(x typed.Expr&) typed.Call?& {
    return match x {
        case typed.Expr.Borrow(_, _, p), typed.Expr.Read(_, _, p, _): tempRoot(p)
        case typed.Expr.Away(_, _, y): tempViewCall(y)
        case _: null
    }
}

fn tempRoot(p typed.Lvalue&) typed.Call?& {
    return match p {
        case typed.Lvalue.Field(_, _, base, _): tempRoot(base)
        case typed.Lvalue.Payload(_, _, py): tempRoot(py.Base)
        case typed.Lvalue.Elem(_, _, e): tempRoot(e.Base)
        case typed.Lvalue.Temp(_, _, x, _): viewCallIn(x)
        case _: null
    }
}

# whether every argument a view call may hand back a view of is stable while the local reading it lives: the call then
# read where it stands
fn (ln mut lowering&) heldViews(u typed.LocalUses&, c typed.Call&) Bool {
    id := match c.Target {
        case typed.Callee.Body(b): b
        case _: typed.BodyId(-1)
    }
    v := ln.L.ViewsOf(id)
    if v <= 0 or (v & typed.ViewOther) != 0: return false
    for k in range c.Args.Len().Min(typed.ViewBits) {
        if (v & (I64(1) << k)) != 0 and not ln.heldSrc(u, c.Args[k]): return false
    }
    ln.vlSites.Put(I64(c.Site), true)
    return true
}

# whether the storage a value names - the storage itself, a view of it, what a reference names - is changed by nothing
# while a local of this body holding it lives, and outlives it: constant data, an immutable global's, a local's own
# storage nothing writes, one holding views of such storage (viewLocals), or a parameter held by value nothing writes
# (its own copy - never what a reference parameter names, which may change under a "mut" name for it during the call)
fn (ln mut lowering&) heldSrc(u typed.LocalUses&, x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Data(_, _, _, _): true
        case typed.Expr.Read(_, ty, p, _): ln.heldRefPlace(u, p) if ln.T.IsRef(ty) else ln.heldPlace(u, p)
        case typed.Expr.Borrow(_, _, p): ln.heldPlace(u, p)
        case typed.Expr.Slice(_, _, sl): ln.heldPlace(u, sl.Base)
        case typed.Expr.Promote(_, _, pr): ln.heldMadeOf(u, pr.X)
        case typed.Expr.Prim(_, _, op, _, args): op == typed.PrimOp.Convert and args.Len() == 1 and ln.heldSrc(u, args[0])
        case typed.Expr.Away(_, _, y): ln.heldSrc(u, y)
        case _: false
    }
}

# a value given storage for a call - an array value's pair names its elements' storage, a place read
fn (ln mut lowering&) heldMadeOf(u typed.LocalUses&, x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Read(_, _, _, _), typed.Expr.Slice(_, _, _), typed.Expr.Data(_, _, _, _): ln.heldSrc(u, x)
        case typed.Expr.Prim(_, _, op, _, args): op == typed.PrimOp.Convert and args.Len() == 1 and ln.heldMadeOf(u, args[0])
        case _: false
    }
}

fn (ln mut lowering&) heldPlace(u typed.LocalUses&, p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Local(_, _, id): ln.heldLocal(u, I64(id))
        case typed.Lvalue.Global(_, _, mi, n): ln.immutableGlobal(mi, n)
        case typed.Lvalue.Field(_, _, base, _): ln.heldPlace(u, base)
        case typed.Lvalue.Elem(_, _, e): ln.heldPlace(u, e.Base)
        case typed.Lvalue.Payload(_, _, py): ln.heldPlace(u, py.Base)
        case typed.Lvalue.Deref(_, _, r): ln.heldSrc(u, r)
        case _: false
    }
}

# ---- moves at last use (D9i) ----

# D9i: a value local's copy left out where that copy is the local's last mention - a by-value argument, a store, a part
# of a value made (`t := mk(n)` then `p := P(t)`): the destination takes the local's storage, Rust's move made by
# liveness. Only where nothing could tell: the local's storage is its own (no view held in place of its copy), named by
# no other local, escaping nowhere, assigned nowhere whole, in no region early freeing made (O8d) - and outlives where
# the copy would be built (the copy's block inside the local's)
fn (ln mut lowering&) movesAtLastUse(u typed.LocalUses&) {
    if not ln.planned or ln.B.Root is null or ln.B.Gen: return
    w := typed.LastUses(ln.B.Locals.Len())
    w.Block(ln.B.Root!)
    for k in range w.CopySite.Len() {
        l := w.CopyLocal[k]
        if w.CopyAt[k] < 0 or w.Last[l] != w.CopyAt[k] or not ln.movable(u, l, w.CopySite[k]): continue
        ln.noCopy.Put(w.CopySite[k], true)
        ln.moved.Put(w.CopySite[k], l)
        ln.L.Moves++
        if ln.L.ViewDump { ln.L.ViewLog.Push($ln.L.P.L.Diags.Locate(ln.file, I64(ln.B.Locals[l].Sp.Start)) ": local L" $l " moved at its last use") }
    }
}

# whether every argument constructor call c's instance may view is a local moved into it at its last use (D9i), the
# instance landing in a block inside each one's
fn (ln mut lowering&) movedViews(c typed.Call&, id I64) Bool {
    views := ln.L.ViewsOf(typed.BodyId(I32(id)))
    if views <= 0 or (views & typed.ViewOther) != 0 or c.Site < typed.SiteId(0): return false
    home := ln.resultScopeAt(c, id)
    if home != typed.Scope.Block: return false
    for k in range c.Args.Len().Min(typed.ViewBits) {
        if (views & (I64(1) << k)) == 0: continue
        a := c.Args[k]
        if a != typed.Expr.Make: return false
        l := try ln.moved.Get(I64(a.m.Site)) catch { return false }
        if not ln.B.Encloses(ln.storageBlock(l), home.b): return false
    }
    return true
}

# where a call's result lands, by the plan: what it passes for its callee's result scope (Unset for none)
fn (ln mut lowering&) resultScopeAt(c typed.Call&, id I64) typed.Scope {
    vs := ln.T.ScopeVarsOf(ln.L.Bodies[id].Ty)
    for j in range vs.Len() {
        if vs[j] == types.ResultVar: return ln.plan.Passed(c.Site, j)
    }
    return typed.Scope.Unset
}

# the block value local l's own storage is in (the plan's, else its declaration's)
fn (ln mut lowering&) storageBlock(l I64) typed.BlockId {
    st := ln.plan.Stored[l] if l < ln.plan.Stored.Len() else typed.Scope.Unset
    if st == typed.Scope.Block: return st.b
    return ln.B.Locals[l].In
}

fn (ln mut lowering&) movable(u typed.LocalUses&, l I64, site I64) Bool {
    loc := ln.B.Locals[l]
    if loc.Kind != typed.LocalKind.Var or ln.T.IsRef(loc.Ty) or loc.Unset: return false
    if ln.vl.Has(l) or ln.rvl.Has(l) or ln.noLetCopy.Has(l) or u.Whole[l] or ln.escapes(u, l): return false
    for j in range u.AliasOf.Len() {
        if u.AliasOf[j] == l: return false
        if (ln.vl.Has(j) or ln.rvl.Has(j)) and u.Init[j] is not null and valueRootLocal(u.Init[j]!) == l: return false
    }
    if site >= ln.plan.Built.Len() or ln.plan.RegionKind[site] != 0: return false
    init := typed.Call.Of(u.Init[l])
    if init is not null and init.Site >= typed.SiteId(0) and ln.plan.RegionKind[I64(init.Site)] != 0: return false
    dest := ln.plan.Built[site]
    # (a local the scope pass homed in the result scope a returned copy of it is built in: O26a's, T13a's String(out))
    if dest == typed.Scope.Var and l < ln.plan.Stored.Len() {
        st := ln.plan.Stored[l]
        if st == typed.Scope.Var: return dest.i == st.i
    }
    return dest == typed.Scope.Block and ln.B.Encloses(ln.storageBlock(l), dest.b)
}

# the local whose own storage a value reads or borrows, no reference crossed; -1 for any other
fn valueRootLocal(x typed.Expr&) I64 {
    return match x {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p): placeRootLocal(p)
        case typed.Expr.Slice(_, _, sl): placeRootLocal(sl.Base)
        case typed.Expr.Promote(_, _, pr): valueRootLocal(pr.X)
        case typed.Expr.Away(_, _, y): valueRootLocal(y)
        case typed.Expr.Prim(_, _, op, _, args): valueRootLocal(args[0]) if op == typed.PrimOp.Convert and args.Len() == 1 else -1
        case _: -1
    }
}

fn placeRootLocal(p typed.Lvalue&) I64 {
    return match p {
        case typed.Lvalue.Local(_, _, id): I64(id)
        case typed.Lvalue.Field(_, _, base, _): placeRootLocal(base)
        case typed.Lvalue.Elem(_, _, e): placeRootLocal(e.Base)
        case typed.Lvalue.Payload(_, _, py): placeRootLocal(py.Base)
        case _: -1
    }
}

fn runArray(t types.Table&, ty types.TypeId) Bool {
    r := t.Repr(ty)
    return t.KindOf(r) == types.Kind.Array and t.Length(r) == types.TypeId(0)
}

# what a reference read out of a place names: a reference local's referent - and a value array local's own storage,
# read as the reference its pair is
fn (ln mut lowering&) heldRefPlace(u typed.LocalUses&, p typed.Lvalue&) Bool {
    return match p {
        case typed.Lvalue.Local(_, _, id): ln.heldReferent(u, I64(id)) if ln.T.IsRef(ln.B.Locals[I64(id)].Ty) else ln.heldLocal(u, I64(id))
        case _: false
    }
}

# what reference local i names: a reference local holding views of stable storage (viewLocals), or one given storage
# made for it by the call declaring it
fn (ln mut lowering&) heldReferent(u typed.LocalUses&, i I64) Bool {
    l := ln.B.Locals[i]
    # (its own storage only: what a reference it holds names may change under any other name for it)
    if not ln.T.SharesRefs(ln.T.Referent(l.Ty)) and l.Kind != typed.LocalKind.Param {
        if ln.vl.Has(i): return true
        # (one given storage made for it by the call declaring it - a built result no one else holds: its own, as a
        # value local's is)
        x := u.Init[i]
        if x is not null and ln.freshCall(x) and ln.heldUnchanged(u, i): return true
    }
    # (what any reference names - a parameter's, which may change under a "mut" name for it - is changed by nothing
    # while every statement of the block the view lives in writes nothing it could reach: quietLife)
    return not u.Whole[i] and not u.WrOther[i] and ln.quietLife(ln.T.Referent(l.Ty))
}

# whether the block a local holding views is declared in (vlIn) writes nothing storage outside it could be: each of its
# statements, nested ones too, quiet (no call giving a writable reference, through a function value or an "any"), its
# stores a scalar local's - in a program none of whose globals can be written through (check.mutStorage)
fn (ln mut lowering&) quietLife(of types.TypeId) Bool {
    if ln.B.Root is null: return false
    b := findBlock(ln.B.Root!, ln.vlIn)
    if b is null: return false
    # (what can write the view's storage: a write of storage of one of the types its by-value parts are, or reaching one
    # through writable references - no type of olang is another's storage, so any other write leaves it as it is)
    ln.qCover.Clear()
    ln.qWrites.Clear()
    ln.coverAdd(of, 0)
    ln.qRoot = of
    # (any call may write a mutable global, and what it reaches writably)
    ok := true
    for g in ln.L.P.L.MutGlobals {
        gt := types.TypeId(I32(g))
        if ln.objHits(gt) or ln.writesCover(gt, 0): ok = false
    }
    ok = ok and ln.quietBlock(b)
    ln.qCover.Clear()
    ln.qWrites.Clear()
    return ok
}

# whether an object of type o - what a reference names, a local's own storage - may be, hold by value or be held by
# value in the object the view is into: o one of the view's by-value parts, or the view's object one of o's
fn (ln mut lowering&) objHits(o types.TypeId) Bool {
    t := ln.T
    if ln.qCover.Has(I64(o)) or ln.qCover.Has(I64(t.Repr(o))): return true
    held Map<I64, Bool>
    ln.heldParts(o, held, 0)
    return held.Has(I64(ln.qRoot)) or held.Has(I64(t.Repr(ln.qRoot)))
}

fn (ln mut lowering&) heldParts(t types.TypeId, out mut Map<I64, Bool>&, depth I64) {
    tt := ln.T
    if depth > 16 or out.Has(I64(t)): return
    out.Put(I64(t), true)
    r := tt.Repr(t)
    out.Put(I64(r), true)
    match tt.KindOf(r) {
        case types.Kind.Array { ln.heldParts(tt.Elem(r), out, depth + 1) }
        case types.Kind.Tuple, types.Kind.Record { for x in tt.Items(tt.Parts(r)) { if x != types.TypeId(0): ln.heldParts(x, out, depth + 1) } }
        case types.Kind.Named { for x in tt.Embedded(r) { ln.heldParts(x, out, depth + 1) } }
        case _ { }
    }
}

# the types whose storage a value of type t is: itself and its by-value parts, all the way down (never behind a
# reference: what a view and a copy of it reach there is the same)
fn (ln mut lowering&) coverAdd(t types.TypeId, depth I64) {
    tt := ln.T
    if depth > 16 or ln.qCover.Has(I64(t)): return
    ln.qCover.Put(I64(t), true)
    r := tt.Repr(t)
    ln.qCover.Put(I64(r), true)
    match tt.KindOf(r) {
        case types.Kind.Array { ln.coverAdd(tt.Elem(r), depth + 1) }
        case types.Kind.Tuple, types.Kind.Record { for x in tt.Items(tt.Parts(r)) { if x != types.TypeId(0): ln.coverAdd(x, depth + 1) } }
        case types.Kind.Named { for x in tt.Embedded(r) { ln.coverAdd(x, depth + 1) } }
        case _ { }
    }
}

# whether a write of a value of type t's storage, or through the writable references it holds, may reach storage the
# view covers (qCover); anything reaching code - a function value, an "any", a type variable - may reach anything
fn (ln mut lowering&) writesCover(t types.TypeId, depth I64) Bool {
    tt := ln.T
    if depth > 16: return true
    r := tt.Repr(t)
    known := try ln.qWrites.Get(I64(r)) catch {
        ln.qWrites.Put(I64(r), false)    # (a type reaching itself again adds nothing to what its other parts say)
        w := ln.writesOf(r, depth)
        ln.qWrites.Put(I64(r), w)
        return w
    }
    return known
}

fn (ln mut lowering&) writesOf(r types.TypeId, depth I64) Bool {
    tt := ln.T
    return match tt.KindOf(r) {
        case types.Kind.Func, types.Kind.Var, types.Kind.Any: true
        # (a writable reference: its object may be the view's, else what it holds writably)
        case types.Kind.Ref: (tt.PermOf(r) & types.Writable) != 0 and (ln.objHits(tt.Referent(r)) or ln.writesCover(tt.Referent(r), depth + 1))
        case types.Kind.Array: ln.writesCover(tt.Elem(r), depth + 1)
        case types.Kind.Tuple, types.Kind.Record: ln.someWrites(tt.Items(tt.Parts(r)), depth)
        case types.Kind.AnonEnum: ln.someWrites(tt.Items(tt.ShapeCases(r)), depth)
        # (a struct's or an enum's parts held in place: a writable reference among a field's is one the value holds)
        case types.Kind.Named: ln.someWrites(tt.Embedded(r), depth)
        case _: false
    }
}

fn (ln mut lowering&) someWrites(xs Array<types.TypeId>&, depth I64) Bool {
    for x in xs {
        if x != types.TypeId(0) and ln.writesCover(x, depth + 1): return true
    }
    return false
}

# the block of a body named id, null for none
fn findBlock(b typed.Block&, id typed.BlockId) typed.Block?& {
    if b.Id == id: return b
    for s in b.Stmts {
        r := match s {
            case typed.Stmt.Block(_, k), typed.Stmt.Loop(_, k, _): findBlock(k, id)
            case typed.Stmt.If(_, f): findIn(f.Then, f.Else, id)
            case _: null
        }
        if r is not null: return r
    }
    return null
}

fn findIn(a typed.Block&, e typed.Block?&, id typed.BlockId) typed.Block?& {
    r := findBlock(a, id)
    if r is not null or e is null: return r
    return findBlock(e, id)
}

# a store into p, quiet for quietLife: a scalar local's, or one into an object that is not the view's, holds it by
# value or is held by it (a reference local repointed changes no object)
fn (ln mut lowering&) quietStore(p typed.Lvalue&) Bool {
    t := ln.T
    if p == typed.Lvalue.Local and (t.IsNumber(p.Type()) or p.Type() == types.BoolT or t.IsRef(p.Type())): return true
    if ln.qCover.Len() == 0: return false
    o := ln.objectOf(p)
    return o != types.UnknownT and not ln.objHits(o)
}

# the type of the object place p is storage of: a local's own, what a reference names - unknown for any other
fn (ln mut lowering&) objectOf(p typed.Lvalue&) types.TypeId {
    return match p {
        case typed.Lvalue.Local(_, ty, _): ty
        case typed.Lvalue.Field(_, _, b, _): ln.objectOf(b)
        case typed.Lvalue.Elem(_, _, e): ln.objectOf(e.Base)
        case typed.Lvalue.Payload(_, _, py): ln.objectOf(py.Base)
        case typed.Lvalue.Deref(_, ty, _): ty
        case _: types.UnknownT
    }
}

fn (ln mut lowering&) quietBlock(b typed.Block&) Bool {
    for s in b.Stmts {
        if not ln.quietNested(s): return false
    }
    return true
}

fn (ln mut lowering&) quietNested(s typed.Stmt&) Bool {
    return match s {
        case typed.Stmt.Let(_, _, x), typed.Stmt.Eval(_, x): ln.quietX(x)
        case typed.Stmt.Assign(_, p, x): ln.quietStore(p) and ln.quietPlace(p) and ln.quietX(x)
        case typed.Stmt.If(_, f): ln.quietX(f.Test) and ln.quietBlock(f.Then) and (f.Else is null or ln.quietBlock(f.Else!))
        case typed.Stmt.Block(_, k): ln.quietBlock(k)
        case typed.Stmt.Loop(_, k, post): ln.quietBlock(k) and (post is null or ln.quietBlock(post))
        case typed.Stmt.Jump(_, _, _), typed.Stmt.Raise(_, _, _): true
        case typed.Stmt.Return(_, x): ln.quietX(x)
        case typed.Stmt.Assert(_, c, m): ln.quietX(c) and ln.quietX(m)
        case _: false
    }
}

# whether a value is a call of a body whose result is storage made for it, which nothing else holds (freshResult)
fn (ln mut lowering&) freshCall(x typed.Expr&) Bool {
    c := viewCallIn(x)
    if c is null: return false
    return match c.Target {
        case typed.Callee.Body(id): ln.L.freshResult(I64(id))
        case _: false
    }
}

# a local's own storage: one nothing writes while it lives (its writes a scalar field's, its lends bodies keeping its
# parts) - a parameter held by value its body never writes, or one holding views of stable storage
fn (ln mut lowering&) heldLocal(u typed.LocalUses&, i I64) Bool {
    l := ln.B.Locals[i]
    if ln.T.SharesRefs(l.Ty): return false
    # (a parameter by value is the callee's own, but a run-time array one - D9b's, the caller's array read in place)
    if l.Kind == typed.LocalKind.Param: return not ln.T.IsRef(l.Ty) and ln.paramElig(i) and not runArray(ln.T, l.Ty)
    if not ln.heldUnchanged(u, i): return false
    a := u.AliasOf[i]
    if a >= 0 and not ln.vl.Has(i): return ln.heldLocal(u, a)
    return true
}

# whether local i's storage - its own, or its referent where it is a reference local - is written by nothing while a
# local declared in vlIn lives: declared around it, its writes a scalar field's, its lends to bodies keeping its parts
fn (ln mut lowering&) heldUnchanged(u typed.LocalUses&, i I64) Bool {
    l := ln.B.Locals[i]
    if l.Kind == typed.LocalKind.Capture or not ln.encloses(l.In, ln.vlIn): return false
    if u.WrOther[i] or u.Whole[i] or ln.escapes(u, i) or not ln.lendsKeep(u, i): return false
    for k in range u.StoreAt.Len() {
        if u.StoreAt[k] == i: return false
    }
    return true
}

# (OLANG_VIEWDUMP: what made local i escape - EscHard, or the bodies it was given to that may keep it)
fn (ln mut lowering&) escWhy(u typed.LocalUses&, i I64) String {
    b := StringBuilder()
    if u.EscHard[i]: b.Push(" (stored, captured or handed on)")
    for k in range u.RefAt.Len() {
        if u.RefAt[k] == i and not ln.L.keepsNoRef(u.RefBody[k], u.RefParam[k]) { b.Push($" (given to body " $u.RefBody[k] " parameter " $u.RefParam[k] ")") }
    }
    return b.ToString()
}

# whether local i's storage escapes: stored, captured, handed to a task, or given as a read-only reference to a body
# that may keep it (typed.LocalUses.RefAt)
fn (ln mut lowering&) escapes(u typed.LocalUses&, i I64) Bool {
    if u.EscHard[i]: return true
    for k in range u.RefAt.Len() {
        if u.RefAt[k] == i and not ln.L.keepsNoRef(u.RefBody[k], u.RefParam[k]): return true
    }
    return false
}

# whether a body keeps nothing of the read-only reference its parameter k is given: the parameter stored nowhere,
# captured by nothing, handed back by no return, named by no other local, and given on only to bodies keeping nothing
# of it. Asked once a body and parameter (a body reaching itself keeps what it is given, as proved by nothing)
fn (lw mut Lowerer&) keepsNoRef(body I64, k I64) Bool {
    if body < 0 or body >= lw.Bodies.Len() or k >= 64: return false
    key := body * 64 + k
    known := try lw.keptRefs.Get(key) catch {
        lw.keptRefs.Put(key, false)
        ok := lw.noRefKept(lw.Bodies[body], k)
        lw.keptRefs.Put(key, ok)
        return ok
    }
    return known
}

fn (lw mut Lowerer&) noRefKept(b typed.Body&, k I64) Bool {
    if b.Root is null or k >= b.Params.Len(): return false
    u := typed.LocalUses.Uses(lw.P.T, b)
    p := I64(b.Params[k])
    # (handed back in a value result - a view the D9h handover gives where the parameter is read, which its caller copies
    # where it keeps it - is no keeping; in a reference result it is)
    if u.EscHard[p] or u.WrOther[p] or u.Whole[p]: return false
    if u.Ret[p] and lw.T().IsRef(lw.T().Result(b.Ty)): return false
    for j in range u.AliasOf.Len() {
        if u.AliasOf[j] == p: return false
    }
    for j in range u.LendAt.Len() {
        if u.LendAt[j] == p: return false
    }
    for j in range u.StoreAt.Len() {
        if u.StoreAt[j] == p: return false
    }
    for j in range u.RefAt.Len() {
        if u.RefAt[j] == p and not lw.keepsNoRef(u.RefBody[j], u.RefParam[j]): return false
    }
    return true
}

# whether block a is block b or one around it - a local declared in a lives as long as one declared in b
fn (ln mut lowering&) encloses(a typed.BlockId, b typed.BlockId) Bool {
    at := b
    for _ in range ln.B.Blocks.Len() + 1 {
        if at == a: return true
        if I64(at) < 0 or I64(at) >= ln.B.Blocks.Len(): return false
        at = ln.B.Blocks[I64(at)].Parent
    }
    return false
}

# whether this body's parameter local i is one its body never assigns whole (names' ParamWritten and BareWritten)
fn (ln mut lowering&) paramElig(i I64) Bool {
    key := pair.Pair(ln.B.File, I64(ln.B.Locals[i].Sp.Start))
    return not ln.L.P.L.ParamWritten.Has(key)
}

fn (ln mut lowering&) immutableGlobal(mi I64, n source.NameId) Bool {
    v := ln.L.P.GlobalDecl(mi, n)
    return v is not null and not generic.WrittenMut(v.Ty)
}

# a body keeping its parameter k's referent's parts as they are: it writes nothing through it but scalar
# fields, assigns it nowhere, lends it to nothing, keeps it nowhere, hands it back nowhere - a walk's Next writing its
# position. Asked once a body and parameter
fn (lw mut Lowerer&) preserves(body I64, k I64) Bool {
    if body < 0 or body >= lw.Bodies.Len() or k >= 64: return false
    key := body * 64 + k
    known := try lw.preserved.Get(key) catch {
        lw.preserved.Put(key, false)   # (a body reaching itself keeps nothing proved)
        ok := lw.keepsParts(lw.Bodies[body], k)
        lw.preserved.Put(key, ok)
        return ok
    }
    return known
}

# whether a body's reference result is storage made for it that nothing else holds: every value it returns
# a value given storage there (Promote of one made: an array, a case, a comprehension, a text, another such call's), or
# a reference local holding one, kept nowhere but its return - lent only to bodies keeping nothing of what they are lent
# (freshParam). Asked once a body
fn (lw mut Lowerer&) freshResult(body I64) Bool {
    if body < 0 or body >= lw.Bodies.Len(): return false
    key := -1 - body
    known := try lw.preserved.Get(key) catch {
        lw.preserved.Put(key, false)
        ok := lw.allFresh(lw.Bodies[body])
        lw.preserved.Put(key, ok)
        return ok
    }
    return known
}

fn (lw mut Lowerer&) allFresh(b typed.Body&) Bool {
    if b.Root is null or not lw.T().IsRef(lw.T().Result(b.Ty)): return false
    u := typed.LocalUses.Uses(lw.P.T, b)
    for x in u.Rets {
        if not lw.freshRet(b, u, x): return false
    }
    return true
}

fn (lw mut Lowerer&) T() mut types.Table& { return lw.P.T }

fn (lw mut Lowerer&) freshRet(b typed.Body&, u typed.LocalUses&, x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Promote(_, _, pr): lw.freshMade(pr.X)
        case typed.Expr.Prim(_, _, op, _, args): op == typed.PrimOp.Convert and args.Len() == 1 and lw.freshRet(b, u, args[0])
        case typed.Expr.Away(_, _, y): lw.freshRet(b, u, y)
        case typed.Expr.Call(_, _, c): c.Target == typed.Callee.Body and lw.freshResult(typed.CalleeBody(c))
        case typed.Expr.Read(_, _, p, _): match p {
            case typed.Lvalue.Local(_, _, id): lw.freshLocal(b, u, I64(id))
            case _: false
        }
        case _: false
    }
}

# a value made where it is: storage of its own no one else names
fn (lw mut Lowerer&) freshMade(x typed.Expr&) Bool {
    return match x {
        case typed.Expr.Make(_, _, m): m.Kind != typed.MakeKind.Tuple
        case typed.Expr.Collect(_, _, _), typed.Expr.Text(_, _, _), typed.Expr.Lit(_, _, _): true
        # (a value result: copied where it is a view and kept - a promotion keeps it)
        case typed.Expr.Call(_, ty, c): c.Target == typed.Callee.Body and not lw.T().IsRef(ty)
        case typed.Expr.Prim(_, _, op, _, args): op == typed.PrimOp.Convert and args.Len() == 1 and lw.freshMade(args[0])
        case typed.Expr.Away(_, _, y): lw.freshMade(y)
        case _: false
    }
}

# a reference local of b holding storage made for it, kept nowhere but where it is returned
fn (lw mut Lowerer&) freshLocal(b typed.Body&, u typed.LocalUses&, i I64) Bool {
    l := b.Locals[i]
    if l.Kind == typed.LocalKind.Param or l.Kind == typed.LocalKind.Capture or u.Esc[i] or u.Whole[i]: return false
    x := u.Init[i]
    if x is null or not lw.freshRet(b, u, x): return false
    for k in range u.LendAt.Len() {
        if u.LendAt[k] == i and not lw.freshParam(u.LendBody[k], u.LendParam[k]): return false
    }
    for j in range u.AliasOf.Len() {
        if u.AliasOf[j] == i: return false
    }
    return true
}

# a body keeping nothing of what its parameter k names: no reference to it kept, handed back or put anywhere
fn (lw mut Lowerer&) freshParam(body I64, k I64) Bool {
    if body < 0 or body >= lw.Bodies.Len() or k >= 64: return false
    key := -(I64(1) << 40) - (body * 64 + k)
    known := try lw.preserved.Get(key) catch {
        lw.preserved.Put(key, false)
        ok := lw.keepsNothing(lw.Bodies[body], k)
        lw.preserved.Put(key, ok)
        return ok
    }
    return known
}

fn (lw mut Lowerer&) keepsNothing(b typed.Body&, k I64) Bool {
    if b.Root is null or k >= b.Params.Len(): return false
    u := typed.LocalUses.Uses(lw.P.T, b)
    p := I64(b.Params[k])
    if u.Esc[p] or u.Ret[p]: return false
    for j in range u.AliasOf.Len() {
        if u.AliasOf[j] == p: return false
    }
    for j in range u.LendAt.Len() {
        if u.LendAt[j] == p and not lw.freshParam(u.LendBody[j], u.LendParam[j]): return false
    }
    return true
}

fn (lw mut Lowerer&) keepsParts(b typed.Body&, k I64) Bool {
    if b.Root is null or k >= b.Params.Len(): return false
    u := typed.LocalUses.Uses(lw.P.T, b)
    p := I64(b.Params[k])
    if u.WrOther[p] or u.Whole[p] or u.Esc[p] or u.Ret[p]: return false
    for j in range u.StoreAt.Len() {
        if u.StoreAt[j] == p: return false
    }
    # (lent on whole to a body keeping them as they are too: a helper's walk calling its Next)
    for j in range u.LendAt.Len() {
        if u.LendAt[j] == p and not lw.preserves(u.LendBody[j], u.LendParam[j]): return false
    }
    return true
}

# the value a reference local is given storage for (Promote), else null
fn promoted(x typed.Expr&) typed.Expr?& {
    return match x {
        case typed.Expr.Promote(_, _, pr): pr.X
        case typed.Expr.Away(_, _, y): promoted(y)
        case _: null
    }
}

# the call a value is, through what passes it on as it is: a try (a walk's Next, whose Exhausted leaves the loop), a
# conversion, a statement-less sequence
fn viewCallIn(x typed.Expr&) typed.Call?& {
    return match x {
        case typed.Expr.Call(_, _, c): c
        case typed.Expr.Try(_, _, tr): viewCallIn(tr.X!) if tr.X is not null else null
        case typed.Expr.Away(_, _, y): viewCallIn(y)
        case typed.Expr.Seq(_, _, q): viewCallIn(q.X!) if q.X is not null and q.Stmts.Len() == 0 else null
        case typed.Expr.Prim(_, _, op, _, args): viewCallIn(args[0]) if op == typed.PrimOp.Convert and args.Len() == 1 else null
        case _: null
    }
}

# ---- values made ----

fn (ln mut lowering&) make(m typed.Make&, ty types.TypeId, sp source.Span) mir.Operand {
    t := ln.T
    match m.Kind {
        case typed.MakeKind.Tuple, typed.MakeKind.Case {
            ops := ln.vals(m.Items)
            if ln.dead { return mir.Operand.None }
            if m.Site >= typed.SiteId(0) and t.IsRef(ty) {
                inner := t.Referent(ty)
                v := ln.into(inner, mir.Rvalue.Aggregate(inner, m.Tag, ln.F.Args(ops)), sp)
                return ln.into(ty, mir.Rvalue.New(ln.built(m.Site), v, ty), sp)
            }
            return ln.into(ty, mir.Rvalue.Aggregate(ty, m.Tag, ln.F.Args(ops)), sp)
        }
        case typed.MakeKind.Array { return ln.arrayLit(m, ty, sp) }
        case typed.MakeKind.Fill { return ln.fill(m, ty, sp) }
        case typed.MakeKind.Copy {
            x := m.Items[0]
            v := ln.val(x)
            if ln.dead { return mir.Operand.None }
            if not t.Same(x.Type(), ty) { return ln.derefCopy(v, x.Type(), ty, ln.madeAt(m.Site), sp) }
            # (a view kept in place of this copy, where nothing could tell the two apart - never one running a declared
            # Copy, E31d, which may make what the value refers to anew)
            if ln.noCopy.Has(I64(m.Site)) and not t.RunsCopy(ty) { return v }
            return ln.ownCopyOf(v, ty, ln.madeAt(m.Site), sp)
        }
    }
}

fn (ln mut lowering&) vals(xs Array<typed.Expr&>&) Array<mir.Operand> {
    ops := Array<mir.Operand>(xs.Len())
    for i in range xs.Len() { ops[i] = ln.val(xs[i]) }
    return ops
}

# the array type behind ty: ty's representation, or what a reference to one names
fn (ln mut lowering&) arrayOf(ty types.TypeId) types.TypeId {
    t := ln.T
    r := t.Repr(ty)
    if t.IsRef(r) { r = t.Repr(t.Referent(r)) }
    return r if t.KindOf(r) == types.Kind.Array else types.UnknownT
}

# a fixed array's length, -1 for a run-time one
fn (ln mut lowering&) fixedLen(at types.TypeId) I64 {
    n := ln.T.Length(at)
    if n == types.TypeId(0) or ln.T.KindOf(n) != types.Kind.Const { return -1 }
    return ln.T.ConstValue(n)
}

# an array literal (E19): a fixed array made of its elements, or a run-time one's storage made and filled
fn (ln mut lowering&) arrayLit(m typed.Make&, ty types.TypeId, sp source.Span, adopt Bool = false
                               into mir.ScopeRef = mir.ScopeRef.Program) mir.Operand {
    t := ln.T
    at := ln.arrayOf(ty)
    if at == types.UnknownT {
        ln.gap(sp, "an array literal of a type that is no array")
        return mir.Operand.None
    }
    ops := ln.vals(m.Items)
    if ln.dead { return mir.Operand.None }
    if ln.fixedLen(at) >= 0 {
        v := ln.into(at, mir.Rvalue.Aggregate(at, 0, ln.F.Args(ops)), sp)
        if not t.IsRef(t.Repr(ty)) { return v }
        return ln.into(ty, mir.Rvalue.New(ln.built(m.Site), v, ty), sp)
    }
    el := t.Elem(at)
    a := ln.temp(ty, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(a), mir.Rvalue.NewArray(into if adopt else ln.madeAt(m.Site), ty, ln.constI64(ops.Len())
                                                             mir.Operand.Const(el, 0))))
    deref := t.IsRef(t.Repr(ty))
    for i in range ops.Len() {
        p := ln.F.Place(mir.Base.Local(a), Array<mir.Proj>[mir.Proj.Deref, mir.Proj.At(i)] if deref else Array<mir.Proj>[mir.Proj.At(i)])
        ln.emit(mir.Stmt.Assign(sp, p, mir.Rvalue.Use(ops[i])))
    }
    return mir.Operand.Copy(mir.Lvalue.L(a))
}

# Array<T>(n, fill) (D14, T8): its length checked (D14b), its storage n of the fill - or of the zero value
fn (ln mut lowering&) fill(m typed.Make&, ty types.TypeId, sp source.Span, adopt Bool = false
                           into mir.ScopeRef = mir.ScopeRef.Program) mir.Operand {
    t := ln.T
    at := ln.arrayOf(ty)
    if at == types.UnknownT {
        ln.gap(sp, "a fill of a type that is no array")
        return mir.Operand.None
    }
    el := t.Elem(at)
    n := mir.Operand.None
    if m.Length is not null { n = ln.val(m.Length) }
    fv := mir.Operand.Const(el, 0)
    if m.NoClear {
        # D14d: the loop after it writes every element before anything reads one - no clear, no zero value made
        fv = mir.Operand.None
    } else if m.Items.Len() > 0 {
        zero := match m.Items[0] {
            case typed.Expr.Call(_, _, k): k.Zero
            case _: false
        }
        if zero and n != mir.Operand.None and not ln.dead {
            # an element type's zero value made only for an array that has an element: Array<T>(0) needs none (D13c)
            v := ln.temp(el, sp)
            ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(v), mir.Rvalue.Use(fv)))
            some := ln.prim(typed.PrimOp.Gt, types.BoolT, Array<mir.Operand>[ln.asI64(n, m.Length!.Type(), sp), ln.constI64(0)], sp)
            yes, after := ln.F.NewBlock(), ln.F.NewBlock()
            ln.end(mir.Term.Branch(some, yes, after))
            ln.start(yes)
            z := ln.val(m.Items[0])
            if not ln.dead { ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(v), mir.Rvalue.Use(z))) }
            ln.goto(after)
            ln.start(after)
            fv = mir.Operand.Copy(mir.Lvalue.L(v))
        } else {
            fv = ln.val(m.Items[0])
        }
    }
    if ln.dead { return mir.Operand.None }
    # (QCE: a fill owning storage - text, an array, a value with such parts - is each element's
    # own copy of it, made where the array is)
    owned := m.Items.Len() > 0 and ln.ownsStorage(el) and fv != mir.Operand.None and fv != mir.Operand.Const
    fixed := ln.fixedLen(at)
    if fixed >= 0 {
        ops := Array<mir.Operand>(fixed)
        if fv == mir.Operand.None { fv = mir.Operand.Const(el, 0) }   # a fixed array's no clear is its local's (Unset)
        for i in range fixed { ops[i] = ln.ownCopyOf(fv, el, ln.madeAt(m.Site), sp) if owned else fv }
        v := ln.into(at, mir.Rvalue.Aggregate(at, 0, ln.F.Args(ops)), sp)
        if not t.IsRef(t.Repr(ty)) { return v }
        return ln.into(ty, mir.Rvalue.New(ln.built(m.Site), v, ty), sp)
    }
    if n == mir.Operand.None {
        ln.gap(sp, "a run-time array's fill with no length")
        return mir.Operand.None
    }
    n64 := ln.asI64(n, m.Length!.Type(), sp)
    if m.Checked != typed.Check.None {
        ok := ln.prim(typed.PrimOp.Ge, types.BoolT, Array<mir.Operand>[n64, ln.constI64(0)], sp)
        ln.check(ok, m.Checked, mir.ExitKind.ArrayLength, OutOfBounds, sp)
        # ... and its byte count an I64 (D14b)
        ln.L.P.Layout(el)
        size := t.Size(el)
        if size > 1 {
            fits := ln.prim(typed.PrimOp.Le, types.BoolT, Array<mir.Operand>[n64, ln.constI64(9223372036854775807 / size)], sp)
            ln.check(fits, m.Checked, mir.ExitKind.ArrayLength, OutOfBounds, sp)
        }
    }
    where := into if adopt else ln.madeAt(m.Site)
    r := ln.into(ty, mir.Rvalue.NewArray(where, ty, n64, fv), sp)
    if not owned { return r }
    buf := ln.local(r, ty, sp)
    bp := pl(mir.Base.Local(buf))
    if t.IsRef(t.Repr(ty)) { bp = ln.with(bp, mir.Proj.Deref) }
    ln.eachIndex(n64, sp, fn(i mir.LocalId) {
        ln.emit(mir.Stmt.Assign(sp, ln.mk(ln.with(bp, mir.Proj.Index(i))), mir.Rvalue.Use(ln.ownCopyOf(fv, el, where, sp))))
    })
    return mir.Operand.Copy(mir.Lvalue.L(buf))
}

# a comprehension (E27): its buffer made at its reservation (or 100), each Yield stored at its count, the buffer grown
# twice over when full; then an array of exactly its count, the elements copied in
fn (ln mut lowering&) collect(c typed.Collect&, ty types.TypeId, sp source.Span) mir.Operand {
    t := ln.T
    at := ln.arrayOf(ty)
    if at == types.UnknownT or ln.fixedLen(at) >= 0 {
        ln.gap(sp, "a comprehension of a type that is no run-time array")
        return mir.Operand.None
    }
    el := t.Elem(at)
    bt := t.Ref(t.Array(el, types.TypeId(0)), types.Writable)
    cap := ln.constI64(100)
    if c.Reserve is not null {
        r := ln.val(c.Reserve)
        cap = ln.asI64(r, c.Reserve!.Type(), sp)
        if c.Checked != typed.Check.None {
            ok := ln.prim(typed.PrimOp.Ge, types.BoolT, Array<mir.Operand>[cap, ln.constI64(0)], sp)
            ln.check(ok, c.Checked, mir.ExitKind.ArrayLength, OutOfBounds, sp)
        }
    }
    if ln.dead { return mir.Operand.None }
    if c.Exact and c.Reserve is not null {
        # E39: as many elements as reserved, one each turn - the result made once at that length and filled in place
        # (where a reference it is promoted to goes, when promote adopts it)
        s0 := ln.madeAt(c.Site)
        out0 := ln.temp(ty, sp)
        # no fill: every element is yielded before anything reads it, and a loop left early leaves the array unread -
        # but where an element owns storage (QCE) the array is cleared, so that a copy of the whole (a grown buffer's
        # room past a Vec's count, M19d) copies empty parts rather than whatever the bytes held
        fill0 := mir.Operand.Const(el, 0) if ln.ownsStorage(el) else mir.Operand.None
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(out0), mir.Rvalue.NewArray(s0, ty, cap, fill0)))
        n0 := ln.temp(mir.I64T, sp)
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(n0), mir.Rvalue.Use(ln.constI64(0))))
        ln.collects.Push(collectCtx(out0, n0, el, ty, s0, true, t.IsRef(t.Repr(ty))))
        ln.block(c.Loop)
        try ln.collects.Pop() catch { }
        if ln.dead { return mir.Operand.None }
        return mir.Operand.Copy(mir.Lvalue.L(out0))
    }
    buf := ln.temp(bt, sp)
    s := ln.built(c.Site)
    # no fill: an element is yielded before anything reads it, and only the yielded ones are copied out
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(buf), mir.Rvalue.NewArray(s, bt, cap, mir.Operand.None)))
    n := ln.temp(mir.I64T, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(n), mir.Rvalue.Use(ln.constI64(0))))
    ln.collects.Push(collectCtx(buf, n, el, bt, s))
    ln.block(c.Loop)
    try ln.collects.Pop() catch { }
    if ln.dead { return mir.Operand.None }
    if ln.madeAt(c.Site) == s {
        # the buffer is the comprehension's alone and lives where the result does: its first n elements are the
        # result, with no copy - the room past them kept as long as the copy would have kept the buffer
        rt := t.Ref(t.Array(el, types.TypeId(0)), types.Writable)
        whole := ln.F.Place(mir.Base.Local(buf), Array<mir.Proj>[mir.Proj.Deref])
        view := ln.into(rt, mir.Rvalue.Slice(whole, ln.constI64(0), mir.Operand.Copy(mir.Lvalue.L(n)), rt), sp)
        if t.IsRef(t.Repr(ty)) { return view }
        return ln.prim(typed.PrimOp.Convert, ty, Array<mir.Operand>[view], sp)
    }
    out := ln.temp(ty, sp)
    # no fill: every element is copied in at once
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(out), mir.Rvalue.NewArray(ln.madeAt(c.Site), ty, mir.Operand.Copy(mir.Lvalue.L(n)), mir.Operand.None)))
    dst := ln.F.Place(mir.Base.Local(out), Array<mir.Proj>[mir.Proj.Deref] if t.IsRef(t.Repr(ty)) else Array<mir.Proj>[])
    ln.emit(mir.Stmt.CopyElems(sp, dst, ln.F.Place(mir.Base.Local(buf), Array<mir.Proj>[mir.Proj.Deref]), mir.Operand.Copy(mir.Lvalue.L(n))))
    return mir.Operand.Copy(mir.Lvalue.L(out))
}

fn (ln mut lowering&) yield(sp source.Span, x typed.Expr&) {
    if ln.collects.Len() == 0 {
        ln.gap(sp, "a yield outside a comprehension")
        return
    }
    cc := ln.collects[ln.collects.Len() - 1]
    v := ln.val(x)
    if ln.dead { return }
    n := mir.Operand.Copy(mir.Lvalue.L(cc.N))
    if cc.Exact {
        at := ln.F.Place(mir.Base.Local(cc.Buf), Array<mir.Proj>[mir.Proj.Deref, mir.Proj.Index(cc.N)] if cc.ByRef else Array<mir.Proj>[mir.Proj.Index(cc.N)])
        ln.emit(mir.Stmt.Assign(sp, at, mir.Rvalue.Use(v)))
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(cc.N), mir.Rvalue.Prim(typed.PrimOp.Add, mir.I64T, ln.F.Args(Array<mir.Operand>[n, ln.constI64(1)]))))
        return
    }
    deref := ln.F.Place(mir.Base.Local(cc.Buf), Array<mir.Proj>[mir.Proj.Deref])
    full := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[n, ln.prim(typed.PrimOp.Len, mir.I64T
                                                                       Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(cc.Buf))], sp)], sp)
    grow, store := ln.F.NewBlock(), ln.F.NewBlock()
    ln.end(mir.Term.Branch(full, grow, store))
    ln.start(grow)
    more := ln.prim(typed.PrimOp.Add, mir.I64T, Array<mir.Operand>[ln.prim(typed.PrimOp.Mul, mir.I64T
                                                                   Array<mir.Operand>[n, ln.constI64(2)], sp), ln.constI64(1)], sp)
    nb := ln.temp(cc.ArrT, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(nb), mir.Rvalue.NewArray(cc.At, cc.ArrT, more, mir.Operand.None)))
    ln.emit(mir.Stmt.CopyElems(sp, ln.F.Place(mir.Base.Local(nb), Array<mir.Proj>[mir.Proj.Deref]), deref, n))
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(cc.Buf), mir.Rvalue.Use(mir.Operand.Copy(mir.Lvalue.L(nb)))))
    ln.goto(store)
    ln.start(store)
    ln.emit(mir.Stmt.Assign(sp, ln.F.Place(mir.Base.Local(cc.Buf), Array<mir.Proj>[mir.Proj.Deref, mir.Proj.Index(cc.N)])
                            mir.Rvalue.Use(v)))
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(cc.N), mir.Rvalue.Prim(typed.PrimOp.Add, mir.I64T, ln.F.Args(Array<mir.Operand>[n, ln.constI64(1)]))))
}

# ---- operations ----

fn (ln mut lowering&) primExpr(op typed.PrimOp, chk typed.Check, args Array<typed.Expr&>&, ty types.TypeId
                              sp source.Span) mir.Operand {
    t := ln.T
    if op == typed.PrimOp.AnyMake { return ln.anyMake(args, ty, sp) }
    # O8d: the array a sole place let go of, released as it was replaced - nothing left to retire
    if op == typed.PrimOp.Retire and ln.freeing and ln.L.Free!.RetireDropped(I64(ln.B.Id), sp) { return mir.Operand.None }
    if op == typed.PrimOp.AnyIs {
        x := ln.val(args[0])
        if ln.dead { return mir.Operand.None }
        return ln.prim(op, ty, Array<mir.Operand>[x, mir.Operand.Const(args[1].Type(), 0)], sp)
    }
    if op == typed.PrimOp.AnyInstance {
        # T34: the instance an "any" holds - for "as", its type tested first
        x := ln.val(args[0])
        if ln.dead { return mir.Operand.None }
        if chk != typed.Check.None {
            holds := ln.prim(typed.PrimOp.AnyIs, types.BoolT, Array<mir.Operand>[x, mir.Operand.Const(args[1].Type(), 0)], sp)
            ln.check(holds, chk, mir.ExitKind.As, WrongCase, sp)
        }
        return ln.prim(op, ty, Array<mir.Operand>[x], sp)
    }
    if op == typed.PrimOp.ErrPush {
        # T19b: the payload of the error raised next, on the thread's payload stack - its own copy, in its record's region
        v := ln.val(args[0])
        if ln.dead { return mir.Operand.None }
        ln.errPush(v, args[0].Type(), sp)
        return mir.Operand.None
    }
    if op == typed.PrimOp.ErrCaught {
        v := ln.val(args[0])
        if ln.dead { return mir.Operand.None }
        return ln.errCaught(v, ty, sp)
    }
    if op == typed.PrimOp.ErrTaken {
        v := ln.val(args[0])
        if ln.dead { return mir.Operand.None }
        x := ln.local(v, args[0].Type(), sp)
        ln.popIf(ln.errCodeOf(x, args[0].Type()), ln.T.ErrValItems(args[0].Type()), sp)
        return mir.Operand.None
    }
    if op == typed.PrimOp.Drop {
        # O15, T13b: a by-value holder letting go - the value's destructors run in the closing block's scope (C9a)
        match args[0] {
            case typed.Expr.Borrow(_, _, p) {
                a := ln.place(p)
                if ln.dead { return mir.Operand.None }
                home := ln.escapedHome(p)
                if home == mir.ScopeRef.Frame {
                    ln.dropAt(a, p.Type(), ln.innermost(), sp)
                    # Part C (O8d): a holder letting go as its block is left releases what its sole leaves hold, once
                    # its destructors ran (free.olang's LHeld)
                    if ln.heldDrop and ln.freeing and p == typed.Lvalue.Local and not ln.dead {
                        ln.releaseAt(mir.LocalId(I32(p.id)), ln.leafPaths(p.Type()), sp)
                    }
                    return mir.Operand.None
                }
                # (bulk review 7, F4) a holder whose storage the scope pass moved where it flows - the result's, a
                # parameter's, an outer block's - lets go of nothing here: its value is registered where its storage
                # lives, as a call's value no slot takes is (O16), and its destructors run as that scope closes
                rt := ln.T.Ref(p.Type(), types.Writable)
                r := ln.into(rt, mir.Rvalue.Ref(ln.mk(a), rt), sp)
                ln.emit(mir.Stmt.RegisterDtor(sp, home, p.Type(), r))
            }
            case _ { ln.gap(sp, "a drop of no place") }
        }
        return mir.Operand.None
    }
    if op == typed.PrimOp.Destroy {
        # C9b: the region the local's instance was built in released - its destructors run, newest first, and its
        # storage reclaimed (std/runtime's __olang_region_release) - and the local left null; free.olang made every
        # value it can hold in a region of its own, or refused the call
        match args[0] {
            case typed.Expr.Read(_, _, p, _) {
                q := ln.mk(ln.place(p))
                if ln.dead { return mir.Operand.None }
                ln.emit(mir.Stmt.Release(sp, q))
            }
            case _ { }
        }
        return mir.Operand.None
    }
    if op == typed.PrimOp.LaneLen {
        # E39: two lanes' lengths, the first once they agree - a guaranteed check, once per lane operation
        a := ln.val(args[0])
        b := ln.val(args[1])
        if ln.dead { return mir.Operand.None }
        ok := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[a, b], sp)
        ln.check(ok, chk if chk != typed.Check.None else typed.Check.Abort, mir.ExitKind.LaneLength, OutOfBounds, sp)
        return a
    }
    if op == typed.PrimOp.NonEmpty {
        # E39: a total that needs an element - failing with ArrayError.Empty where there is none
        n := ln.val(args[0])
        if ln.dead { return mir.Operand.None }
        ok := ln.prim(typed.PrimOp.Gt, types.BoolT, Array<mir.Operand>[n, ln.constI64(0)], sp)
        ln.check(ok, chk if chk != typed.Check.None else typed.Check.Try, mir.ExitKind.ArrayLength, Empty, sp)
        return mir.Operand.None
    }
    if op == typed.PrimOp.Holds {
        # D17e: a contract's condition under checked - true, or CheckError.CONTRACT to the innermost try
        v := ln.val(args[0])
        if ln.dead { return mir.Operand.None }
        ln.check(v, chk if chk != typed.Check.None else typed.Check.Try, mir.ExitKind.Assert, Contract, sp)
        return v
    }
    # a fixed array a reference names, as a run-time-length array value: the pair naming that storage, not a copy of it
    # (D9b: a by-value array is the caller's array whatever the argument is - a copy is made where one is wanted, a
    # declaration's or a body that writes it)
    r typed.Expr?& = null
    if op == typed.PrimOp.Convert and args.Len() == 1 and ln.valueArray(ty) and not ln.convertsApart(args[0].Type(), ty) { r = derefOf(args[0]) }
    if r is not null and ln.arrayOf(args[0].Type()) != types.UnknownT and ln.fixedLen(ln.arrayOf(args[0].Type())) >= 0 {
        v := ln.val(r)
        if ln.dead { return mir.Operand.None }
        return ln.prim(op, ty, Array<mir.Operand>[v], sp)
    }
    # T7c: a literal or a fill of a known length (held in place) made a run-time-length array value: made at its own
    # site, where the scope pass placed it - the conversion's storage of its own had no place but the program's
    if op == typed.PrimOp.Convert and args.Len() == 1 and ln.valueArray(ty) {
        match args[0] {
            case typed.Expr.Make(_, mt, m) {
                fa := ln.arrayOf(mt)
                if (m.Kind == typed.MakeKind.Fill or m.Kind == typed.MakeKind.Array) and not t.IsRef(t.Repr(mt)) and
                   fa != types.UnknownT and ln.fixedLen(fa) >= 0 and ln.fixedLen(ln.arrayOf(ty)) < 0 and m.Site >= typed.SiteId(0) {
                    at := ln.built(m.Site)
                    return ln.fill(m, ty, sp, true, at) if m.Kind == typed.MakeKind.Fill else ln.arrayLit(m, ty, sp, true, at)
                }
            }
            case _ { }
        }
    }
    ops := ln.vals(args)
    if ln.dead { return mir.Operand.None }
    # T20: an error value made one of a set holding it - its code renumbered (R6)
    if op == typed.PrimOp.Convert and args.Len() == 1 and t.KindOf(ty) == types.Kind.ErrVal and t.KindOf(args[0].Type()) == types.Kind.ErrVal {
        if t.ErrCarries(ty) or t.ErrCarries(args[0].Type()): return ln.errConvert(ops[0], args[0].Type(), ty, sp)
        return ln.into(ty, mir.Rvalue.Recode(ops[0], t.ErrValItems(args[0].Type()), t.ErrValItems(ty)), sp)
    }
    if ln.widening(op, args, ty) { return ln.widen(ops[0], args[0].Type(), ty, sp, ln.innermost()) }
    if op == typed.PrimOp.IsCase and t.IsRef(t.Repr(args[0].Type())) { return ln.isCaseRef(ops[0], args[0].Type(), ops[1], sp) }
    if chk != typed.Check.None { ln.primChecks(op, chk, ops, args, ty, sp) }
    if (op == typed.PrimOp.Eq or op == typed.PrimOp.Ne) and args.Len() == 2 and t.ErrCarries(args[0].Type()) {
        # T19b: error values carrying payloads equal where their codes and their payloads do (E10)
        et := args[0].Type()
        x, y := ln.local(ops[0], et, sp), ln.local(ops[1], et, sp)
        e := ln.equalAt(pl(mir.Base.Local(x)), pl(mir.Base.Local(y)), et, sp)
        return e if op == typed.PrimOp.Eq else ln.prim(typed.PrimOp.Not, types.BoolT, Array<mir.Operand>[e], sp)
    }
    return ln.prim(op, ty, ops, sp)
}

# T32a: an "any" made of a reference to its instance and its table - an array's copy put in the box the conversion
# made where the "any" lands, its elements copied there with it (T7b): the box is a one-part tuple holding the array
fn (ln mut lowering&) anyMake(args Array<typed.Expr&>&, ty types.TypeId, sp source.Span) mir.Operand {
    a0 := args[0]
    if a0 == typed.Expr.Promote {
        pr := a0.pr
        x := pr.X
        if x == typed.Expr.Make and x.m.Kind == typed.MakeKind.Tuple and x.m.Items.Len() == 1 and ln.valueArray(x.m.Items[0].Type()) {
            at := ln.built(pr.Site)
            item := x.m.Items[0]
            v := ln.val(item)
            if ln.dead { return mir.Operand.None }
            if not typed.AnyItemNew(ln.T, item) { v = ln.arrayCopy(v, item.Type(), sp, at) }
            agg := ln.into(x.ty, mir.Rvalue.Aggregate(x.ty, 0, ln.F.Args(Array<mir.Operand>[v])), x.sp)
            box := ln.into(a0.ty, mir.Rvalue.New(at, agg, a0.ty), sp)
            return ln.prim(typed.PrimOp.AnyMake, ty, Array<mir.Operand>[box, ln.val(args[1])], sp)
        }
    }
    ops := ln.vals(args)
    if ln.dead { return mir.Operand.None }
    return ln.prim(typed.PrimOp.AnyMake, ty, ops, sp)
}

# whether what an enum reference names holds a case: false for a null reference (E32, T17d)
fn (ln mut lowering&) isCaseRef(r mir.Operand, rt types.TypeId, tag mir.Operand, sp source.Span) mir.Operand {
    slot := ln.temp(types.BoolT, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(slot), mir.Rvalue.Use(ln.constBool(false, sp))))
    l := ln.local(r, rt, sp)
    nn := ln.prim(typed.PrimOp.Ne, types.BoolT, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(l)), mir.Operand.Const(rt, 0)], sp)
    yes, after := ln.F.NewBlock(), ln.F.NewBlock()
    ln.end(mir.Term.Branch(nn, yes, after))
    ln.start(yes)
    tg := ln.into(mir.I64T, mir.Rvalue.Tag(ln.F.Place(mir.Base.Local(l), Array<mir.Proj>[mir.Proj.Deref])), sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(slot), mir.Rvalue.Prim(typed.PrimOp.Eq, types.BoolT
                                                             ln.F.Args(Array<mir.Operand>[tg, ln.asI64(tag, mir.I64T, sp)]))))
    ln.goto(after)
    ln.start(after)
    return mir.Operand.Copy(mir.Lvalue.L(slot))
}

# what a checked conversion tests before it runs: an array of a run-time length copied into fixed storage, its length
# (T7d); a narrowing (E26b), a value that changes or a NaN or an infinity made an integer
fn (ln mut lowering&) primChecks(op typed.PrimOp, chk typed.Check, ops Array<mir.Operand>&, args Array<typed.Expr&>&
                                 ty types.TypeId, sp source.Span) {
    t := ln.T
    at := t.Repr(args[0].Type())
    rt := t.Repr(ty)
    kind := mir.ExitKind.Abort
    match op {
        case typed.PrimOp.Convert {
            # T7d: an array of a run-time length copied into fixed storage - its length checked, once
            fa := ln.arrayOf(ty)
            sa := ln.arrayOf(args[0].Type())
            if fa != types.UnknownT and sa != types.UnknownT and ln.fixedLen(fa) >= 0 and ln.fixedLen(sa) < 0 {
                n := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[ops[0]], sp)
                same := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[n, mir.Operand.Const(mir.I64T, ln.fixedLen(fa))], sp)
                ln.check(same, chk, mir.ExitKind.FixedLength, OutOfBounds, sp)
                return
            }
            if t.IsInt(rt) and (t.IsInt(at) or t.IsFloat(at)) {
                if t.IsFloat(at) {
                    # a NaN or an infinity: x - x is not 0
                    d := ln.prim(typed.PrimOp.Sub, args[0].Type(), Array<mir.Operand>[ops[0], ops[0]], sp)
                    fin := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[d, mir.Operand.Const(args[0].Type(), 0)], sp)
                    ln.check(fin, chk, kind, Invalid, sp)
                }
                over := ln.into(types.BoolT, mir.Rvalue.Overflows(op, ty, ln.F.Args(ops)), sp)
                ln.fails(over, chk, kind, Overflow, sp)
            } else if t.IsFloat(rt) {
                # Overflow when a finite value becomes infinite: an infinity converted stays one
                res := ln.prim(op, ty, ops, sp)
                d := ln.prim(typed.PrimOp.Sub, ty, Array<mir.Operand>[res, res], sp)
                ok := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[d, mir.Operand.Const(ty, 0)], sp)
                ok = ln.prim(typed.PrimOp.BitOr, types.BoolT, Array<mir.Operand>[ok, ln.prim(typed.PrimOp.Ne, types.BoolT, Array<mir.Operand>[res, res], sp)], sp)
                if t.IsFloat(at) {
                    d0 := ln.prim(typed.PrimOp.Sub, args[0].Type(), Array<mir.Operand>[ops[0], ops[0]], sp)
                    fin0 := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[d0, mir.Operand.Const(args[0].Type(), 0)], sp)
                    ok = ln.prim(typed.PrimOp.BitOr, types.BoolT, Array<mir.Operand>[ok, ln.prim(typed.PrimOp.Not, types.BoolT, Array<mir.Operand>[fin0], sp)], sp)
                }
                ln.check(ok, chk, kind, Overflow, sp)
            }
        }
        case _ { }
    }
}

fn (ln mut lowering&) constBool(b Bool, sp source.Span) mir.Operand { return mir.Operand.Const(types.BoolT, 1 if b else 0) }

# a slice (E16a): its bounds tested (E16b, E16c) - 0 <= lo <= hi <= the base's length - then the reference to its
# elements
fn (ln mut lowering&) slice(s typed.Slice&, ty types.TypeId, sp source.Span) mir.Operand {
    ln.viewing = true
    base := ln.place(s.Base)
    ln.viewing = false
    lo := ln.val(s.Lo)
    hi := ln.val(s.Hi)
    if ln.dead { return mir.Operand.None }
    lo64 := ln.asI64(lo, s.Lo.Type(), sp)
    hi64 := ln.asI64(hi, s.Hi.Type(), sp)
    if s.Checked != typed.Check.None {
        n := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(ln.mk(base))], sp)
        a := ln.prim(typed.PrimOp.Ge, types.BoolT, Array<mir.Operand>[lo64, ln.constI64(0)], sp)
        ln.check(a, s.Checked, mir.ExitKind.SliceBounds, OutOfBounds, sp)
        b := ln.prim(typed.PrimOp.Le, types.BoolT, Array<mir.Operand>[lo64, hi64], sp)
        ln.check(b, s.Checked, mir.ExitKind.SliceBounds, OutOfBounds, sp)
        c := ln.prim(typed.PrimOp.Le, types.BoolT, Array<mir.Operand>[hi64, n], sp)
        ln.check(c, s.Checked, mir.ExitKind.SliceBounds, OutOfBounds, sp)
    }
    return ln.into(ty, mir.Rvalue.Slice(ln.mk(base), lo64, hi64, ty), sp)
}

# ---- function values ----

fn (ln mut lowering&) fnVal(fv typed.FnVal&, ty types.TypeId, sp source.Span) mir.Operand {
    return match fv {
        case typed.FnVal.Named(body): ln.into(ty, mir.Rvalue.Closure(ln.L.CodeOf(body), ty, mir.ScopeRef.Frame, mir.Empty, mir.Empty), sp)
        case typed.FnVal.Lambda(body, caps, site): ln.lambda(body, caps, site, ty, sp)
        case typed.FnVal.Adapter(call, recv, site): ln.adapter(call, recv, site, ty, sp)
    }
}

fn (ln mut lowering&) lambda(body typed.BodyId, caps Array<typed.Capture&>&, site typed.SiteId, ty types.TypeId
                            sp source.Span) mir.Operand {
    gen := ln.L.Bodies[I64(body)].Gen
    s := mir.ScopeRef.Frame if caps.Len() == 0 else ln.built(site)
    # D18: a generator's Next is its walk - its storage (its coroutine's frame, its locals, the scopes it holds open)
    # where the generator lands, which its captures outlive (O14a); a value array it is given copied there (D18b)
    if gen { s = ln.resultScope() }
    ops := Array<mir.Operand>(caps.Len())
    for i in range caps.Len() {
        ops[i] = ln.val(caps[i].Outer)
        ct := caps[i].Outer.Type()
        if ln.dead: continue
        if gen and ln.valueArray(ct) { ops[i] = ln.arrayCopy(ops[i], ct, sp, s) }
        # D16c, E31d (bulk review 7, F8): a value captured is the lambda's own copy - what it owns copied (a struct's
        # arrays, a Vec's buffer), by its declared Copy - made where the lambda lives; a value array is borrowed (above)
        if caps[i].Outer == typed.Expr.Read and not ln.T.IsRef(ct) and ln.T.OwnsParts(ct) { ops[i] = ln.ownCopyOf(ops[i], ct, ln.copyHome(s), sp) }
    }
    if ln.dead { return mir.Operand.None }
    return ln.into(ty, mir.Rvalue.Closure(mir.FnKey.Body(body), ty, s, ln.F.Args(ops), ln.capScopes(site)), sp)
}

# where a closure's captured copies are made: its own scope - or, for one held in the frame (D16d's latitude), the
# frame's scope, which lives as long as the frame does (a scope variable never stands for the frame itself)
fn (ln mut lowering&) copyHome(s mir.ScopeRef) mir.ScopeRef {
    if s != mir.ScopeRef.Frame: return s
    for lv in ln.levels {
        if lv.Kind == mir.ScopeKind.Frame: return mir.ScopeRef.Scope(lv.S)
    }
    return ln.innermost()
}

fn (ln mut lowering&) adapter(call typed.BodyId, recv typed.Expr&, site typed.SiteId, ty types.TypeId, sp source.Span) mir.Operand {
    r := ln.val(recv)
    if ln.dead { return mir.Operand.None }
    ln.L.Want(mir.FnKey.Adapter(call))
    return ln.into(ty, mir.Rvalue.Closure(mir.FnKey.Adapter(call), ty, ln.built(site), ln.F.Args(Array<mir.Operand>[r]), ln.capScopes(site))
                   sp)
}

# where a closure's captures holding references live, in order (D16c): the plan's at its site, none recorded under the
# stand-in placement
fn (ln mut lowering&) capScopes(site typed.SiteId) mir.Range {
    if not ln.planned or site < typed.SiteId(0) or I64(site) >= ln.plan.Built.Len() { return mir.Empty }
    xs Vec<mir.ScopeRef>
    for i := I64(0), ln.plan.Passed(site, i) != typed.Scope.Unset, i++ { xs.Push(ln.scopeRef(ln.plan.Passed(site, i))) }
    return ln.F.ScopeRefs(xs.ToArray())
}

# ---- text ----

# renderings joined (E11a, E11b): every rendered operand computed first, then a builder opened, each piece written - a
# number, a Bool, a Char or text by kind, anything else by its type's Render helper - and the text made where the site
# says, the builder closed
fn (ln mut lowering&) text(tx typed.Text&, ty types.TypeId, sp source.Span) mir.Operand {
    t := ln.T
    vals := Array<mir.Operand>(tx.Pieces.Len())
    tys := Array<types.TypeId>(tx.Pieces.Len())
    for i in range tx.Pieces.Len() {
        match tx.Pieces[i] {
            case typed.Piece.Render(x) {
                ln.readHere(x)
                ln.pieceView(x)
                vals[i], tys[i] = ln.piece(x, sp)
            }
            case _ { }
        }
    }
    if ln.dead { return mir.Operand.None }
    b := ln.F.AddScope(mir.ScopeKind.Builder, ln.top().S, typed.BlockId(-1), sp)
    ln.emit(mir.Stmt.Open(sp, b))
    bref := mir.ScopeRef.Scope(b)
    u8 := t.Prim("U8")
    bytesT := t.Ref(t.Array(u8, types.TypeId(0)), types.ReadOnly)
    for i in range tx.Pieces.Len() {
        match tx.Pieces[i] {
            case typed.Piece.Lit(bytes) {
                c := ln.F.AddConst(typed.Const.Bytes(bytes))
                ln.emit(mir.Stmt.Write(sp, bref, mir.WriteKind.Bytes, mir.Operand.Data(bytesT, c, ln.file, sp)))
            }
            case typed.Piece.Render(_) { ln.render(bref, vals[i], tys[i], sp) }
        }
    }
    r := ln.into(ty, mir.Rvalue.Text(bref, ln.built(tx.Site), ty), sp)
    ln.emit(mir.Stmt.Close(sp, b))
    return r
}

# a rendered operand, computed before any piece renders (E11b, Go's rule): a struct or a number as it is then, but an
# array's elements read when its piece renders - a fixed array read from a place is rendered through a reference to
# that place, as a run-time array's pair names its storage
fn (ln mut lowering&) piece(x typed.Expr&, sp source.Span) mir.Operand, types.TypeId {
    t := ln.T
    xt := x.Type()
    a := ln.arrayOf(xt)
    if not t.IsRef(t.Repr(xt)) and a != types.UnknownT and ln.fixedLen(a) >= 0 {
        match x {
            case typed.Expr.Read(_, _, p, _) {
                q := ln.place(p)
                if ln.dead { return mir.Operand.None, xt }
                if q.Pk >= 0 { return ln.packedRead(q, xt, sp), xt }   # T13c: no place to refer to
                rt := t.Ref(xt, types.ReadOnly)
                return ln.into(rt, mir.Rvalue.Ref(ln.mk(q), rt), sp), rt
            }
            case _ { }
        }
    }
    return ln.val(x), xt
}

# one value written into builder b: by kind where it is a number, a Bool, a Char or text, else through its type's Render
# helper, the builder its one scope
fn (ln mut lowering&) render(b mir.ScopeRef, v mir.Operand, ty types.TypeId, sp source.Span) {
    t := ln.T
    if ty == types.UnknownT or ln.gapped { return }
    if t.IsAny(t.Repr(ty)) {
        ln.renderAny(b, v, ty, true, sp)
        return
    }
    if t.KindOf(ty) == types.Kind.ErrVal {
        ln.renderErr(b, v, ty, sp)
        return
    }
    r := t.Repr(ty)
    if t.IsNullable(r) and t.ArrayRef(r) and ln.isText(ty) and not ln.hasStr(ty) {
        ln.renderMaybeText(b, v, ty, sp)
        return
    }
    how := mir.WriteKind.Bool
    direct := true
    if ln.hasStr(ty) or t.IsNullable(r) and t.ArrayRef(r) {
        direct = false   # (an array that may be null renders as "null" where it is, T2c - through its helper)
    } else if ln.isChar(ty) {
        how = mir.WriteKind.Char
    } else if r == types.BoolT {
        how = mir.WriteKind.Bool
    } else if t.IsUnsigned(r) {
        how = mir.WriteKind.Uint
    } else if t.IsInt(r) {
        how = mir.WriteKind.Int
    } else if t.IsFloat(r) {
        how = mir.WriteKind.Float
    } else if ln.isText(ty) {
        how = mir.WriteKind.Bytes
    } else {
        direct = false
    }
    if direct {
        ln.emit(mir.Stmt.Write(sp, b, how, v))
        return
    }
    ty = ln.L.helperTy(mir.HelperKind.Render, ty)
    hty := mir.HelperType(t, mir.HelperKind.Render, ty)
    ref := ln.into(t.Items(t.Params(hty))[0], mir.Rvalue.Ref(mir.Lvalue.L(ln.local(v, ty, sp)), t.Items(t.Params(hty))[0]), sp)
    callee := mir.Callee.Fn(mir.FnKey.Helper(mir.HelperKind.Render, ty), hty)
    ln.L.Want(mir.FnKey.Helper(mir.HelperKind.Render, ty))
    ok := ln.F.NewBlock()
    k := ln.F.AddCall(mir.Call(callee, ln.F.Args(Array<mir.Operand>[ref, ln.depth()]), ln.F.ScopeRefs(Array<mir.ScopeRef>[b]), mir.NoPlace, false, ok
                               mir.NoLocal, mir.NoBlock))
    ln.end(mir.Term.Call(sp, k))
    ln.start(ok)
}

# T2c: text that may be null rendered - "null" where it is, else the text itself, as how writes it (at the top of a
# rendering its bytes, inside another's quoted)
fn (ln mut lowering&) renderMaybeText(b mir.ScopeRef, v mir.Operand, ty types.TypeId, sp source.Span
                                      how mir.WriteKind = mir.WriteKind.Bytes) {
    x := ln.local(v, ty, sp)
    isNull := ln.prim(typed.PrimOp.Same, types.BoolT, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(x)), mir.Operand.Const(ty, -1)], sp)
    none, some, after := ln.F.NewBlock(), ln.F.NewBlock(), ln.F.NewBlock()
    ln.end(mir.Term.Branch(isNull, none, some))
    ln.start(none)
    ln.word(b, "null", sp)
    ln.goto(after)
    ln.start(some)
    ln.emit(mir.Stmt.Write(sp, b, how, mir.Operand.Copy(mir.Lvalue.L(x))))
    ln.goto(after)
    ln.start(after)
}

# T20, B5: an error value rendered as an error's name prints ("os.Error.Denied", the prelude's and the root program's
# bare), null as "null" - a test of its code per word its type holds
fn (ln mut lowering&) renderErr(b mir.ScopeRef, v mir.Operand, ty types.TypeId, sp source.Span) {
    t := ln.T
    p := ln.L.P
    x := ln.local(v, ty, sp)
    code := ln.into(mir.I32T, mir.Rvalue.Use(ln.errCodeOf(x, ty)), sp)
    codes Vec<I64>
    texts Vec<String&>
    codes.Push(0)
    texts.Push("null")
    # T19b: a word carrying a payload renders it after its name, as an enum case's ("ParseError.Bad(3, 7)")
    pays Vec<I64>     # the payload part of the word at each index, 0 for none
    tags Vec<I64>
    recs Vec<types.TypeId>
    pays.Push(0)
    tags.Push(0)
    recs.Push(types.TypeId(0))
    es := t.Items(t.ErrValItems(ty))
    for j in range es.Len() {
        et := t.ErrOf(es[j])
        d := t.DeclOf(et)
        dm := t.DeclModule(d)
        q := load.ErrQualifier(p.L.Mods[dm].Identity, dm == p.L.Root)
        ws := p.ErrorWords(d)
        pt := p.PayloadOf(et)
        for w in range ws.Len() {
            if w < 64 and (t.ErrMask(es[j]) & (U64(1) << w)) == 0 { continue }
            codes.Push(((j + 1) << 16) | w)
            texts.Push($q $p.ErrorWordName(d, w))
            carried := pt != types.UnknownT and p.WordFields(d, w).Len() > 0
            pays.Push(p.PayloadField(ty, j) if carried else 0)
            tags.Push(w)
            recs.Push(t.Items(t.Cases(pt))[w] if carried else types.TypeId(0))
        }
    }
    after := ln.F.NewBlock()
    for i in range codes.Len() {
        last := i == codes.Len() - 1
        if not last {
            hit := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[code, mir.Operand.Const(mir.I32T, codes[i])], sp)
            yes, no := ln.F.NewBlock(), ln.F.NewBlock()
            ln.end(mir.Term.Branch(hit, yes, no))
            ln.start(yes)
            ln.errWord(b, x, texts[i], pays[i], tags[i], recs[i], sp)
            ln.goto(after)
            ln.start(no)
            continue
        }
        ln.errWord(b, x, texts[i], pays[i], tags[i], recs[i], sp)
        ln.goto(after)
    }
    ln.start(after)
}

# an error word's name written, then the payload error value x holds in part f (0 for none), the case tag of record rec
fn (ln mut lowering&) errWord(b mir.ScopeRef, x mir.LocalId, text String&, f I64, tag I64, rec types.TypeId, sp source.Span) {
    ln.word(b, text, sp)
    if f > 0: ln.renderPayload(ln.with(pl(mir.Base.Local(x)), mir.Proj.Field(f)), tag, rec, b, sp)
}

# text: an array of Chars, or a reference to one - what a Bytes write appends
fn (ln mut lowering&) isText(ty types.TypeId) Bool {
    t := ln.T
    x := t.Repr(ty)
    if t.IsRef(x) { x = t.Repr(t.Referent(x)) }
    if t.KindOf(x) != types.Kind.Array { return false }
    return t.Same(t.Elem(x), ln.L.char())
}

# ---- helpers, adapters, modules' initializations (DESIGN.md 1.8, 1.8.1) ----

# a lowering of no typed body: for a function lowering makes itself, its parameters and blocks written here
fn (lw mut Lowerer&) bare(k mir.FnKey, ty types.TypeId) mir.Fn { return mir.Fn(k, ty, 0, source.Span(0, 0)) }

# a typed body standing in for a function lowering makes itself: its type, no locals and no code
fn standIn(ty types.TypeId) typed.Body { return typed.Body(typed.BodyId(-1), typed.BodyOf.Test(-1), ty, 0, source.Span(0, 0)) }

# the bodies by what they are, once: a type's constructor's (twin 0)
fn (lw mut Lowerer&) index() {
    if lw.indexed { return }
    lw.indexed = true
    for i in range lw.Bodies.Len() {
        match lw.Bodies[i].Of {
            case typed.BodyOf.Ctor(t, twin) {
                if twin == types.ListId(0) { lw.ctorOf.Put(t, i) }
            }
            case typed.BodyOf.Dtor(t) { lw.dtorOf.Put(t, i) }
            case _ { }
        }
    }
}

# a helper for type t (DESIGN.md 1.8.1): its ABI its kind's (mir.HelperType), its code what the kind says of t's parts
fn (lw mut Lowerer&) helper(kind mir.HelperKind, t types.TypeId) mir.Fn {
    hty := mir.HelperType(lw.P.T, kind, t)
    b := standIn(hty)
    ln := lowering(lw, b, lw.P.T, lw.bare(mir.FnKey.Helper(kind, t), hty))
    ln.helper(kind, t)
    lw.Gapped = ln.gapped
    return ln.F
}

# the parameters of a function lowering makes, from its type, and its scope variables; the entry block opening the frame
fn (ln mut lowering&) prologue(vars Array<mir.VarKind>&) {
    t := ln.T
    for p in t.Items(t.Params(ln.F.Ty)) { ln.F.AddParam(source.NameId(0), ln.B.Sp, p) }
    for v in vars { ln.F.Vars.Push(v) }
    ln.F.NewBlock()
    frame := ln.F.AddScope(mir.ScopeKind.Frame, mir.NoScope, typed.BlockId(-1), ln.B.Sp)
    ln.emit(mir.Stmt.Open(ln.B.Sp, frame))
    ln.levels.Push(level(frame, typed.BlockId(-1), mir.ScopeKind.Frame))
}

fn (ln mut lowering&) epilogue(x mir.Operand) {
    ln.leave(0)
    ln.end(mir.Term.Return(ln.B.Sp, x))
}

fn (ln mut lowering&) helper(kind mir.HelperKind, ty types.TypeId) {
    t := ln.T
    sp := ln.B.Sp
    match kind {
        case mir.HelperKind.Equal {
            ln.prologue(Array<mir.VarKind>[])
            a := ln.at(mir.LocalId(0))
            b := ln.at(mir.LocalId(1))
            ln.epilogue(ln.equalAt(a, b, ty, sp, true))
        }
        case mir.HelperKind.Hash {
            ln.prologue(Array<mir.VarKind>[])
            ln.epilogue(ln.hashAt(ln.at(mir.LocalId(0)), ty, sp, true))
        }
        case mir.HelperKind.Zero {
            vs := t.ScopeVarsOf(ln.F.Ty)
            ln.prologue(Array<mir.VarKind>[mir.VarKind.Result] if vs.Len() > 0 else Array<mir.VarKind>[])
            ln.epilogue(ln.zeroOf(ty, sp, vs.Len() > 0))
        }
        case mir.HelperKind.Render {
            ln.prologue(Array<mir.VarKind>[mir.VarKind.Builder])
            ln.rdepth = mir.Operand.Copy(mir.Lvalue.L(mir.LocalId(1)))
            ln.renderAt(ln.at(mir.LocalId(0)), ty, mir.ScopeRef.Var(0), sp, true)
            ln.epilogue(mir.Operand.None)
        }
        case mir.HelperKind.Copy, mir.HelperKind.Parts {
            ln.prologue(Array<mir.VarKind>[mir.VarKind.Result])
            ln.epilogue(ln.copyAt(ln.at(mir.LocalId(0)), ty, mir.ScopeRef.Var(0), sp, true, kind == mir.HelperKind.Parts))
        }
        case mir.HelperKind.Drop {
            ln.prologue(Array<mir.VarKind>[mir.VarKind.Closing])
            ln.dropAt(ln.at(mir.LocalId(0)), ty, mir.ScopeRef.Var(0), sp, true)
            ln.epilogue(mir.Operand.None)
        }
        case mir.HelperKind.Guard {
            ln.prologue(Array<mir.VarKind>[mir.VarKind.Closing])
            ln.guardBody(ty, sp)
            ln.epilogue(mir.Operand.None)
        }
    }
}

# a guard's body (HelperKind.Guard): where its holder's flag is set, the holder's destructors run and the flag cleared
fn (ln mut lowering&) guardBody(gty types.TypeId, sp source.Span) {
    g := ln.at(mir.LocalId(0))
    flag := ln.with(ln.with(g, mir.Proj.Field(0)), mir.Proj.Deref)
    held := ln.with(ln.with(g, mir.Proj.Field(1)), mir.Proj.Deref)
    yes := ln.F.NewBlock()
    done := ln.F.NewBlock()
    ln.end(mir.Term.Branch(mir.Operand.Copy(ln.mk(flag)), yes, done))
    ln.start(yes)
    ln.dropAt(held, mir.GuardOf(ln.T, gty), mir.ScopeRef.Var(0), sp)
    ln.emit(mir.Stmt.Assign(sp, ln.mk(flag), mir.Rvalue.Use(mir.Operand.Const(types.BoolT, 0))))
    ln.end(mir.Term.Goto(done))
    ln.start(done)
}

# a by-value holder's drop just registered (deferred code of kind Drop, "if flag { Drop(x) }"): in a test build its
# guard registered with the block too, so a failed check's unwinding, which runs no deferred code, ends what the holder
# still holds as it closes the block's scope (P1d; bulk review 7, F5)
fn (ln mut lowering&) guardHolder(sp source.Span, b typed.Block&) {
    if not ln.L.Tests or b.Stmts.Len() != 1: return
    match b.Stmts[0] {
        case typed.Stmt.If(_, f) { ln.guardIf(sp, f) }
        case _ { }
    }
}

fn (ln mut lowering&) guardIf(sp source.Span, f typed.If&) {
    if f.Then.Stmts.Len() == 0: return
    fp := readLocalPlace(f.Test)
    hp := droppedPlace(f.Then.Stmts[0])
    if fp is null or hp is null: return
    t := ln.T
    rf := t.Ref(types.BoolT, types.Writable)
    rh := t.Ref(hp.Type(), types.Writable)
    fv := ln.into(rf, mir.Rvalue.Ref(ln.mk(ln.place(fp)), rf), sp)
    hv := ln.into(rh, mir.Rvalue.Ref(ln.mk(ln.place(hp)), rh), sp)
    if ln.dead: return
    gty := mir.GuardType(t, hp.Type())
    gv := ln.into(gty, mir.Rvalue.Aggregate(gty, 0, ln.F.Args(Array<mir.Operand>[fv, hv])), sp)
    s := ln.innermost()
    gr := ln.into(t.Ref(gty, types.Writable), mir.Rvalue.New(s, gv, t.Ref(gty, types.Writable)), sp)
    ln.emit(mir.Stmt.RegisterDtor(sp, s, gty, gr))
}

# a test build's guards kept in the order its block's holders end (runOrder, O15): where the holder just registered is
# held by holders registered before it, their guards are registered again after its own, each holder before what it
# holds - a guard whose holder holds no value any more does nothing, so the unwinding still ends each once
fn (ln mut lowering&) guardAgain(sp source.Span) {
    if not ln.L.Tests: return
    s := ln.top().S
    drops Vec<I64>
    for k in range ln.defers.Len() {
        if ln.deferAt[k] == s and ln.isDrop(k): drops.Push(k)
    }
    if drops.Len() < 2: return
    order := ln.runOrder(drops)
    p := try order.IndexOf(ln.defers.Len() - 1) catch default 0
    for i := p - 1, i >= 0, i-- { ln.guardHolder(sp, ln.defers[order[i]]) }
}

# the place a holder's drop statement ("Drop(&x)") ends, else null
fn droppedPlace(s typed.Stmt&) typed.Lvalue?& {
    return match s {
        case typed.Stmt.Eval(_, x): droppedArg(x)
        case _: null
    }
}

fn droppedArg(x typed.Expr&) typed.Lvalue?& {
    return match x {
        case typed.Expr.Prim(_, _, op, _, args): borrowedPlace(args[0]) if op == typed.PrimOp.Drop and args.Len() == 1 else null
        case _: null
    }
}

fn borrowedPlace(x typed.Expr&) typed.Lvalue?& {
    return match x {
        case typed.Expr.Borrow(_, _, p): p
        case _: null
    }
}

fn readLocalPlace(x typed.Expr&) typed.Lvalue?& {
    return match x {
        case typed.Expr.Read(_, _, p, _): p if p == typed.Lvalue.Local else null
        case _: null
    }
}

# ---- destructors run where a holder lets go (O15, T13b) ----

# the destructors a value of type ty in place a has to run, run in scope at (C9a: the scope being closed): its type's own
# first, then each part's held by value, last first (O15's reverse construction) - a part's through its type's Drop
# helper, so a type that comes round to itself is one function; top: in that helper, its own parts
fn (ln mut lowering&) dropAt(a pl, ty types.TypeId, at mir.ScopeRef, sp source.Span, top Bool = false) {
    t := ln.T
    if t.IsRef(ty) or not t.NeedsDrop(ty) { return }
    if not top {
        ref := ln.into(t.Ref(ty, types.Writable), mir.Rvalue.Ref(ln.mk(a), t.Ref(ty, types.Writable)), sp)
        ln.helperCall(mir.HelperKind.Drop, ty, Array<mir.Operand>[ref], Array<mir.ScopeRef>[at], types.VoidT, sp)
        return
    }
    ln.L.index()
    id := try ln.L.dtorOf.Get(t.Repr(ty)) catch default -1
    if id >= 0 and t.Destructs(t.Repr(ty)) {
        callee, fty := ln.bodyCallee(typed.BodyId(I32(id)))
        p0 := t.Items(t.Params(fty))[0]
        recv := ln.into(p0, mir.Rvalue.Ref(ln.mk(a), p0), sp)
        vs := t.ScopeVarsOf(fty)
        xs := Array<mir.ScopeRef>(vs.Len(), at)
        ok := ln.F.NewBlock()
        k := ln.F.AddCall(mir.Call(callee, ln.F.Args(Array<mir.Operand>[recv]), ln.F.ScopeRefs(xs), mir.NoPlace, false, ok, mir.NoLocal
                                   mir.NoBlock))
        ln.end(mir.Term.Call(sp, k))
        ln.start(ok)
    }
    r := t.Repr(ty)
    if mir.HasFields(t, ty) {
        parts := ln.partsOf(ty)
        for i := parts.Len() - 1, i >= 0, i-- { ln.dropAt(ln.with(a, mir.Proj.Field(i)), parts[i], at, sp) }
    } else if mir.HasCases(t, ty) {
        tag := ln.into(mir.I64T, mir.Rvalue.Tag(ln.mk(a)), sp)
        ln.payloads(ln.casesOf(ty), tag, sp, fn(c I64, rec types.TypeId) {
            fs := ln.items(ln.T.Parts(rec))
            for i := fs.Len() - 1, i >= 0, i-- { ln.dropAt(ln.with(ln.with(a, mir.Proj.Payload(c)), mir.Proj.Field(i)), fs[i], at, sp) }
        })
    } else if t.KindOf(r) == types.Kind.Array and t.Length(r) != types.TypeId(0) {
        el := t.Elem(r)
        n := t.ConstValue(t.Length(r))
        for i := n - 1, i >= 0, i-- { ln.dropAt(ln.with(a, mir.Proj.Index(ln.local(ln.constI64(i), mir.I64T, sp))), el, at, sp) }
    }
}

# ---- owned copies (QCE: T7a relaxed) ----

# whether a copy of a value of the type is more than its bytes: an array of a run-time length (its elements are its
# storage), or a value holding one as a part (types.OwnsParts)
fn (ln mut lowering&) ownsStorage(ty types.TypeId) Bool { return ln.T.OwnedPart(ty) or ln.T.OwnsParts(ty) }

# v, a value of type ty, as one of its own made in scope at (typed.MakeKind.Copy): an array value's elements copied, and
# every part of it that is an array of a run-time length - deep through values, shallow at references - through the
# type's Copy helper where a part owns any
# parts: a copy of what the value holds rather than of the value (D9h's, where a callee handed back a view of what it was
# given: that copy is the callee's own, which a declared Copy at the top would not be - and calls itself through, E31d)
fn (ln mut lowering&) ownCopyOf(v mir.Operand, ty types.TypeId, at mir.ScopeRef, sp source.Span, parts Bool = false) mir.Operand {
    if not ln.T.OwnsParts(ty) { return ln.arrayCopy(v, ty, sp, at) if ln.T.OwnedPart(ty) else v }
    src := ln.local(v, ty, sp)
    if parts and ln.T.DeclaresCopy(ty) {
        return ln.helperCall(mir.HelperKind.Parts, ty, Array<mir.Operand>[ln.refTo(pl(mir.Base.Local(src)), ty, sp)], Array<mir.ScopeRef>[at], ty, sp)
    }
    return ln.helperCall(mir.HelperKind.Copy, ty, Array<mir.Operand>[ln.refTo(pl(mir.Base.Local(src)), ty, sp)], Array<mir.ScopeRef>[at]
                         ty, sp)
}

# the copy of what place a holds, of type ty, made in scope at - a part owning nothing its bytes, an array of a run-time
# length a new one there, and a value's owning parts each copied in turn, an aggregate's through its own Copy helper (so
# a type that comes round to itself through an array is one function); top: in that helper, its own parts
fn (ln mut lowering&) copyAt(a pl, ty types.TypeId, at mir.ScopeRef, sp source.Span, top Bool = false, own Bool = false) mir.Operand {
    t := ln.T
    if not ln.ownsStorage(ty) { return ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp) }
    if t.DeclaresCopy(ty) and not own { return ln.declaredCopy(a, ty, at, sp) }
    r := t.Repr(ty)
    if t.KindOf(r) == types.Kind.Array and t.Length(r) == types.TypeId(0) {
        if not t.OwnsParts(ty) { return ln.arrayCopy(mir.Operand.Copy(ln.mk(a)), ty, sp, at) }
        if not top {
            return ln.helperCall(mir.HelperKind.Copy, ty, Array<mir.Operand>[ln.refTo(a, ty, sp)], Array<mir.ScopeRef>[at], ty, sp)
        }
        el := t.Elem(r)
        n := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(ln.mk(a))], sp)
        buf := ln.temp(ty, sp)
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(buf), mir.Rvalue.NewArray(at, ty, n, mir.Operand.None)))
        ln.eachIndex(n, sp, fn(i mir.LocalId) {
            e := ln.copyAt(ln.with(a, mir.Proj.Index(i)), el, at, sp)
            ln.emit(mir.Stmt.Assign(sp, ln.mk(ln.with(pl(mir.Base.Local(buf)), mir.Proj.Index(i))), mir.Rvalue.Use(e)))
        })
        return mir.Operand.Copy(mir.Lvalue.L(buf))
    }
    if not top { return ln.helperCall(mir.HelperKind.Copy, ty, Array<mir.Operand>[ln.refTo(a, ty, sp)], Array<mir.ScopeRef>[at], ty, sp) }
    # its bytes, then each owning part copied over the part it shares
    d := ln.local(ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp), ty, sp)
    dp := pl(mir.Base.Local(d))
    if mir.HasFields(ln.T, ty) {
        parts := ln.partsOf(ty)
        for i in range parts.Len() { ln.copyPart(ln.with(dp, mir.Proj.Field(i)), parts[i], at, sp) }
    } else if mir.HasCases(ln.T, ty) {
        tag := ln.into(mir.I64T, mir.Rvalue.Tag(ln.mk(dp)), sp)
        ln.payloads(ln.casesOf(ty), tag, sp, fn(c I64, rec types.TypeId) {
            fs := ln.items(ln.T.Parts(rec))
            for i in range fs.Len() { ln.copyPart(ln.with(ln.with(dp, mir.Proj.Payload(c)), mir.Proj.Field(i)), fs[i], at, sp) }
        })
    } else if t.KindOf(r) == types.Kind.Array {
        el := t.Elem(r)
        ln.eachIndex(ln.constI64(t.ConstValue(t.Length(r))), sp, fn(i mir.LocalId) { ln.copyPart(ln.with(dp, mir.Proj.Index(i)), el, at, sp) })
    } else {
        ln.gap(sp, "a Copy helper for a type with no parts")
    }
    return mir.Operand.Copy(mir.Lvalue.L(d))
}

# E31d: the copy of what place a holds, of a type declaring its own Copy, made in scope at - its Copy called on it, the
# new value built where the copy goes (Copy only builds, so nothing else it reaches needs a scope: the program's). A
# buffer's room (a Vec's past its count, a Map's empty slots) is held as zeros, never an element (M19d): a value whose
# never-null reference is null there is room, copied as its bytes - Copy is never run on what is no value
fn (ln mut lowering&) declaredCopy(a pl, ty types.TypeId, at mir.ScopeRef, sp source.Span) mir.Operand {
    t := ln.T
    id := ln.copyBody(ty)
    if id < 0 {
        ln.gap(sp, "a declared Copy whose body check did not make (E31d)")
        return ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp)
    }
    callee, fty := ln.bodyCallee(typed.BodyId(I32(id)))
    dest := ln.temp(ty, sp)
    path := ln.neverNullPath(ty, 0)
    after := mir.NoBlock
    if path.Len() > 0 {
        q := a
        for k in path { q = ln.with(q, mir.Proj.Field(k)) }
        rt := ln.fieldAt(ty, path)
        ref := ln.into(rt, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(q))), sp)
        live := ln.prim(typed.PrimOp.Ne, types.BoolT, Array<mir.Operand>[ref, mir.Operand.Const(rt, 0)], sp)
        some, room := ln.F.NewBlock(), ln.F.NewBlock()
        after = ln.F.NewBlock()
        ln.end(mir.Term.Branch(live, some, room))
        ln.start(room)
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(dest), mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a)))))
        ln.goto(after)
        ln.start(some)
    }
    p0 := t.Items(t.Params(fty))[0]
    recv := ln.into(p0, mir.Rvalue.Ref(ln.mk(a), p0), sp)
    vs := t.ScopeVarsOf(fty)
    xs := Array<mir.ScopeRef>(vs.Len())
    for i in range vs.Len() { xs[i] = at if vs[i] == types.ResultVar else mir.ScopeRef.Program }
    ok := ln.F.NewBlock()
    k := ln.F.AddCall(mir.Call(callee, ln.F.Args(Array<mir.Operand>[recv]), ln.F.ScopeRefs(xs), mir.Lvalue.L(dest), true, ok, mir.NoLocal
                               mir.NoBlock))
    ln.end(mir.Term.Call(sp, k))
    ln.start(ok)
    if after != mir.NoBlock {
        ln.goto(after)
        ln.start(after)
    }
    return mir.Operand.Copy(mir.Lvalue.L(dest))
}

# the body of the Copy a type declares (E31d), -1 for none
fn (ln mut lowering&) copyBody(ty types.TypeId) I64 {
    got := try ln.L.copyOf.Get(ty) catch default -2
    if got != -2 { return got }
    id := ln.methodBody(ty, "Copy", "Copy")
    ln.L.copyOf.Put(ty, id)
    return id
}

# the fields leading, by value, to a reference that is never null (T2c) in a struct of type ty - none where there is
# no such reference
fn (ln mut lowering&) neverNullPath(ty types.TypeId, depth I64) Array<I64> {
    t := ln.T
    if depth > 8 or not mir.HasFields(t, ty) { return Array<I64>(0) }
    parts := ln.partsOf(ty)
    for i in range parts.Len() {
        f := parts[i]
        if t.IsRef(f) and not t.IsNullable(f) and ln.arrayOf(t.Referent(f)) == types.UnknownT { return Array<I64>[i] }
        if t.IsRef(f) or t.KindOf(t.Repr(f)) == types.Kind.Func { continue }
        rest := ln.neverNullPath(f, depth + 1)
        if rest.Len() == 0 { continue }
        out := Array<I64>(rest.Len() + 1)
        out[0] = i
        for j in range rest.Len() { out[j + 1] = rest[j] }
        return out
    }
    return Array<I64>(0)
}

# the type of the field a path of field positions leads to from type ty
fn (ln mut lowering&) fieldAt(ty types.TypeId, path Array<I64>&) types.TypeId {
    cur := ty
    for k in path { cur = ln.partsOf(cur)[k] }
    return cur
}

# v, an array of references to arrays (of type from, or a reference to one), as an array of those arrays' values of
# type ty made in scope at: each element's referent copied there (check's refsAsValues, E12 at the element)
fn (ln mut lowering&) derefCopy(v mir.Operand, from types.TypeId, ty types.TypeId, at mir.ScopeRef, sp source.Span) mir.Operand {
    t := ln.T
    src := ln.local(v, from, sp)
    sp0 := pl(mir.Base.Local(src))
    if t.IsRef(t.Repr(from)) { sp0 = ln.with(sp0, mir.Proj.Deref) }
    el := t.Elem(ln.arrayOf(ty))
    n := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(ln.mk(sp0))], sp)
    buf := ln.temp(ty, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(buf), mir.Rvalue.NewArray(at, ty, n, mir.Operand.None)))
    ln.eachIndex(n, sp, fn(i mir.LocalId) {
        e := ln.copyAt(ln.with(ln.with(sp0, mir.Proj.Index(i)), mir.Proj.Deref), el, at, sp)
        ln.emit(mir.Stmt.Assign(sp, ln.mk(ln.with(pl(mir.Base.Local(buf)), mir.Proj.Index(i))), mir.Rvalue.Use(e)))
    })
    return mir.Operand.Copy(mir.Lvalue.L(buf))
}

# a part of a copy being made, of type ty, its own copy where it owns storage - over the bytes it shares with the original
fn (ln mut lowering&) copyPart(p pl, ty types.TypeId, at mir.ScopeRef, sp source.Span) {
    if not ln.ownsStorage(ty) { return }
    v := ln.copyAt(p, ty, at, sp)
    ln.emit(mir.Stmt.Assign(sp, ln.mk(p), mir.Rvalue.Use(v)))
}

# what reference parameter l names, as a place
fn (ln mut lowering&) at(l mir.LocalId) pl { return ln.with(pl(mir.Base.Local(l)), mir.Proj.Deref) }

# a reference to a place, of type "T&" read-only, for a helper's parameter
fn (ln mut lowering&) refTo(p pl, ty types.TypeId, sp source.Span) mir.Operand {
    rt := ln.T.Ref(ty, types.ReadOnly)
    return ln.into(rt, mir.Rvalue.Ref(ln.mk(p), rt), sp)
}

# a helper of kind for type ty called with args (and its kind's scopes), its result, if any, into a temporary of res
fn (ln mut lowering&) helperCall(kind mir.HelperKind, ty types.TypeId, args Array<mir.Operand>&, scopes Array<mir.ScopeRef>&
                                 res types.TypeId, sp source.Span) mir.Operand {
    ty = ln.L.helperTy(kind, ty)
    hty := mir.HelperType(ln.T, kind, ty)
    k := mir.FnKey.Helper(kind, ty)
    ln.L.Want(k)
    ok := ln.F.NewBlock()
    dest := mir.NoLocal
    if res != types.VoidT { dest = ln.temp(res, sp) }
    c := ln.F.AddCall(mir.Call(mir.Callee.Fn(k, hty), ln.F.Args(args), ln.F.ScopeRefs(scopes)
                               mir.Lvalue.L(dest) if dest != mir.NoLocal else mir.NoPlace, dest != mir.NoLocal, ok, mir.NoLocal
                               mir.NoBlock))
    ln.end(mir.Term.Call(sp, c))
    ln.start(ok)
    return mir.Operand.None if dest == mir.NoLocal else mir.Operand.Copy(mir.Lvalue.L(dest))
}

# a struct's, a tuple's or a record's fields; none for anything else
fn (ln mut lowering&) partsOf(ty types.TypeId) Array<types.TypeId> { return ln.items(mir.FieldsOf(ln.T, ty)) }

fn (ln mut lowering&) items(l types.ListId) Array<types.TypeId> {
    xs := ln.T.Items(l)
    out := Array<types.TypeId>(xs.Len())
    for i in range xs.Len() { out[i] = xs[i] }
    return out
}

# an enum's cases' payloads (a record, or 0 for none); none for anything else
fn (ln mut lowering&) casesOf(ty types.TypeId) Array<types.TypeId> { return ln.items(mir.CasesOf(ln.T, ty)) }

# whether a value of the type is compared, hashed and rendered as itself: a number, a Bool, a Char
fn (ln mut lowering&) scalar(ty types.TypeId) Bool {
    r := ln.T.Repr(ty)
    return r == types.BoolT or ln.T.IsNumber(r)
}

# a Bool slot set true, then false along the way where a test fails; its value at the end
fn (ln mut lowering&) flag(v Bool, sp source.Span) mir.LocalId {
    f := ln.temp(types.BoolT, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(f), mir.Rvalue.Use(ln.constBool(v, sp))))
    return f
}

# "==" part by part (E10): numbers, Bools and Chars by their own "==", references to arrays by their contents and every
# other reference or function value by identity, a null equal only to a null; a struct's, tuple's or record's fields in
# order, an enum's case then its payload, an array's length then its elements - an aggregate part through its own
# Equal helper, so a type that comes round to itself is one function
fn (ln mut lowering&) equalAt(a pl, b pl, ty types.TypeId, sp source.Span, top Bool = false) mir.Operand {
    a, b = ln.solid(a, ty, sp), ln.solid(b, ty, sp)
    t := ln.T
    r := t.Repr(ty)
    if ln.scalar(ty) {
        x := ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp)
        y := ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(b))), sp)
        return ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[x, y], sp)
    }
    if t.KindOf(r) == types.Kind.Func or (t.IsRef(r) and ln.arrayOf(t.Referent(r)) == types.UnknownT) {
        x := ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp)
        y := ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(b))), sp)
        return ln.prim(typed.PrimOp.Same, types.BoolT, Array<mir.Operand>[x, y], sp)
    }
    if t.IsRef(r) {
        # a reference to an array: the arrays equal - an array is never null (T2c), its zero value the empty array, so a
        # zero reference and one to an empty array made elsewhere are equal, which their lengths say before anything is
        # read (a null test first had made an empty Vec unequal to its copy)
        x := ln.local(mir.Operand.Copy(ln.mk(a)), ty, sp)
        y := ln.local(mir.Operand.Copy(ln.mk(b)), ty, sp)
        return ln.equalAt(ln.at(x), ln.at(y), t.Referent(r), sp)
    }
    if not top {
        return ln.helperCall(mir.HelperKind.Equal, ty, Array<mir.Operand>[ln.refTo(a, ty, sp), ln.refTo(b, ty, sp)], Array<mir.ScopeRef>[]
                             types.BoolT, sp)
    }
    res := ln.flag(true, sp)
    no := ln.F.NewBlock()
    ends Vec<mir.BlockId>
    parts, isParts := ln.partsOf(ty), mir.HasFields(ln.T, ty)
    cases, isEnum := ln.casesOf(ty), mir.HasCases(ln.T, ty)
    if isParts {
        for i in range parts.Len() {
            e := ln.equalAt(ln.packedField(a, ty, i), ln.packedField(b, ty, i), parts[i], sp)
            next := ln.F.NewBlock()
            ln.end(mir.Term.Branch(e, next, no))
            ln.start(next)
        }
    } else if isEnum {
        ta := ln.into(mir.I64T, mir.Rvalue.Tag(ln.mk(a)), sp)
        tb := ln.into(mir.I64T, mir.Rvalue.Tag(ln.mk(b)), sp)
        same := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[ta, tb], sp)
        next := ln.F.NewBlock()
        ln.end(mir.Term.Branch(same, next, no))
        ln.start(next)
        ln.payloads(cases, ta, sp, fn(tag I64, rec types.TypeId) {
            fs := ln.items(ln.T.Parts(rec))
            for i in range fs.Len() {
                pa := ln.with(ln.with(a, mir.Proj.Payload(tag)), mir.Proj.Field(i))
                pb := ln.with(ln.with(b, mir.Proj.Payload(tag)), mir.Proj.Field(i))
                e := ln.equalAt(pa, pb, fs[i], sp)
                go := ln.F.NewBlock()
                ln.end(mir.Term.Branch(e, go, no))
                ln.start(go)
            }
        })
    } else if ln.arrayOf(ty) != types.UnknownT {
        el := t.Elem(ln.arrayOf(ty))
        na := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(ln.mk(a))], sp)
        nb := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(ln.mk(b))], sp)
        same := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[na, nb], sp)
        next := ln.F.NewBlock()
        ln.end(mir.Term.Branch(same, next, no))
        ln.start(next)
        ln.eachIndex(na, sp, fn(i mir.LocalId) {
            e := ln.equalAt(ln.with(a, mir.Proj.Index(i)), ln.with(b, mir.Proj.Index(i)), el, sp)
            go := ln.F.NewBlock()
            ln.end(mir.Term.Branch(e, go, no))
            ln.start(go)
        })
    } else {
        ln.gap(sp, "an Equal helper for a type with no parts")
    }
    ln.leaveOpen(ends)
    ln.start(no)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(res), mir.Rvalue.Use(ln.constBool(false, sp))))
    ln.leaveOpen(ends)
    ln.patch(ends)
    return mir.Operand.Copy(mir.Lvalue.L(res))
}

# for each case of an enum with a payload: the code each gives, run where the tag tag (an I64) is that case's
fn (ln mut lowering&) payloads(cases Array<types.TypeId>&, tag mir.Operand, sp source.Span, each fn&(tag I64, rec types.TypeId)) {
    with Vec<I64>
    for i in range cases.Len() {
        if cases[i] != types.TypeId(0) and ln.T.Items(ln.T.Parts(cases[i])).Len() > 0 { with.Push(i) }
    }
    if with.Len() == 0 { return }
    after := ln.F.NewBlock()
    cs := Array<mir.Case>(with.Len())
    bs := Array<mir.BlockId>(with.Len())
    for k in range with.Len() {
        bs[k] = ln.F.NewBlock()
        cs[k] = mir.Case(with[k], bs[k])
    }
    ln.end(mir.Term.Switch(tag, ln.F.AddCases(cs), after))
    for k in range with.Len() {
        ln.start(bs[k])
        each(with[k], cases[with[k]])
        ln.goto(after)
    }
    ln.start(after)
}

# a counted loop, i from 0 below n: the code each gives run for each i
fn (ln mut lowering&) eachIndex(n mir.Operand, sp source.Span, each fn&(i mir.LocalId)) {
    i := ln.temp(mir.I64T, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(i), mir.Rvalue.Use(ln.constI64(0))))
    head, body, after := ln.F.NewBlock(), ln.F.NewBlock(), ln.F.NewBlock()
    ln.goto(head)
    ln.start(head)
    more := ln.prim(typed.PrimOp.Lt, types.BoolT, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(i)), n], sp)
    ln.end(mir.Term.Branch(more, body, after))
    ln.start(body)
    each(i)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(i), mir.Rvalue.Prim(typed.PrimOp.Add, mir.I64T
                                                         ln.F.Args(Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(i)), ln.constI64(1)]))))
    ln.goto(head)
    ln.start(after)
}

# the prelude's mixHash of an I64 (std/prelude/hash.olang): a multiply by the golden-ratio constant, the high bits
# folded into the low ones
fn (ln mut lowering&) mix(x mir.Operand, sp source.Span) mir.Operand {
    h := ln.prim(typed.PrimOp.Mul, mir.I64T, Array<mir.Operand>[x, ln.constI64(-7046029254386353131)], sp)
    return ln.prim(typed.PrimOp.BitXor, mir.I64T, Array<mir.Operand>[h, ln.prim(typed.PrimOp.Shr, mir.I64T, Array<mir.Operand>[h, ln.constI64(29)], sp)], sp)
}

# h, then one more part's hash combined in, as the prelude's HashElements combines an array's
fn (ln mut lowering&) combine(h mir.LocalId, x mir.Operand, sp source.Span) {
    m := ln.prim(typed.PrimOp.Mul, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(h)), ln.constI64(1099511628211)], sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(h), mir.Rvalue.Prim(typed.PrimOp.Add, mir.I64T, ln.F.Args(Array<mir.Operand>[m, x]))))
}

# the supplied Hash (E10b): an integer, Bool or Char by the prelude's mixHash, a reference to an array by its
# elements' (a null 0); a struct's, tuple's or record's fields combined in order, an enum's case then its payload's, an
# array's elements - an aggregate part through its own Hash helper
fn (ln mut lowering&) hashAt(a pl, ty types.TypeId, sp source.Span, top Bool = false) mir.Operand {
    a = ln.solid(a, ty, sp)
    t := ln.T
    r := t.Repr(ty)
    # a part whose type declares Hash (or, in its own module, hash: M6b) hashes by it (E10b)
    hb := -1 if top else ln.methodBody(ty, "Hash", "hash")
    if hb >= 0 {
        callee, fty := ln.bodyCallee(typed.BodyId(I32(hb)))
        p0 := t.Items(t.Params(fty))[0]
        recv := ln.into(p0, mir.Rvalue.Ref(ln.mk(a), p0), sp) if t.IsRef(p0) else ln.into(p0, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp)
        ok := ln.F.NewBlock()
        dest := ln.temp(mir.I64T, sp)
        k := ln.F.AddCall(mir.Call(callee, ln.F.Args(Array<mir.Operand>[recv]), ln.passed(mir.PassedCount(t, callee, fty)), mir.Lvalue.L(dest)
                                   true, ok, mir.NoLocal, mir.NoBlock))
        ln.end(mir.Term.Call(sp, k))
        ln.start(ok)
        return mir.Operand.Copy(mir.Lvalue.L(dest))
    }
    if t.KindOf(ty) == types.Kind.ErrVal { return ln.hashErr(ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp), ty, sp) }
    if ln.scalar(ty) {
        x := ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp)
        if t.IsInt(r) and t.Bits(r) > 64 {
            # T4a: an integer wider than a word - its low word mixed with its high one's hash
            hi := ln.prim(typed.PrimOp.Shr, ty, Array<mir.Operand>[x, ln.constI64(64)], sp)
            lo := ln.asI64(x, ty, sp)
            return ln.mix(ln.prim(typed.PrimOp.BitXor, mir.I64T, Array<mir.Operand>[lo, ln.mix(ln.asI64(hi, ty, sp), sp)], sp), sp)
        }
        return ln.mix(ln.asI64(x, ty, sp), sp)
    }
    if t.IsRef(r) and ln.arrayOf(t.Referent(r)) != types.UnknownT {
        # a reference to an array hashes the array: never null (T2c), so hashing follows equality (equalAt)
        x := ln.local(mir.Operand.Copy(ln.mk(a)), ty, sp)
        return ln.hashAt(ln.at(x), t.Referent(r), sp)
    }
    if t.IsRef(r) {
        x := ln.local(mir.Operand.Copy(ln.mk(a)), ty, sp)
        res := ln.temp(mir.I64T, sp)
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(res), mir.Rvalue.Use(ln.constI64(0))))
        nn := ln.prim(typed.PrimOp.Ne, types.BoolT, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(x)), mir.Operand.Const(ty, 0)], sp)
        some, after := ln.F.NewBlock(), ln.F.NewBlock()
        ln.end(mir.Term.Branch(nn, some, after))
        ln.start(some)
        h := ln.hashAt(ln.at(x), t.Referent(r), sp)
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(res), mir.Rvalue.Use(h)))
        ln.goto(after)
        ln.start(after)
        return mir.Operand.Copy(mir.Lvalue.L(res))
    }
    if not top { return ln.helperCall(mir.HelperKind.Hash, ty, Array<mir.Operand>[ln.refTo(a, ty, sp)], Array<mir.ScopeRef>[], mir.I64T, sp) }
    h := ln.temp(mir.I64T, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(h), mir.Rvalue.Use(ln.constI64(0))))
    parts, isParts := ln.partsOf(ty), mir.HasFields(ln.T, ty)
    cases, isEnum := ln.casesOf(ty), mir.HasCases(ln.T, ty)
    if isParts {
        for i in range parts.Len() { ln.combine(h, ln.hashAt(ln.packedField(a, ty, i), parts[i], sp), sp) }
    } else if isEnum {
        tag := ln.into(mir.I64T, mir.Rvalue.Tag(ln.mk(a)), sp)
        ln.combine(h, ln.mix(tag, sp), sp)
        ln.payloads(cases, tag, sp, fn(k I64, rec types.TypeId) {
            fs := ln.items(ln.T.Parts(rec))
            for i in range fs.Len() {
                ln.combine(h, ln.hashAt(ln.with(ln.with(a, mir.Proj.Payload(k)), mir.Proj.Field(i)), fs[i], sp), sp)
            }
        })
    } else if ln.arrayOf(ty) != types.UnknownT {
        el := t.Elem(ln.arrayOf(ty))
        n := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(ln.mk(a))], sp)
        ln.eachIndex(n, sp, fn(i mir.LocalId) { ln.combine(h, ln.hashAt(ln.with(a, mir.Proj.Index(i)), el, sp), sp) })
    } else {
        ln.gap(sp, "a Hash helper for a type with no parts")
    }
    return mir.Operand.Copy(mir.Lvalue.L(h))
}

# T20, E10b: an error value's hash by the error it holds - its type's identity and its word - never by its code, which
# numbers the error in its own set: so values equal across sets ("PErr.Bad" as a PErr and as a LoadError) hash alike.
# null hashes as the number 0 does
fn (ln mut lowering&) hashErr(v mir.Operand, ty types.TypeId, sp source.Span) mir.Operand {
    t := ln.T
    p := ln.L.P
    l := ln.local(v, ty, sp)
    x := ln.asI64(ln.into(mir.I32T, mir.Rvalue.Use(ln.errCodeOf(l, ty)), sp), mir.I32T, sp)
    hi := ln.prim(typed.PrimOp.Shr, mir.I64T, Array<mir.Operand>[x, ln.constI64(16)], sp)
    w := ln.prim(typed.PrimOp.BitAnd, mir.I64T, Array<mir.Operand>[x, ln.constI64(65535)], sp)
    res := ln.temp(mir.I64T, sp)
    ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(res), mir.Rvalue.Use(ln.mix(ln.constI64(0), sp))))
    after := ln.F.NewBlock()
    es := t.Items(t.ErrValItems(ty))
    for j in range es.Len() {
        d := t.DeclOf(t.ErrOf(es[j]))
        key := stableKey($p.L.Mods[t.DeclModule(d)].Identity "." $t.Names.Text(t.DeclName(d)))
        hit := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[hi, ln.constI64(j + 1)], sp)
        yes, no := ln.F.NewBlock(), ln.F.NewBlock()
        ln.end(mir.Term.Branch(hit, yes, no))
        ln.start(yes)
        h := ln.mix(ln.prim(typed.PrimOp.BitXor, mir.I64T, Array<mir.Operand>[ln.constI64(key), w], sp), sp)
        ln.emit(mir.Stmt.Assign(sp, mir.Lvalue.L(res), mir.Rvalue.Use(h)))
        # T19b: and what its payload holds - hashing follows equality (E10b)
        pt := p.PayloadOf(t.ErrOf(es[j]))
        if pt != types.UnknownT {
            part := ln.with(pl(mir.Base.Local(l)), mir.Proj.Field(p.PayloadField(ty, j)))
            ln.combine(res, ln.hashAt(part, pt, sp), sp)
        }
        ln.goto(after)
        ln.start(no)
    }
    ln.goto(after)
    ln.start(after)
    return mir.Operand.Copy(mir.Lvalue.L(res))
}

# a text's FNV-1a hash, the same in every compilation: an error type's identity
fn stableKey(text String&) I64 {
    h U64 = 14695981039346656037
    for c in text { h = (h ^ U64(c)) * 1099511628211 }
    return I64(h)
}

# a type's zero value (D13c): a constructor with no parameters called, else all zero bits - which of these, or the
# constructor on its parameters' defaults, is eval's to decide once per type (Key.Zero, M8)
fn (ln mut lowering&) zeroOf(ty types.TypeId, sp source.Span, inResult Bool = false) mir.Operand {
    lw := ln.L
    lw.index()
    id := try lw.ctorOf.Get(ty) catch default -1
    t := ln.T
    if id >= 0 and t.Items(t.Params(lw.Bodies[id].Ty)).Len() == 0 {
        callee, fty := ln.bodyCallee(typed.BodyId(I32(id)))
        ok := ln.F.NewBlock()
        dest := ln.temp(ty, sp)
        errs := t.Errors(fty)
        if t.Items(errs).Len() > 0 {
            ln.gap(sp, "a zero value whose constructor can fail")
            return mir.Operand.None
        }
        # built where the helper's result lands - its own scope variable (D13c, the caller's plan), else the program's
        n := mir.PassedCount(t, callee, fty)
        xs := Array<mir.ScopeRef>(n)
        for i in range n { xs[i] = mir.ScopeRef.Var(0) if inResult else mir.ScopeRef.Program }
        k := ln.F.AddCall(mir.Call(callee, mir.Empty, ln.F.ScopeRefs(xs), mir.Lvalue.L(dest), true, ok, mir.NoLocal
                                   mir.NoBlock))
        ln.end(mir.Term.Call(sp, k))
        ln.start(ok)
        return mir.Operand.Copy(mir.Lvalue.L(dest))
    }
    return mir.Operand.Const(ty, 0)
}

# an instance's Call as a function value (E31): its environment the instance, its code calling Call on it with the
# value's own arguments, its result and its errors Call's
# the scopes an adapter passes its Call: for the receiver's, the scope its instance lives in (the capture's, O4b, D16c)
# - which the runtime gives this thread's part of where it is called elsewhere (P2) - for another parameter's, the
# adapter's own for that parameter, for the result's the adapter's result scope
fn (ln mut lowering&) adapterPassed(cty types.TypeId, recv types.TypeId) mir.Range {
    t := ln.T
    cvs := t.ScopeVarsOf(cty)
    avs := t.ScopeVarsOf(ln.F.Ty)
    xs := Array<mir.ScopeRef>(cvs.Len())
    for i in range cvs.Len() {
        xs[i] = mir.ScopeRef.Program
        v := cvs[i]
        if v == 0 and t.HoldsRefs(recv) {
            xs[i] = mir.ScopeRef.Var(avs.Len())
            continue
        }
        want := v - 1 if v > 0 else v
        for j in range avs.Len() {
            if avs[j] == want { xs[i] = mir.ScopeRef.Var(j) }
        }
    }
    return ln.F.ScopeRefs(xs)
}

fn (lw mut Lowerer&) adapterFn(call typed.BodyId) mir.Fn {
    cty := lw.Bodies[I64(call)].Ty
    ps := lw.P.T.Items(lw.P.T.Params(cty))
    rest := Array<types.TypeId>(ps.Len() - 1)
    for i in range rest.Len() { rest[i] = ps[i + 1] }
    ty := lw.P.T.Func(lw.P.T.List(rest), lw.P.T.Result(cty), lw.P.T.Errors(cty))
    b := standIn(ty)
    ln := lowering(lw, b, lw.P.T, lw.bare(mir.FnKey.Adapter(call), ty))
    ln.adapterBody(call, cty, ps[0])
    lw.Gapped = ln.gapped
    return ln.F
}

fn (ln mut lowering&) adapterBody(call typed.BodyId, cty types.TypeId, recv types.TypeId) {
    t := ln.T
    sp := ln.B.Sp
    for p in t.Items(t.Params(ln.F.Ty)) { ln.F.AddParam(source.NameId(0), sp, p) }
    inst := ln.F.AddLocal(mir.Local(source.NameId(0), sp, recv, mir.LocalKind.Capture, mir.ScopeRef.Frame))
    ln.F.Captures.Push(inst)
    for v in t.ScopeVarsOf(ln.F.Ty) { ln.F.Vars.Push(mir.VarKind.Result if v < 0 else mir.VarKind.Param(v)) }
    if t.HoldsRefs(recv) { ln.F.Vars.Push(mir.VarKind.Capture(0)) }
    ln.F.NewBlock()
    frame := ln.F.AddScope(mir.ScopeKind.Frame, mir.NoScope, typed.BlockId(-1), sp)
    ln.emit(mir.Stmt.Open(sp, frame))
    ln.levels.Push(level(frame, typed.BlockId(-1), mir.ScopeKind.Frame))
    args := Array<mir.Operand>(ln.F.Params.Len() + 1)
    args[0] = mir.Operand.Copy(mir.Lvalue.L(inst))
    for i in range ln.F.Params.Len() { args[i + 1] = mir.Operand.Copy(mir.Lvalue.L(ln.F.Params[i])) }
    res := t.Result(cty)
    ok := ln.F.NewBlock()
    dest := mir.NoLocal
    if res != types.VoidT and res != types.NoreturnT { dest = ln.temp(res, sp) }
    code := mir.NoLocal
    eb := mir.NoBlock
    if t.Items(t.Errors(cty)).Len() > 0 {
        code = ln.temp(mir.I32T, sp)
        eb = ln.F.NewBlock()
    }
    callee := mir.Callee.Fn(mir.FnKey.Body(call), cty)
    k := ln.F.AddCall(mir.Call(callee, ln.F.Args(args), ln.adapterPassed(cty, recv)
                               mir.Lvalue.L(dest) if dest != mir.NoLocal else mir.NoPlace, dest != mir.NoLocal, ok, code, eb))
    ln.end(mir.Term.Call(sp, k))
    if eb != mir.NoBlock {
        ln.start(eb)
        ln.leave(0)
        ln.end(mir.Term.Raise(sp, mir.Operand.Copy(mir.Lvalue.L(code))))
    }
    ln.start(ok)
    if res == types.NoreturnT {
        ln.end(mir.Term.Exit(sp, mir.ExitKind.Unreachable, mir.Operand.None))
        return
    }
    ln.epilogue(mir.Operand.None if dest == mir.NoLocal else ln.viewCopied(call, mir.Operand.Copy(mir.Lvalue.L(dest)), res, sp))
}

# D9h: what a call of body made in a function lowering makes for a caller that cannot know what it returns
# (a function value's, an "any"'s slot) - copied into the function's result scope where the body hands back views
fn (ln mut lowering&) viewCopied(body typed.BodyId, v mir.Operand, res types.TypeId, sp source.Span) mir.Operand {
    if ln.L.ViewsOf(body) <= 0 or not ln.valueArray(res): return v
    at := mir.ScopeRef.Program
    for k in range ln.F.Vars.Len() {
        if ln.F.Vars[k] == mir.VarKind.Result: at = mir.ScopeRef.Var(k)
    }
    return ln.arrayCopy(v, res, sp, at)
}

# the code a function value or an "any"'s slot of body calls: the body, or its copying wrapper where it hands back
# views of what it is given (mir.FnKey.Copied)
fn (lw mut Lowerer&) CodeOf(body typed.BodyId) mir.FnKey {
    return mir.FnKey.Copied(body) if lw.ViewsOf(body) > 0 else mir.FnKey.Body(body)
}

# a function handing back views, called as a function value or through an "any" (mir.FnKey.Copied): its parameters
# passed on, its scopes its own, its result copied into its result scope
fn (lw mut Lowerer&) copiedFn(body typed.BodyId) mir.Fn {
    ty := lw.Bodies[I64(body)].Ty
    b := standIn(ty)
    ln := lowering(lw, b, lw.P.T, lw.bare(mir.FnKey.Copied(body), ty))
    ln.copiedBody(body, ty)
    lw.Gapped = ln.gapped
    return ln.F
}

fn (ln mut lowering&) copiedBody(body typed.BodyId, ty types.TypeId) {
    t := ln.T
    sp := ln.B.Sp
    for p in t.Items(t.Params(ty)) { ln.F.AddParam(source.NameId(0), sp, p) }
    vs := t.ScopeVarsOf(ty)
    for v in vs { ln.F.Vars.Push(mir.VarKind.Result if v < 0 else mir.VarKind.Param(v)) }
    ln.F.NewBlock()
    frame := ln.F.AddScope(mir.ScopeKind.Frame, mir.NoScope, typed.BlockId(-1), sp)
    ln.emit(mir.Stmt.Open(sp, frame))
    ln.levels.Push(level(frame, typed.BlockId(-1), mir.ScopeKind.Frame))
    args := Array<mir.Operand>(ln.F.Params.Len())
    for i in range ln.F.Params.Len() { args[i] = mir.Operand.Copy(mir.Lvalue.L(ln.F.Params[i])) }
    passed := Array<mir.ScopeRef>(vs.Len())
    for k in range vs.Len() { passed[k] = mir.ScopeRef.Var(k) }
    res := t.Result(ty)
    ok := ln.F.NewBlock()
    dest := ln.temp(res, sp)
    code := mir.NoLocal
    eb := mir.NoBlock
    if t.Items(t.Errors(ty)).Len() > 0 {
        code = ln.temp(mir.I32T, sp)
        eb = ln.F.NewBlock()
    }
    k := ln.F.AddCall(mir.Call(mir.Callee.Fn(mir.FnKey.Body(body), ty), ln.F.Args(args), ln.F.ScopeRefs(passed), mir.Lvalue.L(dest)
                               true, ok, code, eb))
    ln.end(mir.Term.Call(sp, k))
    if eb != mir.NoBlock {
        ln.start(eb)
        ln.leave(0)
        ln.end(mir.Term.Raise(sp, mir.Operand.Copy(mir.Lvalue.L(code))))
    }
    ln.start(ok)
    ln.epilogue(ln.viewCopied(body, mir.Operand.Copy(mir.Lvalue.L(dest)), res, sp))
}

# a module's initialization (B5a): each of its globals' initializers run, each after the globals it reads - check's
# order (P.InitOrder), a summary of their reads computed once every body is checked (DESIGN.md 1.6)
fn (lw mut Lowerer&) initFn(m I64) mir.Fn {
    ty := lw.P.T.Func(types.ListId(0), types.VoidT, types.ListId(0))
    b := standIn(ty)
    ln := lowering(lw, b, lw.P.T, lw.bare(mir.FnKey.Init(m), ty))
    ln.prologue(Array<mir.VarKind>[])
    for i in lw.P.InitOrder {
        match lw.Bodies[i].Of {
            case typed.BodyOf.Global(gm, _) {
                if gm == m and lw.Bodies[i].Root is not null {
                    ok := ln.F.NewBlock()
                    callee := mir.Callee.Fn(mir.FnKey.Body(typed.BodyId(I32(i))), lw.Bodies[i].Ty)
                    k := ln.F.AddCall(mir.Call(callee, mir.Empty, mir.Empty, mir.NoPlace, false, ok, mir.NoLocal, mir.NoBlock))
                    ln.end(mir.Term.Call(lw.Bodies[i].Sp, k))
                    ln.start(ok)
                }
            }
            case _ { }
        }
    }
    ln.epilogue(mir.Operand.None)
    lw.Gapped = ln.gapped
    return ln.F
}

# "$x" of a value of the type, at the top of its rendering, written into builder b (E11a): a type declaring Str by what
# Str returns; a struct as its name and its fields, an enum as its type and case and its payload, an array as its
# element type and its items, several results as a tuple, a reference as null or what it names, a function value as
# its signature - each part as it renders inside another value (inner)
# the payload of case k (its record type c) of the enum at a, rendered after the case's name: its fields in parentheses,
# nothing where it has none
fn (ln mut lowering&) renderPayload(a pl, k I64, c types.TypeId, b mir.ScopeRef, sp source.Span) {
    fs := ln.items(ln.T.Parts(c))
    if fs.Len() == 0 { return }
    ln.word(b, "(", sp)
    for i in range fs.Len() {
        if i > 0 { ln.word(b, ", ", sp) }
        ln.inner(ln.with(ln.with(a, mir.Proj.Payload(k)), mir.Proj.Field(i)), fs[i], b, sp)
    }
    ln.word(b, ")", sp)
}

fn (ln mut lowering&) renderAt(a pl, ty types.TypeId, b mir.ScopeRef, sp source.Span, top Bool = false) {
    t := ln.T
    if t.IsAny(t.Repr(ty)) {
        ln.renderAny(b, mir.Operand.Copy(ln.mk(a)), ty, top, sp)
        return
    }
    if ln.renderStr(a, ty, b, sp) { return }
    if t.KindOf(ty) == types.Kind.ErrVal {
        ln.renderErr(b, mir.Operand.Copy(ln.mk(a)), ty, sp)
        return
    }
    r := t.Repr(ty)
    if t.IsRef(r) {
        x := ln.local(mir.Operand.Copy(ln.mk(a)), ty, sp)
        some, after := ln.F.NewBlock(), ln.F.NewBlock()
        if t.ArrayRef(r) and not t.IsNullable(r) {
            # T2c: an array written "&" is never null - its zero bits are the empty array, rendered as one
            ln.goto(some)
        } else if t.ArrayRef(r) {
            # T2c: an array that may be null is null where its length is -1 (its zero bits are the empty array)
            isNull := ln.prim(typed.PrimOp.Same, types.BoolT, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(x)), mir.Operand.Const(ty, -1)], sp)
            none := ln.F.NewBlock()
            ln.end(mir.Term.Branch(isNull, none, some))
            ln.start(none)
            ln.word(b, "null", sp)
            ln.goto(after)
        } else {
            nn := ln.prim(typed.PrimOp.Ne, types.BoolT, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(x)), mir.Operand.Const(ty, 0)], sp)
            none := ln.F.NewBlock()
            ln.end(mir.Term.Branch(nn, some, none))
            ln.start(none)
            ln.word(b, "null", sp)
            ln.goto(after)
        }
        ln.start(some)
        ref := t.Referent(r)
        if t.KindOf(ref) == types.Kind.Named and t.DeclKindOf(t.DeclOf(ref)) == types.DeclKind.Foreign {
            # X10: what an extern type's reference names is C's, never read - it renders as the type's name
            ln.word(b, ln.T.Names.Text(t.DeclName(t.DeclOf(ref))), sp)
            ln.goto(after)
            ln.start(after)
            return
        }
        # references followed 8 deep, then "..." - a cycle is cut off
        d := ln.depth()
        far := ln.prim(typed.PrimOp.Ge, types.BoolT, Array<mir.Operand>[d, ln.constI64(8)], sp)
        dots, deeper := ln.F.NewBlock(), ln.F.NewBlock()
        ln.end(mir.Term.Branch(far, dots, deeper))
        ln.start(dots)
        ln.word(b, "...", sp)
        ln.goto(after)
        ln.start(deeper)
        saved := ln.rdepth
        ln.rdepth = ln.prim(typed.PrimOp.Add, mir.I64T, Array<mir.Operand>[d, ln.constI64(1)], sp)
        ln.inner(ln.at(x), t.Referent(r), b, sp)
        ln.rdepth = saved
        ln.goto(after)
        ln.start(after)
        return
    }
    if t.KindOf(r) == types.Kind.Func {
        x := ln.local(mir.Operand.Copy(ln.mk(a)), ty, sp)
        nn := ln.prim(typed.PrimOp.Ne, types.BoolT, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(x)), mir.Operand.Const(ty, 0)], sp)
        some, none, after := ln.F.NewBlock(), ln.F.NewBlock(), ln.F.NewBlock()
        ln.end(mir.Term.Branch(nn, some, none))
        ln.start(none)
        ln.word(b, "null", sp)
        ln.goto(after)
        ln.start(some)
        # the function a value holds is never null, and renders as its signature, whatever declared type it is (T21b)
        ln.word(b, ln.spell(ln.T.Untagged(ln.T.NonNull(ty)), true, not top), sp)
        ln.goto(after)
        ln.start(after)
        return
    }
    if not top {
        ln.helperCall(mir.HelperKind.Render, ty, Array<mir.Operand>[ln.refTo(a, ty, sp), ln.depth()], Array<mir.ScopeRef>[b], types.VoidT, sp)
        return
    }
    parts, isParts := ln.partsOf(ty), mir.HasFields(ln.T, ty)
    cases, isEnum := ln.casesOf(ty), mir.HasCases(ln.T, ty)
    if isParts {
        if t.KindOf(r) == types.Kind.Named { ln.word(b, $ln.L.errQualifier(t.DeclOf(r)) $ln.T.Names.Text(t.DeclName(t.DeclOf(r))), sp) }
        ln.word(b, "(", sp)
        for i in range parts.Len() {
            if i > 0 { ln.word(b, ", ", sp) }
            ln.inner(ln.packedField(a, ty, i), parts[i], b, sp)
        }
        ln.word(b, ")", sp)
    } else if isEnum {
        caseNames := t.CaseNames(r) if t.KindOf(r) == types.Kind.Named else t.ShapeNames(r)
        tag := ln.into(mir.I64T, mir.Rvalue.Tag(ln.mk(a)), sp)
        prefix := "" if t.KindOf(r) != types.Kind.Named else $ln.L.errQualifier(t.DeclOf(r)) $ln.T.Names.Text(t.DeclName(t.DeclOf(r))) "."
        after := ln.F.NewBlock()
        cs := Array<mir.Case>(cases.Len())
        bs := Array<mir.BlockId>(cases.Len())
        for k in range cases.Len() {
            bs[k] = ln.F.NewBlock()
            cs[k] = mir.Case(k, bs[k])
        }
        ln.end(mir.Term.Switch(tag, ln.F.AddCases(cs), after))
        for k in range cases.Len() {
            ln.start(bs[k])
            name := ln.T.Names.Text(caseNames[k]) if caseNames.Len() > 0 and k < caseNames.Len() else $k
            ln.word(b, $prefix $name, sp)
            if cases[k] != types.TypeId(0) { ln.renderPayload(a, k, cases[k], b, sp) }
            ln.goto(after)
        }
        ln.start(after)
    } else if ln.arrayOf(ty) != types.UnknownT {
        el := t.Elem(ln.arrayOf(ty))
        ln.word(b, "Array<" $ln.spell(ln.readOnly(el), true, true) ">[", sp)   # the literal making it (E11a, E19)
        n := ln.prim(typed.PrimOp.Len, mir.I64T, Array<mir.Operand>[mir.Operand.Copy(ln.mk(a))], sp)
        ln.eachIndex(n, sp, fn(i mir.LocalId) {
            first := ln.prim(typed.PrimOp.Eq, types.BoolT, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(i)), ln.constI64(0)], sp)
            sep, item := ln.F.NewBlock(), ln.F.NewBlock()
            ln.end(mir.Term.Branch(first, item, sep))
            ln.start(sep)
            ln.word(b, ", ", sp)
            ln.goto(item)
            ln.start(item)
            ln.inner(ln.with(a, mir.Proj.Index(i)), el, b, sp)
        })
        ln.word(b, "]", sp)
    } else {
        ln.gap(sp, "a Render helper for a type with no rendering")
    }
}

# T33: $ of an "any" - its instance rendered through its table, "null" for none
fn (ln mut lowering&) renderAny(b mir.ScopeRef, v mir.Operand, ty types.TypeId, top Bool, sp source.Span) {
    t := ln.T
    x := ln.local(v, ty, sp)
    after := ln.F.NewBlock()
    if t.IsNullable(t.Repr(ty)) {
        nn := ln.prim(typed.PrimOp.Ne, types.BoolT, Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(x)), mir.Operand.Const(ty, 0)], sp)
        some, none := ln.F.NewBlock(), ln.F.NewBlock()
        ln.end(mir.Term.Branch(nn, some, none))
        ln.start(none)
        ln.word(b, "null", sp)
        ln.goto(after)
        ln.start(some)
    }
    # an "any" is a reference: followed 8 deep, then "...", as any other (E11a) - a cycle through any fields is cut off
    d := ln.depth()
    far := ln.prim(typed.PrimOp.Ge, types.BoolT, Array<mir.Operand>[d, ln.constI64(8)], sp)
    dots, deeper := ln.F.NewBlock(), ln.F.NewBlock()
    ln.end(mir.Term.Branch(far, dots, deeper))
    ln.start(dots)
    ln.word(b, "...", sp)
    ln.goto(after)
    ln.start(deeper)
    d1 := ln.prim(typed.PrimOp.Add, mir.I64T, Array<mir.Operand>[d, ln.constI64(1)], sp)
    hty := mir.HelperType(t, mir.HelperKind.Render, t.Referent(t.Repr(ty)))
    callee := mir.Callee.Dispatch(mir.Operand.Copy(mir.Lvalue.L(x)), -1 if top else -2, hty)
    ok := ln.F.NewBlock()
    k := ln.F.AddCall(mir.Call(callee, ln.F.Args(Array<mir.Operand>[mir.Operand.Copy(mir.Lvalue.L(x)), d1]), ln.F.ScopeRefs(Array<mir.ScopeRef>[b])
                               mir.NoPlace, false, ok, mir.NoLocal, mir.NoBlock))
    ln.end(mir.Term.Call(sp, k))
    ln.start(ok)
    ln.goto(after)
    ln.start(after)
}

# how many references the rendering being written followed to reach here (E11a): 0 outside a Render helper
fn (ln mut lowering&) depth() mir.Operand { return ln.constI64(0) if ln.rdepth == mir.Operand.None else ln.rdepth }

# a value written inside another's rendering (E11a): a Char as a character literal, text as a string literal, a
# number or a Bool as at the top, anything else as at the top through its Render helper
fn (ln mut lowering&) inner(a pl, ty types.TypeId, b mir.ScopeRef, sp source.Span) {
    a = ln.solid(a, ty, sp)
    t := ln.T
    r := t.Repr(ty)
    if ln.isChar(ty) {
        ln.emit(mir.Stmt.Write(sp, b, mir.WriteKind.QuotedChar, ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp)))
        return
    }
    if ln.isText(ty) and not ln.hasStr(ty) {
        x := ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp)
        # T2c: text that may be null renders "null" where it is, an element of an array too
        if t.IsNullable(r) and t.ArrayRef(r): ln.renderMaybeText(b, x, ty, sp, mir.WriteKind.Quoted)
        else: ln.emit(mir.Stmt.Write(sp, b, mir.WriteKind.Quoted, x))
        return
    }
    if t.KindOf(ty) == types.Kind.ErrVal {
        ln.renderErr(b, mir.Operand.Copy(ln.mk(a)), ty, sp)
        return
    }
    if ln.scalar(ty) {
        how := mir.WriteKind.Bool
        if t.IsUnsigned(r) { how = mir.WriteKind.Uint } else if t.IsInt(r) { how = mir.WriteKind.Int } else if t.IsFloat(r) {
            how = mir.WriteKind.Float
        }
        ln.emit(mir.Stmt.Write(sp, b, how, ln.into(ty, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp)))
        return
    }
    ln.renderAt(a, ty, b, sp)
}

# a Char, or a type declared over one (E11a renders those as characters)
fn (ln mut lowering&) isChar(ty types.TypeId) Bool {
    t := ln.T
    x := ty
    for _ in range 16 {
        if t.Same(x, ln.L.char()) { return true }
        if not (t.KindOf(x) == types.Kind.Named and t.DeclKindOf(t.DeclOf(x)) == types.DeclKind.Over and t.HasBody(x)) {
            return false
        }
        x = t.Base(x)
    }
    return false
}

# text written into builder b as it is
fn (ln mut lowering&) word(b mir.ScopeRef, text String&, sp source.Span) {
    bytes := Array<U8>(text.Len())
    for i in range text.Len() { bytes[i] = U8(text[i]) }
    u8 := ln.T.Prim("U8")
    bt := ln.T.Ref(ln.T.Array(u8, types.TypeId(0)), types.ReadOnly)
    c := ln.F.AddConst(typed.Const.Bytes(bytes))
    ln.emit(mir.Stmt.Write(sp, b, mir.WriteKind.Bytes, mir.Operand.Data(bt, c, ln.file, sp)))
}

# the type with its own write permission dropped: an array's element type as a literal writes it (E11a)
fn (ln mut lowering&) readOnly(ty types.TypeId) types.TypeId {
    t := ln.T
    if t.IsRef(ty) { return t.Ref(t.Referent(ty), t.PermOf(ty) & (0 - 1 - types.Writable)) }
    return ty
}

# a type as source writes it (E11a, E21): primitives and declared types by name, their arguments in angle brackets,
# references with their permission, arrays as Array<T> whatever their storage (T7c); a function type as a signature, after "fn"
# where fnWord says
fn (ln mut lowering&) spell(ty types.TypeId, fnWord Bool, item Bool = false, group Bool = false) String {
    t := ln.T
    k := t.KindOf(ty)
    if k == types.Kind.Named {
        # as source writes it outside its module (E11a, B5): "list.List<I64>", the prelude's and the root's own bare
        name := $ln.L.errQualifier(t.DeclOf(ty)) $ln.T.Names.Text(t.DeclName(t.DeclOf(ty)))
        args := t.Items(t.Args(ty))
        if args.Len() == 0 { return $name }
        out := StringBuilder()
        out.Push(name)
        out.PushChar('<')
        for i in range args.Len() {
            if i > 0 { out.Push(", ") }
            out.Push(ln.spell(args[i], true, true))
        }
        out.PushChar('>')
        return out.ToString()
    }
    if k == types.Kind.Ref {
        m := "mut " if (t.PermOf(ty) & types.Writable) != 0 else ""
        return $m $ln.spell(t.Referent(ty), true, item) $("?&" if (t.PermOf(ty) & types.Nullable) != 0 else "&")
    }
    if k == types.Kind.Any { return "any " $ln.spell(t.AnyTrait(ty), true, item) }
    if k == types.Kind.Array {
        return "Array<" $ln.spell(t.Elem(ty), true, true) ">"
    }
    if k == types.Kind.Const { return $t.ConstValue(ty) }
    if k == types.Kind.ErrVal { return ln.L.ErrValSpelling(ty) }
    if k == types.Kind.Tuple {
        out := StringBuilder()
        xs := t.Items(t.Parts(ty))
        out.PushChar('(')
        for i in range xs.Len() {
            if i > 0 { out.Push(", ") }
            out.Push(ln.spell(xs[i], true, true))
        }
        out.PushChar(')')
        return out.ToString()
    }
    if k == types.Kind.Func and t.FuncTag(ty) != types.UnknownT {
        # T21b: a declared function type, as it is held - "Handler&"
        return $ln.spell(t.FuncTag(ty), true) $("?&" if t.FuncNullable(ty) else "&")
    }
    if k == types.Kind.Func {
        out := StringBuilder()
        res := t.Result(ty)
        es := t.Items(t.Errors(ty))
        several := (t.KindOf(res) == types.Kind.Tuple and t.Items(t.Parts(res)).Len() > 1) or es.Len() > 1
        # L18c: an item of a list holding a comma of its own, or a result before its signature's "?", whole
        wrap := fnWord and (group or (item and several))
        if wrap { out.PushChar('(') }
        if fnWord { out.Push("fn?&" if t.FuncNullable(ty) else "fn&") }   # T21: held only by reference
        out.PushChar('(')
        ps := t.Items(t.Params(ty))
        ns := t.NamesOf(ty)
        for i in range ps.Len() {
            if i > 0 { out.Push(", ") }
            if ns.Len() == ps.Len() { out.Push($t.Names.Text(source.NameId(I32(ns[i]))) " ") }
            out.Push(ln.spell(ps[i], true, true))
        }
        out.PushChar(')')
        if t.KindOf(res) == types.Kind.Tuple {
            # several results, bare (D8c)
            parts := t.Items(t.Parts(res))
            for i in range parts.Len() { out.Push($(", " if i > 0 else " ") $ln.spell(parts[i], true, true)) }
        } else if res != types.VoidT {
            g := es.Len() > 0 and t.KindOf(res) == types.Kind.Func and t.Items(t.Errors(res)).Len() == 0
            out.Push(" " $ln.spell(res, true, true, g))
        }
        if es.Len() > 0 {
            out.Push(" ?")
            for i in range es.Len() { out.Push($(", " if i > 0 else " ") $ln.spell(t.ErrOf(es[i]), true)) }
        }
        if wrap { out.PushChar(')') }
        return out.ToString()
    }
    return t.Canon(ty)
}

# T20: an error value's type as source writes it - its error type, the named set it was written as, else its entries
# in braces; an entry holding some words of a type, those words ("os.Error.Denied") - each qualified as its values are
# (B5: "lib.Both", the prelude's and the root program's own bare), so "Vec<lib.Both>[lib.LibErr.B]" reads alike
fn (lw mut Lowerer&) ErrValSpelling(ty types.TypeId) String {
    t types.Table& = lw.P.T
    nd := t.ErrValName(ty)
    if nd >= types.DeclId(0) { return $lw.errQualifier(nd) $t.Names.Text(t.DeclName(nd)) }
    es := t.Items(t.ErrValItems(ty))
    out := StringBuilder()
    if es.Len() != 1 { out.PushChar('{') }
    k := 0
    for e in es {
        et := t.ErrOf(e)
        name := $lw.errQualifier(t.DeclOf(et)) $t.Names.Text(t.DeclName(t.DeclOf(et)))
        if t.KindOf(e) != types.Kind.ErrWords {
            if k > 0 { out.Push(", ") }
            out.Push(name)
            k++
            continue
        }
        ws := lw.P.ErrorWords(t.DeclOf(et))
        for i in range ws.Len() {
            if i < 64 and (t.ErrMask(e) & (U64(1) << i)) != 0 {
                if k > 0 { out.Push(", ") }
                out.Push($name if lw.P.IsRaisedError(t.DeclOf(et)) else $name "." $t.Names.Text(ws[i]))
                k++
            }
        }
    }
    if es.Len() != 1 { out.PushChar('}') }
    return out.ToString()
}

# B5: what an error type's or a named set's name is qualified by where its values print
fn (lw mut Lowerer&) errQualifier(d types.DeclId) String {
    dm := lw.P.T.DeclModule(d)
    return load.ErrQualifier(lw.P.L.Mods[dm].Identity, dm == lw.P.L.Root)
}

# whether a type declares Str (E11c), and its body: its Str, rendering it at every depth
fn (ln mut lowering&) strBody(ty types.TypeId) I64 {
    lw := ln.L
    t := ln.T
    # a declared type over a number or an array is its own type here, with its own Str (E11c)
    r := ty if t.KindOf(ty) == types.Kind.Named else t.Repr(ty)
    if t.KindOf(r) != types.Kind.Named { return -1 }
    got := try lw.strOf.Get(r) catch default -2
    if got != -2 { return got }
    id := ln.methodBody(ty, "Str", "str")
    lw.strOf.Put(r, id)
    return id
}

# the checked body of a one-parameter method a type declares, by either spelling (M6b) - -1 where none was made
fn (ln mut lowering&) methodBody(ty types.TypeId, cap String&, low String&) I64 {
    lw := ln.L
    t := ln.T
    # a declared type over a number or an array is its own type here, with its own methods (E11c)
    r := ty if t.KindOf(ty) == types.Kind.Named else t.Repr(ty)
    if t.KindOf(r) != types.Kind.Named { return -1 }
    id := -1
    for name in Array<String&>[cap, low] {
        m := lw.P.MethodOf(r, t.Names.Intern(name))
        if m >= 0 and id < 0 { id = ln.receiverBody(r, m) }
    }
    return id
}

# the first body of an instance of method m whose one parameter is r, by value or by reference; -1 for none
fn (ln mut lowering&) receiverBody(r types.TypeId, m I64) I64 {
    lw := ln.L
    t := ln.T
    for i in range lw.Bodies.Len() {
        of := lw.Bodies[i].Of
        if of != typed.BodyOf.Fn or lw.P.InstanceFn(of.instance) != m { continue }
        ps := t.Items(t.Params(lw.Bodies[i].Ty))
        if ps.Len() != 1 { continue }
        p0 := t.Referent(ps[0]) if t.IsRef(ps[0]) else ps[0]
        if t.Same(t.Repr(p0), t.Repr(r)) { return i }
    }
    return -1
}

fn (ln mut lowering&) hasStr(ty types.TypeId) Bool { return ln.strBody(ty) >= 0 }

# a value of a type declaring Str rendered by it: Str called on it, what it returns written as it is
fn (ln mut lowering&) renderStr(a pl, ty types.TypeId, b mir.ScopeRef, sp source.Span) Bool {
    id := ln.strBody(ty)
    if id < 0 { return false }
    t := ln.T
    callee, fty := ln.bodyCallee(typed.BodyId(I32(id)))
    p0 := t.Items(t.Params(fty))[0]
    recv := ln.into(p0, mir.Rvalue.Ref(ln.mk(a), p0), sp) if t.IsRef(p0) else ln.into(p0, mir.Rvalue.Use(mir.Operand.Copy(ln.mk(a))), sp)
    res := t.Result(fty)
    ok := ln.F.NewBlock()
    dest := ln.temp(res, sp)
    # E11c: what Str builds for its result is built in a scope "$" opens for the call, closed once the text is copied -
    # its destructors run there, and an unwind through it closes it
    rs := ln.F.AddScope(mir.ScopeKind.Block, ln.top().S, typed.BlockId(-1), sp)
    ln.emit(mir.Stmt.Open(sp, rs))
    vs := t.ScopeVarsOf(fty)
    xs := Array<mir.ScopeRef>(vs.Len())
    for i in range vs.Len() { xs[i] = mir.ScopeRef.Scope(rs) if vs[i] == types.ResultVar else mir.ScopeRef.Program }
    k := ln.F.AddCall(mir.Call(callee, ln.F.Args(Array<mir.Operand>[recv]), ln.F.ScopeRefs(xs), mir.Lvalue.L(dest)
                               true, ok, mir.NoLocal, mir.NoBlock))
    ln.end(mir.Term.Call(sp, k))
    ln.start(ok)
    ln.emit(mir.Stmt.Write(sp, b, mir.WriteKind.Bytes, mir.Operand.Copy(mir.Lvalue.L(dest))))
    ln.emit(mir.Stmt.Close(sp, rs))
    return true
}

# ---- tests ----

# a program of one file, main.olang, loaded over the repository's std, checked and lowered: the verifier's problems with every body and every function they refer to, a line each
# ("B<id>: problem"), "gap" lines for what is not lowered yet, and the dump of each body of the root module whose
# function's name is in dumps
fn lowerText(text String&, dumps Array<String&>&) String, String {
    dir := try os.MkTemp() catch os.Error { unreachable }
    defer { try os.RemoveAll(dir) catch os.Error { } }
    try os.WriteFile($dir "/main.olang", text) catch os.Error { }
    consts := cond.Consts()
    consts.Builtins("linux", "x86_64", "x86-64", 128, 0, false, false, false)
    l := load.Loader("std", consts, fetch.Fetcher($dir "/olang.lock", $dir "/cache", "file:///nowhere/", false, true)
                     source.Names(), diag.Diagnostics(false))
    l.Load($dir "/main.olang")
    r := names.Resolver(l)
    r.Resolve()
    p := generic.Program(l, r)
    c := check.Checker(p, false)
    c.CheckProgram()
    lw := Lowerer(p, c.Bodies)
    problems := StringBuilder()
    out := StringBuilder()
    root := l.Mods[l.Root].File
    for b in range c.Bodies.Len() {
        if not lw.HasCode(b) { continue }
        body := c.Bodies[b]
        name := ""
        match body.Of {
            case typed.BodyOf.Fn(inst) { name = $p.L.Names.Text(p.FnDecl(p.InstanceFn(inst)).Name) }
            case _ { }
        }
        dump := body.File == root and name in dumps
        bad, shown := try lw.Verified(b, dump) catch GapMet {
            problems.Push("B" $b ": gapped\n")
            continue
        }
        for line in bad.Split("\n") {
            if line.Len() > 0 { problems.Push("B" $b ": " $line "\n") }
        }
        out.Push(shown)
    }
    for m in lw.InitModules() { lw.Want(mir.FnKey.Init(m)) }
    w I64 = 0
    for w < lw.Wanted.Len() {
        key := lw.Wanted[w]
        w++
        bad, _ := try lw.VerifiedKey(key, false) catch GapMet {
            problems.Push($key ": gapped\n")
            continue
        }
        for line in bad.Split("\n") {
            if line.Len() > 0 { problems.Push($key ": " $line "\n") }
        }
    }
    for g in lw.Gaps { problems.Push("gap " $g.What "\n") }
    return problems.ToString(), out.ToString()
}

test "a function lowers to straight-line MIR: its operands in temporaries, its frame opened and closed" {
    problems, dump := lowerText("fn add(a I32, b I32) I32 {\n    s := a + b\n    return s\n}\nfn main() { x := add(1, 2) }\n"
                                Array<String&>["add"])
    assert problems == "", problems
    want := ("  L0 Param a: I32\n  L1 Param b: I32\n  L2 Var s: I32\n  L3 Temp: I32\n  L4 Temp: I32\n  L5 Temp: I32\n"
             "  L6 Temp: I32\n  S0 Frame block 0\nbb0:\n  open S0\n  L3 = copy L0\n  L4 = copy L1\n  L5 = Add I32(copy L3, copy L4)\n"
             "  L2 = copy L5\n  L6 = copy L2\n  close S0\n  return copy L6\n")
    assert (try dump.Find(want) catch default -1) > 0, dump
}

test "control flow verifies clean: ifs, loops with break and continue, ranges, for-in, matches, tries, defers" {
    text := ("type Shape enum {\n    Circle(r I64)\n    Square\n}\n"
             "type E error {\n    Bad\n    Worse\n}\n"
             "fn pick(n I64) I64 ? E {\n    if n < 0 { error E.Bad }\n    if n > 100 { error E.Worse }\n    return n\n}\n"
             "fn area(s Shape) I64 {\n    return match s {\n        case Shape.Circle(r): 3 * r * r\n        case Shape.Square: 1\n    }\n}\n"
             "fn walk(a Array<I64>&) I64 ? E {\n    t I64 = 0\n    defer { t = 0 }\n    for x in a {\n        if x == 2 { continue }\n"
             "        if x > 50 { break }\n        t += try pick(x) catch E.Bad default 0\n    }\n    for i in range 3 { t += i }\n"
             "    return t\n}\n"
             "fn main() ? E {\n    s := try walk(Array<I64>[1, 2, 3]) + area(Shape.Circle(2))\n    assert s > 0, \"positive\"\n"
             "    q := try I64(s * 2).Narrow<I32>() catch default 0\n    assert $q \" \" $Shape.Square != \"\"\n}\n")
    problems, _ := lowerText(text, Array<String&>[])
    assert problems == "", problems
}

test "helpers: == on a struct, its Hash, its rendering; a comprehension; a join of tasks" {
    text := ("type Point struct(x I64, y I64) {\n    x, y\n}\n"
             "fn sq(n I64) I64 { return n * n }\n"
             "fn main() {\n    p := Point(1, 2)\n    assert p == Point(1, 2) and p.Hash() == Point(1, 2).Hash()\n"
             "    t := $p\n    a := Array<I64>[x * 2 for x in Array<I64>[1, 2, 3] if x > 1]\n    out := Array<I64>(3)\n"
             "    join {\n        for i in range 3 { spawn out[i] = sq(i) }\n    }\n    assert a.Len() == 2 and out[2] == 4 and t.Len() > 0\n}\n")
    problems, _ := lowerText(text, Array<String&>[])
    assert problems == "", problems
}
