# notebook - "olang notebook run FILE.ipynb" (B24): a Jupyter notebook run without Jupyter or Python. The code cells of
# the notebook (nbformat 4, std/json) run in order in one prompt session (prompt.olang, B22), each as the kernel runs a
# cell (jupyter.olang, B23): its standard output and error captured, its shown value in the MIME types its type
# renders itself in. Each code cell's outputs are replaced by what Jupyter stores for it and its execution_count set;
# every other part of the notebook is written back as it was read.

import "std/os"
import "std/io"
import "std/json"
import "build"
import "prompt"
import "jupyter"

# the notebook at path run, written back to out ("" for path itself): 0, or 1 where a cell failed (the cells after it
# not run, unless all says to go on), 2 where the notebook cannot be read or written
fn Run(cfg mut build.Config&, path String&, out String&, all Bool) I32 {
    text := try os.ReadFile(path) catch os.Error e { return fail($"cannot read " $path ": " $e) }
    doc := try json.Json.Parse(text) catch json.Error e { return fail($path " is no JSON: " $e) }
    cells := try doc["cells"].AsArr() catch json.Error { return fail($path " is no notebook: it has no cells") }
    s := prompt.Session(cfg)
    s.Relay = true
    n I64 = 0
    failed := false
    done Vec<json.Json&>
    for c in cells {
        kind := $str(c, "cell_type")
        if kind != "code" { done.Push(c) }
        else if failed and not all { done.Push(with(c, "outputs", json.Json.Arr(Array<json.Json&>[]), json.Json.Null)) }
        else if source(c).Trim() == "" { done.Push(with(c, "outputs", json.Json.Arr(Array<json.Json&>[]), json.Json.Null)) }
        else {
            n++
            outs := execute(s, source(c), n)
            failed = failed or failedWith(outs)
            done.Push(with(c, "outputs", outs, json.Json.Int(n)))
        }
    }
    s.End()
    top := set(try doc.AsObj() catch json.Error { return fail($path " is no notebook") }, "cells", json.Json.Arr(done.ToArray()))
    meta := try doc["metadata"].AsObj() catch json.Error default empty()
    top = set(top, "metadata", json.Json.Obj(kernelspec(meta)))
    to := out if out != "" else path
    try os.WriteFile(to, $json.Encode(json.Json.Obj(top), " ") "\n") catch os.Error e { return fail($"cannot write " $to ": " $e) }
    return 1 if failed else 0
}

fn fail(why String&) I32 {
    try io.PutErr($"olang notebook: " $why "\n") catch io.Error { }
    return 2
}

fn str(j json.Json&, key String&) String& { return try j[key].AsStr() catch json.Error default "" }

# a cell's source: one text, or the lines of it
fn source(c json.Json&) String {
    s := try c["source"] catch json.Error default json.Json.Null
    if s == json.Json.Null: return ""
    return $(try s.AsStr() catch json.Error default $(try joined(s) catch json.Error default ""))
}

fn joined(a json.Json&) String ? json.Error {
    b := StringBuilder()
    for l in try a.AsArr(): b.Push(try l.AsStr())
    return b.ToString()
}

# the object o with the member key given v: where it is, else at the end
fn set(o json.Object&, key String&, v json.Json&) json.Object {
    ks Vec<String&>
    vs Vec<json.Json&>
    found := false
    for i, k in o.Keys {
        ks.Push(k)
        pick json.Json& = v if k == key else o.Values[i]
        vs.Push(pick)
        found = found or k == key
    }
    if not found {
        ks.Push(key)
        vs.Push(v)
    }
    return try json.Object(ks.ToArray(), vs.ToArray()) catch { unreachable }
}

# the cell c with its outputs and execution_count replaced
fn with(c json.Json&, key String&, outs json.Json&, count json.Json&) json.Json {
    o := try c.AsObj() catch json.Error { return c }
    return json.Json.Obj(set(set(o, key, outs), "execution_count", count))
}

fn empty() json.Object { return try json.Object(Array<String&>[], Array<json.Json&>[]) catch { unreachable } }

# whether a cell's outputs end in an error
fn failedWith(outs json.Json&) Bool {
    a := try outs.AsArr() catch json.Error { return false }
    return a.Len() > 0 and $str(a[a.Len() - 1], "output_type") == "error"
}

# the metadata with a kernelspec naming olang where it has none
fn kernelspec(o json.Object&) json.Object {
    if o.Has("kernelspec"): return o
    spec := try json.Json.Parse("{\"display_name\":\"olang\",\"language\":\"olang\",\"name\":\"olang\"}") catch json.Error { unreachable }
    return set(o, "kernelspec", spec)
}

# a cell run as the kernel runs one: its outputs as Jupyter stores them
fn execute(s mut prompt.Session&, code String&, n I64) json.Json {
    out := jupyter.Capture(1)
    errs := jupyter.Capture(2)
    r := s.Cell(code, label = $"In[" $n "]")
    said := out.End()
    complained := errs.End()
    outs Vec<String&>
    if said != "": outs.Push(stream("stdout", said))
    warnings := r.Diags if r.Checked else ""
    err := $complained $warnings $r.Notes
    if err != "": outs.Push(stream("stderr", err))
    if r.Shown: outs.Push($"{\"output_type\":\"execute_result\",\"data\":" $jupyter.Data(r) ",\"execution_count\":" $n ",\"metadata\":{}}")
    failure := r.Failure if r.Checked else r.Diags
    if failure != "" {
        rows Vec<String&>
        for line in failure.TrimEnd().Lines(): rows.Push(jupyter.Q(line))
        ename := "RuntimeError" if r.Checked else "CompileError"
        outs.Push($"{\"output_type\":\"error\",\"ename\":\"" $ename "\",\"evalue\":" $jupyter.Q(jupyter.FirstLine(failure)) ",\"traceback\":[" $rows.Join(",") "]}")
    }
    parsed := try json.Json.Parse($"[" $outs.Join(",") "]") catch json.Error { unreachable }
    return parsed
}

# a stream output: the text as the lines it ends, as Jupyter writes them
fn stream(name String&, text String&) String {
    ls Vec<String&>
    from I64 = 0
    for i, ch in text {
        if ch != '\n': continue
        ls.Push(jupyter.Q(text[from:i + 1]))
        from = i + 1
    }
    if from < text.Len(): ls.Push(jupyter.Q(text[from:]))
    return $"{\"output_type\":\"stream\",\"name\":\"" $name "\",\"text\":[" $ls.Join(",") "]}"
}
