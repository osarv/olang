# parse - tokens to a syntax tree (compiler/DESIGN.md 1.2 and section 2).
#
# Recursive descent for declarations and statements, precedence climbing (Pratt) over E5's table for expressions. The
# parser looks one token ahead, plus the bounded peeks section 2 lists, and never backtracks: where a form cannot be
# told from the next token, a cover grammar reads the common prefix once and the token after it decides (a statement's
# "a, b", a type argument that turns out to be an expression, a case's patterns).
#
# Errors go to the compilation's diagnostics (diag). An error in a statement skips to that statement's end, or to its
# block's "}"; one in a declaration skips the declaration. What an if's branch meets is held in a group of its own
# (DESIGN.md point 12): which branch is compiled may depend on the build, and an untaken one says nothing.
import "source"
import "token"
import "scan"
import "ast"
import "diag"
import "msgs"
import "std/os"

type Fail error { Syntax }

# L21: how deep blocks, operands and operator chains may nest
MaxNesting I64 = 20000

# the names that are types where "Name<" stands in an expression (DESIGN.md point 1): the module's own type and error
# names in every branch, the prelude's, and its imports' through their aliases
type Oracle struct() {
    bare Map<source.NameId, Bool>
    qualified Map<String&, Bool>      # "alias.Name", "a.b.Name"
    fns Map<source.NameId, Bool>      # the generic functions, where "name<" lists type arguments (G12)
    fnsQualified Map<String&, Bool>
}

fn (o mut Oracle&) Add(names mut source.Names&, alias String&, name String&) {
    if alias == "" {
        o.bare.Put(names.Intern(name), true)
    } else {
        o.qualified.Put($alias "." $name, true)
    }
}

# a generic function's name: "name<I64>" names its instance (G12)
fn (o mut Oracle&) AddFn(names mut source.Names&, alias String&, name String&) {
    if alias == "" {
        o.fns.Put(names.Intern(name), true)
    } else {
        o.fnsQualified.Put($alias "." $name, true)
    }
}

# the generic functions a file declares: "fn name<", by name
fn GenericFnNames(text String&, ts scan.Tokens&) Vec<String&>&text {
    out mut Vec<String&>&text = Vec<String&>()
    toks := ts.Toks
    for i in range toks.Len() - 2 {
        if toks[i].Kind == token.Tok.Fn and toks[i + 1].Kind == token.Tok.Iden and toks[i + 2].Kind == token.Tok.Lt {
            out.Push(text[toks[i + 1].Start:toks[i + 1].End])
        }
    }
    return out
}

type Parser struct(src source.Source&, ts scan.Tokens&, names mut source.Names&, oracle Oracle&, diags mut diag.Diagnostics&
                   file I64) {
    src
    ts
    names
    oracle
    diags
    file
    pos I64 = 0
    half token.Tok = token.Tok.Eof     # the rest of a split ">>", ">=" or ">>=", read next (point 10)
    halfStart I32 = 0
    prevKind token.Tok = token.Tok.Eof # the last token read, and where it ended
    prevEnd I32 = 0
    noGt Bool = false                  # in a type-argument list: ">" closes it, and a comparison or shift is no operator
    inCtor Bool = false                # at a constructor body's top level: a bare name is a field (C2)
    inLine Bool = false                # in a one-line body (S1b): "else" and "catch" end its statement too
    lamItem Bool = false               # ... and the lambda an item of a list: its "," is the list's (L18c)
    inLam Bool = false                 # in a lambda's one-line body (S1b, D16): what closes its bracket ends it, a line end is left
    ctorBody Bool = false              # the next block is a constructor's body
    brackets I64 = 0                   # open "(" and "[" around here, outside every block (L18b)
    skip Bool = false                  # in a parenthesized expression or a comprehension: a line's end separates
                                       # nothing there, so its statement ends are passed over (L18a)
    item Bool = false                  # reading an item of a list: a function type or a lambda here takes one result
                                       # and one error item, a "," after them the list's (L18c)
    depth I64 = 0                      # L21
    tooDeep Bool = false
    limitAt I64 = -1                   # in a try statement, the token where a level first took the last one (L21)
    unclosed Bool = false              # an unclosed block ended at a declaration: the item ends where it stands
    listTry I32 = -1                   # where a try stands that is a whole destructuring's, return's or spawn's value: its
                                       # clause may give one default a result (R9a)
    ItemStarts Vec<I32>               # where each top-level item begins, in order - nested ones in an if's branches too
    ItemKept Vec<Bool>                # beside ItemStarts: whether the item parsed whole (an L21 may be said in one that did)
    SaidIn Map<I32, I64>               # where each syntax error said starts: the item it was said in (an item may read past
                                       # its own lines before it fails - into the declaration its recovery then reads)
    vars Vec<source.NameId>           # the current item's introduced type variables (G8b), which "match T" takes
    reflNames Vec<source.NameId>      # the names an enclosing for-in binds to a reflected list's items (G33): "match f.Type"
    exprs Vec<ast.Expr&>              # nodes being gathered into lists, nested lists on top
    stmts Vec<ast.Stmt&>
    tys Vec<ast.TypeRef&>
    prms Vec<ast.Param&>
    pats Vec<ast.Pattern&>
    ids Vec<source.NameId>
    sps Vec<source.Span>
    decls Vec<ast.Decl&>
    salvage Vec<ast.Decl&>            # a function or type whose body did not parse, as the declaration it still is
    typeParamsRead Array<ast.TypeParam&>& = Array<ast.TypeParam&>(0) # the type parameters of the type declaration being read
    # where angle brackets were read as type brackets, by token index (a split ">>" is there twice): a type-argument or
    # type-parameter list's "<" and its ">". The formatter (compiler/fmt.olang) spaces them; nothing in the compiler
    # reads them
    ArgAngles Vec<I64>
    CloseAngles Vec<I64>
    TypeGroups Vec<I64>               # each "(" grouping a function type in a list (L18c), by token index, for the formatter
    # every comparison read as an operand of "&", "|" or "^" with nothing around it, by its span - where E5's
    # bitwise-tighter precedence (2026-10-24) reads the text otherwise; tools/precedence_migrate.olang wraps them
    Mixed Vec<source.Span>
    OldBitwise Bool = false            # read with E5's precedence before 2026-10-24, for tools/precedence_migrate.olang
    # with RecordOperators, the span of every operator's node (binary, chain, in, is) - over one file's tokens, the shape
    # of every expression; tools/precedence_migrate.olang compares two readings by it
    RecordOperators Bool = false
    Operators Vec<source.Span>
    # the tokens the formatter spaces as the grammar places them, by token index: each "(" grouping a function type in a
    # list (L18c), each "[" opening a contract and each ":" before a contract item's body (D17), each "@" beginning an
    # attribute (G39)
    TypeGroups Vec<I64>
    variadicOk Bool = false            # an extern's parameters being read: "..." may end them (X21)
    noAttrs Bool = false               # reading a function type's parameters or a receiver: no attribute is written there
    attrGlobals Vec<ast.Decl&>        # the hidden globals holding the attributes of the item being read (G39), put
                                       # beside it when it is done
    sawVariadic Bool = false
    spreadOk Bool = false     # D8g: the parameter list being read may hold a variadic parameter - a signature's
}

# ---- reading tokens ----

# the index of the next token at or after i: past statement ends where they separate nothing (skip)
fn (p Parser&) skipFrom(i I64) I64 {
    j := i
    if p.skip {
        for j < p.ts.Toks.Len() - 1 and p.ts.Toks[j].Kind == token.Tok.StmtEnd { j++ }
    }
    return j
}

fn (p Parser&) tk() token.Token { return p.ts.Toks[p.skipFrom(p.pos)] }

fn (p Parser&) peek() token.Tok {
    if p.half != token.Tok.Eof { return p.half }
    return p.ts.Toks[p.skipFrom(p.pos)].Kind
}

# the index n tokens after the next one
fn (p Parser&) after(n I64) I64 {
    i := p.skipFrom(p.pos)
    k := n - (1 if p.half != token.Tok.Eof else 0)
    for k > 0 and i < p.ts.Toks.Len() {
        i = p.skipFrom(i + 1)
        k--
    }
    return i
}

# the kind n tokens after the next one
fn (p Parser&) look(n I64) token.Tok {
    i := p.after(n)
    if i >= p.ts.Toks.Len() { return token.Tok.Eof }
    return p.ts.Toks[i].Kind
}

fn (p Parser&) lookTok(n I64) token.Token {
    i := p.after(n + (1 if p.half != token.Tok.Eof else 0))
    if i >= p.ts.Toks.Len() { return p.ts.Toks[p.ts.Toks.Len() - 1] }
    return p.ts.Toks[i]
}

fn (p Parser&) here() I32 {
    if p.half != token.Tok.Eof { return p.halfStart }
    return p.ts.Toks[p.skipFrom(p.pos)].Start
}

# whether an unreachable's message follows on its line (S16d): a literal, a "$" rendering, a name or a parenthesized
# expression - anything else (a ",", a closing bracket, "if", "else", an operator, the line's end) ends the unreachable
fn (p Parser&) messageHere() Bool {
    if p.breakBefore() { return false }
    return match p.peek() {
        case token.Tok.StrLit, token.Tok.Dollar, token.Tok.Iden, token.Tok.LParen, token.Tok.IntLit: true
        case token.Tok.FloatLit, token.Tok.CharLit, token.Tok.BoolLit, token.Tok.NullLit: true
        case _: false
    }
}

# whether a line ended before the next token
fn (p Parser&) breakBefore() Bool {
    if p.half != token.Tok.Eof { return false }
    return p.tk().Has(token.LineBreak)
}

fn (p mut Parser&) advance() I32 {
    if p.half != token.Tok.Eof {
        p.prevKind = p.half
        p.half = token.Tok.Eof
        p.prevEnd = p.ts.Toks[p.pos - 1].End
        return p.halfStart
    }
    p.pos = p.skipFrom(p.pos)
    t := p.ts.Toks[p.pos]
    if t.Kind != token.Tok.Eof { p.pos++ }
    if t.Kind != token.Tok.StmtEnd {
        p.prevKind = t.Kind
        p.prevEnd = t.End
    }
    return t.Start
}

fn (p Parser&) sees(k token.Tok) Bool { return p.peek() == k }

fn (p mut Parser&) accept(k token.Tok) Bool {
    if p.peek() != k { return false }
    p.advance()
    return true
}

# the span from start to the end of the last token read
fn (p Parser&) from(start I32) source.Span { return source.Span(start, p.prevEnd) }

fn (p Parser&) text(t token.Token) String&p { return p.src.Text[t.Start:t.End] }

# the next token as a diagnostic names it
fn (p Parser&) found() String {
    if p.half != token.Tok.Eof { return msgs.Tok(p.half.Text()) }
    t := p.tk()
    if t.Kind == token.Tok.StmtEnd { return msgs.EndOfLine }
    if t.Kind == token.Tok.Eof { return msgs.EndOfFile }
    return msgs.Tok(p.text(t))
}

# ---- diagnostics ----

fn (p mut Parser&) report(start I32, end I32, m msgs.Msg) {
    p.diags.Error(diag.Where.Span(p.file, I64(start), I64(end)), m)
    if not p.SaidIn.Has(start) { p.SaidIn.Put(start, p.ItemStarts.Len() - 1) }
}

# what was wanted is not here: said at the next token, in the words of a hint where one fits
fn (p mut Parser&) fail(want String&) ? Fail {
    if p.tooDeep or p.unclosed { error Fail.Syntax }
    if not p.hint(want) {
        t := p.tk()
        p.report(p.here(), t.End, msgs.Expected(want, p.found()))
    }
    error Fail.Syntax
}

fn (p mut Parser&) want(k token.Tok) I32 ? Fail {
    if p.peek() != k { try p.fail(k.Describe()) }
    return p.advance()
}

# a name, interned
fn (p mut Parser&) name() source.NameId ? Fail {
    if p.peek() != token.Tok.Iden { try p.fail("a name") }
    t := p.tk()
    p.advance()
    return p.names.Intern(p.text(t))
}

# L9a: a method's name may be any keyword (but true, false and null)
fn (p mut Parser&) methodName() source.NameId ? Fail {
    k := p.peek()
    if k != token.Tok.Iden and not isWordKeyword(k) { try p.fail("a name") }
    t := p.tk()
    p.advance()
    return p.names.Intern(p.text(t))
}

# whether the word after the next "." may be a member's name (L9a): a name, or a keyword where "(" follows it or that may
# name a field - never true, false or null. The scanner makes every word after "." a name; its spelling decides here
fn (p Parser&) memberNext() Bool {
    t := p.lookTok(1)
    if t.Kind != token.Tok.Iden { return false }
    kw := token.Keyword(p.src.Text, I64(t.Start), I64(t.End - t.Start))
    if kw == token.Tok.Iden { return true }
    if kw == token.Tok.BoolLit or kw == token.Tok.NullLit { return false }
    return keywordNamesField(kw) or p.look(2) == token.Tok.LParen
}

fn isWordKeyword(k token.Tok) Bool {
    t := k.Text()
    return t.Len() > 0 and t[0].IsLetter() and k != token.Tok.BoolLit and k != token.Tok.NullLit
}

# L21: one more level of nesting, or the one diagnostic that says there are too many
fn (p mut Parser&) enter() ? Fail {
    if p.depth >= MaxNesting {
        if not p.tooDeep {
            p.tooDeep = true
            t := p.tk()
            p.diags.ErrorUnheld(diag.Where.Span(p.file, I64(p.here()), I64(t.End)), msgs.Nesting(MaxNesting))
        }
        error Fail.Syntax
    }
    if p.depth + 1 == MaxNesting and p.limitAt < 0 { p.limitAt = p.pos }
    p.depth++
}

fn (p mut Parser&) leave() { p.depth-- }

# L21 where a statement starts: every statement is first tried as one that reads an operand there, so a statement met
# at the limit is said to be too deep at its first token. It is still read: what in it nests (an operand, a block) is
# refused by enter(), and one that nests nothing (break, error E.A, a bare return) is kept, its item with it
fn (p mut Parser&) stmtRoom() {
    if p.depth >= MaxNesting { p.tooDeepAt(p.pos) }
}

# the one L21 diagnostic, said at the token with that index
fn (p mut Parser&) tooDeepAt(i I64) {
    if p.tooDeep { return }
    p.tooDeep = true
    t := p.ts.Toks[i]
    p.diags.ErrorUnheld(diag.Where.Span(p.file, I64(t.Start), I64(t.End)), msgs.Nesting(MaxNesting))
}

# ---- lists, gathered on the parser's stacks ----

fn gather<T>(stack mut Vec<T>&, from I64) Array<T>&stack {
    if stack.Len() == from { return Array<T>(0) }
    a mut Array<T>&stack = Array<T>(stack.Len() - from, stack[from])     # each written below
    for i in range a.Len() { a[i] = stack[from + i] }
    stack.Truncate(from)
    return a
}

# ---- statement ends and recovery ----

# where the stacks stand, so that a statement that failed can leave nothing on them
type stackMarks struct(exprs I64, stmts I64, tys I64, prms I64, pats I64, ids I64, sps I64) {
    exprs
    stmts
    tys
    prms
    pats
    ids
    sps
}

fn (p Parser&) marks() stackMarks {
    return stackMarks(p.exprs.Len(), p.stmts.Len(), p.tys.Len(), p.prms.Len(), p.pats.Len(), p.ids.Len(), p.sps.Len())
}

fn (p mut Parser&) release(m stackMarks) {
    p.exprs.Truncate(m.exprs)
    p.stmts.Truncate(m.stmts)
    p.tys.Truncate(m.tys)
    p.prms.Truncate(m.prms)
    p.pats.Truncate(m.pats)
    p.ids.Truncate(m.ids)
    p.sps.Truncate(m.sps)
}

# a statement's end (L18, L20, L20a)
fn (p mut Parser&) endStmt() ? Fail {
    k := p.peek()
    if k == token.Tok.StmtEnd {
        if not p.inLam { p.advance() }    # a lambda's line ends the statement the lambda stands in too
        return
    }
    if k == token.Tok.RBrace or k == token.Tok.Eof { return }
    if p.inLine and (k == token.Tok.Else or k == token.Tok.Catch) { return }
    if p.inLam and (k == token.Tok.RParen or k == token.Tok.RBrack or k == token.Tok.Comma) { return }
    pk := p.prevKind
    if (pk == token.Tok.Amp or pk == token.Tok.Gt or pk == token.Tok.RBrace) and p.breakBefore() { return }
    try p.fail(token.Tok.StmtEnd.Describe())
}

# where a statement may end without anything more: a line end, a block's "}", the file's end, or in a one-line body
# (S1b) the "else" or "catch" after it
fn (p mut Parser&) atEnd() Bool {
    k := p.peek()
    if k == token.Tok.StmtEnd or k == token.Tok.RBrace or k == token.Tok.Eof { return true }
    if p.inLam and (k == token.Tok.RParen or k == token.Tok.RBrack or k == token.Tok.Comma) { return true }
    return p.inLine and (k == token.Tok.Else or k == token.Tok.Catch)
}

fn (p mut Parser&) skipEnds() {
    for p.sees(token.Tok.StmtEnd) { p.advance() }
}

# after an error in a statement: past its end at this depth, or to the "}" closing its block
fn (p mut Parser&) syncStmt(start I64) {
    # from the statement's start, so that the blocks it opened are passed whole - unless the parse got further
    failed := p.pos
    p.pos = start
    p.syncFrom()
    if p.pos < failed {
        p.pos = failed
        p.syncFrom()
    }
}

# to the end of the statement at the cursor: its next line end outside brackets, or its block's "}" - inside a bracket
# left open too
fn (p mut Parser&) syncFrom() {
    p.half = token.Tok.Eof
    p.noGt = false
    depth I64 = 0
    for {
        k := p.peek()
        if k == token.Tok.Eof { return }
        if k == token.Tok.LBrace {
            close := p.ts.Match(I32(p.pos))
            if close < 0 { return }
            p.pos = I64(close)
            p.advance()
            continue
        }
        if k == token.Tok.RBrace {
            return      # the blocks the statement opened were passed whole: this one closes the enclosing block
        } else if k == token.Tok.LParen or k == token.Tok.LBrack {
            depth++
        } else if k == token.Tok.RParen or k == token.Tok.RBrack {
            if depth > 0 { depth-- }
        } else if k == token.Tok.StmtEnd and depth == 0 {
            p.advance()
            return
        }
        p.advance()
    }
}

# after an error in a top-level item: from its start, past its end - a statement end outside its braces, or the "}"
# that closes them at a line's end - or to the "}" of the branch it is in
fn (p mut Parser&) syncItem(start I64) {
    p.pos = start
    p.half = token.Tok.Eof
    p.noGt = false
    depth I64 = 0
    for {
        t := p.tk()
        if t.Kind == token.Tok.Eof { return }
        if t.Kind == token.Tok.RBrace and depth == 0 { return }
        p.advance()
        if t.Kind == token.Tok.LBrace {
            depth++
        } else if t.Kind == token.Tok.RBrace {
            depth--
            if depth == 0 {
                n := p.tk()
                if n.Kind == token.Tok.Eof or n.Kind == token.Tok.StmtEnd or n.Has(token.LineBreak) { return }
            }
        } else if depth == 0 and t.Kind == token.Tok.StmtEnd {
            return
        }
    }
}

# whether the token at i begins a declaration: "type", "test", "import", "extern", or "fn" and a name
fn (p Parser&) declStarts(i I64) Bool {
    k := p.ts.Toks[i].Kind
    if k == token.Tok.Type or k == token.Tok.Test or k == token.Tok.Import or k == token.Tok.Extern { return true }
    if k == token.Tok.Iden and i + 1 < p.ts.Toks.Len() and p.text(p.ts.Toks[i]) == "export" and p.ts.Toks[i + 1].Kind == token.Tok.Fn { return true }
    return k == token.Tok.Fn and i + 1 < p.ts.Toks.Len() and p.ts.Toks[i + 1].Kind == token.Tok.Iden
}

# whether the next token starts a declaration where a statement was wanted - an unclosed block's end
# O3: "fn f&s(" or "type T&s struct" - a scope named after a declaration's name, touching it; there is no such thing,
# so it is reported and read past
fn (p mut Parser&) scopeDecl() {
    if p.half != token.Tok.Eof or not p.sees(token.Tok.Amp) or p.tk().Has(token.Space) { return }
    n := p.lookTok(1)
    if (n.Kind != token.Tok.Iden and n.Kind != token.Tok.Return) or n.Has(token.Space) { return }
    t := p.tk()
    p.report(t.Start, t.End, msgs.ScopeDecl())
    p.advance()
    p.advance()
}

fn (p Parser&) declHere() Bool {
    k := p.peek()
    if p.inCtor and p.keywordFieldHere() { return false }
    if k == token.Tok.Fn or k == token.Tok.Type { return p.look(1) == token.Tok.Iden }
    return k == token.Tok.Test or k == token.Tok.Import or k == token.Tok.Extern
}

# ---- declarations ----

# a whole file
fn (p mut Parser&) File() Array<ast.Decl&>&p {
    from := p.decls.Len()
    for {
        p.skipEnds()
        if p.sees(token.Tok.Eof) { break }
        if p.sees(token.Tok.RBrace) {
            try p.fail("a declaration") catch { }
            p.advance()
            continue
        }
        p.item()
    }
    return gather(p.decls, from)
}

# one expression from the token with index at - a top-level condition, or the initializer of a global one reads, which
# the loader decides before the module is parsed (DESIGN.md 1.4). The cursor is left after it (Pos)
fn (p mut Parser&) ExprAt(at I64) ast.Expr&p ? Fail {
    p.pos = at
    p.half = token.Tok.Eof
    p.noGt = false
    p.inCtor = false
    p.brackets = 0
    p.skip = false
    p.depth = 0
    p.tooDeep = false
    p.vars.Truncate(0)
    return try p.expr()
}

# the index of the next token to read
fn (p Parser&) Pos() I64 { return p.pos }

# one top-level item, onto the decls stack, or its diagnostic
fn (p mut Parser&) item() {
    start := p.pos
    k := p.ItemKept.Len()
    p.ItemStarts.Push(p.here())
    p.ItemKept.Push(true)
    p.vars.Truncate(0)
    p.inCtor = false
    p.brackets = 0
    p.skip = false
    p.depth = 0
    p.tooDeep = false
    p.unclosed = false
    p.salvage.Truncate(0)
    p.attrGlobals.Truncate(0)
    d := try p.decl() catch {
        p.ItemKept[k] = false
        p.attrGlobals.Truncate(0)
        # a function or type whose body did not parse stays declared by its signature or its name, its body never
        # checked - so a use of it is not reported again (SNTX_BODY_UNPARSED)
        for x in p.salvage { p.decls.Push(x) }
        p.salvage.Truncate(0)
        if p.unclosed {
            p.unclosed = false
            return
        }
        if start == p.pos {
            p.advance()           # nothing of it read: an item's first token that begins none
        }
        p.syncItem(start)
        if p.pos == start { p.advance() }
        return
    }
    p.decls.Push(d!)
    # G39: the attributes' globals, declared beside what they are written on - in the same branch of a top-level if
    for x in p.attrGlobals { p.decls.Push(x) }
    p.attrGlobals.Truncate(0)
}

fn (p mut Parser&) decl() ast.Decl?&p ? Fail {
    if p.sees(token.Tok.At) { return try p.attributed() }
    at := p.here()
    match p.peek() {
        case token.Tok.Import {
            p.advance()
            alias source.NameId = source.NameId(0)
            if p.sees(token.Tok.Iden) { alias = try p.name() }
            if not p.sees(token.Tok.StrLit) { try p.fail(token.Tok.StrLit.Describe()) }
            path := p.tk()
            p.advance()
            # X9, X17: "link" after the path names the library a C header's declarations are in - a word only there
            link := try p.linkClause()
            sp := p.from(at)
            try p.endStmt()
            return ast.Decl.Import(sp, alias, source.Span(path.Start, path.End), link)
        }
        case token.Tok.Type { return try p.typeDecl() }
        case token.Tok.Fn {
            f := try p.function()
            return ast.Decl.Fn(f)
        }
        case token.Tok.Extern {
            p.advance()
            if p.sees(token.Tok.Type) {
                # X10: "extern type Db" - a C type held only by reference
                p.advance()
                tname := try p.name()
                tsp := p.from(at)
                try p.endStmt()
                return ast.Decl.Type(tsp, ast.TypeDecl(tname, Array<ast.TypeParam&>(0), false, ast.TypeBody.Foreign))
            }
            # X1, X9: "extern [link "name"] { ... }" - a block of declarations, of the library the link names
            link := try p.linkClause()
            if p.sees(token.Tok.LBrace) { return try p.externBlock(at, link) }
            if link.End > I32(0) { try p.fail(token.Tok.LBrace.Describe()) }
            f := try p.externFn(at)
            try p.endStmt()
            return ast.Decl.Extern(f)
        }
        case token.Tok.Test {
            p.advance()
            # B14: a test may name what it is an example of - a function, a type, Type.Method
            target ast.Path?& = null
            if p.sees(token.Tok.Iden) { target = try p.path() }
            if not p.sees(token.Tok.StrLit) { try p.fail(token.Tok.StrLit.Describe()) }
            nt := p.tk()
            p.advance()
            body := try p.block()
            return ast.Decl.Test(p.from(at), source.Span(nt.Start, nt.End), body, target)
        }
        case token.Tok.If { return try p.topIf() }
        case token.Tok.Assert {
            # S17a: a top-level assert, decided while compiling
            p.advance()
            cond := try p.expr()
            msg ast.Expr?&p = null
            if p.accept(token.Tok.Comma) { msg = try p.expr() }
            sp := p.from(at)
            try p.endStmt()
            return ast.Decl.Assert(sp, cond, msg)
        }
        case token.Tok.Iden {
            # X12: export fn - a contextual word too
            if p.text(p.tk()) == "export" and p.look(1) == token.Tok.Fn {
                p.advance()
                xf := try p.function()
                return ast.Decl.Fn(ast.Func(p.from(at), xf.Recv, xf.Name, xf.S, xf.Body, xf.TypeParams, xf.Bodied, true))
            }
            if p.look(1) == token.Tok.Assign {
                # D13e: a global's value given below its declaration - its place (a top-level if's branch) the checker's
                nt := p.tk()
                n := try p.name()
                p.advance()
                value := try p.expr()
                ssp := p.from(at)
                try p.endStmt()
                return ast.Decl.Set(ssp, ast.Expr.Name(source.Span(nt.Start, nt.End), n), value)
            }
            v := try p.declNames(false)
            sp := p.from(at)
            try p.endStmt()
            return ast.Decl.Global(sp, v)
        }
        case _ { try p.fail("a declaration") }
    }
    unreachable
}

# G39: a type or a function after its attributes - the attributes on lines of their own above it, or on its line
fn (p mut Parser&) attributed() ast.Decl?&p ? Fail {
    attrs := try p.attrs()
    k := p.peek()
    exported := k == token.Tok.Iden and p.text(p.tk()) == "export" and p.look(1) == token.Tok.Fn
    if not (k == token.Tok.Fn or exported or (k == token.Tok.Type and p.look(2) != token.Tok.Error)) {
        p.attrRefused(attrs)
        return try p.decl()
    }
    d := try p.decl()
    match d! {
        case ast.Decl.Fn(f) {
            p.declareAttrs(attrs)
            return ast.Decl.Fn(ast.Func(f.Sp, f.Recv, f.Name, f.S, f.Body, f.TypeParams, f.Bodied, f.Export, attrs))
        }
        case ast.Decl.Type(sp, td) {
            p.declareAttrs(attrs)
            return ast.Decl.Type(sp, ast.TypeDecl(td.Name, td.Params, td.Extends, td.Body, attrs))
        }
        case _ { return d }
    }
}

# "@" and a declared type's value, one or several, each on a line of its own or before what it is written on (G39):
# "@json.Skip", "@json.Key("id")", "@Range<I64>(0, 9)" - a path, its type arguments and its arguments touching it
fn (p mut Parser&) attrs() Array<ast.Attr&>&p ? Fail {
    l mut Vec<ast.Attr&>&p = Vec<ast.Attr&>()
    for p.sees(token.Tok.At) {
        p.TypeGroups.Push(p.skipFrom(p.pos))     # the formatter writes nothing after an attribute's "@"
        at := p.advance()
        xat := p.here()
        if not p.sees(token.Tok.Iden) or p.tk().Has(token.Space) { try p.fail("a type's name after '@' - an attribute is written '@Name' or '@Name(arguments)'") }
        n := try p.name()
        x ast.Expr&p = ast.Expr.Name(p.from(xat), n)
        for p.sees(token.Tok.Dot) and not p.tk().Has(token.Space) {
            p.advance()
            m := try p.methodName()
            x = ast.Expr.Member(p.from(xat), x, m)
        }
        if p.sees(token.Tok.Lt) and p.typeArgsCall(0) {
            targs := try p.typeArgs()
            x = ast.Expr.Generic(p.from(xat), x, targs)
        }
        if p.sees(token.Tok.LParen) and not p.tk().Has(token.Space) {
            args := try p.args()
            x = ast.Expr.Call(p.from(xat), x, args)
        }
        sp := p.from(at)
        l.Push(ast.Attr(sp, x, p.names.Intern("@" $at)))
        p.skipEnds()
    }
    return l.ToArray()
}

# the hidden globals holding attributes' values (G39): put beside the item being read once it is done
fn (p mut Parser&) declareAttrs(attrs Array<ast.Attr&>&p) {
    for a in attrs {
        v mut ast.VarDecl&p = ast.VarDecl(Array<source.NameId>(1, a.Global), Array<source.Span>(1, a.X.Span()), null
                                          Array<ast.Expr&>(1, a.X), true, false, Array<ast.Attr&>(0), true)
        p.attrGlobals.Push(ast.Decl.Global(a.Sp, v))
    }
}

# attributes written where nothing takes them (G39): said once, at the first
fn (p mut Parser&) attrRefused(attrs Array<ast.Attr&>&) {
    if attrs.Len() == 0 { return }
    sp := attrs[0].Sp
    p.report(sp.Start, sp.End, msgs.AttrPlace())
}

# the attributes written here, none where no "@" stands (G39)
fn (p mut Parser&) attrsHere() Array<ast.Attr&>&p ? Fail {
    if not p.sees(token.Tok.At) { return Array<ast.Attr&>(0) }
    return try p.attrs()
}

# "link "name"" after an import's path or "extern" (X9): the text's span, quotes included - (0, 0) where none is written
fn (p mut Parser&) linkClause() source.Span ? Fail {
    if not (p.sees(token.Tok.Iden) and p.text(p.tk()) == "link" and p.look(1) == token.Tok.StrLit) { return source.Span(0, 0) }
    p.advance()
    t := p.tk()
    p.advance()
    return source.Span(t.Start, t.End)
}

# "fn NAME(params) [result | noreturn]" after "extern", or in an extern block (X1): its parameters may end in "..." (X21)
fn (p mut Parser&) externFn(at I32) ast.Func&p ? Fail {
    try p.want(token.Tok.Fn)
    name := try p.name()
    p.variadicOk = true
    s := try p.sig(false) catch {
        p.variadicOk = false
        error Fail.Syntax
    }
    p.variadicOk = false
    return ast.Func(p.from(at), null, name, s, Array<ast.Stmt&>(0), Array<ast.TypeParam&>(0), false)
}

# an extern block's "{" ... "}" (X1, X10): one declaration a line - "fn ..." or "type NAME"
fn (p mut Parser&) externBlock(at I32, link source.Span) ast.Decl&p ? Fail {
    try p.want(token.Tok.LBrace)
    from := p.decls.Len()
    p.skipEnds()
    for not p.sees(token.Tok.RBrace) {
        if p.sees(token.Tok.Eof) { try p.fail(token.Tok.RBrace.Describe()) }
        dat := p.here()
        if p.accept(token.Tok.Type) {
            tname := try p.name()
            p.decls.Push(ast.Decl.Type(p.from(dat), ast.TypeDecl(tname, Array<ast.TypeParam&>(0), false, ast.TypeBody.Foreign)))
        } else if p.sees(token.Tok.Fn) {
            p.decls.Push(ast.Decl.Extern(try p.externFn(dat)))
        } else {
            try p.fail("'fn' or 'type' - an extern block declares C's functions and types")
        }
        try p.endStmt()
        p.skipEnds()
    }
    p.advance()
    ds := gather(p.decls, from)
    return ast.Decl.ExternBlock(p.from(at), link, ds)
}

# an entry of an enum, an error type or a trait: entries on one line are separated by ",", on different lines by the
# line's end (T17, T19, QY)
fn (p mut Parser&) entryEnd() ? Fail {
    if p.accept(token.Tok.Comma) {
        p.skipEnds()
        return
    }
    # QY: after an entry ending in "}", ">" or a bare "&" (after which L18 puts no statement end) the next one may begin a
    # later line - "Round Circle&" above "Sq(s F64)"
    pk := p.prevKind
    if (pk == token.Tok.RBrace or pk == token.Tok.Gt or pk == token.Tok.Amp) and p.breakBefore() {
        p.skipEnds()
        return
    }
    # the next entry on the same line: the body's end was wanted (T17, T19)
    if not p.sees(token.Tok.StmtEnd) and not p.sees(token.Tok.RBrace) and not p.sees(token.Tok.Eof) { try p.fail(token.Tok.RBrace.Describe()) }
    try p.endStmt()
    p.skipEnds()
}

# a top-level if (B9): every branch parsed, each item of it an item of its own
fn (p mut Parser&) topIf() ast.Decl&p ? Fail {
    at := p.here()
    t := try p.topIfRest()
    return ast.Decl.If(p.from(at), t)
}

fn (p mut Parser&) topIfRest() ast.TopIf&p ? Fail {
    try p.want(token.Tok.If)
    cond := try p.expr()
    then := try p.topBranch()
    if not p.accept(token.Tok.Else) { return ast.TopIf(cond, then, null, null) }
    if p.sees(token.Tok.If) {
        inner := try p.topIfRest()
        return ast.TopIf(cond, then, inner, null)
    }
    els := try p.topBranch()
    return ast.TopIf(cond, then, null, els)
}

fn (p mut Parser&) topBranch() ast.TopBranch&p ? Fail {
    at := try p.want(token.Tok.LBrace)
    g := p.diags.Hold()
    from := p.decls.Len()
    for {
        p.skipEnds()
        if p.sees(token.Tok.RBrace) or p.sees(token.Tok.Eof) { break }
        p.item()
    }
    p.diags.EndHold()
    try p.want(token.Tok.RBrace)
    sp := p.from(at)
    decls := gather(p.decls, from)
    return ast.TopBranch(sp, decls, g)
}

fn (p mut Parser&) typeDecl() ast.Decl&p ? Fail {
    at := try p.want(token.Tok.Type)
    name := try p.name()
    if p.sees(token.Tok.Error) { return try p.errorDecl(at, name) }
    return try p.typeDeclRest(at, name) catch {
        p.salvage.Push(ast.Decl.Type(p.from(at), ast.TypeDecl(name, p.typeParamsRead, false, null)))
        error Fail.Syntax
    }
}

# "type Name error [Member, ...] [{ Words }]" (T19, T19a): an error type's words, a named set's members on the line
# after "error", or both - at least one of the two, the braces last
fn (p mut Parser&) errorDecl(at I32, name source.NameId) ast.Decl&p ? Fail {
    p.advance()
    ms mut Vec<ast.Path&>&p = Vec<ast.Path&>()
    if p.sees(token.Tok.Iden) {
        for {
            ms.Push(try p.path())
            if not p.accept(token.Tok.Comma) { break }
        }
    }
    words Array<source.NameId>&p = Array<source.NameId>(0)
    if p.sees(token.Tok.LBrace) {
        words = try p.errorWords()
    } else if ms.Len() == 0 {
        try p.fail("an error type's words or a set's members")
    }
    sp := p.from(at)
    if p.sees(token.Tok.StmtEnd) { p.advance() }
    return ast.Decl.Errors(sp, name, words, ms.ToArray())
}

# an error type's words: "{" then one per line, or several on one line separated by "," (T19, QY), at least one
fn (p mut Parser&) errorWords() Array<source.NameId>&p ? Fail {
    try p.want(token.Tok.LBrace)
    from := p.ids.Len()
    p.skipEnds()
    if p.sees(token.Tok.RBrace) { try p.fail("an error word") }
    for not p.sees(token.Tok.RBrace) {
        w := try p.name()
        p.ids.Push(w)
        try p.entryEnd()
    }
    p.advance()
    return gather(p.ids, from)
}

fn (p mut Parser&) typeDeclRest(at I32, name source.NameId) ast.Decl&p ? Fail {
    p.typeParamsRead = Array<ast.TypeParam&>(0)
    params Array<ast.TypeParam&>&p = Array<ast.TypeParam&>(0)
    if p.sees(token.Tok.Lt) {
        params = try p.typeParams()
        p.typeParamsRead = params
    }
    extending := p.accept(token.Tok.Extends)
    p.scopeDecl()
    body := try p.typeBody()
    sp := p.from(at)
    if p.sees(token.Tok.StmtEnd) { p.advance() }
    return ast.Decl.Type(sp, ast.TypeDecl(name, params, extending, body))
}

fn (p mut Parser&) typeBody() ast.TypeBody?&p ? Fail {
    match p.peek() {
        case token.Tok.Struct {
            p.advance()
            tps Array<ast.TypeParam&>&p = Array<ast.TypeParam&>(0)
            if p.sees(token.Tok.Lt) { tps = try p.typeParams() }      # G10d: "struct<T>(g Graph<T>&)" (QW)
            try p.want(token.Tok.LParen)
            params := try p.params(false)
            k := try p.contractHere()
            errs := p.withContract(try p.errorSet(), k)
            p.ctorBody = true
            body := try p.block()
            dsp := source.Span(0, 0)
            dtor Array<ast.Stmt&>&p = Array<ast.Stmt&>(0)
            if p.sees(token.Tok.Destruct) {
                dat := p.advance()
                dtor = try p.block()
                dsp = p.from(dat)
            }
            return ast.TypeBody.Struct(ast.StructBody(params, errs, body, dsp, dtor, tps))
        }
        case token.Tok.Enum {
            p.advance()
            raw ast.TypeRef?&p = null
            if not p.sees(token.Tok.LBrace) { raw = try p.typeExpr() }   # T17e: "enum String {"
            try p.want(token.Tok.LBrace)
            cases mut Vec<ast.CaseDecl&>&p = Vec<ast.CaseDecl&>()
            p.skipEnds()
            for not p.sees(token.Tok.RBrace) {
                cattrs := try p.attrsHere()
                cat := p.here()
                cn := try p.name()
                payload Array<ast.Param&>&p = Array<ast.Param&>(0)
                whole := false
                if p.accept(token.Tok.LParen) {
                    payload = try p.params(false)
                } else if not p.sees(token.Tok.Comma) and not p.sees(token.Tok.StmtEnd) and not p.sees(token.Tok.RBrace) and
                          not p.sees(token.Tok.Eof) and not p.sees(token.Tok.Assign) {
                    # T17: a payload of one type written whole, "Round Circle"
                    tat := p.here()
                    ty := try p.typeExpr()
                    payload = ast.Param&[ast.Param(p.from(tat), cn, ty, null)]
                    whole = true
                }
                value ast.Expr?&p = null
                if p.accept(token.Tok.Assign) { value = try p.expr() }   # T17e: a raw value
                p.declareAttrs(cattrs)
                cases.Push(ast.CaseDecl(p.from(cat), cn, payload, whole, value, cattrs))
                try p.entryEnd()
            }
            p.advance()
            return ast.TypeBody.Enum(cases.ToArray(), raw)
        }
        case token.Tok.Trait {
            p.advance()
            # "extends A, B" (T30a) and "for X, Y" (T31a), before the methods
            exts := try p.typeList(token.Tok.Extends)
            members := try p.typeList(token.Tok.For)
            try p.want(token.Tok.LBrace)
            methods mut Vec<ast.Func&>&p = Vec<ast.Func&>()
            p.skipEnds()
            for not p.sees(token.Tok.RBrace) {
                mat := p.here()
                # "mut" before the name: the receiver may be written through - a receiver of no name, typed "mut"
                recv ast.Param?&p = null
                if p.sees(token.Tok.Mut) {
                    mt := p.tk()
                    p.advance()
                    msp := source.Span(mt.Start, mt.End)
                    recv = ast.Param(msp, source.NameId(0), ast.TypeRef.Perm(msp, null, true, false), null)
                }
                mn := try p.methodName()
                # D17f: a trait's method may state the contract every call through an "any" is held to
                s := try p.sig(false, false, true)
                methods.Push(ast.Func(p.from(mat), recv, mn, s, Array<ast.Stmt&>(0), Array<ast.TypeParam&>(0), false))
                try p.entryEnd()
            }
            p.advance()
            return ast.TypeBody.Trait(methods.ToArray(), exts, members)
        }
        case _ {
            base := try p.typeExpr()
            if p.sees(token.Tok.LParen) {      # a constructor over a primitive (T29d)
                cat := p.advance()
                cp := try p.params(false)
                ck := try p.contractHere()
                ce := p.withContract(try p.errorSet(), ck)
                cb := try p.block()
                s := ast.Sig(cp, Array<ast.TypeRef&>(0), ce.HasErrors, ce.Errors, false, ce.Contract)
                return ast.TypeBody.Over(base, ast.Func(p.from(cat), null, source.NameId(0), s, cb))
            }
            return ast.TypeBody.Over(base, null)
        }
    }
    unreachable
}

# "fn [(receiver)] Name sig block"
fn (p mut Parser&) function() ast.Func&p ? Fail {
    at := try p.want(token.Tok.Fn)
    recv ast.Param?&p = null
    name source.NameId = source.NameId(0)
    if p.accept(token.Tok.LParen) {
        p.noAttrs = true
        recv = try p.param(false) catch {
            p.noAttrs = false
            error Fail.Syntax
        }
        p.noAttrs = false
        try p.want(token.Tok.RParen)
        name = try p.methodName()
    } else {
        name = try p.name()
    }
    # QW: "fn max<T>(...)" - the function's own type variables (G3); a method's receiver introduces its type's
    # variables bare ("fn (l List<T>&) Push(x T)"): names no type has, written as its type's arguments
    tps Array<ast.TypeParam&>&p = Array<ast.TypeParam&>(0)
    if p.sees(token.Tok.Lt) { tps = try p.typeParams() }
    if recv is not null and recv.Ty is not null { p.receiverVars(recv.Ty!, false) }
    p.scopeDecl()
    s := try p.sig(false, false, true)
    braced := p.sees(token.Tok.LBrace)
    body := try p.block() catch {
        if braced { p.salvage.Push(ast.Decl.Fn(ast.Func(p.from(at), recv, name, s, Array<ast.Stmt&>(0), tps, false))) }
        error Fail.Syntax
    }
    return ast.Func(p.from(at), recv, name, s, body, tps)
}

# the names a receiver's type arguments write that no type has: the variables it introduces (G3, QW)
fn (p mut Parser&) receiverVars(t ast.TypeRef&, inArgs Bool) {
    match t {
        case ast.TypeRef.Named(_, path, args) {
            if inArgs and path.Len() == 1 and args.Len() == 0 {
                n := path[0]
                tx := p.names.Text(n)
                if not p.oracle.bare.Has(n) and not builtinType(tx) { p.vars.Push(n) }
                return
            }
            for a in args { p.receiverVars(a, true) }
        }
        case ast.TypeRef.Ref(_, of, _, _) { p.receiverVars(of, inArgs) }
        case ast.TypeRef.Perm(_, of, _, _) {
            if of is not null { p.receiverVars(of, inArgs) }
        }
        case _ { }
    }
}

# T4, T7: the names every module sees as a type
fn builtinType(t String&) Bool {
    return t == "Bool" or t == "Array" or t == "I8" or t == "I16" or t == "I32" or t == "I64" or t == "U8" or
           t == "U16" or t == "U32" or t == "U64" or t == "F16" or t == "BF16" or t == "F32" or t == "F64"
}

# "<" item { sep item } ">": a type's parameters, or a function's or a constructor's own type variables (G1, G3, G10d,
# QW) - each a name, then its constraint or a constant's type
# after a trait's name: "KEYWORD T, U, ..." where the keyword is there - the types it lists, none where it is not
fn (p mut Parser&) typeList(kw token.Tok) Array<ast.TypeRef&>&p ? Fail {
    if not p.accept(kw) { return Array<ast.TypeRef&>(0) }
    l mut Vec<ast.TypeRef&>&p = Vec<ast.TypeRef&>()
    for {
        l.Push(try p.typeExpr())
        # QY: on one line separated by ",", on different lines by the line break, the trait's "{" closing the list
        if not (try p.sep(token.Tok.LBrace)) { break }
    }
    return l.ToArray()
}

fn (p mut Parser&) typeParams() Array<ast.TypeParam&>&p ? Fail {
    try p.openAngle()
    wasSkip := p.skip
    p.skip = false
    l mut Vec<ast.TypeParam&>&p = Vec<ast.TypeParam&>()
    for {
        # G1a: "? E" closes the list - its error-set parameter, a name alone
        if p.accept(token.Tok.Question) {
            eat := p.here()
            en := try p.name()
            p.vars.Push(en)
            l.Push(ast.TypeParam(p.from(eat), en, null, Array<ast.TypeRef&>(0), true))
            break
        }
        pat := p.here()
        pn := try p.name()
        p.vars.Push(pn)
        ty ast.TypeRef?&p = null
        also mut Vec<ast.TypeRef&>&p = Vec<ast.TypeRef&>()
        # its constraint: a trait, or several side by side - their intersection (G19)
        for not p.sees(token.Tok.Comma) and not p.sees(token.Tok.StmtEnd) and not p.closesAngle() and
            not p.sees(token.Tok.Question) {
            wasNoGt, wasItem := p.noGt, p.item
            p.noGt = true
            p.item = true
            t := try p.typeExpr()
            p.noGt = wasNoGt
            p.item = wasItem
            if ty is null { ty = t } else { also.Push(t) }
        }
        l.Push(ast.TypeParam(p.from(pat), pn, ty, also.ToArray()))
        if p.sees(token.Tok.Question) { continue }
        if not try p.sep(token.Tok.Gt) { break }
    }
    p.skip = wasSkip
    try p.closeAngle()
    return l.ToArray()
}

# "(params) [results] [? errors]" - the "(" not yet read; several results bare, "I64, I64" (D8c). A lambda's parameters
# may leave their types out. A function type or a lambda (value) read as an item of a list takes one result and one
# error item, so a "," after it is the list's: one with several of either is parenthesized whole (L18c)
fn (p mut Parser&) sig(lambda Bool, value Bool = false, named Bool = false) ast.Sig&p ? Fail {
    one := value and p.item
    try p.want(token.Tok.LParen)
    p.sawVariadic = false
    wasNo := p.noAttrs
    p.noAttrs = value
    p.spreadOk = true
    params := try p.params(lambda) catch {
        p.noAttrs = wasNo
        error Fail.Syntax
    }
    p.noAttrs = wasNo
    variadic := p.sawVariadic
    p.sawVariadic = false
    k ast.ContractBlock?&p = null
    if named { k = try p.contractHere() }        # D17: a declaration's contract, right after its parameters
    results Array<ast.TypeRef&>&p = Array<ast.TypeRef&>(0)
    noReturn := p.accept(token.Tok.Noreturn)      # D8e: where a result would stand
    if not noReturn and p.startsResult() {
        from := p.tys.Len()
        wasItem := p.item
        p.item = true
        for {
            t := try p.typeExpr() catch {
                p.item = wasItem
                p.tys.Truncate(from)
                error Fail.Syntax
            }
            p.tys.Push(t)
            if one or not p.accept(token.Tok.Comma) { break }
        }
        p.item = wasItem
        results = gather(p.tys, from)
    }
    # E31c: "commutes" after a method's result - a word only there, so no name is taken from programs
    commutes := false
    if named and results.Len() > 0 and p.sees(token.Tok.Iden) and p.text(p.tk()) == "commutes" {
        p.advance()
        commutes = true
    }
    errs := try p.errorSet(one)
    return ast.Sig(params, results, errs.HasErrors, errs.Errors, noReturn, k
                   commutes, variadic)
}

# ---- contracts (D17) ----

# the contract written here, if one is (D17): "[" items "]" right after a declaration's parameters, on the line of
# their ")"; null for none
fn (p mut Parser&) contractHere() ast.ContractBlock?&p ? Fail {
    if not p.sees(token.Tok.LBrack) { return null }
    return try p.contract()
}

# s with a contract k, null for none
fn (p mut Parser&) withContract(s ast.Sig&p, k ast.ContractBlock?&p) ast.Sig&p {
    if k is null { return s }
    return ast.Sig(s.Params, s.Results, s.HasErrors, s.Errors, s.NoReturn, k, s.Commutes, s.Variadic)
}

fn (p mut Parser&) contract() ast.ContractBlock&p ? Fail {
    p.TypeGroups.Push(p.skipFrom(p.pos))
    at := try p.want(token.Tok.LBrack)
    wasItem, wasSkip := p.item, p.skip
    p.item = false
    p.skip = false
    p.brackets++
    defer {
        p.item = wasItem
        p.skip = wasSkip
        p.brackets--
    }
    from := p.stmts.Len()
    chains mut Vec<ast.Outlives&>&p = Vec<ast.Outlives&>()
    p.skipEnds()
    for not p.sees(token.Tok.RBrack) {
        if p.outlivesHere() {
            chains.Push(try p.outlives())
        } else {
            iat := p.here()
            x := try p.expr()
            p.stmts.Push(ast.Stmt.Assert(p.from(iat), x, null))
        }
        if not try p.sep(token.Tok.RBrack) { break }
    }
    p.skipEnds()
    items := gather(p.stmts, from)
    try p.want(token.Tok.RBrack)
    return ast.ContractBlock(p.from(at), items, chains.ToArray())
}

# whether an "outlives" chain starts here: a name or "return", then the word "outlives"
fn (p Parser&) outlivesHere() Bool {
    if not p.sees(token.Tok.Iden) and not p.sees(token.Tok.Return) { return false }
    t := p.lookTok(1)
    return t.Kind == token.Tok.Iden and p.src.Text[t.Start:t.End] == "outlives"
}

fn (p mut Parser&) outlives() ast.Outlives&p ? Fail {
    at := p.here()
    ns mut Vec<source.NameId>&p = Vec<source.NameId>()
    sps mut Vec<source.Span>&p = Vec<source.Span>()
    for {
        t := p.tk()
        if p.accept(token.Tok.Return) {
            ns.Push(source.NameId(0))
        } else {
            ns.Push(try p.name())
        }
        sps.Push(source.Span(t.Start, p.prevEnd))
        n := p.tk()
        if n.Kind != token.Tok.Iden or p.src.Text[n.Start:n.End] != "outlives" { break }
        p.advance()
    }
    return ast.Outlives(p.from(at), ns.ToArray(), sps.ToArray())
}

# whether a signature's result type follows its parameters
fn (p Parser&) startsResult() Bool {
    k := p.peek()
    return k == token.Tok.Iden or k == token.Tok.Mut or k == token.Tok.Fn or k == token.Tok.LParen or
           k == token.Tok.Enum or k == token.Tok.Struct or k == token.Tok.Trait
}

# "[? [A, B.c]]" - a list on one line; one item where the function type or lambda it ends is an item of a list (one),
# so that a "," after it separates the list it stands in (L18c)
fn (p mut Parser&) errorSet(one Bool = false) ast.Sig&p ? Fail {
    if not p.accept(token.Tok.Question) {
        return ast.Sig(Array<ast.Param&>(0), Array<ast.TypeRef&>(0), false, Array<ast.Path&>(0))
    }
    l mut Vec<ast.Path&>&p = Vec<ast.Path&>()
    if p.sees(token.Tok.Iden) {
        for {
            l.Push(try p.path())
            if one or not p.accept(token.Tok.Comma) { break }
        }
    }
    return ast.Sig(Array<ast.Param&>(0), Array<ast.TypeRef&>(0), true, l.ToArray())
}

fn (p mut Parser&) path() ast.Path&p ? Fail {
    at := p.here()
    from := p.ids.Len()
    p.ids.Push(try p.name())
    for p.sees(token.Tok.Dot) {
        p.advance()
        p.ids.Push(try p.methodName())
    }
    parts := gather(p.ids, from)
    return ast.Path(p.from(at), parts)
}

# a parameter list after its "(", through the ")"
fn (p mut Parser&) params(lambda Bool) Array<ast.Param&>&p ? Fail {
    from := p.prms.Len()
    p.brackets++
    wasSkip, wasItem := p.skip, p.item
    p.skip = false
    p.item = true
    defer { p.item = wasItem }
    ok := p.variadicOk
    p.variadicOk = false
    for not p.sees(token.Tok.RParen) {
        # X21: "..." last, in an extern's list - the rest of the arguments C's variable ones
        if ok and p.ellipsis() {
            for _ in range 3 { p.advance() }
            p.sawVariadic = true
            break
        }
        p.prms.Push(try p.param(lambda))
        if not try p.sep(token.Tok.RParen) { break }
    }
    p.skip = wasSkip
    p.brackets--
    try p.want(token.Tok.RParen)
    ps := gather(p.prms, from)
    p.spreadRules(ps, ok, p.spreadOk)
    p.spreadOk = false
    return ps
}

# D8g: a variadic parameter is a function's (a method's, a lambda's, a function type's), never an extern's - whose
# variable arguments are C's "..." - a constructor's or a case's; one of them, with no default, only defaulted
# parameters after it (given by name)
fn (p mut Parser&) spreadRules(ps Array<ast.Param&>&, inExtern Bool, allowed Bool) {
    seen := -1
    for i in range ps.Len() {
        ty := ps[i].Ty
        if seen >= 0 and ps[i].Dflt is null {
            p.report(ps[i].Sp.Start, ps[i].Sp.End, msgs.VariadicNotLast())
            return
        }
        if ty is null or not isSpreadType(ty) { continue }
        if inExtern or not allowed {
            p.report(ty.Span().Start, ty.Span().End, msgs.VariadicHere("an extern's - C's variable arguments are '...'" if inExtern else "a constructor's or a case's - take an array, 'xs Array<T>&'"))
            return
        }
        if seen >= 0 {
            p.report(ps[i].Sp.Start, ps[i].Sp.End, msgs.VariadicNotLast())
            return
        }
        if ps[i].Dflt is not null { p.report(ps[i].Dflt!.Span().Start, ps[i].Dflt!.Span().End, msgs.VariadicDefault()) }
        seen = i
    }
}

fn isSpreadType(t ast.TypeRef&) Bool {
    match t {
        case ast.TypeRef.Spread(_, _) { return true }
        case _ { return false }
    }
}

# whether "..." stands here: three dots, nothing between them
fn (p Parser&) ellipsis() Bool {
    if not p.sees(token.Tok.Dot) or p.look(1) != token.Tok.Dot or p.look(2) != token.Tok.Dot { return false }
    return not p.lookTok(1).Has(token.Space) and not p.lookTok(2).Has(token.Space)
}

fn (p mut Parser&) param(lambda Bool) ast.Param&p ? Fail {
    attrs := try p.attrsHere()
    # G39: a lambda's, a function type's parameters and a receiver are no declaration reflection reads
    if lambda or p.noAttrs {
        p.attrRefused(attrs)
        attrs = Array<ast.Attr&>(0)
    }
    at := p.here()
    name := try p.name()
    ty ast.TypeRef?&p = null
    if p.ellipsis() {
        # D8g: "xs ...T" - a variadic parameter, the call's arguments there gathered into a read-only array
        sat := p.here()
        for _ in range 3 { p.advance() }
        of := try p.typeExpr()
        ty = ast.TypeRef.Spread(p.from(sat), of)
    } else if not (lambda and (p.sees(token.Tok.Comma) or p.sees(token.Tok.RParen) or p.sees(token.Tok.StmtEnd))) {
        ty = try p.typeExpr()
    }
    dflt ast.Expr?&p = null
    if p.accept(token.Tok.Assign) { dflt = try p.expr() }
    p.declareAttrs(attrs)
    return ast.Param(p.from(at), name, ty, dflt, attrs)
}

# after a list's ",": its closing bracket may follow only from a line of its own (L18a)
fn (p mut Parser&) trailing(close token.Tok) ? Fail {
    if p.sees(close) and not p.breakBefore() {
        p.report(p.prevEnd - 1, p.prevEnd, msgs.TrailingComma(msgs.Tok(close.Text())))
        error Fail.Syntax
    }
}

# QY/L18a: whether another item of a list follows - items on one line are separated by ",", items on different lines by
# the line break: a statement end L18 put there, or, after an item ending in "}", ">" or a bare "&" (after which L18
# puts none), the next token beginning a later line. A separator before the list's closer ends the list; a "," on the
# closer's own line is a trailing comma. A comma ending a line was reported by the scanner, and is read as the line break
fn (p mut Parser&) sep(close token.Tok) Bool ? Fail {
    if p.accept(token.Tok.Comma) {
        try p.trailing(close)
        return not p.sees(close)
    }
    if p.sees(token.Tok.StmtEnd) {
        p.skipEnds()
        return not p.sees(close)
    }
    pk := p.prevKind
    if (pk == token.Tok.RBrace or pk == token.Tok.Gt or pk == token.Tok.Amp) and p.breakBefore() {
        return not p.sees(close) and not p.sees(token.Tok.Eof)
    }
    return false
}

# ---- types ----

fn (p mut Parser&) typeExpr() ast.TypeRef&p ? Fail {
    at := p.here()
    writable := p.accept(token.Tok.Mut)
    t := try p.typeBase()
    t = p.markers(at, t)
    if writable { return ast.TypeRef.Perm(p.from(at), t, writable, false) }
    return t
}

fn (p mut Parser&) typeBase() ast.TypeRef&p ? Fail {
    at := p.here()
    match p.peek() {
        case token.Tok.Fn {
            p.advance()
            s := try p.sig(false, true)
            return ast.TypeRef.Func(p.from(at), s)
        }
        case token.Tok.Enum, token.Tok.Struct, token.Tok.Trait {
            body := try p.typeBody()
            return ast.TypeRef.Shape(p.from(at), body!)
        }
        case token.Tok.Iden {
            # T32, L9c: "any" before a type's name on its line - a run-time trait value
            if p.anyHere() {
                p.advance()
                of := try p.typeBase()
                return ast.TypeRef.Any(p.from(at), of)
            }
            from := p.ids.Len()
            p.ids.Push(try p.name())
            for p.sees(token.Tok.Dot) {
                p.advance()
                p.ids.Push(try p.name())
            }
            path := gather(p.ids, from)
            args Array<ast.TypeRef&>&p = Array<ast.TypeRef&>(0)
            if p.sees(token.Tok.Lt) { args = try p.typeArgs() }
            return ast.TypeRef.Named(p.from(at), path, args)
        }
        # L18c: a function type an item of a list, parenthesized whole where it holds a comma of its own
        case token.Tok.LParen {
            p.TypeGroups.Push(p.skipFrom(p.pos))
            p.advance()
            wasItem, wasSkip := p.item, p.skip
            p.item = false
            p.skip = false
            t := try p.typeExpr() catch {
                p.item = wasItem
                p.skip = wasSkip
                error Fail.Syntax
            }
            p.item = wasItem
            p.skip = wasSkip
            if not p.sees(token.Tok.RParen) and not isFuncType(t) {
                # "(I64, I64)": types bare, as several results are written (D8c)
                p.report(at, p.prevEnd, msgs.NeedlessGroup())
                error Fail.Syntax
            }
            try p.want(token.Tok.RParen)
            if not p.grouped(t) {
                p.report(at, p.prevEnd, msgs.NeedlessGroup())
                error Fail.Syntax
            }
            return t
        }
        # QW: a variable is introduced in the list after a function's name, never as "<T>" in a parameter's type
        case token.Tok.Lt { try p.fail("a name") }
        case _ { try p.fail("a type") }
    }
    unreachable
}

# L9c: whether the next word is "any" with a type's name after it on its line
fn (p Parser&) anyHere() Bool {
    if p.half != token.Tok.Eof or p.look(1) != token.Tok.Iden or p.lookTok(1).Has(token.LineBreak) { return false }
    t := p.tk()
    return t.End - t.Start == 3 and p.src.Text[I64(t.Start):I64(t.End)] == "any"
}

fn isFuncType(t ast.TypeRef&) Bool {
    return match t {
        case ast.TypeRef.Func(_, _): true
        case _: false
    }
}

# L18c: whether a parenthesized type is grouped as it may be - a function type holding a comma of its own (several
# results or several error items), or one with no error set before the "?" of the signature it is a result of
fn (p Parser&) grouped(t ast.TypeRef&) Bool {
    match t {
        case ast.TypeRef.Func(_, s) {
            if s.Results.Len() > 1 or s.Errors.Len() > 1 { return true }
            return not s.HasErrors and p.sees(token.Tok.Question)
        }
        case _ { return false }
    }
}

# reference markers after a type - "&", "&x" (x on the "&"'s own line), "&return"; a second one is the checker's to
# report (T24)
fn (p mut Parser&) markers(at I32, t ast.TypeRef&p) ast.TypeRef&p {
    r ast.TypeRef&p = t
    for p.half == token.Tok.Eof and (p.sees(token.Tok.Amp) or p.nullMark()) {
        nullable := p.sees(token.Tok.Question)
        if nullable { p.advance() }
        p.advance()
        scope source.NameId = source.NameId(0)
        k := p.peek()
        if (k == token.Tok.Iden or k == token.Tok.Return) and not p.breakBefore() {
            nt := p.tk()
            p.advance()
            scope = p.names.Intern(p.text(nt))
        }
        r = ast.TypeRef.Ref(p.from(at), r, scope, nullable)
    }
    return r
}

# T2c: "?&", the "?" written directly before the "&" - never an error set's "?", which no "&" follows
fn (p Parser&) nullMark() Bool {
    if not p.sees(token.Tok.Question) or p.look(1) != token.Tok.Amp { return false }
    return p.lookTok(0).End == p.lookTok(1).Start
}

fn (p Parser&) closesAngle() Bool {
    k := p.peek()
    return k == token.Tok.Gt or k == token.Tok.Shr or k == token.Tok.Ge or k == token.Tok.ShrEq
}

# G12, C#'s rule: whether the "<" n tokens ahead opens a type-argument list a call follows - the "<" directly after the
# name, the tokens types are made of (names, ".", ",", "&", "?", "mut", "fn", "return", parentheses), angle brackets
# balanced on one line, and "(" directly after the closing ">". So "x.Narrow<I32>()" and "f<T>(a)" are calls given type
# arguments, as a known generic function's or type's name always is; "a < b and c > (d)" and "k < m > (0)" are
# comparisons
fn (p Parser&) typeArgsCall(n I64) Bool { return p.typeArgsShape(n) == 2 }

# whether the "<" n tokens ahead would open type arguments by C#'s rule but for the spaces around them, with "()"
# after - which no comparison has: written "f <T> ()" for "f<T>()"
fn (p Parser&) spacedTypeArgs(n I64) Bool { return p.typeArgsShape(n) == 1 }

# 0: no type-argument list; 1: the tokens of one with "()" after, spaced from the name or the "("; 2: one touching both
fn (p Parser&) typeArgsShape(n I64) I64 {
    if p.look(n) != token.Tok.Lt or p.half != token.Tok.Eof { return 0 }
    before := p.prevEnd if n == 0 else p.lookTok(n - 1).End
    touching := p.lookTok(n).Start == before
    depth I64 = 0
    parens I64 = 0
    i := n
    for i < n + 256 {
        k := p.look(i)
        if k == token.Tok.Lt {
            depth++
        } else if k == token.Tok.Gt {
            depth--
        } else if k == token.Tok.Shr {
            depth -= 2
        } else if k == token.Tok.LParen {
            parens++
        } else if k == token.Tok.RParen {
            if parens == 0 { return 0 }
            parens--
        } else if k != token.Tok.Iden and k != token.Tok.Dot and k != token.Tok.Comma and k != token.Tok.Amp and
                  k != token.Tok.Question and k != token.Tok.Mut and k != token.Tok.Fn and k != token.Tok.Return {
            return 0
        }
        if depth < 0 { return 0 }
        if depth == 0 {
            if parens != 0 or p.look(i + 1) != token.Tok.LParen { return 0 }
            if touching and p.lookTok(i).End == p.lookTok(i + 1).Start { return 2 }
            return 1 if p.look(i + 2) == token.Tok.RParen else 0
        }
        i++
    }
    return 0
}

# "<" where one opens a type-argument or a type-parameter list
fn (p mut Parser&) openAngle() ? Fail {
    try p.want(token.Tok.Lt)
    p.ArgAngles.Push(p.pos - 1)
}

# ">" closing a type-argument list: ">>", ">=" and ">>=" are split, the rest read next - a half may split again
fn (p mut Parser&) closeAngle() ? Fail {
    k := p.peek()
    if not p.closesAngle() { try p.fail(token.Tok.Gt.Describe()) }
    at := p.advance()
    p.CloseAngles.Push(p.pos - 1)
    if k == token.Tok.Gt { return }
    p.half = token.Tok.Gt if k == token.Tok.Shr else (token.Tok.Assign if k == token.Tok.Ge else token.Tok.Ge)
    p.halfStart = at + 1
    p.prevKind = token.Tok.Gt
    p.prevEnd = at + 1
}

# "<" type {"," type} ">"
fn (p mut Parser&) typeArgs() Array<ast.TypeRef&>&p ? Fail {
    try p.openAngle()
    wasNoGt := p.noGt
    p.noGt = true
    wasSkip, wasItem := p.skip, p.item
    p.skip = false
    p.item = true
    defer { p.item = wasItem }
    from := p.tys.Len()
    for {
        # G8, QAH: "? A, B" closes the list - the error set given for the type's error-set parameter
        if p.sees(token.Tok.Question) {
            p.tys.Push(try p.errsArg())
            break
        }
        p.tys.Push(try p.typeArg())
        if p.sees(token.Tok.Question) { continue }
        if not try p.sep(token.Tok.Gt) { break }
    }
    p.skip = wasSkip
    p.noGt = wasNoGt
    try p.closeAngle()
    return gather(p.tys, from)
}

# an error-set argument (G8, QAH): "?" and the error set's items, on its line, up to the list's ">"
fn (p mut Parser&) errsArg() ast.TypeRef&p ? Fail {
    at := p.here()
    try p.want(token.Tok.Question)
    l mut Vec<ast.Path&>&p = Vec<ast.Path&>()
    for {
        l.Push(try p.path())
        if not p.accept(token.Tok.Comma) { break }
    }
    return ast.TypeRef.Errs(p.from(at), l.ToArray())
}

# a type argument: a type (G8) - a length is never one (T7)
fn (p mut Parser&) typeArg() ast.TypeRef&p ? Fail {
    return try p.typeExpr()
}

# the type an expression path names, where only a type can stand (a comprehension's element type)
fn (p mut Parser&) exprAsType(x ast.Expr&p) ast.TypeRef&p ? Fail {
    from := p.ids.Len()
    e ast.Expr&p = x
    for {
        match e {
            case ast.Expr.Name(_, n) {
                p.ids.Push(n)
                break
            }
            case ast.Expr.Member(_, b, n) {
                p.ids.Push(n)
                e = b
            }
            case _ {
                p.ids.Truncate(from)
                try p.fail("an element type before the [, as in I32[...]")
            }
        }
    }
    parts := gather(p.ids, from)
    rev mut Array<source.NameId>&p = Array<source.NameId>(parts.Len())
    for i in range parts.Len() { rev[i] = parts[parts.Len() - 1 - i] }
    return ast.TypeRef.Named(x.Span(), rev, Array<ast.TypeRef&>(0))
}

# ---- statements ----

fn (p mut Parser&) block() Array<ast.Stmt&>&p ? Fail {
    if not p.sees(token.Tok.LBrace) { try p.fail(token.Tok.LBrace.Describe()) }
    try p.enter()
    defer p.leave()
    open := p.tk()
    p.advance()
    wasCtor := p.inCtor
    p.inCtor = p.ctorBody
    p.ctorBody = false
    defer { p.inCtor = wasCtor }
    wasBrackets := p.brackets
    p.brackets = 0
    defer { p.brackets = wasBrackets }
    wasSkip := p.skip
    p.skip = false
    defer { p.skip = wasSkip }
    wasItem := p.item
    p.item = false
    defer { p.item = wasItem }
    wasLine := p.inLine
    p.inLine = false
    defer { p.inLine = wasLine }
    wasLam, wasLamItem := p.inLam, p.lamItem
    p.inLam, p.lamItem = false, false
    defer {
        p.inLam = wasLam
        p.lamItem = wasLamItem
    }
    from := p.stmts.Len()
    for {
        p.skipEnds()
        if p.sees(token.Tok.RBrace) or p.sees(token.Tok.Eof) { break }
        if p.declHere() {
            # a declaration where a statement stands: the block was never closed
            if not p.tooDeep and not p.unclosed {
                line := p.src.Line(open.Start)
                t := p.tk()
                where := diag.Where.Span(p.file, I64(t.Start), I64(t.End))
                p.diags.ErrorUnheld(where, msgs.BlockNotClosed(I64(line), p.found()))
            }
            p.stmts.Truncate(from)
            p.unclosed = true
            error Fail.Syntax
        }
        marks := p.marks()
        start := p.pos
        # G39: a constructor's field may have attributes; nothing else in a block takes them
        fattrs Array<ast.Attr&>&p = Array<ast.Attr&>(0)
        if p.sees(token.Tok.At) {
            fattrs = try p.attrs() catch {
                p.release(marks)
                p.syncStmt(start)
                continue
            }
            if not p.inCtor {
                p.attrRefused(fattrs)
                fattrs = Array<ast.Attr&>(0)
            }
        }
        s := try p.stmt() catch {
            if p.tooDeep or p.unclosed {
                p.stmts.Truncate(from)
                error Fail.Syntax
            }
            p.release(marks)
            p.skip = false
            p.syncStmt(start)
            continue
        }
        if fattrs.Len() > 0 { s = p.fieldAttrs(s, fattrs) }
        p.stmts.Push(s)
    }
    if not p.sees(token.Tok.RBrace) {
        p.stmts.Truncate(from)
        try p.fail(token.Tok.RBrace.Describe())
    }
    p.advance()
    return gather(p.stmts, from)
}

# a constructor's field with the attributes written before it (G39): one field declared with its type or its value - a
# pun is its parameter, whose attributes it has
fn (p mut Parser&) fieldAttrs(s ast.Stmt&p, attrs Array<ast.Attr&>&p) ast.Stmt&p {
    match s {
        case ast.Stmt.Var(sp, v) {
            if v.Field and v.Names.Len() == 1 and (v.Ty is not null or v.Values.Len() > 0) {
                p.declareAttrs(attrs)
                return ast.Stmt.Var(sp, ast.VarDecl(v.Names, v.NameSps, v.Ty, v.Values, v.Infer, v.Field, attrs))
            }
            if v.Field and v.Names.Len() == 1 {
                a := attrs[0].Sp
                p.report(a.Start, a.End, msgs.AttrPun(p.names.Text(v.Names[0])))
                return s
            }
        }
        case _ { }
    }
    p.attrRefused(attrs)
    return s
}

fn (p mut Parser&) stmt() ast.Stmt&p ? Fail {
    at := p.here()
    if p.inCtor and p.keywordFieldHere() { return try p.fieldDecl() }
    p.stmtRoom()
    match p.peek() {
        case token.Tok.If {
            s := try p.ifStmt()
            return s
        }
        case token.Tok.For { return try p.forStmt() }
        case token.Tok.Comptime if p.look(1) == token.Tok.For {
            # K3a: "comptime for x in e { }", unrolled while compiling
            p.advance()
            return try p.forStmt(at)
        }
        case token.Tok.Do {
            p.advance()
            body := try p.block()
            try p.want(token.Tok.For)
            cond := try p.expr()
            sp := p.from(at)
            try p.endStmt()
            return ast.Stmt.DoFor(sp, body, cond)
        }
        case token.Tok.Match {
            m := try p.matchBody(false)
            sp := p.from(at)
            if p.sees(token.Tok.StmtEnd) { p.advance() }
            return ast.Stmt.MatchS(sp, m)
        }
        case token.Tok.Return {
            p.advance()
            values Array<ast.Expr&>&p = Array<ast.Expr&>(0)
            if not p.atEnd() and p.lamItem {
                # a lambda's one-line body, the lambda an item of a list: its "," is the list's (L18c)
                values = ast.Expr&[try p.expr()]
            } else if not p.atEnd() {
                p.listTry = p.here()
                values = try p.exprList()
            }
            sp := p.from(at)
            try p.endStmt()
            return ast.Stmt.Return(sp, values)
        }
        case token.Tok.Become {
            # S21: a guaranteed tail call
            p.advance()
            x := try p.expr()
            sp := p.from(at)
            try p.endStmt()
            return ast.Stmt.Become(sp, x)
        }
        case token.Tok.Yield {
            # QAG: a generator's value, handed to the Next that asked for it
            p.advance()
            x := try p.expr()
            sp := p.from(at)
            try p.endStmt()
            return ast.Stmt.Yield(sp, x)
        }
        case token.Tok.Break, token.Tok.Continue, token.Tok.Unreachable {
            k := p.peek()
            p.advance()
            # S16d: "unreachable why" - a message, evaluated only where it is reached
            msg ast.Expr?&p = null
            if k == token.Tok.Unreachable and not p.atEnd() {
                msg = try p.expr()
            }
            sp := p.from(at)
            try p.endStmt()
            return ast.Stmt.Jump(sp, k, msg)
        }
        case token.Tok.Assert {
            p.advance()
            cond := try p.expr()
            msg ast.Expr?&p = null
            if p.accept(token.Tok.Comma) { msg = try p.expr() }
            sp := p.from(at)
            try p.endStmt()
            return ast.Stmt.Assert(sp, cond, msg)
        }
        case token.Tok.Error {
            p.advance()
            word := try p.path()
            sp := p.from(at)
            try p.endStmt()
            return ast.Stmt.Raise(sp, word)
        }
        case token.Tok.Spawn {
            p.advance()
            from := p.exprs.Len()
            for {
                p.exprs.Push(try p.expr())
                if not p.accept(token.Tok.Comma) { break }
            }
            if p.accept(token.Tok.Assign) {
                targets := gather(p.exprs, from)
                if targets.Len() > 1 { p.listTry = p.here() }
                call := try p.expr()
                sp := p.from(at)
                try p.endStmt()
                return ast.Stmt.Spawn(sp, targets, call)
            }
            if p.exprs.Len() - from != 1 {
                p.exprs.Truncate(from)
                try p.fail(token.Tok.Assign.Describe())
            }
            call := p.exprs[from]
            p.exprs.Truncate(from)
            sp := p.from(at)
            try p.endStmt()
            return ast.Stmt.Spawn(sp, Array<ast.Expr&>(0), call)
        }
        case token.Tok.Join {
            j := try p.joinRest(false)
            return ast.Stmt.Join(p.from(at), j)
        }
        case token.Tok.Defer, token.Tok.ErrDefer {
            onError := p.sees(token.Tok.ErrDefer)
            p.advance()
            if p.sees(token.Tok.LBrace) {
                body := try p.block()
                sp := p.from(at)
                if p.sees(token.Tok.StmtEnd) { p.advance() }
                return ast.Stmt.Defer(sp, ast.Stmt.Block(sp, body), onError)
            }
            s := try p.stmt()
            return ast.Stmt.Defer(p.from(at), s, onError)
        }
        case token.Tok.LBrace {
            body := try p.block()
            sp := p.from(at)
            if p.sees(token.Tok.StmtEnd) { p.advance() }
            return ast.Stmt.Block(sp, body)
        }
        case token.Tok.Try { return try p.tryStmt() }
        case token.Tok.Iden { return try p.idenStmt() }
        case _ { return try p.exprStmt() }
    }
    unreachable
}

# L9a: the keywords a field may be named by
fn keywordNamesField(k token.Tok) Bool {
    return match k {
        case token.Tok.Break, token.Tok.Continue, token.Tok.Unreachable, token.Tok.In, token.Tok.Is, token.Tok.As, token.Tok.And, token.Tok.Or: true
        case token.Tok.Xor, token.Tok.Range, token.Tok.Case, token.Tok.Type, token.Tok.Struct: true
        case token.Tok.Enum, token.Tok.Trait, token.Tok.Extends, token.Tok.Import, token.Tok.Test: true
        case token.Tok.Extern, token.Tok.Default: true
        case _: false
    }
}

# whether a keyword at a constructor's statement start declares a field named by it: a type follows on its line
fn (p Parser&) keywordField() Bool {
    n := p.lookTok(1)
    if n.Has(token.LineBreak) { return false }
    k := n.Kind
    return k != token.Tok.StmtEnd and k != token.Tok.Assign and k != token.Tok.Dot and k != token.Tok.LParen and
           k != token.Tok.Comma and k != token.Tok.Eof and k != token.Tok.RBrace
}

# whether a keyword at a constructor's statement start declares a field and no declaration: "test := 1" is a field and
# "test "t" {" a test, "type String& = s" a field and "type T struct(...) {" a type - a type's line holds a shape's
# keyword or a "{", a field's none
fn (p Parser&) keywordFieldHere() Bool {
    k := p.peek()
    if not keywordNamesField(k) or not p.keywordField() { return false }
    n := p.look(1)
    if n == token.Tok.StrLit or n == token.Tok.Fn { return false }
    if k != token.Tok.Type { return true }
    line := p.lineAt(p.pos)
    i := p.pos + 1
    for i < p.ts.Toks.Len() and p.lineAt(i) == line {
        ki := p.kindAt(i)
        if ki == token.Tok.Struct or ki == token.Tok.Enum or ki == token.Tok.Trait or ki == token.Tok.Extends or
           ki == token.Tok.LBrace {
            return false
        }
        i++
    }
    return true
}

# a constructor field named by a keyword: "done I64 = 0", "in := x"
fn (p mut Parser&) fieldDecl() ast.Stmt&p ? Fail {
    at := p.here()
    nt := p.tk()
    p.advance()
    name := p.names.Intern(p.text(nt))
    return try p.varDecl(at, p.one(name, source.Span(nt.Start, nt.End)))
}

# a statement starting with a name: a declaration, a field (in a constructor), or an expression or an assignment
fn (p mut Parser&) idenStmt() ast.Stmt&p ? Fail {
    at := p.here()
    k2 := p.look(1)
    if p.inCtor and (k2 == token.Tok.StmtEnd or k2 == token.Tok.RBrace or k2 == token.Tok.Eof) {
        nt := p.tk()
        name := try p.name()
        sp := p.from(at)
        try p.endStmt()
        v := ast.VarDecl(Array<source.NameId>(1, name), Array<source.Span>(1, source.Span(nt.Start, nt.End))
                         null, Array<ast.Expr&>(0), false, true)
        return ast.Stmt.Var(sp, v)
    }
    if k2 == token.Tok.Define or k2 == token.Tok.Iden or k2 == token.Tok.Mut or
       k2 == token.Tok.Fn or k2 == token.Tok.Enum or k2 == token.Tok.Struct {
        nt := p.tk()
        name := try p.name()
        return try p.varDecl(at, p.one(name, source.Span(nt.Start, nt.End)))
    }
    return try p.exprStmt()
}

# the names of a declaration list, held while its type and values are read
fn (p mut Parser&) varDecl(at I32, names NameList&) ast.Stmt&p ? Fail {
    v := try p.declRest(names, p.inCtor)
    sp := p.from(at)
    if p.inCtor and p.sees(token.Tok.Comma) {
        # fields on one line are separated by "," (C2, QY)

        n := names.Names.Len()
        if n > 1 and v.Values.Len() == 0 {
            # "a, b T," is no list of fields: each name before the last is a field of its own (a pun), the comma
            # after it a separator, and the last takes the type
            for i in range n - 1 {
                ns := names.Sps[i]
                pun := ast.VarDecl(Array<source.NameId>(1, names.Names[i]), Array<source.Span>(1, ns), null
                                   Array<ast.Expr&>(0), false, true)
                p.stmts.Push(ast.Stmt.Var(ns, pun))
            }
            last := names.Sps[n - 1]
            p.advance()
            return ast.Stmt.Var(source.Span(last.Start, sp.End), p.lastField(v, names.Names[n - 1], last))
        }
        p.advance()
        return ast.Stmt.Var(sp, v)
    }
    try p.endStmt()
    return ast.Stmt.Var(sp, v)
}

# the last name of "a, b T," with the declaration's type: a field of its own
fn (p Parser&) lastField(v ast.VarDecl&p, name source.NameId, sp source.Span) ast.VarDecl&p {
    return ast.VarDecl(Array<source.NameId>(1, name), Array<source.Span>(1, sp), v.Ty, Array<ast.Expr&>(0), v.Infer, true)
}

# "[mut] T [= v, ...]" or ":= v, ..." after the names of a declaration
fn (p mut Parser&) declRest(names NameList&, field Bool) ast.VarDecl&p ? Fail {
    if p.sees(token.Tok.Mut) and p.look(1) == token.Tok.Define {
        # "x mut := v": ":=" already gives the permission, which the checker says (D11a, C3)
        mat := p.advance()
        perm := ast.TypeRef.Perm(source.Span(mat, p.prevEnd), null, true, false)
        p.advance()
        values := try p.values(names, field)
        return ast.VarDecl(names.Names, names.Sps, perm, values, true, field)
    }
    if p.accept(token.Tok.Define) {
        values := try p.values(names, field)
        if names.Names.Len() > 1 and values.Len() != names.Names.Len() { p.countDiag(names, values.Len()) }
        return ast.VarDecl(names.Names, names.Sps, null, values, true, field)
    }
    ty := try p.typeExpr()
    values Array<ast.Expr&>&p = Array<ast.Expr&>(0)
    if p.accept(token.Tok.Assign) {
        values = try p.values(names, field)
        if values.Len() != names.Names.Len() and names.Names.Len() > 1 { p.countDiag(names, values.Len()) }
    }
    return ast.VarDecl(names.Names, names.Sps, ty, values, false, field)
}

# a declaration's values; a constructor field's no more than it has names, a comma after them separating the next
# field (T17, T19, C2)
fn (p mut Parser&) values(names NameList&, field Bool) Array<ast.Expr&>&p ? Fail {
    if not field { return try p.exprList() }
    from := p.exprs.Len()
    for {
        p.exprs.Push(try p.expr())
        if p.exprs.Len() - from >= names.Names.Len() or not p.accept(token.Tok.Comma) { break }
    }
    return gather(p.exprs, from)
}

fn (p mut Parser&) countDiag(names NameList&, values I64) {
    sp := names.Sps[0]
    p.report(sp.Start, sp.End, msgs.VarListCount(names.Names.Len(), values))
}

# a top-level declaration of names: "X I32 = 1", "X, Y mut I32 = 0, 0", "X := 3"
fn (p mut Parser&) declNames(field Bool) ast.VarDecl&p ? Fail {
    from := p.ids.Len()
    sfrom := p.sps.Len()
    for {
        nt := p.tk()
        p.ids.Push(try p.name())
        p.sps.Push(source.Span(nt.Start, nt.End))
        if not p.accept(token.Tok.Comma) { break }
    }
    names := NameList(gather(p.ids, from), gather(p.sps, sfrom))
    return try p.declRest(names, field)
}

# the names of a declaration list and the span of each
type NameList struct(Names Array<source.NameId>&, Sps Array<source.Span>&) {
    Names
    Sps
}

# one name and its span, as a declaration list
fn (p Parser&) one(n source.NameId, sp source.Span) NameList&p {
    return NameList(Array<source.NameId>(1, n), Array<source.Span>(1, sp))
}

fn isAssignOp(k token.Tok) Bool {
    return match k {
        case token.Tok.Assign, token.Tok.PlusEq, token.Tok.MinusEq, token.Tok.StarEq, token.Tok.SlashEq: true
        case token.Tok.StarStarEq: true
        case token.Tok.PercentEq, token.Tok.ShlEq, token.Tok.ShrEq, token.Tok.AmpEq, token.Tok.PipeEq: true
        case token.Tok.CaretEq: true
        case _: false
    }
}

# an expression standing as a statement, an assignment, or - after a list - a declaration or a destructuring (the
# cover grammar of DESIGN.md point 3)
fn (p mut Parser&) exprStmt() ast.Stmt&p ? Fail {
    at := p.here()
    first := try p.expr()
    if p.sees(token.Tok.Comma) {
        from := p.exprs.Len()
        p.exprs.Push(first)
        for p.accept(token.Tok.Comma) { p.exprs.Push(try p.expr()) }
        targets := gather(p.exprs, from)
        if p.sees(token.Tok.Define) and p.inCtor {
            names := try p.namesOf(targets)
            return try p.varDecl(at, names)
        }
        if p.accept(token.Tok.Define) or p.accept(token.Tok.Assign) {
            define := p.prevKind == token.Tok.Define
            p.listTry = p.here()
            values := try p.exprList()
            sp := p.from(at)
            try p.endStmt()
            return ast.Stmt.Multi(sp, ast.Multi(targets, define, values))
        }
        names := try p.namesOf(targets)
        if p.inCtor and (p.sees(token.Tok.StmtEnd) or p.sees(token.Tok.RBrace) or p.sees(token.Tok.Eof)) {
            sp := p.from(at)
            try p.endStmt()
            return ast.Stmt.Var(sp, ast.VarDecl(names.Names, names.Sps, null, Array<ast.Expr&>(0), false, true))
        }
        return try p.varDecl(at, names)
    }
    k := p.peek()
    if isAssignOp(k) {
        p.advance()
        value := try p.expr()
        sp := p.from(at)
        try p.endStmt()
        return ast.Stmt.Assign(sp, k, first, value)
    }
    sp := p.from(at)
    try p.endStmt()
    return ast.Stmt.ExprS(sp, first)
}

# the names a list of targets is, where names are wanted; anything else is not where it can stand
fn (p mut Parser&) namesOf(targets Array<ast.Expr&>&) NameList&p ? Fail {
    names mut Array<source.NameId>&p = Array<source.NameId>(targets.Len())
    sps mut Array<source.Span>&p = Array<source.Span>(targets.Len())
    for i, t in targets {
        match t {
            case ast.Expr.Name(sp, n) {
                names[i] = n
                sps[i] = sp
            }
            case _ { try p.fail(token.Tok.Assign.Describe()) }
        }
    }
    return NameList(names, sps)
}

# "try" leading a statement: a guarded call, a checked store (R21), or a join that can fail (P4c)
# L21 in a try statement, as stage 0 counts it: read as an expression, "try X" is the try's level and X's, so with fewer
# than two levels left the limit is said at X first; a store's target and a call with clauses are read at one level, a
# try with no clause (an expression) at two
fn (p mut Parser&) tryStmt() ast.Stmt&p ? Fail {
    at := p.advance()
    if p.depth + 2 > MaxNesting { p.tooDeepAt(p.pos) }
    was := p.limitAt
    defer { p.limitAt = was }
    p.limitAt = -1
    if p.sees(token.Tok.Join) {
        j := try p.joinRest(true)
        return ast.Stmt.Join(p.from(at), j)
    }
    if p.sees(token.Tok.Inc) or p.sees(token.Tok.Dec) {
        x := try p.unary()
        inner := ast.Stmt.ExprS(x.Span(), x)
        cl := try p.clauses(false)
        sp := p.from(at)
        try p.endStmt()
        return ast.Stmt.TryStore(sp, inner, cl)
    }
    x := try p.postfix()
    k := p.peek()
    if isAssignOp(k) {
        p.advance()
        value := try p.expr()
        inner := ast.Stmt.Assign(source.Span(x.Span().Start, p.prevEnd), k, x, value)
        cl := try p.clauses(false)
        sp := p.from(at)
        try p.endStmt()
        return ast.Stmt.TryStore(sp, inner, cl)
    }
    match x {
        case ast.Expr.Postfix(_, op, _) {
            if op == token.Tok.Inc or op == token.Tok.Dec {
                inner := ast.Stmt.ExprS(x.Span(), x)
                cl := try p.clauses(false)
                sp := p.from(at)
                try p.endStmt()
                return ast.Stmt.TryStore(sp, inner, cl)
            }
        }
        case _ { }
    }
    # E24: the whole expression the postfix begins, then the clauses
    x = try p.binaryFrom(x, 1)
    x = try p.condFrom(x)
    reached := p.limitAt
    cl := try p.clauses(false)
    if cl.Len() == 0 and reached >= 0 {
        p.tooDeepAt(reached)
        error Fail.Syntax
    }
    e ast.Expr&p = ast.Expr.Try(p.from(at), x, cl)
    sp := p.from(at)
    try p.endStmt()
    return ast.Stmt.ExprS(sp, e)
}

# "join { body } [catch ...]" - "try" already read when tried
fn (p mut Parser&) joinRest(tried Bool) ast.JoinS&p ? Fail {
    try p.want(token.Tok.Join)
    body := try p.block()
    cl := try p.clauses(false)
    if p.sees(token.Tok.StmtEnd) { p.advance() }
    return ast.JoinS(tried, body, cl)
}

fn (p mut Parser&) ifStmt() ast.Stmt&p ? Fail {
    at := try p.want(token.Tok.If)
    cond := try p.expr()
    then := try p.branch()
    els ast.Stmt?&p = null
    if p.accept(token.Tok.Else) {
        if p.sees(token.Tok.If) {
            els = try p.ifStmt()
        } else {
            b := try p.branch()
            els = ast.Stmt.If(b.Sp, ast.If(null, b, null))
        }
    }
    sp := p.from(at)
    if p.sees(token.Tok.StmtEnd) { p.advance() }
    return ast.Stmt.If(sp, ast.If(cond, then, els))
}

# an if's block, holding the diagnostics its parse met (DESIGN.md point 12): one that does not parse is kept as its
# span, bounded by its matching "}" from the brace table
fn (p mut Parser&) branch() ast.Branch&p ? Fail {
    at := p.here()
    if p.sees(token.Tok.Colon) {
        g := p.diags.Hold()
        body := try p.lineBody() catch {
            p.diags.EndHold()
            if p.tooDeep or p.unclosed { error Fail.Syntax }
            p.syncFrom()
            return ast.Branch(p.from(at), Array<ast.Stmt&>(0), g)
        }
        p.diags.EndHold()
        return ast.Branch(p.from(at), body, g)
    }
    if not p.sees(token.Tok.LBrace) { try p.fail(token.Tok.LBrace.Describe()) }
    g := p.diags.Hold()
    open := p.pos
    body := try p.block() catch {
        p.diags.EndHold()
        if p.tooDeep or p.unclosed { error Fail.Syntax }
        close := p.ts.Match(I32(open))
        if close < 0 { error Fail.Syntax }
        p.pos = I64(close)
        p.half = token.Tok.Eof
        p.advance()
        return ast.Branch(p.from(at), Array<ast.Stmt&>(0), g)
    }
    p.diags.EndHold()
    return ast.Branch(p.from(at), body, g)
}

# a loop's body: a block, or a one-line body (S1b)
fn (p mut Parser&) body() Array<ast.Stmt&>&p ? Fail {
    if p.sees(token.Tok.Colon) { return try p.lineBody() }
    return try p.block()
}

# a lambda's body (D16): a block, or a one-line body (S1b) - its statement ending at its line's end, or at what closes
# the bracket the lambda stands in or a comma of that bracket's list
fn (p mut Parser&) lambdaBody(item Bool) Array<ast.Stmt&>&p ? Fail {
    if not p.sees(token.Tok.Colon) { return try p.block() }
    wasLam, wasItem := p.inLam, p.lamItem
    p.inLam, p.lamItem = true, item
    defer {
        p.inLam = wasLam
        p.lamItem = wasItem
    }
    return try p.lineBody()
}

# S1b: ":" and one simple statement on its line - an assignment, a call or an increment, a return, a break or continue,
# an error, unreachable, assert or spawn statement - never a declaration, an if, a loop, a match, a join, a defer or a
# block
fn (p mut Parser&) lineBody() Array<ast.Stmt&>&p ? Fail {
    colon := p.tk()
    p.advance()
    t := p.tk()
    if p.sees(token.Tok.StmtEnd) or p.sees(token.Tok.Eof) or p.src.Line(t.Start) != p.src.Line(colon.Start) {
        p.report(colon.Start, colon.End, msgs.LineBodyOnLine())
        error Fail.Syntax
    }
    what := lineBodyRefused(p.peek())
    if what != "" {
        p.report(t.Start, t.End, msgs.LineBodyNotSimple(what))
        error Fail.Syntax
    }
    wasLine := p.inLine
    p.inLine = true
    defer { p.inLine = wasLine }
    # a constructor's fields are declared at its body's top level only (C2), never in a one-line body
    wasCtor := p.inCtor
    p.inCtor = false
    defer { p.inCtor = wasCtor }
    st := try p.stmt()
    match st {
        case ast.Stmt.Var(sp, _), ast.Stmt.Multi(sp, _) {
            p.report(sp.Start, sp.End, msgs.LineBodyNotSimple("a declaration"))
            error Fail.Syntax
        }
        case ast.Stmt.Join(sp, _) {
            p.report(sp.Start, sp.End, msgs.LineBodyNotSimple("a join"))
            error Fail.Syntax
        }
        case _ { }
    }
    return ast.Stmt&[st]
}

# what a one-line body may not begin with (S1b), as its error names it; "" for a simple statement's start
fn lineBodyRefused(k token.Tok) String {
    return match k {
        case token.Tok.If: "an if"
        case token.Tok.For, token.Tok.Do: "a loop"
        case token.Tok.Match: "a match"
        case token.Tok.LBrace: "a block (a block takes no ':')"
        case token.Tok.Join: "a join"
        case token.Tok.Defer: "a defer"
        case token.Tok.ErrDefer: "an errdefer"
        case _: ""
    }
}

fn (p mut Parser&) forStmt(comptimeAt I32 = -1) ast.Stmt&p ? Fail {
    at := try p.want(token.Tok.For)
    unrolled := comptimeAt >= 0
    if unrolled { at = comptimeAt }
    if p.sees(token.Tok.LBrace) {
        body := try p.block()
        sp := p.from(at)
        if p.sees(token.Tok.StmtEnd) { p.advance() }
        return ast.Stmt.Forever(sp, body)
    }
    if p.sees(token.Tok.Iden) {
        k2 := p.look(1)
        # for x in / for k, v in (DESIGN.md point 4)
        if k2 == token.Tok.In or k2 == token.Tok.Comma {
            key source.NameId = source.NameId(0)
            name := try p.name()
            if p.accept(token.Tok.Comma) {
                key = name
                name = try p.name()
            }
            try p.want(token.Tok.In)
            tried := p.accept(token.Tok.Try)
            src := try p.forSource()
            # G13, G33: an item of a reflected list names types its loop's matches take ("match f.Type")
            reflAt := p.reflNames.Len()
            if p.reflListPath(src) { p.reflNames.Push(name) }
            body := try p.body() catch {
                p.reflNames.Truncate(reflAt)
                error Fail.Syntax
            }
            p.reflNames.Truncate(reflAt)
            cl Array<ast.Catch&>&p = Array<ast.Catch&>(0)
            if tried { cl = try p.clauses(false) }
            sp := p.from(at)
            if p.sees(token.Tok.StmtEnd) { p.advance() }
            return ast.Stmt.ForIn(sp, ast.ForIn(key, name, src, tried, body, cl, unrolled))
        }
        # three clauses: an initializer like a declaration, then "," cond "," post
        if k2 == token.Tok.Define or k2 == token.Tok.Iden or k2 == token.Tok.Mut {
            iat := p.here()
            nt := p.tk()
            name := try p.name()
            names := p.one(name, source.Span(nt.Start, nt.End))
            v ast.VarDecl?&p = null
            if p.accept(token.Tok.Define) {
                x := try p.expr()
                v = ast.VarDecl(names.Names, names.Sps, null, ast.Expr&[x], true, false)
            } else {
                ty := try p.typeExpr()
                try p.want(token.Tok.Assign)
                x := try p.expr()
                v = ast.VarDecl(names.Names, names.Sps, ty, ast.Expr&[x], false, false)
            }
            init := ast.Stmt.Var(p.from(iat), v!)
            try p.want(token.Tok.Comma)
            cond := try p.expr()
            try p.want(token.Tok.Comma)
            post := try p.simpleStmt()
            body := try p.body()
            sp := p.from(at)
            if p.sees(token.Tok.StmtEnd) { p.advance() }
            return ast.Stmt.For3(sp, ast.For3(init, cond, post, body))
        }
    }
    # K3a: only a for-in is unrolled
    if unrolled { try p.fail("'for NAME in' after 'comptime'") }
    cond := try p.expr()
    body := try p.body()
    sp := p.from(at)
    if p.sees(token.Tok.StmtEnd) { p.advance() }
    return ast.Stmt.While(sp, cond, body)
}

# what a for-in walks: an expression, or "range a[, b[, c]]"
fn (p mut Parser&) forSource() ast.Expr&p ? Fail {
    if p.sees(token.Tok.Range) {
        at := p.advance()
        args := try p.exprList()
        return ast.Expr.Range(p.from(at), args)
    }
    return try p.expr()
}

# a for's post clause: an assignment or an expression, with no statement end
fn (p mut Parser&) simpleStmt() ast.Stmt&p ? Fail {
    at := p.here()
    e := try p.expr()
    k := p.peek()
    if isAssignOp(k) {
        p.advance()
        v := try p.expr()
        return ast.Stmt.Assign(p.from(at), k, e, v)
    }
    return ast.Stmt.ExprS(p.from(at), e)
}

# "match" subject "{" cases "}" - a statement, or a value (S12b); "match T" on an introduced type variable takes types
fn (p mut Parser&) matchBody(value Bool) ast.Match&p ? Fail {
    at := try p.want(token.Tok.Match)
    onType := false
    if p.sees(token.Tok.Iden) and p.look(1) == token.Tok.LBrace {
        n := p.names.Intern(p.text(p.tk()))
        for v in p.vars {
            if v == n { onType = true }
        }
    }
    # G38: a type a reflected member names - "match T.Element", "match P.Type", "match f.Type" in a loop over a list
    if not onType and p.sees(token.Tok.Iden) and p.look(1) == token.Tok.Dot {
        i := p.pos
        head := p.names.Intern(p.text(p.ts.Toks[i]))
        known := false
        for v in p.vars {
            if v == head { known = true }
        }
        for v in p.reflNames {
            if v == head { known = true }
        }
        i++
        ok := known
        steps := 0
        for ok and p.ts.Toks[i].Kind == token.Tok.Dot and p.ts.Toks[i + 1].Kind == token.Tok.Iden {
            w := p.text(p.ts.Toks[i + 1])
            if w != "Type" and w != "Base" and w != "Element" and w != "Target" { ok = false }
            i += 2
            steps++
        }
        if ok and steps > 0 and p.ts.Toks[i].Kind == token.Tok.LBrace { onType = true }
    }
    subject := try p.expr()
    try p.want(token.Tok.LBrace)
    wasBrackets := p.brackets
    p.brackets = 0
    wasSkip := p.skip
    p.skip = false
    cases mut Vec<ast.Case&>&p = Vec<ast.Case&>()
    for {
        p.skipEnds()
        if p.sees(token.Tok.RBrace) or p.sees(token.Tok.Eof) { break }
        cat := p.here()
        try p.want(token.Tok.Case)
        pfrom := p.pats.Len()
        tfrom := p.tys.Len()
        for {
            if onType {
                p.tys.Push(try p.caseType())
            } else {
                x := try p.binary(1)
                if isTypeCasePath(x) and p.sees(token.Tok.Iden) and not p.tk().Has(token.LineBreak) {
                    # T34: "case Button b", "case Box<I64> b" - a type, then the name its instance is bound to ("_" for
                    # none)
                    nat := p.here()
                    n := try p.name()
                    from := p.ids.Len()
                    targs := Array<ast.TypeRef&>(0)
                    match x {
                        case ast.Expr.Generic(_, gx, ga) {
                            pathIds(gx, p.ids)
                            targs = ga
                        }
                        case _ { pathIds(x, p.ids) }
                    }
                    ty := ast.TypeRef.Named(x.Span(), gather(p.ids, from), targs)
                    p.pats.Push(ast.Pattern.Type(source.Span(x.Span().Start, p.prevEnd), ty, n, p.from(nat)))
                } else {
                    p.pats.Push(p.pattern(x, true))
                }
            }
            # QY: alternatives on one line are separated by ",", on different lines by the line break - a header goes
            # on to its "{", ":" or guard, so a line ending in an alternative continues it
            if p.accept(token.Tok.Comma) { continue }
            if not p.sees(token.Tok.StmtEnd) { break }
            n := p.look(1)
            if n == token.Tok.LBrace or n == token.Tok.Colon or n == token.Tok.If or n == token.Tok.RBrace or
               n == token.Tok.Case or n == token.Tok.Eof {
                break
            }
            p.advance()
        }
        alts := gather(p.pats, pfrom)
        types := gather(p.tys, tfrom)
        guard ast.Expr?&p = null
        if p.accept(token.Tok.If) { guard = try p.expr() }
        body, v := try p.caseBody(value)
        cases.Push(ast.Case(p.from(cat), alts, types, guard, body, v))
        if p.sees(token.Tok.StmtEnd) { p.advance() }
    }
    try p.want(token.Tok.RBrace)
    p.brackets = wasBrackets
    p.skip = wasSkip
    return ast.Match(p.from(at), subject, onType, cases.ToArray())
}

# a case of "match T" on a type variable: a type (G15)
fn (p mut Parser&) caseType() ast.TypeRef&p ? Fail {
    return try p.typeExpr()
}

# a case's body (S12, S12b, S1b): in a match used as a value "case P: v" - the value, its expression running on as a
# statement does - or "case P: return x", one statement that leaves; in a match statement a block or "case P: stmt"
fn (p mut Parser&) caseBody(value Bool) Array<ast.Stmt&>&p, ast.Expr?&p ? Fail {
    if p.sees(token.Tok.Colon) and (not value or leavingWord(p.look(1))) {
        st := try p.lineBody()
        return st, null
    }
    if p.sees(token.Tok.Colon) {
        colon := p.tk()
        p.advance()
        t := p.tk()
        if p.sees(token.Tok.StmtEnd) or p.sees(token.Tok.Eof) or p.src.Line(t.Start) != p.src.Line(colon.Start) {
            p.report(colon.Start, colon.End, msgs.LineBodyOnLine())
            error Fail.Syntax
        }
        v := try p.expr()
        return Array<ast.Stmt&>(0), v
    }
    if value {
        # S12b: a block gives no value - read past it, so what follows is still read
        at := p.here()
        try p.block()
        p.report(at, at + 1, msgs.ValueCaseBlock())
        return Array<ast.Stmt&>(0), ast.Expr.Unreachable(p.from(at), null)
    }
    body := try p.block()
    return body, null
}

# a statement that leaves, which a value match's clause may be in place of its value (S12b): return, break, continue,
# error
fn leavingWord(k token.Tok) Bool {
    return k == token.Tok.Return or k == token.Tok.Break or k == token.Tok.Continue or k == token.Tok.Error
}

# an alternative, read as an expression, as the pattern it is (DESIGN.md point 13): at the top a path, a case with its
# payload, "_", or a value; in a payload position a name binds, "_" binds nothing, a call shape nests, a literal is a
# value, a dotted path a case named without its payload (S13: whatever it holds) or a value the checker compares. A
# case whose payload holds anything else is a value compared by "==", as the expression it is
fn (p mut Parser&) pattern(x ast.Expr&p, top Bool) ast.Pattern&p {
    match x {
        case ast.Expr.Name(sp, n) {
            if p.names.Text(n) == "_" { return ast.Pattern.Wild(sp) }
            if top { return ast.Pattern.Path(sp, x) }
            return ast.Pattern.Bind(sp, n)
        }
        case ast.Expr.Member(sp, _, _) { return ast.Pattern.Path(sp, x) }
        case ast.Expr.Call(sp, f, args) {
            if isPath(f) {
                from := p.pats.Len()
                for a in args {
                    sub := p.pattern(a, false)
                    match sub {
                        case ast.Pattern.Value(_, v) {
                            if not isLiteral(v) {
                                p.pats.Truncate(from)
                                return ast.Pattern.Value(sp, x)
                            }
                        }
                        case _ { }
                    }
                    p.pats.Push(sub)
                }
                return ast.Pattern.Case(sp, f, gather(p.pats, from))
            }
            return ast.Pattern.Value(sp, x)
        }
        case ast.Expr.Index(sp, ty, items) {
            if isPath(ty) { return p.elemsPattern(sp, x, items) }
            return ast.Pattern.Value(sp, x)
        }
        case ast.Expr.ArrayLit(sp, _, items) { return p.elemsPattern(sp, x, items) }
        case ast.Expr.Spread(sp, y) {
            match y {
                case ast.Expr.Name(_, n) { if not top: return ast.Pattern.Rest(sp, n) }
                case _ { }
            }
            return ast.Pattern.Value(sp, x)
        }
        case _ { return ast.Pattern.Value(x.Span(), x) }
    }
}

# S13h: an array literal's form as a pattern - each item an element's pattern, "...name" its rest; one item that is no
# pattern (an expression but a literal) makes the whole a value, compared by "==" as written
fn (p mut Parser&) elemsPattern(sp source.Span, x ast.Expr&p, items Array<ast.Expr&>&p) ast.Pattern&p {
    from := p.pats.Len()
    for it in items {
        sub := p.pattern(it, false)
        if not valuePattern(sub) {
            p.pats.Push(sub)
            continue
        }
        p.pats.Truncate(from)
        return ast.Pattern.Value(sp, x)
    }
    return ast.Pattern.Elems(sp, x, gather(p.pats, from))
}

# a value alternative that is no literal: what makes the pattern around it a value
fn valuePattern(q ast.Pattern&) Bool {
    match q {
        case ast.Pattern.Value(_, v) { return not isLiteral(v) }
        case _ { return false }
    }
}

# a path's names, in order
fn pathIds(x ast.Expr&, out mut Vec<source.NameId>&) {
    match x {
        case ast.Expr.Name(_, n) { out.Push(n) }
        case ast.Expr.Member(_, b, n) {
            pathIds(b, out)
            out.Push(n)
        }
        case _ { }
    }
}

# a type case's type (T34): a path, with type arguments or none
# whether a for-in's source is a reflected list (G33): a path ending in Fields, Cases, Params or Results
fn (p mut Parser&) reflListPath(x ast.Expr&) Bool {
    match x {
        case ast.Expr.Member(_, _, n) {
            w := p.names.Text(n)
            return w == "Fields" or w == "Cases" or w == "Params" or w == "Results"
        }
        case _ { return false }
    }
}

fn isTypeCasePath(x ast.Expr&) Bool {
    return match x {
        case ast.Expr.Generic(_, gx, _): isPath(gx)
        case _: isPath(x)
    }
}

fn isPath(x ast.Expr&) Bool {
    return match x {
        case ast.Expr.Name(_, _): true
        case ast.Expr.Member(_, b, _): isPath(b)
        case _: false
    }
}

fn isLiteral(x ast.Expr&) Bool {
    return match x {
        case ast.Expr.Lit(_, _): true
        case ast.Expr.Unary(_, op, v): op == token.Tok.Minus and isLiteral(v)
        case _: false
    }
}

# catch clauses: "catch [A, B.w] [{ ... }] [default v, ...]" - several defaults only where listOk (R9a)
fn (p mut Parser&) clauses(listOk Bool) Array<ast.Catch&>&p ? Fail {
    l mut Vec<ast.Catch&>&p = Vec<ast.Catch&>()
    for p.sees(token.Tok.Catch) {
        at := p.advance()
        from := p.exprs.Len()
        items mut Vec<ast.Path&>&p = Vec<ast.Path&>()
        if p.sees(token.Tok.Iden) {
            for {
                items.Push(try p.path())
                if not p.accept(token.Tok.Comma) { break }
            }
        }
        # R11b: a name after the items, the error the clause took ("catch os.Error e")
        bind := source.NameId(0)
        bsp := source.Span(0, 0)
        if items.Len() > 0 and p.sees(token.Tok.Iden) {
            bt := p.tk()
            bind = try p.name()
            bsp = source.Span(bt.Start, bt.End)
        }
        body Array<ast.Stmt&>&p = Array<ast.Stmt&>(0)
        braced := p.sees(token.Tok.LBrace)
        if braced { body = try p.block() }
        if p.accept(token.Tok.Default) {
            for {
                p.exprs.Push(try p.unary())
                if not listOk or not p.accept(token.Tok.Comma) { break }
            }
        } else if not braced {
            try p.fail(token.Tok.LBrace.Describe())
        }
        defaults := gather(p.exprs, from)
        l.Push(ast.Catch(p.from(at), items.ToArray(), body, defaults, braced, bind, bsp))
    }
    return l.ToArray()
}

# ---- expressions ----

fn (p mut Parser&) exprList() Array<ast.Expr&>&p ? Fail {
    from := p.exprs.Len()
    for {
        x := try p.expr() catch {
            p.exprs.Truncate(from)
            error Fail.Syntax
        }
        p.exprs.Push(x)
        if not p.accept(token.Tok.Comma) { break }
    }
    return gather(p.exprs, from)
}

# expr: binary [ "if" binary "else" expr ] (E28). Outside brackets an "if" first on its line never continues a
# conditional: it begins the next statement (L18b, DESIGN.md point 7)
fn (p mut Parser&) expr() ast.Expr&p ? Fail {
    a := try p.binary(1)
    return try p.condFrom(a)
}

fn (p mut Parser&) condFrom(a ast.Expr&p) ast.Expr&p ? Fail {
    if not p.sees(token.Tok.If) or (p.brackets == 0 and p.breakBefore()) { return a }
    p.advance()
    c := try p.binary(1)
    try p.want(token.Tok.Else)
    b := try p.expr()
    return ast.Expr.Cond(source.Span(a.Span().Start, p.prevEnd), a, c, b)
}

# the binding power of an operator in infix position (E5), 0 for none: "&", "|" and "^" tighter than the comparisons,
# looser than shifts - OldBitwise the order before 2026-10-24, for tools/precedence_migrate.olang. In a type-argument list a comparison or a
# shift is none: it would reach across the list's own ">" (G8)
fn (p Parser&) prec(k token.Tok) I64 {
    return match k {
        case token.Tok.Or: 1
        case token.Tok.Xor: 2
        case token.Tok.And: 3
        case token.Tok.Pipe: 4 if p.OldBitwise else 6
        case token.Tok.Caret: 5 if p.OldBitwise else 7
        case token.Tok.Amp: 6 if p.OldBitwise else 8
        case token.Tok.EqEq, token.Tok.NotEq: 7 if p.OldBitwise else 4
        case token.Tok.In, token.Tok.Is, token.Tok.Not: 8 if p.OldBitwise else 5
        case token.Tok.Lt, token.Tok.Le, token.Tok.Gt, token.Tok.Ge: 0 if p.noGt else (8 if p.OldBitwise else 5)
        case token.Tok.Shl, token.Tok.Shr: 0 if p.noGt else 9
        case token.Tok.Plus, token.Tok.Minus: 10
        case token.Tok.Star, token.Tok.Slash, token.Tok.Percent, token.Tok.At: 11
        case token.Tok.StarStar: 12
        case _: 0
    }
}

# whether an expression is a comparison, unparenthesized: ==, !=, an ordering or a chain of them, in, not in, is (E5)
fn comparison(x ast.Expr&) Bool {
    match x {
        case ast.Expr.Binary(_, op, _, _) {
            return op == token.Tok.EqEq or op == token.Tok.NotEq or isOrdering(op) or op == token.Tok.In
        }
        case ast.Expr.Chain(_, _), ast.Expr.NotIn(_, _, _), ast.Expr.Is(_, _, _, _), ast.Expr.IsType(_, _, _, _) {
            return true
        }
        case _ { return false }
    }
}

fn isOrdering(k token.Tok) Bool { return k == token.Tok.Lt or k == token.Tok.Le or k == token.Tok.Gt or k == token.Tok.Ge }

# precedence climbing: operators binding at least as tightly as min
fn (p mut Parser&) binary(min I64) ast.Expr&p ? Fail {
    left := try p.unary()
    return try p.binaryFrom(left, min)
}

fn (p mut Parser&) binaryFrom(first ast.Expr&p, min I64) ast.Expr&p ? Fail {
    left ast.Expr&p = first
    start := first.Span().Start
    links I64 = 0
    defer { p.depth -= links }
    for {
        if p.RecordOperators and links > 0 { p.Operators.Push(left.Span()) }   # the node the last turn made
        k := p.peek()
        pr := p.prec(k)
        if pr == 0 or pr < min { return left }
        # G39: an "@" beginning a line begins an attribute, never continues a matrix product (L18b's rule for "if")
        if k == token.Tok.At and not p.skip and p.breakBefore() { return left }
        # "not" in infix position can only be "not in"
        if k == token.Tok.Not and p.look(1) != token.Tok.In { return left }
        # E25: f&x(...) is a call, read by postfix; an "&" there is no operator
        if p.half != token.Tok.Eof and k == token.Tok.Amp { return left }
        p.advance()
        if k == token.Tok.Not {
            p.advance()
            right := try p.binary(pr + 1)
            left = ast.Expr.NotIn(source.Span(start, p.prevEnd), left, right)
            try p.enter()
            links++
            continue
        }
        if k == token.Tok.Is {
            negated := p.accept(token.Tok.Not)
            if p.startsType() {
                t := try p.typeExpr()
                left = ast.Expr.IsType(source.Span(start, p.prevEnd), left, t, negated)
            } else {
                y := try p.binary(pr + 1)
                left = ast.Expr.Is(source.Span(start, p.prevEnd), left, y, negated)
            }
            try p.enter()
            links++
            continue
        }
        right := try p.binary(pr + 1)
        if isOrdering(k) and isOrdering(p.peek()) and p.prec(p.peek()) > 0 {
            # a chain: a < b <= c (E30)
            ops mut Vec<token.Tok>&p = Vec<token.Tok>()
            ops.Push(k)
            from := p.exprs.Len()
            p.exprs.Push(left)
            p.exprs.Push(right)
            # each comparison of the chain is a level, as each operator of a + b + c is (L21)
            try p.enter()
            links++
            for isOrdering(p.peek()) and p.prec(p.peek()) > 0 {
                ops.Push(p.peek())
                p.advance()
                p.exprs.Push(try p.binary(pr + 1))
                try p.enter()
                links++
            }
            left = ast.Expr.Chain(source.Span(start, p.prevEnd), ast.Chain(ops.ToArray(), gather(p.exprs, from)))
            continue
        }
        if k == token.Tok.Amp or k == token.Tok.Pipe or k == token.Tok.Caret {
            if comparison(left) { p.Mixed.Push(left.Span()) }
            if comparison(right) { p.Mixed.Push(right.Span()) }
        }
        left = ast.Expr.Binary(source.Span(start, p.prevEnd), k, left, right)
        # each operator applied makes the tree on its left one level deeper, counted once it is built (L21)
        try p.enter()
        links++
    }
}

# whether what follows "is" is a type by its form: "mut", "fn", type arguments or a marker. A bare path is
# left to the resolver (DESIGN.md point 1)
fn (p mut Parser&) startsType() Bool {
    k := p.peek()
    if k == token.Tok.Mut or k == token.Tok.Fn { return true }
    if k != token.Tok.Iden { return false }
    i I64 = 1
    for p.look(i) == token.Tok.Dot and p.look(i + 1) == token.Tok.Iden { i += 2 }
    n := p.look(i)
    if n == token.Tok.Amp { return not p.lookTok(i).Has(token.Space) }
    if n == token.Tok.Lt { return p.isTypePath(i) }
    return false
}

# whether the path at the next i tokens names a type, by the oracle
fn (p mut Parser&) isTypePath(n I64) Bool {
    if n == 1 { return p.oracle.bare.Has(p.names.Intern(p.text(p.tk()))) }
    t StringBuilder = StringBuilder()
    for i in range n { t.Push(p.text(p.lookTok(i))) }
    return p.oracle.qualified.Has(t.ToString())
}

# unary: "not" binary | text | prefix-op unary | postfix
# a prefix operator adds no level of its own, as text pieces do not: what nests is the operand postfix reads, and "not"
# (L21, as stage 0 counts)
fn (p mut Parser&) unary() ast.Expr&p ? Fail {
    at := p.here()
    if p.ellipsis() { return try p.spread() }
    match p.peek() {
        case token.Tok.Not {
            p.advance()
            try p.enter()
            defer p.leave()
            x := try p.binary(4)
            return ast.Expr.Unary(p.from(at), token.Tok.Not, x)
        }
        case token.Tok.Embed {
            # E38: "embed PATH", the path a unary as a prefix operator's operand is
            p.advance()
            x := try p.unary()
            return ast.Expr.Unary(p.from(at), token.Tok.Embed, x)
        }
        case token.Tok.Minus, token.Tok.Tilde, token.Tok.Inc, token.Tok.Dec {
            k := p.peek()
            p.advance()
            x := try p.unary()
            return ast.Expr.Unary(p.from(at), k, x)
        }
        case token.Tok.StrLit, token.Tok.Dollar {
            # a literal with something else after it is a postfix primary ("a b".Split(" ")), else a piece of text
            if p.sees(token.Tok.StrLit) {
                k2 := p.look(1)
                if k2 != token.Tok.StrLit and k2 != token.Tok.Dollar { return try p.postfix() }
            }
            first := try p.piece()
            if not p.sees(token.Tok.StrLit) and not p.sees(token.Tok.Dollar) { return first }
            from := p.exprs.Len()
            p.exprs.Push(first)
            for p.sees(token.Tok.StrLit) or p.sees(token.Tok.Dollar) { p.exprs.Push(try p.piece()) }
            return ast.Expr.Join(p.from(at), gather(p.exprs, from))
        }
        case _ { return try p.power() }
    }
    unreachable
}

# "...x" (D8g: an array passed on as a call's variadic arguments; S13h: an array pattern's rest), and a bare "..." -
# what follows it no operand - holding the name "_"
fn (p mut Parser&) spread() ast.Expr&p ? Fail {
    at := p.here()
    for _ in range 3 { p.advance() }
    k := p.peek()
    if k == token.Tok.Comma or k == token.Tok.RBrack or k == token.Tok.RParen or k == token.Tok.StmtEnd {
        return ast.Expr.Spread(p.from(at), ast.Expr.Name(p.from(at), p.names.Intern("_")))
    }
    x := try p.unary()
    return ast.Expr.Spread(p.from(at), x)
}

# E5a: a postfix expression raised to a power - "x ** y", tighter than a prefix operator ("-x ** 2" is "-(x ** 2)")
# and right-associative ("2 ** 3 ** 2" is "2 ** 9"): the exponent a unary, so "2 ** -1" is read too
fn (p mut Parser&) power() ast.Expr&p ? Fail {
    x := try p.postfix()
    if not p.sees(token.Tok.StarStar) { return x }
    p.advance()
    y := try p.unary()
    sp := source.Span(x.Span().Start, p.prevEnd)
    try p.enter()
    p.leave()
    return ast.Expr.Binary(sp, token.Tok.StarStar, x, y)
}

# a piece of text: a literal, or "$" rendering what follows
fn (p mut Parser&) piece() ast.Expr&p ? Fail {
    at := p.here()
    if p.sees(token.Tok.StrLit) {
        # a literal piece is an operand, a level as any is
        try p.enter()
        p.leave()
        p.advance()
        return ast.Expr.Lit(p.from(at), token.Tok.StrLit)
    }
    try p.want(token.Tok.Dollar)
    k := p.peek()
    if k == token.Tok.Minus or k == token.Tok.Tilde or k == token.Tok.Dollar {
        p.advance()
        inner := p.here()
        x := try p.postfix()
        return ast.Expr.Unary(p.from(at), token.Tok.Dollar, ast.Expr.Unary(p.from(inner), k, x))
    }
    x := try p.postfix()
    return ast.Expr.Unary(p.from(at), token.Tok.Dollar, x)
}

# an operand and what follows it: one level (L21)
fn (p mut Parser&) postfix() ast.Expr&p ? Fail {
    try p.enter()
    defer p.leave()
    x := try p.primary()
    return try p.postfixFrom(x)
}

fn (p mut Parser&) postfixFrom(first ast.Expr&p) ast.Expr&p ? Fail {
    x ast.Expr&p = first
    start := first.Span().Start
    for {
        match p.peek() {
            case token.Tok.LBrack {
                x = try p.index(x)
            }
            case token.Tok.Dot {
                if not p.memberNext() { return x }
                p.advance()
                n := try p.methodName()
                x = ast.Expr.Member(p.from(start), x, n)
                # alias.Type<args>(...): a generic type through an import, known to the oracle
                if p.sees(token.Tok.Lt) and p.isQualifiedType(x) {
                    targs := try p.typeArgs()
                    x = ast.Expr.Generic(p.from(start), x, targs)
                    x = try p.literalAfterType(start, x)
                } else if p.sees(token.Tok.Lt) and isPath(x) and p.oracle.fnsQualified.Has(p.src.TextOf(x.Span())) {
                    # alias.big<I64>: a generic function's instance through an import (G12)
                    targs := try p.typeArgs()
                    x = ast.Expr.Generic(p.from(start), x, targs)
                } else if p.typeArgsCall(0) or p.spacedTypeArgs(0) {
                    # x.Narrow<I32>(): a method's type arguments, by C#'s rule (G12) - written with spaces, said
                    if p.spacedTypeArgs(0) { p.report(p.here(), p.lookTok(0).End, msgs.TypeArgsSpaced(p.names.Text(n))) }
                    targs := try p.typeArgs()
                    x = ast.Expr.Generic(p.from(start), x, targs)
                }
            }
            case token.Tok.LParen {
                args := try p.args()
                x = ast.Expr.Call(p.from(start), x, args)
            }
            case token.Tok.Inc, token.Tok.Dec, token.Tok.Bang {
                k := p.peek()
                p.advance()
                x = ast.Expr.Postfix(p.from(start), k, x)
            }
            case token.Tok.As {
                p.advance()
                t := try p.typeExpr()
                x = ast.Expr.As(p.from(start), x, t)
            }
            case token.Tok.Amp {
                if p.half != token.Tok.Eof { return x }
                # alias.Name&[...]: a marked element type through an import, always a literal (point 1)
                k2 := p.look(1)
                if isPath(x) and (k2 == token.Tok.LBrack or (k2 == token.Tok.Iden and p.look(2) == token.Tok.LBrack and
                                                             p.isQualifiedType(x))) {
                    nt := try p.exprAsType(x)
                    x = try p.arrayLit(start, p.markers(start, nt))
                    continue
                }
                # E25: f&x(...) - the "&", the name and the "(" each touching the one before (DESIGN.md point 6)
                a := p.tk()
                n := p.lookTok(1)
                o := p.lookTok(2)
                if a.Has(token.Space) or (n.Kind != token.Tok.Iden and n.Kind != token.Tok.Return) or n.Has(token.Space) or
                   o.Kind != token.Tok.LParen or o.Has(token.Space) {
                    return x
                }
                p.advance()
                p.advance()
                scope := p.names.Intern(p.text(n))
                args := try p.args()
                x = ast.Expr.ScopeCall(p.from(start), x, scope, args)
            }
            case _ { return x }
        }
    }
}

# whether x is a path whose text the oracle knows as a qualified type: alias.Name
fn (p Parser&) isQualifiedType(x ast.Expr&) Bool {
    if not isPath(x) { return false }
    return p.oracle.qualified.Has(p.src.TextOf(x.Span()))
}

# "[" ... "]" after an operand: a slice, or an index - or an array literal, where the operand names a type
fn (p mut Parser&) index(x ast.Expr&p) ast.Expr&p ? Fail {
    start := x.Span().Start
    p.advance()
    if p.sees(token.Tok.RParen) or p.sees(token.Tok.RBrace) { try p.fail(token.Tok.RBrack.Describe()) }
    wasNoGt, wasItem := p.noGt, p.item
    p.noGt = false
    p.item = true
    p.brackets++
    defer {
        p.brackets--
        p.noGt = wasNoGt
        p.item = wasItem
    }
    if p.sees(token.Tok.Colon) or not p.sees(token.Tok.RBrack) {
        lo ast.Expr?&p = null
        if not p.sees(token.Tok.Colon) {
            lo = try p.elem()
            if p.comprehends() {
                elem := try p.exprAsType(x)
                return try p.comprehension(start, elem, lo)
            }
        }
        if p.accept(token.Tok.Colon) {
            hi ast.Expr?&p = null
            if not p.sees(token.Tok.RBrack) { hi = try p.expr() }
            try p.want(token.Tok.RBrack)
            return ast.Expr.Slice(p.from(start), x, lo, hi)
        }
        from := p.exprs.Len()
        p.exprs.Push(lo!)
        for try p.sep(token.Tok.RBrack) { p.exprs.Push(try p.elem()) }
        if not p.sees(token.Tok.RBrack) {
            p.exprs.Truncate(from)
            try p.fail(token.Tok.RBrack.Describe())
        }
        p.advance()
        return ast.Expr.Index(p.from(start), x, gather(p.exprs, from))
    }
    p.advance()
    return ast.Expr.Index(p.from(start), x, Array<ast.Expr&>(0))
}

# an element of a bracket list: an expression, or a nested "[...]" row (E21, reported by the checker)
fn (p mut Parser&) elem() ast.Expr&p ? Fail {
    if not p.sees(token.Tok.LBrack) { return try p.expr() }
    at := p.advance()
    from := p.exprs.Len()
    for not p.sees(token.Tok.RBrack) {
        p.exprs.Push(try p.elem())
        if not try p.sep(token.Tok.RBrack) { break }
    }
    if not p.sees(token.Tok.RBrack) {
        p.exprs.Truncate(from)
        try p.fail(token.Tok.RBrack.Describe())
    }
    p.advance()
    return ast.Expr.Row(p.from(at), gather(p.exprs, from))
}

# "(" [arg {"," arg} [","]] ")" - an arg may be "default" (E14a), or "name = value" naming a defaulted parameter
# (E14b)
fn (p mut Parser&) args() Array<ast.Expr&>&p ? Fail {
    try p.want(token.Tok.LParen)
    wasNoGt := p.noGt
    p.noGt = false
    p.brackets++
    wasSkip, wasItem := p.skip, p.item
    p.skip = false
    p.item = true
    defer { p.item = wasItem }
    from := p.exprs.Len()
    for not p.sees(token.Tok.RParen) {
        if p.sees(token.Tok.Default) {
            at := p.advance()
            p.exprs.Push(ast.Expr.Default(p.from(at)))
        } else if p.sees(token.Tok.Iden) and p.look(1) == token.Tok.Assign {
            at := p.tk().Start
            n := try p.name() catch {
                p.exprs.Truncate(from)
                p.brackets--
                p.skip = wasSkip
                error Fail.Syntax
            }
            p.advance()
            x := try p.expr() catch {
                p.exprs.Truncate(from)
                p.brackets--
                p.skip = wasSkip
                error Fail.Syntax
            }
            p.exprs.Push(ast.Expr.Named(p.from(at), n, x))
        } else {
            x := try p.expr() catch {
                p.exprs.Truncate(from)
                p.brackets--
                p.skip = wasSkip
                error Fail.Syntax
            }
            # G37: "T(e for p in T.Params)" - a comprehension standing as arguments, its own item of the list
            if p.comprehends() {
                at := I32(x.Span().Start)
                x = try p.comprehension(at, null, x, token.Tok.RParen) catch {
                    p.exprs.Truncate(from)
                    p.brackets--
                    p.skip = wasSkip
                    error Fail.Syntax
                }
            }
            p.exprs.Push(x)
        }
        more := try p.sep(token.Tok.RParen) catch {
            p.exprs.Truncate(from)
            p.brackets--
            p.skip = wasSkip
            error Fail.Syntax
        }
        if not more { break }
    }
    p.skip = wasSkip
    p.brackets--
    p.noGt = wasNoGt
    if not p.sees(token.Tok.RParen) {
        p.exprs.Truncate(from)
        try p.fail(token.Tok.RParen.Describe())
    }
    p.advance()
    return gather(p.exprs, from)
}

fn (p mut Parser&) primary() ast.Expr&p ? Fail {
    at := p.here()
    k := p.peek()
    match k {
        case token.Tok.IntLit, token.Tok.FloatLit, token.Tok.CharLit, token.Tok.BoolLit, token.Tok.NullLit
             token.Tok.StrLit {
            p.advance()
            return ast.Expr.Lit(p.from(at), k)
        }
        case token.Tok.LParen {
            p.advance()
            wasNoGt := p.noGt
            p.noGt = false
            p.brackets++
            # L18a: a parenthesized expression is one item, not a list - a line's end inside it separates nothing
            wasSkip, wasItem := p.skip, p.item
            p.skip = true
            p.item = false
            x := try p.expr() catch {
                p.brackets--
                p.skip = wasSkip
                p.item = wasItem
                error Fail.Syntax
            }
            p.item = wasItem
            p.brackets--
            p.noGt = wasNoGt
            try p.want(token.Tok.RParen) catch {
                p.skip = wasSkip
                error Fail.Syntax
            }
            p.skip = wasSkip
            return ast.Expr.Paren(p.from(at), x)
        }
        case token.Tok.Comptime {
            # K3: computed while compiling - the whole expression after it, as a try's reach (E24)
            p.advance()
            x := try p.expr()
            return ast.Expr.Unary(p.from(at), token.Tok.Comptime, x)
        }
        case token.Tok.Try {
            # E24: what it covers is the whole expression after it, ending at the expression's end or a "catch" - its
            # clauses then end the try, and the expression around it goes on (a default is one unary)
            listOk := at == p.listTry
            p.advance()
            x := try p.expr()
            cl := try p.clauses(listOk)
            return ast.Expr.Try(p.from(at), x, cl)
        }
        case token.Tok.Fn {
            p.advance()
            item := p.item
            s := try p.sig(true, true)
            body := try p.lambdaBody(item)
            return ast.Expr.Lambda(p.from(at), ast.Func(p.from(at), null, source.NameId(0), s, body))
        }
        case token.Tok.Match {
            m := try p.matchBody(true)
            return ast.Expr.MatchE(p.from(at), m)
        }
        case token.Tok.Unreachable {
            # S16d: "unreachable [why]" where a value is expected - its message the expression after it on its line
            p.advance()
            msg ast.Expr?&p = null
            if p.messageHere() { msg = try p.expr() }
            return ast.Expr.Unreachable(p.from(at), msg)
        }
        case token.Tok.Iden {
            if p.anyHere() {
                # an array literal of run-time trait values, its element type written as $ renders it: "any W&[a, b]"
                # (T32, E19) - "any" begins no other expression
                elem := try p.typeExpr()
                return try p.arrayLit(at, elem)
            }
            t := p.tk()
            k2 := p.look(1)
            name := p.names.Intern(p.text(t))
            if k2 == token.Tok.Lt and p.oracle.bare.Has(name) {
                # a generic type applied: Array<I32>(n), Pair<I32, I64>(1, 2), List<String&>[...]
                p.advance()
                targs := try p.typeArgs()
                x := ast.Expr.Generic(p.from(at), ast.Expr.Name(p.from(at), name), targs)
                return try p.literalAfterType(at, x)
            }
            if k2 == token.Tok.Lt and (p.oracle.fns.Has(name) or p.typeArgsCall(1) or p.spacedTypeArgs(1)) {
                # a generic function's instance: big<I64>(x), f := big<I64> (G12)
                if not p.oracle.fns.Has(name) and p.spacedTypeArgs(1) { p.report(p.lookTok(1).Start, p.lookTok(1).End, msgs.TypeArgsSpaced(p.text(t))) }
                p.advance()
                targs := try p.typeArgs()
                return ast.Expr.Generic(p.from(at), ast.Expr.Name(p.from(at), name), targs)
            }
            if k2 == token.Tok.Question and p.look(2) == token.Tok.Amp and p.look(3) == token.Tok.LBrack {
                # Name?&[...]: an element type that may be null (T2c), always a literal
                p.advance()
                if p.nullMark() {
                    nt ast.TypeRef&p = ast.TypeRef.Named(p.from(at), Array<source.NameId>(1, name), Array<ast.TypeRef&>(0))
                    return try p.arrayLit(at, p.markers(at, nt))
                }
                return ast.Expr.Name(p.from(at), name)
            }
            if k2 == token.Tok.Amp {
                # Name&[...]: a marked element type, always a literal; Name&x[...] is one where Name is a type
                k3 := p.look(2)
                if k3 == token.Tok.LBrack or (k3 == token.Tok.Iden and p.look(3) == token.Tok.LBrack and
                                               p.oracle.bare.Has(name)) {
                    p.advance()
                    nt ast.TypeRef&p = ast.TypeRef.Named(p.from(at), Array<source.NameId>(1, name), Array<ast.TypeRef&>(0))
                    elem := p.markers(at, nt)
                    return try p.arrayLit(at, elem)
                }
            }
            p.advance()
            return ast.Expr.Name(p.from(at), name)
        }
        # a bracket with no element type before it (E19): a literal states its element type once
        case token.Tok.LBrack { try p.fail("an element type before the [, as in I32[...]") }
        case _ { try p.fail("an expression") }
    }
    unreachable
}

# after a generic type in an expression: "[...]" makes a literal of that element type (a marker may stand between)
fn (p mut Parser&) literalAfterType(at I32, x ast.Expr&p) ast.Expr&p ? Fail {
    # List<N>?&[...]: an element type that may be null (T2c)
    if not p.nullMark() or p.look(2) != token.Tok.LBrack {
        if not p.sees(token.Tok.Amp) and not p.sees(token.Tok.LBrack) { return x }
        if p.sees(token.Tok.Amp) {
            k2 := p.look(1)
            if k2 != token.Tok.LBrack and not (k2 == token.Tok.Iden and p.look(2) == token.Tok.LBrack) { return x }
        }
    }
    match x {
        case ast.Expr.Generic(sp, base, targs) {
            from := p.ids.Len()
            e ast.Expr&p = base
            for {
                match e {
                    case ast.Expr.Name(_, n) {
                        p.ids.Push(n)
                        break
                    }
                    case ast.Expr.Member(_, b, n) {
                        p.ids.Push(n)
                        e = b
                    }
                    case _ { break }
                }
            }
            parts := gather(p.ids, from)
            rev mut Array<source.NameId>&p = Array<source.NameId>(parts.Len())
            for i in range parts.Len() { rev[i] = parts[parts.Len() - 1 - i] }
            nt ast.TypeRef&p = ast.TypeRef.Named(sp, rev, targs)
            elem := p.markers(at, nt)
            return try p.arrayLit(at, elem)
        }
        case _ { return x }
    }
}

# "[" items "]" or a comprehension "[" value "for" ... "]" (E19, E27), the element type read
fn (p mut Parser&) arrayLit(at I32, elem ast.TypeRef&p) ast.Expr&p ? Fail {
    try p.want(token.Tok.LBrack)
    wasNoGt := p.noGt
    p.noGt = false
    p.brackets++
    wasSkip, wasItem := p.skip, p.item
    p.skip = false
    p.item = true
    defer {
        p.brackets--
        p.noGt = wasNoGt
        p.skip = wasSkip
        p.item = wasItem
    }
    from := p.exprs.Len()
    if not p.sees(token.Tok.RBrack) {
        if p.sees(token.Tok.RParen) or p.sees(token.Tok.RBrace) { try p.fail(token.Tok.RBrack.Describe()) }
        first := try p.elem()
        if p.comprehends() { return try p.comprehension(at, elem, first) }
        p.exprs.Push(first)
        for try p.sep(token.Tok.RBrack) { p.exprs.Push(try p.elem()) }
    }
    if not p.sees(token.Tok.RBrack) {
        p.exprs.Truncate(from)
        try p.fail(token.Tok.RBrack.Describe())
    }
    p.advance()
    return ast.Expr.ArrayLit(p.from(at), elem, gather(p.exprs, from))
}

# after a bracket's first item, the "for" of a comprehension, read - on its line or a later one, since a comprehension
# is one item, not a list (L18a)
fn (p mut Parser&) comprehends() Bool {
    i := p.pos
    for p.ts.Toks[i].Kind == token.Tok.StmtEnd and i < p.ts.Toks.Len() - 1 { i++ }
    if p.half != token.Tok.Eof or p.ts.Toks[i].Kind != token.Tok.For { return false }
    p.pos = i
    p.advance()
    return true
}

# a comprehension after its value and "for": "[key,] name in source [if filter] ]" - one item, not a list: a line's end
# inside it separates nothing (L18a)
fn (p mut Parser&) comprehension(at I32, elem ast.TypeRef?&p, value ast.Expr&p, close token.Tok = token.Tok.RBrack) ast.Expr&p ? Fail {
    wasSkip := p.skip
    p.skip = true
    defer { p.skip = wasSkip }
    key source.NameId = source.NameId(0)

    name := try p.name()
    if p.accept(token.Tok.Comma) {
        key = name
        name = try p.name()
    }
    try p.want(token.Tok.In)
    src ast.Expr?&p = null
    if p.sees(token.Tok.Range) {
        rat := p.advance()
        from := p.exprs.Len()
        for {
            p.exprs.Push(try p.binary(1))
            if not p.accept(token.Tok.Comma) { break }
        }
        src = ast.Expr.Range(p.from(rat), gather(p.exprs, from))
    } else {
        src = try p.binary(1)
    }
    filter ast.Expr?&p = null
    if p.accept(token.Tok.If) { filter = try p.binary(1) }
    if close == token.Tok.RParen { return ast.Expr.Compr(p.from(at), ast.Compr(null, value, key, name, src!, filter, true)) }
    try p.want(token.Tok.RBrack)
    return ast.Expr.Compr(p.from(at), ast.Compr(elem, value, key, name, src!, filter))
}

# ---- hints: a syntax error said in terms of what was probably meant (B11) ----
#
# Each looks at the tokens around the one the parse stopped at, as a reader would, and says what was meant where the
# tokens make it plain: the same patterns, in the same order, as stage 0's.

# the kind and line of the token at i: Eof and -1 outside the file
fn (p Parser&) kindAt(i I64) token.Tok {
    if i < 0 or i >= p.ts.Toks.Len() { return token.Tok.Eof }
    return p.ts.Toks[i].Kind
}

fn (p Parser&) lineAt(i I64) I64 {
    if i < 0 or i >= p.ts.Toks.Len() { return -1 }
    return I64(p.src.Line(p.ts.Toks[i].Start))
}

# a keyword spelled with letters - true, false and null among them
fn (p Parser&) isKw(i I64) Bool {
    k := p.kindAt(i)
    if k == token.Tok.Iden or k == token.Tok.Eof or k == token.Tok.StmtEnd { return false }
    t := p.ts.Toks[i]
    return t.End > t.Start and p.src.Text[t.Start].IsLetter()
}

# the token at i as a diagnostic names it
fn (p Parser&) named(i I64) String {
    k := p.kindAt(i)
    if k == token.Tok.StmtEnd { return msgs.EndOfLine }
    if k == token.Tok.Eof { return msgs.EndOfFile }
    return msgs.Tok(p.text(p.ts.Toks[i]))
}

fn (p mut Parser&) reportAt(i I64, m msgs.Msg) {
    t := p.ts.Toks[i]
    p.report(t.Start, t.End, m)
}

fn isJoiningOp(k token.Tok) Bool {
    return match k {
        case token.Tok.Plus, token.Tok.Minus, token.Tok.Star, token.Tok.Slash, token.Tok.Percent, token.Tok.At: true
        case token.Tok.StarStar: true
        case token.Tok.And, token.Tok.Or, token.Tok.Xor, token.Tok.EqEq, token.Tok.NotEq, token.Tok.Lt, token.Tok.Le: true
        case token.Tok.Gt, token.Tok.Ge, token.Tok.Amp, token.Tok.Pipe, token.Tok.Caret, token.Tok.Shl, token.Tok.Shr: true
        case _: false
    }
}

fn (p mut Parser&) hint(want String&) Bool {
    if p.half != token.Tok.Eof { return false }
    f := p.pos
    fk := p.kindAt(f)
    fl := p.lineAt(f)
    pr := f - 1
    pk := p.kindAt(pr)
    pl := p.lineAt(pr)
    # L9a: "x := range + 1" in a constructor declaring a field "range" - a keyword names a field only after "."
    if keywordNamesField(fk) and want == "an expression" and pk != token.Tok.Colon {
        p.reportAt(f, msgs.KeywordFieldRead(p.named(f)))
        return true
    }
    if p.caseValueComma(f) {
        p.reportAt(f, msgs.MatchValueOne())
        return true
    }
    # "range mut Bool = false" - a keyword beginning a line as a name would ("range" ended the statement there)
    if p.isKw(pr) and pl == fl and p.lineAt(pr - 1) < pl and
       (fk == token.Tok.Mut or fk == token.Tok.Define or fk == token.Tok.Assign or fk == token.Tok.Comma or
        (fk == token.Tok.Iden and (pk == token.Tok.Break or pk == token.Tok.Continue or pk == token.Tok.Unreachable or
                                   pk == token.Tok.Join))) {
        p.reportAt(pr, msgs.KeywordAsName(p.named(pr)))
        return true
    }
    # "fn join(", "x I32, done I32" - a keyword where a name was wanted
    if p.isKw(f) and fk != token.Tok.Mut and
       (want == "a name" or (p.lineAt(f + 1) == fl and (p.kindAt(f + 1) == token.Tok.Iden or
                                                         p.kindAt(f + 1) == token.Tok.Mut or
                                                         p.kindAt(f + 1) == token.Tok.Define))) {
        p.reportAt(f, msgs.KeywordAsName(p.named(f)))
        return true
    }
    # L18: "s := a + b" then "    + c" - the end of the line before ended the statement
    if (pk == token.Tok.StmtEnd or pl < fl) and fl > 0 and isJoiningOp(fk) {
        p.reportAt(f, msgs.LineStartsWithOperator(p.named(f), p.named(f)))
        return true
    }
    # C7: a destructor follows the constructor's body
    if fk == token.Tok.Destruct {
        p.reportAt(f, msgs.DestructInBody())
        return true
    }
    # E11b: a value joined to text has to be rendered - "pretty(t) "\n"" or ""n=" n"
    if (fk == token.Tok.StrLit or fk == token.Tok.Dollar) and pl == fl and p.isOperandEnd(pr) and
       p.joinPieceHint(p.operandStartBefore(pr), pr) {
        return true
    }
    if (pk == token.Tok.StrLit or p.endsRendering(pr)) and pl == fl and (isOperandEndTok(fk) or fk == token.Tok.LParen) and
       fk != token.Tok.RParen and fk != token.Tok.RBrack and not (pk == token.Tok.StrLit and fk == token.Tok.LParen) and
       p.joinPieceHint(f, p.operandEndAfter(f)) {
        return true
    }
    if p.textPieceCalled(f) { return true }
    # L18a: "f(a, b,)" - a comma before a list's closing bracket separates nothing
    if (fk == token.Tok.RParen or fk == token.Tok.RBrack) and pk == token.Tok.Comma and pl == fl {
        p.reportAt(pr, msgs.TrailingComma(p.named(f)))
        return true
    }
    # R15: "fn f() ?error {" - '?' is the whole of the default error
    if fk == token.Tok.Error and pk == token.Tok.Question {
        p.reportAt(f, msgs.ErrorAfterQuestion())
        return true
    }
    # D12: "state Array<F32>(n)" - a declaration's value comes after '='
    if fk == token.Tok.LParen and want == token.Tok.StmtEnd.Describe() and
       (pk == token.Tok.Gt or pk == token.Tok.Shr or pk == token.Tok.Iden) and pl == fl {
        return p.valueAfterEq(f)
    }
    return false
}

# S12b/D8c: "case P: a, b" - a comma after a case's value on its line, outside every bracket
fn (p Parser&) caseValueComma(f I64) Bool {
    if p.kindAt(f) != token.Tok.Comma { return false }
    line := p.lineAt(f)
    depth I64 = 0
    t := f - 1
    for t >= 0 and p.lineAt(t) == line {
        k := p.kindAt(t)
        if k == token.Tok.RParen or k == token.Tok.RBrack or k == token.Tok.RBrace {
            depth++
        } else if k == token.Tok.LParen or k == token.Tok.LBrack or k == token.Tok.LBrace {
            if depth == 0 { return false }
            depth--
        } else if k == token.Tok.Colon and depth == 0 {
            return p.lineStartsCase(t)
        }
        t--
    }
    return false
}

# whether the line of token t begins with "case"
fn (p Parser&) lineStartsCase(t I64) Bool {
    line := p.lineAt(t)
    s := t
    for s > 0 and p.lineAt(s - 1) == line { s-- }
    return p.kindAt(s) == token.Tok.Case
}

fn isOperandEndTok(k token.Tok) Bool {
    return k == token.Tok.Iden or k == token.Tok.RParen or k == token.Tok.RBrack or k == token.Tok.IntLit or
           k == token.Tok.FloatLit or k == token.Tok.CharLit or k == token.Tok.BoolLit or k == token.Tok.NullLit
}

# ...or a member named by a keyword, "s.done" (L9a)
fn (p Parser&) isOperandEnd(i I64) Bool {
    return isOperandEndTok(p.kindAt(i)) or (p.isKw(i) and p.kindAt(i - 1) == token.Tok.Dot)
}

fn isOperandTail(k token.Tok) Bool { return k == token.Tok.Iden or k == token.Tok.RParen or k == token.Tok.RBrack }

# the bracket matching the closing one at i, searching back: -1 for none
fn (p Parser&) openerOf(i I64) I64 {
    closer := p.kindAt(i)
    opener := token.Tok.LParen if closer == token.Tok.RParen else token.Tok.LBrack
    depth I64 = 0
    t := i
    for t >= 0 {
        k := p.kindAt(t)
        if k == closer {
            depth++
        } else if k == opener {
            depth--
            if depth == 0 { return t }
        }
        t--
    }
    return -1
}

# the first token of the postfix operand ending at last - "a.b(c)[d]" from its "]" - or -1 where it is not one (a
# rendering's "$" before it makes it a join piece already)
fn (p Parser&) operandStartBefore(last I64) I64 {
    t := last
    for _ in range 256 {
        k := p.kindAt(t)
        if k == token.Tok.RParen or k == token.Tok.RBrack {
            t = p.openerOf(t)
            if t < 0 { return -1 }
            b := t - 1
            if p.lineAt(b) == p.lineAt(t) and isOperandTail(p.kindAt(b)) {
                t = b
                continue
            }
        } else if p.isOperandEnd(t) {
            if p.kindAt(t - 1) == token.Tok.Dot and isOperandTail(p.kindAt(t - 2)) {
                t = t - 2
                continue
            }
        } else {
            return -1
        }
        return -1 if p.kindAt(t - 1) == token.Tok.Dollar else t
    }
    return -1
}

# the last token of the postfix operand starting at first - "a.b(c)[d]" from its "a"
fn (p Parser&) operandEndAfter(first I64) I64 {
    t := first
    n := p.ts.Toks.Len()
    for _ in range 256 {
        k := p.kindAt(t)
        if k == token.Tok.LParen or k == token.Tok.LBrack {
            opener := k
            closer := token.Tok.RParen if k == token.Tok.LParen else token.Tok.RBrack
            depth I64 = 0
            for t < n {
                kt := p.kindAt(t)
                if kt == opener {
                    depth++
                } else if kt == closer {
                    depth--
                    if depth == 0 { break }
                }
                t++
            }
            if t >= n { return first }
        }
        nx := t + 1
        if p.lineAt(nx) != p.lineAt(t) { return t }
        if p.kindAt(nx) == token.Tok.Dot and (p.kindAt(nx + 1) == token.Tok.Iden or p.isKw(nx + 1)) {
            t = nx + 1
            continue
        }
        if p.kindAt(nx) == token.Tok.LParen or p.kindAt(nx) == token.Tok.LBrack {
            t = nx
            continue
        }
        return t
    }
    return t
}

# E11b: "f(x "a")", "f("a" x)" - a value beside text with no "$": the hint shows the rendering to write
fn (p mut Parser&) joinPieceHint(from I64, to I64) Bool {
    if from < 0 or to < 0 or p.lineAt(from) != p.lineAt(to) { return false }
    a := p.ts.Toks[from]
    b := p.ts.Toks[to]
    # a long operand - a chain holding a lambda, say - is rendered whole by parenthesizing it
    if b.End > a.Start and b.End - a.Start <= 60 {
        p.reportAt(from, msgs.JoinPiece(p.src.Text[a.Start:b.End]))
    } else if from == to {
        p.reportAt(from, msgs.JoinPiece(p.text(a)))
    } else {
        p.reportAt(from, msgs.JoinPiece("(...)"))
    }
    return true
}

# E11b: whether i ends a "$" rendering - "$n", "$a.b(c)" - a join piece another piece may follow
fn (p Parser&) endsRendering(i I64) Bool {
    if not p.isOperandEnd(i) { return false }
    s := i
    for _ in range 256 {
        k := p.kindAt(s)
        if k == token.Tok.RParen or k == token.Tok.RBrack {
            s = p.openerOf(s)
            if s < 0 { return false }
            b := s - 1
            if p.kindAt(b) == token.Tok.Dollar { return true }
            if p.lineAt(b) == p.lineAt(s) and isOperandTail(p.kindAt(b)) {
                s = b
                continue
            }
            return false
        }
        b := s - 1
        if p.kindAt(b) == token.Tok.Dollar { return true }
        if p.kindAt(b) == token.Tok.Dot and isOperandTail(p.kindAt(s - 2)) {
            s = s - 2
            continue
        }
        return false
    }
    return false
}

# E11b: a text literal called - "$n "," (...)" - is a piece of text with "(" after it, which can only be a value to join
fn (p mut Parser&) textPieceCalled(f I64) Bool {
    fl := p.lineAt(f)
    from := f
    t := f
    for t >= 0 and p.lineAt(t) >= fl - 1 {
        from = t
        t--
    }
    t = from
    for t < p.ts.Toks.Len() and p.lineAt(t) <= fl {
        nx := t + 1
        if p.kindAt(t) == token.Tok.StrLit and p.kindAt(nx) == token.Tok.LParen and p.lineAt(nx) == p.lineAt(t) {
            p.reportAt(nx, msgs.JoinPieceCalled())
            return true
        }
        if nx == f { break }
        t++
    }
    return false
}

# D12: "state Array<F32>(n)" - a declaration's value follows '=': the hint writes both spellings out of the line
fn (p mut Parser&) valueAfterEq(f I64) Bool {
    paren := I64(p.ts.Toks[f].Start)
    ls := I64(p.src.LineStart(I32(p.lineAt(f))))
    le := paren
    for le < p.src.Text.Len() and p.src.Text[le] != '\n' { le++ }
    line := p.src.Text[ls:le]
    n := line.Len()
    at := paren - ls
    if at <= 0 or at >= n { return false }
    i I64 = 0
    for i < at and (line[i] == ' ' or line[i] == '\t') { i++ }
    nameStart := i
    for i < at and line[i] != ' ' and line[i] != '\t' { i++ }
    nameEnd := i
    for i < at and (line[i] == ' ' or line[i] == '\t') { i++ }
    if line[i:].StartsWith("mut ") {
        i += 4
        for i < at and line[i] == ' ' { i++ }
    }
    typeStart := i
    typeEnd := at
    for typeEnd > typeStart and line[typeEnd - 1] == ' ' { typeEnd-- }
    if nameEnd == nameStart or typeEnd == typeStart { return false }
    for k in range nameStart, at {
        if line[k] == '=' or line[k] == ':' or line[k] == '(' { return false }
    }
    depth I64 = 0
    close := at
    for close < n {
        if line[close] == '(' {
            depth++
        } else if line[close] == ')' {
            depth--
            if depth == 0 { break }
        }
        close++
    }
    if close >= n { return false }
    value := $line[typeStart:typeEnd] $line[at:close + 1]
    p.reportAt(f, msgs.ValueAfterEq(line[nameStart:typeEnd], value, line[nameStart:nameEnd], value))
    return true
}

# ---- tests ----

# for the tests: a text parsed - every branch's diagnostics chosen when all is set - as its declarations' shapes, then
# "!RULE" for each diagnostic said. types names the types the oracle knows (" List Map ")
fn shapeOf(text String&, types String& = "", all Bool = false) String {
    src := source.Source("t.olang", text)
    names := source.Names()
    o := Oracle()
    for t in types.Split(" ") {
        if t.Len() > 0 { o.Add(names, "", t) }
    }
    diags := diag.Diagnostics(false)
    file := diags.AddFile(src.Path, src.Text)
    ts := scan.Scan(src.Text)
    p := Parser(src, ts, names, o, diags, file)
    decls := p.File()
    if all { diags.ChooseAll() }
    b := StringBuilder()
    for d in decls {
        if b.Len() > 0 { b.Push("; ") }
        match d {
            case ast.Decl.Fn(f) {
                b.Push("fn " $names.Text(f.Name) ":")
                if not f.Bodied {
                    b.Push(" -")
                } else {
                    for s in f.Body { b.Push(" " $shapeStmt(s, names, src.Text)) }
                }
            }
            case ast.Decl.Type(_, t) {
                b.Push("type " $names.Text(t.Name))
                match t.Body {
                    case ast.TypeBody.Trait(ms, _, _) {
                        for m in ms { b.Push(" " $("mut " if m.Recv is not null else "") $names.Text(m.Name)) }
                    }
                    case _ { }
                }
            }
            case _ { b.Push("decl") }
        }
    }
    for s in diags.AllSaid() { b.Push(" !" $s.Rule) }
    return b.ToString()
}

fn shapeStmt(s ast.Stmt&, names source.Names&, text String&) String {
    return match s {
        case ast.Stmt.ExprS(_, x): shapeExpr(x, names, text)
        case ast.Stmt.Return(_, vs): "return" $(" " $shapeExpr(vs[0], names, text) if vs.Len() > 0 else "")
        case ast.Stmt.Become(_, x): "become " $shapeExpr(x, names, text)
        case ast.Stmt.Var(_, v): "var" $v.Names.Len() $(" :=" if v.Infer else "") $(" typed" if v.Ty is not null else "")
        case ast.Stmt.Multi(_, m): "multi" $m.Targets.Len() $(":=" if m.Define else "=") $m.Values.Len()
        case ast.Stmt.If(_, i): "if" $(" else" if i.Else is not null else "")
        case _: "stmt"
    }
}

fn shapeExpr(x ast.Expr&, names source.Names&, text String&) String {
    return match x {
        case ast.Expr.Name(_, n): $names.Text(n)
        case ast.Expr.Lit(sp, _): $text[sp.Start:sp.End]
        case ast.Expr.Paren(_, y): shapeExpr(y, names, text)
        case ast.Expr.Unary(_, op, y): "(" $op.Text() " " $shapeExpr(y, names, text) ")"
        case ast.Expr.Binary(_, op, a, b): "(" $op.Text() " " $shapeExpr(a, names, text) " " $shapeExpr(b, names, text) ")"
        case ast.Expr.Chain(_, c): "(chain " $c.Ops.Len() ")"
        case ast.Expr.Cond(_, a, c, b): ("(if " $shapeExpr(c, names, text) " " $shapeExpr(a, names, text) " "
                                           $shapeExpr(b, names, text) ")")
        case ast.Expr.Call(_, f, args): "(call " $shapeExpr(f, names, text) " " $args.Len() ")"
        case ast.Expr.Generic(_, y, args): "(generic " $shapeExpr(y, names, text) " " $args.Len() ")"
        case _: "expr"
    }
}

test "operators bind by E5's table: tighter first, left to right, not looser than a comparison" {
    assert shapeOf("fn f() I64 {\n    return a + b * c - d\n}\n") == "fn f: return (- (+ a (* b c)) d)"
    assert shapeOf("fn f() Bool {\n    return not a == b and c or d\n}\n") == "fn f: return (or (and (not (== a b)) c) d)"
    assert shapeOf("fn f() Bool {\n    return a < b <= c\n}\n") == "fn f: return (chain 2)"
    assert shapeOf("fn f() I64 {\n    return -a * b if c else d\n}\n") == "fn f: return (if c (* (- a) b) d)"
}

test "a list at a statement's start is read once and the token after it decides" {
    assert shapeOf("fn f() {\n    a, b := 1, 2\n    a, b = b, a\n    g(a)\n}\n") == "fn f: multi2:=2 multi2=2 (call g 1)"
    assert shapeOf("type P struct(x I32, y I32) {\n    x, y\n    p, q I32 = 1, 2\n}\n") == "type P"
}

test "a type-argument list splits the angles it closes, and Name< is a type only where the oracle says so" {
    s := shapeOf("fn f() {\n    x List<List<I32>>= List<List<I32>>()\n}\n", " List ")
    assert s == "fn f: var1 typed", s
    assert shapeOf("fn f() Bool {\n    return a < b and c > d\n}\n") == "fn f: return (and (< a b) (> c d))"
    assert shapeOf("fn f() {\n    g(List<I32>(3))\n}\n", " List ") == "fn f: (call g 1)"
}

test "an error skips its statement, and the items after it are read" {
    s := shapeOf("fn f() {\n    x := (1 +\n    y := 2\n}\nfn g() I64 {\n    return 1\n}\n")
    assert s.StartsWith("fn f:") and s.Contains("fn g: return 1") and s.CountOf("!") == 1, s
}

test "a function whose body does not parse is declared by its signature" {
    # an error inside a statement leaves the body read; a body never closed leaves the function its signature
    assert shapeOf("fn f() {\n    x := )\n}\nfn g() {\n}\n") == "fn f:; fn g: !"
    s := shapeOf("fn f() {\n    x := )\n")
    assert s.StartsWith("fn f: -"), s
}

test "nesting past the limit is one diagnostic (L21), never a crash" {
    deep := StringBuilder()
    deep.Push("fn f() I64 {\n    return ")
    for _ in range 20001 { deep.PushChar('(') }
    deep.PushChar('1')
    for _ in range 20001 { deep.PushChar(')') }
    deep.Push("\n}\nfn g() {\n}\n")
    # the parser recurses as deep as the program nests: it runs on a stack sized for that, as the compiler does
    os.RunOnStack(1 << 30, fn() {
        s := shapeOf(deep.ToString())
        # f stays declared by its signature (its body is the item the limit ended)
        assert s == "fn f: -; fn g: !L21", s
    })
}

test "a statement met at the limit is too deep at its first token, and one that nests nothing keeps its item (L21)" {
    atLimit := fn(stmt String&) String {
        b := StringBuilder()
        b.Push("fn f() {\n    x := 1\n")
        for _ in range 19999 { b.Push("    if x > 0 {") }
        b.Push("\n")
        b.Push(stmt)
        b.Push("\n")
        for _ in range 19999 { b.PushChar('}') }
        b.Push("\n}\nfn g() {\n}\n")
        return shapeOf(b.ToString())
    }
    os.RunOnStack(1 << 30, fn() {
        # every statement is first read as one starting with an operand, so the limit is said at its first token;
        # break, error E.A and return nest nothing and are read whole; the others nest an operand or a block and end
        # the item
        for stmt in String&["break", "error E.A", "return"] {
            s := atLimit(stmt)
            assert s == "fn f: var1 := if; fn g: !L21", s
        }
        for stmt in String&["x++", "y := 2", "z I64 = 1", "try f()", "{ }"] {
            s := atLimit(stmt)
            assert s == "fn f: -; fn g: !L21", $stmt ": " $s
        }
    })
}

test "what a branch meets is held until the branch is chosen; a plain else keeps its branch" {
    text := "fn f() {\n    if c {\n        g()\n    } else {\n        x := )\n    }\n}\n"
    assert shapeOf(text) == "fn f: if else"
    assert shapeOf(text, "", true).Contains(" !"), shapeOf(text, "", true)
}

test "a trait method's mut is kept, as its receiver" {
    assert shapeOf("type T trait {\n    mut Next() I64\n    Len() I64\n}\n") == "type T mut Next Len"
}
