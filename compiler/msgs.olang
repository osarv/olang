# msgs - every diagnostic the compiler can give, one function each (compiler/DESIGN.md section 1.3).
#
# A function takes what its message names, typed, and returns a Msg: which diagnostic it is (Kind), the rule of the
# specification it applies (Rule - empty where no rule states it; never an invented one), and the text, lowercase and
# one line with no period at the end (B11): the headline, what is wrong, in about 80 characters. A message with more to
# say gives its reason as a Note and what to write instead as a Help, each a row of its own after the headline. diag
# records a Msg against where it is about.
#
# This file is the table's source, edited by hand: a diagnostic is a case of Diag and a function of the same name, one
# line each. checks/checks.olang holds this file to the specification.
#
# A token parameter is the token as a reader sees it - Tok(text), or EndOfLine or EndOfFile - and a type parameter is
# the type as source writes it. A Msg is diagmsg's (compiler/diagmsg.olang): these functions make one, and none is its
# builder (D19a) - its type is declared beside diag's other kinds of records, not here.

import r "diagmsg"

# a token as a reader sees it: its text in quotes, each byte that does not print escaped
fn Tok(text String&) String {
    b := StringBuilder()
    b.PushChar('\'')
    for c in text { b.Push(Esc(c)) }
    b.PushChar('\'')
    return b.ToString()
}

# ---- what a misspelt name most likely meant (B11) ----

# the edit distance between two names, letters compared without their case (Levenshtein's); 99 past 60 characters
fn Distance(a String&, b String&) I64 {
    if a.Len() > 60 or b.Len() > 60 { return 99 }
    prev := Array<I64>(b.Len() + 1)
    cur := Array<I64>(b.Len() + 1)
    for j in range b.Len() + 1 { prev[j] = j }
    for i in range 1, a.Len() + 1 {
        cur[0] = i
        for j in range 1, b.Len() + 1 {
            sub := prev[j - 1] + (0 if a[i - 1].ToLower() == b[j - 1].ToLower() else 1)
            del := prev[j] + 1
            ins := cur[j - 1] + 1
            k := sub if sub < del else del
            cur[j] = k if k < ins else ins
        }
        for j in range b.Len() + 1 { prev[j] = cur[j] }
    }
    return prev[b.Len()]
}

# whether a candidate d edits from a misspelt word is near enough to be what was meant: within about a third of the
# word (B7a), and not every letter of it changed
fn Near(word String&, d I64) Bool { return d <= (word.Len() + 2) / 3 and d < word.Len() }

# the nearest of the names offered for a misspelt word - "" while none is near - and how far it is
type Nearest struct(Word String&) {
    Word
    Best String& = ""
    Far I64 = 1 << 30
}

# a candidate offered: kept where it is nearer than any before it (the first of two as near)
fn (n mut Nearest&) Offer(cand String&) {
    if cand == n.Word or cand.Len() == 0 { return }
    d := Distance(n.Word, cand)
    if Near(n.Word, d) and d < n.Far {
        n.Best = cand
        n.Far = d
    }
}

# a builder offered as "Owner.Member" (D19): taken before any near name where the word is its old name - the member
# with its owner's name as one of its words ("ParseIP" for IP.Parse, "DateOf" for Date.Of), what a function making the
# type was called before it became the builder (builder_migrate's renaming read backward)
fn (n mut Nearest&) OfferBuilder(cand String&) {
    dot := try cand.FindByte('.') catch { return }
    owner := cand[:dot]
    member := cand[dot + 1:]
    if owner.Len() == 0 or owner.Len() >= n.Word.Len() or n.Far == 0 { return }
    at := try n.Word.Find(owner) catch { return }
    end := at + owner.Len()
    before := at == 0 or n.Word[at - 1].IsLower() or n.Word[at - 1].IsDigit()
    after := end == n.Word.Len() or n.Word[end].IsUpper()
    if not before or not after or $n.Word[:at] $n.Word[end:] != member { return }
    n.Best = cand
    n.Far = 0
}

# " - did you mean 'x'?" for the nearest name offered, "" for none
fn (n Nearest&) Hint() String { return $" - did you mean '" $n.Best "'?" if n.Best.Len() > 0 else "" }

# the two tokens no text spells
EndOfLine := "end of line"
EndOfFile := "end of file"

# a byte as a message shows it: itself where it prints, else escaped - \t, \n, \r, \0, or \xHH
fn Esc(c Char) String {
    if c == '\t' { return "\\t" }
    if c == '\n' { return "\\n" }
    if c == '\r' { return "\\r" }
    if c == '\0' { return "\\0" }
    if U8(c) < 32 or U8(c) >= 127 {
        hex := U8(c).Format(16)
        return "\\x" $(hex.PadStart(2, '0'))
    }
    b := StringBuilder()
    b.PushChar(c)
    return b.ToString()
}

