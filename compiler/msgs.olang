fn ReturnOwnStorage() r.Msg { return r.Msg(Diag.ReturnOwnStorage, "O26", "this value refers to this function's own storage", "the storage dies at the return", "return a copy ('$x', 'x.Copy()')") }

# O27 as placement (docs/sec8.md 4.3): a view kept where the storage it shows cannot be built - where it is kept is no
# scope that exists at run time, or not known here
fn ViewKept(name String&) r.Msg { return r.Msg(Diag.ViewKept, "O27", "this keeps a view of '" $name "' where no storage can be built for it", "where it is kept is not known here", "keep a copy of what it shows: '$x' or 'x.Copy()'") }

# ... returned: the result scope a view's storage would be built in is not known here
fn ViewReturned(name String&) r.Msg { return r.Msg(Diag.ViewReturned, "O27", "this returns a view of '" $name "' whose storage cannot be built", "it cannot be built where the result goes", "return the value (a result written without '&' copies it), or a copy: '$x'") }

# ... of the copy a match binding or a lambda's capture made where it stands (S13b, D16c), which lives no longer
fn ViewKeptCopy(name String&) r.Msg { return r.Msg(Diag.ViewKeptCopy, "O27", "this keeps a view of '" $name "', the copy its match or lambda made", "the copy is made where it stands and goes with it", "keep a copy of what it shows: '$x' or 'x.Copy()'") }

# O25i (NLL, docs/sec8.md 3.4): a read of a reference local an assignment may have given storage that no longer lives
# where the read stands, and that cannot be built longer
fn ReadAfterScope(name String&) r.Msg { return r.Msg(Diag.ReadAfterScope, "O25i", "this reads '" $name "', which may have storage that no longer lives here", "an assignment may have given it that storage", "assign it a copy ('$x' or 'x.Copy()'), or what lives here") }

# O25i, O12: something built or stored exactly where a reference local's referent lives, its versions reaching here living
# in different scopes
fn VersionsDiffer(name String&) r.Msg { return r.Msg(Diag.VersionsDiffer, "O25i, O12", "'" $name "' may hold values of different scopes here", "so where its referent lives is not known, and nothing new is built or stored through it", "give it values of one scope, or store through each where it is assigned") }

# O20 under the inference (docs/rework.md 2.6, 3): a value read out of a container this function builds, kept where the
# container does not live, through a field that cannot have a binding of its own
fn PartKept(part String&, whole String&) r.Msg { return r.Msg(Diag.PartKept, "O20", "'" $part "' lives where '" $whole "' does, which closes first", "", "keep a copy ('$" $part "'), or keep what '" $whole "' was made from") }

