fn FactUndecided(text String&) r.Msg { return r.Msg(Diag.FactUndecided, "G42", "'" $text "' cannot be decided", "the code it reads it from changes with its value", "read it outside what it decides") }
fn FactNoFunction(fact String&) r.Msg { return r.Msg(Diag.FactNoFunction, "G42", $fact " is read through a function", "", "write it through a function's name or a function's descriptor ('f." $fact "', 'd." $fact "' in a walk of 'm.Functions')") }
fn CapsOneFile() r.Msg { return r.Msg(Diag.CapsOneFile, "B11c", "explain -caps takes one program's file, as 'olang explain -caps main.olang'") }
fn ListingUsage(opt String&) r.Msg { return r.Msg(Diag.ListingUsage, "B11d", $"explain " $opt " takes a program's file and a function's name", "", "write 'olang explain " $opt " main.olang main'") }
fn ListingNoFunction(name String&, file String&) r.Msg { return r.Msg(Diag.ListingNoFunction, "B11d", $"'" $name "' is no function of " $file, "explain -asm and -ir show a function's code, or a method's as 'Type.Method'") }
fn ListingAlone() r.Msg { return r.Msg(Diag.ListingAlone, "B11d", "-asm, -ir and -caps exclude one another - explain shows one of them at a time") }
fn ListingQuick(opt String&) r.Msg { return r.Msg(Diag.ListingQuick, "B11d", $opt " applies to explain only with -asm or -ir, which show code as a build makes it") }
