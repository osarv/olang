fn AssertMsgLoopJump(tok String&) Msg { return Msg(Diag.AssertMsgLoopJump, "S17", $tok " may not leave an assert's message - it is evaluated only when the assert fails") }

# ERR_ASSERT_MESSAGE_NOT_TEXT
fn AssertMessageNotText(ty String&) Msg { return Msg(Diag.AssertMessageNotText, "S18a", "an assertion's message is text, found " $ty " - write it as text: \"x is \" $x") }

