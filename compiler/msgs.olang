fn FuncValueObligations(text String&) Msg { return Msg(Diag.FuncValueObligations, "T22a", "'" $text "' relates its arguments' scopes, which a call through a function value cannot check - call it directly") }

# ERR_LAMBDA_VALUE_OBLIGATIONS
fn LambdaValueObligations(text String&) Msg { return Msg(Diag.LambdaValueObligations, "T22a", "this lambda keeps '" $text "' beyond the call, which a call through a function value cannot check - keep a copy instead") }

# ERR_LAMBDA_VALUE_RELATES
fn LambdaValueRelates() Msg { return Msg(Diag.LambdaValueRelates, "T22a", "this lambda relates its arguments' scopes, which a call through a function value cannot check") }

# ERR_CALL_VALUE_OBLIGATIONS
