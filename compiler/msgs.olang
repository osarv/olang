fn NoteLiteralLocal(text1 String&, ty1 String&, text2 String&, ty2 String&) r.Msg { return r.Msg(Diag.NoteLiteralLocal, "", "'" $text1 "' is " $ty1 ", its literal's own type - declare the type it should have, '" $text2 " " $ty2 " = ...'") }
fn NoteLiteralRange(text1 String&, ty1 String&, ty2 String&, text2 String&, ty3 String&) r.Msg { return r.Msg(Diag.NoteLiteralRange, "", "the range's literals make '" $text1 "' " $ty1 " - write '" $ty2 "(" $text2 ")' here for " $ty3 " values") }
