# errmsg.h's entries, one function each, under the C id each comes from

# ERR_USAGE
fn Usage() Msg { return Msg(Diag.Usage, "B1", "nothing to do - write a file to build and run, as 'olang main.olang', or a mode ('olang help' lists them)") }

# ERR_NOT_A_MODE
fn NotAMode(text String&) Msg { return Msg(Diag.NotAMode, "B1", "'" $text "' is not a mode - the modes are build, compile, test, interpret, format, explain and help, and a file ending in .olang is built and run") }

# ERR_MODE_ONE_FILE
fn ModeOneFile(text String&) Msg { return Msg(Diag.ModeOneFile, "B1", $text " takes exactly one file") }

# ERR_MODE_NEEDS_FILE
fn ModeNeedsFile(text String&) Msg { return Msg(Diag.ModeNeedsFile, "B1", $text " needs a file") }

# ERR_UNKNOWN_FLAG
fn UnknownFlag(text1 String&, text2 String&) Msg { return Msg(Diag.UnknownFlag, "B1", "unknown option '" $text1 "' - 'olang help' lists the options of " $text2) }

# ERR_OPTION_NOT_FOR_MODE
fn OptionNotForMode(text1 String&, text2 String&, text3 String&) Msg { return Msg(Diag.OptionNotForMode, "B1", $text1 " applies to " $text2 ", not to " $text3) }

# ERR_OPTION_NEEDS_VALUE
fn OptionNeedsValue(text1 String&, text2 String&) Msg { return Msg(Diag.OptionNeedsValue, "B1", $text1 " needs a value after it: " $text2) }

# ERR_NOT_A_SOURCE
fn NotASource(text String&) Msg { return Msg(Diag.NotASource, "B1", "'" $text "' is no olang file to run - a file's name ends in .olang") }

# ERR_MODE_FIRST
fn ModeFirst(text String&) Msg { return Msg(Diag.ModeFirst, "B1", "the mode comes first: 'olang " $text "' and then its options") }

# ERR_HELP_ONE_MODE
fn HelpOneMode() Msg { return Msg(Diag.HelpOneMode, "B1", "help takes at most one mode") }

# ERR_OUTPUT_IS_DIR
fn OutputIsDir(text String&) Msg { return Msg(Diag.OutputIsDir, "B3h", "-output " $text " is a directory - name the file to write") }

# ERR_OUTPUT_NO_DIR
fn OutputNoDir(text1 String&, text2 String&) Msg { return Msg(Diag.OutputNoDir, "B3h", "-output " $text1 ": there is no directory " $text2) }

# ERR_OUTPUT_CANNOT_WRITE
fn OutputCannotWrite() Msg { return Msg(Diag.OutputCannotWrite, "B3h", "cannot write it") }

# ERR_CANNOT_RUN
fn CannotRun(text String&) Msg { return Msg(Diag.CannotRun, "B3g", "the program cannot be run: " $text) }

# ERR_FORMATTER_MISSING
fn FormatterMissing(text String&) Msg { return Msg(Diag.FormatterMissing, "B13", "the formatter's source is not beside this compiler: " $text) }

# ERR_FORMATTER_BUILD
fn FormatterBuild(text String&) Msg { return Msg(Diag.FormatterBuild, "B13", "the formatter could not be built - " $text " says why") }

# ERR_TARGET_MISSING
fn TargetMissing() Msg { return Msg(Diag.TargetMissing, "B12", "-target needs a target after it, as '-target x86-64-v3'") }

# ERR_TARGET_UNKNOWN
fn TargetUnknown(text String&) Msg { return Msg(Diag.TargetUnknown, "B12", "unknown target '" $text "' - write native, x86-64, x86-64-v2, x86-64-v3, x86-64-v4, a CPU clang knows ('clang --print-supported-cpus'), or a triple x86_64-linux-gnu or aarch64-linux-gnu, ':CPU' after it if wanted") }

# ERR_TARGET_UNSUPPORTED
fn TargetUnsupported(text String&) Msg { return Msg(Diag.TargetUnsupported, "B12", "olang does not build for '" $text "' - it builds for x86_64 and aarch64 Linux with the GNU C library") }

# ERR_TARGET_NATIVE_FOREIGN
fn TargetNativeForeign(text String&) Msg { return Msg(Diag.TargetNativeForeign, "B12", "'-target " $text "': native is this machine's CPU - name the other architecture's CPU after ':', or none for its default") }

# ERR_TARGET_FOREIGN_MODE
fn TargetForeignMode(text1 String&, text2 String&) Msg { return Msg(Diag.TargetForeignMode, "B12a", $text1 " builds and runs on this machine, and '-target " $text2 "' is another architecture or system - only compile builds for it") }

# ERR_TARGET_NO_BACKEND
fn TargetNoBackend(text String&) Msg { return Msg(Diag.TargetNoBackend, "B12a", "this clang cannot build for '" $text "': its back end for that architecture cannot generate the BF16 code the runtime holds") }

# ERR_TARGET_NO_CLANG
fn TargetNoClang(text String&) Msg { return Msg(Diag.TargetNoClang, "B12", "clang not found on PATH - it is what builds the program, and what says what target '" $text "' is") }

# ERR_EXPLAIN_NEEDS_RULE
fn ExplainNeedsRule() Msg { return Msg(Diag.ExplainNeedsRule, "B11a", "explain takes one rule, as 'olang explain B1'") }

# ERR_NO_SPEC
fn NoSpec(text String&) Msg { return Msg(Diag.NoSpec, "B11a", "no specification at " $text) }

# ERR_NO_RULE
fn NoRule(text String&) Msg { return Msg(Diag.NoRule, "B11a", "the specification has no rule " $text) }

# ERR_DEFINE_MISSING
fn DefineMissing() Msg { return Msg(Diag.DefineMissing, "B10", "-define needs Name=value after it") }

# ERR_DEFINE_SHAPE
fn DefineShape(text String&) Msg { return Msg(Diag.DefineShape, "B10", "-define takes Name=value, found '" $text "'") }

# ERR_DEFINE_NOT_NAME
fn DefineNotName(text1 String&, text2 String&) Msg { return Msg(Diag.DefineNotName, "B10", "-define " $text1 "=" $text2 ": the name is not an identifier") }

# ERR_DEFINE_TWICE
fn DefineTwice(text1 String&, text2 String&) Msg { return Msg(Diag.DefineTwice, "B10", "-define " $text1 "=" $text2 ": defined twice") }

# ERR_DEFINE_BAD_NUMBER
fn DefineBadNumber(text1 String&, text2 String&) Msg { return Msg(Diag.DefineBadNumber, "B10", "-define " $text1 "=" $text2 ": not a number - '0x' and '0b' take digits of their own base") }

# ERR_DEFINE_INT_RANGE
fn DefineIntRange(text1 String&, text2 String&) Msg { return Msg(Diag.DefineIntRange, "B10", "-define " $text1 "=" $text2 ": beyond 64 bits") }

# ERR_DEFINE_NEG_RANGE
fn DefineNegRange(text1 String&, text2 String&) Msg { return Msg(Diag.DefineNegRange, "B10", "-define " $text1 "=" $text2 ": below I64's minimum") }

# ERR_DEFINE_FLOAT_RANGE
fn DefineFloatRange(text1 String&, text2 String&) Msg { return Msg(Diag.DefineFloatRange, "B10", "-define " $text1 "=" $text2 ": beyond F64's range") }

# ERR_DEFINE_BUILTIN
fn DefineBuiltin(text String&) Msg { return Msg(Diag.DefineBuiltin, "B10a", "-define cannot redefine the built-in constant " $text) }

# ERR_CANNOT_OPEN
fn CannotOpen() Msg { return Msg(Diag.CannotOpen, "", "cannot open this file") }

# ERR_NOT_REGULAR
fn NotRegular() Msg { return Msg(Diag.NotRegular, "", "not a regular file") }

# ERR_IS_DIRECTORY
fn IsDirectory() Msg { return Msg(Diag.IsDirectory, "M1", "a directory - a module is one .olang file") }

# ERR_NO_MAIN
fn NoMain() Msg { return Msg(Diag.NoMain, "B4", "no main function - a program starts at 'fn main() ? { }'") }

# ERR_NO_CLANG
fn NoClang(text String&) Msg { return Msg(Diag.NoClang, "", "clang not found on PATH - install clang-20 (the IR is in " $text ")") }

# ERR_CLANG_FAILED
fn ClangFailed(text String&) Msg { return Msg(Diag.ClangFailed, "", "clang could not compile " $text) }

# ERR_LINK_FAILED
fn LinkFailed(text String&) Msg { return Msg(Diag.LinkFailed, "", "linking " $text " failed") }

# ERR_UNKNOWN_CHAR
fn UnknownChar(ch Char) Msg { return Msg(Diag.UnknownChar, "L16", "unexpected character '" $Esc(ch) "'") }

# ERR_SEMICOLON
fn Semicolon() Msg { return Msg(Diag.Semicolon, "L18", "olang has no ';' - a statement ends where its line does; put the next one on a line of its own") }

# ERR_NON_ASCII
fn NonAscii(ch Char) Msg { return Msg(Diag.NonAscii, "L1", "non-ASCII byte '" $Esc(ch) "' - olang source is ASCII") }

# ERR_CARRIAGE_RETURN
fn CarriageReturn() Msg { return Msg(Diag.CarriageReturn, "L3", "carriage return - save the file with LF line endings") }

# ERR_NUL_BYTE
fn NulByte() Msg { return Msg(Diag.NulByte, "L1", "NUL byte in the source - is this a text file?") }

# ERR_UNCLOSED_COMMENT
fn UnclosedComment() Msg { return Msg(Diag.UnclosedComment, "L4a", "unterminated block comment - '##' closes it") }

# ERR_UNCLOSED_STRING
fn UnclosedString() Msg { return Msg(Diag.UnclosedString, "L14", "unterminated string literal") }

# ERR_STRING_NEWLINE
fn StringNewline() Msg { return Msg(Diag.StringNewline, "L14", "string literal not closed on its line - write \\n for a newline") }

# ERR_UNCLOSED_CHAR
fn UnclosedChar() Msg { return Msg(Diag.UnclosedChar, "L13", "unterminated character literal") }

# ERR_CHAR_NEWLINE
fn CharNewline() Msg { return Msg(Diag.CharNewline, "L13", "character literal not closed on its line") }

# ERR_EMPTY_CHAR
fn EmptyChar() Msg { return Msg(Diag.EmptyChar, "L13", "empty character literal") }

# ERR_LONG_CHAR
fn LongChar() Msg { return Msg(Diag.LongChar, "L13", "character literal holds more than one character - text is written in \"\"") }

# ERR_BAD_ESCAPE
fn BadEscape(ch Char) Msg { return Msg(Diag.BadEscape, "L15", "unknown escape '\\" $Esc(ch) "' - the escapes are \\n \\t \\r \\0 \\\\ \\' \\\"") }

# ERR_HEX_NO_DIGITS
fn HexNoDigits() Msg { return Msg(Diag.HexNoDigits, "L10a", "'0x' needs hexadecimal digits") }

# ERR_BIN_NO_DIGITS
fn BinNoDigits() Msg { return Msg(Diag.BinNoDigits, "L10c", "'0b' needs binary digits") }

# ERR_HEX_DIGIT
fn HexDigit(ch Char) Msg { return Msg(Diag.HexDigit, "L10a", "'" $Esc(ch) "' is not a hexadecimal digit") }

# ERR_BIN_DIGIT
fn BinDigit(ch Char) Msg { return Msg(Diag.BinDigit, "L10c", "'" $Esc(ch) "' is not a binary digit") }

# ERR_DIGIT_SEPARATOR
fn DigitSeparator() Msg { return Msg(Diag.DigitSeparator, "L10b", "'_' in a number must stand between two digits") }

# ERR_POINT_NO_DIGIT
fn PointNoDigit() Msg { return Msg(Diag.PointNoDigit, "L12", "a decimal point needs a digit after it") }

# ERR_TWO_POINTS
