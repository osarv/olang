# ERR_TYPE_VAR_NOT_INFERABLE
fn TypeVarNotInferable(text String&) Msg { return Msg(Diag.TypeVarNotInferable, "G4", "type variable " $text " appears in no parameter's type, so no call can infer it - introduce it in a parameter's type") }

