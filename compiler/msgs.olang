# ---- contracts (D17) ----

fn ContractOutlivesNoScope(tok String&) Msg { return Msg(Diag.ContractOutlivesNoScope, "D17d", $tok " names no scope - an 'outlives' item names a reference parameter, a parameter holding references, or 'return'") }

fn ContractOutlivesNotParam(tok String&) Msg { return Msg(Diag.ContractOutlivesNotParam, "D17d", $tok " is no parameter of this function - an 'outlives' item names its parameters and 'return'") }

fn ContractNeedsArgumentError(name String&) Msg { return Msg(Diag.ContractNeedsArgumentError, "D17", $name " has conditions, so a call fails with ArgumentError where one is false - add it after '?'") }
fn ContractFalse(cond String&, name String&) Msg { return Msg(Diag.ContractFalse, "D17e", $"this call breaks " $name "'s requirement '" $cond "'") }

fn ConversionDoesNotFit(value String&, ty String&) Msg { return Msg(Diag.ConversionDoesNotFit, "D17g", $value " does not fit " $ty " - write a value that fits, or 'try x.Narrow<" $ty ">()' to fail with an error") }

fn NoteContractCondition() Msg { return Msg(Diag.NoteContractCondition, "", "the condition") }

test "a message is its text, its arguments in their places" {
    m := Expected("'}'", Tok("South"))
    assert m.Text == "expected '}', found 'South'" and m.Rule == "" and m.Kind == Diag.Expected
    assert UnknownChar('@').Rule == "L16"
    assert NoMain().Text == "no main function - a program starts at 'fn main() { }'"
}

test "a byte that does not print is escaped, in a character and in a token" {
    assert UnknownChar('\t').Text == "unexpected character '\\t'"
    assert Esc(Char(1)) == "\\x01" and Esc(Char(200)) == "\\xc8" and Esc('a') == "a"
    assert Tok("a\nb") == "'a\\nb'"
    assert Expected("a name", EndOfLine).Text == "expected a name, found end of line"
}
