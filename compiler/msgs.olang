fn NoteVecGrowsInside(text String&) r.Msg { return r.Msg(Diag.NoteVecGrowsInside, "", $text " may grow it here") }
fn NoteVecTaskHolds(text String&) r.Msg { return r.Msg(Diag.NoteVecTaskHolds, "", "the task holding a view of '" $text "' is started here") }
fn NoteStrBuildsHere() r.Msg { return r.Msg(Diag.NoteStrBuildsHere, "", "built here, where the receiver's part it was handed lives") }
fn NoteStrKeepCopies(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.NoteStrKeepCopies, "", "'" $text1 "' cannot be made where '" $text2 "' lives: a Str builds nothing where its receiver does - keep copies of what it reads instead of references") }
