fn NotSliceable(ty String&) r.Msg { return r.Msg(Diag.NotSliceable, "E16a", $ty " cannot be sliced") }
fn SliceBoundNotInt(ty String&) r.Msg { return r.Msg(Diag.SliceBoundNotInt, "E16a", "a slice's bounds are integers, found " $ty) }
fn NoSuchMember(ty String&, text String&, hint String&) r.Msg { return r.Msg(Diag.NoSuchMember, "", $ty " has no member '" $text "'" $hint) }
fn MemberIsPrivate(text String&, ty String&) r.Msg { return r.Msg(Diag.MemberIsPrivate, "M6a", "member '" $text "' of " $ty " is private to its module") }
fn NotAssignable() r.Msg { return r.Msg(Diag.NotAssignable, "S4", "this cannot be written - a variable, an element or a member can") }
fn AssignIntoTried() r.Msg { return r.Msg(Diag.AssignIntoTried, "R9a", "a 'try ... catch' value is a copy, so nothing written into it is kept", "it is the element or what a clause gives, a copy either way", "write into the collection itself, 'x[i].f = v'") }
fn IncdecNotNumber(tok String&, ty String&) r.Msg { return r.Msg(Diag.IncdecNotNumber, "S3a", $tok " takes a number, found " $ty) }
fn CaptureReadOnly() r.Msg { return r.Msg(Diag.CaptureReadOnly, "D16c", "a lambda's captures are read-only - capture a reference to change what is outside it") }
fn ReadOnlyRefWrite() r.Msg { return r.Msg(Diag.ReadOnlyRefWrite, "T25b", "this writes through a read-only reference - one with no 'mut' in its type") }
fn WriteIntoCallValue() r.Msg { return r.Msg(Diag.WriteIntoCallValue, "E31", "this writes into a value a call gave back", "it is a copy no one holds", "store the whole element: x[i] = v") }
fn Immutable(text String&) r.Msg { return r.Msg(Diag.Immutable, "S6", $text " cannot be written - only a local, a parameter or a 'mut' global can") }
fn StrStoresInReceiver() r.Msg { return r.Msg(Diag.StrStoresInReceiver, "E11c, O12", "this Str builds and stores nothing where its receiver's references reach", "'$' does not say where a value it renders lives", "take the receiver by reference ('x T&'), or build what it needs here") }
fn StrReceiverWritable() r.Msg { return r.Msg(Diag.StrReceiverWritable, "E11c, T25c", "Str only reads its receiver", "'$' renders read-only values too", "pass on what it holds read-only") }
fn NoteUnassignedDecl() r.Msg { return r.Msg(Diag.NoteUnassignedDecl, "", "declared here with no value") }
fn NoteUnassignedNoElse() r.Msg { return r.Msg(Diag.NoteUnassignedNoElse, "", "when this condition is false nothing assigns it - this 'if' has no 'else'") }
fn NoteUnassignedBranch() r.Msg { return r.Msg(Diag.NoteUnassignedBranch, "", "this branch does not assign it") }
fn NoteUnassignedLoop() r.Msg { return r.Msg(Diag.NoteUnassignedLoop, "", "this loop may run no times - assigning in its body does not count") }
fn NoteUnassignedArm() r.Msg { return r.Msg(Diag.NoteUnassignedArm, "", "this arm does not assign it") }
fn NoteUnassignedClause() r.Msg { return r.Msg(Diag.NoteUnassignedClause, "", "this clause runs when the try fails, which may be before the assignment") }
fn NoteReadUnassigned() r.Msg { return r.Msg(Diag.NoteReadUnassigned, "", "read here before it is assigned on every path - assign it on each path before this read") }
fn NoteHere() r.Msg { return r.Msg(Diag.NoteHere, "", "here") }
fn NoteFuncTypeScopes(ty String&) r.Msg { return r.Msg(Diag.NoteFuncTypeScopes, "", "a function type says where each reference argument and the result live, as the function does - write '" $ty "', or pass a lambda calling it") }
fn NoteVecGrewHere() r.Msg { return r.Msg(Diag.NoteVecGrewHere, "", "the Vec grew here, after the view was taken; take the view after the growth, or copy the elements first: 'v.ToArray()'") }
