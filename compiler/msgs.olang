fn SpawnResultVoid() r.Msg { return r.Msg(Diag.SpawnResultVoid, "P1g", "this call returns nothing to bind - drop the target") }
fn SpawnResultType(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.SpawnResultType, "P1g", "a spawn target has exactly the call's type " $ty1 ", found " $ty2 " - convert after the join") }
fn SpawnResultAsRef(ty1 String&, ty2 String&, text String&, ty3 String&) r.Msg { return r.Msg(Diag.SpawnResultAsRef, "P1g", "a spawn target has exactly the call's type " $ty1 ", found " $ty2, "", "declare '" $text "' to give " $ty3 ", built where its result lands") }
fn SpawnResultTooShort() r.Msg { return r.Msg(Diag.SpawnResultTooShort, "P1g", "this target closes before the join does - declare it at the join's level or wider") }
fn SpawnResultsDisagree() r.Msg { return r.Msg(Diag.SpawnResultsDisagree, "P1g", "these targets live in different scopes, and the results are built in one") }
fn FuncValueObligations(text String&, place String&) r.Msg { return r.Msg(Diag.FuncValueObligations, "T22a", "'" $text "' ties where what it is given lives to what it keeps or gives back", $place " holds only what its written function type says of every call", "call it directly, or hold it in a local and call it there") }
fn LambdaValueObligations(text String&, place String&) r.Msg { return r.Msg(Diag.LambdaValueObligations, "T22a", "this lambda keeps '" $text "' beyond the call", $place " holds only what its written function type says of every call", "keep a copy instead, or hold the lambda in a local and call it there") }
fn LambdaValueRelates(place String&) r.Msg { return r.Msg(Diag.LambdaValueRelates, "T22a", "this lambda ties where what it is given lives to what it keeps or gives back", "its captures are included, and " $place " holds only what its written function type says of every call", "hold it in a local and call it there") }
# a function value at a boundary doing what one promise word would say of its place's type (T22b): the word to write
fn ValueBeyondType(subject String&, does String&, place String&, word String&) r.Msg { return r.Msg(Diag.ValueBeyondType, "T22b", $subject " " $does, "the function type of " $place " says nothing of that", "write '" $word "' after its signature") }
# 2.2.1: a lambda keeping an argument in a capture that outlives the lambda, held where "keeps x" is all the type says
fn LambdaKeepsOuter(text String&) r.Msg { return r.Msg(Diag.LambdaKeepsOuter, "T22b", "this lambda keeps '" $text "' in what it captured from an outer scope", "that scope outlives where the lambda lives, and 'keeps " $text "' says only that '" $text "' outlives the lambda", "capture from one scope, or hold the lambda in a local and call it there") }
# a function value whose functions are not followed, held as a type promising more than its own (T22b)
# a function value whose functions are followed doing what an effect word of the type it is held as denies (T22b)
fn EffectBeyond(what String&, does String&, want String&, word String&) r.Msg { return r.Msg(Diag.EffectBeyond, "T22b", $what " may " $does, "'" $want "', the type it is held as here, promises '" $word "'", "give a function that does not, or hold it as a type without '" $word "'") }
fn NoteEffect(text String&) r.Msg { return r.Msg(Diag.NoteEffect, "", text) }
fn FuncTypeBeyond(have String&, want String&, word String&) r.Msg { return r.Msg(Diag.FuncTypeBeyond, "T22b", "a value of type '" $have "' may do what '" $want "' does not say ('" $word "')", "which functions it holds is not known here", "write '" $word "' after the signature of the type it is held as, or give a function directly") }

# T21c: a promise's misuses
fn PromiseMisplaced(word String&) r.Msg { return r.Msg(Diag.PromiseMisplaced, "T21c", "'" $word "' is a promise, written only after a function type's signature", "what a function itself does is read off its body ('olang explain' shows it)") }
fn PromiseNoParam(name String&) r.Msg { return r.Msg(Diag.PromiseNoParam, "T21c", "'" $name "' is no parameter of this function type", "a promise names its parameters by the names written in it") }
fn PromiseTwice(word String&) r.Msg { return r.Msg(Diag.PromiseTwice, "T21c", "'" $word "' is promised twice - write it once") }
fn PromiseReturnsNoreturn() r.Msg { return r.Msg(Diag.PromiseReturnsNoreturn, "T21c", "'returns' promises every call comes back, and 'noreturn' that none does - write one of them") }
fn PromiseBorrowsNothing(word String&) r.Msg { return r.Msg(Diag.PromiseBorrowsNothing, "T21c", "this function type's result holds no reference, so '" $word "' says nothing - leave it out") }
fn PromiseBorrowsValue(name String&) r.Msg { return r.Msg(Diag.PromiseBorrowsValue, "T21c", "'" $name "' holds no reference, so no result can refer into it - leave 'borrows " $name "' out") }
fn PromiseBorrowsBoth() r.Msg { return r.Msg(Diag.PromiseBorrowsBoth, "T21c", "'noborrow' and 'borrows' say opposite things", "'noborrow' says the result refers into no parameter, and 'borrows' that it may refer into one", "write one of them") }
fn PromiseKeepsValue(name String&) r.Msg { return r.Msg(Diag.PromiseKeepsValue, "T21c", "'" $name "' holds no reference and is not unique", "a call can keep only a copy of it, which needs no word", "leave the 'keeps' out") }
fn PromiseKeepsSelf(name String&) r.Msg { return r.Msg(Diag.PromiseKeepsSelf, "T21c", "'keeps " $name " in " $name "' keeps a parameter in itself, which says nothing - leave it out") }
fn PromiseKeepsInValue(name String&) r.Msg { return r.Msg(Diag.PromiseKeepsInValue, "T21c", "'" $name "' holds no reference, so nothing can be kept in what it refers to") }
fn PromiseKeepsPath(name String&, field String&) r.Msg { return r.Msg(Diag.PromiseKeepsPath, "T21c", "a promise names one field of a parameter - write 'in " $name "." $field "'") }
fn PromiseKeepsField(field String&, name String&) r.Msg { return r.Msg(Diag.PromiseKeepsField, "T21c", "'" $field "' is no field of what '" $name "' refers to") }

# type arguments written apart from the name or the "(" (G12)
fn TypeArgsSpaced(name String&) r.Msg { return r.Msg(Diag.TypeArgsSpaced, "G12", "type arguments are written touching the name and the '('", "with spaces, '<' and '>' compare", "write '" $name "<...>(...)'") }

# a Call failing with other errors than the function type it is wanted as
fn CallValueErrors(ty String&, has String&, wants String&, fix String&) r.Msg { return r.Msg(Diag.CallValueErrors, "T22, E31", $ty "'s Call fails with " $has " where the function type says " $wants, "the errors must be the same, in the same order", $fix) }
fn CallValueObligations(ty String&, place String&) r.Msg { return r.Msg(Diag.CallValueObligations, "T22a, E31", $ty "'s Call ties where what it is given lives to what it keeps or gives back", $place " holds only what its written function type says of every call", "call it by name, or hold the value in a local and call it there") }
fn LambdaResultUninferable() r.Msg { return r.Msg(Diag.LambdaResultUninferable, "D16b", "this value gives the lambda no result type - write one") }
fn LambdaArity(ty String&, n1 I64, text String&, n2 I64) r.Msg { return r.Msg(Diag.LambdaArity, "D16a", $ty " takes " $n1 " parameter" $text ", and this lambda " $n2) }
fn LambdaSignature(ty String&) r.Msg { return r.Msg(Diag.LambdaSignature, "D16a", "this lambda's signature disagrees with " $ty " - leave that part out, or make them agree") }
fn LambdaParamUntyped(tok String&) r.Msg { return r.Msg(Diag.LambdaParamUntyped, "D16a", "lambda parameter " $tok " has no type, and nothing gives it one - write it") }
fn AlreadyDeclared(tok String&) r.Msg { return r.Msg(Diag.AlreadyDeclared, "", $tok " is already declared here") }
fn MissingReturn(ty String&) r.Msg { return r.Msg(Diag.MissingReturn, "D10a", "the end can be reached without returning " $ty, "", "return on every path, or end it with 'unreachable'") }
fn BreakOutsideLoop(tok String&) r.Msg { return r.Msg(Diag.BreakOutsideLoop, "S11", $tok " acts on the innermost loop, and there is none here") }
fn DeferLoopJump(tok String&) r.Msg { return r.Msg(Diag.DeferLoopJump, "S19b", $tok " may not leave deferred code", "it runs while its block is left") }
fn CatchNotProduced(ty String&) r.Msg { return r.Msg(Diag.CatchNotProduced, "R14", "the call does not fail with " $ty) }
fn TryCatchOnSlice() r.Msg { return r.Msg(Diag.TryCatchOnSlice, "R10", "a try statement discards its value, leaving a slice nothing", "", "write 's := try a[lo:hi]' and catch where it is used") }
fn EmptyDestructor() r.Msg { return r.Msg(Diag.EmptyDestructor, "C7a", "this destructor does nothing - remove it") }
fn LiteralCtorFails(ty String&, text String&) r.Msg { return r.Msg(Diag.LiteralCtorFails, "T29d", "this literal enters " $ty " through its constructor, which does not run on it while compiling", $text) }
fn ZeroValueShared(ty String&) r.Msg { return r.Msg(Diag.ZeroValueShared, "D13c", $ty "'s zero value holds references, which a fill would share", "", "give a fill, or build the elements") }
fn NoZeroValue(ty String&, text String&) r.Msg { return r.Msg(Diag.NoZeroValue, "D13c", $ty " has no zero value, so this needs one", "its constructor does not run on zeros while compiling", $text) }
fn ReadUnassigned(name String&, ty String&, fix String&) r.Msg { return r.Msg(Diag.ReadUnassigned, "D13d", "'" $name "' is read here before it is assigned on every path", $ty " has no zero value", "assign it on each path before this read, or give it a value" $fix) }
fn FieldUnassigned(name String&, ty String&, fix String&) r.Msg { return r.Msg(Diag.FieldUnassigned, "D13d", "the field '" $name "' is not assigned on every path through the constructor", $ty " has no zero value", "assign it on each path, or give it a value" $fix) }
fn TopSetPlace() r.Msg { return r.Msg(Diag.TopSetPlace, "D13e", "a top-level assignment is written only inside a top-level 'if'", "it is a global's initializer", "give the value in the global's declaration") }
fn TopSetTarget(name String&) r.Msg { return r.Msg(Diag.TopSetTarget, "D13e", "'" $name "' is no global of this module declared above with no value", "only such a global is assigned at the top level") }
fn TopSetHasValue(name String&) r.Msg { return r.Msg(Diag.TopSetHasValue, "D13e", "'" $name "' has a value in its declaration", "a global is given its value once", "declare it with no value, or drop this assignment") }
fn TopSetTwice(name String&) r.Msg { return r.Msg(Diag.TopSetTwice, "D13e", "'" $name "' is assigned twice at the top level in this build", "each build gives a global one value") }
fn TopSetMissing(name String&, ty String&) r.Msg { return r.Msg(Diag.TopSetMissing, "D13e", "this branch does not assign '" $name "', and " $ty " has no zero value", "", "assign it in every branch of the 'if', or give it a value") }
fn TopSetNoElse(name String&, ty String&) r.Msg { return r.Msg(Diag.TopSetNoElse, "D13e", "this 'if' assigns '" $name "' and has no 'else', and " $ty " has no zero value", "", "add an 'else' assigning it, or give it a value") }
fn TopSetCondReads(name String&) r.Msg { return r.Msg(Diag.TopSetCondReads, "D13e", "this condition reads '" $name "', which its 'if' assigns", "a condition cannot decide the value it reads") }
