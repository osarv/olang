fn AssertFalse() r.Msg { return r.Msg(Diag.AssertFalse, "S18c", "this assertion is false, evaluated while compiling") }
fn AssertFalseMessage(text String&) r.Msg { return r.Msg(Diag.AssertFalseMessage, "S18c", "this assertion is false, evaluated while compiling: " $text) }
fn AssertFalseWritten(text String&) r.Msg { return r.Msg(Diag.AssertFalseWritten, "S18c", "this assertion is false, evaluated while compiling", "its message reads what only the running program knows, so it is shown as written: " $text) }
fn AssertMsgReturns(text String&) r.Msg { return r.Msg(Diag.AssertMsgReturns, "S17", $text " message may not return - it is evaluated only where it is used, and gives text") }
fn AssertMsgError(text String&) r.Msg { return r.Msg(Diag.AssertMsgError, "S17", "an error may not leave " $text " message - catch it here") }
fn AssertMsgLoopJump(tok String&, text String&) r.Msg { return r.Msg(Diag.AssertMsgLoopJump, "S17", $tok " may not leave " $text " message", "it is evaluated only where it is used") }
