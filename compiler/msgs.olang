fn BreakOutsideLoop(tok String&) Msg { return Msg(Diag.BreakOutsideLoop, "S11", $tok " acts on the innermost loop, and there is none here") }

# ERR_DEFER_LOOP_JUMP
fn DeferLoopJump(tok String&) Msg { return Msg(Diag.DeferLoopJump, "S19b", $tok " may not leave deferred code - it runs while its block is left") }

