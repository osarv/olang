fn OperandNotInt(tok String&, ty String&) r.Msg { return r.Msg(Diag.OperandNotInt, "E8", $tok " takes an integer, found " $ty) }
fn OperandNotNumber(tok String&, ty String&) r.Msg { return r.Msg(Diag.OperandNotNumber, "E6", $tok " takes numbers, found " $ty) }
fn TupleNotAValue() r.Msg { return r.Msg(Diag.TupleNotAValue, "D8c", "several results are not one value", "", "destructure them ('a, b := f()'), or pass them as all of a call's arguments") }
fn LiteralExprNoValue() r.Msg { return r.Msg(Diag.LiteralExprNoValue, "E4a", "this literal expression has no value", "no integer type holds it, from I128's least to U128's greatest") }
fn LiteralNoOwnType(what String&) r.Msg { return r.Msg(Diag.LiteralNoOwnType, "T6a, E4a", $what " needs more than 64 bits, and a literal's own type is at most U64", "", "give it the type it should have, as 'x U128 = ...', or convert an operand, as 'U128(1) << 100'") }
fn LiteralDoesNotMeet(ty1 String&, ty2 String&, ty3 String&) r.Msg { return r.Msg(Diag.LiteralDoesNotMeet, "E6d", "this literal does not fit " $ty1 ", and " $ty2 " does not flow into " $ty3 " - convert one") }
fn ShiftOutOfRange(ty String&, n1 I64, n2 I64) r.Msg { return r.Msg(Diag.ShiftOutOfRange, "E8a", "shifting " $ty " by " $n1 " is outside its width of " $n2 " bits") }
fn DivideByZero() r.Msg { return r.Msg(Diag.DivideByZero, "E6a", "division by zero") }
fn NumbersDoNotMeet(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.NumbersDoNotMeet, "T6b", $ty1 " and " $ty2 " do not meet - neither flows into the other; convert one") }
fn OperandsDiffer(tok String&, ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.OperandsDiffer, "", $tok " takes operands of one type, found " $ty1 " and " $ty2) }
fn FloatLiteralRange(tok String&) r.Msg { return r.Msg(Diag.FloatLiteralRange, "L12b", $tok " is beyond F64's range") }
fn NoSuchErrorWord(ty String&, tok String&, hint String&) r.Msg { return r.Msg(Diag.NoSuchErrorWord, "T19", $ty " has no word " $tok $hint) }
fn NoSuchCase(ty String&, tok String&) r.Msg { return r.Msg(Diag.NoSuchCase, "T17", $ty " has no case " $tok) }
fn NoSuchCaseMeant(ty String&, tok String&, text String&) r.Msg { return r.Msg(Diag.NoSuchCaseMeant, "T17", $ty " has no case " $tok " - did you mean '" $text "'?") }
fn ScopeArgCount() r.Msg { return r.Msg(Diag.ScopeArgCount, "E25", "a call takes at most one scope argument") }
fn MatmulUndeclared(ty String&) r.Msg { return r.Msg(Diag.MatmulUndeclared, "E31", "'@' has no built-in meaning, and " $ty " declares no MatMul") }
fn NotExtendedOp(ty String&, tok String&, text String&) r.Msg { return r.Msg(Diag.NotExtendedOp, "T29f", $ty " does not extend its base, so it takes no " $tok, "", "declare its method " $text ", or declare it with 'extends'") }
fn CondNotBoolType(ty String&) r.Msg { return r.Msg(Diag.CondNotBoolType, "", "a condition is a Bool, found " $ty) }
fn CondBranchTypes(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.CondBranchTypes, "E28", "both values of 'a if c else b' have one type, found " $ty1 " and " $ty2) }
fn MembershipNoMethod(text String&, ty String&) r.Msg { return r.Msg(Diag.MembershipNoMethod, "E29", "'x in c' calls " $text ", and " $ty " has none") }
fn MembershipNotBool(text String&) r.Msg { return r.Msg(Diag.MembershipNotBool, "E29", $text ", which 'in' calls, gives a Bool") }
fn MembershipNeedsTry(text String&) r.Msg { return r.Msg(Diag.MembershipNeedsTry, "E29", $text " can fail here - write 'try x in c'") }
fn IncdecInExpression(tok String&) r.Msg { return r.Msg(Diag.IncdecInExpression, "S3a", $tok " is a statement of its own, never part of an expression") }
fn NotCallable(ty String&) r.Msg { return r.Msg(Diag.NotCallable, "E13b", $ty " is not a function, and declares no Call") }
fn JoinPieceCalled() r.Msg { return r.Msg(Diag.JoinPieceCalled, "E11b", "'(' after a piece of text calls it - to join the value inside, write '$(...)'") }
fn UnhandledFallibleCall() r.Msg { return r.Msg(Diag.UnhandledFallibleCall, "E15", "this call can fail - write 'try', and catch or pass on its errors") }
fn VariadicNotLast() r.Msg { return r.Msg(Diag.VariadicNotLast, "D8g", "a variadic parameter is the last one but defaulted ones", "one variadic parameter, and only parameters with a default after it, given by name") }
fn VariadicHere(what String&) r.Msg { return r.Msg(Diag.VariadicHere, "D8g", "a variadic parameter is a function's, not " $what) }
fn VariadicDefault() r.Msg { return r.Msg(Diag.VariadicDefault, "D8g", "a variadic parameter takes no default - a call giving it no argument gives it the empty array") }
fn SpreadNotHere() r.Msg { return r.Msg(Diag.SpreadNotHere, "D8g", "'...a' stands nowhere here", "it passes an array on as a variadic parameter's arguments", "pass the array itself, 'a'") }
fn SpreadAlone() r.Msg { return r.Msg(Diag.SpreadAlone, "D8g", "'...a' stands alone among a variadic parameter's arguments", "it passes an array on as all of them", "leave the others out") }
