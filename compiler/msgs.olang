fn RestNotHere() r.Msg { return r.Msg(Diag.RestNotHere, "S13h", "'...' stands among an array pattern's items only", "it is for the elements they do not name", "write 'case Array<String&>[first, ...rest]'") }
fn RestTwice() r.Msg { return r.Msg(Diag.RestTwice, "S13h", "an array pattern has one '...', for the elements its other items do not name") }
fn RestNoSlice(ty String&) r.Msg { return r.Msg(Diag.RestNoSlice, "S13h", "a named rest is a slice, and " $ty " declares no Slice", "", "write a bare '...', or match the elements as an array (a Vec's View())") }
fn ElemsNotSeq(ty String&) r.Msg { return r.Msg(Diag.ElemsNotSeq, "S13h", "an array pattern matches an array, text or a type declaring At and Len", $ty " is none of them") }
fn ElemsType(written String&, elem String&) r.Msg { return r.Msg(Diag.ElemsType, "S13h", "this array pattern's elements are " $written ", and what is matched holds " $elem, "", "write 'Array<" $elem ">[...]'") }
fn StructPatNoField(ty String&, text String&, hint String&) r.Msg { return r.Msg(Diag.StructPatNoField, "S13i", $ty " has no field '" $text "'", "a struct pattern names the fields it matches, never its constructor's parameters" $hint) }
fn StructPatPositional(ty String&) r.Msg { return r.Msg(Diag.StructPatPositional, "S13i", "a struct pattern names the fields it matches", "the order of " $ty "'s fields is no part of it", "write 'field = pattern' or a field's name") }
fn StructPatType(ty String&, text String&) r.Msg { return r.Msg(Diag.StructPatType, "S13i", "the value matched here is " $ty ", and this struct pattern matches " $text) }
fn PatFieldTwice(text String&) r.Msg { return r.Msg(Diag.PatFieldTwice, "S13b", "field '" $text "' is named twice in this pattern") }
fn PatFieldBothWays(text String&) r.Msg { return r.Msg(Diag.PatFieldBothWays, "S13b", "field '" $text "' is matched by position and again by name") }
fn PatPositionAfterName() r.Msg { return r.Msg(Diag.PatPositionAfterName, "S13b", "an item by position follows one by name", "", "items by position come first, as a call's arguments do") }
fn PayloadNoField(text String&, name String&, hint String&) r.Msg { return r.Msg(Diag.PayloadNoField, "S13b", "case " $text " has no field '" $name "'" $hint) }
fn WholeCaseNamed(text String&, ty String&) r.Msg { return r.Msg(Diag.WholeCaseNamed, "S13b", "case " $text " carries one whole " $ty " and has no field names", "", "match its fields with a struct pattern, '" $text "(" $ty "(field = ...))'") }
fn MatchLengthUncovered(ty String&, what String&) r.Msg { return r.Msg(Diag.MatchLengthUncovered, "S13h", "a match over " $ty " gives a value only when its cases cover every value", "none matches an array of " $what, "add a case for it, or 'case _: v'") }
fn PowNone(ty String&, hint String&) r.Msg { return r.Msg(Diag.PowNone, "E5a", "'**' calls Pow, which " $ty " has none of" $hint) }
fn OperatorCallFails(text String&) r.Msg { return r.Msg(Diag.OperatorCallFails, "E31", "this operator calls " $text ", which can fail - write 'try' before the expression") }
fn IsOnlyNull(op String&) r.Msg { return r.Msg(Diag.IsOnlyNull, "E10c", $"'is' tests for null and nothing else - compare with '" $op "'") }
fn IsCaseWritten(op String&, x String&, y String&) r.Msg { return r.Msg(Diag.IsCaseWritten, "E10c, E32", $"a case is tested with '" $op "': '" $x " " $op " " $y "'") }
fn CaseTestNotEnum(text String&, ty String&) r.Msg { return r.Msg(Diag.CaseTestNotEnum, "E32", $text " is a case of an enum, and this is " $ty) }
fn CaseTestOther(text String&, ty String&) r.Msg { return r.Msg(Diag.CaseTestOther, "E32", $text " is no case of " $ty ", the type this tests") }
fn IsNullOfNull() r.Msg { return r.Msg(Diag.IsNullOfNull, "E10c", "'null is null' tests nothing - 'is null' follows a reference or a function value") }
fn IsNullOfValue(ty String&) r.Msg { return r.Msg(Diag.IsNullOfValue, "E10c", $"only a reference or a function value can be null, and this is " $ty) }
fn MayBeNull(text String&, ty1 String&, ty2 String&, bang String&) r.Msg { return r.Msg(Diag.MayBeNull, "T2c", "'" $text "' is a " $ty1 ", which may be null, and " $ty2 " never is", "", "test it first ('if x is not null'), or write '" $bang "!'") }
fn NullToNonNull(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.NullToNonNull, "T2c", $ty1 " is never null - a reference that may be is written " $ty2) }
fn NoteNullableDecl() r.Msg { return r.Msg(Diag.NoteNullableDecl, "", "the type is written here - write '?&' for '&' where it may be null") }
fn NeverNull(text String&, ty String&, val String&) r.Msg { return r.Msg(Diag.NeverNull, "T2c", "'" $text "' is a " $ty ", never null, so this is always " $val) }
fn NoZeroNonNull(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.NoZeroNonNull, "T2c", $ty1 " is never null, so it has no zero value - give it a value, or write " $ty2) }
fn ReadMaybeNull(text String&, ty String&, bang String&) r.Msg { return r.Msg(Diag.ReadMaybeNull, "T2c", "'" $text "' is a " $ty ", which may be null", "", "read through it where a test says it is not ('if x is not null'), or write '" $bang "!'") }
fn NullToArray(ty String&, empty String&) r.Msg { return r.Msg(Diag.NullToArray, "T2c", "an array written '&' is never null", "", "write '" $empty "' for an empty " $ty ", or '?&' where it may be null") }
fn ArrayIsNull(text String&, empty String&) r.Msg { return r.Msg(Diag.ArrayIsNull, "T2c", "an array written '&' is never null", "", "test whether it is empty: write '" $text $empty "', or '?&' where it may be null") }
fn NarrowedWrite(local String&, kase String&) r.Msg { return r.Msg(Diag.NarrowedWrite, "S8d", "a narrowed payload field is read, never written or lent writably", "'" $local "' is narrowed to " $kase ", and what it reads there is a copy of the payload", "assign the whole case, '" $local " = " $kase "(...)', or change a copy a match binds and assign the case back") }
fn CallDoesNothing(call String&) r.Msg { return r.Msg(Diag.CallDoesNothing, "S3", "'" $call "' gives a value and does nothing else", "", "use the value (assign it, pass it on), or leave the call out") }
fn FieldOfEnum(ty String&, f String&) r.Msg { return r.Msg(Diag.FieldOfEnum, "S8d", $ty " is an enum, and its payload's '" $f "' is read through a case", "", "read it where a test narrows a local or a parameter to the case, 'if e == Case { e." $f " }', until it is assigned") }
fn NullCompared(x String&, form String&) r.Msg { return r.Msg(Diag.NullCompared, "E10c", $"null is tested with 'is', never compared - write '" $x " " $form "'") }
fn AsNeedsCase(ty String&, text String&) r.Msg { return r.Msg(Diag.AsNeedsCase, "E32", "after 'as' comes a case of " $ty ", found " $text) }
fn PatternType(ty String&, text String&) r.Msg { return r.Msg(Diag.PatternType, "S13b", "a pattern here names a case of " $ty ", found " $text) }
fn CaseIsPrivate(tok String&) r.Msg { return r.Msg(Diag.CaseIsPrivate, "M6a", "case " $tok " is private to its module") }
fn AsNothing(text String&) r.Msg { return r.Msg(Diag.AsNothing, "E32", "case " $text " carries nothing for 'as' to give - test for it with '=='") }
fn IsAsNotEnum(ty String&) r.Msg { return r.Msg(Diag.IsAsNotEnum, "E32", "'as' asks for an enum value's payload, and this is " $ty) }
fn SliceNeedsLen(ty String&) r.Msg { return r.Msg(Diag.SliceNeedsLen, "E31", "a slice with no end runs to Len(), and " $ty " has none") }
fn AtUndeclared(ty String&) r.Msg { return r.Msg(Diag.AtUndeclared, "E31", $ty " declares SetAt but not At, which reading x[i] calls") }
fn SetatUndeclared(ty String&) r.Msg { return r.Msg(Diag.SetatUndeclared, "E31", $ty " declares At but not SetAt, which x[i] = v calls") }
fn WriteThroughAtNoSetat(ty String&) r.Msg { return r.Msg(Diag.WriteThroughAtNoSetat, "E31", "this writes through x[i] on " $ty ", which declares At but not SetAt", "the copy At gives back is never written back", "declare SetAt") }
fn WriteThroughAtBuilds() r.Msg { return r.Msg(Diag.WriteThroughAtBuilds, "E31, O17", "x[i] gives a copy, and the call can build into what it holds", "it builds where the copy is", "hold the elements by reference, or take it in place ('x.RefMut(i)')") }
fn CondLentWritable() r.Msg { return r.Msg(Diag.CondLentWritable, "E28", "this call would write a copy of what a conditional or a match chose", "a conditional or a match gives a copy of the value it chooses, which the call writes and drops", "call on the place itself, 'if c { f(a) } else { f(b) }', or hold the values by reference") }
fn WriteThroughAtCall() r.Msg { return r.Msg(Diag.WriteThroughAtCall, "E31b", "this call writes a copy of x[i]", "x[i] gives a copy, and the call can reach the collection another way", "call it in place, 'x.RefMut(i)' (a Vec), or copy out and back: 't := x[i]', the call on 't', 'x[i] = t'; or hold the elements by reference") }
fn WriteThroughAtOperator(ty String&, method String&) r.Msg { return r.Msg(Diag.WriteThroughAtOperator, "E31b", "this store writes a copy of x[i]", "x[i] gives a copy of the element, and the store would run " $ty "'s " $method " between reading it and writing it back", "write 't := x[i]', the store into 't', then 'x[i] = t'") }
fn CharNoPad(tok String&, name String&) r.Msg { return r.Msg(Diag.CharNoPad, "M19, T29f", "Char has no method " $tok " - a character is padded as text: '($c)." $name "(n)'") }
fn StepNotNumber(ty String&) r.Msg { return r.Msg(Diag.StepNotNumber, "S3a, E31", "'++' and '--' step a number, or a type declaring Inc (Dec) or Plus (Minus) - found " $ty) }
fn DefaultArgNotAllowed() r.Msg { return r.Msg(Diag.DefaultArgNotAllowed, "E14a", "'default' stands only for a parameter's declared default, in a call") }
fn DeferErrorEscapes() r.Msg { return r.Msg(Diag.DeferErrorEscapes, "S19b", "an error may not leave deferred code - catch it here") }
fn CaseTypeArgsNotInferable(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.CaseTypeArgsNotInferable, "G10c", "the type arguments of " $text1 " cannot be inferred from this case", "", "write them, '" $text1 "<...>." $text2[text1.Len() + 1:] "', or give it a type to land in") }
fn EmbedPathUnknown() r.Msg { return r.Msg(Diag.EmbedPathUnknown, "E38", "an embed's path is text known while compiling - a literal, or what reads no local") }
fn EmbedPathUndecided() r.Msg { return r.Msg(Diag.EmbedPathUndecided, "E38", "this embed's path cannot be computed while compiling - write it so it can, or as a literal") }
fn EmbedNotRead(path String&, why String&) r.Msg { return r.Msg(Diag.EmbedNotRead, "E38", $"embed " $path " reads no file: " $why) }
fn TryNowhereToGo() r.Msg { return r.Msg(Diag.TryNowhereToGo, "R13", "an error tried here has nowhere to go - catch every one it can be") }
fn GenErrorNotDeclared(ty String&) r.Msg { return r.Msg(Diag.GenErrorNotDeclared, "R9, D18", $ty " can escape here, but the generator's result does not say so", "the generator's result must say it fails with " $ty, "write 'Iterator<T ? " $ty ">', or catch it") }
fn TryErrorNotDeclared(ty String&) r.Msg { return r.Msg(Diag.TryErrorNotDeclared, "R9", $ty " can escape here, and this function does not declare it - add it after '?', or catch it") }
fn UnknownMethod(ty String&, tok String&, hint String&) r.Msg { return r.Msg(Diag.UnknownMethod, "M19", $ty " has no method " $tok $hint) }
fn MethodNotInherited(ty String&, tok String&) r.Msg { return r.Msg(Diag.MethodNotInherited, "T29f", $ty " declares no " $tok ", and does not extend its base, which has one", "", "declare it with 'extends'") }

# a name read through a number type that is none of its limits (E36), or a limit of a type that is no number
fn NoLimit(ty String&, name String&, tail String&) r.Msg { return r.Msg(Diag.NoLimit, "E36", $ty " has no limit '" $name "'", $tail[3:]) }

# become where no jump can stand (S21): a test, a constructor, a lambda, main ...
fn BecomeOutside(where String&) r.Msg { return r.Msg(Diag.BecomeOutside, "S21", "'become' cannot be written in " $where, "'become' ends a function declared with fn", "write 'return' and the call") }

# become inside what may not be left so (S21)
fn BecomeInside(what String&) r.Msg { return r.Msg(Diag.BecomeInside, "S21", "'become' cannot be written here", "'become' leaves the function at once, so not from " $what, "write 'return' and the call") }

# become try f(x) (S21)
fn BecomeTry() r.Msg { return r.Msg(Diag.BecomeTry, "S21", "'become' takes the call alone", "what it fails with is the function's own", "write it without 'try'") }

# become given what is no call of a function (S21)
fn BecomeNotCall(what String&) r.Msg { return r.Msg(Diag.BecomeNotCall, "S21", "'become' takes a call, and this is " $what, "a call of a function or a method declared with fn", "write 'return' instead") }

# become calling a function of another signature (S21)
fn BecomeSignature(have String&, callee String&) r.Msg { return r.Msg(Diag.BecomeSignature, "S21", "'become' calls a function of this one's own signature, and this is " $have, "the callee is " $callee, "write 'return' and the call, or give them one signature") }

# become with a parameter or result through memory (S21)
fn BecomeMemory() r.Msg { return r.Msg(Diag.BecomeMemory, "S21", "'become' cannot jump here: a parameter or the result is over 128 bytes", "such a value is passed through memory the function's frame holds", "pass a reference, or write 'return'") }

# become whose callee fails otherwise (S21)
fn BecomeErrors(have String&, callee String&) r.Msg { return r.Msg(Diag.BecomeErrors, "S21", "'become' makes the callee's failure this function's own, and the sets differ", "this one fails with " $have ", the callee with " $callee, "give them one error set, in one order, or write 'return try' and the call") }

# become in a function holding what has a destructor (S21, O16)
fn BecomeDestructor(what String&) r.Msg { return r.Msg(Diag.BecomeDestructor, "S21", "'become' would run a destructor before the call", "'become' closes this function's scopes before the call, and " $what " whose destructor would run then", "write 'return' and the call") }

# become leaving a by-value parameter holding a value with a destructor it does not hand on (S21, O15)
fn BecomeHeldParam(name String&) r.Msg { return r.Msg(Diag.BecomeHeldParam, "S21", "'become' would leave parameter '" $name "' with a destructor to run", "'become' ends this function before the call, and the call does not take the value, so its destructor would run then", "hand it on, or write 'return' and the call") }

# become handing the callee storage of a scope it closes (S21, section 8)
fn BecomeBorrows() r.Msg { return r.Msg(Diag.BecomeBorrows, "S21", "this 'become' argument is storage made in a scope it closes", "'become' closes this function's scopes before the call", "pass what the function was given, a global, or a value; or write 'return'") }

# a top-level assert decided false while compiling (S17a), with its message where that computes too
fn TopAssertFalse() r.Msg { return r.Msg(Diag.TopAssertFalse, "S17a", "this top-level assert is false, decided while compiling") }
fn TopAssertFalseMessage(text String&) r.Msg { return r.Msg(Diag.TopAssertFalseMessage, "S17a", "this top-level assert is false, decided while compiling: " $text) }

# a top-level assert the evaluator cannot decide (S17a): it holds of the program while compiling, or is no assert there
fn TopAssertUndecidable(why String&) r.Msg { return r.Msg(Diag.TopAssertUndecidable, "S17a", "this top-level assert cannot be decided while compiling", "a top-level assert is decided while compiling: " $why, "assert it in a function or a test, where it is checked at run time") }

# a name read through Place that is not Here (E40)
fn PlaceMember(name String&) r.Msg { return r.Msg(Diag.PlaceMember, "E40", "Place gives no '" $name "' through its name - 'Place.Here' is the place where it is written") }

# a bit operation on what is no integer (E37)
fn BitOpNotInteger(name String&, ty String&) r.Msg { return r.Msg(Diag.BitOpNotInteger, "E37", "'" $name "' is a method of the integer types, and " $ty " is none") }

# a rotation's count of no integer type (E37)
fn BitOpCount(ty String&) r.Msg { return r.Msg(Diag.BitOpCount, "E37", "a rotation's count is an integer, found " $ty) }

# an enum's raw type that is neither text nor an integer type (T17e)
fn RawType(ty String&) r.Msg { return r.Msg(Diag.RawType, "T17e", "an enum's raw type is String or an integer type, found " $ty) }

# a raw value that is no literal of the raw type (T17e)
fn RawNotLiteral(ty String&) r.Msg { return r.Msg(Diag.RawNotLiteral, "T17e", "a raw value is a literal of the raw type " $ty) }

# a raw value the raw type cannot hold (T17e)
fn RawNoFit(v String&, ty String&) r.Msg { return r.Msg(Diag.RawNoFit, "T17e", "the raw value " $v " does not fit " $ty) }

# two cases of one enum with one raw value (T17e)
fn RawRepeated(name String&, v String&, other String&) r.Msg { return r.Msg(Diag.RawRepeated, "T17e", "'" $name "' has the raw value " $v ", which '" $other "' has already - raw values are distinct") }

# a raw value in an enum that names no raw type (T17e)
fn RawWithoutType() r.Msg { return r.Msg(Diag.RawWithoutType, "T17e", "a raw value needs the enum's raw type, written after 'enum': 'enum String {' or 'enum U8 {'") }

# a raw type on an anonymous enum (T17e)
fn RawAnonymous() r.Msg { return r.Msg(Diag.RawAnonymous, "T17e", "only a declared enum has raw values - declare the enum with 'type'") }

# Value or From on an enum without raw values (T17e)
fn NoRawValues(ty String&, name String&) r.Msg { return r.Msg(Diag.NoRawValues, "T17e", $ty " declares no raw values, so it has no '" $name "' - name a raw type after 'enum'") }

# From on an enum a case of which carries a payload (T17e)
fn FromPayload(ty String&, name String&) r.Msg { return r.Msg(Diag.FromPayload, "T17e", "'From' makes a case from its raw value alone, and " $ty "'s case '" $name "' carries a payload") }

# a case named From in an enum with raw values (T17e)
fn FromCaseName() r.Msg { return r.Msg(Diag.FromCaseName, "T17e", "a case of an enum with raw values may not be named 'From'", "'From' makes a case from its raw value") }
fn AtomicNotInteger(ty String&) r.Msg { return r.Msg(Diag.AtomicNotInteger, "P9", "the atomic operations are methods of the integer types, and " $ty " is none") }
fn DefaultCount(n1 I64, n2 I64) r.Msg { return r.Msg(Diag.DefaultCount, "R11", "expected " $n1 " defaults, one per result, found " $n2) }
fn DefaultScope() r.Msg { return r.Msg(Diag.DefaultScope, "R11, O25", "a reference default lives where the call's result does - or is null, or built there") }
fn CatchAfterCatchAll() r.Msg { return r.Msg(Diag.CatchAfterCatchAll, "R11a", "a catch with no error types takes every error left, so no clause can follow it") }
fn CatchUnreachable() r.Msg { return r.Msg(Diag.CatchUnreachable, "R11a", "an earlier clause already takes every error this one names") }
