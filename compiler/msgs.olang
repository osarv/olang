# ---- contracts (D17) ----

fn ContractNeedsArgumentError(name String&) r.Msg { return r.Msg(Diag.ContractNeedsArgumentError, "D17", $name " has conditions, so a call fails with ArgumentError where one is false", "", "add it after '?'") }
