# one function each, under the id it is known by

# lane operators (E39)
fn LaneLengths(a I64, b I64) r.Msg { return r.Msg(Diag.LaneLengths, "E39", "these arrays are of lengths " $a " and " $b " - a lane operation takes arrays of one length") }
fn LaneReferences() r.Msg { return r.Msg(Diag.LaneReferences, "E39", "lane operators give elements that may not be or hold references - build the array with a loop") }
fn LaneCompare(op String&, how String&) r.Msg { return r.Msg(Diag.LaneCompare, "E39", $op " does not compare arrays - lane by lane it is '" $how "', an Array<Bool>") }
fn LaneMaskBool(what String&, ty String&) r.Msg { return r.Msg(Diag.LaneMaskBool, "E39", $what " takes lanes of Bool, found " $ty) }

# integers of any width (T4a)
fn ByteSwapWidth(ty String&, bits I64) r.Msg { return r.Msg(Diag.ByteSwapWidth, "E37, T4a", $ty " has no 'ByteSwap': its " $bits " bits are no whole number of bytes") }
fn AtomicWidth(ty String&) r.Msg { return r.Msg(Diag.AtomicWidth, "P9, T4a", $ty " is no atomic width", "the atomic operations take integers of 8, 16, 32 or 64 bits", "hold the value as one of those") }

# compile-time reflection (G32-G38)
fn ReflNoMember(ty String&, name String&) r.Msg { return r.Msg(Diag.ReflNoMember, "G32", $ty " has no reflected member '" $name "'", "a type's are Name, Kind, Base, Fields, Cases, Params, Results, Element, Length, Target, Nullable, Size and Align") }
fn ReflNoKind(ty String&) r.Msg { return r.Msg(Diag.ReflNoKind, "G32", $ty " has no TypeKind", "only a struct, an enum, a number, Bool, an array, a reference, a function type and an error value have one") }
fn ReflNoLength(ty String&) r.Msg { return r.Msg(Diag.ReflNoLength, "G32", $ty " has no Length - only an array whose length is known while compiling has one") }
fn ReflNoLayout(ty String&, name String&) r.Msg { return r.Msg(Diag.ReflNoLayout, "G32", $ty " has no " $name " - it is not laid out (a trait, an error type, an extern type)") }
fn ReflNotList(name String&, ty String&, why String&) r.Msg { return r.Msg(Diag.ReflNotList, "G33", $ty " has no " $name " - " $why) }
fn ReflListValue(list String&) r.Msg { return r.Msg(Diag.ReflListValue, "G33", $list " is a list known while compiling, no value", "", "walk it with 'for', count it with '.Len()', index it with a constant, or make an array of it with a comprehension") }
fn ReflIndexNotConst() r.Msg { return r.Msg(Diag.ReflIndexNotConst, "G33", "a list known while compiling is indexed by a constant - this index is known only at run time") }
fn ReflIndexRange(k I64, n I64) r.Msg { return r.Msg(Diag.ReflIndexRange, "G33", $"index " $k " is outside the list, which holds " $n) }
fn ReflFilterUndecided() r.Msg { return r.Msg(Diag.ReflFilterUndecided, "G33", "this comprehension's filter is known only at run time", "a comprehension over a list known while compiling keeps an element by a filter decided while compiling") }
fn ReflTryList() r.Msg { return r.Msg(Diag.ReflTryList, "G33", "'try' on a walk of a list known while compiling", "a list known while compiling is walked with no call that can fail", "write 'for x in ...' without 'try'") }
fn ReflNoDefault(name String&, ty String&) r.Msg { return r.Msg(Diag.ReflNoDefault, "G34", $"parameter '" $name "' of " $ty " has no default - read 'p.Default' only where 'p.HasDefault' holds") }
fn ReflOfArgs(n I64) r.Msg { return r.Msg(Diag.ReflOfArgs, "G34", $"'Of' takes one value, found " $n) }
fn ReflOfType(want String&, have String&) r.Msg { return r.Msg(Diag.ReflOfType, "G34", $"this field is " $want "'s, and the value is " $have) }
fn ReflDescNoMember(what String&, name String&, have String&) r.Msg { return r.Msg(Diag.ReflDescNoMember, "G34", $"a " $what " has no '" $name "' - its members are " $have) }
fn ReflTypeNotValue(name String&) r.Msg { return r.Msg(Diag.ReflTypeNotValue, "G38", "'" $name "' is a type, not a value", "", "write it where a type goes: a declaration ('x " $name " = ...'), a type argument or a match's subject") }

# G38 (above and TypeNotAValue): a type written where a value goes - a reflected one, or a type's own name - one wording for both
fn ReflCaseOther(c String&, ty String&) r.Msg { return r.Msg(Diag.ReflCaseOther, "G34", $"this case is " $c "'s, and the value is " $ty) }
fn ReflCaseUnreachable() r.Msg { return r.Msg(Diag.ReflCaseUnreachable, "G36", "no type can reach this case - a case before it takes every type it does") }
fn ReflArgCompr() r.Msg { return r.Msg(Diag.ReflArgCompr, "G37", "a comprehension as a call's arguments must walk a list known while compiling", "'T.Params', 'T.Fields' ... are such lists", "write another comprehension in brackets, 'Array<T>[e for x in c]'") }
fn ReflNoType(name String&, ty String&, why String&) r.Msg { return r.Msg(Diag.ReflNoType, "G38", $"'" $name "' of " $ty ": " $why) }

# attributes (G39, G40) and the functions reflection reads (G41)
fn AttrPlace() r.Msg { return r.Msg(Diag.AttrPlace, "G39", "nothing here takes an attribute", "an attribute is written before a type, a function or a method, an enum's case, a constructor's field or a parameter") }
fn AttrPun(name String&) r.Msg { return r.Msg(Diag.AttrPun, "G39", $"field '" $name "' is a pun of its parameter", "it has the parameter's attributes", "write the attribute on the parameter") }
fn AttrType(ty String&) r.Msg { return r.Msg(Diag.AttrType, "G39", $"an attribute is a value of a declared type, and this is " $ty, "a struct, an enum's case or a declared number type") }
fn AttrTwice(ty String&) r.Msg { return r.Msg(Diag.AttrTwice, "G39", $"a declaration takes one attribute of each type, and this is its second " $ty) }
fn AttrWritable(ty String&) r.Msg { return r.Msg(Diag.AttrWritable, "G39", $"an attribute's value holds a 'mut' reference, and " $ty " is read-only data", "an attribute's value is baked while compiling, and no reader could write through the reference", "give its type read-only references ('T&')") }
fn ComptimeLocal(tok String&) r.Msg { return r.Msg(Diag.ComptimeLocal, "K3", $tok " is a local or a parameter, and a comptime is computed while compiling", "only the running program knows a local or a parameter", "compute it from constants, globals and type parameters, or drop 'comptime'") }
fn ComptimeNotBaked(why String&) r.Msg { return r.Msg(Diag.ComptimeNotBaked, "K3", "this comptime cannot be computed while compiling", $why) }
fn ComptimeForTry() r.Msg { return r.Msg(Diag.ComptimeForTry, "K3a", "a comptime for's walk cannot fail at run time", "its elements are computed while compiling, so nothing of its walk fails at run time", "write 'comptime for x in e'") }
fn ComptimeForSource(ty String&) r.Msg { return r.Msg(Diag.ComptimeForSource, "K3a", $"a comptime for walks a range or an array, found " $ty, "", "give it an array: 'comptime for x in xs.View()'") }
fn ComptimeForElem(ty String&) r.Msg { return r.Msg(Diag.ComptimeForElem, "K3a", $"a comptime for's elements are integers, Bool or Char, found " $ty, "", "walk its positions: 'comptime for i in range xs.Len()'") }
fn ComptimeForUnknown(why String&) r.Msg { return r.Msg(Diag.ComptimeForUnknown, "K3a", "a comptime for's elements cannot be computed while compiling", $why) }
fn ComptimeForTooMany(n I64, most I64) r.Msg { return r.Msg(Diag.ComptimeForTooMany, "K3a", $"this comptime for unrolls into " $n " copies, at most " $most, "", "walk it at run time: drop 'comptime'") }
fn AttrNotBuilt(why String&) r.Msg { return r.Msg(Diag.AttrNotBuilt, "G39", "this attribute's value cannot be built while compiling", $why) }
fn AttrRead(name String&) r.Msg { return r.Msg(Diag.AttrRead, "G40", $"'" $name "' takes the attribute's type and no arguments - '" $name "<json.Key>()'") }
fn ReflFnList(what String&) r.Msg { return r.Msg(Diag.ReflFnList, "G41", $what, "", "'Functions' is read through an import's alias ('handlers.Functions'), 'Methods' through a type") }
fn ReflFnCall(name String&, want I64, have I64) r.Msg { return r.Msg(Diag.ReflFnCall, "G41", $"'" $name "' is called with " $want " arguments (a method's receiver first), found " $have) }
fn ReflMatchSubject() r.Msg { return r.Msg(Diag.ReflMatchSubject, "G13", "'match' on a type takes a type known while compiling", "", "match a type variable, or a type a reflected member names") }
fn Usage() r.Msg { return r.Msg(Diag.Usage, "B1", "nothing to do", "", "write a file to build and run, as 'olang main.olang', or a mode ('olang help' lists them)") }
fn NotAMode(text String&) r.Msg { return r.Msg(Diag.NotAMode, "B1", "'" $text "' is not a mode", "the modes are build, compile, test, interpret, format, explain, help, doc, lsp, mcp, fix, bindgen, profile and api, and a file ending in .olang is built and run") }
fn ModeOneFile(text String&) r.Msg { return r.Msg(Diag.ModeOneFile, "B1", $text " takes exactly one file") }
fn ModeNeedsFile(text String&) r.Msg { return r.Msg(Diag.ModeNeedsFile, "B1", $text " needs a file") }
fn UnknownFlag(text1 String&, text2 String&, hint String&) r.Msg { return r.Msg(Diag.UnknownFlag, "B1", "unknown option '" $text1 "'" $hint " - 'olang help' lists the options of " $text2) }
fn OptionNotForMode(text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.OptionNotForMode, "B1", $text1 " applies to " $text2 ", not to " $text3) }
fn OptionNeedsValue(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.OptionNeedsValue, "B1", $text1 " needs a value after it: " $text2) }
fn QuickAlone(text String&) r.Msg { return r.Msg(Diag.QuickAlone, "B2g", "-quick and " $text " each say how much to optimize - give one") }
fn InterpretBuilds(text String&) r.Msg { return r.Msg(Diag.InterpretBuilds, "B3e", "-interpret builds nothing, and " $text " says how to build - give one") }
fn FuzzTimeNotNumber(text String&) r.Msg { return r.Msg(Diag.FuzzTimeNotNumber, "B19", "-fuzztime takes a whole number of seconds, at least 1, and '" $text "' is none") }
fn FuzzTimeAlone() r.Msg { return r.Msg(Diag.FuzzTimeAlone, "B19", "-fuzztime says how long -fuzz runs - give -fuzz NAME with it") }
fn BenchFuzz() r.Msg { return r.Msg(Diag.BenchFuzz, "B19b", "-bench and -fuzz are given together", "-bench measures the tests a build runs, and -fuzz runs one test on a fuzzer's inputs", "give one") }
fn FuzzNoTest(word String&) r.Msg { return r.Msg(Diag.FuzzNoTest, "B19", "-fuzz " $word " names no test of this file", "", "give a test's target, its target's type or a word of its description") }
fn FuzzManyTests(word String&, names String&) r.Msg { return r.Msg(Diag.FuzzManyTests, "B19", "-fuzz " $word " names several tests (" $names ") - give a word that names one") }
fn NotASource(text String&) r.Msg { return r.Msg(Diag.NotASource, "B1", "'" $text "' is no olang file to run - a file's name ends in .olang") }
fn ModeFirst(text String&) r.Msg { return r.Msg(Diag.ModeFirst, "B1", "the mode comes first: 'olang " $text "' and then its options") }
fn HelpOneMode() r.Msg { return r.Msg(Diag.HelpOneMode, "B1", "help takes at most one mode") }
fn OutputIsDir(text String&) r.Msg { return r.Msg(Diag.OutputIsDir, "B3h", "-output " $text " is a directory - name the file to write") }
fn OutputNoDir(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.OutputNoDir, "B3h", "-output " $text1 ": there is no directory " $text2) }
fn OutputCannotWrite() r.Msg { return r.Msg(Diag.OutputCannotWrite, "B3h", "cannot write it") }
fn CannotRun(text String&) r.Msg { return r.Msg(Diag.CannotRun, "B3g", "the program cannot be run: " $text) }
fn FormatterMissing(text String&) r.Msg { return r.Msg(Diag.FormatterMissing, "B13", "the formatter's source is not beside this compiler: " $text) }
fn FormatterBuild(text String&) r.Msg { return r.Msg(Diag.FormatterBuild, "B13", "the formatter could not be built - " $text " says why") }
fn TargetMissing() r.Msg { return r.Msg(Diag.TargetMissing, "B12", "-target needs a target after it, as '-target x86-64-v3'") }
fn TargetUnknown(text String&) r.Msg { return r.Msg(Diag.TargetUnknown, "B12", "unknown target '" $text "'", "", "write native, x86-64, x86-64-v2, x86-64-v3, x86-64-v4, a CPU clang knows ('clang --print-supported-cpus'), or a triple x86_64-linux-gnu or aarch64-linux-gnu, ':CPU' after it if wanted") }
fn TargetUnsupported(text String&) r.Msg { return r.Msg(Diag.TargetUnsupported, "B12", "olang does not build for '" $text "'", "it builds for x86_64 and aarch64 Linux with the GNU C library") }
fn TargetNativeForeign(text String&) r.Msg { return r.Msg(Diag.TargetNativeForeign, "B12", "'-target " $text "' names native with another architecture's CPU", "native is this machine's CPU", "name the other architecture's CPU after ':', or none for its default") }
fn TargetForeignMode(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.TargetForeignMode, "B12a", $text1 " runs on this machine, not on '-target " $text2 "'", "'-target " $text2 "' is another architecture or system", "build, compile and test build for it") }
fn TargetNoBackend(text String&) r.Msg { return r.Msg(Diag.TargetNoBackend, "B12a", "this clang cannot build for '" $text "'", "its back end for that architecture cannot generate the BF16 code the runtime holds", "use clang 19 or newer (OLANG_CLANG names the one to use)") }
fn TargetNoClang(text String&) r.Msg { return r.Msg(Diag.TargetNoClang, "B12", "clang not found on PATH - it is what builds the program, and what says what target '" $text "' is") }
fn TargetNoEmulator(text String&) r.Msg { return r.Msg(Diag.TargetNoEmulator, "B12a", "nothing here runs " $text " programs", "", "install qemu-user (qemu-" $text "), or name an emulator with OLANG_EMULATOR") }
fn ExplainNeedsRule() r.Msg { return r.Msg(Diag.ExplainNeedsRule, "B11a", "explain takes one rule, as 'olang explain B1'") }
fn ExplainNeedsName(file String&) r.Msg { return r.Msg(Diag.ExplainNeedsName, "B11b", $"explain " $file " takes the name of one of its items, as 'olang explain " $file " main'") }
fn LineBodyOnLine() r.Msg { return r.Msg(Diag.LineBodyOnLine, "S1b", "a one-line body stands on the line of its ':' - write a block, '{ ... }'") }
fn LineBodyNotSimple(what String&) r.Msg { return r.Msg(Diag.LineBodyNotSimple, "S1b", $"a one-line body is one simple statement, not " $what " - write a block, '{ ... }'") }
fn ModeNoFiles(mode String&) r.Msg { return r.Msg(Diag.ModeNoFiles, "B1", $mode " takes no files - its client names them as it goes") }
fn DocOneName(file String&) r.Msg { return r.Msg(Diag.DocOneName, "B14", $"doc " $file " takes at most the name of one of its items, as 'olang doc " $file " main'") }
fn DocNoItem(name String&, file String&) r.Msg { return r.Msg(Diag.DocNoItem, "B14", $"'" $name "' is no item of " $file " - 'olang doc " $file "' lists them") }
fn ExplainNoItem(name String&, file String&) r.Msg { return r.Msg(Diag.ExplainNoItem, "B11b", $"'" $name "' is no top-level item of " $file) }
fn NoSpec(text String&) r.Msg { return r.Msg(Diag.NoSpec, "B11a", "no specification at " $text) }
fn NoRule(text String&) r.Msg { return r.Msg(Diag.NoRule, "B11a", "the specification has no rule " $text) }
fn DefineMissing() r.Msg { return r.Msg(Diag.DefineMissing, "B10", "-define needs Name=value after it") }
fn DefineShape(text String&) r.Msg { return r.Msg(Diag.DefineShape, "B10", "-define takes Name=value, found '" $text "'") }
fn DefineNotName(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.DefineNotName, "B10", "-define " $text1 "=" $text2 ": the name is not an identifier") }
fn DefineTwice(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.DefineTwice, "B10", "-define " $text1 "=" $text2 ": defined twice") }
fn DefineBadNumber(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.DefineBadNumber, "B10", "-define " $text1 "=" $text2 ": not a number - '0x' and '0b' take digits of their own base") }
fn DefineIntRange(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.DefineIntRange, "B10", "-define " $text1 "=" $text2 ": beyond 64 bits") }
fn DefineNegRange(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.DefineNegRange, "B10", "-define " $text1 "=" $text2 ": below I64's minimum") }
fn DefineFloatRange(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.DefineFloatRange, "B10", "-define " $text1 "=" $text2 ": beyond F64's range") }
fn DefineBuiltin(text String&) r.Msg { return r.Msg(Diag.DefineBuiltin, "B10a", "-define cannot redefine the built-in constant " $text) }
fn CannotOpen() r.Msg { return r.Msg(Diag.CannotOpen, "", "cannot open this file") }
fn NotRegular() r.Msg { return r.Msg(Diag.NotRegular, "", "not a regular file") }
fn IsDirectory() r.Msg { return r.Msg(Diag.IsDirectory, "M1", "a directory - a module is one .olang file") }
fn NoMain() r.Msg { return r.Msg(Diag.NoMain, "B4", "no main function - a program starts at 'fn main() { }'") }
fn NoClang(text String&) r.Msg { return r.Msg(Diag.NoClang, "", "clang not found on PATH - install clang-20 (the IR is in " $text ")") }
fn ClangFailed(text String&) r.Msg { return r.Msg(Diag.ClangFailed, "", "clang could not compile " $text) }
fn LinkFailed(text String&) r.Msg { return r.Msg(Diag.LinkFailed, "", "linking " $text " failed") }
fn UnknownChar(ch Char) r.Msg { return r.Msg(Diag.UnknownChar, "L16", "unexpected character '" $Esc(ch) "'") }
fn CommaEndsLine() r.Msg { return r.Msg(Diag.CommaEndsLine, "L18a", "a comma never ends a line", "items on different lines are separated by the line break", "remove it") }
fn Semicolon() r.Msg { return r.Msg(Diag.Semicolon, "L18", "olang has no ';' - a statement ends where its line does; put the next one on a line of its own") }
fn NonAscii(ch Char) r.Msg { return r.Msg(Diag.NonAscii, "L1", "non-ASCII byte '" $Esc(ch) "' - olang source is ASCII") }
fn CarriageReturn() r.Msg { return r.Msg(Diag.CarriageReturn, "L3", "carriage return - save the file with LF line endings") }
fn NulByte() r.Msg { return r.Msg(Diag.NulByte, "L1", "NUL byte in the source - is this a text file?") }
fn UnclosedComment() r.Msg { return r.Msg(Diag.UnclosedComment, "L4a", "unterminated block comment - '##' closes it") }
fn UnclosedString() r.Msg { return r.Msg(Diag.UnclosedString, "L14", "unterminated string literal") }
fn StringNewline() r.Msg { return r.Msg(Diag.StringNewline, "L14", "string literal not closed on its line - write \\n for a newline") }
fn UnclosedChar() r.Msg { return r.Msg(Diag.UnclosedChar, "L13", "unterminated character literal") }
fn CharNewline() r.Msg { return r.Msg(Diag.CharNewline, "L13", "character literal not closed on its line") }
fn EmptyChar() r.Msg { return r.Msg(Diag.EmptyChar, "L13", "empty character literal") }
fn LongChar() r.Msg { return r.Msg(Diag.LongChar, "L13", "character literal holds more than one character - text is written in \"\"") }
fn BadEscape(ch Char) r.Msg { return r.Msg(Diag.BadEscape, "L15", "unknown escape '\\" $Esc(ch) "' - the escapes are \\n \\t \\r \\0 \\\\ \\' \\\"") }
fn HexNoDigits() r.Msg { return r.Msg(Diag.HexNoDigits, "L10a", "'0x' needs hexadecimal digits") }
fn BinNoDigits() r.Msg { return r.Msg(Diag.BinNoDigits, "L10c", "'0b' needs binary digits") }
fn HexDigit(ch Char) r.Msg { return r.Msg(Diag.HexDigit, "L10a", "'" $Esc(ch) "' is not a hexadecimal digit") }
fn BinDigit(ch Char) r.Msg { return r.Msg(Diag.BinDigit, "L10c", "'" $Esc(ch) "' is not a binary digit") }
fn DigitSeparator() r.Msg { return r.Msg(Diag.DigitSeparator, "L10b", "'_' in a number must stand between two digits") }
fn PointNoDigit() r.Msg { return r.Msg(Diag.PointNoDigit, "L12", "a decimal point needs a digit after it") }
fn TwoPoints() r.Msg { return r.Msg(Diag.TwoPoints, "L12", "a number has at most one decimal point") }
fn Expected(text String&, tok String&) r.Msg { return r.Msg(Diag.Expected, "", "expected " $text ", found " $tok) }
fn BlockNotClosed(n I64, tok String&) r.Msg { return r.Msg(Diag.BlockNotClosed, "", "the block opened on line " $n " has no '}' - found " $tok) }
fn Nesting(n I64) r.Msg { return r.Msg(Diag.Nesting, "L21", "nested more than " $n " levels deep - split it into locals or functions") }
fn KeywordAsName(tok String&) r.Msg { return r.Msg(Diag.KeywordAsName, "L9", $tok " is a keyword, not a name - choose another") }
fn KeywordFieldRead(tok String&) r.Msg { return r.Msg(Diag.KeywordFieldRead, "L9a", $tok " is a keyword, not a name", "a field named by one is reached only after '.', never by the name alone") }
fn DestructInBody() r.Msg { return r.Msg(Diag.DestructInBody, "C7", "'destruct' follows the constructor's body", "", "close the body first: 'type T unique struct(...) { ... } destruct { ... }'") }
fn JoinPiece(text String&) r.Msg { return r.Msg(Diag.JoinPiece, "E11b", "a join piece is a text literal or a '$' rendering - write '$" $text "'") }
fn NeedlessGroup() r.Msg { return r.Msg(Diag.NeedlessGroup, "L18c", "these parentheses group nothing", "parentheses group only a function type holding a comma of its own, as an item of a list", "write this without them") }
fn TrailingComma(tok String&) r.Msg { return r.Msg(Diag.TrailingComma, "L18a", "a comma before " $tok " separates nothing - remove it") }
fn VarListCount(n1 I64, n2 I64) r.Msg { return r.Msg(Diag.VarListCount, "D12b", $n1 " names need as many values, found " $n2) }
fn ErrorAfterQuestion() r.Msg { return r.Msg(Diag.ErrorAfterQuestion, "R1a", "'?' alone is what the body can fail with - write '?', or name the types: '? io.Error'") }
fn ValueAfterEq(text1 String&, text2 String&, text3 String&, text4 String&) r.Msg { return r.Msg(Diag.ValueAfterEq, "D12", "a declaration's value follows '='", "", "write '" $text1 " = " $text2 "', or '" $text3 " := " $text4 "'") }
fn CondName(tok String&) r.Msg { return r.Msg(Diag.CondName, "B9a", $tok " is not a build constant or an immutable global of this module") }
fn CondMutable(tok String&) r.Msg { return r.Msg(Diag.CondMutable, "B9a", $tok " is mutable, so a top-level condition cannot read it") }
fn CondGlobalInit(tok String&) r.Msg { return r.Msg(Diag.CondGlobalInit, "B9a", $tok " is not computed from literals and build constants alone") }
fn CondCycle(tok String&) r.Msg { return r.Msg(Diag.CondCycle, "B9a", $tok " is defined in terms of itself") }
fn CondTypes(tok String&) r.Msg { return r.Msg(Diag.CondTypes, "B9", $tok " cannot combine these values") }
fn CondNoMeet(tok String&) r.Msg { return r.Msg(Diag.CondNoMeet, "T6b", $tok ": these numbers' types do not meet - convert one, as I64(n)") }
fn CondNotBool(tok String&) r.Msg { return r.Msg(Diag.CondNotBool, "B9", "the condition beginning " $tok " is not a Bool") }
fn ImportRemoteBadName() r.Msg { return r.Msg(Diag.ImportRemoteBadName, "M23a", "a remote import's name holds a character it may not", "its host, owner, repository and ref may hold only letters, digits, '.', '_' and '-'") }
fn ImportLockNotACommit(text String&) r.Msg { return r.Msg(Diag.ImportLockNotACommit, "M23b", "olang.lock names no commit for " $text " - delete its line, or build with -update") }
fn ImportFetchFailed(text String&) r.Msg { return r.Msg(Diag.ImportFetchFailed, "M23a", "could not fetch " $text " with git - check the path and the connection") }
fn ImportLockedFetchFailed(text String&) r.Msg { return r.Msg(Diag.ImportLockedFetchFailed, "M23b, M23c", "could not fetch the commit olang.lock names for " $text, "", "delete its line, or build with -update") }
fn ImportPathTooLong() r.Msg { return r.Msg(Diag.ImportPathTooLong, "M23", "this import path is too long to name a file") }
fn ImportFileNotFound(text String&) r.Msg { return r.Msg(Diag.ImportFileNotFound, "M23", "no .olang file at " $text) }
fn ImportHasExtension() r.Msg { return r.Msg(Diag.ImportHasExtension, "M23", "an import names its file without '.olang'") }
fn ImportLeavesRoot(text String&) r.Msg { return r.Msg(Diag.ImportLeavesRoot, "M23", "this relative import leaves " $text " - name a module outside it by its own path") }
fn ImportRemoteNeedsFile() r.Msg { return r.Msg(Diag.ImportRemoteNeedsFile, "M23", "a remote import names a file in the repository: host/owner/repo[@ref]/path") }
fn ImportAliasInvalid(text String&) r.Msg { return r.Msg(Diag.ImportAliasInvalid, "M4", "'" $text "' is no identifier, so it cannot be this import's alias", "", "write one: import Name \"...\"") }
fn ImportAliasConflict(text String&) r.Msg { return r.Msg(Diag.ImportAliasConflict, "M5", "another import of this module is already named '" $text "' - give one an alias of its own") }
fn UnknownImport(tok String&, hint String&) r.Msg { return r.Msg(Diag.UnknownImport, "M10", $tok " is no import here" $hint) }
fn UnknownImportStd(tok String&, text String&) r.Msg { return r.Msg(Diag.UnknownImportStd, "M10", $tok " is no import here - std has it: 'import \"std/" $text "\"'") }
fn ImportIsPrivate(tok String&) r.Msg { return r.Msg(Diag.ImportIsPrivate, "M14", "import " $tok " is private to its module - only a capitalized alias is re-exported") }
fn ReexportCycle(tok String&) r.Msg { return r.Msg(Diag.ReexportCycle, "M17", "re-exporting " $tok " reaches this module again") }
fn ImportReachedTwice(tok String&) r.Msg { return r.Msg(Diag.ImportReachedTwice, "M16", $tok " reaches a file another import of this module already reaches") }
fn NameClashesWithImport(tok String&) r.Msg { return r.Msg(Diag.NameClashesWithImport, "M20", $tok " is an import's alias in this module - rename one of them") }
fn UnknownType(tok String&) r.Msg { return r.Msg(Diag.UnknownType, "", "unknown type " $tok) }
fn UnknownTypeMeant(tok String&, text String&) r.Msg { return r.Msg(Diag.UnknownTypeMeant, "", "unknown type " $tok " - did you mean '" $text "'?") }
fn UnknownNumberType(tok String&, text String&) r.Msg { return r.Msg(Diag.UnknownNumberType, "T4", "unknown type " $tok " - the numbers are named by kind and width: did you mean '" $text "'?") }
fn UnknownName(tok String&) r.Msg { return r.Msg(Diag.UnknownName, "", "unknown name " $tok) }
fn UnknownNameMeant(tok String&, text String&) r.Msg { return r.Msg(Diag.UnknownNameMeant, "", "unknown name " $tok " - did you mean '" $text "'?") }
fn TypedHole(ty String&, fits String&) r.Msg { return r.Msg(Diag.TypedHole, "E41", "'_' holds the place of a value of type " $ty, $("nothing in scope has that type" if fits.Len() == 0 else "in scope: " $fits)) }
fn TypedHoleUntyped() r.Msg { return r.Msg(Diag.TypedHoleUntyped, "E41", "'_' holds the place of a value, and nothing here says its type") }
fn TypeNotAValue(name String&) r.Msg { return r.Msg(Diag.TypeNotAValue, "G38", "'" $name "' is a type, not a value", "", "write it where a type goes: a declaration ('x " $name " = ...'), a type argument or a match's subject") }
fn UnknownFunction(tok String&) r.Msg { return r.Msg(Diag.UnknownFunction, "", "unknown function or type " $tok) }
fn UnknownFunctionMeant(tok String&, text String&) r.Msg { return r.Msg(Diag.UnknownFunctionMeant, "", "unknown function or type " $tok " - did you mean '" $text "'?") }
fn UnknownErrorType(tok String&, hint String&) r.Msg { return r.Msg(Diag.UnknownErrorType, "R1", "unknown error type " $tok $hint) }

# ---- the error a clause took (R11b, R3a) ----

fn CatchNameUnused(tok String&) r.Msg { return r.Msg(Diag.CatchNameUnused, "R11b", $tok " names the error this clause took, and nothing uses it - leave the name off") }
fn CatchLoneUnused(tok String&, hint String&) r.Msg { return r.Msg(Diag.CatchLoneUnused, "R11b", $tok " names no error type, and nothing uses it", "so it names the error this clause took", "write the error type meant, or 'catch' alone" $hint) }
fn CatchNameInTask(tok String&) r.Msg { return r.Msg(Diag.CatchNameInTask, "R11b", "a spawned call's clause names no error", "the clause runs on the task's thread", "leave " $tok " off, or catch it where the join fails") }
fn CaughtAssigned(tok String&, text String&) r.Msg { return r.Msg(Diag.CaughtAssigned, "R11b", $tok " names the error this clause took and is never assigned", "", "hold a value that changes in a local of its own ('x := " $text "')") }
fn CaughtComparedToCaught() r.Msg { return r.Msg(Diag.CaughtComparedToCaught, "T20", "two error types are never compared - compare an error value with each ('e == T')") }
fn CaughtCompareWhat(tok String&) r.Msg { return r.Msg(Diag.CaughtCompareWhat, "T20", $tok " is compared with no error", "it is compared with an error word, an error type, a named set or another error value", "write 'e == T.WORD' or 'e == T'") }
fn ErrComparedNotError(text String&, ty String&, item String&) r.Msg { return r.Msg(Diag.ErrComparedNotError, "T20", "'" $text "' is " $ty ", not an error value - only an error value is '" $item "'") }
fn ErrValueNoOp(tok String&, ty String&) r.Msg { return r.Msg(Diag.ErrValueNoOp, "T20", $tok " on " $ty ": an error value is no number", "it is compared with '==' and '!=', and rendered with '$'") }
fn ErrMatchNotError(text String&, ty String&) r.Msg { return r.Msg(Diag.ErrMatchNotError, "T20", "the cases name errors, and '" $text "' is " $ty ", not an error value") }
fn ErrNeverNull(tok String&) r.Msg { return r.Msg(Diag.ErrNeverNull, "T20", $tok " holds an error here, never null", "a caught error, a word written or a value a test says is not null") }
fn ErrValueNotHeld(ty1 String&, ty2 String&, text String&) r.Msg { return r.Msg(Diag.ErrValueNotHeld, "T20", "expected " $ty1 ", found " $ty2, "it can be " $text, "test it first ('if e == T'), or hold it in a set that has it") }
fn CaughtNeverIs(tok String&, text1 String&, text2 String&) r.Msg { return r.Msg(Diag.CaughtNeverIs, "R11b", $tok " is never " $text1 " here - it is " $text2) }
fn TryOnCaught(text String&) r.Msg { return r.Msg(Diag.TryOnCaught, "R11b", "'" $text "' is an error already caught, not a call - raise it again with 'error " $text "'") }
fn ReraiseUndeclared(ty String&) r.Msg { return r.Msg(Diag.ReraiseUndeclared, "R3a", "the error raised again can be " $ty ", which this function does not declare", "", "add it after '?', or test the error first") }
fn ReraiseWordNotInSet(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.ReraiseWordNotInSet, "R3a", "the error raised again can be " $ty1 ", not in this function's '?' " $ty2, "", "add it after '?', or test the error first") }
fn RaiseNotCaught(tok String&) r.Msg { return r.Msg(Diag.RaiseNotCaught, "R3", "'error' raises a word, 'error T.WORD', or an error value - " $tok " is neither") }
fn PayloadHoldsRef(field String&, ty String&, what String&) r.Msg { return r.Msg(Diag.PayloadHoldsRef, "T19b", "payload field " $field " of type " $ty " holds " $what, "a payload holds values only", "hold a copy ('$x', 'x.Copy()') or plain data") }
fn PayloadWordBare(word String&, fields String&) r.Msg { return r.Msg(Diag.PayloadWordBare, "T19b", $word " carries " $fields " - give them: '" $word "(" $fields ")'") }
fn PlainWordCalled(word String&) r.Msg { return r.Msg(Diag.PlainWordCalled, "T19b", $word " carries nothing - write it without '()'") }
fn PayloadFieldUnnarrowed(name String&, field String&) r.Msg { return r.Msg(Diag.PayloadFieldUnnarrowed, "T19b", $name " may hold an error that has no field " $field, "", "test which it holds first ('if " $name " == T.Word')") }
fn PayloadArgs(word String&, want I64, got I64) r.Msg { return r.Msg(Diag.PayloadArgs, "T19b", $word " carries " $want " field" $("" if want == 1 else "s") ", " $got " given") }
fn RaisedFieldUnnamed() r.Msg { return r.Msg(Diag.RaisedFieldUnnamed, "R3b, T19b", "a field an error raised by name carries is named by the raise: a bare name, or 'name = value'") }
fn ErrPatternNeedsName(what String&) r.Msg { return r.Msg(Diag.ErrPatternNeedsName, "T19b, S13b", "a payload pattern needs a name, and " $what " is none", "it reads the error a local or a catch clause's name holds", "write 'e := ...' first and match 'e'") }
fn ErrPatternBindValue() r.Msg { return r.Msg(Diag.ErrPatternBindValue, "T19b, S13b", "a payload pattern binds names only in a match statement", "", "in a value match read the field after the test ('case W: e.field')") }
fn ErrPatternBindAlts() r.Msg { return r.Msg(Diag.ErrPatternBindAlts, "T19b, S13b", "a payload pattern binding a name stands alone in its case", "", "give each alternative a case of its own") }
fn ErrorMethodGiven(ty String&, name String&) r.Msg { return r.Msg(Diag.ErrorMethodGiven, "T20", "an error value's " $name " is the language's, and " $ty " cannot declare one", "(T20)", "choose another name") }
fn RaisedFieldsDiffer(name String&, first String&) r.Msg { return r.Msg(Diag.RaisedFieldsDiffer, "R3b, T19b", $name " carries (" $first "), as its first raise names them", "", "give the same fields in that order") }
fn RaiseNearError(tok String&, near String&) r.Msg { return r.Msg(Diag.RaiseNearError, "R3b", "no error of this module is named " $tok " - did you mean " $near "?", "", "to raise a new error of that name, name it after this function's '?'") }
fn RaiseNeedsQuestion(ty String&) r.Msg { return r.Msg(Diag.RaiseNeedsQuestion, "R1d", "this function raises " $ty " but writes no '?'", "a function that can fail says so", "write '?' after its result (its errors inferred), or '? " $ty "'") }
fn TryNeedsQuestion(ty String&) r.Msg { return r.Msg(Diag.TryNeedsQuestion, "R1d", $ty " can escape here, and this function writes no '?'", "a function that can fail says so", "write '?' after its result (its errors inferred), or catch it") }
fn ContractNeedsQuestion(name String&) r.Msg { return r.Msg(Diag.ContractNeedsQuestion, "R1d, D17", $name " has conditions and this function writes no '?'", "a call fails with ArgumentError where a condition is false", "write '?' after its result, or '? ArgumentError'") }
fn FlagAmongResults() r.Msg { return r.Msg(Diag.FlagAmongResults, "R23", "a Bool among several results is a flag beside a value", "", "what can fail says so with '? E' and raises an error instead (error NotFound)") }
fn FlagWithOutParam(tok String&) r.Msg { return r.Msg(Diag.FlagWithOutParam, "R23a", "a function giving a Bool that writes through " $tok " gives a flag beside a value", "", "give the value as the result and fail with '? E' instead") }
fn RaiseWholeType(tok String&) r.Msg { return r.Msg(Diag.RaiseWholeType, "R3", $tok " is an error type of words - raise one of them, 'error " $(tok[1:tok.Len() - 1]) ".Word'") }
fn RaisedWordOwnName(tok String&) r.Msg { return r.Msg(Diag.RaisedWordOwnName, "R3b", "an error of one word named as its type needs no declaration", "it is declared by raising it", "write 'error " $(tok[1:tok.Len() - 1]) "' where it is raised, with no declaration") }
fn CaughtMatchBlock() r.Msg { return r.Msg(Diag.CaughtMatchBlock, "R11b", "a match on an error value used as a value needs a value in every clause", "each clause is 'case P: v'", "a clause that leaves is written in a match statement") }
fn CaughtCaseNever(tok String&) r.Msg { return r.Msg(Diag.CaughtCaseNever, "R11b", "this case is never reached: the cases before it take every error " $tok " can be") }
fn CaughtCaseForm() r.Msg { return r.Msg(Diag.CaughtCaseForm, "R11b", "a case of an error value names an error word, an error type, a named set or null") }
fn CaughtMatchMissing(text String&) r.Msg { return r.Msg(Diag.CaughtMatchMissing, "R11b", "this match does not cover " $text " - add a case for it, or 'case _'") }
fn ErrorSetHoldsItself(tok String&, text String&) r.Msg { return r.Msg(Diag.ErrorSetHoldsItself, "T19a", $tok " reaches itself through its member '" $text "'", "a set holds its members' errors, never itself") }
fn ErrorWordOfMember(tok String&, ty String&) r.Msg { return r.Msg(Diag.ErrorWordOfMember, "T19a", "word " $tok " is " $ty "'s too, a member of this set - name it another way") }
fn ErrorAsResult(text String&) r.Msg { return r.Msg(Diag.ErrorAsResult, "T20", $text " is an error type: an error is raised, never returned", "", "write '? " $text "' after the parameters") }
fn NotAnErrorType(tok String&) r.Msg { return r.Msg(Diag.NotAnErrorType, "R1", $tok " is no error type - an error set names error types, their words and named sets") }
fn FuncTypeErrsUnwritten() r.Msg { return r.Msg(Diag.FuncTypeErrsUnwritten, "R1b", "a function type writes its error set - '? io.Error' - since no body says what it is") }
fn TraitErrsUnwritten() r.Msg { return r.Msg(Diag.TraitErrsUnwritten, "R1b", "a trait's method writes its error set - '? io.Error' - since no body says what it is") }
fn TypeIsPrivate(tok String&) r.Msg { return r.Msg(Diag.TypeIsPrivate, "M6", "type " $tok " is private to its module") }
fn TypeNameInUse(tok String&) r.Msg { return r.Msg(Diag.TypeNameInUse, "D2", "type " $tok " is already declared in this module") }
fn BuiltinTypeRedeclared(tok String&) r.Msg { return r.Msg(Diag.BuiltinTypeRedeclared, "D3a", $tok " is a built-in type's name - choose another") }
fn NameIsType(tok String&) r.Msg { return r.Msg(Diag.NameIsType, "D2", $tok " is already a type's name in this module - choose another") }
fn BuildConstRedeclared(tok String&) r.Msg { return r.Msg(Diag.BuildConstRedeclared, "B10", $tok " is a build constant - choose another name") }
fn BuildDefaultMut(tok String&) r.Msg { return r.Msg(Diag.BuildDefaultMut, "B10c", $tok " is a build constant, and a declaration giving it a default is immutable - drop 'mut'") }
fn BuildDefaultType(tok String&, ty String&) r.Msg { return r.Msg(Diag.BuildDefaultType, "B10c", $tok " is a build constant, and its default is a " $ty, "a default for a build constant is a Bool, I32, I64, U64, F64 or String") }
fn BuildDefaultFit(text1 String&, text2 String&, tok String&, ty String&) r.Msg { return r.Msg(Diag.BuildDefaultFit, "B10c", "-define " $text1 "=" $text2 " does not fit " $tok ", which is " $ty) }
fn UnknownBuildName(tok String&, text String&) r.Msg { return r.Msg(Diag.UnknownBuildName, "B10", "unknown name " $tok, "", "if it is a build constant, define it with '-define " $text "=VALUE', or declare it with a default") }
fn NameInUse(tok String&) r.Msg { return r.Msg(Diag.NameInUse, "D2", $tok " is already declared in this module") }
fn ConstraintDisagrees(tok String&) r.Msg { return r.Msg(Diag.ConstraintDisagrees, "G19", $tok " is constrained differently elsewhere in this declaration - one constraint per variable") }
fn ConstraintUnmet(ty String&, text1 String&, text2 String&) r.Msg { return r.Msg(Diag.ConstraintUnmet, "G19", $ty " does not satisfy the constraint " $text1 " on " $text2) }
fn ConstraintUnmetMethod(ty String&, text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.ConstraintUnmetMethod, "G19", $ty " does not satisfy the constraint " $text1 " on " $text2 ": it has no method " $text3 " that fits") }
fn ConstraintSealed(ty String&, text1 String&, text2 String&, text3 String&, text4 String&) r.Msg { return r.Msg(Diag.ConstraintSealed, "G19, T31", $ty " does not satisfy the constraint " $text1 " on " $text2, $text3 " is sealed - only the types its own module gives '" $text4 "' satisfy it") }
fn ConstraintClosed(ty String&, text1 String&, text2 String&, text3 String&, list String&) r.Msg { return r.Msg(Diag.ConstraintClosed, "G19, T31a", $ty " does not satisfy the constraint " $text1 " on " $text2, $text3 " is closed, met by " $list " alone") }
fn TraitExtendsNotTrait(text String&) r.Msg { return r.Msg(Diag.TraitExtendsNotTrait, "T30a", $text " is not a trait, so a trait cannot extend it", "", "a type takes a trait's methods by declaring them") }
fn TraitExtendsItself(tok String&) r.Msg { return r.Msg(Diag.TraitExtendsItself, "T30a", $tok " extends itself through the traits it extends") }
fn TraitMemberOpen(text String&) r.Msg { return r.Msg(Diag.TraitMemberOpen, "T31a", $text " is an open trait, so it lists no types to take in - list types, or closed traits") }
fn TraitMemberMissing(ty String&, tok String&, tok2 String&) r.Msg { return r.Msg(Diag.TraitMemberMissing, "T31a", $ty " is listed by " $tok " but has no method " $tok2 " that fits", "", "declare it, or leave " $ty " out") }
fn ConstraintUnmetHash(ty String&, text1 String&, text2 String&) r.Msg { return r.Msg(Diag.ConstraintUnmetHash, "G19, E10b", $ty " does not satisfy the constraint " $text1 " on " $text2, "it has no Hash", "declare 'Hash() I64', agreeing with '=='") }
fn UnboundedInstantiation() r.Msg { return r.Msg(Diag.UnboundedInstantiation, "G17", "this generic's instantiations never end - each one requires a larger one") }
fn TypeHoldsItself(ty String&) r.Msg { return r.Msg(Diag.TypeHoldsItself, "T16", $ty " cannot hold itself by value - hold it through a reference ('&')") }
fn ArrayTypeHoldsItself(text1 String&, text2 String&, ty String&) r.Msg { return r.Msg(Diag.ArrayTypeHoldsItself, "T29", $text1 " holds itself through the array it is declared over", "", "hold the array in a struct: 'type " $text2 " struct(items " $ty "&)'") }
fn MissingTypeArgs(tok String&, text String&) r.Msg { return r.Msg(Diag.MissingTypeArgs, "G7", $tok " is generic - write its type arguments, as '" $text "<I32>'") }
fn TypeArgCount(text String&, n1 I64, n2 I64) r.Msg { return r.Msg(Diag.TypeArgCount, "G7", "type arguments for " $text ": expected " $n1 ", found " $n2) }
fn TryParens() r.Msg { return r.Msg(Diag.TryParens, "E24", "these parentheses group nothing", "a 'try' covers the whole expression after it", "write it without them") }
fn AsCanFail() r.Msg { return r.Msg(Diag.AsCanFail, "E32", "'as' fails where the value holds another case", "", "write 'try' before it and catch CaseError, or '(x as C)!'") }
fn NarrowNotNumber(ty String&) r.Msg { return r.Msg(Diag.NarrowNotNumber, "E26b", "'Narrow' converts to a number type, and " $ty " is none") }
fn NarrowNeedsType() r.Msg { return r.Msg(Diag.NarrowNeedsType, "E26b", "'Narrow' names the type it converts to - write 'x.Narrow<I32>()'") }
fn TypeArgsOnNonGeneric(text String&) r.Msg { return r.Msg(Diag.TypeArgsOnNonGeneric, "G7", $text " is not generic, so it takes no type arguments") }
fn TypeVarAsValue(text String&) r.Msg { return r.Msg(Diag.TypeVarAsValue, "G8b", $text " is a type variable, not a value") }
fn ArrayLengthRange(n I64) r.Msg { return r.Msg(Diag.ArrayLengthRange, "T7c", "an array's length is from 0 to the largest whose bytes fit an I64, found " $n) }
fn TypeMatchValueCase(text String&) r.Msg { return r.Msg(Diag.TypeMatchValueCase, "G13", $text " is a type variable, so its cases are types") }
fn ArrayTooManyArgs(n I64) r.Msg { return r.Msg(Diag.ArrayTooManyArgs, "G8, T7", "Array takes one type argument, found " $n, "its element type - a length is never written in a type", "'Array<T>(n)' makes n elements") }
fn ConstraintNotTrait(ty String&) r.Msg { return r.Msg(Diag.ConstraintNotTrait, "G6, G19", $ty " is not a trait, so it cannot constrain a type variable", "a type parameter's constraint is a trait, and a length is no parameter (T7)") }
fn InstanceNotReferable(text String&, ty String&) r.Msg { return r.Msg(Diag.InstanceNotReferable, "T24", $text " gives a reference here, and " $ty " cannot be one", "only a struct, an enum or an array can", "read the value instead (as 'x[i]' does)") }
fn NoteInstanceRef() r.Msg { return r.Msg(Diag.NoteInstanceRef, "", "the reference it would give is written here") }
fn InvalidReferenceTarget(ty String&) r.Msg { return r.Msg(Diag.InvalidReferenceTarget, "T24", $ty " cannot be a reference - only a struct, an enum or an array can") }
fn DoubleReferenceMarker() r.Msg { return r.Msg(Diag.DoubleReferenceMarker, "T24", "a type takes at most one reference marker") }
fn DestructCopiedHeld(ty String&, held String&) r.Msg { return r.Msg(Diag.DestructCopiedHeld, "C11", $ty " has a destructor to run and copies, and so does " $held, "a copy of " $held " would copy what it holds past its count (its Copy)", "hold them by reference, " $ty "&") }
fn DestructTypeByValue(ty String&, held String&) r.Msg { return r.Msg(Diag.DestructTypeByValue, "C11", $ty " has a destructor to run, and " $held " keeps values of it", "no holder ends them there", "write " $ty "&, or keep them in a Vec<" $ty ">") }
fn TraitNotAType(ty String&) r.Msg { return r.Msg(Diag.TraitNotAType, "T30, T32", $ty " is a trait, not a type", "a trait is a constraint on a type variable", "a value of any type meeting it is an 'any " $ty $("" if ty.EndsWith("&") else "&") "'") }
fn AnyNotTrait(ty String&) r.Msg { return r.Msg(Diag.AnyNotTrait, "T32", "'any' takes a trait, and " $ty " is none") }
fn AnyNeedsMarker(ty String&) r.Msg { return r.Msg(Diag.AnyNeedsMarker, "T32", "an 'any' is always a reference - write 'any " $ty "&'") }
fn FuncTypeBare(rest String&) r.Msg { return r.Msg(Diag.FuncTypeBare, "T21", "a function type is held only by reference", "", "write 'fn&" $rest "', or 'fn?&" $rest "' where it may be null") }
fn FuncDeclBare(ty String&) r.Msg { return r.Msg(Diag.FuncDeclBare, "T21b", $ty " is a function type, held only by reference", "", "write '" $ty "&', or '" $ty "?&' where it may be null") }
fn FuncDeclMismatch(want String&, have String&, name String&) r.Msg { return r.Msg(Diag.FuncDeclMismatch, "T21b, T29", "expected " $want ", found " $have, "a declared function type is a type of its own", "write '" $name "(f)' to make one the other") }
fn AnyCopyOutlived() r.Msg { return r.Msg(Diag.AnyCopyOutlived, "T32a", "the 'any' outlives what this array's elements refer to", "its copy keeps them", "build them where the 'any' goes") }
fn AnyNotConverted(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.AnyNotConverted, "T32a", "an '" $ty1 "' is never made an '" $ty2 "' - an 'any' is made from its instance's own type, once") }
fn AnyUnmet(ty String&, tr String&) r.Msg { return r.Msg(Diag.AnyUnmet, "T32a", $ty " cannot be an 'any " $tr "&': it does not satisfy " $tr) }
fn AnyUnmetMethod(ty String&, tr String&, tok String&) r.Msg { return r.Msg(Diag.AnyUnmetMethod, "T32a, T31", $ty " cannot be an 'any " $tr "&': it has no method " $tok " that fits") }
fn AnyNotMember(ty String&, tr String&, list String&) r.Msg { return r.Msg(Diag.AnyNotMember, "T32a, T31a", $ty " cannot be an 'any " $tr "&'", $tr " is closed, met by " $list " alone") }
fn AnyMethodScopes(ty String&, tok String&, tr String&) r.Msg { return r.Msg(Diag.AnyMethodScopes, "T32a, T22", $ty "'s " $tok " cannot be called through an 'any " $tr "&'", "it says where its references live as " $tr "'s signature does not") }
fn AnyMethodObligations(ty String&, tok String&, tr String&) r.Msg { return r.Msg(Diag.AnyMethodObligations, "T32a, T22a", $ty "'s " $tok " cannot be called through an 'any " $tr "&'", "it ties where what it is given lives to what it keeps or gives back, which a call through an 'any' cannot check", "call it directly, or through generic code") }
fn AnyNoCopy(tok String&, ty String&) r.Msg { return r.Msg(Diag.AnyNoCopy, "T32", $tok " keeps a copy of the value it is called on, and an " $ty " has none", "", "call it on the instance's own type") }
fn AnyNoMethod(ty String&, tok String&, hint String&) r.Msg { return r.Msg(Diag.AnyNoMethod, "T32b", $ty " has no method " $tok " - an 'any' is used through its trait's methods alone" $hint) }
fn AnyOpenInspected(ty String&, tr String&) r.Msg { return r.Msg(Diag.AnyOpenInspected, "T34", $ty "'s trait " $tr " is open, so its instance's type is never asked for", "", "use its methods, or add the method it lacks") }
fn AnyNotMemberCase(ty String&, tr String&) r.Msg { return r.Msg(Diag.AnyNotMemberCase, "T34", $ty " is not one of the types " $tr " lists") }
fn AnyCaseTwice(ty String&) r.Msg { return r.Msg(Diag.AnyCaseTwice, "T34", $ty " is matched by an earlier clause - this one is never reached") }
fn AnyCaseAlone() r.Msg { return r.Msg(Diag.AnyCaseAlone, "T34", "a type case binding a name is its clause's only alternative - bind '_' to share a clause") }
fn AnySpawnedResult(targets String&, ty String&, text String&) r.Msg { return r.Msg(Diag.AnySpawnedResult, "T32b, P1", "a task cannot call through an 'any''s table", "a task calls a function or a function value", "write 'spawn " $targets "fn() " $ty " { return " $text " }()'") }
fn AnySpawned(text String&) r.Msg { return r.Msg(Diag.AnySpawned, "T32b, P1", "a task cannot call through an 'any''s table", "a task calls a function or a function value", "write 'spawn fn() { " $text " }'") }
fn AnyCaseNotAny(ty String&) r.Msg { return r.Msg(Diag.AnyCaseNotAny, "T34", "a type case matches an 'any' of a closed trait, and this is " $ty) }
fn NoteAnyMethod(tok String&) r.Msg { return r.Msg(Diag.NoteAnyMethod, "", $tok " is declared here") }
fn EnumCaseInUse(tok String&) r.Msg { return r.Msg(Diag.EnumCaseInUse, "T17", "enum case " $tok " is already declared") }
fn DeclaredTwice(tok String&) r.Msg { return r.Msg(Diag.DeclaredTwice, "", $tok " is declared twice") }
fn FieldHasParamName(tok String&) r.Msg { return r.Msg(Diag.FieldHasParamName, "C2a", "field " $tok " has a parameter's name", "", "write it bare to take the parameter's value, or name it apart") }
fn TraitMethodGeneric(tok String&) r.Msg { return r.Msg(Diag.TraitMethodGeneric, "T35", "trait method " $tok " may not be generic in a type of its own") }
fn CtorFieldNoValue(tok String&) r.Msg { return r.Msg(Diag.CtorFieldNoValue, "C4", "field " $tok " names no parameter of the constructor - give it a value, with '=' or ':='") }
fn DefaultNotTrailing(tok String&) r.Msg { return r.Msg(Diag.DefaultNotTrailing, "D8a", $tok " has no default, but a parameter before it does - defaulted parameters come last") }
fn TypeVarNamesType(tok String&) r.Msg { return r.Msg(Diag.TypeVarNamesType, "G1", "type variable " $tok " is named after a type - choose a name no type has, as '<T>'") }
fn TypeVarNotInferable(text String&, name String&) r.Msg { return r.Msg(Diag.TypeVarNotInferable, "G4", "type variable " $text " of " $name " appears in no parameter's type", "so the call writes it", "write " $name "<...>(...)") }
fn TypeVarNotErrorSet(tok String&) r.Msg { return r.Msg(Diag.TypeVarNotErrorSet, "G1a", $tok " is a type variable, not an error set", "", "an error-set parameter is written after '?' in its list, '<T ? E>'") }
fn ErrVarNotType(tok String&, name String&) r.Msg { return r.Msg(Diag.ErrVarNotType, "G1a", $tok " is an error-set parameter, not a type", "it stands where an error set is written", "write '? " $name "'") }
fn ErrSetArgUnwanted(name String&) r.Msg { return r.Msg(Diag.ErrSetArgUnwanted, "G1a", $name " has no error-set parameter, so its arguments end in no '?'") }
fn ExternType(ty String&) r.Msg { return r.Msg(Diag.ExternType, "X2", $ty " cannot cross the C boundary", "an extern parameter is a number of the twelve primitives, a Bool, an extern type's reference, a plain-data struct or a reference to one, or an array of these") }
fn ExternResult(ty String&) r.Msg { return r.Msg(Diag.ExternResult, "X2", $ty " cannot come back from C", "an extern's result is one number of the twelve primitives, Bool, extern type's reference or plain-data struct") }
fn ForeignBuilt(ty String&) r.Msg { return r.Msg(Diag.ForeignBuilt, "X10", $ty " is an extern type: only C makes one", "", "declare the C function that does, as 'extern fn open() " $ty "&'") }
fn ForeignByValue(ty String&) r.Msg { return r.Msg(Diag.ForeignByValue, "X10", $ty " is an extern type, held only by reference", "", "write '" $ty "&', or '" $ty "?&' where it may be null") }
fn ExportMethod() r.Msg { return r.Msg(Diag.ExportMethod, "X12", "an export fn cannot be a method", "an export fn is one C calls by its name, and a method has no C name", "declare a function taking the receiver") }
fn ExportGeneric() r.Msg { return r.Msg(Diag.ExportGeneric, "X12", "an export fn cannot be generic", "an export fn is one C function, and a generic one stands for many", "declare it for the types C passes") }
fn ExportName(tok String&) r.Msg { return r.Msg(Diag.ExportName, "X12", $tok " is the program's own name in C - name the export fn otherwise") }
fn ExportType(ty String&) r.Msg { return r.Msg(Diag.ExportType, "X12", $ty " cannot come from C", "an export fn's parameter is a number, a Bool, an extern type's reference, a plain-data struct or a reference to one, or an array by reference") }
fn ExportResult(ty String&) r.Msg { return r.Msg(Diag.ExportResult, "X12", $ty " cannot go back to C", "an export fn gives one number, Bool, extern type's reference, plain-data struct, or an array of these by value") }
fn ExportObligation(rel String&) r.Msg { return r.Msg(Diag.ExportObligation, "X12", "an export fn's body requires what its caller cannot hold (" $rel ")", "its caller is C, which nothing holds to what a body requires", "keep what it is given only for the call") }
fn CallbackNotExport() r.Msg { return r.Msg(Diag.CallbackNotExport, "X13", "a C function is given a function by the name of an export fn", "", "declare one with 'export fn' and pass it by name") }
fn LinkName(tok String&) r.Msg { return r.Msg(Diag.LinkName, "X9", $tok " names no library and no file", "", "write a library's name, as 'link \"m\"', or a path to one, as 'link \"lib/libx.a\"'") }
fn InterpLink(text String&, why String&) r.Msg { return r.Msg(Diag.InterpLink, "B3e", "the library '" $text "' a link names cannot be loaded into interpret", $why, "build the program instead") }
fn VarArgType(ty String&) r.Msg { return r.Msg(Diag.VarArgType, "X21", $ty " cannot be a C variable argument", "", "pass a number, a reference or an array; a Bool as 'I32(b)', a struct by reference") }
fn VarArgWide(ty String&) r.Msg { return r.Msg(Diag.VarArgWide, "X21", $ty " cannot be a C variable argument", "no C type of olang's holds it", "convert it, 'I64(x)' or 'U64(x)'") }
fn LinkOnOlangImport() r.Msg { return r.Msg(Diag.LinkOnOlangImport, "X17", "'link' names the library a C header's declarations are in - an olang module needs none") }
fn CHeaderNotFound(spec String&) r.Msg { return r.Msg(Diag.CHeaderNotFound, "X17", "no C header '" $spec "' beside this file or where the C compiler looks") }
fn CFileNotFound(path String&) r.Msg { return r.Msg(Diag.CFileNotFound, "X17", "no C file at " $path) }
fn CImportFailed(spec String&, why String&) r.Msg { return r.Msg(Diag.CImportFailed, "X17", "'" $spec "' cannot be imported", $why) }
fn CNoForm(name String&, why String&) r.Msg { return r.Msg(Diag.CNoForm, "X19", "the C import has no olang form of '" $name "': " $why) }
fn ConstToMutRef(fix String&) r.Msg { return r.Msg(Diag.ConstToMutRef, "T25d", "this hands data written in the program where it may be written", "", "pass a copy of its own: " $fix) }
fn CPointerReadOnly(ty String&) r.Msg { return r.Msg(Diag.CPointerReadOnly, "X22", "C may write through this pointer, and " $ty " is read-only - pass a writable one ('mut')") }
fn CPointerTemporary(ty String&) r.Msg { return r.Msg(Diag.CPointerTemporary, "X22", "C is handed a pointer to a " $ty " that is no place - put it in a local first") }
fn MutOnValueType(ty String&) r.Msg { return r.Msg(Diag.MutOnValueType, "T25b", "'mut' makes a reference writable, and " $ty " is no reference") }
fn MutOnValueParam(ty String&) r.Msg { return r.Msg(Diag.MutOnValueParam, "D9", "'mut' on a by-value parameter of type " $ty, "a by-value parameter is the callee's own copy, always writable - 'mut' is for a reference") }
fn MutOnValueField(ty String&) r.Msg { return r.Msg(Diag.MutOnValueField, "C3", "a field is writable wherever its instance is - 'mut' is for a reference, and " $ty " is none") }
fn PrimCtorNotPrimitive() r.Msg { return r.Msg(Diag.PrimCtorNotPrimitive, "T29d", "only a type over a primitive has a constructor written this way", "", "a struct writes 'struct(params) { ... }'") }
fn PrimCtorParam(ty String&) r.Msg { return r.Msg(Diag.PrimCtorParam, "T29d", "this constructor takes one parameter, of type " $ty " - the value it checks") }
fn TypeDefinedThroughItself(text String&) r.Msg { return r.Msg(Diag.TypeDefinedThroughItself, "", $text " is used while it is still being declared") }
fn ErrorWordInUse(tok String&) r.Msg { return r.Msg(Diag.ErrorWordInUse, "T19", "error word " $tok " is already declared") }
fn ExtendsNotBase() r.Msg { return r.Msg(Diag.ExtendsNotBase, "T29f", "only a type over a number or an array extends its base") }
fn GenericNotStruct() r.Msg { return r.Msg(Diag.GenericNotStruct, "G6", "only a struct, an enum or a trait takes type parameters") }
fn DeclaredOverAggregate(ty String&) r.Msg { return r.Msg(Diag.DeclaredOverAggregate, "T29", "a type is declared over a number, an array or a function type, not over " $ty, "", "hold it in a struct's field instead") }
fn NotTheOperator(ty String&, text1 String&, text2 String&, text3 String&, text4 String&) r.Msg { return r.Msg(Diag.NotTheOperator, "E31", $ty "'s " $text1 " takes " $text2 " besides its receiver", "it is an ordinary method, not the one " $text3 " calls, which takes " $text4) }
fn ArrayOneIndex(ty String&) r.Msg { return r.Msg(Diag.ArrayOneIndex, "E31", $ty " takes one index - several are passed to a type's At or SetAt") }
fn OperatorResult(text String&) r.Msg { return r.Msg(Diag.OperatorResult, "E31", $text " gives one result") }
fn CommutesNotHere(text String&) r.Msg { return r.Msg(Diag.CommutesNotHere, "E31c", "'commutes' is no use on " $text, "it is written only on a Plus, Mul, BitAnd, BitOr or BitXor of one parameter", "remove it") }
fn CommutesSameType(text String&, ty String&) r.Msg { return r.Msg(Diag.CommutesSameType, "E31c", $text " takes " $ty ", its own receiver's type", "the operator reads both ways already", "remove 'commutes'") }
fn CommutesClash(op String&, a String&, b String&, other String&) r.Msg { return r.Msg(Diag.CommutesClash, "E31c", "'commutes' here makes " $op " between " $a " and " $b " ambiguous", "it would call this method or " $other, "remove 'commutes'") }
fn SetatResult() r.Msg { return r.Msg(Diag.SetatResult, "E31", "SetAt gives no result") }
fn MethodCannotFail(text String&) r.Msg { return r.Msg(Diag.MethodCannotFail, "E31", $text " cannot fail - the operation calling it has nowhere to handle an error") }
fn LessNotBool() r.Msg { return r.Msg(Diag.LessNotBool, "E31", "Less, which '<' calls, gives a Bool") }
fn LenShape() r.Msg { return r.Msg(Diag.LenShape, "E31", "Len gives an I64") }
fn EqShape() r.Msg { return r.Msg(Diag.EqShape, "E10a", "Eq takes one parameter of its receiver's own type and gives a Bool") }
fn CopyShape(ty String&) r.Msg { return r.Msg(Diag.CopyShape, "E31d", "this Copy has the wrong shape", "Copy takes nothing but its receiver, read through a read-only reference, gives a new " $ty " and cannot fail", "write 'fn (x " $ty "&) Copy() " $ty "'") }
fn CopyOnWhat(ty String&) r.Msg { return r.Msg(Diag.CopyOnWhat, "E31d", $ty " cannot declare a Copy", "only a struct or an enum the program declares has a Copy of its own - its supplied Copy is the one") }
fn CopyDoesMore(what String&) r.Msg { return r.Msg(Diag.CopyDoesMore, "E31d", "this Copy " $what, "a Copy only builds the new value, and every copy of the value runs it, so it may do nothing else") }
fn ImmutWrite(ty String&) r.Msg { return r.Msg(Diag.ImmutWrite, "T13a", "nothing of " $ty " changes after its constructor (it is immut) - make a new one") }
fn TextWrite() r.Msg { return r.Msg(Diag.TextWrite, "T13a, T29c", "a String never changes once it is made", "", "write the text as an Array<Char> and make the String with String(chars), or build it with a StringBuilder") }
fn ImmutMutRef(ty String&) r.Msg { return r.Msg(Diag.ImmutMutRef, "T13a", "'mut' on " $ty ", which is immut", "'mut' makes a reference writable, and nothing of " $ty " changes after its constructor", "read it through '" $ty "&'") }
fn TextMutRef() r.Msg { return r.Msg(Diag.TextMutRef, "T13a, T29c", "'mut' on a String, which never changes once it is made", "'mut' makes a reference writable", "write text through 'mut Array<Char>&', read it through 'String&'") }
fn ImmutCopy(ty String&) r.Msg { return r.Msg(Diag.ImmutCopy, "T13a, E31d", "a copy of " $ty " shares it, as nothing of it changes (it is immut) - it declares no Copy") }
fn UniqueImmut() r.Msg { return r.Msg(Diag.UniqueImmut, "T13b", "'unique' and 'immut' are never one type's", "an immut value is copied freely, a unique one never") }
fn UniqueImmutPart(ty String&, part String&) r.Msg { return r.Msg(Diag.UniqueImmutPart, "T13b", $part " is unique, so it is no part of " $ty ", which is immut", "an immut value is copied freely, a unique one never", "hold a reference, '" $part "&'") }
fn UniqueCopy(ty String&) r.Msg { return r.Msg(Diag.UniqueCopy, "T13b, E31d", $ty " is unique, so it has no Copy", "a unique value is never copied", "make a new one with a function or its constructor") }
fn UniqueByValue(ty String&, what String&) r.Msg { return r.Msg(Diag.UniqueByValue, "T13b", $ty " is unique, and this value is held elsewhere", $what " holds one of its own", "write a reference ('" $ty "&'), or make a new " $ty " here") }
fn UniqueFill(ty String&) r.Msg { return r.Msg(Diag.UniqueFill, "T13b", "Array<" $ty ">(n, fill) copies its fill, and " $ty " is unique", "the fill is copied into every element", "make each element with a comprehension ('" $ty "[" $ty "(...) for i in range n]'), or hold references ('Array<" $ty "&>')") }
fn PackedNotStruct() r.Msg { return r.Msg(Diag.PackedNotStruct, "T13c", "'packed' lays a struct out bit by bit - it is written right before 'struct', nothing else") }
fn PackedField(ty String&, what String&) r.Msg { return r.Msg(Diag.PackedField, "T13c", $ty " (" $what ") is no field of a packed struct", "a packed struct lays its fields out bit by bit", "a field is an integer, Bool, Char, float, payload-free enum, packed struct, or an array of a known length of these") }
fn PackedParams() r.Msg { return r.Msg(Diag.PackedParams, "T13c", "a packed struct takes no type parameters - its layout is its declaration's") }
fn PackedDestruct() r.Msg { return r.Msg(Diag.PackedDestruct, "T13c", "a packed struct holds plain data, so it declares no destructor") }
fn PackedLend(field String&) r.Msg { return r.Msg(Diag.PackedLend, "T13c", "'" $field "' is a field of a packed struct, so no reference names it", "it is at a bit offset", "copy it into a local first ('v := " $field "') and lend that") }
fn PackedByValueC(ty String&) r.Msg { return r.Msg(Diag.PackedByValueC, "X11a", $ty " is packed and holds a float, so it crosses to C by reference only - write '" $ty "&'") }
fn UniqueAfter(name String&, ty String&) r.Msg { return r.Msg(Diag.UniqueAfter, "T13b", "'" $name "' is handed on here, and " $ty " is unique", "a unique value given by value lands once more only at its last mention, and '" $name "' is mentioned after") }
fn UniqueLentHere(name String&, ty String&) r.Msg { return r.Msg(Diag.UniqueLentHere, "T13b", "'" $name "' is handed on here while the same call also reaches it", $ty " is unique, so one value would be in two places", "give the call '" $name "' once, or hand it on in a call of its own") }
fn UniqueAlias(name String&, ty String&, alias String&) r.Msg { return r.Msg(Diag.UniqueAlias, "T13b", "'" $name "' is handed on here, and '" $alias "', which reaches it, is used after", $ty " is unique", "use '" $alias "' before handing '" $name "' on, or no longer after") }
fn DropRegistered(h String&, v String&, t String&) r.Msg { return r.Msg(Diag.DropRegistered, "O15, O16", "'" $h "' may be ended after '" $v "', which it may hold a reference to", "it holds a value where its call landed, ended as that scope closes, so its destructors could read '" $v "' already ended", "declare it by value, '" $h " " $t " = ...', and its block ends it first") }
fn DropTempRegistered(v String&, t String&) r.Msg { return r.Msg(Diag.DropTempRegistered, "O15, O16", "this value may be ended after '" $v "', which it may hold a reference to", "it is held where its call lands, ended as that scope closes, so its destructors could read '" $v "' already ended", "declare it by value first, 'x " $t " = ...', and give the call that") }
fn DropCycle(a String&, b String&) r.Msg { return r.Msg(Diag.DropCycle, "O15", "'" $a "' and '" $b "' may each hold a reference to the other", "both have destructors to run - whichever is ended first, the other's destructor could read it", "end one of them before the other refers to it (a block of its own), or hold one by reference") }
fn UniqueKind(what String&) r.Msg { return r.Msg(Diag.UniqueKind, "T13b", "'unique' says a value exists in one place - " $what " has no values of its own") }
fn UniqueNeedsCopy(text String&, ty String&) r.Msg { return r.Msg(Diag.UniqueNeedsCopy, "T13b, G18", $text " needs a copy, and " $ty " is unique", "its values are never copied", "call " $text " with a reference ('" $ty "&') or with a type that copies") }
fn DestructNotUnique(ty String&) r.Msg { return r.Msg(Diag.DestructNotUnique, "C11, T13b", "a type with a destructor is unique, and " $ty " is not", "a destructor releases what one value holds", "declare it 'type " $ty " unique struct(...)'") }
# T2d, T13d: weak references and the generational types they name
fn WeakNotNullable(rest String&) r.Msg { return r.Msg(Diag.WeakNotNullable, "T2d", "'weak' is written before a reference that may be null", "a weak place reads null once nothing owning holds what it names", "write 'weak " $weakFix(rest) "'") }
fn weakFix(rest String&) String {
    if rest.EndsWith("&") and not rest.EndsWith("?&"): return $rest[:rest.Len() - 1] "?&"
    return $rest "?&"
}
fn WeakPlace(ty String&) r.Msg { return r.Msg(Diag.WeakPlace, "T2d", "'weak' is written only where a value is stored", "a field, a payload, an element or a type argument a type stores, or a global - never a local, a parameter, a result or a function type's", "write '" $ty "' here") }
fn WeakTarget(ty String&, what String&) r.Msg { return r.Msg(Diag.WeakTarget, "T2d", "a weak reference names a struct or an enum, and " $ty " is " $what, "", "hold it by an ordinary reference") }
fn WeakFresh(ty String&) r.Msg { return r.Msg(Diag.WeakFresh, "T2d", "a new " $ty " stored only into a weak place would read null at once", "nothing owning holds it", "store it into an owning place first, then here") }
fn WeakUnheld(ty String&) r.Msg { return r.Msg(Diag.WeakUnheld, "T2d", "no owning place of the program holds a " $ty, "a field, an element, a payload or a global holding it other than weakly would - so every weak reference to one would read null", "hold it somewhere owning, or drop 'weak'") }
fn GenByValue(ty String&) r.Msg { return r.Msg(Diag.GenByValue, "T13d", $ty " is generational, so its values are held only by reference", "a weak reference names it", "write '" $ty "&' here") }
fn GenByValueAway(ty String&) r.Msg { return r.Msg(Diag.GenByValueAway, "T13d", "this weak reference makes " $ty " generational, held by value elsewhere", "another module holds one by value, and a generational type's values are held only by reference", "write '" $ty "&' there, or drop 'weak'") }
fn NoteGenSlot(ty String&) r.Msg { return r.Msg(Diag.NoteGenSlot, "", "a " $ty " held by value here") }
fn GenUnique(ty String&) r.Msg { return r.Msg(Diag.GenUnique, "T13d", $ty " is generational, so it cannot be unique", "a weak reference names it, and its values are never copied, only referenced", "drop 'unique'") }
fn GenCopyDestruct(ty String&) r.Msg { return r.Msg(Diag.GenCopyDestruct, "T13d, E31d", $ty " is generational and declares a destructor, so it has no Copy", "each instance's destructor runs once", "make a new one with its constructor") }
fn StrShape() r.Msg { return r.Msg(Diag.StrShape, "E11c", "Str gives a String") }
fn EqStrWrites(text String&) r.Msg { return r.Msg(Diag.EqStrWrites, "E10a, E11c", $text " takes what it is given read-only - neither its receiver nor a parameter may be 'mut'") }
fn ProtocolBothSpellings(ty String&, text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.ProtocolBothSpellings, "M6b", $ty " declares " $text1 " twice, public and private", "", "keep one: " $text2 ", or " $text3 " for its own module only") }
fn ProtocolPrivate(tok String&, ty String&, text1 String&, text2 String&) r.Msg { return r.Msg(Diag.ProtocolPrivate, "M6b", $tok " needs " $ty "'s " $text1 ", which is private to its module", "", "declare it " $text2 " to use it here") }
fn OverrideSignature(text String&) r.Msg { return r.Msg(Diag.OverrideSignature, "M19e", $text " does not have the signature of the default it overrides", "", "match it, or choose another name") }
fn DefaultOutsideTrait(text String&) r.Msg { return r.Msg(Diag.DefaultOutsideTrait, "M19e", "a default of trait " $text " is declared in that trait's module") }
fn MethodOnForeignType(ty String&) r.Msg { return r.Msg(Diag.MethodOnForeignType, "M19", "a method of " $ty " is declared in that type's module") }
fn DefaultShadowsRequired(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.DefaultShadowsRequired, "M19e", "trait " $text1 " already requires a method " $text2 " - choose another name for this default") }
fn MethodClashesInherited(ty String&, text String&) r.Msg { return r.Msg(Diag.MethodClashesInherited, "T29e", $ty " inherits a method " $text " from its base - choose another name") }

# M21: two methods of one name whose receivers some one instance meets alike
fn MethodOverlap(name String&, ty String&) r.Msg { return r.Msg(Diag.MethodOverlap, "M21", "'" $name "' is declared twice for " $ty " - declare one per instance") }
fn MethodClashesSupplied(text String&, ty String&) r.Msg { return r.Msg(Diag.MethodClashesSupplied, "E23, E33, E37, P9, T17e", "the compiler supplies " $text " for " $ty " - choose another name") }
fn MethodOnBuiltinType(ty String&) r.Msg { return r.Msg(Diag.MethodOnBuiltinType, "M19d", "only the prelude declares methods of " $ty, "", "declare a type of your own over it: 'type T extends ...'") }
fn BuilderOwnerElsewhere(ty String&) r.Msg { return r.Msg(Diag.BuilderOwnerElsewhere, "D19", "a builder is declared in its owner's module, and " $ty " is not this module's", "", "declare it there") }
fn BuilderOwnerKind(ty String&) r.Msg { return r.Msg(Diag.BuilderOwnerKind, "D19", $ty " is no type a builder makes", "a builder's owner is a struct, an enum, a type declared over another, an extern type, or a type variable a trait constrains") }
fn BuilderResult(owner String&, got String&) r.Msg { return r.Msg(Diag.BuilderResult, "D19", "a builder of " $owner " gives one value of it, not " $got, "its result is " $owner ", a reference to it or an instance of it") }
fn BuilderTakesOwner(owner String&, param String&) r.Msg { return r.Msg(Diag.BuilderTakesOwner, "D19", "a builder of " $owner " takes no value of it, and " $param " does", "", "make it a method, 'fn (x " $owner ") ...', or a function of the module") }
fn BuilderNameTaken(owner String&, tok String&, what String&) r.Msg { return r.Msg(Diag.BuilderNameTaken, "D19", $tok " is already " $what " of " $owner " - name the builder otherwise") }
fn BuilderTwice(owner String&, tok String&) r.Msg { return r.Msg(Diag.BuilderTwice, "D19", $owner " has two builders named " $tok) }
fn BuilderExpected(tok String&, ty String&, owner String&, name String&) r.Msg { return r.Msg(Diag.BuilderExpected, "D19a", $tok " makes a " $ty " its module declares and takes none", "", "declare it as the type's builder, 'fn " $owner "." $name "(...)', and call it '" $ty "." $name "(...)'") }
fn BuilderOwnerBare(ty String&, every String&, one String&, name String&) r.Msg { return r.Msg(Diag.BuilderOwnerBare, "D19", $ty " is generic, and a builder's owner is written with its arguments", "", "write 'fn " $every "." $name "(...)' for every instance, 'fn " $one "." $name "(...)' for one") }
fn NoBuilder(ty String&, tok String&, hint String&) r.Msg { return r.Msg(Diag.NoBuilder, "D19", $ty " has no builder, case or member " $tok $hint) }
fn BuilderPrivate(ty String&, tok String&) r.Msg { return r.Msg(Diag.BuilderPrivate, "M6", $ty "'s builder " $tok " is private to its module") }
fn BuilderNotValue(tok String&) r.Msg { return r.Msg(Diag.BuilderNotValue, "T21", "the builder " $tok " is generic, so it is no value by its name alone", "", "call it, or pass a lambda calling it") }
fn ConstraintUnmetBuilder(ty String&, text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.ConstraintUnmetBuilder, "T30b", $ty " does not satisfy the constraint " $text1 " on " $text2 ": it has no builder " $text3 " that fits") }
fn FromBitsWidth(ty String&, u String&, got String&) r.Msg { return r.Msg(Diag.FromBitsWidth, "E33", $ty ".FromBits takes the " $u " of its width, and this is a " $got, "", "convert it first: '" $u "(x)'") }
fn AnyOfBuilderTrait(tr String&, tok String&) r.Msg { return r.Msg(Diag.AnyOfBuilderTrait, "T30b", $tr " requires the builder " $tok ", so it has no run-time value", "a builder takes no instance to dispatch on", "take the type as a constrained variable") }
fn MethodInUse(ty String&, text String&) r.Msg { return r.Msg(Diag.MethodInUse, "M21", $ty " already has a method " $text " in this module") }
fn LocalUnused(name String&) r.Msg { return r.Msg(Diag.LocalUnused, "D3b", $name " is declared and never read - read it, or leave the declaration out") }
fn LocalUnusedBare(name String&) r.Msg { return r.Msg(Diag.LocalUnusedBare, "D3b", $name " is never read - write '_' in its place") }
fn ImportUnused(alias String&, spec String&) r.Msg { return r.Msg(Diag.ImportUnused, "M5a", "nothing here is reached through " $alias " - remove 'import \"" $spec "\"'") }
fn UnderscoreDeclared() r.Msg { return r.Msg(Diag.UnderscoreDeclared, "D8c", "'_' discards a value and names nothing, so it cannot be declared") }
fn ShadowsGlobal(tok String&) r.Msg { return r.Msg(Diag.ShadowsGlobal, "D3a", $tok " is already declared in this module - a name means one thing in it") }
fn ShadowsFunction(tok String&) r.Msg { return r.Msg(Diag.ShadowsFunction, "D3a", $tok " names a function of this module - a name means one thing in it, so name this apart") }
fn ShadowsBuildConst(tok String&) r.Msg { return r.Msg(Diag.ShadowsBuildConst, "D3a", $tok " is a build constant - choose another name") }
fn PreludeConstRedeclared(tok String&) r.Msg { return r.Msg(Diag.PreludeConstRedeclared, "D3a", $tok " is a constant of the prelude - choose another name") }
fn PreludeFuncRedeclared(tok String&) r.Msg { return r.Msg(Diag.PreludeFuncRedeclared, "D3a", $tok " is the prelude's function, reached bare in every module - choose another name") }
fn ShadowsType(tok String&) r.Msg { return r.Msg(Diag.ShadowsType, "D3a", $tok " is a type's name - choose another") }
fn TypeHasNoConstructor(tok String&) r.Msg { return r.Msg(Diag.TypeHasNoConstructor, "", "type " $tok " has no constructor - an enum's values are its cases") }
fn MethodCalledAsFunction(tok String&, text String&) r.Msg { return r.Msg(Diag.MethodCalledAsFunction, "M19", $tok " is a method - call it on its receiver: x." $text "(...)") }
fn NotInModule(text String&, tok String&, hint String&) r.Msg { return r.Msg(Diag.NotInModule, "M9", $text " declares no " $tok $hint) }
fn VarIsPrivate(tok String&) r.Msg { return r.Msg(Diag.VarIsPrivate, "M6", $tok " is private to its module") }
fn ShiftUnadapted() r.Msg { return r.Msg(Diag.ShiftUnadapted, "E8a, E4a", "this shift is past its literal's width, and nothing adapts it to a wider type", "", "convert the literal, as I64(1) << 40") }
fn ScopeMayNotOutlive() r.Msg { return r.Msg(Diag.ScopeMayNotOutlive, "O10", "this reference lives in a scope that may not outlive where it is put") }
fn OwnCannotOutlive() r.Msg { return r.Msg(Diag.OwnCannotOutlive, "O10d", "this value lives in this function's own scope, which closes first") }
fn ArrayRunTimeIntoFixed(n I64) r.Msg { return r.Msg(Diag.ArrayRunTimeIntoFixed, "T7d", "a run-time-length array is stored where " $n " elements are laid out", "this array's length is known only at run time", "copy them through a slice of that length, 'v[0:" $n "]'") }
fn ArraySizeMismatch(n1 I64, n2 I64) r.Msg { return r.Msg(Diag.ArraySizeMismatch, "T7d", "an array of " $n1 " elements stored where " $n2 " are laid out", "", "fixed storage takes an array of its own length") }
fn LiteralRange(tok String&, ty String&) r.Msg { return r.Msg(Diag.LiteralRange, "T6", $tok " does not fit " $ty) }
fn ElemRefShape(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.ElemRefShape, "T25a", "expected " $ty1 ", found " $ty2 " - they differ in whether the elements are references") }
fn TypeMismatch(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.TypeMismatch, "E12", "expected " $ty1 ", found " $ty2) }
fn NumberDoesNotFlow(ty1 String&, ty2 String&, ty3 String&) r.Msg { return r.Msg(Diag.NumberDoesNotFlow, "T6b", $ty1 " does not flow into " $ty2 " - convert it, as " $ty3 "(x)") }
fn LiteralExprRange(ty String&) r.Msg { return r.Msg(Diag.LiteralExprRange, "E4a", "this literal expression's value does not fit " $ty) }
fn LiteralNeedsCtor(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.LiteralNeedsCtor, "T29d", "a value of " $ty1 " is made by its constructor - write " $ty2 "(...)") }
fn ReadOnlyToWritable() r.Msg { return r.Msg(Diag.ReadOnlyToWritable, "T25c", "a read-only reference cannot become writable - pass a writable one, or drop the 'mut'") }
fn ReadOnlyCopyDecl(ty String&, text String&) r.Msg { return r.Msg(Diag.ReadOnlyCopyDecl, "T25c", "this copies a read-only " $ty ", and a written type declares a writable one", "", "declare it with ':=' for a read-only copy, borrow it read-only, or make one of its own " $text) }
fn ReadOnlyCopyGlobal(ty String&, text String&) r.Msg { return r.Msg(Diag.ReadOnlyCopyGlobal, "T25c", "a mutable global holds no copy of a read-only " $ty, "", "give it one of its own, made " $text ", or drop its 'mut'") }
fn ReadOnlyCopyStored(ty String&, text String&) r.Msg { return r.Msg(Diag.ReadOnlyCopyStored, "T25c", "a copy of a read-only " $ty " cannot be stored where it can be written", "", "store one of its own, made " $text) }
fn ReadOnlyCopyReturned(ty String&, text String&) r.Msg { return r.Msg(Diag.ReadOnlyCopyReturned, "T25c", "a copy of a read-only " $ty " cannot be returned as a writable value", "", "return one of its own, made " $text ", or a read-only reference") }
fn ReadOnlyRefKept(text1 String&, text2 String&, ty String&) r.Msg { return r.Msg(Diag.ReadOnlyRefKept, "T25c", "'" $text1 "' keeps what its parameter '" $text2 "' reaches where it can be written", "this " $ty " is read-only", "pass a writable one") }
fn ReadOnlyCopyArg(text1 String&, text2 String&, ty String&, text3 String&) r.Msg { return r.Msg(Diag.ReadOnlyCopyArg, "T25c", "'" $text1 "' writes through or keeps its parameter '" $text2 "'", "this " $ty " is a read-only copy", "pass one of its own, made " $text3) }
fn ReadOnlyCopyLent(text String&) r.Msg { return r.Msg(Diag.ReadOnlyCopyLent, "T25c", "a read-only copy cannot be passed where it may be written - pass one of its own, made " $text) }
fn ReadOnlyCopyWrite() r.Msg { return r.Msg(Diag.ReadOnlyCopyWrite, "T25c", "this writes through a reference a read-only copy holds", "a copy of a place reached read-only writes nothing it shares") }
fn ReadOnlyFuncValue(text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.ReadOnlyFuncValue, "T25c", $text1 " cannot be a function value", "it writes through or keeps its by-value parameter '" $text2 "', and a caller of a function value may pass a read-only copy", "work on one of its own, made " $text3) }
fn NoteGroupFunctionType() r.Msg { return r.Msg(Diag.NoteGroupFunctionType, "", "a function type of several results or error items is parenthesized whole in a list: '(fn&(x I64) I64, I64)'") }
fn NoteReadOnlyCopy(text String&) r.Msg { return r.Msg(Diag.NoteReadOnlyCopy, "", "'" $text "' copies a place reached read-only, so it is read-only") }
fn NoteReadOnlyCopyOf(text1 String&, text2 String&, text3 String&, text4 String&) r.Msg { return r.Msg(Diag.NoteReadOnlyCopyOf, "", "'" $text1 "' copies '" $text2 "', reached read-only, so it is read-only - '" $text3 " := " $text4 ".Clone()' would be one of its own") }
fn TypeNotInferable() r.Msg { return r.Msg(Diag.TypeNotInferable, "D15", "':=' takes its type from the initializer, and a call returning nothing has none") }
fn DeclFromNull() r.Msg { return r.Msg(Diag.DeclFromNull, "D15", "':=' takes its type from the initializer, and null has none - write the type: 'x T?& = null'") }
fn BuildIntoCapture() r.Msg { return r.Msg(Diag.BuildIntoCapture, "T22c", "this call cannot build the argument where its callee keeps it", "the function given for the callee keeps this argument in what it captured", "make the argument in the caller and pass it in") }
fn BuildIntoUnknownScope() r.Msg { return r.Msg(Diag.BuildIntoUnknownScope, "O11, O12", "where this reference's referent lives is not known here", "the callee may build there", "put it in a local first, so its scope is found from it while the program runs (O29), or give it one known scope") }
fn StoreIntoUnknownScope() r.Msg { return r.Msg(Diag.StoreIntoUnknownScope, "O12", "where this place's references live is not known here", "so nothing new is built into it", "reach the place through a local, so its scope is found from it while the program runs (O29), or store what already lives there") }
fn TagUnknownScope(tok1 String&, tok2 String&) r.Msg { return r.Msg(Diag.TagUnknownScope, "O12", "where " $tok1 " lives is not known here, so nothing is declared to live there", "", "read it through " $tok2 ", or declare the local with ':='") }
fn BuildThroughUnknownScope() r.Msg { return r.Msg(Diag.BuildThroughUnknownScope, "C2d", "this builds through a field whose scope is not known here", "", "read the field into a local first, so its scope is found from it while the program runs (O29), or build where it lives") }
fn ReturnTypeMismatch(ty1 String&, ty2 String&) r.Msg { return r.Msg(Diag.ReturnTypeMismatch, "D8", "this function returns " $ty1 ", found " $ty2) }
fn ArgCount(n1 I64, text String&, n2 I64) r.Msg { return r.Msg(Diag.ArgCount, "E14", "expected " $n1 " argument" $text ", found " $n2) }
fn ArgCountRange(n1 I64, n2 I64, n3 I64) r.Msg { return r.Msg(Diag.ArgCountRange, "E14", "expected " $n1 " to " $n2 " arguments, found " $n3) }
fn SpreadCount() r.Msg { return r.Msg(Diag.SpreadCount, "D8d", "these results are passed as the arguments, so there must be as many", "", "destructure them first: 'a, b := g()'") }
fn ScopeArgsDisagree() r.Msg { return r.Msg(Diag.ScopeArgsDisagree, "O25e", "these arguments live in different scopes, and the call needs them in one", "", "make them where one of them lives") }
fn BorrowSplitScopes() r.Msg { return r.Msg(Diag.BorrowSplitScopes, "O17", "this value's references live where its own storage does not", "the callee can store through it", "declare it a reference ('x T& = ...')") }
fn SliceSplitValue() r.Msg { return r.Msg(Diag.SliceSplitValue, "O17a", "this value is not sliced or viewed", "its references live where its own storage does not", "index the value itself, or lend it whole to a call") }
fn BorrowSplitValue() r.Msg { return r.Msg(Diag.BorrowSplitValue, "O17a", "this value is not held by reference", "its references live where its own storage does not", "use the value itself") }
fn BorrowSplitParam(name String&) r.Msg { return r.Msg(Diag.BorrowSplitParam, "O17a, T13b", "'" $name "' is not held by reference", "it holds references to the caller's storage while its own storage is this call's", "use '" $name "' itself, or take its value where it is mentioned last, declaring its type ('w T = " $name "')") }
fn FieldBindingUnknown() r.Msg { return r.Msg(Diag.FieldBindingUnknown, "O23, O11", "this stores into a field whose binding is not known through this path", "", "store through a variable holding the instance") }
fn FieldSetPrecompiled(field String&) r.Msg { return r.Msg(Diag.FieldSetPrecompiled, "B3i, O23", "this stores into '" $field "' through a path with no known binding", "the instance's binding is not known through this path, and a precompiled module declares the field: only that module's own code decides what it may be given", "store through a variable holding the instance, or store a copy ('x.Copy()')") }
fn ScopeObligationUnmet() r.Msg { return r.Msg(Diag.ScopeObligationUnmet, "O10c", "the callee needs one argument's scope to outlive another's", "nothing here shows it", "pass them from one scope") }
fn ReferenceNarrowed() r.Msg { return r.Msg(Diag.ReferenceNarrowed, "O25", "a reference never narrows - declare it with ':=' from what it is given") }
fn ReferenceNarrowedLocal(text String&) r.Msg { return r.Msg(Diag.ReferenceNarrowedLocal, "O25", "a reference never narrows", "'" $text "' lives in a block that closes first, and this keeps it longer") }
fn RefTypevarNotAggregate(ty String&, text String&) r.Msg { return r.Msg(Diag.RefTypevarNotAggregate, "G11", $ty " cannot be held through '" $text "&' - only a struct, an enum or an array can") }
fn NullableMeetsNoTrait(text1 String&, text2 String&, text3 String&, text4 String&) r.Msg { return r.Msg(Diag.NullableMeetsNoTrait, "T2c", $text1 " may be null, so it meets no trait", $text3 " must meet " $text2 " here", "write " $text4 ", which never is") }
fn TypeArgsNotInferable(text String&) r.Msg { return r.Msg(Diag.TypeArgsNotInferable, "G9", "the type arguments of " $text " cannot be inferred from these arguments") }
fn LengthNotInferable(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.LengthNotInferable, "G29", "'" $text1 "' takes an array by value whose length its body decides on", "this argument gives no length ('" $text2 "')", "give it an array, or take the parameter as '&'") }
fn CtorTypeArgsNotInferable(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.CtorTypeArgsNotInferable, "G10c", "the type arguments of " $text1 " cannot be inferred from these arguments", "", "write them: " $text2 "<...>(...)") }
fn CtorVarsNotInferable(text String&) r.Msg { return r.Msg(Diag.CtorVarsNotInferable, "G10d", "what " $text "'s constructor introduces cannot be inferred from these arguments") }
fn CtorFieldNamesVar(tok String&, text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.CtorFieldNamesVar, "G10d", "the type of field " $tok " names " $text1 ", which only the constructor introduces", "", "for a field to hold it, declare it the type's parameter: 'type " $text2 "<" $text3 ">'") }
fn CtorGenericInferredField(tok String&, text String&) r.Msg { return r.Msg(Diag.CtorGenericInferredField, "G10d", "field " $tok " takes its type from ':=', and the constructor introduces " $text, "so the body is checked per call", "write the field's type") }
fn CtorVarOfGeneric(text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.CtorVarOfGeneric, "G10d", $text1 " is not one of " $text2 "'s parameters", "a generic type's constructor introduces none of its own", "add " $text3 " to the type's list") }
fn DefaultArgNoDefault(text String&) r.Msg { return r.Msg(Diag.DefaultArgNoDefault, "E14a", "parameter " $text " declares no default, so 'default' cannot stand in for it") }
fn NamedArgUnknown(tok String&, text String&) r.Msg { return r.Msg(Diag.NamedArgUnknown, "E14b", $tok " names no parameter of " $text) }
fn NamedArgUnknownMeant(tok String&, text String&, best String&) r.Msg { return r.Msg(Diag.NamedArgUnknownMeant, "E14b", $tok " names no parameter of " $text " - did you mean '" $best "'?") }
fn NamedArgRequired(tok String&) r.Msg { return r.Msg(Diag.NamedArgRequired, "E14b", "parameter " $tok " declares no default, so it is given by position, not by name") }
fn NamedArgTwice(tok String&) r.Msg { return r.Msg(Diag.NamedArgTwice, "E14b", "parameter " $tok " is named twice") }
fn NamedArgAlsoPositional(tok String&) r.Msg { return r.Msg(Diag.NamedArgAlsoPositional, "E14b", "parameter " $tok " is given by position already") }
fn PositionalAfterNamed() r.Msg { return r.Msg(Diag.PositionalAfterNamed, "E14b", "an argument by position comes before every argument by name") }
fn NamedArgThroughValue() r.Msg { return r.Msg(Diag.NamedArgThroughValue, "E14b", "a call through a function value takes its arguments by position", "a function type names no parameters") }
fn NamedArgNotHere() r.Msg { return r.Msg(Diag.NamedArgNotHere, "E14b", "an argument by name is for a defaulted parameter in a call", "it gives a function's, a method's or a constructor's defaulted parameter") }
fn TestTargetUnknown(text String&) r.Msg { return r.Msg(Diag.TestTargetUnknown, "B7a", "a test names a function, a type or Type.Method of its file, and '" $text "' is none") }
fn TestTargetUnknownMeant(text String&, best String&) r.Msg { return r.Msg(Diag.TestTargetUnknownMeant, "B7a", "a test target '" $text "' is none of its file's - did you mean '" $best "'?", "a test names a function, a type or Type.Method of its file") }
fn TestTargetElsewhere(text String&) r.Msg { return r.Msg(Diag.TestTargetElsewhere, "B7a", "'" $text "' is declared in another file", "a test is an example of its own file's code, written beside it") }
fn TestTargetTwice(text String&) r.Msg { return r.Msg(Diag.TestTargetTwice, "B7a", "this file has a test of " $text " described so already - tell them apart by their descriptions") }
fn AtomicNotPlace() r.Msg { return r.Msg(Diag.AtomicNotPlace, "P9", "an atomic operation acts on a place - a variable, a field or an element") }
fn AtomicNotWritable() r.Msg { return r.Msg(Diag.AtomicNotWritable, "P9", "this atomic operation writes its place, which must be writable") }

# the prelude's vacate() on what is no writable place (docs/memory.md 3.4)
fn VacateNotPlace() r.Msg { return r.Msg(Diag.VacateNotPlace, "M19d", "vacate() empties a place - a writable variable, field or element") }

