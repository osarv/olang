fn AssertAborts(text String&) r.Msg { return r.Msg(Diag.AssertAborts, "S18c", "this assertion aborts the program, evaluated while compiling", $text) }
fn GlobalAborts(text String&) r.Msg { return r.Msg(Diag.GlobalAborts, "K2", "this global's initializer aborts the program, evaluated while compiling", $text) }
fn VecViewStale(text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.VecViewStale, "M19g", "'" $text1 "' holds a view of '" $text2 "' taken before '" $text3 "' may have grown") }
fn VecHiddenViewStale(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.VecHiddenViewStale, "M19g", "this reads a view of '" $text1 "' taken before '" $text2 "' may have grown") }
fn VecViewGivenGrowing(text1 String&, text2 String&, text3 String&, copy String&) r.Msg { return r.Msg(Diag.VecViewGivenGrowing, "M19g", "this view of '" $text1 "' is given to " $text2 ", which may grow '" $text3 "' - " $copy) }
fn VecGrowsUnderTask(text1 String&, copy String&) r.Msg { return r.Msg(Diag.VecGrowsUnderTask, "M19g", "'" $text1 "' may grow here while a task holds a view of it - give the task " $copy) }
fn AssertStale(text String&) r.Msg { return r.Msg(Diag.AssertStale, "S18c, K1", "evaluated while compiling, this assertion stops on a stale view", $text) }
fn GlobalStale(text String&) r.Msg { return r.Msg(Diag.GlobalStale, "K2, K1", "evaluated while compiling, this global's initializer stops on a stale view", $text) }
fn CondTooDeep(n I64) r.Msg { return r.Msg(Diag.CondTooDeep, "B9c", "conditions decide branches holding further conditions more than " $n " levels deep") }
fn MainSignature() r.Msg { return r.Msg(Diag.MainSignature, "B4", "main takes no parameters and returns no value: 'fn main() { }', or 'fn main() ? { }'") }
fn NoteObligationOrigin() r.Msg { return r.Msg(Diag.NoteObligationOrigin, "", "the callee requires it because of this statement") }
fn NoteMakeWhere(text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.NoteMakeWhere, "", "'" $text1 "' is made here by '" $text3 "', in a block that closes first - declare it where '" $text2 "' lives and assign it here") }
fn NoteRefillKept(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.NoteRefillKept, "", "or refill the one kept - '" $text1 ".Clear()', then put the elements in: one made where '" $text2 "' lives stays there, beside every one made before it, until that scope closes") }
fn NoteParamCopy(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.NoteParamCopy, "", "'" $text1 "' is the call's own copy of its argument - take it by reference to give back what the caller passed: '" $text2 "'") }
fn NoteAssignedHere(name String&) r.Msg { return r.Msg(Diag.NoteAssignedHere, "", "'" $name "' is given a value here") }
fn NoteBindingWhere(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.NoteBindingWhere, "", "'" $text1 "' is bound here to what the matched value holds, which lives in a block that closes first - make that where '" $text2 "' lives") }
fn NoteDeclareWhere(text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.NoteDeclareWhere, "", "'" $text1 "' is declared here, in a block that closes first - declare it where '" $text2 "' lives, '" $text1 " " $text3 "&', and assign it here") }
fn NoteLoopCopyLent(text String&) r.Msg { return r.Msg(Diag.NoteLoopCopyLent, "", "'" $text "' is the loop's copy of an element, in the loop's block - a call it is lent to by reference ties what it builds to that copy: take that parameter by value, or build from its fields here") }
fn NoteViewRefusedBy() r.Msg { return r.Msg(Diag.NoteViewRefusedBy, "", "the callee is no view of the element because of this statement") }
fn NoteHeldIndexWhere(text String&) r.Msg { return r.Msg(Diag.NoteHeldIndexWhere, "", "the index is held here, for both the read and the write, in a block that closes first - make it where '" $text "' lives first, then index with it") }
fn NoteCondValue() r.Msg { return r.Msg(Diag.NoteCondValue, "", "this is the value that does not fit - each value a conditional or a match gives is stored as though alone (E28)") }
fn NoteSliceOfTemporary() r.Msg { return r.Msg(Diag.NoteSliceOfTemporary, "", "this borrows a value made here, which lives only in this block - keep a copy of what the slice shows ('$x', 'x.Copy()')") }
fn NoteTextCopyWhere(text String&) r.Msg { return r.Msg(Diag.NoteTextCopyWhere, "", "this text lives in a block that closes first - pass a copy, which is made where '" $text "' lives: write '$' before it") }
fn NoteLoopCopy(text1 String&, text2 String&, text3 String&) r.Msg { return r.Msg(Diag.NoteLoopCopy, "", "'" $text1 "' is the loop's copy of an element, made in the loop's block - lend the element itself: '" $text2 "[i]', with 'for i in range " $text3 ".Len()'") }
fn CondUndecidable(text String&) r.Msg { return r.Msg(Diag.CondUndecidable, "B9c", "this top-level condition cannot be decided while compiling", $text) }
fn CondUnseen() r.Msg { return r.Msg(Diag.CondUnseen, "B9c", "this top-level condition uses what exists only in the branches it decides, or does not check") }
fn CondUnknownBuild(text String&) r.Msg { return r.Msg(Diag.CondUnknownBuild, "B10", "unknown name " $text) }
fn CondDecidedNotBool() r.Msg { return r.Msg(Diag.CondDecidedNotBool, "B9", "a top-level condition is true or false") }
fn GlobalReadsItself(text1 String&, text2 String&) r.Msg { return r.Msg(Diag.GlobalReadsItself, "B5a", $text1 "'s initializer reads " $text2 ", which is not set until the initializer is done") }
fn GlobalsCycle(text String&) r.Msg { return r.Msg(Diag.GlobalsCycle, "B5a", "these globals' initializers read each other, so none can be set first: " $text) }
fn ModuleIdentityClash(text String&) r.Msg { return r.Msg(Diag.ModuleIdentityClash, "M22a", "this module has the same identity as " $text " - rename one, or import it by a relative path") }

