fn ApiNoSide(text String&) r.Msg { return r.Msg(Diag.ApiNoSide, "B21", "'" $text "' is neither a path nor a commit of the repository here") }
fn ApiNoFiles(text String&) r.Msg { return r.Msg(Diag.ApiNoFiles, "B21", "'" $text "' names no .olang file on either side") }
fn ColumnsNotRecord(ty String&, row String&, why String&) r.Msg { return r.Msg(Diag.ColumnsNotRecord, "T7e", $ty " takes a record for its rows, and " $row " " $why, "a record is a struct whose constructor declares exactly its fields, each a parameter written bare", "write 'type P struct(X F32, Y F32) { X, Y }'") }
fn ColumnNamedLikeMethod(ty String&, row String&, name String&) r.Msg { return r.Msg(Diag.ColumnNamedLikeMethod, "T7e", $row "'s field '" $name "' would be a column of " $ty " named like its method", "a field may not share a method's name '" $name "' (M19)", "rename the field") }
fn ColumnAssigned() r.Msg { return r.Msg(Diag.ColumnAssigned, "T7e", "a column is assigned whole only alone - 'c.x = v', its length checked against its table's") }
fn TraitMethodEffect(ty String&, tok String&, does String&, tr String&, word String&) r.Msg { return r.Msg(Diag.TraitMethodEffect, "T30c, T22b", $ty "'s " $tok " may " $does ", and " $tr "'s " $tok " promises '" $word "'", "every call through an 'any " $tr "&' relies on it", "give " $ty " a method that does not, or take '" $word "' off the trait's method") }
fn TraitMethodBeyondField(ty String&, tok String&, does String&, tr String&) r.Msg { return r.Msg(Diag.TraitMethodBeyondField, "T30c, T22b", $ty "'s " $tok " " $does, "no promise of " $tr "'s " $tok " can say that", "call it directly, or through generic code") }
fn TraitMethodBeyond(ty String&, tok String&, does String&, tr String&, word String&) r.Msg { return r.Msg(Diag.TraitMethodBeyond, "T30c, T22b", $ty "'s " $tok " " $does ", and " $tr "'s " $tok " says nothing of that", "", "write '" $word "' after its signature in the trait") }

test "a message is its text, its arguments in their places" {
    m := Expected("'}'", Tok("South"))
    assert m.Text == "expected '}', found 'South'" and m.Rule == "" and m.Kind == Diag.Expected
    assert UnknownChar('@').Rule == "L16"
    assert NoMain().Text == "no main function - a program starts at 'fn main() { }'"
}

test "a byte that does not print is escaped, in a character and in a token" {
    assert UnknownChar('\t').Text == "unexpected character '\\t'"
    assert Esc(Char(1)) == "\\x01" and Esc(Char(200)) == "\\xc8" and Esc('a') == "a"
    assert Tok("a\nb") == "'a\\nb'"
    assert Expected("a name", EndOfLine).Text == "expected a name, found end of line"
}
