# ERR_MAIN_SIGNATURE
fn MainSignature() Msg { return Msg(Diag.MainSignature, "B4", "main takes no parameters, returns no value and declares '?': 'fn main() ? { }'") }

# NOTE_OBLIGATION_ORIGIN
fn NoteObligationOrigin() Msg { return Msg(Diag.NoteObligationOrigin, "", "the callee requires it because of this statement") }

# NOTE_MAKE_WHERE
fn NoteMakeWhere(text1 String&, text2 String&, text3 String&, text4 String&) Msg { return Msg(Diag.NoteMakeWhere, "", "'" $text1 "' is made here, in a block that closes first - make it where '" $text2 "' lives: '" $text3 "&" $text4 "(...)'") }

# NOTE_REFILL_KEPT
fn NoteRefillKept(text1 String&, text2 String&) Msg { return Msg(Diag.NoteRefillKept, "", "or refill the one kept - '" $text1 ".Clear()', then put the elements in: one made where '" $text2 "' lives stays there, beside every one made before it, until that scope closes") }

# NOTE_DECLARE_WHERE
fn NoteDeclareWhere(text1 String&, text2 String&, text3 String&, text4 String&, text5 String&) Msg { return Msg(Diag.NoteDeclareWhere, "", "'" $text1 "' is declared here, in a block that closes first - declare it where '" $text2 "' lives: '" $text3 " " $text4 "&" $text5 " = ...'") }

# NOTE_LOOP_COPY_LENT
fn NoteLoopCopyLent(text String&) Msg { return Msg(Diag.NoteLoopCopyLent, "", "'" $text "' is the loop's copy of an element, in the loop's block - a call it is lent to by reference ties what it builds to that copy: take that parameter by value, or build from its fields here") }

# NOTE_VIEW_REFUSED_BY
fn NoteViewRefusedBy() Msg { return Msg(Diag.NoteViewRefusedBy, "", "the callee is no view of the element because of this statement") }

# NOTE_HELD_INDEX_WHERE
fn NoteHeldIndexWhere(text String&) Msg { return Msg(Diag.NoteHeldIndexWhere, "", "the index is held here, for both the read and the write, in a block that closes first - make it where '" $text "' lives first, then index with it") }

# NOTE_COND_VALUE
fn NoteCondValue() Msg { return Msg(Diag.NoteCondValue, "", "this is the value that does not fit - each value a conditional or a match gives is stored as though alone (E28)") }

# NOTE_SLICE_OF_TEMPORARY
fn NoteSliceOfTemporary() Msg { return Msg(Diag.NoteSliceOfTemporary, "", "this borrows a value made here, which lives only in this block - make the value where the borrow is kept ('x T&c = ...'), then slice or view that") }

# NOTE_TEXT_COPY_WHERE
fn NoteTextCopyWhere(text String&) Msg { return Msg(Diag.NoteTextCopyWhere, "", "this text lives in a block that closes first - pass a copy, which is made where '" $text "' lives: write '$' before it") }

# NOTE_LOOP_COPY
fn NoteLoopCopy(text1 String&, text2 String&, text3 String&) Msg { return Msg(Diag.NoteLoopCopy, "", "'" $text1 "' is the loop's copy of an element, made in the loop's block - lend the element itself: '" $text2 "[i]', with 'for i in range " $text3 ".Len()'") }

# ERR_COND_UNDECIDABLE
fn CondUndecidable(text String&) Msg { return Msg(Diag.CondUndecidable, "B9c", "this top-level condition cannot be decided while compiling: " $text) }

# ERR_COND_UNSEEN
fn CondUnseen() Msg { return Msg(Diag.CondUnseen, "B9c", "this top-level condition uses what exists only in the branches it decides, or does not check") }

# ERR_COND_UNKNOWN_BUILD
fn CondUnknownBuild(text String&) Msg { return Msg(Diag.CondUnknownBuild, "B10", "unknown name " $text) }

# ERR_COND_DECIDED_NOT_BOOL
fn CondDecidedNotBool() Msg { return Msg(Diag.CondDecidedNotBool, "B9", "a top-level condition is true or false") }

# ERR_GLOBAL_READS_ITSELF
fn GlobalReadsItself(text1 String&, text2 String&) Msg { return Msg(Diag.GlobalReadsItself, "B5a", $text1 "'s initializer reads " $text2 ", which is not set until the initializer is done") }

# ERR_GLOBALS_CYCLE
fn GlobalsCycle(text String&) Msg { return Msg(Diag.GlobalsCycle, "B5a", "these globals' initializers read each other, so none can be set first: " $text) }

# ERR_MODULE_IDENTITY_CLASH
fn ModuleIdentityClash(text String&) Msg { return Msg(Diag.ModuleIdentityClash, "M22a", "this module has the same identity as " $text " - rename one, or import it by a relative path") }

# ---- tests ----

test "a message is its C twin's text, its arguments in their places" {
    m := Expected("'}'", Tok("South"))
    assert m.Text == "expected '}', found 'South'" and m.Rule == "" and m.Kind == Diag.Expected
    assert UnknownChar('@').Rule == "L16"
    assert NoMain().Text == "no main function - a program starts at 'fn main() ? { }'"
}

test "a byte that does not print is escaped, in a character and in a token" {
    assert UnknownChar('\t').Text == "unexpected character '\\t'"
    assert Esc(Char(1)) == "\\x01" and Esc(Char(200)) == "\\xc8" and Esc('a') == "a"
    assert Tok("a\nb") == "'a\\nb'"
    assert Expected("a name", EndOfLine).Text == "expected a name, found end of line"
}
