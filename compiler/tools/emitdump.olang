# emitdump - a program checked by the self-hosted checker, lowered (compiler/lower.olang) and written as LLVM IR by the
# self-hosted emitter (compiler/emit.olang): M9's tool, as lowerdump is M7's.
#
#     emitdump [-D NAME=VALUE]... [-t] [-standin] [-o OUT.ll] FILE
#     emitdump -rt DIR
#
# The program whose root is FILE - with -t its test blocks run by the harness, else its main - written as one LLVM
# module to OUT.ll (FILE's base name with ".ll" in build/ by default), placed by the scope pass's plans
# (compiler/scope.olang, M6), with -standin by lowering's stand-in placement instead. On standard error, the check's
# errors when there are any (the module is written still, a body they left wrong a function failing when called), and
# a line "gap WHAT" for each construct emission does not emit yet. Compile the module with the filled-in runtime beside
# it (stage 0 leaves one in build/, olang_runtime.HASH.ll): clang -O1 OUT.ll RUNTIME.ll -o PROG -lm -lpthread -ldl.
# With -rt, the runtime itself filled in for this machine (emit.RuntimeIR): DIR/olang_runtime.ll and DIR/olang_dyncall.ll.

import "std/os"
import "std/io"
import "std/pair"
import "../source"
import "../diag"
import "../cond"
import "../fetch"
import "../load"
import "../lower"
import "../scope"
import "../typed"
import "../interp"
import "../emit"
import "../target"

fn main() ? {
    args := os.Args()
    if args.Len() < 2 {
        try io.PrintErrln("usage: emitdump [-D NAME=VALUE]... [-t] [-standin] [-o OUT.ll] FILE") catch io.IoError { }
        os.Exit(2)
    }
    os.RunOnStack(1 << 30, fn() { run(args) })
}

fn run(args Array<String&>&) {
    std := try os.Env("OLANG_STD") catch default "std"
    defines List<String&>
    testBuild := false
    standin := false
    outPath String&args = ""
    k I64 = 1
    for k < args.Len() and args[k].StartsWith("-") and args[k] != "-rt" {
        if args[k] == "-t" {
            testBuild = true
        } else if args[k] == "-standin" {
            standin = true
        } else if args[k] == "-D" and k + 1 < args.Len() {
            k++
            defines.Push(args[k])
        } else if args[k] == "-o" and k + 1 < args.Len() {
            k++
            outPath = args[k]
        }
        k++
    }
    if k + 1 < args.Len() and args[k] == "-rt" {
        runtimeFiles(std, args[k + 1])
        return
    }
    if k >= args.Len() { os.Exit(2) }
    path := args[k]
    d := diag.Diagnostics(false)
    consts := cond.Consts()
    # B12: built for this machine, as stage 0 builds by default - what the target constants say and every function
    # carries
    tg := try target.Resolve("native", target.FindClang(), false, d) catch target.Bad {
        try io.PrintErr(d.Render()) catch io.IoError { }
        os.Exit(1)
    }
    consts.Builtins(tg.Os, tg.Arch, tg.Cpu, tg.VectorBits, 1 if tg.Fma else 0, false, false, testBuild)
    for f in defines { try consts.Define(f, d) catch { } }
    f := fetch.Fetcher(load.LockPath(path), fetch.CacheDir(), fetch.GitBase(), false, true)
    l := load.Loader(std, consts, f, source.Names(), d)
    l.Load(path)
    # checked with the build's decisions made by evaluation (B9c, S8b)
    c := interp.Analyze(l, testBuild)
    p := c.P
    # the asserts the evaluator decides while compiling (S18c): a true one is not tested at run time
    asserts Map<pair.Pair<I64, I64>, Bool>
    interp.DecideAsserts(c, asserts)
    # what checking said, and the program written anyway: a body checking left wrong is a function that says so when
    # it is called (the self-hosted checker is still being finished, M5b/M5c)
    if d.Count() > 0 { try io.PrintErr(d.Render()) catch io.IoError { } }
    lw := lower.Lowerer(p, c.Bodies)
    lw.AssertsTrue = asserts
    # placed by the scope pass (M6); its own errors, which stage 0's checker reports while checking, are not shown. A
    # body it erred in (an over-rejection, while the pass is being finished) is placed by the stand-in placement, its
    # plan not one to trust
    sc := scope.Scoper(p, c.Bodies)
    if not standin {
        sc.Run()
        upto := d.RecordCount()
        for b in range c.Bodies.Len() {
            body := c.Bodies[b]
            if d.ErrorWithin(body.File, I64(body.Sp.Start), I64(body.Sp.End), upto) { sc.Plans[b] = typed.NewPlan(body) }
        }
        lw.Plans = sc.Plans
    }
    e := emit.Emitter(p, lw, d, p.T)
    e.Tests = testBuild
    e.Attrs = tg.Attrs
    if outPath == "" {
        base := path
        s := try base.FindLast("/") catch default -1
        base = base[s + 1:]
        if base.EndsWith(".olang") { base = base[:base.Len() - 6] }
        outPath = "build/" $base ".ll"
    }
    fd := try os.Create(outPath) catch os.OsError {
        try io.PrintErrln("emitdump: cannot write " $outPath) catch io.IoError { }
        os.Exit(1)
    }
    w := io.Writer(fd)
    e.Program(w)
    try w.Flush() catch io.IoError { os.Exit(1) }
    try os.Close(fd) catch os.OsError { }
    for g in e.Gaps { try io.PrintErrln("gap " $g) catch io.IoError { } }
    for g in lw.Gaps { try io.PrintErrln("lower gap " $d.Locate(g.File, I64(g.Sp.Start)) " " $g.What) catch io.IoError { } }
}

# the runtime's files filled in for this machine (B12), written into dir
fn runtimeFiles(std String&, dir String&) {
    d := diag.Diagnostics(false)
    tg := try target.Resolve("native", target.FindClang(), false, d) catch target.Bad {
        try io.PrintErr(d.Render()) catch io.IoError { }
        os.Exit(1)
    }
    core := filled(std, "runtime", tg.Arch)
    write($dir "/olang_runtime.ll", emit.RuntimeModule(core, tg.Arch, tg.Attrs))
    # the dynamic call's object: the runtime as a module carries it, then its own text (S3)
    write($dir "/olang_dyncall.ll", emit.RuntimeModule($emit.RuntimeDecls(core) $filled(std, "dyncall", tg.Arch) "\n" $emit.RuntimeMetadata(core), tg.Arch, tg.Attrs))
}

fn filled(std String&, name String&, arch String&) String {
    text := try os.ReadFile($std "/runtime/" $name ".ll") catch os.OsError {
        try io.PrintErrln("emitdump: cannot read " $std "/runtime/" $name ".ll") catch io.IoError { }
        os.Exit(1)
    }
    return try emit.RuntimeFill(text, arch, false) catch emit.RuntimeError {
        try io.PrintErrln("emitdump: " $std "/runtime/" $name ".ll is malformed") catch io.IoError { }
        os.Exit(1)
    }
}

fn write(path String&, text String&) {
    try os.WriteFile(path, text) catch os.OsError {
        try io.PrintErrln("emitdump: cannot write " $path) catch io.IoError { }
        os.Exit(1)
    }
}
