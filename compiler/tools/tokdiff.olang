# tokdiff [FILE...] - compares the self-hosted scanner's token stream with the C tokenizer's (compiler/DESIGN.md
# section 4): every token's line and text, every statement end, and every lexical error's rule and position. With no
# FILE, every .olang file of the repository. Prints the first differences and exits 1 if there are any.
#
# Run from the repository root after "make build/tokdump build/compiler_tools_dump". The one documented difference is
# normalized away: the C tokenizer puts a statement end before a "catch" beginning a line, which its parser skips; the
# scanner puts none there (R9b).

import "std/os"
import "toolkit"

fn main() {
    files := toolkit.FilesOr(os.Args(), toolkit.Tracked("*.olang"))
    oracle := "build/tokdump"
    dump := "build/compiler_tools_dump"
    work := toolkit.Scratch("tokdiff")
    defer toolkit.Clean(work)
    args := List<String&>()
    args.Push(oracle)
    for f in files { args.Push(f) }
    c := normalize(toolkit.RunShowing(args.ToArray()).Stdout)
    args.Clear()
    args.Push(dump)
    args.Push("tokens")
    for f in files { args.Push(f) }
    olang := toolkit.RunShowing(args.ToArray()).Stdout
    if c == olang {
        toolkit.Say("tokdiff: no difference over " $files.Len() " files\n")
        return
    }
    toolkit.Say(toolkit.Head(toolkit.Diff(work, c, olang), 40))
    toolkit.Say("tokdiff: the streams differ\n")
    os.Exit(1)
}

# the C tokenizer's rendering reduced to what the scanner's is: its diagnostics as "error RULE LINE:COL", and a statement
# end dropped where "catch" follows it
fn normalize(raw String&) String {
    out := List<String&>()
    pending String& = ""
    diag := false
    for line in toolkit.Rows(raw) {
        if line.StartsWith("== ") {
            if pending != "" { out.Push(pending) }
            pending = ""
            diag = false
            out.Push($line)
            continue
        }
        if line == "-- diagnostics" {
            if pending != "" { out.Push(pending) }
            pending = ""
            diag = true
            continue
        }
        if diag {
            row := diagRow(line)
            if row != "" { out.Push(row) }
            continue
        }
        text := toolkit.AfterSpace(line)
        if pending != "" {
            if text != "catch" { out.Push(pending) }
            pending = ""
        }
        if text == ";" {
            pending = $line
            continue
        }
        out.Push($line)
    }
    if pending != "" { out.Push(pending) }
    return toolkit.Text(out)
}

# "error RULE LINE:COL" of a diagnostic row "path:LINE:COL: error[RULE]: text", "" for a row of another shape
fn diagRow(line String&) String {
    e := try line.Find(": error[") catch default -1
    if e < 0 { return "" }
    close := try line[e:].FindByte(']') catch default -1
    if close < 0 { return "" }
    head := line[0:e]
    # the position is the last two colon-separated numbers of what comes before
    c2 := try head.FindLast(":") catch default -1
    if c2 < 0 { return "" }
    c1 := try head[0:c2].FindLast(":") catch default -1
    if c1 < 0 { return "" }
    if not toolkit.IsNumber(head[c2 + 1:]) or not toolkit.IsNumber(head[c1 + 1:c2]) { return "" }
    return "error " $line[e + 8:e + close] " " $head[c1 + 1:]
}

test "diagnostic rows are reduced to rule and position" {
    assert diagRow("a/b.olang:3:14: error[L5]: bad") == "error L5 3:14"
    assert diagRow("a/b.olang:3:14: error: bad") == ""
    assert diagRow("  note") == ""
}

test "a statement end before catch is dropped" {
    assert normalize("== f\n3 x\n3 ;\n4 catch\n4 y\n") == "== f\n3 x\n4 catch\n4 y\n"
    assert normalize("== f\n3 ;\n4 z\n") == "== f\n3 ;\n4 z\n"
    assert normalize("== f\n3 ;\n-- diagnostics\nf:1:2: error[L1]: m\nf:x\n") == "== f\n3 ;\nerror L1 1:2\n"
}
