# toolkit - what the compiler's acceptance tools share (they were shell scripts: tokdiff, astdiff, namesdiff, layoutdiff,
# layoutgold, modgraph, diaggold_capture). Running a program without a shell, reading a program's text as rows, a
# scratch directory, the files an acceptance tool runs over, and diff(1)'s report of two texts.

import "std/os"
import "std/io"

# ---- saying ----

# t on standard output, whole - a failed write is not worth stopping a report for
fn Say(t String&) {
    try io.Print(t) catch io.Error { }
}

# t on standard error
fn Warn(t String&) {
    try io.PrintErr(t) catch io.Error { }
}

# says why on standard output and ends with status 1: the tool did not run to its end
fn Die(why String&) noreturn {
    Say($why "\n")
    os.Exit(1)
}

# ---- running programs ----

# runs args[0] with args, in dir when it is not "", with the environment extended by env ("NAME=value" each), and gives
# what it did. A program that cannot be started ends the tool, saying so
fn Run(args Array<String&>&, env Array<String&>& = Array<String&>(0), dir String& = "") os.Output {
    full := Vec<String&>()
    if env.Len() > 0 {
        full.Push("env")
        for e in env { full.Push(e) }
    }
    for a in args { full.Push(a) }
    o := try os.Exec(...full.ToArray(), dir = dir) catch os.Error {
        Die("cannot run " $args[0])
        unreachable
    }
    return o
}

# the same, with what the program wrote to standard error passed on to ours
fn RunShowing(args Array<String&>&, env Array<String&>& = Array<String&>(0), dir String& = "") os.Output {
    o := Run(args, env, dir)
    if o.Stderr.Len() > 0 { Warn(o.Stderr) }
    return o
}

# the value of an environment variable, else fallback
fn Env(name String&, fallback String&) String {
    v := try os.Env(name) catch os.Error { return $fallback }
    if v.Len() > 0 { return $v }
    return $fallback
}

# ---- text as rows ----

# the rows of a text as awk reads them: split at each newline, the last row needing none, an empty text having none
fn Rows(t String&) Vec<String&> {
    rows := Vec<String&>()
    at I64 = 0
    for at < t.Len() {
        nl := try t[at:].FindByte('\n') catch default (t.Len() - at)
        rows.Push(t[at:at + nl])
        at += nl + 1
    }
    return rows
}

# the rows joined, a newline after each
fn Text(rows Vec<String&>&) String {
    b := StringBuilder()
    for r in rows {
        b.Push(r)
        b.PushChar('\n')
    }
    return b.ToString()
}

# the rows sorted by bytes (LC_ALL=C sort)
fn Sorted(rows Vec<String&>&) Vec<String&> {
    l := Vec<String&>()
    for r in rows { l.Push(r) }
    l.Sort(fn(a String&, b String&) Bool { return a < b })
    return l
}

# where text starts after its first space, else the whole of it - awk's substr($0, index($0, " ") + 1)
fn AfterSpace(t String&) String&t {
    sp := try t.FindByte(' ') catch default -1
    return t[sp + 1:]
}

# whether t is a nonempty run of digits
fn IsNumber(t String&) Bool {
    if t.Len() == 0 { return false }
    for c in t {
        if not c.IsDigit() { return false }
    }
    return true
}

# the whitespace-separated words of a row, as awk's fields are
fn Fields(t String&) Vec<String&> {
    f := Vec<String&>()
    i I64 = 0
    for i < t.Len() {
        for i < t.Len() and (t[i] == ' ' or t[i] == '\t') { i++ }
        s := i
        for i < t.Len() and t[i] != ' ' and t[i] != '\t' { i++ }
        if i > s { f.Push(t[s:i]) }
    }
    return f
}

# ---- files ----

# a new scratch directory; the tool ends if there is none. Removing it is the caller's (Clean)
fn Scratch(name String&) String& {
    return try os.MkTemp("", $name ".") catch os.Error {
        Die($name ": no scratch directory")
        unreachable
    }
}

# removes a scratch directory
fn Clean(dir String&) {
    try os.RemoveAll(dir) catch os.Error { }
}

# writes a file; the tool ends if it cannot
fn Write(path String&, text String&) {
    try os.WriteFile(path, text) catch os.Error { Die("cannot write " $path) }
}

# reads a file; the tool ends if it cannot
fn Read(path String&) String& {
    return try os.ReadFile(path) catch os.Error {
        Die("cannot read " $path)
        unreachable
    }
}

# the files git tracks that match pattern ("*.olang"), sorted
fn Tracked(pattern String&) Vec<String&> {
    o := Run(String&["git", "ls-files", pattern])
    return Sorted(Rows(o.Stdout))
}

# the names in dir that end in suffix, in byte order, each with dir/ before it; none for a directory that is not there
fn Matching(dir String&, suffix String&) Vec<String&> {
    l := Vec<String&>()
    names := try os.ReadDir(dir) catch os.Error { return l }
    for n in names {
        if n.EndsWith(suffix) { l.Push($dir "/" $n) }
    }
    return l
}

# the files of an acceptance tool's command line, else the default list
fn FilesOr(args Array<String&>&, fallback Vec<String&>&) Vec<String&> {
    l := Vec<String&>()
    if args.Len() > 1 {
        for i in range 1, args.Len() { l.Push(args[i]) }
        return l
    }
    for f in fallback { l.Push(f) }
    return l
}

# whether a tool is there to run (the file exists)
fn Built(path String&) Bool {
    return os.Exists(path)
}

# the compiler a tool runs when none is named: $OLANG, else build/olang (make bootstrap) - paths relative to the
# repository root, where the tools run
fn Compiler() String {
    return Env("OLANG", "build/olang")
}

# ---- comparing ----

# diff(1)'s report of two texts, "" for none - the texts go through files in dir
fn Diff(dir String&, a String&, b String&) String {
    Write($dir "/diff.a", a)
    Write($dir "/diff.b", b)
    o := Run(String&["diff", $dir "/diff.a", $dir "/diff.b"])
    return $o.Stdout
}

# the first n rows of a text
fn Head(t String&, n I64) String {
    out := StringBuilder()
    k I64 = 0
    for r in Rows(t) {
        if k >= n { break }
        out.Push(r)
        out.PushChar('\n')
        k++
    }
    return out.ToString()
}

# the rows of a diff report that are changes ("<" or ">")
fn Changes(report String&) String {
    out := StringBuilder()
    for r in Rows(report) {
        if r.StartsWith("<") or r.StartsWith(">") {
            out.Push(r)
            out.PushChar('\n')
        }
    }
    return out.ToString()
}

# how many "== " headers a rendering holds - one for each file a dump tool was given
fn Sections(t String&) I64 {
    n I64 = 0
    for r in Rows(t) {
        if r.StartsWith("== ") { n++ }
    }
    return n
}

# ---- goldens ----
#
# A golden file (compiler/goldens/*.txt) holds stored outputs, a section each: a row "=== KEY", then the body's rows,
# each written "| ROW", and "\\ no newline at end" after the last when the body does not end in one. Any text can be a
# body, a row beginning "=== " included. A golden is captured on purpose by its tool's -capture (a make target), never
# written by a check.

# the sections of a golden: its keys in order, and each key's body
type Golden struct() {
    Keys Vec<String&> = Vec<String&>()
    Bodies Map<String&, String&> = Map<String&, String&>()
}

# a section of a golden file, written as GoldenRead reads it back
fn GoldenSection(key String&, body String&) String {
    b := StringBuilder()
    b.Push("=== " $key "\n")
    for r in Rows(body) {
        b.Push("| ")
        b.Push(r)
        b.PushChar('\n')
    }
    if body.Len() > 0 and body[body.Len() - 1] != '\n' { b.Push("\\ no newline at end\n") }
    return b.ToString()
}

# a golden's text read into its sections; rows of another shape end the tool, since the file is not one
fn GoldenParse(t String&, what String&) Golden {
    g := Golden()
    key String& = ""
    body := StringBuilder()
    open := false
    for r in Rows(t) {
        if r.StartsWith("=== ") {
            if open { g.Bodies.Put($key, body.ToString()) }
            key = $r[4:]
            g.Keys.Push($key)
            body.Clear()
            open = true
        } else if open and r.StartsWith("| ") {
            body.Push(r[2:])
            body.PushChar('\n')
        } else if open and r == "|" {
            body.PushChar('\n')
        } else if open and r == "\\ no newline at end" {
            s := body.ToString()
            body.Clear()
            body.Push(s[:s.Len() - 1] if s.Len() > 0 else s)
        } else {
            Die($what ": not a golden row: " $r)
        }
    }
    if open { g.Bodies.Put($key, body.ToString()) }
    return g
}

# the golden at path, read; a missing one ends the tool, naming the target that captures it
fn GoldenRead(path String&, target String&) Golden {
    t := try os.ReadFile(path) catch os.Error {
        Die("no golden " $path " - capture it with make " $target)
        unreachable
    }
    return GoldenParse(t, path)
}

# writes a golden whole, through a file beside it renamed into place
fn GoldenWrite(path String&, text String&) {
    Write($path ".tmp", text)
    try os.Rename($path ".tmp", path) catch os.Error { Die("cannot write " $path) }
}

# FNV-1a over a text's bytes, 64 bits, as 16 hex digits - what a golden stores of a dump too large to keep
fn Hash(t String&) String {
    h U64 = 0xcbf29ce484222325
    for c in t {
        h = (h ^ U64(U8(c))) * 0x100000001b3
    }
    return h.Format(16).PadStart(16, '0')
}

test "rows are awk's" {
    assert Rows("a\nb\n").Len() == 2
    assert Rows("a\nb").Len() == 2
    assert Rows("").Len() == 0
    assert Rows("a\n\n").Len() == 2
    assert Rows("a\n\n")[1] == ""
    assert Text(Rows("x\ny")) == "x\ny\n"
}

test "fields split on runs of blanks" {
    f := Fields("  a  b\tc ")
    assert f.Len() == 3
    assert f[2] == "c"
    assert AfterSpace("12 catch") == "catch"
    assert AfterSpace("catch") == "catch"
}

test "sorting is by bytes" {
    s := Sorted(Rows("b\nB\na\n"))
    assert s[0] == "B"
    assert s[2] == "b"
}

test "a golden section reads back as its body, whatever the body holds" {
    for body in String&["", "a\n", "a\nb", "=== x\n| y\n\n", "\n\n", "z"] {
        g := GoldenParse($GoldenSection("k one", body) $GoldenSection("k2", "x\n"), "test")
        assert g.Keys.Len() == 2
        assert g.Keys[0] == "k one"
        assert (try g.Bodies.Get("k one") catch default "?") == body
        assert (try g.Bodies.Get("k2") catch default "?") == "x\n"
    }
}

test "a hash is FNV-1a's" {
    assert Hash("") == "cbf29ce484222325"
    assert Hash("a") == "af63dc4c8601ec8c"
}

# ---- stored runs (compiler/goldens/run.txt, captured by compiler/tools/rungold.olang) ----
#
# A file of tests is stored under "test FILE" as its status and its tests' endings, "ok - NAME" or "FAIL - NAME" a row
# each in the order they ran; a checks case that runs under "run NAME" as its program's status and standard output.
# Either body's first row is "status N", and a case whose output differed between two runs says "status N unstable"
# and is held to its status alone.

# the key a file is stored under: a checks case by its name, a file of tests by its path
fn RunKey(f String&) String {
    if f.StartsWith("checks/cases/") { return $"run " $f[13:] }
    return $"test " $f
}

# a stored run's body
fn RunBody(status I64, unstable Bool, text String&) String {
    return $"status " $status $(" unstable" if unstable else "") "\n" $text
}

# what a stored run holds: whether there is one, its status, whether its output is held, and the output (a file of
# tests: its endings)
type StoredRun struct() {
    Found Bool = true
    Status I64 = 0
    Stable Bool = true
    Out String& = ""
}

fn RunParse(body String&) StoredRun {
    r := StoredRun()
    nl := try body.FindByte('\n') catch default body.Len()
    head := Fields(body[:nl])
    if head.Len() >= 2 { r.Status = try head[1].ParseInt() catch default -999 }
    r.Stable = head.Len() < 3
    r.Out = $body[nl + 1:] if nl < body.Len() else ""
    return r
}

# a test run's standard output reduced to its tests' endings, as RunBody stores them: "ok - NAME", "FAIL - NAME"
fn TestEndings(out String&) String {
    b := StringBuilder()
    for row in Rows(out) {
        if row.StartsWith("ok - ") {
            b.Push(row)
            b.PushChar('\n')
        } else if row.StartsWith("FAIL - ") {
            n := row[7:]
            k := try n.Find(": ") catch default -1
            b.Push("FAIL - ")
            b.Push(n[:k] if k >= 0 else n)
            b.PushChar('\n')
        }
    }
    return b.ToString()
}

test "a stored run reads back" {
    r := RunParse(RunBody(3, false, "a\nb"))
    assert r.Status == 3 and r.Stable and r.Out == "a\nb"
    u := RunParse(RunBody(0, true, ""))
    assert u.Status == 0 and not u.Stable and u.Out == ""
    assert RunKey("checks/cases/x.olang") == "run x.olang"
    assert RunKey("tests/shared.olang") == "test tests/shared.olang"
    assert TestEndings("== f ==\nok - a b\nFAIL - c: assertion failed\nx\n") == "ok - a b\nFAIL - c\n"
}

# the run stored for a file in a golden; Found is false where it holds none
fn RunStored(g Golden&, f String&) StoredRun {
    body := try g.Bodies.Get(RunKey(f)) catch {
        r := StoredRun()
        r.Found = false
        return r
    }
    return RunParse(body)
}

# a program's output as a stored run holds it: the working directory - the repository's root - written $ROOT
fn RunText(out String&) String {
    here := try os.Cwd() catch os.Error { return $out }
    return out.Replace(here, "$ROOT")
}

# ---- hashed goldens (compiler/goldens/tokens.*, ast.*: tokdiff, astdiff) ----
#
# A dump of every file of the repository is too large to keep whole, so a hashed golden keeps, in BASE.txt, a row per
# file - "SOURCE DUMP PATH", the hash of the file's text and of its dump's section - and, in BASE.full.txt, the whole
# section (a golden section keyed by its path) of the small files whose dump says something worth reading back: their
# diagnostics. The whole section is only for reading a difference; the hash is what is compared, and the two must agree. A file whose text no longer has the stored hash is stale: its golden says nothing about it until it is
# captured again.

# a dump tool's rendering split at its "== PATH" headers: the paths in order, and each path's rows
fn DumpSections(t String&) Golden {
    g := Golden()
    key String& = ""
    body := StringBuilder()
    open := false
    for r in Rows(t) {
        if r.StartsWith("== ") {
            if open { g.Bodies.Put($key, body.ToString()) }
            key = $r[3:]
            g.Keys.Push($key)
            body.Clear()
            open = true
        } else if open {
            body.Push(r)
            body.PushChar('\n')
        }
    }
    if open { g.Bodies.Put($key, body.ToString()) }
    return g
}

type HashGolden struct() {
    Paths Vec<String&> = Vec<String&>()
    Source Map<String&, String&> = Map<String&, String&>()
    Dump Map<String&, String&> = Map<String&, String&>()
    Full Golden = Golden()
}

# the hashed golden at BASE.txt and BASE.full.txt; a missing one ends the tool, naming the target that captures it
fn HashGoldenRead(base String&, target String&) HashGolden {
    h := HashGolden()
    table := try os.ReadFile($base ".txt") catch os.Error {
        Die("no golden " $base ".txt - capture it with make " $target)
        unreachable
    }
    for r in Rows(table) {
        if r.StartsWith("#") or r == "" { continue }
        f := Fields(r)
        if f.Len() != 3 { Die($base ".txt: not a golden row: " $r) }
        h.Paths.Push($f[2])
        h.Source.Put($f[2], $f[0])
        h.Dump.Put($f[2], $f[1])
    }
    h.Full = GoldenRead($base ".full.txt", target)
    for f in h.Full.Keys {
        if Hash(try h.Full.Bodies.Get(f) catch default "") != (try h.Dump.Get(f) catch default "") {
            Die($base ".full.txt: " $f "'s section is not the one " $base ".txt hashes - capture it again (make " $target ")")
        }
    }
    return h
}

# writes a hashed golden of the files' sections; full says which sections are kept whole too
fn HashGoldenWrite(base String&, what String&, files Vec<String&>&, sections Golden&, full fn(body String&) Bool) {
    table := StringBuilder()
    table.Push("# " $what " - a row per file: the hash of its text, the hash of its section, its path (compiler/tools/toolkit.olang)\n")
    whole := StringBuilder()
    for f in files {
        body := try sections.Bodies.Get(f) catch { Die($base ": no section for " $f) }
        table.Push($Hash(Read(f)) " " $Hash(body) " " $f "\n")
        if full(body) { whole.Push(GoldenSection(f, body)) }
    }
    GoldenWrite($base ".txt", table.ToString())
    GoldenWrite($base ".full.txt", whole.ToString())
}

# the files of a list whose text is not the one the golden was captured from (new files included)
fn HashGoldenStale(h HashGolden&, files Vec<String&>&) Vec<String&> {
    l := Vec<String&>()
    for f in files {
        src := try h.Source.Get(f) catch default ""
        if src != Hash(Read(f)) { l.Push(f) }
    }
    return l
}

# a file's section against the golden: "" where it has the stored hash, else a report of how it differs - a diff against
# the section kept whole where there is one, else the section's first rows
fn HashGoldenCheck(h HashGolden&, dir String&, f String&, body String&) String {
    want := try h.Dump.Get(f) catch default ""
    if Hash(body) == want { return "" }
    whole := try h.Full.Bodies.Get(f) catch {
        return $"-- " $f ": its section is not the golden's (hash " $Hash(body) ", golden " $want "); it begins\n" $Head(body, 20)
    }
    return $"-- " $f " (< golden, > now)\n" $Head(Diff(dir, whole, body), 30)
}

test "dump sections are split at their headers" {
    g := DumpSections("== a\n1 x\n2 y\n== b\n== c\nz\n")
    assert g.Keys.Len() == 3
    assert (try g.Bodies.Get("a") catch default "?") == "1 x\n2 y\n"
    assert (try g.Bodies.Get("b") catch default "?") == ""
    assert (try g.Bodies.Get("c") catch default "?") == "z\n"
}
