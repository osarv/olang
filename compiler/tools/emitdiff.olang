# emitdiff - M9's acceptance, measured: each program built by stage 0 and by the self-hosted pipeline (load, names,
# check, lower with the stand-in placement, emit - compiler/tools/emitdump.olang), run, and the two runs compared.
#
#     emitdiff [-v] [-O LEVEL] [FILE...]
#
# A file of tests (the corpus, std's tests - the default list) is run as "olang test FILE" runs it, and compared test
# by test: a row per file, "same N" where every test ends as stage 0's does, else what each run said - "stage0 P ok F
# fail; port P ok F fail; D differ" - and with -v each test that differs. A checks case ("# check: run") is a program,
# built and run, its output and status compared. Then the totals. The port's module is compiled by clang (at -O LEVEL,
# 0 by default) with stage 0's filled-in runtime beside it; a module clang refuses counts as "does not compile". The
# compiler under test is $OLANG (build/out), the emitter build/compiler_tools_emitdump (or $EMITDUMP).

import "std/os"
import "std/io"
import "toolkit"

fn main() {
    args := os.Args()
    olang := absolute(toolkit.Env("OLANG", "build/out"))
    emitdump := toolkit.Env("EMITDUMP", "build/compiler_tools_emitdump")
    verbose := false
    level := "0"
    files List<String&>
    k I64 = 1
    for k < args.Len() {
        if args[k] == "-v" {
            verbose = true
        } else if args[k] == "-O" and k + 1 < args.Len() {
            k++
            level = args[k]
        } else {
            files.Push(args[k])
        }
        k++
    }
    if files.Len() == 0 {
        for f in toolkit.Matching("tests", ".olang") { files.Push($f) }
        for f in toolkit.Matching("std", ".olang") { files.Push($f) }
        for f in toolkit.Matching("std/prelude/tests", ".olang") { files.Push($f) }
    }
    dir := "build/emitdiff"
    try os.MkDirAll($dir "/rt") catch os.OsError { toolkit.Die("emitdiff: cannot make " $dir) }
    rt := runtime(olang, dir)
    same, differ, broken I64 = 0, 0, 0
    tests, testsSame I64 = 0, 0
    for i in range files.Len() {
        f := files[i]
        program := f.StartsWith("checks/")
        # named as stage 0 names its binary (build/std_os_test), since a program may read its own name (os.Args)
        sub := $dir "/p" $i
        try os.MkDirAll(sub) catch os.OsError { toolkit.Die("emitdiff: cannot make " $sub) }
        base := f[:f.Len() - 6] if f.EndsWith(".olang") else f
        out := $sub "/" $base.Replace("/", "_") $("" if program else "_test")
        r := compare(olang, emitdump, level, rt, f, out, program, verbose)
        toolkit.Say(r.Row)
        tests += r.Tests
        testsSame += r.Same
        if r.Broken {
            broken++
        } else if r.Equal {
            same++
        } else {
            differ++
        }
        try os.RemoveAll(sub) catch os.OsError { }
    }
    toolkit.Say(("== total: files " $files.Len() " same " $same " differ " $differ " broken " $broken "; tests " $tests
                 " ending as stage 0's " $testsSame "\n"))
}

fn absolute(p String&) String {
    if p.StartsWith("/") { return $p }
    cwd := try os.Cwd() catch os.OsError { return $p }
    return $cwd "/" $p
}

# the runtime's IR, filled in by stage 0 for this machine, and the dynamic call's: what a program declaring nothing
# but an import of std/ffi leaves in its build/
fn runtime(olang String&, dir String&) Array<String&> {
    toolkit.Write($dir "/rt/rt.olang", "import \"std/ffi\"\nfn main() { }\n")
    toolkit.Run(String&[$olang, "build", "rt.olang"], String&[], $dir "/rt")
    rt String& = ""
    dc String& = ""
    for n in toolkit.Matching($dir "/rt/build", ".ll") {
        if (try n.Find("olang_runtime.") catch default -1) >= 0 { rt = $n }
        if (try n.Find("olang_dyncall.") catch default -1) >= 0 { dc = $n }
    }
    if rt == "" or dc == "" { toolkit.Die("emitdiff: stage 0 left no runtime in " $dir "/rt/build") }
    return String&[rt, dc]
}

type result struct() {
    Row String& = ""
    Equal Bool = false
    Broken Bool = false
    Tests I64 = 0
    Same I64 = 0
}

fn compare(olang String&, emitdump String&, level String&, rt Array<String&>&, f String&, out String&, program Bool, v Bool) result {
    r := result()
    # stage 0's run
    s0 := toolkit.Run(String&["timeout", "600", $olang, $f]) if program else toolkit.Run(String&["timeout", "600", $olang, "test", $f])
    # the port's
    dump := String&[$emitdump, "-o", $out ".ll", $f] if program else String&[$emitdump, "-t", "-o", $out ".ll", $f]
    e := toolkit.Run(dump)
    gaps := gapCount(e.Stderr)
    if e.Status != 0 {
        r.Broken = true
        r.Row = $f ": not emitted (status " $e.Status ")" "\n"
        return r
    }
    c := toolkit.Run(String&["clang", "-O" $level, "-w", $out ".ll", rt[0], rt[1], "-o", $out, "-lm", "-lpthread", "-ldl", "-lffi"])
    if c.Status != 0 {
        r.Broken = true
        r.Row = $f ": does not compile - " $firstLine(c.Stderr) "\n"
        return r
    }
    p := toolkit.Run(String&["timeout", "600", $out])
    if program {
        r.Equal = p.Stdout == s0.Stdout and p.Status == s0.Status
        r.Row = $f ": " $("same" if r.Equal else "differs (status " $s0.Status " / " $p.Status ")") $gapsText(gaps) "\n"
        return r
    }
    a := outcomes(toolkit.Rows(s0.Stdout))
    b := outcomes(toolkit.Rows(p.Stdout))
    r.Tests = a.Len()
    rows := StringBuilder()
    diffs I64 = 0
    for name in a.Keys() {
        x := try a.Get(name) catch default ""
        y := try b.Get(name) catch default "missing"
        if x == y {
            r.Same++
        } else {
            diffs++
            if v { rows.Push("    " $name ": stage0 " $x ", port " $y "\n") }
        }
    }
    r.Equal = diffs == 0 and p.Status == s0.Status
    if r.Equal {
        r.Row = $f ": same " $r.Tests $gapsText(gaps) "\n"
    } else {
        s0ok, s0f := counts(a)
        pok, pf := counts(b)
        r.Row = ($f ": stage0 " $s0ok " ok " $s0f " fail; port " $pok " ok " $pf " fail (status " $p.Status "); " $diffs
                 " differ" $gapsText(gaps) "\n" $rows.ToString())
    }
    return r
}

fn gapCount(t String&) I64 {
    n I64 = 0
    for row in toolkit.Rows(t) {
        if row.StartsWith("gap ") { n++ }
    }
    return n
}

fn gapsText(n I64) String { return "" if n == 0 else " (" $n " gaps)" }

fn firstLine(t String&) String {
    for row in toolkit.Rows(t) {
        if row.Len() > 0 { return $row }
    }
    return ""
}

# each test's ending, by name: "ok" or "FAIL"
fn outcomes(rows List<String&>&) Map<String&, String&> {
    m Map<String&, String&>
    for row in rows {
        if row.StartsWith("ok - ") {
            m.Put($row[5:], "ok")
        } else if row.StartsWith("FAIL - ") {
            n := row[7:]
            k := try n.Find(": ") catch default -1
            m.Put($n[:k] if k >= 0 else $n, "FAIL")
        }
    }
    return m
}

fn counts(m Map<String&, String&>&) (I64, I64) {
    ok, bad I64 = 0, 0
    for v in m.Values() {
        if v == "ok" { ok++ } else { bad++ }
    }
    return ok, bad
}
