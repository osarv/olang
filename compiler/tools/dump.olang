# dump - what the self-hosted compiler's passes make of a file, as text to diff against the C compiler's oracles
# (compiler/DESIGN.md section 4).
#
#     dump tokens FILE...
#     dump speed FILE...
#     dump ast FILE...
#     dump parse FILE...
#
# For each file, "== FILE", then:
#
# - tokens: one line per token - its line and its text, ";" for a statement end - and then one line per lexical error,
#   "error RULE LINE:COL". bootstrap/oracle/tokdump prints the C tokenizer's stream the same way, and
#   compiler/tools/tokdiff.sh compares the two.
# - speed: the fastest of ten scans, in MB/s.
# - ast: one line per declaration and statement, "KIND LINE:COL-LINE:COL", the span of its tokens - an item the parser
#   met an error in prints none - then "-- diagnostics" and the first syntax error of each item, "error RULE LINE:COL".
#   Every branch of an if is parsed and its diagnostics said, as if each were taken. bootstrap/oracle/astdump prints
#   the C parser's tree the same way, and compiler/tools/astdiff.sh compares the two.
# - parse: the fastest of ten scans and parses, in MB/s.

import "std/os"
import "std/io"
import "std/time"
import "../source"
import "../scan"
import "../token"
import "../ast"
import "../parse"
import "../diag"
import "../msgs"
import "std/filepath"

fn main() ? {
    args := os.Args()
    mode := args[1] if args.Len() >= 3 else ""
    if mode != "tokens" and mode != "speed" and mode != "ast" and mode != "parse" {
        eprintln("usage: dump tokens|speed|ast|parse FILE...")
        os.Exit(2)
    }
    os.RunOnStack(1 << 30, fn() { run(mode, args) })
}

fn run(mode String&, args Array<String&>&) {
    out := io.Writer(1)
    std := try os.Env("OLANG_STD") catch default "std"
    prelude := preludeTypes(std)
    for k in range 2, args.Len() {
        path := args[k]
        out.Write("== " $path "\n")
        src := try source.Read(path) catch {
            out.Write("error IO 0:0\n")
            continue
        }
        match mode {
            case "tokens" { tokens(out, src) }
            case "speed" { speed(out, src) }
            case "ast" { astDump(out, src, std, prelude) }
            nomatch { parseSpeed(out, src, std, prelude) }
        }
    }
    try out.Flush() catch io.IoError { os.Exit(1) }
}

# a file's tokens and lexical errors, as "dump tokens" prints them
fn tokens(out mut io.Writer&, src source.Source&) {
    ts := scan.Scan(src.Text)
    for tk in ts.Toks {
        if tk.Kind == token.Tok.Eof { break }
        out.Write($src.Line(tk.Start))
        out.WriteChar(' ')
        if tk.Kind == token.Tok.StmtEnd {
            out.WriteChar(';')
        } else {
            out.Write(src.Text[tk.Start:tk.End])
        }
        out.WriteChar('\n')
    }
    for d in ts.Diags {
        line, col := src.LineCol(d.Start)
        out.Write("error " $d.Rule() " " $line ":" $col "\n")
    }
}

# how fast the file scans: the fastest of ten scans, in MB/s, and how many tokens it has
fn speed(out mut io.Writer&, src source.Source&) {
    best I64 = 0
    count I64 = 0
    for k in range 10 {
        t := time.Now()
        ts := scan.Scan(src.Text)
        d := time.Since(t)
        count = ts.Toks.Len()
        if k == 0 or d < best { best = d }
    }
    mbs := F64(src.Text.Len()) / 1e6 / (F64(best) / 1e9)
    out.Write($count " tokens, " $(F64(best) / 1e6).Fixed(1) " ms, " $mbs.Fixed(1) " MB/s\n")
}
