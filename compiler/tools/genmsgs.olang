# Writes compiler/msgs.olang from bootstrap/errmsg.h's X-macro table (compiler/DESIGN.md section 1.3).
#
# Every entry of the C compiler's table - X(ID, "RULE", "FORMAT") - becomes one olang function taking the format's
# directives as typed parameters and returning a Msg: the diagnostic's kind, its rule and its text. So every C message
# has its olang twin, and the compiler checks each call's arguments where C's varargs could not.
#
#     %s %S   text: String&                    %d %l   a count: I64
#     %n      a token, as a reader sees it: String& (Tok(text), EndOfLine or EndOfFile until M3's Token exists)
#     %t      a type, as source writes it: String& (until M5's types exist)
#     %c      a byte, escaped where it does not print: Char
#     %%      a '%'
#
# Run from the repository root: build/out -b compiler/tools/genmsgs.olang && build/compiler_tools_genmsgs (not with -i:
# the interpreter frees nothing, and this runs out of memory). It rewrites compiler/msgs.olang whole, so it is the source of the
# generated part until the port's checker (M5) makes %n and %t typed; from then on msgs.olang is edited by hand and
# checks/checks.olang holds it to errmsg.h's rules (bootstrap/ takes fixes only).
#
# A port of the Python script this replaced (the same file written, byte for byte).

import "std/os"
import "std/io"

# what msgs.olang starts with, before the Diag enum
Header String& = (
    "# msgs - every diagnostic the compiler can give, one function each (compiler/DESIGN.md section 1.3).\n"
    "#\n"
    "# A function takes what its message names, typed, and returns a Msg: which diagnostic it is (Kind), the rule of the\n"
    "# specification it applies (Rule - empty where no rule states it; never an invented one), and the text, lowercase and\n"
    "# one line with no period at the end (B11). diag records a Msg against where it is about.\n"
    "#\n"
    "# GENERATED by compiler/tools/genmsgs.olang from bootstrap/errmsg.h - edit the table there and run it again, until M5 makes\n"
    "# the token and type parameters typed (DESIGN.md), after which this file is edited by hand.\n"
    "#\n"
    "# Until then a token parameter (C's %n) is the token as a reader sees it - Tok(text), or EndOfLine or EndOfFile - and a\n"
    "# type parameter (C's %t) is the type as source writes it.\n"
    "\n"
    "# a diagnostic: which one it is, the rule it applies, and its text\n"
    "type Msg struct(Kind Diag, Rule String&, Text String&) {\n"
    "    Kind\n"
    "    Rule\n"
    "    Text\n"
    "}\n"
    "\n"
    "# a token as a reader sees it: its text in quotes, each byte that does not print escaped\n"
    "fn Tok(text String&) String {\n"
    "    b := StringBuilder()\n"
    "    b.PushChar('\\'')\n"
    "    for c in text { b.Push(Esc(c)) }\n"
    "    b.PushChar('\\'')\n"
    "    return b.ToString()\n"
    "}\n"
    "\n"
    "# the two tokens no text spells\n"
    "EndOfLine := \"end of line\"\n"
    "EndOfFile := \"end of file\"\n"
    "\n"
    "# a byte as a message shows it: itself where it prints, else escaped - \\t, \\n, \\r, \\0, or \\xHH\n"
    "fn Esc(c Char) String {\n"
    "    if c == '\\t' { return \"\\\\t\" }\n"
    "    if c == '\\n' { return \"\\\\n\" }\n"
    "    if c == '\\r' { return \"\\\\r\" }\n"
    "    if c == '\\0' { return \"\\\\0\" }\n"
    "    if U8(c) < 32 or U8(c) >= 127 {\n"
    "        hex := U8(c).Format(16)\n"
    "        return \"\\\\x\" $(hex.PadStart(2, '0'))\n"
    "    }\n"
    "    b := StringBuilder()\n"
    "    b.PushChar(c)\n"
    "    return b.ToString()\n"
    "}\n"
    "\n"
)

# what msgs.olang ends with
Tests String& = (
    "\n"
    "# ---- tests ----\n"
    "\n"
    "test \"a message is its C twin's text, its arguments in their places\" {\n"
    "    m := Expected(\"'}'\", Tok(\"South\"))\n"
    "    assert m.Text == \"expected '}', found 'South'\" and m.Rule == \"\" and m.Kind == Diag.Expected\n"
    "    assert UnknownChar('@').Rule == \"L16\"\n"
    "    assert NoMain().Text == \"no main function - a program starts at 'fn main() ? { }'\"\n"
    "}\n"
    "\n"
    "test \"a byte that does not print is escaped, in a character and in a token\" {\n"
    "    assert UnknownChar('\\t').Text == \"unexpected character '\\\\t'\"\n"
    "    assert Esc(Char(1)) == \"\\\\x01\" and Esc(Char(200)) == \"\\\\xc8\" and Esc('a') == \"a\"\n"
    "    assert Tok(\"a\\nb\") == \"'a\\\\nb'\"\n"
    "    assert Expected(\"a name\", EndOfLine).Text == \"expected a name, found end of line\"\n"
    "}\n"
)

# the directives a format may hold, with the stem of the parameter each makes and its type
DirectiveChars String& = "sSntdlc"
Stems Array<String&>& = String&["text", "text", "tok", "ty", "n", "n", "ch"]
Types Array<String&>& = String&["String&", "String&", "String&", "String&", "I64", "I64", "Char"]

# ends the program with a message, as Python's SystemExit(text) did: on the standard error, status 1
fn die(message String&) {
    try io.Write(io.Stderr, $message "\n") catch io.IoError { }
    os.Exit(1)
}

# whether c is a letter, a digit or an underscore
fn isWord(c Char) Bool { return c.IsLetter() or c.IsDigit() or c == '_' }

# whether c is white space
fn isSpace(c Char) Bool { return c == ' ' or c == '\t' or c == '\n' or c == '\r' or (c >= 11 and c <= 12) }

# the position after the white space starting at i
fn skipSpace(t String&, i I64) I64 {
    j := i
    for j < t.Len() and isSpace(t[j]) { j++ }
    return j
}

# what literalEnd and readEntry fail with: the text is no C string literal, or the line no entry
error notEntry {
    TEXT
}

# the position after the C string literal starting at i (a quote), or notEntry.TEXT when it is none: a quote, then
# any bytes but a quote or a backslash and any backslash with the byte after it, then a quote
fn literalEnd(t String&, i I64) I64 ? {
    if i >= t.Len() or t[i] != '"' { error notEntry.TEXT }
    j := i + 1
    for j < t.Len() and t[j] != '"' {
        if t[j] == '\\' {
            if j + 1 >= t.Len() { error notEntry.TEXT }
            j += 2
        } else {
            j++
        }
    }
    if j >= t.Len() { error notEntry.TEXT }
    return j + 1
}

# the bytes of the string literal text[start:end] (quotes included), escapes decoded
fn decode(lit String&) String {
    out := StringBuilder()
    body := lit[1:lit.Len() - 1]
    i I64 = 0
    for i < body.Len() {
        c := body[i]
        if c != '\\' {
            out.PushChar(c)
            i++
            continue
        }
        e := body[i + 1]
        i += 2
        if e == 'n' {
            out.PushChar('\n')
        } else if e == 't' {
            out.PushChar('\t')
        } else if e == 'r' {
            out.PushChar('\r')
        } else if e == '0' {
            out.PushChar(Char(0))
        } else if e == '\\' or e == '"' or e == '\'' or e == '?' {
            out.PushChar(e)
        } else if e == 'x' {
            j := i
            for j < body.Len() and (body[j].IsDigit() or (body[j] >= 'a' and body[j] <= 'f') or (body[j] >= 'A' and body[j] <= 'F')) { j++ }
            if j == i { die("genmsgs: unknown escape \\x") }
            value := try body[i:j].ParseUint(16) catch default 0
            if value >= 127 { die("genmsgs: a byte no olang literal writes: " $value) }
            out.PushChar(Char(U8(value)))
            i = j
        } else {
            die("genmsgs: unknown escape \\" $e)
        }
    }
    return out.ToString()
}

# one entry of the table, X(ID, "RULE", "FORMAT"...): its id, its rule and its format with the literals joined and
# decoded - or notEntry.TEXT when the line is no entry
fn readEntry(line String&) (String, String, String) ? {
    i := skipSpace(line, 0)
    if not line[i:].StartsWith("X(") { error notEntry.TEXT }
    i += 2
    start := i
    for i < line.Len() and isWord(line[i]) { i++ }
    if i == start or i >= line.Len() or line[i] != ',' { error notEntry.TEXT }
    id := $line[start:i]
    i = skipSpace(line, i + 1)
    ruleEnd := try literalEnd(line, i)
    rule := decode(line[i:ruleEnd])
    if ruleEnd >= line.Len() or line[ruleEnd] != ',' { error notEntry.TEXT }
    i = skipSpace(line, ruleEnd + 1)
    format := StringBuilder()
    count I64 = 0
    for i < line.Len() and line[i] == '"' {
        e := try literalEnd(line, i)
        format.Push(decode(line[i:e]))
        i = skipSpace(line, e)
        count++
    }
    if count == 0 or i >= line.Len() or line[i] != ')' { error notEntry.TEXT }
    return id, rule, format.ToString()
}

# text as an olang string literal (L14/L15)
fn olangLit(text String&) String {
    out := StringBuilder()
    out.PushChar('"')
    for c in text {
        if c == '\\' {
            out.Push("\\\\")
        } else if c == '"' {
            out.Push("\\\"")
        } else if c == '\n' {
            out.Push("\\n")
        } else if c == '\t' {
            out.Push("\\t")
        } else if c == '\r' {
            out.Push("\\r")
        } else if U8(c) == 0 {
            out.Push("\\0")
        } else if U8(c) < 32 or U8(c) >= 127 {
            die("genmsgs: a byte no olang literal writes: " $U8(c))
        } else {
            out.PushChar(c)
        }
    }
    out.PushChar('"')
    return out.ToString()
}

# ERR_UNKNOWN_CHAR is UnknownChar, NOTE_IN_LIBRARY NoteInLibrary
fn funcName(id String&) String {
    out := StringBuilder()
    words := id.Split("_")
    for k, w in words {
        if k == 0 and w == "ERR" { continue }
        out.PushChar(w[0])
        out.Push(w[1:].ToLower())
    }
    return out.ToString()
}

# the function for one entry: its name and its text
fn function(id String&, rule String&, format String&) (String, String) {
    stems List<String&>        # the stem of each parameter, in order
    kinds List<I64>            # its directive's index in DirectiveChars
    # pieces: a literal's text, or a parameter's number as "\0" and the number
    literals List<String&>
    order List<I64>            # -1 for a literal (the next of literals), else the parameter's number
    lit := StringBuilder()
    i I64 = 0
    for i < format.Len() {
        c := format[i]
        if c != '%' {
            lit.PushChar(c)
            i++
            continue
        }
        d := format[i + 1]
        i += 2
        if d == '%' {
            lit.PushChar('%')
            continue
        }
        k := try DirectiveChars.FindByte(d) catch {
            die("genmsgs: " $id ": unknown directive %" $d)
            unreachable
        }
        if lit.Len() > 0 {
            literals.Push(lit.ToString())
            order.Push(-1)
            lit = StringBuilder()
        }
        stems.Push(Stems[k])
        kinds.Push(k)
        order.Push(stems.Len() - 1)
    }
    if lit.Len() > 0 {
        literals.Push(lit.ToString())
        order.Push(-1)
    }
    # a stem used once is its own name; one used more than once is numbered from 1
    names List<String&>
    for k in range stems.Len() {
        total I64 = 0
        before I64 = 0
        for j in range stems.Len() {
            if stems[j] == stems[k] {
                total++
                if j < k { before++ }
            }
        }
        if total == 1 { names.Push($stems[k]) } else { names.Push($stems[k] $(before + 1)) }
    }
    pieceText := StringBuilder()
    pieces I64 = 0
    next I64 = 0
    for o in order {
        if pieces > 0 { pieceText.PushChar(' ') }
        pieces++
        if o < 0 {
            pieceText.Push(olangLit(literals[next]))
            next++
        } else if kinds[o] == 6 {
            pieceText.Push("$Esc(" $names[o] ")")
        } else {
            pieceText.Push("$" $names[o])
        }
    }
    text := pieceText.ToString() if pieces > 0 else "\"\""
    name := funcName(id)
    sig := StringBuilder()
    for k in range stems.Len() {
        if k > 0 { sig.Push(", ") }
        sig.Push($names[k] " " $Types[kinds[k]])
    }
    return name, "fn " $name "(" $sig.ToString() ") Msg { return Msg(Diag." $name ", " $olangLit(rule) ", " $text ") }"
}

fn main() ? {
    src := try os.ReadFile("bootstrap/errmsg.h") catch {
        die("genmsgs: cannot read bootstrap/errmsg.h - run it from the repository root")
        unreachable
    }
    from := try src.Find("#define DIAGNOSTICS(X)") catch default 0
    to := try src.Find("enum diag {") catch default 0
    table := src[from:to]
    ids List<String&>
    names List<String&>
    functions List<String&>
    for line in table.Split("\n") {
        if not line.TrimStart().StartsWith("X(") { continue }
        id, rule, format := try readEntry(line) catch {
            die("genmsgs: cannot read: " $line)
            unreachable
        }
        name, decl := function(id, rule, format)
        if name in names { die("genmsgs: two entries are named " $name) }
        ids.Push($id)
        names.Push($name)
        functions.Push($decl)
    }
    out := StringBuilder()
    out.Push(Header)
    out.Push("# every diagnostic, in errmsg.h's order\n")
    out.Push("type Diag enum {\n")
    for name in names { out.Push("    " $name "\n") }
    out.Push("}\n\n")
    out.Push("# errmsg.h's entries, one function each, under the C id each comes from\n")
    for k in range ids.Len() { out.Push("\n# " $ids[k] "\n" $functions[k] "\n") }
    out.Push(Tests)
    try os.WriteFile("compiler/msgs.olang", out.ToString()) catch {
        die("genmsgs: cannot write compiler/msgs.olang")
    }
    io.Println("genmsgs: " $ids.Len() " diagnostics written to compiler/msgs.olang")!
}

test "names, literals and functions are written as the Python script wrote them" {
    assert funcName("ERR_UNKNOWN_CHAR") == "UnknownChar" and funcName("NOTE_IN_LIBRARY") == "NoteInLibrary"
    assert olangLit("a\"b\\c\n") == "\"a\\\"b\\\\c\\n\""
    name, decl := function("ERR_X", "R1", "expected %t, found %n and %n, 100%%")
    assert name == "X"
    assert decl == "fn X(ty String&, tok1 String&, tok2 String&) Msg { return Msg(Diag.X, \"R1\", \"expected \" $ty \", found \" $tok1 \" and \" $tok2 \", 100%\") }"
    id, rule, format := try readEntry("    X(ERR_A, \"R1\", \"one \" \"two\\n\") \\") catch { unreachable }
    assert id == "ERR_A" and rule == "R1" and format == "one two\n"
}
