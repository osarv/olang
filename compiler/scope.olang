# scope - section 8, the scope pass (compiler/DESIGN.md 1.7, the M6 row; docs/scope-model.md is its design): where
# every value lives, judged over the typed core (typed.olang), and where every value is built, given to lowering as
# each body's plan (typed.Plan).
#
# The model (docs/scope-model.md 2-3), in short:
# - A scope term of a body is a block of it (B), one of its scope variables (V: a reference parameter's, a by-value one
#   holding references, the result scope, a constructor's instance, a destructor's closing scope, a lambda's captures),
#   the program's scope (P), a derived scope (D: where the argument for a parameter bound a field written "&q", O23a), a
#   set of terms not known here (O12) or an untraced one (O11). Only B, V and P exist at run time, so only they are ever
#   built into (2.3).
# - Terms are ordered by "outlives" (2.2): P outlives everything, a scope variable or a derived scope every block, a
#   block the blocks nested in it; anything else between V, D and P terms is an obligation of the body (O10b), which its
#   callers discharge (O10c).
# - FIT (3.1): existing storage put into a slot must outlive the slot's term, and be exactly it where something can be
#   stored through it (O25, O25g); a reference local is always exact (O25a, O25b). A temporary is built where it lands
#   (PLACE, 3.2, O6, O18a) - which is all placement is.
# - CALL (3.3): each of a callee's scope variables is bound to a term of the caller (O17, O18a, O18b, E25), and the
#   callee's obligations are judged through those bindings.
# - Obligations are summaries over the call graph's strongly connected components (7.2): a component's bodies are
#   judged until their obligations stop growing, then once more with their errors said, callees first.
#
# What the pass does not judge yet is recorded as a gap (Gaps), as check's are; compiler/PROGRESS notes say which.

import "std/pair"
import "source"
import "diag"
import "msgs"
import "types"
import "generic"
import "typed"

# ---- scope terms (docs/scope-model.md 2.1) ----

# a scope term of one body
type Term enum {
    None                   # no term: a value holding no reference, or one not decided yet
    Block(b typed.BlockId) # a block's scope (O2); Block(0) the body's frame
    Var(i I64)             # one of the body's scope variables, by its index in Vars
    Program                # the program's scope (O1b)
    Derived(p I64, w I64)  # where the argument for parameter p (an index in Params) bound its type's variable w (O23a)
    Set(id I64)            # not known here (O12): one of the terms of set id
    Untraced               # not traced (O11)
}

# whether a term exists at run time, so that something can be built in it (2.3)
fn (t Term) Runs() Bool {
    return match t {
        case Term.Block(_), Term.Var(_), Term.Program => true
        case _ => false
    }
}

# whether a term can be part of an obligation: a scope variable, a derived scope or the program's (O10b)
fn (t Term) Relatable() Bool {
    return match t {
        case Term.Var(_), Term.Derived(_, _), Term.Program => true
        case _ => false
    }
}

# a relation of a body's obligations (O10b): Hi outlives Lo, both relatable terms of the body; Exact where it is one half
# of an equality (O25b, O25c); At the statement of the body that required it, for the note O10c's error gives
type rel struct(Hi Term, Lo Term, Exact Bool, At source.Span, Why I64) {
    Hi
    Lo
    Exact
    At
    Why      # a constructor's: WhyHolds where its instance holds an argument (C2d), WhyField where a "&q" field names one
}

WhyHolds I64 = 1
WhyField I64 = 2
WhyResult I64 = 3 # what an instance a function returns holds (C2d through its result, said where the result lands)

# what a judgment of "outlives" comes to (2.2): it holds; it is an obligation the body records; it fails because a
# block is asked to outlive a scope variable (O10d) or another block it is nested in (O10); it cannot be judged here
# (O11, O12)
Holds I64 = 0
Obliged I64 = 1
FailsBlock I64 = 2
FailsUnknown I64 = 3

# what a value is to section 8 (docs/scope-model.md 2.5): holding no reference (Plain), null, a temporary built where it
# landed (Fresh, T the term it was built in), or existing storage (Existing, T where its referent lives - for a
# reference - or where its references are - for a value holding them)
type ValKind enum {
    Plain
    Null
    Fresh
    Existing
    Static # constant data (T25d): it lives in the program's scope and fits every slot, as null does
}

type Val struct(K ValKind, T Term) {
    K
    T
}

fn plain() Val { return Val(ValKind.Plain, Term.None) }

fn fresh(t Term) Val { return Val(ValKind.Fresh, t) }

fn existing(t Term) Val { return Val(ValKind.Existing, t) }

# ---- the pass over a program ----

# a construct the pass met and does not judge yet: where, and what
type Gap struct(File I64, Sp source.Span, What String&) {
    File
    Sp
    What
}

# what a body's judgment says to its callers: its obligations (O10b), once its component has converged
type summary struct() {
    Rels List<rel>
    Builds List<Bool> # by scope variable: whether the body may build into it (O18c, E11c)
    Real List<Bool>   # ... a value, not only a task's stand-in (P2), which a derived scope takes (O23a)
    # by scope variable: where the body's first build into it is, innermost - a callee's own site where it builds there
    # through a call - for E11c's note
    BuildFile List<I64>
    BuildAt List<source.Span>
    Keeps List<Bool>  # by parameter: whether the body may keep something in what it names (O17)
    Stores List<Bool> # ... store something into it, or hand a writable reference into it out - not only keep its reference
    Puts List<Bool>   # ... store something into it itself, or by a callee that does - not only hand a reference out (O17b)
    # a lambda's, by local: the same of each reference it captured, for a lambda that never leaves where it is made,
    # judged by its body (O17, D16c)
    CapKeeps List<Bool>
    CapStores List<Bool>
    CapPuts List<Bool>
    # by constructor parameter of the instance the body returns: where every return's instance bound it, in the body's
    # terms (O13c) - Untraced where the returns disagree or it is not one of the caller's; empty for none
    ResBind List<Term>
    # by field of a constructor's instance: where the instance the field was given bound its own constructor's
    # parameters, in the constructor's terms - from FieldFrom[i] in FieldTerms, -1 for none (O23a)
    FieldFrom List<I64>
    FieldTerms List<Term>
    Done Bool = false
    Judging Bool = false # its component is being judged to a fixed point: Builds is what the rounds so far found
}

# a function made a value (T22a): where, which body, and how - Named, Lambda, or an instance through its Call (Of)
type fnUse struct(File I64, Sp source.Span, F I64, Kind I64, Of types.TypeId) {
    File
    Sp
    F
    Kind
    Of
}

FnNamed I64 = 0
FnLambda I64 = 1
FnCall I64 = 2

# the scope pass over a checked program: P the program, Bodies check's typed bodies. Run judges every body and fills
# Plans, one per body (an empty plan for a body with no code)
type Scoper struct(P mut generic.Program&, Bodies List<mut typed.Body&>) {
    P
    Bodies
    Plans List<typed.Plan>
    Gaps List<Gap>
    InstNote fn(inst I64) String = null # the checker's note for an instance's context ("instantiated here, with T = ...")
    Spell fn(t types.TypeId) String = null # a type as source writes it, for a message (the checker's)
    sums List<mut summary&>
    ctorOf Map<types.TypeId, I64>  # a type's constructor's body (twin 0)
    stTypes Map<types.TypeId, I64> # storeThrough, once asked: 1 being asked, 2 no, 3 yes
    asTypes Map<pair.Pair<I64, I64>, I64> # admitsAt, by (type, writable): 1 being asked, 2 no, 3 yes
    texts Map<I64, String&>        # a diag file's text, by file
    judged List<Bool>              # by body: whether its scopes were judged (it had code and no unknown type)
    # the call graph (Tarjan): each body's callees in edgeTo from edgeFrom[b]; the components, callees' first, in
    # compNodes from compFrom[k]
    edgeFrom List<I64>
    edgeTo List<I64>
    # each body's locals assigned after their declaration (walkBody), in assignedTo from assignedFrom[b]
    assignedFrom List<I64>
    assignedTo List<I64>
    # ... and the locals whose own storage a borrow or a slice names, in borrowedTo from borrowedFrom[b]
    borrowedFrom List<I64>
    borrowedTo List<I64>
    tIndex List<I64>
    tLow List<I64>
    tOn List<Bool>
    tStack List<I64>
    tNext I64 = 0
    compFrom List<I64>
    compNodes List<I64>
    # the body being judged
    B typed.Body& = null
    Id I64 = -1
    report Bool = false
    plan typed.Plan = typed.Plan(0, 0, 0)
    terms List<Term>           # by local: where its referent lives (a reference) or its references (a value holding them)
    stors List<Term>           # by local: where its own storage is
    blocks List<typed.BlockId> # the blocks entered, innermost last
    gamma List<rel>            # the obligations found (O10b)
    setFrom List<I64>          # the sets of terms not known here (O12): set k's terms in setTerms from setFrom[k]
    setTerms List<Term>
    stmtSp source.Span = source.Span(0, 0) # the statement being judged
    resultVar I64 = -1                     # the result scope's index in Vars, -1 for none
    held Map<I64, typed.Expr&>             # a held local's temporary initializer, built where its one use puts it
    splitHome Map<I64, Term>               # a for-in's hidden borrow of a split value: where its references live (O17a)
    inits Map<I64, typed.Expr&>            # by local: its declaration's initializer, for the notes
    # by local never assigned after its declaration: the construction bindings of the instance it holds or refers to,
    # one per constructor parameter in bindTerms from bindFrom (O23a); ctorSite, ctorFrom the constructor call last judged
    bindFrom Map<I64, I64>
    bindTerms List<Term>
    bindKids List<I64>         # parallel to bindTerms: the record of the argument's own instance there, -1 for none
    siteRec Map<I64, I64>      # a call's site: the record its instance's bindings start at
    fieldsAssigned Map<pair.Pair<I64, I64>, Bool> # (struct type, field) any body assigns after construction, -1 all
    # a local assigned after its declaration: the record every value it is given has, merged over a quiet judging of
    # the body first (lateBody) - Untraced where they disagree, none where one has no record (O23a)
    lateBody I64 = -1
    lateGather Bool = false
    late Map<I64, List<Term>>
    lateNone Map<I64, Bool>
    lateDecl Map<I64, Bool>    # ... whose declaration's value was among them
    ctorSite I64 = -1
    ctorFrom I64 = 0
    resBind List<Term>         # the returns' instance bindings so far (O13c), resBound once one is seen
    resBound Bool = false
    targets List<typed.Place&>             # the places of the Assigns being judged, innermost last (Place.Target)
    buildsVar List<Bool>                   # by scope variable: whether this body builds into it, directly or through a call
    realVar List<Bool>                     # ... a value, not only a task's stand-in
    standIn Bool = false                   # the build buildsInto records next is a task's stand-in (P2)
    buildSp List<source.Span>              # by scope variable: where in this body it first builds there
    buildFile List<I64>                    # ... and that build's innermost site (a callee's, through a call)
    buildAt List<source.Span>
    noBuild List<Bool>                     # by scope variable: where nothing may be built - a Str's receiver's (E11c)
    onFrame Bool = false                   # the lambda val judges next is made for a call that keeps nothing of it (D16c)
    inSpawn Bool = false                   # the call val judges next is a task's (P2: every scope it binds is built into)
    joins List<typed.BlockId>              # the join blocks entered, innermost last (P1a)
    taskJoin Term = Term.None              # the join block of the task call val judges next: its temporaries are built there
    taskTemp Bool = false                  # judging a temporary a task is handed: what it holds must last until taskAt's join
    taskAt source.Span = source.Span(0, 0) # ... the argument it is
    taskSlot Term = Term.None
    taskFunc Bool = false                  # ... a function value the task calls through, not an argument
    fitSlot Term = Term.None               # the slot of the fit being judged, for fitError
    fitNarrow Bool = false                 # ... that the value outlives its slot, which is narrower (O25)
    fitLocalRead Bool = false              # ... that the value is a local read or borrowed, its own scope's to say (O10)
    fitAt Bool = false                     # fitError says its error at fitSp, not at the value (P1g)
    fitSp source.Span = source.Span(0, 0)
    fnUses List<fnUse>                     # the functions made values, judged once every body is (T22a)
    kept List<Bool>                        # by local: computeKeeps' finding for a reference parameter
    keptStore List<Bool>                   # ... that it stores into what the parameter names (Stores)
    keptPut List<Bool>                     # ... itself, not only by handing a reference out (Puts)
    under List<Term>                       # the terms fieldTerm's underestimates stand above, a Derived(-1 - k, _) for under[k]
    underElem List<Bool>                   # ... and whether each was read through an array's element (O23)
    temps Map<I64, Term>                   # by site: a temporary place's value judged (tempTerm), the term its references are at
    partDest Map<I64, Term>                # by call site: where a part read out of its built result is put (O18a)
    resAt Term = Term.None                 # the result scope the call judged last was bound to
    lifted Map<I64, I64>                   # by block: a "for" statement's own, which stands for the block around it (S9)
    trMemo Map<pair.Pair<I64, I64>, I64>   # transient's answers, by (body, parameter): 1 being asked, 2 no, 3 yes
    useMemo Map<pair.Pair<I64, I64>, I64>  # uses' answers, by (body and mode, parameter): 1 being asked, 2 no, 3 yes
    regionOnly List<I64>                   # by local: the parameter whose region it holds only reads of (O17), -1 none
    aliasOf List<I64>                      # by local: the reference parameter it was declared as a second name for, -1 none
    rlChanged Bool = false
    why I64 = 0                            # what the obligations recorded now are for, in a constructor (rel.Why)
    # what decide found for the local the next Let declares: the result term it is moved to (O26a), or that a call it
    # is declared from lands by its obligations (O18c); landing is that flag handed to the call
    moveTo Term = Term.None
    landOK Bool = false
    landing Bool = false
    # the flow analysis (flowRun): fl the locals reached, flDirect those a return gives, flKept whether the local is kept
    # beyond its block (O18c), flMode which of the two is asked, flBlock the local's block, flGrew whether a pass grew fl
    fl List<I64>
    flDirect List<I64>
    flKept Bool = false
    flMode I64 = 0
    flBlock typed.BlockId = typed.BlockId(0)
    flGrew Bool = false
    flCaps Bool = true                     # whether carried follows what a function value captured
    kwTransient Bool = false               # the lambda kwExpr walks next never leaves where it is made (D16c)
    atDest Bool = false                    # the choice val judges next builds its new values at its destination (E28)
    landSite I64 = -1                      # the call an assignment's value is, and its "=" (C2d through a result)
    landSp source.Span = source.Span(0, 0)
}

# every body judged, callees before callers, a component of the call graph until its obligations stop growing
fn (s mut Scoper&) Run() {
    n := s.Bodies.Len()
    for i in range n {
        s.Plans.Push(typed.NewPlan(s.Bodies[i]))
        s.sums.Push(summary())
        s.judged.Push(false)
        match s.Bodies[i].Of {
            case typed.BodyOf.Ctor(t, twin) {
                if twin == types.ListId(0) { s.ctorOf.Put(t, i) }
            }
            case _ { }
        }
    }
    for m in s.P.L.Mods {
        if m.Src != null and m.File >= 0 { s.texts.Put(m.File, m.Src.Text) }
    }
    s.components()
    for k in range s.compFrom.Len() {
        end := s.compFrom[k + 1] if k + 1 < s.compFrom.Len() else s.compNodes.Len()
        comp := Array<I64>(end - s.compFrom[k])
        for i in range comp.Len() { comp[i] = s.compNodes[s.compFrom[k] + i] }
        s.component(comp)
    }
    s.fnValues()
}

# the function instance whose body b is, or is a lambda inside; -1 for none
fn (s mut Scoper&) instanceOf(b I64) I64 {
    for depth in range 64 {
        match s.Bodies[b].Of {
            case typed.BodyOf.Fn(inst) { return inst }
            case typed.BodyOf.Lambda(parent) { b = I64(parent) }
            case _ { return -1 }
        }
    }
    return -1
}

# G16b: the contexts an instance's body is judged in - where it was asked for, and where each instance asking for it was
# in turn, the outermost first: how many were pushed
fn (s mut Scoper&) instContexts(inst I64) I64 {
    if inst < 0 { return 0 }
    chain List<generic.Origin>
    insts List<I64>
    cur := inst
    for depth in range 32 {
        if s.P.T.Items(s.P.InstanceArgs(cur)).Len() == 0 { break }
        o := s.P.InstanceOrigin(cur)
        if o.File < 0 { break }
        chain.Push(o)
        insts.Push(cur)
        if o.Within < 0 { break }
        cur = o.Within
    }
    for kk in range chain.Len() {
        o := chain[chain.Len() - 1 - kk]
        i := insts[chain.Len() - 1 - kk]
        text := s.InstNote(i) if s.InstNote != null else "instantiated here"
        s.P.L.Diags.PushContext(diag.Where.Span(o.File, I64(o.Sp.Start), I64(o.Sp.End)), text)
    }
    return chain.Len()
}

# T22a: a function carrying a scope obligation cannot be a value - a call through one discharges nothing
fn (s mut Scoper&) fnValues() {
    for u in s.fnUses {
        rels := s.sums[u.F].Rels
        if rels.Len() == 0 { continue }
        at := diag.Where.Span(u.File, I64(u.Sp.Start), I64(u.Sp.End))
        if u.Kind == FnCall {
            t := u.Of
            if s.isRef(t) { t = s.P.T.Referent(t) }
            t = s.P.T.Plain(t)
            name := s.P.L.Names.Text(s.P.T.DeclName(s.P.T.DeclOf(t))) if s.P.T.KindOf(t) == types.Kind.Named else ""
            s.P.L.Diags.Error(at, msgs.CallValueObligations(name))
        } else if u.Kind == FnNamed {
            text := try s.texts.Get(u.File) catch default ""
            s.P.L.Diags.Error(at, msgs.FuncValueObligations(text[I64(u.Sp.Start):I64(u.Sp.End)] if I64(u.Sp.End) <= text.Len() else ""))
        } else {
            # a lambda has no name the program wrote: the parameter it keeps, one an obligation requires to outlive
            # something else (B11)
            kept := ""
            body := s.Bodies[u.F]
            # written for a callback whose result is a type variable, it may require what that type does: each of its
            # arguments outliving its result scope (O14b)
            if s.P.T.ResultFrom(body.Ty, 0) == types.FromTypeVar {
                covered := true
                for r in rels {
                    match r.Lo {
                        case Term.Var(k) { covered = covered and body.Vars[k] == typed.ScopeVar.Result }
                        case _ { covered = false }
                    }
                }
                if covered { continue }
            }
            for r in rels {
                match r.Hi {
                    case Term.Var(k) {
                        match body.Vars[k] {
                            case typed.ScopeVar.Param(l) {
                                if kept == "" { kept = s.P.L.Names.Text(body.Locals[I64(l)].Name) }
                            }
                            case _ { }
                        }
                    }
                    case _ { }
                }
            }
            s.P.L.Diags.Error(at, msgs.LambdaValueObligations(kept) if kept != "" else msgs.LambdaValueRelates())
        }
    }
}

# a component of the call graph judged: alone, once; with a cycle, until no body's obligations grow, then once more
# saying its errors (docs/scope-model.md 7.2)
fn (s mut Scoper&) component(comp Array<I64>&) {
    cyclic := comp.Len() > 1 or s.callsItself(comp[0])
    if cyclic {
        # what the component's bodies may build into is a least fixed point: none at first, each round what the last
        # found (docs/scope-model.md 7.2)
        for b in comp { s.sums[b].Judging = true }
        for round in range 20 {
            grew := false
            for b in comp {
                before := s.sums[b].Rels.Len()
                built := s.facts(b)
                s.judge(b, false)
                if s.sums[b].Rels.Len() != before or s.facts(b) != built { grew = true }
            }
            if not grew { break }
        }
    }
    for b in comp { s.judge(b, true) }
    for b in comp {
        s.sums[b].Done = true
        s.sums[b].Judging = false
    }
}

# how many of a body's may-facts hold: what it builds into, keeps and stores (each only grows over a component's rounds)
fn (s mut Scoper&) facts(b I64) I64 {
    sm := s.sums[b]
    return countTrue(sm.Builds) + countTrue(sm.Real) + countTrue(sm.Keeps) + countTrue(sm.Stores) + countTrue(sm.Puts) +
        countTrue(sm.CapKeeps) + countTrue(sm.CapStores) + countTrue(sm.CapPuts)
}

fn countTrue(xs List<Bool>&) I64 {
    n I64 = 0
    for x in xs {
        if x { n++ }
    }
    return n
}

fn (s mut Scoper&) callsItself(b I64) Bool {
    for k in range s.edgeFrom[b], s.edgeFrom[b + 1] {
        if s.edgeTo[k] == b { return true }
    }
    return false
}

# body b judged: its plan made and its obligations recorded - its errors said where report holds
fn (s mut Scoper&) judge(b I64, report Bool) {
    body := s.Bodies[b]
    if body.Root == null { return }
    for l in body.Locals {
        if l.Ty == types.UnknownT { return }
    }
    if report and s.lateBody != b and s.hasLateLocals(b) {
        # what each assigned local is given, gathered before the judging that reports reads it
        s.lateBody = b
        s.late.Clear()
        s.lateNone.Clear()
        s.lateDecl.Clear()
        s.lateGather = true
        s.judge(b, false)
        s.lateGather = false
    }
    s.judged[b] = true
    s.B = body
    s.Id = b
    s.terms.Clear()
    s.stors.Clear()
    s.blocks.Clear()
    s.joins.Clear()
    s.gamma.Clear()
    s.setFrom.Clear()
    s.setTerms.Clear()
    s.held.Clear()
    s.splitHome.Clear()
    s.inits.Clear()
    s.bindFrom.Clear()
    s.bindTerms.Clear()
    s.bindKids.Clear()
    s.siteRec.Clear()
    s.ctorSite = -1
    s.resBind.Clear()
    s.resBound = false
    s.targets.Clear()
    s.resultVar = -1
    s.report = report
    s.plan = typed.NewPlan(body)
    s.buildsVar.Clear()
    s.realVar.Clear()
    s.buildSp.Clear()
    s.buildFile.Clear()
    s.buildAt.Clear()
    s.noBuild.Clear()
    str := s.isStr(body)
    for k in range body.Vars.Len() {
        s.buildsVar.Push(false)
        s.realVar.Push(false)
        s.buildSp.Push(body.Sp)
        s.buildFile.Push(body.File)
        s.buildAt.Push(body.Sp)
        nb := false
        if str {
            match body.Vars[k] {
                case typed.ScopeVar.Param(l) { nb = body.Params.Len() > 0 and l == body.Params[0] }
                case _ { }
            }
        }
        s.noBuild.Push(nb)
    }
    s.under.Clear()
    s.underElem.Clear()
    s.temps.Clear()
    s.partDest.Clear()
    s.lifted.Clear()
    # G16b, B11: what is said in an instance's body is said at the program's use of it, as the checker says it
    pushed := 0
    base := 0
    if report {
        base = s.P.L.Diags.ContextBase(s.P.L.Diags.ContextDepth())
        pushed = s.instContexts(s.instanceOf(b))
    }
    s.run()
    if report and str { s.strReceiver() }
    if report {
        for k in range pushed { s.P.L.Diags.PopContext() }
        s.P.L.Diags.ContextBase(base)
    }
    # the obligations only grow: what a round found is kept for the next
    for r in s.gamma {
        if not hasRel(s.sums[b].Rels, r) { s.sums[b].Rels.Push(r) }
    }
    sm := s.sums[b]
    s.noteFieldRecs(sm)
    sm.ResBind.Clear()
    if s.resBound {
        for t in s.resBind { sm.ResBind.Push(t) }
    }
    sm.Builds.Clear()
    sm.Real.Clear()
    sm.BuildFile.Clear()
    sm.BuildAt.Clear()
    for k in range s.buildsVar.Len() {
        sm.Builds.Push(s.buildsVar[k])
        sm.Real.Push(s.realVar[k])
        sm.BuildFile.Push(s.buildFile[k])
        sm.BuildAt.Push(s.buildAt[k])
    }
    s.computeKeeps(body)
    if report { s.Plans[b] = s.plan }
}

# whether a body is a Str that "$" calls (E11c): a method named Str or str, of no parameter but its receiver
fn (s mut Scoper&) isStr(b typed.Body&) Bool {
    match b.Of {
        case typed.BodyOf.Fn(inst) {
            fd := s.P.FnDecl(s.P.InstanceFn(inst))
            if fd.Recv == null or b.Params.Len() != 1 { return false }
            n := s.P.L.Names.Text(fd.Name)
            return n == "Str" or n == "str"
        }
        case _ { return false }
    }
}

# E11c: "$" does not say where a part it renders lives, so a Str requires nothing of its receiver's scopes - no
# obligation names one but the receiver's outliving its result - and builds nothing there, directly or through what it
# hands a part of the receiver to: one error, at the first
fn (s mut Scoper&) strReceiver() {
    for r in s.gamma {
        bad := false
        match r.Lo {
            case Term.Var(k) { bad = k < s.noBuild.Len() and s.noBuild[k] and r.Hi != r.Lo }
            case Term.Derived(p, _) { bad = p >= 0 }
            case _ { }
        }
        if bad {
            s.err(s.firstToken(s.B.File, r.At), msgs.StrStoresInReceiver())
            return
        }
    }
    for k in range s.noBuild.Len() {
        if not s.noBuild[k] or not s.buildsVar[k] { continue }
        rec := s.err(s.buildSp[k], msgs.StrStoresInReceiver())
        if s.buildFile[k] != s.B.File or s.buildAt[k].Start != s.buildSp[k].Start {
            s.note(rec, s.buildFile[k], s.buildAt[k], msgs.NoteStrBuildsHere())
        }
        return
    }
}

fn hasRel(rs List<rel>&, r rel) Bool {
    for x in rs {
        if x.Hi == r.Hi and x.Lo == r.Lo and x.Exact == r.Exact { return true }
    }
    return false
}

fn (s mut Scoper&) gap(file I64, sp source.Span, what String&) { s.Gaps.Push(Gap(file, sp, $what)) }

# ---- types ----

fn (s mut Scoper&) holds(t types.TypeId) Bool { return s.P.T.HoldsRefs(t) }

fn (s mut Scoper&) isRef(t types.TypeId) Bool { return s.P.T.KindOf(t) == types.Kind.Ref }

fn (s mut Scoper&) isFunc(t types.TypeId) Bool { return s.P.T.KindOf(t) == types.Kind.Func }

# whether something can be stored through a value of type t (O25g): a writable reference to storage with an assignable
# part holding a reference; a value holding such a writable reference. Never a read-only reference or a function value
fn (s mut Scoper&) storeThrough(t types.TypeId) Bool {
    match s.P.T.KindOf(t) {
        case types.Kind.Ref {
            if (s.P.T.PermOf(t) & types.Writable) == 0 { return false }
            return s.assignableHolds(s.P.T.Referent(t))
        }
        case types.Kind.Func { return false }
        case types.Kind.Named, types.Kind.Tuple, types.Kind.Record, types.Kind.Array, types.Kind.AnonEnum { }
        nomatch { return false }
    }
    state := try s.stTypes.Get(t) catch default 0
    if state != 0 { return state == 3 }
    s.stTypes.Put(t, 1)
    r := false
    for p in s.parts(t) {
        if s.storeThrough(p) { r = true }
    }
    s.stTypes.Put(t, 3 if r else 2)
    return r
}

# whether something could be stored, at any depth, through what a value of type t refers to (C2d, O23a): what holds a
# reference, for a value; for a reference, a writable one holding references reached through it - a read-only one's
# writable references included. Where a call binds a derived scope only so, a build there is said
fn (s mut Scoper&) admitsStores(t types.TypeId) Bool {
    if not s.isRef(t) { return s.holds(t) }
    return s.admitsAt(s.P.T.Referent(t), (s.P.T.PermOf(t) & types.Writable) != 0)
}

fn (s mut Scoper&) admitsAt(t types.TypeId, writable Bool) Bool {
    k := pair.Pair(I64(t), 1 if writable else 0)
    state := try s.asTypes.Get(k) catch default 0
    if state != 0 { return state == 3 }
    s.asTypes.Put(k, 1)
    r := false
    match s.P.T.KindOf(t) {
        case types.Kind.Var { r = true }
        case types.Kind.Named {
            # an enum's payload is never assigned: only what its references let through
            w := writable
            if s.P.T.HasBody(t) and s.P.T.DeclKindOf(s.P.T.DeclOf(t)) == types.DeclKind.Enum { w = false }
            for p in s.parts(t) {
                if s.partAdmits(p, w) { r = true }
            }
        }
        case types.Kind.Array, types.Kind.Tuple, types.Kind.Record, types.Kind.AnonEnum {
            for p in s.parts(t) {
                if s.partAdmits(p, writable) { r = true }
            }
        }
        nomatch { }
    }
    s.asTypes.Put(k, 3 if r else 2)
    return r
}

fn (s mut Scoper&) partAdmits(p types.TypeId, writable Bool) Bool {
    if writable and (s.isRef(p) or s.holds(p)) { return true }
    if s.isRef(p) { return s.admitsAt(s.P.T.Referent(p), (s.P.T.PermOf(p) & types.Writable) != 0) }
    return s.admitsAt(p, writable)
}

# whether storage of type t has a part that can be assigned through a writable reference to it and holds a reference
# (QC: every field is assignable through a writable instance; an element of an array; an enum's payload never is, so
# only what its writable references reach counts)
fn (s mut Scoper&) assignableHolds(t types.TypeId) Bool {
    match s.P.T.KindOf(t) {
        case types.Kind.Named {
            if not s.P.T.HasBody(t) { return true }
            match s.P.T.DeclKindOf(s.P.T.DeclOf(t)) {
                case types.DeclKind.Struct {
                    for f in s.P.T.Items(s.P.T.Fields(t)) {
                        if s.holds(f) { return true }
                    }
                    return false
                }
                case types.DeclKind.Over { return s.assignableHolds(s.P.T.Base(t)) }
                case types.DeclKind.Enum { return s.storeThrough(t) }
                nomatch { return false }
            }
        }
        case types.Kind.Array { return s.holds(s.P.T.Elem(t)) }
        case types.Kind.Tuple, types.Kind.Record {
            for f in s.P.T.Items(s.P.T.Parts(t)) {
                if s.holds(f) { return true }
            }
            return false
        }
        case types.Kind.Var { return true }
        nomatch { return false }
    }
}

# the parts a value of type t holds in place: a struct's fields, an enum's payloads' fields, an array's elements, a
# tuple's or record's parts
fn (s mut Scoper&) parts(t types.TypeId) List<types.TypeId> {
    out List<types.TypeId>
    match s.P.T.KindOf(t) {
        case types.Kind.Named {
            if not s.P.T.HasBody(t) { return out }
            match s.P.T.DeclKindOf(s.P.T.DeclOf(t)) {
                case types.DeclKind.Struct {
                    for f in s.P.T.Items(s.P.T.Fields(t)) { out.Push(f) }
                }
                case types.DeclKind.Enum {
                    for c in s.P.T.Items(s.P.T.Cases(t)) {
                        if c != types.TypeId(0) {
                            for f in s.parts(c) { out.Push(f) }
                        }
                    }
                }
                case types.DeclKind.Over { out.Push(s.P.T.Base(t)) }
                nomatch { }
            }
        }
        case types.Kind.Array { out.Push(s.P.T.Elem(t)) }
        case types.Kind.Tuple, types.Kind.Record {
            for f in s.P.T.Items(s.P.T.Parts(t)) { out.Push(f) }
        }
        case types.Kind.AnonEnum {
            for c in s.P.T.Items(s.P.T.ShapeCases(t)) {
                if c != types.TypeId(0) {
                    for f in s.parts(c) { out.Push(f) }
                }
            }
        }
        nomatch { }
    }
    return out
}

# the body of a function a callee reaches, -1 where there is none (an extern, a helper, a function value)
fn (s mut Scoper&) bodyOf(c typed.Callee&) I64 {
    return match c {
        case typed.Callee.Body(id) => I64(id)
        case _ => -1
    }
}

# a struct type's field i's mark, as its constructor's Fields say (C2d): Bare for a bare field, Of(param) for one written
# "&p"; None where the type has no constructor body
fn (s mut Scoper&) fieldMark(t types.TypeId, i I64) typed.Mark {
    id := try s.ctorOf.Get(t) catch default -1
    if id < 0 { return typed.Mark.None }
    b := s.Bodies[id]
    if i >= b.Fields.Len() { return typed.Mark.None }
    return b.Locals[I64(b.Fields[i])].Marked
}

# ---- the call graph and its components (Tarjan) ----

# what a walk of a body finds: the bodies it calls, makes a value of or writes a lambda for, and the locals it assigns
# after their declaration - a store into the local itself, a task's target
type walked struct() {
    Callees List<I64>
    Assigned List<I64>
    Borrowed List<I64>            # the locals whose own storage a borrow or a slice names, reached through no reference
    FieldTypes List<types.TypeId> # the struct types whose field FieldIdx is assigned after construction - -1 the whole
    FieldIdx List<I64>            # value, written through a reference
}

fn walkBody(s mut Scoper&, b I64) walked {
    out walked
    body := s.Bodies[b]
    if body.Root != null { collectBlock(body.Root, out) }
    return out
}

# a local a place is, the whole of it: -1 for any other place
fn wholeLocal(p typed.Place&) I64 {
    return match p {
        case typed.Place.Local(_, _, id) => I64(id)
        case _ => -1
    }
}

fn collectBlock(bl typed.Block&, out mut walked&) {
    if bl == null { return }
    for st in bl.Stmts { collectStmt(st, out) }
}

fn collectStmt(st typed.Stmt&, out mut walked&) {
    if st == null { return }
    match st {
        case typed.Stmt.Let(_, _, x) { collectExpr(x, out) }
        case typed.Stmt.Assign(_, p, x) {
            if wholeLocal(p) >= 0 { out.Assigned.Push(wholeLocal(p)) }
            collectField(p, out)
            collectPlace(p, out)
            collectExpr(x, out)
        }
        case typed.Stmt.Eval(_, x) { collectExpr(x, out) }
        case typed.Stmt.If(_, i) {
            collectExpr(i.Test, out)
            collectBlock(i.Then, out)
            collectBlock(i.Else, out)
        }
        case typed.Stmt.Loop(_, body, post) {
            collectBlock(body, out)
            collectBlock(post, out)
        }
        case typed.Stmt.Return(_, x) { collectExpr(x, out) }
        case typed.Stmt.Assert(_, c, m) {
            collectExpr(c, out)
            collectExpr(m, out)
        }
        case typed.Stmt.Block(_, b) { collectBlock(b, out) }
        case typed.Stmt.Defer(_, b) { collectBlock(b, out) }
        case typed.Stmt.Join(_, jn) {
            collectBlock(jn.Code, out)
            for c in jn.Clauses { collectBlock(c.Code, out) }
        }
        case typed.Stmt.Spawn(_, sp) {
            for p in sp.Targets {
                if wholeLocal(p) >= 0 { out.Assigned.Push(wholeLocal(p)) }
                collectField(p, out)
                collectPlace(p, out)
            }
            collectExpr(sp.Task, out)
            for c in sp.Clauses { collectExpr(c.Handler, out) }
        }
        case typed.Stmt.Yield(_, x) { collectExpr(x, out) }
        case _ { }
    }
}

# a store into a field, or into all a reference names (O23a: the instance a field holds is no longer its constructor's)
fn collectField(p typed.Place&, out mut walked&) {
    match p {
        case typed.Place.Field(_, _, b, i) {
            out.FieldTypes.Push(b.Type())
            out.FieldIdx.Push(i)
        }
        case typed.Place.Deref(_, ty, _) {
            out.FieldTypes.Push(ty)
            out.FieldIdx.Push(-1)
        }
        case _ { }
    }
}

fn collectPlace(p typed.Place&, out mut walked&) {
    if p == null { return }
    match p {
        case typed.Place.Deref(_, _, r) { collectExpr(r, out) }
        case typed.Place.Field(_, _, b, _) { collectPlace(b, out) }
        case typed.Place.Elem(_, _, e) {
            collectPlace(e.Base, out)
            collectExpr(e.Index, out)
        }
        case typed.Place.Payload(_, _, pl) { collectPlace(pl.Base, out) }
        case typed.Place.Temp(_, _, v, _) { collectExpr(v, out) }
        case _ { }
    }
}

fn collectExpr(x typed.Expr&, out mut walked&) {
    if x == null { return }
    match x {
        case typed.Expr.Read(_, _, p, _) { collectPlace(p, out) }
        case typed.Expr.Borrow(_, _, p) {
            if not flThroughRef(p) and flRoot(p) >= 0 { out.Borrowed.Push(flRoot(p)) }
            collectPlace(p, out)
        }
        case typed.Expr.Take(_, _, p) { collectPlace(p, out) }
        case typed.Expr.Promote(_, _, pr) { collectExpr(pr.X, out) }
        case typed.Expr.Call(_, _, c) {
            match c.Target {
                case typed.Callee.Body(id) { out.Callees.Push(I64(id)) }
                case typed.Callee.Value(v) { collectExpr(v, out) }
                case _ { }
            }
            for a in c.Args { collectExpr(a, out) }
        }
        case typed.Expr.Make(_, _, m) {
            for a in m.Items { collectExpr(a, out) }
            collectExpr(m.Length, out)
        }
        case typed.Expr.Collect(_, _, c) {
            collectExpr(c.Reserve, out)
            collectBlock(c.Loop, out)
        }
        case typed.Expr.Prim(_, _, _, _, args) {
            for a in args { collectExpr(a, out) }
        }
        case typed.Expr.Slice(_, _, sl) {
            if not flThroughRef(sl.Base) and flRoot(sl.Base) >= 0 { out.Borrowed.Push(flRoot(sl.Base)) }
            collectPlace(sl.Base, out)
            collectExpr(sl.Lo, out)
            collectExpr(sl.Hi, out)
        }
        case typed.Expr.Cond(_, _, c) {
            collectExpr(c.C, out)
            collectExpr(c.A, out)
            collectExpr(c.B, out)
        }
        case typed.Expr.Seq(_, _, q) {
            for st in q.Stmts { collectStmt(st, out) }
            collectExpr(q.X, out)
        }
        case typed.Expr.Match(_, _, m) {
            for st in m.Held { collectStmt(st, out) }
            for a in m.Arms { collectArm(a, out) }
            collectArm(m.NoMatch, out)
        }
        case typed.Expr.Try(_, _, t) {
            collectExpr(t.X, out)
            for c in t.Clauses {
                collectBlock(c.Code, out)
                for d in c.Defaults { collectExpr(d, out) }
            }
        }
        case typed.Expr.Fn(_, _, f) {
            match f {
                case typed.FnVal.Named(id) { out.Callees.Push(I64(id)) }
                case typed.FnVal.Lambda(id, caps, _) {
                    out.Callees.Push(I64(id))
                    for c in caps { collectExpr(c.Outer, out) }
                }
                case typed.FnVal.Adapter(id, r, _) {
                    out.Callees.Push(I64(id))
                    collectExpr(r, out)
                }
            }
        }
        case typed.Expr.Text(_, _, t) {
            for pc in t.Pieces {
                match pc {
                    case typed.Piece.Render(r) { collectExpr(r, out) }
                    case _ { }
                }
            }
        }
        case typed.Expr.Away(_, _, y) { collectExpr(y, out) }
        case _ { }
    }
}

fn collectArm(a typed.Arm&, out mut walked&) {
    if a == null { return }
    for alt in a.Alts {
        collectExpr(alt.Test, out)
        for bd in alt.Binds { collectExpr(bd.From, out) }
    }
    collectExpr(a.Guard, out)
    collectBlock(a.Code, out)
    collectExpr(a.Value, out)
}

# the program's bodies in components, callees' components before their callers' (Tarjan's order)
fn (s mut Scoper&) components() {
    n := s.Bodies.Len()
    for i in range n {
        s.edgeFrom.Push(s.edgeTo.Len())
        w := walkBody(s, i)
        for c in w.Callees { s.edgeTo.Push(c) }
        s.assignedFrom.Push(s.assignedTo.Len())
        for l in w.Assigned { s.assignedTo.Push(l) }
        s.borrowedFrom.Push(s.borrowedTo.Len())
        for l in w.Borrowed { s.borrowedTo.Push(l) }
        for k in range w.FieldTypes.Len() {
            s.fieldsAssigned.Put(pair.Pair(I64(s.P.T.Repr(w.FieldTypes[k])), w.FieldIdx[k]), true)
        }
        s.tIndex.Push(-1)
        s.tLow.Push(0)
        s.tOn.Push(false)
    }
    s.edgeFrom.Push(s.edgeTo.Len())
    s.assignedFrom.Push(s.assignedTo.Len())
    s.borrowedFrom.Push(s.borrowedTo.Len())
    for i in range n {
        if s.tIndex[i] < 0 { s.visit(i) }
    }
}

fn (s mut Scoper&) visit(v I64) {
    s.tIndex[v] = s.tNext
    s.tLow[v] = s.tNext
    s.tNext++
    s.tStack.Push(v)
    s.tOn[v] = true
    for k in range s.edgeFrom[v], s.edgeFrom[v + 1] {
        w := s.edgeTo[k]
        if w < 0 or w >= s.tIndex.Len() { continue }
        if s.tIndex[w] < 0 {
            s.visit(w)
            if s.tLow[w] < s.tLow[v] { s.tLow[v] = s.tLow[w] }
        } else if s.tOn[w] and s.tIndex[w] < s.tLow[v] {
            s.tLow[v] = s.tIndex[w]
        }
    }
    if s.tLow[v] == s.tIndex[v] {
        s.compFrom.Push(s.compNodes.Len())
        for {
            w := try s.tStack.Pop() catch { break }
            s.tOn[w] = false
            s.compNodes.Push(w)
            if w == v { break }
        }
    }
}

# ---- judging one body ----

fn (s mut Scoper&) run() {
    b := s.B
    for i in range b.Locals.Len() {
        s.terms.Push(Term.None)
        s.stors.Push(Term.Block(typed.BlockId(0)))
    }
    for k in range b.Vars.Len() {
        match b.Vars[k] {
            case typed.ScopeVar.Param(l) {
                s.terms[I64(l)] = Term.Var(k)
            }
            case typed.ScopeVar.Capture(l) {
                s.terms[I64(l)] = Term.Var(k)
            }
            case typed.ScopeVar.Result, typed.ScopeVar.Instance { s.resultVar = k }
            case typed.ScopeVar.Closing {
                # a destructor's instance lives in the closing scope (C9a)
                if b.Params.Len() > 0 { s.terms[I64(b.Params[0])] = Term.Var(k) }
            }
        }
    }
    # a parameter sharing another's scope variable (O4a) lives where that one does
    for i in range b.Params.Len() {
        l := b.Params[i]
        match b.Locals[I64(l)].Marked {
            case typed.Mark.Of(x) {
                if s.terms[I64(l)] == Term.None { s.terms[I64(l)] = s.terms[I64(x)] }
            }
            case _ { }
        }
    }
    s.blocks.Push(typed.BlockId(0))
    s.stmts(b.Root.Stmts)
    s.landHeld()
    try s.blocks.Pop() catch { }
}

fn (s mut Scoper&) block(bl typed.Block&) {
    if bl == null { return }
    s.blocks.Push(bl.Id)
    s.stmts(bl.Stmts)
    try s.blocks.Pop() catch { }
}

fn (s mut Scoper&) stmts(ss Array<typed.Stmt&>&) {
    for i in range ss.Len() {
        st := ss[i]
        match st {
            case typed.Stmt.Let(_, l, x) {
                s.decide(l, x, ss, i + 1)
                # a capturing lambda held in a local only ever called lives in this frame (D16c)
                if s.capturingLambda(x) and s.ocStmts(ss, i + 1, I64(l), false) { s.onFrame = true }
            }
            case _ { }
        }
        s.stmt(st)
        s.onFrame = false
    }
}

# whether an expression is a conditional or a match (E28, S12b)
fn (s mut Scoper&) choiceOfRefs(x typed.Expr&) Bool {
    return match s.unAway(x) {
        case typed.Expr.Cond(_, _, _), typed.Expr.Match(_, _, _) => true
        case typed.Expr.Seq(_, _, q) => s.choiceOfRefs(q.X)
        case _ => false
    }
}

# whether a block is a three-clause "for"'s own: the variables it declares, then the loop (S9)
fn (s mut Scoper&) forWrap(b typed.Block&) Bool {
    if s.B.Blocks[I64(b.Id)].Kind != typed.BlockKind.Plain or b.Stmts.Len() < 2 { return false }
    for i in range b.Stmts.Len() {
        match b.Stmts[i] {
            case typed.Stmt.Let(_, l, _) {
                if i == b.Stmts.Len() - 1 or s.B.Locals[I64(l)].Kind != typed.LocalKind.Var { return false }
            }
            case typed.Stmt.Loop(_, _, _) {
                if i != b.Stmts.Len() - 1 { return false }
            }
            case _ { return false }
        }
    }
    return true
}

# the block whose scope block b stands for: itself, or for a three-clause "for"'s own, the block around the loop
fn (s mut Scoper&) lift(b typed.BlockId) typed.BlockId {
    return typed.BlockId(I32(try s.lifted.Get(I64(b)) catch default I64(b)))
}

# the block statements stand in now: a temporary nothing else places is built there (O18a's last row)
fn (s mut Scoper&) here() Term {
    b := s.lift(s.blocks[s.blocks.Len() - 1])
    # what a constructor's top level builds is built in its instance scope (C2g); a global's initializer's in the
    # program's (O1b), and so does a condition's or an assert message's the evaluator computes (B9c, S18c)
    if b == typed.BlockId(0) {
        match s.B.Of {
            case typed.BodyOf.Ctor(_, _) {
                if s.resultVar >= 0 { return Term.Var(s.resultVar) }
            }
            case typed.BodyOf.Global(_, _), typed.BodyOf.Cond(_, _) { return Term.Program }
            case _ { }
        }
    }
    return Term.Block(b)
}

fn (s mut Scoper&) gapAt(sp source.Span, what String&) { s.gap(s.B.File, sp, what) }

# ---- where a local's initializer lands (O26a, O18c) ----

# decided for the local a Let at ss[from - 1] declares, before it is judged: the result term it is moved to where the
# function returns it (O26a), else whether the call it is declared from lands where its obligations say (O18c)
fn (s mut Scoper&) decide(l typed.LocalId, x typed.Expr&, ss Array<typed.Stmt&>&, from I64) {
    s.moveTo = Term.None
    s.landOK = false
    loc := s.B.Locals[I64(l)]
    if loc.Kind == typed.LocalKind.Held { return }
    # a constructor's own top level is its instance's scope (C2g); a block inside it moves nothing there
    ctor := match s.B.Of {
        case typed.BodyOf.Ctor(_, _) => true
        case _ => false
    }
    # a for-in's own variable is the loop's copy, never moved: it is no declaration of the program's (O26a)
    if s.qualifiesMove(loc, x) and not ctor and not s.loopElement(I64(l)) {
        rt := s.resultTerm(0)
        # an array value returned from a function with no result scope (its type holds no reference) lasts only in the
        # program's scope (T7b, as lower's copy of one is made there)
        if s.isBlock(rt) and s.arenaValue(loc.Ty) and s.returnsArray() { rt = s.storageTerm() }
        if rt.Runs() and not s.isBlock(rt) {
            s.flowStart(l, 0)
            s.flCaps = false
            s.flowRun(ss, from)
            s.flCaps = true
            if flHas(s.flDirect, I64(l)) or (flHas(s.fl, I64(l)) and not s.tiedToBlock(x)) {
                s.moveTo = rt
                return
            }
        }
    }
    if not s.holds(loc.Ty) { return }
    match loc.Marked {
        case typed.Mark.None, typed.Mark.Infer { }
        case _ { return }
    }
    c := s.callOf(x)
    if c == null { return }
    callee := s.bodyOf(c.Target)
    if callee < 0 or not s.summed(callee) { return }
    # a constructor's instance is built where it is declared, C2d holding it to what it holds (O18a)
    if s.P.T.Role(s.calleeType(c)) == types.RoleCtor { return }
    rv := s.resultVarOf(s.calleeType(c))
    if rv < 0 { return }
    # it lands there where that costs nothing (the callee builds nothing there), where an obligation needs it, or where
    # the local is kept beyond its block
    if not s.sumBuilds(callee, rv) or s.forced(callee, rv) {
        s.landOK = true
        return
    }
    s.flowStart(l, 1)
    s.flowRun(ss, from)
    s.landOK = s.flKept
}

# whether an argument borrows a for-in's copy of an element: a value, its storage the loop's block (O17, O10c)
fn (s mut Scoper&) lentLoopCopy(a typed.Expr&) Bool {
    match s.unAway(a) {
        case typed.Expr.Borrow(_, _, p) {
            match p {
                case typed.Place.Local(_, _, id) { return s.loopElement(I64(id)) and not s.isRef(s.B.Locals[I64(id)].Ty) }
                case _ { }
            }
        }
        case _ { }
    }
    return false
}

# whether local l is a for-in's own variable, its element or key (S9a): declared at the loop, as its loop block is
fn (s mut Scoper&) loopElement(l I64) Bool {
    loc := s.B.Locals[l]
    if loc.Kind != typed.LocalKind.Var or I64(loc.In) <= 0 or I64(loc.In) >= s.B.Blocks.Len() { return false }
    bi := s.B.Blocks[I64(loc.In)]
    return bi.Kind == typed.BlockKind.Loop and bi.Sp.Start == loc.Sp.Start and bi.Sp.End == loc.Sp.End
}

# whether a local is one O26a may move: a value whose declaration makes it (a call's result, an instance, an array or a
# literal built here, its zero value) holding references or storage a borrow can name; a reference declared by ":=" or
# a bare "&" from a temporary or null
fn (s mut Scoper&) qualifiesMove(loc typed.Local, x typed.Expr&) Bool {
    t := loc.Ty
    if s.isFunc(t) { return false }
    if s.isRef(t) {
        match loc.Marked {
            case typed.Mark.Bare, typed.Mark.Infer { }
            case _ { return false }
        }
        return s.isFresh(x) or s.isNullLit(x)
    }
    match loc.Marked {
        case typed.Mark.None, typed.Mark.Infer { }
        case _ { return false }
    }
    if not s.madeHere(x) { return false }
    if s.holds(t) { return true }
    # a number or a Bool is never moved; storage a borrow can name may be
    k := s.P.T.KindOf(t)
    return k == types.Kind.Array or k == types.Kind.Named or k == types.Kind.Tuple
}

# whether x is an array literal of constant data only, promoted into a read-only reference (T25d)
fn (s mut Scoper&) staticLiteral(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Promote(_, ty, pr) {
            if s.P.T.KindOf(ty) != types.Kind.Ref or (s.P.T.PermOf(ty) & types.Writable) != 0 { return false }
            match pr.X {
                case typed.Expr.Make(_, _, m) {
                    if m.Kind != typed.MakeKind.Array { return false }
                    for it in m.Items {
                        match it {
                            case typed.Expr.Data(_, _, _, _) { }
                            case _ { return false }
                        }
                    }
                    return true
                }
                case _ { }
            }
        }
        case _ { }
    }
    return false
}

fn (s mut Scoper&) isNullLit(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Lit(_, ty, _) { return s.holds(ty) }
        case _ { return false }
    }
}

# whether an expression makes new storage for a value: a call, a constructor, a literal or array built here, a zero
fn (s mut Scoper&) madeHere(x typed.Expr&) Bool {
    if x == null { return false }
    return match x {
        case typed.Expr.Call(_, _, _), typed.Expr.Make(_, _, _), typed.Expr.Collect(_, _, _) => true
        case typed.Expr.Promote(_, _, _), typed.Expr.Text(_, _, _) => true
        case typed.Expr.Lit(_, ty, _) => s.holds(ty)
        case typed.Expr.Try(_, _, t) => s.madeHere(t.X)
        case typed.Expr.Away(_, _, y) => s.madeHere(y)
        case typed.Expr.Seq(_, _, q) => s.madeHere(q.X)
        case typed.Expr.Prim(_, _, op, _, args) => op == typed.PrimOp.Convert and args.Len() > 0 and s.madeHere(args[0])
        case typed.Expr.Read(_, ty, p, _) => s.heldPart(p) or s.constCopy(p, ty)
        # a conditional or a value match each of whose values makes it (E28, S12b; stage 0's copiesExistingRefs)
        case typed.Expr.Cond(_, _, c) => s.madeHere(c.A) and s.madeHere(c.B)
        case typed.Expr.Match(_, _, m) => s.matchMadeHere(m)
        case _ => false
    }
}

# whether a read of p is a copy of constant data into new storage: an array value read out of a literal (T25d)
fn (s mut Scoper&) constCopy(p typed.Place&, ty types.TypeId) Bool {
    if not s.arenaValue(ty) { return false }
    match p {
        case typed.Place.Deref(_, _, r) {
            return match s.unAway(r) {
                case typed.Expr.Data(_, _, _, _) => true
                case _ => false
            }
        }
        case _ { return false }
    }
}

# whether every value a value match gives makes new storage - an arm that leaves gives none
fn (s mut Scoper&) matchMadeHere(m typed.Match&) Bool {
    if not m.IsValue { return false }
    for a in m.Arms {
        if a.Value != null and not s.madeHere(a.Value) { return false }
    }
    return m.NoMatch.Value == null or s.madeHere(m.NoMatch.Value)
}

# whether a place is a part of a held local whose initializer makes new storage: a destructured result (S4b)
fn (s mut Scoper&) heldPart(p typed.Place&) Bool {
    match p {
        case typed.Place.Field(_, _, _, _) { }
        case _ { return false }
    }
    r := flRoot(p)
    if r < 0 or flThroughRef(p) { return false }
    x := try s.held.Get(r) catch default null
    return x != null and s.madeHere(x)
}

# the call an initializer is: itself, or under a try, a conversion, an Away
fn (s mut Scoper&) callOf(x typed.Expr&) typed.Call&x {
    if x == null { return null }
    return match x {
        case typed.Expr.Call(_, _, c) => c
        case typed.Expr.Try(_, _, t) => s.callOf(t.X)
        case typed.Expr.Away(_, _, y) => s.callOf(y)
        case _ => null
    }
}

# the index among a function type's scope variables of its result scope, -1 for none
fn (s mut Scoper&) resultVarOf(fty types.TypeId) I64 {
    if fty == types.UnknownT { return -1 }
    vars := s.P.T.ScopeVarsOf(fty)
    for v in range vars.Len() {
        if vars[v] == types.ResultVar { return v }
    }
    return -1
}

fn (s mut Scoper&) sumBuilds(callee I64, v I64) Bool {
    bs := s.sums[callee].Builds
    return v >= bs.Len() or bs[v]
}

# whether a call's callee may build into its scope variable v: a body not known, or not judged to the end, may
fn (s mut Scoper&) calleeBuilds(c typed.Call&, callee I64, v I64) Bool {
    match c.Target {
        case typed.Callee.Extern(_), typed.Callee.Helper(_, _) { return false }
        case _ { }
    }
    return s.buildsSum(callee, v)
}

# whether body callee may build into its scope variable v, as its summary says: a body not known may; one of the
# component being judged, what the rounds so far found (a least fixed point)
fn (s mut Scoper&) buildsSum(callee I64, v I64) Bool {
    if callee < 0 or v < 0 { return true }
    sm := s.sums[callee]
    if sm.Judging { return v < sm.Builds.Len() and sm.Builds[v] }
    if not sm.Done { return true }
    return s.sumBuilds(callee, v)
}

# whether a callee's obligations need its result scope to outlive, or to be, one an argument gives (O18c, O25g)
fn (s mut Scoper&) forced(callee I64, rv I64) Bool {
    for r in s.sums[callee].Rels {
        if r.Hi == Term.Var(rv) and r.Lo != Term.Var(rv) { return true }
        if r.Exact and r.Lo == Term.Var(rv) and r.Hi != Term.Var(rv) { return true }
    }
    return false
}

# where a call's result scope lands by its obligations (O18c): the shortest of the scopes they require it be outlived
# by, through the call's bindings - None where there is none, where two are not ordered here, or where one is the
# program's, a derived one or not known here
fn (s mut Scoper&) landByObligations(c typed.Call&, rv I64, beta Array<Term>&) Term {
    callee := s.bodyOf(c.Target)
    if callee < 0 or not s.summed(callee) { return Term.None }
    best := Term.None
    for r in s.sums[callee].Rels {
        if r.Lo != Term.Var(rv) or r.Hi == Term.Var(rv) { continue }
        to := Term.None
        match r.Hi {
            case Term.Var(i) {
                if i < beta.Len() { to = beta[i] }
                # constant data given for it lives in the program's scope; a variable nothing determines yet is bound
                # after, by its own obligations or where the result lands (O18b), and constrains nothing here
                if to == Term.None {
                    if not s.staticVar(c, i) { continue }
                    to = Term.Program
                }
            }
            # a derived scope is where the argument's instance bound it, where its record says (O23a); else it outlives
            # where its instance is: landed there, an underestimate (O23)
            case Term.Derived(p, w) {
                if p >= 0 {
                    to = s.derivedAt(p, w, c, true, beta)
                    if not to.Runs() or to == Term.Program { to = s.paramBinding(c, p, beta) }
                }
            }
            case _ { return Term.None }
        }
        match to {
            case Term.Block(_), Term.Var(_) { }
            # the program's, only where the callee builds nothing there: nothing is then kept to the end
            case Term.Program {
                if s.sumBuilds(callee, rv) { return Term.None }
            }
            case _ { return Term.None }
        }
        if best == Term.None {
            best = to
        } else if s.order(best, to) == Holds {
            best = to
        } else if s.order(to, best) != Holds {
            return Term.None
        }
    }
    return best
}

# the site of the call a reference argument is read out of a part of the built result of, else -1
fn (s mut Scoper&) argPartCall(a typed.Expr&) I64 {
    match s.unAway(a) {
        case typed.Expr.Read(_, ty, p, _) {
            if s.isRef(ty) { return s.partCall(p) }
        }
        case _ { }
    }
    return -1
}

fn (s mut Scoper&) argPartOK(a typed.Expr&, t Term) Bool {
    if not t.Runs() { return true }
    match s.unAway(a) {
        case typed.Expr.Read(_, _, p, _) { return s.partOK(p, t) }
        case _ { return false }
    }
}

# whether every argument determining a call's scope variable v is constant data (T25d), and one is
fn (s mut Scoper&) staticVar(c typed.Call&, v I64) Bool {
    fty := s.calleeType(c)
    if fty == types.UnknownT { return false }
    vars := s.P.T.ScopeVarsOf(fty)
    if v >= vars.Len() { return false }
    any := false
    for i in range c.Args.Len() {
        k := s.P.T.ShareOf(fty, i)
        q := k if k >= 0 else i
        if vars[v] != q { continue }
        match s.unAway(c.Args[i]) {
            case typed.Expr.Data(_, _, _, _) { any = true }
            case _ { return false }
        }
    }
    return any
}

# whether a call's result passed on as an argument lands by its obligations (O18c): its arguments' terms, read without
# judging them, give it a scope to land in
fn (s mut Scoper&) argLands(a typed.Expr&) Bool { return s.landTerm(a) != Term.None }

# where a call's result lands by its obligations (O18c), read off its arguments without judging them; None where it does
# not
fn (s mut Scoper&) landTerm(a typed.Expr&) Term {
    c := s.callOf(a)
    if c == null { return Term.None }
    fty := s.calleeType(c)
    callee := s.bodyOf(c.Target)
    if callee < 0 or not s.summed(callee) { return Term.None }
    # a constructor's instance is built where its parameter is bound, C2d holding it to what it holds (O18b)
    if s.P.T.Role(fty) == types.RoleCtor { return Term.None }
    rv := s.resultVarOf(fty)
    if rv < 0 { return Term.None }
    vars := s.P.T.ScopeVarsOf(fty)
    beta := Array<Term>(vars.Len())
    for i in range c.Args.Len() {
        k := s.P.T.ShareOf(fty, i)
        q := k if k >= 0 else i
        for v in range vars.Len() {
            if vars[v] == q and beta[v] == Term.None { beta[v] = s.peekTerm(c.Args[i]) }
        }
    }
    return s.landByObligations(c, rv, beta)
}

# an argument's term read off its shape without judging it: a local's or a field's read or borrow; None for anything else
fn (s mut Scoper&) peekTerm(a typed.Expr&) Term {
    if a == null { return Term.None }
    return match a {
        case typed.Expr.Read(_, ty, p, _) => s.peekPlace(p, true) if s.holds(ty) else Term.None
        case typed.Expr.Borrow(_, _, p) => s.peekBorrow(p)
        case typed.Expr.Away(_, _, y) => s.peekTerm(y)
        case _ => Term.None
    }
}

# a borrow's term read off its shape: its place's storage - a temporary's (a handle a call gives, lent as its reference,
# O17b) where its value's references are, which its call's landing says before it is judged (O18c)
fn (s mut Scoper&) peekBorrow(p typed.Place&) Term {
    match p {
        case typed.Place.Temp(_, _, v, site) {
            t := try s.temps.Get(I64(site)) catch default Term.None
            if t != Term.None { return t }
            if s.isHandle(v.Type()) { return s.landTerm(v) }
            return Term.None
        }
        case _ { return s.peekPlace(p, false) }
    }
}

# a place's parts' term (parts) or its storage's, as partsTerm and storOf give them, where that needs no judging
fn (s mut Scoper&) peekPlace(p typed.Place&, parts Bool) Term {
    return match p {
        case typed.Place.Local(_, _, id) => s.whereLives(id) if parts else s.stors[I64(id)]
        case typed.Place.Global(_, _, _, _) => Term.Program
        case typed.Place.Field(_, _, base, _) => s.peekPlace(base, parts)
        case typed.Place.Payload(_, _, pl) => s.peekPlace(pl.Base, parts)
        case typed.Place.Elem(_, _, e) => s.peekPlace(e.Base, parts or s.runLength(e.Base.Type()))
        case typed.Place.Deref(_, _, r) => s.peekTerm(r)
        # a temporary judged already: where its value's references are (tempTerm)
        case typed.Place.Temp(_, _, _, site) => (try s.temps.Get(I64(site)) catch default Term.None) if parts else Term.None
        case _ => Term.None
    }
}

fn (s mut Scoper&) runLength(t types.TypeId) Bool {
    return s.P.T.KindOf(t) == types.Kind.Array and s.P.T.Length(t) == types.TypeId(0)
}

# whether a call's result holds what an argument living in one of this function's blocks refers to: its callee holds
# that argument's scope to outlive its result scope (O26a: such a local is not moved by a flow)
fn (s mut Scoper&) tiedToBlock(x typed.Expr&) Bool {
    c := s.callOf(x)
    if c == null { return false }
    fty := s.calleeType(c)
    callee := s.bodyOf(c.Target)
    if callee < 0 or not s.sums[callee].Done { return false }
    rv := s.resultVarOf(fty)
    vars := s.P.T.ScopeVarsOf(fty)
    for r in s.sums[callee].Rels {
        if r.Lo != Term.Var(rv) { continue }
        match r.Hi {
            case Term.Var(v) {
                for i in range c.Args.Len() {
                    k := s.P.T.ShareOf(fty, i)
                    q := k if k >= 0 else i
                    if v < vars.Len() and vars[v] == q and s.isBlock(s.peekTerm(c.Args[i])) { return true }
                }
            }
            case _ { }
        }
    }
    return false
}

# ---- the flow analysis (O26a, O18c), read off the rest of a block as written ----

fn flHas(xs List<I64>&, x I64) Bool {
    for y in xs {
        if y == x { return true }
    }
    return false
}

fn (s mut Scoper&) flAdd(x I64) {
    if x < 0 or flHas(s.fl, x) { return }
    s.fl.Push(x)
    s.flGrew = true
}

# mode 0 asks which locals the function returns, seeded with those living in the result scope already; mode 1 whether
# local l is kept beyond its block
fn (s mut Scoper&) flowStart(l typed.LocalId, mode I64) {
    s.fl.Clear()
    s.flDirect.Clear()
    s.flKept = false
    s.flMode = mode
    s.flBlock = s.B.Locals[I64(l)].In
    if mode == 1 {
        s.fl.Push(I64(l))
        return
    }
    # what already lives where the result goes - the parameter a borrowed result is borrowed from too: what is stored
    # into its referent is where the result is (O26a's home)
    rt := s.resultTerm(0)
    for k in range s.terms.Len() {
        if s.terms[k] == rt { s.fl.Push(k) }
    }
}

fn (s mut Scoper&) flowRun(ss Array<typed.Stmt&>&, from I64) {
    for pass in range 6 {
        s.flGrew = false
        for i in range from, ss.Len() { s.flStmt(ss[i]) }
        if not s.flGrew or s.flKept { break }
    }
}

fn (s mut Scoper&) flBlockOf(b typed.Block&) {
    if b == null { return }
    for st in b.Stmts { s.flStmt(st) }
}

fn (s mut Scoper&) flStmt(st typed.Stmt&) {
    if st == null { return }
    match st {
        case typed.Stmt.Let(_, l, x) {
            s.flExpr(x)
            s.flInto(I64(l), s.B.Locals[I64(l)].Ty, x, false, true)
        }
        case typed.Stmt.Assign(_, p, x) {
            s.flPlace(p)
            s.flExpr(x)
            r := s.flPlaceRoot(p)
            # a copy stored into a part of what flows into the result keeps its references where the source's are
            # (O25h), so the source flows too: "p.Lengths = lengths" then "return Checker(p)"; only a copy taking a
            # local's whole place is the copy's own
            whole := match p {
                case typed.Place.Local(_, _, _) => true
                case _ => false
            }
            s.flInto(r, p.Type(), x, flThroughRef(p) or r < 0 or s.outside(r), whole)
        }
        case typed.Stmt.Eval(_, x) { s.flExpr(x) }
        case typed.Stmt.If(_, i) {
            s.flExpr(i.Test)
            s.flBlockOf(i.Then)
            s.flBlockOf(i.Else)
        }
        case typed.Stmt.Loop(_, body, post) {
            s.flBlockOf(body)
            s.flBlockOf(post)
        }
        case typed.Stmt.Return(_, x) {
            s.flExpr(x)
            if x == null { return }
            if s.flMode == 0 {
                xs List<I64>
                s.carried(x, xs)
                s.returnedArrays(x, xs)
                for k in xs {
                    s.flAdd(k)
                    if not flHas(s.flDirect, k) { s.flDirect.Push(k) }
                }
            } else if s.carries(x) {
                s.flKept = true
            }
        }
        case typed.Stmt.Assert(_, c, m) {
            s.flExpr(c)
            s.flExpr(m)
        }
        case typed.Stmt.Block(_, b) { s.flBlockOf(b) }
        case typed.Stmt.Defer(_, b) { s.flBlockOf(b) }
        case typed.Stmt.Join(_, jn) {
            s.flBlockOf(jn.Code)
            for c in jn.Clauses { s.flBlockOf(c.Code) }
        }
        case typed.Stmt.Spawn(_, sw) {
            s.flExpr(sw.Task)
            if s.flMode == 1 and s.carries(sw.Task) { s.flKept = true }
        }
        case typed.Stmt.Yield(_, x) {
            s.flExpr(x)
            if s.flMode == 1 and s.carries(x) { s.flKept = true }
        }
        case _ { }
    }
}

# a value x put into local r's storage (or a part of it) of type ty: in mode 0 what x carries joins where r is in the
# set, but for a plain copy of a value local, which is no flow (O25h); in mode 1 r joins where x carries the local, or
# the local is kept where r is outside its block
fn (s mut Scoper&) flInto(r I64, ty types.TypeId, x typed.Expr&, outside Bool, whole Bool) {
    if x == null or not s.holds(ty) { return }
    if s.flMode == 0 {
        if r >= 0 and flHas(s.fl, r) and not (whole and s.plainCopyOf(x, ty)) {
            xs List<I64>
            s.carried(x, xs)
            for k in xs { s.flAdd(k) }
        }
        return
    }
    if not s.carries(x) { return }
    if outside {
        s.flKept = true
        return
    }
    s.flAdd(r)
}

# whether x reads a value local as a plain copy of it (O25h)
fn (s mut Scoper&) plainCopyOf(x typed.Expr&, ty types.TypeId) Bool {
    if s.isRef(ty) { return false }
    match x {
        case typed.Expr.Read(_, rt, p, _) {
            if s.isRef(rt) { return false }
            match p {
                case typed.Place.Local(_, _, _) { return true }
                case _ { }
            }
        }
        case _ { }
    }
    return false
}

# whether local r lives outside the analysed local's block: a parameter, a capture, or one of an enclosing block
fn (s mut Scoper&) outside(r I64) Bool {
    loc := s.B.Locals[r]
    if loc.Kind == typed.LocalKind.Param or loc.Kind == typed.LocalKind.Capture { return true }
    return not s.B.Encloses(s.flBlock, loc.In)
}

fn (s mut Scoper&) flPlace(p typed.Place&) {
    match p {
        case typed.Place.Deref(_, _, r) { s.flExpr(r) }
        case typed.Place.Field(_, _, b, _) { s.flPlace(b) }
        case typed.Place.Elem(_, _, e) {
            s.flPlace(e.Base)
            s.flExpr(e.Index)
        }
        case typed.Place.Payload(_, _, pl) { s.flPlace(pl.Base) }
        case typed.Place.Temp(_, _, v, _) { s.flExpr(v) }
        case _ { }
    }
}

# the expressions in x walked for the statements and method calls in them
fn (s mut Scoper&) flExpr(x typed.Expr&) {
    if x == null { return }
    match x {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Take(_, _, p), typed.Expr.Borrow(_, _, p) { s.flPlace(p) }
        case typed.Expr.Promote(_, _, pr) { s.flExpr(pr.X) }
        case typed.Expr.Call(_, _, c) {
            match c.Target {
                case typed.Callee.Value(f) { s.flExpr(f) }
                case _ { }
            }
            for a in c.Args { s.flExpr(a) }
            s.flCall(c)
        }
        case typed.Expr.Make(_, _, m) {
            s.flExpr(m.Length)
            for it in m.Items { s.flExpr(it) }
        }
        case typed.Expr.Collect(_, _, c) {
            s.flExpr(c.Reserve)
            s.flBlockOf(c.Loop)
        }
        case typed.Expr.Prim(_, _, _, _, args) {
            for a in args { s.flExpr(a) }
        }
        case typed.Expr.Slice(_, _, sl) {
            s.flPlace(sl.Base)
            s.flExpr(sl.Lo)
            s.flExpr(sl.Hi)
        }
        case typed.Expr.Cond(_, _, c) {
            s.flExpr(c.C)
            s.flExpr(c.A)
            s.flExpr(c.B)
        }
        case typed.Expr.Seq(_, _, q) {
            for st in q.Stmts { s.flStmt(st) }
            s.flExpr(q.X)
        }
        case typed.Expr.Match(_, _, m) {
            for st in m.Held { s.flStmt(st) }
            for a in m.Arms { s.flArm(a) }
            s.flArm(m.NoMatch)
        }
        case typed.Expr.Try(_, _, t) {
            s.flExpr(t.X)
            for c in t.Clauses {
                s.flBlockOf(c.Code)
                for df in c.Defaults { s.flExpr(df) }
            }
        }
        case typed.Expr.Text(_, _, t) {
            for pc in t.Pieces {
                match pc {
                    case typed.Piece.Render(r) { s.flExpr(r) }
                    case _ { }
                }
            }
        }
        case typed.Expr.Away(_, _, y) { s.flExpr(y) }
        case _ { }
    }
}

fn (s mut Scoper&) flArm(a typed.Arm&) {
    if a == null { return }
    for alt in a.Alts {
        s.flExpr(alt.Test)
        for bd in alt.Binds { s.flExpr(bd.From) }
    }
    s.flExpr(a.Guard)
    s.flBlockOf(a.Code)
    s.flExpr(a.Value)
}

# a method call on a local: what its other arguments carry is handed to it (mode 0: joins where the receiver is in the
# set); in mode 1 an argument carrying the local, handed to a call that can keep it in another argument, is kept where
# that argument is outside the block, and joins that argument's local otherwise
fn (s mut Scoper&) flCall(c typed.Call&) {
    n := c.Args.Len()
    if n == 0 { return }
    if s.flMode == 0 {
        if not s.isMethodCall(c) { return }
        r := flRootExpr(c.Args[0])
        if r < 0 or not flHas(s.fl, r) { return }
        for j in range 1, n {
            if s.canKeep(c, j) {
                xs List<I64>
                s.carried(c.Args[j], xs)
                for k in xs { s.flAdd(k) }
            }
        }
        return
    }
    for j in range n {
        if not s.canKeep(c, j) or not s.carries(c.Args[j]) { continue }
        for k in range n {
            if k == j { continue }
            r := flRootExpr(c.Args[k])
            if r < 0 { continue }
            if s.outside(r) or flThroughRefExpr(c.Args[k]) {
                s.flKept = true
                return
            }
            s.flAdd(r)
        }
    }
}

fn (s mut Scoper&) isMethodCall(c typed.Call&) Bool {
    match c.Target {
        case typed.Callee.Body(id) {
            match s.Bodies[I64(id)].Of {
                case typed.BodyOf.Fn(inst) { return s.P.FnDecl(s.P.InstanceFn(inst)).Recv != null }
                case _ { }
            }
        }
        case _ { }
    }
    return false
}

# whether a callee can keep argument j beyond the call - in its result, its receiver or another argument, as its
# obligations say (O10b); a body not known, or not judged to the end, can
fn (s mut Scoper&) canKeep(c typed.Call&, j I64) Bool {
    fty := s.calleeType(c)
    if fty == types.UnknownT { return true }
    match c.Target {
        case typed.Callee.Extern(_), typed.Callee.Helper(_, _) { return false }
        case _ { }
    }
    if s.P.T.Role(fty) == types.RoleCtor { return true }
    e := s.P.T.ResultFrom(fty, 0)
    if e == j or e == types.FromTypeVar { return true }
    # an argument sharing the scope the result is borrowed from may be what is handed back (O13)
    if e >= 0 and s.P.T.ShareOf(fty, j) == e { return true }
    callee := s.bodyOf(c.Target)
    if callee < 0 or not s.sums[callee].Done { return true }
    vars := s.P.T.ScopeVarsOf(fty)
    k := s.P.T.ShareOf(fty, j)
    q := k if k >= 0 else j
    for v in range vars.Len() {
        if vars[v] != q { continue }
        for r in s.sums[callee].Rels {
            if r.Hi == Term.Var(v) or (r.Exact and r.Lo == Term.Var(v)) { return true }
        }
    }
    return false
}

# whether x carries what local l refers to, or its storage, where it is put (mode 1's local is fl's first)
fn (s mut Scoper&) carries(x typed.Expr&) Bool {
    xs List<I64>
    s.carried(x, xs)
    for k in xs {
        if flHas(s.fl, k) { return true }
    }
    return false
}

# the array value locals a return gives whole - a result, or one of several: what is returned shares their storage
# (T7b), so they live where the result goes (O26a)
fn (s mut Scoper&) returnedArrays(x typed.Expr&, out mut List<I64>&) {
    if x == null { return }
    match x {
        case typed.Expr.Read(_, ty, p, _) {
            if s.arenaValue(ty) and wholeLocal(p) >= 0 { out.Push(wholeLocal(p)) }
        }
        case typed.Expr.Make(_, _, m) {
            if m.Kind == typed.MakeKind.Tuple {
                for it in m.Items { s.returnedArrays(it, out) }
            }
        }
        case typed.Expr.Away(_, _, y) { s.returnedArrays(y, out) }
        case _ { }
    }
}

# the locals a value carries where it is put: one it reads that holds references, one whose storage it borrows or
# slices, through what is built from them - a call's argument it can keep, an item, a choice's values
fn (s mut Scoper&) carried(x typed.Expr&, out mut List<I64>&) {
    if x == null { return }
    match x {
        case typed.Expr.Read(_, ty, p, _), typed.Expr.Take(_, ty, p) {
            if s.holds(ty) { s.carriedPlace(p, out) }
        }
        case typed.Expr.Borrow(_, _, p) { s.carriedPlace(p, out) }
        case typed.Expr.Slice(_, _, sl) { s.carriedPlace(sl.Base, out) }
        case typed.Expr.Promote(_, _, pr) { s.carried(pr.X, out) }
        case typed.Expr.Call(_, ty, c) {
            if not s.holds(ty) { return }
            for j in range c.Args.Len() {
                if s.canKeep(c, j) { s.carried(c.Args[j], out) }
            }
        }
        case typed.Expr.Make(_, _, m) {
            for it in m.Items { s.carried(it, out) }
        }
        case typed.Expr.Prim(_, ty, op, _, args) {
            if op == typed.PrimOp.Convert and args.Len() > 0 and s.holds(ty) { s.carried(args[0], out) }
        }
        case typed.Expr.Cond(_, _, c) {
            s.carried(c.A, out)
            s.carried(c.B, out)
        }
        case typed.Expr.Seq(_, _, q) { s.carried(q.X, out) }
        case typed.Expr.Match(_, _, m) {
            for a in m.Arms {
                if a != null { s.carried(a.Value, out) }
            }
            if m.NoMatch != null { s.carried(m.NoMatch.Value, out) }
        }
        case typed.Expr.Try(_, _, t) {
            s.carried(t.X, out)
            for c in t.Clauses {
                for df in c.Defaults { s.carried(df, out) }
            }
        }
        case typed.Expr.Away(_, _, y) { s.carried(y, out) }
        case typed.Expr.Fn(_, _, f) {
            # a lambda returned moves nothing it captured into the result scope: each capture is an obligation (D16d);
            # an instance adapted through its Call is the value itself (E31)
            match f {
                case typed.FnVal.Lambda(_, caps, _) {
                    if not s.flCaps { return }
                    for cp in caps { s.carried(cp.Outer, out) }
                }
                case typed.FnVal.Adapter(_, r, _) { s.carried(r, out) }
                case _ { }
            }
        }
        case _ { }
    }
}

fn (s mut Scoper&) carriedPlace(p typed.Place&, out mut List<I64>&) {
    r := flRoot(p)
    if r >= 0 and not flHas(out, r) { out.Push(r) }
    match p {
        case typed.Place.Deref(_, _, e) { s.carried(e, out) }
        case _ { }
    }
}

# the local a place is rooted at - through a reference read out of one too - else -1
# the local a place is rooted at, through a call's result borrowed from an argument too (O13): storing into what
# c.cur() names stores into what c reaches
fn (s mut Scoper&) flPlaceRoot(p typed.Place&) I64 {
    return match p {
        case typed.Place.Field(_, _, b, _) => s.flPlaceRoot(b)
        case typed.Place.Elem(_, _, e) => s.flPlaceRoot(e.Base)
        case typed.Place.Payload(_, _, pl) => s.flPlaceRoot(pl.Base)
        case typed.Place.Deref(_, _, r) => s.flExprRoot(r)
        case typed.Place.Temp(_, _, v, _) => s.flExprRoot(v)
        case _ => flRoot(p)
    }
}

fn (s mut Scoper&) flExprRoot(x typed.Expr&) I64 {
    if x == null { return -1 }
    match x {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p), typed.Expr.Take(_, _, p) { return s.flPlaceRoot(p) }
        case typed.Expr.Away(_, _, y) { return s.flExprRoot(y) }
        case typed.Expr.Call(_, _, c) {
            e := s.P.T.ResultFrom(s.calleeType(c), 0)
            if e >= 0 and e < c.Args.Len() { return s.flExprRoot(c.Args[e]) }
        }
        case _ { }
    }
    return -1
}

fn flRoot(p typed.Place&) I64 {
    return match p {
        case typed.Place.Local(_, _, id) => I64(id)
        case typed.Place.Field(_, _, b, _) => flRoot(b)
        case typed.Place.Elem(_, _, e) => flRoot(e.Base)
        case typed.Place.Payload(_, _, pl) => flRoot(pl.Base)
        case typed.Place.Deref(_, _, r) => flRootExpr(r)
        case _ => -1
    }
}

fn flRootExpr(x typed.Expr&) I64 {
    if x == null { return -1 }
    return match x {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p), typed.Expr.Take(_, _, p) => flRoot(p)
        case typed.Expr.Away(_, _, y) => flRootExpr(y)
        case _ => -1
    }
}

# whether a place goes through a reference: what it names is not its root's own storage
fn flThroughRef(p typed.Place&) Bool {
    return match p {
        case typed.Place.Deref(_, _, _) => true
        case typed.Place.Field(_, _, b, _) => flThroughRef(b)
        case typed.Place.Elem(_, _, e) => flThroughRef(e.Base)
        case typed.Place.Payload(_, _, pl) => flThroughRef(pl.Base)
        case _ => false
    }
}

fn flThroughRefExpr(x typed.Expr&) Bool {
    if x == null { return false }
    return match x {
        case typed.Expr.Read(_, ty, p, _) => flThroughRef(p)
        case typed.Expr.Borrow(_, _, p) => flThroughRef(p)
        case _ => false
    }
}

# ---- what a body keeps in what its reference parameters name (O17, O17b) ----

# by parameter: whether the body may keep something in the storage a reference parameter names - store a value holding
# references into a part of it, hand a reference into it on to a callee that may, return or keep one - read off the
# checked body. A value whose references live elsewhere than its own storage is lent only to a callee keeping nothing in
# it (O17), and a handle a call gives is lent as its reference to one (O17b)
fn (s mut Scoper&) computeKeeps(b typed.Body&) {
    s.kept.Clear()
    s.keptStore.Clear()
    s.keptPut.Clear()
    for i in range b.Locals.Len() {
        s.kept.Push(false)
        s.keptStore.Push(false)
        s.keptPut.Push(false)
    }
    s.aliasOf.Clear()
    for i in range b.Locals.Len() { s.aliasOf.Push(-1) }
    s.aliasBlock(b.Root)
    s.regionLocals(b)
    s.kwBlock(b.Root)
    s.sums[s.Id].Keeps.Clear()
    s.sums[s.Id].Stores.Clear()
    s.sums[s.Id].Puts.Clear()
    for p in b.Params {
        s.sums[s.Id].Keeps.Push(s.kept[I64(p)])
        s.sums[s.Id].Stores.Push(s.keptStore[I64(p)])
        s.sums[s.Id].Puts.Push(s.keptPut[I64(p)])
    }
    s.sums[s.Id].CapKeeps.Clear()
    s.sums[s.Id].CapStores.Clear()
    s.sums[s.Id].CapPuts.Clear()
    if s.isLambda(b) {
        for i in range b.Locals.Len() {
            s.sums[s.Id].CapKeeps.Push(s.kept[i])
            s.sums[s.Id].CapStores.Push(s.keptStore[i])
            s.sums[s.Id].CapPuts.Push(s.keptPut[i])
        }
    }
}

fn (s mut Scoper&) isLambda(b typed.Body&) Bool {
    return match b.Of {
        case typed.BodyOf.Lambda(_) => true
        case _ => false
    }
}

# whether local l is one whose region O17 asks about: a reference parameter, or a lambda's capture of a reference
fn (s mut Scoper&) regionKind(l I64) Bool {
    k := s.B.Locals[l].Kind
    return k == typed.LocalKind.Param or (k == typed.LocalKind.Capture and s.isLambda(s.B))
}

# the region a place is in (O17): the reference parameter it is reached from through a reference - what that parameter
# names, or storage reached from there - else -1
fn (s mut Scoper&) regionOf(p typed.Place&) I64 {
    if not flThroughRef(p) { return -1 }
    r := s.regionParam(flRoot(p))
    if r < 0 or not s.regionKind(r) or not s.isRef(s.B.Locals[r].Ty) { return -1 }
    return r
}

# whether a place reaches what it names through a "&q" field of a struct (C2d): it is then where q's argument lived -
# the instance's binding, a derived scope (O23a) - never the storage or the references of the value it starts from
fn (s mut Scoper&) throughDerived(p typed.Place&) Bool {
    return match p {
        case typed.Place.Deref(_, _, r) => s.throughDerivedExpr(r) or s.derivedRead(r)
        case typed.Place.Field(_, _, b, _) => s.throughDerived(b)
        case typed.Place.Elem(_, _, e) => s.throughDerived(e.Base)
        case typed.Place.Payload(_, _, pl) => s.throughDerived(pl.Base)
        case _ => false
    }
}

fn (s mut Scoper&) throughDerivedExpr(x typed.Expr&) Bool {
    return match s.unAway(x) {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p) => s.throughDerived(p)
        case _ => false
    }
}

# whether x reads a "&q" field of a struct, the reference it holds
fn (s mut Scoper&) derivedRead(x typed.Expr&) Bool {
    match s.unAway(x) {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Place.Field(_, _, b, i) {
                    if not s.isStruct(b.Type()) { return false }
                    return match s.fieldMark(b.Type(), i) {
                        case typed.Mark.Of(_) => true
                        case _ => false
                    }
                }
                case _ { }
            }
        }
        case _ { }
    }
    return false
}

# the reference parameter whose region what local l refers to is in: l's own, a second name's for one, or a reference
# l holds only reads of a region into ("s := l.s; s.tail[i] = x" stores into l's region, O17); else l
fn (s mut Scoper&) regionParam(l I64) I64 {
    if l < 0 { return l }
    if l < s.aliasOf.Len() and s.aliasOf[l] >= 0 { return s.aliasOf[l] }
    if l < s.regionOnly.Len() and s.regionOnly[l] >= 0 and s.isRef(s.B.Locals[l].Ty) { return s.regionOnly[l] }
    return l
}

# the reference locals declared as second names for a reference parameter (a for-in's hidden cursor): "c := p" - or
# for a part of what it names, never assigned after ("for x in p.L" walks a borrow of p.L): what is done with them is
# done with the parameter's region
fn (s mut Scoper&) aliasBlock(bl typed.Block&) {
    if bl == null { return }
    for st in bl.Stmts {
        match st {
            case typed.Stmt.Let(_, l, x) {
                p := regionLocal(s.unAway(x))
                if p < 0 and not s.reassigned(I64(l)) {
                    match s.unAway(x) {
                        case typed.Expr.Borrow(_, _, bp) { p = regionRoot(bp) }
                        case _ { }
                    }
                }
                # a constructor's field is the instance's slot, never a second name: what it holds, the instance keeps
                field := s.B.Locals[I64(l)].Kind == typed.LocalKind.Field
                if p >= 0 and not field and s.isRef(s.B.Locals[I64(l)].Ty) and s.isRef(s.B.Locals[p].Ty) {
                    if s.aliasOf[p] >= 0 { p = s.aliasOf[p] }
                    if s.regionKind(p) { s.aliasOf[I64(l)] = p }
                }
            }
            case typed.Stmt.If(_, i) {
                s.aliasBlock(i.Then)
                s.aliasBlock(i.Else)
            }
            case typed.Stmt.Loop(_, body, post) {
                s.aliasBlock(body)
                s.aliasBlock(post)
            }
            case typed.Stmt.Block(_, b), typed.Stmt.Defer(_, b) { s.aliasBlock(b) }
            case typed.Stmt.Join(_, jn) { s.aliasBlock(jn.Code) }
            case _ { }
        }
    }
}

# whether x brings nothing new into parameter r's region (O17): a value read out of it through a reference, or a local
# holding only such reads
fn (s mut Scoper&) regionRead(x typed.Expr&, r I64) Bool {
    if x == null { return true }
    match x {
        case typed.Expr.Read(_, _, p, _) {
            if s.regionOf(p) == r { return true }
            # anything read out of a local holding only what it read out of the region
            l := flRoot(p)
            return l >= 0 and l < s.regionOnly.Len() and s.regionOnly[l] == r
        }
        # null, and constant data, which lives for the program, bring nothing that is built
        case typed.Expr.Lit(_, _, _), typed.Expr.Data(_, _, _, _) { return true }
        case typed.Expr.Away(_, _, y) { return s.regionRead(y, r) }
        case typed.Expr.Cond(_, _, c) { return s.regionRead(c.A, r) and s.regionRead(c.B, r) }
        case typed.Expr.Prim(_, _, op, _, args) { return op == typed.PrimOp.Convert and args.Len() > 0 and s.regionRead(args[0], r) }
        case typed.Expr.Seq(_, _, q) { return q.Stmts.Len() == 0 and s.regionRead(q.X, r) }
        # a result borrowed from what the region hands the call - "s.tail = s.chunk(k)" - is storage of the region
        case typed.Expr.Call(_, _, c) {
            fty := s.calleeType(c)
            if fty == types.UnknownT { return false }
            e := s.P.T.ResultFrom(fty, 0)
            if e < 0 or e >= c.Args.Len() { return false }
            a := c.Args[e]
            return s.regionParam(s.handedRegion(a)) == r or s.regionRead(a, r)
        }
        case _ { }
    }
    return false
}

# the locals holding only what they read out of one parameter's region (O17: "t := a[i]  a[i] = a[j]  a[j] = t"): each
# written only with such reads - its declaration, an assignment to it or to a part of it - and never lent writably nor
# given a task's result; by local, the parameter, -1 for none. A fixed point: a local failing frees no other
fn (s mut Scoper&) regionLocals(b typed.Body&) {
    s.regionOnly.Clear()
    for i in range b.Locals.Len() { s.regionOnly.Push(-1) }
    # a candidate: a local declared from a region read
    s.rlBlock(b.Root, 0)
    for round in range 8 {
        s.rlChanged = false
        s.rlBlock(b.Root, 1)
        if not s.rlChanged { break }
    }
}

fn (s mut Scoper&) rlBlock(bl typed.Block&, pass I64) {
    if bl == null { return }
    for st in bl.Stmts { s.rlStmt(st, pass) }
}

fn (s mut Scoper&) rlDrop(l I64) {
    if l >= 0 and l < s.regionOnly.Len() and s.regionOnly[l] >= 0 {
        s.regionOnly[l] = -1
        s.rlChanged = true
    }
}

fn (s mut Scoper&) rlStmt(st typed.Stmt&, pass I64) {
    if st == null { return }
    match st {
        case typed.Stmt.Let(_, l, x) {
            if pass == 0 {
                match s.unAway(x) {
                    case typed.Expr.Read(_, _, p, _) {
                        k := s.regionOf(p)
                        if k >= 0 and s.B.Locals[I64(l)].Kind != typed.LocalKind.Param { s.regionOnly[I64(l)] = k }
                    }
                    case _ { }
                }
            }
            s.rlExpr(x, pass)
        }
        case typed.Stmt.Assign(_, p, x) {
            if pass == 1 and not flThroughRef(p) {
                r := flRoot(p)
                if r >= 0 and r < s.regionOnly.Len() and s.regionOnly[r] >= 0 and not s.regionRead(x, s.regionOnly[r]) { s.rlDrop(r) }
            }
            s.rlExpr(x, pass)
        }
        case typed.Stmt.Eval(_, x), typed.Stmt.Return(_, x), typed.Stmt.Yield(_, x) { s.rlExpr(x, pass) }
        case typed.Stmt.If(_, i) {
            s.rlExpr(i.Test, pass)
            s.rlBlock(i.Then, pass)
            s.rlBlock(i.Else, pass)
        }
        case typed.Stmt.Loop(_, body, post) {
            s.rlBlock(body, pass)
            s.rlBlock(post, pass)
        }
        case typed.Stmt.Assert(_, c, m) {
            s.rlExpr(c, pass)
            s.rlExpr(m, pass)
        }
        case typed.Stmt.Block(_, bl), typed.Stmt.Defer(_, bl) { s.rlBlock(bl, pass) }
        case typed.Stmt.Join(_, jn) {
            s.rlBlock(jn.Code, pass)
            for c in jn.Clauses { s.rlBlock(c.Code, pass) }
        }
        case typed.Stmt.Spawn(_, sw) {
            if pass == 1 {
                for p in sw.Targets {
                    if not flThroughRef(p) { s.rlDrop(flRoot(p)) }
                }
            }
            s.rlExpr(sw.Task, pass)
        }
        case _ { }
    }
}

# a value's lends of a candidate: a borrow of it - or a part of it - for a writable reference, which may be written
fn (s mut Scoper&) rlExpr(x typed.Expr&, pass I64) {
    if x == null or pass == 0 { return }
    match x {
        case typed.Expr.Borrow(_, ty, p) {
            if not flThroughRef(p) and (s.P.T.PermOf(ty) & types.Writable) != 0 { s.rlDrop(flRoot(p)) }
        }
        case typed.Expr.Promote(_, _, pr) { s.rlExpr(pr.X, pass) }
        case typed.Expr.Call(_, _, c) {
            for a in c.Args { s.rlExpr(a, pass) }
        }
        case typed.Expr.Make(_, _, m) {
            for it in m.Items { s.rlExpr(it, pass) }
        }
        case typed.Expr.Prim(_, _, _, _, args) {
            for a in args { s.rlExpr(a, pass) }
        }
        case typed.Expr.Cond(_, _, c) {
            s.rlExpr(c.A, pass)
            s.rlExpr(c.B, pass)
        }
        case typed.Expr.Seq(_, _, q) {
            for st in q.Stmts { s.rlStmt(st, pass) }
            s.rlExpr(q.X, pass)
        }
        case typed.Expr.Match(_, _, m) {
            for st in m.Held { s.rlStmt(st, pass) }
            for a in m.Arms {
                if a != null {
                    s.rlBlock(a.Code, pass)
                    s.rlExpr(a.Value, pass)
                }
            }
            if m.NoMatch != null { s.rlBlock(m.NoMatch.Code, pass) }
        }
        case typed.Expr.Try(_, _, t) {
            s.rlExpr(t.X, pass)
            for c in t.Clauses { s.rlBlock(c.Code, pass) }
        }
        case typed.Expr.Fn(_, _, f) {
            match f {
                case typed.FnVal.Lambda(_, caps, _) {
                    # a lambda copying a candidate in may write the copy, not the candidate; but a borrow is a lend
                    for cp in caps { s.rlExpr(cp.Outer, pass) }
                }
                case _ { }
            }
        }
        case typed.Expr.Away(_, _, y) { s.rlExpr(y, pass) }
        case _ { }
    }
}

fn (s mut Scoper&) keepParam(id I64) {
    if id >= 0 and id < s.aliasOf.Len() and s.aliasOf[id] >= 0 { id = s.aliasOf[id] }
    if id >= 0 and id < s.kept.Len() and s.regionKind(id) and s.isRef(s.B.Locals[id].Ty) {
        s.kept[id] = true
    }
}

# a parameter whose region the body stores into, or hands a writable reference into out (O17): kept, and more - put
# when it is a store itself
fn (s mut Scoper&) storeParam(id I64, put Bool) {
    id = s.regionParam(id)
    if id >= 0 and id < s.kept.Len() and s.regionKind(id) and s.isRef(s.B.Locals[id].Ty) {
        s.kept[id] = true
        s.keptStore[id] = true
        if put { s.keptPut[id] = true }
    }
}

fn (s mut Scoper&) kwBlock(b typed.Block&) {
    if b == null { return }
    for i in range b.Stmts.Len() {
        st := b.Stmts[i]
        # a capturing lambda held in a local only ever called never leaves the frame (D16c)
        match st {
            case typed.Stmt.Let(_, l, x) {
                if s.capturingLambda(x) and s.ocStmts(b.Stmts, i + 1, I64(l), false) { s.kwTransient = true }
            }
            case _ { }
        }
        s.kwStmt(st)
        s.kwTransient = false
    }
}

fn (s mut Scoper&) kwStmt(st typed.Stmt&) {
    if st == null { return }
    match st {
        case typed.Stmt.Let(_, l, x) {
            # a second name for a reference parameter: what is done with it is done with the parameter
            if s.aliasOf[I64(l)] >= 0 {
                match s.unAway(x) {
                    case typed.Expr.Borrow(_, _, bp) { s.kwPlace(bp) }
                    case _ { }
                }
                return
            }
            s.kwExpr(x, false)
        }
        case typed.Stmt.Assign(_, p, x) {
            s.kwPlace(p)
            s.kwExpr(x, false)
            # a reference, or a value holding one, stored into a parameter's region that it did not read out of there
            # keeps something new in it (O17)
            r := s.regionOf(p)
            if r >= 0 and s.holds(p.Type()) and not s.regionRead(x, r) { s.storeParam(r, true) }
        }
        case typed.Stmt.Eval(_, x) { s.kwExpr(x, false) }
        case typed.Stmt.If(_, i) {
            s.kwExpr(i.Test, true)
            s.kwBlock(i.Then)
            s.kwBlock(i.Else)
        }
        case typed.Stmt.Loop(_, body, post) {
            s.kwBlock(body)
            s.kwBlock(post)
        }
        case typed.Stmt.Return(_, x) {
            s.kwExpr(x, false)
            # a reference into a parameter's region through which something can be stored, handed out: the caller can
            # build through it (O17) - a read-only one's writable references included ("return b.arr[0:1]" of an
            # "Array<mut Node&>"). One read through a "&q" field is not into the region: it lives where q's argument
            # did, a derived scope the call resolves (O23a) - "return it.given.entry" of a Map's iterator
            if x != null and (s.storeThrough(x.Type()) or (s.isRef(x.Type()) and s.admitsStores(x.Type()))) {
                ux := s.unAway(x)
                r := flRootExpr(ux)
                if r >= 0 and flThroughRefExpr(ux) and not s.throughDerivedExpr(ux) { s.storeParam(r, false) }
                # a slice of storage reached through the parameter's reference is a reference into it too (E16a)
                match ux {
                    case typed.Expr.Slice(_, _, sl) {
                        if flThroughRef(sl.Base) { s.storeParam(flRoot(sl.Base), false) }
                    }
                    case _ { }
                }
            }
        }
        case typed.Stmt.Assert(_, c, m) {
            s.kwExpr(c, true)
            s.kwExpr(m, true)
        }
        case typed.Stmt.Block(_, b) { s.kwBlock(b) }
        case typed.Stmt.Defer(_, b) { s.kwBlock(b) }
        case typed.Stmt.Join(_, jn) {
            s.kwBlock(jn.Code)
            for c in jn.Clauses { s.kwBlock(c.Code) }
        }
        case typed.Stmt.Spawn(_, sw) {
            for p in sw.Targets {
                s.kwPlace(p)
                # a task's result stored into a parameter's region (P1g)
                r := s.regionOf(p)
                if r >= 0 and s.holds(p.Type()) { s.storeParam(r, true) }
            }
            s.kwExpr(sw.Task, false)
            for c in sw.Clauses { s.kwExpr(c.Handler, false) }
        }
        case typed.Stmt.Yield(_, x) { s.kwExpr(x, false) }
        case _ { }
    }
}

# an expression's uses of the reference parameters: inert where its value only is looked at (a comparison, a
# condition, a rendering); a parameter's reference, or a borrow into what it names, going anywhere else keeps it
fn (s mut Scoper&) kwExpr(x typed.Expr&, inert Bool) {
    if x == null { return }
    match x {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Take(_, _, p) {
            match p {
                case typed.Place.Local(_, _, id) {
                    if not inert { s.keepParam(I64(id)) }
                    return
                }
                case _ { }
            }
            s.kwPlace(p)
        }
        case typed.Expr.Borrow(_, _, p) {
            if not inert { s.keepParam(regionRoot(p)) }
            s.kwPlace(p)
        }
        case typed.Expr.Promote(_, _, pr) { s.kwExpr(pr.X, inert) }
        case typed.Expr.Call(_, _, c) { s.kwCall(c) }
        case typed.Expr.Make(_, _, m) {
            s.kwExpr(m.Length, true)
            for it in m.Items { s.kwExpr(it, false) }
        }
        case typed.Expr.Collect(_, _, c) {
            s.kwExpr(c.Reserve, true)
            s.kwBlock(c.Loop)
        }
        case typed.Expr.Prim(_, _, _, _, args) {
            for a in args { s.kwExpr(a, true) }
        }
        case typed.Expr.Slice(_, _, sl) {
            if not inert { s.keepParam(regionRoot(sl.Base)) }
            s.kwPlace(sl.Base)
            s.kwExpr(sl.Lo, true)
            s.kwExpr(sl.Hi, true)
        }
        case typed.Expr.Cond(_, _, c) {
            s.kwExpr(c.C, true)
            s.kwExpr(c.A, inert)
            s.kwExpr(c.B, inert)
        }
        case typed.Expr.Seq(_, _, q) {
            for st in q.Stmts { s.kwStmt(st) }
            s.kwExpr(q.X, inert)
        }
        case typed.Expr.Match(_, _, m) {
            for st in m.Held { s.kwStmt(st) }
            for a in m.Arms { s.kwArm(a, inert) }
            s.kwArm(m.NoMatch, inert)
        }
        case typed.Expr.Try(_, _, t) {
            s.kwExpr(t.X, inert)
            for c in t.Clauses {
                s.kwBlock(c.Code)
                for df in c.Defaults { s.kwExpr(df, inert) }
            }
        }
        case typed.Expr.Fn(_, _, f) {
            match f {
                case typed.FnVal.Lambda(lb, caps, _) {
                    # a lambda that never leaves where it is made is judged by its body: a capture is kept where the
                    # lambda keeps or stores into it (O17, D16c)
                    tr := s.kwTransient
                    s.kwTransient = false
                    for cp in caps { s.kwCapture(I64(lb), cp, tr) }
                }
                case typed.FnVal.Adapter(_, r, _) { s.kwExpr(r, false) }
                case _ { }
            }
        }
        case typed.Expr.Text(_, _, t) {
            for pc in t.Pieces {
                match pc {
                    case typed.Piece.Render(r) { s.kwExpr(r, true) }
                    case _ { }
                }
            }
        }
        case typed.Expr.Away(_, _, y) { s.kwExpr(y, inert) }
        case _ { }
    }
}

fn (s mut Scoper&) kwCapture(lb I64, cp typed.Capture&, tr Bool) {
    sm := s.sums[lb]
    k := I64(cp.Inner)
    if not tr or not (sm.Done or sm.Judging) or k >= sm.CapKeeps.Len() {
        s.kwExpr(cp.Outer, false)
        return
    }
    if sm.CapStores[k] {
        r := regionLocal(s.unAway(cp.Outer))
        if r >= 0 { s.storeParam(r, sm.CapPuts[k]) }
    }
    s.kwExpr(cp.Outer, not sm.CapKeeps[k])
}

fn (s mut Scoper&) kwArm(a typed.Arm&, inert Bool) {
    if a == null { return }
    for alt in a.Alts {
        s.kwExpr(alt.Test, true)
        for bd in alt.Binds { s.kwExpr(bd.From, false) }
    }
    s.kwExpr(a.Guard, true)
    s.kwBlock(a.Code)
    s.kwExpr(a.Value, inert)
}

# a place's subexpressions: the reference it goes through only navigated, its indices looked at
fn (s mut Scoper&) kwPlace(p typed.Place&) {
    match p {
        case typed.Place.Deref(_, _, r) { s.kwExpr(r, true) }
        case typed.Place.Field(_, _, b, _) { s.kwPlace(b) }
        case typed.Place.Elem(_, _, e) {
            s.kwPlace(e.Base)
            s.kwExpr(e.Index, true)
        }
        case typed.Place.Payload(_, _, pl) { s.kwPlace(pl.Base) }
        case typed.Place.Temp(_, _, v, _) { s.kwExpr(v, false) }
        case _ { }
    }
}

# a call: an argument that is a parameter's reference, or a borrow into what it names, is kept where the callee may
# keep something in it
fn (s mut Scoper&) kwCall(c typed.Call&) {
    match c.Target {
        case typed.Callee.Value(f) {
            # a lambda called where it is made never leaves it (D16c)
            if s.capturingLambda(f) { s.kwTransient = true }
            s.kwExpr(f, false)
            s.kwTransient = false
        }
        case _ { }
    }
    fty := s.calleeType(c)
    ps := s.P.T.Items(s.P.T.Params(fty)) if fty != types.UnknownT else types.TypeId[]
    for k in range c.Args.Len() {
        a := c.Args[k]
        r := s.handedRegion(a)
        if r < 0 {
            # a reference into a region handed on: kept where the callee keeps it - through a function value, where
            # something can be stored through its parameter (T22a)
            ua := s.unAway(a)
            rr := flRootExpr(ua)
            if rr >= 0 and flThroughRefExpr(ua) and s.isRef(ua.Type()) {
                # a reference read out of the region names storage that lives where the region's does: kept in it only
                # by a callee storing into what it names, not by one keeping the reference
                match c.Target {
                    case typed.Callee.Value(_) {
                        if k < ps.Len() and s.storeThrough(ps[k]) { s.storeParam(rr, true) }
                    }
                    case _ {
                        if s.calleeStoresArg(c, k) { s.storeParam(rr, s.calleePutsArg(c, k)) }
                    }
                }
            }
            # a capturing lambda made for a callee keeping nothing of it never leaves the call (D16c)
            if s.capturingLambda(a) and s.transient(s.bodyOf(c.Target), k) { s.kwTransient = true }
            s.kwExpr(a, false)
            s.kwTransient = false
            continue
        }
        # a handle in the region lent as its reference to a callee using it only through that reference (O17b): the
        # region's own storage is not kept, and what the callee hands back out of where the handle's reference leads
        # is judged where it lands ("for b in f.Blocks", "f.Blocks[i]") - only what it stores there itself is a store
        # into the region ("r.tags.Push(t)")
        if s.handleLent(c, k, a) {
            if s.calleePutsArg(c, k) { s.storeParam(r, true) }
            s.kwHanded(a)
            continue
        }
        match c.Target {
            case typed.Callee.Value(_) {
                if k < ps.Len() and s.storeThrough(ps[k]) { s.storeParam(r, true) }
            }
            case _ {
                if s.calleeStoresArg(c, k) {
                    s.storeParam(r, s.calleePutsArg(c, k))
                } else if s.calleeKeepsArg(c, k) {
                    s.keepParam(r)
                }
            }
        }
        s.kwHanded(a)
    }
}

# an argument handing over a region's storage: its place's subexpressions, navigated and looked at
fn (s mut Scoper&) kwHanded(a typed.Expr&) {
    match s.unAway(a) {
        case typed.Expr.Borrow(_, _, p) { s.kwPlace(p) }
        case typed.Expr.Slice(_, _, sl) {
            s.kwPlace(sl.Base)
            s.kwExpr(sl.Lo, true)
            s.kwExpr(sl.Hi, true)
        }
        case _ { }
    }
}

# the reference parameter whose storage an argument hands over: the parameter's reference read, or a borrow into what
# it names; -1 for none
fn (s mut Scoper&) handedRegion(a typed.Expr&) I64 {
    match a {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Place.Local(_, _, id) { return I64(id) }
                case _ { }
            }
        }
        case typed.Expr.Borrow(_, _, p) { return regionRoot(p) }
        # a slice of what a parameter names is a borrow into it with its pointer and length adjusted (E16a)
        case typed.Expr.Slice(_, _, sl) { return regionRoot(sl.Base) }
        case typed.Expr.Away(_, _, y) { return s.handedRegion(y) }
        case _ { }
    }
    return -1
}

# whether a callee may keep something in what its argument k names
fn (s mut Scoper&) calleeKeepsArg(c typed.Call&, k I64) Bool {
    match c.Target {
        case typed.Callee.Body(id) {
            cb := I64(id)
            # one of the component being judged: what the rounds so far found (a least fixed point, 7.2)
            if s.sums[cb].Judging { return k < s.sums[cb].Keeps.Len() and s.sums[cb].Keeps[k] }
            if not s.sums[cb].Done or k >= s.sums[cb].Keeps.Len() { return true }
            return s.sums[cb].Keeps[k]
        }
        case typed.Callee.Extern(_), typed.Callee.Helper(_, _) { return false }
        case _ { return true }
    }
}

# whether a callee may store into what its argument k names itself, or by a callee that does (O17b)
fn (s mut Scoper&) calleePutsArg(c typed.Call&, k I64) Bool {
    match c.Target {
        case typed.Callee.Body(id) {
            cb := I64(id)
            if s.sums[cb].Judging { return k < s.sums[cb].Puts.Len() and s.sums[cb].Puts[k] }
            if not s.sums[cb].Done or k >= s.sums[cb].Puts.Len() { return true }
            return s.sums[cb].Puts[k]
        }
        case typed.Callee.Extern(_), typed.Callee.Helper(_, _) { return false }
        case _ { return true }
    }
}

# whether a callee may store into what its argument k names, or hand a writable reference into it out (O17)
fn (s mut Scoper&) calleeStoresArg(c typed.Call&, k I64) Bool {
    match c.Target {
        case typed.Callee.Body(id) {
            cb := I64(id)
            # one of the component being judged: what the rounds so far found (a least fixed point, 7.2)
            if s.sums[cb].Judging { return k < s.sums[cb].Stores.Len() and s.sums[cb].Stores[k] }
            if not s.sums[cb].Done or k >= s.sums[cb].Stores.Len() { return true }
            return s.sums[cb].Stores[k]
        }
        case typed.Callee.Extern(_), typed.Callee.Helper(_, _) { return false }
        case _ { return true }
    }
}

# the local whose referent a place is part of, reached through its reference and then only fields, payloads and the
# elements of fixed arrays (parts of that storage, not of another); -1 for none
fn regionRoot(p typed.Place&) I64 {
    return match p {
        case typed.Place.Deref(_, _, r) => regionLocal(r)
        case typed.Place.Field(_, _, b, _) => regionRoot(b)
        case typed.Place.Payload(_, _, pl) => regionRoot(pl.Base)
        case typed.Place.Elem(_, _, e) => regionRoot(e.Base)
        case _ => -1
    }
}

fn regionLocal(r typed.Expr&) I64 {
    match r {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Place.Local(_, _, id) { return I64(id) }
                case _ { }
            }
        }
        case _ { }
    }
    return -1
}

# ---- writes through x[i] (E31b) ----

# a call's argument i, for a writable reference parameter: a copy of an element no one holds - x[i] read through At, a
# field or an element of it, a "checked ... catch default" value, a conditional or a match choosing places - is written
# where the write is lost, an error; but a handle element lent as its reference to a callee using it only through it
# (O17b), and a view element lent to one writing nothing of its own storage, are lent as copies (not spawned)
fn (s mut Scoper&) writtenCopy(c typed.Call&, i I64, spawned Bool, callSp source.Span) {
    a := c.Args[i]
    how := 0
    et := types.UnknownT
    at := a.Span()
    x := s.unAway(a)
    match x {
        case typed.Expr.Promote(_, _, pr) {
            v := s.unAway(pr.X)
            if s.atCall(v) {
                how = 1
            } else if s.tryDefault(v) or s.choiceOfPlaces(v) {
                how = 2
            }
            et = v.Type()
            at = s.elemAt(v)
        }
        case typed.Expr.Borrow(_, _, p) {
            v := tempOf(p)
            if v != null {
                if s.atCall(v) {
                    how = 1
                } else if s.tryDefault(v) or s.choiceOfPlaces(v) {
                    how = 2
                }
            }
            et = p.Type()
            match p {
                case typed.Place.Temp(_, _, _, _) { at = s.elemAt(v) }
                case _ { at = s.lastName(p.Span()) }
            }
        }
        case _ { }
    }
    handle := s.isHandle(et)
    if spawned and handle and how == 1 { at = s.nameSpan(callSp) }
    if how == 0 { return }
    if not spawned {
        match c.Target {
            case typed.Callee.Body(id) {
                # a handle - x[i]'s, or a try's element or default ("(try m.Get(k) catch default L()).Push(v)") - is a
                # second name for its collection, lent as its reference to a callee using it only through it (O17b)
                if handle and s.uses(I64(id), i, UseThru) { return }
                if how == 1 and not handle and s.isStruct(et) and s.uses(I64(id), i, UseView) { return }
            }
            case _ { }
        }
    }
    s.err(at, msgs.SpawnAtElement() if spawned and handle and how == 1 else msgs.WriteThroughAtCall())
}

# where an element read is said: its "[" - the element a try reads, for a try's
fn (s mut Scoper&) elemAt(v typed.Expr&) source.Span {
    if v == null { return source.Span(0, 0) }
    sp := v.Span()
    match v {
        case typed.Expr.Try(_, _, t) {
            if t.X != null { sp = t.X.Span() }
        }
        case _ { }
    }
    text := try s.texts.Get(s.B.File) catch default ""
    for k in range I64(sp.Start), I64(sp.End) {
        if k >= text.Len() { break }
        if text[k] == '[' { return source.Span(I32(k), I32(k + 1)) }
    }
    return sp
}

fn (s mut Scoper&) unAway(x typed.Expr&) typed.Expr&x {
    if x == null { return x }
    match x {
        case typed.Expr.Away(_, _, y) { return s.unAway(y) }
        case _ { return x }
    }
}

# the value a place is part of, held in a temporary place - reached through fields, elements and payloads, no reference
fn tempOf(p typed.Place&) typed.Expr&p {
    return match p {
        case typed.Place.Temp(_, _, v, _) => v
        case typed.Place.Field(_, _, b, _) => tempOf(b)
        case typed.Place.Elem(_, _, e) => tempOf(e.Base)
        case typed.Place.Payload(_, _, pl) => tempOf(pl.Base)
        case _ => null
    }
}

# whether x reads an element through At (E31): a call of a method At, at, CheckedAt or checkedAt - under checked too
fn (s mut Scoper&) atCall(x typed.Expr&) Bool {
    if x == null { return false }
    match x {
        case typed.Expr.Try(_, _, t) { return t.Clauses.Len() == 0 and s.atCall(t.X) }
        case typed.Expr.Away(_, _, y) { return s.atCall(y) }
        case typed.Expr.Seq(_, _, q) { return s.atCall(q.X) }
        case typed.Expr.Call(_, _, c) {
            match c.Target {
                case typed.Callee.Body(id) {
                    match s.Bodies[I64(id)].Of {
                        case typed.BodyOf.Fn(inst) {
                            fd := s.P.FnDecl(s.P.InstanceFn(inst))
                            if fd.Recv == null { return false }
                            n := s.P.L.Names.Text(fd.Name)
                            return n == "At" or n == "at" or n == "CheckedAt" or n == "checkedAt"
                        }
                        case _ { }
                    }
                }
                case _ { }
            }
        }
        case _ { }
    }
    return false
}

# whether x is a try giving a default (R9a): the element or the default, a value either way
fn (s mut Scoper&) tryDefault(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Try(_, _, t) {
            for c in t.Clauses {
                if c.Defaults.Len() > 0 { return true }
            }
        }
        case _ { }
    }
    return false
}

# whether x is a conditional or a match one of whose values is a place read (E28): a value, not the place
fn (s mut Scoper&) choiceOfPlaces(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Cond(_, _, c) { return not s.isFresh(c.A) or not s.isFresh(c.B) }
        case typed.Expr.Match(_, _, m) {
            for a in m.Arms {
                if a != null and a.Value != null and not s.isFresh(a.Value) { return true }
            }
        }
        case _ { }
    }
    return false
}

# whether a struct is a handle (O17b): its only field a reference living with the instance, or another handle
fn (s mut Scoper&) isHandle(t types.TypeId) Bool {
    if not s.isStruct(t) { return false }
    fs := s.P.T.Items(s.P.T.Fields(t))
    if fs.Len() != 1 { return false }
    if s.isRef(fs[0]) { return s.fieldMark(t, 0) == typed.Mark.Bare }
    return s.isHandle(fs[0])
}

# how a body may use a reference parameter (E31b, O17b): only through its reference field (UseThru, a handle's); or
# writing nothing of the instance's own storage (UseView) - its references followed, its numbers, Bools and function values
# read, it or a struct it holds handed on read-only, by value, or to a callee using it so
UseThru I64 = 1
UseView I64 = 2

# whether body b uses its parameter j only as mode says - a body not checked does not; one whose answer is being asked
# is taken to (a greatest fixed point)
fn (s mut Scoper&) uses(b I64, j I64, mode I64) Bool {
    if b < 0 { return false }
    key := pair.Pair(b * 4 + mode, j)
    st := try s.useMemo.Get(key) catch default 0
    if st != 0 { return st != 2 }
    body := s.Bodies[b]
    if body.Root == null or not s.judged[b] or j >= body.Params.Len() { return false }
    s.useMemo.Put(key, 1)
    r := s.ueBlock(body, body.Root, I64(body.Params[j]), mode)
    s.useMemo.Put(key, 3 if r else 2)
    return r
}

fn (s mut Scoper&) ueBlock(b typed.Body&, bl typed.Block&, l I64, mode I64) Bool {
    if bl == null { return true }
    for st in bl.Stmts {
        if not s.ueStmt(b, st, l, mode) { return false }
    }
    return true
}

fn (s mut Scoper&) ueStmt(b typed.Body&, st typed.Stmt&, l I64, mode I64) Bool {
    if st == null { return true }
    match st {
        case typed.Stmt.Let(_, _, x) { return s.ueExpr(b, x, l, mode) }
        case typed.Stmt.Assign(_, p, x) { return s.uePlace(b, p, l, mode) and s.ueExpr(b, x, l, mode) }
        case typed.Stmt.Eval(_, x) { return s.ueExpr(b, x, l, mode) }
        case typed.Stmt.If(_, i) {
            return s.ueExpr(b, i.Test, l, mode) and s.ueBlock(b, i.Then, l, mode) and s.ueBlock(b, i.Else, l, mode)
        }
        case typed.Stmt.Loop(_, body, post) { return s.ueBlock(b, body, l, mode) and s.ueBlock(b, post, l, mode) }
        case typed.Stmt.Return(_, x) { return s.ueExpr(b, x, l, mode) }
        case typed.Stmt.Assert(_, c, m) { return s.ueExpr(b, c, l, mode) and s.ueExpr(b, m, l, mode) }
        case typed.Stmt.Block(_, bl) { return s.ueBlock(b, bl, l, mode) }
        case typed.Stmt.Defer(_, bl) { return s.ueBlock(b, bl, l, mode) }
        case typed.Stmt.Join(_, jn) {
            if not s.ueBlock(b, jn.Code, l, mode) { return false }
            for c in jn.Clauses {
                if not s.ueBlock(b, c.Code, l, mode) { return false }
            }
            return true
        }
        case typed.Stmt.Spawn(_, sw) {
            # a task handed it keeps it past the call
            xs List<I64>
            s.carried(sw.Task, xs)
            if flHas(xs, l) { return false }
            for p in sw.Targets {
                if not s.uePlace(b, p, l, mode) { return false }
            }
            if not s.ueExpr(b, sw.Task, l, mode) { return false }
            for c in sw.Clauses {
                if not s.ueExpr(b, c.Handler, l, mode) { return false }
            }
            return true
        }
        case typed.Stmt.Yield(_, x) { return s.ueExpr(b, x, l, mode) }
        case _ { return true }
    }
}

fn (s mut Scoper&) ueExprs(b typed.Body&, xs Array<typed.Expr&>&, l I64, mode I64) Bool {
    for x in xs {
        if not s.ueExpr(b, x, l, mode) { return false }
    }
    return true
}

# whether r reads the parameter's reference itself
fn isParamRead(r typed.Expr&, l I64) Bool {
    match r {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Place.Local(_, _, id) { return I64(id) == l }
                case _ { }
            }
        }
        case typed.Expr.Away(_, _, y) { return isParamRead(y, l) }
        case _ { }
    }
    return false
}

# a field place read straight through the parameter: p.f, its index; -1 for none
fn ownField(p typed.Place&, l I64) I64 {
    match p {
        case typed.Place.Field(_, _, base, i) {
            match base {
                case typed.Place.Deref(_, _, r) {
                    if isParamRead(r, l) { return i }
                }
                case _ { }
            }
        }
        case _ { }
    }
    return -1
}

fn (s mut Scoper&) ueExpr(b typed.Body&, x typed.Expr&, l I64, mode I64) Bool {
    if x == null { return true }
    match x {
        case typed.Expr.Read(_, ty, p, _) {
            if ownField(p, l) >= 0 {
                # a field read through it: its reference (a handle's), or for a view a number, a Bool, a function value
                # or a reference
                if mode == UseThru { return true }
                k := s.P.T.KindOf(ty)
                return k == types.Kind.Ref or k == types.Kind.Func or s.isNumberLike(ty)
            }
            return s.uePlace(b, p, l, mode)
        }
        case typed.Expr.Borrow(_, _, p), typed.Expr.Take(_, _, p) { return s.uePlace(b, p, l, mode) }
        case typed.Expr.Promote(_, _, pr) { return s.ueExpr(b, pr.X, l, mode) }
        case typed.Expr.Call(_, _, c) {
            match c.Target {
                case typed.Callee.Value(f) {
                    if not s.ueExpr(b, f, l, mode) { return false }
                }
                case _ { }
            }
            fty := s.calleeType(c)
            ps := s.P.T.Items(s.P.T.Params(fty)) if fty != types.UnknownT else types.TypeId[]
            for k in range c.Args.Len() {
                a := s.unAway(c.Args[k])
                handed := s.handedOn(a, l)
                if handed == 0 {
                    if not s.ueExpr(b, a, l, mode) { return false }
                    continue
                }
                # handed on: to a named function's parameter used the same way; for a view also to a read-only
                # reference parameter or a by-value one
                callee := -1
                match c.Target {
                    case typed.Callee.Body(id) { callee = I64(id) }
                    case _ { }
                }
                if callee < 0 or k >= ps.Len() { return false }
                pt := ps[k]
                if mode == UseView and (not s.isRef(pt) or (s.P.T.PermOf(pt) & types.Writable) == 0) { continue }
                if handed == 1 {
                    if not s.uses(callee, k, mode) { return false }
                } else if handed == 2 {
                    # a struct the parameter holds by value: a handle used only through its reference (a handle holding
                    # one, as StringBuilder holds its List, is used through that one's), a view as one
                    ft := s.unAway(a).Type()
                    rt := s.P.T.Referent(pt) if s.isRef(pt) else pt
                    if mode == UseThru {
                        if not s.isHandle(rt) or not s.uses(callee, k, UseThru) { return false }
                        continue
                    }
                    if mode != UseView { return false }
                    if s.isHandle(rt) {
                        if not s.uses(callee, k, UseThru) { return false }
                    } else if not s.isStruct(rt) or not s.uses(callee, k, UseView) {
                        return false
                    }
                } else {
                    return false
                }
            }
            return true
        }
        case typed.Expr.Make(_, _, m) { return s.ueExprs(b, m.Items, l, mode) and s.ueExpr(b, m.Length, l, mode) }
        case typed.Expr.Collect(_, _, c) { return s.ueExpr(b, c.Reserve, l, mode) and s.ueBlock(b, c.Loop, l, mode) }
        case typed.Expr.Prim(_, _, _, _, args) { return s.ueExprs(b, args, l, mode) }
        case typed.Expr.Slice(_, _, sl) {
            return s.uePlace(b, sl.Base, l, mode) and s.ueExpr(b, sl.Lo, l, mode) and s.ueExpr(b, sl.Hi, l, mode)
        }
        case typed.Expr.Cond(_, _, c) {
            return s.ueExpr(b, c.C, l, mode) and s.ueExpr(b, c.A, l, mode) and s.ueExpr(b, c.B, l, mode)
        }
        case typed.Expr.Seq(_, _, q) {
            for st in q.Stmts {
                if not s.ueStmt(b, st, l, mode) { return false }
            }
            return s.ueExpr(b, q.X, l, mode)
        }
        case typed.Expr.Match(_, _, m) {
            for st in m.Held {
                if not s.ueStmt(b, st, l, mode) { return false }
            }
            for a in m.Arms {
                if not s.ueArm(b, a, l, mode) { return false }
            }
            return s.ueArm(b, m.NoMatch, l, mode)
        }
        case typed.Expr.Try(_, _, t) {
            if not s.ueExpr(b, t.X, l, mode) { return false }
            for c in t.Clauses {
                if not s.ueBlock(b, c.Code, l, mode) or not s.ueExprs(b, c.Defaults, l, mode) { return false }
            }
            return true
        }
        case typed.Expr.Fn(_, _, f) {
            match f {
                case typed.FnVal.Lambda(_, caps, _) {
                    for cp in caps {
                        if flRootExpr(cp.Outer) == l { return false }
                        if not s.ueExpr(b, cp.Outer, l, mode) { return false }
                    }
                }
                case typed.FnVal.Adapter(_, r, _) {
                    if flRootExpr(r) == l { return false }
                    return s.ueExpr(b, r, l, mode)
                }
                case _ { }
            }
            return true
        }
        case typed.Expr.Text(_, _, t) {
            for pc in t.Pieces {
                match pc {
                    case typed.Piece.Render(r) {
                        if flRootExpr(r) == l or not s.ueExpr(b, r, l, mode) { return false }
                    }
                    case _ { }
                }
            }
            return true
        }
        case typed.Expr.Away(_, _, y) { return s.ueExpr(b, y, l, mode) }
        case _ { return true }
    }
}

# how a call's argument hands the parameter on: 1 its reference itself, 2 a borrow of a struct it holds by value (p.w),
# 3 a copy of the whole instance; 0 none
fn (s mut Scoper&) handedOn(a typed.Expr&, l I64) I64 {
    if isParamRead(a, l) { return 1 }
    match a {
        case typed.Expr.Borrow(_, _, p) {
            if ownField(p, l) >= 0 { return 2 }
        }
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Place.Deref(_, _, r) {
                    if isParamRead(r, l) { return 3 }
                }
                case _ { }
            }
        }
        case _ { }
    }
    return 0
}

fn (s mut Scoper&) ueArm(b typed.Body&, a typed.Arm&, l I64, mode I64) Bool {
    if a == null { return true }
    for alt in a.Alts {
        if not s.ueExpr(b, alt.Test, l, mode) { return false }
        for bd in alt.Binds {
            if not s.ueExpr(b, bd.From, l, mode) { return false }
        }
    }
    return s.ueExpr(b, a.Guard, l, mode) and s.ueBlock(b, a.Code, l, mode) and s.ueExpr(b, a.Value, l, mode)
}

# a place's uses of the parameter: through a reference read out of one of its fields, anything; the parameter itself, its
# own storage (a field of it written, borrowed, the instance copied), none
fn (s mut Scoper&) uePlace(b typed.Body&, p typed.Place&, l I64, mode I64) Bool {
    match p {
        case typed.Place.Local(_, _, id) { return I64(id) != l }
        case typed.Place.Deref(_, _, r) {
            if isParamRead(r, l) { return false }
            return s.ueExpr(b, r, l, mode)
        }
        case typed.Place.Field(_, _, base, _) { return s.uePlace(b, base, l, mode) }
        case typed.Place.Elem(_, _, e) { return s.uePlace(b, e.Base, l, mode) and s.ueExpr(b, e.Index, l, mode) }
        case typed.Place.Payload(_, _, pl) { return s.uePlace(b, pl.Base, l, mode) }
        case typed.Place.Temp(_, _, v, _) { return s.ueExpr(b, v, l, mode) }
        case _ { return true }
    }
}

# whether t is a number or a Bool (a declared type over one counts)
fn (s mut Scoper&) isNumberLike(t types.TypeId) Bool {
    if s.P.T.IsNumber(t) or s.P.T.KindOf(t) == types.Kind.Bool { return true }
    if s.P.T.KindOf(t) == types.Kind.Named and s.P.T.HasBody(t) and s.P.T.DeclKindOf(s.P.T.DeclOf(t)) == types.DeclKind.Over {
        return s.isNumberLike(s.P.T.Base(t))
    }
    return false
}

# ---- lambdas that never leave the frame (D16c) ----

# whether x is a lambda capturing a reference, or a value holding one
fn (s mut Scoper&) capturingLambda(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Fn(_, _, f) {
            match f {
                case typed.FnVal.Lambda(_, caps, _) { return not s.capturesNothing(caps) }
                case _ { }
            }
        }
        case typed.Expr.Away(_, _, y) { return s.capturingLambda(y) }
        case _ { }
    }
    return false
}

# whether a callee keeps nothing of what is passed for its parameter j beyond the call (D16c): no obligation of its names
# the parameter's scope, its result does not, no other parameter shares it, and - a function-typed one - it is read only
# to be called, or handed straight on to a named function keeping nothing of it, and is captured by no lambda. A callee
# whose answer is being asked keeps it
fn (s mut Scoper&) transient(callee I64, j I64) Bool {
    if callee < 0 { return false }
    key := pair.Pair(callee, j)
    st := try s.trMemo.Get(key) catch default 0
    if st != 0 { return st == 3 }
    s.trMemo.Put(key, 1)
    r := s.transientNow(callee, j)
    s.trMemo.Put(key, 3 if r else 2)
    return r
}

fn (s mut Scoper&) transientNow(callee I64, j I64) Bool {
    b := s.Bodies[callee]
    match b.Of {
        case typed.BodyOf.Fn(_) { }
        case _ { return false }
    }
    if b.Root == null or not s.judged[callee] or not s.sums[callee].Done or j >= b.Params.Len() { return false }
    fty := b.Ty
    k := s.P.T.ShareOf(fty, j)
    q := k if k >= 0 else j
    v := -1
    vars := s.P.T.ScopeVarsOf(fty)
    for i in range vars.Len() {
        if vars[i] == q { v = i }
    }
    if v < 0 { return false }
    for r in s.sums[callee].Rels {
        if r.Hi == Term.Var(v) or r.Lo == Term.Var(v) { return false }
        match r.Hi {
            case Term.Derived(p, _) {
                if p == j { return false }
            }
            case _ { }
        }
        match r.Lo {
            case Term.Derived(p, _) {
                if p == j { return false }
            }
            case _ { }
        }
    }
    rt := s.P.T.Result(fty)
    nres := s.P.T.Items(s.P.T.Parts(rt)).Len() if s.P.T.KindOf(rt) == types.Kind.Tuple else 1
    for i in range nres {
        if s.P.T.ResultFrom(fty, i) == q { return false }
    }
    for i in range b.Params.Len() {
        if i != j and (s.P.T.ShareOf(fty, i) == q or (i == q and k >= 0)) { return false }
    }
    pl := I64(b.Params[j])
    if not s.isFunc(b.Locals[pl].Ty) { return true }
    return s.ocBlock(b.Root, pl, true)
}

# whether every use of local l in these statements is a call through it (D16c) - or, where passOn, its being handed
# straight on to a parameter of a named function keeping nothing of it (transient)
fn (s mut Scoper&) ocStmts(ss Array<typed.Stmt&>&, from I64, l I64, passOn Bool) Bool {
    for i in range from, ss.Len() {
        if not s.ocStmt(ss[i], l, passOn) { return false }
    }
    return true
}

fn (s mut Scoper&) ocBlock(b typed.Block&, l I64, passOn Bool) Bool {
    if b == null { return true }
    return s.ocStmts(b.Stmts, 0, l, passOn)
}

fn (s mut Scoper&) ocStmt(st typed.Stmt&, l I64, passOn Bool) Bool {
    if st == null { return true }
    match st {
        case typed.Stmt.Let(_, _, x) { return s.ocExpr(x, l, passOn) }
        case typed.Stmt.Assign(_, p, x) { return s.ocPlace(p, l, passOn) and s.ocExpr(x, l, passOn) }
        case typed.Stmt.Eval(_, x) { return s.ocExpr(x, l, passOn) }
        case typed.Stmt.If(_, i) {
            return s.ocExpr(i.Test, l, passOn) and s.ocBlock(i.Then, l, passOn) and s.ocBlock(i.Else, l, passOn)
        }
        case typed.Stmt.Loop(_, body, post) { return s.ocBlock(body, l, passOn) and s.ocBlock(post, l, passOn) }
        case typed.Stmt.Return(_, x) { return s.ocExpr(x, l, passOn) }
        case typed.Stmt.Assert(_, c, m) { return s.ocExpr(c, l, passOn) and s.ocExpr(m, l, passOn) }
        case typed.Stmt.Block(_, b) { return s.ocBlock(b, l, passOn) }
        case typed.Stmt.Defer(_, b) { return s.ocBlock(b, l, passOn) }
        case typed.Stmt.Join(_, jn) {
            if not s.ocBlock(jn.Code, l, passOn) { return false }
            for c in jn.Clauses {
                if not s.ocBlock(c.Code, l, passOn) { return false }
            }
            return true
        }
        case typed.Stmt.Spawn(_, sw) {
            # a task calling through it takes it to another thread: a use as a value
            match sw.Task {
                case typed.Expr.Call(_, _, c) {
                    match c.Target {
                        case typed.Callee.Value(f) {
                            if flRootExpr(f) == l { return false }
                        }
                        case _ { }
                    }
                }
                case _ { }
            }
            for p in sw.Targets {
                if not s.ocPlace(p, l, passOn) { return false }
            }
            if not s.ocExpr(sw.Task, l, passOn) { return false }
            for c in sw.Clauses {
                if not s.ocExpr(c.Handler, l, passOn) { return false }
            }
            return true
        }
        case typed.Stmt.Yield(_, x) { return s.ocExpr(x, l, passOn) }
        case _ { return true }
    }
}

fn (s mut Scoper&) ocExprs(xs Array<typed.Expr&>&, l I64, passOn Bool) Bool {
    for x in xs {
        if not s.ocExpr(x, l, passOn) { return false }
    }
    return true
}

fn (s mut Scoper&) ocExpr(x typed.Expr&, l I64, passOn Bool) Bool {
    if x == null { return true }
    match x {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p), typed.Expr.Take(_, _, p) { return s.ocPlace(p, l, passOn) }
        case typed.Expr.Promote(_, _, pr) { return s.ocExpr(pr.X, l, passOn) }
        case typed.Expr.Call(_, _, c) {
            match c.Target {
                case typed.Callee.Value(f) {
                    if flRootExpr(f) != l and not s.ocExpr(f, l, passOn) { return false }
                }
                case _ { }
            }
            for i in range c.Args.Len() {
                a := c.Args[i]
                if passOn and flRootExpr(a) == l {
                    match c.Target {
                        case typed.Callee.Body(id) {
                            if s.transient(I64(id), i) { continue }
                        }
                        case _ { }
                    }
                }
                if not s.ocExpr(a, l, passOn) { return false }
            }
            return true
        }
        case typed.Expr.Make(_, _, m) { return s.ocExprs(m.Items, l, passOn) and s.ocExpr(m.Length, l, passOn) }
        case typed.Expr.Collect(_, _, c) { return s.ocExpr(c.Reserve, l, passOn) and s.ocBlock(c.Loop, l, passOn) }
        case typed.Expr.Prim(_, _, _, _, args) { return s.ocExprs(args, l, passOn) }
        case typed.Expr.Slice(_, _, sl) {
            return s.ocPlace(sl.Base, l, passOn) and s.ocExpr(sl.Lo, l, passOn) and s.ocExpr(sl.Hi, l, passOn)
        }
        case typed.Expr.Cond(_, _, c) {
            return s.ocExpr(c.C, l, passOn) and s.ocExpr(c.A, l, passOn) and s.ocExpr(c.B, l, passOn)
        }
        case typed.Expr.Seq(_, _, q) { return s.ocStmts(q.Stmts, 0, l, passOn) and s.ocExpr(q.X, l, passOn) }
        case typed.Expr.Match(_, _, m) {
            if not s.ocStmts(m.Held, 0, l, passOn) { return false }
            for a in m.Arms {
                if not s.ocArm(a, l, passOn) { return false }
            }
            return s.ocArm(m.NoMatch, l, passOn)
        }
        case typed.Expr.Try(_, _, t) {
            if not s.ocExpr(t.X, l, passOn) { return false }
            for c in t.Clauses {
                if not s.ocBlock(c.Code, l, passOn) or not s.ocExprs(c.Defaults, l, passOn) { return false }
            }
            return true
        }
        case typed.Expr.Fn(_, _, f) {
            match f {
                case typed.FnVal.Lambda(_, caps, _) {
                    # a capture of it is a use as a value
                    for cp in caps {
                        if flRootExpr(cp.Outer) == l or not s.ocExpr(cp.Outer, l, passOn) { return false }
                    }
                }
                case typed.FnVal.Adapter(_, r, _) { return s.ocExpr(r, l, passOn) }
                case _ { }
            }
            return true
        }
        case typed.Expr.Text(_, _, t) {
            for pc in t.Pieces {
                match pc {
                    case typed.Piece.Render(r) {
                        if not s.ocExpr(r, l, passOn) { return false }
                    }
                    case _ { }
                }
            }
            return true
        }
        case typed.Expr.Away(_, _, y) { return s.ocExpr(y, l, passOn) }
        case _ { return true }
    }
}

fn (s mut Scoper&) ocArm(a typed.Arm&, l I64, passOn Bool) Bool {
    if a == null { return true }
    for alt in a.Alts {
        if not s.ocExpr(alt.Test, l, passOn) { return false }
        for bd in alt.Binds {
            if not s.ocExpr(bd.From, l, passOn) { return false }
        }
    }
    return s.ocExpr(a.Guard, l, passOn) and s.ocBlock(a.Code, l, passOn) and s.ocExpr(a.Value, l, passOn)
}

# a place's uses of l: a place rooted at it is a use as a value
fn (s mut Scoper&) ocPlace(p typed.Place&, l I64, passOn Bool) Bool {
    match p {
        case typed.Place.Local(_, _, id) { return I64(id) != l }
        case typed.Place.Deref(_, _, r) { return s.ocExpr(r, l, passOn) }
        case typed.Place.Field(_, _, b, _) { return s.ocPlace(b, l, passOn) }
        case typed.Place.Elem(_, _, e) { return s.ocPlace(e.Base, l, passOn) and s.ocExpr(e.Index, l, passOn) }
        case typed.Place.Payload(_, _, pl) { return s.ocPlace(pl.Base, l, passOn) }
        case typed.Place.Temp(_, _, v, _) { return s.ocExpr(v, l, passOn) }
        case _ { return true }
    }
}

# ---- statements ----

fn (s mut Scoper&) stmt(st typed.Stmt&) {
    if st == null { return }
    saved := s.stmtSp
    s.stmtSp = st.Span()
    match st {
        case typed.Stmt.Let(sp, l, x) { s.let(sp, l, x) }
        case typed.Stmt.Assign(sp, p, x) { s.assign(sp, p, x) }
        case typed.Stmt.Eval(_, x) { s.val(x, Term.None) }
        case typed.Stmt.If(_, i) {
            s.val(i.Test, Term.None)
            s.block(i.Then)
            s.block(i.Else)
        }
        case typed.Stmt.Loop(_, body, post) {
            s.block(body)
            s.block(post)
        }
        case typed.Stmt.Jump(_, _, _) { }
        case typed.Stmt.Return(sp, x) { s.ret(sp, x) }
        case typed.Stmt.Raise(_, _, _) { }
        case typed.Stmt.Exit(_, _) { }
        case typed.Stmt.Assert(_, c, m) {
            s.val(c, Term.None)
            s.val(m, Term.None)
        }
        case typed.Stmt.Block(_, b) {
            # a three-clause "for" declares its variable in a block of its own, evaluated once in the block around the
            # loop (S9): that is where the variable lives and what its initializer builds is built, as stage 0 has it
            if s.forWrap(b) { s.lifted.Put(I64(b.Id), I64(s.lift(s.blocks[s.blocks.Len() - 1]))) }
            s.block(b)
        }
        case typed.Stmt.Defer(_, b) { s.block(b) }
        case typed.Stmt.Join(_, jn) {
            s.joins.Push(jn.Code.Id)
            s.block(jn.Code)
            try s.joins.Pop() catch { }
            for c in jn.Clauses { s.block(c.Code) }
        }
        case typed.Stmt.Spawn(sp, sw) { s.spawn(sp, sw) }
        case typed.Stmt.Yield(_, x) { s.val(x, s.here()) }
    }
    s.stmtSp = saved
}

# a local declared (O25a, O25h): its claim fixed by its mark, its initializer judged against it
fn (s mut Scoper&) let(sp source.Span, l typed.LocalId, x typed.Expr&) {
    loc := s.B.Locals[I64(l)]
    t := loc.Ty
    if x != null { s.inits.Put(I64(l), x) }
    moved := s.moveTo
    land := s.landOK
    s.moveTo = Term.None
    s.landOK = false
    s.stors[I64(l)] = s.blockTerm(loc.In)
    if loc.Kind == typed.LocalKind.Field and not s.isRef(t) and s.borrowed(I64(l)) and loc.In == typed.BlockId(0) {
        # a value field a reference is taken to lives in the instance scope - its slot in the constructor's frame closes
        # as it returns, and the field is copied into the instance from there (C2g)
        st := s.blockTerm(typed.BlockId(0))
        if st.Runs() {
            s.stors[I64(l)] = st
            s.plan.Stored[I64(l)] = s.scopeOf(st)
            s.buildsInto(st, sp, s.B.File, sp)
        }
    }
    if moved != Term.None {
        # a local the function returns lives where the result goes, its own storage too (O26a)
        s.terms[I64(l)] = moved
        s.stors[I64(l)] = moved
        s.plan.Stored[I64(l)] = s.scopeOf(moved)
        # its slot made there is a build there (E11c: in a borrowed result's home, where a Str's receiver lives)
        s.buildsInto(moved, x.Span(), s.B.File, x.Span())
        v := s.val(x, moved)
        s.bindLocal(l, x)
        if v.K == ValKind.Existing { s.fit(v.T, moved, s.isRef(t) or s.storeThrough(t), x, FitLocal) }
        return
    }
    if not s.holds(t) {
        s.val(x, Term.None)
        return
    }
    # a held local: its temporary is built where its one use puts it (typed.LocalKind.Held) - a call's several results
    # passed on as another's arguments (D8d) where the first of them is
    spreadCall := loc.Kind == typed.LocalKind.Hidden and s.P.T.KindOf(t) == types.Kind.Tuple and s.callOf(x) != null
    if (loc.Kind == typed.LocalKind.Held or spreadCall) and s.isFresh(x) {
        s.held.Put(I64(l), x)
        s.terms[I64(l)] = Term.None
        return
    }
    # the handle a for-in walks that a call gives (users[0][0]): lent as its reference where the call landed (O17b, O18c),
    # its copy in the walk's block
    if loc.Kind == typed.LocalKind.Hidden and s.isRef(t) {
        match s.unAway(x) {
            case typed.Expr.Promote(_, _, pr) {
                if s.isHandle(pr.X.Type()) and s.isFresh(pr.X) and s.argLands(pr.X) {
                    s.buildSite(pr.Site, s.blockTerm(loc.In), pr.X.Span())
                    s.landing = true
                    v := s.val(pr.X, Term.None)
                    s.landing = false
                    s.terms[I64(l)] = s.valTerm(v, s.blockTerm(loc.In))
                    return
                }
            }
            case _ { }
        }
    }
    # the array a for-in walks, a literal of constant data reaching a read-only reference: its elements are the constant
    # data itself (T25d), in the program's scope, whatever its own storage is
    if loc.Kind == typed.LocalKind.Hidden and s.staticLiteral(x) {
        s.val(x, s.blockTerm(loc.In))
        s.terms[I64(l)] = Term.Program
        return
    }
    claim := s.markTerm(loc.Marked, loc.In)
    match loc.Marked {
        case typed.Mark.Of(y) {
            match claim {
                case Term.Set(_) {
                    # a mark naming a local whose scope is not known here (O12): nothing is declared to live there
                    if s.report {
                        n := msgs.Tok(s.P.L.Names.Text(s.B.Locals[I64(y)].Name))
                        s.err(s.markAt(s.stmtSp, s.P.L.Names.Text(s.B.Locals[I64(y)].Name)), msgs.TagUnknownScope(n, n))
                    }
                    claim = s.blockTerm(loc.In)
                }
                case _ { }
            }
        }
        case _ { }
    }
    if loc.Kind == typed.LocalKind.Field {
        # a constructor's field is a slot of the instance (C2d): a bare one lives with it, whatever its type writes; one
        # written "&q" keeps q's argument's scope, which the instance may not outlive
        match loc.Marked {
            case typed.Mark.Of(q) {
                s.why = WhyField
                s.oblige(s.whereLives(q), s.blockTerm(typed.BlockId(0)), false)
                s.why = 0
            }
            case _ { claim = s.blockTerm(typed.BlockId(0)) }
        }
    }
    isRef := s.isRef(t) or s.isFunc(t)
    if s.isRef(t) and loc.Kind != typed.LocalKind.Hidden and loc.Kind != typed.LocalKind.Held { s.splitBorrow(x) }
    if s.isRef(t) and loc.Kind == typed.LocalKind.Hidden {
        # the array a for-in walks, a split value borrowed: each element is given the references' scope, not the
        # storage's (O17a)
        match x {
            case typed.Expr.Borrow(_, _, bp) {
                if s.splitPlace(bp) { s.splitHome.Put(I64(l), s.partsTerm(bp)) }
            }
            case _ { }
        }
    }
    if claim == Term.None {
        # ":=", or no marker on a value holding references: the initializer's own term; a temporary is built in the
        # local's block (O18a), a call's result where its obligations say where decide found that it lands (O18c)
        s.landing = land
        v := s.val(x, s.blockTerm(loc.In))
        s.landing = false
        s.bindLocal(l, x)
        s.terms[I64(l)] = s.valTerm(v, s.blockTerm(loc.In))
        h := try s.splitHome.Get(I64(l)) catch default Term.None
        if h != Term.None { s.terms[I64(l)] = h }
        # a "&p" field read through an element: only its container's scope is known, which the local would claim as its
        # own (C2d, O23)
        match v.T {
            case Term.Derived(p, _) {
                if p < 0 and -p - 1 < s.underElem.Len() and s.underElem[-p - 1] and s.report {
                    s.err(s.lastName(x.Span()), msgs.BuildThroughUnknownScope())
                }
            }
            case _ { }
        }
        return
    }
    s.terms[I64(l)] = claim
    # a conditional or a match of references a written type declares builds its new values at the claim, as any
    # temporary it is given lands (O18a) - and so is a set where its other values live elsewhere (E28)
    bareChoice := loc.Marked == typed.Mark.Bare and s.isRef(t) and s.choiceOfRefs(x)
    s.atDest = bareChoice
    v := s.val(x, claim)
    s.atDest = false
    s.bindLocal(l, x)
    # a conditional or a match of references living in different scopes declared with a bare "&" is held where it is
    # declared - every value it can give outlives this block - and where it lives is not known here: read, never built
    # into nor stored through (E28, O12)
    match v.T {
        case Term.Set(_) {
            if loc.Marked == typed.Mark.Bare and s.isRef(t) and s.choiceOfRefs(x) {
                s.terms[I64(l)] = v.T
                return
            }
        }
        case _ { }
    }
    # a local naming where a derived scope's referent lives may hold what lives there, never what is new (O23a, C2d)
    if v.K == ValKind.Fresh and s.report and s.unknownBinding(claim) { s.err(s.opTok(x), msgs.BuildThroughUnknownScope()) }
    if loc.Kind == typed.LocalKind.Field and v.K == ValKind.Fresh and v.T != claim and v.T.Relatable() {
        # a field built where a scope argument says, not with the instance: what it names, the instance may not
        # outlive (C2d)
        s.why = WhyField
        s.fit(v.T, claim, false, x, FitField)
        s.why = 0
    }
    if v.K == ValKind.Existing {
        exact := s.narrowingMatters(t)
        kind := FitLocal
        if loc.Kind == typed.LocalKind.Field {
            # a constructor's field is a slot of the instance (C2d): exact where something can be stored through it (O25g) -
            # a field written "&q" exactly where its argument lives then, so that building through it builds where its
            # referent is; else it need only outlive the instance
            exact = s.storeThrough(t)
            kind = FitField if exact else FitDecl
            s.why = WhyHolds
        }
        s.fit(v.T, claim, exact, x, kind)
        s.why = 0
    }
}

# a local initialized by a constructor call, or by a call whose result is an instance of known bindings (O13c), and
# never assigned after - the for-in's hidden iterator included: its instance's construction bindings are where each of
# its "&q" fields lives, wherever it is read (O23a, C2d)
fn (s mut Scoper&) bindLocal(l typed.LocalId, x typed.Expr&) {
    k := s.B.Locals[I64(l)].Kind
    if k != typed.LocalKind.Var and k != typed.LocalKind.Hidden and k != typed.LocalKind.Field { return }
    if s.reassigned(I64(l)) {
        s.noteLate(I64(l), x)
        if s.lateGather { s.lateDecl.Put(I64(l), true) }
        if s.lateGather or s.lateBody != s.Id or s.lateNone.Has(I64(l)) or not s.lateDecl.Has(I64(l)) { return }
        ts := try s.late.Get(I64(l)) catch { return }
        s.bindFrom.Put(I64(l), s.bindTerms.Len())
        for t in ts {
            s.bindTerms.Push(t)
            s.bindKids.Push(-1)
        }
        return
    }
    c := s.callOf(s.unPromoted(x))
    if c == null or I64(c.Site) != s.ctorSite { return }
    s.bindFrom.Put(I64(l), s.ctorFrom)
}

# the number of constructor parameters of the struct a value of type t is, or refers to; 0 for none
fn (s mut Scoper&) ctorParams(t types.TypeId) I64 {
    r := s.P.T.Repr(t)
    if s.isRef(r) { r = s.P.T.Repr(s.P.T.Referent(r)) }
    id := try s.ctorOf.Get(r) catch default -1
    return s.Bodies[id].Params.Len() if id >= 0 else 0
}

# O13c: the instance a return gives, its construction bindings merged into the returns' so far - a constructor call
# judged just now, or a local whose bindings are known; a binding is the caller's only through a scope variable, the
# program's or a derived scope of a parameter
fn (s mut Scoper&) noteResBind(x typed.Expr&) {
    n := s.ctorParams(x.Type())
    if n == 0 { return }
    from := -1
    c := s.callOf(s.unPromoted(x))
    if c != null and I64(c.Site) == s.ctorSite {
        from = s.ctorFrom
    } else {
        l := s.argLocal(s.unPromoted(x))
        if l >= 0 { from = try s.bindFrom.Get(l) catch default -1 }
    }
    for w in range n {
        t := Term.Untraced
        if from >= 0 and from + w < s.bindTerms.Len() {
            t = s.bindTerms[from + w]
            ok := match t {
                case Term.Var(_), Term.Program => true
                case Term.Derived(p, _) => p >= 0
                case _ => false
            }
            if not ok { t = Term.Untraced }
        }
        if not s.resBound {
            s.resBind.Push(t)
        } else if w < s.resBind.Len() and s.resBind[w] != t {
            s.resBind[w] = Term.Untraced
        }
    }
    s.resBound = true
}

# whether body b has a local assigned after its declaration whose type is a struct with a constructor: one whose
# record a later read could use (O23a)
fn (s mut Scoper&) hasLateLocals(b I64) Bool {
    for k in range s.assignedFrom[b], s.assignedFrom[b + 1] {
        l := s.assignedTo[k]
        if l >= 0 and l < s.Bodies[b].Locals.Len() and s.ctorParams(s.Bodies[b].Locals[l].Ty) > 0 { return true }
    }
    return false
}

# while gathering, the record value x gives local l merged into what the local's other values gave (O23a)
fn (s mut Scoper&) noteLate(l I64, x typed.Expr&) {
    if not s.lateGather or s.lateNone.Has(l) { return }
    n := s.ctorParams(s.B.Locals[l].Ty)
    c := s.callOf(s.unPromoted(x))
    if n == 0 or c == null or I64(c.Site) != s.ctorSite or s.ctorFrom + n > s.bindTerms.Len() {
        s.lateNone.Put(l, true)
        return
    }
    first := not s.late.Has(l)
    if first { s.late.Put(l, List<Term>()) }
    ts := try s.late.Get(l) catch { return }
    for w in range n {
        t := s.bindTerms[s.ctorFrom + w]
        if first {
            ts.Push(t)
        } else if w < ts.Len() and ts[w] != t {
            ts[w] = Term.Untraced
        }
    }
}

# whether the body being judged assigns local l after its declaration (walkBody)
fn (s mut Scoper&) borrowed(l I64) Bool {
    for k in range s.borrowedFrom[s.Id], s.borrowedFrom[s.Id + 1] {
        if s.borrowedTo[k] == l { return true }
    }
    return false
}

fn (s mut Scoper&) reassigned(l I64) Bool {
    for k in range s.assignedFrom[s.Id], s.assignedFrom[s.Id + 1] {
        if s.assignedTo[k] == l { return true }
    }
    return false
}

# where the instance local l holds or refers to bound its constructor's parameter w (bindLocal); None where not known
fn (s mut Scoper&) boundAt(l I64, w I64) Term {
    return s.recAt(try s.bindFrom.Get(l) catch default -1, w)
}

# binding w of the instance record from: None where not known
fn (s mut Scoper&) recAt(from I64, w I64) Term {
    if from < 0 or w < 0 or from + w >= s.bindTerms.Len() { return Term.None }
    t := s.bindTerms[from + w]
    return t if t.Runs() else Term.None
}

# the record of the instance an argument is: a constructor call or a call whose result's bindings are known, judged
# just now, or a local whose bindings are known; -1 for none
fn (s mut Scoper&) argRec(a typed.Expr&) I64 {
    x := s.unPromoted(s.unAway(a))
    c := s.callOf(x)
    if c != null { return try s.siteRec.Get(I64(c.Site)) catch default -1 }
    match x {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p) { return s.recOf(p) }
        case _ { return -1 }
    }
}

# the record of the instance a place holds or refers to (O23a): a local's; through a reference a local holds, its
# instance's; a field's, where the record of the instance holding it knows it - a "&q" field the argument's own record,
# a bare field the one its constructor gave it (FieldFrom); -1 where not known
fn (s mut Scoper&) recOf(p typed.Place&) I64 {
    match p {
        case typed.Place.Local(_, _, id) { return try s.bindFrom.Get(I64(id)) catch default -1 }
        case typed.Place.Deref(_, _, r) {
            match s.unAway(r) {
                case typed.Expr.Read(_, _, q, _) {
                    match q {
                        case typed.Place.Local(_, _, id) {
                            if s.B.Locals[I64(id)].Kind == typed.LocalKind.Param { return -1 }
                            return try s.bindFrom.Get(I64(id)) catch default -1
                        }
                        case typed.Place.Field(_, _, b, i) { return s.fieldRec(b, i) }
                        case _ { return -1 }
                    }
                }
                case _ { return -1 }
            }
        }
        case typed.Place.Field(_, _, b, i) { return s.fieldRec(b, i) }
        case _ { return -1 }
    }
}

# the record of the instance field i of the struct at base holds or refers to - where no body assigns that field, or
# all of such a struct through a reference, after construction: a store judged against the field's own binding says
# nothing of the bindings of the instance it puts there
fn (s mut Scoper&) fieldRec(base typed.Place&, i I64) I64 {
    bt := base.Type()
    if not s.isStruct(bt) { return -1 }
    r := I64(s.P.T.Repr(bt))
    if s.fieldsAssigned.Has(pair.Pair(r, i)) or s.fieldsAssigned.Has(pair.Pair(r, I64(-1))) { return -1 }
    rb := s.recOf(base)
    match s.fieldMark(bt, i) {
        case typed.Mark.Of(q) {
            w := s.ctorParamIndex(bt, q)
            if rb < 0 or w < 0 or rb + w >= s.bindKids.Len() { return -1 }
            return s.bindKids[rb + w]
        }
        case _ { }
    }
    # a bare field: the instance its constructor gave it, its bindings in that constructor's terms - its parameters'
    # bindings this instance's record has, its instance scope where this instance's references are
    cb := try s.ctorOf.Get(bt) catch default -1
    if cb < 0 or not s.summed(cb) or i >= s.sums[cb].FieldFrom.Len() { return -1 }
    ff := s.sums[cb].FieldFrom[i]
    if ff < 0 { return -1 }
    cbody := s.Bodies[cb]
    n := s.ctorParams(cbody.Locals[I64(cbody.Fields[i])].Ty) if i < cbody.Fields.Len() else 0
    if n == 0 or ff + n > s.sums[cb].FieldTerms.Len() { return -1 }
    from := s.bindTerms.Len()
    for w in range n {
        t := s.sums[cb].FieldTerms[ff + w]
        u := Term.Untraced
        match t {
            case Term.Program { u = Term.Program }
            case Term.Var(k) {
                if k < cbody.Vars.Len() {
                    match cbody.Vars[k] {
                        case typed.ScopeVar.Instance { u = s.peekPlace(base, true) }
                        case typed.ScopeVar.Param(l) {
                            j := -1
                            for k2 in range cbody.Params.Len() {
                                if cbody.Params[k2] == l { j = k2 }
                            }
                            if rb >= 0 and j >= 0 and rb + j < s.bindTerms.Len() { u = s.bindTerms[rb + j] }
                        }
                        case _ { }
                    }
                }
            }
            case _ { }
        }
        s.bindTerms.Push(u)
        s.bindKids.Push(-1)
    }
    return from
}

# a constructor's fields' instance records, in its own terms, for its summary (O23a); none for any other body
fn (s mut Scoper&) noteFieldRecs(sm mut summary&) {
    sm.FieldFrom.Clear()
    sm.FieldTerms.Clear()
    match s.B.Of {
        case typed.BodyOf.Ctor(_, _) { }
        case _ { return }
    }
    for f in s.B.Fields {
        from := try s.bindFrom.Get(I64(f)) catch default -1
        n := s.ctorParams(s.B.Locals[I64(f)].Ty)
        if from < 0 or n == 0 or from + n > s.bindTerms.Len() {
            sm.FieldFrom.Push(-1)
            continue
        }
        sm.FieldFrom.Push(sm.FieldTerms.Len())
        for w in range n {
            t := s.bindTerms[from + w]
            ok := match t {
                case Term.Var(_), Term.Program => true
                case _ => false
            }
            sm.FieldTerms.Push(t if ok else Term.Untraced)
        }
    }
}

# the value a promotion makes a reference of, else the expression itself
fn (s mut Scoper&) unPromoted(x typed.Expr&) typed.Expr&x {
    return match s.unAway(x) {
        case typed.Expr.Promote(_, _, pr) => pr.X
        case _ => x
    }
}

# what a value's term comes to where a local takes it: a temporary's where it was built, existing storage's own, a
# value holding nothing none
fn (s mut Scoper&) valTerm(v Val, built Term) Term {
    return match v.K {
        case ValKind.Fresh => v.T
        case ValKind.Existing => v.T
        case ValKind.Null => built
        case ValKind.Plain => built
        case ValKind.Static => Term.Program
    }
}

# the term a mark names for a local declared in block in (O25a): None where the local takes its initializer's
fn (s mut Scoper&) markTerm(m typed.Mark, inb typed.BlockId) Term {
    return match m {
        case typed.Mark.Bare => s.blockTerm(inb)
        case typed.Mark.Of(x) => s.whereLives(x)
        case typed.Mark.Global(_, _) => Term.Program
        case typed.Mark.Return => Term.Var(s.resultVar) if s.resultVar >= 0 else Term.Untraced
        case _ => Term.None
    }
}

# where variable x lives (O4a): a reference's referent, a value's references - or its block, where it holds none yet
fn (s mut Scoper&) whereLives(x typed.LocalId) Term {
    t := s.terms[I64(x)]
    if t != Term.None { return t }
    return s.stors[I64(x)]
}

# a block's term: a constructor's top level is its instance scope (C2g), a global's initializer's the program's (O1b)
fn (s mut Scoper&) blockTerm(bl typed.BlockId) Term {
    b := s.lift(bl)
    if b == typed.BlockId(0) {
        match s.B.Of {
            case typed.BodyOf.Ctor(_, _) {
                if s.resultVar >= 0 { return Term.Var(s.resultVar) }
            }
            case typed.BodyOf.Global(_, _), typed.BodyOf.Cond(_, _) { return Term.Program }
            case _ { }
        }
    }
    return Term.Block(b)
}

# a store (S4, O25b, O25c, O20): the slot's term from the target place, the value judged against it
fn (s mut Scoper&) assign(sp source.Span, p typed.Place&, x typed.Expr&) {
    t := p.Type()
    s.targets.Push(p)
    s.placeOperands(p)
    if not s.holds(t) {
        # an array value given a new length takes the temporary's storage (T11b), so the temporary is built where the
        # place's own storage is (O18a) - never in the block the assignment stands in, which may close first
        s.val(x, s.peekPlace(p, false) if s.arenaValue(t) else Term.None)
        try s.targets.Pop() catch { }
        return
    }
    slot, exact, kind := s.slotOf(p)
    if s.isRef(t) { s.splitBorrow(x) }
    # a call assigned: what its result holds is said at the "=" (C2d through a function's result)
    savedLand, savedLandSp := s.landSite, s.landSp
    ac := s.callOf(x)
    if ac != null { s.landSite, s.landSp = I64(ac.Site), s.eqAfter(p.Span()) }
    v := s.val(x, slot if slot.Runs() else s.here())
    s.landSite, s.landSp = savedLand, savedLandSp
    if wholeLocal(p) >= 0 { s.noteLate(wholeLocal(p), x) }
    if v.K == ValKind.Existing and s.bindingUnknown(p, slot) {
        # existing storage stored into a "&p" field of an instance whose construction binding is not known through this
        # path - an element, a field of another instance: only its container's scope is, an underestimate, and the store
        # could falsify the binding every reader of that instance relies on (O23, O11)
        if s.report { s.err(s.eqAfter(p.Span()), msgs.FieldBindingUnknown()) }
        try s.targets.Pop() catch { }
        return
    }
    if v.K == ValKind.Existing {
        # an assignment's own fit is said at its "=" (B11), a global's at the value (O1b)
        savedAt, savedSp := s.fitAt, s.fitSp
        s.fitAt, s.fitSp = kind != FitGlobal, s.eqAfter(p.Span())
        s.fit(v.T, slot, exact, x, kind)
        s.fitAt, s.fitSp = savedAt, savedSp
    }
    if v.K == ValKind.Fresh and not slot.Runs() and slot != Term.None { s.freshIntoUnknown(sp, p, slot) }
    try s.targets.Pop() catch { }
}

# whether a place is a "&p" field of an instance whose construction binding is not known here - reached through an
# element or another instance's field, or a local whose binding is not tracked: its slot only its container's scope,
# an underestimate (fieldTerm, O23)
fn (s mut Scoper&) bindingUnknown(p typed.Place&, slot Term) Bool {
    match p {
        case typed.Place.Field(_, _, base, i) {
            if not s.isStruct(base.Type()) { return false }
            match s.fieldMark(base.Type(), i) {
                case typed.Mark.Of(_) { }
                case _ { return false }
            }
            return match slot {
                case Term.Derived(q, _) => q < 0
                case _ => false
            }
        }
        case _ { return false }
    }
}

# whether a term is where a "&p" field of a parameter names, or one reached through an element: a derived scope, with no
# run-time scope to build in (C2d, O23a)
fn (s mut Scoper&) unknownBinding(t Term) Bool {
    return match t {
        case Term.Derived(q, _) => q >= 0 or (-q - 1 < s.underElem.Len() and s.underElem[-q - 1])
        case _ => false
    }
}

# a temporary stored where its slot's scope is not known here, said at the "=": through a "&p" field of a parameter, or
# one reached through an element (C2d, O23a); into a place whose references live in one of several scopes (O12) - in
# neither is there a run-time scope to build it in
fn (s mut Scoper&) freshIntoUnknown(sp source.Span, p typed.Place&, slot Term) {
    match slot {
        case Term.Derived(_, _) {
            if s.unknownBinding(slot) {
                if s.report { s.err(s.eqAfter(p.Span()), msgs.BuildThroughUnknownScope()) }
                return
            }
        }
        case Term.Set(_) {
            if s.report { s.err(s.eqAfter(p.Span()), msgs.StoreIntoUnknownScope()) }
            return
        }
        case _ { }
    }
    s.gapAt(sp, "a temporary stored where its slot's scope is not known here (O12, O23a)")
}

# the kinds of slot a fit is judged for: which error it gives
FitLocal I64 = 0  # a reference local or parameter (O25b)
FitField I64 = 1  # a field or an element reached through a container (O20, O25c)
FitGlobal I64 = 2 # a global or what is reached from one (O1b)
FitReturn I64 = 3 # a result (O14, O26)
FitValue I64 = 4  # a value local holding references (O25h)
FitPayload I64 = 5 # an enum case's payload (T17c)
FitDecl I64 = 6   # a constructor's field declared (C2d): where nothing can be stored through it, outliving (O10)
FitOwn I64 = 7    # a reference or function value returned, living in this function's own scope (O10d)
FitElem I64 = 8   # an array literal's element or an array's fill (O25c)

# a place's slot: its term, whether a value put there must be exactly in it, and its kind
fn (s mut Scoper&) slotOf(p typed.Place&) (Term, Bool, I64) {
    t := p.Type()
    isRef := s.isRef(t)
    match p {
        case typed.Place.Local(_, _, id) {
            loc := s.B.Locals[I64(id)]
            if isRef or s.isFunc(t) { return s.terms[I64(id)], s.narrowingMatters(t), FitLocal }
            return s.terms[I64(id)], s.storeThrough(t), FitValue
        }
        case typed.Place.Global(_, _, _, _) { return Term.Program, isRef and s.storeThrough(t), FitGlobal }
        case typed.Place.Field(_, _, base, i) {
            bt := base.Type()
            mark := typed.Mark.None
            if s.P.T.KindOf(bt) == types.Kind.Named and s.isStruct(bt) { mark = s.fieldMark(bt, i) }
            match mark {
                case typed.Mark.Of(_) {
                    # a field written "&p" keeps its argument's own scope: what is stored must outlive where that argument
                    # lived - the instance's construction binding, through a parameter its derived scope (C2d, O23a) - and
                    # be exactly there where something can be stored through it (O25g), so that building through the
                    # field builds where its referent is
                    return s.fieldTerm(base, i), s.storeThrough(t), FitField
                }
                case _ { }
            }
            return s.partsTerm(base), s.storeThrough(t), s.slotKind(base)
        }
        case typed.Place.Elem(_, _, e) { return s.partsTerm(e.Base), s.storeThrough(t), s.slotKind(e.Base) }
        case typed.Place.Payload(_, _, pl) { return s.partsTerm(pl.Base), s.storeThrough(t), s.slotKind(pl.Base) }
        case typed.Place.Deref(_, _, r) {
            # the whole referent written over: its references are where it lives
            return s.val(r, Term.None).T, s.storeThrough(t), FitField
        }
        case typed.Place.Temp(_, _, _, _) { return s.here(), false, FitValue }
        case typed.Place.Target(_, _) {
            if s.targets.Len() >= 2 { return s.slotOf(s.targets[s.targets.Len() - 2]) }
            return Term.Untraced, false, FitValue
        }
    }
}

fn (s mut Scoper&) slotKind(base typed.Place&) I64 {
    return match base {
        case typed.Place.Global(_, _, _, _) => FitGlobal
        case typed.Place.Field(_, _, b, _) => s.slotKind(b)
        case typed.Place.Elem(_, _, e) => s.slotKind(e.Base)
        case typed.Place.Payload(_, _, pl) => s.slotKind(pl.Base)
        case typed.Place.Local(_, _, _) => FitValue
        case _ => FitField
    }
}

fn (s mut Scoper&) isStruct(t types.TypeId) Bool {
    return s.P.T.KindOf(t) == types.Kind.Named and s.P.T.HasBody(t) and s.P.T.DeclKindOf(s.P.T.DeclOf(t)) == types.DeclKind.Struct
}

# where the references a place's parts hold live (O20, O25h, O5): through a reference, where it leads; a value local's
# references; a global's, the program's; a field written "&q" where its binding says (C2d, O23a), else its container's
fn (s mut Scoper&) partsTerm(p typed.Place&) Term {
    match p {
        case typed.Place.Local(_, _, id) {
            t := s.terms[I64(id)]
            return t if t != Term.None else s.stors[I64(id)]
        }
        case typed.Place.Global(_, _, _, _) { return Term.Program }
        case typed.Place.Deref(_, _, r) { return s.val(r, Term.None).T }
        case typed.Place.Field(_, _, base, i) { return s.fieldTerm(base, i) }
        case typed.Place.Elem(_, _, e) { return s.partsTerm(e.Base) }
        case typed.Place.Payload(_, _, pl) { return s.partsTerm(pl.Base) }
        case typed.Place.Temp(_, _, v, site) { return s.tempTerm(v, site) }
        case typed.Place.Target(_, _) {
            if s.targets.Len() >= 2 { return s.partsTerm(s.targets[s.targets.Len() - 2]) }
            return Term.Untraced
        }
    }
}

# what field i of the struct at base holds lives in: a bare field where the instance's references are; one written
# "&q" where q's argument lived (C2d, O23a) - read through a reference parameter p, the derived scope D(p, q); else
# where the instance is, an underestimate (O23) that is read but never built into nor shown to be outlived
fn (s mut Scoper&) fieldTerm(base typed.Place&, i I64) Term {
    bt := base.Type()
    if s.isStruct(bt) {
        match s.fieldMark(bt, i) {
            case typed.Mark.Of(q) {
                w := s.ctorParamIndex(bt, q)
                match base {
                    case typed.Place.Deref(_, _, r) {
                        y := regionLocal(r)
                        if y >= 0 and s.B.Locals[y].Kind == typed.LocalKind.Param { return Term.Derived(s.paramIndex(y), w) }
                    }
                    case _ { }
                }
                # an instance whose construction bindings are known (O23a): a local's, a field's of one
                if s.recAt(s.recOf(base), w) != Term.None { return s.recAt(s.recOf(base), w) }
                s.under.Push(s.partsTerm(base))
                s.underElem.Push(throughElem(base))
                return Term.Derived(-s.under.Len(), w)
            }
            case _ { }
        }
    }
    return s.partsTerm(base)
}

# whether a place is reached through an element of an array: no per-instance binding is known there (O23)
fn throughElem(p typed.Place&) Bool {
    return match p {
        case typed.Place.Elem(_, _, _) => true
        case typed.Place.Field(_, _, b, _) => throughElem(b)
        case typed.Place.Payload(_, _, pl) => throughElem(pl.Base)
        case typed.Place.Deref(_, _, r) => throughElemExpr(r)
        case typed.Place.Temp(_, _, _, _) => true
        case _ => false
    }
}

fn throughElemExpr(x typed.Expr&) Bool {
    if x == null { return false }
    return match x {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p) => throughElem(p)
        case typed.Expr.Away(_, _, y) => throughElemExpr(y)
        case _ => false
    }
}

# the index among a constructor's parameters of its local q, -1 for none
fn (s mut Scoper&) ctorParamIndex(t types.TypeId, q typed.LocalId) I64 {
    id := try s.ctorOf.Get(t) catch default -1
    if id < 0 { return -1 }
    ps := s.Bodies[id].Params
    for k in range ps.Len() {
        if ps[k] == q { return k }
    }
    return -1
}

# the index among this body's parameters of its local y
fn (s mut Scoper&) paramIndex(y I64) I64 {
    for k in range s.B.Params.Len() {
        if I64(s.B.Params[k]) == y { return k }
    }
    return -1
}

# a derived term of a local's instance (fieldTerm's underestimate): the term it stands above, else None
fn (s mut Scoper&) floorOf(t Term) Term {
    match t {
        case Term.Derived(p, _) {
            if p < 0 and -p - 1 < s.under.Len() { return s.under[-p - 1] }
        }
        case _ { }
    }
    return Term.None
}

# a value with no storage of its own read through a place (a field of a call's result): a call lands where its
# obligations say, as ":=" from it would (O18c: "m := r.mods[0]; m.top.Get(n)"), else where the place stands
fn (s mut Scoper&) tempVal(v typed.Expr&) Val {
    if s.callOf(v) != null and s.isFresh(v) {
        s.landing = true
        x := s.val(v, Term.None)
        s.landing = false
        return x
    }
    return s.val(v, s.here())
}

# where a place's own storage is (E12c): a local's block, what a reference names, a part of a value where the value's
# storage is - an element of a run-time-length array where its elements were built
fn (s mut Scoper&) storOf(p typed.Place&) Term {
    match p {
        case typed.Place.Local(_, _, id) { return s.stors[I64(id)] }
        case typed.Place.Global(_, _, _, _) { return Term.Program }
        case typed.Place.Deref(_, _, r) { return s.val(r, Term.None).T }
        case typed.Place.Field(_, _, base, _) { return s.storOf(base) }
        case typed.Place.Elem(_, _, e) {
            bt := e.Base.Type()
            if s.P.T.KindOf(bt) == types.Kind.Array and s.P.T.Length(bt) == types.TypeId(0) { return s.partsTerm(e.Base) }
            return s.storOf(e.Base)
        }
        case typed.Place.Payload(_, _, pl) { return s.storOf(pl.Base) }
        case typed.Place.Temp(_, _, v, site) {
            s.tempTerm(v, site)
            return s.frameHere()
        }
        case typed.Place.Target(_, _) {
            if s.targets.Len() >= 2 { return s.storOf(s.targets[s.targets.Len() - 2]) }
            return Term.Untraced
        }
    }
}

# where a temporary's own storage is: the block statements stand in - in a constructor's top level its frame, not the
# instance scope its builds go to (E16a, C2g)
fn (s mut Scoper&) frameHere() Term {
    b := s.blocks[s.blocks.Len() - 1]
    match s.B.Of {
        case typed.BodyOf.Ctor(_, _) { return Term.Block(b) }
        case _ { return s.here() }
    }
}

# a place's own subexpressions judged as operands: a reference it goes through, an index
fn (s mut Scoper&) placeOperands(p typed.Place&) {
    match p {
        case typed.Place.Deref(_, _, r) { s.val(r, Term.None) }
        case typed.Place.Field(_, _, b, _) { s.placeOperands(b) }
        case typed.Place.Elem(_, _, e) {
            s.placeOperands(e.Base)
            s.val(e.Index, Term.None)
        }
        case typed.Place.Payload(_, _, pl) { s.placeOperands(pl.Base) }
        case typed.Place.Temp(_, _, v, site) { s.tempTerm(v, site) }
        case _ { }
    }
}

# a temporary place's value judged once, its storage built where the place stands; the term its references are at
fn (s mut Scoper&) tempTerm(v typed.Expr&, site typed.SiteId) Term {
    t := try s.temps.Get(I64(site)) catch default Term.Untraced
    if t != Term.Untraced { return t }
    s.resAt = Term.None
    x := s.tempVal(v)
    h := s.here()
    s.build(site, h)
    t = x.T if x.T != Term.None else h
    # a call's array value holds no reference, but its elements are where its result scope is bound (T7b)
    if x.T == Term.None and s.arenaValue(v.Type()) and s.callOf(v) != null and s.resAt.Runs() { t = s.resAt }
    s.temps.Put(I64(site), t)
    return t
}

# a return (O13, O14, O26): the value judged against the result's term
fn (s mut Scoper&) ret(sp source.Span, x typed.Expr&) {
    if x == null { return }
    rt := s.P.T.Result(s.B.Ty)
    if s.P.T.KindOf(rt) == types.Kind.Tuple {
        match x {
            case typed.Expr.Make(_, _, m) {
                if m.Kind == typed.MakeKind.Tuple {
                    for k in range m.Items.Len() { s.retOne(k, m.Items[k]) }
                    return
                }
            }
            case _ { }
        }
        s.val(x, s.resultTerm(0))
        return
    }
    s.retOne(0, x)
}

# the term result k is built or borrowed in
fn (s mut Scoper&) resultTerm(k I64) Term {
    if s.P.T.KindOf(s.B.Ty) != types.Kind.Func { return s.here() }
    e := s.P.T.ResultFrom(s.B.Ty, k)
    if e >= 0 {
        if e < s.B.Params.Len() { return s.terms[I64(s.B.Params[e])] }
        return Term.Untraced
    }
    return Term.Var(s.resultVar) if s.resultVar >= 0 else s.here()
}

# whether the body being judged is a function whose result is, or holds by value, an array value
fn (s mut Scoper&) returnsArray() Bool {
    return s.P.T.KindOf(s.B.Ty) == types.Kind.Func and s.arenaValue(s.P.T.Result(s.B.Ty))
}

# where storage a result is made of is built when its type holds no reference: the result scope where the function
# has one, else the program's
fn (s mut Scoper&) storageTerm() Term { return Term.Var(s.resultVar) if s.resultVar >= 0 else Term.Program }

# whether a value of type t is, or holds by value, an array of a run-time length: storage of its own in an arena (T7b)
fn (s mut Scoper&) arenaValue(t types.TypeId) Bool {
    r := s.P.T.Repr(t)
    match s.P.T.KindOf(r) {
        case types.Kind.Array { return s.P.T.Length(r) == types.TypeId(0) }
        case types.Kind.Tuple, types.Kind.Record {
            for p in s.P.T.Items(s.P.T.Parts(r)) {
                if s.arenaValue(p) { return true }
            }
            return false
        }
        case _ { return false }
    }
}

# result k's mark (ResultMark), where the body's type gives one its parameters can say
fn (s mut Scoper&) resultMark(k I64) typed.Mark {
    if s.P.T.KindOf(s.B.Ty) != types.Kind.Func { return typed.Mark.Bare }
    e := s.P.T.ResultFrom(s.B.Ty, k)
    if e >= s.B.Params.Len() { return typed.Mark.TypeVar }
    return s.B.ResultMark(s.P.T, k)
}

fn (s mut Scoper&) retOne(k I64, x typed.Expr&) {
    t := x.Type()
    if not s.holds(t) {
        # an array value: its type holds no reference, so its function may have no result scope to build it in (the
        # typed contract gives none), and then what it is made of outlives the call only in the program's scope - where
        # lower makes its copy of a returned array value too (T7b)
        s.val(x, s.storageTerm() if s.arenaValue(t) else Term.None)
        return
    }
    dest := s.resultTerm(k)
    v := s.val(x, dest)
    if k == 0 and s.P.T.KindOf(s.B.Ty) == types.Kind.Func and s.P.T.KindOf(s.P.T.Result(s.B.Ty)) != types.Kind.Tuple {
        s.noteResBind(x)
    }
    m := s.resultMark(k)
    built := match m {
        case typed.Mark.Of(_), typed.Mark.TypeVar => false
        case _ => s.isRef(t) and not s.isFunc(t)
    }
    # a read-only reference to existing storage returned as a built result, which is new and writable (T25c, O14)
    if built and v.K == ValKind.Fresh and s.handsBackExisting(x) and s.readOnlyAsBuilt(x) { return }
    if v.K != ValKind.Existing { return }
    exact := s.storeThrough(t)
    match m {
        case typed.Mark.Of(_) { s.fit(v.T, dest, exact, x, FitReturn) }
        case typed.Mark.TypeVar { s.fit(v.T, dest, exact, x, FitReturn) }
        case _ {
            # a built result: a value whose scope is the result scope (O26), else an obligation where the language
            # allows one - a function value (O14a), a value holding references (O14c)
            if s.isFunc(t) or not s.isRef(t) {
                s.fit(v.T, dest, exact, x, FitReturn)
            } else if v.T == dest or not s.builtFromParam(x, v.T) {
                s.fit(v.T, dest, true, x, FitReturn)
            }
        }
    }
}

# O14, T25c: existing storage a parameter's reference reaches, returned as a built result - which is new storage, in
# the result scope, and writable - is a borrowed result, and the error says how to write it: true when it said so
fn (s mut Scoper&) builtFromParam(x typed.Expr&, t Term) Bool {
    if not s.report { return false }
    u := s.unAway(x)
    param := match t {
        case Term.Var(k) => k < s.B.Vars.Len() and s.isParamVar(s.B.Vars[k])
        case Term.Derived(p, _) => p >= 0
        case _ => false
    }
    lvalue := match u {
        case typed.Expr.Read(_, _, _, _), typed.Expr.Borrow(_, _, _) => true
        case _ => false
    }
    if param and lvalue {
        s.err(s.opTok(x), msgs.ReturnBorrowAsBuilt())
        return true
    }
    if param { return s.readOnlyAsBuilt(x) }
    return false
}

# T25c, O14: a read-only reference returned as a built result: borrow it from the parameter it is read through - true
# when it said so
fn (s mut Scoper&) readOnlyAsBuilt(x typed.Expr&) Bool {
    rt := x.Type()
    if not s.isRef(rt) or (s.P.T.PermOf(rt) & types.Writable) != 0 { return false }
    p := s.paramRoot(s.unAway(x))
    if p < 0 or s.Spell == null {
        s.err(s.opTok(x), msgs.ReadOnlyToBuiltResultNo())
    } else {
        s.err(s.opTok(x), msgs.ReadOnlyToBuiltResult($s.Spell(s.P.T.Referent(rt)) "&" $s.P.L.Names.Text(s.B.Locals[p].Name)))
    }
    return true
}

# whether a call hands back existing storage: its result borrowed from a parameter, or written as a type variable
# (O13, O14b)
fn (s mut Scoper&) handsBackExisting(x typed.Expr&) Bool {
    c := s.callOf(s.unAway(x))
    if c == null { return false }
    fty := s.calleeType(c)
    if fty == types.UnknownT { return false }
    r := s.P.T.ResultFrom(fty, 0)
    return r >= 0 or r == types.FromTypeVar
}

fn (s mut Scoper&) isParamVar(v typed.ScopeVar) Bool {
    return match v {
        case typed.ScopeVar.Param(_) => true
        case _ => false
    }
}

# the parameter a value is read through - a member, an element, a slice or an At call of it; -1 for none
fn (s mut Scoper&) paramRoot(x typed.Expr&) I64 {
    u := s.unAway(x)
    match u {
        case typed.Expr.Call(_, _, c) {
            if c.Args.Len() > 0 { return s.paramRoot(c.Args[0]) }
            return -1
        }
        case typed.Expr.Slice(_, _, sl) {
            r := flRoot(sl.Base)
            return r if r >= 0 and s.B.Locals[r].Kind == typed.LocalKind.Param else -1
        }
        case _ { }
    }
    r := flRootExpr(u)
    return r if r >= 0 and s.B.Locals[r].Kind == typed.LocalKind.Param else -1
}

# a task (P1, P1g, P2): its targets are assignments of its results; its call judged as any call, landing where its one
# target is
fn (s mut Scoper&) spawn(sp source.Span, sw typed.Spawn&) {
    j := Term.None
    if s.joins.Len() > 0 { j = Term.Block(s.joins[s.joins.Len() - 1]) }
    for p in sw.Targets {
        s.placeOperands(p)
        # a local a task's result is given has no record a read could trust (O23a)
        if s.lateGather and wholeLocal(p) >= 0 { s.lateNone.Put(wholeLocal(p), true) }
        # a target is stored into when the task's call returns: it lasts until the join (P1g)
        if not s.lastsUntil(s.peekPlace(p, false), j) and s.report { s.err(p.Span(), msgs.SpawnResultTooShort()) }
    }
    dest := Term.None
    if sw.Targets.Len() == 1 {
        slot, _, _ := s.slotOf(sw.Targets[0])
        dest = slot
    }
    for c in sw.Clauses {
        # a clause runs on the task's thread: what it captured is handed to the task (P2), and the default it gives is
        # built where the targets are (P4a, R9a)
        s.inSpawn = true
        v := s.val(c.Handler, j)
        s.inSpawn = false
        if v.K == ValKind.Existing and not s.lastsUntil(v.T, j) and s.report {
            s.err(s.firstToken(s.B.File, c.Sp), msgs.SpawnCaptureTooShort())
        }
        match c.Handler {
            case typed.Expr.Fn(_, _, f) {
                match f {
                    case typed.FnVal.Lambda(id, _, _) { s.clauseBuilds(I64(id), dest, c.Sp) }
                    case _ { }
                }
            }
            case _ { }
        }
    }
    s.inSpawn = true
    s.taskJoin = j
    v := s.val(sw.Task, dest)
    s.inSpawn = false
    s.taskJoin = Term.None
    # each target is assigned its result as an assignment's value is (P1g, O25): said at the spawn
    if v.K == ValKind.Existing {
        for p in sw.Targets {
            if not s.holds(p.Type()) { continue }
            slot, exact, kind := s.slotOf(p)
            savedAt, savedSp := s.fitAt, s.fitSp
            s.fitAt, s.fitSp = true, s.firstToken(s.B.File, sp)
            s.fit(v.T, slot, exact, sw.Task, kind)
            s.fitAt, s.fitSp = savedAt, savedSp
        }
    }
    if sw.Site >= typed.SiteId(0) { s.build(sw.Site, j if j.Runs() else s.here()) }
}

# the assignment operator after a place written at sp: "=", or a compound one ("+=", "<<=") - the place's own span where
# there is none
fn (s mut Scoper&) eqAfter(sp source.Span) source.Span {
    text := try s.texts.Get(s.B.File) catch default ""
    k := I64(sp.End)
    depth := 0
    for k < text.Len() and text[k] != '\n' {
        ch := text[k]
        if ch == '(' or ch == '[' or ch == '{' {
            depth++
        } else if ch == ')' or ch == ']' or ch == '}' {
            depth--
        } else if ch == '=' and depth == 0 {
            if k + 1 < text.Len() and text[k + 1] == '=' {
                k += 2
                continue
            }
            from := k
            for from > I64(sp.End) and text[from - 1] != ' ' and text[from - 1] != ')' and text[from - 1] != ']' and not isNameChar(text[from - 1]) { from-- }
            return source.Span(I32(from), I32(k + 1))
        }
        k++
    }
    return sp
}

# whether a build through a call into scope variable v is one: where v is bound to a derived scope (O23a), only through a
# parameter something could be stored through, or one a result is borrowed from (C2d)
fn (s mut Scoper&) derivedBuilds(fty types.TypeId, vars Array<I64>&, v I64, beta Array<Term>&) Bool {
    match beta[v] {
        case Term.Derived(_, _) { }
        case _ { return true }
    }
    q := vars[v]
    ps := s.P.T.Items(s.P.T.Params(fty))
    if q < 0 or q >= ps.Len() { return true }
    if s.admitsStores(ps[q]) { return true }
    for k in range s.P.T.Results(fty).Len() {
        if s.P.T.ResultFrom(fty, k) == q { return true }
    }
    return false
}

# O17a: a value whose references live where its own storage does not, borrowed into a reference, would take them to
# live where that is (O20) - refused where something could be stored through them
fn (s mut Scoper&) splitBorrow(x typed.Expr&) {
    match s.unAway(x) {
        case typed.Expr.Borrow(sp, _, p) {
            if s.splitPlace(p) and s.report { s.err(s.firstToken(s.B.File, sp), msgs.BorrowSplitValue()) }
        }
        case _ { }
    }
}

# whether a place, not reached through a reference, is (part of) a value whose references live where its own storage
# does not, something being storable through them (O17a)
fn (s mut Scoper&) splitPlace(p typed.Place&) Bool {
    if flThroughRef(p) or not s.valueAdmits(p.Type()) { return false }
    refs := s.peekPlace(p, true)
    stor := s.peekPlace(p, false)
    match refs {
        case Term.Set(_) { return true }
        case Term.None, Term.Untraced { return false }
        case _ { }
    }
    return stor != Term.None and stor != Term.Untraced and refs != stor
}

# whether a value of type t holds, by value, a reference through which something could be stored (O17a)
fn (s mut Scoper&) valueAdmits(t types.TypeId) Bool {
    if s.isRef(t) { return false }
    k := pair.Pair(I64(t), 2)
    state := try s.asTypes.Get(k) catch default 0
    if state != 0 { return state == 3 }
    s.asTypes.Put(k, 1)
    r := false
    for p in s.parts(t) {
        if s.isRef(p) {
            if s.admitsStores(p) { r = true }
        } else if s.valueAdmits(p) {
            r = true
        }
    }
    s.asTypes.Put(k, 3 if r else 2)
    return r
}

# where a slice is said: its "[", a view at its "as"
fn (s mut Scoper&) sliceAt(sp source.Span, sl typed.Slice&) source.Span {
    text := try s.texts.Get(s.B.File) catch default ""
    k := I64(sl.Base.Span().End)
    for k < I64(sp.End) and k < text.Len() {
        if not sl.Exact and text[k] == '[' { return source.Span(I32(k), I32(k + 1)) }
        if sl.Exact and k + 2 <= text.Len() and text[k] == 'a' and text[k + 1] == 's' { return source.Span(I32(k), I32(k + 2)) }
        k++
    }
    return sp
}

# where an error about an operand a task is handed is said (P2): a member read at the member's name, a call at its
# callee's, a lambda at its "fn", anything else where it begins
fn (s mut Scoper&) opTok(x typed.Expr&) source.Span {
    u := s.unAway(x)
    match u {
        case typed.Expr.Promote(_, _, pr) { return s.opTok(pr.X) }
        case typed.Expr.Call(sp, _, _), typed.Expr.Make(sp, _, _) { return s.nameSpan(sp) }
        case typed.Expr.Slice(sp, _, sl) { return s.sliceAt(sp, sl) }
        case typed.Expr.Cond(sp, _, c) { return s.wordAt(source.Span(c.A.Span().End, sp.End), "if") }
        case typed.Expr.Read(sp, _, p, _), typed.Expr.Borrow(sp, _, p) {
            match p {
                case typed.Place.Field(_, _, _, _) { return s.lastName(sp) }
                case typed.Place.Elem(_, _, _) { return s.lastBracket(sp) }
                # a slice's elements copied out, said at the slice
                case typed.Place.Deref(_, _, r) {
                    match s.unAway(r) {
                        case typed.Expr.Slice(_, _, _) { return s.opTok(r) }
                        case _ { }
                    }
                }
                case _ { }
            }
        }
        case _ { }
    }
    return s.firstToken(s.B.File, u.Span())
}

# the argument determining scope variable v, said at its last name (a build through a derived scope, C2d); at for none
fn (s mut Scoper&) ownerAt(c typed.Call&, owner Array<I64>&, v I64, at source.Span) source.Span {
    for i in range c.Args.Len() {
        if i < owner.Len() and owner[i] == v { return s.lastName(c.Args[i].Span()) }
    }
    return at
}

# an index's "[" in sp: the last one outside every bracket - an index of an index, a[i][j], the outer one's
fn (s mut Scoper&) lastBracket(sp source.Span) source.Span {
    text := try s.texts.Get(s.B.File) catch default ""
    depth := 0
    at := -1
    for k in range I64(sp.Start), I64(sp.End) {
        if k >= text.Len() { break }
        c := text[k]
        if c == '[' {
            if depth == 0 { at = k }
            depth++
        } else if c == '(' {
            depth++
        } else if (c == ']' or c == ')') and depth > 0 {
            depth--
        }
    }
    return source.Span(I32(at), I32(at + 1)) if at >= 0 else s.firstToken(s.B.File, sp)
}

# whether storage at term t lasts until join block j closes (P2): a block j's or one enclosing it; a set where each of
# its terms does; anything else (a scope variable, the program's, a term not known here) is not shown not to
fn (s mut Scoper&) lastsUntil(t Term, j Term) Bool {
    if j == Term.None { return true }
    match t {
        case Term.Set(id) {
            for m in range s.setFrom[id], s.setEnd(id) {
                if not s.lastsUntil(s.setTerms[m], j) { return false }
            }
            return true
        }
        case Term.Block(_) { return s.order(t, j) == Holds }
        case _ { return true }
    }
}

# a task clause's lambda lb giving a default built in its result scope, which is where the spawn's targets are (dest)
fn (s mut Scoper&) clauseBuilds(lb I64, dest Term, sp source.Span) {
    vs := s.Bodies[lb].Vars
    for k in range vs.Len() {
        if vs[k] != typed.ScopeVar.Result { continue }
        if s.buildsSum(lb, k) { s.buildsThrough(dest, sp, lb, k) }
    }
}

# held locals no use placed: their temporaries are built in the block they were held in
fn (s mut Scoper&) landHeld() {
    for e in s.held {
        s.val(e.Value, s.here())
    }
}

# ---- expressions ----

# whether an expression is a temporary (E12c): new storage, or a value with no storage of its own whose references
# are new - not existing storage read, borrowed or copied, nor constant data
fn (s mut Scoper&) isFresh(x typed.Expr&) Bool {
    if x == null { return false }
    return match x {
        case typed.Expr.Promote(_, _, _), typed.Expr.Make(_, _, _), typed.Expr.Collect(_, _, _) => true
        case typed.Expr.Text(_, _, _) => true
        case typed.Expr.Call(_, ty, c) => s.callBuilds(c, ty)
        case typed.Expr.Seq(_, _, q) => s.isFresh(q.X)
        case typed.Expr.Away(_, _, y) => s.isFresh(y)
        case typed.Expr.Try(_, _, t) => s.isFresh(t.X)
        case typed.Expr.Cond(_, _, c) => s.isFresh(c.A) and s.isFresh(c.B)
        case typed.Expr.Prim(_, _, op, _, args) => op == typed.PrimOp.Convert and args.Len() > 0 and s.isFresh(args[0])
        case typed.Expr.Fn(_, _, f) => s.fnFresh(f)
        case _ => false
    }
}

fn (s mut Scoper&) fnFresh(f typed.FnVal&) Bool {
    return match f {
        case typed.FnVal.Lambda(_, caps, _) => s.capturesNothing(caps)
        case _ => false
    }
}

fn (s mut Scoper&) capturesNothing(caps Array<typed.Capture&>&) Bool {
    for c in caps {
        if s.holds(c.Outer.Type()) { return false }
    }
    return true
}

# whether a call's result is built (a temporary): a built result holding references, or a constructor's instance
fn (s mut Scoper&) callBuilds(c typed.Call&, ty types.TypeId) Bool {
    if not s.holds(ty) { return false }
    fty := s.calleeType(c)
    if fty == types.UnknownT { return true }
    if s.P.T.Role(fty) == types.RoleCtor { return true }
    e := s.P.T.ResultFrom(fty, 0)
    return e < 0
}

fn (s mut Scoper&) calleeType(c typed.Call&) types.TypeId {
    return match c.Target {
        case typed.Callee.Body(id) => s.Bodies[I64(id)].Ty
        case typed.Callee.Value(x) => x.Type()
        case _ => types.UnknownT
    }
}

# an expression judged: what it is to section 8, every temporary in it built where it lands - in dest where dest is a
# run-time term, else where the expression stands (O18a's last row)
fn (s mut Scoper&) val(x typed.Expr&, dest Term) Val {
    if x == null { return plain() }
    d := dest if dest.Runs() else s.here()
    match x {
        case typed.Expr.Lit(_, ty, bits) {
            if s.holds(ty) { return Val(ValKind.Null, Term.None) }
            return plain()
        }
        case typed.Expr.Data(_, _, _, _) { return Val(ValKind.Static, Term.Program) }
        case typed.Expr.Read(_, ty, p, _) { return s.read(p, ty, dest) }
        case typed.Expr.Take(_, ty, p) { return s.read(p, ty, dest) }
        case typed.Expr.Borrow(_, _, p) {
            s.placeOperands(p)
            return existing(s.storOf(p))
        }
        case typed.Expr.Promote(_, _, pr) {
            s.buildSite(pr.Site, d, pr.X.Span())
            s.val(pr.X, d)
            # a conversion of an array's storage to a type declared over it names that storage (T29a, E12c): it is no
            # temporary, and lives where the storage does
            cp := s.convertedPlace(pr.X)
            if cp != null {
                t := s.peekPlace(cp, false)
                if t != Term.None { return existing(t) }
            }
            return fresh(d)
        }
        case typed.Expr.Call(sp, ty, c) { return s.call(sp, ty, c, dest) }
        case typed.Expr.Make(_, ty, m) {
            if m.Site >= typed.SiteId(0) { s.build(m.Site, d) }
            s.val(m.Length, Term.None)
            # an item built in d too (O6), existing storage judged as a slot of it (O25c, T17c) - a payload's once
            # its items agree on one scope (T17c)
            vs := Array<Val>(m.Items.Len())
            for k in range m.Items.Len() { vs[k] = s.val(m.Items[k], d) }
            agreed := m.Kind != typed.MakeKind.Case or not s.report or s.payloadAgree(m.Items, vs)
            for k in range m.Items.Len() {
                if agreed and vs[k].K == ValKind.Existing { s.fit(vs[k].T, d, s.storeThrough(m.Items[k].Type()), m.Items[k], s.itemKind(m.Kind)) }
            }
            if not s.holds(ty) and m.Site < typed.SiteId(0) { return plain() }
            return fresh(d)
        }
        case typed.Expr.Collect(_, _, c) {
            s.build(c.Site, d)
            s.val(c.Reserve, Term.None)
            s.block(c.Loop)
            return fresh(d)
        }
        case typed.Expr.Prim(_, ty, op, _, args) {
            # a conversion names its argument's storage (T29a): an array value's too
            if op == typed.PrimOp.Convert and args.Len() > 0 and (s.holds(ty) or s.arenaValue(ty)) { return s.val(args[0], dest) }
            for a in args { s.val(a, Term.None) }
            return plain()
        }
        case typed.Expr.Slice(sp, ty, sl) {
            # a slice of a call's built result put elsewhere has its call land there (O18a)
            pk := s.partLand(sl.Base, ty, dest)
            s.placeOperands(sl.Base)
            # a slice or a view of a value whose references live elsewhere than its storage would take them to live
            # where that is (O17a)
            if s.splitPlace(sl.Base) and s.report { s.err(s.sliceAt(sp, sl), msgs.SliceSplitValue()) }
            s.val(sl.Lo, Term.None)
            s.val(sl.Hi, Term.None)
            st := s.sliceTerm(sl.Base)
            if pk >= 0 { s.partDest.Remove(pk) }
            return existing(st)
        }
        case typed.Expr.Cond(_, ty, c) {
            s.val(c.C, Term.None)
            xs List<typed.Expr&>
            xs.Push(c.A)
            xs.Push(c.B)
            nd := s.choiceDest(xs, dest)
            a := s.val(c.A, nd)
            b := s.val(c.B, nd)
            return s.join(a, b, d)
        }
        case typed.Expr.Seq(_, _, q) {
            ad := s.atDest
            s.atDest = false
            s.stmts(q.Stmts)
            s.atDest = ad
            return s.val(q.X, dest)
        }
        case typed.Expr.Match(_, ty, m) { return s.match(m, dest) }
        case typed.Expr.Try(_, _, t) {
            v := s.val(t.X, dest)
            # a default is built where the value it stands for lives (R9a, R11)
            dd := v.T if (v.K == ValKind.Existing or v.K == ValKind.Fresh) and v.T.Runs() else dest
            cv := v
            for c in t.Clauses {
                s.block(c.Code)
                for df in c.Defaults {
                    dv := s.val(df, dd)
                    if s.report and s.isRef(x.Type()) and not s.defaultFits(cv, dv) { s.err(s.opTok(df), msgs.DefaultScope()) }
                    v = s.join(v, dv, d)
                }
            }
            return v
        }
        case typed.Expr.Fn(sp, ty, f) { return s.fnVal(f, d, sp) }
        case typed.Expr.Text(_, _, t) {
            s.build(t.Site, d)
            for pc in t.Pieces {
                match pc {
                    case typed.Piece.Render(r) { s.val(r, Term.None) }
                    case _ { }
                }
            }
            return fresh(d)
        }
        case typed.Expr.Away(_, _, y) { return s.val(y, dest) }
    }
}

# whether a reference default dv lives where the call's result cv does (R11, O25): existing storage exactly there, a
# temporary or constant data built or living anywhere a known scope is - null always
fn (s mut Scoper&) defaultFits(cv Val, dv Val) Bool {
    known := match cv.T {
        case Term.Set(_), Term.Untraced => false
        case _ => true
    }
    return match dv.K {
        case ValKind.Existing => known and cv.T != Term.None and dv.T == cv.T
        case ValKind.Fresh, ValKind.Static => known
        case _ => true
    }
}

# the place a conversion to a declared array type reads (T29a): an array value read, not through a reference - null
# for anything else
fn (s mut Scoper&) convertedPlace(x typed.Expr&) typed.Place&x {
    match s.unAway(x) {
        case typed.Expr.Prim(_, ty, op, _, args) {
            if op != typed.PrimOp.Convert or args.Len() != 1 or s.P.T.KindOf(s.P.T.Plain(ty)) != types.Kind.Named { return null }
            match s.unAway(args[0]) {
                case typed.Expr.Read(_, at, p, _) {
                    k := s.P.T.KindOf(at)
                    if k != types.Kind.Array and k != types.Kind.Named { return null }
                    match p {
                        case typed.Place.Temp(_, _, _, _) { return null }
                        case _ { return p }
                    }
                }
                case _ { }
            }
        }
        case _ { }
    }
    return null
}

# an item of an array, tuple or case being built in d: a temporary built there too (O6), existing storage judged as a
# slot of it (O25c, T17c)
# the kind of slot an item of a value made is (fit)
fn (s mut Scoper&) itemKind(k typed.MakeKind) I64 {
    return match k {
        case typed.MakeKind.Case => FitPayload
        case typed.MakeKind.Array, typed.MakeKind.Fill => FitElem
        case _ => FitField
    }
}

fn (s mut Scoper&) item(x typed.Expr&, d Term, kind I64) {
    v := s.val(x, d)
    if v.K == ValKind.Existing { s.fit(v.T, d, s.storeThrough(x.Type()), x, kind) }
}

# what reading a place gives (O20, O25h): a reference's referent's term, a value's references' - a held local's
# temporary built where this one use puts it; a part of a call's built result read where it is put elsewhere than here
# has its call land there (O18a: "f = mkBox(i).n" with f outside the loop)
fn (s mut Scoper&) read(p typed.Place&, ty types.TypeId, dest Term) Val {
    k := s.partLand(p, ty, dest)
    v := s.readPart(p, ty, dest)
    if k >= 0 { s.partDest.Remove(k) }
    return v
}

# where a part of a call's built result is put elsewhere than the block it stands in: that call's site, its landing
# noted for the call (O18a); -1 for none
fn (s mut Scoper&) partLand(p typed.Place&, ty types.TypeId, dest Term) I64 {
    if not dest.Runs() or dest == s.here() or not s.holds(ty) { return -1 }
    k := s.partCall(p)
    if k < 0 or (try s.partDest.Get(k) catch default Term.None) != Term.None or not s.partOK(p, dest) { return -1 }
    s.partDest.Put(k, dest)
    return k
}

# the site of the call whose built result a place is a part of - a field, an element or a payload of it, through what it
# holds, or of a held local it initializes (D8d) - -1 for none
fn (s mut Scoper&) partCall(p typed.Place&) I64 {
    return match p {
        case typed.Place.Field(_, _, b, _) => s.partCall(b)
        case typed.Place.Elem(_, _, e) => s.partCall(e.Base)
        case typed.Place.Payload(_, _, pl) => s.partCall(pl.Base)
        case typed.Place.Deref(_, _, r) => s.builtCall(r)
        case typed.Place.Temp(_, _, v, _) => s.builtCall(v)
        case typed.Place.Local(_, _, id) => s.builtCall(try s.held.Get(I64(id)) catch default null)
        case _ => -1
    }
}

# whether the call partCall finds can land in t: what its callee's obligations need its result scope to be outlived by
# - read off its arguments without judging them - outlives t (as stage 0 lands it only there)
fn (s mut Scoper&) partOK(p typed.Place&, t Term) Bool {
    return match p {
        case typed.Place.Field(_, _, b, _) => s.partOK(b, t)
        case typed.Place.Elem(_, _, e) => s.partOK(e.Base, t)
        case typed.Place.Payload(_, _, pl) => s.partOK(pl.Base, t)
        case typed.Place.Deref(_, _, r) => s.builtOK(r, t)
        case typed.Place.Temp(_, _, v, _) => s.builtOK(v, t)
        case typed.Place.Local(_, _, id) => s.builtOK(try s.held.Get(I64(id)) catch default null, t)
        case _ => false
    }
}

fn (s mut Scoper&) builtOK(x typed.Expr&, t Term) Bool {
    if x == null { return false }
    match x {
        case typed.Expr.Read(_, _, q, _) { return s.partOK(q, t) }
        case typed.Expr.Away(_, _, y) { return s.builtOK(y, t) }
        case _ { }
    }
    c := s.callOf(x)
    if c == null { return false }
    fty := s.calleeType(c)
    callee := s.bodyOf(c.Target)
    if callee < 0 or not s.summed(callee) { return false }
    rv := s.resultVarOf(fty)
    if rv < 0 { return true }
    vars := s.P.T.ScopeVarsOf(fty)
    for r in s.sums[callee].Rels {
        if r.Lo != Term.Var(rv) or r.Hi == Term.Var(rv) { continue }
        match r.Hi {
            case Term.Var(v) {
                b := Term.None
                for i in range c.Args.Len() {
                    k := s.P.T.ShareOf(fty, i)
                    q := k if k >= 0 else i
                    if v < vars.Len() and vars[v] == q {
                        b = s.peekTerm(c.Args[i])
                        break
                    }
                }
                if b == Term.None and s.staticVar(c, v) { b = Term.Program }
                # a temporary given for it is bound after, where the result lands
                if b == Term.None { continue }
                o := s.order(b, t)
                if o != Holds and o != Obliged { return false }
            }
            case Term.Program { }
            case _ { return false }
        }
    }
    return true
}

# the site of the call an expression is where its result is built (a temporary) - read out of the temporary holding it,
# or a part of one - else -1
fn (s mut Scoper&) builtCall(x typed.Expr&) I64 {
    if x == null { return -1 }
    match x {
        case typed.Expr.Read(_, _, q, _) { return s.partCall(q) }
        case typed.Expr.Away(_, _, y) { return s.builtCall(y) }
        case _ { }
    }
    # an array value a call gives is built in its result scope (T7b)
    if not s.isFresh(x) and not s.arenaValue(x.Type()) { return -1 }
    c := s.callOf(x)
    return I64(c.Site) if c != null else -1
}

fn (s mut Scoper&) readPart(p typed.Place&, ty types.TypeId, dest Term) Val {
    # an array value read out of a call's built result shares that result's storage - nothing is copied - so the result is
    # built where the value goes (T7b)
    match p {
        case typed.Place.Deref(_, _, r) {
            if dest != Term.None and s.arenaValue(ty) and s.isFresh(r) {
                v := s.val(r, dest)
                if not s.holds(ty) { return plain() }
                return existing(v.T)
            }
        }
        case _ { }
    }
    s.placeOperands(p)
    match p {
        case typed.Place.Local(_, _, id) {
            x := try s.held.Get(I64(id)) catch default null
            if x != null {
                s.held.Remove(I64(id))
                v := s.val(x, dest)
                s.terms[I64(id)] = v.T
                return v
            }
        }
        case _ {
            # a part of a held local - one of a destructured call's results (D8c): the call lands where its first use puts
            # it, as the whole would
            r := flRoot(p)
            if r >= 0 and not flThroughRef(p) {
                x := try s.held.Get(r) catch default null
                if x != null {
                    s.held.Remove(r)
                    v := s.val(x, dest)
                    s.terms[r] = v.T
                }
            }
        }
    }
    if not s.holds(ty) { return plain() }
    match p {
        case typed.Place.Local(_, _, id) { return existing(s.whereLives(id)) }
        case typed.Place.Deref(_, _, r) { return existing(s.val(r, Term.None).T) }
        case _ { return existing(s.partsTerm(p)) }
    }
}

# a slice's term (E16a): where its base's elements are - of a temporary, the block it is written in
fn (s mut Scoper&) sliceTerm(base typed.Place&) Term {
    bt := base.Type()
    if s.P.T.KindOf(bt) == types.Kind.Ref { return s.storOf(base) }
    if s.P.T.KindOf(bt) == types.Kind.Array and s.P.T.Length(bt) == types.TypeId(0) { return s.partsTerm(base) }
    return s.storOf(base)
}

# where a choice's new values are built (E28, S12b): where the values it gives that already live somewhere share a scope,
# read off their shape - else where the choice lands
fn (s mut Scoper&) choiceDest(xs List<typed.Expr&>&, dest Term) Term {
    if s.atDest {
        s.atDest = false
        return dest
    }
    shared := Term.None
    for x in xs {
        if s.isFresh(x) or s.isNullLit(x) or not s.holds(x.Type()) { continue }
        t := s.choicePeek(x)
        if t == Term.None or not t.Runs() { return dest }
        if shared == Term.None {
            shared = t
        } else if shared != t {
            return dest
        }
    }
    return dest if shared == Term.None else shared
}

# a choice's value's term read off its shape, as peekTerm reads it - None where it reads a match's binding, whose term
# its arm gives
fn (s mut Scoper&) choicePeek(x typed.Expr&) Term {
    match x {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p) {
            r := flRoot(p)
            if r < 0 or s.B.Locals[r].Kind == typed.LocalKind.Binding or s.B.Locals[r].Kind == typed.LocalKind.Held { return Term.None }
        }
        case typed.Expr.Away(_, _, y) { return s.choicePeek(y) }
        # a result borrowed from an argument lives where that argument's referent does (O13)
        case typed.Expr.Call(_, _, c) {
            fty := s.calleeType(c)
            if fty == types.UnknownT { return Term.None }
            e := s.P.T.ResultFrom(fty, 0)
            if e < 0 or e >= c.Args.Len() { return Term.None }
            return s.choicePeek(c.Args[e])
        }
        case _ { return Term.None }
    }
    return s.peekTerm(x)
}

# two values a choice can give, joined (E28, O12): one term where they agree, a set where they do not
fn (s mut Scoper&) join(a Val, b Val, d Term) Val {
    if a.K == ValKind.Plain { return b }
    if b.K == ValKind.Plain { return a }
    if a.K == ValKind.Null or a.K == ValKind.Static { return b }
    if b.K == ValKind.Null or b.K == ValKind.Static { return a }
    if a.T == b.T { return Val(ValKind.Existing if a.K == ValKind.Existing or b.K == ValKind.Existing else a.K, a.T) }
    return existing(s.setOf(a.T, b.T))
}

fn (s mut Scoper&) setOf(a Term, b Term) Term {
    xs List<Term>
    s.addToSet(xs, a)
    s.addToSet(xs, b)
    if xs.Len() == 1 { return xs[0] }
    s.setFrom.Push(s.setTerms.Len())
    for t in xs { s.setTerms.Push(t) }
    return Term.Set(s.setFrom.Len() - 1)
}

# where set id's terms end in setTerms
fn (s mut Scoper&) setEnd(id I64) I64 { return s.setFrom[id + 1] if id + 1 < s.setFrom.Len() else s.setTerms.Len() }

fn (s mut Scoper&) addToSet(xs mut List<Term>&, t Term) {
    match t {
        case Term.Set(id) {
            for k in range s.setFrom[id], s.setEnd(id) { s.addToSet(xs, s.setTerms[k]) }
            return
        }
        case _ { }
    }
    for u in xs {
        if u == t { return }
    }
    xs.Push(t)
}

fn (s mut Scoper&) match(m typed.Match&, dest Term) Val {
    s.stmts(m.Held)
    if m.IsValue {
        xs List<typed.Expr&>
        for a in m.Arms {
            if a != null and a.Value != null { xs.Push(a.Value) }
        }
        if m.NoMatch != null and m.NoMatch.Value != null { xs.Push(m.NoMatch.Value) }
        dest = s.choiceDest(xs, dest)
    }
    d := dest if dest.Runs() else s.here()
    v := plain()
    first := true
    for a in m.Arms {
        av := s.arm(a, dest)
        if m.IsValue {
            v = av if first else s.join(v, av, d)
            first = false
        }
    }
    nv := s.arm(m.NoMatch, dest)
    if m.IsValue and m.NoMatch != null and m.NoMatch.Value != null { v = s.join(v, nv, d) }
    return v
}

fn (s mut Scoper&) arm(a typed.Arm&, dest Term) Val {
    if a == null { return plain() }
    bound List<I64>
    for alt in a.Alts {
        s.val(alt.Test, Term.None)
        for bd in alt.Binds {
            v := s.val(bd.From, Term.None)
            l := I64(bd.To)
            # a binding is a local of its clause's block (S13b); alternatives binding one name from different scopes
            # bind it where neither is known (S13c, O12)
            s.stors[l] = s.blockTerm(s.B.Locals[l].In)
            if flHas(bound, l) and s.terms[l] != v.T and s.terms[l] != Term.None and v.T != Term.None {
                s.terms[l] = s.setOf(s.terms[l], v.T)
            } else if not flHas(bound, l) {
                s.terms[l] = v.T
                bound.Push(l)
            }
        }
    }
    s.val(a.Guard, Term.None)
    v := plain()
    if a.Code != null {
        s.blocks.Push(a.Code.Id)
        s.stmts(a.Code.Stmts)
        v = s.val(a.Value, dest)
        try s.blocks.Pop() catch { }
    } else {
        v = s.val(a.Value, dest)
    }
    return v
}

# a function value (T21, D16c, D16d): a named function's static; a lambda capturing nothing is a temporary built where it
# lands, one capturing references lives where they do - in the caller's frame where it is made for a call keeping
# nothing of it (onFrame), in the block it is made in where what it captured is a Str's receiver's (E11c); an adapter
# where its instance is (E31). What the lambda's body (or the adapter's Call) builds into what it captured is built
# there; a task's lambda is handed a stand-in for each scope it captured (P2)
fn (s mut Scoper&) fnVal(f typed.FnVal&, d Term, sp source.Span) Val {
    spawned := s.inSpawn
    frame := s.onFrame
    s.inSpawn = false
    s.onFrame = false
    match f {
        case typed.FnVal.Named(b) {
            if s.report { s.fnUses.Push(fnUse(s.B.File, s.lastName(sp), I64(b), FnNamed, types.UnknownT)) }
            return existing(Term.Program)
        }
        case typed.FnVal.Lambda(id, caps, site) {
            if s.report { s.fnUses.Push(fnUse(s.B.File, s.firstToken(s.B.File, sp), I64(id), FnLambda, types.UnknownT)) }
            home := Term.None
            scopes List<typed.Scope>
            lb := I64(id)
            for c in caps {
                v := s.val(c.Outer, Term.None)
                if not s.holds(c.Outer.Type()) { continue }
                t := s.valTerm(v, s.here())
                scopes.Push(s.scopeOf(t))
                home = t if home == Term.None else s.inner(home, t)
                k := s.captureVar(lb, c.Inner)
                if s.buildsSum(lb, k) {
                    s.buildsThrough(t, sp, lb, k)
                } else if spawned and not s.noBuildTerm(t) {
                    # a task's stand-in, made where what it captured lives - but in a Str, where its receiver's parts live
                    # nothing is built: the lambda lives in the join block (E11c, D16e)
                    s.standIn = true
                    s.buildsInto(t, sp, s.B.File, sp)
                    s.standIn = false
                }
            }
            if home == Term.None {
                if frame {
                    s.onFrameAt(site)
                } else {
                    s.build(site, d)
                }
                s.plan.Pass(site, scopes.ToArray())
                return fresh(d)
            }
            if frame {
                s.onFrameAt(site)
                s.plan.Pass(site, scopes.ToArray())
                return existing(s.here())
            }
            # what captured a Str's receiver's parts lives in the block it is made in - a task's, in its join block (D16e)
            if s.noBuildTerm(home) { home = d if spawned and d.Runs() else s.here() }
            s.build(site, home if home.Runs() else s.here())
            s.plan.Pass(site, scopes.ToArray())
            return existing(home)
        }
        case typed.FnVal.Adapter(cb, r, site) {
            if s.report { s.fnUses.Push(fnUse(s.B.File, s.opTok(r), I64(cb), FnCall, r.Type())) }
            v := s.val(r, Term.None)
            t := s.valTerm(v, s.here())
            at := s.nameSpan(sp)
            s.buildSite(site, t if t.Runs() else s.here(), at)
            # what the adapted Call builds where its receiver lives is built where the instance is
            k := s.paramVar(I64(cb), 0)
            if s.buildsSum(I64(cb), k) { s.buildsThrough(t, at, I64(cb), k) }
            s.plan.Pass(site, typed.Scope[s.scopeOf(t)])
            return existing(t)
        }
    }
}

# a closure site placed in the caller's frame: nothing built anywhere (D16c)
fn (s mut Scoper&) onFrameAt(site typed.SiteId) {
    if site >= typed.SiteId(0) and I64(site) < s.plan.Built.Len() { s.plan.Built[I64(site)] = typed.Scope.Frame }
}

# whether a term is one of this body's scope variables nothing may be built into (E11c)
fn (s mut Scoper&) noBuildTerm(t Term) Bool {
    return match t {
        case Term.Var(k) => k < s.noBuild.Len() and s.noBuild[k]
        case _ => false
    }
}

# the index among body b's scope variables of its capture of local l, -1 for none
fn (s mut Scoper&) captureVar(b I64, l typed.LocalId) I64 {
    vs := s.Bodies[b].Vars
    for k in range vs.Len() {
        match vs[k] {
            case typed.ScopeVar.Capture(x) {
                if x == l { return k }
            }
            case _ { }
        }
    }
    return -1
}

# the index among body b's scope variables of its parameter j's, -1 for none
fn (s mut Scoper&) paramVar(b I64, j I64) I64 {
    body := s.Bodies[b]
    if j >= body.Params.Len() { return -1 }
    l := body.Params[j]
    for k in range body.Vars.Len() {
        match body.Vars[k] {
            case typed.ScopeVar.Param(x) {
                if x == l { return k }
            }
            case _ { }
        }
    }
    return -1
}

# the shorter-lived of two terms where the order says (a closure's home among its captures', D16d), the first else
fn (s mut Scoper&) inner(a Term, b Term) Term {
    if s.order(a, b) == Holds { return b }
    return a
}

# ---- calls (CALL, docs/scope-model.md 3.3) ----

# a call judged: each of its callee's scope variables bound (O17, O18a, O18b, E25), its temporaries built where those
# say, its callee's obligations judged through the bindings (O10c); what its result is to section 8
fn (s mut Scoper&) call(sp source.Span, ty types.TypeId, c typed.Call&, dest Term) Val {
    land := s.landing
    s.landing = false
    # a part of its result read where it is put (O18a): there, unless its obligations force it elsewhere (O18c)
    pd := try s.partDest.Get(I64(c.Site)) catch default Term.None
    partD := pd != Term.None
    if partD {
        dest = pd
        land = false
    }
    spawned := s.inSpawn
    s.inSpawn = false
    j := s.taskJoin if spawned else Term.None
    s.taskJoin = Term.None
    fty := s.calleeType(c)
    match c.Target {
        case typed.Callee.Value(x) {
            # a task's lambda: what it captured is handed to the task too (P2), and it is built to last until the join
            # (D16e); a function value the task calls through lasts until the join as an argument does (P2)
            lambda := false
            match x {
                case typed.Expr.Fn(_, _, _) {
                    s.inSpawn = spawned
                    lambda = true
                }
                case _ { }
            }
            savedTemp, savedAt, savedSlot, savedFunc := s.taskTemp, s.taskAt, s.taskSlot, s.taskFunc
            if spawned and not lambda {
                # one computed for the task holds what it was made from, which lasts until the join likewise
                s.taskTemp, s.taskAt, s.taskSlot, s.taskFunc = true, s.opTok(x), j, true
            }
            fv := s.val(x, j)
            s.taskTemp, s.taskAt, s.taskSlot, s.taskFunc = savedTemp, savedAt, savedSlot, savedFunc
            s.inSpawn = false
            if spawned and fv.K == ValKind.Existing and not s.lastsUntil(fv.T, j) and s.report {
                if lambda {
                    s.err(s.firstToken(s.B.File, x.Span()), msgs.SpawnCaptureTooShort())
                } else {
                    s.err(s.opTok(x), msgs.SpawnFuncTooShort())
                }
            }
        }
        case _ { }
    }
    if fty == types.UnknownT {
        for a in c.Args { s.val(a, Term.None) }
        return plain() if not s.holds(ty) else fresh(dest if dest.Runs() else s.here())
    }
    vars := s.P.T.ScopeVarsOf(fty)
    n := c.Args.Len()
    ps := s.P.T.Items(s.P.T.Params(fty))
    beta := Array<Term>(vars.Len())
    owner := Array<I64>(n) # by argument: the index in vars of its parameter's scope variable, -1 for none
    for i in range n {
        owner[i] = -1
        if i >= ps.Len() { continue }
        k := s.P.T.ShareOf(fty, i)
        q := k if k >= 0 else i
        for v in range vars.Len() {
            if vars[v] == q { owner[i] = v }
        }
    }
    # a result borrowed from a parameter (O13) given a temporary lives where the temporary is built: where the result
    # lands, as a built result does (O18a)
    ev := -1
    ef := s.P.T.ResultFrom(fty, 0)
    if ef >= 0 and ef < n { ev = owner[ef] }
    # existing arguments determine their scope variables (O17, O25e) - and so does a call's result passed on that lands
    # where its own obligations say (O18c): "adj[a].Push(v)" is "inner := adj[a]; inner.Push(v)"
    vals := Array<Val>(n)
    landed := Array<Bool>(n)
    for i in range n {
        vals[i] = plain()
        a := c.Args[i]
        if owner[i] < 0 { continue }
        v := plain()
        pr := s.promoted(a)
        # a constructor's arguments are what its instance holds: C2d judges them where the instance lands, not O17
        ctorCallee := s.P.T.Role(fty) == types.RoleCtor
        if pr != null and s.isFresh(pr.X) and s.argLands(pr.X) and not (ctorCallee and s.calleeKeepsArg(c, i)) {
            # a value a call gives, lent by reference to a callee keeping nothing in it: its call lands where its
            # obligations say and the variable is bound where its references are; its copy is a temporary of this
            # block (O17b, O18c) - one keeping something in it would keep it where the copy is (O17)
            s.landing = true
            v = s.val(pr.X, Term.None)
            s.landing = false
            s.build(pr.Site, s.here())
            landed[i] = true
            if v.K == ValKind.Fresh { v = existing(v.T) }
            if not ctorCallee and s.calleeKeepsArg(c, i) and not s.handleLent(c, i, a) and s.report {
                # x[i]'s copy, said at its "[" (E31b)
                if s.atCall(pr.X) {
                    s.err(s.elemAt(pr.X), msgs.WriteThroughAtBuilds())
                } else {
                    s.err(s.argAt(a), msgs.BorrowSplitScopes())
                }
            }
        } else if pr != null and s.oldValue(pr.X) {
            # S4d's copy of a place's old value is built where a temporary put there would be: where the place's
            # references are, which it is not split from
            slot, _, _ := s.slotOf(s.targets[s.targets.Len() - 1])
            t := slot if slot.Runs() else s.here()
            s.val(pr.X, Term.None)
            s.build(pr.Site, t)
            landed[i] = true
            v = existing(t)
        } else if pr != null and not s.isFresh(pr.X) and s.holds(pr.X.Type()) and not ctorCallee {
            # a value with no storage of its own whose references already live somewhere - a copy out of a place, a
            # conditional of places, a try's default - lent where its references are, to a callee keeping nothing in
            # it (O17); its copy is a temporary of this block
            v = s.val(pr.X, Term.None)
            s.build(pr.Site, s.here())
            landed[i] = true
            if v.K == ValKind.Existing and s.calleeKeepsArg(c, i) and not s.handleLent(c, i, a) and s.report {
                s.err(s.argAt(a), msgs.BorrowSplitScopes())
            }
            if v.K == ValKind.Fresh { v = existing(v.T) }
        } else if s.isFresh(a) and s.argLands(a) {
            s.landing = true
            v = s.val(a, Term.None)
            s.landing = false
            landed[i] = true
            if v.K == ValKind.Fresh { v = existing(v.T) }
        } else if s.isFresh(a) or s.isHeldFresh(a) {
            continue
        } else {
            # a capturing lambda made for a callee keeping nothing of it lives in this frame (D16c)
            if s.capturingLambda(a) and s.transient(s.bodyOf(c.Target), i) { s.onFrame = true }
            # a reference read out of a call's built result, for a variable the callee's obligations need to outlive one
            # an argument before it determines: its call lands there, where the callee keeps it (O18b, O18c)
            pk := -1
            pc := s.argPartCall(a)
            if pc >= 0 and s.argPartOK(a, s.requiredBy(s.bodyOf(c.Target), owner[i], beta) if owner[i] != ev else dest) {
                t := s.requiredBy(s.bodyOf(c.Target), owner[i], beta)
                # ... or for the parameter the result is borrowed from, where the result is put
                if t == Term.None and owner[i] == ev and dest.Runs() { t = dest }
                if t.Runs() and t != s.here() and (try s.partDest.Get(pc) catch default Term.None) == Term.None {
                    pk = pc
                    s.partDest.Put(pk, t)
                }
            }
            v = s.val(a, Term.None)
            if pk >= 0 { s.partDest.Remove(pk) }
            s.onFrame = false
            rf := s.splitRefs(a)
            cr := s.choiceRefs(a)
            if cr != Term.None {
                # a choice of places is a copy of this block's (E28)
                rf = cr
                v = existing(s.here())
            }
            if rf != Term.None and rf != v.T {
                # a value whose references live elsewhere than its storage is lent where they are, to a callee keeping
                # nothing in it (O17) - a handle lent as its reference to one using it only through it (O17b), where that
                # is known here (O12); but a for-in's copy of an element is lent as the storage it is, the loop's block
                # (a recorded limit: the callee's obligations cannot tell its storage from what it holds)
                handle := rf.Runs() and s.handleLent(c, i, a)
                loop := cr == Term.None and s.lentLoopCopy(a)
                if s.calleeKeepsArg(c, i) and not handle {
                    if s.report { s.err(s.argAt(a), msgs.BorrowSplitScopes()) }
                } else if cr != Term.None or handle or not loop {
                    v = existing(rf)
                }
            }
        }
        vals[i] = v
        if v.K != ValKind.Existing { continue }
        # an argument whose scope is one of several (O12): read through, never built into
        if s.report and i < ps.Len() and s.buildsIntoSet(c, i, ps[i], owner[i], v.T) { s.err(s.opTok(a), msgs.BuildIntoUnknownScope()) }
        k := owner[i]
        if beta[k] == Term.None {
            beta[k] = v.T
        } else if beta[k] != v.T {
            # said at the call (at a constructor's argument, C2d)
            s.disagree(a.Span() if s.P.T.Role(fty) == types.RoleCtor else s.nameSpan(sp), beta[k], v.T)
        }
    }
    # what a task is handed lasts until its join (P2): an argument's storage, and what it holds
    if spawned and s.report {
        for i in range n {
            a := c.Args[i]
            ua := s.unAway(a)
            match ua {
                case typed.Expr.Borrow(_, _, p) {
                    if not s.lastsUntil(s.peekPlace(p, false), j) {
                        s.err(s.opTok(a), msgs.SpawnArgTooShort())
                        continue
                    }
                }
                case _ { }
            }
            v := vals[i]
            if landed[i] or v.K != ValKind.Existing or s.lastsUntil(v.T, j) { continue }
            byRef := match ua {
                case typed.Expr.Borrow(_, _, _) => false
                case _ => s.isRef(ua.Type()) or (i < ps.Len() and s.isRef(ps[i]))
            }
            s.err(s.opTok(a), msgs.SpawnArgTooShort() if byRef and not s.isFunc(ua.Type()) else msgs.SpawnArgHoldsShort())
        }
    }
    # the result scope: a written scope argument (E25), else where the call lands (O18a); a task's call stands in its join
    # block (P2)
    here := j if j.Runs() else s.here()
    rv := -1
    for v in range vars.Len() {
        if vars[v] == types.ResultVar { rv = v }
    }
    if rv >= 0 {
        match c.Scoped {
            case typed.Mark.Of(x) {
                beta[rv] = s.whereLives(x)
                match beta[rv] {
                    case Term.Set(_) {
                        # a scope argument naming a local whose scope is not known here (O12)
                        if s.report {
                            name := s.P.L.Names.Text(s.B.Locals[I64(x)].Name)
                            s.err(s.markAt(sp, name), msgs.TagUnknownScope(msgs.Tok(name), msgs.Tok(name)))
                        }
                        beta[rv] = here
                    }
                    case _ { }
                }
            }
            case typed.Mark.Return { beta[rv] = Term.Var(s.resultVar) if s.resultVar >= 0 else here }
            case typed.Mark.Global(_, nm) {
                # a global lives in the program's scope, which a result reaches by being stored there (E25, O1b)
                if s.report {
                    name := s.P.L.Names.Text(nm)
                    s.err(s.markAt(sp, name), msgs.ScopeArgProgram(msgs.Tok(name)))
                }
                beta[rv] = dest if dest.Runs() else here
            }
            case _ {
                beta[rv] = dest if dest.Runs() else here
                # a result nothing puts anywhere lands by its obligations where they need its scope to outlive an
                # argument's (O18a, O18c) - a constructor's instance is built where it stands, C2d holding it
                if s.P.T.Role(fty) == types.RoleCtor { land = false }
                if not land and (dest == Term.None or partD) and s.P.T.Role(fty) != types.RoleCtor {
                    cb := s.bodyOf(c.Target)
                    land = cb >= 0 and s.summed(cb) and s.forced(cb, rv)
                }
                if land {
                    t := s.landByObligations(c, rv, beta)
                    if t != Term.None { beta[rv] = t }
                }
            }
        }
    }
    # a scope variable no argument determines: where the callee's obligations say it must live (O18b), else where the
    # call's result lands, else where the call stands (O18a)
    callee := s.bodyOf(c.Target)
    for v in range vars.Len() {
        if beta[v] != Term.None { continue }
        t := s.requiredBy(callee, v, beta)
        if t == Term.None { t = beta[rv] if rv >= 0 else (dest if v == ev and dest.Runs() else here) }
        beta[v] = t
    }
    # the temporaries built where their scope variable is bound - a task's, what they hold lasting until its join (P2)
    for i in range n {
        a := c.Args[i]
        if landed[i] { continue }
        if owner[i] >= 0 and (s.isFresh(a) or s.isHeldFresh(a)) {
            b := beta[owner[i]]
            t := b if b.Runs() else here
            savedTemp, savedAt, savedSlot, savedFunc := s.taskTemp, s.taskAt, s.taskSlot, s.taskFunc
            if spawned { s.taskTemp, s.taskAt, s.taskSlot, s.taskFunc = true, s.opTok(a), t, false }
            vals[i] = s.val(a, t)
            s.taskTemp, s.taskAt, s.taskSlot, s.taskFunc = savedTemp, savedAt, savedSlot, savedFunc
            if spawned and vals[i].K == ValKind.Existing and not s.lastsUntil(vals[i].T, j) and s.report {
                s.err(s.opTok(a), msgs.SpawnArgHoldsShort())
            }
        } else if owner[i] < 0 {
            vals[i] = s.val(a, Term.None)
        }
    }
    # a copy of an element no one holds, for a writable reference parameter, is written and lost (E31b)
    if s.report {
        for i in range n {
            if i < ps.Len() and s.isRef(ps[i]) and (s.P.T.PermOf(ps[i]) & types.Writable) != 0 {
                s.writtenCopy(c, i, spawned, sp)
            }
        }
    }
    scopes := Array<typed.Scope>(vars.Len())
    for v in range vars.Len() { scopes[v] = s.scopeOf(beta[v]) }
    s.plan.Pass(c.Site, scopes)
    # what the callee may build into, recorded as this body's building there (O18c, E11c); a task is handed a stand-in for
    # every scope it binds, made where that scope is (P2)
    at := s.nameSpan(sp)
    ctor := s.P.T.Role(fty) == types.RoleCtor
    for v in range vars.Len() {
        if spawned {
            # a stand-in is made where the scope is - one a run-time term names; a derived one is built into only where
            # the callee builds there (O23a)
            if s.calleeBuilds(c, callee, v) {
                s.buildsThrough(beta[v], at, callee, v)
            } else {
                s.standIn = true
                s.buildsInto(beta[v], at, s.B.File, at)
                s.standIn = false
            }
        } else if ctor and v == rv and s.isRef(ty) {
            # a constructor's instance held by reference (a destructor-bearing type, C11) is built where it lands
            s.buildsInto(beta[v], at, s.B.File, at)
        } else if s.calleeBuilds(c, callee, v) and s.derivedBuilds(fty, vars, v, beta) {
            s.buildsThrough(beta[v], s.ownerAt(c, owner, v, at) if isDerived(beta[v]) else at, callee, v)
        }
    }
    # the callee's obligations, through the bindings (O10c)
    # a constructor's arguments the instance holds agree on where it lives, said at the first that does not (C2d, O25e)
    agreed := true
    if callee >= 0 and s.report and s.P.T.Role(fty) == types.RoleCtor and rv >= 0 {
        agreed = s.argsAgree(c, callee, rv, owner, vals, beta)
    }
    if callee >= 0 { s.discharge(sp, callee, beta, c, agreed) }
    s.resAt = beta[rv] if rv >= 0 else here
    if not s.holds(ty) { return plain() }
    if s.P.T.Role(fty) != types.RoleCtor and callee >= 0 and s.summed(callee) and s.sums[callee].ResBind.Len() > 0 {
        # the instance it gives carries the bindings its callee's returns had, through this call's (O13c): "it :=
        # l.Iter()" knows its iterator reads l
        s.ctorSite = I64(c.Site)
        s.ctorFrom = s.bindTerms.Len()
        for t in s.sums[callee].ResBind {
            u := s.through(t, beta, c, false) if t != Term.Untraced else Term.Untraced
            s.bindTerms.Push(u)
            s.bindKids.Push(-1)
        }
        s.siteRec.Put(I64(c.Site), s.ctorFrom)
    }
    if s.P.T.Role(fty) == types.RoleCtor {
        # its construction bindings, for a local it initializes (O23a): where each parameter's argument lives
        s.ctorSite = I64(c.Site)
        s.ctorFrom = s.bindTerms.Len()
        for p in range n {
            s.bindTerms.Push(s.paramBinding(c, p, beta))
            s.bindKids.Push(s.argRec(c.Args[p]))
        }
        s.siteRec.Put(I64(c.Site), s.ctorFrom)
        return fresh(beta[rv] if rv >= 0 else here)
    }
    e := s.P.T.ResultFrom(fty, 0)
    if e >= 0 {
        # a result borrowed from parameter e lives where its argument's referent does (O13)
        for v in range vars.Len() {
            if vars[v] == e or (e < n and owner[e] == v) { return existing(beta[v]) }
        }
        return existing(Term.Untraced)
    }
    return fresh(beta[rv] if rv >= 0 else here)
}

# whether an argument living at t, one of several scopes (O11, O12), is lent for parameter type pt whose scope variable v
# the callee may build into: through a writable reference something can be stored through; through a read-only one
# where the callee's body builds there; a value whose references something can be stored through
fn (s mut Scoper&) buildsIntoSet(c typed.Call&, i I64, pt types.TypeId, v I64, t Term) Bool {
    match t {
        case Term.Set(_) { }
        case _ { return false }
    }
    if not s.isRef(pt) { return s.valueAdmits(pt) }
    if not s.admitsStores(pt) { return false }
    if (s.P.T.PermOf(pt) & types.Writable) != 0 { return true }
    return s.calleeBuilds(c, s.bodyOf(c.Target), v)
}

# the promotion an argument is, of a value into a reference parameter (E12c); null for none
fn (s mut Scoper&) promoted(a typed.Expr&) typed.Promote&a {
    return match a {
        case typed.Expr.Promote(_, _, pr) => pr
        case _ => null
    }
}

# where the references of a value borrowed by an argument live, where that is not its own storage's place: a value
# local's or a part of one (O17); None for anything else
fn (s mut Scoper&) splitRefs(a typed.Expr&) Term {
    match a {
        case typed.Expr.Borrow(_, _, p) {
            if not s.holds(p.Type()) or flThroughRef(p) { return Term.None }
            return s.peekPlace(p, true)
        }
        case typed.Expr.Prim(_, _, op, _, args) {
            if op == typed.PrimOp.Convert and args.Len() > 0 { return s.splitRefs(args[0]) }
        }
        case typed.Expr.Away(_, _, y) { return s.splitRefs(y) }
        case _ { }
    }
    return Term.None
}

# whether a call's argument i is a handle its callee uses only through its reference (O17b): lent as that reference
fn (s mut Scoper&) handleLent(c typed.Call&, i I64, a typed.Expr&) Bool {
    fty := s.calleeType(c)
    if fty == types.UnknownT { return false }
    ps := s.P.T.Items(s.P.T.Params(fty))
    if i >= ps.Len() or not s.isRef(ps[i]) or not s.isHandle(s.P.T.Referent(ps[i])) { return false }
    match c.Target {
        case typed.Callee.Body(id) { return s.uses(I64(id), i, UseThru) }
        case _ { return false }
    }
}

# whether x reads an Assign's target's old value (S4d's copy, Place.Target)
fn (s mut Scoper&) oldValue(x typed.Expr&) Bool {
    if s.targets.Len() == 0 { return false }
    match s.unAway(x) {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Place.Target(_, _) { return true }
                # a borrow of the place written over, or of storage within it (S4d: "y = wrap(y)")
                case _ { return not s.isRef(s.targets[s.targets.Len() - 1].Type()) and within(p, s.targets[s.targets.Len() - 1]) }
            }
        }
        case _ { }
    }
    return false
}

# whether place p is place q or storage within it - a field, payload or element of it (any element standing for any
# other), reached through no reference (S4d)
fn within(p typed.Place&, q typed.Place&) Bool {
    if samePlace(p, q) { return true }
    return match p {
        case typed.Place.Field(_, _, b, _) => within(b, q)
        case typed.Place.Elem(_, _, e) => within(e.Base, q)
        case typed.Place.Payload(_, _, pl) => within(pl.Base, q)
        case _ => false
    }
}

fn samePlace(p typed.Place&, q typed.Place&) Bool {
    match p {
        case typed.Place.Local(_, _, a) {
            match q {
                case typed.Place.Local(_, _, b) { return a == b }
                case _ { return false }
            }
        }
        case typed.Place.Global(_, _, m, n) {
            match q {
                case typed.Place.Global(_, _, m2, n2) { return m == m2 and n == n2 }
                case _ { return false }
            }
        }
        case typed.Place.Field(_, _, b, i) {
            match q {
                case typed.Place.Field(_, _, b2, i2) { return i == i2 and samePlace(b, b2) }
                case _ { return false }
            }
        }
        case typed.Place.Elem(_, _, e) {
            match q {
                case typed.Place.Elem(_, _, e2) { return samePlace(e.Base, e2.Base) }
                case _ { return false }
            }
        }
        case typed.Place.Payload(_, _, pl) {
            match q {
                case typed.Place.Payload(_, _, pl2) { return samePlace(pl.Base, pl2.Base) }
                case _ { return false }
            }
        }
        case _ { return false }
    }
}

# where an argument is said: a conditional at its "if"
fn (s mut Scoper&) argAt(a typed.Expr&) source.Span {
    x := s.unAway(a)
    match x {
        case typed.Expr.Promote(_, _, pr) { x = s.unAway(pr.X) }
        case _ { }
    }
    match x {
        case typed.Expr.Cond(_, _, c) {
            text := try s.texts.Get(s.B.File) catch default ""
            from := I64(c.A.Span().End)
            to := I64(x.Span().End)
            for k in range from, to - 1 {
                word := k + 2 <= text.Len() and text[k] == 'i' and text[k + 1] == 'f'
                if word and (k == 0 or not isNameChar(text[k - 1])) and (k + 2 >= text.Len() or not isNameChar(text[k + 2])) {
                    return source.Span(I32(k), I32(k + 2))
                }
            }
        }
        case _ { }
    }
    return a.Span()
}

# a conditional or a match choosing value places, lent to a reference parameter (E28): a copy, a temporary of this block,
# its references where the places' are - their term (a set where they differ); None for any other argument
fn (s mut Scoper&) choiceRefs(a typed.Expr&) Term {
    xs List<typed.Expr&>
    match s.unAway(a) {
        case typed.Expr.Cond(_, _, c) {
            xs.Push(c.A)
            xs.Push(c.B)
        }
        case typed.Expr.Match(_, _, m) {
            if not m.IsValue { return Term.None }
            for arm in m.Arms {
                if arm != null and arm.Value != null { xs.Push(arm.Value) }
            }
            if m.NoMatch != null and m.NoMatch.Value != null { xs.Push(m.NoMatch.Value) }
        }
        case _ { return Term.None }
    }
    t := Term.None
    for x in xs {
        match s.unAway(x) {
            case typed.Expr.Borrow(_, _, p) {
                if not s.holds(p.Type()) or flThroughRef(p) { return Term.None }
                u := s.peekPlace(p, true)
                if u == Term.None { return Term.None }
                t = u if t == Term.None else s.setOf(t, u)
            }
            case _ { return Term.None }
        }
    }
    return t
}

fn (s mut Scoper&) isHeldFresh(x typed.Expr&) Bool {
    match x {
        case typed.Expr.Read(_, _, p, _) {
            match p {
                case typed.Place.Local(_, _, id) { return s.held.Has(I64(id)) }
                case _ { }
            }
        }
        case _ { }
    }
    return false
}

# the term the callee's obligations require scope variable v to live in: a bound one it must outlive or equal (O18b);
# None where none does. A callee of the component being judged gives what the rounds so far found: its obligations only
# grow, so the first relation naming v - what this reads - is fixed once found, and the rounds still reach their fixed
# point before anything is said (7.2)
fn (s mut Scoper&) requiredBy(callee I64, v I64, beta Array<Term>&) Term {
    if callee < 0 or not (s.sums[callee].Done or s.sums[callee].Judging) { return Term.None }
    for r in s.sums[callee].Rels {
        match r.Hi {
            case Term.Var(i) {
                if i == v {
                    match r.Lo {
                        case Term.Var(k) {
                            if k < beta.Len() and beta[k] != Term.None and beta[k].Runs() { return beta[k] }
                        }
                        case Term.Program { return Term.Program }
                        case _ { }
                    }
                }
            }
            case _ { }
        }
    }
    return Term.None
}

# a callee's obligations judged through a call's bindings (O10c): each held, recorded as the caller's own, or an error
# at the call naming the callee's statement that required it
fn (s mut Scoper&) discharge(sp source.Span, callee I64, beta Array<Term>&, c typed.Call&, agreed Bool) {
    for r in s.sums[callee].Rels {
        hi := s.through(r.Hi, beta, c, true)
        lo := s.through(r.Lo, beta, c, false)
        if hi == Term.None or lo == Term.None { continue }
        k := s.judgeOut(hi, lo)
        if k == Holds { continue }
        if k == Obliged {
            # what a constructor's instance holds, through a constructor building one of its fields: its own C2d, said
            # where it is called as such
            saved := s.why
            if r.Why != 0 and s.instanceRel(hi, lo) {
                s.why = r.Why
            } else if r.Why != 0 and s.resultVar >= 0 and lo == Term.Var(s.resultVar) and not s.isCtor() {
                # an instance this function returns, holding what its argument names: the caller's C2d
                s.why = WhyResult
            }
            s.oblige(hi, lo, r.Exact)
            s.why = saved
            continue
        }
        if not s.report { continue }
        if s.taskTemp and lo == s.taskSlot {
            # a temporary a task is handed, holding what does not last until the join (P2)
            s.err(s.taskAt, msgs.SpawnFuncTooShort() if s.taskFunc else msgs.SpawnArgHoldsShort())
            continue
        }
        if r.Lo == Term.Var(s.resultVarOf(s.calleeType(c))) and s.ownIntoResult(hi, lo) {
            # a result returned holding this function's own storage, through the call that put it there (O26)
            s.err(s.nameSpan(sp), msgs.ReturnOwnStorage())
            continue
        }
        if r.Why != 0 {
            # a constructor's instance outliving what it holds (C2d): said at the argument - once its arguments were
            # found to disagree, said there instead; one a function returns, where its result is put
            if not agreed { continue }
            ai := s.argOfVar(c, r.Hi)
            if ai < 0 { ai = s.argOfVar(c, r.Lo) }
            at := s.argAt(c.Args[ai]) if ai >= 0 else s.nameSpan(sp)
            if r.Why == WhyResult and s.landSite == I64(c.Site) { at = s.landSp }
            s.err(at, msgs.InstanceOutlivesReferent() if r.Why == WhyField else msgs.InstanceOutlivesArg())
            continue
        }
        m := msgs.ReferenceNarrowed() if r.Exact else msgs.ScopeObligationUnmet()
        rec := s.err(s.nameSpan(sp), m)
        cb := s.Bodies[callee]
        s.note(rec, cb.File, s.firstToken(cb.File, r.At), msgs.NoteObligationOrigin())
        # the argument too short a loop's copy of an element (B11, r06)
        ai := s.argOfVar(c, r.Hi)
        if ai >= 0 and s.lentLoopCopy(c.Args[ai]) { s.noteLoopCopy(rec, c.Args[ai]) }
    }
}

# whether the arguments a constructor's instance holds agree on one scope for it, as stage 0 binds it (C2d's instance
# scope, bindHereFrom): in order, each existing one held exactly where the binding so far is, or - held only to be
# outlived - outliving it, a binding only outlived narrowing to a shorter one, an exact one fixing it where the others
# outlive it; two of this function's scope variables are both kept. False, with O25e's error at the argument, where
# they do not
fn (s mut Scoper&) argsAgree(c typed.Call&, callee I64, rv I64, owner Array<I64>&, vals Array<Val>&, beta Array<Term>&) Bool {
    fty := s.calleeType(c)
    ps := s.P.T.Items(s.P.T.Params(fty))
    bt := Term.None
    bx := false
    for i in range c.Args.Len() {
        v := owner[i]
        if v < 0 or v == rv or vals[i].K != ValKind.Existing { continue }
        held := false
        viaField := false
        for r in s.sums[callee].Rels {
            if r.Why == 0 { continue }
            if r.Hi == Term.Var(v) and r.Lo == Term.Var(rv) {
                held = true
                if r.Why == WhyField { viaField = true }
            }
        }
        if not held { continue }
        # held exactly where something can be stored through it, unless a "&q" field keeps it (stage 0's narrowing)
        pt := ps[i] if i < ps.Len() else types.UnknownT
        ex := not viaField and pt != types.UnknownT and (s.admitsStores(pt) if s.isRef(pt) else s.valueAdmits(pt))
        t := beta[v]
        if not t.Runs() { continue }
        nt, nx, ok := s.agreeStep(bt, bx, t, ex)
        if not ok {
            s.err(s.argAt(c.Args[i]), msgs.ScopeArgsDisagree())
            return false
        }
        bt, bx = nt, nx
    }
    return true
}

# one more value an instance holds, living at t (exactly there where ex), against the binding so far, bt (bx): the
# binding after it, and whether it agrees (argsAgree)
fn (s mut Scoper&) isCtor() Bool {
    return match s.B.Of {
        case typed.BodyOf.Ctor(_, _) => true
        case _ => false
    }
}

fn (s mut Scoper&) agreeStep(bt Term, bx Bool, t Term, ex Bool) (Term, Bool, Bool) {
    if bt == Term.None { return t, ex, true }
    if t == bt { return bt, bx, true }
    if ex != bx {
        if bx and s.order(t, bt) == Holds { return bt, bx, true }
        if ex and s.order(bt, t) == Holds { return t, true, true }
    }
    if not bx and not ex {
        if s.order(bt, t) == Holds { return t, false, true }
        if s.order(t, bt) == Holds { return bt, false, true }
    }
    # two of this function's scope variables: the instance must not outlive either, kept by the obligations
    both := match t {
        case Term.Var(_) => match bt {
            case Term.Var(_) => true
            case _ => false
        }
        case _ => false
    }
    return bt, bx, both
}

# whether the values an enum case's payload holds agree on one scope for it, as argsAgree for a constructor's (T17c):
# false, with the error at the item, where they do not
fn (s mut Scoper&) payloadAgree(items Array<typed.Expr&>&, vs Array<Val>&) Bool {
    bt := Term.None
    bx := false
    for k in range items.Len() {
        it := items[k]
        if vs[k].K != ValKind.Existing or not vs[k].T.Runs() or not s.holds(it.Type()) { continue }
        ty := it.Type()
        ex := s.admitsStores(ty) if s.isRef(ty) else s.valueAdmits(ty)
        nt, nx, ok := s.agreeStep(bt, bx, vs[k].T, ex)
        if not ok {
            s.err(s.argAt(it), msgs.PayloadScopesDisagree())
            return false
        }
        bt, bx = nt, nx
    }
    return true
}

# whether a body's summary can be read: judged, or of the component being judged - what its rounds so far found, which
# only grows, the rounds running to their fixed point before anything is said (7.2)
fn (s mut Scoper&) summed(b I64) Bool { return s.sums[b].Done or s.sums[b].Judging }

# whether a callee's relation on its result, through a call, asks this function's own storage to outlive this one's
# result: what the call builds is returned (O26) - in a function, not a constructor, whose instance is its fields' own concern (C2d)
fn (s mut Scoper&) ownIntoResult(hi Term, lo Term) Bool {
    match s.B.Of {
        case typed.BodyOf.Ctor(_, _) { return false }
        case _ { }
    }
    return s.resultVar >= 0 and lo == Term.Var(s.resultVar) and s.isBlock(hi)
}

# whether a relation names the instance of the constructor being judged (C2d)
fn (s mut Scoper&) instanceRel(hi Term, lo Term) Bool {
    match s.B.Of {
        case typed.BodyOf.Ctor(_, _) { }
        case _ { return false }
    }
    return s.resultVar >= 0 and (hi == Term.Var(s.resultVar) or lo == Term.Var(s.resultVar))
}

# a note at a for-in's own variable lent by its storage (B11, r06): the element itself is lent from the array walked,
# where that is a local of the program's - else what a call lent it ties to the copy
fn (s mut Scoper&) noteLoopCopy(rec I64, a typed.Expr&) {
    l := flRootExpr(s.unAway(a))
    if l < 0 { return }
    name := s.P.L.Names.Text(s.B.Locals[l].Name)
    at := s.wordAt(s.B.Locals[l].Sp, name)
    arr := ""
    x := try s.inits.Get(l) catch default null
    if x != null {
        match x {
            case typed.Expr.Read(_, _, p, _) {
                match p {
                    case typed.Place.Elem(_, _, e) {
                        h := flRoot(e.Base)
                        src typed.Expr&x = null
                        if h >= 0 and s.B.Locals[h].Kind == typed.LocalKind.Hidden { src = try s.inits.Get(h) catch default null }
                        w := -1
                        if src != null { w = flRootExpr(s.unAway(src)) }
                        if w >= 0 and s.B.Locals[w].Kind == typed.LocalKind.Var and not s.loopElement(w) { arr = s.P.L.Names.Text(s.B.Locals[w].Name) }
                    }
                    case _ { }
                }
            }
            case _ { }
        }
    }
    if arr != "" {
        s.note(rec, s.B.File, at, msgs.NoteLoopCopy(name, arr, arr))
    } else if s.holds(s.B.Locals[l].Ty) {
        s.note(rec, s.B.File, at, msgs.NoteLoopCopyLent(name))
    }
}

# where a name is written as a whole word on the line a span begins: its own span, else the span
fn (s mut Scoper&) wordAt(sp source.Span, name String&) source.Span {
    text := try s.texts.Get(s.B.File) catch default ""
    end := I64(sp.Start)
    for end < text.Len() and text[end] != '\n' { end++ }
    for k in range I64(sp.Start), end {
        if k + name.Len() > end or text[k:k + name.Len()] != name { continue }
        if k > 0 and isNameChar(text[k - 1]) { continue }
        if k + name.Len() < text.Len() and isNameChar(text[k + name.Len()]) { continue }
        return source.Span(I32(k), I32(k + name.Len()))
    }
    return sp
}

# the argument of a call that determines a callee's scope term t (a scope variable), -1 for none
fn (s mut Scoper&) argOfVar(c typed.Call&, t Term) I64 {
    v := -1
    match t {
        case Term.Var(i) { v = i }
        case _ { return -1 }
    }
    fty := s.calleeType(c)
    if fty == types.UnknownT { return -1 }
    vars := s.P.T.ScopeVarsOf(fty)
    if v >= vars.Len() { return -1 }
    for i in range c.Args.Len() {
        k := s.P.T.ShareOf(fty, i)
        q := k if k >= 0 else i
        if q == vars[v] { return i }
    }
    return -1
}

# a callee's term in the caller's, through a call's bindings; hi where it is to outlive the other side of a relation
fn (s mut Scoper&) through(t Term, beta Array<Term>&, c typed.Call&, hi Bool) Term {
    return match t {
        case Term.Var(i) => beta[i] if i < beta.Len() else Term.Untraced
        case Term.Program => Term.Program
        case Term.Derived(p, w) => s.derivedAt(p, w, c, hi, beta)
        case _ => Term.Untraced
    }
}

# a callee's derived scope through a call (O23a): where the argument for parameter p bound w. Through a reference
# parameter of this body, its own derived scope; through a local whose construction bindings are known, that binding;
# otherwise the argument's own term where an underestimate serves - on the side that is to outlive (O23) - and untraced
# on the other
fn (s mut Scoper&) derivedAt(p I64, w I64, c typed.Call&, hi Bool, beta Array<Term>&) Term {
    if p < 0 or p >= c.Args.Len() { return Term.Untraced }
    a := c.Args[p]
    y := regionLocal(a)
    if y >= 0 and s.B.Locals[y].Kind == typed.LocalKind.Param and s.isRef(s.B.Locals[y].Ty) {
        return Term.Derived(s.paramIndex(y), w)
    }
    # an instance whose construction bindings are known (O23a): a local's, a field's of one
    rec := s.argRec(a)
    if s.recAt(rec, w) != Term.None { return s.recAt(rec, w) }
    if not hi { return Term.Untraced }
    t := s.paramBinding(c, p, beta)
    return t if t != Term.None else Term.Untraced
}

# the local an argument is, read or borrowed whole: -1 for any other argument
fn (s mut Scoper&) argLocal(a typed.Expr&) I64 {
    return match s.unAway(a) {
        case typed.Expr.Borrow(_, _, p) => wholeLocal(p)
        case typed.Expr.Read(_, _, p, _) => wholeLocal(p)
        case _ => -1
    }
}

# the binding at a call of parameter p's scope variable: where the instance whose "&q" fields a derived scope reads is
# (that derived scope outlives it, C2d)
fn (s mut Scoper&) paramBinding(c typed.Call&, p I64, beta Array<Term>&) Term {
    fty := s.calleeType(c)
    if fty == types.UnknownT { return Term.None }
    vars := s.P.T.ScopeVarsOf(fty)
    k := s.P.T.ShareOf(fty, p)
    q := k if k >= 0 else p
    for v in range vars.Len() {
        if vars[v] == q and v < beta.Len() { return beta[v] }
    }
    return Term.None
}

# two arguments determining one scope variable in different scopes (O25e)
fn (s mut Scoper&) disagree(at source.Span, t Term, u Term) {
    if s.judgeOut(t, u) == Obliged and s.judgeOut(u, t) == Obliged {
        s.oblige(t, u, true)
        return
    }
    if not s.report { return }
    s.err(at, msgs.ScopeArgsDisagree())
}

# ---- the order and judging a fit ----

# whether a outlives b, by the order of 2.2: Holds; Obliged where both are relatable terms the order does not decide
# (and the body's obligations do not either); FailsBlock where a block is asked to outlive what it cannot; FailsUnknown
# where a side is not known here
fn (s mut Scoper&) order(a Term, b Term) I64 {
    if a == b {
        return match a {
            case Term.Set(_), Term.Untraced, Term.None => FailsUnknown
            case _ => Holds
        }
    }
    # an underestimate is shown to outlive what the term it stands above does, and is never shown to be outlived
    if s.floorOf(b) != Term.None { return FailsUnknown }
    fa := s.floorOf(a)
    if fa != Term.None { return s.order(fa, b) }
    match a {
        case Term.Untraced, Term.None { return FailsUnknown }
        case Term.Set(id) {
            worst := Holds
            for m in range s.setFrom[id], s.setEnd(id) {
                k := s.order(s.setTerms[m], b)
                if k > worst { worst = k }
            }
            return worst
        }
        case Term.Program { return Holds }
        case _ { }
    }
    match b {
        case Term.Untraced, Term.None { return FailsUnknown }
        case Term.Set(id) {
            worst := Holds
            for m in range s.setFrom[id], s.setEnd(id) {
                k := s.order(a, s.setTerms[m])
                if k > worst { worst = k }
            }
            return worst
        }
        case Term.Block(bb) {
            match a {
                case Term.Var(_), Term.Derived(_, _) { return Holds }
                case Term.Block(ab) { return Holds if s.B.Encloses(ab, bb) else FailsBlock }
                case _ { return FailsUnknown }
            }
        }
        case _ { }
    }
    # b a scope variable, a derived scope or the program's
    match a {
        case Term.Block(_) { return FailsBlock }
        case _ { }
    }
    if s.gammaHolds(a, b) { return Holds }
    return Obliged
}

# the order and the obligations already recorded
fn (s mut Scoper&) judgeOut(a Term, b Term) I64 { return s.order(a, b) }

# whether the body's obligations show hi outlives lo: a path of relations from hi to lo
fn (s mut Scoper&) gammaHolds(hi Term, lo Term) Bool {
    seen List<Term>
    todo List<Term>
    todo.Push(hi)
    for todo.Len() > 0 {
        t := try todo.Pop() catch { break }
        if t == lo { return true }
        if t == Term.Program { continue }
        dup := false
        for u in seen {
            if u == t { dup = true }
        }
        if dup { continue }
        seen.Push(t)
        for r in s.gamma {
            if r.Hi == t { todo.Push(r.Lo) }
        }
        # what the program's scope outlives, everything does not: only obligations lead on
    }
    return false
}

# an obligation recorded (O10b): hi outlives lo - both ways where exact
fn (s mut Scoper&) oblige(hi Term, lo Term, exact Bool) {
    if s.floorOf(hi) != Term.None { hi = s.floorOf(hi) }
    if s.floorOf(lo) != Term.None { lo = s.floorOf(lo) }
    # one naming a constructor's instance is what the instance holds (C2d)
    why := s.why
    if why == 0 and s.instanceRel(hi, lo) { why = WhyHolds }
    s.addRel(rel(hi, lo, exact, s.stmtSp, why))
    if exact { s.addRel(rel(lo, hi, exact, s.stmtSp, why)) }
}

fn (s mut Scoper&) addRel(r rel) {
    if not hasRel(s.gamma, r) { s.gamma.Push(r) }
}

# a value of existing storage living at t put into a slot of term slot (FIT, 3.1): it must outlive the slot, and be
# exactly in it where exact
fn (s mut Scoper&) fit(t Term, slot Term, exact Bool, x typed.Expr&, kind I64) {
    if slot == Term.None or t == Term.None { return }
    s.fitSlot = slot
    # a value one of several terms can give is judged as each of them stored alone (E28)
    match t {
        case Term.Set(id) {
            for m in range s.setFrom[id], s.setEnd(id) { s.fit(s.setTerms[m], slot, exact, x, kind) }
            return
        }
        case _ { }
    }
    # a local exactly in a derived scope, or in another scope exactly where a derived one is: nothing here shows the two
    # the same (O25, O23a) - a result's is an obligation each call discharges (O14b)
    if exact and t != slot and (kind == FitLocal or kind == FitValue) and (s.derivedTerm(t) or s.derivedTerm(slot)) {
        s.fitError(x, kind, true)
        return
    }
    k := s.order(t, slot)
    if k == Holds and exact and t != slot {
        k = s.order(slot, t)
        if k == FailsBlock and s.isBlock(slot) {
            # a reference narrowed into a shorter block (O25)
            s.fitNarrow = true
            s.fitError(x, kind, true)
            s.fitNarrow = false
            return
        }
    }
    if k == Holds { return }
    # a global holds only what lives as long as the program: what lives where a scope variable says is no obligation
    # on the callers - stored into a global, it is O1b's error at the value, as stage 0 has it
    if k == Obliged and kind == FitGlobal {
        s.fitError(x, kind, exact)
        return
    }
    if k == Obliged {
        s.oblige(t, slot, false)
        if exact and t != slot {
            o := s.order(slot, t)
            if o == Obliged { s.oblige(slot, t, false) }
        }
        return
    }
    s.fitError(x, kind, exact)
}

# whether x is a lambda capturing references from several scopes: returned, it is built in the result scope with each
# capture held to it (D16d), so what refers to this function's storage is said as O26 says it
fn (s mut Scoper&) capsDiffer(x typed.Expr&) Bool {
    match s.unAway(x) {
        case typed.Expr.Fn(_, _, f) {
            match f {
                case typed.FnVal.Lambda(_, caps, _) {
                    first := Term.None
                    for cp in caps {
                        if not s.holds(cp.Outer.Type()) { continue }
                        t := s.peekTerm(cp.Outer)
                        if t == Term.None { continue }
                        if first == Term.None {
                            first = t
                        } else if t != first {
                            return true
                        }
                    }
                }
                case _ { }
            }
        }
        case _ { }
    }
    return false
}

# whether a local of type t must hold exactly what it is given (O25, O25g): a reference; a value holding a reference
# through which, at any depth, something could be stored
fn (s mut Scoper&) narrowingMatters(t types.TypeId) Bool {
    if s.isFunc(t) { return false }
    # a reference local never narrows, whatever it refers to (O25)
    return s.isRef(t) or s.valueAdmits(t)
}

fn isDerived(t Term) Bool {
    return match t {
        case Term.Derived(_, _) => true
        case _ => false
    }
}

fn (s mut Scoper&) derivedTerm(t Term) Bool {
    return match t {
        case Term.Derived(p, _) => p >= 0
        case _ => false
    }
}

fn (s mut Scoper&) isBlock(t Term) Bool {
    return match t {
        case Term.Block(_) => true
        case _ => false
    }
}

fn (s mut Scoper&) fitError(x typed.Expr&, kind I64, exact Bool) {
    if not s.report { return }
    # a reference or a function value returned that lives in this function's own scope (O10d); a value referring to it,
    # O26's
    if kind == FitReturn and (s.isRef(x.Type()) or s.isFunc(x.Type())) and not s.capsDiffer(x) { kind = FitOwn }
    s.fitLocalRead = false
    match s.unAway(x) {
        case typed.Expr.Read(_, _, p, _), typed.Expr.Borrow(_, _, p) {
            match p {
                case typed.Place.Local(_, _, _) { s.fitLocalRead = true }
                case _ { }
            }
        }
        case _ { }
    }
    if kind == FitField and exact and s.why == 0 and not (s.taskTemp and s.fitSlot == s.taskSlot) {
        # a reference stored where something can be stored through it lives exactly where its slot's references do
        # (O25) - a value local of this function's own, named, where it is what closes first
        name := s.valueLocalName(x) if not s.fitNarrow else ""
        s.err(s.fitSp if s.fitAt else s.opTok(x), msgs.ReferenceNarrowedLocal(name) if name != "" else msgs.ReferenceNarrowed())
        return
    }
    rec := s.fitErrorAt(s.fitSp if s.fitAt else s.opTok(x), kind, exact)
    # a slice of a temporary borrows it in the block it is written in, which a reader would not guess (E16a)
    match s.unAway(x) {
        case typed.Expr.Slice(sp, _, sl) {
            if rec >= 0 and throughTemp(sl.Base) { s.note(rec, s.B.File, s.sliceAt(sp, sl), msgs.NoteSliceOfTemporary()) }
        }
        case _ { }
    }
}

# the name of the value local of this function's an expression reads or borrows whole, "" for any other
fn (s mut Scoper&) valueLocalName(x typed.Expr&) String {
    l := s.argLocal(x)
    if l < 0 or s.isRef(s.B.Locals[l].Ty) or s.B.Locals[l].Kind == typed.LocalKind.Hidden { return "" }
    return $s.P.L.Names.Text(s.B.Locals[l].Name)
}

# whether a place is a part of a temporary, reached without a reference
fn throughTemp(p typed.Place&) Bool {
    return match p {
        case typed.Place.Temp(_, _, _, _) => true
        case typed.Place.Field(_, _, b, _) => throughTemp(b)
        case typed.Place.Elem(_, _, e) => throughTemp(e.Base)
        case typed.Place.Payload(_, _, pl) => throughTemp(pl.Base)
        case _ => false
    }
}

fn (s mut Scoper&) fitErrorAt(sp source.Span, kind I64, exact Bool) I64 {
    if s.taskTemp and s.fitSlot == s.taskSlot {
        # a temporary a task is handed, holding what does not last until the join (P2)
        return s.err(s.taskAt, msgs.SpawnFuncTooShort() if s.taskFunc else msgs.SpawnArgHoldsShort())
    }
    m := msgs.ScopeMayNotOutlive()
    if kind == FitLocal {
        # a reference narrowed, or a value whose scope its type does not say, where something can be stored through it
        # (O25); a local's own scope too short for where it is put (O10)
        if exact and (s.fitNarrow or not s.fitLocalRead) { m = msgs.ReferenceNarrowed() }
    } else if kind == FitPayload {
        m = msgs.PayloadOutlived()
    } else if kind == FitOwn {
        m = msgs.OwnCannotOutlive()
    } else if kind == FitField {
        m = msgs.StoredRefOutlived()
    } else if kind == FitElem {
        m = msgs.ElemNotInArrayScope() if exact else msgs.ElemOutlived()
    } else if kind == FitGlobal {
        m = msgs.GlobalHoldsShorter()
    } else if kind == FitReturn {
        m = msgs.ReturnOwnStorage()
    } else if kind == FitValue {
        m = msgs.ValueRefsOutlived()
    }
    return s.err(sp, m)
}

# ---- placement ----

# site built in term t: a run-time term's scope, else where the site stands (a static-only term is never built into,
# docs/scope-model.md 2.3)
fn (s mut Scoper&) build(site typed.SiteId, t Term) {
    if site < typed.SiteId(0) or I64(site) >= s.plan.Built.Len() { return }
    s.buildSite(site, t, s.B.Sites[I64(site)].Sp)
}

# site built in term t, the expression it builds at sp
fn (s mut Scoper&) buildSite(site typed.SiteId, t Term, sp source.Span) {
    if site < typed.SiteId(0) or I64(site) >= s.plan.Built.Len() { return }
    u := t if t.Runs() else s.here()
    s.plan.Built[I64(site)] = s.scopeOf(u)
    s.buildsInto(u, sp, s.B.File, sp)
}

# a build into term t recorded for the body's summary (O18c, E11c): at sp in this body, its innermost site at (file, at)
# - a callee's own, for a build through a call
fn (s mut Scoper&) buildsInto(t Term, sp source.Span, file I64, at source.Span) {
    match t {
        case Term.Derived(_, _) {
            # a derived scope exists at no run time: nothing is built into it (C2d, O23a) - a task's stand-in for it is
            # made where the instance whose field it reads lives, which it outlives (O23)
            if s.report and not s.standIn { s.err(sp, msgs.BuildThroughUnknownScope()) }
        }
        case Term.Var(k) {
            if k < s.buildsVar.Len() and not s.buildsVar[k] {
                s.buildsVar[k] = true
                s.buildSp[k] = sp
                s.buildFile[k] = file
                s.buildAt[k] = at
            }
            if k < s.realVar.Len() and not s.standIn { s.realVar[k] = true }
        }
        case _ { }
    }
}

# a build through a call at sp into term t, the callee building into its scope variable v there (E11c's note: the
# callee's innermost site)
fn (s mut Scoper&) buildsThrough(t Term, sp source.Span, callee I64, v I64) {
    known := callee >= 0 and v >= 0 and (s.sums[callee].Done or s.sums[callee].Judging) and v < s.sums[callee].BuildAt.Len()
    saved := s.standIn
    # a callee building only its tasks' stand-ins there builds a stand-in here too
    if known and v < s.sums[callee].Real.Len() and not s.sums[callee].Real[v] { s.standIn = true }
    if known {
        s.buildsInto(t, sp, s.sums[callee].BuildFile[v], s.sums[callee].BuildAt[v])
    } else {
        s.buildsInto(t, sp, s.B.File, sp)
    }
    s.standIn = saved
}

# a term as the plan says it: Inert for one nothing exists for at run time
fn (s mut Scoper&) scopeOf(t Term) typed.Scope {
    return match t {
        case Term.Block(b) => typed.Scope.Block(b)
        case Term.Var(i) => typed.Scope.Var(i)
        case Term.Program => typed.Scope.Program
        case _ => typed.Scope.Inert
    }
}

# ---- diagnostics ----

fn (s mut Scoper&) err(sp source.Span, m msgs.Msg) I64 {
    return s.P.L.Diags.Error(diag.Where.Span(s.B.File, I64(sp.Start), I64(sp.End)), m)
}

fn (s mut Scoper&) note(rec I64, file I64, sp source.Span, m msgs.Msg) {
    s.P.L.Diags.Note(rec, diag.Where.Span(file, I64(sp.Start), I64(sp.End)), m)
}

# a call's span as an error names it: its callee's name - the name before the argument list
fn (s mut Scoper&) nameSpan(sp source.Span) source.Span {
    text := try s.texts.Get(s.B.File) catch default ""
    at := I64(sp.Start)
    end := I64(sp.End)
    if end > text.Len() { return sp }
    # the name before the call's own argument list: the last "(" at depth 0 that follows a name - in a chain
    # ("a.F().G(x)") the last call's, G (strings and characters skipped)
    k := at
    name := sp
    last := source.Span(0, 0)
    found := false
    depth := 0
    angle := 0
    beforeAngle := source.Span(0, 0)
    bracket := source.Span(0, 0)
    for k < end {
        ch := text[k]
        if ch == '"' or ch == '\'' {
            k++
            for k < end and text[k] != ch {
                if text[k] == '\\' { k++ }
                k++
            }
            k++
            last = source.Span(0, 0)
            continue
        }
        if ch == '(' or ch == '[' or ch == '{' {
            if ch == '(' and depth == 0 and last.End > last.Start {
                name = last
                found = true
            }
            # an index written "x[i]" calls At: said at its "["
            if ch == '[' and depth == 0 { bracket = source.Span(I32(k), I32(k + 1)) }
            depth++
            last = source.Span(0, 0)
            k++
            continue
        }
        if ch == ')' or ch == ']' or ch == '}' {
            depth--
            last = source.Span(0, 0)
            k++
            continue
        }
        if isNameChar(ch) {
            from := k
            for k < end and isNameChar(text[k]) { k++ }
            if angle == 0 { last = source.Span(I32(from), I32(k)) }
            if not found and depth == 0 and angle == 0 { name = last }
            continue
        }
        if ch == '<' and depth == 0 {
            # a type's arguments ("List<I64>(...)"): the name before them is the callee's
            angle++
            if angle == 1 { beforeAngle = last }
        } else if ch == '>' and angle > 0 and depth == 0 {
            angle--
            if angle == 0 { last = beforeAngle }
            k++
            continue
        } else if ch != '.' and ch != ' ' and ch != ',' and angle == 0 {
            last = source.Span(0, 0)
        }
        # a store written "x[i] = v" calls SetAt (E31b): said at its "="
        if ch == '=' and depth == 0 and not found and k + 1 < end and text[k + 1] != '=' and k > at and text[k - 1] != '=' and text[k - 1] != '!' and text[k - 1] != '<' and text[k - 1] != '>' {
            # a compound one ("x[i] += v") at its operator, as stage 0 says it
            p := text[k - 1]
            if k - 1 > at and (p == '+' or p == '-' or p == '*' or p == '/' or p == '%' or p == '&' or p == '|' or p == '^') {
                return source.Span(I32(k - 1), I32(k + 1))
            }
            return source.Span(I32(k), I32(k + 1))
        }
        k++
    }
    if not found and bracket.End > bracket.Start { return bracket }
    return name
}

# the last name in a span: a member a place reads
fn (s mut Scoper&) lastName(sp source.Span) source.Span {
    text := try s.texts.Get(s.B.File) catch default ""
    k := I64(sp.Start)
    end := I64(sp.End)
    if end > text.Len() { return sp }
    name := sp
    for k < end {
        if isNameChar(text[k]) {
            from := k
            for k < end and isNameChar(text[k]) { k++ }
            name = source.Span(I32(from), I32(k))
            continue
        }
        k++
    }
    return name
}

# where a mark "&name" on the line a span begins names name: the name's own span, else the span
fn (s mut Scoper&) markAt(sp source.Span, name String&) source.Span {
    text := try s.texts.Get(s.B.File) catch default ""
    end := I64(sp.Start)
    for end < text.Len() and text[end] != '\n' { end++ }
    for k in range I64(sp.Start), end {
        if text[k] != '&' or k + 1 + name.Len() > end { continue }
        if text[k + 1:k + 1 + name.Len()] != name { continue }
        if k + 1 + name.Len() < text.Len() and isNameChar(text[k + 1 + name.Len()]) { continue }
        return source.Span(I32(k + 1), I32(k + 1 + name.Len()))
    }
    return sp
}

# the first token of a statement: a name, or one character
fn (s mut Scoper&) firstToken(file I64, sp source.Span) source.Span {
    text := try s.texts.Get(file) catch default ""
    at := I64(sp.Start)
    if at < 0 or at >= text.Len() { return sp }
    k := at
    for k < text.Len() and isNameChar(text[k]) { k++ }
    if k == at { k = at + 1 }
    return source.Span(I32(at), I32(k))
}

fn isNameChar(c Char) Bool { return c.IsLetter() or c.IsDigit() or c == '_' }

# whether body b's scopes were judged: it has code, and no type in it is unknown (a check error)
fn (s Scoper&) Judged(b I64) Bool { return s.judged[b] }

# body b's summary as text, for compiler/tools/scopedump.olang: its obligations, what it builds into, keeps and stores
fn (s Scoper&) Summary(b I64) String {
    t := StringBuilder()
    sm := s.sums[b]
    for r in sm.Rels { t.Push("rel " $r.Hi $(" == " if r.Exact else " >= ") $r.Lo $(" why " $r.Why if r.Why != 0 else "") "\n") }
    for k in range sm.Builds.Len() { t.Push("var " $k " builds " $sm.Builds[k] " real " $sm.Real[k] "\n") }
    for k in range sm.Keeps.Len() { t.Push("param " $k " keeps " $sm.Keeps[k] " stores " $sm.Stores[k] " puts " $sm.Puts[k] "\n") }
    for k in range sm.ResBind.Len() { t.Push("result binds " $k " at " $sm.ResBind[k] "\n") }
    return t.ToString()
}

# ---- tests: the plan and the summaries, which compiler/tools/scopediff.olang cannot show ----

if TestBuild {
    import "std/os"
    import "cond"
    import "fetch"
    import "load"
    import "names"
    import typecheck "check"

    # the rules of the errors said in the root module, in order
    fn rootRules(l mut load.Loader&) String {
        b := StringBuilder()
        for d in l.Diags.AllSaid() {
            if d.File == l.Mods[l.Root].File { b.Push($d.Rule " ") }
        }
        return b.ToString()
    }

    # the body of the root module's function declared at the start of line n
    fn bodyAt(l mut load.Loader&, bodies List<mut typed.Body&>&, n I64) I64 {
        root := l.Mods[l.Root].File
        for k in range bodies.Len() {
            body := bodies[k]
            if body.File == root and l.Diags.Locate(body.File, I64(body.Sp.Start)).EndsWith(":" $n ":1") { return k }
        }
        return -1
    }

    jpTasks String& = ("type P struct(v I64) { v }\n"
                       "fn work(p P&) I64 { return p.v }\n"
                       "fn spawnOne() I64 {\n"
                       "    r I64 = 0\n"
                       "    join {\n"
                       "        spawn r = work(P(1))\n"
                       "    }\n"
                       "    return r\n"
                       "}\n"
                       "fn keep(l mut List<P&>&, n I64) {\n"
                       "    for i in range n { l.Push(P(i)) }\n"
                       "}\n"
                       "fn grow(l mut List<P&>&) { l.Push(P(1)) }\n"
                       "fn peek(l List<P&>&) I64 { return l.Len() }\n"
                       "fn fanPeek(l List<P&>&) {\n"
                       "    join {\n"
                       "        spawn peek(l)\n"
                       "    }\n"
                       "}\n"
                       "fn fanGrow(l mut List<P&>&) {\n"
                       "    join {\n"
                       "        spawn grow(l)\n"
                       "    }\n"
                       "}\n"
                       "fn main() {\n"
                       "    l := List<P&>()\n"
                       "    keep(l, 3)\n"
                       "    fanPeek(l)\n"
                       "    fanGrow(l)\n"
                       "    assert spawnOne() == 1\n"
                       "}\n")

    test "plans and summaries: a task's temporary built in its join block, an element where its list lives (O18b), a build through a stand-in apart from one into the scope itself (P2)" {
        dir := try os.MkTemp() catch os.OsError { unreachable }
        defer { try os.RemoveAll(dir) catch os.OsError { } }
        try os.WriteFile($dir "/main.olang", jpTasks) catch os.OsError { }
        consts := cond.Consts()
        consts.Builtins("linux", "x86_64", "x86-64", 128, 0, false, false, false)
        l := load.Loader("std", consts, fetch.Fetcher($dir "/olang.lock", $dir "/cache", "file:///nowhere/", false, true)
                         source.Names(), diag.Diagnostics(false))
        l.Load($dir "/main.olang")
        r := names.Resolver(l)
        r.Resolve()
        p := generic.Program(l, r)
        c := typecheck.Checker(p, false)
        c.CheckProgram()
        s := Scoper(p, c.Bodies)
        s.Run()
        assert rootRules(l) == "", rootRules(l)
        # the task's P(1) is built in the join block, where the task is made, not in the spawn's own block
        b := bodyAt(l, c.Bodies, 3)
        assert b >= 0
        body := c.Bodies[b]
        promotes I64 = 0
        for i in range body.Sites.Len() {
            if body.Sites[i].Kind != typed.SiteKind.Promote { continue }
            promotes++
            match s.Plans[b].Built[i] {
                case typed.Scope.Block(k) { assert body.Blocks[I64(k)].Kind == typed.BlockKind.Join, $body.Blocks[I64(k)].Kind }
                case _ { assert s.Plans[b].Built[i] is typed.Scope.Block, $s.Plans[b].Built[i] }
            }
        }
        assert promotes == 1, $promotes
        # each P(i) pushed is built where the list lives: its parameter's scope variable
        k := bodyAt(l, c.Bodies, 10)
        assert k >= 0
        kb := c.Bodies[k]
        assert kb.Vars[0] == typed.ScopeVar.Param(kb.Params[0]), $kb.Vars[0]
        for i in range kb.Sites.Len() {
            if kb.Sites[i].Kind == typed.SiteKind.Promote { assert s.Plans[k].Built[i] == typed.Scope.Var(0), $s.Plans[k].Built[i] }
        }
        # grow builds into its list's scope, and so does a task spawned on it; one spawned on peek, which builds nothing,
        # is handed a stand-in of it all the same, which is no build into the scope itself
        g := bodyAt(l, c.Bodies, 13)
        fp := bodyAt(l, c.Bodies, 15)
        fg := bodyAt(l, c.Bodies, 20)
        assert g >= 0 and fp >= 0 and fg >= 0
        assert s.sums[g].Builds[0] and s.sums[g].Real[0]
        assert s.sums[fg].Builds[0] and s.sums[fg].Real[0]
        assert s.sums[fp].Builds[0], "fanPeek makes a stand-in of its list's scope"
        assert not s.sums[fp].Real[0], "fanPeek builds into no real scope"
    }

    jpArrays String& = ("type E enum {\n"
                        "    Leaf(n I64)\n"
                        "    Pair(a E&, b E&)\n"
                        "}\n"
                        "type P struct() {\n"
                        "    n I64 = 0\n"
                        "}\n"
                        "fn (p mut P&) mark(t E&p) E&p { return t }\n"
                        "fn (p mut P&) build(n I64) E&p {\n"
                        "    nt := E.Leaf(n)\n"
                        "    return p.mark(nt)\n"
                        "}\n"
                        "fn shout(n I64) String {\n"
                        "    out := String(Array<Char>(n, 'a'))\n"
                        "    return out\n"
                        "}\n"
                        "fn label(n I64) String { return $n \"!\" }\n"
                        "fn main() {\n"
                        "    p := P()\n"
                        "    e := p.build(4)\n"
                        "    assert shout(3).Len() == 3\n"
                        "    assert label(5).Len() == 2\n"
                        "}\n")

    test "plans: a returned array value is built in the result scope its function has for it (T7b); a local lent for a parameter sharing the borrowed result's scope lives there (O26a)" {
        dir := try os.MkTemp() catch os.OsError { unreachable }
        defer { try os.RemoveAll(dir) catch os.OsError { } }
        try os.WriteFile($dir "/main.olang", jpArrays) catch os.OsError { }
        consts := cond.Consts()
        consts.Builtins("linux", "x86_64", "x86-64", 128, 0, false, false, false)
        l := load.Loader("std", consts, fetch.Fetcher($dir "/olang.lock", $dir "/cache", "file:///nowhere/", false, true)
                         source.Names(), diag.Diagnostics(false))
        l.Load($dir "/main.olang")
        r := names.Resolver(l)
        r.Resolve()
        p := generic.Program(l, r)
        c := typecheck.Checker(p, false)
        c.CheckProgram()
        s := Scoper(p, c.Bodies)
        s.Run()
        assert rootRules(l) == "", rootRules(l)
        # nt is lent for mark's t, which shares p's scope, the scope build's result is borrowed from: it lives there
        b := bodyAt(l, c.Bodies, 9)
        assert b >= 0
        stored := false
        for x in s.Plans[b].Stored {
            if x == typed.Scope.Var(0) { stored = true }
        }
        assert stored, "nt is stored where p lives"
        # shout's array and label's text are what they return: each built in its function's result scope, the one
        # scope variable an array value's result gives it
        for n in I64[13, 17] {
            k := bodyAt(l, c.Bodies, n)
            assert k >= 0
            assert c.Bodies[k].Vars.Len() == 1, $c.Bodies[k].Vars.Len()
            built := false
            for i in range c.Bodies[k].Sites.Len() {
                if s.Plans[k].Built[i] == typed.Scope.Var(0) { built = true }
                assert s.Plans[k].Built[i] != typed.Scope.Block(typed.BlockId(0)), "a site of line " $n " built in its frame"
            }
            assert built, "a site of line " $n " built in the result scope"
        }
    }
}
